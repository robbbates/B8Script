0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Spec: docs/b8script.md (2026-10-09) plus the 2026-11-20 changes:
0000                             ;        [x stores in a variable, "[ " pushes an anonymous block, any other
0000                             ;        character after [ is an error, the heap pointer lives at z10+.
0000                             ;        The string escape is "/" (it was ">").
0000                             ; 
0000                             ;  Two switches, set in the two EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    CHECKED  0 = no checks (spec: "B8Script checks nothing")
0000                             ;             1 = stops on stack overrun, Ctrl-C, heap past the limit, a store
0000                             ;                 outside the program's own space, and a bad character after [,
0000                             ;                 printing a letter and the place, like  S @ 245
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   0   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   0   ; 1 = checked build
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    HL'  return-stack pointer (the alternate HL). Entries are 2 bytes; the
0000                             ;         stack grows down. Only rpush and rpop (and the checks) touch it.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  A handler ends with RST 10h ("next character") or RST 08h ("drop, then
0000                             ;  next"), one byte each instead of a three-byte JP. An RST is a CALL, so the
0000                             ;  first thing each stub does is POP DE to throw the return address away.
0000                             ; -----------------------------------------------------------------------------
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (SP stays inside this page)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch (= z10+), interpreter variables in the gaps, and the -n?
0000                             ;             line buffer at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack's page has a guard band: the data
0000                             ;  stack can overrun by a cell or two (and the calls made while it is full)
0000                             ;  into the top 32 bytes of the return-stack page, which are never used, and
0000                             ;  the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
                    BDOS:     EQU   0005h   
0000                          ENDIF      
0000                          IFN   CPM   
0000                             ; ---- generic machine: edit these to suit -----------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The zero flag must match A
0000                             ;   (end the routine with OR A / RET).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                             ;   KEY and CONOUT must preserve BC, DE, HL and HL'.
0000                RSPAGE:   EQU   80h   ; 8000h return stack
0000                DSPAGE:   EQU   81h   ; 8100h data stack
0000                LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
0000                PROG:     EQU   8300h   ; where the loader puts the program text
0000                HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms: each pass
0000                             ; calls getk once, so tune it for your clock
0000                             ; and your CONST routine
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; z10+, the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                KEYBUF:   EQU   LET+36h   ;   around machine code; a held-back key;
0000                SPTMP:    EQU   LET+38h   ;   scratch for the SP check;
0000                HLIM:     EQU   LET+3Ah   ;   high byte of the heap limit
0000                LBHDR:    EQU   LET+7Eh   ; CP/M BDOS 10 header: max, count
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FEh   ; empty data stack
0000                             ; =============================================================================
0000                             ;  Page zero (generic ROM) or the start of the .COM file (CP/M)
0000                             ; =============================================================================
0000                          IF   CPM   
                              .ORG   0100h   
                              JP   start   
0000                          ENDIF      
0000                          IFN   CPM   
0000                          .ORG   0000h   
0000   C3 0D 03               JP   start   ; 0000h reset
0003                ENDPROG:      
0003   C3 09 FF               JP   EXIT   ; 0003h the program has ended
0006   E5           H_DUP:    PUSH   HL   ; 0006h ":" (two-byte handlers fill the gaps)
0007   D7                     RST   10h   
0008                             ; ---- RST 08h: drop TOS, then next ------------------------------------------
0008   D1                     POP   DE   ; 0008h discard the RST's return address
0009                DROP_NEXT:      
0009   E1                     POP   HL   ; new TOS = NOS
000A   18 05                  JR   next0   
000C   E3           H_SWAP:   EX   (SP),HL   ; 000Ch "%"
000D   D7                     RST   10h   
000E   00 00                  DB   0,0   ; 000Eh spare
0010                             ; ---- RST 10h: next character ------------------------------------------------
0010   D1                     POP   DE   ; 0010h discard the RST's return address
0011                          ENDIF      
0011                             ; =============================================================================
0011                             ;  The inner loop: read one character and sort it by range.
0011                             ; 
0011                             ;    00h          end of program
0011                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0011                             ;    30h-39h      digit: read a whole number
0011                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0011                             ;    61h-7Ah      a-z: push the address of that letter's cell
0011                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0011                             ; =============================================================================
0011                NEXT0:       
0011                          IF   CHECKED   
                                 ; Both stacks are checked once per character, not in every handler.
                                 ; Each stack lives in one page, so it has overrun exactly when the
                                 ; pointer's high byte has left that page. Errors are caught one cell
                                 ; late at most; the page below each stack is a guard band.
                              LD   (SPTMP),SP   
                              LD   A,(SPTMP+1)   
                              CP   DSPAGE   
                              JP   NZ,e_stack   
                              EXX      ; the return stack: in its page, and not
                              LD   A,L   ;   above its empty position (an underflow
                              CP   RSTOP&0FFh+1   ;   would stay inside the page, in the
                              LD   A,H   ;   guard band)
                              EXX      
                              JP   NC,e_rstack   
                              CP   RSPAGE   
                              JP   NZ,e_rstack   
0011                          ENDIF      
0011   0A                     LD   A,(BC)   
0012   03                     INC   BC   
0013   D6 21                  SUB   21h   ; A = c - 21h
0015   38 38                  JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
0017   FE 0F                  CP   0Fh   
0019   38 26                  JR   C,punct   ; 21h-2Fh: PTAB index 0-14
001B   D6 0F                  SUB   0Fh   ; A = c - 30h
001D   FE 0A                  CP   0Ah   
001F   38 4A                  JR   C,digit   ; 30h-39h
0021   FE 11                  CP   11h   
0023   30 04                  JR   NC,ab40   
0025   C6 05                  ADD   A,5   ; 3Ah-40h: index 15-21
0027   18 18                  JR   punct   
0029   D6 11        AB40:     SUB   11h   ; A = c - 41h
002B   FE 1A                  CP   1Ah   
002D   38 2D                  JR   C,upper   ; 41h-5Ah: A = letter index 0-25
002F   FE 20                  CP   20h   
0031   30 04                  JR   NC,ab60   
0033   D6 04                  SUB   4   ; 5Bh-60h: index 22-27
0035   18 0A                  JR   punct   
0037   FE 3A        AB60:     CP   3Ah   
0039   38 1B                  JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
003B   FE 3E                  CP   3Eh   
003D   30 D2                  JR   NC,next0   ; 7Fh-FFh: ignored
003F   D6 1E                  SUB   1Eh   ; 7Bh-7Eh: index 28-31
0041                             ; Punctuation: HL holds TOS, so it is parked in DE while the table is read.
0041                             ; PTAB never crosses a page (checked at assembly), so only L needs adding.
0041   EB           PUNCT:    EX   DE,HL   ; DE = TOS
0042   87                     ADD   A,A   
0043   C6 71                  ADD   A,PTAB & 0FFh   
0045   6F                     LD   L,A   
0046   26 00                  LD   H,PTAB / 256   
0048   7E                     LD   A,(HL)   
0049   2C                     INC   L   
004A   66                     LD   H,(HL)   
004B   6F                     LD   L,A   ; HL = handler
004C   EB                     EX   DE,HL   ; HL = TOS, DE = handler
004D   D5                     PUSH   DE   ; jump to it; the stack is balanced again
004E   C9                     RET      ;   when the handler starts
004F   C6 21        CTL:      ADD   A,21h   ; back to c; zero only for NUL
0051   20 BE                  JR   NZ,next0   
0053   C3 03 00               JP   endprog   
0056                             ; a-z: push the cell's address (the cell is the variable)
0056   E5           LOWER:    PUSH   HL   
0057   87                     ADD   A,A   
0058   6F                     LD   L,A   
0059   26 82                  LD   H,LETPAGE   
005B   D7                     RST   10h   
005C                             ; A-Z: call the word. The return address (the IP after the letter) goes on
005C                             ; the return stack, and the IP becomes the address in the letter's cell.
005C   E5           UPPER:    PUSH   HL   ; keep TOS
005D   87                     ADD   A,A   
005E   6F                     LD   L,A   
005F   26 82                  LD   H,LETPAGE   ; HL -> cell
0061   5E                     LD   E,(HL)   
0062   2C                     INC   L   
0063   56                     LD   D,(HL)   ; DE = the word's body
0064   E1                     POP   HL   ; TOS back
0065   CD C7 00               CALL   rpush   ; push the return address (IP)
0068   42                     LD   B,D   
0069   4B                     LD   C,E   ; IP = body
006A   D7                     RST   10h   
006B                             ; Digits: step back onto the first digit and read the whole number.
006B   E5           DIGIT:    PUSH   HL   
006C   0B                     DEC   BC   
006D   CD B1 00               CALL   rdnum   
0070   D7                     RST   10h   
0071                             ; =============================================================================
0071                             ;  Dispatch table: one handler per punctuation character, in code order.
0071                             ;  It sits right after the inner loop so that it can't cross a page (the
0071                             ;  loop only adds to the low byte of its address).
0071                             ; =============================================================================
0071   99 01        PTAB:     DW   h_store   ; !
0073   36 02                  DW   h_str   ; "
0075   5A 02                  DW   h_num   ; #
0077   3D 02                  DW   h_print   ; $
0079   0C 00                  DW   h_swap   ; %
007B   4B 01                  DW   h_and   ; &
007D   55 02                  DW   h_emit   ; '
007F   AC 01                  DW   h_open   ; (
0081   B9 01                  DW   h_close   ; )
0083   F8 00                  DW   h_mul   ; *
0085   D9 00                  DW   h_add   ; +
0087   81 02                  DW   h_cfetch   ; ,
0089   DC 00                  DW   h_sub   ; -
008B   9E 01                  DW   h_cstore   ; .
008D   0E 01                  DW   h_div   ; /
008F   06 00                  DW   h_dup   ; :
0091   09 00                  DW   drop_next   ; ;
0093   6B 01                  DW   h_lt   ; <
0095   7B 01                  DW   h_eq   ; =
0097   68 01                  DW   h_gt   ; >
0099   84 02                  DW   h_key   ; ?
009B   94 01                  DW   h_fetch   ; @
009D   E0 01                  DW   h_def   ; [
009F   CB 01                  DW   h_break   ; \
00A1   DA 01                  DW   h_ret   ; ]
00A3   5B 01                  DW   h_xor   ; ^
00A5   A1 01                  DW   h_alloc   ; _
00A7   CE 02                  DW   h_grave   ; `
00A9   86 01                  DW   h_tor   ; {
00AB   53 01                  DW   h_or   ; |
00AD   8E 01                  DW   h_fromr   ; }
00AF   63 01                  DW   h_not   ; ~
00B1                PTABEND:      
00B1                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
00B1                             ; non-digit. Values wrap at 16 bits, as the spec says.
00B1   21 00 00     RDNUM:    LD   HL,0   
00B4   0A           RDN1:     LD   A,(BC)   
00B5   D6 30                  SUB   "0"   
00B7   FE 0A                  CP   10   
00B9   D0                     RET   NC   
00BA   03                     INC   BC   
00BB   54                     LD   D,H   
00BC   5D                     LD   E,L   
00BD   29                     ADD   HL,HL   
00BE   29                     ADD   HL,HL   
00BF   19                     ADD   HL,DE   
00C0   29                     ADD   HL,HL   ; HL * 10
00C1   5F                     LD   E,A   
00C2   16 00                  LD   D,0   
00C4   19                     ADD   HL,DE   
00C5   18 ED                  JR   rdn1   
00C7                             ; =============================================================================
00C7                             ;  Return stack. rpush pushes BC (nearly always the IP); rpop pops into DE.
00C7                             ;  HL' is the pointer. Both go through the Z80 stack to cross between the
00C7                             ;  register sets.
00C7                             ; =============================================================================
00C7   C5           RPUSH:    PUSH   BC   
00C8   D9                     EXX      
00C9   D1                     POP   DE   
00CA   2B                     DEC   HL   
00CB   72                     LD   (HL),D   
00CC   2B                     DEC   HL   
00CD   73                     LD   (HL),E   
00CE   D9                     EXX      
00CF   C9                     RET      
00D0   D9           RPOP:     EXX      
00D1   5E                     LD   E,(HL)   
00D2   23                     INC   HL   
00D3   56                     LD   D,(HL)   
00D4   23                     INC   HL   
00D5   D5                     PUSH   DE   
00D6   D9                     EXX      
00D7   D1                     POP   DE   
00D8   C9                     RET      
00D9                             ; =============================================================================
00D9                             ;  Arithmetic and logic. Effects are ( NOS TOS -- result ).
00D9                             ; =============================================================================
00D9   D1           H_ADD:    POP   DE   
00DA   19                     ADD   HL,DE   
00DB   D7                     RST   10h   
00DC                             ; "-" has two jobs: directly before a digit it starts a negative number.
00DC   0A           H_SUB:    LD   A,(BC)   
00DD   D6 30                  SUB   "0"   
00DF   FE 0A                  CP   10   
00E1   38 06                  JR   C,negnum   
00E3   CD F1 00               CALL   neg16   ; a - b = a + (-b)
00E6   D1                     POP   DE   
00E7   19                     ADD   HL,DE   
00E8   D7                     RST   10h   
00E9   E5           NEGNUM:   PUSH   HL   
00EA   CD B1 00               CALL   rdnum   
00ED   CD F1 00               CALL   neg16   
00F0   D7                     RST   10h   
00F1                             ; neg16: HL = -HL (keeps BC, DE)
00F1   AF           NEG16:    XOR   A   
00F2   95                     SUB   L   
00F3   6F                     LD   L,A   
00F4   9F                     SBC   A,A   
00F5   94                     SUB   H   
00F6   67                     LD   H,A   
00F7   C9                     RET      
00F8                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept.
00F8   D1           H_MUL:    POP   DE   ; DE = multiplicand
00F9   C5                     PUSH   BC   
00FA   44                     LD   B,H   
00FB   4D                     LD   C,L   ; BC = multiplier
00FC   21 00 00               LD   HL,0   
00FF   3E 10                  LD   A,16   
0101   29           MUL1:     ADD   HL,HL   
0102   CB 21                  SLA   C   
0104   CB 10                  RL   B   
0106   30 01                  JR   NC,mul2   
0108   19                     ADD   HL,DE   
0109   3D           MUL2:     DEC   A   
010A   20 F5                  JR   NZ,mul1   
010C   C1                     POP   BC   
010D   D7                     RST   10h   
010E                             ; "/" ( a b -- r q ): the quotient is on top. Truncates toward zero; r takes
010E                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
010E                             ; of a. Dividing by zero is not checked: it returns two cells of no meaning.
010E   D1           H_DIV:    POP   DE   ; DE = a, HL = b
010F   C5                     PUSH   BC   ; free BC for udiv
0110   7A                     LD   A,D   
0111   AC                     XOR   H   
0112   F5                     PUSH   AF   ; S flag = sign of q
0113   7A                     LD   A,D   
0114   B7                     OR   A   
0115   F5                     PUSH   AF   ; S flag = sign of a (for r)
0116   CB 7C                  BIT   7,H   
0118   C4 F1 00               CALL   NZ,neg16   ; HL = |b|
011B   EB                     EX   DE,HL   
011C   CB 7C                  BIT   7,H   
011E   C4 F1 00               CALL   NZ,neg16   ; HL = |a|, DE = |b|
0121   CD 32 01               CALL   udiv   ; BC = q, HL = r
0124   F1                     POP   AF   
0125   FC F1 00               CALL   M,neg16   ; r's sign
0128   EB                     EX   DE,HL   ; DE = r
0129   60                     LD   H,B   
012A   69                     LD   L,C   ; HL = q
012B   F1                     POP   AF   
012C   FC F1 00               CALL   M,neg16   ; q's sign
012F   C1                     POP   BC   
0130   D5                     PUSH   DE   ; r under q
0131   D7                     RST   10h   
0132                             ; udiv: unsigned HL / DE. Returns BC = quotient, HL = remainder.
0132                             ; Uses A, BC; the caller saves the IP.
0132   44           UDIV:     LD   B,H   
0133   4D                     LD   C,L   
0134   21 00 00               LD   HL,0   
0137   3E 10                  LD   A,16   
0139   CB 21        UDV1:     SLA   C   
013B   CB 10                  RL   B   
013D   ED 6A                  ADC   HL,HL   
013F   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
0141   30 03                  JR   NC,udv2   ;   always fits in 16 bits
0143   19                     ADD   HL,DE   
0144   18 01                  JR   udv3   
0146   0C           UDV2:     INC   C   
0147   3D           UDV3:     DEC   A   
0148   20 EF                  JR   NZ,udv1   
014A   C9                     RET      
014B   D1           H_AND:    POP   DE   
014C   7C                     LD   A,H   
014D   A2                     AND   D   
014E   67                     LD   H,A   
014F   7D                     LD   A,L   
0150   A3                     AND   E   
0151   6F                     LD   L,A   
0152   D7                     RST   10h   
0153   D1           H_OR:     POP   DE   
0154   7C                     LD   A,H   
0155   B2                     OR   D   
0156   67                     LD   H,A   
0157   7D                     LD   A,L   
0158   B3                     OR   E   
0159   6F                     LD   L,A   
015A   D7                     RST   10h   
015B   D1           H_XOR:    POP   DE   
015C   7C                     LD   A,H   
015D   AA                     XOR   D   
015E   67                     LD   H,A   
015F   7D                     LD   A,L   
0160   AB                     XOR   E   
0161   6F                     LD   L,A   
0162   D7                     RST   10h   
0163   CD F1 00     H_NOT:    CALL   neg16   ; ~x = -x - 1
0166   2B                     DEC   HL   
0167   D7                     RST   10h   
0168                             ; Signed compares. Flipping both sign bits turns a signed compare into an
0168                             ; unsigned one; SBC HL,HL then turns the carry into -1 or 0 with no branch.
0168   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
0169   18 02                  JR   cmp   
016B   D1           H_LT:     POP   DE   ; a < b: HL = a, DE = b
016C   EB                     EX   DE,HL   
016D   7C           CMP:      LD   A,H   
016E   EE 80                  XOR   80h   
0170   67                     LD   H,A   
0171   7A                     LD   A,D   
0172   EE 80                  XOR   80h   
0174   57                     LD   D,A   
0175   B7                     OR   A   
0176   ED 52                  SBC   HL,DE   ; carry if HL < DE
0178   ED 62                  SBC   HL,HL   
017A   D7                     RST   10h   
017B   D1           H_EQ:     POP   DE   
017C   B7                     OR   A   
017D   ED 52                  SBC   HL,DE   
017F   21 00 00               LD   HL,0   
0182   20 01                  JR   NZ,eq1   
0184   2B                     DEC   HL   
0185   D7           EQ1:      RST   10h   
0186                             ; =============================================================================
0186                             ;  Stack
0186                             ; =============================================================================
0186                          IF   CPM   ; (the generic build has these in page zero)
                    H_DUP:    PUSH   HL   
                              RST   10h   
                    H_SWAP:   EX   (SP),HL   
                              RST   10h   
0186                          ENDIF      
0186   C5           H_TOR:    PUSH   BC   ; "{" TOS to the return stack
0187   44                     LD   B,H   
0188   4D                     LD   C,L   
0189   CD C7 00               CALL   rpush   
018C   C1                     POP   BC   
018D   CF                     RST   08h   
018E   E5           H_FROMR:   PUSH   HL   ; "}" return stack to TOS
018F   CD D0 00               CALL   rpop   
0192   EB                     EX   DE,HL   
0193   D7                     RST   10h   
0194                             ; =============================================================================
0194                             ;  Storage
0194                             ; =============================================================================
0194   5E           H_FETCH:   LD   E,(HL)   ; "@"
0195   23                     INC   HL   
0196   56                     LD   D,(HL)   
0197   EB                     EX   DE,HL   
0198   D7                     RST   10h   
0199   D1           H_STORE:   POP   DE   ; "!" ( n addr -- )
019A                          IF   CHECKED   
                              INC   HL   ; both bytes must be in the program's space
                              CALL   chkst   
                              DEC   HL   
019A                          ENDIF      
019A   73                     LD   (HL),E   
019B   23                     INC   HL   
019C   72                     LD   (HL),D   
019D   CF                     RST   08h   
019E   D1           H_CSTORE:   POP   DE   ; "." ( c addr -- )
019F                          IF   CHECKED   
                              CALL   chkst   
019F                          ENDIF      
019F   73                     LD   (HL),E   
01A0   CF                     RST   08h   
01A1                             ; "_" ( n -- addr ): the heap pointer moves up by n; TOS is the old pointer.
01A1   EB           H_ALLOC:   EX   DE,HL   
01A2   2A 7C 82               LD   HL,(HEAP)   
01A5   E5                     PUSH   HL   
01A6   19                     ADD   HL,DE   
01A7                          IF   CHECKED   
                              JP   C,e_heap   ; a negative count wraps: too big
                              LD   A,(HLIM)   
                              DEC   A   
                              CP   H   
                              JP   C,e_heap   ; the new top must stay below the limit page
01A7                          ENDIF      
01A7   22 7C 82               LD   (HEAP),HL   
01AA   E1                     POP   HL   
01AB   D7                     RST   10h   
01AC                          IF   CHECKED   
                                 ; chkst: stop unless HL is in the program's own space: from the letter page
                                 ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
                                 ; whatever lies above the limit are safe. Memory above the heap top but
                                 ; below the limit is the program's own: Tiny BASIC keeps its lines there.
                                 ; Keeps every register.
                    CHKST:    PUSH   AF   
                              LD   A,H   
                              CP   LETPAGE   
                              JR   C,chk1   
                              LD   A,(HLIM)   
                              DEC   A   
                              CP   H   
                    CHK1:     JP   C,e_store   
                              POP   AF   
                              RET      
01AC                          ENDIF      
01AC                             ; =============================================================================
01AC                             ;  Flow control
01AC                             ; =============================================================================
01AC                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
01AC                             ; the matching ")".
01AC   7C           H_OPEN:   LD   A,H   
01AD   B5                     OR   L   
01AE   E1                     POP   HL   
01AF   28 04                  JR   Z,skipnx   
01B1   CD C7 00               CALL   rpush   ; the block starts at the IP
01B4   D7                     RST   10h   
01B5   CD FE 01     SKIPNX:   CALL   skip   
01B8   D7                     RST   10h   
01B9                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
01B9                             ; drops it and carries on.
01B9   7C           H_CLOSE:   LD   A,H   
01BA   B5                     OR   L   
01BB   E1                     POP   HL   
01BC   28 09                  JR   Z,rdrop   
01BE                          IF   CHECKED   
                              CALL   chkbrk   ; Ctrl-C is checked at every loop-back
01BE                          ENDIF      
01BE   CD D0 00               CALL   rpop   ; peek: pop the block start ...
01C1   42                     LD   B,D   
01C2   4B                     LD   C,E   
01C3   CD C7 00               CALL   rpush   ; ... and push it back
01C6   D7                     RST   10h   
01C7   CD D0 00     RDROP:    CALL   rpop   
01CA   D7                     RST   10h   
01CB                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
01CB                             ; drops the block start, "]" returns. No closer at all ends the program.
01CB   7C           H_BREAK:   LD   A,H   
01CC   B5                     OR   L   
01CD   E1                     POP   HL   
01CE   28 09                  JR   Z,brk1   
01D0   CD FE 01               CALL   skip   
01D3   FE 29                  CP   ")"   
01D5   28 F0                  JR   Z,rdrop   
01D7   18 01                  JR   h_ret   
01D9   D7           BRK1:     RST   10h   
01DA                             ; "]" returns: pop an address and jump to it.
01DA   CD D0 00     H_RET:    CALL   rpop   
01DD   42                     LD   B,D   
01DE   4B                     LD   C,E   
01DF                          IF   CHECKED   
                              CALL   chkbrk   ; ... and at every word return
01DF                          ENDIF      
01DF   D7                     RST   10h   
01E0                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
01E0                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
01E0                             ; the body"s address instead. Either way it then skips to the matching "]'.
01E0   0A           H_DEF:    LD   A,(BC)   
01E1   03                     INC   BC   
01E2   5F                     LD   E,A   
01E3   E6 DF                  AND   0DFh   ; fold case
01E5   D6 41                  SUB   "A"   
01E7   FE 1A                  CP   26   
01E9   30 0E                  JR   NC,def2   ; not a letter
01EB   7B                     LD   A,E   
01EC   D6 41                  SUB   "A"   ; 0-25 or 32-57: lowercase lands 64 bytes up
01EE   87                     ADD   A,A   
01EF   5F                     LD   E,A   
01F0   16 82                  LD   D,LETPAGE   ; DE -> cell
01F2   79                     LD   A,C   
01F3   12                     LD   (DE),A   
01F4   1C                     INC   E   
01F5   78                     LD   A,B   
01F6   12                     LD   (DE),A   
01F7   18 BC                  JR   skipnx   
01F9                DEF2:        
01F9                          IF   CHECKED   
                              LD   A,E   
                              CP   " "   
                              JP   NZ,e_brack   ; anything but a letter or a space
01F9                          ENDIF      
01F9   E5                     PUSH   HL   ; an anonymous block: push its address
01FA   60                     LD   H,B   
01FB   69                     LD   L,C   
01FC   18 B7                  JR   skipnx   
01FE                             ; skip: read past text to the closer at this level, and return it in A.
01FE                             ; Brackets of both kinds count together; strings are stepped over whole. A
01FE                             ; NUL first ends the program (for "\" with no closer; anything else that runs
01FE                             ; into the NUL had unbalanced brackets anyway).
01FE   16 00        SKIP:     LD   D,0   
0200   0A           SK1:      LD   A,(BC)   
0201   03                     INC   BC   
0202   B7                     OR   A   
0203   CA 03 00               JP   Z,endprog   
0206   FE 22                  CP   22h   
0208   20 05                  JR   NZ,sk2   
020A   CD 28 02               CALL   skipstr   
020D   18 F1                  JR   sk1   
020F   FE 28        SK2:      CP   "("   
0211   28 12                  JR   Z,sk3   
0213   FE 5B                  CP   "["   
0215   28 0E                  JR   Z,sk3   
0217   FE 29                  CP   ")"   
0219   28 04                  JR   Z,sk4   
021B   FE 5D                  CP   "]"   
021D   20 E1                  JR   NZ,sk1   
021F   14           SK4:      INC   D   
0220   15                     DEC   D   
0221   C8                     RET   Z   ; the closer at this level
0222   15                     DEC   D   
0223   18 DB                  JR   sk1   
0225   14           SK3:      INC   D   
0226   18 D8                  JR   sk1   
0228                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
0228                             ; the next character, so "/"" does not end it.
0228   0A           SKIPSTR:   LD   A,(BC)   
0229   03                     INC   BC   
022A   FE 2F                  CP   "/"   
022C   20 03                  JR   NZ,ss1   
022E   03                     INC   BC   
022F   18 F7                  JR   skipstr   
0231   FE 22        SS1:      CP   22h   
0233   20 F3                  JR   NZ,skipstr   
0235   C9                     RET      
0236                             ; =============================================================================
0236                             ;  Console
0236                             ; =============================================================================
0236                             ; 22h pushes the address of the text after it and skips the string.
0236   E5           H_STR:    PUSH   HL   
0237   60                     LD   H,B   
0238   69                     LD   L,C   
0239   CD 28 02               CALL   skipstr   
023C   D7                     RST   10h   
023D                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
023D                             ; 40h-7Fh clears its bit 6 (/M is CR, /` is space); plus anything lower gives
023D                             ; that character itself.
023D   7E           H_PRINT:   LD   A,(HL)   
023E   23                     INC   HL   
023F   FE 22                  CP   22h   
0241   28 11                  JR   Z,prdone   
0243   FE 2F                  CP   "/"   
0245   20 08                  JR   NZ,pr1   
0247   7E                     LD   A,(HL)   
0248   23                     INC   HL   
0249   FE 40                  CP   40h   
024B   38 02                  JR   C,pr1   
024D   E6 BF                  AND   0BFh   
024F   CD 03 FF     PR1:      CALL   putc   
0252   18 E9                  JR   h_print   
0254   CF           PRDONE:   RST   08h   
0255   7D           H_EMIT:   LD   A,L   ; "'"
0256   CD 03 FF               CALL   putc   
0259   CF                     RST   08h   
025A                             ; "#" prints TOS as a signed decimal number, with no space after it.
025A   CB 7C        H_NUM:    BIT   7,H   
025C   28 08                  JR   Z,num1   
025E   3E 2D                  LD   A,"-"   
0260   CD 03 FF               CALL   putc   
0263   CD F1 00               CALL   neg16   
0266   C5           NUM1:     PUSH   BC   
0267   CD 6C 02               CALL   pdec   
026A   C1                     POP   BC   
026B   CF                     RST   08h   
026C                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits)
026C   11 0A 00     PDEC:     LD   DE,10   
026F   CD 32 01               CALL   udiv   ; BC = HL / 10, HL = digit
0272   7D                     LD   A,L   
0273   F5                     PUSH   AF   
0274   60                     LD   H,B   
0275   69                     LD   L,C   
0276   7C                     LD   A,H   
0277   B5                     OR   L   
0278   C4 6C 02               CALL   NZ,pdec   
027B   F1                     POP   AF   
027C   C6 30                  ADD   A,"0"   
027E   C3 03 FF               JP   putc   
0281   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
0282   18 1A                  JR   kt3   
0284                             ; "?" ( n -- c ) or ( -n -- addr )
0284                             ;   n > 0: wait about n ms for a key; 0 if none came
0284                             ;   n = 0: wait for a key
0284                             ;   n < 0: read a line of at most -n characters, with echo. n is not
0284                             ;          checked: the buffer holds 127 characters and the CR, so a
0284                             ;          program must ask for 127 or fewer.
0284   CB 7C        H_KEY:    BIT   7,H   
0286   20 1A                  JR   NZ,line   
0288   11 28 00     KT1:      LD   DE,MSLOOP   ; one millisecond, roughly
028B   CD 06 FF     KT2:      CALL   getk   
028E   20 0E                  JR   NZ,kt3   
0290   1B                     DEC   DE   
0291   7A                     LD   A,D   
0292   B3                     OR   E   
0293   20 F6                  JR   NZ,kt2   
0295   7C                     LD   A,H   ; 0? never counts down: it waits
0296   B5                     OR   L   
0297   28 EF                  JR   Z,kt1   
0299   2B                     DEC   HL   
029A   7C                     LD   A,H   
029B   B5                     OR   L   
029C   20 EA                  JR   NZ,kt1   ; A = 0 if the time ran out
029E   6F           KT3:      LD   L,A   
029F   26 00                  LD   H,0   
02A1   D7                     RST   10h   
02A2                          IF   CPM   
                                 ; CP/M: BDOS 10 does the editing (the spec allows the platform's
                                 ; own line editor). It doesn't store the CR, so it is added here.
                    LINE:     XOR   A   
                              SUB   L   ; A = the count (TOS is minus the count)
                              LD   (LBHDR),A   
                              PUSH   BC   
                              EXX      
                              PUSH   HL   
                              EXX      
                              LD   DE,LBHDR   
                              LD   C,10   
                              CALL   BDOS   
                              EXX      
                              POP   HL   
                              EXX      
                              POP   BC   
                              LD   HL,LBHDR+1   
                              LD   E,(HL)   ; count
                              LD   D,0   
                              INC   HL   ; HL = LINEBUF
                              PUSH   HL   
                              ADD   HL,DE   
                              LD   (HL),13   
                              POP   HL   
                              RST   10h   
02A2                          ENDIF      
02A2                          IFN   CPM   
02A2                             ; Generic: Backspace takes the last character back (and is echoed as
02A2                             ; it is), CR ends (stored, not echoed), every other key is stored and
02A2                             ; echoed until the line is full. The line buffer starts at offset 80h
02A2                             ; of its page, so L alone is the place in the line: D holds the L of
02A2                             ; a full line.
02A2   3E 80        LINE:     LD   A,LINEBUF & 0FFh   
02A4   95                     SUB   L   ; (TOS is minus the count)
02A5   57                     LD   D,A   ; D = the L of a full line
02A6   21 80 82               LD   HL,LINEBUF   
02A9   CD 06 FF     LN2:      CALL   getk   
02AC   28 FB                  JR   Z,ln2   
02AE   FE 0D                  CP   13   
02B0   28 18                  JR   Z,ln5   
02B2   FE 08                  CP   8   
02B4   28 0D                  JR   Z,ln4   
02B6   5F                     LD   E,A   
02B7   7D                     LD   A,L   
02B8   BA                     CP   D   
02B9   28 EE                  JR   Z,ln2   ; full
02BB   73                     LD   (HL),E   
02BC   2C                     INC   L   
02BD   7B                     LD   A,E   
02BE   CD 03 FF     LN3:      CALL   putc   
02C1   18 E6                  JR   ln2   
02C3   2D           LN4:      DEC   L   ; Backspace: one back, and echo it,
02C4   FA BE 02               JP   M,ln3   ;   unless the line was empty (L left the
02C7   2C                     INC   L   ;   upper half of the page)
02C8   18 DF                  JR   ln2   
02CA   77           LN5:      LD   (HL),A   ; the CR
02CB   2E 80                  LD   L,LINEBUF & 0FFh   
02CD   D7                     RST   10h   
02CE                          ENDIF      
02CE                             ; =============================================================================
02CE                             ;  Machine code: the grave
02CE                             ; =============================================================================
02CE                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
02CE                             ; are stored from addr until a non-hex character; then a RET (C9h) is
02CE                             ; written and its address is left. An odd last digit is consumed and dropped.
02CE                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
02CE                             ; code is entered by CALL with the data stack above the return address; it
02CE                             ; must keep BC, and on return the top cell becomes the new TOS.
02CE   0A           H_GRAVE:   LD   A,(BC)   
02CF   CD FC 02               CALL   hexval   
02D2   38 17                  JR   C,exec   
02D4   0A           HX1:      LD   A,(BC)   
02D5   CD FC 02               CALL   hexval   
02D8   38 0E                  JR   C,hx2   
02DA   03                     INC   BC   
02DB                          IF   CHECKED   
                              CALL   chkst   
02DB                          ENDIF      
02DB   77                     LD   (HL),A   ; the high digit goes in first ...
02DC   0A                     LD   A,(BC)   
02DD   CD FC 02               CALL   hexval   
02E0   38 06                  JR   C,hx2   ; odd digit: consumed, and the RET below
02E2   03                     INC   BC   ;   overwrites it
02E3   ED 6F                  RLD      ; ... and RLD shifts it up under the low one
02E5   23                     INC   HL   
02E6   18 EC                  JR   hx1   
02E8                HX2:         
02E8                          IF   CHECKED   
                              CALL   chkst   
02E8                          ENDIF      
02E8   36 C9                  LD   (HL),0C9h   
02EA   D7                     RST   10h   
02EB   D9           EXEC:     EXX      
02EC   22 34 82               LD   (RSAVE),HL   ; machine code may change the alternates
02EF   D9                     EXX      
02F0   11 F5 02               LD   DE,exret   
02F3   D5                     PUSH   DE   
02F4   E9                     JP   (HL)   
02F5   D9           EXRET:    EXX      
02F6   2A 34 82               LD   HL,(RSAVE)   
02F9   D9                     EXX      
02FA   E1                     POP   HL   
02FB   D7                     RST   10h   
02FC                             ; hexval: A = a character; returns its value 0-15 with carry clear, or
02FC                             ; carry set if it isn't a hex digit (0-9, A-F, a-f).
02FC   D6 30        HEXVAL:   SUB   "0"   
02FE   FE 0A                  CP   10   
0300   3F                     CCF      
0301   D0                     RET   NC   
0302   E6 DF                  AND   0DFh   
0304   D6 11                  SUB   11h   
0306   FE 06                  CP   6   
0308   3F                     CCF      
0309   D8                     RET   C   
030A   C6 0A                  ADD   A,10   
030C   C9                     RET      
030D                             ; =============================================================================
030D                             ;  Console layer: getk returns a waiting key in A (zero flag clear), or
030D                             ;  A = 0 with the zero flag set when none is waiting. putc prints A.
030D                             ;  Both keep BC, DE, HL and HL". In the generic build they are the host"s
030D                             ;  KEY and CONOUT routines themselves.
030D                             ; =============================================================================
030D                          IF   (1-CPM)*(1-CHECKED)   
030D                GETK:     EQU   KEY   ; the host's routine does the whole job
030D                          ENDIF      
030D                          IF   CHECKED   
                    GETK:     LD   A,(KEYBUF)   ; a key held back by the break check
                              OR   A   
                              JR   Z,gk1   
                              PUSH   AF   
                              XOR   A   
                              LD   (KEYBUF),A   
                              POP   AF   
                              RET      
030D                          ENDIF      
030D                          IF   (1-CPM)*CHECKED   
                    GK1:      JP   KEY   
030D                          ENDIF      
030D                          IF   CPM*(1-CHECKED)   
                    GETK:        
030D                          ENDIF      
030D                          IF   CPM   
                    GK1:      LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
                              CALL   putc   
                              OR   A   
                              RET      
                                 ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
                                 ; printing and could swallow a key that BDOS 6 then never sees.
                    PUTC:     PUSH   BC   
                              PUSH   DE   
                              PUSH   HL   
                              EXX      
                              PUSH   HL   
                              EXX      
                              LD   E,A   
                              LD   C,6   
                              CALL   BDOS   
                              EXX      
                              POP   HL   
                              EXX      
                              POP   HL   
                              POP   DE   
                              POP   BC   
                              RET      
030D                          ENDIF      
030D                          IFN   CPM   
030D                PUTC:     EQU   CONOUT   
030D                          ENDIF      
030D                             ; =============================================================================
030D                             ;  Checked build: break key and error reports
030D                             ; =============================================================================
030D                          IF   CHECKED   
                                 ; chkbrk: a waiting key is read now; Ctrl-C stops the program, anything
                                 ; else is held for the next "?".
                    CHKBRK:   LD   A,(KEYBUF)   
                              OR   A   
                              RET   NZ   ; one key is already held
                              CALL   getk   
                              RET   Z   
                              CP   3   
                              JR   Z,e_break   
                              LD   (KEYBUF),A   
                              RET      
                                 ; Error entries. Each loads its letter and then hides the next entry inside
                                 ; a 3-byte LD HL,nn (the 21h), so they all fall through to `error`.
                    E_STACK:   LD   A,"S"   ; data stack over or under
                              DB   21h   
                    E_RSTACK:   LD   A,"R"   ; return stack over or under
                              DB   21h   
                    E_BREAK:   LD   A,"B"   ; Ctrl-C
                              DB   21h   
                    E_HEAP:   LD   A,"H"   ; heap past the limit
                              DB   21h   
                    E_STORE:   LD   A,"W"   ; write outside the program's space
                              DB   21h   
                    E_BRACK:   LD   A,"D"   ; bad character after [
                                 ; error: print the letter in A, " @ " and the offset in the program of the
                                 ; character just read, then end. For example: S @ 245
                    ERROR:    LD   SP,DSTOP   ; the stacks may be wrecked: start clean
                              CALL   putc   
                              LD   A," "   
                              CALL   putc   
                              LD   A,"@"   
                              CALL   putc   
                              LD   A," "   
                              CALL   putc   
                              LD   HL,(0-PROG-1)&0FFFFh   ; minus the address of the character
                              ADD   HL,BC   ;   just read: HL = its offset
                              CALL   pdec   
                              JP   endprog   
030D                          ENDIF      
030D                             ; =============================================================================
030D                             ;  Startup
030D                             ; =============================================================================
030D                START:       
030D                          IF   CPM   
                                 ; CP/M: the RAM pages follow the image; the heap may grow to the BDOS
                              LD   SP,DSTOP   
                              LD   HL,stubs   ; RST 08h and RST 10h stubs into page zero
                              LD   DE,0008h   
                              LD   BC,13   
                              LDIR      
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   
                              CALL   BDOS   
                              INC   A   
                              JP   Z,0   ; no such file: back to CP/M
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              OR   A   
                              JR   Z,ld1   
                              LD   HL,-128   ; the failed read left nothing: back up
                              ADD   HL,DE   
                              LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   
                              LD   (HEAP),HL   
                              LD   A,(0007h)   ; the BDOS page is the heap limit
                              LD   (HLIM),A   
030D                          ENDIF      
030D                          IFN   CPM   
030D   31 FE 81               LD   SP,DSTOP   
0310   21 00 83               LD   HL,PROG   ; the heap starts after the program's NUL
0313   AF                     XOR   A   
0314   47                     LD   B,A   
0315   4F                     LD   C,A   
0316   ED B1                  CPIR      
0318   22 7C 82               LD   (HEAP),HL   
031B                          ENDIF      
031B                          IF   (1-CPM)*CHECKED   
                              LD   A,HEAPLIM   
                              LD   (HLIM),A   
031B                          ENDIF      
031B   D9                     EXX      
031C   21 E0 80               LD   HL,RSTOP   
031F   D9                     EXX      
0320                          IF   CHECKED   
                              XOR   A   
                              LD   (KEYBUF),A   
0320                          ENDIF      
0320   01 00 83               LD   BC,PROG   
0323   C3 11 00               JP   next0   
0326                          IF   CPM   
                    STUBS:    POP   DE   ; 0008h: drop, then next
                              POP   HL   
                              JP   next0   
                              DB   0,0,0   
                              POP   DE   ; 0010h: next
                              JP   next0   
                    ENDPROG:   EQU   0   ; warm boot
                    DROP_NEXT:   EQU   0009h   
                                 ; RAM pages, after the image
                    RSPAGE:   EQU   (imgend + 255) / 256   
                    DSPAGE:   EQU   RSPAGE + 1   
                    LETPAGE:   EQU   RSPAGE + 2   
                    PROG:     EQU   LETPAGE*256 + 256   
0326                          ENDIF      
0326                IMGEND:      


