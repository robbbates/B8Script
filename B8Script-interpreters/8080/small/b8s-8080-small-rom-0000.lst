0544                          IF   FAST*(1-CHECKED)   
                                 ; a-z, unchecked: a variable followed by "@" or "!" is fetched or stored in
                                 ; the same step.
                    FVA:      LXI   H,LET+40h+0   ; a
                              LDAX   B   
                              CPI   "@"   
                              JZ   fvat   
                              CPI   "!"   
                              JZ   fvst   
                              PUSH   D   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FVB:      LXI   H,LET+40h+2   ; b
                              LDAX   B   
                              CPI   "@"   
                              JZ   fvat   
