E514   E9 11                  SBC   #11h   ; (the carry is set)
E516   C9 06                  CMP   #6   
E518   B0 0F                  BCS   ic9   
E51A   69 0A                  ADC   #10   
E51C   D0 03                  BNE   incip   ; always
E51E                             ; Reading the program
E51E                             ;    peek: A = the character at IP, IP unchanged, Y = 0
E51E                             ;    getc: the same, then IP moves on; flags follow A
E51E                             ;    incip: IP moves on; keeps A, the carry and Y
E51E   20 2A E5     GETC:     JSR   peek   
