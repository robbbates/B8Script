E349   CC 00 0A     PDEC:     LDD   #10   
E34C   36 06                  PSHU   D   
E34E                          IF   (1-CHECKED)*(1-QK)   
                              BSR   udiv   ; NOS = quotient, TOS = digit
E34E                          ENDIF      
E34E                          IF   CHECKED*(1-QK)   
                              LBSR   udiv   ; (out of a BSR's reach here)
E34E                          ENDIF      
E34E                          IF   SBASEU   
                              BSR   ud0   ; (base: past the power-of-two test)
E34E                          ENDIF      
E34E                          IF   QK-SBASEU   
