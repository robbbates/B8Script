0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Motorola 6809
0000                             ;  Spec: docs/b8script.md (2026-11-21).
0000                             ;  Follows the design of the Z80 interpreter (z80/b8s-z80.asm).
0000                             ; 
0000                             ;  Two builds, selected by the CHECKED line below (CPM is always 0: the 6809
0000                             ;  has no CP/M; the line is kept only so that build.sh works):
0000                             ;    CHECKED  0 = no checks (spec: an unchecked build checks nothing)
0000                             ;             1 = a checked build: variables start at 0, words start
0000                             ;                 undefined, and every error in the spec's table stops the
0000                             ;                 program with the four-line report, then goes to EXIT:
0000                             ;                   Err X @ line,col
0000                             ;                   <up to 16 characters of the text at the place>
0000                             ;                   Stk n: ... v v v      (n = depth, then the top 8 values)
0000                             ;                   Rtn n
0000                             ;                 S/s data stack over/underflow, R/r return stack over/
0000                             ;                 underflow, H heap, O store outside the program's space,
0000                             ;                 W bad character after [, U undefined word, Q no closing
0000                             ;                 quote, X reserved byte, Z divide by zero, N unbalanced or
0000                             ;                 mismatched brackets, B Ctrl-C.
0000                             ; 
0000                             ;  Assembler: asm80, M6809 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   0   ; always 0 (no CP/M on the 6809)
0000                CHECKED:   EQU   1   ; 1 = checked build
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    Y    IP: the address of the next program character to read
0000                             ;    U    the data stack pointer. The stack grows down and U points at the
0000                             ;         top cell (TOS); nothing is cached in a register, because every
0000                             ;         dispatch needs A, B and X as scratch. Cells are big-endian here.
0000                             ;         (Only the stacks are big-endian: cells in RAM that the program can
0000                             ;         see - variables, the heap pointer, anything @ and ! reach - are
0000                             ;         little-endian, as the spec says, so @ and ! swap the bytes.)
0000                             ;    S    the return stack. A word call is a plain push of Y. Entries are
0000                             ;         2 bytes, big-endian. Handlers are called with JSR, so the return
0000                             ;         address of the dispatcher is on top of S while a handler runs.
0000                             ;    DP   the letter page, so the letter-page variables below cost 2-byte
0000                             ;         direct addressing. Nothing else may change DP.
0000                             ;    A B X are scratch. Every handler is entered by JSR and ends in RTS (one
0000                             ;    byte). A handler that pushes or pops the return stack first pulls the
0000                             ;    dispatcher's return address into X (PULS X) and ends with JMP ,X.
0000                             ; 
0000                             ;  Dispatch (unchecked build). PTAB holds one byte per punctuation character:
0000                             ;  the low byte of the handler's distance from PTAB. The handlers of the last
0000                             ;  characters (in code order) start within 256 bytes after PTAB, the handlers
0000                             ;  of the first NPG1 characters in the 256 bytes after that. The assembler
0000                             ;  works NPG1 out from where five handlers landed, and testing/chktab09.py
0000                             ;  checks the layout. The checked build is bigger than that reach, so its
0000                             ;  table holds whole addresses instead.
0000                             ; -----------------------------------------------------------------------------
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM areas:
0000                             ; 
0000                             ;    8000h-80FFh  return stack (S); empty = 8100h. Unchecked: 127 entries.
0000                             ;                 Checked: 112 entries (S down to 8020h); the 32 bytes below
0000                             ;                 are a guard band for what a handler and an interrupt push
0000                             ;                 on top of a full stack before the check runs.
0000                             ;    8100h-81FFh  data stack (U). Unchecked: 127 cells, empty = 8200h.
0000                             ;                 Checked: 126 cells (U from 81FCh, empty, down to 8100h):
0000                             ;                 the 4 bytes above are a guard band, so a handler that runs
0000                             ;                 on an empty stack writes there and not on the letter
0000                             ;                 cells. A push past the last cell lands on the return
0000                             ;                 stack's bottom entry (80FEh), and the program stops with S
0000                             ;                 before anything reads it.
0000                             ;    8200h-82FFh  letter page (LET): A..Z at +00h..+33h, a..z at +40h..+73h
0000                             ;                 (a word cell is always 64 bytes below its variable), the
0000                             ;                 heap pointer at +7Ch (= z10+), interpreter variables in the
0000                             ;                 gaps, and the -n? line buffer at +80h..+FFh. +7Ah and +7Bh
0000                             ;                 are kept free.
0000                             ;    8300h-       PROG, the program text, NUL-terminated; the heap starts
0000                             ;                 after the NUL and grows to HEAPLIM*256 (F000h)
0000                             ;    F000h-       this image (ROM). The reset vector (FFFEh) must point to
0000                             ;                 `start` (see the listing); the image does not contain it.
0000                             ;    FF03h-FF0Bh  the console routines (CONOUT, KEY) and EXIT are supplied
0000                             ;                 by the system and need no space here.
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range LET..HEAPLIM*256.
0000                             ; -----------------------------------------------------------------------------
0000                             ; ---- generic machine: edit these to suit -----------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The Z flag must match A (end the
0000                             ;   routine with TSTA / RTS, or a plain LDA).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                             ;   Both are called with JSR. They may change A and CC and must preserve
0000                             ;   B, X, Y, U and DP.
0000                RSPAGE:   EQU   80h   
0000                DSPAGE:   EQU   81h   
0000                LETPAGE:   EQU   82h   
0000                PROG:     EQU   8300h   ; where the loader puts the program text
0000                             ; (the checked startup counts on it being
0000                             ; the page after LETPAGE)
0000                HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
0000                MSLOOP:   EQU   20   ; n? inner loop count for about 1 ms; tune it
0000                             ; for your clock and your KEY routine
0000                             ; letter-page layout (direct-page offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   7Ch   ; z10+, the heap pointer (little-endian)
0000                KEYBUF:   EQU   34h   ; gap after Z: a key held back by the break check
0000                AT:       EQU   36h   ; checked: the address of the character being
0000                             ;   run (big-endian), the place an error reports
0000                PEND:     EQU   38h   ; checked: the program's end, the first byte
0000                             ;   after its NUL (big-endian): the heap's floor
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+100h   ; empty return stack
0000                RSLIM:    EQU   RSPAGE*256+20h   ; checked: S may go no lower between characters
0000                RSREP:    EQU   RSTOP-16   ; checked: S while the error report runs
0000                DSTOP:    EQU   DSPAGE*256+100h-4*CHECKED   ; empty data stack (a guard if checked)
0000                DSLIM:    EQU   DSPAGE*256   ; checked: U may go no lower between characters
F000                          .ORG   0F000h   
F000   7E FF 09     FIN:      JMP   EXIT   ; the program has ended
F003                             ; =============================================================================
F003                             ;  Startup
F003                             ; =============================================================================
F003   10 CE 81 00  START:    LDS   #RSTOP   
F007   CE 81 FC               LDU   #DSTOP   
F00A   86 82                  LDA   #LETPAGE   
F00C   1F 8B                  TFR   A,DP   
F00E                          IF   CHECKED   
F00E                             ; Zero the whole letter page: every variable starts at 0, every word
F00E                             ; cell at 0 (undefined: a call stops with U), and so do the
F00E                             ; interpreter's own cells in the gaps (KEYBUF and the rest). A is
F00E                             ; still LETPAGE; 256 rounds leave X at the next page, PROG.
F00E   5F                     CLRB      
F00F   1F 01                  TFR   D,X   
F011   6F 80        SZ:       CLR   ,X+   
F013   5A                     DECB      
F014   26 FB                  BNE   sz   
F016                          ENDIF      
F016                          IF   1-CHECKED   
                              LDX   #PROG   ; the heap starts after the program's NUL
F016                          ENDIF      
F016   A6 80        SC:       LDA   ,X+   
F018   26 FC                  BNE   sc   
F01A   1F 10                  TFR   X,D   
F01C   D7 7C                  STB   <HEAP   ; (little-endian)
F01E   97 7D                  STA   <HEAP+1   
F020                          IF   CHECKED   
F020   9F 38                  STX   <PEND   ; the heap may never go below this
F022                          ENDIF      
F022   10 8E 83 00            LDY   #PROG   
F026                             ; =============================================================================
F026                             ;  The inner loop: read one character and sort it by range.
F026                             ; 
F026                             ;    00h          end of program
F026                             ;    01h-20h, 7Fh       ignored (control, space, DEL)
F026                             ;    80h-FFh      reserved: ignored, or X in the checked build
F026                             ;    30h-39h      digit: read a whole number
F026                             ;    41h-5Ah      A-Z: call the word in that letter's cell
F026                             ;    61h-7Ah      a-z: push the address of that letter's cell
F026                             ;    the rest     punctuation: JSR through PTAB, 32 entries, in code order
F026                             ; =============================================================================
F026                NEXT:        
F026                          IF   CHECKED   
F026                             ; Both stacks are checked once per character, not in every handler:
F026                             ; the pointer minus its limit, taken as unsigned, must be no more
F026                             ; than the stack's size. Below the limit (an overflow) it wraps to
F026                             ; FFxxh, and the compare leaves N set; above the empty point (an
F026                             ; underflow) it is just over the size, and N is clear.
F026   30 C9 7F 00            LEAX   (0-DSLIM)&0FFFFh,U   
F02A   8C 00 FC               CMPX   #DSTOP-DSLIM   
F02D   22 5E                  BHI   e_ds   
F02F   30 E9 7F E0            LEAX   (0-RSLIM)&0FFFFh,S   
F033   8C 00 E0               CMPX   #RSTOP-RSLIM   
F036   22 5E                  BHI   e_rs   
F038   10 9F 36               STY   <AT   ; the place, should this character fail
F03B                          ENDIF      
F03B   A6 A0                  LDA   ,Y+   
F03D   27 C1                  BEQ   fin   ; NUL ends the program
F03F   80 21                  SUBA   #21h   ; A = c - 21h
F041   25 E3                  BLO   next   ; 01h-20h ignored
F043   81 0F                  CMPA   #0Fh   
F045   25 24                  BLO   punct   ; 21h-2Fh: PTAB index 0-14
F047   80 0F                  SUBA   #0Fh   ; A = c - 30h
F049   81 0A                  CMPA   #0Ah   
F04B   25 26                  BLO   digit   ; 30h-39h
F04D   81 11                  CMPA   #11h   
F04F   25 18                  BLO   p3a   ; 3Ah-40h
F051   80 11                  SUBA   #11h   ; A = c - 41h
F053   81 1A                  CMPA   #1Ah   
F055   25 28                  BLO   upper   ; 41h-5Ah: A = letter index 0-25
F057   81 20                  CMPA   #20h   
F059   25 0C                  BLO   p5b   ; 5Bh-60h
F05B   81 3A                  CMPA   #3Ah   
F05D   25 1A                  BLO   lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
F05F   81 3E                  CMPA   #3Eh   
F061                          IF   1-CHECKED   
                              BHS   next   ; 7Fh-FFh: ignored
F061                          ENDIF      
F061                          IF   CHECKED   
F061   27 C3                  BEQ   next   ; 7Fh (DEL): ignored
F063   22 40                  BHI   e_resv   ; 80h-FFh: reserved
F065                          ENDIF      
F065   80 1A                  SUBA   #1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
F067   80 09        P5B:      SUBA   #9   ; 5Bh-60h: -4 in all, index 22-27
F069   8B 05        P3A:      ADDA   #5   ; 3Ah-40h: index 15-21
F06B                             ; Punctuation: A = the PTAB index.
F06B   8E F0 D9     PUNCT:    LDX   #PTAB   
F06E                          IF   1-CHECKED   
                                 ; The handler is at PTAB + D, where B is the table byte and A is 1
                                 ; for the first NPG1 characters, 0 for the rest.
                              LDB   A,X   
                              CMPA   #NPG1   ; carry: one of the first NPG1
                              LDA   #0   ; (leaves the carry alone)
                              ROLA      
                              JSR   D,X   ; the handler ends in RTS
F06E                          ENDIF      
F06E                          IF   CHECKED   
F06E   48                     ASLA      ; the table holds whole addresses
F06F   AD 96                  JSR   [A,X]   
F071                          ENDIF      
F071   20 B3                  BRA   next   
F073                             ; Digits: step back onto the first digit and read the whole number.
F073   31 3F        DIGIT:    LEAY   -1,Y   
F075   8D 44                  BSR   rdnum   
F077   20 AD                  BRA   next   
F079                             ; a-z: push the cell's address (the cell is the variable)
F079   8D 32        LOWER:    BSR   cellx   
F07B   36 10                  PSHU   X   
F07D   20 A7                  BRA   next   
F07F                             ; A-Z: call the word. The IP (the address after the letter) goes on the
F07F                             ; return stack, and the IP becomes the address in the letter's cell.
F07F                             ; Checked: a cell still 0 (high byte 0) was never defined, since every
F07F                             ; address in the program's space is 8200h or more. The call has not been
F07F                             ; made yet, so the report shows the stacks as they were.
F07F   8D 2C        UPPER:    BSR   cellx   
F081   E6 84                  LDB   ,X   
F083   A6 01                  LDA   1,X   
F085                          IF   CHECKED   
F085   27 21                  BEQ   e_undef   
F087                          ENDIF      
F087   34 20                  PSHS   Y   
F089   1F 02                  TFR   D,Y   
F08B   20 99                  BRA   next   
F08D                             ; =============================================================================
F08D                             ;  Checked build: the error entries.
F08D                             ; 
F08D                             ;  Each entry loads its letter and then hides the next entry inside a 3-byte
F08D                             ;  CMPX # (the 8Ch), so that a run of them falls through to one place. The
F08D                             ;  place an error reports is the address in AT, which the inner loop sets to
F08D                             ;  each character before it runs it; the one error that reports another
F08D                             ;  place (W, at the character after the [) changes AT before it comes.
F08D                             ; 
F08D                             ;  The report counts the return stack from S, so S must be what the program
F08D                             ;  left there. The entries reached from a handler (after h_cstore, just
F08D                             ;  ahead of the report) first drop the dispatcher's return address, and the
F08D                             ;  return address of chkst or chkbrk, which are one call deeper. The inner
F08D                             ;  loop's own entries (here, where its short branches reach them) need
F08D                             ;  nothing dropped.
F08D                             ; =============================================================================
F08D                          IF   CHECKED   
F08D                             ; ---- reached from the inner loop -------------------------------------------
F08D                             ; The stack checks branch here with N set for an overflow (the pointer is
F08D                             ; below its limit) and clear for an underflow. After an underflow that stack
F08D                             ; counts as empty.
F08D   2B 10        E_DS:     BMI   e_S   
F08F   CE 81 FC               LDU   #DSTOP   ; s
F092   86 73                  LDA   #"s"   
F094   20 14                  BRA   eall   
F096   2B 0A        E_RS:     BMI   e_R   
F098   10 CE 81 00            LDS   #RSTOP   ; r
F09C   86 72                  LDA   #"r"   
F09E   8C                     FCB   8Ch   
F09F   86 53        E_S:      LDA   #"S"   
F0A1   8C                     FCB   8Ch   
F0A2   86 52        E_R:      LDA   #"R"   
F0A4   8C                     FCB   8Ch   
F0A5   86 58        E_RESV:   LDA   #"X"   ; a reserved byte (80h-FFh) outside a string
F0A7   8C                     FCB   8Ch   
F0A8   86 55        E_UNDEF:   LDA   #"U"   ; a word never defined (its cell is still 0)
F0AA   7E F3 36     EALL:     JMP   error   
F0AD                          ENDIF      
F0AD                             ; cellx: A = letter index (0-25, or 32-57 for lowercase) -> X = cell address
F0AD   48           CELLX:    ASLA      
F0AE   8E 82 00               LDX   #LET   
F0B1   30 86                  LEAX   A,X   
F0B3   39                     RTS      
F0B4                             ; isdig: A = the character at IP minus "0"; the carry is set if it is a digit
F0B4   A6 A4        ISDIG:    LDA   ,Y   
F0B6   80 30                  SUBA   #"0"   
F0B8   81 0A                  CMPA   #10   
F0BA   39           AB9:      RTS      
F0BB                             ; rdnum: read decimal digits at IP and push the value; IP is left on the
F0BB                             ; first non-digit. Values wrap at 16 bits, as the spec says. The running
F0BB                             ; value lives in the new top cell: V = V*10 + digit.
F0BB   4F           RDNUM:    CLRA      
F0BC   5F                     CLRB      
F0BD   36 06                  PSHU   D   
F0BF   8D F3        RD1:      BSR   isdig   
F0C1   24 F7                  BHS   ab9   
F0C3   31 21                  LEAY   1,Y   
F0C5   34 02                  PSHS   A   
F0C7   EC C4                  LDD   ,U   
F0C9   58                     ASLB      
F0CA   49                     ROLA      
F0CB   58                     ASLB      
F0CC   49                     ROLA      
F0CD   E3 C4                  ADDD   ,U   ; 5V
F0CF   58                     ASLB      
F0D0   49                     ROLA      ; 10V
F0D1   EB E0                  ADDB   ,S+   
F0D3   89 00                  ADCA   #0   
F0D5   ED C4                  STD   ,U   
F0D7   20 E6                  BRA   rd1   
F0D9                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
F0D9                             ; and return its value in A with the carry set; otherwise leave the IP and
F0D9                             ; return with the carry clear.
F0D9                             ; (In the unchecked build it is here, ahead of the table, to leave room in
F0D9                             ; the two ranges after it; the checked build has it next to the grave.)
F0D9                          IF   1-CHECKED   
                    HEXC:     BSR   isdig   
                              BLO   hv1   ; C = 1
                              ANDA   #0DFh   
                              SUBA   #11h   
                              CMPA   #6   
                              BHS   hv9   ; C = 0
                              SUBA   #0F6h   ; + 10, and sets the carry
                    HV1:      LEAY   1,Y   ; (LEAY leaves the carry alone)
                    HV9:      RTS      
F0D9                          ENDIF      
F0D9                             ; =============================================================================
F0D9                             ;  Dispatch table, in code order.
F0D9                             ; 
F0D9                             ;  Unchecked build: one byte per character, the low byte of the handler's
F0D9                             ;  distance from PTAB. NPG1 is how many characters, from the start, have
F0D9                             ;  handlers more than 255 bytes past PTAB. ] \ [ @ ? sit where the two ranges
F0D9                             ;  meet (in falling code order for this), and which side each lands on is
F0D9                             ;  worked out here. (One division to a line: asm80 only rounds down when it
F0D9                             ;  stores a value.)
F0D9                             ; 
F0D9                             ;  Checked build: it has more code than the two ranges hold, so its table
F0D9                             ;  holds whole addresses and there are no rules about where handlers go.
F0D9                             ; =============================================================================
F0D9                          IF   1-CHECKED   
                    PGRET:    EQU   (h_ret-PTAB)/256   ; 0 = first range, 1 = second
                    PGBRK:    EQU   (h_break-PTAB)/256   
                    PGDEF:    EQU   (h_def-PTAB)/256   
                    PGFET:    EQU   (h_fetch-PTAB)/256   
                    PGKEY:    EQU   (h_key-PTAB)/256   
                    NPG1:     EQU   20 + PGKEY + PGFET + PGDEF + PGBRK + PGRET   
F0D9                          ENDIF      
F0D9                PTAB:        
F0D9                          IF   1-CHECKED   
                              FCB   (h_store-PTAB) & 0FFh   ; !
                              FCB   (h_str-PTAB) & 0FFh   ; "
                              FCB   (h_num-PTAB) & 0FFh   ; #
                              FCB   (h_print-PTAB) & 0FFh   ; $
                              FCB   (h_swap-PTAB) & 0FFh   ; %
                              FCB   (h_and-PTAB) & 0FFh   ; &
                              FCB   (h_emit-PTAB) & 0FFh   ; '
                              FCB   (h_open-PTAB) & 0FFh   ; (
                              FCB   (h_close-PTAB) & 0FFh   ; )
                              FCB   (h_mul-PTAB) & 0FFh   ; *
                              FCB   (h_add-PTAB) & 0FFh   ; +
                              FCB   (h_cfetch-PTAB) & 0FFh   ; ,
                              FCB   (h_sub-PTAB) & 0FFh   ; -
                              FCB   (h_cstore-PTAB) & 0FFh   ; .
                              FCB   (h_div-PTAB) & 0FFh   ; /
                              FCB   (h_dup-PTAB) & 0FFh   ; :
                              FCB   (h_drop-PTAB) & 0FFh   ; ;
                              FCB   (h_lt-PTAB) & 0FFh   ; <
                              FCB   (h_eq-PTAB) & 0FFh   ; =
                              FCB   (h_gt-PTAB) & 0FFh   ; >
                              FCB   (h_key-PTAB) & 0FFh   ; ?
                              FCB   (h_fetch-PTAB) & 0FFh   ; @
                              FCB   (h_def-PTAB) & 0FFh   ; [
                              FCB   (h_break-PTAB) & 0FFh   ; \
                              FCB   (h_ret-PTAB) & 0FFh   ; ]
                              FCB   (h_xor-PTAB) & 0FFh   ; ^
                              FCB   (h_alloc-PTAB) & 0FFh   ; _
                              FCB   (h_grave-PTAB) & 0FFh   ; `
                              FCB   (h_tor-PTAB) & 0FFh   ; {
                              FCB   (h_or-PTAB) & 0FFh   ; |
                              FCB   (h_fromr-PTAB) & 0FFh   ; }
                              FCB   (h_not-PTAB) & 0FFh   ; ~
F0D9                          ENDIF      
F0D9                          IF   CHECKED   
F0D9   F2 F0                  FDB   h_store   ; !
F0DB   F1 FB                  FDB   h_str   ; "
F0DD   F4 08                  FDB   h_num   ; #
F0DF   F2 D7                  FDB   h_print   ; $
F0E1   F2 C3                  FDB   h_swap   ; %
F0E3   F4 2E                  FDB   h_and   ; &
F0E5   F2 CF                  FDB   h_emit   ; '
F0E7   F2 6C                  FDB   h_open   ; (
F0E9   F2 80                  FDB   h_close   ; )
F0EB   F2 8D                  FDB   h_mul   ; *
F0ED   F4 36                  FDB   h_add   ; +
F0EF   F2 78                  FDB   h_cfetch   ; ,
F0F1   F4 3D                  FDB   h_sub   ; -
F0F3   F2 FC                  FDB   h_cstore   ; .
F0F5   F4 48                  FDB   h_div   ; /
F0F7   F2 CA                  FDB   h_dup   ; :
F0F9   F2 D4                  FDB   h_drop   ; ;
F0FB   F2 AB                  FDB   h_lt   ; <
F0FD   F2 B7                  FDB   h_eq   ; =
F0FF   F2 A9                  FDB   h_gt   ; >
F101   F2 1E                  FDB   h_key   ; ?
F103   F2 18                  FDB   h_fetch   ; @
F105   F1 B3                  FDB   h_def   ; [
F107   F1 96                  FDB   h_break   ; \
F109   F1 8F                  FDB   h_ret   ; ]
F10B   F1 21                  FDB   h_xor   ; ^
F10D   F1 3F                  FDB   h_alloc   ; _
F10F   F1 5B                  FDB   h_grave   ; `
F111   F1 2F                  FDB   h_tor   ; {
F113   F1 19                  FDB   h_or   ; |
F115   F1 37                  FDB   h_fromr   ; }
F117   F1 2A                  FDB   h_not   ; ~
F119                          ENDIF      
F119                PTABEND:      
F119                             ; =============================================================================
F119                             ;  Handlers that must start in the first range (within 255 bytes of PTAB)
F119                             ;  in the unchecked build: ^ _ ` 00bbIHwg ~
F119                             ; =============================================================================
F119   EC C1        H_OR:     LDD   ,U++   
F11B   AA C4                  ORA   ,U   
F11D   EA 41                  ORB   1,U   
F11F   20 06                  BRA   st0   
