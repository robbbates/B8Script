0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Intel 8080
0000                             ;  Spec: docs/b8script.md (2026-10-09) plus the 2026-11-20 changes:
0000                             ;        [x stores in a variable, "[ " pushes an anonymous block, any other
0000                             ;        character after [ is an error, the heap pointer lives at z10+.
0000                             ;        The string escape is "/" (it was ">").
0000                             ;  A port of the Z80 interpreter (z80/b8s-z80.asm); same behaviour, same
0000                             ;  memory map, same switches.
0000                             ; 
0000                             ;  Two switches, set in the two EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    CHECKED  0 = no checks (spec: "B8Script checks nothing")
0000                             ;             1 = stops on stack overrun, Ctrl-C, heap past the limit, a store
0000                             ;                 outside the program's own space, and a bad character after [,
0000                             ;                 printing a letter and the place, like  S @ 245
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), I8080 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   0   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   0   ; 1 = checked build
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the 8080"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  The return stack pointer has no register (the 8080 has no spare pair): it
0000                             ;  is the RAM word RSP. Only rpush and rpop (and the checks) touch it; both
0000                             ;  destroy HL, so each caller makes sure TOS is parked or dead first.
0000                             ; 
0000                             ;  (asm80 wants the vector number: RST 1 = RST 08h, RST 2 = RST 10h.)
0000                             ;  A handler ends with RST 10h ("next character") or RST 08h ("drop, then
0000                             ;  next"), one byte each instead of a three-byte JMP. An RST is a CALL, so the
0000                             ;  first thing each stub does is POP D to throw the return address away.
0000                             ; 
0000                             ;  What the 8080 lacks, and what replaces it: no JR (JMP/Jcc), no DJNZ, no
0000                             ;  SBC HL (byte-wise SUB/SBB, or negate and DAD), no shifts on register pairs
0000                             ;  (DAD H doubles; RAL/RAR through A), no LDIR/CPIR (small loops).
0000                             ; -----------------------------------------------------------------------------
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (SP stays inside this page)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch (= z10+), interpreter variables in the gaps, and the -n?
0000                             ;             line buffer at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range LETPAGE..heap top.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
                    BDOS:     EQU   0005h   
0000                          ENDIF      
0000                          IFN   CPM   
0000                             ; ---- generic machine: edit these to suit -----------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The zero flag must match A
0000                             ;   (end the routine with ORA A / RET).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                             ;   KEY and CONOUT must preserve BC, DE and HL.
0000                RSPAGE:   EQU   80h   ; 8000h return stack
0000                DSPAGE:   EQU   81h   ; 8100h data stack
0000                LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
0000                PROG:     EQU   8300h   ; where the loader puts the program text
0000                HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms; tune it
0000                             ; for your clock and your KEY routine
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; z10+, the heap pointer
0000                RSP:      EQU   LET+34h   ; gap after Z: the return stack pointer;
0000                KEYBUF:   EQU   LET+36h   ;   a held-back key;
0000                HLIM:     EQU   LET+3Ah   ;   high byte of the heap limit
0000                LBHDR:    EQU   LET+7Eh   ; CP/M BDOS 10 header: max, count
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FEh   ; empty data stack
0000                             ; =============================================================================
0000                             ;  Page zero (generic ROM) or the start of the .COM file (CP/M)
0000                             ; =============================================================================
0000                          IF   CPM   
                              .ORG   0100h   
                              JMP   start   
0000                          ENDIF      
0000                          IFN   CPM   
0000                          .ORG   0000h   
0000   31 FE 81               LXI   SP,DSTOP   ; 0000h reset: the stack first,
0003   C3 41 03               JMP   start   ;   then the rest of the startup
0006   E3           H_SWAP:   XTHL      ; 0006h the two-byte handlers fill the gaps
0007   D7                     RST   2   ;   between the vectors
0008                             ; ---- RST 08h: drop TOS, then next ------------------------------------------
0008   D1                     POP   D   ; 0008h discard the RST's return address
0009                DROP_NEXT:      
0009   E1                     POP   H   ; new TOS = NOS
000A   C3 11 00               JMP   next0   
000D   E5           H_DUP:    PUSH   H   ; 000Dh
000E   D7                     RST   2   
000F   00                     DB   0   ; 000Fh spare
0010                             ; ---- RST 10h: next character ------------------------------------------------
0010   D1                     POP   D   ; 0010h discard the RST's return address
0011                          ENDIF      
0011                             ; =============================================================================
0011                             ;  The inner loop: read one character and sort it by range.
0011                             ; 
0011                             ;    00h          end of program
0011                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0011                             ;    30h-39h      digit: read a whole number
0011                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0011                             ;    61h-7Ah      a-z: push the address of that letter's cell
0011                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0011                             ; =============================================================================
0011                NEXT0:       
0011                          IF   CHECKED   
                                 ; Both stacks are checked once per character, not in every handler.
                                 ; Each stack lives in one page, so it has overrun exactly when the
                                 ; pointer's high byte has left that page. Errors are caught one cell
                                 ; late at most; the page below each stack is a guard band.
                              XCHG      ; DE = TOS (HL is needed for the pointers)
                              LXI   H,0   
                              DAD   SP   
                              MOV   A,H   
                              CPI   DSPAGE   
                              JNZ   e_stack   
                              LHLD   RSP   ; the return stack: in its page, and not
                              MOV   A,L   ;   above its empty position (an underflow
                              CPI   RSTOP&0FFh+1   ;   would stay inside the page, in the
                              JNC   e_rstack   ;   guard band)
                              MOV   A,H   
                              CPI   RSPAGE   
                              JNZ   e_rstack   
                              XCHG      ; TOS back
0011                          ENDIF      
0011   0A                     LDAX   B   
0012   03                     INX   B   
0013   D6 21                  SUI   21h   ; A = c - 21h
0015   DA 58 00               JC   ctl   ; c < 21h: NUL ends, the rest are ignored
0018   FE 0F                  CPI   0Fh   
001A   DA 4B 00               JC   punct   ; 21h-2Fh: PTAB index 0-14
001D   D6 0F                  SUI   0Fh   ; A = c - 30h
001F   FE 0A                  CPI   0Ah   
0021   DA 75 00               JC   digit   ; 30h-39h
0024   FE 11                  CPI   11h   
0026   D2 2E 00               JNC   ab40   
0029   C6 05                  ADI   5   ; 3Ah-40h: index 15-21
002B   C3 4B 00               JMP   punct   
002E   D6 11        AB40:     SUI   11h   ; A = c - 41h
0030   FE 1A                  CPI   1Ah   
0032   DA 66 00               JC   upper   ; 41h-5Ah: A = letter index 0-25
0035   FE 20                  CPI   20h   
0037   D2 3F 00               JNC   ab60   
003A   D6 04                  SUI   4   ; 5Bh-60h: index 22-27
003C   C3 4B 00               JMP   punct   
003F   FE 3A        AB60:     CPI   3Ah   
0041   DA 60 00               JC   lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0044   FE 3E                  CPI   3Eh   
0046   D2 11 00               JNC   next0   ; 7Fh-FFh: ignored
0049   D6 1E                  SUI   1Eh   ; 7Bh-7Eh: index 28-31
004B                             ; Punctuation: HL holds TOS, so it is parked on the stack while the table is
004B                             ; read, then swapped for the handler's address: XTHL puts TOS back in HL and
004B                             ; leaves the address on the stack for RET to jump to. The stack is balanced
004B                             ; again when the handler starts. PTAB never crosses a page (checked in the
004B                             ; listing), so only L needs adding.
004B   E5           PUNCT:    PUSH   H   
004C   87                     ADD   A   
004D   C6 7B                  ADI   PTAB & 0FFh   
004F   6F                     MOV   L,A   
0050   26 00                  MVI   H,PTAB / 256   
0052   7E                     MOV   A,M   
0053   23                     INX   H   
0054   66                     MOV   H,M   
0055   6F                     MOV   L,A   ; HL = handler
0056   E3                     XTHL      
0057   C9                     RET      
0058   C6 21        CTL:      ADI   21h   ; back to c; zero only for NUL
005A   C2 11 00               JNZ   next0   
005D                          IF   CPM   
                              JMP   endprog   
005D                          ENDIF      
005D                          IFN   CPM   
005D                ENDPROG:      
005D   C3 09 FF               JMP   EXIT   ; the program has ended
0060                          ENDIF      
0060                             ; a-z: push the cell's address (the cell is the variable)
0060   E5           LOWER:    PUSH   H   
0061   87                     ADD   A   
0062   6F                     MOV   L,A   
0063   26 82                  MVI   H,LETPAGE   
0065   D7                     RST   2   
0066                             ; A-Z: call the word. The return address (the IP after the letter) goes on
0066                             ; the return stack, and the IP becomes the address in the letter's cell.
0066   E5           UPPER:    PUSH   H   ; keep TOS
0067   87                     ADD   A   
0068   6F                     MOV   L,A   
0069   26 82                  MVI   H,LETPAGE   ; HL -> cell
006B   50                     MOV   D,B   
006C   59                     MOV   E,C   ; DE = return address
006D   4E                     MOV   C,M   
006E   23                     INX   H   
006F   46                     MOV   B,M   ; IP = the word's body
0070   CD D2 00               CALL   rpush   
0073   E1                     POP   H   ; TOS back
0074   D7                     RST   2   
0075                             ; Digits: step back onto the first digit and read the whole number.
0075   E5           DIGIT:    PUSH   H   
0076   0B                     DCX   B   
0077   CD BB 00               CALL   rdnum   
007A   D7                     RST   2   
007B                             ; =============================================================================
007B                             ;  Dispatch table: one handler per punctuation character, in code order.
007B                             ;  It sits right after the inner loop so that it can't cross a page (the
007B                             ;  loop only adds to the low byte of its address).
007B                             ; =============================================================================
007B   B3 01        PTAB:     DW   h_store   ; !
007D   5C 02                  DW   h_str   ; "
007F   84 02                  DW   h_num   ; #
0081   63 02                  DW   h_print   ; $
0083   06 00                  DW   h_swap   ; %
0085   6A 01                  DW   h_and   ; &
0087   7F 02                  DW   h_emit   ; '
0089   CA 01                  DW   h_open   ; (
008B   DA 01                  DW   h_close   ; )
008D   09 01                  DW   h_mul   ; *
008F   E9 00                  DW   h_add   ; +
0091   B8 01                  DW   h_cfetch   ; ,
0093   EC 00                  DW   h_sub   ; -
0095   BC 01                  DW   h_cstore   ; .
0097   25 01                  DW   h_div   ; /
0099   0D 00                  DW   h_dup   ; :
009B   09 00                  DW   drop_next   ; ;
009D   88 01                  DW   h_lt   ; <
009F   97 01                  DW   h_eq   ; =
00A1   87 01                  DW   h_gt   ; >
00A3   AA 02                  DW   h_key   ; ?
00A5   AE 01                  DW   h_fetch   ; @
00A7   02 02                  DW   h_def   ; [
00A9   EB 01                  DW   h_break   ; \
00AB   FA 01                  DW   h_ret   ; ]
00AD   7A 01                  DW   h_xor   ; ^
00AF   BF 01                  DW   h_alloc   ; _
00B1   05 03                  DW   h_grave   ; `
00B3   A4 01                  DW   h_tor   ; {
00B5   72 01                  DW   h_or   ; |
00B7   A9 01                  DW   h_fromr   ; }
00B9   82 01                  DW   h_not   ; ~
00BB                PTABEND:      
00BB                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
00BB                             ; non-digit. Values wrap at 16 bits, as the spec says.
00BB   21 00 00     RDNUM:    LXI   H,0   
00BE   0A           RDN1:     LDAX   B   
00BF   D6 30                  SUI   "0"   
00C1   FE 0A                  CPI   10   
00C3   D0                     RNC      
00C4   03                     INX   B   
00C5   54                     MOV   D,H   
00C6   5D                     MOV   E,L   
00C7   29                     DAD   H   
00C8   29                     DAD   H   
00C9   19                     DAD   D   
00CA   29                     DAD   H   ; HL * 10
00CB   5F                     MOV   E,A   
00CC   16 00                  MVI   D,0   
00CE   19                     DAD   D   
00CF   C3 BE 00               JMP   rdn1   
00D2                             ; =============================================================================
00D2                             ;  Return stack. rpush pushes DE; rpop pops into HL. RSP is the pointer (a RAM
00D2                             ;  word, growing down). Both destroy HL; rpush also keeps DE, rpop clobbers DE.
00D2                             ; =============================================================================
00D2   2A 34 82     RPUSH:    LHLD   RSP   
00D5   2B                     DCX   H   
00D6   72                     MOV   M,D   
00D7   2B                     DCX   H   
00D8   73                     MOV   M,E   
00D9   22 34 82               SHLD   RSP   
00DC   C9                     RET      
00DD   2A 34 82     RPOP:     LHLD   RSP   
00E0   5E                     MOV   E,M   
00E1   23                     INX   H   
00E2   56                     MOV   D,M   
00E3   23                     INX   H   
00E4   22 34 82               SHLD   RSP   
00E7   EB                     XCHG      
00E8   C9                     RET      
00E9                             ; =============================================================================
00E9                             ;  Arithmetic and logic. Effects are ( NOS TOS -- result ).
00E9                             ; =============================================================================
00E9   D1           H_ADD:    POP   D   
00EA   19                     DAD   D   
00EB   D7                     RST   2   
00EC                             ; "-" has two jobs: directly before a digit it starts a negative number.
00EC                             ; Otherwise a - b is a + (-b): neg16 and DAD are shorter than a byte-wise SUB/SBB.
00EC   0A           H_SUB:    LDAX   B   
00ED   D6 30                  SUI   "0"   
00EF   FE 0A                  CPI   10   
00F1   DA FA 00               JC   negnum   
00F4   D1                     POP   D   
00F5   CD 02 01               CALL   neg16   
00F8   19                     DAD   D   
00F9   D7                     RST   2   
00FA   E5           NEGNUM:   PUSH   H   
00FB   CD BB 00               CALL   rdnum   
00FE   CD 02 01               CALL   neg16   
0101   D7                     RST   2   
0102                             ; neg16: HL = -HL (keeps BC, DE)
0102   AF           NEG16:    XRA   A   
0103   95                     SUB   L   
0104   6F                     MOV   L,A   
0105   9F                     SBB   A   
0106   94                     SUB   H   
0107   67                     MOV   H,A   
0108   C9                     RET      
0109                             ; "*": shift-and-add on the multiplier's low bit, so it stops as soon as the
0109                             ; multiplier is used up; only the low 16 bits are kept.
0109   D1           H_MUL:    POP   D   ; DE = multiplicand
010A   C5                     PUSH   B   
010B   44                     MOV   B,H   
010C   4D                     MOV   C,L   ; BC = multiplier
010D   21 00 00               LXI   H,0   
0110   78           MUL1:     MOV   A,B   
0111   B7                     ORA   A   ; clear carry
0112   1F                     RAR      
0113   47                     MOV   B,A   
0114   79                     MOV   A,C   
0115   1F                     RAR      
0116   4F                     MOV   C,A   ; BC >> 1, carry = the bit shifted out
0117   D2 1B 01               JNC   mul2   
011A   19                     DAD   D   
011B   EB           MUL2:     XCHG      
011C   29                     DAD   H   ; multiplicand << 1
011D   EB                     XCHG      
011E   78                     MOV   A,B   
011F   B1                     ORA   C   
0120   C2 10 01               JNZ   mul1   
0123   C1                     POP   B   
0124   D7                     RST   2   
0125                             ; "/" ( a b -- r q ): the quotient is on top. Truncates toward zero; r takes
0125                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
0125                             ; of a. Dividing by zero is not checked: it returns two cells of no meaning.
0125   D1           H_DIV:    POP   D   ; DE = a, HL = b
0126   C5                     PUSH   B   
0127   7A                     MOV   A,D   
0128   B7                     ORA   A   
0129   F5                     PUSH   PSW   ; S flag = sign of a (for r)
012A   AC                     XRA   H   
012B   F5                     PUSH   PSW   ; S flag = sign of q
012C   7C                     MOV   A,H   
012D   B7                     ORA   A   
012E   FC 02 01               CM   neg16   ; HL = |b|
0131   EB                     XCHG      
0132   7C                     MOV   A,H   
0133   B7                     ORA   A   
0134   FC 02 01               CM   neg16   ; HL = |a|, DE = |b|
0137   CD 49 01               CALL   udiv   ; HL = q, BC = r
013A   F1                     POP   PSW   
013B   FC 02 01               CM   neg16   ; q's sign
013E   EB                     XCHG      ; DE = q
013F   60                     MOV   H,B   
0140   69                     MOV   L,C   ; HL = r
0141   F1                     POP   PSW   
0142   FC 02 01               CM   neg16   ; r's sign
0145   C1                     POP   B   
0146   E5                     PUSH   H   ; r under q
0147   EB                     XCHG      ; HL = q
0148   D7                     RST   2   
0149                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, BC = remainder.
0149                             ; Uses A, BC; the caller saves the IP. HL holds the dividend and, as its bits
0149                             ; leave at the top, the quotient bits arrive at the bottom. The loop counter
0149                             ; lives on the stack, since A is busy with the shifts.
0149   01 00 00     UDIV:     LXI   B,0   
014C   3E 10                  MVI   A,16   
014E   F5                     PUSH   PSW   
014F   29           UDV1:     DAD   H   ; next dividend bit into the carry
0150   79                     MOV   A,C   
0151   17                     RAL      
0152   4F                     MOV   C,A   
0153   78                     MOV   A,B   
0154   17                     RAL      
0155   47                     MOV   B,A   ; BC = BC*2 + bit
0156   79                     MOV   A,C   
0157   93                     SUB   E   
0158   78                     MOV   A,B   
0159   9A                     SBB   D   ; carry if BC < DE
015A   DA 62 01               JC   udv2   
015D   47                     MOV   B,A   ; BC - DE (high byte; A holds it)
015E   79                     MOV   A,C   
015F   93                     SUB   E   
0160   4F                     MOV   C,A   
0161   2C                     INR   L   ; quotient bit
0162   F1           UDV2:     POP   PSW   
0163   3D                     DCR   A   
0164   F5                     PUSH   PSW   
0165   C2 4F 01               JNZ   udv1   
0168   F1                     POP   PSW   
0169   C9                     RET      
016A   D1           H_AND:    POP   D   
016B   7C                     MOV   A,H   
016C   A2                     ANA   D   
016D   67                     MOV   H,A   
016E   7D                     MOV   A,L   
016F   A3                     ANA   E   
0170   6F                     MOV   L,A   
0171   D7                     RST   2   
0172   D1           H_OR:     POP   D   
0173   7C                     MOV   A,H   
0174   B2                     ORA   D   
0175   67                     MOV   H,A   
0176   7D                     MOV   A,L   
0177   B3                     ORA   E   
0178   6F                     MOV   L,A   
0179   D7                     RST   2   
017A   D1           H_XOR:    POP   D   
017B   7C                     MOV   A,H   
017C   AA                     XRA   D   
017D   67                     MOV   H,A   
017E   7D                     MOV   A,L   
017F   AB                     XRA   E   
0180   6F                     MOV   L,A   
0181   D7                     RST   2   
0182                             ; ~x is -x - 1: shorter than complementing both bytes.
0182   CD 02 01     H_NOT:    CALL   neg16   
0185   2B                     DCX   H   
0186   D7                     RST   2   
0187                             ; Signed compares. Both are "DE < HL" for the right pair: > swaps the two
0187                             ; cells first (XTHL), < doesn't. There is no overflow flag, so the signed
0187                             ; answer is the unsigned borrow of DE - HL, flipped when the signs differ.
0187                             ; SBB A turns a carry into -1 or 0 with no branch.
0187   E3           H_GT:     XTHL      ; a > b  is  b < a
0188   D1           H_LT:     POP   D   ; a < b: DE = a, HL = b
0189   7B                     MOV   A,E   
018A   95                     SUB   L   
018B   7A                     MOV   A,D   
018C   9C                     SBB   H   
018D   9F                     SBB   A   ; A = -1 if DE < HL unsigned
018E   6F                     MOV   L,A   
018F   7C                     MOV   A,H   
0190   AA                     XRA   D   
0191   17                     RAL      ; carry = the signs differ
0192   9F                     SBB   A   
0193   AD                     XRA   L   ; flip when they do
0194   67                     MOV   H,A   
0195   6F                     MOV   L,A   
0196   D7                     RST   2   
0197   D1           H_EQ:     POP   D   
0198   7D                     MOV   A,L   
0199   AB                     XRA   E   
019A   6F                     MOV   L,A   
019B   7C                     MOV   A,H   
019C   AA                     XRA   D   
019D   B5                     ORA   L   ; zero if equal
019E   D6 01                  SUI   1   ; carry only for zero
01A0   9F                     SBB   A   
01A1   67                     MOV   H,A   
01A2   6F                     MOV   L,A   
01A3   D7                     RST   2   
01A4                             ; =============================================================================
01A4                             ;  Stack
01A4                             ; =============================================================================
01A4                          IF   CPM   
                    H_SWAP:   XTHL      
                              RST   2   
01A4                          ENDIF      
01A4   EB           H_TOR:    XCHG      ; "{" TOS to the return stack
01A5   CD D2 00               CALL   rpush   
01A8   CF                     RST   1   
01A9   E5           H_FROMR:   PUSH   H   ; "}" return stack to TOS
01AA   CD DD 00               CALL   rpop   
01AD   D7                     RST   2   
01AE                             ; =============================================================================
01AE                             ;  Storage
01AE                             ; =============================================================================
01AE   5E           H_FETCH:   MOV   E,M   ; "@"
01AF   23                     INX   H   
01B0   56                     MOV   D,M   
01B1   EB                     XCHG      
01B2   D7                     RST   2   
01B3   D1           H_STORE:   POP   D   ; "!" ( n addr -- )
01B4                          IF   CHECKED   
                              INX   H   ; both bytes must be in the program's space
                              CALL   chkst   
                              DCX   H   
01B4                          ENDIF      
01B4   73                     MOV   M,E   
01B5   23                     INX   H   
01B6   72                     MOV   M,D   
01B7   CF                     RST   1   
01B8   6E           H_CFETCH:   MOV   L,M   ; ","
01B9   26 00                  MVI   H,0   
01BB   D7                     RST   2   
01BC   D1           H_CSTORE:   POP   D   ; "." ( c addr -- )
01BD                          IF   CHECKED   
                              CALL   chkst   
01BD                          ENDIF      
01BD   73                     MOV   M,E   
01BE   CF                     RST   1   
01BF                             ; "_" ( n -- addr ): the heap pointer moves up by n; TOS is the old pointer.
01BF   EB           H_ALLOC:   XCHG      
01C0   2A 7C 82               LHLD   HEAP   
01C3   E5                     PUSH   H   
01C4   19                     DAD   D   
01C5                          IF   CHECKED   
                              JC   e_heap   ; a negative count wraps: too big
                              LDA   HLIM   
                              DCR   A   
                              CMP   H   
                              JC   e_heap   ; the new top must stay below the limit page
01C5                          ENDIF      
01C5   22 7C 82               SHLD   HEAP   
01C8   E1                     POP   H   
01C9   D7                     RST   2   
01CA                          IF   CHECKED   
                                 ; chkst: stop unless HL is in the program's own space: from the letter page
                                 ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
                                 ; whatever lies above the limit are safe. Memory above the heap top but
                                 ; below the limit is the program's own: Tiny BASIC keeps its lines there.
                                 ; Keeps every register.
                    CHKST:    PUSH   PSW   
                              MOV   A,H   
                              CPI   LETPAGE   
                              JC   chk1   
                              LDA   HLIM   
                              DCR   A   
                              CMP   H   
                    CHK1:     JC   e_store   
                              POP   PSW   
                              RET      
01CA                          ENDIF      
01CA                             ; =============================================================================
01CA                             ;  Flow control
01CA                             ; =============================================================================
01CA                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
01CA                             ; the matching ")".
01CA   7C           H_OPEN:   MOV   A,H   
01CB   B5                     ORA   L   
01CC   CA D5 01               JZ   op_f   
01CF   50                     MOV   D,B   
01D0   59                     MOV   E,C   
01D1   CD D2 00               CALL   rpush   ; (HL, the flag, is dead here)
01D4   CF                     RST   1   ; = POP H, RST 2: the flag is dead, so drop it
01D5   E1           OP_F:     POP   H   
01D6   CD 23 02     SKIPNX:   CALL   skip   
01D9   D7                     RST   2   
01DA                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
01DA                             ; drops it and carries on.
01DA   7C           H_CLOSE:   MOV   A,H   
01DB   B5                     ORA   L   
01DC   CA E7 01               JZ   rdrop   
01DF                          IF   CHECKED   
                              CALL   chkbrk   ; Ctrl-C is checked at every loop-back
01DF                          ENDIF      
01DF   2A 34 82               LHLD   RSP   ; peek the block start
01E2   4E                     MOV   C,M   
01E3   23                     INX   H   
01E4   46                     MOV   B,M   
01E5   E1                     POP   H   
01E6   D7                     RST   2   
01E7   CD DD 00     RDROP:    CALL   rpop   ; (HL, the flag, is dead: NOS is next)
01EA   CF                     RST   1   
01EB                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
01EB                             ; drops the block start, "]" returns. No closer at all ends the program.
01EB   7C           H_BREAK:   MOV   A,H   
01EC   B5                     ORA   L   
01ED   C2 F1 01               JNZ   brk1   
01F0   CF                     RST   1   
01F1   CD 23 02     BRK1:     CALL   skip   
01F4   FE 29                  CPI   ")"   
01F6   CA E7 01               JZ   rdrop   
01F9   E1                     POP   H   ; and fall into "]"
01FA                             ; "]" returns: pop an address and jump to it.
01FA   E5           H_RET:    PUSH   H   
01FB   CD DD 00               CALL   rpop   
01FE   44                     MOV   B,H   
01FF   4D                     MOV   C,L   
0200   E1                     POP   H   
0201                          IF   CHECKED   
                              CALL   chkbrk   ; ... and at every word return
0201                          ENDIF      
0201   D7                     RST   2   
0202                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
0202                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
0202                             ; the body"s address instead. Either way it then skips to the matching "]'.
0202   0A           H_DEF:    LDAX   B   
0203   03                     INX   B   
0204   5F                     MOV   E,A   
0205   E6 DF                  ANI   0DFh   ; fold case
0207   D6 41                  SUI   "A"   
0209   FE 1A                  CPI   26   
020B   D2 1D 02               JNC   def2   ; not a letter
020E   7B                     MOV   A,E   
020F   D6 41                  SUI   "A"   ; 0-25 or 32-57: lowercase lands 64 bytes up
0211   87                     ADD   A   
0212   5F                     MOV   E,A   
0213   16 82                  MVI   D,LETPAGE   ; DE -> cell
0215   79                     MOV   A,C   
0216   12                     STAX   D   
0217   1C                     INR   E   
0218   78                     MOV   A,B   
0219   12                     STAX   D   
021A   C3 D6 01               JMP   skipnx   
021D                DEF2:        
021D                          IF   CHECKED   
                              MOV   A,E   
                              CPI   " "   
                              JNZ   e_brack   ; anything but a letter or a space
021D                          ENDIF      
021D   E5                     PUSH   H   ; an anonymous block: push its address
021E   60                     MOV   H,B   
021F   69                     MOV   L,C   
0220   C3 D6 01               JMP   skipnx   
0223                             ; skip: read past text to the closer at this level, and return it in A.
0223                             ; Brackets of both kinds count together; strings are stepped over whole. A
0223                             ; NUL first ends the program (for "\" with no closer; anything else that runs
0223                             ; into the NUL had unbalanced brackets anyway). D counts the open levels,
0223                             ; starting at 1 for the one we are in.
0223   16 01        SKIP:     MVI   D,1   
0225   0A           SK1:      LDAX   B   
0226   03                     INX   B   
0227   B7                     ORA   A   
0228   CA 5D 00               JZ   endprog   
022B   FE 22                  CPI   22h   
022D   CC 4F 02               CZ   skipstr   ; leaves A = 22h, which matches nothing below
0230   FE 28                  CPI   "("   
0232   CA 49 02               JZ   sk3   
0235   FE 5B                  CPI   "["   
0237   CA 49 02               JZ   sk3   
023A   FE 29                  CPI   ")"   
023C   CA 44 02               JZ   sk4   
023F   FE 5D                  CPI   "]"   
0241   C2 25 02               JNZ   sk1   
0244   15           SK4:      DCR   D   
0245   C8                     RZ      ; the closer at this level
0246   C3 25 02               JMP   sk1   
0249   14           SK3:      INR   D   ; an opener: one deeper (the DCR below makes
024A   14                     INR   D   ;   it +1 net, and can't reach zero)
024B   C3 44 02               JMP   sk4   
024E                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
024E                             ; the next character, so "/"" does not end it.
024E   03           SS0:      INX   B   
024F   0A           SKIPSTR:   LDAX   B   
0250   03                     INX   B   
0251   FE 2F                  CPI   "/"   
0253   CA 4E 02               JZ   ss0   
0256   FE 22                  CPI   22h   
0258   C2 4F 02               JNZ   skipstr   
025B   C9                     RET      
025C                             ; =============================================================================
025C                             ;  Console
025C                             ; =============================================================================
025C                             ; 22h pushes the address of the text after it and skips the string.
025C   E5           H_STR:    PUSH   H   
025D   60                     MOV   H,B   
025E   69                     MOV   L,C   
025F   CD 4F 02               CALL   skipstr   
0262   D7                     RST   2   
0263                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
0263                             ; 40h-7Fh clears its bit 6 (/M is CR, /` is space); plus anything lower gives
0263                             ; that character itself.
0263   7E           H_PRINT:   MOV   A,M   
0264   23                     INX   H   
0265   FE 22                  CPI   22h   
0267   CA 7E 02               JZ   prdone   
026A   FE 2F                  CPI   "/"   
026C   C2 78 02               JNZ   pr1   
026F   7E                     MOV   A,M   
0270   23                     INX   H   
0271   FE 40                  CPI   40h   
0273   DA 78 02               JC   pr1   
0276   E6 BF                  ANI   0BFh   
0278   CD 03 FF     PR1:      CALL   putc   
027B   C3 63 02               JMP   h_print   
027E   CF           PRDONE:   RST   1   
027F   7D           H_EMIT:   MOV   A,L   ; "'"
0280   CD 03 FF               CALL   putc   
0283   CF                     RST   1   
0284                             ; "#" prints TOS as a signed decimal number, with no space after it.
0284   7C           H_NUM:    MOV   A,H   
0285   B7                     ORA   A   
0286   F2 91 02               JP   num1   
0289   3E 2D                  MVI   A,"-"   
028B   CD 03 FF               CALL   putc   
028E   CD 02 01               CALL   neg16   
0291   C5           NUM1:     PUSH   B   
0292   CD 97 02               CALL   pdec   
0295   C1                     POP   B   
0296   CF                     RST   1   
0297                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits)
0297   11 0A 00     PDEC:     LXI   D,10   
029A   CD 49 01               CALL   udiv   ; HL = HL / 10, BC = digit
029D   79                     MOV   A,C   
029E   F5                     PUSH   PSW   
029F   7C                     MOV   A,H   
02A0   B5                     ORA   L   
02A1   C4 97 02               CNZ   pdec   
02A4   F1                     POP   PSW   
02A5   C6 30                  ADI   "0"   
02A7   C3 03 FF               JMP   putc   
02AA                             ; "?" ( n -- c ) or ( -n -- addr )
02AA                             ;   n > 0: wait about n ms for a key; 0 if none came
02AA                             ;   n = 0: wait for a key
02AA                             ;   n < 0: read a line of at most -n characters, with echo. n is not
02AA                             ;          checked: the buffer holds 127 characters and the CR, so a
02AA                             ;          program must ask for 127 or fewer.
02AA   7C           H_KEY:    MOV   A,H   
02AB   B7                     ORA   A   
02AC   FA D3 02               JM   line   
02AF   B5                     ORA   L   
02B0   C2 BD 02               JNZ   kt1   
02B3   CD 06 FF     KW:       CALL   getk   ; 0?: wait
02B6   CA B3 02               JZ   kw   
02B9   6F           KT3:      MOV   L,A   
02BA   26 00                  MVI   H,0   
02BC   D7                     RST   2   
02BD   11 28 00     KT1:      LXI   D,MSLOOP   ; one millisecond, roughly
02C0   CD 06 FF     KT2:      CALL   getk   
02C3   C2 B9 02               JNZ   kt3   
02C6   1B                     DCX   D   
02C7   7A                     MOV   A,D   
02C8   B3                     ORA   E   
02C9   C2 C0 02               JNZ   kt2   
02CC   2B                     DCX   H   
02CD   7C                     MOV   A,H   
02CE   B5                     ORA   L   
02CF   C2 BD 02               JNZ   kt1   
02D2   D7                     RST   2   ; time ran out: HL is already 0
02D3                          IF   CPM   
                                 ; CP/M: BDOS 10 does the editing (the spec allows the platform's
                                 ; own line editor). It doesn't store the CR, so it is added here.
                    LINE:     XRA   A   
                              SUB   L   ; A = the count (TOS is minus the count)
                              STA   LBHDR   
                              PUSH   B   
                              LXI   D,LBHDR   
                              MVI   C,10   
                              CALL   BDOS   
                              POP   B   
                              LXI   H,LBHDR+1   
                              MOV   A,M   ; count (0-127)
                              INX   H   ; HL = LINEBUF, whose low byte is 80h:
                              PUSH   H   
                              ADD   L   ;   adding the count to L can't carry
                              MOV   L,A   
                              MVI   M,13   
                              POP   H   
                              RST   2   
02D3                          ENDIF      
02D3                          IFN   CPM   
02D3                             ; Generic: Backspace takes the last character back (and is echoed as
02D3                             ; it is), CR ends (stored, not echoed), every other key is stored and
02D3                             ; echoed until the line is full. The line buffer starts at offset 80h
02D3                             ; of its page, so L alone is the place in the line: D holds the L of
02D3                             ; a full line.
02D3   3E 80        LINE:     MVI   A,LINEBUF & 0FFh   
02D5   95                     SUB   L   ; (TOS is minus the count)
02D6   57                     MOV   D,A   ; D = the L of a full line
02D7   21 80 82               LXI   H,LINEBUF   
02DA   CD 06 FF     LN2:      CALL   getk   
02DD   CA DA 02               JZ   ln2   
02E0   FE 0D                  CPI   13   
02E2   CA 01 03               JZ   ln5   
02E5   FE 08                  CPI   8   
02E7   CA F9 02               JZ   ln4   
02EA   5F                     MOV   E,A   
02EB   7D                     MOV   A,L   
02EC   BA                     CMP   D   
02ED   CA DA 02               JZ   ln2   ; full
02F0   73                     MOV   M,E   
02F1   2C                     INR   L   
02F2   7B                     MOV   A,E   
02F3   CD 03 FF     LN3:      CALL   putc   
02F6   C3 DA 02               JMP   ln2   
02F9   2D           LN4:      DCR   L   ; Backspace: one back, and echo it,
02FA   FA F3 02               JM   ln3   ;   unless the line was empty (L left the
02FD   2C                     INR   L   ;   upper half of the page)
02FE   C3 DA 02               JMP   ln2   
0301   77           LN5:      MOV   M,A   ; the CR
0302   2E 80                  MVI   L,LINEBUF & 0FFh   
0304   D7                     RST   2   
0305                          ENDIF      
0305                             ; =============================================================================
0305                             ;  Machine code: the grave
0305                             ; =============================================================================
0305                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
0305                             ; are stored from addr until a non-hex character; then a RET (C9h) is
0305                             ; written and its address is left. An odd last digit is consumed and dropped.
0305                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
0305                             ; code is entered by CALL with the data stack above the return address; it
0305                             ; must keep BC, and on return the top cell becomes the new TOS.
0305   0A           H_GRAVE:   LDAX   B   
0306   CD 30 03               CALL   hexval   
0309   DA 2A 03               JC   exec   
030C   0A           HX1:      LDAX   B   
030D   CD 30 03               CALL   hexval   
0310   DA 27 03               JC   hx2   
0313   03                     INX   B   
0314   87                     ADD   A   
0315   87                     ADD   A   
0316   87                     ADD   A   
0317   87                     ADD   A   
0318   57                     MOV   D,A   
0319   0A                     LDAX   B   
031A   CD 30 03               CALL   hexval   
031D   DA 27 03               JC   hx2   ; odd digit: already consumed, dropped
0320   03                     INX   B   
0321   B2                     ORA   D   
0322                          IF   CHECKED   
                              CALL   chkst   
0322                          ENDIF      
0322   77                     MOV   M,A   
0323   23                     INX   H   
0324   C3 0C 03               JMP   hx1   
0327                HX2:         
0327                          IF   CHECKED   
                              CALL   chkst   
0327                          ENDIF      
0327   36 C9                  MVI   M,0C9h   
0329   D7                     RST   2   
032A   CD 2F 03     EXEC:     CALL   exjmp   ; the code returns here, with its top cell on
032D   E1                     POP   H   ;   the stack: that becomes the new TOS
032E   D7                     RST   2   
032F   E9           EXJMP:    PCHL      
0330                             ; hexval: A = a character; returns its value 0-15 with carry clear, or
0330                             ; carry set if it isn't a hex digit (0-9, A-F, a-f).
0330   D6 30        HEXVAL:   SUI   "0"   
0332   FE 0A                  CPI   10   
0334   3F                     CMC      
0335   D0                     RNC      
0336   E6 DF                  ANI   0DFh   
0338   D6 11                  SUI   11h   
033A   FE 06                  CPI   6   
033C   3F                     CMC      
033D   D8                     RC      
033E   C6 0A                  ADI   10   
0340   C9                     RET      
0341                             ; =============================================================================
0341                             ;  Console layer: getk returns a waiting key in A (zero flag clear), or
0341                             ;  A = 0 with the zero flag set when none is waiting. putc prints A.
0341                             ;  Both keep BC, DE and HL. In the generic build they are the host's KEY and
0341                             ;  CONOUT routines themselves.
0341                             ; =============================================================================
0341                          IF   (1-CPM)*(1-CHECKED)   
0341                GETK:     EQU   KEY   ; the host's routine does the whole job
0341                          ENDIF      
0341                          IF   CHECKED   
                    GETK:     LDA   KEYBUF   ; a key held back by the break check
                              ORA   A   
                              JZ   gk1   
                              PUSH   PSW   
                              XRA   A   
                              STA   KEYBUF   
                              POP   PSW   
                              RET      
0341                          ENDIF      
0341                          IF   (1-CPM)*CHECKED   
                    GK1:      EQU   KEY   
0341                          ENDIF      
0341                          IF   CPM*(1-CHECKED)   
                    GETK:        
0341                          ENDIF      
0341                          IF   CPM   
                    GK1:      MVI   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
                                 ; (putc ends with ORA A, for the zero flag)
                                 ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
                                 ; printing and could swallow a key that BDOS 6 then never sees.
                    PUTC:     PUSH   B   
                              PUSH   D   
                              PUSH   H   
                              MOV   E,A   
                              MVI   C,6   
                              CALL   BDOS   
                              POP   H   
                              POP   D   
                              POP   B   
                              ORA   A   
                              RET      
0341                          ENDIF      
0341                          IFN   CPM   
0341                PUTC:     EQU   CONOUT   
0341                          ENDIF      
0341                             ; =============================================================================
0341                             ;  Checked build: break key and error reports
0341                             ; =============================================================================
0341                          IF   CHECKED   
                                 ; chkbrk: a waiting key is read now; Ctrl-C stops the program, anything
                                 ; else is held for the next "?".
                    CHKBRK:   LDA   KEYBUF   
                              ORA   A   
                              RNZ      ; one key is already held
                              CALL   getk   
                              RZ      
                              CPI   3   
                              JZ   e_break   
                              STA   KEYBUF   
                              RET      
                                 ; Error entries. Each loads its letter and then hides the next entry inside
                                 ; a 3-byte LXI H (the 21h), so they all fall through to `error`.
                    E_STACK:   MVI   A,"S"   ; data stack over or under
                              DB   21h   
                    E_RSTACK:   MVI   A,"R"   ; return stack over or under
                              DB   21h   
                    E_BREAK:   MVI   A,"B"   ; Ctrl-C
                              DB   21h   
                    E_HEAP:   MVI   A,"H"   ; heap past the limit
                              DB   21h   
                    E_STORE:   MVI   A,"W"   ; write outside the program's space
                              DB   21h   
                    E_BRACK:   MVI   A,"D"   ; bad character after [
                                 ; error: print the letter in A, " @ " and the offset in the program of the
                                 ; character just read, then end. For example: S @ 245
                    ERROR:    LXI   SP,DSTOP   ; the stacks may be wrecked: start clean
                              CALL   putc   
                              MVI   A," "   
                              CALL   putc   
                              MVI   A,"@"   
                              CALL   putc   
                              MVI   A," "   
                              CALL   putc   
                              LXI   H,(0-PROG-1)&0FFFFh   
                              DAD   B   ; IP - (PROG+1): the character just read
                              CALL   pdec   
                              JMP   endprog   
0341                          ENDIF      
0341                             ; =============================================================================
0341                             ;  Startup
0341                             ; =============================================================================
0341                START:       
0341                          IF   CPM   
                              LXI   SP,DSTOP   
                                 ; CP/M: the RAM pages follow the image; the heap may grow to the BDOS
                              LXI   H,stubs   ; RST 08h and RST 10h stubs into page zero
                              LXI   D,0008h   
                              MVI   B,12   
                    CPY:      MOV   A,M   
                              STAX   D   
                              INX   H   
                              INX   D   
                              DCR   B   
                              JNZ   cpy   
                              LXI   D,005Ch   ; open the file named on the command line
                              MVI   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LXI   D,PROG   
                    LD1:      PUSH   D   
                              MVI   C,26   ; set the DMA address
                              CALL   BDOS   
                              LXI   D,005Ch   
                              MVI   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   H   ; HL = the address this record went to
                              ORA   A   
                              JNZ   ld2   
                              LXI   D,128   
                              DAD   D   
                              XCHG      
                              JMP   ld1   
                    LD2:      MVI   M,0   ; the end of the file counts as NUL
                              INX   H   
                              SHLD   HEAP   
                              LDA   0007h   ; the BDOS page is the heap limit
                              STA   HLIM   
0341                          ENDIF      
0341                          IFN   CPM   
0341   21 00 83               LXI   H,PROG   ; the heap starts after the program's NUL
0344   7E           FNUL:     MOV   A,M   
0345   23                     INX   H   
0346   B7                     ORA   A   
0347   C2 44 03               JNZ   fnul   
034A   22 7C 82               SHLD   HEAP   
034D                          ENDIF      
034D                          IF   (1-CPM)*CHECKED   
                              MVI   A,HEAPLIM   
                              STA   HLIM   
034D                          ENDIF      
034D   21 E0 80               LXI   H,RSTOP   
0350   22 34 82               SHLD   RSP   
0353                          IF   CHECKED   
                              XRA   A   
                              STA   KEYBUF   
0353                          ENDIF      
0353   01 00 83               LXI   B,PROG   
0356   C3 11 00               JMP   next0   
0359                          IF   CPM   
                    STUBS:    POP   D   ; 0008h: drop, then next
                              POP   H   
                              JMP   next0   
                    H_DUP:    EQU   000Dh   
                              PUSH   H   ; 000Dh: dup
                              RST   2   
                              DB   0   
                              POP   D   ; 0010h: next
                              JMP   next0   
                    ENDPROG:   EQU   0   ; warm boot
                    DROP_NEXT:   EQU   0009h   
                                 ; RAM pages, after the image
                    RSPAGE:   EQU   (imgend + 255) / 256   
                    DSPAGE:   EQU   RSPAGE + 1   
                    LETPAGE:   EQU   RSPAGE + 2   
                    PROG:     EQU   LETPAGE*256 + 256   
0359                          ENDIF      
0359                IMGEND:      


