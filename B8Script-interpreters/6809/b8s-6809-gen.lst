                              CMPD   <PEND   
                              LBLO   e_heap   ; below the program's end
                              CMPA   #HEAPLIM   
                              LBHS   e_heap   ; the new top must stay below the limit page
F0FE                          ENDIF      
F0FE   D7 7C                  STB   <HEAP   
F100   97 7D                  STA   <HEAP+1   
F102   AF C4                  STX   ,U   
F104   39                     RTS      
F105                             ; ---- machine code: the grave -----------------------------------------------
F105                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
F105                             ; are stored from addr until a non-hex character; then a RTS (39h) is
F105                             ; written and its address is left. An odd last digit is consumed and dropped.
F105                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
F105                             ; code is entered by JSR (the dispatcher's own), with the address already
F105                             ; popped: U points at the top data cell (big-endian, 2 bytes, stack grows
F105                             ; down) and the return address is on top of S. The code may pop and push
F105                             ; data cells by changing U; on return the cell at ,U is the new TOS. It must
F105                             ; keep Y (the interpreter's reading position), DP and S (balanced), and
F105                             ; return with RTS. A, B, X, CC may change.
F105                             ; Neither the loader's stores nor the code are checked, in either build.
F105   8D 98        H_GRAVE:   BSR   hexc   ; the digit after the grave, if any
F107   24 1A                  BCC   exec   
F109   AE C4                  LDX   ,U   
F10B   C6 10        HX1:      LDB   #16   
F10D   3D                     MUL      ; B = the digit, moved up to the high half
F10E   E7 84                  STB   ,X   ; (an odd digit is overwritten by the RTS)
F110   8D 8D                  BSR   hexc   
F112   24 08                  BCC   hx2   ; odd digit: already consumed, dropped
F114   AA 84                  ORA   ,X   
F116   A7 80                  STA   ,X+   
F118   8D 85                  BSR   hexc   
F11A   25 EF                  BCS   hx1   
F11C   86 39        HX2:      LDA   #39h   ; RTS
F11E   A7 84                  STA   ,X   
F120   AF C4                  STX   ,U   
F122   39                     RTS      
F123   AE C1        EXEC:     LDX   ,U++   
F125   6E 84                  JMP   ,X   ; the code's RTS returns to the dispatcher
F127                          IF   CHECKED   
                    HEXC:     JSR   isdig   
                              BLO   hv1   ; C = 1
                              ANDA   #0DFh   
                              SUBA   #11h   
                              CMPA   #6   
                              BHS   hv9   ; C = 0
                              SUBA   #0F6h   ; + 10, and sets the carry
                    HV1:      LEAY   1,Y   ; (LEAY leaves the carry alone)
                    HV9:      RTS      
F127                          ENDIF      
F127                          IF   1-CHECKED   
F127                GETK:     EQU   KEY   ; the host's routine does the whole job
F127                          ENDIF      
F127                             ; ---- where the two ranges meet ---------------------------------------------
F127                             ; The first range ends somewhere among the next five handlers, ] \ [ @ ?
F127                             ; (they are in falling code order for this): NPG1 follows. Every handler
F127                             ; below them must start in the second range, and every one above in the
F127                             ; first.
F127                             ; "]" returns: pop an address and jump to it. (PULS X,Y: the dispatcher's
F127                             ; return address into X, then the saved IP into Y.)
F127                H_RET:       
F127                          IF   CHECKED   
                              JSR   chkbrk   ; Ctrl-C is checked at every word return
F127                          ENDIF      
F127   35 30                  PULS   X,Y   
F129   6E 84                  JMP   ,X   
F12B                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
F12B                             ; drops the block start, "]" returns. No closer at all ends the program.
F12B   EC C1        H_BREAK:   LDD   ,U++   
F12D   27 40                  BEQ   sk9   ; false: nothing to do
F12F   8D 1F                  BSR   skip   
F131   4D                     TSTA      ; skip returns 0 for ")"
F132                          IF   CHECKED   
                              LBMI   fin   ; (and FFh for the NUL: the program ends)
F132                          ENDIF      
F132   26 F3                  BNE   h_ret   
F134   35 16        RDROP:    PULS   D,X   ; the return address and the block start
F136   1F 05                  TFR   D,PC   ; back to the dispatcher
F138                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
F138                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
F138                             ; the body"s address instead. Either way it then skips to the matching "]'.
F138                             ; (The unchecked build takes anything that is not a letter as the space; the
F138                             ; checked build stops on it.)
F138                          IF   CHECKED   
                    DEF1:     CMPA   #" "-"A"+256   
                              BEQ   def2   
                              LEAY   -1,Y   ; anything but a letter or a space: W. The
                              STY   <AT   ;   place is that character, just read
                              LBRA   e_brack   
F138                          ENDIF      
F138   A6 A0        H_DEF:    LDA   ,Y+   
F13A   80 41                  SUBA   #"A"   ; a letter gives 0-25 or 32-57: lowercase
F13C   1F 89                  TFR   A,B   ;   lands 64 bytes up
F13E   C4 DF                  ANDB   #0DFh   ; fold case
F140   C1 1A                  CMPB   #26   
F142                          IF   1-CHECKED   
F142   24 0A                  BHS   def2   ; not a letter
F144                          ENDIF      
F144                          IF   CHECKED   
                              BHS   def1   
F144                          ENDIF      
F144   BD F0 73               JSR   cellx   
F147   1F 20                  TFR   Y,D   
F149   E7 84                  STB   ,X   ; little-endian
F14B   A7 01                  STA   1,X   
F14D   8C                     FCB   8Ch   ; (CMPX #: steps over the PSHU)
F14E   36 20        DEF2:     PSHU   Y   ; an anonymous block: push its address
F150                          IF   1-CHECKED   
F150                             ; fall into skip
F150                          ENDIF      
F150                          IF   CHECKED   
                                 ; Checked: the skip must end at a "]" (A = 2), or for a false "(",
                                 ; which comes to opf, at a ")" (A = 0). Anything else stops with N.
                              BSR   skip   
                              SUBA   #2   
                              FCB   8Ch   ; (CMPX #: steps over the BSR)
                    OPF:      BSR   skip   
                              TSTA      
                              LBNE   e_nest   
                              RTS      
F150                          ENDIF      
F150                             ; skip: read past text to the closer at this level, and return A = 0 if it
F150                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
F150                             ; strings are stepped over whole. B counts the open levels.
F150                             ; Unchecked: a NUL first ends the program (for "\" with no closer; anything
F150                             ; else that runs into the NUL had unbalanced brackets anyway).
F150                             ; Checked: a NUL, or a string that runs into it, returns A = FFh, and the
F150                             ; caller decides: "\" ends the program, "(" and "[" stop with N, as they do
F150                             ; for a closer of the other kind. The place is the opener, still in AT.
F150   5F           SKIP:     CLRB      
F151   A6 A0        SK1:      LDA   ,Y+   
F153                          IF   1-CHECKED   
F153   10 27 FE A9            LBEQ   fin   
F157                          ENDIF      
F157                          IF   CHECKED   
                              BEQ   ssn   ; A = FFh
F157                          ENDIF      
F157   81 22                  CMPA   #22h   
F159   26 02                  BNE   sk2   
F15B   8D 79                  BSR   skipstr   ; leaves A = 22h, which matches nothing below
F15D                          IF   CHECKED   
                              BCS   sk9   ; (or FFh, with the carry set: unclosed)
F15D                          ENDIF      
F15D   80 28        SK2:      SUBA   #"("   
F15F   27 0F                  BEQ   sk3   
F161   4A                     DECA      ; ")"
F162   27 08                  BEQ   sk4   
F164   80 32                  SUBA   #"["-")"   
F166   27 08                  BEQ   sk3   
F168   81 02                  CMPA   #"]"-"["   
F16A   26 E5                  BNE   sk1   
F16C   5A           SK4:      DECB      
F16D   2A E2                  BPL   sk1   
F16F   39           SK9:      RTS      ; the closer at this level
F170   5C           SK3:      INCB      
F171   20 DE                  BRA   sk1   
F173                             ; 22h, checked build (the unchecked one is with the handlers below).
F173                             ; Checked: a NUL ends the string too, even right after a "/"; skipstr then
F173                             ; returns A = FFh with the carry set (the carry is clear at the quote), and
F173                             ; """ stops with Q, the string's address already pushed. (skip comes here
F173                             ; for its own NUL as well.)
F173                          IF   CHECKED   
                    H_STR:    PSHU   Y   
                              BSR   skipstr   
                              LBCS   e_quote   
                              RTS      
                    SS0:      LDA   ,Y+   ; the character after the "/"
                              BEQ   ssn   
                    SKIPSTR:   LDA   ,Y+   
                              BEQ   ssn   
                              CMPA   #"/"   
                              BEQ   ss0   
                              CMPA   #22h   
                              BNE   skipstr   
                              RTS      ; the quote: C = 0
                    SSN:      SUBA   #1   ; the NUL: A = FFh, C = 1
                              RTS      
F173                          ENDIF      
F173   AE C4        H_FETCH:   LDX   ,U   ; "@" (the cell in memory is little-endian)
F175   A6 01                  LDA   1,X   
F177   20 6B                  BRA   cf1   
F179                             ; "?" ( n -- c ) or ( -n -- addr )
F179                             ;   n > 0: wait about n ms for a key; 0 if none came
