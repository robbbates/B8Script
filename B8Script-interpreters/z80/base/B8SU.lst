                    FDM:      INC   BC   ; more digits: HL = HL * 10 + the digit
                              LD   D,H   
                              LD   E,L   
                              ADD   HL,HL   
                              ADD   HL,HL   
                              ADD   HL,DE   
                              ADD   HL,HL   
                              LD   E,A   
                              LD   D,0   
                              ADD   HL,DE   
