  1831 00000A0E ????????            <1> v_outh: resd    1               ; the handle putc writes to
  1832 00000A12 ????????            <1> v_dstop:resd    1               ; ESP for the empty data stack
  1833 00000A16 ??                  <1> v_iscon:resb    1               ; non-zero if the input is a console
  1834 00000A17 ??                  <1> v_pcnt: resb    1               ; the break key's countdown
  1835 00000A18 ????????            <1> v_mode: resd    1               ; the console's input mode at the start
  1836 00000A1C ????????            <1> v_npend:resd    1               ; the heap's first address (checked '_')
  1837 00000A20 ????????            <1> v_skat: resd    1               ; where the skip started (checked N)
  1838 00000A24 ????????            <1> v_edln: resd    1               ; the editor: the line ^E put in the input
  1839                              <1> v_end:
  1840                              <1>         times   -((v_end-next) > 128) db 0      ; (an error if out of reach)
  1841                              <1>         times   -((next-iat) > 128) db 0
