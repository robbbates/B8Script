E39E                          IF   SBASEU   
                                 ; a-z, in the unchecked QK builds: a variable followed by "@" or "!" is
                                 ; fetched or stored in the same step (x@ is the commonest pair in most
                                 ; programs). A checked build checks the stacks between the two, so it keeps
                                 ; them apart. (pvar calls lowp, which only pushes.)
                    LOWQ:     ASL      
                              STA   T0   ; the cell's offset in the letter page
                              LDY   #0   
                              LDA   (IP),Y   
                              CMP   #"@"   
                              BEQ   lwf   
                              CMP   #"!"   
                              BEQ   lws   
                              LDA   T0   
                              LDY   #>LET   
                              JMP   pushay   ; the address
                    LWF:      JSR   incip   ; x@: TOS = the cell's value
                              LDY   T0   
                              DEX      
                              DEX      
                              LDA   LET,Y   
                              STA   0,X   
                              LDA   LET+1,Y   
                              STA   1,X   
                              RTS      
                    LWS:      JSR   incip   ; x!: the cell = TOS, and it is dropped
                              LDY   T0   
                              LDA   0,X   
                              STA   LET,Y   
                              LDA   1,X   
                              STA   LET+1,Y   
                              INX      
                              INX      
                              RTS      
E39E                          ENDIF      
E39E                          IF   QK   
E39E                             ; The skip cache. Nearly every skip is one that has happened before (a loop
E39E                             ; skips the same false block on every pass), so the first scan from each
E39E                             ; place is remembered: 64 entries of 00bbc3RhcnQsIHRoZSBjbG9zZXIncyBhZGRyZXNz, in CPAGE,
E39E                             ; found by the start's low byte times 4. Only skips that start in the
E39E                             ; program text are kept (the line buffer changes); the cache is emptied when
E39E                             ; the program starts. A program that changes its own text while it runs is
E39E                             ; not looked after. Where the skip started is kept in the scratch under the
E39E                             ; top cell, $FE,X and $FF,X. (The checked build: A holds the wrong closer on
E39E                             ; the way in, as at the checked skip above.)
E39E                SKIP:        
E39E                          ENDIF      
E39E                          IF   CHECKED*QK   
E39E   85 04                  STA   T0   
E3A0                          ENDIF      
E3A0                          IF   QK   
E3A0   A5 01                  LDA   IP+1   
E3A2   C9 05                  CMP   #>PROG   
E3A4   90 24                  BCC   sks   ; below the program text: no cache
E3A6   A5 00                  LDA   IP   
E3A8   0A                     ASL      
E3A9   0A                     ASL      
E3AA   A8                     TAY      ; Y -> the entry
E3AB   A5 00                  LDA   IP   
E3AD   D9 00 02               CMP   CPAGE*256,Y   
E3B0   D0 18                  BNE   sks   
E3B2   A5 01                  LDA   IP+1   
E3B4   D9 01 02               CMP   CPAGE*256+1,Y   
E3B7   D0 11                  BNE   sks   
E3B9   B9 02 02               LDA   CPAGE*256+2,Y   ; a hit: the IP goes to the closer, which is
E3BC   85 00                  STA   IP   ;   read
E3BE   B9 03 02               LDA   CPAGE*256+3,Y   
E3C1   85 01                  STA   IP+1   
E3C3   A0 00                  LDY   #0   
E3C5   B1 00                  LDA   (IP),Y   
E3C7   4C 8C E6               JMP   incip   
E3CA   A5 00        SKS:      LDA   IP   
E3CC   95 FE                  STA   0FEh,X   
E3CE   A5 01                  LDA   IP+1   
E3D0   95 FF                  STA   0FFh,X   
E3D2   A0 00                  LDY   #0   
E3D4   84 06                  STY   T2   ; depth
E3D6                             ; The scan reads at IP+Y. Most characters are nothing to it, and two range
E3D6                             ; tests rule them out: * to Z, and ^ and up. Only NUL " ( ) [ ] count.
E3D6   B1 00        SQ1:      LDA   (IP),Y   
E3D8   C8                     INY      
E3D9   F0 1D                  BEQ   sqw   
E3DB   C9 5E        SQ2:      CMP   #5Eh   
E3DD   B0 F7                  BCS   sq1   ; ^ _ ` a-z 00bbIHwg ~ and up: nothing
E3DF   C9 5B                  CMP   #5Bh   
E3E1   B0 2D                  BCS   sqb   ; [ \ ]
E3E3   C9 2A                  CMP   #2Ah   
E3E5   B0 EF                  BCS   sq1   ; * to Z: nothing
E3E7   C9 28                  CMP   #28h   
E3E9   F0 20                  BEQ   sqo   ; (
E3EB   B0 29                  BCS   sqc   ; )
E3ED   C9 22                  CMP   #22h   
E3EF   F0 0B                  BEQ   sqq   ; a string
E3F1   C9 01                  CMP   #1   
E3F3   B0 E1                  BCS   sq1   ; the rest below "(": nothing
E3F5                          ENDIF      
