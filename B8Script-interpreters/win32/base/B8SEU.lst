  2450 000009EA AC                  <1>         lodsb
  2451 000009EB 2C21                <1>         sub     al,21h                  ; AL = c - 21h
  2452 000009ED 72F0                <1>         jb      ctl                     ; c < 21h: NUL ends, the rest are ignored
  2453 000009EF 3C0F                <1>         cmp     al,0Fh
  2454 000009F1 722A                <1>         jb      punct                   ; 21h-2Fh: PTAB index 0-14
  2455 000009F3 2C0F                <1>         sub     al,0Fh                  ; AL = c - 30h
  2456 000009F5 3C0A                <1>         cmp     al,0Ah
  2457 000009F7 72DF                <1>         jb      digit                   ; 30h-39h
  2458 000009F9 3C11                <1>         cmp     al,11h
  2459 000009FB 721E                <1>         jb      p3a                     ; 3Ah-40h
  2460 000009FD 2C11                <1>         sub     al,11h                  ; AL = c - 41h
  2461 000009FF 3C1A                <1>         cmp     al,1Ah
  2462 00000A01 0F82E6F6FFFF        <1>         jb      upper                   ; 41h-5Ah: AL = letter index 0-25
  2463 00000A07 3C20                <1>         cmp     al,20h
  2464 00000A09 720E                <1>         jb      p5b                     ; 5Bh-60h
  2465 00000A0B 3C3A                <1>         cmp     al,3Ah
  2466 00000A0D 0F8203F9FFFF        <1>         jb      lower                   ; 61h-7Ah: AL = 20h-39h (cell +64 bytes)
  2467 00000A13 3C3E                <1>         cmp     al,3Eh
  2468                              <1> %if CHECKED
  2469                              <1>         je      next                    ; 7Fh, DEL: ignored
  2470                              <1>         jae     e_hi                    ; 80h-FFh: reserved
  2471                              <1> %else
  2472 00000A15 73D1                <1>         jae     next                    ; 7Fh-FFh: ignored
  2473                              <1> %endif
  2474 00000A17 2C1A                <1>         sub     al,1Ah                  ; 7Bh-7Eh: -1Eh in all, index 28-31
  2475 00000A19 2C09                <1> p5b:    sub     al,9                    ; 5Bh-60h: -4 in all, index 22-27
  2476 00000A1B 0405                <1> p3a:    add     al,5                    ; 3Ah-40h: index 15-21
  2477 00000A1D 8A80[11080000]      <1> punct:  mov     al,[ptab+eax]
  2478 00000A23 8D80[11010000]      <1>         lea     eax,[hbase+eax]
  2479 00000A29 FFE0                <1>         jmp     eax
  2480                              <1> %endif
