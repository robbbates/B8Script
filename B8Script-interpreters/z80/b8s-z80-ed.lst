0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Spec: docs/b8script.md (2026-11-24).
0000                             ; 
0000                             ;  Four switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    EDITOR   1 = with the line editor built in (see the end of this file):
0000                             ;                 the spec's suggested standard. It goes with either setting
0000                             ;                 of the other two.
0000                             ;    CHECKED  0 = no checks (spec: the programmer is responsible)
0000                             ;             1 = starts with every variable at 0 and every word undefined,
0000                             ;                 and stops on every error in the spec's table (and Ctrl-C)
0000                             ;                 with a four-line report: the letter and the place as line
0000                             ;                 and column, the text there, and both stacks. See `error`.
0000                             ;    ANSI     what the console escapes of "$" (/00bbIC8= /| /` /~) do:
0000                             ;             1 = send ANSI (VT100) sequences through CONOUT
0000                             ;             0 = call the machine's own routines CONCLS, CONEOL, CONCUR and
0000                             ;                 CONAT (see the equates). The CP/M builds always send ANSI.
0000                             ; 
0000                             ;  In every build Ctrl-C stops a running program (an unchecked build stops
0000                             ;  without a word): see the console layer for the rules, the held key and
0000                             ;  the break-off cell.
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   0   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   0   ; 1 = checked build
0000                EDITOR:   EQU   1   ; 1 = with the line editor
0000                ANSI:     EQU   0   ; 1 = the console escapes send ANSI sequences
0000                FAST:     EQU   0   ; 1 = the speed build (not with EDITOR): see "The speed build"
0000                ANS:      EQU   ANSI+CPM-ANSI*CPM   ; (CP/M: always ANSI)
0000                EDGEN:    EQU   EDITOR*(1-CPM)   ; (the generic build with the editor)
0000                             ; (IF takes any value but 0 as true, so
0000                             ;  IF CHECKED+EDITOR means "either")
0000                TABP0:    EQU   EDGEN*(1-CHECKED)   ; (the build with its table in page zero)
0000                PTLATE:   EQU   1-(1-CPM)*(1-EDITOR)*(1-CHECKED)*(1-ANS)   ; (1: the table goes after psgn and pdec,
0000                             ;   not before them: wherever it doesn't cross a
0000                             ;   page. chktab.py says if it does)
0000                QUICK:    EQU   1-(1-FAST)*(CHECKED*CPM*EDITOR+CHECKED*(1-CPM)*(1-EDITOR))   
0000                             ; (1: the speed-ups that cost bytes: every build
0000                             ;  but the two that are full, the checked
0000                             ;  generic one and the checked CP/M editor.
0000                             ;  See "Speed-ups" below)
0000                QUICKU:   EQU   QUICK*(1-CHECKED)*(1-FAST)   ; (and those that only the unchecked
0000                             ;  builds take; the speed build has its own)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    IY   return-stack pointer. Entries are 2 bytes; the stack grows down.
0000                             ;         Only rpop and rpushn (and the checks) touch it. The alternate
0000                             ;         registers are not used at all: an interrupt routine may use them.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  One-byte calls. In a generic build the routines used most are reached
0000                             ;  with RST, one byte instead of three. The source writes them as macros:
0000                             ; 
0000                             ;    POPR   RST 08h  rpop    pop the return stack into DE
0000                             ;    DROP   RST 18h  drp     drop TOS, then next character  (ends a handler)
0000                             ;    NEGH   RST 20h  neg16   HL = -HL
0000                             ;    PUTA   RST 28h  putc    print A
0000                             ;    NEXT   RST 30h  next0   next character                 (ends a handler)
0000                             ; 
0000                             ;  RST 18h and RST 30h never return: an RST is a CALL, so the first thing
0000                             ;  each of them does is POP DE to throw the return address away.
0000                             ; 
0000                             ;  A CP/M build leaves page zero alone: there the macros are CALLs, and
0000                             ;  DROP and NEXT are jumps (DROPR and NEXTR: JR, where it reaches).
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (the top four bytes of the page are spare,
0000                             ;             so a full stack runs two bytes into the page below)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch, interpreter variables in the gaps, and the -n? line buffer
0000                             ;             at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack has a guard band: the data stack can
0000                             ;  overrun by a cell or two (and the calls made while it is full, the error
0000                             ;  report's included) into the top 32 bytes of the return-stack page, which
0000                             ;  are never used, and the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
                    BDOS:     EQU   0005h   
                    BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IF   CPM*(1-EDITOR)   
                    EXIT:     EQU   0000h   ; warm boot
0000                          ENDIF      
0000                          IFN   CPM   
0000                             ; ---- generic machine: edit these to suit -----------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The zero flag must match A
0000                             ;   (end the routine with OR A / RET).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                             ;   KEY and CONOUT must preserve BC, DE, HL and IY.
0000                          ENDIF      
0000                          IF   1-ANS   
0000                             ; With ANSI = 0 the console escapes call these. All four must keep BC and
0000                             ; IY, and all but CONAT also HL. They may change A, DE and the flags.
0000                CONCLS:   EQU   0FF0Ch   ; /{  clear the screen, the cursor to the top left
0000                CONEOL:   EQU   0FF0Fh   ; /}  clear from the cursor to the end of the line
0000                CONCUR:   EQU   0FF12h   ; /| and /`  show the cursor if A is not 0, hide
0000                             ;     it if A = 0
0000                CONAT:    EQU   0FF15h   ; /~  the cursor to row HL, column DE, both
0000                             ;     counted from 0. May change A, DE and HL
0000                          ENDIF      
0000                          IFN   CPM   
0000                RSPAGE:   EQU   80h   ; 8000h return stack
0000                DSPAGE:   EQU   81h   ; 8100h data stack
0000                LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
0000                PROG:     EQU   8300h   ; where the loader puts the program text
0000                HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
0000                CPAGE:    EQU   HEAPLIM   ; the skip cache's page (QUICK builds): the page
0000                             ;   at the heap limit, which the heap never reaches
0000                BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)   
                    EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                          ENDIF      
0000                          IF   EDGEN   
0000                LEAVE:    EQU   0FF09h   ; where the editor's ^X goes
0000                          ENDIF      
0000                          IF   EDITOR*CPM   
                    LEAVE:    EQU   0000h   ; the editor's ^X: warm boot
0000                          ENDIF      
0000                          IF   EDITOR   
0000                EXIT:     EQU   edend   ; a program that ends goes back to the editor,
0000                SKEND:    EQU   skend   ;   also when it ends inside skip
0000                          ENDIF      
0000                          IF   1-EDITOR   
                    SKEND:    EQU   EXIT   
0000                          ENDIF      
0000                MSLOOP:   EQU   40-36*CPM   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine. (The wait
0000                             ; for a second Ctrl-C uses it too: 250 ms.)
0000                             ; CP/M: 4, for a BDOS 6 call of about 280 us
0000                             ; (an RC2014 with RomWBW and ZPM3). A .COM can
0000                             ; be patched: see TIMING.B8S.
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                             ;   around machine code (and in the checked
0000                             ;   build the address "$" prints from);
0000                PCNT:     EQU   LET+36h   ;   the break-key poll count (see rpushn);
0000                SKPL:     EQU   LET+3Ch   ;   the checked skip's starting place;
0000                NPEND:    EQU   LET+38h   ;   minus the address of the program's end
0000                             ;   (the heap"s first byte), for the checked "_';
0000                EDLN:     EQU   LET+3Ah   ;   the editor: the number of the line that ^E
0000                             ;   put in the input line (0: none)
0000                KEYBUF:   EQU   LET+7Ah   ; gap after z: a key read by the break check and
0000                             ;   held for the next "?" (0: none);
0000                BRKOFF:   EQU   LET+7Bh   ;   the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FCh   ; empty data stack. The four bytes above it
0000                             ; are spare: a character can pop two cells
0000                             ; too many before the checked build sees it,
0000                             ; and the next call must not land on the
0000                             ; letter cells.
0000                             ; The five one-byte calls. A generic build owns page zero and reaches them
0000                             ; with RST. A CP/M build must leave page zero alone (CP/M keeps it for
0000                             ; interrupts, and RomWBW's BIOS calls itself through RST 08h), so there each
0000                             ; is a CALL, or a jump for the two that never return: DROP is a JP, and
0000                             ; NEXT is JP (IX), two bytes, with IX holding next0's address throughout.
0000                             ; (asm80 can't nest IF, so these are written with DS: a count of 0 writes
0000                             ; nothing. DS can't take a label that comes later, but EQU can, and DS can
0000                             ; take that.)
0000                AROP:     EQU   rpop   
0000                ANEG:     EQU   neg16   
0000                APUT:     EQU   putc   
0000                APTK:     EQU   putk   
0000                          IF   1-CPM   
0000                PUTK:     EQU   putc   ; (CP/M only: here it is never used)
0000                          ENDIF      
0000                ANXT:     EQU   next0   
0000                          IF   CHECKED   
                    ACHK:     EQU   chkstk   ; (for the speed build's dispatcher)
0000                          ENDIF      
0000                          IF   1-CHECKED   
0000                ACHK:     EQU   0   
0000                          ENDIF      
0000                          IF   FAST   
                    DTPG:     EQU   DTAB/256   ; (the speed build"s table"s first page)
0000                          ENDIF      
0000                          IF   1-FAST   
0000                DTPG:     EQU   0   
0000                          ENDIF      
0000                .macro POPR,
0000                             ; 
0000                 DS      1-CPM,0CFh      ;   RST 08h
0000                 DS      CPM,0CDh        ;   CALL rpop
0000                 DS      CPM,AROP&0FFh
0000                 DS      CPM,AROP/256
0000                .endm
0000                 
0000                .macro DROP,
0000                             ; 
0000                 DS      (1-CPM)*(1-FAST),0DFh ; RST 18h
0000                 DS      CPM+FAST-CPM*FAST,0E1h ; POP HL
0000                 DS      CPM+FAST-CPM*FAST,0DDh ; JP (IX)
0000                 DS      CPM+FAST-CPM*FAST,0E9h
0000                .endm
0000                 
0000                .macro NEGH,
0000                             ; 
0000                 DS      1-CPM,0E7h      ;   RST 20h
0000                 DS      CPM,0CDh        ;   CALL neg16
0000                 DS      CPM,ANEG&0FFh
0000                 DS      CPM,ANEG/256
0000                .endm
0000                 
0000                .macro PUTA,
0000                             ; 
0000                 DS      1-CPM,0EFh      ;   RST 28h
0000                 DS      CPM,0CDh        ;   CALL putc
0000                 DS      CPM,APUT&0FFh
0000                 DS      CPM,APUT/256
0000                .endm
0000                 
0000                .macro PUTK,
0000                             ; 
0000                 DS      1-CPM,3Eh       ;   LD A,%%1 / RST 28h
0000                 DS      1-CPM,%%1
0000                 DS      1-CPM,0EFh
0000                 DS      CPM,0CDh        ;   CALL putk / DB %%1
0000                 DS      CPM,APTK&0FFh
0000                 DS      CPM,APTK/256
0000                 DS      CPM,%%1
0000                .endm
0000                 
0000                .macro PUTAR,
0000                             ; 
0000                 DS      1-CPM,0EFh      ;   RST 28h
0000                 DS      1-CPM,0C9h      ;   RET
0000                 DS      CPM,0C3h        ;   JP putc
0000                 DS      CPM,APUT&0FFh
0000                 DS      CPM,APUT/256
0000                .endm
0000                 
0000                .macro NEXT,
0000                             ; 
0000                 DS      (1-CPM)*(1-FAST),0F7h ; RST 30h
0000                 DS      CPM+FAST-CPM*FAST,0DDh ; JP (IX): IX holds next0
0000                 DS      CPM+FAST-CPM*FAST,0E9h
0000                .endm
0000                 
0000                .macro NEXTF,
0000                             ; 
0000                 DS      FAST*CHECKED,0CDh ;   (speed build: CALL chkstk, checked)
0000                 DS      FAST*CHECKED,ACHK&0FFh
0000                 DS      FAST*CHECKED,ACHK/256
0000                 DS      FAST,0Ah        ;   (speed build: the dispatcher: LD A,(BC)
0000                 DS      FAST,03h        ;   INC BC
0000                 DS      FAST,0EBh       ;   EX DE,HL
0000                 DS      FAST,6Fh        ;   LD L,A
0000                 DS      FAST,26h        ;   LD H,DTAB/256
0000                 DS      FAST,DTPG
0000                 DS      FAST,7Eh        ;   LD A,(HL)
0000                 DS      FAST,24h        ;   INC H
0000                 DS      FAST,66h        ;   LD H,(HL)
0000                 DS      FAST,6Fh        ;   LD L,A
0000                 DS      FAST,0E9h       ;   JP (HL))
0000                .endm
0000                 
0000                .macro NEXTZ,
0000                             ; 
0000                 DS      1-CPM,0F7h      ;   byte there in every build (RST 30h)
0000                 DS      CPM,0DDh        ; JP (IX)
0000                 DS      CPM,0E9h
0000                .endm
0000                 
0000                .macro SETIX,
0000                             ; 
0000                 DS      CPM+FAST-CPM*FAST,0DDh ; a generic build): LD IX,next0
0000                 DS      CPM+FAST-CPM*FAST,21h
0000                 DS      CPM+FAST-CPM*FAST,ANXT&0FFh
0000                 DS      CPM+FAST-CPM*FAST,ANXT/256
0000                .endm
0000                 
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is just the start of the .COM file.
0000                             ; =============================================================================
0000                          .ORG   BASE   
0000                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              XOR   A   ; 00  reset. (This byte, AFh, is also what an
0000                          ENDIF      ;     undefined word runs into: see e_hi.)
0000                          IF   1-EDGEN   
                              LD   SP,DSTOP   ; 00  reset, or the start of the .COM file
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)   
                              JP   qstart   ; 03  (the skip cache is emptied first)
                              DW   0   ; 06  spare
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              JR   init   ; 04  (the rest of the startup is close by)
                              DW   0   ; 06  spare
0000                          ENDIF      
0000                          IF   EDGEN   
0000   AF                     XOR   A   ; 00  reset: no program yet. (This byte, AFh,
0001   32 00 83               LD   (PROG),A   ;     is also what an undefined word runs
0004   C3 FF 03               JP   init   ; 04  into in the checked build: see e_hi.)
0007   00                     NOP      ; 07  spare
0008                          ENDIF      
0008                          IF   CPM*(1-EDITOR)   
                              JP   start   ; 03
0008                          ENDIF      
0008                          IF   CPM*EDITOR*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
                                 ; is held back.
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
0008                          ENDIF      
0008                          IF   CPM*EDITOR   
                              CALL   load   ; the file named on the command line
                              JP   edit0   
0008                          ENDIF      
0008                          IF   1-CPM   
0008                             ; ---- RST 08h: rpop: pop the return stack into DE ---------------------------
0008   FD 5E 00     RPOP:     LD   E,(IY+0)   ; 08
000B   FD 56 01               LD   D,(IY+1)   
000E   18 1B                  JR   rp2   ; (the rest is at 2Bh)
0010                             ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
0010   C6 21        CTL:      ADD   A,21h   ; 10  back to c; zero only for NUL
0012   20 1D                  JR   NZ,next0   ;     the rest are ignored
0014   C3 41 04     ENDPROG:   JP   EXIT   ;     the program has ended
0017   00                     NOP      ; 17  spare
0018                             ; ---- RST 18h: drop TOS, then next ------------------------------------------
0018   D1           RST18:    POP   DE   ; 18  discard the RST's return address
0019   E1           DRP:      POP   HL   ;     new TOS = NOS
001A   18 15                  JR   next0   
001C                          ENDIF      
001C   E5           H_FROMR:   PUSH   HL   ; 1C  "}" return stack to TOS
001D                          ;*Macro unroll:  POPR
001D   CF                     DS   1-CPM,0CFh   
001E                          DS   CPM,0CDh   
001E                          DS   CPM,AROP&0FFh   
001E                          DS   CPM,AROP/256   
001E   EB                     EX   DE,HL   
001F                          ;*Macro unroll:  NEXTZ
001F   F7                     DS   1-CPM,0F7h   
0020                          DS   CPM,0DDh   
0020                          DS   CPM,0E9h   
0020                          IF   1-CPM   
0020                             ; ---- RST 20h: neg16: HL = -HL (keeps BC, DE) -------------------------------
0020   AF           NEG16:    XOR   A   ; 20
0021   95                     SUB   L   
0022   6F                     LD   L,A   
0023   9F                     SBC   A,A   
0024   94                     SUB   H   
0025   67                     LD   H,A   
0026   C9                     RET      
0027   00                     NOP      ; 27  spare
0028                             ; ---- RST 28h: putc: print A (keeps BC, DE, HL, IY) -------------------------
0028                RST28:       
0028   C3 03 FF     PUTC:     JP   CONOUT   ; 28
002B   FD 23        RP2:      INC   IY   ; 2B  the rest of rpop
002D   FD 23                  INC   IY   
002F   C9                     RET      
0030                             ; ---- RST 30h: next character -----------------------------------------------
0030   D1           RST30:    POP   DE   ; 30  discard the RST's return address
0031                          ENDIF      
0031                          IF   CPM   
                                 ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
                    CTL:      ADD   A,21h   ; back to c; zero only for NUL
                              JR   NZ,next0   ; the rest are ignored
                    ENDPROG:   JP   EXIT   ; the program has ended
0031                          ENDIF      
0031                             ; =============================================================================
0031                             ;  The inner loop: read one character and sort it by range.
0031                             ; 
0031                             ;    00h          end of program
0031                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0031                             ;    30h-39h      digit: read a whole number
0031                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0031                             ;    61h-7Ah      a-z: push the address of that letter's cell
0031                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0031                             ; =============================================================================
0031                          IF   FAST   
                              ;*Macro unroll: next0:  NEXTF                   ; (the speed build: the table dispatcher)
                    NEXT0:    DS   FAST*CHECKED,0CDh   ; (the speed build: the table dispatcher)
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
0031                          ENDIF      
0031                          IF   1-FAST   
0031                NEXT0:       
0031                          ENDIF      
0031                          IF   CHECKED*(1-FAST)   
                              CALL   chkstk   ; both stacks are checked once per character
0031                          ENDIF      
0031                          IF   1-FAST   
0031   0A                     LD   A,(BC)   
0032   03                     INC   BC   
0033   D6 21                  SUB   21h   ; A = c - 21h
0035   38 D9                  JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
0037   FE 0F                  CP   0Fh   
0039   38 22                  JR   C,punct   ; 21h-2Fh: PTAB index 0-14
003B   D6 0F                  SUB   0Fh   ; A = c - 30h
003D   FE 0A                  CP   0Ah   
003F   38 73                  JR   C,digit   ; 30h-39h
0041   FE 11                  CP   11h   
0043   38 16                  JR   C,p3a   ; 3Ah-40h
0045   D6 11                  SUB   11h   ; A = c - 41h
0047   FE 1A                  CP   1Ah   
0049   38 72                  JR   C,upper   ; 41h-5Ah: A = letter index 0-25
004B   FE 20                  CP   20h   
004D   38 0A                  JR   C,p5b   ; 5Bh-60h
004F   FE 3A                  CP   3Ah   
0051   38 67                  JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0053   FE 3E                  CP   3Eh   
0055                          ENDIF      
0055                          IF   (1-CHECKED)*(1-FAST)   
0055   30 DA                  JR   NC,next0   ; 7Fh-FFh: ignored
0057                          ENDIF      
0057                          IF   CHECKED*(1-FAST)   
                              JR   Z,next0   ; 7Fh, DEL: ignored
                              JP   NC,e_hi   ; 80h-FFh: reserved
0057                          ENDIF      
0057                          IF   1-FAST   
0057   D6 1A                  SUB   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
0059   D6 09        P5B:      SUB   9   ; 5Bh-60h: -4 in all, index 22-27
005B   C6 05        P3A:      ADD   A,5   ; 3Ah-40h: index 15-21
005D                          ENDIF      
005D                .macro PTABLE,
005D                             ; 
005D                 DB      h_store & 0FFh  ; !
005D                 DB      h_str & 0FFh    ; "
005D                 DB      h_num & 0FFh    ; #
005D                 DB      h_print & 0FFh  ; $
005D                 DB      h_swap & 0FFh   ; %
005D                 DB      h_and & 0FFh    ; &
005D                 DB      h_emit & 0FFh   ; '
005D                 DB      h_open & 0FFh   ; (
005D                 DB      h_close & 0FFh  ; )
005D                 DB      h_mul & 0FFh    ; *
005D                 DB      h_add & 0FFh    ; +
005D                 DB      h_cfetch & 0FFh ; ,
005D                 DB      h_sub & 0FFh    ; -
005D                 DB      h_cstore & 0FFh ; .
005D                 DB      h_div & 0FFh    ; /
005D                 DB      h_dup & 0FFh    ; :
005D                 DB      h_drop & 0FFh   ; ;
005D                 DB      h_lt & 0FFh     ; <
005D                 DB      h_eq & 0FFh     ; =
005D                 DB      h_gt & 0FFh     ; >
005D                 DB      h_key & 0FFh    ; ?
005D                 DB      h_fetch & 0FFh  ; @
005D                 DB      h_def & 0FFh    ; [
005D                 DB      h_break & 0FFh  ; \
005D                 DB      h_ret & 0FFh    ; ]
005D                 DB      h_xor & 0FFh    ; ^
005D                 DB      h_alloc & 0FFh  ; _
005D                 DB      h_grave & 0FFh  ; `
005D                 DB      h_tor & 0FFh    ; {
005D                 DB      h_or & 0FFh     ; |
005D                 DB      h_fromr & 0FFh  ; }
005D                 DB      h_not & 0FFh    ; ~
005D                .endm
005D                 
005D                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
005D                             ; untouched, and A, DE free.
005D                          IF   1-FAST   
005D   C6 6A        PUNCT:    ADD   A,PTAB & 0FFh   ; PTAB never crosses a page
005F   5F                     LD   E,A   
0060   16 00                  LD   D,PTAB / 256   ; (0 if the table is in page zero)
0062   FE 81                  CP   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
0064   1A                     LD   A,(DE)   
0065   5F                     LD   E,A   ; the handler's low byte
0066                          ENDIF      
0066                          IF   (1-CPM)*(1-TABP0)*(1-FAST)   
                              LD   D,0   
0066                          ENDIF      
0066                          IF   (1-CPM)*(1-FAST)   
0066   CB 12                  RL   D   ; its page: 0 + carry
0068                          ENDIF      
0068                          IF   CPM*(1-FAST)   
                              LD   D,1   
                              JR   NC,pu1   
                              INC   D   ; its page: 1 + carry
                    PU1:         
0068                          ENDIF      
0068                          IF   1-FAST   
0068   D5                     PUSH   DE   ; jump to it; the stack is balanced again
0069   C9                     RET      ;   when the handler starts
006A                          ENDIF      
006A                             ; The rest of the startup: here so that the generic reset code can reach it
006A                             ; with JR. st0: find the program's NUL; the heap starts after it.
006A                             ; (The editor build has its own copy of this, next to the editor.)
006A                             ; A checked build first clears the lower half of the letter page (A = 0):
006A                             ; every variable starts at 0, every word cell holds 0000h, the address an
006A                             ; undefined word is caught at (see e_hi), and no key is held back.
006A                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                    INIT:     LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
                              LD   BC,PROG   ; the IP
006A                          ENDIF      
006A                          IF   (1-CPM)*(1-EDITOR)   
                    ST0:      LD   H,B   
                              LD   L,C   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
006A                          ENDIF      
006A                          IF   1-EDITOR   
                    ST2:      LD   (HEAP),HL   
006A                          ENDIF      
006A                          IF   CHECKED*(1-EDITOR)   
                              ;*Macro unroll:  NEGH                    ; minus the heap's first address: '_' may not
                              DS   1-CPM,0E7h   ; minus the heap"s first address: "_' may not
                              DS   CPM,0CDh   
                              DS   CPM,ANEG&0FFh   
                              DS   CPM,ANEG/256   
                              LD   (NPEND),HL   ;   release below it
006A                          ENDIF      
006A                          IF   (1-CHECKED)*(1-EDITOR)*(1-CPM)   
                              LD   H,A   ; (A = 0) no key is held, and the break key
                              LD   L,A   ;   is on (the checked build has cleared
006A                          ENDIF      ;   these)
006A                          IF   (1-CHECKED)*(1-EDITOR)*CPM   
                              LD   HL,0   
006A                          ENDIF      
006A                          IF   (1-CHECKED)*(1-EDITOR)   
                              LD   (KEYBUF),HL   
006A                          ENDIF      
006A                          IF   1-EDITOR   
                              ;*Macro unroll:  SETIX
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,21h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
                              LD   IY,RSTOP   ; the return stack is empty
                              ;*Macro unroll:  NEXT                    ; (its return address is thrown away)
                              DS   (1-CPM)*(1-FAST),0F7h   ; (its return address is thrown away)
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
006A                          ENDIF      
006A                             ; In the unchecked generic editor build the table is here, in the first
006A                             ; page, which saves loading D twice. (The other builds have no room for it
006A                             ; here: theirs is further down.)
006A                          IF   TABP0   
006A                PTAB:        
006A                          ;*Macro unroll:  PTABLE
006A   95                     DB   h_store & 0FFh   
006B   9A                     DB   h_str & 0FFh   
006C   BD                     DB   h_num & 0FFh   
006D   A1                     DB   h_print & 0FFh   
006E   90                     DB   h_swap & 0FFh   
006F   4A                     DB   h_and & 0FFh   
0070   BA                     DB   h_emit & 0FFh   
0071   29                     DB   h_open & 0FFh   
0072   31                     DB   h_close & 0FFh   
0073   6B                     DB   h_mul & 0FFh   
0074   41                     DB   h_add & 0FFh   
0075   D9                     DB   h_cfetch & 0FFh   
0076   39                     DB   h_sub & 0FFh   
0077   92                     DB   h_cstore & 0FFh   
0078   6F                     DB   h_div & 0FFh   
0079   8E                     DB   h_dup & 0FFh   
007A   94                     DB   h_drop & 0FFh   
007B   52                     DB   h_lt & 0FFh   
007C   61                     DB   h_eq & 0FFh   
007D   53                     DB   h_gt & 0FFh   
007E   C1                     DB   h_key & 0FFh   
007F   24                     DB   h_fetch & 0FFh   
0080   07                     DB   h_def & 0FFh   
0081   FA                     DB   h_break & 0FFh   
0082   F6                     DB   h_ret & 0FFh   
0083   8A                     DB   h_xor & 0FFh   
0084   9D                     DB   h_alloc & 0FFh   
0085   E0                     DB   h_grave & 0FFh   
0086   DC                     DB   h_tor & 0FFh   
0087   92                     DB   h_or & 0FFh   
0088   1C                     DB   h_fromr & 0FFh   
0089   9A                     DB   h_not & 0FFh   
008A                PTABEND:      
008A                          ENDIF      
008A                             ; =============================================================================
008A                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
008A                             ;  (00bbIGFuZCA= are up among the RST routines.) The machine-code call, exec,
008A                             ;  is here too: it belongs to "`" and makes the page come out right.
008A                             ; =============================================================================
008A   D1           H_XOR:    POP   DE   
008B   7C                     LD   A,H   
008C   AA                     XOR   D   
008D   67                     LD   H,A   
008E   7D                     LD   A,L   
008F   AB                     XOR   E   
0090   6F                     LD   L,A   
0091                          ;*Macro unroll:  NEXT
0091   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0092                          DS   CPM+FAST-CPM*FAST,0DDh   
0092                          DS   CPM+FAST-CPM*FAST,0E9h   
0092   D1           H_OR:     POP   DE   
0093   7C                     LD   A,H   
0094   B2                     OR   D   
0095   67                     LD   H,A   
0096   7D                     LD   A,L   
0097   B3                     OR   E   
0098   6F                     LD   L,A   
0099                          ;*Macro unroll:  NEXT
0099   F7                     DS   (1-CPM)*(1-FAST),0F7h   
009A                          DS   CPM+FAST-CPM*FAST,0DDh   
009A                          DS   CPM+FAST-CPM*FAST,0E9h   
009A                          ;*Macro unroll: h_not:  NEGH                    ; ~x = -x - 1
009A   E7           H_NOT:    DS   1-CPM,0E7h   ; ~x = -x - 1
009B                          DS   CPM,0CDh   
009B                          DS   CPM,ANEG&0FFh   
009B                          DS   CPM,ANEG/256   
009B   2B                     DEC   HL   
009C                          ;*Macro unroll:  NEXT
009C   F7                     DS   (1-CPM)*(1-FAST),0F7h   
009D                          DS   CPM+FAST-CPM*FAST,0DDh   
009D                          DS   CPM+FAST-CPM*FAST,0E9h   
009D                             ; "_" ( n -- addr ): the heap pointer moves by n, a signed count (the add is
009D                             ; the same either way); TOS is the old pointer.
009D   ED 5B 7C 82  H_ALLOC:   LD   DE,(HEAP)   
00A1                          IF   CHECKED*CPM   
                              LD   A,H   ; the count's sign, for chkhp
00A1                          ENDIF      
00A1   19                     ADD   HL,DE   ; the new top
00A2                          IF   CHECKED   
                              CALL   chkhp   
00A2                          ENDIF      
00A2   22 7C 82               LD   (HEAP),HL   
00A5   EB                     EX   DE,HL   
00A6                          ;*Macro unroll:  NEXT
00A6   F7                     DS   (1-CPM)*(1-FAST),0F7h   
00A7                          DS   CPM+FAST-CPM*FAST,0DDh   
00A7                          DS   CPM+FAST-CPM*FAST,0E9h   
00A7                          IF   1-CPM*CHECKED   
00A7   FD 22 34 82  EXEC:     LD   (RSAVE),IY   ; machine code may change IX and IY
00AB   CD DF 00               CALL   jphl   
00AE   FD 2A 34 82            LD   IY,(RSAVE)   
00B2                          ;*Macro unroll:  SETIX
00B2                          DS   CPM+FAST-CPM*FAST,0DDh   
00B2                          DS   CPM+FAST-CPM*FAST,21h   
00B2                          DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
00B2                          DS   CPM+FAST-CPM*FAST,ANXT/256   
00B2   E1                     POP   HL   
00B3                          ;*Macro unroll:  NEXT
00B3   F7                     DS   (1-CPM)*(1-FAST),0F7h   
00B4                          DS   CPM+FAST-CPM*FAST,0DDh   
00B4                          DS   CPM+FAST-CPM*FAST,0E9h   
00B4                          ENDIF      
00B4                             ; ---- the letters and digits (here, in the middle, so that the inner loop's
00B4                             ; ---- short jumps reach them, and the handlers after them reach rpushn) ------
00B4                             ; Digits: step back onto the first digit and read the whole number.
00B4   E5           DIGIT:    PUSH   HL   
00B5   0B                     DEC   BC   
00B6   CD 97 02               CALL   rdnum   
00B9                          ;*Macro unroll:  NEXT
00B9   F7                     DS   (1-CPM)*(1-FAST),0F7h   
00BA                          DS   CPM+FAST-CPM*FAST,0DDh   
00BA                          DS   CPM+FAST-CPM*FAST,0E9h   
00BA                             ; a-z: push the cell's address (the cell is the variable)
00BA                             ;  (the unchecked builds with room do x@ and x! in one step: lowq)
00BA                          IF   1-QUICKU   
                    LOWER:    PUSH   HL   
                              ADD   A,A   
                              LD   L,A   
                              LD   H,LETPAGE   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
00BA                          ENDIF      
00BA                          IF   QUICKU   
00BA   C3 76 03     LOWER:    JP   lowq   
00BD                          ENDIF      
00BD                             ; A-Z: call the word. The return address (the IP after the letter) goes on
00BD                             ; the return stack, and the IP becomes the address in the letter's cell.
00BD   C5           UPPER:    PUSH   BC   ; the return address, for rpushn
00BE   EB                     EX   DE,HL   ; park TOS
00BF   87                     ADD   A,A   
00C0   6F                     LD   L,A   
00C1   26 82                  LD   H,LETPAGE   ; HL -> cell
00C3   4E                     LD   C,(HL)   
00C4   2C                     INC   L   
00C5   46                     LD   B,(HL)   ; IP = the word's body
00C6   EB                     EX   DE,HL   ; TOS back, and fall into rpushn
00C7                             ; rpushn: move the top cell of the data stack (in memory) to the return
00C7                             ; stack, then next. Everything that pushes the return stack ends here.
00C7                             ; 
00C7                             ; The break key is looked at here, so at every word call and loop-back (and
00C7                             ; block entry and "{"), but only one time in 256: PCNT counts them.
00C7                             ; Reading the keyboard can be slow (it is a BDOS call under CP/M).
00C7   D1           RPUSHN:   POP   DE   
00C8   FD 72 FF               LD   (IY-1),D   
00CB   FD 73 FE               LD   (IY-2),E   
00CE   FD 2B                  DEC   IY   
00D0   FD 2B                  DEC   IY   
00D2   E5                     PUSH   HL   
00D3   21 36 82               LD   HL,PCNT   
00D6   35                     DEC   (HL)   
00D7   E1                     POP   HL   ; (the zero flag lasts)
00D8   CC C1 03               CALL   Z,pollk   
00DB                          ;*Macro unroll:  NEXT
00DB   F7                     DS   (1-CPM)*(1-FAST),0F7h   
00DC                          DS   CPM+FAST-CPM*FAST,0DDh   
00DC                          DS   CPM+FAST-CPM*FAST,0E9h   
00DC                             ; "{" TOS to the return stack: the new TOS comes up, the old one goes across.
00DC   E3           H_TOR:    EX   (SP),HL   
00DD   18 E8                  JR   rpushn   
00DF   E9           JPHL:     JP   (HL)   ; (for the machine-code call)
00E0                             ; ---- machine code: the grave -----------------------------------------------
00E0                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
00E0                             ; are stored from addr until a non-hex character; then a RET (C9h) is
00E0                             ; written and its address is left. An odd last digit is consumed and dropped.
00E0                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
00E0                             ; code is entered by CALL with the data stack above the return address; it
00E0                             ; must keep BC, and on return the top cell becomes the new TOS.
00E0   CD 95 03     H_GRAVE:   CALL   hexc   
00E3                          IF   1-CPM*CHECKED   
00E3   30 C2                  JR   NC,exec   
00E5                          ENDIF      
00E5                          IF   CPM*CHECKED   
                              JP   NC,exec   ; (out of the way: see rpop)
00E5                          ENDIF      
00E5   77           HX1:      LD   (HL),A   ; the high digit goes in first ...
00E6   CD 95 03               CALL   hexc   
00E9   30 08                  JR   NC,hx2   ; odd digit: consumed, and the RET below
00EB   ED 6F                  RLD      ;   overwrites it
00ED   23                     INC   HL   ; ... and RLD shifts it up under the low one
00EE   CD 95 03               CALL   hexc   
00F1   38 F2                  JR   C,hx1   
00F3   36 C9        HX2:      LD   (HL),0C9h   ; (never range-checked: the spec says so)
00F5                          ;*Macro unroll:  NEXT
00F5   F7                     DS   (1-CPM)*(1-FAST),0F7h   
00F6                          DS   CPM+FAST-CPM*FAST,0DDh   
00F6                          DS   CPM+FAST-CPM*FAST,0E9h   
00F6                             ; ---- where the two pages meet ----------------------------------------------
00F6                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
00F6                             ; are in falling code order for this), and where exactly differs between the
00F6                             ; builds: NPG1 follows. Every handler below these four must start in the
00F6                             ; second page, and every one above in the first; chktab.py checks both.
00F6                             ; "]" returns: pop an address and jump to it.
00F6                          ;*Macro unroll: h_ret:  POPR
00F6   CF           H_RET:    DS   1-CPM,0CFh   
00F7                          DS   CPM,0CDh   
00F7                          DS   CPM,AROP&0FFh   
00F7                          DS   CPM,AROP/256   
00F7   42                     LD   B,D   
00F8   4B                     LD   C,E   
00F9                          ;*Macro unroll: brk1:   NEXT
00F9   F7           BRK1:     DS   (1-CPM)*(1-FAST),0F7h   
00FA                          DS   CPM+FAST-CPM*FAST,0DDh   
00FA                          DS   CPM+FAST-CPM*FAST,0E9h   
00FA                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
00FA                             ; drops the block start, "]" returns. No closer at all ends the program.
00FA   7C           H_BREAK:   LD   A,H   
00FB   B5                     OR   L   
00FC   E1                     POP   HL   
00FD   28 FA                  JR   Z,brk1   
00FF   CD B9 02               CALL   skip   
0102   B7                     OR   A   ; skip returns 0 for ")"
0103   20 F1                  JR   NZ,h_ret   
0105                          ;*Macro unroll: rdrop:  POPR
0105   CF           RDROP:    DS   1-CPM,0CFh   
0106                          DS   CPM,0CDh   
0106                          DS   CPM,AROP&0FFh   
0106                          DS   CPM,AROP/256   
0106                          ;*Macro unroll:  NEXT
0106   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0107                          DS   CPM+FAST-CPM*FAST,0DDh   
0107                          DS   CPM+FAST-CPM*FAST,0E9h   
0107                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
0107                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
0107                             ; the body"s address instead. Either way it then skips to the matching "]'.
0107                             ; (The unchecked build takes anything that is not a letter as the space; the
0107                             ; checked build stops on it.)
0107   0A           H_DEF:    LD   A,(BC)   
0108   03                     INC   BC   
0109   D6 41                  SUB   "A"   ; a letter gives 0-25 or 32-57: lowercase
010B   5F                     LD   E,A   ;   lands 64 bytes up
010C   E6 DF                  AND   0DFh   ; fold case
010E   FE 1A                  CP   26   
0110   30 0B                  JR   NC,def2   ; not a letter
0112   CB 23                  SLA   E   
0114   16 82                  LD   D,LETPAGE   ; DE -> cell
0116   79                     LD   A,C   
0117   12                     LD   (DE),A   
0118   1C                     INC   E   
0119   78                     LD   A,B   
011A   12                     LD   (DE),A   
011B   18 03                  JR   skipnx   
011D                DEF2:        
011D                          IF   CHECKED   
                              LD   A,E   
                              CP   " "-"A"+256   
                              JP   NZ,e_brack   ; anything but a letter or a space
011D                          ENDIF      
011D   E5                     PUSH   HL   ; an anonymous block: push its address
011E   60                     LD   H,B   
011F   69                     LD   L,C   
0120                SKIPNX:      
0120                          IF   CHECKED   
                              DEC   BC   ; back onto the letter, so that skip finds its
0120                          ENDIF      ;   opener, the "[", just before where it starts
0120   CD B9 02     SKIPO:    CALL   skip   
0123                          ;*Macro unroll:  NEXT
0123   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0124                          DS   CPM+FAST-CPM*FAST,0DDh   
0124                          DS   CPM+FAST-CPM*FAST,0E9h   
0124   5E           H_FETCH:   LD   E,(HL)   ; "@"
0125   23                     INC   HL   
0126   56                     LD   D,(HL)   
0127   EB                     EX   DE,HL   
0128                          ;*Macro unroll:  NEXT
0128   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0129                          DS   CPM+FAST-CPM*FAST,0DDh   
0129                          DS   CPM+FAST-CPM*FAST,0E9h   
0129                             ; =============================================================================
0129                             ;  Handlers that must start in the image's second page.
0129                             ;  "?" is the last (with "," inside it), so its long tail may run past that
0129                             ;  page.
0129                             ; =============================================================================
0129                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
0129                             ; the matching ")".
0129   7C           H_OPEN:   LD   A,H   
012A   B5                     OR   L   
012B   E1                     POP   HL   
012C   28 F2                  JR   Z,skipo   
012E   C5                     PUSH   BC   ; the block starts at the IP
012F   18 96                  JR   rpushn   
0131                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
0131                             ; drops it and carries on.
0131   7C           H_CLOSE:   LD   A,H   
0132   B5                     OR   L   
0133   E1                     POP   HL   
0134   28 CF                  JR   Z,rdrop   
0136                          IF   QUICK   
0136   C3 66 03               JP   closeq   ; (out of the handlers' pages: see Speed-ups)
0139                          ENDIF      
0139                          IF   1-QUICK   
                              ;*Macro unroll:  POPR                    ; pop the block start ...
                              DS   1-CPM,0CFh   ; pop the block start ...
                              DS   CPM,0CDh   
                              DS   CPM,AROP&0FFh   
                              DS   CPM,AROP/256   
                              LD   B,D   
                              LD   C,E   
                              PUSH   BC   
0139                          ENDIF      
0139                          IF   (1-QUICK)*(1-CPM)   
                              JR   rpushn   ; ... and push it back
0139                          ENDIF      
0139                          IF   (1-QUICK)*CPM   
                              JP   rpushn   
0139                          ENDIF      
0139                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
0139                             ; "-" has two jobs: directly before a digit it starts a negative number.
0139   0A           H_SUB:    LD   A,(BC)   
013A   D6 30                  SUB   "0"   
013C   FE 0A                  CP   10   
013E   38 04                  JR   C,negnum   
0140                          ;*Macro unroll:  NEGH                    ; a - b = a + (-b): fall into '+'
0140   E7                     DS   1-CPM,0E7h   ; a - b = a + (-b): fall into "+"
0141                          DS   CPM,0CDh   
0141                          DS   CPM,ANEG&0FFh   
0141                          DS   CPM,ANEG/256   
0141   D1           H_ADD:    POP   DE   
0142   19                     ADD   HL,DE   
0143                          ;*Macro unroll:  NEXT
0143   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0144                          DS   CPM+FAST-CPM*FAST,0DDh   
0144                          DS   CPM+FAST-CPM*FAST,0E9h   
0144   E5           NEGNUM:   PUSH   HL   ; a negative number: read it, negate it
0145   CD 97 02               CALL   rdnum   
0148                          ;*Macro unroll:  NEGH
0148   E7                     DS   1-CPM,0E7h   
0149                          DS   CPM,0CDh   
0149                          DS   CPM,ANEG&0FFh   
0149                          DS   CPM,ANEG/256   
0149                          ;*Macro unroll:  NEXT
0149   F7                     DS   (1-CPM)*(1-FAST),0F7h   
014A                          DS   CPM+FAST-CPM*FAST,0DDh   
014A                          DS   CPM+FAST-CPM*FAST,0E9h   
014A   D1           H_AND:    POP   DE   
014B   7C                     LD   A,H   
014C   A2                     AND   D   
014D   67                     LD   H,A   
014E   7D                     LD   A,L   
014F   A3                     AND   E   
0150   6F                     LD   L,A   
0151                          ;*Macro unroll:  NEXT
0151   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0152                          DS   CPM+FAST-CPM*FAST,0DDh   
0152                          DS   CPM+FAST-CPM*FAST,0E9h   
0152                             ; Signed compares. Both are "HL < DE" for the right pair: "<" swaps the two
0152                             ; cells first. Flipping both sign bits turns a signed compare into an
0152                             ; unsigned one (and XOR clears the carry for SBC); SBC HL,HL then turns the
0152                             ; carry into -1 or 0 with no branch.
0152   E3           H_LT:     EX   (SP),HL   ; a < b: HL = a, and b is popped next
0153   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
0154   7C                     LD   A,H   
0155   EE 80                  XOR   80h   
0157   67                     LD   H,A   
0158   7A                     LD   A,D   
0159   EE 80                  XOR   80h   
015B   57                     LD   D,A   
015C   ED 52                  SBC   HL,DE   ; carry if HL < DE
015E   ED 62        TF:       SBC   HL,HL   ; carry -> -1 or 0
0160                          ;*Macro unroll:  NEXT
0160   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0161                          DS   CPM+FAST-CPM*FAST,0DDh   
0161                          DS   CPM+FAST-CPM*FAST,0E9h   
0161   D1           H_EQ:     POP   DE   
0162   B7                     OR   A   
0163   ED 52                  SBC   HL,DE   
0165   7C                     LD   A,H   
0166   B5                     OR   L   
0167   FE 01                  CP   1   ; carry only if a - b = 0
0169   18 F3                  JR   tf   
016B                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept. The
016B                             ; multiplier shifts up through A:C.
016B                          IF   1-QUICK   
                    H_MUL:    POP   DE   ; DE = multiplicand
                              PUSH   BC   
                              LD   A,H   
                              LD   C,L   ; A:C = multiplier
                              LD   HL,0   
                              LD   B,16   
                    MUL1:     ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mul2   
                              ADD   HL,DE   
                    MUL2:     DJNZ   mul1   
                              POP   BC   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
016B                          ENDIF      
016B                          IF   QUICK   
016B   D1           H_MUL:    POP   DE   ; DE = multiplicand
016C   C3 3A 03               JP   mulq   ; (out of the handlers' pages: see Speed-ups)
016F                          ENDIF      
016F                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
016F                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
016F                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
016F                             ; stops on it.
016F                H_DIV:       
016F                          IF   CHECKED   
                              LD   A,H   
                              OR   L   
                              JP   Z,e_zero   
016F                          ENDIF      
016F   D1                     POP   DE   ; DE = a, HL = b
0170   D5                     PUSH   DE   ; a, for r's sign
0171   7A                     LD   A,D   
0172   AC                     XOR   H   
0173   F5                     PUSH   AF   ; S flag = sign of q
0174   CB 7C                  BIT   7,H   
0176   C4 20 00               CALL   NZ,neg16   ; HL = |b|
0179   EB                     EX   DE,HL   
017A   CB 7C                  BIT   7,H   
017C   C4 20 00               CALL   NZ,neg16   ; HL = |a|, DE = |b|
017F   CD 42 02               CALL   udiv   ; HL = q, DE = r
0182   F1                     POP   AF   
0183   FC 20 00               CALL   M,neg16   ; q's sign
0186   EB                     EX   DE,HL   ; HL = r, DE = q
0187   F1                     POP   AF   ; A = a's high byte
0188   B7                     OR   A   
0189   FC 20 00               CALL   M,neg16   ; r's sign
018C   D5                     PUSH   DE   ; q under r
018D                          ;*Macro unroll:  NEXT
018D   F7                     DS   (1-CPM)*(1-FAST),0F7h   
018E                          DS   CPM+FAST-CPM*FAST,0DDh   
018E                          DS   CPM+FAST-CPM*FAST,0E9h   
018E                             ; ---- stack and storage -----------------------------------------------------
018E   E5           H_DUP:    PUSH   HL   ; ":"
018F                          ;*Macro unroll:  NEXT
018F   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0190                          DS   CPM+FAST-CPM*FAST,0DDh   
0190                          DS   CPM+FAST-CPM*FAST,0E9h   
0190   E3           H_SWAP:   EX   (SP),HL   ; "%"
0191                          ;*Macro unroll:  NEXT
0191   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0192                          DS   CPM+FAST-CPM*FAST,0DDh   
0192                          DS   CPM+FAST-CPM*FAST,0E9h   
0192                             ; (The checked build tests the address before it takes the value off the
0192                             ; stack, so that an error report shows both.)
0192                H_CSTORE:      ; "." ( c addr -- )
0192                          IF   CHECKED   
                              CALL   chkst   
0192                          ENDIF      
0192   D1                     POP   DE   
0193   73                     LD   (HL),E   
0194                          ;*Macro unroll: h_drop: DROP                    ; ';' is this one byte
0194   DF           H_DROP:   DS   (1-CPM)*(1-FAST),0DFh   ; ";" is this one byte
0195                          DS   CPM+FAST-CPM*FAST,0E1h   
0195                          DS   CPM+FAST-CPM*FAST,0DDh   
0195                          DS   CPM+FAST-CPM*FAST,0E9h   
0195                H_STORE:      ; "!" ( n addr -- )
0195                          IF   CHECKED   
                              CALL   chkst   
0195                          ENDIF      
0195   D1                     POP   DE   
0196   73                     LD   (HL),E   
0197   23                     INC   HL   
0198   72                     LD   (HL),D   
0199                          ;*Macro unroll:  DROP
0199   DF                     DS   (1-CPM)*(1-FAST),0DFh   
019A                          DS   CPM+FAST-CPM*FAST,0E1h   
019A                          DS   CPM+FAST-CPM*FAST,0DDh   
019A                          DS   CPM+FAST-CPM*FAST,0E9h   
019A                             ; ---- console ---------------------------------------------------------------
019A                             ; 22h pushes the address of the text after it and skips the string.
019A   E5           H_STR:    PUSH   HL   
019B   60                     LD   H,B   
019C   69                     LD   L,C   
019D   CD AE 02               CALL   skipstr   
01A0                          IF   CHECKED   
                              OR   A   ; 0: the text ran out before the closing quote
                              JP   Z,e_quote   
01A0                          ENDIF      
01A0                          ;*Macro unroll:  NEXT
01A0   F7                     DS   (1-CPM)*(1-FAST),0F7h   
01A1                          DS   CPM+FAST-CPM*FAST,0DDh   
01A1                          DS   CPM+FAST-CPM*FAST,0E9h   
01A1                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
01A1                             ; 60h to 7Eh is one of the escapes at pesc; "/" plus any other character
01A1                             ; clears that character"s bit 6 (/M is CR, and / then DEL gives "?"; "/',
01A1                             ; '"' and '?' have no bit 6, so //, /" and /? give themselves).
01A1                          IF   1-CHECKED   
01A1   7E           H_PRINT:   LD   A,(HL)   
01A2   23                     INC   HL   
01A3   FE 22                  CP   22h   
01A5   28 15                  JR   Z,pr9   
01A7   FE 2F                  CP   "/"   
01A9   20 0C                  JR   NZ,pr1   
01AB   7E                     LD   A,(HL)   
01AC   23                     INC   HL   
01AD   FE 60                  CP   60h   
01AF   38 04                  JR   C,pr0   
01B1   FE 7F                  CP   7Fh   
01B3   38 57                  JR   C,pesc   
01B5   E6 BF        PR0:      AND   0BFh   
01B7                          ;*Macro unroll: pr1:    PUTA
01B7   EF           PR1:      DS   1-CPM,0EFh   
01B8                          DS   CPM,0CDh   
01B8                          DS   CPM,APUT&0FFh   
01B8                          DS   CPM,APUT/256   
01B8   18 E7                  JR   h_print   
01BA                PRLOOP:   EQU   h_print   ; (where the escapes go back to)
01BA                PRAGAIN:   EQU   h_print   ; (and where /~ goes back to)
01BA                          ENDIF      
01BA                          IF   CHECKED   
                                 ; (The checked build has the loop as a routine, prstr, which the error
                                 ; report uses too. The address is kept meanwhile, for a report: it shows
                                 ; the stack as it was before the "$". /~ comes back to hp1.)
                    H_PRINT:   LD   (RSAVE),HL   
                    HP1:      CALL   prstr   
                              ;*Macro unroll:  DROP
                              DS   (1-CPM)*(1-FAST),0DFh   
                              DS   CPM+FAST-CPM*FAST,0E1h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
01BA                          ENDIF      
01BA   7D           H_EMIT:   LD   A,L   ; "'"
01BB                          ;*Macro unroll:  PUTA
01BB   EF                     DS   1-CPM,0EFh   
01BC                          DS   CPM,0CDh   
01BC                          DS   CPM,APUT&0FFh   
01BC                          DS   CPM,APUT/256   
01BC                          ;*Macro unroll: pr9:    DROP
01BC   DF           PR9:      DS   (1-CPM)*(1-FAST),0DFh   
01BD                          DS   CPM+FAST-CPM*FAST,0E1h   
01BD                          DS   CPM+FAST-CPM*FAST,0DDh   
01BD                          DS   CPM+FAST-CPM*FAST,0E9h   
01BD                             ; "#" prints TOS as a signed decimal number, with no space after it.
01BD   CD A7 03     H_NUM:    CALL   psgn   
01C0                          ;*Macro unroll:  DROP
01C0   DF                     DS   (1-CPM)*(1-FAST),0DFh   
01C1                          DS   CPM+FAST-CPM*FAST,0E1h   
01C1                          DS   CPM+FAST-CPM*FAST,0DDh   
01C1                          DS   CPM+FAST-CPM*FAST,0E9h   
01C1                             ; "?" ( n -- c ) or ( -n -- addr )
01C1                             ;   n > 0: wait about n ms for a key; 0 if none came
01C1                             ;   n = 0: wait for a key
01C1                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
01C1                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
01C1   CB 7C        H_KEY:    BIT   7,H   
01C3   20 19                  JR   NZ,line   
01C5   1E 28        KT1:      LD   E,MSLOOP   ; one millisecond, roughly
01C7   CD EF 03     KT2:      CALL   getk   
01CA   20 0E                  JR   NZ,kt3   
01CC   1D                     DEC   E   
01CD   20 F8                  JR   NZ,kt2   
01CF   7C                     LD   A,H   ; 0? never counts down: it waits
01D0   B5                     OR   L   
01D1   28 F2                  JR   Z,kt1   
01D3   2B                     DEC   HL   
01D4   7C                     LD   A,H   
01D5   B5                     OR   L   
01D6   20 ED                  JR   NZ,kt1   ; A = 0 if the time ran out
01D8   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
01D9   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
01DA   6F           KT3:      LD   L,A   
01DB   26 00                  LD   H,0   
01DD                          ;*Macro unroll:  NEXT
01DD   F7                     DS   (1-CPM)*(1-FAST),0F7h   
01DE                          DS   CPM+FAST-CPM*FAST,0DDh   
01DE                          DS   CPM+FAST-CPM*FAST,0E9h   
01DE                             ; Backspace takes the last character back (and is echoed as it
01DE                             ; is), CR ends (stored, not echoed), every other key is stored and
01DE                             ; echoed until the line is full. (CP/M too: getk reads through BDOS
01DE                             ; 6.) The line buffer starts at offset 80h of its page, so L alone
01DE                             ; is the place in the line: D holds the L of a full line.
01DE   11 7F 00     LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
01E1   19                     ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
01E2   9F                     SBC   A,A   
01E3   A5                     AND   L   ; (0 for a count that is too big)
01E4   2F                     CPL      
01E5   57                     LD   D,A   ; D = the L of a full line: 80h + count, FFh
01E6                             ;   at most
01E6   21 80 82               LD   HL,LINEBUF   
01E9   CD EF 03     LN2:      CALL   getk   
01EC   28 FB                  JR   Z,ln2   
01EE   FE 0D                  CP   13   
01F0   28 16                  JR   Z,ln5   
01F2   FE 08                  CP   8   
01F4   28 0B                  JR   Z,ln4   
01F6   5F                     LD   E,A   
01F7   7D                     LD   A,L   
01F8   BA                     CP   D   
01F9   28 EE                  JR   Z,ln2   ; full
01FB   73                     LD   (HL),E   
01FC   2C                     INC   L   
01FD   7B                     LD   A,E   
01FE                          ;*Macro unroll: ln3:    PUTA
01FE   EF           LN3:      DS   1-CPM,0EFh   
01FF                          DS   CPM,0CDh   
01FF                          DS   CPM,APUT&0FFh   
01FF                          DS   CPM,APUT/256   
01FF   18 E8                  JR   ln2   
0201   2D           LN4:      DEC   L   ; Backspace: one back, and echo it,
0202   FA FE 01               JP   M,ln3   ;   unless the line was empty (L left the
0205   2C                     INC   L   ;   upper half of the page)
0206   18 E1                  JR   ln2   
0208   77           LN5:      LD   (HL),A   ; the CR
0209   2E 80                  LD   L,LINEBUF & 0FFh   
020B                          ;*Macro unroll:  NEXT
020B   F7                     DS   (1-CPM)*(1-FAST),0F7h   
020C                          DS   CPM+FAST-CPM*FAST,0DDh   
020C                          DS   CPM+FAST-CPM*FAST,0E9h   
020C                             ; =============================================================================
020C                             ;  More routines (no handler starts past this point)
020C                             ; =============================================================================
020C                          IF   CHECKED   
                                 ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
                                 ; "$", and the texts of the report). A NUL first is an error: Q.
                    PRSTR:    LD   A,(HL)   
                              INC   HL   
                              CP   22h   
                              RET   Z   
                              OR   A   
                              JP   Z,e_dollar   
                              CP   "/"   
                              JR   NZ,prs1   
                              LD   A,(HL)   
                              INC   HL   
                              CP   60h   
                              JR   C,prs0   
                              CP   7Fh   
                              JR   C,pesc   
                    PRS0:     AND   0BFh   
                              ;*Macro unroll: prs1:   PUTA
                    PRS1:     DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              JR   prstr   
                    PRLOOP:   EQU   prstr   ; (where the escapes go back to)
                    PRAGAIN:   EQU   hp1   ; (and where /~ goes back to)
                                 ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
                                 ; pnl: the same, on a new line.
                    PNL:      CALL   pmsg   ; (pmsg's own CR LF, then on into pmsg for
                              DB   13,10,22h   ;   the caller's text)
                    PMSG:     EX   (SP),HL   
                              CALL   prstr   
                              EX   (SP),HL   
                              RET      
020C                          ENDIF      
020C                             ; pesc: the escapes of "$". A = the character after the "/", 60h to 7Eh, and
020C                             ; HL points past it. Each goes back into the loop that prints the string
020C                             ; (PRLOOP), but /~ has the stack to see to, and goes back by PRAGAIN.
020C                             ;    /a-/z   print the variable, as "#" does
020C                             ;    /{      clear the screen, the cursor to the top left
020C                             ;    /}      clear from the cursor to the end of the line
020C                             ;    /|  /`  show the cursor, hide it
020C                             ;    /~      ( row col -- ) the cursor to that row and column, from 0
020C   FE 7E        PESC:     CP   7Eh   
020E   28 1C                  JR   Z,pat   
0210   11 A1 01               LD   DE,PRLOOP   ; the others return into the loop
0213   D5                     PUSH   DE   
0214   D6 7B                  SUB   7Bh   ; 00bbIDAsIHwgMSwg 2, and no borrow
0216   30 1D                  JR   NC,pcon   
0218   C6 1A                  ADD   A,1Ah   ; a-z: 0-25, and a carry; `: FFh, and none
021A   30 22                  JR   NC,phide   
021C   87                     ADD   A,A   ; the variable's cell
021D   C6 40                  ADD   A,40h   
021F   E5                     PUSH   HL   
0220   6F                     LD   L,A   
0221   26 82                  LD   H,LETPAGE   
0223   7E                     LD   A,(HL)   
0224   2C                     INC   L   
0225   66                     LD   H,(HL)   
0226   6F                     LD   L,A   
0227   CD A7 03               CALL   psgn   
022A   E1                     POP   HL   
022B   C9                     RET      
022C                             ; /~ ( row col addr -- ): the two cells under the string's address go. In
022C                             ; the checked build "$" is the routine prstr: its own return address goes
022C                             ; first, and hp1 calls it again afterwards. There each /~ first looks that
022C                             ; its two cells are there, and is s if not, before it prints anything.
022C                PAT:         
022C                          IF   CHECKED   
                              EX   (SP),HL   ; the text pointer over prstr's return address
                              LD   HL,(6-DSTOP)&0FFFFh   ; a carry: the two cells aren't there
                              ADD   HL,SP   
                              JP   C,e_under   
                              POP   HL   
022C                          ENDIF      
022C   D1                     POP   DE   ; DE = the column
022D   E3                     EX   (SP),HL   ; HL = the row; the text pointer is kept
022E                          IF   1-ANS   
022E   CD 15 FF               CALL   CONAT   
0231   E1                     POP   HL   
0232   C3 A1 01               JP   PRAGAIN   
0235                             ; With ANSI = 0 the machine's routines do the rest.
0235   CA 0C FF     PCON:     JP   Z,CONCLS   ; /{
0238   FE 02                  CP   2   
023A   CA 0F FF               JP   Z,CONEOL   ; /}
023D   FE                     DB   0FEh   ; /|  (CP n steps over the XOR: A = 1, show)
023E   AF           PHIDE:    XOR   A   ; /`  (A = 0: hide)
023F   C3 12 FF               JP   CONCUR   
0242                          ENDIF      
0242                          IF   ANS   
                              PUSH   DE   
                              CALL   csi   ; ESC [ row+1 ; col+1 H (ANSI counts from 1)
                              INC   HL   
                              CALL   pdec   
                              ;*Macro unroll:  PUTK    3Bh             ; ';'
                              DS   1-CPM,3Eh   ; ";"
                              DS   1-CPM,3Bh   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,3Bh   
                              POP   HL   
                              INC   HL   
                              CALL   pdec   
                              ;*Macro unroll:  PUTK    48h             ; 'H'
                              DS   1-CPM,3Eh   ; "H"
                              DS   1-CPM,48h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,48h   
                              POP   HL   
                              JP   PRAGAIN   
                                 ; With ANSI = 1 they are sequences. The carry is clear on the way in.
                    PSHOW:    LD   E,"h"   ; /|  ESC [ ? 2 5 h
                              DB   0DAh   ; (JP C,nn: with no carry it steps over two bytes)
                    PHIDE:    LD   E,"l"   ; /`  ESC [ ? 2 5 l
0242                          ENDIF      
0242                          IF   ANS*CHECKED   
                                 ; (The checked build prints the fixed parts with pmsg, which it has for the
                                 ; report: shorter than a character at a time.)
                              CALL   pmsg   
                              DB   27,"[?25",22h   
                    PSE:      LD   A,E   ; then E
                              ;*Macro unroll:  PUTAR
                              DS   1-CPM,0EFh   
                              DS   1-CPM,0C9h   
                              DS   CPM,0C3h   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                                 ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into cse.
                    PCON:     DEC   A   
                              JR   Z,pshow   ; /|
                              LD   E,"K"   
                              JP   P,cse   ; /}  ESC [ K
                              LD   E,"H"   ; /{  ESC [ H ESC [ J
                              CALL   cse   
                              LD   E,"J"   ; (on into cse)
                                 ; cse: ESC [ and then E. csi: ESC [. Both keep HL.
                    CSE:      CALL   csi   
                              JR   pse   
                    CSI:      CALL   pmsg   
                              DB   27,"[",22h   
                              RET      
0242                          ENDIF      
0242                          IF   ANS*(1-CHECKED)   
                              LD   A,"?"   
                              CALL   csia   
                              ;*Macro unroll:  PUTK    32h             ; '2'
                              DS   1-CPM,3Eh   ; "2"
                              DS   1-CPM,32h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,32h   
                              ;*Macro unroll:  PUTK    35h             ; '5'
                              DS   1-CPM,3Eh   ; "5"
                              DS   1-CPM,35h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,35h   
                              LD   A,E   
                              ;*Macro unroll:  PUTAR
                              DS   1-CPM,0EFh   
                              DS   1-CPM,0C9h   
                              DS   CPM,0C3h   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                                 ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into csia.
                    PCON:     DEC   A   
                              JR   Z,pshow   ; /|
                              LD   A,"K"   
                              JP   P,csia   ; /}  ESC [ K
                              LD   A,"H"   ; /{  ESC [ H ESC [ J
                              CALL   csia   
                              LD   A,"J"   ; (on into csia)
                                 ; csia: ESC [ and then A. csi: ESC [, keeping A.
                    CSIA:     CALL   csi   
                              ;*Macro unroll:  PUTAR
                              DS   1-CPM,0EFh   
                              DS   1-CPM,0C9h   
                              DS   CPM,0C3h   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                    CSI:      PUSH   AF   
                              ;*Macro unroll:  PUTK    1Bh             ; ESC
                              DS   1-CPM,3Eh   ; ESC
                              DS   1-CPM,1Bh   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,1Bh   
                              ;*Macro unroll:  PUTK    5Bh             ; '['
                              DS   1-CPM,3Eh   ; "["
                              DS   1-CPM,5Bh   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,5Bh   
                              POP   AF   
                              RET      
0242                          ENDIF      
0242                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
0242                             ; Uses A; keeps BC (the IP) itself. The dividend shifts up through A:C while
0242                             ; the quotient bits arrive at the bottom of C.
0242                             ; Dividing by 2 is one shift (the spec wants that fast).
0242                          IF   1-QUICK   
                    UDIV:     LD   A,E   
                              XOR   2   
                              OR   D   
                              JR   NZ,udv0   
                              SRL   H   
                              RR   L   ; the quotient
                              ADC   A,A   
                              LD   E,A   ; the remainder: the bit that fell out (D is 0)
                              RET      
0242                          ENDIF      
0242                          IF   QUICK   
0242                             ; (The builds with room divide by any power of two with shifts: 2, and 32,
0242                             ; 64, 256 and the like, which fixed point and byte work use all the time.)
0242   7A           UDIV:     LD   A,D   
0243   B7                     OR   A   
0244   20 1A                  JR   NZ,uq1   ; 256 and up
0246   B3                     OR   E   
0247   28 33                  JR   Z,udv0   ; by 0: the long way (it means nothing anyway)
0249   3D                     DEC   A   
024A   A3                     AND   E   
024B   20 2F                  JR   NZ,udv0   ; not a power of two
024D   7B                     LD   A,E   ; by 2^k below 256: q = HL >> k, and
024E   3D                     DEC   A   ;   r = L & (2^k - 1)
024F   A5                     AND   L   
0250   F5                     PUSH   AF   
0251   CB 3B        UQ2:      SRL   E   
0253   38 06                  JR   C,uq3   
0255   CB 3C                  SRL   H   
0257   CB 1D                  RR   L   
0259   18 F6                  JR   uq2   
025B   F1           UQ3:      POP   AF   
025C   5F                     LD   E,A   
025D   16 00                  LD   D,0   
025F   C9                     RET      
0260   7B           UQ1:      LD   A,E   
0261   B7                     OR   A   
0262   20 18                  JR   NZ,udv0   
0264   7A                     LD   A,D   
0265   3D                     DEC   A   
0266   A2                     AND   D   
0267   20 13                  JR   NZ,udv0   ; not a power of two
0269   7A                     LD   A,D   ; by 2^k, 256 and up: q = H >> (k - 8), and
026A   3D                     DEC   A   ;   r = HL & (2^k - 1)
026B   A4                     AND   H   
026C   5F                     LD   E,A   ; (the remainder's high byte,
026D   7D                     LD   A,L   ;   and its low byte)
026E   6C                     LD   L,H   
026F   26 00                  LD   H,0   
0271   CB 3A        UQ4:      SRL   D   
0273   38 04                  JR   C,uq5   
0275   CB 3D                  SRL   L   
0277   18 F8                  JR   uq4   
0279   53           UQ5:      LD   D,E   
027A   5F                     LD   E,A   
027B   C9                     RET      
027C                          ENDIF      
027C                          IF   1-FAST   
027C   C5           UDV0:     PUSH   BC   
027D   7C                     LD   A,H   
027E   4D                     LD   C,L   
027F   21 00 00               LD   HL,0   
0282   06 10                  LD   B,16   
0284   CB 21        UDV1:     SLA   C   
0286   17                     RLA      
0287   ED 6A                  ADC   HL,HL   
0289   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
028B   30 02                  JR   NC,udv2   ;   always fits in 16 bits
028D   19                     ADD   HL,DE   ; too much: put it back, and cancel the
028E   0D                     DEC   C   ;   INC below
028F   0C           UDV2:     INC   C   ; a quotient bit
0290   10 F2                  DJNZ   udv1   
0292   EB                     EX   DE,HL   ; DE = remainder
0293   67                     LD   H,A   
0294   69                     LD   L,C   ; HL = quotient
0295   C1                     POP   BC   
0296   C9                     RET      
0297                          ENDIF      
0297                          IF   FAST   
                                 ; (the speed build: the same 16 rounds, unrolled)
                    UDV0:     PUSH   BC   
                              LD   A,H   
                              LD   C,L   
                              LD   HL,0   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr0   
                              ADD   HL,DE   
                              DEC   C   
                    UVR0:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr1   
                              ADD   HL,DE   
                              DEC   C   
                    UVR1:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr2   
                              ADD   HL,DE   
                              DEC   C   
                    UVR2:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr3   
                              ADD   HL,DE   
                              DEC   C   
                    UVR3:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr4   
                              ADD   HL,DE   
                              DEC   C   
                    UVR4:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr5   
                              ADD   HL,DE   
                              DEC   C   
                    UVR5:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr6   
                              ADD   HL,DE   
                              DEC   C   
                    UVR6:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr7   
                              ADD   HL,DE   
                              DEC   C   
                    UVR7:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr8   
                              ADD   HL,DE   
                              DEC   C   
                    UVR8:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr9   
                              ADD   HL,DE   
                              DEC   C   
                    UVR9:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr10   
                              ADD   HL,DE   
                              DEC   C   
                    UVR10:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr11   
                              ADD   HL,DE   
                              DEC   C   
                    UVR11:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr12   
                              ADD   HL,DE   
                              DEC   C   
                    UVR12:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr13   
                              ADD   HL,DE   
                              DEC   C   
                    UVR13:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr14   
                              ADD   HL,DE   
                              DEC   C   
                    UVR14:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr15   
                              ADD   HL,DE   
                              DEC   C   
                    UVR15:    INC   C   
                              EX   DE,HL   ; DE = remainder
                              LD   H,A   
                              LD   L,C   ; HL = quotient
                              POP   BC   
                              RET      
0297                          ENDIF      
0297                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
0297                             ; non-digit. Values wrap at 16 bits, as the spec says.
0297   21 00 00     RDNUM:    LD   HL,0   
029A   0A           RDN1:     LD   A,(BC)   
029B   D6 30                  SUB   "0"   
029D   FE 0A                  CP   10   
029F   D0                     RET   NC   
02A0   03                     INC   BC   
02A1   54                     LD   D,H   
02A2   5D                     LD   E,L   
02A3   29                     ADD   HL,HL   
02A4   29                     ADD   HL,HL   
02A5   19                     ADD   HL,DE   
02A6   29                     ADD   HL,HL   ; HL * 10
02A7   5F                     LD   E,A   
02A8   16 00                  LD   D,0   
02AA   19                     ADD   HL,DE   
02AB   18 ED                  JR   rdn1   
02AD                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
02AD                             ; the next character, so "/"" does not end it. Leaves A = 22h.
02AD                          IF   1-CHECKED   
02AD   03           SS0:      INC   BC   
02AE   0A           SKIPSTR:   LD   A,(BC)   
02AF   03                     INC   BC   
02B0   FE 2F                  CP   "/"   
02B2   28 F9                  JR   Z,ss0   
02B4   FE 22                  CP   22h   
02B6   20 F6                  JR   NZ,skipstr   
02B8   C9                     RET      
02B9                          ENDIF      
02B9                          IF   CHECKED   
                                 ; The checked build never steps over a NUL: if the text runs out first it
                                 ; returns A = 0 with the IP on the NUL.
                    SKIPSTR:   LD   A,(BC)   
                              OR   A   
                              RET   Z   
                              INC   BC   
                              CP   22h   
                              RET   Z   
                              CP   "/"   
                              JR   NZ,skipstr   
                              LD   A,(BC)   ; the escaped character
                              OR   A   
                              RET   Z   
                              INC   BC   
                              JR   skipstr   
02B9                          ENDIF      
02B9                             ; skip: read past text to the closer at this level, and return A = 0 if it
02B9                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
02B9                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
02B9                             ; no closer; anything else that runs into the NUL had unbalanced brackets
02B9                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
02B9                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
02B9                             ; 
02B9                             ; The checked build also looks at the character the skip was started by,
02B9                             ; which is always the one just before where it starts: "(" must end at ")",
02B9                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
02B9                             ; quote counts as running into it. "\" takes either closer. SKPL keeps the
02B9                             ; place where the skip started, for the report.
02B9                          IF   1-QUICK   
                                 ; (The two full builds, both checked, have no skip cache: this is their skip.)
                    SKIP:     LD   (SKPL),BC   
                              DEC   BC   
                              LD   A,(BC)   
                              INC   BC   
                              LD   E,A   ; E = the opener: ( [ or \
                              LD   D,0   
                    SK3:      INC   D   ; an opener: one deeper
                    SK1:      LD   A,(BC)   
                              OR   A   
                              JR   Z,sk6   ; (the IP stays on the NUL)
                              INC   BC   
                              CP   22h   
                              CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
                              SUB   "("   ;   (or 0, and then the NUL is read next)
                              JR   Z,sk3   
                              DEC   A   ; ")"
                              JR   Z,sk4   
                              SUB   "["-")"   
                              JR   Z,sk3   
                              CP   "]"-"["   
                              JR   NZ,sk1   
                    SK4:      DEC   D   
                              JR   NZ,sk1   
                              LD   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
                              XOR   E   ;   opener is 0 for "(" and 1 for "[", and only
                              AND   6   ;   "\" has bit 2: so this is 2 for the wrong
                              CP   2   ;   closer, and only then
                              LD   A,D   
                              RET   NZ   
                              JR   sk7   
                    SK6:      BIT   2,E   ; the text ran out:
                              JP   NZ,SKEND   ;   "\" with no closer ends the program
                    SK7:      LD   BC,(SKPL)   ; N. The place is the opener
                              LD   A,"N"   
                              JP   errp   ; (errp drops skip's return address)
02B9                          ENDIF      
02B9                          IF   QUICK   
02B9                             ; The skip cache. Nearly every skip is one that has happened before (a loop
02B9                             ; skips the same false block on every pass), so the first scan from each
02B9                             ; place is remembered: 64 entries of 00bbc3RhcnQsIGVuZA==, at CPAGE, found by the
02B9                             ; start's low byte. Only skips that start in the program text are kept (the
02B9                             ; line buffer changes); the cache is emptied whenever a run starts (skclr).
02B9                             ; A program that changes its own text while it runs is not looked after.
02B9   ED 43 3C 82  SKIP:     LD   (SKPL),BC   ; where it starts: the cache's key (and the
02BD   78                     LD   A,B   ;   checked report's place)
02BE   FE 83                  CP   PROG/256   
02C0   38 1B                  JR   C,sks   ; below the program text: no cache
02C2   79                     LD   A,C   
02C3   87                     ADD   A,A   
02C4   87                     ADD   A,A   
02C5   5F                     LD   E,A   
02C6   16 F0                  LD   D,CPAGE   ; DE -> the entry
02C8   1A                     LD   A,(DE)   
02C9   B9                     CP   C   
02CA   20 11                  JR   NZ,sks   
02CC   1C                     INC   E   
02CD   1A                     LD   A,(DE)   
02CE   B8                     CP   B   
02CF   20 0C                  JR   NZ,sks   
02D1   1C                     INC   E   
02D2   1A                     LD   A,(DE)   
02D3   4F                     LD   C,A   
02D4   1C                     INC   E   
02D5   1A                     LD   A,(DE)   
02D6   47                     LD   B,A   ; a hit: the IP is past the closer
02D7   0B                     DEC   BC   
02D8   0A                     LD   A,(BC)   
02D9   03                     INC   BC   
02DA   D6 29                  SUB   ")"   ; 0 for ")", not 0 for "]"
02DC   C9                     RET      
02DD                SKS:         
02DD                          ENDIF      
02DD                          IF   QUICK*CHECKED   
                              DEC   BC   
                              LD   A,(BC)   
                              INC   BC   
                              LD   E,A   ; E = the opener: ( [ or \
02DD                          ENDIF      
02DD                          IF   QUICK   
02DD                             ; The scan. Most characters are nothing to it, and two range tests rule
02DD                             ; them out: * to Z, and ^ and up. Only NUL " ( ) [ ] count.
02DD   16 00                  LD   D,0   
02DF   14           SQ3:      INC   D   ; an opener: one deeper
02E0   0A           SQ1:      LD   A,(BC)   
02E1   03                     INC   BC   
02E2   FE 5E                  CP   5Eh   
02E4   30 FA                  JR   NC,sq1   ; ^ _ ` a-z 00bbIHwg ~ and up: nothing
02E6   FE 5B                  CP   5Bh   
02E8   30 19                  JR   NC,sqb   ; [ \ ]
02EA   FE 2A                  CP   2Ah   
02EC   30 F2                  JR   NC,sq1   ; * to Z: nothing
02EE   FE 28                  CP   28h   
02F0   28 ED                  JR   Z,sq3   ; (
02F2   30 19                  JR   NC,sqc   ; )
02F4   FE 22                  CP   22h   
02F6   28 06                  JR   Z,sqq   ; a string
02F8   B7                     OR   A   
02F9   20 E5                  JR   NZ,sq1   ; the rest below "(": nothing
02FB                          ENDIF      
02FB                          IF   QUICK*(1-CHECKED)   
02FB   C3 40 04               JP   SKEND   ; NUL: the end of the program
02FE                          ENDIF      
02FE                          IF   QUICK*CHECKED   
                              DEC   BC   ; NUL: the IP stays on it
                              BIT   2,E   ; the text ran out:
                              JP   NZ,SKEND   ;   "\" with no closer ends the program
                    SQ7:      LD   BC,(SKPL)   ; N. The place is the opener
                              LD   A,"N"   
                              JP   errp   ; (errp drops skip's return address)
02FE                          ENDIF      
02FE                          IF   QUICK   
02FE   CD AE 02     SQQ:      CALL   skipstr   ; step over the string
0301   18 DD                  JR   sq1   
0303   D6 5C        SQB:      SUB   5Ch   ; [ -1, \ 0, ] 1
0305   28 D9                  JR   Z,sq1   ; "\" is nothing here
0307   38 D6                  JR   C,sq3   ; [
0309   3E 02                  LD   A,2   ; ]
030B   18 01                  JR   sq4   
030D   AF           SQC:      XOR   A   ; )
030E   15           SQ4:      DEC   D   
030F   20 CF                  JR   NZ,sq1   
0311                          ENDIF      
0311                          IF   QUICK*CHECKED   
                              LD   D,A   ; the closer at this level (as above): 2 here
                              XOR   E   ;   means the wrong closer
                              AND   6   
                              CP   2   
                              LD   A,D   
                              JR   Z,sq7   
0311                          ENDIF      
0311                          IF   QUICK   
0311                             ; The closer at this level: remember the skip (if it started in the program
0311                             ; text), and return A = 0 for ")" or 2 for "]".
0311   F5                     PUSH   AF   
0312   E5                     PUSH   HL   
0313   2A 3C 82               LD   HL,(SKPL)   
0316   7C                     LD   A,H   
0317   FE 83                  CP   PROG/256   
0319   38 11                  JR   C,sq9   
031B   7D                     LD   A,L   
031C   87                     ADD   A,A   
031D   87                     ADD   A,A   
031E   5F                     LD   E,A   
031F   16 F0                  LD   D,CPAGE   
0321   7D                     LD   A,L   
0322   12                     LD   (DE),A   
0323   1C                     INC   E   
0324   7C                     LD   A,H   
0325   12                     LD   (DE),A   
0326   1C                     INC   E   
0327   79                     LD   A,C   
0328   12                     LD   (DE),A   
0329   1C                     INC   E   
032A   78                     LD   A,B   
032B   12                     LD   (DE),A   
032C   E1           SQ9:      POP   HL   
032D   F1                     POP   AF   
032E   C9                     RET      
032F                             ; skclr: empty the skip cache (a start of 0000h matches no skip). Keeps HL.
032F   E5           SKCLR:    PUSH   HL   
0330   21 00 F0               LD   HL,CPAGE*256   
0333   36 00        SKC1:     LD   (HL),0   
0335   2C                     INC   L   
0336   20 FB                  JR   NZ,skc1   
0338   E1                     POP   HL   
0339   C9                     RET      
033A                          ENDIF      
033A                             ;  ---- Speed-ups (QUICK builds) -------------------------------------------
033A                             ;  The skip cache is above. These are the handlers' tails that the builds with
033A                             ;  room take, kept here, out of the handlers' first two pages.
033A                          IF   QUICK   
033A                             ; "*" with an operand below 256 takes 8 rounds, not 16: that one becomes the
033A                             ; multiplier (most multiplications have one, a count or a small constant).
033A   7C           MULQ:     LD   A,H   
033B   B7                     OR   A   
033C   28 05                  JR   Z,mq8   ; the multiplier is below 256
033E   7A                     LD   A,D   
033F   B7                     OR   A   
0340   20 11                  JR   NZ,mq16   
0342   EB                     EX   DE,HL   ; the multiplicand is: it becomes the multiplier
0343                          ENDIF      
0343                          IF   QUICK*(1-FAST)   
0343   7D           MQ8:      LD   A,L   
0344   21 00 00               LD   HL,0   
0347   C5                     PUSH   BC   
0348   06 08                  LD   B,8   
034A   29           MQ1:      ADD   HL,HL   
034B   17                     RLA      
034C   30 01                  JR   NC,mq2   
034E   19                     ADD   HL,DE   
034F   10 F9        MQ2:      DJNZ   mq1   
0351   C1                     POP   BC   
0352                          ;*Macro unroll:  NEXT
0352   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0353                          DS   CPM+FAST-CPM*FAST,0DDh   
0353                          DS   CPM+FAST-CPM*FAST,0E9h   
0353   C5           MQ16:     PUSH   BC   ; 16 rounds; the multiplier shifts up through A:C
0354   7C                     LD   A,H   
0355   4D                     LD   C,L   
0356   21 00 00               LD   HL,0   
0359   06 10                  LD   B,16   
035B   29           MQ3:      ADD   HL,HL   
035C   CB 21                  SLA   C   
035E   17                     RLA      
035F   30 01                  JR   NC,mq4   
0361   19                     ADD   HL,DE   
0362   10 F7        MQ4:      DJNZ   mq3   
0364   C1                     POP   BC   
0365                          ;*Macro unroll:  NEXT
0365   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0366                          DS   CPM+FAST-CPM*FAST,0DDh   
0366                          DS   CPM+FAST-CPM*FAST,0E9h   
0366                          ENDIF      
0366                          IF   FAST   
                                 ; (the speed build: the same rounds, unrolled)
                    MQ8:      LD   A,L   
                              LD   HL,0   
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur0   
                              ADD   HL,DE   
                    MUR0:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur1   
                              ADD   HL,DE   
                    MUR1:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur2   
                              ADD   HL,DE   
                    MUR2:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur3   
                              ADD   HL,DE   
                    MUR3:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur4   
                              ADD   HL,DE   
                    MUR4:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur5   
                              ADD   HL,DE   
                    MUR5:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur6   
                              ADD   HL,DE   
                    MUR6:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur7   
                              ADD   HL,DE   
                    MUR7:        
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
                    MQ16:     PUSH   BC   
                              LD   A,H   
                              LD   C,L   
                              LD   HL,0   
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus0   
                              ADD   HL,DE   
                    MUS0:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus1   
                              ADD   HL,DE   
                    MUS1:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus2   
                              ADD   HL,DE   
                    MUS2:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus3   
                              ADD   HL,DE   
                    MUS3:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus4   
                              ADD   HL,DE   
                    MUS4:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus5   
                              ADD   HL,DE   
                    MUS5:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus6   
                              ADD   HL,DE   
                    MUS6:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus7   
                              ADD   HL,DE   
                    MUS7:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus8   
                              ADD   HL,DE   
                    MUS8:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus9   
                              ADD   HL,DE   
                    MUS9:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus10   
                              ADD   HL,DE   
                    MUS10:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus11   
                              ADD   HL,DE   
                    MUS11:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus12   
                              ADD   HL,DE   
                    MUS12:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus13   
                              ADD   HL,DE   
                    MUS13:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus14   
                              ADD   HL,DE   
                    MUS14:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus15   
                              ADD   HL,DE   
                    MUS15:       
                              POP   BC   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
0366                          ENDIF      
0366                          IF   QUICK   
0366                             ; A true ")" reads the block start where it is, on top of the return stack,
0366                             ; instead of popping it and pushing it back; the break key is looked at as
0366                             ; rpushn would.
0366   FD 4E 00     CLOSEQ:   LD   C,(IY+0)   
0369   FD 46 01               LD   B,(IY+1)   
036C   E5                     PUSH   HL   
036D   21 36 82               LD   HL,PCNT   
0370   35                     DEC   (HL)   
0371   E1                     POP   HL   
0372   CC C1 03               CALL   Z,pollk   
0375                          ;*Macro unroll:  NEXT
0375   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0376                          DS   CPM+FAST-CPM*FAST,0DDh   
0376                          DS   CPM+FAST-CPM*FAST,0E9h   
0376                          ENDIF      
0376                          IF   QUICKU   
0376                             ; a-z, in the unchecked builds: a variable followed by "@" or "!" is fetched
0376                             ; or stored in the same step (x@ is the commonest pair in most programs).
0376                             ; (A checked build checks the stacks between the two, so it keeps them apart.)
0376   87           LOWQ:     ADD   A,A   
0377   5F                     LD   E,A   
0378   16 82                  LD   D,LETPAGE   ; DE -> the cell
037A   0A                     LD   A,(BC)   
037B   FE 40                  CP   "@"   
037D   28 07                  JR   Z,lwf   
037F   FE 21                  CP   "!"   
0381   28 0B                  JR   Z,lws   
0383   E5                     PUSH   HL   
0384   EB                     EX   DE,HL   ; TOS = the cell's address
0385                          ;*Macro unroll:  NEXT
0385   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0386                          DS   CPM+FAST-CPM*FAST,0DDh   
0386                          DS   CPM+FAST-CPM*FAST,0E9h   
0386   03           LWF:      INC   BC   ; x@: TOS = the cell's value
0387   E5                     PUSH   HL   
0388   EB                     EX   DE,HL   
0389   5E                     LD   E,(HL)   
038A   2C                     INC   L   
038B   56                     LD   D,(HL)   
038C   EB                     EX   DE,HL   
038D                          ;*Macro unroll:  NEXT
038D   F7                     DS   (1-CPM)*(1-FAST),0F7h   
038E                          DS   CPM+FAST-CPM*FAST,0DDh   
038E                          DS   CPM+FAST-CPM*FAST,0E9h   
038E   03           LWS:      INC   BC   ; x!: the cell = TOS, and NOS comes up
038F   EB                     EX   DE,HL   
0390   73                     LD   (HL),E   
0391   2C                     INC   L   
0392   72                     LD   (HL),D   
0393   E1                     POP   HL   
0394                          ;*Macro unroll:  NEXT
0394   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0395                          DS   CPM+FAST-CPM*FAST,0DDh   
0395                          DS   CPM+FAST-CPM*FAST,0E9h   
0395                          ENDIF      
0395                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)   
                    QSTART:   LD   BC,PROG   ; the generic reset goes on here: the IP,
                              CALL   skclr   ;   an empty skip cache, and the rest of the
                              JP   st0   ;   startup
0395                          ENDIF      
0395                             ; =============================================================================
0395                             ;  Dispatch table: the low byte of each handler's address, in code order
0395                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
0395                             ;  It must not cross a page (the dispatcher only adds to its low byte).
0395                             ; =============================================================================
0395                             ; The handlers of the first NPG1 characters start in the image's second page.
0395                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
0395                             ; differs between the builds, so the count is worked out here.
0395                             ; (One division to a line: asm80 only rounds down when it stores a value.)
0395                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
0395                PGBRK:    EQU   (h_break-BASE)/256   
0395                PGDEF:    EQU   (h_def-BASE)/256   
0395                PGFET:    EQU   (h_fetch-BASE)/256   
0395                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
0395                          IF   (1-TABP0)*(1-PTLATE)   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0395                          ENDIF      
0395                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
0395                             ; and return its value in A with the carry set; otherwise leave the IP and
0395                             ; return with the carry clear.
0395   0A           HEXC:     LD   A,(BC)   
0396   D6 30                  SUB   "0"   
0398   FE 0A                  CP   10   
039A   38 09                  JR   C,hc1   
039C   E6 DF                  AND   0DFh   
039E   D6 11                  SUB   11h   
03A0   FE 06                  CP   6   
03A2   D0                     RET   NC   
03A3   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
03A5   03           HC1:      INC   BC   
03A6   C9                     RET      
03A7                             ; psgn: print HL as a signed number. Keeps BC.
03A7   CB 7C        PSGN:     BIT   7,H   
03A9   28 04                  JR   Z,pdec   
03AB                          ;*Macro unroll:  PUTK    2Dh             ; '-'
03AB   3E                     DS   1-CPM,3Eh   ; "-"
03AC   2D                     DS   1-CPM,2Dh   
03AD   EF                     DS   1-CPM,0EFh   
03AE                          DS   CPM,0CDh   
03AE                          DS   CPM,APTK&0FFh   
03AE                          DS   CPM,APTK/256   
03AE                          DS   CPM,2Dh   
03AE                          ;*Macro unroll:  NEGH
03AE   E7                     DS   1-CPM,0E7h   
03AF                          DS   CPM,0CDh   
03AF                          DS   CPM,ANEG&0FFh   
03AF                          DS   CPM,ANEG/256   
03AF                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
03AF                             ; Keeps BC.
03AF   11 0A 00     PDEC:     LD   DE,10   
03B2   CD 42 02               CALL   udiv   ; HL = HL / 10, E = the last digit
03B5   7B                     LD   A,E   
03B6   F5                     PUSH   AF   
03B7   7C                     LD   A,H   
03B8   B5                     OR   L   
03B9   C4 AF 03               CALL   NZ,pdec   
03BC   F1                     POP   AF   
03BD   C6 30                  ADD   A,"0"   
03BF                          ;*Macro unroll:  PUTAR
03BF   EF                     DS   1-CPM,0EFh   
03C0   C9                     DS   1-CPM,0C9h   
03C1                          DS   CPM,0C3h   
03C1                          DS   CPM,APUT&0FFh   
03C1                          DS   CPM,APUT/256   
03C1                             ; (The table goes here instead in the builds where, before psgn, it would
03C1                             ; cross a page: PTLATE. If it would cross one here too, it starts on the next
03C1                             ; page: PTPAD is 0 unless it must.)
03C1                          IF   (1-TABP0)*PTLATE   
                    PTPH:     EQU   $ & 0FFh   
                    PTPX:     EQU   (PTPH + 31) / 256   
                    PTPAD:    EQU   PTPX * (256 - PTPH)   
                              DS   PTPAD   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
03C1                          ENDIF      
03C1                             ; =============================================================================
03C1                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
03C1                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
03C1                             ;  (RST 28h) prints A. Both keep BC, DE, HL and IY. In the generic build
03C1                             ;  they are the host's KEY and CONOUT routines themselves.
03C1                             ; 
03C1                             ;  A running program reads the keyboard only through getk and pollk, which
03C1                             ;  between them give the break key its rules:
03C1                             ;    - Ctrl-C stops the program;
03C1                             ;    - any other key that the break check reads is held in KEYBUF for the
03C1                             ;      next "?", and a newer one takes its place;
03C1                             ;    - "?" (getk) takes the held key first;
03C1                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
03C1                             ;      key like any other, but two of them within about 250 ms still stop it.
03C1                             ;  Both are called straight from a handler, never from a routine under one:
03C1                             ;  the checked build's report counts on finding one return address above the
03C1                             ;  data stack.
03C1                             ; =============================================================================
03C1                          IFN   CPM   
03C1                RAWK:     EQU   KEY   
03C1                          ENDIF      
03C1                             ; pollk: the break check (see rpushn).
03C1   CD 06 FF     POLLK:    CALL   rawk   
03C4   C8                     RET   Z   ; no key
03C5   32 7A 82               LD   (KEYBUF),A   ; held for the next "?"
03C8   FE 03        PK1:      CP   3   ; (getk joins here)
03CA   C0                     RET   NZ   
03CB                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
03CB                             ; the program has turned it off, wait about 250 ms for one more key: a
03CB                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
03CB                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
03CB   3A 7B 82     CTLC:     LD   A,(BRKOFF)   
03CE   B7                     OR   A   
03CF   CA 37 04     CT0:      JP   Z,brk   
03D2   D5                     PUSH   DE   
03D3   11 10 27               LD   DE,250*MSLOOP   
03D6   CD 06 FF     CT1:      CALL   rawk   
03D9   20 05                  JR   NZ,ct2   
03DB   1B                     DEC   DE   
03DC   7A                     LD   A,D   
03DD   B3                     OR   E   
03DE   20 F6                  JR   NZ,ct1   
03E0   D1           CT2:      POP   DE   ; A = the second key, or 0 if none came
03E1   FE 03                  CP   3   
03E3   28 EA                  JR   Z,ct0   ; (the zero flag takes the JP there)
03E5   B7                     OR   A   
03E6   28 03                  JR   Z,ct3   
03E8   32 7A 82               LD   (KEYBUF),A   
03EB   3E 03        CT3:      LD   A,3   
03ED   B7                     OR   A   
03EE   C9                     RET      
03EF                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
03EF   E5           GETK:     PUSH   HL   ; a held key goes first, and is taken out of
03F0   21 7A 82               LD   HL,KEYBUF   ;   the buffer
03F3   7E                     LD   A,(HL)   
03F4   36 00                  LD   (HL),0   
03F6   E1                     POP   HL   
03F7   B7                     OR   A   
03F8   C0                     RET   NZ   
03F9   CD 06 FF               CALL   rawk   
03FC   C8                     RET   Z   
03FD   18 C9                  JR   pk1   ; Ctrl-C? If not, that is the key
03FF                          IF   (1-CHECKED)*(1-EDITOR)   
                    BRK:      EQU   endprog   ; the unchecked build stops without a word
03FF                          ENDIF      ;   (with the editor, both stacks are cleared);
03FF                          IF   (1-CHECKED)*EDITOR   
03FF                BRK:      EQU   edit0   
03FF                          ENDIF      
03FF                          IF   CHECKED   
                    BRK:      EQU   e_break   ;   the checked build reports B
03FF                          ENDIF      
03FF                          IF   CPM   
                                 ; The routines a generic build keeps in page zero (see there). Here they are
                                 ; out of the way of the handlers, which must fit in the image's first two
                                 ; pages.
                    RPOP:     LD   E,(IY+0)   ; pop the return stack into DE
                              LD   D,(IY+1)   
                              INC   IY   
                              INC   IY   
                              RET      
                    NEG16:    XOR   A   ; HL = -HL (keeps BC, DE)
                              SUB   L   
                              LD   L,A   
                              SBC   A,A   
                              SUB   H   
                              LD   H,A   
                              RET      
03FF                          ENDIF      
03FF                          IF   CPM*CHECKED   ; (the checked builds need the room)
                    EXEC:     LD   (RSAVE),IY   ; machine code may change IX and IY
                              CALL   jphl   
                              LD   IY,(RSAVE)   
                              ;*Macro unroll:  SETIX
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,21h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
                              POP   HL   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
03FF                          ENDIF      
03FF                          IF   CPM   
                    RAWK:     LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
                              JR   putc   
                    PUTK:     EX   (SP),HL   ; print the byte after the CALL
                              LD   A,(HL)   
                              INC   HL   
                              EX   (SP),HL   
                                 ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
                                 ; printing and could swallow a key that BDOS 6 then never sees.
                                 ; It keeps every register but A and the flags: BDOS may change any of them
                                 ; (IX and IY too, in a Z80 BDOS or BIOS).
                    PUTC:     PUSH   BC   
                              PUSH   DE   
                              PUSH   HL   
                              PUSH   IX   
                              PUSH   IY   
                              LD   E,A   
                              LD   C,6   
                              CALL   BDOS   
                              POP   IY   
                              POP   IX   
                              POP   HL   
                              POP   DE   
                              POP   BC   
                              OR   A   ; (for getk)
                              RET      
03FF                          ENDIF      
03FF                             ; =============================================================================
03FF                             ;  Checked build: the checks and the error report
03FF                             ; =============================================================================
03FF                          IF   CHECKED   
                                 ; chkstk: both stacks are checked once per character, not in every handler.
                                 ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
                                 ; the constant carries if it is above (cells were popped that were never
                                 ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
                                 ; a character late at most: the bytes above DSTOP and the guard band below
                                 ; the page take what happens meanwhile. DE is free between characters.
                    CHKSTK:   EX   DE,HL   
                              LD   HL,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
                              ADD   HL,SP   
                              EX   DE,HL   
                              JR   C,e_under   
                              INC   D   
                              JR   NZ,e_over   
                              PUSH   IY   ; the return stack: in its page (or it has
                              POP   DE   ;   overflowed), and not above its empty
                              LD   A,D   ;   position (an underflow stays inside the
                              CP   RSPAGE   ;   page, in the guard band)
                              LD   A,E   
                              JR   NZ,e_rover   
                              CP   RSTOP&0FFh+1   
                              RET   C   
                              LD   IY,RSTOP   ; return stack underflow: it counts as empty
                              LD   A,"r"   
                              JR   errp   
                    E_ROVER:   LD   A,"R"   ; return stack overflow
                              DB   11h   ; (LD DE,nn hides the next entry)
                    E_OVER:   LD   A,"S"   ; data stack overflow
                              JR   errp   
                    E_UNDER:   LD   SP,DSTOP   ; data stack underflow: it counts as empty
                              LD   A,"s"   
                              JR   error   
                                 ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
                                 ; was never defined still holds 0000h, and the byte there is a reserved one
                                 ; in every build (AFh or C3h): if the IP is in page zero, this was a call of
                                 ; an undefined word. The call is undone, so the place is the call itself.
                    E_HI:     INC   B   
                              DJNZ   e_resv   ; (B is as it was, and is not 0)
                              ;*Macro unroll:  POPR
                              DS   1-CPM,0CFh   
                              DS   CPM,0CDh   
                              DS   CPM,AROP&0FFh   
                              DS   CPM,AROP/256   
                              LD   B,D   
                              LD   C,E   
                              LD   A,"U"   
                              JR   error   
                                 ; chkhp: HL = the new heap top, DE = the old one, the carry is from adding
                                 ; the count. Stop if the top is not below the limit page, or is below the
                                 ; program's end.
                    CHKHP:       
03FF                          ENDIF      
03FF                          IF   CHECKED*CPM   
                                 ; With this much room a top that wrapped round can land back in
                                 ; range, so the add is tested too: growing (A, the count's high
                                 ; byte, is positive) must not carry, and releasing must.
                              RRA      ; the carry comes in above the sign:
                              ADD   A,40h   ;   bit 7 = carry XOR sign
                              ADD   A,A   
                              JR   C,e_heap   
                              LD   A,(0007h)   
                              DEC   A   
                              CP   H   
                              JR   C,e_heap   
03FF                          ENDIF      
03FF                          IF   CHECKED*(1-CPM)   
                                 ; (Here the program's space is under 32K, so a top that wrapped
                                 ; round always falls outside it.)
                              LD   A,H   
                              CP   HEAPLIM   
                              JR   NC,e_heap   
03FF                          ENDIF      
03FF                          IF   CHECKED   
                              PUSH   DE   
                              EX   DE,HL   
                              LD   HL,(NPEND)   
                              ADD   HL,DE   ; carry: at or above the program's end
                              EX   DE,HL   
                              POP   DE   
                              RET   C   
                    E_HEAP:   OR   A   ; put the count back in TOS for the report
                              SBC   HL,DE   
                              LD   A,"H"   
                              JR   errp   
                                 ; chkst: stop unless HL is in the program's own space: from the letter page
                                 ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
                                 ; whatever lies above the limit are safe. Memory above the heap top but
                                 ; below the limit is the program's own: Tiny BASIC keeps its lines there.
                                 ; It is the page of HL + 1 that is tested, so that one test serves both
                                 ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
                                 ; Keeps HL and BC. It runs on into its own error entry.
                    CHKST:    INC   HL   
                              LD   A,H   
                              DEC   HL   
                              CP   LETPAGE   
                              JR   C,e_store   
03FF                          ENDIF      
03FF                          IF   CHECKED*(1-CPM)   
                              CP   HEAPLIM   
                              RET   C   
03FF                          ENDIF      
03FF                          IF   CHECKED*CPM   
                              LD   E,A   
                              LD   A,(0007h)   ; the BDOS page is the heap limit
                              DEC   A   
                              CP   E   
                              RET   NC   
03FF                          ENDIF      
03FF                          IF   CHECKED   
                                 ; Error entries. Each loads its letter and then hides the next entry inside
                                 ; a 3-byte LD DE,nn (the 11h), so they all fall through to `error`.
                    E_STORE:   LD   A,"O"   ; a store outside the program's space
                              DB   11h   
                    E_BREAK:   LD   A,"B"   ; Ctrl-C (found inside pollk or getk)
                                 ; errp: an error found inside a routine: drop its return address first.
                    ERRP:     POP   DE   
                              JR   error   
                                 ; e_dollar: "$" ran into a NUL (in prstr): Q, with the string's address
                                 ; back in TOS. prstr"s return address goes first. But if "$' had no
                                 ; address at all (the stack was empty), it is s, found now: chkstk, called
                                 ; one cell up, sees the stack past its empty place then.
                    E_DOLLAR:   POP   DE   
                              POP   HL   
                              CALL   chkstk   
                              PUSH   HL   
                              LD   HL,(RSAVE)   
                              DB   11h   ; (LD DE,nn hides e_quote's first two bytes)
                    E_QUOTE:   LD   B,H   ; an unclosed string: HL is its address, one
                              LD   C,L   ;   past the opening quote, which is the place
                              LD   A,"Q"   
                              DB   11h   
                    E_RESV:   LD   A,"X"   ; a reserved byte outside a string
                              DB   11h   
                    E_ZERO:   LD   A,"Z"   ; dividing by zero
                              DB   11h   
                    E_BRACK:   LD   A,"W"   ; bad character after [
                                 ; error: the report, then the end. A = the letter, BC = one past the place,
                                 ; HL = TOS, and both stacks as the report is to show them:
                                 ; 
                                 ;   Err X @ line,col
                                 ;   D:n: the top 8 cells at most, bottom to top
                                 ;   R:n
                    ERROR:    PUSH   HL   ; now the whole data stack is in memory
                              LD   E,A   
                              CALL   pnl   
                              DB   "Err ",22h   
                              LD   A,E   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              CALL   pmsg   
                              DB   " @ ",22h   
                              DEC   BC   ; BC = the place
                                 ; The line and column. A place below the program is in the line
                                 ; buffer: line 0. Otherwise count the LFs from the program's start;
                                 ; DE = the line's number, HL = where it starts.
                              LD   HL,LINEBUF   
                              LD   DE,0   
                              LD   A,B   
                              CP   PROG/256   
                              JR   C,er3   
                              INC   H   
                              LD   L,E   ; HL = PROG
                    ER1:      INC   DE   ; a new line starts at HL
                              PUSH   HL   
                    ER2:      LD   A,L   
                              SUB   C   
                              LD   A,H   
                              SBC   A,B   
                              JR   NC,er2x   ; reached the place
                              LD   A,(HL)   
                              INC   HL   
                              CP   10   
                              JR   NZ,er2   
                              POP   AF   
                              JR   er1   
                    ER2X:     POP   HL   
                    ER3:      PUSH   BC   
                              PUSH   HL   
                              EX   DE,HL   
                              CALL   pdec   ; the line
                              ;*Macro unroll:  PUTK    2Ch             ; ','
                              DS   1-CPM,3Eh   ; ","
                              DS   1-CPM,2Ch   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,2Ch   
                              POP   DE   
                              POP   HL   
                              OR   A   
                              SBC   HL,DE   
                              INC   HL   
                              CALL   pdec   ; the column
                                 ; The two stack lines:  D:n: the top 8 cells at most, bottom to top
                                 ;                       R:n
                                 ; TOS is in memory with the rest (pushed) by now.
                              CALL   pnl   
                              DB   "D:",22h   
                              LD   HL,DSTOP-2   ; (DSTOP-2) - SP is twice the depth (the cell
                              SBC   HL,SP   ;   at DSTOP-2 was pushed with the first value
                                 ;   and holds nothing; pnl left the carry clear)
                              CALL   phalf   ; the depth
                              ;*Macro unroll:  PUTK    3Ah             ; ':'
                              DS   1-CPM,3Eh   ; ":"
                              DS   1-CPM,3Ah   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,3Ah   
                              LD   A,C   
                              CP   9   
                              JR   C,er6   
                              CALL   pmsg   
                              DB   " ...",22h   
                              LD   C,8   
                    ER6:      LD   H,0   ; C = the number of cells to show
                              LD   L,C   
                              ADD   HL,HL   
                              ADD   HL,SP   ; HL -> just above the deepest of them
                              INC   C   
                    ER7:      DEC   C   
                              JR   Z,er8   
                              DEC   HL   
                              LD   D,(HL)   
                              DEC   HL   
                              LD   E,(HL)   
                              PUSH   HL   
                              ;*Macro unroll:  PUTK    20h             ; ' '
                              DS   1-CPM,3Eh   ; " "
                              DS   1-CPM,20h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,20h   
                              EX   DE,HL   
                              CALL   psgn   
                              POP   HL   
                              JR   er7   
                    ER8:      CALL   pnl   
                              DB   "R:",22h   
                              PUSH   IY   ; RSTOP - IY is under 256 (the pointer is
                              POP   HL   ;   at most one entry below its page), so
                              LD   A,RSTOP&0FFh   ;   the low bytes are enough
                              SUB   L   
                              LD   L,A   
                              LD   H,0   
                              CALL   phalf   
                              CALL   pnl   
                              DB   22h   
03FF                          ENDIF      
03FF                          IF   CHECKED*(1-EDITOR)   
                              JP   endprog   
03FF                          ENDIF      
03FF                          IF   CHECKED*EDITOR   
                              JR   edit0   ; back to the editor, with both stacks cleared
03FF                          ENDIF      
03FF                          IF   CHECKED   
                                 ; phalf: print half of HL, and leave it in C.
                    PHALF:    SRL   H   
                              RR   L   
                              PUSH   HL   
                              CALL   pdec   
                              POP   BC   
                              RET      
03FF                          ENDIF      
03FF                             ; =============================================================================
03FF                             ;  The line editor (EDITOR = 1)
03FF                             ; 
03FF                             ;  The interpreter starts here, and a program that ends comes back here.
03FF                             ;  There is no prompt. It follows the spec's suggested standard for a line
03FF                             ;  editor (docs/b8script.md, Environments). Type a line and press Return:
03FF                             ; 
03FF                             ;    n text    put the text in as line n; the lines from n on move down. A
03FF                             ;              number past the end (or 0) adds the line at the end.
03FF                             ;    n         take line n out
03FF                             ;    anything else is run at once, as B8Script. (Start such a line with a
03FF                             ;    space if it would begin with a digit.)
03FF                             ; 
03FF                             ;  A command key ends the line too, and takes what was typed as its argument:
03FF                             ; 
03FF                             ;    ^G        run the program
03FF                             ;    n ^L      list from line n (no number: all of it). Any key holds the
03FF                             ;              list until another key is pressed; Ctrl-C ends it.
03FF                             ;    n ^E      put line n in the input line; Return puts it back, changed
03FF                             ;    name ^R   read. CP/M: the file of that name (no name: the same file as
03FF                             ;              last time). Generic: what is typed, or pasted, from now until
03FF                             ;              ^Z replaces the program; it is not echoed.
03FF                             ;    name ^W   write. CP/M: to that file (no name: the same file as last
03FF                             ;              time). Generic: the text is printed, as it is.
03FF                             ;    ^N        new: no program
03FF                             ;    ^X        leave (to LEAVE)
03FF                             ; 
03FF                             ;  In the line: the left and right arrow keys move the cursor;
03FF                             ;  a character goes in at the cursor; Backspace and DEL take out the one
03FF                             ;  before it; Esc drops the line. Only CR, LF, BS and printing characters are
03FF                             ;  sent to the terminal, so any terminal will do.
03FF                             ; 
03FF                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
03FF                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
03FF                             ;  125 characters; the one character after a line number separates it from
03FF                             ;  the text and is not stored. The text is kept as it is typed, each line
03FF                             ;  ending in CR LF, at PROG.
03FF                             ; 
03FF                             ;  What lasts from one line to the next: the program, the words, the
03FF                             ;  variables and the data stack. An error or a break clears both stacks. The
03FF                             ;  return stack starts empty for every line.
03FF                             ; 
03FF                             ;  Things to know:
03FF                             ;    - Reset empties the program (generic builds).
03FF                             ;    - A word's address points into the program, so run the program again
03FF                             ;      after editing it.
03FF                             ;    - Nothing is printed between a program's output and what is typed next.
03FF                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
03FF                             ;      a line that calls -n? and carries on afterwards runs what was typed.
03FF                             ;      (The stored program never comes back to the line, so it may.)
03FF                             ;    - The editor"s own keys are not the program"s: -n? is the plain line
03FF                             ;      read of the other builds.
03FF                             ; 
03FF                             ;  The data stack is the CPU's stack, so the editor works on top of whatever
03FF                             ;  the last line left there, with TOS pushed like the rest.
03FF                             ; =============================================================================
03FF                          IF   EDGEN   
03FF                INIT:        ; reset (A = 0)
03FF                          ENDIF      
03FF                          IF   EDGEN*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at 0, and
                                 ; every word cell holds 0000h, the address an undefined word is caught at
                                 ; (see e_hi).
                              LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
03FF                          ENDIF      
03FF                          IF   EDGEN   
03FF   18 36                  JR   edit0   
0401                          ENDIF      
0401                          IF   EDITOR   
0401                             ; Right arrow: one to the right, by printing the character there
0401   7D           RIGHT:    LD   A,L   
0402   BB                     CP   E   
0403   28 4E                  JR   Z,ed1   ; at the end
0405   7E                     LD   A,(HL)   
0406   2C                     INC   L   
0407   18 2B                  JR   lf1   
0409                             ; Esc: alone it drops the line. An arrow key sends Esc [ and a letter, so
0409                             ; wait about 5 ms for a second key: after a "[" read on to the letter that
0409                             ; ends the sequence, and act on C (right) and D (left).
0409   01 C8 00     ESC:      LD   BC,5*MSLOOP   
040C   CD 06 FF     ES1:      CALL   rawk   
040F   20 0A                  JR   NZ,es2   
0411   0B                     DEC   BC   
0412   78                     LD   A,B   
0413   B1                     OR   C   
0414   20 F6                  JR   NZ,es1   
0416   CD 80 04               CALL   fin   ; no second key: the line is dropped
0419   18 27                  JR   edit   
041B   FE 5B        ES2:      CP   "["   
041D   20 34                  JR   NZ,ed1   ; not a sequence known here
041F   CD D9 04     ES3:      CALL   ekey   
0422   FE 40                  CP   40h   
0424   38 F9                  JR   C,es3   ; (its parameters)
0426   D6 43                  SUB   "C"   
0428   28 D7                  JR   Z,right   
042A   3D                     DEC   A   ; "D"?
042B   20 26                  JR   NZ,ed1   ; no: on into left
042D                             ; Left arrow: the cursor goes one to the left
042D   7D           LEFT:     LD   A,L   
042E   87                     ADD   A,A   
042F   28 22                  JR   Z,ed1   ; (L = 80h: at the start)
0431   2D                     DEC   L   
0432   3E 08                  LD   A,8   
0434                          ;*Macro unroll: lf1:    PUTA
0434   EF           LF1:      DS   1-CPM,0EFh   
0435                          DS   CPM,0CDh   
0435                          DS   CPM,APUT&0FFh   
0435                          DS   CPM,APUT/256   
0435   18 1C                  JR   ed1   
0437                             ; edit0: reset, an error or a break: both stacks are cleared, and the cursor
0437                             ;   is shown, in case the program had hidden it and could not show it again.
0437                             ; skend: a program that ended inside skip: its return address goes.
0437                             ; edend: a program that ended: TOS joins the rest of the data stack.
0437   31 FA 81     EDIT0:    LD   SP,DSTOP-2   ; empty (the cell that stands for TOS is pushed)
043A                          ENDIF      
043A                          IF   EDITOR*ANS   
                              XOR   A   ; (pshow wants the carry clear)
                              CALL   pshow   ; ESC [ ? 2 5 h
043A                          ENDIF      
043A                          IF   EDITOR*(1-ANS)   
043A   3E 01                  LD   A,1   
043C   CD 12 FF               CALL   CONCUR   ; show the cursor
043F                          ENDIF      
043F                          IF   EDITOR   
043F   21                     DB   21h   ; (LD HL,nn: steps over the next two bytes)
0440   D1           SKEND:    POP   DE   
0441   E5           EDEND:    PUSH   HL   
0442                             ; edit: start a new input line.
0442   FD 21 E0 80  EDIT:     LD   IY,RSTOP   ; the return stack is empty
0446                          ;*Macro unroll:  SETIX                   ; (a file read or written may have changed IX)
0446                          DS   CPM+FAST-CPM*FAST,0DDh   ; (a file read or written may have changed IX)
0446                          DS   CPM+FAST-CPM*FAST,21h   
0446                          DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
0446                          DS   CPM+FAST-CPM*FAST,ANXT/256   
0446   21 00 00               LD   HL,0   
0449   22 7A 82               LD   (KEYBUF),HL   ; no key is held, and the break key is on
044C   22 3A 82               LD   (EDLN),HL   ; no line is being edited
044F   21 80 82               LD   HL,LINEBUF   ; HL = the cursor,
0452   5D                     LD   E,L   ;   E = the end of the line (its low byte)
0453   CD D9 04     ED1:      CALL   ekey   
0456   FE 7F                  CP   7Fh   
0458   28 38                  JR   Z,bsp   ; DEL
045A   FE 20                  CP   " "   
045C   30 4E                  JR   NC,insc   
045E   FE 09                  CP   9   
0460   28 4A                  JR   Z,insc   ; Tab is text
0462   FE 08                  CP   8   
0464   28 2C                  JR   Z,bsp   
0466   FE 1B                  CP   1Bh   
0468   28 9F                  JR   Z,esc   
046A   E5                     PUSH   HL   ; a command key? Look it up
046B   21 DF 04               LD   HL,cmds   
046E   06 08                  LD   B,NCMD   
0470   BE           ED2:      CP   (HL)   
0471   23                     INC   HL   
0472   28 07                  JR   Z,ed3   
0474   23                     INC   HL   
0475   23                     INC   HL   
0476   10 F8                  DJNZ   ed2   
0478   E1                     POP   HL   
0479   18 D8                  JR   ed1   ; no: the key is ignored
047B   7E           ED3:      LD   A,(HL)   
047C   23                     INC   HL   
047D   66                     LD   H,(HL)   
047E   6F                     LD   L,A   
047F   E3                     EX   (SP),HL   ; the command's address: fin returns to it
0480                             ; fin: end the input line: CR LF and a NUL after it, and a new line on the
0480                             ; terminal. Leaves BC -> the line and HL -> the NUL.
0480   26 82        FIN:      LD   H,LETPAGE   
0482   6B                     LD   L,E   
0483   36 0D                  LD   (HL),13   
0485   2C                     INC   L   
0486   36 0A                  LD   (HL),10   
0488   2D                     DEC   L   
0489   CD DC 05               CALL   prl   ; (prints the CR LF)
048C   36 00                  LD   (HL),0   
048E   01 80 82               LD   BC,LINEBUF   
0491   C9                     RET      
0492                             ; Backspace, DEL: the character before the cursor goes. The cursor moves
0492                             ; left, the rest of the line moves down over it, and the last place (now a
0492                             ; space) is printed over along with the rest.
0492   7D           BSP:      LD   A,L   
0493   87                     ADD   A,A   
0494   28 BD                  JR   Z,ed1   ; at the start
0496   2D                     DEC   L   
0497                          ;*Macro unroll:  PUTK    08h             ; backspace
0497   3E                     DS   1-CPM,3Eh   ; backspace
0498   08                     DS   1-CPM,08h   
0499   EF                     DS   1-CPM,0EFh   
049A                          DS   CPM,0CDh   
049A                          DS   CPM,APTK&0FFh   
049A                          DS   CPM,APTK/256   
049A                          DS   CPM,08h   
049A   E5                     PUSH   HL   
049B   2C           BS1:      INC   L   
049C   7E                     LD   A,(HL)   
049D   2D                     DEC   L   
049E   77                     LD   (HL),A   
049F   2C                     INC   L   
04A0   7D                     LD   A,L   
04A1   BB                     CP   E   
04A2   20 F7                  JR   NZ,bs1   
04A4   2D                     DEC   L   
04A5   36 20                  LD   (HL)," "   
04A7   E1                     POP   HL   
04A8   53                     LD   D,E   
04A9   1D                     DEC   E   
04AA   18 15                  JR   ic2   
04AC                             ; A character goes in at the cursor: it ripples up through the rest of the
04AC                             ; line, the cursor moves on, and the rest is printed again.
04AC   47           INSC:     LD   B,A   
04AD   7B                     LD   A,E   
04AE   FE FD                  CP   0FDh   
04B0   28 A1                  JR   Z,ed1   ; the line is full: 125 characters
04B2   78                     LD   A,B   
04B3                          ;*Macro unroll:  PUTA
04B3   EF                     DS   1-CPM,0EFh   
04B4                          DS   CPM,0CDh   
04B4                          DS   CPM,APUT&0FFh   
04B4                          DS   CPM,APUT/256   
04B4   E5                     PUSH   HL   
04B5   7E           IC1:      LD   A,(HL)   
04B6   70                     LD   (HL),B   
04B7   47                     LD   B,A   
04B8   7D                     LD   A,L   
04B9   2C                     INC   L   
04BA   BB                     CP   E   
04BB   20 F8                  JR   NZ,ic1   
04BD   E1                     POP   HL   
04BE   2C                     INC   L   
04BF   1C                     INC   E   
04C0   53                     LD   D,E   
04C1   CD C6 04     IC2:      CALL   tail   
04C4   18 8D                  JR   ed1   
04C6                             ; tail: print the line from the cursor to D (a low byte), and bring the
04C6                             ; cursor back with backspaces. Nothing at all if the cursor is at D.
04C6   4D           TAIL:     LD   C,L   
04C7   7D           TA1:      LD   A,L   
04C8   BA                     CP   D   
04C9   28 05                  JR   Z,ta2   
04CB   7E                     LD   A,(HL)   
04CC                          ;*Macro unroll:  PUTA
04CC   EF                     DS   1-CPM,0EFh   
04CD                          DS   CPM,0CDh   
04CD                          DS   CPM,APUT&0FFh   
04CD                          DS   CPM,APUT/256   
04CD   2C                     INC   L   
04CE   18 F7                  JR   ta1   
04D0   7D           TA2:      LD   A,L   
04D1   B9                     CP   C   
04D2   C8                     RET   Z   
04D3                          ;*Macro unroll:  PUTK    08h             ; backspace
04D3   3E                     DS   1-CPM,3Eh   ; backspace
04D4   08                     DS   1-CPM,08h   
04D5   EF                     DS   1-CPM,0EFh   
04D6                          DS   CPM,0CDh   
04D6                          DS   CPM,APTK&0FFh   
04D6                          DS   CPM,APTK/256   
04D6                          DS   CPM,08h   
04D6   2D                     DEC   L   
04D7   18 F7                  JR   ta2   
04D9                             ; ekey: wait for a key
04D9   CD 06 FF     EKEY:     CALL   rawk   
04DC   28 FB                  JR   Z,ekey   
04DE   C9                     RET      
04DF                             ; The command keys, and where each goes (after fin).
04DF   0D           CMDS:     DB   13   
04E0   27 05                  DW   cret   
04E2   07                     DB   7   ; ^G
04E3   6F 05                  DW   crun   
04E5   0C                     DB   12   ; ^L
04E6   84 05                  DW   clist   
04E8   05                     DB   5   ; ^E
04E9   FD 04                  DW   cedln   
04EB   12                     DB   18   ; ^R
04EC   E8 05                  DW   cread   
04EE   17                     DB   23   ; ^W
04EF   15 06                  DW   cwrite   
04F1   0E                     DB   14   ; ^N
04F2   F7 04                  DW   cnew   
04F4   18                     DB   24   ; ^X
04F5   09 FF                  DW   LEAVE   
04F7                NCMD:     EQU   8   
04F7                             ; ^N: no program
04F7   AF           CNEW:     XOR   A   
04F8   32 00 83               LD   (PROG),A   
04FB   18 6F        GED0:     JR   gedit   
04FD                             ; ^E: line n goes into the input line, to be changed. EDLN remembers which
04FD                             ; line it was: Return puts the text back in its place.
04FD   CD 97 02     CEDLN:    CALL   rdnum   
0500   E5                     PUSH   HL   
0501   CD C4 05               CALL   find   ; HL -> the line, or the NUL if there is none
0504   D1                     POP   DE   
0505   7E                     LD   A,(HL)   
0506   B7                     OR   A   
0507   28 F2                  JR   Z,ged0   
0509   ED 53 3A 82            LD   (EDLN),DE   
050D   11 80 82               LD   DE,LINEBUF   
0510   7E           CE1:      LD   A,(HL)   ; copy it, and show it, up to its CR (or LF)
0511   FE 0D                  CP   13   
0513   28 0D                  JR   Z,ce2   
0515   FE 0A                  CP   10   
0517   28 09                  JR   Z,ce2   
0519   12                     LD   (DE),A   
051A                          ;*Macro unroll:  PUTA
051A   EF                     DS   1-CPM,0EFh   
051B                          DS   CPM,0CDh   
051B                          DS   CPM,APUT&0FFh   
051B                          DS   CPM,APUT/256   
051B   23                     INC   HL   
051C   1C                     INC   E   
051D   7B                     LD   A,E   
051E   FE FD                  CP   0FDh   ; (a longer line is cut at 125 characters)
0520   20 EE                  JR   NZ,ce1   
0522   EB           CE2:      EX   DE,HL   ; the cursor is at the line's end
0523   5D                     LD   E,L   
0524   C3 53 04               JP   ed1   
0527                             ; Return. If ^E put a line here, the text goes back in its place. If not:
0527                             ; a number and text is a line to put in, a number alone a line to take out,
0527                             ; and anything else is run where it is.
0527   E5           CRET:     PUSH   HL   ; the end of what was typed
0528   2A 3A 82               LD   HL,(EDLN)   
052B   7C                     LD   A,H   
052C   B5                     OR   L   
052D   28 07                  JR   Z,cr1   
052F   E5                     PUSH   HL   
0530   CD B4 05               CALL   delln   
0533   E1                     POP   HL   
0534   18 13                  JR   ins   
0536   CD 97 02     CR1:      CALL   rdnum   ; HL = the number it starts with, BC -> after
0539   79                     LD   A,C   ; C is still 80h if there was no number:
053A   87                     ADD   A,A   ;   only then is twice it 0
053B   28 36                  JR   Z,st0p   ; no number: run the line
053D   0A                     LD   A,(BC)   
053E   FE 0D                  CP   13   
0540   20 06                  JR   NZ,cr2   
0542   D1                     POP   DE   ; the number alone: take that line out
0543   CD B4 05               CALL   delln   
0546   18 24                  JR   gedit   
0548   03           CR2:      INC   BC   ; step over the one character after the number
0549                             ; Put the text at BC in as line n (in HL): open a gap of its length there,
0549                             ; CR and LF included, and copy it in.
0549   CD C4 05     INS:      CALL   find   ; HL -> where it goes
054C   D1                     POP   DE   ; the end of what was typed
054D   7B                     LD   A,E   
054E   91                     SUB   C   ; A = the length of the text, with its CR LF
054F   C5                     PUSH   BC   ; the text
0550   4F                     LD   C,A   
0551   06 00                  LD   B,0   
0553   C5                     PUSH   BC   ; its length
0554   54                     LD   D,H   
0555   5D                     LD   E,L   ; DE = where it goes
0556   AF                     XOR   A   
0557   4F                     LD   C,A   ; BC = 0: CPIR looks as far as it needs to
0558   ED B1                  CPIR      ; HL -> one past the program's NUL
055A   ED 52                  SBC   HL,DE   ; the number of bytes to move up, NUL included
055C   44                     LD   B,H   
055D   4D                     LD   C,L   
055E   19                     ADD   HL,DE   
055F   2B                     DEC   HL   ; HL -> the NUL
0560   EB                     EX   DE,HL   
0561   E3                     EX   (SP),HL   ; HL = the length; where it goes is kept
0562   E5                     PUSH   HL   
0563   19                     ADD   HL,DE   ; the NUL's new place
0564   EB                     EX   DE,HL   
0565   ED B8                  LDDR      ; move the rest of the program up
0567   C1                     POP   BC   ; the length
0568   D1                     POP   DE   ; where it goes
0569   E1                     POP   HL   ; the text
056A   ED B0                  LDIR      
056C   C3 42 04     GEDIT:    JP   edit   
056F                             ; ^G: run the program. st0p: run the typed line (BC -> it).
056F   01 00 83     CRUN:     LD   BC,PROG   
0572   3E                     DB   3Eh   ; (LD A,n: steps over the POP)
0573   E1           ST0P:     POP   HL   ; (the end of what was typed)
0574                             ; st0: start running at BC. The heap starts after the stored program's NUL.
0574   21 00 83     ST0:      LD   HL,PROG   
0577   AF                     XOR   A   
0578   BE           ST1:      CP   (HL)   
0579   23                     INC   HL   
057A   20 FC                  JR   NZ,st1   
057C   22 7C 82               LD   (HEAP),HL   
057F                          ENDIF      
057F                          IF   EDITOR*QUICK   
057F   CD 2F 03               CALL   skclr   ; every run starts with an empty skip cache
0582                          ENDIF      
0582                          IF   EDITOR*CHECKED   
                              ;*Macro unroll:  NEGH                    ; minus the heap's first address: '_' may not
                              DS   1-CPM,0E7h   ; minus the heap"s first address: "_' may not
                              DS   CPM,0CDh   
                              DS   CPM,ANEG&0FFh   
                              DS   CPM,ANEG/256   
                              LD   (NPEND),HL   ;   release below it
0582                          ENDIF      
0582                          IF   EDITOR   
0582   E1                     POP   HL   ; TOS: the data stack is as the last line left it
0583                          ;*Macro unroll:  NEXT                    ; (its return address is thrown away)
0583   F7                     DS   (1-CPM)*(1-FAST),0F7h   ; (its return address is thrown away)
0584                          DS   CPM+FAST-CPM*FAST,0DDh   
0584                          DS   CPM+FAST-CPM*FAST,0E9h   
0584                             ; ^L: list from line n. DE = the number of the line at HL.
0584   CD 97 02     CLIST:    CALL   rdnum   ; HL = n, or 0 if there was none:
0587   7C                     LD   A,H   
0588   B5                     OR   L   
0589   20 01                  JR   NZ,li0   
058B   2C                     INC   L   ;   then from line 1
058C   E5           LI0:      PUSH   HL   
058D   CD C4 05               CALL   find   
0590   D1                     POP   DE   
0591   7E           LI1:      LD   A,(HL)   
0592   B7                     OR   A   
0593   28 D7                  JR   Z,gedit   ; the end of the text
0595   CD 06 FF               CALL   rawk   
0598   28 09                  JR   Z,li3   ; no key: carry on
059A   FE 03                  CP   3   
059C   C4 D9 04               CALL   NZ,ekey   ; any key but Ctrl-C: wait for one more
059F   FE 03                  CP   3   
05A1   28 C9                  JR   Z,gedit   ; Ctrl-C, first or second, ends the list
05A3   E5           LI3:      PUSH   HL   
05A4   D5                     PUSH   DE   
05A5   EB                     EX   DE,HL   
05A6   CD AF 03               CALL   pdec   ; the line's number,
05A9   3E 20                  LD   A," "   
05AB                          ;*Macro unroll:  PUTA                    ;   a space,
05AB   EF                     DS   1-CPM,0EFh   ;   a space,
05AC                          DS   CPM,0CDh   
05AC                          DS   CPM,APUT&0FFh   
05AC                          DS   CPM,APUT/256   
05AC   D1                     POP   DE   
05AD   E1                     POP   HL   
05AE   13                     INC   DE   
05AF   CD DC 05               CALL   prl   ;   and the line
05B2   18 DD                  JR   li1   
05B4                             ; delln: take line n (in HL) out: copy everything after it down over it.
05B4   CD C4 05     DELLN:    CALL   find   
05B7   54                     LD   D,H   
05B8   5D                     LD   E,L   
05B9   CD D2 05               CALL   nxl   ; HL -> the next line
05BC   7E           DE1:      LD   A,(HL)   
05BD   12                     LD   (DE),A   
05BE   23                     INC   HL   
05BF   13                     INC   DE   
05C0   B7                     OR   A   
05C1   20 F9                  JR   NZ,de1   
05C3   C9                     RET      
05C4                             ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
05C4                             ; of the text if there are fewer lines (or the number is 0). Keeps BC.
05C4   EB           FIND:     EX   DE,HL   
05C5   21 00 83               LD   HL,PROG   
05C8   1B           FI1:      DEC   DE   
05C9   7A                     LD   A,D   
05CA   B3                     OR   E   
05CB   C8                     RET   Z   
05CC   CD D2 05               CALL   nxl   
05CF   20 F7                  JR   NZ,fi1   
05D1   C9                     RET      
05D2                             ; nxl: step HL over one line, to just past its LF (and return not-zero), or
05D2                             ; stop at the NUL that ends the text (and return zero).
05D2   7E           NXL:      LD   A,(HL)   
05D3   B7                     OR   A   
05D4   C8                     RET   Z   
05D5   23                     INC   HL   
05D6   FE 0A                  CP   10   
05D8   20 F8                  JR   NZ,nxl   
05DA   B7                     OR   A   
05DB   C9                     RET      
05DC                             ; prl: print the line at HL, to its LF; HL -> just past it.
05DC   7E           PRL:      LD   A,(HL)   
05DD                          ;*Macro unroll:  PUTA
05DD   EF                     DS   1-CPM,0EFh   
05DE                          DS   CPM,0CDh   
05DE                          DS   CPM,APUT&0FFh   
05DE                          DS   CPM,APUT/256   
05DE   7E                     LD   A,(HL)   
05DF   23                     INC   HL   
05E0   FE 0A                  CP   10   
05E2   20 F8                  JR   NZ,prl   
05E4   C9                     RET      
05E5                          ENDIF      
05E5                          IF   EDGEN   
05E5   C3 42 04     GED1:     JP   edit   
05E8                             ; ^R, generic: what comes in from now until ^Z is the program. A CR is
05E8                             ; stored as CR LF; a LF right after a line end is dropped (it is the CR's
05E8                             ; own, or an empty line's), and a LF anywhere else ends a line too. A last
05E8                             ; line with no end is given one. Nothing is echoed, and there is no check
05E8                             ; for running out of memory.
05E8   21 FF 82     CREAD:    LD   HL,PROG-1   
05EB   36 0A                  LD   (HL),10   ; (as if a line had just ended: the byte is
05ED   23                     INC   HL   ;   the line buffer's last, and spare)
05EE   CD D9 04     RD1:      CALL   ekey   
05F1   4F                     LD   C,A   
05F2   FE 1A                  CP   1Ah   
05F4   20 02                  JR   NZ,rd2   
05F6   3E 0A                  LD   A,10   ; ^Z ends the last line, as a LF would
05F8   FE 0A        RD2:      CP   10   
05FA   20 07                  JR   NZ,rd3   
05FC   2B                     DEC   HL   
05FD   BE                     CP   (HL)   
05FE   23                     INC   HL   
05FF   28 0B                  JR   Z,rd4   ; straight after a line end: dropped
0601   3E 0D                  LD   A,13   ; anywhere else it ends the line
0603   77           RD3:      LD   (HL),A   
0604   23                     INC   HL   
0605   FE 0D                  CP   13   
0607   20 03                  JR   NZ,rd4   
0609   36 0A                  LD   (HL),10   ; after a CR goes a LF
060B   23                     INC   HL   
060C   79           RD4:      LD   A,C   
060D   FE 1A                  CP   1Ah   
060F   20 DD                  JR   NZ,rd1   
0611   36 00                  LD   (HL),0   
0613   18 D0                  JR   ged1   
0615                             ; ^W, generic: the text is printed as it is, for the terminal to capture.
0615   21 00 83     CWRITE:   LD   HL,PROG   
0618   7E           CW1:      LD   A,(HL)   
0619   B7                     OR   A   
061A   28 C9                  JR   Z,ged1   
061C                          ;*Macro unroll:  PUTA
061C   EF                     DS   1-CPM,0EFh   
061D                          DS   CPM,0CDh   
061D                          DS   CPM,APUT&0FFh   
061D                          DS   CPM,APUT/256   
061D   23                     INC   HL   
061E   18 F8                  JR   cw1   
0620                          ENDIF      
0620                          IF   EDITOR*CPM   
                    CFCB:     EQU   005Ch   ; the file's name is kept here, where the CCP
                                 ;   put the one from the command line
                                 ; ^W, CP/M: write the file: delete the old one, make it anew, write the
                                 ; text in records of 128 bytes, and close it. The text's NUL and the 127
                                 ; bytes after it are set to ^Z meanwhile, which pads the last record. (A
                                 ; full disk or directory is not noticed: the calls fail and that is all.)
                    CWRITE:   CALL   setname   
                              LD   C,19   ; delete
                              CALL   fbdos   
                              LD   C,22   ; make
                              CALL   fbdos   
                              LD   HL,PROG   
                              XOR   A   
                    CW1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,cw1   
                              DEC   HL   ; HL -> the NUL
                              PUSH   HL   
                              LD   B,128   
                    CW2:      LD   (HL),1Ah   
                              INC   HL   
                              DJNZ   cw2   
                              POP   HL   
                              LD   DE,PROG   
                    CW3:      LD   A,E   ; a record that starts before the end is written
                              SUB   L   
                              LD   A,D   
                              SBC   A,H   
                              JR   NC,cw4   
                              PUSH   HL   
                              LD   C,21   ; write, from where the record lies
                              CALL   frec   
                              POP   HL   
                              JR   cw3   
                    CW4:      LD   (HL),0   ; the NUL again
                              LD   C,16   ; close
                              CALL   fbdos   
                              JP   edit   
                                 ; frec: BDOS function C (read or write a record) with the 128 bytes at DE.
                                 ; Returns A = the BDOS's answer, HL = DE and DE = DE + 128.
                    FREC:     PUSH   DE   
                              PUSH   BC   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              POP   BC   
                              CALL   fbdos   
                              POP   DE   
                              LD   HL,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              RET      
                                 ; setname: if a name was typed (the line does not start with its CR), put it
                                 ; in the FCB: up to 8 characters, a dot, up to 3 more, in capitals. The drive
                                 ; is the current one. Then, name or no name, clear the FCB after the name,
                                 ; as it must be before a file is opened or made.
                    SETNAME:   LD   DE,LINEBUF   
                              LD   A,(DE)   
                              CP   13   
                              JR   Z,fcbclr   
                              LD   HL,CFCB   
                              LD   (HL),0   ; the current drive
                              LD   B,11   
                    SN1:      INC   L   
                              LD   (HL)," "   
                              DJNZ   sn1   
                              LD   L,CFCB+1   
                    SN2:      LD   A,(DE)   
                              INC   DE   
                              CP   13   
                              JR   Z,fcbclr   
                              CP   "."   
                              JR   NZ,sn3   
                              LD   L,CFCB+9   ; the type
                              JR   sn2   
                    SN3:      CP   "a"   
                              JR   C,sn4   
                              AND   5Fh   ; a capital
                    SN4:      LD   (HL),A   
                              INC   L   
                              JR   sn2   
                    FCBCLR:   LD   HL,CFCB+12   
                              LD   B,24   
                    FC1:      LD   (HL),0   
                              INC   HL   
                              DJNZ   fc1   
                              RET      
                                 ; fbdos: BDOS function C on the file
                    FBDOS:    LD   DE,CFCB   
                              JP   BDOS   
                                 ; ^R, CP/M: read the file. A name typed before the key is the file's name
                                 ; from now on. (On into load, which returns to edit.)
                    CREAD:    CALL   setname   
                              LD   HL,edit   
                              PUSH   HL   
                                 ; load: read the file into PROG. No such file: no program. The text ends at
                                 ; the file"s first ^Z (1Ah), which pads a text file"s last record; one more
                                 ; goes after the last record, so the search always stops. And every line
                                 ; must end in LF: a last line without one is given a CR LF. (The FCB is
                                 ; clear after its name: the CCP left it so, or setname did.)
                    LOAD:     LD   C,15   ; open (no such file: the first read fails
                              CALL   fbdos   ;   too)
                              LD   DE,PROG   
                    LD1:      LD   C,20   ; read the next 128 bytes
                              CALL   frec   
                              OR   A   
                              JR   Z,ld1   
                              LD   (HL),1Ah   ; (HL = where the record that failed would be)
                              LD   HL,PROG-1   
                              LD   A,10   ; (a file with no text needs nothing added)
                    TR1:      INC   HL   
                              LD   E,A   ; E = the character before this one
                              LD   A,(HL)   
                              CP   1Ah   
                              JR   NZ,tr1   
                              LD   A,E   
                              CP   10   
                              JR   Z,tr2   
                              LD   (HL),13   
                              INC   HL   
                              LD   (HL),10   
                              INC   HL   
                    TR2:      LD   (HL),0   
                              RET      
0620                          ENDIF      
0620                             ; =============================================================================
0620                          IF   CPM   
                                 ; The RAM pages follow the image; the heap may grow to the BDOS.
                    START:       
0620                          ENDIF      
0620                          IF   CPM*CHECKED*(1-EDITOR)   
                                 ; Clear the lower half of the letter page (as the editor build does
                                 ; at its start).
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
0620                          ENDIF      
0620                          IF   CPM*(1-EDITOR)   
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:      LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
                              CALL   skclr   ; an empty skip cache
                              JP   st2   
0620                          ENDIF      
0620                          IF   FAST   
                                 ; =============================================================================
                                 ;  The speed build (FAST = 1)
                                 ; 
                                 ;  The inner loop is a table: 256 entries, the low bytes of the handlers'
                                 ;  addresses in one page and the high bytes in the next. The dispatcher (at
                                 ;  next0, and inline, as NEXTF, at the end of the speed build's own entries,
                                 ;  so there is no jump back to it; the ordinary handlers end in JP (IX), with
                                 ;  IX = next0, as in the CP/M builds):
                                 ; 
                                 ;      LD A,(BC) / INC BC / EX DE,HL / LD L,A / LD H,DTAB/256 /
                                 ;      LD A,(HL) / INC H / LD H,(HL) / LD L,A / JP (HL)
                                 ; 
                                 ;  So every entry starts with TOS in DE, not HL. The punctuation entries are
                                 ;  thunks into the ordinary handlers (EX DE,HL / JP handler); the letters and
                                 ;  digits have one entry each, which knows its cell or its value already.
                                 ; =============================================================================
                    FTSTORE:   EX   DE,HL   ; !
                              JP   h_store   
                    FTSTR:    EX   DE,HL   ; "
                              JP   h_str   
                    FTNUM:    EX   DE,HL   ; #
                              JP   h_num   
                    FTPRINT:   EX   DE,HL   ; $
                              JP   h_print   
                    FTSWAP:   EX   DE,HL   ; %
                              JP   h_swap   
                    FTAND:    EX   DE,HL   ; &
                              JP   h_and   
                    FTEMIT:   EX   DE,HL   ; '
                              JP   h_emit   
                    FTOPEN:   EX   DE,HL   ; (
                              JP   h_open   
                    FTCLOSE:   EX   DE,HL   ; )
                              JP   h_close   
                    FTMUL:    EX   DE,HL   ; *
                              JP   h_mul   
                    FTADD:    EX   DE,HL   ; +
                              JP   h_add   
                    FTCFETCH:   EX   DE,HL   ; ,
                              JP   h_cfetch   
                    FTSUB:    EX   DE,HL   ; -
                              JP   h_sub   
                    FTCSTORE:   EX   DE,HL   ; .
                              JP   h_cstore   
                    FTDIV:    EX   DE,HL   ; /
                              JP   h_div   
                    FTDUP:    EX   DE,HL   ; :
                              JP   h_dup   
                    FTDROP:   EX   DE,HL   ; ;
                              JP   h_drop   
                    FTLT:     EX   DE,HL   ; <
                              JP   h_lt   
                    FTEQ:     EX   DE,HL   ; =
                              JP   h_eq   
                    FTGT:     EX   DE,HL   ; >
                              JP   h_gt   
                    FTKEY:    EX   DE,HL   ; ?
                              JP   h_key   
                    FTFETCH:   EX   DE,HL   ; @
                              JP   h_fetch   
                    FTDEF:    EX   DE,HL   ; [
                              JP   h_def   
                    FTBREAK:   EX   DE,HL   ; \
                              JP   h_break   
                    FTRET:    EX   DE,HL   ; ]
                              JP   h_ret   
                    FTXOR:    EX   DE,HL   ; ^
                              JP   h_xor   
                    FTALLOC:   EX   DE,HL   ; _
                              JP   h_alloc   
                    FTGRAVE:   EX   DE,HL   ; `
                              JP   h_grave   
                    FTTOR:    EX   DE,HL   ; {
                              JP   h_tor   
                    FTOR:     EX   DE,HL   ; |
                              JP   h_or   
                    FTFROMR:   EX   DE,HL   ; }
                              JP   h_fromr   
                    FTNOT:    EX   DE,HL   ; ~
                              JP   h_not   
                                 ; The commonest punctuation, written for the speed build: TOS in DE on the
                                 ; way in, and the dispatcher inline on the way out.
                    FS_ADD:      ; +
                              POP   HL   
                              ADD   HL,DE   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_SUB:      ; -
                              LD   A,(BC)   ; a digit next: a negative number
                              SUB   "0"   
                              CP   10   
                              JR   C,fs_neg   
                              POP   HL   
                              OR   A   
                              SBC   HL,DE   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_NEG:   EX   DE,HL   
                              JP   h_sub   
                    FS_DUP:      ; :
                              PUSH   DE   
                              EX   DE,HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_DROP:      ; ;
                              POP   HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_SWAP:      ; %
                              POP   HL   
                              PUSH   DE   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_FET:      ; @
                              EX   DE,HL   
                              LD   E,(HL)   
                              INC   HL   
                              LD   D,(HL)   
                              EX   DE,HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_CFET:      ; ,
                              LD   A,(DE)   
                              LD   L,A   
                              LD   H,0   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_LT:       ; <
                              POP   HL   ; a < b: HL = a, DE = b
                    FS_LT1:   LD   A,H   
                              XOR   80h   
                              LD   H,A   
                              LD   A,D   
                              XOR   80h   
                              LD   D,A   
                              SBC   HL,DE   ; carry if HL < DE
                              SBC   HL,HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_GT:       ; >
                              POP   HL   ; a > b  is  b < a
                              EX   DE,HL   
                              JP   fs_lt1   
                    FS_EQ:       ; =
                              POP   HL   
                              OR   A   
                              SBC   HL,DE   
                              LD   A,H   
                              OR   L   
                              CP   1   ; carry only if a - b = 0
                              SBC   HL,HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
