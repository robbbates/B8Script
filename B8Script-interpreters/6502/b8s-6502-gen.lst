E1A3   86 E2                  DW   h_add-1   ; +
E1A5   01 E4                  DW   h_cfetch-1   ; ,
E1A7   7E E2                  DW   h_sub-1   ; -
E1A9   40 E2                  DW   h_cstore-1   ; .
E1AB   18 E3                  DW   h_div-1   ; /
E1AD   0A E1                  DW   push-1   ; :
E1AF   48 E2                  DW   drop-1   ; ;
E1B1   B5 E2                  DW   h_lt-1   ; <
E1B3   CB E2                  DW   h_eq-1   ; =
E1B5   B2 E2                  DW   h_gt-1   ; >
E1B7   0A E4                  DW   h_key-1   ; ?
E1B9   F5 E3                  DW   h_fetch-1   ; @
E1BB   32 E1                  DW   h_def-1   ; [
E1BD   64 E0                  DW   h_break-1   ; \
E1BF   53 E0                  DW   h_ret-1   ; ]
E1C1   70 E2                  DW   h_xor-1   ; ^
E1C3   45 E3                  DW   h_alloc-1   ; _
E1C5   73 E4                  DW   h_grave-1   ; `
E1C7   33 E0                  DW   h_tor-1   ; {
E1C9   62 E2                  DW   h_or-1   ; |
E1CB   40 E0                  DW   h_fromr-1   ; }
E1CD   9E E2                  DW   h_not-1   ; ~
E1CF                             ; rdnum: TOS = TOS*10 + digit for each digit at IP. Wraps at 16 bits. The
E1CF                             ; test is at the bottom so the loop closes with a branch. Returns with the
E1CF                             ; carry set.
E1CF   20 1F E2     RD1:      JSR   incip   ; (keeps A = the digit)
E1D2   06 02                  ASL   TL   
E1D4   26 03                  ROL   TH   ; x2
E1D6   18                     CLC      
E1D7   65 02                  ADC   TL   
E1D9   85 04                  STA   T0   
E1DB   A5 03                  LDA   TH   
E1DD   69 00                  ADC   #0   
E1DF   85 05                  STA   T1   ; T = x2 + digit
E1E1   06 02                  ASL   TL   
E1E3   26 03                  ROL   TH   
E1E5   06 02                  ASL   TL   
E1E7   26 03                  ROL   TH   ; x8
E1E9   18                     CLC      
E1EA   A5 02                  LDA   TL   
E1EC   65 04                  ADC   T0   
E1EE   85 02                  STA   TL   
E1F0   A5 03                  LDA   TH   
