   593 00000139 668B1B              <1> h_fetch:mov     bx,[ebx]
   594 0000013C FFE5                <1>         jmp     ebp
   595                              <1> 
   596                              <1> ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
   597                              <1> ; '-' has two jobs: directly before a digit it starts a negative number.
   598 0000013E 8A06                <1> h_sub:  mov     al,[esi]
   599 00000140 2C30                <1>         sub     al,'0'
   600 00000142 3C0A                <1>         cmp     al,10
   601 00000144 72B0                <1>         jb      negnum
