F127                GETK:     EQU   KEY   ; the host's routine does the whole job
F127                          ENDIF      
F127                             ; ---- where the two ranges meet ---------------------------------------------
F127                             ; The first range ends somewhere among the next five handlers, ] \ [ @ ?
F127                             ; (they are in falling code order for this): NPG1 follows. Every handler
F127                             ; below them must start in the second range, and every one above in the
F127                             ; first.
F127                             ; "]" returns: pop an address and jump to it. (PULS X,Y: the dispatcher's
F127                             ; return address into X, then the saved IP into Y.)
F127                H_RET:       
F127                          IF   CHECKED   
                              JSR   chkbrk   ; Ctrl-C is checked at every word return
F127                          ENDIF      
F127   35 30                  PULS   X,Y   
F129   6E 84                  JMP   ,X   
F12B                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
F12B                             ; drops the block start, "]" returns. No closer at all ends the program.
F12B   EC C1        H_BREAK:   LDD   ,U++   
F12D   27 40                  BEQ   sk9   ; false: nothing to do
F12F   8D 1F                  BSR   skip   
F131   4D                     TSTA      ; skip returns 0 for ")"
F132   26 F3                  BNE   h_ret   
F134   35 16        RDROP:    PULS   D,X   ; the return address and the block start
F136   1F 05                  TFR   D,PC   ; back to the dispatcher
F138                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
F138                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
F138                             ; the body"s address instead. Either way it then skips to the matching "]'.
F138                             ; (The unchecked build takes anything that is not a letter as the space; the
F138                             ; checked build stops on it.)
F138                          IF   CHECKED   
                    DEF1:     CMPA   #" "-"A"+256   
                              BEQ   def2   
                              LBRA   e_brack   ; anything but a letter or a space
F138                          ENDIF      
F138   A6 A0        H_DEF:    LDA   ,Y+   
F13A   80 41                  SUBA   #"A"   ; a letter gives 0-25 or 32-57: lowercase
F13C   1F 89                  TFR   A,B   ;   lands 64 bytes up
F13E   C4 DF                  ANDB   #0DFh   ; fold case
F140   C1 1A                  CMPB   #26   
F142                          IF   1-CHECKED   
F142   24 0A                  BHS   def2   ; not a letter
F144                          ENDIF      
F144                          IF   CHECKED   
                              BHS   def1   
F144                          ENDIF      
F144   BD F0 73               JSR   cellx   
F147   1F 20                  TFR   Y,D   
F149   E7 84                  STB   ,X   ; little-endian
F14B   A7 01                  STA   1,X   
F14D   8C                     FCB   8Ch   ; (CMPX #: steps over the PSHU)
F14E   36 20        DEF2:     PSHU   Y   ; an anonymous block: push its address
F150                             ; fall into skip
F150                             ; skip: read past text to the closer at this level, and return A = 0 if it
F150                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
F150                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
F150                             ; no closer; anything else that runs into the NUL had unbalanced brackets
F150                             ; anyway). B counts the open levels.
F150   5F           SKIP:     CLRB      
F151   A6 A0        SK1:      LDA   ,Y+   
F153   10 27 FE A9            LBEQ   fin   
F157   81 22                  CMPA   #22h   
F159   26 02                  BNE   sk2   
F15B   8D 79                  BSR   skipstr   ; leaves A = 22h, which matches nothing below
F15D   80 28        SK2:      SUBA   #"("   
F15F   27 0F                  BEQ   sk3   
F161   4A                     DECA      ; ")"
F162   27 08                  BEQ   sk4   
F164   80 32                  SUBA   #"["-")"   
F166   27 08                  BEQ   sk3   
F168   81 02                  CMPA   #"]"-"["   
F16A   26 E5                  BNE   sk1   
F16C   5A           SK4:      DECB      
F16D   2A E2                  BPL   sk1   
F16F   39           SK9:      RTS      ; the closer at this level
F170   5C           SK3:      INCB      
F171   20 DE                  BRA   sk1   
F173   AE C4        H_FETCH:   LDX   ,U   ; "@" (the cell in memory is little-endian)
F175   A6 01                  LDA   1,X   
F177   20 6B                  BRA   cf1   
F179                             ; "?" ( n -- c ) or ( -n -- addr )
F179                             ;   n > 0: wait about n ms for a key; 0 if none came
F179                             ;   n = 0: wait for a key
F179                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
F179                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
F179   AE C4        H_KEY:    LDX   ,U   
F17B   2B 17                  BMI   line   
F17D   C6 14        KT1:      LDB   #MSLOOP   ; one millisecond, roughly
F17F   BD FF 06     KT2:      JSR   getk   
F182   26 0B                  BNE   kt3   
F184   5A                     DECB      
F185   26 F8                  BNE   kt2   
F187   30 1F                  LEAX   -1,X   
F189   26 F2                  BNE   kt1   ; A = 0 if the time ran out
F18B   AE C4                  LDX   ,U   ; 0?: the countdown from 0 took 65536 ms;
F18D   27 EE                  BEQ   kt1   ;   run it again, until a key comes
F18F   6F C4        KT3:      CLR   ,U   
F191   A7 41                  STA   1,U   
F193   39                     RTS      
F194                             ; Backspace takes the last character back (and is echoed as it is), CR ends
F194                             ; (stored, not echoed), every other key is stored and echoed until the line
F194                             ; is full. B = the length so far; the low byte of the top cell becomes the
F194                             ; most allowed (it holds minus the count on entry).
F194   8C FF 81     LINE:     CMPX   #-127   ; (X = TOS, minus the count)
F197   24 04                  BHS   ln1   
F199   86 81                  LDA   #-127   ; more than 127 is taken as 127
F19B   A7 41                  STA   1,U   
F19D   60 41        LN1:      NEG   1,U   
F19F   8E 82 80               LDX   #LINEBUF   
F1A2   5F                     CLRB      
F1A3   BD FF 06     LN2:      JSR   getk   
F1A6   27 FB                  BEQ   ln2   
F1A8   81 0D                  CMPA   #13   
F1AA   27 16                  BEQ   ln5   
F1AC   81 08                  CMPA   #8   
F1AE   27 0C                  BEQ   ln4   
F1B0   E1 41                  CMPB   1,U   
F1B2   24 EF                  BHS   ln2   ; full
F1B4   A7 85                  STA   B,X   
F1B6   5C                     INCB      
F1B7   BD FF 03     LN3:      JSR   CONOUT   
F1BA   20 E7                  BRA   ln2   
F1BC   5D           LN4:      TSTB      ; Backspace: nothing to take back?
F1BD   27 E4                  BEQ   ln2   
F1BF   5A                     DECB      
F1C0   20 F5                  BRA   ln3   ; echo it
F1C2   A7 85        LN5:      STA   B,X   ; A = 13
F1C4   AF C4                  STX   ,U   
F1C6   39                     RTS      
F1C7                             ; =============================================================================
F1C7                             ;  Handlers that must start in the second range (unchecked build).
F1C7                             ; =============================================================================
F1C7                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
F1C7                             ; the matching ")".
F1C7   EC C1        H_OPEN:   LDD   ,U++   
F1C9   27 85                  BEQ   skip   ; tail call: skip ends in RTS
F1CB   35 10                  PULS   X   
F1CD   34 20                  PSHS   Y   
F1CF   6E 84                  JMP   ,X   
F1D1                             ; 22h pushes the address of the text after it and skips the string.
F1D1   36 20        H_STR:    PSHU   Y   
F1D3   8C                     FCB   8Ch   ; (CMPX #: steps over the LEAY)
F1D4                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
F1D4                             ; the next character, so "/"" does not end it. Leaves A = 22h.
F1D4   31 21        SS0:      LEAY   1,Y   
F1D6   A6 A0        SKIPSTR:   LDA   ,Y+   
F1D8   81 2F                  CMPA   #"/"   
F1DA   27 F8                  BEQ   ss0   
F1DC   81 22                  CMPA   #22h   
F1DE   26 F6                  BNE   skipstr   
F1E0   39                     RTS      
F1E1   AE C4        H_CFETCH:   LDX   ,U   ; ","
F1E3   4F                     CLRA      
F1E4   E6 84        CF1:      LDB   ,X   
F1E6   ED C4                  STD   ,U   
F1E8   39                     RTS      
F1E9                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
F1E9                             ; drops it and carries on.
F1E9   EC C1        H_CLOSE:   LDD   ,U++   
F1EB   10 27 FF 45            LBEQ   rdrop   
F1EF                          IF   CHECKED   
                              JSR   chkbrk   ; Ctrl-C is checked at every loop-back
F1EF                          ENDIF      
F1EF   10 AE 62               LDY   2,S   ; the block start, under the return address
F1F2   39                     RTS      
F1F3                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
F1F3                             ; "*": three 8x8 multiplies; only the low 16 bits are kept.
F1F3                             ; a = ah:al at 2,U.  b = bh:bl at ,U.
F1F3   A6 43        H_MUL:    LDA   3,U   
F1F5   E6 C4                  LDB   ,U   
F1F7   3D                     MUL      ; al*bh
F1F8   E7 C4                  STB   ,U   ; (bh is no longer needed)
F1FA   A6 42                  LDA   2,U   
F1FC   E6 41                  LDB   1,U   
F1FE   3D                     MUL      ; ah*bl
F1FF   EB C4                  ADDB   ,U   
F201   E7 C4                  STB   ,U   ; the cross terms, low byte
F203   A6 43                  LDA   3,U   
F205   E6 41                  LDB   1,U   
F207   3D                     MUL      ; al*bl
F208   AB C4                  ADDA   ,U   
F20A   33 42                  LEAU   2,U   
F20C   ED C4                  STD   ,U   
F20E   39                     RTS      
F20F                             ; Signed compares: a-b, then a branch to put -1 or 0 on the stack.
F20F   8D 69        H_GT:     BSR   h_swap   ; a > b is b < a
F211   8D 10        H_LT:     BSR   cmp   
F213   2D 02                  BLT   true   
F215   5F           FALSE:    CLRB      
F216   8C                     FCB   8Ch   ; (CMPX #: steps over the LDB)
F217   C6 FF        TRUE:     LDB   #0FFh   
F219   1D                     SEX      ; D = 0000 or FFFF
F21A   ED C4                  STD   ,U   
F21C   39                     RTS      
F21D   8D 04        H_EQ:     BSR   cmp   
F21F   27 F6                  BEQ   true   
F221   20 F2                  BRA   false   
F223   EC 42        CMP:      LDD   2,U   
F225   10 A3 C1               CMPD   ,U++   
F228   39                     RTS      
F229   A6 41        H_EMIT:   LDA   1,U   ; "'"
F22B   8D 4A                  BSR   putc   
F22D   33 42        H_DROP:   LEAU   2,U   ; ";"
F22F   39                     RTS      
F230                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character
F230                             ; clears that character"s bit 6 (/M is CR, /` is space; "/" and ""' have no
F230                             ; bit 6, so // and /" give themselves).
F230   AE C4        H_PRINT:   LDX   ,U   
