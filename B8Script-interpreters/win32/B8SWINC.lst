  1829                              <1> ; =============================================================================
  1830                              <1> ;  The imports: kernel32.dll only. An import directory entry, the import
  1831                              <1> ;  lookup table, the hint/name entries and the DLL's name; then the import
  1832                              <1> ;  address table, which the loader fills in, right below `next` (with the
  1833                              <1> ;  routine pointers after it), so that CALL [EBP+d8] reaches it.
  1834                              <1> ; =============================================================================
  1835                              <1> %macro  IMPORTS 1
  1836                              <1>         IMP     GetStdHandle
  1837                              <1>         IMP     GetConsoleMode
  1838                              <1>         IMP     SetConsoleMode
  1839                              <1>         IMP     GetCommandLineA
  1840                              <1>         IMP     CreateFileA
  1841                              <1>         IMP     ReadFile
  1842                              <1>         IMP     WriteFile
  1843                              <1> %if EDITOR
  1844                              <1>         IMP     CloseHandle             ; (a runner leaves its file open)
  1845                              <1> %endif
  1846                              <1>         IMP     WaitForMultipleObjects
  1847                              <1>         IMP     CreateWaitableTimerExW
  1848                              <1>         IMP     SetWaitableTimer
  1849                              <1>         IMP     ReadConsoleInputA
  1850                              <1>         IMP     ExitProcess
  1851                              <1> %endmacro
  1852 000006BA 00<rep 2h>          <1>         align   4, db 0
