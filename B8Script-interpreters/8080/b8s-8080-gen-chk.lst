03A3                             ; =============================================================================
03A3                             ;  Machine code: the grave
03A3                             ; =============================================================================
03A3                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
03A3                             ; are stored from addr until a non-hex character; then a RET (C9h) is
03A3                             ; written and its address is left. An odd last digit is consumed and dropped.
03A3                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
03A3                             ; code is entered by CALL with the data stack above the return address; it
03A3                             ; must keep BC, and on return the top cell becomes the new TOS.
03A3   0A           H_GRAVE:   LDAX   B   
03A4   CD D4 03               CALL   hexval   
03A7   DA CE 03               JC   exec   
03AA   0A           HX1:      LDAX   B   
03AB   CD D4 03               CALL   hexval   
03AE   DA C8 03               JC   hx2   
03B1   03                     INX   B   
03B2   87                     ADD   A   
03B3   87                     ADD   A   
03B4   87                     ADD   A   
03B5   87                     ADD   A   
03B6   57                     MOV   D,A   
03B7   0A                     LDAX   B   
03B8   CD D4 03               CALL   hexval   
03BB   DA C8 03               JC   hx2   ; odd digit: already consumed, dropped
03BE   03                     INX   B   
03BF   B2                     ORA   D   
03C0                          IF   CHECKED   
03C0   CD 1F 02               CALL   chkst   
03C3                          ENDIF      
03C3   77                     MOV   M,A   
03C4   23                     INX   H   
03C5   C3 AA 03               JMP   hx1   
03C8                HX2:         
03C8                          IF   CHECKED   
03C8   CD 1F 02               CALL   chkst   
03CB                          ENDIF      
03CB   36 C9                  MVI   M,0C9h   
03CD   D7                     RST   2   
03CE   CD D3 03     EXEC:     CALL   exjmp   ; the code returns here, with its top cell on
03D1   E1                     POP   H   ;   the stack: that becomes the new TOS
03D2   D7                     RST   2   
03D3   E9           EXJMP:    PCHL      
03D4                             ; hexval: A = a character; returns its value 0-15 with carry clear, or
03D4                             ; carry set if it isn't a hex digit (0-9, A-F, a-f).
03D4   D6 30        HEXVAL:   SUI   "0"   
03D6   FE 0A                  CPI   10   
03D8   3F                     CMC      
03D9   D0                     RNC      
03DA   E6 DF                  ANI   0DFh   
03DC   D6 11                  SUI   11h   
03DE   FE 06                  CPI   6   
03E0   3F                     CMC      
03E1   D8                     RC      
03E2   C6 0A                  ADI   10   
03E4   C9                     RET      
03E5                             ; =============================================================================
03E5                             ;  Console layer: getk returns a waiting key in A (zero flag clear), or
03E5                             ;  A = 0 with the zero flag set when none is waiting. putc prints A.
03E5                             ;  Both keep BC, DE and HL.
03E5                             ; =============================================================================
03E5                GETK:        
03E5                          IF   CHECKED   
03E5   3A 36 82               LDA   KEYBUF   ; a key held back by the break check
03E8   B7                     ORA   A   
03E9   CA F3 03               JZ   gk1   
03EC   F5                     PUSH   PSW   
03ED   AF                     XRA   A   
03EE   32 36 82               STA   KEYBUF   
03F1   F1                     POP   PSW   
03F2   C9                     RET      
03F3                GK1:         
03F3                          ENDIF      
03F3                          IF   CPM   
                              MVI   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
                              JMP   putc   ; (which ends with ORA A, for the zero flag)
                                 ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
                                 ; printing and could swallow a key that BDOS 6 then never sees.
                    PUTC:     PUSH   B   
                              PUSH   D   
                              PUSH   H   
                              MOV   E,A   
                              MVI   C,6   
                              CALL   BDOS   
                              POP   H   
                              POP   D   
                              POP   B   
                              ORA   A   
                              RET      
03F3                          ENDIF      
03F3                          IFN   CPM   
03F3   CD 06 FF               CALL   CONST   
03F6   B7                     ORA   A   
03F7   C8                     RZ      
03F8   CD 00 FF               CALL   CONIN   
03FB   B7                     ORA   A   
03FC   C9                     RET      
03FD                PUTC:     EQU   CONOUT   
03FD                          ENDIF      
03FD                             ; =============================================================================
03FD                             ;  Checked build: break key and error reports
03FD                             ; =============================================================================
03FD                          IF   CHECKED   
03FD                             ; chkbrk: a waiting key is read now; Ctrl-C stops the program, anything
03FD                             ; else is held for the next "?".
03FD   3A 36 82     CHKBRK:   LDA   KEYBUF   
0400   B7                     ORA   A   
0401   C0                     RNZ      ; one key is already held
0402   CD E5 03               CALL   getk   
0405   C8                     RZ      
0406   FE 03                  CPI   3   
0408   CA 20 04               JZ   e_break   
040B   32 36 82               STA   KEYBUF   
040E   C9                     RET      
040F   CD 3B 04     E_STACK:   CALL   error   
0412   73 74 61 63 EB         DB   "stac","k"+80h   
0417   CD 3B 04     E_RSTACK:   CALL   error   
041A   72 65 74 75 72 EE      DB   "retur","n"+80h   
0420   CD 3B 04     E_BREAK:   CALL   error   
0423   62 72 65 61 EB         DB   "brea","k"+80h   
0428   CD 3B 04     E_HEAP:   CALL   error   
042B   68 65 61 F0            DB   "hea","p"+80h   
042F   CD 3B 04     E_STORE:   CALL   error   
0432   73 74 6F 72 E5         DB   "stor","e"+80h   
0437   CD 3B 04     E_BRACK:   CALL   error   
043A   DB                     DB   "["+80h   
043B                             ; error: print CR LF, the word after the CALL (last character has bit 7
043B                             ; set), " at " and the offset of the reading position in the program.
043B   D1           ERROR:    POP   D   ; DE -> the word
043C   31 FE 81               LXI   SP,DSTOP   ; the stacks may be wrecked: start clean
043F   21 67 04               LXI   H,er1   
0442   CD 59 04               CALL   prs   
0445   EB                     XCHG      
0446   CD 59 04               CALL   prs   ; the word
0449   21 69 04               LXI   H,er2   
044C   CD 59 04               CALL   prs   
044F   21 FF 7C               LXI   H,(0-PROG-1)&0FFFFh   
0452   09                     DAD   B   ; IP - (PROG+1): the character just read
0453   CD 09 03               CALL   pdec   
0456   C3 78 00               JMP   endprog   
0459                             ; prs: print the string at HL, whose last character has bit 7 set
0459   7E           PRS:      MOV   A,M   
045A   23                     INX   H   
045B   F5                     PUSH   PSW   
045C   E6 7F                  ANI   7Fh   
045E   CD 03 FF               CALL   putc   
0461   F1                     POP   PSW   
0462   17                     RAL      
0463   D2 59 04               JNC   prs   
0466   C9                     RET      
0467   0D 8A        ER1:      DB   13,10+80h   
0469   20 61 74 A0  ER2:      DB   " at"," "+80h   
046D                          ENDIF      
046D                             ; =============================================================================
046D                             ;  Startup
046D                             ; =============================================================================
046D                START:       
046D                          IF   CPM   
                              LXI   SP,DSTOP   
                                 ; CP/M: the RAM pages follow the image; the heap may grow to the BDOS
                              LXI   H,stubs   ; RST 08h and RST 10h stubs into page zero
                              LXI   D,0008h   
                              MVI   B,12   
                    CPY:      MOV   A,M   
                              STAX   D   
                              INX   H   
                              INX   D   
                              DCR   B   
                              JNZ   cpy   
                              LXI   D,005Ch   ; open the file named on the command line
                              MVI   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LXI   D,PROG   
                    LD1:      PUSH   D   
                              MVI   C,26   ; set the DMA address
                              CALL   BDOS   
                              LXI   D,005Ch   
                              MVI   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   H   ; HL = the address this record went to
                              ORA   A   
                              JNZ   ld2   
                              LXI   D,128   
                              DAD   D   
                              XCHG      
                              JMP   ld1   
                    LD2:      MVI   M,0   ; the end of the file counts as NUL
                              INX   H   
                              SHLD   HEAP   
                              LDA   0007h   ; the BDOS page is the heap limit
                              STA   HLIM   
046D                          ENDIF      
046D                          IFN   CPM   
046D   21 00 83               LXI   H,PROG   ; the heap starts after the program's NUL
0470   7E           FNUL:     MOV   A,M   
0471   23                     INX   H   
0472   B7                     ORA   A   
0473   C2 70 04               JNZ   fnul   
0476   22 7C 82               SHLD   HEAP   
0479                          ENDIF      
0479                          IF   (1-CPM)*CHECKED   
0479   3E F0                  MVI   A,HEAPLIM   
047B   32 3A 82               STA   HLIM   
047E                          ENDIF      
047E   21 E0 80               LXI   H,RSTOP   
0481   22 34 82               SHLD   RSP   
0484                          IF   CHECKED   
0484   AF                     XRA   A   
0485   32 36 82               STA   KEYBUF   
0488                          ENDIF      
0488   01 00 83               LXI   B,PROG   
048B   C3 11 00               JMP   next0   
048E                          IF   CPM   
                    STUBS:    POP   D   ; 0008h: drop, then next
                              POP   H   
                              JMP   next0   
                    H_DUP:    EQU   000Dh   
                              PUSH   H   ; 000Dh: dup
                              RST   2   
                              DB   0   
                              POP   D   ; 0010h: next
                              JMP   next0   
                    ENDPROG:   EQU   0   ; warm boot
                    DROP_NEXT:   EQU   0009h   
                                 ; RAM pages, after the image
                    RSPAGE:   EQU   (imgend + 255) / 256   
                    DSPAGE:   EQU   RSPAGE + 1   
                    LETPAGE:   EQU   RSPAGE + 2   
                    PROG:     EQU   LETPAGE*256 + 256   
048E                          ENDIF      
048E                IMGEND:      


