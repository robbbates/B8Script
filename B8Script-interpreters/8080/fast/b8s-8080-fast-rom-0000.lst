063F   CF                     DS   1-CPM,0CFh   
0640                          DS   CPM,0CDh   
0640                          DS   CPM,AROP&0FFh   
0640                          DS   CPM,AROP/256   
0640   44                     MOV   B,H   
0641   4D                     MOV   C,L   
0642   E1                     POP   H   
0643   3E 55                  MVI   A,"U"   
0645   C3 61 06               JMP   error   
0648                             ; e_dollar: "$" ran into a NUL (in prstr): Q, with the string's address
0648                             ; back in TOS. prstr"s return address goes first. But if "$' had no
0648                             ; address at all (the stack was empty), it is s, found now: chkstk, called
0648                             ; one cell up, sees the stack past its empty place then.
0648   D1           E_DOLLAR:   POP   D   
0649   E1                     POP   H   
064A   CD 02 06               CALL   chkstk   
064D   E5                     PUSH   H   
064E   2A 3A 82               LHLD   PSAVE   
0651   11                     DB   11h   ; (LXI D hides e_quote's first two bytes)
0652                             ; Error entries. Each loads its letter and then hides the next entry inside
0652                             ; a 3-byte LXI D (the 11h), so they all fall through to `error`.
0652   44           E_QUOTE:   MOV   B,H   ; an unclosed string: HL is its address, one
0653   4D                     MOV   C,L   ;   past the opening quote, which is the place
0654   3E 51                  MVI   A,"Q"   
0656   11                     DB   11h   
0657   3E 58        E_RESV:   MVI   A,"X"   ; a reserved byte outside a string
0659   11                     DB   11h   
065A   3E 5A        E_ZERO:   MVI   A,"Z"   ; dividing by zero
065C   11                     DB   11h   
065D   3E 57        E_BRACK:   MVI   A,"W"   ; bad character after [
065F   FE                     DB   0FEh   ; (CPI hides the one byte of errp)
0660                             ; errp: an error found inside a routine: drop its return address first.
0660   D1           ERRP:     POP   D   
