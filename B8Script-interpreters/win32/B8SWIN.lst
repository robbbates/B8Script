     1                                  %define CHECKED 0
     2                                  %define EDITOR 0
     3                                  [map all B8SWIN.map]
     4                                  %include "/home/user/B8Script/B8Script-interpreters/win32/b8s-win32.asm"
     1                              <1> ; =============================================================================
     2                              <1> ;  B8Script interpreter for 32-bit Windows (x86, console subsystem)
     3                              <1> ;  Spec: docs/b8script.md (2026-11-24).
     4                              <1> ;
     5                              <1> ;  Assembler: NASM 2.16, flat binary output: the PE header is laid out by
     6                              <1> ;  hand at the top of this file, so the output IS the .EXE:
     7                              <1> ;
     8                              <1> ;      nasm -f bin -o B8SWIN.EXE b8s-win32.asm
     9                              <1> ;      nasm -f bin -DCHECKED=1 -o B8SWINC.EXE b8s-win32.asm
    10                              <1> ;      nasm -f bin -DEDITOR=1 -o B8SWINE.EXE b8s-win32.asm
    11                              <1> ;      nasm -f bin -DEDITOR=1 -DCHECKED=1 -o B8SWINEC.EXE b8s-win32.asm
    12                              <1> ;
    13                              <1> ;  Two switches (the defaults below, or -D on the command line):
    14                              <1> ;    CHECKED  0 = no checks (spec: the programmer is responsible)
    15                              <1> ;             1 = starts with every variable at 0 and every word undefined,
    16                              <1> ;                 and stops on every error in the spec's table (and Ctrl-C)
    17                              <1> ;                 with the four-line report, on the standard error handle.
    18                              <1> ;    EDITOR   0 = a runner: B8SWIN PROG.B8S loads the file, runs it, exits
    19                              <1> ;             1 = the line editor of the spec's suggested standard (the same
    20                              <1> ;                 editor as the Z80's, key for key); the file named on the
    21                              <1> ;                 command line is the program to start with.
    22                              <1> ;
    23                              <1> ;  In every build Ctrl-C stops a running program (an unchecked runner stops
    24                              <1> ;  without a word): see the console layer for the rules, the held key and
    25                              <1> ;  the break-off cell.
    26                              <1> ;
    27                              <1> ;  The console escapes of '$' (/{ /} /| /` /~) always send ANSI (VT100)
    28                              <1> ;  sequences: the output's console mode asks for them to be obeyed (see
    29                              <1> ;  the startup).
    30                              <1> ; =============================================================================
    31                              <1> 
    32                              <1> %ifndef CHECKED
    33                              <1> %define CHECKED 0
    34                              <1> %endif
    35                              <1> %ifndef EDITOR
    36                              <1> %define EDITOR  0
    37                              <1> %endif
    38                              <1> 
    39                              <1> ; -----------------------------------------------------------------------------
    40                              <1> ;  The machine model
    41                              <1> ;
    42                              <1> ;  B8Script is defined for a 64 KB machine with 16-bit cells, and that is what
    43                              <1> ;  runs here. The 64 KB arena sits at ARENA (00410000h), a multiple of 64 KB,
    44                              <1> ;  inside the image (its last 64 KB of uninitialised space): the B8Script
    45                              <1> ;  address a is the byte at ARENA + a. Because the arena is 64 KB aligned,
    46                              <1> ;  "ARENA + a" is simply a 32-bit register whose high word is 0041h and whose
    47                              <1> ;  low word is a. Every cell the interpreter keeps in a 32-bit register or
    48                              <1> ;  stack slot is kept in that form, so it is at once the 16-bit cell (its low
    49                              <1> ;  word) and a pointer to that cell's address:
    50                              <1> ;
    51                              <1> ;    EBX  TOS. 16-bit operations work on BX; EBX's high word is always 0041h,
    52                              <1> ;         so [EBX] is the byte TOS points at.
    53                              <1> ;    ESI  IP: a pointer to the next program character (LODSB reads it).
    54                              <1> ;    ESP  the data stack: one dword per cell, low word the cell, high word
    55                              <1> ;         0041h. [ESP] is NOS. It is the thread's own stack (the API calls
    56                              <1> ;         push their arguments below it). V_DSTOP holds ESP for the empty
    57                              <1> ;         stack.
    58                              <1> ;    EDI  the return stack pointer: dword entries (IP values and cells parked
    59                              <1> ;         with '{', all in the same form), growing down from RSTOP. A pop is
    60                              <1> ;         MOV r,[EDI] / SCASD (SCASD only steps EDI on by 4).
    61                              <1> ;    EBP  the address of `next`: every handler ends with JMP EBP (2 bytes),
    62                              <1> ;         and the interpreter's own variables, the import address table
    63                              <1> ;         and the pointers to the routines called most (see CALLP) lie
    64                              <1> ;         within 127 bytes of `next`, so [EBP+d8] reaches them in 3-byte
    65                              <1> ;         instructions. (V() below names them.)
    66                              <1> ;    EAX ECX EDX  scratch. (The Windows API keeps EBX, ESI, EDI and EBP.)
    67                              <1> ;
    68                              <1> ;  Memory map of the arena (B8Script addresses):
    69                              <1> ;    0000h-00FFh  page zero: unused, and left zero. An undefined word's cell
    70                              <1> ;                 holds 0000h, so calling it runs into the NUL at 0000h; the
    71                              <1> ;                 checked build sees that the IP is 0001h there and reports U.
    72                              <1> ;    0100h        the letter page: A-Z at +00h..+33h, a-z at +40h..+73h (a
    73                              <1> ;                 word's cell is 64 bytes below its variable's), the held key
    74                              <1> ;                 at +7Ah, the break-off cell at +7Bh, the heap pointer at +7Ch,
    75                              <1> ;                 and the -n? line buffer at +80h..+FFh (127 characters and CR;
    76                              <1> ;                 the editor's input line uses it too)
    77                              <1> ;    0200h        PROG: the program text, ending in NUL; the heap starts after
    78                              <1> ;                 the NUL and may grow up to the heap limit, FF00h
    79                              <1> ;    FF00h-FFFFh  above the limit: not the program's (unused)
    80                              <1> ;  The stacks are outside the arena: the return stack is 112 entries below
    81                              <1> ;  RSTOP (in the image's uninitialised space below the arena) and the data
    82                              <1> ;  stack is the thread's stack (127 cells in the checked builds, as deep as
    83                              <1> ;  the 1 MB stack reserve allows in the others).
    84                              <1> ;
    85                              <1> ;  The whole image (code, arena) is one section, readable, writable and
    86                              <1> ;  executable, so machine code can run in the arena (see h_grave).
    87                              <1> ; -----------------------------------------------------------------------------
    88                              <1> 
    89                              <1> IB      equ     400000h         ; ImageBase
    90                              <1> SECTVA  equ     1000h           ; the section's RVA
    91                              <1> ARENA   equ     410000h         ; the 64 KB B8Script memory (RVA 10000h)
    92                              <1> IMGSIZE equ     20000h          ; SizeOfImage: the arena is its last 64 KB
    93                              <1> 
    94                              <1> LET     equ     0100h           ; the letter page (a B8Script address)
    95                              <1> HELD    equ     LET+7Ah         ; a key read by the break check, held for the
    96                              <1>                                 ;   next '?' (0: none)
    97                              <1> BRKOFF  equ     LET+7Bh         ; the break-off cell: a non-zero byte here
    98                              <1>                                 ;   makes Ctrl-C a key like any other
    99                              <1> HEAP    equ     LET+7Ch         ; the heap pointer (a cell)
   100                              <1> LINEBUF equ     LET+80h         ; the -n? line buffer
   101                              <1> PROG    equ     0200h           ; the program text
   102                              <1> HEAPLIM equ     0FFh            ; the heap limit, as a page: FF00h
   103                              <1> LIMIT   equ     HEAPLIM*256
   104                              <1> MAXFILE equ     LIMIT-PROG-3    ; the most a file may bring (room for CR LF NUL)
   105                              <1> 
   106                              <1> RSTOP   equ     IB+0FF00h       ; the empty return stack (it grows down)
   107                              <1> RSMAX   equ     112             ; return stack entries (checked builds)
   108                              <1> DSMAX   equ     127             ; data stack cells (checked builds)
   109                              <1> NAMEBUF equ     IB+0F000h       ; the file's name, as typed (up to 3.5 KB)
   110                              <1> 
   111                              <1> ; -----------------------------------------------------------------------------
   112                              <1> ;  The PE header, by the documented rules: a 64-byte DOS header whose
   113                              <1> ;  e_lfanew points at the PE signature, the COFF header, the PE32 optional
   114                              <1> ;  header with its 16 data directories, and one section header. Then zeros
   115                              <1> ;  up to SizeOfHeaders (200h, one FileAlignment).
   116                              <1> ; -----------------------------------------------------------------------------
   117                              <1>         bits    32
   118                              <1>         section hdr start=0 vstart=IB
   119 00000000 4D5A                <1>         dw      'MZ'                    ; e_magic
   120 00000002 00<rep 3Ah>         <1>         times   3Ch-($-$$) db 0
   121 0000003C [4000C0FF]          <1>         dd      pe-IB                   ; e_lfanew
   122 00000040 50450000            <1> pe:     db      'PE',0,0
   123 00000044 4C01                <1>         dw      14Ch                    ; Machine: i386
   124 00000046 0100                <1>         dw      1                       ; NumberOfSections
   125 00000048 00000000            <1>         dd      0                       ; TimeDateStamp
   126 0000004C 0000000000000000    <1>         dd      0, 0                    ; no COFF symbols
   127 00000054 E000                <1>         dw      opthdr_end-opthdr       ; SizeOfOptionalHeader (224)
   128 00000056 0F01                <1>         dw      010Fh                   ; RELOCS_STRIPPED, EXECUTABLE_IMAGE,
   129                              <1>                                         ;   LINE_NUMS_STRIPPED,
   130                              <1>                                         ;   LOCAL_SYMS_STRIPPED, 32BIT_MACHINE
   131 00000058 0B01                <1> opthdr: dw      10Bh                    ; PE32
   132 0000005A 0100                <1>         db      1, 0                    ; linker version
   133 0000005C 00080000            <1>         dd      RAWSIZE                 ; SizeOfCode
   134 00000060 00080000            <1>         dd      RAWSIZE                 ; SizeOfInitializedData
   135 00000064 00000000            <1>         dd      0                       ; SizeOfUninitializedData
   136 00000068 [0000C0FF]          <1>         dd      start-IB                ; AddressOfEntryPoint
   137 0000006C 00100000            <1>         dd      SECTVA                  ; BaseOfCode
   138 00000070 00100000            <1>         dd      SECTVA                  ; BaseOfData
   139 00000074 00004000            <1>         dd      IB                      ; ImageBase
   140 00000078 00100000            <1>         dd      1000h                   ; SectionAlignment
   141 0000007C 00020000            <1>         dd      200h                    ; FileAlignment
   142 00000080 04000000            <1>         dw      4, 0                    ; OS version 4.0
   143 00000084 00000000            <1>         dw      0, 0                    ; image version
   144 00000088 04000000            <1>         dw      4, 0                    ; subsystem version 4.0
   145 0000008C 00000000            <1>         dd      0                       ; Win32VersionValue
   146 00000090 00000200            <1>         dd      IMGSIZE                 ; SizeOfImage
   147 00000094 00020000            <1>         dd      200h                    ; SizeOfHeaders
   148 00000098 00000000            <1>         dd      0                       ; CheckSum
   149 0000009C 0300                <1>         dw      3                       ; Subsystem: Windows console
   150 0000009E 0000                <1>         dw      0                       ; DllCharacteristics: none
   151 000000A0 0000100000100000    <1>         dd      100000h, 1000h          ; stack reserve, commit
   152 000000A8 0000100000100000    <1>         dd      100000h, 1000h          ; heap reserve, commit
   153 000000B0 00000000            <1>         dd      0                       ; LoaderFlags
   154 000000B4 10000000            <1>         dd      16                      ; NumberOfRvaAndSizes
   155 000000B8 0000000000000000    <1>         dd      0, 0                    ; 0 export
   156 000000C0 [C404C0FF]28000000  <1>         dd      idesc-IB, idesc_end-idesc ; 1 import
   157 000000C8 00000000<rep 14h>   <1>         times   10*2 dd 0               ; 2-11
   158 00000118 [0406C0FF]34000000  <1>         dd      iat-IB, iat_end-iat     ; 12 IAT
   159 00000120 00000000<rep 6h>    <1>         times   3*2 dd 0                ; 13-15
   160                              <1> opthdr_end:
   161 00000138 2E74657874000000    <1>         db      '.text',0,0,0           ; the one section
   162 00000140 00F00100            <1>         dd      IMGSIZE-SECTVA          ; VirtualSize: code, then zeros up to
   163                              <1>                                         ;   the arena's end
   164 00000144 00100000            <1>         dd      SECTVA                  ; VirtualAddress
   165 00000148 00080000            <1>         dd      RAWSIZE                 ; SizeOfRawData
   166 0000014C 00020000            <1>         dd      200h                    ; PointerToRawData
   167 00000150 0000000000000000    <1>         dd      0, 0                    ; no relocations, no line numbers
   168 00000158 00000000            <1>         dw      0, 0
   169 0000015C 600000E0            <1>         dd      0E0000060h              ; code, initialised data, execute,
   170                              <1>                                         ;   read, write
   171 00000160 00<rep A0h>         <1>         times   200h-($-$$) db 0
   172                              <1> 
   173                              <1> ; =============================================================================
   174                              <1> ;  The code
   175                              <1> ; =============================================================================
   176                              <1>         section text start=200h vstart=IB+SECTVA
   177                              <1> tstart:
   178                              <1> %define V(x) ebp+(x)-next               ; a variable or IAT slot near `next`
   179                              <1> 
   180                              <1> ; The routines called from many places are called through a pointer near
   181                              <1> ; `next` (CALL [EBP+d8], 3 bytes, instead of 5): the pointers are at ptrs,
   182                              <1> ; after the IAT. P_x says whether routine x has one in this build.
   183                              <1> %define P_putc  1
   184                              <1> %define P_waitk EDITOR
   185                              <1> %define P_ekey  EDITOR
   186                              <1> %define P_rdnum EDITOR
   187                              <1> %define P_find  EDITOR
   188                              <1> %define P_pmsg  CHECKED
   189                              <1> %define P_pdec  CHECKED
   190                              <1> %define P_hexc  1
   191                              <1> %macro  CALLP 1
   192                              <1>  %if P_%1
   193                              <1>         call    [V(p_%1)]
   194                              <1>  %else
   195                              <1>         call    %1
   196                              <1>  %endif
   197                              <1> %endmacro
   198                              <1> %macro  JMPP 1
   199                              <1>  %if P_%1
   200                              <1>         jmp     [V(p_%1)]
   201                              <1>  %else
   202                              <1>         jmp     %1
   203                              <1>  %endif
   204                              <1> %endmacro
   205                              <1> 
   206                              <1> ; run0: start running at ESI. The heap starts after the stored program's
   207                              <1> ; NUL. TOS is popped: the data stack is as the last line left it. (The
   208                              <1> ; runner's startup runs on into it; in the editor builds it follows ^G.)
   209                              <1> %macro  RUN0CODE 0
   210                              <1> run0:   mov     edx,ARENA+PROG
   211                              <1> .st1:   inc     edx
   212                              <1>         cmp     byte [edx-1],0
   213                              <1>         jne     .st1
   214                              <1>         mov     [ARENA+HEAP],dx
   215                              <1> %if CHECKED
   216                              <1>         movzx   eax,dx                  ; '_' may not release below this
   217                              <1>         mov     [V(v_npend)],eax
   218                              <1> %endif
   219                              <1>         pop     ebx
   220                              <1>         jmp     ebp
   221                              <1> %endmacro
   222                              <1> 
   223                              <1> ; ---- startup ----------------------------------------------------------------
   224                              <1> ; The data stack starts empty; the cell pushed here stands for TOS, as when
   225                              <1> ; the editor has the stack in memory: the run starts by popping it.
   226 00000000 BD[5C060000]        <1> start:  mov     ebp,next
   227 00000005 BE00024100          <1>         mov     esi,ARENA+PROG
   228 0000000A 89654F              <1>         mov     [V(v_dstop)],esp
   229 0000000D 56                  <1>         push    esi                     ; (the cell that stands for TOS)
   230 0000000E 6AF6                <1>         push    -10                     ; STD_INPUT_HANDLE
   231 00000010 FF55A8              <1>         call    [V(iat_GetStdHandle)]
   232 00000013 894543              <1>         mov     [V(v_hin)],eax
   233 00000016 97                  <1>         xchg    eax,edi                 ; (EDI = the input handle, for now)
   234                              <1>         ; ANSI escape sequences: the output mode becomes processed output,
   235                              <1>         ; wrap at the end of a line and virtual terminal processing (1+2+4),
   236                              <1>         ; so the console obeys ESC [ ... as a terminal does. 1+2 is the
   237                              <1>         ; console's usual output mode. On Windows before 10, or when the
   238                              <1>         ; output is not a console, the call fails and nothing changes. The
   239                              <1>         ; mode is left on at the end, which does no harm. (The arguments
   240                              <1>         ; are pushed now, and the call made after the input's two.)
   241 00000017 6A07                <1>         push    7
   242 00000019 6AF5                <1>         push    -11                     ; STD_OUTPUT_HANDLE
   243 0000001B FF55A8              <1>         call    [V(iat_GetStdHandle)]
   244 0000001E 89454B              <1>         mov     [V(v_outh)],eax
   245 00000021 50                  <1>         push    eax
   246                              <1>         ; Raw keys: no echo, no line editing, Ctrl-C as a key (mode 0). If
   247                              <1>         ; the input is not a console, GetConsoleMode fails, and the keys are
   248                              <1>         ; read as bytes with ReadFile (see waitk).
   249 00000022 8D4D55              <1>         lea     ecx,[V(v_mode)]
   250 00000025 51                  <1>         push    ecx
   251 00000026 57                  <1>         push    edi
   252 00000027 FF55AC              <1>         call    [V(iat_GetConsoleMode)]
   253 0000002A 884553              <1>         mov     [V(v_iscon)],al
   254 0000002D 6A00                <1>         push    0
   255 0000002F 57                  <1>         push    edi
   256 00000030 FF55B0              <1>         call    [V(iat_SetConsoleMode)]
   257 00000033 FF55B0              <1>         call    [V(iat_SetConsoleMode)] ; (the output's, pushed above)
   258                              <1>         ; A high-resolution waitable timer for the timed waits of '?' (Windows
   259                              <1>         ; 10 1803 and later). A plain wait only ends on the system's tick,
   260                              <1>         ; every 15.6 ms, so 1? would take about 16 ms. Older Windows refuses
   261                              <1>         ; the flag; then v_htm is 0 and the waits are plain ones.
   262 00000036 6803001F00          <1>         push    1F0003h                 ; TIMER_ALL_ACCESS
   263 0000003B 6A02                <1>         push    2                       ; CREATE_WAITABLE_TIMER_HIGH_RESOLUTION
   264 0000003D 6A00                <1>         push    0
   265 0000003F 6A00                <1>         push    0
   266 00000041 FF55C8              <1>         call    [V(iat_CreateWaitableTimerExW)]
   267 00000044 894547              <1>         mov     [V(v_htm)],eax
   268                              <1>         ; The command line: the program's own name, then the file's.
   269 00000047 FF55B4              <1>         call    [V(iat_GetCommandLineA)]
   270 0000004A 96                  <1>         xchg    eax,esi
   271 0000004B E82A000000          <1>         call    token
   272 00000050 E825000000          <1>         call    token
   273 00000055 E844000000          <1>         call    load                    ; (no file, or no such file: no text)
   274                              <1> %if EDITOR
   275                              <1>         mov     eax,6835323Fh           ; ESC [ ? 2 5 h: the editor shows the
   276                              <1>         call    pseq                    ;   cursor when it starts, as after an
   277                              <1>         jmp     edit                    ;   error or a break (edit0)
   278                              <1> %else
   279 0000005A BF00FF4000          <1>         mov     edi,RSTOP               ; the return stack is empty
   280 0000005F BE00024100          <1>         mov     esi,ARENA+PROG          ; the IP
   281                              <1>         RUN0CODE                        ; (on into run0)
   210 00000064 BA00024100          <2> run0: mov edx,ARENA+PROG
   211 00000069 42                  <2> .st1: inc edx
   212 0000006A 807AFF00            <2>  cmp byte [edx-1],0
   213 0000006E 75F9                <2>  jne .st1
   214 00000070 6689157C014100      <2>  mov [ARENA+HEAP],dx
   215                              <2> %if CHECKED
   216                              <2>  movzx eax,dx
   217                              <2>  mov [V(v_npend)],eax
   218                              <2> %endif
   219 00000077 5B                  <2>  pop ebx
   220 00000078 FFE5                <2>  jmp ebp
   282                              <1> %endif
   283                              <1> 
   284                              <1> ; token: copy the next word of the command line at ESI to NAMEBUF, ending
   285                              <1> ; in NUL. A word is ended by a space, or is in double quotes. ESI is left
   286                              <1> ; after it (on the NUL at the end of the line, so another token is empty).
   287 0000007A BF00F04000          <1> token:  mov     edi,NAMEBUF
   288 0000007F AC                  <1> .sp:    lodsb
   289 00000080 3C20                <1>         cmp     al,' '
   290 00000082 74FB                <1>         je      .sp
   291 00000084 B420                <1>         mov     ah,' '
   292 00000086 3C22                <1>         cmp     al,22h
   293 00000088 7503                <1>         jne     .ch
   294 0000008A 88C4                <1>         mov     ah,al                   ; a quoted word ends at the quote
   295 0000008C AC                  <1>         lodsb
   296 0000008D 84C0                <1> .ch:    test    al,al
   297 0000008F 7408                <1>         jz      .nul
   298 00000091 38E0                <1>         cmp     al,ah
   299 00000093 7405                <1>         je      .end
   300 00000095 AA                  <1>         stosb
   301 00000096 AC                  <1>         lodsb
   302 00000097 EBF4                <1>         jmp     .ch
   303 00000099 4E                  <1> .nul:   dec     esi
   304 0000009A C60700              <1> .end:   mov     byte [edi],0
   305 0000009D C3                  <1>         ret
   306                              <1> 
   307                              <1> ; load: read the file named in NAMEBUF into PROG, and end the text with a
   308                              <1> ; NUL. No such file (or no name): no text, since ReadFile on the failed
   309                              <1> ; handle reads nothing (it sets the count to 0 first). The editor's ^R
   310                              <1> ; (cread) runs on into it, after setname.
   311                              <1> %if EDITOR
   312                              <1> cread:  call    setname
   313                              <1> %endif
   314 0000009E 31C0                <1> load:   xor     eax,eax
   315 000000A0 50                  <1>         push    eax                     ; hTemplateFile
   316 000000A1 50                  <1>         push    eax                     ; dwFlagsAndAttributes
   317 000000A2 6A03                <1>         push    3                       ; OPEN_EXISTING
   318 000000A4 50                  <1>         push    eax                     ; lpSecurityAttributes
   319 000000A5 6A01                <1>         push    1                       ; FILE_SHARE_READ
   320 000000A7 6800000080          <1>         push    80000000h               ; GENERIC_READ
   321 000000AC 6800F04000          <1>         push    NAMEBUF
   322 000000B1 FF55B8              <1>         call    [V(iat_CreateFileA)]
   323 000000B4 50                  <1>         push    eax                     ; (for CloseHandle)
   324 000000B5 6A00                <1>         push    0
   325 000000B7 8D4D3F              <1>         lea     ecx,[V(v_cnt)]
   326 000000BA 51                  <1>         push    ecx
   327 000000BB 68FDFC0000          <1>         push    MAXFILE
   328 000000C0 6800024100          <1>         push    ARENA+PROG
   329 000000C5 50                  <1>         push    eax
   330 000000C6 FF55BC              <1>         call    [V(iat_ReadFile)]
   331                              <1> %if EDITOR
   332                              <1>         call    [V(iat_CloseHandle)]
   333                              <1> %else
   334 000000C9 58                  <1>         pop     eax                     ; (the handle stays open)
   335                              <1> %endif
   336 000000CA 8B453F              <1>         mov     eax,[V(v_cnt)]
   337 000000CD C6800002410000      <1>         mov     byte [ARENA+PROG+eax],0 ; the end of the file counts as NUL
   338                              <1> %if EDITOR
   339                              <1>         ; The editor's text ends at the file's first ^Z (as in the CP/M
   340                              <1>         ; builds) or NUL, and every line must end in LF: a last line
   341                              <1>         ; without one is given a CR LF.
   342                              <1>         mov     esi,ARENA+PROG
   343                              <1>         mov     al,10                   ; (a file with no text needs nothing)
   344                              <1> .ld1:   mov     ah,al                   ; AH = the character before
   345                              <1>         lodsb
   346                              <1>         cmp     al,1Ah
