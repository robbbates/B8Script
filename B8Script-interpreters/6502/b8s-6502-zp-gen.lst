E11D   B5 02        H_CSTORE:   LDA   2,X   
E11F                ST9:         
E11F                          IF   CHECKED   
                              JSR   chkst   
E11F                          ENDIF      
E11F   81 00                  STA   (0,X)   
E121   E8                     INX      
E122   E8                     INX      
E123   E8           DROP:     INX      ; ";"
E124   E8                     INX      
E125   60                     RTS      
E126                             ; "-" has two jobs: directly before a digit it starts a negative number.
E126   20 2E E5     H_SUB:    JSR   isdig   
E129   90 0F                  BCC   negnum   
E12B   20 08 E1     SUB1:     JSR   neg   ; a - b = a + (-b)
E12E   18                     CLC      
