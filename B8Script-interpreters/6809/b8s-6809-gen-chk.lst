F2D5   33 42                  LEAU   2,U   
F2D7   37 06                  PULU   D   
F2D9   E7 84                  STB   ,X   
F2DB   39                     RTS      
F2DC                             ; "#" prints TOS as a signed decimal number, with no space after it.
F2DC   6D C4        H_NUM:    TST   ,U   
