0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Intel 8080
0000                             ;  Spec: docs/b8script.md (2026-10-09) plus the 2026-11-20 changes:
0000                             ;        [x stores in a variable, "[ " pushes an anonymous block, any other
0000                             ;        character after [ is an error, the heap pointer lives at z10+.
0000                             ;        The string escape is "/" (it was ">").
0000                             ;  A port of the Z80 interpreter (z80/b8s-z80.asm); same behaviour, same
0000                             ;  memory map, same switches.
0000                             ; 
0000                             ;  Two switches, set in the two EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    CHECKED  0 = no checks (spec: "B8Script checks nothing")
0000                             ;             1 = stops on stack overrun, Ctrl-C, heap past the limit, a store
0000                             ;                 outside the program's own space, and a bad character after [,
0000                             ;                 printing a letter and the place, like  S @ 245
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), I8080 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   1   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   1   ; 1 = checked build
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the 8080"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  The return stack pointer has no register (the 8080 has no spare pair): it
0000                             ;  is the RAM word RSP. Only rpush and rpop (and the checks) touch it; both
0000                             ;  destroy HL, so each caller makes sure TOS is parked or dead first.
0000                             ; 
0000                             ;  (asm80 wants the vector number: RST 1 = RST 08h, RST 2 = RST 10h.)
0000                             ;  A handler ends with RST 10h ("next character") or RST 08h ("drop, then
0000                             ;  next"), one byte each instead of a three-byte JMP. An RST is a CALL, so the
0000                             ;  first thing each stub does is POP D to throw the return address away.
0000                             ; 
0000                             ;  What the 8080 lacks, and what replaces it: no JR (JMP/Jcc), no DJNZ, no
0000                             ;  SBC HL (byte-wise SUB/SBB, or negate and DAD), no shifts on register pairs
0000                             ;  (DAD H doubles; RAL/RAR through A), no LDIR/CPIR (small loops).
0000                             ; -----------------------------------------------------------------------------
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (SP stays inside this page)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch (= z10+), interpreter variables in the gaps, and the -n?
0000                             ;             line buffer at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range LETPAGE..heap top.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
0000                BDOS:     EQU   0005h   
0000                          ENDIF      
0000                          IFN   CPM   
                                 ; ---- generic machine: edit these to suit -----------------------------------
                    KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
                                 ;   waiting. The zero flag must match A
                                 ;   (end the routine with ORA A / RET).
                    CONOUT:   EQU   0FF03h   ; print the character in A
                    EXIT:     EQU   0FF09h   ; where to go when the program ends
                                 ;   KEY and CONOUT must preserve BC, DE and HL.
                    RSPAGE:   EQU   80h   ; 8000h return stack
                    DSPAGE:   EQU   81h   ; 8100h data stack
                    LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
                    PROG:     EQU   8300h   ; where the loader puts the program text
                    HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms; tune it
0000                             ; for your clock and your KEY routine
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; z10+, the heap pointer
0000                RSP:      EQU   LET+34h   ; gap after Z: the return stack pointer;
0000                KEYBUF:   EQU   LET+36h   ;   a held-back key;
0000                HLIM:     EQU   LET+3Ah   ;   high byte of the heap limit
0000                LBHDR:    EQU   LET+7Eh   ; CP/M BDOS 10 header: max, count
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FEh   ; empty data stack
0000                             ; =============================================================================
0000                             ;  Page zero (generic ROM) or the start of the .COM file (CP/M)
0000                             ; =============================================================================
0000                          IF   CPM   
0100                          .ORG   0100h   
0100   C3 CF 04               JMP   start   
0103                          ENDIF      
0103                          IFN   CPM   
                              .ORG   0000h   
                              LXI   SP,DSTOP   ; 0000h reset: the stack first,
                              JMP   start   ;   then the rest of the startup
                    H_SWAP:   XTHL      ; 0006h the two-byte handlers fill the gaps
                              RST   2   ;   between the vectors
                                 ; ---- RST 08h: drop TOS, then next ------------------------------------------
                              POP   D   ; 0008h discard the RST's return address
                    DROP_NEXT:      
                              POP   H   ; new TOS = NOS
                              JMP   next0   
                    H_DUP:    PUSH   H   ; 000Dh
                              RST   2   
                              DB   0   ; 000Fh spare
                                 ; ---- RST 10h: next character ------------------------------------------------
                              POP   D   ; 0010h discard the RST's return address
0103                          ENDIF      
0103                             ; =============================================================================
0103                             ;  The inner loop: read one character and sort it by range.
0103                             ; 
0103                             ;    00h          end of program
0103                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0103                             ;    30h-39h      digit: read a whole number
0103                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0103                             ;    61h-7Ah      a-z: push the address of that letter's cell
0103                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0103                             ; =============================================================================
0103                NEXT0:       
0103                          IF   CHECKED   
0103                             ; Both stacks are checked once per character, not in every handler.
0103                             ; Each stack lives in one page, so it has overrun exactly when the
0103                             ; pointer's high byte has left that page. Errors are caught one cell
0103                             ; late at most; the page below each stack is a guard band.
0103   EB                     XCHG      ; DE = TOS (HL is needed for the pointers)
0104   21 00 00               LXI   H,0   
0107   39                     DAD   SP   
0108   7C                     MOV   A,H   
0109   FE 07                  CPI   DSPAGE   
010B   C2 9F 04               JNZ   e_stack   
010E   2A 34 08               LHLD   RSP   ; the return stack: in its page, and not
0111   7D                     MOV   A,L   ;   above its empty position (an underflow
0112   FE E1                  CPI   RSTOP&0FFh+1   ;   would stay inside the page, in the
0114   D2 A2 04               JNC   e_rstack   ;   guard band)
0117   7C                     MOV   A,H   
0118   FE 06                  CPI   RSPAGE   
011A   C2 A2 04               JNZ   e_rstack   
011D   EB                     XCHG      ; TOS back
011E                          ENDIF      
011E   0A                     LDAX   B   
011F   03                     INX   B   
0120   D6 21                  SUI   21h   ; A = c - 21h
0122   DA 65 01               JC   ctl   ; c < 21h: NUL ends, the rest are ignored
0125   FE 0F                  CPI   0Fh   
0127   DA 58 01               JC   punct   ; 21h-2Fh: PTAB index 0-14
012A   D6 0F                  SUI   0Fh   ; A = c - 30h
012C   FE 0A                  CPI   0Ah   
012E   DA 82 01               JC   digit   ; 30h-39h
0131   FE 11                  CPI   11h   
0133   D2 3B 01               JNC   ab40   
0136   C6 05                  ADI   5   ; 3Ah-40h: index 15-21
0138   C3 58 01               JMP   punct   
013B   D6 11        AB40:     SUI   11h   ; A = c - 41h
013D   FE 1A                  CPI   1Ah   
013F   DA 73 01               JC   upper   ; 41h-5Ah: A = letter index 0-25
0142   FE 20                  CPI   20h   
0144   D2 4C 01               JNC   ab60   
0147   D6 04                  SUI   4   ; 5Bh-60h: index 22-27
0149   C3 58 01               JMP   punct   
014C   FE 3A        AB60:     CPI   3Ah   
014E   DA 6D 01               JC   lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0151   FE 3E                  CPI   3Eh   
0153   D2 03 01               JNC   next0   ; 7Fh-FFh: ignored
0156   D6 1E                  SUI   1Eh   ; 7Bh-7Eh: index 28-31
0158                             ; Punctuation: HL holds TOS, so it is parked on the stack while the table is
0158                             ; read, then swapped for the handler's address: XTHL puts TOS back in HL and
0158                             ; leaves the address on the stack for RET to jump to. The stack is balanced
0158                             ; again when the handler starts. PTAB never crosses a page (checked in the
0158                             ; listing), so only L needs adding.
0158   E5           PUNCT:    PUSH   H   
0159   87                     ADD   A   
015A   C6 88                  ADI   PTAB & 0FFh   
015C   6F                     MOV   L,A   
015D   26 01                  MVI   H,PTAB / 256   
015F   7E                     MOV   A,M   
0160   23                     INX   H   
0161   66                     MOV   H,M   
0162   6F                     MOV   L,A   ; HL = handler
0163   E3                     XTHL      
0164   C9                     RET      
0165   C6 21        CTL:      ADI   21h   ; back to c; zero only for NUL
0167   C2 03 01               JNZ   next0   
016A                          IF   CPM   
016A   C3 00 00               JMP   endprog   
016D                          ENDIF      
016D                          IFN   CPM   
                    ENDPROG:      
                              JMP   EXIT   ; the program has ended
016D                          ENDIF      
016D                             ; a-z: push the cell's address (the cell is the variable)
016D   E5           LOWER:    PUSH   H   
016E   87                     ADD   A   
016F   6F                     MOV   L,A   
0170   26 08                  MVI   H,LETPAGE   
0172   D7                     RST   2   
0173                             ; A-Z: call the word. The return address (the IP after the letter) goes on
0173                             ; the return stack, and the IP becomes the address in the letter's cell.
0173   E5           UPPER:    PUSH   H   ; keep TOS
0174   87                     ADD   A   
0175   6F                     MOV   L,A   
0176   26 08                  MVI   H,LETPAGE   ; HL -> cell
0178   50                     MOV   D,B   
0179   59                     MOV   E,C   ; DE = return address
017A   4E                     MOV   C,M   
017B   23                     INX   H   
017C   46                     MOV   B,M   ; IP = the word's body
017D   CD DF 01               CALL   rpush   
0180   E1                     POP   H   ; TOS back
0181   D7                     RST   2   
0182                             ; Digits: step back onto the first digit and read the whole number.
0182   E5           DIGIT:    PUSH   H   
0183   0B                     DCX   B   
0184   CD C8 01               CALL   rdnum   
0187   D7                     RST   2   
0188                             ; =============================================================================
0188                             ;  Dispatch table: one handler per punctuation character, in code order.
0188                             ;  It sits right after the inner loop so that it can't cross a page (the
0188                             ;  loop only adds to the low byte of its address).
0188                             ; =============================================================================
0188   C2 02        PTAB:     DW   h_store   ; !
018A   9B 03                  DW   h_str   ; "
018C   C3 03                  DW   h_num   ; #
018E   A2 03                  DW   h_print   ; $
0190   B1 02                  DW   h_swap   ; %
0192   77 02                  DW   h_and   ; &
0194   BE 03                  DW   h_emit   ; '
0196   FD 02                  DW   h_open   ; (
0198   0D 03                  DW   h_close   ; )
019A   16 02                  DW   h_mul   ; *
019C   F6 01                  DW   h_add   ; +
019E   CC 02                  DW   h_cfetch   ; ,
01A0   F9 01                  DW   h_sub   ; -
01A2   D0 02                  DW   h_cstore   ; .
01A4   32 02                  DW   h_div   ; /
01A6   0D 00                  DW   h_dup   ; :
01A8   09 00                  DW   drop_next   ; ;
01AA   95 02                  DW   h_lt   ; <
01AC   A4 02                  DW   h_eq   ; =
01AE   94 02                  DW   h_gt   ; >
01B0   E9 03                  DW   h_key   ; ?
01B2   BD 02                  DW   h_fetch   ; @
01B4   3B 03                  DW   h_def   ; [
01B6   21 03                  DW   h_break   ; \
01B8   30 03                  DW   h_ret   ; ]
01BA   87 02                  DW   h_xor   ; ^
01BC   D6 02                  DW   h_alloc   ; _
01BE   2D 04                  DW   h_grave   ; `
01C0   B3 02                  DW   h_tor   ; {
01C2   7F 02                  DW   h_or   ; |
01C4   B8 02                  DW   h_fromr   ; }
01C6   8F 02                  DW   h_not   ; ~
01C8                PTABEND:      
01C8                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
01C8                             ; non-digit. Values wrap at 16 bits, as the spec says.
01C8   21 00 00     RDNUM:    LXI   H,0   
01CB   0A           RDN1:     LDAX   B   
01CC   D6 30                  SUI   "0"   
01CE   FE 0A                  CPI   10   
01D0   D0                     RNC      
01D1   03                     INX   B   
01D2   54                     MOV   D,H   
01D3   5D                     MOV   E,L   
01D4   29                     DAD   H   
01D5   29                     DAD   H   
01D6   19                     DAD   D   
01D7   29                     DAD   H   ; HL * 10
01D8   5F                     MOV   E,A   
01D9   16 00                  MVI   D,0   
01DB   19                     DAD   D   
01DC   C3 CB 01               JMP   rdn1   
01DF                             ; =============================================================================
01DF                             ;  Return stack. rpush pushes DE; rpop pops into HL. RSP is the pointer (a RAM
01DF                             ;  word, growing down). Both destroy HL; rpush also keeps DE, rpop clobbers DE.
01DF                             ; =============================================================================
01DF   2A 34 08     RPUSH:    LHLD   RSP   
01E2   2B                     DCX   H   
01E3   72                     MOV   M,D   
01E4   2B                     DCX   H   
01E5   73                     MOV   M,E   
01E6   22 34 08               SHLD   RSP   
01E9   C9                     RET      
01EA   2A 34 08     RPOP:     LHLD   RSP   
01ED   5E                     MOV   E,M   
01EE   23                     INX   H   
01EF   56                     MOV   D,M   
01F0   23                     INX   H   
01F1   22 34 08               SHLD   RSP   
01F4   EB                     XCHG      
01F5   C9                     RET      
01F6                             ; =============================================================================
01F6                             ;  Arithmetic and logic. Effects are ( NOS TOS -- result ).
01F6                             ; =============================================================================
01F6   D1           H_ADD:    POP   D   
01F7   19                     DAD   D   
01F8   D7                     RST   2   
01F9                             ; "-" has two jobs: directly before a digit it starts a negative number.
01F9                             ; Otherwise a - b is a + (-b): neg16 and DAD are shorter than a byte-wise SUB/SBB.
01F9   0A           H_SUB:    LDAX   B   
01FA   D6 30                  SUI   "0"   
01FC   FE 0A                  CPI   10   
01FE   DA 07 02               JC   negnum   
0201   D1                     POP   D   
0202   CD 0F 02               CALL   neg16   
0205   19                     DAD   D   
0206   D7                     RST   2   
0207   E5           NEGNUM:   PUSH   H   
0208   CD C8 01               CALL   rdnum   
020B   CD 0F 02               CALL   neg16   
020E   D7                     RST   2   
020F                             ; neg16: HL = -HL (keeps BC, DE)
020F   AF           NEG16:    XRA   A   
0210   95                     SUB   L   
0211   6F                     MOV   L,A   
0212   9F                     SBB   A   
0213   94                     SUB   H   
0214   67                     MOV   H,A   
0215   C9                     RET      
0216                             ; "*": shift-and-add on the multiplier's low bit, so it stops as soon as the
0216                             ; multiplier is used up; only the low 16 bits are kept.
0216   D1           H_MUL:    POP   D   ; DE = multiplicand
0217   C5                     PUSH   B   
0218   44                     MOV   B,H   
0219   4D                     MOV   C,L   ; BC = multiplier
021A   21 00 00               LXI   H,0   
021D   78           MUL1:     MOV   A,B   
021E   B7                     ORA   A   ; clear carry
021F   1F                     RAR      
0220   47                     MOV   B,A   
0221   79                     MOV   A,C   
0222   1F                     RAR      
0223   4F                     MOV   C,A   ; BC >> 1, carry = the bit shifted out
0224   D2 28 02               JNC   mul2   
0227   19                     DAD   D   
0228   EB           MUL2:     XCHG      
0229   29                     DAD   H   ; multiplicand << 1
022A   EB                     XCHG      
022B   78                     MOV   A,B   
022C   B1                     ORA   C   
022D   C2 1D 02               JNZ   mul1   
0230   C1                     POP   B   
0231   D7                     RST   2   
0232                             ; "/" ( a b -- r q ): the quotient is on top. Truncates toward zero; r takes
0232                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
0232                             ; of a. Dividing by zero is not checked: it returns two cells of no meaning.
0232   D1           H_DIV:    POP   D   ; DE = a, HL = b
0233   C5                     PUSH   B   
0234   7A                     MOV   A,D   
0235   B7                     ORA   A   
0236   F5                     PUSH   PSW   ; S flag = sign of a (for r)
0237   AC                     XRA   H   
0238   F5                     PUSH   PSW   ; S flag = sign of q
0239   7C                     MOV   A,H   
023A   B7                     ORA   A   
023B   FC 0F 02               CM   neg16   ; HL = |b|
023E   EB                     XCHG      
023F   7C                     MOV   A,H   
0240   B7                     ORA   A   
0241   FC 0F 02               CM   neg16   ; HL = |a|, DE = |b|
0244   CD 56 02               CALL   udiv   ; HL = q, BC = r
0247   F1                     POP   PSW   
0248   FC 0F 02               CM   neg16   ; q's sign
024B   EB                     XCHG      ; DE = q
024C   60                     MOV   H,B   
024D   69                     MOV   L,C   ; HL = r
024E   F1                     POP   PSW   
024F   FC 0F 02               CM   neg16   ; r's sign
0252   C1                     POP   B   
0253   E5                     PUSH   H   ; r under q
0254   EB                     XCHG      ; HL = q
0255   D7                     RST   2   
0256                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, BC = remainder.
0256                             ; Uses A, BC; the caller saves the IP. HL holds the dividend and, as its bits
0256                             ; leave at the top, the quotient bits arrive at the bottom. The loop counter
0256                             ; lives on the stack, since A is busy with the shifts.
0256   01 00 00     UDIV:     LXI   B,0   
0259   3E 10                  MVI   A,16   
025B   F5                     PUSH   PSW   
025C   29           UDV1:     DAD   H   ; next dividend bit into the carry
025D   79                     MOV   A,C   
025E   17                     RAL      
025F   4F                     MOV   C,A   
0260   78                     MOV   A,B   
0261   17                     RAL      
0262   47                     MOV   B,A   ; BC = BC*2 + bit
0263   79                     MOV   A,C   
0264   93                     SUB   E   
0265   78                     MOV   A,B   
0266   9A                     SBB   D   ; carry if BC < DE
0267   DA 6F 02               JC   udv2   
026A   47                     MOV   B,A   ; BC - DE (high byte; A holds it)
026B   79                     MOV   A,C   
026C   93                     SUB   E   
026D   4F                     MOV   C,A   
026E   2C                     INR   L   ; quotient bit
026F   F1           UDV2:     POP   PSW   
0270   3D                     DCR   A   
0271   F5                     PUSH   PSW   
0272   C2 5C 02               JNZ   udv1   
0275   F1                     POP   PSW   
0276   C9                     RET      
0277   D1           H_AND:    POP   D   
0278   7C                     MOV   A,H   
0279   A2                     ANA   D   
027A   67                     MOV   H,A   
027B   7D                     MOV   A,L   
027C   A3                     ANA   E   
027D   6F                     MOV   L,A   
027E   D7                     RST   2   
027F   D1           H_OR:     POP   D   
0280   7C                     MOV   A,H   
0281   B2                     ORA   D   
0282   67                     MOV   H,A   
0283   7D                     MOV   A,L   
0284   B3                     ORA   E   
0285   6F                     MOV   L,A   
0286   D7                     RST   2   
0287   D1           H_XOR:    POP   D   
0288   7C                     MOV   A,H   
0289   AA                     XRA   D   
028A   67                     MOV   H,A   
028B   7D                     MOV   A,L   
028C   AB                     XRA   E   
028D   6F                     MOV   L,A   
028E   D7                     RST   2   
028F                             ; ~x is -x - 1: shorter than complementing both bytes.
028F   CD 0F 02     H_NOT:    CALL   neg16   
0292   2B                     DCX   H   
0293   D7                     RST   2   
0294                             ; Signed compares. Both are "DE < HL" for the right pair: > swaps the two
0294                             ; cells first (XTHL), < doesn't. There is no overflow flag, so the signed
0294                             ; answer is the unsigned borrow of DE - HL, flipped when the signs differ.
0294                             ; SBB A turns a carry into -1 or 0 with no branch.
0294   E3           H_GT:     XTHL      ; a > b  is  b < a
0295   D1           H_LT:     POP   D   ; a < b: DE = a, HL = b
0296   7B                     MOV   A,E   
0297   95                     SUB   L   
0298   7A                     MOV   A,D   
0299   9C                     SBB   H   
029A   9F                     SBB   A   ; A = -1 if DE < HL unsigned
029B   6F                     MOV   L,A   
029C   7C                     MOV   A,H   
029D   AA                     XRA   D   
029E   17                     RAL      ; carry = the signs differ
029F   9F                     SBB   A   
02A0   AD                     XRA   L   ; flip when they do
02A1   67                     MOV   H,A   
02A2   6F                     MOV   L,A   
02A3   D7                     RST   2   
02A4   D1           H_EQ:     POP   D   
02A5   7D                     MOV   A,L   
02A6   AB                     XRA   E   
02A7   6F                     MOV   L,A   
02A8   7C                     MOV   A,H   
02A9   AA                     XRA   D   
02AA   B5                     ORA   L   ; zero if equal
02AB   D6 01                  SUI   1   ; carry only for zero
02AD   9F                     SBB   A   
02AE   67                     MOV   H,A   
02AF   6F                     MOV   L,A   
02B0   D7                     RST   2   
02B1                             ; =============================================================================
02B1                             ;  Stack
02B1                             ; =============================================================================
02B1                          IF   CPM   
02B1   E3           H_SWAP:   XTHL      
02B2   D7                     RST   2   
02B3                          ENDIF      
02B3   EB           H_TOR:    XCHG      ; "{" TOS to the return stack
02B4   CD DF 01               CALL   rpush   
02B7   CF                     RST   1   
02B8   E5           H_FROMR:   PUSH   H   ; "}" return stack to TOS
02B9   CD EA 01               CALL   rpop   
02BC   D7                     RST   2   
02BD                             ; =============================================================================
02BD                             ;  Storage
02BD                             ; =============================================================================
02BD   5E           H_FETCH:   MOV   E,M   ; "@"
02BE   23                     INX   H   
02BF   56                     MOV   D,M   
02C0   EB                     XCHG      
02C1   D7                     RST   2   
02C2   D1           H_STORE:   POP   D   ; "!" ( n addr -- )
02C3                          IF   CHECKED   
02C3   23                     INX   H   ; both bytes must be in the program's space
02C4   CD EC 02               CALL   chkst   
02C7   2B                     DCX   H   
02C8                          ENDIF      
02C8   73                     MOV   M,E   
02C9   23                     INX   H   
02CA   72                     MOV   M,D   
02CB   CF                     RST   1   
02CC   6E           H_CFETCH:   MOV   L,M   ; ","
02CD   26 00                  MVI   H,0   
02CF   D7                     RST   2   
02D0   D1           H_CSTORE:   POP   D   ; "." ( c addr -- )
02D1                          IF   CHECKED   
02D1   CD EC 02               CALL   chkst   
02D4                          ENDIF      
02D4   73                     MOV   M,E   
02D5   CF                     RST   1   
02D6                             ; "_" ( n -- addr ): the heap pointer moves up by n; TOS is the old pointer.
02D6   EB           H_ALLOC:   XCHG      
02D7   2A 7C 08               LHLD   HEAP   
02DA   E5                     PUSH   H   
02DB   19                     DAD   D   
02DC                          IF   CHECKED   
02DC   DA A8 04               JC   e_heap   ; a negative count wraps: too big
02DF   3A 3A 08               LDA   HLIM   
02E2   3D                     DCR   A   
02E3   BC                     CMP   H   
02E4   DA A8 04               JC   e_heap   ; the new top must stay below the limit page
02E7                          ENDIF      
02E7   22 7C 08               SHLD   HEAP   
02EA   E1                     POP   H   
02EB   D7                     RST   2   
02EC                          IF   CHECKED   
02EC                             ; chkst: stop unless HL is in the program's own space: from the letter page
02EC                             ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
02EC                             ; whatever lies above the limit are safe. Memory above the heap top but
02EC                             ; below the limit is the program's own: Tiny BASIC keeps its lines there.
02EC                             ; Keeps every register.
02EC   F5           CHKST:    PUSH   PSW   
02ED   7C                     MOV   A,H   
02EE   FE 08                  CPI   LETPAGE   
02F0   DA F8 02               JC   chk1   
02F3   3A 3A 08               LDA   HLIM   
02F6   3D                     DCR   A   
02F7   BC                     CMP   H   
02F8   DA AB 04     CHK1:     JC   e_store   
02FB   F1                     POP   PSW   
02FC   C9                     RET      
02FD                          ENDIF      
02FD                             ; =============================================================================
02FD                             ;  Flow control
02FD                             ; =============================================================================
02FD                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
02FD                             ; the matching ")".
02FD   7C           H_OPEN:   MOV   A,H   
02FE   B5                     ORA   L   
02FF   CA 08 03               JZ   op_f   
0302   50                     MOV   D,B   
0303   59                     MOV   E,C   
0304   CD DF 01               CALL   rpush   ; (HL, the flag, is dead here)
0307   CF                     RST   1   ; = POP H, RST 2: the flag is dead, so drop it
0308   E1           OP_F:     POP   H   
0309   CD 62 03     SKIPNX:   CALL   skip   
030C   D7                     RST   2   
030D                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
030D                             ; drops it and carries on.
030D   7C           H_CLOSE:   MOV   A,H   
030E   B5                     ORA   L   
030F   CA 1D 03               JZ   rdrop   
0312                          IF   CHECKED   
0312   CD 8D 04               CALL   chkbrk   ; Ctrl-C is checked at every loop-back
0315                          ENDIF      
0315   2A 34 08               LHLD   RSP   ; peek the block start
0318   4E                     MOV   C,M   
0319   23                     INX   H   
031A   46                     MOV   B,M   
031B   E1                     POP   H   
031C   D7                     RST   2   
031D   CD EA 01     RDROP:    CALL   rpop   ; (HL, the flag, is dead: NOS is next)
0320   CF                     RST   1   
0321                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
0321                             ; drops the block start, "]" returns. No closer at all ends the program.
0321   7C           H_BREAK:   MOV   A,H   
0322   B5                     ORA   L   
0323   C2 27 03               JNZ   brk1   
0326   CF                     RST   1   
0327   CD 62 03     BRK1:     CALL   skip   
032A   FE 29                  CPI   ")"   
032C   CA 1D 03               JZ   rdrop   
032F   E1                     POP   H   ; and fall into "]"
0330                             ; "]" returns: pop an address and jump to it.
0330   E5           H_RET:    PUSH   H   
0331   CD EA 01               CALL   rpop   
0334   44                     MOV   B,H   
0335   4D                     MOV   C,L   
0336   E1                     POP   H   
0337                          IF   CHECKED   
0337   CD 8D 04               CALL   chkbrk   ; ... and at every word return
033A                          ENDIF      
033A   D7                     RST   2   
033B                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
033B                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
033B                             ; the body"s address instead. Either way it then skips to the matching "]'.
033B   0A           H_DEF:    LDAX   B   
033C   03                     INX   B   
033D   5F                     MOV   E,A   
033E   E6 DF                  ANI   0DFh   ; fold case
0340   D6 41                  SUI   "A"   
0342   FE 1A                  CPI   26   
0344   D2 56 03               JNC   def2   ; not a letter
0347   7B                     MOV   A,E   
0348   D6 41                  SUI   "A"   ; 0-25 or 32-57: lowercase lands 64 bytes up
034A   87                     ADD   A   
034B   5F                     MOV   E,A   
034C   16 08                  MVI   D,LETPAGE   ; DE -> cell
034E   79                     MOV   A,C   
034F   12                     STAX   D   
0350   1C                     INR   E   
0351   78                     MOV   A,B   
0352   12                     STAX   D   
0353   C3 09 03               JMP   skipnx   
0356                DEF2:        
0356                          IF   CHECKED   
0356   7B                     MOV   A,E   
0357   FE 20                  CPI   " "   
0359   C2 AE 04               JNZ   e_brack   ; anything but a letter or a space
035C                          ENDIF      
035C   E5                     PUSH   H   ; an anonymous block: push its address
035D   60                     MOV   H,B   
035E   69                     MOV   L,C   
035F   C3 09 03               JMP   skipnx   
0362                             ; skip: read past text to the closer at this level, and return it in A.
0362                             ; Brackets of both kinds count together; strings are stepped over whole. A
0362                             ; NUL first ends the program (for "\" with no closer; anything else that runs
0362                             ; into the NUL had unbalanced brackets anyway). D counts the open levels,
0362                             ; starting at 1 for the one we are in.
0362   16 01        SKIP:     MVI   D,1   
0364   0A           SK1:      LDAX   B   
0365   03                     INX   B   
0366   B7                     ORA   A   
0367   CA 00 00               JZ   endprog   
036A   FE 22                  CPI   22h   
036C   CC 8E 03               CZ   skipstr   ; leaves A = 22h, which matches nothing below
036F   FE 28                  CPI   "("   
0371   CA 88 03               JZ   sk3   
0374   FE 5B                  CPI   "["   
0376   CA 88 03               JZ   sk3   
0379   FE 29                  CPI   ")"   
037B   CA 83 03               JZ   sk4   
037E   FE 5D                  CPI   "]"   
0380   C2 64 03               JNZ   sk1   
0383   15           SK4:      DCR   D   
0384   C8                     RZ      ; the closer at this level
0385   C3 64 03               JMP   sk1   
0388   14           SK3:      INR   D   ; an opener: one deeper (the DCR below makes
0389   14                     INR   D   ;   it +1 net, and can't reach zero)
038A   C3 83 03               JMP   sk4   
038D                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
038D                             ; the next character, so "/"" does not end it.
038D   03           SS0:      INX   B   
038E   0A           SKIPSTR:   LDAX   B   
038F   03                     INX   B   
0390   FE 2F                  CPI   "/"   
0392   CA 8D 03               JZ   ss0   
0395   FE 22                  CPI   22h   
0397   C2 8E 03               JNZ   skipstr   
039A   C9                     RET      
039B                             ; =============================================================================
039B                             ;  Console
039B                             ; =============================================================================
039B                             ; 22h pushes the address of the text after it and skips the string.
039B   E5           H_STR:    PUSH   H   
039C   60                     MOV   H,B   
039D   69                     MOV   L,C   
039E   CD 8E 03               CALL   skipstr   
03A1   D7                     RST   2   
03A2                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
03A2                             ; 40h-7Fh clears its bit 6 (/M is CR, /` is space); plus anything lower gives
03A2                             ; that character itself.
03A2   7E           H_PRINT:   MOV   A,M   
03A3   23                     INX   H   
03A4   FE 22                  CPI   22h   
03A6   CA BD 03               JZ   prdone   
03A9   FE 2F                  CPI   "/"   
03AB   C2 B7 03               JNZ   pr1   
03AE   7E                     MOV   A,M   
03AF   23                     INX   H   
03B0   FE 40                  CPI   40h   
03B2   DA B7 03               JC   pr1   
03B5   E6 BF                  ANI   0BFh   
03B7   CD 7F 04     PR1:      CALL   putc   
03BA   C3 A2 03               JMP   h_print   
03BD   CF           PRDONE:   RST   1   
03BE   7D           H_EMIT:   MOV   A,L   ; "'"
03BF   CD 7F 04               CALL   putc   
03C2   CF                     RST   1   
03C3                             ; "#" prints TOS as a signed decimal number, with no space after it.
03C3   7C           H_NUM:    MOV   A,H   
03C4   B7                     ORA   A   
03C5   F2 D0 03               JP   num1   
03C8   3E 2D                  MVI   A,"-"   
03CA   CD 7F 04               CALL   putc   
03CD   CD 0F 02               CALL   neg16   
03D0   C5           NUM1:     PUSH   B   
03D1   CD D6 03               CALL   pdec   
03D4   C1                     POP   B   
03D5   CF                     RST   1   
03D6                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits)
03D6   11 0A 00     PDEC:     LXI   D,10   
03D9   CD 56 02               CALL   udiv   ; HL = HL / 10, BC = digit
03DC   79                     MOV   A,C   
03DD   F5                     PUSH   PSW   
03DE   7C                     MOV   A,H   
03DF   B5                     ORA   L   
03E0   C4 D6 03               CNZ   pdec   
03E3   F1                     POP   PSW   
03E4   C6 30                  ADI   "0"   
03E6   C3 7F 04               JMP   putc   
03E9                             ; "?" ( n -- c ) or ( -n -- addr )
03E9                             ;   n > 0: wait about n ms for a key; 0 if none came
03E9                             ;   n = 0: wait for a key
03E9                             ;   n < 0: read a line of at most -n characters, with echo. n is not
03E9                             ;          checked: the buffer holds 127 characters and the CR, so a
03E9                             ;          program must ask for 127 or fewer.
03E9   7C           H_KEY:    MOV   A,H   
03EA   B7                     ORA   A   
03EB   FA 12 04               JM   line   
03EE   B5                     ORA   L   
03EF   C2 FC 03               JNZ   kt1   
03F2   CD 6F 04     KW:       CALL   getk   ; 0?: wait
03F5   CA F2 03               JZ   kw   
03F8   6F           KT3:      MOV   L,A   
03F9   26 00                  MVI   H,0   
03FB   D7                     RST   2   
03FC   11 28 00     KT1:      LXI   D,MSLOOP   ; one millisecond, roughly
03FF   CD 6F 04     KT2:      CALL   getk   
0402   C2 F8 03               JNZ   kt3   
0405   1B                     DCX   D   
0406   7A                     MOV   A,D   
0407   B3                     ORA   E   
0408   C2 FF 03               JNZ   kt2   
040B   2B                     DCX   H   
040C   7C                     MOV   A,H   
040D   B5                     ORA   L   
040E   C2 FC 03               JNZ   kt1   
0411   D7                     RST   2   ; time ran out: HL is already 0
0412                          IF   CPM   
0412                             ; CP/M: BDOS 10 does the editing (the spec allows the platform's
0412                             ; own line editor). It doesn't store the CR, so it is added here.
0412   AF           LINE:     XRA   A   
0413   95                     SUB   L   ; A = the count (TOS is minus the count)
0414   32 7E 08               STA   LBHDR   
0417   C5                     PUSH   B   
0418   11 7E 08               LXI   D,LBHDR   
041B   0E 0A                  MVI   C,10   
041D   CD 05 00               CALL   BDOS   
0420   C1                     POP   B   
0421   21 7F 08               LXI   H,LBHDR+1   
0424   7E                     MOV   A,M   ; count (0-127)
0425   23                     INX   H   ; HL = LINEBUF, whose low byte is 80h:
0426   E5                     PUSH   H   
0427   85                     ADD   L   ;   adding the count to L can't carry
0428   6F                     MOV   L,A   
0429   36 0D                  MVI   M,13   
042B   E1                     POP   H   
042C   D7                     RST   2   
042D                          ENDIF      
042D                          IFN   CPM   
                                 ; Generic: Backspace takes the last character back (and is echoed as
                                 ; it is), CR ends (stored, not echoed), every other key is stored and
                                 ; echoed until the line is full. The line buffer starts at offset 80h
                                 ; of its page, so L alone is the place in the line: D holds the L of
                                 ; a full line.
                    LINE:     MVI   A,LINEBUF & 0FFh   
                              SUB   L   ; (TOS is minus the count)
                              MOV   D,A   ; D = the L of a full line
                              LXI   H,LINEBUF   
                    LN2:      CALL   getk   
                              JZ   ln2   
                              CPI   13   
                              JZ   ln5   
                              CPI   8   
                              JZ   ln4   
                              MOV   E,A   
                              MOV   A,L   
                              CMP   D   
                              JZ   ln2   ; full
                              MOV   M,E   
                              INR   L   
                              MOV   A,E   
                    LN3:      CALL   putc   
                              JMP   ln2   
                    LN4:      DCR   L   ; Backspace: one back, and echo it,
                              JM   ln3   ;   unless the line was empty (L left the
                              INR   L   ;   upper half of the page)
                              JMP   ln2   
                    LN5:      MOV   M,A   ; the CR
                              MVI   L,LINEBUF & 0FFh   
                              RST   2   
042D                          ENDIF      
042D                             ; =============================================================================
042D                             ;  Machine code: the grave
042D                             ; =============================================================================
042D                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
042D                             ; are stored from addr until a non-hex character; then a RET (C9h) is
042D                             ; written and its address is left. An odd last digit is consumed and dropped.
042D                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
042D                             ; code is entered by CALL with the data stack above the return address; it
042D                             ; must keep BC, and on return the top cell becomes the new TOS.
042D   0A           H_GRAVE:   LDAX   B   
042E   CD 5E 04               CALL   hexval   
0431   DA 58 04               JC   exec   
0434   0A           HX1:      LDAX   B   
0435   CD 5E 04               CALL   hexval   
0438   DA 52 04               JC   hx2   
043B   03                     INX   B   
043C   87                     ADD   A   
043D   87                     ADD   A   
043E   87                     ADD   A   
043F   87                     ADD   A   
0440   57                     MOV   D,A   
0441   0A                     LDAX   B   
0442   CD 5E 04               CALL   hexval   
0445   DA 52 04               JC   hx2   ; odd digit: already consumed, dropped
0448   03                     INX   B   
0449   B2                     ORA   D   
044A                          IF   CHECKED   
044A   CD EC 02               CALL   chkst   
044D                          ENDIF      
044D   77                     MOV   M,A   
044E   23                     INX   H   
044F   C3 34 04               JMP   hx1   
0452                HX2:         
0452                          IF   CHECKED   
0452   CD EC 02               CALL   chkst   
0455                          ENDIF      
0455   36 C9                  MVI   M,0C9h   
0457   D7                     RST   2   
0458   CD 5D 04     EXEC:     CALL   exjmp   ; the code returns here, with its top cell on
045B   E1                     POP   H   ;   the stack: that becomes the new TOS
045C   D7                     RST   2   
045D   E9           EXJMP:    PCHL      
045E                             ; hexval: A = a character; returns its value 0-15 with carry clear, or
045E                             ; carry set if it isn't a hex digit (0-9, A-F, a-f).
045E   D6 30        HEXVAL:   SUI   "0"   
0460   FE 0A                  CPI   10   
0462   3F                     CMC      
0463   D0                     RNC      
0464   E6 DF                  ANI   0DFh   
0466   D6 11                  SUI   11h   
0468   FE 06                  CPI   6   
046A   3F                     CMC      
046B   D8                     RC      
046C   C6 0A                  ADI   10   
046E   C9                     RET      
046F                             ; =============================================================================
046F                             ;  Console layer: getk returns a waiting key in A (zero flag clear), or
046F                             ;  A = 0 with the zero flag set when none is waiting. putc prints A.
046F                             ;  Both keep BC, DE and HL. In the generic build they are the host's KEY and
046F                             ;  CONOUT routines themselves.
046F                             ; =============================================================================
046F                          IF   (1-CPM)*(1-CHECKED)   
                    GETK:     EQU   KEY   ; the host's routine does the whole job
046F                          ENDIF      
046F                          IF   CHECKED   
046F   3A 36 08     GETK:     LDA   KEYBUF   ; a key held back by the break check
0472   B7                     ORA   A   
0473   CA 7D 04               JZ   gk1   
0476   F5                     PUSH   PSW   
0477   AF                     XRA   A   
0478   32 36 08               STA   KEYBUF   
047B   F1                     POP   PSW   
047C   C9                     RET      
047D                          ENDIF      
047D                          IF   (1-CPM)*CHECKED   
                    GK1:      EQU   KEY   
047D                          ENDIF      
047D                          IF   CPM*(1-CHECKED)   
                    GETK:        
047D                          ENDIF      
047D                          IF   CPM   
047D   3E FF        GK1:      MVI   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
047F                             ; (putc ends with ORA A, for the zero flag)
047F                             ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
047F                             ; printing and could swallow a key that BDOS 6 then never sees.
047F   C5           PUTC:     PUSH   B   
0480   D5                     PUSH   D   
0481   E5                     PUSH   H   
0482   5F                     MOV   E,A   
0483   0E 06                  MVI   C,6   
0485   CD 05 00               CALL   BDOS   
0488   E1                     POP   H   
0489   D1                     POP   D   
048A   C1                     POP   B   
048B   B7                     ORA   A   
048C   C9                     RET      
048D                          ENDIF      
048D                          IFN   CPM   
                    PUTC:     EQU   CONOUT   
048D                          ENDIF      
048D                             ; =============================================================================
048D                             ;  Checked build: break key and error reports
048D                             ; =============================================================================
048D                          IF   CHECKED   
048D                             ; chkbrk: a waiting key is read now; Ctrl-C stops the program, anything
048D                             ; else is held for the next "?".
048D   3A 36 08     CHKBRK:   LDA   KEYBUF   
0490   B7                     ORA   A   
0491   C0                     RNZ      ; one key is already held
0492   CD 6F 04               CALL   getk   
0495   C8                     RZ      
0496   FE 03                  CPI   3   
0498   CA A5 04               JZ   e_break   
049B   32 36 08               STA   KEYBUF   
049E   C9                     RET      
049F                             ; Error entries. Each loads its letter and then hides the next entry inside
049F                             ; a 3-byte LXI H (the 21h), so they all fall through to `error`.
049F   3E 53        E_STACK:   MVI   A,"S"   ; data stack over or under
04A1   21                     DB   21h   
04A2   3E 52        E_RSTACK:   MVI   A,"R"   ; return stack over or under
04A4   21                     DB   21h   
04A5   3E 42        E_BREAK:   MVI   A,"B"   ; Ctrl-C
04A7   21                     DB   21h   
04A8   3E 48        E_HEAP:   MVI   A,"H"   ; heap past the limit
04AA   21                     DB   21h   
04AB   3E 57        E_STORE:   MVI   A,"W"   ; write outside the program's space
04AD   21                     DB   21h   
04AE   3E 44        E_BRACK:   MVI   A,"D"   ; bad character after [
04B0                             ; error: print the letter in A, " @ " and the offset in the program of the
04B0                             ; character just read, then end. For example: S @ 245
04B0   31 FE 07     ERROR:    LXI   SP,DSTOP   ; the stacks may be wrecked: start clean
04B3   CD 7F 04               CALL   putc   
04B6   3E 20                  MVI   A," "   
04B8   CD 7F 04               CALL   putc   
04BB   3E 40                  MVI   A,"@"   
04BD   CD 7F 04               CALL   putc   
04C0   3E 20                  MVI   A," "   
04C2   CD 7F 04               CALL   putc   
04C5   21 FF F6               LXI   H,(0-PROG-1)&0FFFFh   
04C8   09                     DAD   B   ; IP - (PROG+1): the character just read
04C9   CD D6 03               CALL   pdec   
04CC   C3 00 00               JMP   endprog   
04CF                          ENDIF      
04CF                             ; =============================================================================
04CF                             ;  Startup
04CF                             ; =============================================================================
04CF                START:       
04CF                          IF   CPM   
04CF   31 FE 07               LXI   SP,DSTOP   
04D2                             ; CP/M: the RAM pages follow the image; the heap may grow to the BDOS
04D2   21 24 05               LXI   H,stubs   ; RST 08h and RST 10h stubs into page zero
04D5   11 08 00               LXI   D,0008h   
04D8   06 0C                  MVI   B,12   
04DA   7E           CPY:      MOV   A,M   
04DB   12                     STAX   D   
04DC   23                     INX   H   
04DD   13                     INX   D   
04DE   05                     DCR   B   
04DF   C2 DA 04               JNZ   cpy   
04E2   11 5C 00               LXI   D,005Ch   ; open the file named on the command line
04E5   0E 0F                  MVI   C,15   ; (no such file: the first read fails too,
04E7   CD 05 00               CALL   BDOS   ;   and the program is empty)
04EA   11 00 09               LXI   D,PROG   
04ED   D5           LD1:      PUSH   D   
04EE   0E 1A                  MVI   C,26   ; set the DMA address
04F0   CD 05 00               CALL   BDOS   
04F3   11 5C 00               LXI   D,005Ch   
04F6   0E 14                  MVI   C,20   ; read the next 128 bytes
04F8   CD 05 00               CALL   BDOS   
04FB   E1                     POP   H   ; HL = the address this record went to
04FC   B7                     ORA   A   
04FD   C2 08 05               JNZ   ld2   
0500   11 80 00               LXI   D,128   
0503   19                     DAD   D   
0504   EB                     XCHG      
0505   C3 ED 04               JMP   ld1   
0508   36 00        LD2:      MVI   M,0   ; the end of the file counts as NUL
050A   23                     INX   H   
050B   22 7C 08               SHLD   HEAP   
050E   3A 07 00               LDA   0007h   ; the BDOS page is the heap limit
0511   32 3A 08               STA   HLIM   
0514                          ENDIF      
0514                          IFN   CPM   
                              LXI   H,PROG   ; the heap starts after the program's NUL
                    FNUL:     MOV   A,M   
                              INX   H   
                              ORA   A   
