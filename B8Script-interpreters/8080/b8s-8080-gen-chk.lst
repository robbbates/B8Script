0309   11 0A 00     PDEC:     LXI   D,10   
030C   CD 8B 01               CALL   udiv   ; HL = HL / 10, BC = digit
030F   79                     MOV   A,C   
0310   F5                     PUSH   PSW   
0311   7C                     MOV   A,H   
0312   B5                     ORA   L   
0313   C4 09 03               CNZ   pdec   
0316   F1                     POP   PSW   
0317   C6 30                  ADI   "0"   
0319   C3 03 FF               JMP   putc   
031C                             ; "?" ( n -- c ) or ( -n -- addr )
031C                             ;   n > 0: wait about n ms for a key; 0 if none came
031C                             ;   n = 0: wait for a key
031C                             ;   n < 0: read a line of at most -n characters (capped at CAP) with echo
031C   7C           H_KEY:    MOV   A,H   
