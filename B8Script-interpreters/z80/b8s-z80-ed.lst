0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Spec: docs/b8script.md (2026-11-24).
0000                             ; 
0000                             ;  Four switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    EDITOR   1 = with the line editor built in (see the end of this file):
0000                             ;                 the spec's suggested standard. It goes with either setting
0000                             ;                 of the other two.
0000                             ;    CHECKED  0 = no checks (spec: the programmer is responsible)
0000                             ;             1 = starts with every variable at 0 and every word undefined,
0000                             ;                 and stops on every error in the spec's table (and Ctrl-C)
0000                             ;                 with a four-line report: the letter and the place as line
0000                             ;                 and column, the text there, and both stacks. See `error`.
0000                             ;    ANSI     what the console escapes of "$" (/00bbIC8= /| /` /~) do:
0000                             ;             1 = send ANSI (VT100) sequences through CONOUT
0000                             ;             0 = call the machine's own routines CONCLS, CONEOL, CONCUR and
0000                             ;                 CONAT (see the equates). The CP/M builds always send ANSI.
0000                             ; 
0000                             ;  In every build Ctrl-C stops a running program (an unchecked build stops
0000                             ;  without a word): see the console layer for the rules, the held key and
0000                             ;  the break-off cell.
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   0   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   0   ; 1 = checked build
0000                EDITOR:   EQU   1   ; 1 = with the line editor
0000                ANSI:     EQU   0   ; 1 = the console escapes send ANSI sequences
0000                ANS:      EQU   ANSI+CPM-ANSI*CPM   ; (CP/M: always ANSI)
0000                PRSUB:    EQU   CHECKED   ; (1: "$" is the routine prstr)
0000                EDGEN:    EQU   EDITOR*(1-CPM)   ; (the generic build with the editor)
0000                             ; (IF takes any value but 0 as true, so
0000                             ;  IF CHECKED+EDITOR means "either")
0000                TABP0:    EQU   EDGEN*(1-CHECKED)   ; (the build with its table in page zero)
0000                PTLATE:   EQU   1-CPM*EDITOR*(1-CHECKED)   ; (1: the table goes after psgn and pdec,
0000                             ;   not before them: wherever it doesn't cross a
0000                             ;   page. chktab.py says if it does)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    HL'  return-stack pointer (the alternate HL). Entries are 2 bytes; the
0000                             ;         stack grows down. Only rpop and rpushn (and the checks) touch it.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  One-byte calls. The routines used most are reached with RST, one byte
0000                             ;  instead of three:
0000                             ; 
0000                             ;    RST 08h  rpop    pop the return stack into DE
0000                             ;    RST 18h  drop    drop TOS, then next character     (ends a handler)
0000                             ;    RST 20h  neg16   HL = -HL
0000                             ;    RST 28h  putc    print A
0000                             ;    RST 30h  next    next character                    (ends a handler)
0000                             ; 
0000                             ;  RST 18h and RST 30h never return: an RST is a CALL, so the first thing
0000                             ;  each of them does is POP DE to throw the return address away.
0000                             ; 
0000                             ;  The CP/M build can't own page zero, so the block from `vecs` to `vecend`
0000                             ;  (image addresses 0108h-0133h) is copied to 0008h-0033h when it starts. The
0000                             ;  code in that block is written to work at either place.
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (the top four bytes of the page are spare,
0000                             ;             so a full stack runs two bytes into the page below)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch, interpreter variables in the gaps, and the -n? line buffer
0000                             ;             at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack has a guard band: the data stack can
0000                             ;  overrun by a cell or two (and the calls made while it is full, the error
0000                             ;  report's included) into the top 32 bytes of the return-stack page, which
0000                             ;  are never used, and the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
                    BDOS:     EQU   0005h   
                    BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IF   CPM*(1-EDITOR)   
                    EXIT:     EQU   0000h   ; warm boot
0000                          ENDIF      
0000                          IFN   CPM   
0000                             ; ---- generic machine: edit these to suit -----------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The zero flag must match A
0000                             ;   (end the routine with OR A / RET).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                             ;   KEY and CONOUT must preserve BC, DE, HL and HL'.
0000                          ENDIF      
0000                          IF   1-ANS   
0000                             ; With ANSI = 0 the console escapes call these. All four must keep BC and
0000                             ; HL'; CONCLS, CONEOL and CONCUR also DE and HL.
0000                CONCLS:   EQU   0FF0Ch   ; /{  clear the screen, the cursor to the top left
0000                CONEOL:   EQU   0FF0Fh   ; /}  clear from the cursor to the end of the line
0000                CONCUR:   EQU   0FF12h   ; /| and /`  show the cursor if A is not 0, hide
0000                             ;     it if A = 0
0000                CONAT:    EQU   0FF15h   ; /~  the cursor to row HL, column DE, both
0000                             ;     counted from 0. May change A, DE and HL
0000                          ENDIF      
0000                          IFN   CPM   
0000                RSPAGE:   EQU   80h   ; 8000h return stack
0000                DSPAGE:   EQU   81h   ; 8100h data stack
0000                LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
0000                PROG:     EQU   8300h   ; where the loader puts the program text
0000                HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
0000                BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)   
                    EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                          ENDIF      
0000                          IF   EDGEN   
0000                LEAVE:    EQU   0FF09h   ; where the editor's ^X goes
0000                          ENDIF      
0000                          IF   EDITOR*CPM   
                    LEAVE:    EQU   0000h   ; the editor's ^X: warm boot
0000                          ENDIF      
0000                          IF   EDITOR   
0000                EXIT:     EQU   edend   ; a program that ends goes back to the editor,
0000                SKEND:    EQU   skend   ;   also when it ends inside skip
0000                          ENDIF      
0000                          IF   1-EDITOR   
                    SKEND:    EQU   EXIT   
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine. (The wait
0000                             ; for a second Ctrl-C uses it too: 250 ms.)
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                             ;   around machine code (and in the checked
0000                             ;   build the address "$" prints from);
0000                NPEND:    EQU   LET+38h   ;   minus the address of the program's end
0000                             ;   (the heap"s first byte), for the checked "_';
0000                EDLN:     EQU   LET+3Ah   ;   the editor: the number of the line that ^E
0000                             ;   put in the input line (0: none)
0000                KEYBUF:   EQU   LET+7Ah   ; gap after z: a key read by the break check and
0000                             ;   held for the next "?" (0: none);
0000                BRKOFF:   EQU   LET+7Bh   ;   the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FCh   ; empty data stack. The four bytes above it
0000                             ; are spare: a character can pop two cells
0000                             ; too many before the checked build sees it,
0000                             ; and the next call must not land on the
0000                             ; letter cells.
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is the start of the .COM file, and 0108h-0133h is also copied to
0000                             ;  page zero (see the header).
0000                             ; =============================================================================
0000                          .ORG   BASE   
0000                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              XOR   A   ; 00  reset. (This byte, AFh, is also what an
0000                          ENDIF      ;     undefined word runs into: see e_hi.)
0000                          IF   1-EDGEN   
                              LD   SP,DSTOP   ; 00  reset, or the start of the .COM file
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)   
                              LD   BC,PROG   ; 03  the IP
                              JR   st0   ; 06  (the rest of the startup is close by)
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              JR   init   ; 04  (the rest of the startup is close by)
                              DW   0   ; 06  spare
0000                          ENDIF      
0000                          IF   EDGEN   
0000   AF                     XOR   A   ; 00  reset: no program yet. (This byte, AFh,
0001   32 00 83               LD   (PROG),A   ;     is also what an undefined word runs
0004   C3 24 03               JP   init   ; 04  into in the checked build: see e_hi.)
0007   00                     NOP      ; 07  spare
0008                          ENDIF      
0008                          IF   CPM   
                              JP   start   ; 03
                              DW   0   ; 06  spare
0008                          ENDIF      
0008                VECS:        
0008                             ; ---- RST 08h: rpop: pop the return stack into DE ---------------------------
0008   D9           RPOP:     EXX      ; 08
0009   5E                     LD   E,(HL)   
000A   23                     INC   HL   
000B   56                     LD   D,(HL)   
000C   23                     INC   HL   
000D   D5                     PUSH   DE   ; across to the main registers
000E   D9                     EXX      
000F   D1                     POP   DE   
0010   C9                     RET      ; 10  (so RST 10h is not used)
0011                             ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
0011   C6 21        CTL:      ADD   A,21h   ; 11  back to c; zero only for NUL
0013   20 1C                  JR   NZ,next0   ;     the rest are ignored
0015   C3 61 03     ENDPROG:   JP   EXIT   ;     the program has ended
0018                             ; ---- RST 18h: drop TOS, then next ------------------------------------------
0018   D1           RST18:    POP   DE   ; 18  discard the RST's return address
0019   E1                     POP   HL   ;     new TOS = NOS
001A   18 15                  JR   nx   
001C   E5           H_FROMR:   PUSH   HL   ; 1C  "}" return stack to TOS
001D   CF                     RST   08h   
001E   EB                     EX   DE,HL   
001F   F7                     RST   30h   
0020                             ; ---- RST 20h: neg16: HL = -HL (keeps BC, DE) -------------------------------
0020   AF           NEG16:    XOR   A   ; 20
0021   95                     SUB   L   
0022   6F                     LD   L,A   
0023   9F                     SBC   A,A   
0024   94                     SUB   H   
0025   67                     LD   H,A   
0026   C9                     RET      
0027   00                     NOP      ; 27  spare
0028                             ; ---- RST 28h: putc: print A (keeps BC, DE, HL, HL') ------------------------
0028                RST28:       
0028                          IFN   CPM   
0028   C3 03 FF     PUTC:     JP   CONOUT   ; 28
002B                          ENDIF      
002B                          IF   CPM   
                              JP   putc   ; 28
002B                          ENDIF      
002B   E9           JPHL:     JP   (HL)   ; 2B  (for the machine-code call)
002C   E3           H_TOR:    EX   (SP),HL   ; 2C  "{" TOS to the return stack: the new TOS
002D   C3 CC 00               JP   rpushn   ;     comes up, the old one goes across
0030                             ; ---- RST 30h: next character -----------------------------------------------
0030   D1           RST30:    POP   DE   ; 30  discard the RST's return address
0031                NX:          
0031                          IF   CPM   
                              JP   next0   ; (this copy runs in page zero)
0031                          ENDIF      
0031                VECEND:      
0031                             ; =============================================================================
0031                             ;  The inner loop: read one character and sort it by range.
0031                             ; 
0031                             ;    00h          end of program
0031                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0031                             ;    30h-39h      digit: read a whole number
0031                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0031                             ;    61h-7Ah      a-z: push the address of that letter's cell
0031                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0031                             ; =============================================================================
0031                NEXT0:       
0031                          IF   CHECKED   
                              CALL   chkstk   ; both stacks are checked once per character
0031                          ENDIF      
0031   0A                     LD   A,(BC)   
0032   03                     INC   BC   
0033   D6 21                  SUB   21h   ; A = c - 21h
0035   38 DA                  JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
0037   FE 0F                  CP   0Fh   
0039   38 22                  JR   C,punct   ; 21h-2Fh: PTAB index 0-14
003B   D6 0F                  SUB   0Fh   ; A = c - 30h
003D   FE 0A                  CP   0Ah   
003F   38 75                  JR   C,digit   ; 30h-39h
0041   FE 11                  CP   11h   
0043   38 16                  JR   C,p3a   ; 3Ah-40h
0045   D6 11                  SUB   11h   ; A = c - 41h
0047   FE 1A                  CP   1Ah   
0049   38 77                  JR   C,upper   ; 41h-5Ah: A = letter index 0-25
004B   FE 20                  CP   20h   
004D   38 0A                  JR   C,p5b   ; 5Bh-60h
004F   FE 3A                  CP   3Ah   
0051   38 69                  JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0053   FE 3E                  CP   3Eh   
0055                          IF   1-CHECKED   
0055   30 DA                  JR   NC,next0   ; 7Fh-FFh: ignored
0057                          ENDIF      
0057                          IF   CHECKED   
                              JR   Z,next0   ; 7Fh, DEL: ignored
                              JP   NC,e_hi   ; 80h-FFh: reserved
0057                          ENDIF      
0057   D6 1A                  SUB   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
0059   D6 09        P5B:      SUB   9   ; 5Bh-60h: -4 in all, index 22-27
005B   C6 05        P3A:      ADD   A,5   ; 3Ah-40h: index 15-21
005D                .macro PTABLE,
005D                             ; 
005D                 DB      h_store & 0FFh  ; !
005D                 DB      h_str & 0FFh    ; "
005D                 DB      h_num & 0FFh    ; #
005D                 DB      h_print & 0FFh  ; $
005D                 DB      h_swap & 0FFh   ; %
005D                 DB      h_and & 0FFh    ; &
005D                 DB      h_emit & 0FFh   ; '
005D                 DB      h_open & 0FFh   ; (
005D                 DB      h_close & 0FFh  ; )
005D                 DB      h_mul & 0FFh    ; *
005D                 DB      h_add & 0FFh    ; +
005D                 DB      h_cfetch & 0FFh ; ,
005D                 DB      h_sub & 0FFh    ; -
005D                 DB      h_cstore & 0FFh ; .
005D                 DB      h_div & 0FFh    ; /
005D                 DB      h_dup & 0FFh    ; :
005D                 DB      h_drop & 0FFh   ; ;
005D                 DB      h_lt & 0FFh     ; <
005D                 DB      h_eq & 0FFh     ; =
005D                 DB      h_gt & 0FFh     ; >
005D                 DB      h_key & 0FFh    ; ?
005D                 DB      h_fetch & 0FFh  ; @
005D                 DB      h_def & 0FFh    ; [
005D                 DB      h_break & 0FFh  ; \
005D                 DB      h_ret & 0FFh    ; ]
005D                 DB      h_xor & 0FFh    ; ^
005D                 DB      h_alloc & 0FFh  ; _
005D                 DB      h_grave & 0FFh  ; `
005D                 DB      h_tor & 0FFh    ; {
005D                 DB      h_or & 0FFh     ; |
005D                 DB      h_fromr & 0FFh  ; }
005D                 DB      h_not & 0FFh    ; ~
005D                .endm
005D                 
005D                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
005D                             ; untouched, and A, DE free.
005D   C6 6A        PUNCT:    ADD   A,PTAB & 0FFh   ; PTAB never crosses a page
005F   5F                     LD   E,A   
0060   16 00                  LD   D,PTAB / 256   ; (0 if the table is in page zero)
0062   FE 80                  CP   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
0064   1A                     LD   A,(DE)   
0065   5F                     LD   E,A   ; the handler's low byte
0066                          IF   (1-CPM)*(1-TABP0)   
                              LD   D,0   
0066                          ENDIF      
0066                          IFN   CPM   
0066   CB 12                  RL   D   ; its page: 0 + carry
0068                          ENDIF      
0068                          IF   CPM   
                              LD   D,1   
                              JR   NC,pu1   
                              INC   D   ; its page: 1 + carry
                    PU1:         
0068                          ENDIF      
0068   D5                     PUSH   DE   ; jump to it; the stack is balanced again
0069   C9                     RET      ;   when the handler starts
006A                             ; The rest of the startup: here so that the generic reset code can reach it
006A                             ; with JR. st0: find the program's NUL; the heap starts after it.
006A                             ; (The editor build has its own copy of this, next to the editor.)
006A                             ; A checked build first clears the lower half of the letter page (A = 0):
006A                             ; every variable starts at 0, every word cell holds 0000h, the address an
006A                             ; undefined word is caught at (see e_hi), and no key is held back.
006A                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                    INIT:     LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
                              LD   BC,PROG   ; the IP
006A                          ENDIF      
006A                          IF   (1-CPM)*(1-EDITOR)   
                    ST0:      LD   H,B   
                              LD   L,C   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
006A                          ENDIF      
006A                          IF   1-EDITOR   
                    ST2:      LD   (HEAP),HL   
006A                          ENDIF      
006A                          IF   CHECKED*(1-EDITOR)   
                              RST   20h   ; minus the heap"s first address: "_' may not
                              LD   (NPEND),HL   ;   release below it
006A                          ENDIF      
006A                          IF   (1-CHECKED)*(1-EDITOR)*(1-CPM)   
                              LD   H,A   ; (A = 0) no key is held, and the break key
                              LD   L,A   ;   is on (the checked build has cleared
006A                          ENDIF      ;   these)
006A                          IF   (1-CHECKED)*(1-EDITOR)*CPM   
                              LD   HL,0   
006A                          ENDIF      
006A                          IF   (1-CHECKED)*(1-EDITOR)   
                              LD   (KEYBUF),HL   
006A                          ENDIF      
006A                          IF   1-EDITOR   
                              EXX      
                              LD   HL,RSTOP   ; the return stack is empty
                              EXX      
                              RST   30h   ; (its return address is thrown away)
006A                          ENDIF      
006A                             ; In the unchecked generic editor build the table is here, in the first
006A                             ; page, which saves loading D twice. (The other builds have no room for it
006A                             ; here: theirs is further down.)
006A                          IF   TABP0   
006A                PTAB:        
006A                          ;*Macro unroll:  PTABLE
006A   A0                     DB   h_store & 0FFh   
006B   A5                     DB   h_str & 0FFh   
006C   C8                     DB   h_num & 0FFh   
006D   AC                     DB   h_print & 0FFh   
006E   9B                     DB   h_swap & 0FFh   
006F   45                     DB   h_and & 0FFh   
0070   C5                     DB   h_emit & 0FFh   
0071   21                     DB   h_open & 0FFh   
0072   29                     DB   h_close & 0FFh   
0073   66                     DB   h_mul & 0FFh   
0074   3C                     DB   h_add & 0FFh   
0075   E4                     DB   h_cfetch & 0FFh   
0076   34                     DB   h_sub & 0FFh   
0077   9D                     DB   h_cstore & 0FFh   
0078   7A                     DB   h_div & 0FFh   
0079   99                     DB   h_dup & 0FFh   
007A   9F                     DB   h_drop & 0FFh   
007B   4D                     DB   h_lt & 0FFh   
007C   5C                     DB   h_eq & 0FFh   
007D   4E                     DB   h_gt & 0FFh   
007E   CC                     DB   h_key & 0FFh   
007F   1C                     DB   h_fetch & 0FFh   
0080   FF                     DB   h_def & 0FFh   
0081   F2                     DB   h_break & 0FFh   
0082   EE                     DB   h_ret & 0FFh   
0083   8A                     DB   h_xor & 0FFh   
0084   9D                     DB   h_alloc & 0FFh   
0085   D8                     DB   h_grave & 0FFh   
0086   2C                     DB   h_tor & 0FFh   
0087   92                     DB   h_or & 0FFh   
0088   1C                     DB   h_fromr & 0FFh   
0089   9A                     DB   h_not & 0FFh   
008A                PTABEND:      
008A                          ENDIF      
008A                             ; =============================================================================
008A                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
008A                             ;  (00bbIGFuZCA= are up among the RST routines.) The machine-code call, exec,
008A                             ;  is here too: it belongs to "`" and makes the page come out right.
008A                             ; =============================================================================
008A   D1           H_XOR:    POP   DE   
008B   7C                     LD   A,H   
008C   AA                     XOR   D   
008D   67                     LD   H,A   
008E   7D                     LD   A,L   
008F   AB                     XOR   E   
0090   6F                     LD   L,A   
0091   F7                     RST   30h   
0092   D1           H_OR:     POP   DE   
0093   7C                     LD   A,H   
0094   B2                     OR   D   
0095   67                     LD   H,A   
0096   7D                     LD   A,L   
0097   B3                     OR   E   
0098   6F                     LD   L,A   
0099   F7                     RST   30h   
009A   E7           H_NOT:    RST   20h   ; ~x = -x - 1
009B   2B                     DEC   HL   
009C   F7                     RST   30h   
009D                             ; "_" ( n -- addr ): the heap pointer moves by n, a signed count (the add is
009D                             ; the same either way); TOS is the old pointer.
009D   ED 5B 7C 82  H_ALLOC:   LD   DE,(HEAP)   
00A1                          IF   CHECKED*CPM   
                              LD   A,H   ; the count's sign, for chkhp
00A1                          ENDIF      
00A1   19                     ADD   HL,DE   ; the new top
00A2                          IF   CHECKED   
                              CALL   chkhp   
00A2                          ENDIF      
00A2   22 7C 82               LD   (HEAP),HL   
00A5   EB                     EX   DE,HL   
00A6   F7                     RST   30h   
00A7   D9           EXEC:     EXX      
00A8   22 34 82               LD   (RSAVE),HL   ; machine code may change the alternates
00AB   D9                     EXX      
00AC   CD 2B 00               CALL   jphl   
00AF   D9                     EXX      
00B0   2A 34 82               LD   HL,(RSAVE)   
00B3   D9                     EXX      
00B4   E1                     POP   HL   
00B5   F7                     RST   30h   
00B6                             ; ---- the letters and digits (here, in the middle, so that the inner loop's
00B6                             ; ---- short jumps reach them, and the handlers after them reach rpushn) ------
00B6                             ; Digits: step back onto the first digit and read the whole number.
00B6   E5           DIGIT:    PUSH   HL   
00B7   0B                     DEC   BC   
00B8   CD 77 02               CALL   rdnum   
00BB   F7                     RST   30h   
00BC                             ; a-z: push the cell's address (the cell is the variable)
00BC   E5           LOWER:    PUSH   HL   
00BD   87                     ADD   A,A   
00BE   6F                     LD   L,A   
00BF   26 82                  LD   H,LETPAGE   
00C1   F7                     RST   30h   
00C2                             ; A-Z: call the word. The return address (the IP after the letter) goes on
00C2                             ; the return stack, and the IP becomes the address in the letter's cell.
00C2   C5           UPPER:    PUSH   BC   ; the return address, for rpushn
00C3   EB                     EX   DE,HL   ; park TOS
00C4   87                     ADD   A,A   
00C5   6F                     LD   L,A   
00C6   26 82                  LD   H,LETPAGE   ; HL -> cell
00C8   4E                     LD   C,(HL)   
00C9   2C                     INC   L   
00CA   46                     LD   B,(HL)   ; IP = the word's body
00CB   EB                     EX   DE,HL   ; TOS back, and fall into rpushn
00CC                             ; rpushn: move the top cell of the data stack (in memory) to the return
00CC                             ; stack, then next. Everything that pushes the return stack ends here.
00CC                             ; 
00CC                             ; The break key is looked at here, so at every word call and loop-back (and
00CC                             ; block entry and "{"), but only one time in 256: B', which nothing else
00CC                             ; uses, counts them. Reading the keyboard can be slow (it is a BDOS call
00CC                             ; under CP/M), and this way it costs a loop four bytes and 14 T-states.
00CC                             ; (DEC B, not DJNZ: its zero flag lasts through the EXX, so one EXX serves
00CC                             ; both ways out.)
00CC   D9           RPUSHN:   EXX      
00CD   D1                     POP   DE   
00CE   2B                     DEC   HL   
00CF   72                     LD   (HL),D   
00D0   2B                     DEC   HL   
00D1   73                     LD   (HL),E   
00D2   05                     DEC   B   
00D3   D9                     EXX      
00D4   CC E6 02               CALL   Z,pollk   
00D7   F7                     RST   30h   
00D8                             ; ---- machine code: the grave -----------------------------------------------
00D8                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
00D8                             ; are stored from addr until a non-hex character; then a RET (C9h) is
00D8                             ; written and its address is left. An odd last digit is consumed and dropped.
00D8                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
00D8                             ; code is entered by CALL with the data stack above the return address; it
00D8                             ; must keep BC, and on return the top cell becomes the new TOS.
00D8   CD BA 02     H_GRAVE:   CALL   hexc   
00DB   30 CA                  JR   NC,exec   
00DD   77           HX1:      LD   (HL),A   ; the high digit goes in first ...
00DE   CD BA 02               CALL   hexc   
00E1   30 08                  JR   NC,hx2   ; odd digit: consumed, and the RET below
00E3   ED 6F                  RLD      ;   overwrites it
00E5   23                     INC   HL   ; ... and RLD shifts it up under the low one
00E6   CD BA 02               CALL   hexc   
00E9   38 F2                  JR   C,hx1   
00EB   36 C9        HX2:      LD   (HL),0C9h   ; (never range-checked: the spec says so)
00ED   F7                     RST   30h   
00EE                             ; ---- where the two pages meet ----------------------------------------------
00EE                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
00EE                             ; are in falling code order for this), and where exactly differs between the
00EE                             ; builds: NPG1 follows. Every handler below these four must start in the
00EE                             ; second page, and every one above in the first; chktab.py checks both.
00EE                             ; "]" returns: pop an address and jump to it.
00EE   CF           H_RET:    RST   08h   
00EF   42                     LD   B,D   
00F0   4B                     LD   C,E   
00F1   F7           BRK1:     RST   30h   
00F2                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
00F2                             ; drops the block start, "]" returns. No closer at all ends the program.
00F2   7C           H_BREAK:   LD   A,H   
00F3   B5                     OR   L   
00F4   E1                     POP   HL   
00F5   28 FA                  JR   Z,brk1   
00F7   CD 99 02               CALL   skip   
00FA   B7                     OR   A   ; skip returns 0 for ")"
00FB   20 F1                  JR   NZ,h_ret   
00FD   CF           RDROP:    RST   08h   
00FE   F7                     RST   30h   
00FF                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
00FF                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
00FF                             ; the body"s address instead. Either way it then skips to the matching "]'.
00FF                             ; (The unchecked build takes anything that is not a letter as the space; the
00FF                             ; checked build stops on it.)
00FF   0A           H_DEF:    LD   A,(BC)   
0100   03                     INC   BC   
0101   D6 41                  SUB   "A"   ; a letter gives 0-25 or 32-57: lowercase
0103   5F                     LD   E,A   ;   lands 64 bytes up
0104   E6 DF                  AND   0DFh   ; fold case
0106   FE 1A                  CP   26   
0108   30 0B                  JR   NC,def2   ; not a letter
010A   CB 23                  SLA   E   
010C   16 82                  LD   D,LETPAGE   ; DE -> cell
010E   79                     LD   A,C   
010F   12                     LD   (DE),A   
0110   1C                     INC   E   
0111   78                     LD   A,B   
0112   12                     LD   (DE),A   
0113   18 03                  JR   skipnx   
0115                DEF2:        
0115                          IF   CHECKED   
                              LD   A,E   
                              CP   " "-"A"+256   
                              JP   NZ,e_brack   ; anything but a letter or a space
0115                          ENDIF      
0115   E5                     PUSH   HL   ; an anonymous block: push its address
0116   60                     LD   H,B   
0117   69                     LD   L,C   
0118                SKIPNX:      
0118                          IF   CHECKED   
                              DEC   BC   ; back onto the letter, so that skip finds its
0118                          ENDIF      ;   opener, the "[", just before where it starts
0118   CD 99 02     SKIPO:    CALL   skip   
011B   F7                     RST   30h   
011C   5E           H_FETCH:   LD   E,(HL)   ; "@"
011D   23                     INC   HL   
011E   56                     LD   D,(HL)   
011F   EB                     EX   DE,HL   
0120   F7                     RST   30h   
0121                             ; =============================================================================
0121                             ;  Handlers that must start in the image's second page.
0121                             ;  "?" is the last (with "," inside it), so its long tail may run past that
0121                             ;  page.
0121                             ; =============================================================================
0121                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
0121                             ; the matching ")".
0121   7C           H_OPEN:   LD   A,H   
0122   B5                     OR   L   
0123   E1                     POP   HL   
0124   28 F2                  JR   Z,skipo   
0126   C5                     PUSH   BC   ; the block starts at the IP
0127   18 A3                  JR   rpushn   
0129                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
0129                             ; drops it and carries on.
0129   7C           H_CLOSE:   LD   A,H   
012A   B5                     OR   L   
012B   E1                     POP   HL   
012C   28 CF                  JR   Z,rdrop   
012E   CF                     RST   08h   ; pop the block start ...
012F   42                     LD   B,D   
0130   4B                     LD   C,E   
0131   C5                     PUSH   BC   
0132   18 98                  JR   rpushn   ; ... and push it back
0134                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
0134                             ; "-" has two jobs: directly before a digit it starts a negative number.
0134   0A           H_SUB:    LD   A,(BC)   
0135   D6 30                  SUB   "0"   
0137   FE 0A                  CP   10   
0139   38 04                  JR   C,negnum   
013B   E7                     RST   20h   ; a - b = a + (-b): fall into "+"
013C   D1           H_ADD:    POP   DE   
013D   19                     ADD   HL,DE   
013E   F7                     RST   30h   
013F   E5           NEGNUM:   PUSH   HL   ; a negative number: read it, negate it
0140   CD 77 02               CALL   rdnum   
0143   E7                     RST   20h   
0144   F7                     RST   30h   
0145   D1           H_AND:    POP   DE   
0146   7C                     LD   A,H   
0147   A2                     AND   D   
0148   67                     LD   H,A   
0149   7D                     LD   A,L   
014A   A3                     AND   E   
014B   6F                     LD   L,A   
014C   F7                     RST   30h   
014D                             ; Signed compares. Both are "HL < DE" for the right pair: "<" swaps the two
014D                             ; cells first. Flipping both sign bits turns a signed compare into an
014D                             ; unsigned one (and XOR clears the carry for SBC); SBC HL,HL then turns the
014D                             ; carry into -1 or 0 with no branch.
014D   E3           H_LT:     EX   (SP),HL   ; a < b: HL = a, and b is popped next
014E   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
014F   7C                     LD   A,H   
0150   EE 80                  XOR   80h   
0152   67                     LD   H,A   
0153   7A                     LD   A,D   
0154   EE 80                  XOR   80h   
0156   57                     LD   D,A   
0157   ED 52                  SBC   HL,DE   ; carry if HL < DE
0159   ED 62        TF:       SBC   HL,HL   ; carry -> -1 or 0
015B   F7                     RST   30h   
015C   D1           H_EQ:     POP   DE   
015D   B7                     OR   A   
015E   ED 52                  SBC   HL,DE   
0160   7C                     LD   A,H   
0161   B5                     OR   L   
0162   FE 01                  CP   1   ; carry only if a - b = 0
0164   18 F3                  JR   tf   
0166                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept. The
0166                             ; multiplier shifts up through A:C.
0166   D1           H_MUL:    POP   DE   ; DE = multiplicand
0167   C5                     PUSH   BC   
0168   7C                     LD   A,H   
0169   4D                     LD   C,L   ; A:C = multiplier
016A   21 00 00               LD   HL,0   
016D   06 10                  LD   B,16   
016F   29           MUL1:     ADD   HL,HL   
0170   CB 21                  SLA   C   
0172   17                     RLA      
0173   30 01                  JR   NC,mul2   
0175   19                     ADD   HL,DE   
0176   10 F7        MUL2:     DJNZ   mul1   
0178   C1                     POP   BC   
0179   F7                     RST   30h   
017A                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
017A                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
017A                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
017A                             ; stops on it.
017A                H_DIV:       
017A                          IF   CHECKED   
                              LD   A,H   
                              OR   L   
                              JP   Z,e_zero   
017A                          ENDIF      
017A   D1                     POP   DE   ; DE = a, HL = b
017B   D5                     PUSH   DE   ; a, for r's sign
017C   7A                     LD   A,D   
017D   AC                     XOR   H   
017E   F5                     PUSH   AF   ; S flag = sign of q
017F   CB 7C                  BIT   7,H   
0181   C4 20 00               CALL   NZ,neg16   ; HL = |b|
0184   EB                     EX   DE,HL   
0185   CB 7C                  BIT   7,H   
0187   C4 20 00               CALL   NZ,neg16   ; HL = |a|, DE = |b|
018A   CD 4F 02               CALL   udiv   ; HL = q, DE = r
018D   F1                     POP   AF   
018E   FC 20 00               CALL   M,neg16   ; q's sign
0191   EB                     EX   DE,HL   ; HL = r, DE = q
0192   F1                     POP   AF   ; A = a's high byte
0193   B7                     OR   A   
0194   FC 20 00               CALL   M,neg16   ; r's sign
0197   D5                     PUSH   DE   ; q under r
0198   F7                     RST   30h   
0199                             ; ---- stack and storage -----------------------------------------------------
0199   E5           H_DUP:    PUSH   HL   ; ":"
019A   F7                     RST   30h   
019B   E3           H_SWAP:   EX   (SP),HL   ; "%"
019C   F7                     RST   30h   
019D                             ; (The checked build tests the address before it takes the value off the
019D                             ; stack, so that an error report shows both.)
019D                H_CSTORE:      ; "." ( c addr -- )
019D                          IF   CHECKED   
                              CALL   chkst   
019D                          ENDIF      
019D   D1                     POP   DE   
019E   73                     LD   (HL),E   
019F   DF           H_DROP:   RST   18h   ; ";" is this one byte
01A0                H_STORE:      ; "!" ( n addr -- )
01A0                          IF   CHECKED   
                              CALL   chkst   
01A0                          ENDIF      
01A0   D1                     POP   DE   
01A1   73                     LD   (HL),E   
01A2   23                     INC   HL   
01A3   72                     LD   (HL),D   
01A4   DF                     RST   18h   
01A5                             ; ---- console ---------------------------------------------------------------
01A5                             ; 22h pushes the address of the text after it and skips the string.
01A5   E5           H_STR:    PUSH   HL   
01A6   60                     LD   H,B   
01A7   69                     LD   L,C   
01A8   CD 8E 02               CALL   skipstr   
01AB                          IF   CHECKED   
                              OR   A   ; 0: the text ran out before the closing quote
                              JP   Z,e_quote   
01AB                          ENDIF      
01AB   F7                     RST   30h   
01AC                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
01AC                             ; 60h to 7Eh is one of the escapes at pesc; "/" plus any other character
01AC                             ; clears that character"s bit 6 (/M is CR, /? is DEL"s "?"; "/" and """ have
01AC                             ; no bit 6, so // and /" give themselves).
01AC                          IF   1-PRSUB   
01AC   7E           H_PRINT:   LD   A,(HL)   
01AD   23                     INC   HL   
01AE   FE 22                  CP   22h   
01B0   28 15                  JR   Z,pr9   
01B2   FE 2F                  CP   "/"   
01B4   20 0C                  JR   NZ,pr1   
01B6   7E                     LD   A,(HL)   
01B7   23                     INC   HL   
01B8   FE 60                  CP   60h   
01BA   38 04                  JR   C,pr0   
01BC   FE 7F                  CP   7Fh   
01BE   38 57                  JR   C,pesc   
01C0   E6 BF        PR0:      AND   0BFh   
01C2   EF           PR1:      RST   28h   
01C3   18 E7                  JR   h_print   
01C5                PRLOOP:   EQU   h_print   ; (where the escapes go back to)
01C5                PRAGAIN:   EQU   h_print   ; (and where /~ goes back to)
01C5                          ENDIF      
01C5                          IF   CHECKED   
                                 ; (The checked build has the loop as a routine, prstr, which the error
                                 ; report uses too. The address is kept meanwhile, for a report: it shows
                                 ; the stack as it was before the "$". /~ comes back to hp1.)
                    H_PRINT:   LD   (RSAVE),HL   
                    HP1:      CALL   prstr   
                              RST   18h   
01C5                          ENDIF      
01C5   7D           H_EMIT:   LD   A,L   ; "'"
01C6   EF                     RST   28h   
01C7   DF           PR9:      RST   18h   
01C8                             ; "#" prints TOS as a signed decimal number, with no space after it.
01C8   CD CC 02     H_NUM:    CALL   psgn   
01CB   DF                     RST   18h   
01CC                             ; "?" ( n -- c ) or ( -n -- addr )
01CC                             ;   n > 0: wait about n ms for a key; 0 if none came
01CC                             ;   n = 0: wait for a key
01CC                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
01CC                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
01CC   CB 7C        H_KEY:    BIT   7,H   
01CE   20 19                  JR   NZ,line   
01D0   1E 28        KT1:      LD   E,MSLOOP   ; one millisecond, roughly
01D2   CD 14 03     KT2:      CALL   getk   
01D5   20 0E                  JR   NZ,kt3   
01D7   1D                     DEC   E   
01D8   20 F8                  JR   NZ,kt2   
01DA   7C                     LD   A,H   ; 0? never counts down: it waits
01DB   B5                     OR   L   
01DC   28 F2                  JR   Z,kt1   
01DE   2B                     DEC   HL   
01DF   7C                     LD   A,H   
01E0   B5                     OR   L   
01E1   20 ED                  JR   NZ,kt1   ; A = 0 if the time ran out
01E3   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
01E4   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
01E5   6F           KT3:      LD   L,A   
01E6   26 00                  LD   H,0   
01E8   F7                     RST   30h   
01E9                             ; Backspace takes the last character back (and is echoed as
01E9                             ; it is), CR ends (stored, not echoed), every other key is stored and
01E9                             ; echoed until the line is full. The line buffer starts at offset 80h
01E9                             ; of its page, so L alone is the place in the line: D holds the L of
01E9                             ; a full line.
01E9   11 7F 00     LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
01EC   19                     ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
01ED   9F                     SBC   A,A   
01EE   A5                     AND   L   ; (0 for a count that is too big)
01EF   2F                     CPL      
01F0   57                     LD   D,A   ; D = the L of a full line: 80h + count, FFh
01F1                             ;   at most
01F1   21 80 82               LD   HL,LINEBUF   
01F4   CD 14 03     LN2:      CALL   getk   
01F7   28 FB                  JR   Z,ln2   
01F9   FE 0D                  CP   13   
01FB   28 16                  JR   Z,ln5   
01FD   FE 08                  CP   8   
01FF   28 0B                  JR   Z,ln4   
0201   5F                     LD   E,A   
0202   7D                     LD   A,L   
0203   BA                     CP   D   
0204   28 EE                  JR   Z,ln2   ; full
0206   73                     LD   (HL),E   
0207   2C                     INC   L   
0208   7B                     LD   A,E   
0209   EF           LN3:      RST   28h   
020A   18 E8                  JR   ln2   
020C   2D           LN4:      DEC   L   ; Backspace: one back, and echo it,
020D   FA 09 02               JP   M,ln3   ;   unless the line was empty (L left the
0210   2C                     INC   L   ;   upper half of the page)
0211   18 E1                  JR   ln2   
0213   77           LN5:      LD   (HL),A   ; the CR
0214   2E 80                  LD   L,LINEBUF & 0FFh   
0216   F7                     RST   30h   
0217                             ; =============================================================================
0217                             ;  More routines (no handler starts past this point)
0217                             ; =============================================================================
0217                          IF   CHECKED   
                                 ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
                                 ; "$", and the texts of the report). A NUL first is an error: Q.
                    PRSTR:    LD   A,(HL)   
                              INC   HL   
                              CP   22h   
                              RET   Z   
                              OR   A   
                              JR   Z,e_dollar   
                              CP   "/"   
                              JR   NZ,prs1   
                              LD   A,(HL)   
                              INC   HL   
                              CP   60h   
                              JR   C,prs0   
                              CP   7Fh   
                              JR   C,pesc   
                    PRS0:     AND   0BFh   
                    PRS1:     RST   28h   
                              JR   prstr   
                    PRLOOP:   EQU   prstr   ; (where the escapes go back to)
                    PRAGAIN:   EQU   hp1   ; (and where /~ goes back to)
                                 ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
                                 ; pnl: the same, on a new line.
                    PNL:      LD   A,13   
                              RST   28h   
                              LD   A,10   
                              RST   28h   
                    PMSG:     EX   (SP),HL   
                              CALL   prstr   
                              EX   (SP),HL   
                              RET      
                    E_DOLLAR:   POP   DE   ; "$" ran into a NUL: drop the return address,
                              LD   HL,(RSAVE)   ;   and put the string's address back in TOS
                              LD   A,"Q"   
                              JP   error   
0217                          ENDIF      
0217                             ; pesc: the escapes of "$". A = the character after the "/", 60h to 7Eh, and
0217                             ; HL points past it. Each goes back into the loop that prints the string
0217                             ; (PRLOOP), but /~ has the stack to see to, and goes back by PRAGAIN.
0217                             ;    /a-/z   print the variable, as "#" does
0217                             ;    /{      clear the screen, the cursor to the top left
0217                             ;    /}      clear from the cursor to the end of the line
0217                             ;    /|  /`  show the cursor, hide it
0217                             ;    /~      ( row col -- ) the cursor to that row and column, from 0
0217   FE 7E        PESC:     CP   7Eh   
0219   28 1C                  JR   Z,pat   
021B   11 AC 01               LD   DE,PRLOOP   ; the others return into the loop
021E   D5                     PUSH   DE   
021F   D6 7B                  SUB   7Bh   ; 00bbIDAsIHwgMSwg 2, and no borrow
0221   30 21                  JR   NC,pcon   
0223   C6 1A                  ADD   A,1Ah   ; a-z: 0-25, and a carry; `: FFh, and none
0225   30 19                  JR   NC,phide   
0227   87                     ADD   A,A   ; the variable's cell
0228   C6 40                  ADD   A,40h   
022A   E5                     PUSH   HL   
022B   6F                     LD   L,A   
022C   26 82                  LD   H,LETPAGE   
022E   7E                     LD   A,(HL)   
022F   2C                     INC   L   
0230   66                     LD   H,(HL)   
0231   6F                     LD   L,A   
0232   CD CC 02               CALL   psgn   
0235   E1                     POP   HL   
0236   C9                     RET      
0237                             ; /~ ( row col addr -- ): the two cells under the string's address go. Where
0237                             ; "$" is the routine prstr, its own return address goes first, and hp1
0237                             ; calls it again afterwards. (The checked build looks first, through
0237                             ; chkstk, that there is a column at least: with less, it is s. With a
0237                             ; column but no row it is s after the "$", as for any other character; the
0237                             ; spare bytes above the stack take what is written meanwhile.)
0237                PAT:         
0237                          IF   PRSUB   
                              POP   DE   
0237                          ENDIF      
0237                          IF   CHECKED   
                              CALL   chkstk   
0237                          ENDIF      
0237   D1                     POP   DE   ; DE = the column
0238   E3                     EX   (SP),HL   ; HL = the row; the text pointer is kept
0239                          IF   1-ANS   
0239   CD 15 FF               CALL   CONAT   
023C   E1                     POP   HL   
023D   C3 AC 01               JP   PRAGAIN   
0240                             ; With ANSI = 0 the machine's routines do the rest.
0240   AF           PHIDE:    XOR   A   ; /`  (A = 0: hide)
0241   C3 12 FF               JP   CONCUR   
0244   CA 0C FF     PCON:     JP   Z,CONCLS   ; /{
0247   FE 02                  CP   2   
0249   CA 0F FF               JP   Z,CONEOL   ; /}
024C   C3 12 FF               JP   CONCUR   ; /|  (A = 1: show)
024F                          ENDIF      
024F                          IF   ANS   
                              PUSH   DE   
                              CALL   csi   ; ESC [ row+1 ; col+1 H (ANSI counts from 1)
                              INC   HL   
                              CALL   pdec   
                              LD   A,";"   
                              RST   28h   
                              POP   HL   
                              INC   HL   
                              CALL   pdec   
                              LD   A,"H"   
                              RST   28h   
                              POP   HL   
                              JP   PRAGAIN   
                                 ; With ANSI = 1 they are sequences. The carry is clear on the way in.
                    PSHOW:    LD   E,"h"   ; /|  ESC [ ? 2 5 h
                              DB   0DAh   ; (JP C,nn: with no carry it steps over two bytes)
                    PHIDE:    LD   E,"l"   ; /`  ESC [ ? 2 5 l
                              LD   A,"?"   
                              CALL   csia   
                              LD   A,"2"   
                              RST   28h   
                              LD   A,"5"   
                              RST   28h   
                              LD   A,E   
                              RST   28h   
                              RET      
                                 ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into csia.
                    PCON:     DEC   A   
                              JR   Z,pshow   ; /|
                              LD   A,"K"   
                              JP   P,csia   ; /}  ESC [ K
                              LD   A,"H"   ; /{  ESC [ H ESC [ J
                              CALL   csia   
                              LD   A,"J"   ; (on into csia)
                                 ; csia: ESC [ and then A. csi: ESC [, keeping A.
                    CSIA:     CALL   csi   
                              RST   28h   
                              RET      
                    CSI:      PUSH   AF   
                              LD   A,27   
                              RST   28h   
                              LD   A,"["   
                              RST   28h   
                              POP   AF   
                              RET      
024F                          ENDIF      
024F                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
024F                             ; Uses A; keeps BC (the IP) itself. The dividend shifts up through A:C while
024F                             ; the quotient bits arrive at the bottom of C.
024F                             ; Dividing by 2 is one shift (the spec wants that fast).
024F   7B           UDIV:     LD   A,E   
0250   EE 02                  XOR   2   
0252   B2                     OR   D   
0253   20 07                  JR   NZ,udv0   
0255   CB 3C                  SRL   H   
0257   CB 1D                  RR   L   ; the quotient
0259   8F                     ADC   A,A   
025A   5F                     LD   E,A   ; the remainder: the bit that fell out (D is 0)
025B   C9                     RET      
025C   C5           UDV0:     PUSH   BC   
025D   7C                     LD   A,H   
025E   4D                     LD   C,L   
025F   21 00 00               LD   HL,0   
0262   06 10                  LD   B,16   
0264   CB 21        UDV1:     SLA   C   
0266   17                     RLA      
0267   ED 6A                  ADC   HL,HL   
0269   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
026B   30 02                  JR   NC,udv2   ;   always fits in 16 bits
026D   19                     ADD   HL,DE   ; too much: put it back, and cancel the
026E   0D                     DEC   C   ;   INC below
026F   0C           UDV2:     INC   C   ; a quotient bit
0270   10 F2                  DJNZ   udv1   
0272   EB                     EX   DE,HL   ; DE = remainder
0273   67                     LD   H,A   
0274   69                     LD   L,C   ; HL = quotient
0275   C1                     POP   BC   
0276   C9                     RET      
0277                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
0277                             ; non-digit. Values wrap at 16 bits, as the spec says.
0277   21 00 00     RDNUM:    LD   HL,0   
027A   0A           RDN1:     LD   A,(BC)   
027B   D6 30                  SUB   "0"   
027D   FE 0A                  CP   10   
027F   D0                     RET   NC   
0280   03                     INC   BC   
0281   54                     LD   D,H   
0282   5D                     LD   E,L   
0283   29                     ADD   HL,HL   
0284   29                     ADD   HL,HL   
0285   19                     ADD   HL,DE   
0286   29                     ADD   HL,HL   ; HL * 10
0287   5F                     LD   E,A   
0288   16 00                  LD   D,0   
028A   19                     ADD   HL,DE   
028B   18 ED                  JR   rdn1   
028D                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
028D                             ; the next character, so "/"" does not end it. Leaves A = 22h.
028D                          IF   1-CHECKED   
028D   03           SS0:      INC   BC   
028E   0A           SKIPSTR:   LD   A,(BC)   
028F   03                     INC   BC   
0290   FE 2F                  CP   "/"   
0292   28 F9                  JR   Z,ss0   
0294   FE 22                  CP   22h   
0296   20 F6                  JR   NZ,skipstr   
0298   C9                     RET      
0299                          ENDIF      
0299                          IF   CHECKED   
                                 ; The checked build never steps over a NUL: if the text runs out first it
                                 ; returns A = 0 with the IP on the NUL.
                    SKIPSTR:   LD   A,(BC)   
                              OR   A   
                              RET   Z   
                              INC   BC   
                              CP   22h   
                              RET   Z   
                              CP   "/"   
                              JR   NZ,skipstr   
                              LD   A,(BC)   ; the escaped character
                              OR   A   
                              RET   Z   
                              INC   BC   
                              JR   skipstr   
0299                          ENDIF      
0299                             ; skip: read past text to the closer at this level, and return A = 0 if it
0299                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
0299                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
0299                             ; no closer; anything else that runs into the NUL had unbalanced brackets
0299                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
0299                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
0299                             ; 
0299                             ; The checked build also looks at the character the skip was started by,
0299                             ; which is always the one just before where it starts: "(" must end at ")",
0299                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
0299                             ; quote counts as running into it. "\" takes either closer. IX keeps the
0299                             ; place where the skip started, for the report.
0299                SKIP:        
0299                          IF   CHECKED   
                              PUSH   BC   
                              POP   IX   
                              DEC   BC   
                              LD   A,(BC)   
                              INC   BC   
                              LD   E,A   ; E = the opener: ( [ or \
0299                          ENDIF      
0299   16 00                  LD   D,0   
029B   14           SK3:      INC   D   ; an opener: one deeper
029C   0A           SK1:      LD   A,(BC)   
029D                          IF   1-CHECKED   
029D   03                     INC   BC   
029E   B7                     OR   A   
029F   CA 60 03               JP   Z,SKEND   ; (the end of the program)
02A2                          ENDIF      
02A2                          IF   CHECKED   
                              OR   A   
                              JR   Z,sk6   ; (the IP stays on the NUL)
                              INC   BC   
02A2                          ENDIF      
02A2   FE 22                  CP   22h   
02A4   CC 8E 02               CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
02A7   D6 28                  SUB   "("   ;   (or 0, and then the NUL is read next)
02A9   28 F0                  JR   Z,sk3   
02AB   3D                     DEC   A   ; ")"
02AC   28 08                  JR   Z,sk4   
02AE   D6 32                  SUB   "["-")"   
02B0   28 E9                  JR   Z,sk3   
02B2   FE 02                  CP   "]"-"["   
02B4   20 E6                  JR   NZ,sk1   
02B6   15           SK4:      DEC   D   
02B7                          IF   1-CHECKED   
02B7   C8                     RET   Z   ; the closer at this level
02B8   18 E2                  JR   sk1   
02BA                          ENDIF      
02BA                          IF   CHECKED   
                              JR   NZ,sk1   
                              LD   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
                              XOR   E   ;   opener is 0 for "(" and 1 for "[", and only
                              AND   6   ;   "\" has bit 2: so this is 2 for the wrong
                              CP   2   ;   closer, and only then
                              LD   A,D   
                              RET   NZ   
                              JR   sk7   
                    SK6:      BIT   2,E   ; the text ran out:
                              JP   NZ,SKEND   ;   "\" with no closer ends the program
                    SK7:      PUSH   IX   ; N. The place is the opener
                              POP   BC   
                              LD   A,"N"   
                              JP   errp   ; (errp drops skip's return address)
02BA                          ENDIF      
02BA                             ; =============================================================================
02BA                             ;  Dispatch table: the low byte of each handler's address, in code order
02BA                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
02BA                             ;  It must not cross a page (the dispatcher only adds to its low byte).
02BA                             ; =============================================================================
02BA                             ; The handlers of the first NPG1 characters start in the image's second page.
02BA                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
02BA                             ; differs between the builds, so the count is worked out here.
02BA                             ; (One division to a line: asm80 only rounds down when it stores a value.)
02BA                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
02BA                PGBRK:    EQU   (h_break-BASE)/256   
02BA                PGDEF:    EQU   (h_def-BASE)/256   
02BA                PGFET:    EQU   (h_fetch-BASE)/256   
02BA                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
02BA                          IF   (1-TABP0)*(1-PTLATE)   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
02BA                          ENDIF      
02BA                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
02BA                             ; and return its value in A with the carry set; otherwise leave the IP and
02BA                             ; return with the carry clear.
02BA   0A           HEXC:     LD   A,(BC)   
02BB   D6 30                  SUB   "0"   
02BD   FE 0A                  CP   10   
02BF   38 09                  JR   C,hc1   
02C1   E6 DF                  AND   0DFh   
02C3   D6 11                  SUB   11h   
02C5   FE 06                  CP   6   
02C7   D0                     RET   NC   
02C8   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
02CA   03           HC1:      INC   BC   
02CB   C9                     RET      
02CC                             ; psgn: print HL as a signed number. Keeps BC.
02CC   CB 7C        PSGN:     BIT   7,H   
02CE   28 04                  JR   Z,pdec   
02D0   3E 2D                  LD   A,"-"   
02D2   EF                     RST   28h   
02D3   E7                     RST   20h   
02D4                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
02D4                             ; Keeps BC.
02D4   11 0A 00     PDEC:     LD   DE,10   
02D7   CD 4F 02               CALL   udiv   ; HL = HL / 10, E = the last digit
02DA   7B                     LD   A,E   
02DB   F5                     PUSH   AF   
02DC   7C                     LD   A,H   
02DD   B5                     OR   L   
02DE   C4 D4 02               CALL   NZ,pdec   
02E1   F1                     POP   AF   
02E2   C6 30                  ADD   A,"0"   
02E4   EF                     RST   28h   
02E5   C9                     RET      
02E6                             ; (The table goes here instead in the builds where, before psgn, it would
02E6                             ; cross a page: PTLATE.)
02E6                          IF   (1-TABP0)*PTLATE   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
02E6                          ENDIF      
02E6                             ; =============================================================================
02E6                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
02E6                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
02E6                             ;  (RST 28h) prints A. Both keep BC, DE, HL and HL'. In the generic build
02E6                             ;  they are the host's KEY and CONOUT routines themselves.
02E6                             ; 
02E6                             ;  A running program reads the keyboard only through getk and pollk, which
02E6                             ;  between them give the break key its rules:
02E6                             ;    - Ctrl-C stops the program;
02E6                             ;    - any other key that the break check reads is held in KEYBUF for the
02E6                             ;      next "?", and a newer one takes its place;
02E6                             ;    - "?" (getk) takes the held key first;
02E6                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
02E6                             ;      key like any other, but two of them within about 250 ms still stop it.
02E6                             ;  Both are called straight from a handler, never from a routine under one:
02E6                             ;  the checked build's report counts on finding one return address above the
02E6                             ;  data stack.
02E6                             ; =============================================================================
02E6                          IFN   CPM   
02E6                RAWK:     EQU   KEY   
02E6                          ENDIF      
02E6                             ; pollk: the break check (see rpushn).
02E6   CD 06 FF     POLLK:    CALL   rawk   
02E9   C8                     RET   Z   ; no key
02EA   32 7A 82               LD   (KEYBUF),A   ; held for the next "?"
02ED   FE 03        PK1:      CP   3   ; (getk joins here)
02EF   C0                     RET   NZ   
02F0                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
02F0                             ; the program has turned it off, wait about 250 ms for one more key: a
02F0                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
02F0                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
02F0   3A 7B 82     CTLC:     LD   A,(BRKOFF)   
02F3   B7                     OR   A   
02F4   CA 5C 03     CT0:      JP   Z,brk   
02F7   D5                     PUSH   DE   
02F8   11 10 27               LD   DE,250*MSLOOP   
02FB   CD 06 FF     CT1:      CALL   rawk   
02FE   20 05                  JR   NZ,ct2   
0300   1B                     DEC   DE   
0301   7A                     LD   A,D   
0302   B3                     OR   E   
0303   20 F6                  JR   NZ,ct1   
0305   D1           CT2:      POP   DE   ; A = the second key, or 0 if none came
0306   FE 03                  CP   3   
0308   28 EA                  JR   Z,ct0   ; (the zero flag takes the JP there)
030A   B7                     OR   A   
030B   28 03                  JR   Z,ct3   
030D   32 7A 82               LD   (KEYBUF),A   
0310   3E 03        CT3:      LD   A,3   
0312   B7                     OR   A   
0313   C9                     RET      
0314                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
0314   E5           GETK:     PUSH   HL   ; a held key goes first, and is taken out of
0315   21 7A 82               LD   HL,KEYBUF   ;   the buffer
0318   7E                     LD   A,(HL)   
0319   36 00                  LD   (HL),0   
031B   E1                     POP   HL   
031C   B7                     OR   A   
031D   C0                     RET   NZ   
031E   CD 06 FF               CALL   rawk   
0321   C8                     RET   Z   
0322   18 C9                  JR   pk1   ; Ctrl-C? If not, that is the key
0324                          IF   (1-CHECKED)*(1-EDITOR)   
                    BRK:      EQU   endprog   ; the unchecked build stops without a word
0324                          ENDIF      ;   (with the editor, both stacks are cleared);
0324                          IF   (1-CHECKED)*EDITOR   
0324                BRK:      EQU   edit0   
0324                          ENDIF      
0324                          IF   CHECKED   
                    BRK:      EQU   e_break   ;   the checked build reports B
0324                          ENDIF      
0324                          IF   CPM   
                    RAWK:     LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
                                 ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
                                 ; printing and could swallow a key that BDOS 6 then never sees.
                    PUTC:     PUSH   DE   
                              PUSH   HL   
                              LD   E,A   
                              LD   A,6   
                              CALL   bdosx   
                              POP   HL   
                              POP   DE   
                              OR   A   ; (for getk)
                              RET      
                                 ; bdosx: call BDOS function A with DE, keeping BC and HL'
                    BDOSX:    PUSH   BC   
                              EXX      
                              PUSH   HL   
                              EXX      
                              LD   C,A   
                              CALL   BDOS   
                              EXX      
                              POP   HL   
                              EXX      
                              POP   BC   
                              RET      
0324                          ENDIF      
0324                             ; =============================================================================
0324                             ;  Checked build: the checks and the error report
0324                             ; =============================================================================
0324                          IF   CHECKED   
                                 ; chkstk: both stacks are checked once per character, not in every handler.
                                 ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
                                 ; the constant carries if it is above (cells were popped that were never
                                 ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
                                 ; a character late at most: the bytes above DSTOP and the guard band below
                                 ; the page take what happens meanwhile. DE is free between characters.
                    CHKSTK:   EX   DE,HL   
                              LD   HL,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
                              ADD   HL,SP   
                              EX   DE,HL   
                              JR   C,e_under   
                              INC   D   
                              JR   NZ,e_over   
                              EXX      ; the return stack: in its page (or it has
                              LD   A,H   ;   overflowed), and not above its empty
                              CP   RSPAGE   ;   position (an underflow stays inside the
                              LD   A,L   ;   page, in the guard band)
                              EXX      
                              JR   NZ,e_rover   
                              CP   RSTOP&0FFh+1   
                              RET   C   
                              EXX      ; return stack underflow: it counts as empty
                              LD   L,RSTOP&0FFh   ;   (H is right: the pointer is in its page)
                              EXX      
                              LD   A,"r"   
                              JR   errp   
                    E_ROVER:   LD   A,"R"   ; return stack overflow
                              DB   11h   ; (LD DE,nn hides the next entry)
                    E_OVER:   LD   A,"S"   ; data stack overflow
                              JR   errp   
                    E_UNDER:   LD   SP,DSTOP   ; data stack underflow: it counts as empty
                              LD   A,"s"   
                              JR   error   
                                 ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
                                 ; was never defined still holds 0000h, and the byte there is a reserved one
                                 ; in every build (AFh or C3h): if the IP is in page zero, this was a call of
                                 ; an undefined word. The call is undone, so the place is the call itself.
                    E_HI:     INC   B   
                              DJNZ   e_resv   ; (B is as it was, and is not 0)
                              RST   08h   
                              LD   B,D   
                              LD   C,E   
                              LD   A,"U"   
                              JR   error   
                                 ; chkhp: HL = the new heap top, DE = the old one, the carry is from adding
                                 ; the count. Stop if the top is not below the limit page, or is below the
                                 ; program's end.
                    CHKHP:       
0324                          ENDIF      
0324                          IF   CHECKED*CPM   
                                 ; With this much room a top that wrapped round can land back in
                                 ; range, so the add is tested too: growing (A, the count's high
                                 ; byte, is positive) must not carry, and releasing must.
                              RRA      ; the carry comes in above the sign:
                              ADD   A,40h   ;   bit 7 = carry XOR sign
                              ADD   A,A   
                              JR   C,e_heap   
                              LD   A,(0007h)   
                              DEC   A   
                              CP   H   
                              JR   C,e_heap   
0324                          ENDIF      
0324                          IF   CHECKED*(1-CPM)   
                                 ; (Here the program's space is under 32K, so a top that wrapped
                                 ; round always falls outside it.)
                              LD   A,H   
                              CP   HEAPLIM   
                              JR   NC,e_heap   
0324                          ENDIF      
0324                          IF   CHECKED   
                              PUSH   DE   
                              EX   DE,HL   
                              LD   HL,(NPEND)   
                              ADD   HL,DE   ; carry: at or above the program's end
                              EX   DE,HL   
                              POP   DE   
                              RET   C   
                    E_HEAP:   OR   A   ; put the count back in TOS for the report
                              SBC   HL,DE   
                              LD   A,"H"   
                              JR   errp   
                                 ; chkst: stop unless HL is in the program's own space: from the letter page
                                 ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
                                 ; whatever lies above the limit are safe. Memory above the heap top but
                                 ; below the limit is the program's own: Tiny BASIC keeps its lines there.
                                 ; It is the page of HL + 1 that is tested, so that one test serves both
                                 ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
                                 ; Keeps HL and BC. It runs on into its own error entry.
                    CHKST:    INC   HL   
                              LD   A,H   
                              DEC   HL   
                              CP   LETPAGE   
                              JR   C,e_store   
0324                          ENDIF      
0324                          IF   CHECKED*(1-CPM)   
                              CP   HEAPLIM   
                              RET   C   
0324                          ENDIF      
0324                          IF   CHECKED*CPM   
                              LD   E,A   
                              LD   A,(0007h)   ; the BDOS page is the heap limit
                              DEC   A   
                              CP   E   
                              RET   NC   
0324                          ENDIF      
0324                          IF   CHECKED   
                                 ; Error entries. Each loads its letter and then hides the next entry inside
                                 ; a 3-byte LD DE,nn (the 11h), so they all fall through to `error`.
                    E_STORE:   LD   A,"O"   ; a store outside the program's space
                              DB   11h   
                    E_BREAK:   LD   A,"B"   ; Ctrl-C (found inside pollk or getk)
                                 ; errp: an error found inside a routine: drop its return address first.
                    ERRP:     POP   DE   
                              JR   error   
                    E_QUOTE:   LD   B,H   ; an unclosed string: HL is its address, one
                              LD   C,L   ;   past the opening quote, which is the place
                              LD   A,"Q"   
                              DB   11h   
                    E_RESV:   LD   A,"X"   ; a reserved byte outside a string
                              DB   11h   
                    E_ZERO:   LD   A,"Z"   ; dividing by zero
                              DB   11h   
                    E_BRACK:   LD   A,"W"   ; bad character after [
                                 ; error: the report, then the end. A = the letter, BC = one past the place,
                                 ; HL = TOS, and both stacks as the report is to show them:
                                 ; 
                                 ;   Err X @ line,col
                                 ;   up to 16 characters of the text from the place
                                 ;   Stk n: the top 8 cells at most, bottom to top
                                 ;   Rtn n
                    ERROR:    PUSH   HL   ; now the whole data stack is in memory
                              LD   E,A   
                              CALL   pnl   
                              DB   "Err ",22h   
                              LD   A,E   
                              RST   28h   
                              CALL   pmsg   
                              DB   " @ ",22h   
                              DEC   BC   ; BC = the place
                                 ; The line and column. A place below the program is in the line
                                 ; buffer: line 0. Otherwise count the LFs from the program's start;
                                 ; DE = the line's number, HL = where it starts.
                              LD   HL,LINEBUF   
                              LD   DE,0   
                              LD   A,B   
                              CP   PROG/256   
                              JR   C,er3   
                              INC   H   
                              LD   L,E   ; HL = PROG
                    ER1:      INC   DE   ; a new line starts at HL
                              PUSH   HL   
                    ER2:      LD   A,L   
                              SUB   C   
                              LD   A,H   
                              SBC   A,B   
                              JR   NC,er2x   ; reached the place
                              LD   A,(HL)   
                              INC   HL   
                              CP   10   
                              JR   NZ,er2   
                              POP   AF   
                              JR   er1   
                    ER2X:     POP   HL   
                    ER3:      PUSH   BC   
                              PUSH   HL   
                              EX   DE,HL   
                              CALL   pdec   ; the line
                              LD   A,","   
                              RST   28h   
                              POP   DE   
                              POP   HL   
                              PUSH   HL   
                              OR   A   
                              SBC   HL,DE   
                              INC   HL   
                              CALL   pdec   ; the column
                              CALL   pnl   
                              DB   22h   
                              POP   HL   ; the text, as it is: 16 characters, or fewer
                              LD   B,16   ;   if the line or the program ends first
                    ER4:      LD   A,(HL)   
                              INC   HL   
                              OR   A   
                              JR   Z,er5   
                              CP   13   
                              JR   Z,er5   
                              CP   10   
                              JR   Z,er5   
0324                          ENDIF      
0324                          IF   CHECKED*CPM*(1-EDITOR)   
                              CP   1Ah   ; (the ^Z that pads a file's last record ends
                              JR   Z,er5   ;   the text too: some terminals clear the
0324                          ENDIF      ;   screen on it. The editor's loader ends
0324                          IF   CHECKED   ;   the text at the first ^Z.)
                              RST   28h   
                              DJNZ   er4   
                    ER5:         ; (on into the two stack lines)
                                 ; The two stack lines:  Stk n: the top 8 cells at most, bottom to top
                                 ;                       Rtn n
                                 ; TOS is in memory with the rest (pushed) by now.
                              CALL   pnl   
                              DB   "Stk ",22h   
                              LD   HL,(2-DSTOP)&0FFFFh   ; SP - (DSTOP-2) is minus twice the
                              ADD   HL,SP   ;   depth (the cell at DSTOP-2 was pushed
                              RST   20h   ;   with the first value and holds nothing)
                              CALL   phalf   ; the depth
                              LD   A,":"   
                              RST   28h   
                              LD   A,C   
                              CP   9   
                              JR   C,er6   
                              CALL   pmsg   
                              DB   " ...",22h   
                              LD   C,8   
                    ER6:      LD   H,0   ; C = the number of cells to show
                              LD   L,C   
                              ADD   HL,HL   
                              ADD   HL,SP   ; HL -> just above the deepest of them
                              INC   C   
                    ER7:      DEC   C   
                              JR   Z,er8   
                              DEC   HL   
                              LD   D,(HL)   
                              DEC   HL   
                              LD   E,(HL)   
                              PUSH   HL   
                              LD   A," "   
                              RST   28h   
                              EX   DE,HL   
                              CALL   psgn   
                              POP   HL   
                              JR   er7   
                    ER8:      CALL   pnl   
                              DB   "Rtn ",22h   
                              EXX      
                              PUSH   HL   
                              EXX      
                              POP   DE   
                              LD   HL,RSTOP   
                              OR   A   
                              SBC   HL,DE   
                              CALL   phalf   
                              CALL   pnl   
                              DB   22h   
0324                          ENDIF      
0324                          IF   CHECKED*(1-EDITOR)   
                              JP   endprog   
0324                          ENDIF      
0324                          IF   CHECKED*EDITOR   
                              JP   edit0   ; back to the editor, with both stacks cleared
0324                          ENDIF      
0324                          IF   CHECKED   
                                 ; phalf: print half of HL, and leave it in C.
                    PHALF:    SRL   H   
                              RR   L   
                              PUSH   HL   
                              CALL   pdec   
                              POP   BC   
                              RET      
0324                          ENDIF      
0324                             ; =============================================================================
0324                             ;  The line editor (EDITOR = 1)
0324                             ; 
0324                             ;  The interpreter starts here, and a program that ends comes back here.
0324                             ;  There is no prompt. It follows the spec's suggested standard for a line
0324                             ;  editor (docs/b8script.md, Environments). Type a line and press Return:
0324                             ; 
0324                             ;    n text    put the text in as line n; the lines from n on move down. A
0324                             ;              number past the end (or 0) adds the line at the end.
0324                             ;    n         take line n out
0324                             ;    anything else is run at once, as B8Script. (Start such a line with a
0324                             ;    space if it would begin with a digit.)
0324                             ; 
0324                             ;  A command key ends the line too, and takes what was typed as its argument:
0324                             ; 
0324                             ;    ^G        run the program
0324                             ;    n ^L      list from line n (no number: all of it). Any key holds the
0324                             ;              list until another key is pressed; Ctrl-C ends it.
0324                             ;    n ^E      put line n in the input line; Return puts it back, changed
0324                             ;    name ^R   read. CP/M: the file of that name (no name: the same file as
0324                             ;              last time). Generic: what is typed, or pasted, from now until
0324                             ;              ^Z replaces the program; it is not echoed.
0324                             ;    name ^W   write. CP/M: to that file (no name: the same file as last
0324                             ;              time). Generic: the text is printed, as it is.
0324                             ;    ^N ^N     new: no program (the key twice in a row)
0324                             ;    ^X        leave (to LEAVE)
0324                             ; 
0324                             ;  In the line: ^B and ^F, or the left and right arrow keys, move the cursor;
0324                             ;  a character goes in at the cursor; Backspace and DEL take out the one
0324                             ;  before it; Esc drops the line. Only CR, LF, BS and printing characters are
0324                             ;  sent to the terminal, so any terminal will do.
0324                             ; 
0324                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
0324                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
0324                             ;  125 characters; the one character after a line number separates it from
0324                             ;  the text and is not stored. The text is kept as it is typed, each line
0324                             ;  ending in CR LF, at PROG.
0324                             ; 
0324                             ;  What lasts from one line to the next: the program, the words, the
0324                             ;  variables and the data stack. An error or a break clears both stacks. The
0324                             ;  return stack starts empty for every line.
0324                             ; 
0324                             ;  Things to know:
0324                             ;    - Reset empties the program (generic builds).
0324                             ;    - A word's address points into the program, so run the program again
0324                             ;      after editing it.
0324                             ;    - Nothing is printed between a program's output and what is typed next.
0324                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
0324                             ;      a line that calls -n? and carries on afterwards runs what was typed.
0324                             ;      (The stored program never comes back to the line, so it may.)
0324                             ;    - The editor"s own keys are not the program"s: -n? is the plain line
0324                             ;      read of the other builds.
0324                             ; 
0324                             ;  The data stack is the CPU's stack, so the editor works on top of whatever
0324                             ;  the last line left there, with TOS pushed like the rest.
0324                             ; =============================================================================
0324                          IF   EDGEN   
0324                INIT:        ; reset (A = 0)
0324                          ENDIF      
0324                          IF   EDGEN*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at 0, and
                                 ; every word cell holds 0000h, the address an undefined word is caught at
                                 ; (see e_hi).
                              LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
0324                          ENDIF      
0324                          IF   EDGEN   
0324   18 36                  JR   edit0   
0326                          ENDIF      
0326                          IF   EDITOR   
0326                             ; ^F, right arrow: one to the right, by printing the character there
0326   7D           RIGHT:    LD   A,L   
0327   BB                     CP   E   
0328   28 4A                  JR   Z,ed1   ; at the end
032A   7E                     LD   A,(HL)   
032B   2C                     INC   L   
032C   18 2B                  JR   lf1   
032E                             ; Esc: alone it drops the line. An arrow key sends Esc [ and a letter, so
032E                             ; wait about 5 ms for a second key: after a "[" read on to the letter that
032E                             ; ends the sequence, and act on C (right) and D (left).
032E   01 C8 00     ESC:      LD   BC,5*MSLOOP   
0331   CD 06 FF     ES1:      CALL   rawk   
0334   20 0A                  JR   NZ,es2   
0336   0B                     DEC   BC   
0337   78                     LD   A,B   
0338   B1                     OR   C   
0339   20 F6                  JR   NZ,es1   
033B   CD A9 03               CALL   fin   ; no second key: the line is dropped
033E   18 22                  JR   edit   
0340   FE 5B        ES2:      CP   "["   
0342   20 30                  JR   NZ,ed1   ; not a sequence known here
0344   CD 02 04     ES3:      CALL   ekey   
0347   FE 40                  CP   40h   
0349   38 F9                  JR   C,es3   ; (its parameters)
034B   D6 43                  SUB   "C"   
034D   28 D7                  JR   Z,right   
034F   3D                     DEC   A   ; "D"?
0350   20 22                  JR   NZ,ed1   ; no: on into left
0352                             ; ^B, left arrow: the cursor goes one to the left
0352   7D           LEFT:     LD   A,L   
0353   87                     ADD   A,A   
0354   28 1E                  JR   Z,ed1   ; (L = 80h: at the start)
0356   2D                     DEC   L   
0357   3E 08                  LD   A,8   
0359   EF           LF1:      RST   28h   
035A   18 18                  JR   ed1   
035C                             ; edit0: reset, an error or a break: both stacks are cleared.
035C                             ; skend: a program that ended inside skip: its return address goes.
035C                             ; edend: a program that ended: TOS joins the rest of the data stack.
035C   31 FA 81     EDIT0:    LD   SP,DSTOP-2   ; empty (the cell that stands for TOS is pushed)
035F   21                     DB   21h   ; (LD HL,nn: steps over the next two bytes)
0360   D1           SKEND:    POP   DE   
0361   E5           EDEND:    PUSH   HL   
0362                             ; edit: start a new input line.
0362   D9           EDIT:     EXX      
0363   21 E0 80               LD   HL,RSTOP   ; the return stack is empty
0366   D9                     EXX      
0367   21 00 00               LD   HL,0   
036A   22 7A 82               LD   (KEYBUF),HL   ; no key is held, and the break key is on
036D   22 3A 82               LD   (EDLN),HL   ; no line is being edited
0370   21 80 82               LD   HL,LINEBUF   ; HL = the cursor,
0373   5D                     LD   E,L   ;   E = the end of the line (its low byte)
0374   CD 02 04     ED1:      CALL   ekey   
0377   FE 7F                  CP   7Fh   
0379   28 40                  JR   Z,bsp   ; DEL
037B   FE 20                  CP   " "   
037D   30 56                  JR   NC,insc   
037F   FE 09                  CP   9   
0381   28 52                  JR   Z,insc   ; Tab is text
0383   FE 08                  CP   8   
0385   28 34                  JR   Z,bsp   
0387   FE 02                  CP   2   
0389   28 C7                  JR   Z,left   ; ^B
038B   FE 06                  CP   6   
038D   28 97                  JR   Z,right   ; ^F
038F   FE 1B                  CP   1Bh   
0391   28 9B                  JR   Z,esc   
0393   E5                     PUSH   HL   ; a command key? Look it up
0394   21 08 04               LD   HL,cmds   
0397   06 08                  LD   B,NCMD   
0399   BE           ED2:      CP   (HL)   
039A   23                     INC   HL   
039B   28 07                  JR   Z,ed3   
039D   23                     INC   HL   
039E   23                     INC   HL   
039F   10 F8                  DJNZ   ed2   
03A1   E1                     POP   HL   
03A2   18 D0                  JR   ed1   ; no: the key is ignored
03A4   7E           ED3:      LD   A,(HL)   
03A5   23                     INC   HL   
03A6   66                     LD   H,(HL)   
03A7   6F                     LD   L,A   
03A8   E3                     EX   (SP),HL   ; the command's address: fin returns to it
03A9                             ; fin: end the input line: CR LF and a NUL after it, and a new line on the
03A9                             ; terminal. Leaves BC -> the line and HL -> the NUL.
03A9   26 82        FIN:      LD   H,LETPAGE   
03AB   6B                     LD   L,E   
03AC   36 0D                  LD   (HL),13   
03AE   2C                     INC   L   
03AF   36 0A                  LD   (HL),10   
03B1   2D                     DEC   L   
03B2   CD 0D 05               CALL   prl   ; (prints the CR LF)
03B5   36 00                  LD   (HL),0   
03B7   01 80 82               LD   BC,LINEBUF   
03BA   C9                     RET      
03BB                             ; Backspace, DEL: the character before the cursor goes. The cursor moves
03BB                             ; left, the rest of the line moves down over it, and the last place (now a
03BB                             ; space) is printed over along with the rest.
03BB   7D           BSP:      LD   A,L   
03BC   87                     ADD   A,A   
03BD   28 B5                  JR   Z,ed1   ; at the start
03BF   2D                     DEC   L   
03C0   3E 08                  LD   A,8   
03C2   EF                     RST   28h   
03C3   E5                     PUSH   HL   
03C4   2C           BS1:      INC   L   
03C5   7E                     LD   A,(HL)   
03C6   2D                     DEC   L   
03C7   77                     LD   (HL),A   
03C8   2C                     INC   L   
03C9   7D                     LD   A,L   
03CA   BB                     CP   E   
03CB   20 F7                  JR   NZ,bs1   
03CD   2D                     DEC   L   
03CE   36 20                  LD   (HL)," "   
03D0   E1                     POP   HL   
03D1   53                     LD   D,E   
03D2   1D                     DEC   E   
03D3   18 15                  JR   ic2   
03D5                             ; A character goes in at the cursor: it ripples up through the rest of the
03D5                             ; line, the cursor moves on, and the rest is printed again.
03D5   47           INSC:     LD   B,A   
03D6   7B                     LD   A,E   
03D7   FE FD                  CP   0FDh   
03D9   28 99                  JR   Z,ed1   ; the line is full: 125 characters
03DB   78                     LD   A,B   
03DC   EF                     RST   28h   
03DD   E5                     PUSH   HL   
03DE   7E           IC1:      LD   A,(HL)   
03DF   70                     LD   (HL),B   
03E0   47                     LD   B,A   
03E1   7D                     LD   A,L   
03E2   2C                     INC   L   
03E3   BB                     CP   E   
03E4   20 F8                  JR   NZ,ic1   
03E6   E1                     POP   HL   
03E7   2C                     INC   L   
03E8   1C                     INC   E   
03E9   53                     LD   D,E   
03EA   CD EF 03     IC2:      CALL   tail   
03ED   18 85                  JR   ed1   
03EF                             ; tail: print the line from the cursor to D (a low byte), and bring the
03EF                             ; cursor back with backspaces. Nothing at all if the cursor is at D.
03EF   4D           TAIL:     LD   C,L   
03F0   7D           TA1:      LD   A,L   
03F1   BA                     CP   D   
03F2   28 05                  JR   Z,ta2   
03F4   7E                     LD   A,(HL)   
03F5   EF                     RST   28h   
03F6   2C                     INC   L   
03F7   18 F7                  JR   ta1   
03F9   7D           TA2:      LD   A,L   
03FA   B9                     CP   C   
03FB   C8                     RET   Z   
03FC   3E 08                  LD   A,8   
03FE   EF                     RST   28h   
03FF   2D                     DEC   L   
0400   18 F7                  JR   ta2   
0402                             ; ekey: wait for a key
0402   CD 06 FF     EKEY:     CALL   rawk   
0405   28 FB                  JR   Z,ekey   
0407   C9                     RET      
0408                             ; The command keys, and where each goes (after fin).
0408   0D           CMDS:     DB   13   
0409   58 04                  DW   cret   
040B   07                     DB   7   ; ^G
040C   A0 04                  DW   crun   
040E   0C                     DB   12   ; ^L
040F   B2 04                  DW   clist   
0411   05                     DB   5   ; ^E
0412   2E 04                  DW   cedln   
0414   12                     DB   18   ; ^R
0415   16 05                  DW   cread   
0417   17                     DB   23   ; ^W
0418   43 05                  DW   cwrite   
041A   0E                     DB   14   ; ^N
041B   20 04                  DW   cnew   
041D   18                     DB   24   ; ^X
041E   09 FF                  DW   LEAVE   
0420                NCMD:     EQU   8   
0420                             ; ^N ^N: no program, if the next key is ^N too
0420   CD 02 04     CNEW:     CALL   ekey   
0423   FE 0E                  CP   14   
0425   20 04                  JR   NZ,ged0   
0427   AF                     XOR   A   
0428   32 00 83               LD   (PROG),A   
042B   C3 62 03     GED0:     JP   edit   
042E                             ; ^E: line n goes into the input line, to be changed. EDLN remembers which
042E                             ; line it was: Return puts the text back in its place.
042E   CD 77 02     CEDLN:    CALL   rdnum   
0431   E5                     PUSH   HL   
0432   CD F5 04               CALL   find   ; HL -> the line, or the NUL if there is none
0435   D1                     POP   DE   
0436   7E                     LD   A,(HL)   
0437   B7                     OR   A   
0438   28 F1                  JR   Z,ged0   
043A   ED 53 3A 82            LD   (EDLN),DE   
043E   11 80 82               LD   DE,LINEBUF   
0441   7E           CE1:      LD   A,(HL)   ; copy it, and show it, up to its CR (or LF)
0442   FE 0D                  CP   13   
0444   28 0D                  JR   Z,ce2   
0446   FE 0A                  CP   10   
0448   28 09                  JR   Z,ce2   
044A   12                     LD   (DE),A   
044B   EF                     RST   28h   
044C   23                     INC   HL   
044D   1C                     INC   E   
044E   7B                     LD   A,E   
044F   FE FD                  CP   0FDh   ; (a longer line is cut at 125 characters)
0451   20 EE                  JR   NZ,ce1   
0453   EB           CE2:      EX   DE,HL   ; the cursor is at the line's end
0454   5D                     LD   E,L   
0455   C3 74 03               JP   ed1   
0458                             ; Return. If ^E put a line here, the text goes back in its place. If not:
0458                             ; a number and text is a line to put in, a number alone a line to take out,
0458                             ; and anything else is run where it is.
0458   E5           CRET:     PUSH   HL   ; the end of what was typed
0459   2A 3A 82               LD   HL,(EDLN)   
045C   7C                     LD   A,H   
045D   B5                     OR   L   
045E   28 07                  JR   Z,cr1   
0460   E5                     PUSH   HL   
0461   CD E5 04               CALL   delln   
0464   E1                     POP   HL   
0465   18 13                  JR   ins   
0467   CD 77 02     CR1:      CALL   rdnum   ; HL = the number it starts with, BC -> after
046A   79                     LD   A,C   ; C is still 80h if there was no number:
046B   87                     ADD   A,A   ;   only then is twice it 0
046C   28 36                  JR   Z,st0p   ; no number: run the line
046E   0A                     LD   A,(BC)   
046F   FE 0D                  CP   13   
0471   20 06                  JR   NZ,cr2   
0473   D1                     POP   DE   ; the number alone: take that line out
0474   CD E5 04               CALL   delln   
0477   18 24                  JR   gedit   
0479   03           CR2:      INC   BC   ; step over the one character after the number
047A                             ; Put the text at BC in as line n (in HL): open a gap of its length there,
047A                             ; CR and LF included, and copy it in.
047A   CD F5 04     INS:      CALL   find   ; HL -> where it goes
047D   D1                     POP   DE   ; the end of what was typed
047E   7B                     LD   A,E   
047F   91                     SUB   C   ; A = the length of the text, with its CR LF
0480   C5                     PUSH   BC   ; the text
0481   4F                     LD   C,A   
0482   06 00                  LD   B,0   
0484   C5                     PUSH   BC   ; its length
0485   54                     LD   D,H   
0486   5D                     LD   E,L   ; DE = where it goes
0487   AF                     XOR   A   
0488   4F                     LD   C,A   ; BC = 0: CPIR looks as far as it needs to
0489   ED B1                  CPIR      ; HL -> one past the program's NUL
048B   ED 52                  SBC   HL,DE   ; the number of bytes to move up, NUL included
048D   44                     LD   B,H   
048E   4D                     LD   C,L   
048F   19                     ADD   HL,DE   
0490   2B                     DEC   HL   ; HL -> the NUL
0491   EB                     EX   DE,HL   
0492   E3                     EX   (SP),HL   ; HL = the length; where it goes is kept
0493   E5                     PUSH   HL   
0494   19                     ADD   HL,DE   ; the NUL's new place
0495   EB                     EX   DE,HL   
0496   ED B8                  LDDR      ; move the rest of the program up
0498   C1                     POP   BC   ; the length
0499   D1                     POP   DE   ; where it goes
049A   E1                     POP   HL   ; the text
049B   ED B0                  LDIR      
049D   C3 62 03     GEDIT:    JP   edit   
04A0                             ; ^G: run the program. st0p: run the typed line (BC -> it).
04A0   01 00 83     CRUN:     LD   BC,PROG   
04A3   3E                     DB   3Eh   ; (LD A,n: steps over the POP)
04A4   E1           ST0P:     POP   HL   ; (the end of what was typed)
04A5                             ; st0: start running at BC. The heap starts after the stored program's NUL.
04A5   21 00 83     ST0:      LD   HL,PROG   
04A8   AF                     XOR   A   
04A9   BE           ST1:      CP   (HL)   
04AA   23                     INC   HL   
04AB   20 FC                  JR   NZ,st1   
04AD   22 7C 82               LD   (HEAP),HL   
04B0                          ENDIF      
04B0                          IF   EDITOR*CHECKED   
                              RST   20h   ; minus the heap"s first address: "_' may not
                              LD   (NPEND),HL   ;   release below it
04B0                          ENDIF      
04B0                          IF   EDITOR   
04B0   E1                     POP   HL   ; TOS: the data stack is as the last line left it
04B1   F7                     RST   30h   ; (its return address is thrown away)
04B2                             ; ^L: list from line n. DE = the number of the line at HL.
04B2   CD 77 02     CLIST:    CALL   rdnum   ; HL = n, or 0 if there was none:
04B5   7C                     LD   A,H   
04B6   B5                     OR   L   
04B7   20 01                  JR   NZ,li0   
04B9   2C                     INC   L   ;   then from line 1
04BA   E5           LI0:      PUSH   HL   
04BB   CD F5 04               CALL   find   
04BE   D1                     POP   DE   
04BF   7E           LI1:      LD   A,(HL)   
04C0   B7                     OR   A   
04C1   28 DA                  JR   Z,gedit   ; the end of the text
04C3   CD 06 FF               CALL   rawk   
04C6   28 09                  JR   Z,li3   ; no key: carry on
04C8   FE 03                  CP   3   
04CA   C4 02 04               CALL   NZ,ekey   ; any key but Ctrl-C: wait for one more
04CD   FE 03                  CP   3   
04CF   28 CC                  JR   Z,gedit   ; Ctrl-C, first or second, ends the list
04D1   E5           LI3:      PUSH   HL   
04D2   D5                     PUSH   DE   
04D3   EB                     EX   DE,HL   
04D4   CD D4 02               CALL   pdec   ; the line's number,
04D7   3E 20                  LD   A," "   
04D9   EF                     RST   28h   ;   a space,
04DA   D1                     POP   DE   
04DB   E1                     POP   HL   
04DC   13                     INC   DE   
04DD   CD 0D 05               CALL   prl   ;   and the line
04E0   18 DD                  JR   li1   
04E2   C3 62 03     GED1:     JP   edit   
04E5                             ; delln: take line n (in HL) out: copy everything after it down over it.
04E5   CD F5 04     DELLN:    CALL   find   
04E8   54                     LD   D,H   
04E9   5D                     LD   E,L   
04EA   CD 03 05               CALL   nxl   ; HL -> the next line
04ED   7E           DE1:      LD   A,(HL)   
04EE   12                     LD   (DE),A   
04EF   23                     INC   HL   
04F0   13                     INC   DE   
04F1   B7                     OR   A   
04F2   20 F9                  JR   NZ,de1   
04F4   C9                     RET      
04F5                             ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
04F5                             ; of the text if there are fewer lines (or the number is 0). Keeps BC.
04F5   EB           FIND:     EX   DE,HL   
04F6   21 00 83               LD   HL,PROG   
04F9   1B           FI1:      DEC   DE   
04FA   7A                     LD   A,D   
04FB   B3                     OR   E   
04FC   C8                     RET   Z   
04FD   CD 03 05               CALL   nxl   
0500   20 F7                  JR   NZ,fi1   
0502   C9                     RET      
0503                             ; nxl: step HL over one line, to just past its LF (and return not-zero), or
0503                             ; stop at the NUL that ends the text (and return zero).
0503   7E           NXL:      LD   A,(HL)   
0504   B7                     OR   A   
0505   C8                     RET   Z   
0506   23                     INC   HL   
0507   FE 0A                  CP   10   
0509   20 F8                  JR   NZ,nxl   
050B   B7                     OR   A   
050C   C9                     RET      
050D                             ; prl: print the line at HL, to its LF; HL -> just past it.
050D   7E           PRL:      LD   A,(HL)   
050E   EF                     RST   28h   
050F   7E                     LD   A,(HL)   
0510   23                     INC   HL   
0511   FE 0A                  CP   10   
0513   20 F8                  JR   NZ,prl   
0515   C9                     RET      
0516                          ENDIF      
0516                          IF   EDGEN   
0516                             ; ^R, generic: what comes in from now until ^Z is the program. A CR is
0516                             ; stored as CR LF; a LF right after a line end is dropped (it is the CR's
0516                             ; own, or an empty line's), and a LF anywhere else ends a line too. A last
0516                             ; line with no end is given one. Nothing is echoed, and there is no check
0516                             ; for running out of memory.
0516   21 FF 82     CREAD:    LD   HL,PROG-1   
0519   36 0A                  LD   (HL),10   ; (as if a line had just ended: the byte is
051B   23                     INC   HL   ;   the line buffer's last, and spare)
051C   CD 02 04     RD1:      CALL   ekey   
051F   4F                     LD   C,A   
0520   FE 1A                  CP   1Ah   
0522   20 02                  JR   NZ,rd2   
0524   3E 0A                  LD   A,10   ; ^Z ends the last line, as a LF would
0526   FE 0A        RD2:      CP   10   
0528   20 07                  JR   NZ,rd3   
052A   2B                     DEC   HL   
052B   BE                     CP   (HL)   
052C   23                     INC   HL   
052D   28 0B                  JR   Z,rd4   ; straight after a line end: dropped
052F   3E 0D                  LD   A,13   ; anywhere else it ends the line
0531   77           RD3:      LD   (HL),A   
0532   23                     INC   HL   
0533   FE 0D                  CP   13   
0535   20 03                  JR   NZ,rd4   
0537   36 0A                  LD   (HL),10   ; after a CR goes a LF
0539   23                     INC   HL   
053A   79           RD4:      LD   A,C   
053B   FE 1A                  CP   1Ah   
053D   20 DD                  JR   NZ,rd1   
053F   36 00                  LD   (HL),0   
0541   18 9F                  JR   ged1   
0543                             ; ^W, generic: the text is printed as it is, for the terminal to capture.
0543   21 00 83     CWRITE:   LD   HL,PROG   
0546   7E           CW1:      LD   A,(HL)   
0547   B7                     OR   A   
0548   28 98                  JR   Z,ged1   
054A   EF                     RST   28h   
054B   23                     INC   HL   
054C   18 F8                  JR   cw1   
054E                          ENDIF      
054E                          IF   EDITOR*CPM   
                    CFCB:     EQU   005Ch   ; the file's name is kept here, where the CCP
                                 ;   put the one from the command line
                                 ; ^R, CP/M: read the file. A name typed before the key is the file's name
                                 ; from now on.
                    CREAD:    CALL   setname   
                              CALL   load   
                              JP   edit   
                                 ; ^W, CP/M: write the file: delete the old one, make it anew, write the
                                 ; text in records of 128 bytes, and close it. The text's NUL and the 127
                                 ; bytes after it are set to ^Z meanwhile, which pads the last record. (A
                                 ; full disk or directory is not noticed: the calls fail and that is all.)
                    CWRITE:   CALL   setname   
                              LD   C,19   ; delete
                              CALL   fbdos   
                              LD   C,22   ; make
                              CALL   fbdos   
                              LD   HL,PROG   
                              XOR   A   
                    CW1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,cw1   
                              DEC   HL   ; HL -> the NUL
                              PUSH   HL   
                              LD   B,128   
                    CW2:      LD   (HL),1Ah   
                              INC   HL   
                              DJNZ   cw2   
                              POP   HL   
                              LD   DE,PROG   
                    CW3:      LD   A,E   ; a record that starts before the end is written
                              SUB   L   
                              LD   A,D   
                              SBC   A,H   
                              JR   NC,cw4   
                              PUSH   HL   
                              LD   C,21   ; write, from where the record lies
                              CALL   frec   
                              POP   HL   
                              JR   cw3   
                    CW4:      LD   (HL),0   ; the NUL again
                              LD   C,16   ; close
                              CALL   fbdos   
                              JP   edit   
                                 ; frec: BDOS function C (read or write a record) with the 128 bytes at DE.
                                 ; Returns A = the BDOS's answer, HL = DE and DE = DE + 128.
                    FREC:     PUSH   DE   
                              PUSH   BC   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              POP   BC   
                              CALL   fbdos   
                              POP   HL   
                              LD   DE,128   
                              EX   DE,HL   
                              ADD   HL,DE   
                              EX   DE,HL   
                              RET      
                                 ; setname: if a name was typed (the line does not start with its CR), put it
                                 ; in the FCB: up to 8 characters, a dot, up to 3 more, in capitals. The drive
                                 ; is the current one. Then, name or no name, clear the FCB after the name,
                                 ; as it must be before a file is opened or made.
                    SETNAME:   LD   DE,LINEBUF   
                              LD   A,(DE)   
                              CP   13   
                              JR   Z,fcbclr   
                              LD   HL,CFCB   
                              LD   (HL),0   ; the current drive
                              LD   B,11   
                    SN1:      INC   L   
                              LD   (HL)," "   
                              DJNZ   sn1   
                              LD   L,CFCB+1   
                    SN2:      LD   A,(DE)   
                              INC   DE   
                              CP   13   
                              JR   Z,fcbclr   
                              CP   "."   
                              JR   NZ,sn3   
                              LD   L,CFCB+9   ; the type
                              JR   sn2   
                    SN3:      CP   "a"   
                              JR   C,sn4   
                              AND   5Fh   ; a capital
                    SN4:      LD   (HL),A   
                              INC   L   
                              JR   sn2   
                    FCBCLR:   LD   HL,CFCB+12   
                              LD   B,24   
                    FC1:      LD   (HL),0   
                              INC   HL   
                              DJNZ   fc1   
                              RET      
                                 ; fbdos: BDOS function C on the file
                    FBDOS:    LD   DE,CFCB   
                              JP   BDOS   
                                 ; load: read the file into PROG. No such file: no program. The text ends at
                                 ; the file"s first ^Z (1Ah), which pads a text file"s last record; one more
                                 ; goes after the last record, so the search always stops. And every line
                                 ; must end in LF: a last line without one is given a CR LF. (The FCB is
                                 ; clear after its name: the CCP left it so, or setname did.)
                    LOAD:     LD   C,15   ; open (no such file: the first read fails
                              CALL   fbdos   ;   too)
                              LD   DE,PROG   
                    LD1:      LD   C,20   ; read the next 128 bytes
                              CALL   frec   
                              OR   A   
                              JR   Z,ld1   
                              LD   (HL),1Ah   ; (HL = where the record that failed would be)
                              LD   HL,PROG-1   
                              LD   A,10   ; (a file with no text needs nothing added)
                    TR1:      INC   HL   
                              LD   E,A   ; E = the character before this one
                              LD   A,(HL)   
                              CP   1Ah   
                              JR   NZ,tr1   
                              LD   A,E   
                              CP   10   
                              JR   Z,tr2   
                              LD   (HL),13   
                              INC   HL   
                              LD   (HL),10   
                              INC   HL   
                    TR2:      LD   (HL),0   
                              RET      
054E                          ENDIF      
054E                             ; =============================================================================
054E                          IF   CPM   
                                 ; The RAM pages follow the image; the heap may grow to the BDOS.
                    START:       
054E                          ENDIF      
054E                          IF   CPM*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
                                 ; is held back.
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
054E                          ENDIF      
054E                          IF   CPM   
                              LD   HL,vecs   ; the RST routines go down into page zero
                              LD   DE,0008h   
                              LD   BC,vecend-vecs   
                              LDIR      
054E                          ENDIF      
054E                          IF   CPM*EDITOR   
                              CALL   load   ; the file named on the command line
                              JP   edit0   
054E                          ENDIF      
054E                          IF   CPM*(1-EDITOR)   
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:      LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
                              JP   st2   
054E                          ENDIF      
054E                          IF   CPM   
                                 ; RAM pages, after the image
                    RSPAGE:   EQU   (imgend + 255) / 256   
                    DSPAGE:   EQU   RSPAGE + 1   
                    LETPAGE:   EQU   RSPAGE + 2   
                    PROG:     EQU   LETPAGE*256 + 256   
054E                          ENDIF      
054E                IMGEND:      


