                              LD   A,(0007h)   ; the BDOS page is the limit
                              LD   H,A   
                              LD   L,0   
                              DEC   HL   
0573                          ENDIF      
0573                          IF   EDITOR   
0573   B7                     OR   A   
0574   ED 52                  SBC   HL,DE   
0576   CD 4B 03               CALL   pnl   
0579   46 72 65 65 20 22      DB   "Free ",22h   
057F   CD 7A 02               CALL   pdec   ; the room left for text and heap
0582   CD 4B 03               CALL   pnl   
0585   22                     DB   22h   
0586   C3 98 03     GED1:     JP   edit   
0589                             ; delln: take line n (in HL) out: copy everything after it down over it.
0589   CD 99 05     DELLN:    CALL   find   
058C   54                     LD   D,H   
058D   5D                     LD   E,L   
058E   CD A7 05               CALL   nxl   ; HL -> the next line
0591   7E           DE1:      LD   A,(HL)   
0592   12                     LD   (DE),A   
0593   23                     INC   HL   
0594   13                     INC   DE   
0595   B7                     OR   A   
0596   20 F9                  JR   NZ,de1   
0598   C9                     RET      
0599                             ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
0599                             ; of the text if there are fewer lines (or the number is 0). Keeps BC.
0599   EB           FIND:     EX   DE,HL   
059A   21 00 83               LD   HL,PROG   
059D   1B           FI1:      DEC   DE   
059E   7A                     LD   A,D   
059F   B3                     OR   E   
05A0   C8                     RET   Z   
05A1   CD A7 05               CALL   nxl   
05A4   20 F7                  JR   NZ,fi1   
05A6   C9                     RET      
05A7                             ; nxl: step HL over one line, to just past its LF (and return not-zero), or
05A7                             ; stop at the NUL that ends the text (and return zero).
05A7   7E           NXL:      LD   A,(HL)   
05A8   B7                     OR   A   
05A9   C8                     RET   Z   
05AA   23                     INC   HL   
05AB   FE 0A                  CP   10   
05AD   20 F8                  JR   NZ,nxl   
05AF   B7                     OR   A   
05B0   C9                     RET      
05B1                             ; prl: print the line at HL, to its LF; HL -> just past it.
05B1   7E           PRL:      LD   A,(HL)   
05B2   EF                     RST   28h   
05B3   7E                     LD   A,(HL)   
05B4   23                     INC   HL   
05B5   FE 0A                  CP   10   
05B7   20 F8                  JR   NZ,prl   
05B9   C9                     RET      
05BA                          ENDIF      
05BA                          IF   EDGEN   
05BA                             ; ^R, generic: what comes in from now until ^Z is the program. A CR is
05BA                             ; stored as CR LF; a LF right after a line end is dropped (it is the CR's
05BA                             ; own, or an empty line's), and a LF anywhere else ends a line too. A last
05BA                             ; line with no end is given one. Nothing is echoed, and there is no check
05BA                             ; for running out of memory.
05BA   21 FF 82     CREAD:    LD   HL,PROG-1   
05BD   3E 0A                  LD   A,10   
05BF   FE                     DB   0FEh   ; (CP n: steps over the LD A,13)
05C0   3E 0D        RD1:      LD   A,13   ; a LF alone ends a line
05C2   77           RD2:      LD   (HL),A   
05C3   23                     INC   HL   
05C4   FE 0D                  CP   13   
05C6   3E 0A                  LD   A,10   
05C8   28 F8                  JR   Z,rd2   ; after a CR goes a LF
05CA   CD 38 04     RD3:      CALL   ekey   
05CD   FE 1A                  CP   1Ah   
05CF   28 0B                  JR   Z,rd4   
05D1   FE 0A                  CP   10   
05D3   20 ED                  JR   NZ,rd2   
05D5   2B                     DEC   HL   
05D6   BE                     CP   (HL)   
05D7   23                     INC   HL   
05D8   28 F0                  JR   Z,rd3   ; (the LF is dropped)
05DA   18 E4                  JR   rd1   
05DC   2B           RD4:      DEC   HL   
05DD   7E                     LD   A,(HL)   
05DE   23                     INC   HL   
05DF   FE 0A                  CP   10   
05E1   28 06                  JR   Z,rd5   
05E3   36 0D                  LD   (HL),13   
05E5   23                     INC   HL   
05E6   36 0A                  LD   (HL),10   
05E8   23                     INC   HL   
05E9   36 00        RD5:      LD   (HL),0   
05EB   18 99                  JR   ged1   
05ED                             ; ^W, generic: the text is printed as it is, for the terminal to capture.
05ED   21 00 83     CWRITE:   LD   HL,PROG   
05F0   7E           CW1:      LD   A,(HL)   
05F1   B7                     OR   A   
05F2   28 92                  JR   Z,ged1   
05F4   EF                     RST   28h   
05F5   23                     INC   HL   
05F6   18 F8                  JR   cw1   
05F8                          ENDIF      
05F8                          IF   EDITOR*CPM   
                    CFCB:     EQU   005Ch   ; the file's name is kept here, where the CCP
                                 ;   put the one from the command line
                                 ; ^R, CP/M: read the file. A name typed before the key is the file's name
                                 ; from now on.
                    CREAD:    CALL   setname   
                              CALL   load   
                              JP   edit   
                                 ; ^W, CP/M: write the file: delete the old one, make it anew, write the
                                 ; text in records of 128 bytes, and close it. The text's NUL and the 127
                                 ; bytes after it are set to ^Z meanwhile, which pads the last record.
                    CWRITE:   CALL   setname   
                              CALL   fcbclr   
                              LD   C,19   ; delete
                              CALL   fbdos   
                              LD   C,22   ; make
                              CALL   fbdos   
                              INC   A   
                              JP   Z,edit   ; no room in the directory
                              LD   HL,PROG   
                              XOR   A   
                    CW1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,cw1   
                              DEC   HL   ; HL -> the NUL
                              PUSH   HL   
                              LD   B,128   
                    CW2:      LD   (HL),1Ah   
                              INC   HL   
                              DJNZ   cw2   
                              POP   HL   
                              LD   DE,PROG   
                    CW3:      LD   A,E   ; a record that starts before the end is written
                              SUB   L   
                              LD   A,D   
                              SBC   A,H   
                              JR   NC,cw4   
                              PUSH   HL   
                              PUSH   DE   
                              LD   C,26   ; set the DMA address: the record is written
                              CALL   BDOS   ;   from where it lies
                              LD   C,21   ; write
                              CALL   fbdos   
                              POP   HL   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              POP   HL   
                              JR   cw3   
                    CW4:      LD   (HL),0   ; the NUL again
                              LD   C,16   ; close
                              CALL   fbdos   
                              JP   edit   
                                 ; setname: if a name was typed (the line does not start with its CR), put it
                                 ; in the CFCB: up to 8 characters, a dot, up to 3 more, in capitals. The drive
                                 ; is the current one.
                    SETNAME:   LD   DE,LINEBUF   
                              LD   A,(DE)   
                              CP   13   
                              RET   Z   
                              LD   HL,CFCB   
                              LD   (HL),0   ; the current drive
                              LD   B,11   
                    SN1:      INC   L   
                              LD   (HL)," "   
                              DJNZ   sn1   
                              LD   L,CFCB+1   
                    SN2:      LD   A,(DE)   
                              INC   DE   
                              CP   13   
                              RET   Z   
                              CP   "."   
                              JR   NZ,sn3   
                              LD   L,CFCB+9   ; the type
                              JR   sn2   
                    SN3:      CP   "a"   
                              JR   C,sn4   
                              AND   5Fh   ; a capital
                    SN4:      LD   (HL),A   
                              INC   L   
                              JR   sn2   
                                 ; fcbclr: clear the CFCB after its name, as it must be before a file is opened
                    FCBCLR:   LD   HL,CFCB+12   
                              LD   B,24   
                    FC1:      LD   (HL),0   
                              INC   HL   
                              DJNZ   fc1   
                              RET      
                                 ; fbdos: BDOS function C on the file
                    FBDOS:    LD   DE,CFCB   
                              JP   BDOS   
                                 ; load: read the file into PROG. No such file: no program. The text ends at
                                 ; the file"s first ^Z (1Ah), which pads a text file"s last record; one more
                                 ; goes after the last record, so the search always stops. And every line
                                 ; must end in LF: a last line without one is given a CR LF.
                    LOAD:     CALL   fcbclr   
                              LD   C,15   ; open (no such file: the first read fails
                              CALL   fbdos   ;   too)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   C,20   ; read the next 128 bytes
                              CALL   fbdos   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:      LD   (HL),1Ah   
                              LD   HL,PROG-1   
                              LD   A,10   ; (a file with no text needs nothing added)
                    TR1:      INC   HL   
                              LD   E,A   ; E = the character before this one
                              LD   A,(HL)   
                              CP   1Ah   
                              JR   NZ,tr1   
                              LD   A,E   
                              CP   10   
                              JR   Z,tr2   
                              LD   (HL),13   
                              INC   HL   
                              LD   (HL),10   
                              INC   HL   
                    TR2:      LD   (HL),0   
                              RET      
05F8                          ENDIF      
05F8                             ; =============================================================================
05F8                             ;  CP/M startup (the generic build starts at address 0: see st0)
05F8                             ; =============================================================================
05F8                          IF   CPM   
                                 ; The RAM pages follow the image; the heap may grow to the BDOS.
                    START:       
05F8                          ENDIF      
05F8                          IF   CPM*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
                                 ; is held back.
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
05F8                          ENDIF      
05F8                          IF   CPM   
                              LD   HL,vecs   ; the RST routines go down into page zero
                              LD   DE,0008h   
                              LD   BC,vecend-vecs   
                              LDIR      
05F8                          ENDIF      
05F8                          IF   CPM*EDITOR   
                              CALL   load   ; the file named on the command line
                              JP   edit0   
05F8                          ENDIF      
05F8                          IF   CPM*(1-EDITOR)   
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:      LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
                              JP   st2   
05F8                          ENDIF      
05F8                          IF   CPM   
                                 ; RAM pages, after the image
                    RSPAGE:   EQU   (imgend + 255) / 256   
                    DSPAGE:   EQU   RSPAGE + 1   
                    LETPAGE:   EQU   RSPAGE + 2   
                    PROG:     EQU   LETPAGE*256 + 256   
05F8                          ENDIF      
05F8                IMGEND:      


