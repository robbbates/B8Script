  1033 00000499 8D4C240C            <1>         lea     ecx,[esp+12]
  1034 0000049D 8D54241C            <1>         lea     edx,[esp+28]
  1035 000004A1 6A00                <1>         push    0                       ; lpOverlapped
  1036 000004A3 51                  <1>         push    ecx                     ; lpNumberOfBytesWritten
  1037 000004A4 6A01                <1>         push    1
