                              POP   HL   ; (the two the other way round: the same)
                              JP   mulq   
                    FS_OPEN:      ; (
                              LD   A,D   
                              OR   E   
                              POP   HL   
                              JR   Z,fs_op0   
                              PUSH   BC   ; the block start
                              JP   rpushn   
                    FS_OP0:   CALL   skip   
                              ;*Macro unroll:  NEXTF
