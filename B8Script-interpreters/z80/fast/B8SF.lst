0430   ED 52                  SBC   HL,DE   
0432   30 02                  JR   NC,uvr9   
0434   19                     ADD   HL,DE   
0435   0D                     DEC   C   
0436   0C           UVR9:     INC   C   
0437   CB 21                  SLA   C   
0439   17                     RLA      
043A   ED 6A                  ADC   HL,HL   
043C   ED 52                  SBC   HL,DE   
043E   30 02                  JR   NC,uvr10   
0440   19                     ADD   HL,DE   
0441   0D                     DEC   C   
0442   0C           UVR10:    INC   C   
0443   CB 21                  SLA   C   
0445   17                     RLA      
0446   ED 6A                  ADC   HL,HL   
0448   ED 52                  SBC   HL,DE   
044A   30 02                  JR   NC,uvr11   
044C   19                     ADD   HL,DE   
044D   0D                     DEC   C   
044E   0C           UVR11:    INC   C   
