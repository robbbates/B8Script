  1187 000004F2 3DFEFFFF7F          <1>         cmp     eax,7FFFFFFEh
  1188 000004F7 7320                <1>         jae     .wk1                    ; 1 ms or more, and not INFINITE,
  1189 000004F9 85FF                <1>         test    edi,edi                 ;   uses it
