  1100 000003F7 74EC                <1>         je      .ct0                    ; (the zero flag takes the JZ there)
  1101 000003F9 84C0                <1>         test    al,al
  1102 000003FB 7405                <1>         jz      .ct3
  1103 000003FD A27A014100          <1>         mov     [ARENA+HELD],al
  1104 00000402 B003                <1> .ct3:   mov     al,3
  1105 00000404 84C0                <1>         test    al,al
  1106 00000406 C3                  <1>         ret
  1107                              <1> 
  1108                              <1> %if CHECKED=0
  1109                              <1>  %if EDITOR
  1110                              <1> brk     equ     edit0                   ; the editor: back, both stacks cleared
  1111                              <1>  %else
  1112                              <1> brk     equ     exit                    ; the runner stops without a word
  1113                              <1>  %endif
  1114                              <1> %else
  1115                              <1> brk     equ     e_break                 ; the checked build reports B
  1116                              <1> %endif
  1117                              <1> %if EDITOR
  1118                              <1> SKEND   equ     skend                   ; a program that ends goes back to the
  1119                              <1> %else                                   ;   editor, also when it ends inside skip
  1120                              <1> SKEND   equ     exit
  1121                              <1> %endif
  1122                              <1> 
  1123                              <1> ; endprog: the inner loop read the NUL that ends the program. In the checked
  1124                              <1> ; build an IP of 0001h means the NUL at 0000h, where every undefined word's
  1125                              <1> ; cell points: U, with the call undone, so the place is the call itself.
  1126                              <1> endprog:
  1127                              <1> %if CHECKED
  1128                              <1>         cmp     si,1                    ; (ESI is in the arena)
  1129                              <1>         jne     .ep1
  1130                              <1>         mov     esi,[edi]
  1131                              <1>         scasd
  1132                              <1>         mov     al,'U'
  1133                              <1>         jmp     error
  1134                              <1> .ep1:
  1135                              <1> %endif
  1136                              <1> %if EDITOR
  1137                              <1>         jmp     edend
  1138                              <1> %else
  1139 00000407 E9AEFCFFFF          <1>         jmp     exit
  1140                              <1> %endif
  1141                              <1> 
  1142                              <1> 
  1143                              <1> %if CHECKED+EDITOR
  1144                              <1> ; pstk: the two stack lines:  Stk n: the top 8 cells at most, bottom to top
  1145                              <1> ;                             Rtn n
  1146                              <1> ; TOS must be in memory with the rest (pushed), and pstk is called: so the
  1147                              <1> ; top cell is at [ESP+4] here, and the depth is 2 less than the dwords
  1148                              <1> ; down to V_DSTOP (the call, and the cell that stands for TOS when the stack
  1149                              <1> ; is empty).
  1150                              <1> pstk:   call    pmsg
  1151                              <1>         db      '/M/JStk ',22h
  1152                              <1>         mov     eax,[V(v_dstop)]
  1153                              <1>         sub     eax,esp
  1154                              <1>         shr     eax,2
  1155                              <1>         dec     eax
  1156                              <1>         dec     eax
  1157                              <1>         push    eax
  1158                              <1>         call    pdec                    ; the depth
  1159                              <1>         mov     al,':'
  1160                              <1>         call    putc
  1161                              <1>         pop     ecx
  1162                              <1>         cmp     ecx,9
  1163                              <1>         jb      .ps1
  1164                              <1>         call    pmsg
  1165                              <1>         db      ' ...',22h
  1166                              <1>         push    8
  1167                              <1>         pop     ecx
  1168                              <1> .ps1:   jecxz   .ps3                    ; ECX = the number of cells to show
  1169                              <1> .ps2:   mov     al,' '
  1170                              <1>         call    putc
  1171                              <1>         mov     eax,[esp+ecx*4]
  1172                              <1>         push    ecx
  1173                              <1>         call    psgn
  1174                              <1>         pop     ecx
  1175                              <1>         loop    .ps2
  1176                              <1> .ps3:   call    pmsg
  1177                              <1>         db      '/M/JRtn ',22h
  1178                              <1>         mov     eax,RSTOP
  1179                              <1>         sub     eax,edi
  1180                              <1>         shr     eax,2
  1181                              <1>         jmp     pdec
  1182                              <1> %endif
  1183                              <1> 
  1184                              <1> ; =============================================================================
  1185                              <1> ;  The line editor (EDITOR = 1)
  1186                              <1> ;
  1187                              <1> ;  The interpreter starts here, and a program that ends comes back here.
  1188                              <1> ;  There is no prompt. It follows the spec's suggested standard for a line
  1189                              <1> ;  editor (docs/b8script.md, Environments), and is the Z80's editor, key for
  1190                              <1> ;  key. Type a line and press Return:
  1191                              <1> ;
  1192                              <1> ;    n text    put the text in as line n; the lines from n on move down. A
  1193                              <1> ;              number past the end (or 0) adds the line at the end.
  1194                              <1> ;    n         take line n out
  1195                              <1> ;    anything else is run at once, as B8Script. (Start such a line with a
  1196                              <1> ;    space if it would begin with a digit.)
  1197                              <1> ;
  1198                              <1> ;  A command key ends the line too, and takes what was typed as its argument:
  1199                              <1> ;
  1200                              <1> ;    ^G        run the program
  1201                              <1> ;    n ^L      list from line n (no number: all of it). Any key holds the
  1202                              <1> ;              list until another key is pressed; Ctrl-C ends it.
  1203                              <1> ;    n ^E      put line n in the input line; Return puts it back, changed
  1204                              <1> ;    name ^R   read the file of that name (no name: the current one: the
  1205                              <1> ;              one from the command line, or the last one typed)
  1206                              <1> ;    name ^W   write the program to that file (no name: the current one)
  1207                              <1> ;    ^N ^N     new: no program (the key twice in a row)
  1208                              <1> ;    ^V        view: the build, both stacks, and the program's size, lines
  1209                              <1> ;              and free memory
  1210                              <1> ;    ^X        leave
  1211                              <1> ;
  1212                              <1> ;  In the line: ^B and ^F, or the left and right arrow keys, move the cursor;
  1213                              <1> ;  a character goes in at the cursor; Backspace and DEL take out the one
  1214                              <1> ;  before it; Esc drops the line (after Esc it waits 5 ms for a '[': Esc [ C
  1215                              <1> ;  and Esc [ D are right and left too). Only CR, LF, BS and printing
  1216                              <1> ;  characters are sent to the terminal.
  1217                              <1> ;
  1218                              <1> ;  Lines are counted, not numbered. A typed line holds 125 characters; the
  1219                              <1> ;  one character after a line number separates it from the text and is not
  1220                              <1> ;  stored. The text is kept as typed, each line ending in CR LF, at PROG. A
  1221                              <1> ;  file is read up to its first ^Z, and a last line with no line end is
  1222                              <1> ;  given one; it is written as it is, with no padding.
  1223                              <1> ;
  1224                              <1> ;  What lasts from one line to the next: the program, the words, the
  1225                              <1> ;  variables and the data stack (TOS is kept pushed while the editor runs).
  1226                              <1> ;  An error or a break clears both stacks. The return stack starts empty for
  1227                              <1> ;  every line.
  1228                              <1> ;
  1229                              <1> ;  Registers in the editor: EBX = the cursor, EDX = the end of the line
  1230                              <1> ;  (pointers into the line buffer); EDI is free (edit resets it).
  1231                              <1> ; =============================================================================
  1232                              <1> %if EDITOR
  1233                              <1> ; ^F, right arrow: one to the right, by printing the character there
  1234                              <1> right:  cmp     ebx,edx
  1235                              <1>         je      ed1                     ; at the end
  1236                              <1>         mov     al,[ebx]
  1237                              <1>         inc     ebx
  1238                              <1>         jmp     short lf1
  1239                              <1> 
  1240                              <1> ; Esc: alone it drops the line. An arrow key sends Esc [ and a letter, so
  1241                              <1> ; wait about 5 ms for a second key: after a '[' read on to the letter that
  1242                              <1> ; ends the sequence, and act on C (right) and D (left).
  1243                              <1> esc:    push    5
  1244                              <1>         pop     eax
  1245                              <1>         call    waitk
  1246                              <1>         jnz     .es2
  1247                              <1>         call    fin                     ; no second key: the line is dropped
  1248                              <1>         jmp     edit
  1249                              <1> .es2:   cmp     al,'['
  1250                              <1>         jne     ed1                     ; not a sequence known here
  1251                              <1> .es3:   call    ekey
  1252                              <1>         cmp     al,40h
  1253                              <1>         jb      .es3                    ; (its parameters)
  1254                              <1>         sub     al,'C'
  1255                              <1>         je      right
  1256                              <1>         dec     al                      ; 'D'?
  1257                              <1>         jne     ed1                     ; no: on into left
  1258                              <1> ; ^B, left arrow: the cursor goes one to the left
  1259                              <1> left:   cmp     bl,80h
  1260                              <1>         je      ed1                     ; at the start
  1261                              <1>         dec     ebx
  1262                              <1>         mov     al,8
  1263                              <1> lf1:    call    putc
  1264                              <1>         jmp     ed1
  1265                              <1> 
  1266                              <1> ; edit0: an error or a break: both stacks are cleared.
  1267                              <1> ; skend: a program that ended inside skip: its return address goes.
  1268                              <1> ; edend: a program that ended: TOS joins the rest of the data stack.
  1269                              <1> edit0:  mov     esp,[V(v_dstop)]
  1270                              <1>  %if CHECKED
  1271                              <1>         push    -11                     ; the report went to stderr: back to
  1272                              <1>         call    [V(iat_GetStdHandle)]   ;   stdout
  1273                              <1>         mov     [V(v_outh)],eax
  1274                              <1>  %endif
  1275                              <1>         db      3Ch                     ; (CMP AL,n: steps over the POP)
  1276                              <1> skend:  pop     eax
  1277                              <1> edend:  push    ebx
  1278                              <1> ; edit: start a new input line.
  1279                              <1> edit:   mov     edi,RSTOP               ; the return stack is empty
  1280                              <1>         xor     eax,eax
  1281                              <1>         mov     [ARENA+HELD],ax         ; no key is held, and the break key is on
  1282                              <1>         mov     [V(v_edln)],eax         ; no line is being edited
  1283                              <1>         mov     ebx,ARENA+LINEBUF       ; EBX = the cursor,
  1284                              <1>         mov     edx,ebx                 ;   EDX = the end of the line
  1285                              <1> ed1:    call    ekey
  1286                              <1>         cmp     al,7Fh
  1287                              <1>         je      bsp                     ; DEL
  1288                              <1>         cmp     al,' '
  1289                              <1>         jae     insc
  1290                              <1>         cmp     al,9
  1291                              <1>         je      insc                    ; Tab is text
  1292                              <1>         cmp     al,8
  1293                              <1>         je      bsp
  1294                              <1>         cmp     al,2
  1295                              <1>         je      left                    ; ^B
  1296                              <1>         cmp     al,6
  1297                              <1>         je      right                   ; ^F
  1298                              <1>         cmp     al,1Bh
  1299                              <1>         je      esc
  1300                              <1>         push    edi                     ; a command key? Look it up
  1301                              <1>         mov     edi,ckeys
  1302                              <1>         push    NCMD
  1303                              <1>         pop     ecx
  1304                              <1>         repne   scasb
  1305                              <1>         pop     edi
  1306                              <1>         jne     ed1                     ; no: the key is ignored
  1307                              <1>         movzx   eax,word [ctabr+ecx*2]  ; the command's address: fin returns
  1308                              <1>         add     eax,IB                  ;   to it
  1309                              <1>         push    eax
  1310                              <1> ; fin: end the input line: CR LF and a NUL after it, and a new line on the
  1311                              <1> ; terminal. Leaves ESI -> the line.
  1312                              <1> fin:    mov     word [edx],0A0Dh
  1313                              <1>         mov     esi,edx
  1314                              <1>         call    prl                     ; (prints the CR LF)
  1315                              <1>         mov     byte [esi],0
  1316                              <1>         mov     esi,ARENA+LINEBUF
  1317                              <1>         ret
  1318                              <1> 
  1319                              <1> ; Backspace, DEL: the character before the cursor goes. The cursor moves
  1320                              <1> ; left, the rest of the line moves down over it, and the last place (now a
  1321                              <1> ; space) is printed over along with the rest.
  1322                              <1> bsp:    cmp     bl,80h
  1323                              <1>         je      ed1                     ; at the start
  1324                              <1>         dec     ebx
  1325                              <1>         mov     al,8
  1326                              <1>         call    putc
  1327                              <1>         mov     ecx,ebx
  1328                              <1> .bs1:   mov     al,[ecx+1]
  1329                              <1>         mov     [ecx],al
  1330                              <1>         inc     ecx
  1331                              <1>         cmp     ecx,edx
  1332                              <1>         jne     .bs1
  1333                              <1>         mov     byte [ecx-1],' '
  1334                              <1>         dec     edx
  1335                              <1>         jmp     short ic2
  1336                              <1> ; A character goes in at the cursor: it ripples up through the rest of the
  1337                              <1> ; line, the cursor moves on, and the rest is printed again.
  1338                              <1> insc:   cmp     dl,0FDh
  1339                              <1>         je      ed1                     ; the line is full: 125 characters
  1340                              <1>         call    putc
  1341                              <1>         mov     ecx,ebx
  1342                              <1> .ic1:   xchg    al,[ecx]
  1343                              <1>         inc     ecx
  1344                              <1>         cmp     ecx,edx
  1345                              <1>         jbe     .ic1
  1346                              <1>         inc     ebx
  1347                              <1>         inc     edx
  1348                              <1>         mov     ecx,edx
  1349                              <1> ic2:    call    tail
  1350                              <1>         jmp     ed1
  1351                              <1> ; tail: print the line from the cursor to ECX, and bring the cursor back
  1352                              <1> ; with backspaces. Nothing at all if the cursor is at ECX.
  1353                              <1> tail:   mov     esi,ebx
  1354                              <1> .ta1:   cmp     esi,ecx
  1355                              <1>         je      .ta2
  1356                              <1>         lodsb
  1357                              <1>         call    putc
  1358                              <1>         jmp     .ta1
  1359                              <1> .ta2:   cmp     esi,ebx
  1360                              <1>         je      .ta3
  1361                              <1>         mov     al,8
  1362                              <1>         call    putc
  1363                              <1>         dec     esi
  1364                              <1>         jmp     .ta2
  1365                              <1> .ta3:   ret
  1366                              <1> 
  1367                              <1> ; ekey: wait for a key
  1368                              <1> ekey:   or      eax,-1
  1369                              <1>         jmp     waitk
  1370                              <1> 
  1371                              <1> ; The command keys, and where each goes (after fin). REPNE SCASB leaves ECX
  1372                              <1> ; = the number of keys after the one found, so the table is backwards. (The
  1373                              <1> ; addresses are kept as RVAs, which fit in a word.)
  1374                              <1> ckeys:  db      13, 7, 12, 5, 18, 23, 14, 22, 24
  1375                              <1> NCMD    equ     $-ckeys
  1376                              <1> ctabr:  dw      exit-IB                 ; ^X
  1377                              <1>         dw      cview-IB                   ; ^V
  1378                              <1>         dw      cnew-IB                 ; ^N
  1379                              <1>         dw      cwrite-IB                  ; ^W
  1380                              <1>         dw      cread-IB                   ; ^R
  1381                              <1>         dw      cedln-IB                   ; ^E
  1382                              <1>         dw      clist-IB                   ; ^L
  1383                              <1>         dw      crun-IB                 ; ^G
  1384                              <1>         dw      cret-IB                 ; Return
  1385                              <1> 
  1386                              <1> ; ^N ^N: no program, if the next key is ^N too
  1387                              <1> cnew:   call    ekey
  1388                              <1>         cmp     al,14
  1389                              <1>         jne     gedit
  1390                              <1>         mov     byte [ARENA+PROG],0
  1391                              <1> gedit:  jmp     edit
  1392                              <1> 
  1393                              <1> ; ^E: line n goes into the input line, to be changed. V_EDLN remembers
  1394                              <1> ; which line it was: Return puts the text back in its place.
  1395                              <1> cedln:  call    rdnum
  1396                              <1>         movzx   eax,dx
  1397                              <1>         push    eax
  1398                              <1>         call    find                    ; EDI -> the line, or the NUL
  1399                              <1>         pop     eax
  1400                              <1>         cmp     byte [edi],0
  1401                              <1>         je      gedit
  1402                              <1>         mov     [V(v_edln)],eax
  1403                              <1>         mov     ebx,ARENA+LINEBUF
  1404                              <1> .ce1:   mov     al,[edi]                ; copy it, and show it, up to its CR
  1405                              <1>         cmp     al,13                   ;   (or LF)
  1406                              <1>         je      .ce2
  1407                              <1>         cmp     al,10
  1408                              <1>         je      .ce2
  1409                              <1>         mov     [ebx],al
  1410                              <1>         call    putc
  1411                              <1>         inc     edi
  1412                              <1>         inc     ebx
  1413                              <1>         cmp     bl,0FDh                 ; (a longer line is cut at 125)
  1414                              <1>         jne     .ce1
  1415                              <1> .ce2:   mov     edx,ebx                 ; the cursor is at the line's end
  1416                              <1>         jmp     ed1
  1417                              <1> 
  1418                              <1> ; Return. If ^E put a line here, the text goes back in its place. If not:
  1419                              <1> ; a number and text is a line to put in, a number alone a line to take out,
  1420                              <1> ; and anything else is run where it is.
  1421                              <1> cret:   push    edx                     ; the end of what was typed
  1422                              <1>         mov     eax,[V(v_edln)]
  1423                              <1>         test    eax,eax
  1424                              <1>         jz      .cr1
  1425                              <1>         push    eax
  1426                              <1>         call    delln
  1427                              <1>         pop     eax
  1428                              <1>         jmp     short ins
  1429                              <1> .cr1:   call    rdnum                   ; DX = the number it starts with
  1430                              <1>         mov     eax,esi                 ; ESI's low byte is still 80h if there
  1431                              <1>         cmp     al,80h                  ;   was no number:
  1432                              <1>         je      runln                   ;   then run the line
  1433                              <1>         movzx   eax,dx
  1434                              <1>         cmp     byte [esi],13
  1435                              <1>         jne     .cr2
  1436                              <1>         pop     edx                     ; the number alone: take that line out
  1437                              <1>         call    delln
  1438                              <1>         jmp     gedit
  1439                              <1> .cr2:   inc     esi                     ; step over the one character after it
  1440                              <1> 
  1441                              <1> ; Put the text at ESI in as line EAX: open a gap of its length there, CR
  1442                              <1> ; and LF included, and copy it in.
  1443                              <1> ins:    call    find                    ; EDI -> where it goes
  1444                              <1>         pop     ecx                     ; the end of what was typed
  1445                              <1>         inc     ecx
  1446                              <1>         inc     ecx
  1447                              <1>         sub     ecx,esi                 ; the length, with its CR LF
  1448                              <1>         push    esi                     ; the text
  1449                              <1>         push    ecx                     ; its length
  1450                              <1>         push    edi                     ; where it goes
  1451                              <1>         mov     esi,edi
  1452                              <1> .in1:   lodsb                           ; find the program's NUL
  1453                              <1>         test    al,al
  1454                              <1>         jnz     .in1
  1455                              <1>         dec     esi
  1456                              <1>         mov     ecx,esi
  1457                              <1>         sub     ecx,edi
  1458                              <1>         inc     ecx                     ; the bytes to move up, NUL included
  1459                              <1>         mov     edi,esi
  1460                              <1>         add     edi,[esp+4]             ; the NUL's new place
  1461                              <1>         std
  1462                              <1>         rep     movsb                   ; move the rest of the program up
  1463                              <1>         cld
  1464                              <1>         pop     edi
  1465                              <1>         pop     ecx
  1466                              <1>         pop     esi
  1467                              <1>         rep     movsb
  1468                              <1>         jmp     gedit
  1469                              <1> 
  1470                              <1> ; ^G: run the program. runln: run the typed line (ESI -> it).
  1471                              <1> crun:   mov     esi,ARENA+PROG
  1472                              <1>         db      3Ch                     ; (CMP AL,n: steps over the POP)
  1473                              <1> runln:   pop     eax                     ; (the end of what was typed)
  1474                              <1> %endif
  1475                              <1> ; run0: start running at ESI. The heap starts after the stored program's
  1476                              <1> ; NUL. TOS is popped: the data stack is as the last line left it.
  1477 0000040C BA00024100          <1> run0:    mov     edx,ARENA+PROG
  1478 00000411 42                  <1> .st1:   inc     edx
  1479 00000412 807AFF00            <1>         cmp     byte [edx-1],0
  1480 00000416 75F9                <1>         jne     .st1
  1481 00000418 6689157C014100      <1>         mov     [ARENA+HEAP],dx
  1482                              <1> %if CHECKED
  1483                              <1>         movzx   eax,dx                  ; '_' may not release below this
  1484                              <1>         mov     [V(v_npend)],eax
  1485                              <1> %endif
  1486 0000041F 5B                  <1>         pop     ebx
  1487 00000420 FFE5                <1>         jmp     ebp
  1488                              <1> 
  1489                              <1> %if EDITOR
  1490                              <1> ; ^L: list from line n. EDX = the number of the line at ESI.
  1491                              <1> clist:  call    rdnum                   ; DX = n, or 0 if there was none:
  1492                              <1>         movzx   eax,dx
  1493                              <1>         test    eax,eax
  1494                              <1>         jnz     .li0
  1495                              <1>         inc     eax                     ;   then from line 1
  1496                              <1> .li0:   push    eax
  1497                              <1>         call    find
  1498                              <1>         pop     edx
  1499                              <1>         mov     esi,edi
  1500                              <1> .li1:   cmp     byte [esi],0
  1501                              <1>         je      gedit                   ; the end of the text
  1502                              <1>         xor     eax,eax
  1503                              <1>         call    waitk
  1504                              <1>         jz      .li3                    ; no key: carry on
  1505                              <1>         cmp     al,3
  1506                              <1>         je      gedit                   ; Ctrl-C ends the list,
  1507                              <1>         call    ekey                    ;   any other key holds it until the
  1508                              <1>         cmp     al,3                    ;   next (and a Ctrl-C then ends it)
  1509                              <1>         je      gedit
  1510                              <1> .li3:   push    edx
  1511                              <1>         xchg    eax,edx
  1512                              <1>         call    pdec                    ; the line's number,
  1513                              <1>         mov     al,' '
  1514                              <1>         call    putc                    ;   a space,
  1515                              <1>         pop     edx
  1516                              <1>         inc     edx
  1517                              <1>         call    prl                     ;   and the line
  1518                              <1>         jmp     .li1
  1519                              <1> 
  1520                              <1> ; ^V: view.
  1521                              <1> cview:  call    pmsg
  1522                              <1>  %if CHECKED
  1523                              <1>         db      'B8SWINEC 2026-11-21',22h
  1524                              <1>  %else
  1525                              <1>         db      'B8SWINE 2026-11-21',22h
  1526                              <1>  %endif
  1527                              <1>         call    pstk                    ; both stacks
  1528                              <1>         mov     edi,ARENA+PROG
  1529                              <1>         or      ecx,-1
  1530                              <1> .cv1:   inc     ecx                     ; count the lines, and find the end
  1531                              <1>         call    nxl
  1532                              <1>         jnz     .cv1
  1533                              <1>         push    ecx
  1534                              <1>         call    pmsg
  1535                              <1>         db      '/M/JProg ',22h
  1536                              <1>         lea     eax,[edi-(ARENA+PROG)]
  1537                              <1>         call    pdec                    ; the program's size
  1538                              <1>         call    pmsg
  1539                              <1>         db      '/M/JLines ',22h
  1540                              <1>         pop     eax
  1541                              <1>         call    pdec
  1542                              <1>         call    pmsg
  1543                              <1>         db      '/M/JFree ',22h
  1544                              <1>         mov     eax,ARENA+LIMIT-1
  1545                              <1>         sub     eax,edi
  1546                              <1>         call    pdec                    ; the room left for text and heap
  1547                              <1>         call    pmsg
  1548                              <1>         db      '/M/J',22h
  1549                              <1>         jmp     gedit
  1550                              <1> 
  1551                              <1> ; delln: take line EAX out: copy everything after it down over it. Keeps ESI.
  1552                              <1> delln:  push    esi
  1553                              <1>         call    find
  1554                              <1>         push    edi
  1555                              <1>         call    nxl                     ; EDI -> the next line
  1556                              <1>         mov     esi,edi
  1557                              <1>         pop     edi
  1558                              <1> .de1:   lodsb
  1559                              <1>         stosb
  1560                              <1>         test    al,al
  1561                              <1>         jnz     .de1
  1562                              <1>         pop     esi
  1563                              <1>         ret
  1564                              <1> 
  1565                              <1> ; find: EAX = a line number. Returns EDI -> that line, or -> the NUL at the
  1566                              <1> ; end of the text if there are fewer lines (or the number is 0). Keeps ESI.
  1567                              <1> find:   xchg    eax,ecx
  1568                              <1>         mov     edi,ARENA+PROG
  1569                              <1> .fi1:   dec     cx
  1570                              <1>         jz      .fi2
  1571                              <1>         call    nxl
  1572                              <1>         jnz     .fi1
  1573                              <1> .fi2:   ret
  1574                              <1> 
  1575                              <1> ; nxl: step EDI over one line, to just past its LF (and return not-zero),
  1576                              <1> ; or stop at the NUL that ends the text (and return zero).
  1577                              <1> nxl:    mov     al,[edi]
  1578                              <1>         test    al,al
  1579                              <1>         jz      .nx1
  1580                              <1>         inc     edi
  1581                              <1>         cmp     al,10
  1582                              <1>         jne     nxl
  1583                              <1>         test    al,al
  1584                              <1> .nx1:   ret
  1585                              <1> 
  1586                              <1> ; prl: print the line at ESI, to its LF; ESI -> just past it.
  1587                              <1> prl:    lodsb
  1588                              <1>         call    putc
  1589                              <1>         cmp     al,10
  1590                              <1>         jne     prl
  1591                              <1>         ret
  1592                              <1> 
  1593                              <1> ; ^R: read the file. ^W: write the file (made anew, or emptied first). A
  1594                              <1> ; name typed before the key is the file's name from now on. (A file that
  1595                              <1> ; can't be made or written is not noticed: nothing is written.)
  1596                              <1> cread:  call    setname
  1597                              <1>         call    load
  1598                              <1>         jmp     gedit
  1599                              <1> cwrite: call    setname
  1600                              <1>         mov     edi,ARENA+PROG
  1601                              <1>         xor     eax,eax
  1602                              <1>         or      ecx,-1
  1603                              <1>         repne   scasb
  1604                              <1>         not     ecx
  1605                              <1>         dec     ecx                     ; the length of the text
  1606                              <1>         push    ecx
  1607                              <1>         push    eax                     ; hTemplateFile
  1608                              <1>         push    eax                     ; dwFlagsAndAttributes
  1609                              <1>         push    2                       ; CREATE_ALWAYS
  1610                              <1>         push    eax                     ; lpSecurityAttributes
  1611                              <1>         push    eax                     ; no sharing
  1612                              <1>         push    40000000h               ; GENERIC_WRITE
  1613                              <1>         push    NAMEBUF
  1614                              <1>         call    [V(iat_CreateFileA)]
  1615                              <1>         pop     ecx
  1616                              <1>         push    eax                     ; (for CloseHandle)
  1617                              <1>         push    0
  1618                              <1>         lea     edx,[V(v_cnt)]
  1619                              <1>         push    edx
  1620                              <1>         push    ecx
  1621                              <1>         push    ARENA+PROG
  1622                              <1>         push    eax
  1623                              <1>         call    [V(iat_WriteFile)]
  1624                              <1>         call    [V(iat_CloseHandle)]
  1625                              <1>         jmp     gedit
  1626                              <1> 
  1627                              <1> ; setname: if a name was typed (the line does not start with its CR), it is
  1628                              <1> ; the file's name from now on, as typed (a Windows path).
  1629                              <1> setname:mov     esi,ARENA+LINEBUF
  1630                              <1>         cmp     byte [esi],13
  1631                              <1>         je      .sn2
  1632                              <1>         mov     edi,NAMEBUF
  1633                              <1> .sn1:   lodsb
  1634                              <1>         cmp     al,13
  1635                              <1>         jne     .sn3
  1636                              <1>         mov     al,0
  1637                              <1> .sn3:   stosb
  1638                              <1>         test    al,al
  1639                              <1>         jnz     .sn1
  1640                              <1> .sn2:   ret
  1641                              <1> %endif
