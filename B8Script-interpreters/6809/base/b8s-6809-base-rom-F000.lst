F564                          IF   FAST*CHECKED   
                                 ; A-Z, checked: call the word, unless its cell is still 0 (U); the
                                 ; IP goes on the return stack, and the break key is looked at.
                    FUA:      LDB   <00h   ; A
                              LDA   <01h   
                              LBEQ   e_undef   
                              PSHS   Y   
                              TFR   D,Y   
                              DEC   <COUNT   
                              BNE   fuA1   
                              JSR   pk1   
                              ;*Macro unroll: fuA1:   NEXTF
                    FUA1:     DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FUB:      LDB   <02h   ; B
                              LDA   <03h   
                              LBEQ   e_undef   
                              PSHS   Y   
                              TFR   D,Y   
                              DEC   <COUNT   
                              BNE   fuB1   
                              JSR   pk1   
                              ;*Macro unroll: fuB1:   NEXTF
