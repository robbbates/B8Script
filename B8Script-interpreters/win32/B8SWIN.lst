  1770                              <1> ; setname: if a name was typed (the line does not start with its CR), it is
  1771                              <1> ; the file's name from now on, as typed (a Windows path).
  1772                              <1> setname:mov     esi,ARENA+LINEBUF
  1773                              <1>         cmp     byte [esi],13
  1774                              <1>         je      .sn2
  1775                              <1>         mov     edi,NAMEBUF
  1776                              <1> .sn1:   lodsb
  1777                              <1>         stosb
  1778                              <1>         cmp     al,13
  1779                              <1>         jne     .sn1
  1780                              <1>         mov     byte [edi-1],0          ; (the CR becomes the NUL)
  1781                              <1> .sn2:   ret
  1782                              <1> %endif
