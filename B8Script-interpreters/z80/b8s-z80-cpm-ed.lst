06BD   C8                     RET   Z   
06BE   23                     INC   HL   
06BF   FE 0A                  CP   10   
06C1   20 F8                  JR   NZ,nxl   
06C3   B7                     OR   A   
06C4   C9                     RET      
06C5                             ; prl: print the line at HL, to its LF; HL -> just past it.
06C5   7E           PRL:      LD   A,(HL)   
06C6   EF                     RST   28h   
06C7   7E                     LD   A,(HL)   
06C8   23                     INC   HL   
06C9   FE 0A                  CP   10   
06CB   20 F8                  JR   NZ,prl   
06CD   C9                     RET      
06CE                          ENDIF      
06CE                          IF   EDGEN   
                                 ; ^R, generic: what comes in from now until ^Z is the program. A CR is
                                 ; stored as CR LF; a LF right after a line end is dropped (it is the CR's
                                 ; own, or an empty line's), and a LF anywhere else ends a line too. A last
                                 ; line with no end is given one. Nothing is echoed, and there is no check
                                 ; for running out of memory.
                    CREAD:    LD   HL,PROG-1   
                              LD   A,10   
                              DB   0FEh   ; (CP n: steps over the LD A,13)
                    RD1:      LD   A,13   ; a LF alone ends a line
                    RD2:      LD   (HL),A   
                              INC   HL   
                              CP   13   
                              LD   A,10   
                              JR   Z,rd2   ; after a CR goes a LF
                    RD3:      CALL   ekey   
                              CP   1Ah   
                              JR   Z,rd4   
                              CP   10   
                              JR   NZ,rd2   
                              DEC   HL   
                              CP   (HL)   
                              INC   HL   
                              JR   Z,rd3   ; (the LF is dropped)
                              JR   rd1   
                    RD4:      DEC   HL   
                              LD   A,(HL)   
                              INC   HL   
                              CP   10   
                              JR   Z,rd5   
                              LD   (HL),13   
                              INC   HL   
                              LD   (HL),10   
                              INC   HL   
                    RD5:      LD   (HL),0   
                              JR   ged1   
                                 ; ^W, generic: the text is printed as it is, for the terminal to capture.
                    CWRITE:   LD   HL,PROG   
                    CW1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,ged1   
                              RST   28h   
                              INC   HL   
                              JR   cw1   
06CE                          ENDIF      
06CE                          IF   EDITOR*CPM   
06CE                CFCB:     EQU   005Ch   ; the file's name is kept here, where the CCP
06CE                             ;   put the one from the command line
06CE                             ; ^R, CP/M: read the file. A name typed before the key is the file's name
06CE                             ; from now on.
06CE   CD 25 07     CREAD:    CALL   setname   
06D1   CD 62 07               CALL   load   
06D4   C3 A8 04               JP   edit   
06D7                             ; ^W, CP/M: write the file: delete the old one, make it anew, write the
06D7                             ; text in records of 128 bytes, and close it. The text's NUL and the 127
06D7                             ; bytes after it are set to ^Z meanwhile, which pads the last record.
06D7   CD 25 07     CWRITE:   CALL   setname   
06DA   CD 51 07               CALL   fcbclr   
06DD   0E 13                  LD   C,19   ; delete
06DF   CD 5C 07               CALL   fbdos   
06E2   0E 16                  LD   C,22   ; make
06E4   CD 5C 07               CALL   fbdos   
06E7   3C                     INC   A   
06E8   CA A8 04               JP   Z,edit   ; no room in the directory
06EB   21 00 0B               LD   HL,PROG   
06EE   AF                     XOR   A   
06EF   BE           CW1:      CP   (HL)   
06F0   23                     INC   HL   
06F1   20 FC                  JR   NZ,cw1   
06F3   2B                     DEC   HL   ; HL -> the NUL
06F4   E5                     PUSH   HL   
06F5   06 80                  LD   B,128   
06F7   36 1A        CW2:      LD   (HL),1Ah   
06F9   23                     INC   HL   
06FA   10 FB                  DJNZ   cw2   
06FC   E1                     POP   HL   
06FD   11 00 0B               LD   DE,PROG   
0700   7B           CW3:      LD   A,E   ; a record that starts before the end is written
0701   95                     SUB   L   
0702   7A                     LD   A,D   
0703   9C                     SBC   A,H   
0704   30 15                  JR   NC,cw4   
0706   E5                     PUSH   HL   
0707   D5                     PUSH   DE   
0708   0E 1A                  LD   C,26   ; set the DMA address: the record is written
070A   CD 05 00               CALL   BDOS   ;   from where it lies
070D   0E 15                  LD   C,21   ; write
070F   CD 5C 07               CALL   fbdos   
0712   E1                     POP   HL   
0713   11 80 00               LD   DE,128   
0716   19                     ADD   HL,DE   
0717   EB                     EX   DE,HL   
0718   E1                     POP   HL   
0719   18 E5                  JR   cw3   
071B   36 00        CW4:      LD   (HL),0   ; the NUL again
071D   0E 10                  LD   C,16   ; close
071F   CD 5C 07               CALL   fbdos   
0722   C3 A8 04               JP   edit   
0725                             ; setname: if a name was typed (the line does not start with its CR), put it
0725                             ; in the CFCB: up to 8 characters, a dot, up to 3 more, in capitals. The drive
0725                             ; is the current one.
0725   11 80 0A     SETNAME:   LD   DE,LINEBUF   
0728   1A                     LD   A,(DE)   
0729   FE 0D                  CP   13   
072B   C8                     RET   Z   
072C   21 5C 00               LD   HL,CFCB   
072F   36 00                  LD   (HL),0   ; the current drive
0731   06 0B                  LD   B,11   
0733   2C           SN1:      INC   L   
0734   36 20                  LD   (HL)," "   
0736   10 FB                  DJNZ   sn1   
0738   2E 5D                  LD   L,CFCB+1   
073A   1A           SN2:      LD   A,(DE)   
073B   13                     INC   DE   
073C   FE 0D                  CP   13   
073E   C8                     RET   Z   
073F   FE 2E                  CP   "."   
0741   20 04                  JR   NZ,sn3   
0743   2E 65                  LD   L,CFCB+9   ; the type
0745   18 F3                  JR   sn2   
0747   FE 61        SN3:      CP   "a"   
0749   38 02                  JR   C,sn4   
074B   E6 5F                  AND   5Fh   ; a capital
074D   77           SN4:      LD   (HL),A   
074E   2C                     INC   L   
074F   18 E9                  JR   sn2   
0751                             ; fcbclr: clear the CFCB after its name, as it must be before a file is opened
0751   21 68 00     FCBCLR:   LD   HL,CFCB+12   
0754   06 18                  LD   B,24   
0756   36 00        FC1:      LD   (HL),0   
0758   23                     INC   HL   
0759   10 FB                  DJNZ   fc1   
075B   C9                     RET      
075C                             ; fbdos: BDOS function C on the file
075C   11 5C 00     FBDOS:    LD   DE,CFCB   
075F   C3 05 00               JP   BDOS   
0762                             ; load: read the file into PROG. No such file: no program. The text ends at
0762                             ; the file"s first ^Z (1Ah), which pads a text file"s last record; one more
0762                             ; goes after the last record, so the search always stops. And every line
0762                             ; must end in LF: a last line without one is given a CR LF.
0762   CD 51 07     LOAD:     CALL   fcbclr   
0765   0E 0F                  LD   C,15   ; open (no such file: the first read fails
0767   CD 5C 07               CALL   fbdos   ;   too)
076A   11 00 0B               LD   DE,PROG   
076D   D5           LD1:      PUSH   DE   
076E   0E 1A                  LD   C,26   ; set the DMA address
0770   CD 05 00               CALL   BDOS   
0773   0E 14                  LD   C,20   ; read the next 128 bytes
0775   CD 5C 07               CALL   fbdos   
0778   E1                     POP   HL   ; HL = the address this record went to
0779   B7                     OR   A   
077A   20 07                  JR   NZ,ld2   
077C   11 80 00               LD   DE,128   
077F   19                     ADD   HL,DE   
0780   EB                     EX   DE,HL   
0781   18 EA                  JR   ld1   
0783   36 1A        LD2:      LD   (HL),1Ah   
0785   21 FF 0A               LD   HL,PROG-1   
0788   3E 0A                  LD   A,10   ; (a file with no text needs nothing added)
078A   23           TR1:      INC   HL   
078B   5F                     LD   E,A   ; E = the character before this one
078C   7E                     LD   A,(HL)   
078D   FE 1A                  CP   1Ah   
078F   20 F9                  JR   NZ,tr1   
0791   7B                     LD   A,E   
0792   FE 0A                  CP   10   
0794   28 06                  JR   Z,tr2   
0796   36 0D                  LD   (HL),13   
0798   23                     INC   HL   
0799   36 0A                  LD   (HL),10   
079B   23                     INC   HL   
079C   36 00        TR2:      LD   (HL),0   
079E   C9                     RET      
079F                          ENDIF      
079F                             ; =============================================================================
079F                             ;  CP/M startup (the generic build starts at address 0: see st0)
079F                             ; =============================================================================
079F                          IF   CPM   
079F                             ; The RAM pages follow the image; the heap may grow to the BDOS.
079F                START:       
079F                          ENDIF      
079F                          IF   CPM*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
                                 ; is held back.
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
079F                          ENDIF      
079F                          IF   CPM   
079F   21 08 01               LD   HL,vecs   ; the RST routines go down into page zero
07A2   11 08 00               LD   DE,0008h   
07A5   01 2C 00               LD   BC,vecend-vecs   
07A8   ED B0                  LDIR      
07AA                          ENDIF      
07AA                          IF   CPM*EDITOR   
07AA   CD 62 07               CALL   load   ; the file named on the command line
07AD   C3 A2 04               JP   edit0   
07B0                          ENDIF      
07B0                          IF   CPM*(1-EDITOR)   
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:      LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
                              JP   st2   
07B0                          ENDIF      
07B0                          IF   CPM   
07B0                             ; RAM pages, after the image
07B0                RSPAGE:   EQU   (imgend + 255) / 256   
07B0                DSPAGE:   EQU   RSPAGE + 1   
07B0                LETPAGE:   EQU   RSPAGE + 2   
07B0                PROG:     EQU   LETPAGE*256 + 256   
07B0                          ENDIF      
07B0                IMGEND:      


