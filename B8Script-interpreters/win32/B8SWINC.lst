  1375                              <1> 
  1376                              <1> ; =============================================================================
  1377                              <1> ;  The line editor (EDITOR = 1)
  1378                              <1> ;
  1379                              <1> ;  The interpreter starts here, and a program that ends comes back here.
  1380                              <1> ;  There is no prompt. It follows the spec's suggested standard for a line
  1381                              <1> ;  editor (docs/b8script.md, Environments), and is the Z80's editor, key for
  1382                              <1> ;  key. Type a line and press Return:
  1383                              <1> ;
  1384                              <1> ;    n text    put the text in as line n; the lines from n on move down. A
  1385                              <1> ;              number past the end (or 0) adds the line at the end.
  1386                              <1> ;    n         take line n out
  1387                              <1> ;    anything else is run at once, as B8Script. (Start such a line with a
  1388                              <1> ;    space if it would begin with a digit.)
  1389                              <1> ;
  1390                              <1> ;  A command key ends the line too, and takes what was typed as its argument:
  1391                              <1> ;
  1392                              <1> ;    ^G        run the program
  1393                              <1> ;    n ^L      list from line n (no number: all of it). Any key holds the
  1394                              <1> ;              list until another key is pressed; Ctrl-C ends it.
  1395                              <1> ;    n ^E      put line n in the input line; Return puts it back, changed
  1396                              <1> ;    name ^R   read the file of that name (no name: the current one: the
  1397                              <1> ;              one from the command line, or the last one typed)
  1398                              <1> ;    name ^W   write the program to that file (no name: the current one)
  1399                              <1> ;    ^N ^N     new: no program (the key twice in a row)
  1400                              <1> ;    ^X        leave
  1401                              <1> ;
  1402                              <1> ;  Any other control key does nothing.
  1403                              <1> ;
  1404                              <1> ;  In the line: ^B and ^F, or the left and right arrow keys, move the cursor;
  1405                              <1> ;  a character goes in at the cursor; Backspace and DEL take out the one
  1406                              <1> ;  before it; Esc drops the line (after Esc it waits 5 ms for a '[': Esc [ C
  1407                              <1> ;  and Esc [ D are right and left too). Only CR, LF, BS and printing
  1408                              <1> ;  characters are sent to the terminal.
  1409                              <1> ;
  1410                              <1> ;  Lines are counted, not numbered. A typed line holds 125 characters; the
  1411                              <1> ;  one character after a line number separates it from the text and is not
  1412                              <1> ;  stored. The text is kept as typed, each line ending in CR LF, at PROG. A
  1413                              <1> ;  file is read up to its first ^Z, and a last line with no line end is
  1414                              <1> ;  given one; it is written as it is, with no padding.
  1415                              <1> ;
  1416                              <1> ;  What lasts from one line to the next: the program, the words, the
  1417                              <1> ;  variables and the data stack (TOS is kept pushed while the editor runs).
  1418                              <1> ;  An error or a break clears both stacks. The return stack starts empty for
  1419                              <1> ;  every line.
  1420                              <1> ;
  1421                              <1> ;  Registers in the editor: EBX = the cursor, EDX = the end of the line
  1422                              <1> ;  (pointers into the line buffer); EDI is free (edit resets it).
  1423                              <1> ; =============================================================================
  1424                              <1> %if EDITOR
  1425                              <1> ; ^E: line n goes into the input line, to be changed. V_EDLN remembers
  1426                              <1> ; which line it was: Return puts the text back in its place.
  1427                              <1> cedln:  CALLP   rdnum
  1428                              <1>         xchg    eax,edx                 ; (find and V_EDLN use only the low
  1429                              <1>         push    eax                     ;   word)
  1430                              <1>         CALLP   find                    ; EDI -> the line, or the NUL
  1431                              <1>         pop     eax
  1432                              <1>         cmp     byte [edi],0
  1433                              <1>         je      .ce9
  1434                              <1>         mov     [V(v_edln)],eax
  1435                              <1>         mov     ebx,ARENA+LINEBUF
  1436                              <1> .ce1:   mov     al,[edi]                ; copy it, and show it, up to its CR
  1437                              <1>         cmp     al,13                   ;   (or LF)
  1438                              <1>         je      .ce2
  1439                              <1>         cmp     al,10
  1440                              <1>         je      .ce2
  1441                              <1>         mov     [ebx],al
  1442                              <1>         CALLP   putc
  1443                              <1>         inc     edi
  1444                              <1>         inc     ebx
  1445                              <1>         cmp     bl,0FDh                 ; (a longer line is cut at 125)
  1446                              <1>         jne     .ce1
  1447                              <1> .ce2:   mov     edx,ebx                 ; the cursor is at the line's end
  1448                              <1>         pop     eax                     ; (not back to edit: on with the line)
  1449                              <1>         jmp     ed1
  1450                              <1> .ce9:   ret
  1451                              <1> 
  1452                              <1> ; ^F, right arrow: one to the right, by printing the character there
  1453                              <1> right:  cmp     ebx,edx
  1454                              <1>         je      ed1                     ; at the end
  1455                              <1>         mov     al,[ebx]
  1456                              <1>         inc     ebx
  1457                              <1>         jmp     short lf1
  1458                              <1> 
  1459                              <1> ; Esc: alone it drops the line. An arrow key sends Esc [ and a letter, so
  1460                              <1> ; wait about 5 ms for a second key: after a '[' read on to the letter that
  1461                              <1> ; ends the sequence, and act on C (right) and D (left).
  1462                              <1> esc:    push    5
  1463                              <1>         pop     eax
  1464                              <1>         CALLP   waitk
  1465                              <1>         jnz     .es2
  1466                              <1>         call    fin                     ; no second key: the line is dropped
  1467                              <1>         jmp     edit
  1468                              <1> .es2:   cmp     al,'['
  1469                              <1>         jne     ed1                     ; not a sequence known here
  1470                              <1> .es3:   CALLP   ekey
  1471                              <1>         cmp     al,40h
  1472                              <1>         jb      .es3                    ; (its parameters)
  1473                              <1>         sub     al,'C'
  1474                              <1>         je      right
  1475                              <1>         dec     al                      ; 'D'?
  1476                              <1>         jne     ed1                     ; no: on into left
  1477                              <1> ; ^B, left arrow: the cursor goes one to the left
  1478                              <1> left:   cmp     bl,80h
  1479                              <1>         je      ed1                     ; at the start
  1480                              <1>         dec     ebx
  1481                              <1>         mov     al,8
  1482                              <1> lf1:    CALLP   putc
  1483                              <1>         jmp     ed1
  1484                              <1> 
  1485                              <1> ; edit0: an error or a break: both stacks are cleared.
  1486                              <1> ; skend: a program that ended inside skip: its return address goes.
  1487                              <1> ; edend: a program that ended: TOS joins the rest of the data stack.
  1488                              <1> edit0:  mov     esp,[V(v_dstop)]
  1489                              <1>  %if CHECKED
  1490                              <1>         push    -11                     ; the report went to stderr: back to
  1491                              <1>         call    [V(iat_GetStdHandle)]   ;   stdout
  1492                              <1>         mov     [V(v_outh)],eax
  1493                              <1>         mov     ebx,esi                 ; (the report's texts moved EBX out of
  1494                              <1>  %endif                                 ;   the arena: the cell for TOS)
  1495                              <1>         db      3Ch                     ; (CMP AL,n: steps over the POP)
  1496                              <1> skend:  pop     eax
  1497                              <1> edend:  push    ebx
  1498                              <1> ; edit: start a new input line.
  1499                              <1> edit:   mov     edi,RSTOP               ; the return stack is empty
  1500                              <1>         xor     eax,eax
  1501                              <1>         mov     [ARENA+HELD],ax         ; no key is held, and the break key is on
  1502                              <1>         mov     [V(v_edln)],eax         ; no line is being edited
  1503                              <1>         mov     ebx,ARENA+LINEBUF       ; EBX = the cursor,
  1504                              <1>         mov     edx,ebx                 ;   EDX = the end of the line
  1505                              <1> ed1:    CALLP   ekey
  1506                              <1>         cmp     al,7Fh
  1507                              <1>         je      bsp                     ; DEL
  1508                              <1>         cmp     al,' '
  1509                              <1>         jae     insc
  1510                              <1>         cmp     al,9
  1511                              <1>         je      insc                    ; Tab is text
  1512                              <1>         cmp     al,8
  1513                              <1>         je      bsp
  1514                              <1>         cmp     al,2
  1515                              <1>         je      left                    ; ^B
  1516                              <1>         cmp     al,6
  1517                              <1>         je      right                   ; ^F
  1518                              <1>         cmp     al,1Bh
  1519                              <1>         je      esc
  1520                              <1>         push    edi                     ; a command key? Look it up
  1521                              <1>         mov     edi,ckeys
  1522                              <1>         push    NCMD
  1523                              <1>         pop     ecx
  1524                              <1>         repne   scasb
  1525                              <1>         pop     edi
  1526                              <1>         jne     ed1                     ; no: the key is ignored
  1527                              <1>         push    edit                    ; the command returns to edit
  1528                              <1>         mov     eax,ebp                 ; the command's address (the high word
  1529                              <1>         mov     ax,[ctabr+ecx*2]        ;   is next's): fin returns to it
  1530                              <1>         push    eax
  1531                              <1> ; fin: end the input line: CR LF and a NUL after it, and a new line on the
  1532                              <1> ; terminal. Leaves ESI -> the line.
  1533                              <1> fin:    mov     word [edx],0A0Dh
  1534                              <1>         mov     esi,edx
  1535                              <1>         call    prl                     ; (prints the CR LF)
  1536                              <1>         mov     byte [esi],0
  1537                              <1>         mov     esi,ARENA+LINEBUF
  1538                              <1>         ret
  1539                              <1> 
  1540                              <1> ; Backspace, DEL: the character before the cursor goes. The cursor moves
  1541                              <1> ; left, the rest of the line moves down over it, and the last place (now a
  1542                              <1> ; space) is printed over along with the rest.
  1543                              <1> bsp:    cmp     bl,80h
  1544                              <1>         je      ed1                     ; at the start
  1545                              <1>         dec     ebx
  1546                              <1>         mov     al,8
  1547                              <1>         CALLP   putc
  1548                              <1>         mov     ecx,ebx
  1549                              <1> .bs1:   mov     al,[ecx+1]
  1550                              <1>         mov     [ecx],al
  1551                              <1>         inc     ecx
  1552                              <1>         cmp     ecx,edx
  1553                              <1>         jne     .bs1
  1554                              <1>         mov     byte [ecx-1],' '
  1555                              <1>         dec     edx
  1556                              <1>         jmp     short ic2
  1557                              <1> ; A character goes in at the cursor: it ripples up through the rest of the
  1558                              <1> ; line, the cursor moves on, and the rest is printed again.
  1559                              <1> insc:   cmp     dl,0FDh
  1560                              <1>         je      ed1                     ; the line is full: 125 characters
  1561                              <1>         CALLP   putc
  1562                              <1>         mov     ecx,ebx
  1563                              <1> .ic1:   xchg    al,[ecx]
  1564                              <1>         inc     ecx
  1565                              <1>         cmp     ecx,edx
  1566                              <1>         jbe     .ic1
  1567                              <1>         inc     ebx
  1568                              <1>         inc     edx
  1569                              <1>         mov     ecx,edx
  1570                              <1> ; ic2: print the line from the cursor to ECX, and bring the cursor back
  1571                              <1> ; with backspaces. Nothing at all if the cursor is at ECX.
  1572                              <1> ic2:    mov     esi,ebx
  1573                              <1> .ta1:   cmp     esi,ecx
  1574                              <1>         je      .ta2
  1575                              <1>         lodsb
  1576                              <1>         CALLP   putc
  1577                              <1>         jmp     .ta1
  1578                              <1> .ta2:   cmp     esi,ebx
  1579                              <1>         je      .ta3
  1580                              <1>         mov     al,8
  1581                              <1>         CALLP   putc
  1582                              <1>         dec     esi
  1583                              <1>         jmp     .ta2
  1584                              <1> .ta3:   jmp     ed1
  1585                              <1> 
  1586                              <1> ; ekey: wait for a key
  1587                              <1> ekey:   or      eax,-1
  1588                              <1>         JMPP    waitk
  1589                              <1> 
  1590                              <1> ; The command keys, and where each goes (after fin, which returns to the
  1591                              <1> ; command; the command returns to edit, which is under it on the stack).
  1592                              <1> ; REPNE SCASB leaves ECX = the number of keys after the one found, so the
  1593                              <1> ; table is backwards. (The addresses are kept as their low words: the code
  1594                              <1> ; is all in the one 64 KB as `next`.)
  1595                              <1> ckeys:  db      13, 7, 12, 5, 18, 23, 14, 24
  1596                              <1> NCMD    equ     $-ckeys
  1597                              <1> ctabr:  dw      exit-IB                 ; ^X
  1598                              <1>         dw      cnew-IB                 ; ^N
  1599                              <1>         dw      cwrite-IB               ; ^W
  1600                              <1>         dw      cread-IB                ; ^R
  1601                              <1>         dw      cedln-IB                ; ^E
  1602                              <1>         dw      clist-IB                ; ^L
  1603                              <1>         dw      crun-IB                 ; ^G
  1604                              <1>         dw      cret-IB                 ; Return
  1605                              <1> 
  1606                              <1> ; ^N ^N: no program, if the next key is ^N too
  1607                              <1> cnew:   CALLP   ekey
  1608                              <1>         cmp     al,14
  1609                              <1>         jne     cn9
  1610                              <1>         mov     byte [ARENA+PROG],0
  1611                              <1> cn9:    ret
  1612                              <1> 
  1613                              <1> ; delln: take line EAX out: copy everything after it down over it. Keeps ESI.
  1614                              <1> delln:  push    esi
  1615                              <1>         CALLP   find
  1616                              <1>         push    edi
  1617                              <1>         call    nxl                     ; EDI -> the next line
  1618                              <1>         mov     esi,edi
  1619                              <1>         pop     edi
  1620                              <1> .de1:   lodsb
  1621                              <1>         stosb
  1622                              <1>         test    al,al
  1623                              <1>         jnz     .de1
  1624                              <1>         pop     esi
  1625                              <1>         ret
  1626                              <1> 
  1627                              <1> ; Return. If ^E put a line here, the text goes back in its place. If not:
  1628                              <1> ; a number and text is a line to put in, a number alone a line to take out,
  1629                              <1> ; and anything else is run where it is.
  1630                              <1> cret:   push    edx                     ; the end of what was typed
  1631                              <1>         mov     eax,[V(v_edln)]
  1632                              <1>         test    eax,eax
  1633                              <1>         jz      .cr1
  1634                              <1>         push    eax
  1635                              <1>         call    delln
  1636                              <1>         pop     eax
  1637                              <1>         jmp     short ins
  1638                              <1> .cr1:   CALLP   rdnum                   ; DX = the number it starts with
  1639                              <1>         mov     eax,esi                 ; ESI's low byte is still 80h if there
  1640                              <1>         cmp     al,80h                  ;   was no number:
  1641                              <1>         je      runln                   ;   then run the line
  1642                              <1>         xchg    eax,edx
  1643                              <1>         cmp     byte [esi],13
  1644                              <1>         jne     .cr2
  1645                              <1>         pop     edx                     ; the number alone: take that line out
  1646                              <1>         jmp     delln
  1647                              <1> .cr2:   inc     esi                     ; step over the one character after it
  1648                              <1> 
  1649                              <1> ; Put the text at ESI in as line EAX: open a gap of its length there, CR
  1650                              <1> ; and LF included, and copy it in.
  1651                              <1> ins:    CALLP   find                    ; EDI -> where it goes
  1652                              <1>         pop     ecx                     ; the end of what was typed
  1653                              <1>         inc     ecx
  1654                              <1>         inc     ecx
  1655                              <1>         sub     ecx,esi                 ; the length, with its CR LF
  1656                              <1>         push    esi                     ; the text
  1657                              <1>         push    ecx                     ; its length
  1658                              <1>         push    edi                     ; where it goes
  1659                              <1>         mov     esi,edi
  1660                              <1> .in1:   lodsb                           ; find the program's NUL
  1661                              <1>         test    al,al
  1662                              <1>         jnz     .in1
  1663                              <1>         dec     esi
  1664                              <1>         mov     ecx,esi
  1665                              <1>         sub     ecx,edi
  1666                              <1>         inc     ecx                     ; the bytes to move up, NUL included
  1667                              <1>         mov     edi,esi
  1668                              <1>         add     edi,[esp+4]             ; the NUL's new place
  1669                              <1>         std
  1670                              <1>         rep     movsb                   ; move the rest of the program up
  1671                              <1>         cld
  1672                              <1>         pop     edi
  1673                              <1>         pop     ecx
  1674                              <1>         pop     esi
  1675                              <1>         rep     movsb
  1676                              <1>         ret
  1677                              <1> 
  1678                              <1> ; ^G: run the program. runln: run the typed line (ESI -> it).
  1679                              <1> crun:   mov     esi,ARENA+PROG
  1680                              <1>         db      3Ch                     ; (CMP AL,n: steps over the POP)
  1681                              <1> runln:  pop     eax                     ; (the end of what was typed)
  1682                              <1>         pop     eax                     ; (the return to edit: a program that
  1683                              <1>                                         ;   ends goes to edend)
  1684                              <1>         RUN0CODE
  1685                              <1> 
  1686                              <1> ; ^L: list from line n. EDX = the number of the line at ESI.
  1687                              <1> clist:  CALLP   rdnum                   ; DX = n, or 0 if there was none:
  1688                              <1>         movzx   eax,dx
  1689                              <1>         test    eax,eax
  1690                              <1>         jnz     .li0
  1691                              <1>         inc     eax                     ;   then from line 1
  1692                              <1> .li0:   push    eax
  1693                              <1>         CALLP   find
  1694                              <1>         pop     edx
  1695                              <1>         mov     esi,edi
  1696                              <1> .li1:   cmp     byte [esi],0
  1697                              <1>         je      .li9                    ; the end of the text
  1698                              <1>         xor     eax,eax
  1699                              <1>         CALLP   waitk
  1700                              <1>         jz      .li3                    ; no key: carry on
  1701                              <1>         cmp     al,3
  1702                              <1>         je      .li9                    ; Ctrl-C ends the list,
  1703                              <1>         CALLP   ekey                    ;   any other key holds it until the
  1704                              <1>         cmp     al,3                    ;   next (and a Ctrl-C then ends it)
  1705                              <1> .li9:   je      fi9
  1706                              <1> .li3:   push    edx
  1707                              <1>         xchg    eax,edx
  1708                              <1>         CALLP   pdec                    ; the line's number,
  1709                              <1>         mov     al,' '
  1710                              <1>         CALLP   putc                    ;   a space,
  1711                              <1>         pop     edx
  1712                              <1>         inc     edx
  1713                              <1>         call    prl                     ;   and the line
  1714                              <1>         jmp     .li1
  1715                              <1> 
  1716                              <1> ; find: EAX = a line number. Returns EDI -> that line, or -> the NUL at the
  1717                              <1> ; end of the text if there are fewer lines (or the number is 0). Keeps ESI.
  1718                              <1> find:   xchg    eax,ecx
  1719                              <1>         mov     edi,ARENA+PROG
  1720                              <1> .fi1:   dec     cx
  1721                              <1>         jz      fi9
  1722                              <1>         call    nxl
  1723                              <1>         jnz     .fi1
  1724                              <1> fi9:    ret
  1725                              <1> 
  1726                              <1> ; nxl: step EDI over one line, to just past its LF (and return not-zero),
  1727                              <1> ; or stop at the NUL that ends the text (and return zero).
  1728                              <1> nxl:    mov     al,[edi]
  1729                              <1>         test    al,al
  1730                              <1>         jz      .nx1
  1731                              <1>         inc     edi
  1732                              <1>         cmp     al,10
  1733                              <1>         jne     nxl
  1734                              <1>         test    al,al
  1735                              <1> .nx1:   ret
  1736                              <1> 
  1737                              <1> ; prl: print the line at ESI, to its LF; ESI -> just past it.
  1738                              <1> prl:    lodsb
  1739                              <1>         CALLP   putc
  1740                              <1>         cmp     al,10
  1741                              <1>         jne     prl
  1742                              <1>         ret
  1743                              <1> 
  1744                              <1> ; ^R: read the file (cread, at load). ^W: write the file (made anew, or
  1745                              <1> ; emptied first). A name typed before the key is the file's name from now
  1746                              <1> ; on. (A file that can't be made or written is not noticed: nothing is
  1747                              <1> ; written.)
  1748                              <1> cwrite: call    setname
  1749                              <1>         mov     edi,ARENA+PROG
  1750                              <1>         xor     eax,eax
  1751                              <1>         or      ecx,-1
  1752                              <1>         repne   scasb
  1753                              <1>         not     ecx
  1754                              <1>         dec     ecx                     ; the length of the text
  1755                              <1>         push    ecx
  1756                              <1>         push    eax                     ; hTemplateFile
  1757                              <1>         push    eax                     ; dwFlagsAndAttributes
  1758                              <1>         push    2                       ; CREATE_ALWAYS
  1759                              <1>         push    eax                     ; lpSecurityAttributes
  1760                              <1>         push    eax                     ; no sharing
  1761                              <1>         push    40000000h               ; GENERIC_WRITE
  1762                              <1>         push    NAMEBUF
  1763                              <1>         call    [V(iat_CreateFileA)]
  1764                              <1>         pop     ecx
  1765                              <1>         push    eax                     ; (for CloseHandle)
  1766                              <1>         push    0
  1767                              <1>         lea     edx,[V(v_cnt)]
  1768                              <1>         push    edx
  1769                              <1>         push    ecx
  1770                              <1>         push    ARENA+PROG
  1771                              <1>         push    eax
  1772                              <1>         call    [V(iat_WriteFile)]
  1773                              <1>         call    [V(iat_CloseHandle)]
  1774                              <1>         ret
  1775                              <1> 
  1776                              <1> ; setname: if a name was typed (the line does not start with its CR), it is
  1777                              <1> ; the file's name from now on, as typed (a Windows path).
  1778                              <1> setname:mov     esi,ARENA+LINEBUF
  1779                              <1>         cmp     byte [esi],13
  1780                              <1>         je      .sn2
  1781                              <1>         mov     edi,NAMEBUF
  1782                              <1> .sn1:   lodsb
  1783                              <1>         stosb
  1784                              <1>         cmp     al,13
  1785                              <1>         jne     .sn1
  1786                              <1>         mov     byte [edi-1],0          ; (the CR becomes the NUL)
  1787                              <1> .sn2:   ret
  1788                              <1> %endif
  1789                              <1> 
