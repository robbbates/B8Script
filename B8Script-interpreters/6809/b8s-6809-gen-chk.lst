F32C   A8 C4                  EORA   ,U   
F32E   34 02                  PSHS   A   ; a xor b: for q
F330   30 42                  LEAX   2,U   
F332   8D 22                  BSR   absx   ; |a|
F334   1F 31                  TFR   U,X   
F336   8D 1E                  BSR   absx   ; |b|
F338   8D 22                  BSR   udiv   ; NOS = q, TOS = r
F33A   30 42                  LEAX   2,U   
F33C   6D E0                  TST   ,S+   
F33E   2A 02                  BPL   dv1   
F340   8D 0B                  BSR   negx   ; q's sign
F342   6D E0        DV1:      TST   ,S+   
F344   2A 0F                  BPL   ng9   
F346   20 03                  BRA   negt   ; r's sign
F348   BD F0 C1     NEGNUM:   JSR   rdnum   ; a negative literal: read it, then negate
F34B   1F 31        NEGT:     TFR   U,X   
F34D   EC 84        NEGX:     LDD   ,X   ; negx: negate the cell at X
F34F   40                     NEGA      
F350   50                     NEGB      
F351   82 00                  SBCA   #0   
F353   ED 84                  STD   ,X   
F355   39           NG9:      RTS      
F356   6D 84        ABSX:     TST   ,X   ; absx: negate the cell at X if negative
F358   2A FB                  BPL   ng9   
F35A   20 F1                  BRA   negx   
F35C                             ; udiv: unsigned divide, in place. The dividend is the NOS cell and the
F35C                             ; divisor the TOS cell, both <= 8000h; the NOS cell becomes the quotient and
F35C                             ; the TOS cell the remainder. The remainder is built in D (always < the
F35C                             ; divisor, so 2R+1 fits in 16 bits).
F35C                             ; Dividing by 2 is one shift (the spec wants that fast).
