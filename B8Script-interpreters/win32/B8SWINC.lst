  1855 000006C4 00000000            <1>         dd      0                       ; ForwarderChain
  1856 000006C8 [EE07C0FF]          <1>         dd      dllname-IB              ; Name
  1857 000006CC [FC07C0FF]          <1>         dd      iat-IB                  ; FirstThunk: the IAT
  1858 000006D0 00<rep 14h>         <1>         times   20 db 0                 ; the null entry that ends the list
  1859                              <1> idesc_end:
  1860                              <1> %macro  IMP 1
  1861                              <1>         dd      hn_%1-IB
  1862                              <1> %endmacro
