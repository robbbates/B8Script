0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Spec: docs/b8script.md (2026-11-21).
0000                             ; 
0000                             ;  Three switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    EDITOR   1 = with the line editor built in (see the end of this file):
0000                             ;                 the spec's suggested standard. It goes with either setting
0000                             ;                 of the other two.
0000                             ;    CHECKED  0 = no checks (spec: the programmer is responsible)
0000                             ;             1 = starts with every variable at 0 and every word undefined,
0000                             ;                 and stops on every error in the spec's table (and Ctrl-C)
0000                             ;                 with a four-line report: the letter and the place as line
0000                             ;                 and column, the text there, and both stacks. See `error`.
0000                             ; 
0000                             ;  In every build Ctrl-C stops a running program (an unchecked build stops
0000                             ;  without a word): see the console layer for the rules, the held key and
0000                             ;  the break-off cell.
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   0   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   1   ; 1 = checked build
0000                EDITOR:   EQU   1   ; 1 = with the line editor
0000                EDGEN:    EQU   EDITOR*(1-CPM)   ; (the generic build with the editor)
0000                             ; (IF takes any value but 0 as true, so
0000                             ;  IF CHECKED+EDITOR means "either")
0000                TABP0:    EQU   EDGEN*(1-CHECKED)   ; (the build with its table in page zero)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    HL'  return-stack pointer (the alternate HL). Entries are 2 bytes; the
0000                             ;         stack grows down. Only rpop and rpushn (and the checks) touch it.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  One-byte calls. The routines used most are reached with RST, one byte
0000                             ;  instead of three:
0000                             ; 
0000                             ;    RST 08h  rpop    pop the return stack into DE
0000                             ;    RST 18h  drop    drop TOS, then next character     (ends a handler)
0000                             ;    RST 20h  neg16   HL = -HL
0000                             ;    RST 28h  putc    print A
0000                             ;    RST 30h  next    next character                    (ends a handler)
0000                             ; 
0000                             ;  RST 18h and RST 30h never return: an RST is a CALL, so the first thing
0000                             ;  each of them does is POP DE to throw the return address away.
0000                             ; 
0000                             ;  The CP/M build can't own page zero, so the block from `vecs` to `vecend`
0000                             ;  (image addresses 0108h-0133h) is copied to 0008h-0033h when it starts. The
0000                             ;  code in that block is written to work at either place.
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (the top four bytes of the page are spare,
0000                             ;             so a full stack runs two bytes into the page below)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch, interpreter variables in the gaps, and the -n? line buffer
0000                             ;             at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack has a guard band: the data stack can
0000                             ;  overrun by a cell or two (and the calls made while it is full, the error
0000                             ;  report's included) into the top 32 bytes of the return-stack page, which
0000                             ;  are never used, and the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
                    BDOS:     EQU   0005h   
                    BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IF   CPM*(1-EDITOR)   
                    EXIT:     EQU   0000h   ; warm boot
0000                          ENDIF      
0000                          IFN   CPM   
0000                             ; ---- generic machine: edit these to suit -----------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The zero flag must match A
0000                             ;   (end the routine with OR A / RET).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                             ;   KEY and CONOUT must preserve BC, DE, HL and HL'.
0000                RSPAGE:   EQU   80h   ; 8000h return stack
0000                DSPAGE:   EQU   81h   ; 8100h data stack
0000                LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
0000                PROG:     EQU   8300h   ; where the loader puts the program text
0000                HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
0000                BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)   
                    EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                          ENDIF      
0000                          IF   EDGEN   
0000                LEAVE:    EQU   0FF09h   ; where the editor's ^X goes
0000                          ENDIF      
0000                          IF   EDITOR*CPM   
                    LEAVE:    EQU   0000h   ; the editor's ^X: warm boot
0000                          ENDIF      
0000                          IF   EDITOR   
0000                EXIT:     EQU   edend   ; a program that ends goes back to the editor,
0000                SKEND:    EQU   skend   ;   also when it ends inside skip
0000                          ENDIF      
0000                          IF   1-EDITOR   
                    SKEND:    EQU   EXIT   
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine. (The wait
0000                             ; for a second Ctrl-C uses it too: 250 ms.)
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                             ;   around machine code;
0000                NPEND:    EQU   LET+38h   ;   minus the address of the program's end
0000                             ;   (the heap"s first byte), for the checked "_';
0000                EDLN:     EQU   LET+3Ah   ;   the editor: the number of the line that ^E
0000                             ;   put in the input line (0: none)
0000                KEYBUF:   EQU   LET+7Ah   ; gap after z: a key read by the break check and
0000                             ;   held for the next "?" (0: none);
0000                BRKOFF:   EQU   LET+7Bh   ;   the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                LBHDR:    EQU   LET+7Eh   ; CP/M BDOS 10 header: max, count
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FCh   ; empty data stack. The four bytes above it
0000                             ; are spare: a character can pop two cells
0000                             ; too many before the checked build sees it,
0000                             ; and the next call must not land on the
0000                             ; letter cells.
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is the start of the .COM file, and 0108h-0133h is also copied to
0000                             ;  page zero (see the header).
0000                             ; =============================================================================
0000                          .ORG   BASE   
0000                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              XOR   A   ; 00  reset. (This byte, AFh, is also what an
0000                          ENDIF      ;     undefined word runs into: see e_hi.)
0000                          IF   1-EDGEN   
                              LD   SP,DSTOP   ; 00  reset, or the start of the .COM file
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)   
                              LD   BC,PROG   ; 03  the IP
                              JR   st0   ; 06  (the rest of the startup is close by)
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              JR   init   ; 04  (the rest of the startup is close by)
                              DW   0   ; 06  spare
0000                          ENDIF      
0000                          IF   EDGEN   
0000   AF                     XOR   A   ; 00  reset: no program yet. (This byte, AFh,
0001   32 00 83               LD   (PROG),A   ;     is also what an undefined word runs
0004   C3 7C 04               JP   init   ; 04  into in the checked build: see e_hi.)
0007   00                     NOP      ; 07  spare
0008                          ENDIF      
0008                          IF   CPM   
                              JP   start   ; 03
                              DW   0   ; 06  spare
0008                          ENDIF      
0008                VECS:        
0008                             ; ---- RST 08h: rpop: pop the return stack into DE ---------------------------
0008   D9           RPOP:     EXX      ; 08
0009   5E                     LD   E,(HL)   
000A   23                     INC   HL   
000B   56                     LD   D,(HL)   
000C   23                     INC   HL   
000D   D5                     PUSH   DE   ; across to the main registers
000E   D9                     EXX      
000F   D1                     POP   DE   
0010   C9                     RET      ; 10  (so RST 10h is not used)
0011                             ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
0011   C6 21        CTL:      ADD   A,21h   ; 11  back to c; zero only for NUL
0013   20 1C                  JR   NZ,next0   ;     the rest are ignored
0015   C3 C4 04     ENDPROG:   JP   EXIT   ;     the program has ended
0018                             ; ---- RST 18h: drop TOS, then next ------------------------------------------
0018   D1           RST18:    POP   DE   ; 18  discard the RST's return address
0019   E1                     POP   HL   ;     new TOS = NOS
001A   18 15                  JR   nx   
001C   E5           H_FROMR:   PUSH   HL   ; 1C  "}" return stack to TOS
001D   CF                     RST   08h   
001E   EB                     EX   DE,HL   
001F   F7                     RST   30h   
0020                             ; ---- RST 20h: neg16: HL = -HL (keeps BC, DE) -------------------------------
0020   AF           NEG16:    XOR   A   ; 20
0021   95                     SUB   L   
0022   6F                     LD   L,A   
0023   9F                     SBC   A,A   
0024   94                     SUB   H   
0025   67                     LD   H,A   
0026   C9                     RET      
0027   00                     NOP      ; 27  spare
0028                             ; ---- RST 28h: putc: print A (keeps BC, DE, HL, HL') ------------------------
0028                RST28:       
0028                          IFN   CPM   
0028   C3 03 FF     PUTC:     JP   CONOUT   ; 28
002B                          ENDIF      
002B                          IF   CPM   
                              JP   putc   ; 28
002B                          ENDIF      
002B   E9           JPHL:     JP   (HL)   ; 2B  (for the machine-code call)
002C   E3           H_TOR:    EX   (SP),HL   ; 2C  "{" TOS to the return stack: the new TOS
002D   C3 B7 00               JP   rpushn   ;     comes up, the old one goes across
0030                             ; ---- RST 30h: next character -----------------------------------------------
0030   D1           RST30:    POP   DE   ; 30  discard the RST's return address
0031                NX:          
0031                          IF   CPM   
                              JP   next0   ; (this copy runs in page zero)
0031                          ENDIF      
0031                VECEND:      
0031                             ; =============================================================================
0031                             ;  The inner loop: read one character and sort it by range.
0031                             ; 
0031                             ;    00h          end of program
0031                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0031                             ;    30h-39h      digit: read a whole number
0031                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0031                             ;    61h-7Ah      a-z: push the address of that letter's cell
0031                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0031                             ; =============================================================================
0031                NEXT0:       
0031                          IF   CHECKED   
0031   CD 45 03               CALL   chkstk   ; both stacks are checked once per character
0034                          ENDIF      
0034   0A                     LD   A,(BC)   
0035   03                     INC   BC   
0036   D6 21                  SUB   21h   ; A = c - 21h
0038   38 D7                  JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
003A   FE 0F                  CP   0Fh   
003C   38 25                  JR   C,punct   ; 21h-2Fh: PTAB index 0-14
003E   D6 0F                  SUB   0Fh   ; A = c - 30h
0040   FE 0A                  CP   0Ah   
0042   38 5D                  JR   C,digit   ; 30h-39h
0044   FE 11                  CP   11h   
0046   38 19                  JR   C,p3a   ; 3Ah-40h
0048   D6 11                  SUB   11h   ; A = c - 41h
004A   FE 1A                  CP   1Ah   
004C   38 5F                  JR   C,upper   ; 41h-5Ah: A = letter index 0-25
004E   FE 20                  CP   20h   
0050   38 0D                  JR   C,p5b   ; 5Bh-60h
0052   FE 3A                  CP   3Ah   
0054   38 51                  JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0056   FE 3E                  CP   3Eh   
0058                          IF   1-CHECKED   
                              JR   NC,next0   ; 7Fh-FFh: ignored
0058                          ENDIF      
0058                          IF   CHECKED   
0058   28 D7                  JR   Z,next0   ; 7Fh, DEL: ignored
005A   D2 72 03               JP   NC,e_hi   ; 80h-FFh: reserved
005D                          ENDIF      
005D   D6 1A                  SUB   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
005F   D6 09        P5B:      SUB   9   ; 5Bh-60h: -4 in all, index 22-27
0061   C6 05        P3A:      ADD   A,5   ; 3Ah-40h: index 15-21
0063                .macro PTABLE,
0063                             ; 
0063                 DB      h_store & 0FFh  ; !
0063                 DB      h_str & 0FFh    ; "
0063                 DB      h_num & 0FFh    ; #
0063                 DB      h_print & 0FFh  ; $
0063                 DB      h_swap & 0FFh   ; %
0063                 DB      h_and & 0FFh    ; &
0063                 DB      h_emit & 0FFh   ; '
0063                 DB      h_open & 0FFh   ; (
0063                 DB      h_close & 0FFh  ; )
0063                 DB      h_mul & 0FFh    ; *
0063                 DB      h_add & 0FFh    ; +
0063                 DB      h_cfetch & 0FFh ; ,
0063                 DB      h_sub & 0FFh    ; -
0063                 DB      h_cstore & 0FFh ; .
0063                 DB      h_div & 0FFh    ; /
0063                 DB      h_dup & 0FFh    ; :
0063                 DB      h_drop & 0FFh   ; ;
0063                 DB      h_lt & 0FFh     ; <
0063                 DB      h_eq & 0FFh     ; =
0063                 DB      h_gt & 0FFh     ; >
0063                 DB      h_key & 0FFh    ; ?
0063                 DB      h_fetch & 0FFh  ; @
0063                 DB      h_def & 0FFh    ; [
0063                 DB      h_break & 0FFh  ; \
0063                 DB      h_ret & 0FFh    ; ]
0063                 DB      h_xor & 0FFh    ; ^
0063                 DB      h_alloc & 0FFh  ; _
0063                 DB      h_grave & 0FFh  ; `
0063                 DB      h_tor & 0FFh    ; {
0063                 DB      h_or & 0FFh     ; |
0063                 DB      h_fromr & 0FFh  ; }
0063                 DB      h_not & 0FFh    ; ~
0063                .endm
0063                 
0063                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
0063                             ; untouched, and A, DE free.
0063   C6 B0        PUNCT:    ADD   A,PTAB & 0FFh   ; PTAB never crosses a page
0065   5F                     LD   E,A   
0066   16 02                  LD   D,PTAB / 256   ; (0 if the table is in page zero)
0068   FE C6                  CP   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
006A   1A                     LD   A,(DE)   
006B   5F                     LD   E,A   ; the handler's low byte
006C                          IF   (1-CPM)*(1-TABP0)   
006C   16 00                  LD   D,0   
006E                          ENDIF      
006E                          IFN   CPM   
006E   CB 12                  RL   D   ; its page: 0 + carry
0070                          ENDIF      
0070                          IF   CPM   
                              LD   D,1   
                              JR   NC,pu1   
                              INC   D   ; its page: 1 + carry
                    PU1:         
0070                          ENDIF      
0070   D5                     PUSH   DE   ; jump to it; the stack is balanced again
0071   C9                     RET      ;   when the handler starts
0072                             ; The rest of the startup: here so that the generic reset code can reach it
0072                             ; with JR. st0: find the program's NUL; the heap starts after it.
0072                             ; (The editor build has its own copy of this, next to the editor.)
0072                             ; A checked build first clears the lower half of the letter page (A = 0):
0072                             ; every variable starts at 0, every word cell holds 0000h, the address an
0072                             ; undefined word is caught at (see e_hi), and no key is held back.
0072                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                    INIT:     LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
                              LD   BC,PROG   ; the IP
0072                          ENDIF      
0072                          IF   (1-CPM)*(1-EDITOR)   
                    ST0:      LD   H,B   
                              LD   L,C   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
0072                          ENDIF      
0072                          IF   1-EDITOR   
                    ST2:      LD   (HEAP),HL   
0072                          ENDIF      
0072                          IF   CHECKED*(1-EDITOR)   
                              RST   20h   ; minus the heap"s first address: "_' may not
                              LD   (NPEND),HL   ;   release below it
0072                          ENDIF      
0072                          IF   (1-CHECKED)*(1-EDITOR)   
                              LD   HL,0   ; no key is held, and the break key is on
                              LD   (KEYBUF),HL   ;   (the checked build has cleared these)
0072                          ENDIF      
0072                          IF   1-EDITOR   
                              EXX      
                              LD   HL,RSTOP   ; the return stack is empty
                              EXX      
                              RST   30h   ; (its return address is thrown away)
0072                          ENDIF      
0072                             ; In the unchecked generic editor build the table is here, in the first
0072                             ; page, which saves loading D twice. (The other builds have no room for it
0072                             ; here: theirs is further down.)
0072                          IF   TABP0   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0072                          ENDIF      
0072                             ; =============================================================================
0072                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
0072                             ;  (00bbIGFuZCA= are up among the RST routines.) The machine-code call, exec,
0072                             ;  is here too: it belongs to "`" and makes the page come out right.
0072                             ; =============================================================================
0072   D1           H_XOR:    POP   DE   
0073   7C                     LD   A,H   
0074   AA                     XOR   D   
0075   67                     LD   H,A   
0076   7D                     LD   A,L   
0077   AB                     XOR   E   
0078   6F                     LD   L,A   
0079   F7                     RST   30h   
007A   D1           H_OR:     POP   DE   
007B   7C                     LD   A,H   
007C   B2                     OR   D   
007D   67                     LD   H,A   
007E   7D                     LD   A,L   
007F   B3                     OR   E   
0080   6F                     LD   L,A   
0081   F7                     RST   30h   
0082   E7           H_NOT:    RST   20h   ; ~x = -x - 1
0083   2B                     DEC   HL   
0084   F7                     RST   30h   
0085                             ; "_" ( n -- addr ): the heap pointer moves by n, a signed count (the add is
0085                             ; the same either way); TOS is the old pointer.
0085   ED 5B 7C 82  H_ALLOC:   LD   DE,(HEAP)   
0089                          IF   CHECKED*CPM   
                              LD   A,H   ; the count's sign, for chkhp
0089                          ENDIF      
0089   19                     ADD   HL,DE   ; the new top
008A                          IF   CHECKED   
008A   CD 31 03               CALL   chkhp   
008D                          ENDIF      
008D   22 7C 82               LD   (HEAP),HL   
0090   EB                     EX   DE,HL   
0091   F7                     RST   30h   
0092   D9           EXEC:     EXX      
0093   22 34 82               LD   (RSAVE),HL   ; machine code may change the alternates
0096   D9                     EXX      
0097   CD 2B 00               CALL   jphl   
009A   D9                     EXX      
009B   2A 34 82               LD   HL,(RSAVE)   
009E   D9                     EXX      
009F   E1                     POP   HL   
00A0   F7                     RST   30h   
00A1                             ; ---- the letters and digits (here, in the middle, so that the inner loop's
00A1                             ; ---- short jumps reach them, and the handlers after them reach rpushn) ------
00A1                             ; Digits: step back onto the first digit and read the whole number.
00A1   E5           DIGIT:    PUSH   HL   
00A2   0B                     DEC   BC   
00A3   CD 32 02               CALL   rdnum   
00A6   F7                     RST   30h   
00A7                             ; a-z: push the cell's address (the cell is the variable)
00A7   E5           LOWER:    PUSH   HL   
00A8   87                     ADD   A,A   
00A9   6F                     LD   L,A   
00AA   26 82                  LD   H,LETPAGE   
00AC   F7                     RST   30h   
00AD                             ; A-Z: call the word. The return address (the IP after the letter) goes on
00AD                             ; the return stack, and the IP becomes the address in the letter's cell.
00AD   C5           UPPER:    PUSH   BC   ; the return address, for rpushn
00AE   EB                     EX   DE,HL   ; park TOS
00AF   87                     ADD   A,A   
00B0   6F                     LD   L,A   
00B1   26 82                  LD   H,LETPAGE   ; HL -> cell
00B3   4E                     LD   C,(HL)   
00B4   2C                     INC   L   
00B5   46                     LD   B,(HL)   ; IP = the word's body
00B6   EB                     EX   DE,HL   ; TOS back, and fall into rpushn
00B7                             ; rpushn: move the top cell of the data stack (in memory) to the return
00B7                             ; stack, then next. Everything that pushes the return stack ends here.
00B7                             ; 
00B7                             ; The break key is looked at here, so at every word call and loop-back (and
00B7                             ; block entry and "{"), but only one time in 256: B', which nothing else
00B7                             ; uses, counts them. Reading the keyboard can be slow (it is a BDOS call
00B7                             ; under CP/M), and this way it costs a loop two bytes and 13 T-states.
00B7   D9           RPUSHN:   EXX      
00B8   D1                     POP   DE   
00B9   2B                     DEC   HL   
00BA   72                     LD   (HL),D   
00BB   2B                     DEC   HL   
00BC   73                     LD   (HL),E   
00BD   10 05                  DJNZ   rp1   
00BF   D9                     EXX      
00C0   CD E2 02               CALL   pollk   
00C3   F7                     RST   30h   
00C4   D9           RP1:      EXX      
00C5   F7                     RST   30h   
00C6                             ; ---- machine code: the grave -----------------------------------------------
00C6                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
00C6                             ; are stored from addr until a non-hex character; then a RET (C9h) is
00C6                             ; written and its address is left. An odd last digit is consumed and dropped.
00C6                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
00C6                             ; code is entered by CALL with the data stack above the return address; it
00C6                             ; must keep BC, and on return the top cell becomes the new TOS.
00C6   CD D0 02     H_GRAVE:   CALL   hexc   
00C9   30 C7                  JR   NC,exec   
00CB   77           HX1:      LD   (HL),A   ; the high digit goes in first ...
00CC   CD D0 02               CALL   hexc   
00CF   30 08                  JR   NC,hx2   ; odd digit: consumed, and the RET below
00D1   ED 6F                  RLD      ;   overwrites it
00D3   23                     INC   HL   ; ... and RLD shifts it up under the low one
00D4   CD D0 02               CALL   hexc   
00D7   38 F2                  JR   C,hx1   
00D9   36 C9        HX2:      LD   (HL),0C9h   ; (never range-checked: the spec says so)
00DB   F7                     RST   30h   
00DC                             ; ---- where the two pages meet ----------------------------------------------
00DC                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
00DC                             ; are in falling code order for this), and where exactly differs between the
00DC                             ; builds: NPG1 follows. Every handler below these four must start in the
00DC                             ; second page, and every one above in the first; chktab.py checks both.
00DC                             ; "]" returns: pop an address and jump to it.
00DC   CF           H_RET:    RST   08h   
00DD   42                     LD   B,D   
00DE   4B                     LD   C,E   
00DF   F7           BRK1:     RST   30h   
00E0                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
00E0                             ; drops the block start, "]" returns. No closer at all ends the program.
00E0   7C           H_BREAK:   LD   A,H   
00E1   B5                     OR   L   
00E2   E1                     POP   HL   
00E3   28 FA                  JR   Z,brk1   
00E5   CD 59 02               CALL   skip   
00E8   B7                     OR   A   ; skip returns 0 for ")"
00E9   20 F1                  JR   NZ,h_ret   
00EB   CF           RDROP:    RST   08h   
00EC   F7                     RST   30h   
00ED                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
00ED                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
00ED                             ; the body"s address instead. Either way it then skips to the matching "]'.
00ED                             ; (The unchecked build takes anything that is not a letter as the space; the
00ED                             ; checked build stops on it.)
00ED   0A           H_DEF:    LD   A,(BC)   
00EE   03                     INC   BC   
00EF   D6 41                  SUB   "A"   ; a letter gives 0-25 or 32-57: lowercase
00F1   5F                     LD   E,A   ;   lands 64 bytes up
00F2   E6 DF                  AND   0DFh   ; fold case
00F4   FE 1A                  CP   26   
00F6   30 0B                  JR   NC,def2   ; not a letter
00F8   CB 23                  SLA   E   
00FA   16 82                  LD   D,LETPAGE   ; DE -> cell
00FC   79                     LD   A,C   
00FD   12                     LD   (DE),A   
00FE   1C                     INC   E   
00FF   78                     LD   A,B   
0100   12                     LD   (DE),A   
0101   18 09                  JR   skipnx   
0103                DEF2:        
0103                          IF   CHECKED   
0103   7B                     LD   A,E   
0104   FE DF                  CP   " "-"A"+256   
0106   C2 92 03               JP   NZ,e_brack   ; anything but a letter or a space
0109                          ENDIF      
0109   E5                     PUSH   HL   ; an anonymous block: push its address
010A   60                     LD   H,B   
010B   69                     LD   L,C   
010C                SKIPNX:      
010C                          IF   CHECKED   
010C   0B                     DEC   BC   ; back onto the letter, so that skip finds its
010D                          ENDIF      ;   opener, the "[", just before where it starts
010D   CD 59 02     SKIPO:    CALL   skip   
0110   F7                     RST   30h   
0111   5E           H_FETCH:   LD   E,(HL)   ; "@"
0112   23                     INC   HL   
0113   56                     LD   D,(HL)   
0114   EB                     EX   DE,HL   
0115   F7                     RST   30h   
0116                             ; =============================================================================
0116                             ;  Handlers that must start in the image's second page.
0116                             ;  "?" is the last (with "," inside it), so its long tail may run past that
0116                             ;  page.
0116                             ; =============================================================================
0116                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
0116                             ; the matching ")".
0116   7C           H_OPEN:   LD   A,H   
0117   B5                     OR   L   
0118   E1                     POP   HL   
0119   28 F2                  JR   Z,skipo   
011B   C5                     PUSH   BC   ; the block starts at the IP
011C   18 99                  JR   rpushn   
011E                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
011E                             ; drops it and carries on.
011E   7C           H_CLOSE:   LD   A,H   
011F   B5                     OR   L   
0120   E1                     POP   HL   
0121   28 C8                  JR   Z,rdrop   
0123   CF                     RST   08h   ; pop the block start ...
0124   42                     LD   B,D   
0125   4B                     LD   C,E   
0126   C5                     PUSH   BC   
0127   18 8E                  JR   rpushn   ; ... and push it back
0129                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
0129                             ; "-" has two jobs: directly before a digit it starts a negative number.
0129   0A           H_SUB:    LD   A,(BC)   
012A   D6 30                  SUB   "0"   
012C   FE 0A                  CP   10   
012E   38 04                  JR   C,negnum   
0130   E7                     RST   20h   ; a - b = a + (-b): fall into "+"
0131   D1           H_ADD:    POP   DE   
0132   19                     ADD   HL,DE   
0133   F7                     RST   30h   
0134   E5           NEGNUM:   PUSH   HL   ; a negative number: read it, negate it
0135   CD 32 02               CALL   rdnum   
0138   E7                     RST   20h   
0139   F7                     RST   30h   
013A   D1           H_AND:    POP   DE   
013B   7C                     LD   A,H   
013C   A2                     AND   D   
013D   67                     LD   H,A   
013E   7D                     LD   A,L   
013F   A3                     AND   E   
0140   6F                     LD   L,A   
0141   F7                     RST   30h   
0142                             ; Signed compares. Both are "HL < DE" for the right pair: "<" swaps the two
0142                             ; cells first. Flipping both sign bits turns a signed compare into an
0142                             ; unsigned one (and XOR clears the carry for SBC); SBC HL,HL then turns the
0142                             ; carry into -1 or 0 with no branch.
0142   E3           H_LT:     EX   (SP),HL   ; a < b: HL = a, and b is popped next
0143   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
0144   7C                     LD   A,H   
0145   EE 80                  XOR   80h   
0147   67                     LD   H,A   
0148   7A                     LD   A,D   
0149   EE 80                  XOR   80h   
014B   57                     LD   D,A   
014C   ED 52                  SBC   HL,DE   ; carry if HL < DE
014E   ED 62        TF:       SBC   HL,HL   ; carry -> -1 or 0
0150   F7                     RST   30h   
0151   D1           H_EQ:     POP   DE   
0152   B7                     OR   A   
0153   ED 52                  SBC   HL,DE   
0155   7C                     LD   A,H   
0156   B5                     OR   L   
0157   FE 01                  CP   1   ; carry only if a - b = 0
0159   18 F3                  JR   tf   
015B                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept. The
015B                             ; multiplier shifts up through A:C.
015B   D1           H_MUL:    POP   DE   ; DE = multiplicand
015C   C5                     PUSH   BC   
015D   7C                     LD   A,H   
015E   4D                     LD   C,L   ; A:C = multiplier
015F   21 00 00               LD   HL,0   
0162   06 10                  LD   B,16   
0164   29           MUL1:     ADD   HL,HL   
0165   CB 21                  SLA   C   
0167   17                     RLA      
0168   30 01                  JR   NC,mul2   
016A   19                     ADD   HL,DE   
016B   10 F7        MUL2:     DJNZ   mul1   
016D   C1                     POP   BC   
016E   F7                     RST   30h   
016F                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
016F                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
016F                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
016F                             ; stops on it.
016F                H_DIV:       
016F                          IF   CHECKED   
016F   7C                     LD   A,H   
0170   B5                     OR   L   
0171   CA 8F 03               JP   Z,e_zero   
0174                          ENDIF      
0174   D1                     POP   DE   ; DE = a, HL = b
0175   C5                     PUSH   BC   ; free BC for udiv
0176   D5                     PUSH   DE   ; a, for r's sign
0177   7A                     LD   A,D   
0178   AC                     XOR   H   
0179   F5                     PUSH   AF   ; S flag = sign of q
017A   CB 7C                  BIT   7,H   
017C   C4 20 00               CALL   NZ,neg16   ; HL = |b|
017F   EB                     EX   DE,HL   
0180   CB 7C                  BIT   7,H   
0182   C4 20 00               CALL   NZ,neg16   ; HL = |a|, DE = |b|
0185   CD 0C 02               CALL   udiv   ; HL = q, DE = r
0188   F1                     POP   AF   
0189   FC 20 00               CALL   M,neg16   ; q's sign
018C   EB                     EX   DE,HL   ; HL = r, DE = q
018D   F1                     POP   AF   ; A = a's high byte
018E   B7                     OR   A   
018F   FC 20 00               CALL   M,neg16   ; r's sign
0192   C1                     POP   BC   
0193   D5                     PUSH   DE   ; q under r
0194   F7                     RST   30h   
0195                             ; ---- stack and storage -----------------------------------------------------
0195   E5           H_DUP:    PUSH   HL   ; ":"
0196   F7                     RST   30h   
0197   E3           H_SWAP:   EX   (SP),HL   ; "%"
0198   F7                     RST   30h   
0199                             ; (The checked build tests the address before it takes the value off the
0199                             ; stack, so that an error report shows both.)
0199                H_CSTORE:      ; "." ( c addr -- )
0199                          IF   CHECKED   
0199   CD 24 03               CALL   chkst   
019C                          ENDIF      
019C   D1                     POP   DE   
019D   73                     LD   (HL),E   
019E   DF           H_DROP:   RST   18h   ; ";" is this one byte
019F                H_STORE:      ; "!" ( n addr -- )
019F                          IF   CHECKED   
019F   CD 24 03               CALL   chkst   
01A2                          ENDIF      
01A2   D1                     POP   DE   
01A3   73                     LD   (HL),E   
01A4   23                     INC   HL   
01A5   72                     LD   (HL),D   
01A6   DF                     RST   18h   
01A7                             ; ---- console ---------------------------------------------------------------
01A7                             ; 22h pushes the address of the text after it and skips the string.
01A7   E5           H_STR:    PUSH   HL   
01A8   60                     LD   H,B   
01A9   69                     LD   L,C   
01AA   CD 48 02               CALL   skipstr   
01AD                          IF   CHECKED   
01AD   B7                     OR   A   ; 0: the text ran out before the closing quote
01AE   CA 87 03               JP   Z,e_quote   
01B1                          ENDIF      
01B1   F7                     RST   30h   
01B2                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character
01B2                             ; clears that character"s bit 6 (/M is CR, /` is space; "/" and ""' have no
01B2                             ; bit 6, so // and /" give themselves).
01B2                          IF   (1-CHECKED)*(1-EDITOR)   
                    H_PRINT:   LD   A,(HL)   
                              INC   HL   
                              CP   22h   
                              JR   Z,pr9   
                              CP   "/"   
                              JR   NZ,pr1   
                              LD   A,(HL)   
                              INC   HL   
                              AND   0BFh   
                    PR1:      RST   28h   
                              JR   h_print   
01B2                          ENDIF      
01B2                          IF   CHECKED   
01B2                             ; (The checked build has the loop as a routine, prstr, which the error
01B2                             ; report uses too. The address is kept on the stack meanwhile: a report
01B2                             ; shows the stack as it was before the "$".)
01B2   E5           H_PRINT:   PUSH   HL   
01B3   CD 56 04               CALL   prstr   
01B6   D1                     POP   DE   
01B7   DF                     RST   18h   
01B8                          ENDIF      
01B8                          IF   (1-CHECKED)*EDITOR   
                                 ; (With the editor the loop is a routine, prstr, which ^V uses too.)
                    H_PRINT:   CALL   prstr   
                              RST   18h   
01B8                          ENDIF      
01B8   7D           H_EMIT:   LD   A,L   ; "'"
01B9   EF                     RST   28h   
01BA   DF           PR9:      RST   18h   
01BB                             ; "#" prints TOS as a signed decimal number, with no space after it.
01BB   C5           H_NUM:    PUSH   BC   
01BC   CD 96 02               CALL   psgn   
01BF   C1                     POP   BC   
01C0   DF                     RST   18h   
01C1                             ; "?" ( n -- c ) or ( -n -- addr )
01C1                             ;   n > 0: wait about n ms for a key; 0 if none came
01C1                             ;   n = 0: wait for a key
01C1                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
01C1                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
01C1   CB 7C        H_KEY:    BIT   7,H   
01C3   20 19                  JR   NZ,line   
01C5   1E 28        KT1:      LD   E,MSLOOP   ; one millisecond, roughly
01C7   CD EE 02     KT2:      CALL   getk   
01CA   20 0E                  JR   NZ,kt3   
01CC   1D                     DEC   E   
01CD   20 F8                  JR   NZ,kt2   
01CF   7C                     LD   A,H   ; 0? never counts down: it waits
01D0   B5                     OR   L   
01D1   28 F2                  JR   Z,kt1   
01D3   2B                     DEC   HL   
01D4   7C                     LD   A,H   
01D5   B5                     OR   L   
01D6   20 ED                  JR   NZ,kt1   ; A = 0 if the time ran out
01D8   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
01D9   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
01DA   6F           KT3:      LD   L,A   
01DB   26 00                  LD   H,0   
01DD   F7                     RST   30h   
01DE                          IF   CPM   
                                 ; CP/M: BDOS 10 does the editing (the spec allows the platform's
                                 ; own line editor). It doesn't store the CR, so it is added here.
                    LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
                              ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
                              SBC   A,A   
                              AND   L   ; (0 for a count that is too big)
                              XOR   127   ; A = the count, 127 at most
                              LD   (LBHDR),A   
                              LD   DE,LBHDR   
                              LD   A,10   
                              CALL   bdosx   
                              LD   HL,LBHDR+1   
                              LD   A,(HL)   ; the count typed (0-127)
                              INC   L   ; HL = LINEBUF, whose low byte is 80h:
                              ADD   A,L   ;   adding the count to L can't carry
                              LD   L,A   
                              LD   (HL),13   
01DE                          ENDIF      
01DE                          IFN   CPM   
01DE                             ; Generic: Backspace takes the last character back (and is echoed as
01DE                             ; it is), CR ends (stored, not echoed), every other key is stored and
01DE                             ; echoed until the line is full. The line buffer starts at offset 80h
01DE                             ; of its page, so L alone is the place in the line: D holds the L of
01DE                             ; a full line.
01DE   11 7F 00     LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
01E1   19                     ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
01E2   9F                     SBC   A,A   
01E3   A5                     AND   L   ; (0 for a count that is too big)
01E4   2F                     CPL      
01E5   57                     LD   D,A   ; D = the L of a full line: 80h + count, FFh
01E6                             ;   at most
01E6   21 80 82               LD   HL,LINEBUF   
01E9   CD EE 02     LN2:      CALL   getk   
01EC   28 FB                  JR   Z,ln2   
01EE   FE 0D                  CP   13   
01F0   28 16                  JR   Z,ln5   
01F2   FE 08                  CP   8   
01F4   28 0B                  JR   Z,ln4   
01F6   5F                     LD   E,A   
01F7   7D                     LD   A,L   
01F8   BA                     CP   D   
01F9   28 EE                  JR   Z,ln2   ; full
01FB   73                     LD   (HL),E   
01FC   2C                     INC   L   
01FD   7B                     LD   A,E   
01FE   EF           LN3:      RST   28h   
01FF   18 E8                  JR   ln2   
0201   2D           LN4:      DEC   L   ; Backspace: one back, and echo it,
0202   FA FE 01               JP   M,ln3   ;   unless the line was empty (L left the
0205   2C                     INC   L   ;   upper half of the page)
0206   18 E1                  JR   ln2   
0208   77           LN5:      LD   (HL),A   ; the CR
0209                          ENDIF      
0209   2E 80                  LD   L,LINEBUF & 0FFh   
020B   F7                     RST   30h   
020C                             ; =============================================================================
020C                             ;  More routines (no handler starts past this point)
020C                             ; =============================================================================
020C                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
020C                             ; Uses A, BC; the caller saves the IP. The dividend shifts up through A:C
020C                             ; while the quotient bits arrive at the bottom of C.
020C                             ; Dividing by 2 is one shift (the spec wants that fast).
020C   7B           UDIV:     LD   A,E   
020D   EE 02                  XOR   2   
020F   B2                     OR   D   
0210   20 07                  JR   NZ,udv0   
0212   CB 3C                  SRL   H   
0214   CB 1D                  RR   L   ; the quotient
0216   8F                     ADC   A,A   
0217   5F                     LD   E,A   ; the remainder: the bit that fell out (D is 0)
0218   C9                     RET      
0219   7C           UDV0:     LD   A,H   
021A   4D                     LD   C,L   
021B   21 00 00               LD   HL,0   
021E   06 10                  LD   B,16   
0220   CB 21        UDV1:     SLA   C   
0222   17                     RLA      
0223   ED 6A                  ADC   HL,HL   
0225   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
0227   30 02                  JR   NC,udv2   ;   always fits in 16 bits
0229   19                     ADD   HL,DE   ; too much: put it back, and cancel the
022A   0D                     DEC   C   ;   INC below
022B   0C           UDV2:     INC   C   ; a quotient bit
022C   10 F2                  DJNZ   udv1   
022E   EB                     EX   DE,HL   ; DE = remainder
022F   67                     LD   H,A   
0230   69                     LD   L,C   ; HL = quotient
0231   C9                     RET      
0232                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
0232                             ; non-digit. Values wrap at 16 bits, as the spec says.
0232   21 00 00     RDNUM:    LD   HL,0   
0235   0A           RDN1:     LD   A,(BC)   
0236   D6 30                  SUB   "0"   
0238   FE 0A                  CP   10   
023A   D0                     RET   NC   
023B   03                     INC   BC   
023C   54                     LD   D,H   
023D   5D                     LD   E,L   
023E   29                     ADD   HL,HL   
023F   29                     ADD   HL,HL   
0240   19                     ADD   HL,DE   
0241   29                     ADD   HL,HL   ; HL * 10
0242   5F                     LD   E,A   
0243   16 00                  LD   D,0   
0245   19                     ADD   HL,DE   
0246   18 ED                  JR   rdn1   
0248                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
0248                             ; the next character, so "/"" does not end it. Leaves A = 22h.
0248                          IF   1-CHECKED   
                    SS0:      INC   BC   
                    SKIPSTR:   LD   A,(BC)   
                              INC   BC   
                              CP   "/"   
                              JR   Z,ss0   
                              CP   22h   
                              JR   NZ,skipstr   
                              RET      
0248                          ENDIF      
0248                          IF   CHECKED   
0248                             ; The checked build never steps over a NUL: if the text runs out first it
0248                             ; returns A = 0 with the IP on the NUL.
0248   0A           SKIPSTR:   LD   A,(BC)   
0249   B7                     OR   A   
024A   C8                     RET   Z   
024B   03                     INC   BC   
024C   FE 22                  CP   22h   
024E   C8                     RET   Z   
024F   FE 2F                  CP   "/"   
0251   20 F5                  JR   NZ,skipstr   
0253   0A                     LD   A,(BC)   ; the escaped character
0254   B7                     OR   A   
0255   C8                     RET   Z   
0256   03                     INC   BC   
0257   18 EF                  JR   skipstr   
0259                          ENDIF      
0259                             ; skip: read past text to the closer at this level, and return A = 0 if it
0259                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
0259                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
0259                             ; no closer; anything else that runs into the NUL had unbalanced brackets
0259                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
0259                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
0259                             ; 
0259                             ; The checked build also looks at the character the skip was started by,
0259                             ; which is always the one just before where it starts: "(" must end at ")",
0259                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
0259                             ; quote counts as running into it. "\" takes either closer. IX keeps the
0259                             ; place where the skip started, for the report.
0259                SKIP:        
0259                          IF   CHECKED   
0259   C5                     PUSH   BC   
025A   DD E1                  POP   IX   
025C   0B                     DEC   BC   
025D   0A                     LD   A,(BC)   
025E   03                     INC   BC   
025F   5F                     LD   E,A   ; E = the opener: ( [ or \
0260                          ENDIF      
0260   16 00                  LD   D,0   
0262   14           SK3:      INC   D   ; an opener: one deeper
0263   0A           SK1:      LD   A,(BC)   
0264                          IF   1-CHECKED   
                              INC   BC   
                              OR   A   
                              JP   Z,SKEND   ; (the end of the program)
0264                          ENDIF      
0264                          IF   CHECKED   
0264   B7                     OR   A   
0265   28 22                  JR   Z,sk6   ; (the IP stays on the NUL)
0267   03                     INC   BC   
0268                          ENDIF      
0268   FE 22                  CP   22h   
026A   CC 48 02               CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
026D   D6 28                  SUB   "("   ;   (or 0, and then the NUL is read next)
026F   28 F1                  JR   Z,sk3   
0271   3D                     DEC   A   ; ")"
0272   28 08                  JR   Z,sk4   
0274   D6 32                  SUB   "["-")"   
0276   28 EA                  JR   Z,sk3   
0278   FE 02                  CP   "]"-"["   
027A   20 E7                  JR   NZ,sk1   
027C   15           SK4:      DEC   D   
027D                          IF   1-CHECKED   
                              RET   Z   ; the closer at this level
                              JR   sk1   
027D                          ENDIF      
027D                          IF   CHECKED   
027D   20 E4                  JR   NZ,sk1   
027F   57                     LD   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
0280   AB                     XOR   E   ;   opener is 0 for "(" and 1 for "[", and only
0281   E6 06                  AND   6   ;   "\" has bit 2: so this is 2 for the wrong
0283   FE 02                  CP   2   ;   closer, and only then
0285   7A                     LD   A,D   
0286   C0                     RET   NZ   
0287   18 05                  JR   sk7   
0289   CB 53        SK6:      BIT   2,E   ; the text ran out:
028B   C2 C3 04               JP   NZ,SKEND   ;   "\" with no closer ends the program
028E   DD E5        SK7:      PUSH   IX   ; N. The place is the opener
0290   C1                     POP   BC   
0291   3E 4E                  LD   A,"N"   
0293   C3 84 03               JP   errp   ; (errp drops skip's return address)
0296                          ENDIF      
0296                             ; psgn: print HL as a signed number. Uses BC.
0296   CB 7C        PSGN:     BIT   7,H   
0298   28 04                  JR   Z,pdec   
029A   3E 2D                  LD   A,"-"   
029C   EF                     RST   28h   
029D   E7                     RST   20h   
029E                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
029E                             ; Uses BC.
029E   11 0A 00     PDEC:     LD   DE,10   
02A1   CD 0C 02               CALL   udiv   ; HL = HL / 10, E = the last digit
02A4   7B                     LD   A,E   
02A5   F5                     PUSH   AF   
02A6   7C                     LD   A,H   
02A7   B5                     OR   L   
02A8   C4 9E 02               CALL   NZ,pdec   
02AB   F1                     POP   AF   
02AC   C6 30                  ADD   A,"0"   
02AE   EF                     RST   28h   
02AF   C9                     RET      
02B0                             ; =============================================================================
02B0                             ;  Dispatch table: the low byte of each handler's address, in code order
02B0                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
02B0                             ;  It must not cross a page (the dispatcher only adds to its low byte).
02B0                             ; =============================================================================
02B0                             ; The handlers of the first NPG1 characters start in the image's second page.
02B0                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
02B0                             ; differs between the builds, so the count is worked out here.
02B0                             ; (One division to a line: asm80 only rounds down when it stores a value.)
02B0                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
02B0                PGBRK:    EQU   (h_break-BASE)/256   
02B0                PGDEF:    EQU   (h_def-BASE)/256   
02B0                PGFET:    EQU   (h_fetch-BASE)/256   
02B0                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
02B0                          IF   1-TABP0   
02B0                PTAB:        
02B0                          ;*Macro unroll:  PTABLE
02B0   9F                     DB   h_store & 0FFh   
02B1   A7                     DB   h_str & 0FFh   
02B2   BB                     DB   h_num & 0FFh   
02B3   B2                     DB   h_print & 0FFh   
02B4   97                     DB   h_swap & 0FFh   
02B5   3A                     DB   h_and & 0FFh   
02B6   B8                     DB   h_emit & 0FFh   
02B7   16                     DB   h_open & 0FFh   
02B8   1E                     DB   h_close & 0FFh   
02B9   5B                     DB   h_mul & 0FFh   
02BA   31                     DB   h_add & 0FFh   
02BB   D9                     DB   h_cfetch & 0FFh   
02BC   29                     DB   h_sub & 0FFh   
02BD   99                     DB   h_cstore & 0FFh   
02BE   6F                     DB   h_div & 0FFh   
02BF   95                     DB   h_dup & 0FFh   
02C0   9E                     DB   h_drop & 0FFh   
02C1   42                     DB   h_lt & 0FFh   
02C2   51                     DB   h_eq & 0FFh   
02C3   43                     DB   h_gt & 0FFh   
02C4   C1                     DB   h_key & 0FFh   
02C5   11                     DB   h_fetch & 0FFh   
02C6   ED                     DB   h_def & 0FFh   
02C7   E0                     DB   h_break & 0FFh   
02C8   DC                     DB   h_ret & 0FFh   
02C9   72                     DB   h_xor & 0FFh   
02CA   85                     DB   h_alloc & 0FFh   
02CB   C6                     DB   h_grave & 0FFh   
02CC   2C                     DB   h_tor & 0FFh   
02CD   7A                     DB   h_or & 0FFh   
02CE   1C                     DB   h_fromr & 0FFh   
02CF   82                     DB   h_not & 0FFh   
02D0                PTABEND:      
02D0                          ENDIF      
02D0                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
02D0                             ; and return its value in A with the carry set; otherwise leave the IP and
02D0                             ; return with the carry clear.
02D0   0A           HEXC:     LD   A,(BC)   
02D1   D6 30                  SUB   "0"   
02D3   FE 0A                  CP   10   
02D5   38 09                  JR   C,hc1   
02D7   E6 DF                  AND   0DFh   
02D9   D6 11                  SUB   11h   
02DB   FE 06                  CP   6   
02DD   D0                     RET   NC   
02DE   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
02E0   03           HC1:      INC   BC   
02E1   C9                     RET      
02E2                             ; =============================================================================
02E2                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
02E2                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
02E2                             ;  (RST 28h) prints A. Both keep BC, DE, HL and HL'. In the generic build
02E2                             ;  they are the host's KEY and CONOUT routines themselves.
02E2                             ; 
02E2                             ;  A running program reads the keyboard only through getk and pollk, which
02E2                             ;  between them give the break key its rules:
02E2                             ;    - Ctrl-C stops the program;
02E2                             ;    - any other key that the break check reads is held in KEYBUF for the
02E2                             ;      next "?", and a newer one takes its place;
02E2                             ;    - "?" (getk) takes the held key first;
02E2                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
02E2                             ;      key like any other, but two of them within about 250 ms still stop it.
02E2                             ;  Both are called straight from a handler, never from a routine under one:
02E2                             ;  the checked build's report counts on finding one return address above the
02E2                             ;  data stack.
02E2                             ; =============================================================================
02E2                          IFN   CPM   
02E2                RAWK:     EQU   KEY   
02E2                          ENDIF      
02E2                             ; pollk: the break check (see rpushn).
02E2   CD 06 FF     POLLK:    CALL   rawk   
02E5   C8                     RET   Z   ; no key
02E6   32 7A 82               LD   (KEYBUF),A   ; held for the next "?"
02E9   FE 03                  CP   3   
02EB   C0                     RET   NZ   
02EC   18 11                  JR   ctlc   
02EE                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
02EE   E5           GETK:     PUSH   HL   ; a held key goes first, and is taken out of
02EF   21 7A 82               LD   HL,KEYBUF   ;   the buffer
02F2   7E                     LD   A,(HL)   
02F3   36 00                  LD   (HL),0   
02F5   E1                     POP   HL   
02F6   B7                     OR   A   
02F7   C0                     RET   NZ   
02F8   CD 06 FF               CALL   rawk   
02FB   C8                     RET   Z   
02FC   FE 03                  CP   3   
02FE   C0                     RET   NZ   
02FF                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
02FF                             ; the program has turned it off, wait about 250 ms for one more key: a
02FF                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
02FF                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
02FF   3A 7B 82     CTLC:     LD   A,(BRKOFF)   
0302   B7                     OR   A   
0303   CA 7C 03               JP   Z,brk   
0306   D5                     PUSH   DE   
0307   11 10 27               LD   DE,250*MSLOOP   
030A   CD 06 FF     CT1:      CALL   rawk   
030D   20 05                  JR   NZ,ct2   
030F   1B                     DEC   DE   
0310   7A                     LD   A,D   
0311   B3                     OR   E   
0312   20 F6                  JR   NZ,ct1   
0314   D1           CT2:      POP   DE   ; A = the second key, or 0 if none came
0315   FE 03                  CP   3   
0317   CA 7C 03               JP   Z,brk   
031A   B7                     OR   A   
031B   28 03                  JR   Z,ct3   
031D   32 7A 82               LD   (KEYBUF),A   
0320   3E 03        CT3:      LD   A,3   
0322   B7                     OR   A   
0323   C9                     RET      
0324                          IF   (1-CHECKED)*(1-EDITOR)   
                    BRK:      EQU   endprog   ; the unchecked build stops without a word
0324                          ENDIF      ;   (with the editor, both stacks are cleared);
0324                          IF   (1-CHECKED)*EDITOR   
                    BRK:      EQU   edit0   
0324                          ENDIF      
0324                          IF   CHECKED   
0324                BRK:      EQU   e_break   ;   the checked build reports B
0324                          ENDIF      
0324                          IF   CPM   
                    RAWK:     LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
                                 ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
                                 ; printing and could swallow a key that BDOS 6 then never sees.
                    PUTC:     PUSH   DE   
                              PUSH   HL   
                              LD   E,A   
                              LD   A,6   
                              CALL   bdosx   
                              POP   HL   
                              POP   DE   
                              OR   A   ; (for getk)
                              RET      
                                 ; bdosx: call BDOS function A with DE, keeping BC and HL'
                    BDOSX:    PUSH   BC   
                              EXX      
                              PUSH   HL   
                              EXX      
                              LD   C,A   
                              CALL   BDOS   
                              EXX      
                              POP   HL   
                              EXX      
                              POP   BC   
                              RET      
0324                          ENDIF      
0324                             ; =============================================================================
0324                             ;  Checked build: the checks and the error report
0324                             ; =============================================================================
0324                          IF   CHECKED   
0324                             ; chkst: stop unless HL is in the program's own space: from the letter page
0324                             ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
0324                             ; whatever lies above the limit are safe. Memory above the heap top but
0324                             ; below the limit is the program's own: Tiny BASIC keeps its lines there.
0324                             ; It is the page of HL + 1 that is tested, so that one test serves both
0324                             ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
0324                             ; Keeps HL and BC.
0324   23           CHKST:    INC   HL   
0325   7C                     LD   A,H   
0326   2B                     DEC   HL   
0327   FE 82                  CP   LETPAGE   
0329   38 03                  JR   C,chs1   
032B                          ENDIF      
032B                          IF   CHECKED*(1-CPM)   
032B   FE F0                  CP   HEAPLIM   
032D   D8                     RET   C   
032E                          ENDIF      
032E                          IF   CHECKED*CPM   
                              LD   E,A   
                              LD   A,(0007h)   ; the BDOS page is the heap limit
                              DEC   A   
                              CP   E   
                              RET   NC   
032E                          ENDIF      
032E                          IF   CHECKED   
032E   C3 82 03     CHS1:     JP   e_store   
0331                             ; chkhp: HL = the new heap top, DE = the old one, the carry is from adding
0331                             ; the count. Stop if the top is not below the limit page, or is below the
0331                             ; program's end.
0331                CHKHP:       
0331                          ENDIF      
0331                          IF   CHECKED*CPM   
                                 ; With this much room a top that wrapped round can land back in
                                 ; range, so the add is tested too: growing (A, the count's high
                                 ; byte, is positive) must not carry, and releasing must.
                              RRA      ; the carry comes in above the sign:
                              ADD   A,40h   ;   bit 7 = carry XOR sign
                              ADD   A,A   
                              JR   C,e_heap   
                              LD   A,(0007h)   
                              DEC   A   
                              CP   H   
                              JR   C,e_heap   
0331                          ENDIF      
0331                          IF   CHECKED*(1-CPM)   
0331                             ; (Here the program's space is under 32K, so a top that wrapped
0331                             ; round always falls outside it.)
0331   7C                     LD   A,H   
0332   FE F0                  CP   HEAPLIM   
0334   30 09                  JR   NC,e_heap   
0336                          ENDIF      
0336                          IF   CHECKED   
0336   D5                     PUSH   DE   
0337   EB                     EX   DE,HL   
0338   2A 38 82               LD   HL,(NPEND)   
033B   19                     ADD   HL,DE   ; carry: at or above the program's end
033C   EB                     EX   DE,HL   
033D   D1                     POP   DE   
033E   D8                     RET   C   
033F   B7           E_HEAP:   OR   A   ; put the count back in TOS for the report
0340   ED 52                  SBC   HL,DE   
0342   C3 7F 03               JP   e_heap1   
0345                             ; chkstk: both stacks are checked once per character, not in every handler.
0345                             ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
0345                             ; the constant carries if it is above (cells were popped that were never
0345                             ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
0345                             ; a character late at most: the bytes above DSTOP and the guard band below
0345                             ; the page take what happens meanwhile. DE is free between characters.
0345   EB           CHKSTK:   EX   DE,HL   
0346   21 05 7E               LD   HL,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
0349   39                     ADD   HL,SP   
034A   EB                     EX   DE,HL   
034B   38 1E                  JR   C,e_under   
034D   14                     INC   D   
034E   20 17                  JR   NZ,e_over   
0350   D9                     EXX      ; the return stack: in its page (or it has
0351   7C                     LD   A,H   ;   overflowed), and not above its empty
0352   FE 80                  CP   RSPAGE   ;   position (an underflow stays inside the
0354   7D                     LD   A,L   ;   page, in the guard band)
0355   D9                     EXX      
0356   20 0C                  JR   NZ,e_rover   
0358   FE E1                  CP   RSTOP&0FFh+1   
035A   D8                     RET   C   
035B   D9                     EXX      ; return stack underflow: it counts as empty
035C   21 E0 80               LD   HL,RSTOP   
035F   D9                     EXX      
0360   3E 72                  LD   A,"r"   
0362   18 20                  JR   errp   
0364   3E 52        E_ROVER:   LD   A,"R"   ; return stack overflow
0366   11                     DB   11h   ; (LD DE,nn hides the next entry)
0367   3E 53        E_OVER:   LD   A,"S"   ; data stack overflow
0369   18 19                  JR   errp   
036B   31 FC 81     E_UNDER:   LD   SP,DSTOP   ; data stack underflow: it counts as empty
036E   3E 73                  LD   A,"s"   
0370   18 22                  JR   error   
0372                             ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
0372                             ; was never defined still holds 0000h, and the byte there is a reserved one
0372                             ; in every build (AFh or C3h): if the IP is in page zero, this was a call of
0372                             ; an undefined word. The call is undone, so the place is the call itself.
0372   04           E_HI:     INC   B   
0373   10 17                  DJNZ   e_resv   ; (B is as it was, and is not 0)
0375   CF                     RST   08h   
0376   42                     LD   B,D   
0377   4B                     LD   C,E   
0378   3E 55                  LD   A,"U"   
037A   18 18                  JR   error   
037C                             ; Error entries. Each loads its letter and then hides the next entry inside
037C                             ; a 3-byte LD DE,nn (the 11h), so they all fall through to `error`.
037C   3E 42        E_BREAK:   LD   A,"B"   ; Ctrl-C (found inside pollk or getk)
037E   11                     DB   11h   
037F   3E 48        E_HEAP1:   LD   A,"H"   ; heap (found inside chkhp)
0381   11                     DB   11h   
0382   3E 4F        E_STORE:   LD   A,"O"   ; a store outside the program's space (chkst)
0384                             ; errp: an error found inside a routine: drop its return address first.
0384   D1           ERRP:     POP   DE   
0385   18 0D                  JR   error   
0387   44           E_QUOTE:   LD   B,H   ; an unclosed string: HL is its address, one
0388   4D                     LD   C,L   ;   past the opening quote, which is the place
0389   3E 51                  LD   A,"Q"   
038B   11                     DB   11h   
038C   3E 58        E_RESV:   LD   A,"X"   ; a reserved byte outside a string
038E   11                     DB   11h   
038F   3E 5A        E_ZERO:   LD   A,"Z"   ; dividing by zero
0391   11                     DB   11h   
0392   3E 57        E_BRACK:   LD   A,"W"   ; bad character after [
0394                             ; error: the report, then the end. A = the letter, BC = one past the place,
0394                             ; HL = TOS, and both stacks as the report is to show them:
0394                             ; 
0394                             ;   Err X @ line,col
0394                             ;   up to 16 characters of the text from the place
0394                             ;   Stk n: the top 8 cells at most, bottom to top
0394                             ;   Rtn n
0394   E5           ERROR:    PUSH   HL   ; now the whole data stack is in memory
0395   5F                     LD   E,A   
0396   CD 69 04               CALL   pnl   
0399   45 72 72 20 22         DB   "Err ",22h   
039E   7B                     LD   A,E   
039F   EF                     RST   28h   
03A0   CD 6F 04               CALL   pmsg   
03A3   20 40 20 22            DB   " @ ",22h   
03A7   0B                     DEC   BC   ; BC = the place
03A8                             ; The line and column. A place below the program is in the line
03A8                             ; buffer: line 0. Otherwise count the LFs from the program's start;
03A8                             ; DE = the line's number, HL = where it starts.
03A8   21 80 82               LD   HL,LINEBUF   
03AB   11 00 00               LD   DE,0   
03AE   78                     LD   A,B   
03AF   FE 83                  CP   PROG/256   
03B1   38 14                  JR   C,er3   
03B3   24                     INC   H   
03B4   6B                     LD   L,E   ; HL = PROG
03B5   13           ER1:      INC   DE   ; a new line starts at HL
03B6   E5                     PUSH   HL   
03B7   7D           ER2:      LD   A,L   
03B8   91                     SUB   C   
03B9   7C                     LD   A,H   
03BA   98                     SBC   A,B   
03BB   30 09                  JR   NC,er2x   ; reached the place
03BD   7E                     LD   A,(HL)   
03BE   23                     INC   HL   
03BF   FE 0A                  CP   10   
03C1   20 F4                  JR   NZ,er2   
03C3   F1                     POP   AF   
03C4   18 EF                  JR   er1   
03C6   E1           ER2X:     POP   HL   
03C7   C5           ER3:      PUSH   BC   
03C8   E5                     PUSH   HL   
03C9   EB                     EX   DE,HL   
03CA   CD 9E 02               CALL   pdec   ; the line
03CD   3E 2C                  LD   A,","   
03CF   EF                     RST   28h   
03D0   D1                     POP   DE   
03D1   E1                     POP   HL   
03D2   E5                     PUSH   HL   
03D3   B7                     OR   A   
03D4   ED 52                  SBC   HL,DE   
03D6   23                     INC   HL   
03D7   CD 9E 02               CALL   pdec   ; the column
03DA   CD 69 04               CALL   pnl   
03DD   22                     DB   22h   
03DE   E1                     POP   HL   ; the text, as it is: 16 characters, or fewer
03DF   06 10                  LD   B,16   ;   if the line or the program ends first
03E1   7E           ER4:      LD   A,(HL)   
03E2   23                     INC   HL   
03E3   B7                     OR   A   
03E4   28 0B                  JR   Z,er5   
03E6   FE 0D                  CP   13   
03E8   28 07                  JR   Z,er5   
03EA   FE 0A                  CP   10   
03EC   28 03                  JR   Z,er5   
03EE                          ENDIF      
03EE                          IF   CHECKED*CPM   
                              CP   1Ah   ; (the ^Z that pads a file's last record ends
                              JR   Z,er5   ;   the text too: some terminals clear the
03EE                          ENDIF      ;   screen on it)
03EE                          IF   CHECKED   
03EE   EF                     RST   28h   
03EF   10 F0                  DJNZ   er4   
03F1                ER5:         ; (without the editor: on into pstk)
03F1                          ENDIF      
03F1                          IF   CHECKED*EDITOR   
03F1   CD FB 03               CALL   pstk   
03F4   CD 69 04               CALL   pnl   
03F7   22                     DB   22h   
03F8   C3 BF 04               JP   edit0   ; back to the editor, with both stacks cleared
03FB                          ENDIF      
03FB                             ; =============================================================================
03FB                             ;  Routines that the checked build's report and the editor share
03FB                             ; =============================================================================
03FB                SPADJ:    EQU   2*EDITOR   ; (with the editor pstk is called, not fallen
03FB                             ;   into: the stack is one address deeper)
03FB                          IF   CHECKED+EDITOR   
03FB                             ; pstk: the two stack lines:  Stk n: the top 8 cells at most, bottom to top
03FB                             ;                             Rtn n
03FB                             ; TOS must be in memory with the rest (pushed). In a build without the
03FB                             ; editor this is the end of `error`, which runs on into it.
03FB   CD 69 04     PSTK:     CALL   pnl   
03FE   53 74 6B 20 22         DB   "Stk ",22h   
0403   21 F8 81               LD   HL,DSTOP-2-SPADJ   ; (the cell at DSTOP-2 was pushed with the
0406   B7                     OR   A   ;   first value and holds nothing)
0407   ED 72                  SBC   HL,SP   
0409   CD 4C 04               CALL   phalf   ; the depth
040C   3E 3A                  LD   A,":"   
040E   EF                     RST   28h   
040F   79                     LD   A,C   
0410   FE 09                  CP   9   
0412   38 0A                  JR   C,er6   
0414   CD 6F 04               CALL   pmsg   
0417   20 2E 2E 2E 22         DB   " ...",22h   
041C   0E 08                  LD   C,8   
041E   26 00        ER6:      LD   H,0   ; C = the number of cells to show
0420   69                     LD   L,C   
0421   29                     ADD   HL,HL   
0422   39                     ADD   HL,SP   ; HL -> just above the deepest of them
0423                          ENDIF      
0423                          IF   EDITOR   
0423   23                     INC   HL   
0424   23                     INC   HL   
0425                          ENDIF      
0425                          IF   CHECKED+EDITOR   
0425   0C                     INC   C   
0426   0D           ER7:      DEC   C   
0427   28 11                  JR   Z,er8   
0429   2B                     DEC   HL   
042A   56                     LD   D,(HL)   
042B   2B                     DEC   HL   
042C   5E                     LD   E,(HL)   
042D   E5                     PUSH   HL   
042E   C5                     PUSH   BC   
042F   3E 20                  LD   A," "   
0431   EF                     RST   28h   
0432   EB                     EX   DE,HL   
0433   CD 96 02               CALL   psgn   
0436   C1                     POP   BC   
0437   E1                     POP   HL   
0438   18 EC                  JR   er7   
043A   CD 69 04     ER8:      CALL   pnl   
043D   52 74 6E 20 22         DB   "Rtn ",22h   
0442   D9                     EXX      
0443   E5                     PUSH   HL   
0444   D9                     EXX      
0445   D1                     POP   DE   
0446   21 E0 80               LD   HL,RSTOP   
0449   B7                     OR   A   
044A   ED 52                  SBC   HL,DE   
044C                          ENDIF      
044C                          IF   CHECKED*(1-EDITOR)   
                              CALL   phalf   
                              CALL   pnl   
                              DB   22h   
                              JP   endprog   
044C                          ENDIF      
044C                          IF   CHECKED+EDITOR   
044C                             ; phalf: print half of HL, and leave it in C. (With the editor, pstk ends by
044C                             ; running on into this.)
044C   CB 3C        PHALF:    SRL   H   
044E   CB 1D                  RR   L   
0450   E5                     PUSH   HL   
0451   CD 9E 02               CALL   pdec   
0454   C1                     POP   BC   
0455   C9                     RET      
0456                             ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
0456                             ; "$", and the texts of the report and the editor). In the checked build a
0456                             ; NUL first is an error: Q.
0456   7E           PRSTR:    LD   A,(HL)   
0457   23                     INC   HL   
0458   FE 22                  CP   22h   
045A   C8                     RET   Z   
045B                          ENDIF      
045B                          IF   CHECKED   
045B   B7                     OR   A   
045C   28 17                  JR   Z,e_dollar   
045E                          ENDIF      
045E                          IF   CHECKED+EDITOR   
045E   FE 2F                  CP   "/"   
0460   20 04                  JR   NZ,prs1   
0462   7E                     LD   A,(HL)   
0463   23                     INC   HL   
0464   E6 BF                  AND   0BFh   
0466   EF           PRS1:     RST   28h   
0467   18 ED                  JR   prstr   
0469                             ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
0469                             ; pnl: the same, on a new line.
0469   3E 0D        PNL:      LD   A,13   
046B   EF                     RST   28h   
046C   3E 0A                  LD   A,10   
046E   EF                     RST   28h   
046F   E3           PMSG:     EX   (SP),HL   
0470   CD 56 04               CALL   prstr   
0473   E3                     EX   (SP),HL   
0474   C9                     RET      
0475                          ENDIF      
0475                          IF   CHECKED   
0475   D1           E_DOLLAR:   POP   DE   ; "$" ran into a NUL: drop the return address,
0476   E1                     POP   HL   ;   and put the string's address back in TOS
0477   3E 51                  LD   A,"Q"   
0479   C3 94 03               JP   error   
047C                          ENDIF      
047C                             ; =============================================================================
047C                             ;  The line editor (EDITOR = 1)
047C                             ; 
047C                             ;  The interpreter starts here, and a program that ends comes back here.
047C                             ;  There is no prompt. It follows the spec's suggested standard for a line
047C                             ;  editor (docs/b8script.md, Environments). Type a line and press Return:
047C                             ; 
047C                             ;    n text    put the text in as line n; the lines from n on move down. A
047C                             ;              number past the end (or 0) adds the line at the end.
047C                             ;    n         take line n out
047C                             ;    anything else is run at once, as B8Script. (Start such a line with a
047C                             ;    space if it would begin with a digit.)
047C                             ; 
047C                             ;  A command key ends the line too, and takes what was typed as its argument:
047C                             ; 
047C                             ;    ^G        run the program
047C                             ;    n ^L      list from line n (no number: all of it). Any key holds the
047C                             ;              list until another key is pressed; Ctrl-C ends it.
047C                             ;    n ^E      put line n in the input line; Return puts it back, changed
047C                             ;    name ^R   read. CP/M: the file of that name (no name: the same file as
047C                             ;              last time). Generic: what is typed, or pasted, from now until
047C                             ;              ^Z replaces the program; it is not echoed.
047C                             ;    name ^W   write. CP/M: to that file (no name: the same file as last
047C                             ;              time). Generic: the text is printed, as it is.
047C                             ;    ^N ^N     new: no program (the key twice in a row)
047C                             ;    ^V        view: the build, both stacks, and the program's size, lines
047C                             ;              and free memory
047C                             ;    ^X        leave (to LEAVE)
047C                             ; 
047C                             ;  In the line: ^B and ^F, or the left and right arrow keys, move the cursor;
047C                             ;  a character goes in at the cursor; Backspace and DEL take out the one
047C                             ;  before it; Esc drops the line. Only CR, LF, BS and printing characters are
047C                             ;  sent to the terminal, so any terminal will do.
047C                             ; 
047C                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
047C                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
047C                             ;  125 characters; the one character after a line number separates it from
047C                             ;  the text and is not stored. The text is kept as it is typed, each line
047C                             ;  ending in CR LF, at PROG.
047C                             ; 
047C                             ;  What lasts from one line to the next: the program, the words, the
047C                             ;  variables and the data stack. An error or a break clears both stacks. The
047C                             ;  return stack starts empty for every line.
047C                             ; 
047C                             ;  Things to know:
047C                             ;    - Reset empties the program (generic builds).
047C                             ;    - A word's address points into the program, so run the program again
047C                             ;      after editing it.
047C                             ;    - Nothing is printed between a program's output and what is typed next.
047C                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
047C                             ;      a line that calls -n? and carries on afterwards runs what was typed.
047C                             ;      (The stored program never comes back to the line, so it may.)
047C                             ;    - The editor"s own keys are not the program"s: -n? is the plain line
047C                             ;      read of the other builds (BDOS 10 under CP/M).
047C                             ; 
047C                             ;  The data stack is the CPU's stack, so the editor works on top of whatever
047C                             ;  the last line left there, with TOS pushed like the rest.
047C                             ; =============================================================================
047C                          IF   EDGEN   
047C                INIT:        ; reset (A = 0)
047C                          ENDIF      
047C                          IF   EDGEN*CHECKED   
047C                             ; Clear the lower half of the letter page: every variable starts at 0, and
047C                             ; every word cell holds 0000h, the address an undefined word is caught at
047C                             ; (see e_hi).
047C   21 00 82               LD   HL,LET   
047F   77           INI1:     LD   (HL),A   
0480   2C                     INC   L   
0481   F2 7F 04               JP   P,ini1   ; +00h to +7Fh
0484                          ENDIF      
0484                          IF   EDGEN   
0484   18 39                  JR   edit0   
0486                          ENDIF      
0486                          IF   EDITOR   
0486                             ; ^B, left arrow: the cursor goes one to the left
0486   7D           LEFT:     LD   A,L   
0487   87                     ADD   A,A   
0488   28 4D                  JR   Z,ed1   ; (L = 80h: at the start)
048A   2D                     DEC   L   
048B   3E 08                  LD   A,8   
048D   EF           LF1:      RST   28h   
048E   18 47                  JR   ed1   
0490                             ; ^F, right arrow: one to the right, by printing the character there
0490   7D           RIGHT:    LD   A,L   
0491   BB                     CP   E   
0492   28 43                  JR   Z,ed1   ; at the end
0494   7E                     LD   A,(HL)   
0495   2C                     INC   L   
0496   18 F5                  JR   lf1   
0498                             ; Esc: alone it drops the line. An arrow key sends Esc [ and a letter, so
0498                             ; wait about 5 ms for a second key: after a "[" read on to the letter that
0498                             ; ends the sequence, and act on C (right) and D (left).
0498   01 C8 00     ESC:      LD   BC,5*MSLOOP   
049B   CD 06 FF     ES1:      CALL   rawk   
049E   20 0A                  JR   NZ,es2   
04A0   0B                     DEC   BC   
04A1   78                     LD   A,B   
04A2   B1                     OR   C   
04A3   20 F6                  JR   NZ,es1   
04A5   CD 0C 05               CALL   fin   ; no second key: the line is dropped
04A8   18 1B                  JR   edit   
04AA   FE 5B        ES2:      CP   "["   
04AC   20 29                  JR   NZ,ed1   ; not a sequence known here
04AE   CD 65 05     ES3:      CALL   ekey   
04B1   FE 40                  CP   40h   
04B3   38 F9                  JR   C,es3   ; (its parameters)
04B5   FE 43                  CP   "C"   
04B7   28 D7                  JR   Z,right   
04B9   FE 44                  CP   "D"   
04BB   28 C9                  JR   Z,left   
04BD   18 18                  JR   ed1   
04BF                             ; edit0: reset, an error or a break: both stacks are cleared.
04BF                             ; skend: a program that ended inside skip: its return address goes.
04BF                             ; edend: a program that ended: TOS joins the rest of the data stack.
04BF   31 FA 81     EDIT0:    LD   SP,DSTOP-2   ; empty (the cell that stands for TOS is pushed)
04C2   21                     DB   21h   ; (LD HL,nn: steps over the next two bytes)
04C3   D1           SKEND:    POP   DE   
04C4   E5           EDEND:    PUSH   HL   
04C5                             ; edit: start a new input line.
04C5   D9           EDIT:     EXX      
04C6   21 E0 80               LD   HL,RSTOP   ; the return stack is empty
04C9   D9                     EXX      
04CA   21 00 00               LD   HL,0   
04CD   22 7A 82               LD   (KEYBUF),HL   ; no key is held, and the break key is on
04D0   22 3A 82               LD   (EDLN),HL   ; no line is being edited
04D3   21 80 82               LD   HL,LINEBUF   ; HL = the cursor,
04D6   5D                     LD   E,L   ;   E = the end of the line (its low byte)
04D7   CD 65 05     ED1:      CALL   ekey   
04DA   FE 7F                  CP   7Fh   
04DC   28 40                  JR   Z,bsp   ; DEL
04DE   FE 20                  CP   " "   
04E0   30 56                  JR   NC,insc   
04E2   FE 09                  CP   9   
04E4   28 52                  JR   Z,insc   ; Tab is text
04E6   FE 08                  CP   8   
04E8   28 34                  JR   Z,bsp   
04EA   FE 02                  CP   2   
04EC   28 98                  JR   Z,left   ; ^B
04EE   FE 06                  CP   6   
04F0   28 9E                  JR   Z,right   ; ^F
04F2   FE 1B                  CP   1Bh   
04F4   28 A2                  JR   Z,esc   
04F6   E5                     PUSH   HL   ; a command key? Look it up
04F7   21 6B 05               LD   HL,cmds   
04FA   06 09                  LD   B,NCMD   
04FC   BE           ED2:      CP   (HL)   
04FD   23                     INC   HL   
04FE   28 07                  JR   Z,ed3   
0500   23                     INC   HL   
0501   23                     INC   HL   
0502   10 F8                  DJNZ   ed2   
0504   E1                     POP   HL   
0505   18 D0                  JR   ed1   ; no: the key is ignored
0507   7E           ED3:      LD   A,(HL)   
0508   23                     INC   HL   
0509   66                     LD   H,(HL)   
050A   6F                     LD   L,A   
050B   E3                     EX   (SP),HL   ; the command's address: fin returns to it
050C                             ; fin: end the input line: CR LF and a NUL after it, and a new line on the
050C                             ; terminal. Leaves BC -> the line and HL -> the NUL.
050C   26 82        FIN:      LD   H,LETPAGE   
050E   6B                     LD   L,E   
050F   36 0D                  LD   (HL),13   
0511   2C                     INC   L   
0512   36 0A                  LD   (HL),10   
0514   2D                     DEC   L   
0515   CD E3 06               CALL   prl   ; (prints the CR LF)
0518   36 00                  LD   (HL),0   
051A   01 80 82               LD   BC,LINEBUF   
051D   C9                     RET      
051E                             ; Backspace, DEL: the character before the cursor goes. The cursor moves
051E                             ; left, the rest of the line moves down over it, and the last place (now a
051E                             ; space) is printed over along with the rest.
051E   7D           BSP:      LD   A,L   
051F   87                     ADD   A,A   
0520   28 B5                  JR   Z,ed1   ; at the start
0522   2D                     DEC   L   
0523   3E 08                  LD   A,8   
0525   EF                     RST   28h   
0526   E5                     PUSH   HL   
0527   2C           BS1:      INC   L   
0528   7E                     LD   A,(HL)   
0529   2D                     DEC   L   
052A   77                     LD   (HL),A   
052B   2C                     INC   L   
052C   7D                     LD   A,L   
052D   BB                     CP   E   
052E   20 F7                  JR   NZ,bs1   
0530   2D                     DEC   L   
0531   36 20                  LD   (HL)," "   
0533   E1                     POP   HL   
0534   53                     LD   D,E   
0535   1D                     DEC   E   
0536   18 15                  JR   ic2   
0538                             ; A character goes in at the cursor: it ripples up through the rest of the
0538                             ; line, the cursor moves on, and the rest is printed again.
0538   47           INSC:     LD   B,A   
0539   7B                     LD   A,E   
053A   FE FD                  CP   0FDh   
053C   28 99                  JR   Z,ed1   ; the line is full: 125 characters
053E   78                     LD   A,B   
053F   EF                     RST   28h   
0540   E5                     PUSH   HL   
0541   7E           IC1:      LD   A,(HL)   
0542   70                     LD   (HL),B   
0543   47                     LD   B,A   
0544   7D                     LD   A,L   
0545   2C                     INC   L   
0546   BB                     CP   E   
0547   20 F8                  JR   NZ,ic1   
0549   E1                     POP   HL   
054A   2C                     INC   L   
054B   1C                     INC   E   
054C   53                     LD   D,E   
054D   CD 52 05     IC2:      CALL   tail   
0550   18 85                  JR   ed1   
0552                             ; tail: print the line from the cursor to D (a low byte), and bring the
0552                             ; cursor back with backspaces. Nothing at all if the cursor is at D.
0552   4D           TAIL:     LD   C,L   
0553   7D           TA1:      LD   A,L   
0554   BA                     CP   D   
0555   28 05                  JR   Z,ta2   
0557   7E                     LD   A,(HL)   
0558   EF                     RST   28h   
0559   2C                     INC   L   
055A   18 F7                  JR   ta1   
055C   7D           TA2:      LD   A,L   
055D   B9                     CP   C   
055E   C8                     RET   Z   
055F   3E 08                  LD   A,8   
0561   EF                     RST   28h   
0562   2D                     DEC   L   
0563   18 F7                  JR   ta2   
0565                             ; ekey: wait for a key
0565   CD 06 FF     EKEY:     CALL   rawk   
0568   28 FB                  JR   Z,ekey   
056A   C9                     RET      
056B                             ; The command keys, and where each goes (after fin).
056B   0D           CMDS:     DB   13   
056C   C5 05                  DW   cret   
056E   07                     DB   7   ; ^G
056F   0D 06                  DW   crun   
0571   0C                     DB   12   ; ^L
0572   23 06                  DW   clist   
0574   05                     DB   5   ; ^E
0575   94 05                  DW   cedln   
0577   12                     DB   18   ; ^R
0578   EC 06                  DW   cread   
057A   17                     DB   23   ; ^W
057B   1F 07                  DW   cwrite   
057D   0E                     DB   14   ; ^N
057E   86 05                  DW   cnew   
0580   16                     DB   22   ; ^V
0581   55 06                  DW   cview   
0583   18                     DB   24   ; ^X
0584   09 FF                  DW   LEAVE   
0586                NCMD:     EQU   9   
0586                             ; ^N ^N: no program, if the next key is ^N too
0586   CD 65 05     CNEW:     CALL   ekey   
0589   FE 0E                  CP   14   
058B   20 04                  JR   NZ,ged0   
058D   AF                     XOR   A   
058E   32 00 83               LD   (PROG),A   
0591   C3 C5 04     GED0:     JP   edit   
0594                             ; ^E: line n goes into the input line, to be changed. EDLN remembers which
0594                             ; line it was: Return puts the text back in its place.
0594   CD 32 02     CEDLN:    CALL   rdnum   
0597   E5                     PUSH   HL   
0598   CD CB 06               CALL   find   ; HL -> the line, or the NUL if there is none
059B   D1                     POP   DE   
059C   7E                     LD   A,(HL)   
059D   B7                     OR   A   
059E   28 F1                  JR   Z,ged0   
05A0   ED 53 3A 82            LD   (EDLN),DE   
05A4   11 80 82               LD   DE,LINEBUF   
05A7   7E           CE1:      LD   A,(HL)   
05A8   FE 0D                  CP   13   
05AA   28 0C                  JR   Z,ce2   
05AC   FE 0A                  CP   10   
05AE   28 08                  JR   Z,ce2   
05B0   12                     LD   (DE),A   
05B1   23                     INC   HL   
05B2   1C                     INC   E   
05B3   7B                     LD   A,E   
05B4   FE FD                  CP   0FDh   ; (a longer line is cut at 125 characters)
05B6   20 EF                  JR   NZ,ce1   
05B8   21 80 82     CE2:      LD   HL,LINEBUF   ; show it; the cursor ends up at its end
05BB   7D           CE3:      LD   A,L   
05BC   BB                     CP   E   
05BD   CA D7 04               JP   Z,ed1   
05C0   7E                     LD   A,(HL)   
05C1   EF                     RST   28h   
05C2   2C                     INC   L   
05C3   18 F6                  JR   ce3   
05C5                             ; Return. If ^E put a line here, the text goes back in its place. If not:
05C5                             ; a number and text is a line to put in, a number alone a line to take out,
05C5                             ; and anything else is run where it is.
05C5   E5           CRET:     PUSH   HL   ; the end of what was typed
05C6   2A 3A 82               LD   HL,(EDLN)   
05C9   7C                     LD   A,H   
05CA   B5                     OR   L   
05CB   28 07                  JR   Z,cr1   
05CD   E5                     PUSH   HL   
05CE   CD BB 06               CALL   delln   
05D1   E1                     POP   HL   
05D2   18 13                  JR   ins   
05D4   CD 32 02     CR1:      CALL   rdnum   ; HL = the number it starts with, BC -> after
05D7   79                     LD   A,C   ; C is still 80h if there was no number:
05D8   87                     ADD   A,A   ;   only then is twice it 0
05D9   28 36                  JR   Z,st0p   ; no number: run the line
05DB   0A                     LD   A,(BC)   
05DC   FE 0D                  CP   13   
05DE   20 06                  JR   NZ,cr2   
05E0   D1                     POP   DE   ; the number alone: take that line out
05E1   CD BB 06               CALL   delln   
05E4   18 24                  JR   gedit   
05E6   03           CR2:      INC   BC   ; step over the one character after the number
05E7                             ; Put the text at BC in as line n (in HL): open a gap of its length there,
05E7                             ; CR and LF included, and copy it in.
05E7   CD CB 06     INS:      CALL   find   ; HL -> where it goes
05EA   D1                     POP   DE   ; the end of what was typed
05EB   7B                     LD   A,E   
05EC   91                     SUB   C   ; A = the length of the text, with its CR LF
05ED   C5                     PUSH   BC   ; the text
05EE   4F                     LD   C,A   
05EF   06 00                  LD   B,0   
05F1   C5                     PUSH   BC   ; its length
05F2   54                     LD   D,H   
05F3   5D                     LD   E,L   ; DE = where it goes
05F4   AF                     XOR   A   
05F5   4F                     LD   C,A   ; BC = 0: CPIR looks as far as it needs to
05F6   ED B1                  CPIR      ; HL -> one past the program's NUL
05F8   ED 52                  SBC   HL,DE   ; the number of bytes to move up, NUL included
05FA   44                     LD   B,H   
05FB   4D                     LD   C,L   
05FC   19                     ADD   HL,DE   
05FD   2B                     DEC   HL   ; HL -> the NUL
05FE   EB                     EX   DE,HL   
05FF   E3                     EX   (SP),HL   ; HL = the length; where it goes is kept
0600   E5                     PUSH   HL   
0601   19                     ADD   HL,DE   ; the NUL's new place
0602   EB                     EX   DE,HL   
0603   ED B8                  LDDR      ; move the rest of the program up
0605   C1                     POP   BC   ; the length
0606   D1                     POP   DE   ; where it goes
0607   E1                     POP   HL   ; the text
0608   ED B0                  LDIR      
060A   C3 C5 04     GEDIT:    JP   edit   
060D                             ; ^G: run the program. st0p: run the typed line (BC -> it).
060D   01 00 83     CRUN:     LD   BC,PROG   
0610   3E                     DB   3Eh   ; (LD A,n: steps over the POP)
0611   E1           ST0P:     POP   HL   ; (the end of what was typed)
0612                             ; st0: start running at BC. The heap starts after the stored program's NUL.
0612   21 00 83     ST0:      LD   HL,PROG   
0615   AF                     XOR   A   
0616   BE           ST1:      CP   (HL)   
0617   23                     INC   HL   
0618   20 FC                  JR   NZ,st1   
061A   22 7C 82               LD   (HEAP),HL   
061D                          ENDIF      
061D                          IF   EDITOR*CHECKED   
061D   E7                     RST   20h   ; minus the heap"s first address: "_' may not
061E   22 38 82               LD   (NPEND),HL   ;   release below it
0621                          ENDIF      
0621                          IF   EDITOR   
0621   E1                     POP   HL   ; TOS: the data stack is as the last line left it
0622   F7                     RST   30h   ; (its return address is thrown away)
0623                             ; ^L: list from line n. DE = the number of the line at HL.
0623   CD 32 02     CLIST:    CALL   rdnum   ; HL = n, or 0 if there was none:
0626   7C                     LD   A,H   
0627   B5                     OR   L   
0628   20 01                  JR   NZ,li0   
062A   2C                     INC   L   ;   then from line 1
062B   E5           LI0:      PUSH   HL   
062C   CD CB 06               CALL   find   
062F   D1                     POP   DE   
0630   7E           LI1:      LD   A,(HL)   
0631   B7                     OR   A   
0632   28 D6                  JR   Z,gedit   ; the end of the text
0634   CD 06 FF               CALL   rawk   
0637   28 0B                  JR   Z,li3   ; no key: carry on
0639   FE 03                  CP   3   
063B   28 CD                  JR   Z,gedit   ; Ctrl-C
063D   CD 65 05               CALL   ekey   ; any other key: wait for one more
0640   FE 03                  CP   3   
0642   28 C6                  JR   Z,gedit   
0644   E5           LI3:      PUSH   HL   
0645   D5                     PUSH   DE   
0646   EB                     EX   DE,HL   
0647   CD 9E 02               CALL   pdec   ; the line's number,
064A   3E 20                  LD   A," "   
064C   EF                     RST   28h   ;   a space,
064D   D1                     POP   DE   
064E   E1                     POP   HL   
064F   13                     INC   DE   
0650   CD E3 06               CALL   prl   ;   and the line
0653   18 DB                  JR   li1   
0655                             ; ^V: view.
0655   CD 6F 04     CVIEW:    CALL   pmsg   
0658   42 38 53 5A 38 30 45   DB   "B8SZ80E"   
065F                          ENDIF      
065F                          IF   EDITOR*CHECKED   
065F   43                     DB   "C"   
0660                          ENDIF      
0660                          IF   EDITOR   
0660   20 32 30 32 36 2D 31 31 2D 32 31 22 DB   " 2026-11-21",22h   
066C   CD FB 03               CALL   pstk   ; both stacks
066F   21 00 83               LD   HL,PROG   
0672   11 00 00               LD   DE,0   
0675   7E           CV1:      LD   A,(HL)   ; count the lines, and find the end
0676   B7                     OR   A   
0677   28 08                  JR   Z,cv2   
0679   23                     INC   HL   
067A   FE 0A                  CP   10   
067C   20 F7                  JR   NZ,cv1   
067E   13                     INC   DE   
067F   18 F4                  JR   cv1   
0681   E5           CV2:      PUSH   HL   ; the NUL
0682   D5                     PUSH   DE   ; the lines
0683   11 00 7D               LD   DE,(0-PROG)&0FFFFh   
0686   19                     ADD   HL,DE   
0687   CD 69 04               CALL   pnl   
068A   50 72 6F 67 20 22      DB   "Prog ",22h   
0690   CD 9E 02               CALL   pdec   ; the program's size
0693   E1                     POP   HL   
0694   CD 69 04               CALL   pnl   
0697   4C 69 6E 65 73 20 22   DB   "Lines ",22h   
069E   CD 9E 02               CALL   pdec   
06A1   D1                     POP   DE   
06A2                          ENDIF      
06A2                          IF   EDGEN   
06A2   21 FF EF               LD   HL,HEAPLIM*256-1   
06A5                          ENDIF      
06A5                          IF   EDITOR*CPM   
                              LD   A,(0007h)   ; the BDOS page is the limit
                              LD   H,A   
                              LD   L,0   
                              DEC   HL   
06A5                          ENDIF      
06A5                          IF   EDITOR   
06A5   B7                     OR   A   
06A6   ED 52                  SBC   HL,DE   
06A8   CD 69 04               CALL   pnl   
06AB   46 72 65 65 20 22      DB   "Free ",22h   
06B1   CD 9E 02               CALL   pdec   ; the room left for text and heap
06B4   CD 69 04               CALL   pnl   
06B7   22                     DB   22h   
06B8   C3 C5 04     GED1:     JP   edit   
06BB                             ; delln: take line n (in HL) out: copy everything after it down over it.
06BB   CD CB 06     DELLN:    CALL   find   
06BE   54                     LD   D,H   
06BF   5D                     LD   E,L   
06C0   CD D9 06               CALL   nxl   ; HL -> the next line
06C3   7E           DE1:      LD   A,(HL)   
06C4   12                     LD   (DE),A   
06C5   23                     INC   HL   
06C6   13                     INC   DE   
06C7   B7                     OR   A   
06C8   20 F9                  JR   NZ,de1   
06CA   C9                     RET      
06CB                             ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
06CB                             ; of the text if there are fewer lines (or the number is 0). Keeps BC.
06CB   EB           FIND:     EX   DE,HL   
06CC   21 00 83               LD   HL,PROG   
06CF   1B           FI1:      DEC   DE   
06D0   7A                     LD   A,D   
06D1   B3                     OR   E   
06D2   C8                     RET   Z   
06D3   CD D9 06               CALL   nxl   
06D6   20 F7                  JR   NZ,fi1   
06D8   C9                     RET      
06D9                             ; nxl: step HL over one line, to just past its LF (and return not-zero), or
06D9                             ; stop at the NUL that ends the text (and return zero).
06D9   7E           NXL:      LD   A,(HL)   
06DA   B7                     OR   A   
06DB   C8                     RET   Z   
06DC   23                     INC   HL   
06DD   FE 0A                  CP   10   
06DF   20 F8                  JR   NZ,nxl   
06E1   B7                     OR   A   
06E2   C9                     RET      
06E3                             ; prl: print the line at HL, to its LF; HL -> just past it.
06E3   7E           PRL:      LD   A,(HL)   
06E4   EF                     RST   28h   
06E5   7E                     LD   A,(HL)   
06E6   23                     INC   HL   
06E7   FE 0A                  CP   10   
06E9   20 F8                  JR   NZ,prl   
06EB   C9                     RET      
06EC                          ENDIF      
06EC                          IF   EDGEN   
06EC                             ; ^R, generic: what comes in from now until ^Z is the program. A CR is
06EC                             ; stored as CR LF; a LF right after a line end is dropped (it is the CR's
06EC                             ; own, or an empty line's), and a LF anywhere else ends a line too. A last
06EC                             ; line with no end is given one. Nothing is echoed, and there is no check
06EC                             ; for running out of memory.
06EC   21 FF 82     CREAD:    LD   HL,PROG-1   
06EF   3E 0A                  LD   A,10   
06F1   FE                     DB   0FEh   ; (CP n: steps over the LD A,13)
06F2   3E 0D        RD1:      LD   A,13   ; a LF alone ends a line
06F4   77           RD2:      LD   (HL),A   
06F5   23                     INC   HL   
06F6   FE 0D                  CP   13   
06F8   3E 0A                  LD   A,10   
06FA   28 F8                  JR   Z,rd2   ; after a CR goes a LF
06FC   CD 65 05     RD3:      CALL   ekey   
06FF   FE 1A                  CP   1Ah   
0701   28 0B                  JR   Z,rd4   
0703   FE 0A                  CP   10   
0705   20 ED                  JR   NZ,rd2   
0707   2B                     DEC   HL   
0708   BE                     CP   (HL)   
0709   23                     INC   HL   
070A   28 F0                  JR   Z,rd3   ; (the LF is dropped)
070C   18 E4                  JR   rd1   
070E   2B           RD4:      DEC   HL   
070F   7E                     LD   A,(HL)   
0710   23                     INC   HL   
0711   FE 0A                  CP   10   
0713   28 06                  JR   Z,rd5   
0715   36 0D                  LD   (HL),13   
0717   23                     INC   HL   
0718   36 0A                  LD   (HL),10   
071A   23                     INC   HL   
071B   36 00        RD5:      LD   (HL),0   
071D   18 99                  JR   ged1   
071F                             ; ^W, generic: the text is printed as it is, for the terminal to capture.
071F   21 00 83     CWRITE:   LD   HL,PROG   
0722   7E           CW1:      LD   A,(HL)   
0723   B7                     OR   A   
0724   28 92                  JR   Z,ged1   
0726   EF                     RST   28h   
0727   23                     INC   HL   
0728   18 F8                  JR   cw1   
072A                          ENDIF      
072A                          IF   EDITOR*CPM   
                    CFCB:     EQU   005Ch   ; the file's name is kept here, where the CCP
                                 ;   put the one from the command line
                                 ; ^R, CP/M: read the file. A name typed before the key is the file's name
                                 ; from now on.
                    CREAD:    CALL   setname   
                              CALL   load   
                              JP   edit   
                                 ; ^W, CP/M: write the file: delete the old one, make it anew, write the
                                 ; text in records of 128 bytes, and close it. The text's NUL and the 127
                                 ; bytes after it are set to ^Z meanwhile, which pads the last record.
                    CWRITE:   CALL   setname   
                              CALL   fcbclr   
                              LD   C,19   ; delete
                              CALL   fbdos   
                              LD   C,22   ; make
                              CALL   fbdos   
                              INC   A   
                              JP   Z,edit   ; no room in the directory
                              LD   HL,PROG   
                              XOR   A   
                    CW1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,cw1   
                              DEC   HL   ; HL -> the NUL
                              PUSH   HL   
                              LD   B,128   
                    CW2:      LD   (HL),1Ah   
                              INC   HL   
                              DJNZ   cw2   
                              POP   HL   
                              LD   DE,PROG   
                    CW3:      LD   A,E   ; a record that starts before the end is written
                              SUB   L   
                              LD   A,D   
                              SBC   A,H   
                              JR   NC,cw4   
                              PUSH   HL   
                              PUSH   DE   
                              LD   C,26   ; set the DMA address: the record is written
                              CALL   BDOS   ;   from where it lies
                              LD   C,21   ; write
                              CALL   fbdos   
                              POP   HL   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              POP   HL   
                              JR   cw3   
                    CW4:      LD   (HL),0   ; the NUL again
                              LD   C,16   ; close
                              CALL   fbdos   
                              JP   edit   
                                 ; setname: if a name was typed (the line does not start with its CR), put it
                                 ; in the CFCB: up to 8 characters, a dot, up to 3 more, in capitals. The drive
                                 ; is the current one.
                    SETNAME:   LD   DE,LINEBUF   
                              LD   A,(DE)   
                              CP   13   
                              RET   Z   
                              LD   HL,CFCB   
                              LD   (HL),0   ; the current drive
                              LD   B,11   
                    SN1:      INC   L   
                              LD   (HL)," "   
                              DJNZ   sn1   
                              LD   L,CFCB+1   
                    SN2:      LD   A,(DE)   
                              INC   DE   
                              CP   13   
                              RET   Z   
                              CP   "."   
                              JR   NZ,sn3   
                              LD   L,CFCB+9   ; the type
                              JR   sn2   
                    SN3:      CP   "a"   
                              JR   C,sn4   
                              AND   5Fh   ; a capital
                    SN4:      LD   (HL),A   
                              INC   L   
                              JR   sn2   
                                 ; fcbclr: clear the CFCB after its name, as it must be before a file is opened
                    FCBCLR:   LD   HL,CFCB+12   
                              LD   B,24   
                    FC1:      LD   (HL),0   
                              INC   HL   
                              DJNZ   fc1   
                              RET      
                                 ; fbdos: BDOS function C on the file
                    FBDOS:    LD   DE,CFCB   
                              JP   BDOS   
                                 ; load: read the file into PROG. No such file: no program. The text ends at
                                 ; the file"s first ^Z (1Ah), which pads a text file"s last record; one more
                                 ; goes after the last record, so the search always stops. And every line
                                 ; must end in LF: a last line without one is given a CR LF.
                    LOAD:     CALL   fcbclr   
                              LD   C,15   ; open (no such file: the first read fails
                              CALL   fbdos   ;   too)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   C,20   ; read the next 128 bytes
                              CALL   fbdos   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:      LD   (HL),1Ah   
                              LD   HL,PROG-1   
                              LD   A,10   ; (a file with no text needs nothing added)
                    TR1:      INC   HL   
                              LD   E,A   ; E = the character before this one
                              LD   A,(HL)   
                              CP   1Ah   
                              JR   NZ,tr1   
                              LD   A,E   
                              CP   10   
                              JR   Z,tr2   
                              LD   (HL),13   
                              INC   HL   
                              LD   (HL),10   
                              INC   HL   
                    TR2:      LD   (HL),0   
                              RET      
072A                          ENDIF      
072A                             ; =============================================================================
072A                             ;  CP/M startup (the generic build starts at address 0: see st0)
072A                             ; =============================================================================
072A                          IF   CPM   
                                 ; The RAM pages follow the image; the heap may grow to the BDOS.
                    START:       
072A                          ENDIF      
072A                          IF   CPM*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
                                 ; is held back.
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
072A                          ENDIF      
072A                          IF   CPM   
                              LD   HL,vecs   ; the RST routines go down into page zero
                              LD   DE,0008h   
                              LD   BC,vecend-vecs   
                              LDIR      
072A                          ENDIF      
072A                          IF   CPM*EDITOR   
                              CALL   load   ; the file named on the command line
                              JP   edit0   
072A                          ENDIF      
072A                          IF   CPM*(1-EDITOR)   
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:      LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
                              JP   st2   
072A                          ENDIF      
072A                          IF   CPM   
                                 ; RAM pages, after the image
                    RSPAGE:   EQU   (imgend + 255) / 256   
                    DSPAGE:   EQU   RSPAGE + 1   
                    LETPAGE:   EQU   RSPAGE + 2   
                    PROG:     EQU   LETPAGE*256 + 256   
072A                          ENDIF      
072A                IMGEND:      


