  2404                              <1> ; =============================================================================
  2405                              <1> ;  The inner loop: read one character and sort it by range.
  2406                              <1> ;
  2407                              <1> ;    00h          end of program
  2408                              <1> ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes; the checked
  2409                              <1> ;                 build stops on 80h-FFh: X)
  2410                              <1> ;    30h-39h      digit: read a whole number
  2411                              <1> ;    41h-5Ah      A-Z: call the word in that letter's cell
  2412                              <1> ;    61h-7Ah      a-z: push the address of that letter's cell
  2413                              <1> ;    the rest     punctuation: jump through PTAB, 32 entries
  2414                              <1> ;
  2415                              <1> ;  (The fast build has none of this: `next` is its table's dispatcher. See
  2416                              <1> ;  "The fast build".)
  2417                              <1> ; =============================================================================
  2418                              <1> %if FAST == 0
  2419                              <1> ; Digits: step back onto the first digit and read the whole number.
  2420 00000B14 53                  <1> digit:  push    ebx
  2421 00000B15 4E                  <1>         dec     esi
  2422                              <1>         CALLP   rdnum
   223                              <2>  %if P_%1
   224 00000B16 FF55CB              <2>  call [V(p_%1)]
   225                              <2>  %else
   226                              <2>  call %1
   227                              <2>  %endif
  2423 00000B19 FFE5                <1>         jmp     ebp
  2424                              <1> 
  2425                              <1>  %if SBASEU == 0
  2426                              <1> ; a-z: push the cell's address (the cell is the variable). (The unchecked
  2427                              <1> ; base build does x@ and x! in one step: its `lower` is after the window.)
  2428 00000B1B 53                  <1> lower:  push    ebx
  2429 00000B1C 8D9C0000014100      <1>         lea     ebx,[ARENA+LET+eax*2]
  2430 00000B23 FFE5                <1>         jmp     ebp
  2431                              <1>  %endif
  2432                              <1> ; (digit, lower and ctl are here, before next, to keep the variables after
  2433                              <1> ; next in reach)
  2434 00000B25 0421                <1> ctl:    add     al,21h                  ; back to c; zero only for NUL
  2435 00000B27 750C                <1>         jnz     next                    ; the rest are ignored
  2436 00000B29 E924FAFFFF          <1>         jmp     endprog
  2437                              <1> %endif
  2438                              <1> %if CHECKED
  2439 00000B2E B058                <1> e_hi:   mov     al,'X'                  ; a reserved byte outside a string
  2440 00000B30 E9E7F7FFFF          <1>         jmp     error
  2441                              <1> %endif
  2442                              <1> %if FAST
  2443                              <1> next:   NEXTF                           ; (the fast build: through the table)
  2444                              <1> %else
  2445                              <1> next:
  2446                              <1> %if CHECKED
  2447 00000B35 E885F7FFFF          <1>         call    chkstk                  ; both stacks, once per character
  2448                              <1> %endif
  2449 00000B3A 31C0                <1>         xor     eax,eax
  2450 00000B3C AC                  <1>         lodsb
  2451 00000B3D 2C21                <1>         sub     al,21h                  ; AL = c - 21h
  2452 00000B3F 72E4                <1>         jb      ctl                     ; c < 21h: NUL ends, the rest are ignored
  2453 00000B41 3C0F                <1>         cmp     al,0Fh
  2454 00000B43 7228                <1>         jb      punct                   ; 21h-2Fh: PTAB index 0-14
  2455 00000B45 2C0F                <1>         sub     al,0Fh                  ; AL = c - 30h
  2456 00000B47 3C0A                <1>         cmp     al,0Ah
  2457 00000B49 72C9                <1>         jb      digit                   ; 30h-39h
  2458 00000B4B 3C11                <1>         cmp     al,11h
  2459 00000B4D 721C                <1>         jb      p3a                     ; 3Ah-40h
  2460 00000B4F 2C11                <1>         sub     al,11h                  ; AL = c - 41h
  2461 00000B51 3C1A                <1>         cmp     al,1Ah
  2462 00000B53 0F8294F5FFFF        <1>         jb      upper                   ; 41h-5Ah: AL = letter index 0-25
  2463 00000B59 3C20                <1>         cmp     al,20h
  2464 00000B5B 720C                <1>         jb      p5b                     ; 5Bh-60h
  2465 00000B5D 3C3A                <1>         cmp     al,3Ah
  2466 00000B5F 72BA                <1>         jb      lower                   ; 61h-7Ah: AL = 20h-39h (cell +64 bytes)
  2467 00000B61 3C3E                <1>         cmp     al,3Eh
  2468                              <1> %if CHECKED
  2469 00000B63 74D0                <1>         je      next                    ; 7Fh, DEL: ignored
  2470 00000B65 73C7                <1>         jae     e_hi                    ; 80h-FFh: reserved
