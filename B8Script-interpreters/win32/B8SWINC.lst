   630 0000017A 6619DB              <1> tf:     sbb     bx,bx
   631 0000017D FFE5                <1>         jmp     ebp
   632 0000017F 5A                  <1> h_eq:   pop     edx
   633 00000180 6629D3              <1>         sub     bx,dx
   634 00000183 6683FB01            <1>         cmp     bx,1                    ; carry only if a - b = 0
   635 00000187 EBF1                <1>         jmp     tf
   636                              <1> 
