0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Spec: docs/b8script.md (2026-11-24).
0000                             ; 
0000                             ;  The switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    EDITOR   1 = with the line editor built in (see the end of this file):
0000                             ;                 the spec's suggested standard. It goes with either setting
0000                             ;                 of the other two.
0000                             ;    CHECKED  0 = no checks (spec: the programmer is responsible)
0000                             ;             1 = starts with every variable at 0 and every word undefined,
0000                             ;                 and stops on every error in the spec's table (and Ctrl-C)
0000                             ;                 with a four-line report: the letter and the place as line
0000                             ;                 and column, the text there, and both stacks. See `error`.
0000                             ;    QUICK    1 = the speed-ups that cost bytes: a skip cache, a faster skip,
0000                             ;                 "*" and "/" quicker for small and power-of-two operands, and
0000                             ;                 more (see "Speed-ups"). 0, the default, is the smallest build.
0000                             ;    FAST     1 = the speed build: QUICK and a dispatch table besides, with
0000                             ;                 no size limit (see "The speed build"). Not with EDITOR.
0000                             ;    ANSI     what the console escapes of "$" (/00bbIC8= /| /` /~) do:
0000                             ;             1 = send ANSI (VT100) sequences through CONOUT
0000                             ;             0 = call the machine's own routines CONCLS, CONEOL, CONCUR and
0000                             ;                 CONAT (see the equates). The CP/M builds always send ANSI.
0000                             ; 
0000                             ;  In every build Ctrl-C stops a running program (an unchecked build stops
0000                             ;  without a word): see the console layer for the rules, the held key and
0000                             ;  the break-off cell.
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   0   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   1   ; 1 = checked build
0000                EDITOR:   EQU   1   ; 1 = with the line editor
0000                ANSI:     EQU   0   ; 1 = the console escapes send ANSI sequences
0000                QUICK:    EQU   0   ; 1 = the speed-ups that cost bytes (see "Speed-ups")
0000                FAST:     EQU   0   ; 1 = the speed build (not with EDITOR): see "The speed build"
0000                ANS:      EQU   ANSI+CPM-ANSI*CPM   ; (CP/M: always ANSI)
0000                EDGEN:    EQU   EDITOR*(1-CPM)   ; (the generic build with the editor)
0000                             ; (IF takes any value but 0 as true, so
0000                             ;  IF CHECKED+EDITOR means "either")
0000                TABP0:    EQU   EDGEN*(1-CHECKED)   ; (the build with its table in page zero)
0000                PTLATE:   EQU   1-(1-CPM)*(1-EDITOR)*(1-CHECKED)*(1-ANS)   ; (1: the table goes after psgn and pdec,
0000                             ;   not before them: wherever it doesn't cross a
0000                             ;   page. chktab.py says if it does)
0000                QK:       EQU   QUICK+FAST-QUICK*FAST   ; (the speed-ups: QUICK, or the speed build)
0000                QUICKU:   EQU   QK*(1-CHECKED)*(1-FAST)   ; (and those that only the unchecked
0000                             ;  builds take; the speed build has its own)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    IY   return-stack pointer. Entries are 2 bytes; the stack grows down.
0000                             ;         Only rpop and rpushn (and the checks) touch it. The alternate
0000                             ;         registers are not used at all: an interrupt routine may use them.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  One-byte calls. In a generic build the routines used most are reached
0000                             ;  with RST, one byte instead of three. The source writes them as macros:
0000                             ; 
0000                             ;    POPR   RST 08h  rpop    pop the return stack into DE
0000                             ;    DROP   RST 18h  drp     drop TOS, then next character  (ends a handler)
0000                             ;    NEGH   RST 20h  neg16   HL = -HL
0000                             ;    PUTA   RST 28h  putc    print A
0000                             ;    NEXT   RST 30h  next0   next character                 (ends a handler)
0000                             ; 
0000                             ;  RST 18h and RST 30h never return: an RST is a CALL, so the first thing
0000                             ;  each of them does is POP DE to throw the return address away.
0000                             ; 
0000                             ;  A CP/M build leaves page zero alone: there the macros are CALLs, and
0000                             ;  DROP and NEXT are jumps (DROPR and NEXTR: JR, where it reaches).
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (the top four bytes of the page are spare,
0000                             ;             so a full stack runs two bytes into the page below)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch, interpreter variables in the gaps, and the -n? line buffer
0000                             ;             at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack has a guard band: the data stack can
0000                             ;  overrun by a cell or two (and the calls made while it is full, the error
0000                             ;  report's included) into the top 32 bytes of the return-stack page, which
0000                             ;  are never used, and the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
                    BDOS:     EQU   0005h   
                    BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IF   CPM*(1-EDITOR)   
                    EXIT:     EQU   0000h   ; warm boot
0000                          ENDIF      
0000                          IFN   CPM   
0000                             ; ---- generic machine: edit these to suit -----------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The zero flag must match A
0000                             ;   (end the routine with OR A / RET).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                             ;   KEY and CONOUT must preserve BC, DE, HL and IY.
0000                          ENDIF      
0000                          IF   1-ANS   
0000                             ; With ANSI = 0 the console escapes call these. All four must keep BC and
0000                             ; IY, and all but CONAT also HL. They may change A, DE and the flags.
0000                CONCLS:   EQU   0FF0Ch   ; /{  clear the screen, the cursor to the top left
0000                CONEOL:   EQU   0FF0Fh   ; /}  clear from the cursor to the end of the line
0000                CONCUR:   EQU   0FF12h   ; /| and /`  show the cursor if A is not 0, hide
0000                             ;     it if A = 0
0000                CONAT:    EQU   0FF15h   ; /~  the cursor to row HL, column DE, both
0000                             ;     counted from 0. May change A, DE and HL
0000                          ENDIF      
0000                          IFN   CPM   
0000                RSPAGE:   EQU   80h   ; 8000h return stack
0000                DSPAGE:   EQU   81h   ; 8100h data stack
0000                LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
0000                PROG:     EQU   8300h   ; where the loader puts the program text
0000                HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
0000                CPAGE:    EQU   HEAPLIM   ; the skip cache's page (QK builds): the page
0000                             ;   at the heap limit, which the heap never reaches
0000                BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)   
                    EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                          ENDIF      
0000                          IF   EDGEN   
0000                LEAVE:    EQU   0FF09h   ; where the editor's ^X goes
0000                          ENDIF      
0000                          IF   EDITOR*CPM   
                    LEAVE:    EQU   0000h   ; the editor's ^X: warm boot
0000                          ENDIF      
0000                          IF   EDITOR   
0000                EXIT:     EQU   edend   ; a program that ends goes back to the editor,
0000                SKEND:    EQU   skend   ;   also when it ends inside skip
0000                          ENDIF      
0000                          IF   1-EDITOR   
                    SKEND:    EQU   EXIT   
0000                          ENDIF      
0000                MSLOOP:   EQU   40-36*CPM   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine. (The wait
0000                             ; for a second Ctrl-C uses it too: 250 ms.)
0000                             ; CP/M: 4, for a BDOS 6 call of about 280 us
0000                             ; (an RC2014 with RomWBW and ZPM3). A .COM can
0000                             ; be patched: see TIMING.B8S.
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                             ;   around machine code (and in the checked
0000                             ;   build the address "$" prints from);
0000                PCNT:     EQU   LET+36h   ;   the break-key poll count (see rpushn);
0000                SKPL:     EQU   LET+3Ch   ;   the checked skip's starting place;
0000                NPEND:    EQU   LET+38h   ;   minus the address of the program's end
0000                             ;   (the heap"s first byte), for the checked "_';
0000                EDLN:     EQU   LET+3Ah   ;   the editor: the number of the line that ^E
0000                             ;   put in the input line (0: none)
0000                KEYBUF:   EQU   LET+7Ah   ; gap after z: a key read by the break check and
0000                             ;   held for the next "?" (0: none);
0000                BRKOFF:   EQU   LET+7Bh   ;   the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FCh   ; empty data stack. The four bytes above it
0000                             ; are spare: a character can pop two cells
0000                             ; too many before the checked build sees it,
0000                             ; and the next call must not land on the
0000                             ; letter cells.
0000                             ; The five one-byte calls. A generic build owns page zero and reaches them
0000                             ; with RST. A CP/M build must leave page zero alone (CP/M keeps it for
0000                             ; interrupts, and RomWBW's BIOS calls itself through RST 08h), so there each
0000                             ; is a CALL, or a jump for the two that never return: DROP is a JP, and
0000                             ; NEXT is JP (IX), two bytes, with IX holding next0's address throughout.
0000                             ; (asm80 can't nest IF, so these are written with DS: a count of 0 writes
0000                             ; nothing. DS can't take a label that comes later, but EQU can, and DS can
0000                             ; take that.)
0000                AROP:     EQU   rpop   
0000                ANEG:     EQU   neg16   
0000                APUT:     EQU   putc   
0000                APTK:     EQU   putk   
0000                          IF   1-CPM   
0000                PUTK:     EQU   putc   ; (CP/M only: here it is never used)
0000                          ENDIF      
0000                ANXT:     EQU   next0   
0000                          IF   CHECKED   
0000                ACHK:     EQU   chkstk   ; (for the speed build's dispatcher)
0000                          ENDIF      
0000                          IF   1-CHECKED   
                    ACHK:     EQU   0   
0000                          ENDIF      
0000                          IF   FAST   
                    DTPG:     EQU   DTAB/256   ; (the speed build"s table"s first page)
0000                          ENDIF      
0000                          IF   1-FAST   
0000                DTPG:     EQU   0   
0000                          ENDIF      
0000                .macro POPR,
0000                             ; 
0000                 DS      1-CPM,0CFh      ;   RST 08h
0000                 DS      CPM,0CDh        ;   CALL rpop
0000                 DS      CPM,AROP&0FFh
0000                 DS      CPM,AROP/256
0000                .endm
0000                 
0000                .macro DROP,
0000                             ; 
0000                 DS      (1-CPM)*(1-FAST),0DFh ; RST 18h
0000                 DS      CPM+FAST-CPM*FAST,0E1h ; POP HL
0000                 DS      CPM+FAST-CPM*FAST,0DDh ; JP (IX)
0000                 DS      CPM+FAST-CPM*FAST,0E9h
0000                .endm
0000                 
0000                .macro NEGH,
0000                             ; 
0000                 DS      1-CPM,0E7h      ;   RST 20h
0000                 DS      CPM,0CDh        ;   CALL neg16
0000                 DS      CPM,ANEG&0FFh
0000                 DS      CPM,ANEG/256
0000                .endm
0000                 
0000                .macro PUTA,
0000                             ; 
0000                 DS      1-CPM,0EFh      ;   RST 28h
0000                 DS      CPM,0CDh        ;   CALL putc
0000                 DS      CPM,APUT&0FFh
0000                 DS      CPM,APUT/256
0000                .endm
0000                 
0000                .macro PUTK,
0000                             ; 
0000                 DS      1-CPM,3Eh       ;   LD A,%%1 / RST 28h
0000                 DS      1-CPM,%%1
0000                 DS      1-CPM,0EFh
0000                 DS      CPM,0CDh        ;   CALL putk / DB %%1
0000                 DS      CPM,APTK&0FFh
0000                 DS      CPM,APTK/256
0000                 DS      CPM,%%1
0000                .endm
0000                 
0000                .macro PUTAR,
0000                             ; 
0000                 DS      1-CPM,0EFh      ;   RST 28h
0000                 DS      1-CPM,0C9h      ;   RET
0000                 DS      CPM,0C3h        ;   JP putc
0000                 DS      CPM,APUT&0FFh
0000                 DS      CPM,APUT/256
0000                .endm
0000                 
0000                .macro NEXT,
0000                             ; 
0000                 DS      (1-CPM)*(1-FAST),0F7h ; RST 30h
0000                 DS      CPM+FAST-CPM*FAST,0DDh ; JP (IX): IX holds next0
0000                 DS      CPM+FAST-CPM*FAST,0E9h
0000                .endm
0000                 
0000                .macro NEXTF,
0000                             ; 
0000                 DS      FAST*CHECKED,0CDh ;   (speed build: CALL chkstk, checked)
0000                 DS      FAST*CHECKED,ACHK&0FFh
0000                 DS      FAST*CHECKED,ACHK/256
0000                 DS      FAST,0Ah        ;   (speed build: the dispatcher: LD A,(BC)
0000                 DS      FAST,03h        ;   INC BC
0000                 DS      FAST,0EBh       ;   EX DE,HL
0000                 DS      FAST,6Fh        ;   LD L,A
0000                 DS      FAST,26h        ;   LD H,DTAB/256
0000                 DS      FAST,DTPG
0000                 DS      FAST,7Eh        ;   LD A,(HL)
0000                 DS      FAST,24h        ;   INC H
0000                 DS      FAST,66h        ;   LD H,(HL)
0000                 DS      FAST,6Fh        ;   LD L,A
0000                 DS      FAST,0E9h       ;   JP (HL))
0000                .endm
0000                 
0000                .macro NEXTZ,
0000                             ; 
0000                 DS      1-CPM,0F7h      ;   byte there in every build (RST 30h)
0000                 DS      CPM,0DDh        ; JP (IX)
0000                 DS      CPM,0E9h
0000                .endm
0000                 
0000                .macro SETIX,
0000                             ; 
0000                 DS      CPM+FAST-CPM*FAST,0DDh ; a generic build): LD IX,next0
0000                 DS      CPM+FAST-CPM*FAST,21h
0000                 DS      CPM+FAST-CPM*FAST,ANXT&0FFh
0000                 DS      CPM+FAST-CPM*FAST,ANXT/256
0000                .endm
0000                 
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is just the start of the .COM file.
0000                             ; =============================================================================
0000                          .ORG   BASE   
0000                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              XOR   A   ; 00  reset. (This byte, AFh, is also what an
0000                          ENDIF      ;     undefined word runs into: see e_hi.)
0000                          IF   1-EDGEN   
                              LD   SP,DSTOP   ; 00  reset, or the start of the .COM file
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)*(1-QK)   
                              LD   BC,PROG   ; 03  the IP
                              JR   st0   ; 06  (the rest of the startup is close by)
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)*QK   
                              JP   qstart   ; 03  (the skip cache is emptied first)
                              DW   0   ; 06  spare
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)*CHECKED*(1-QK)   
                              JR   init   ; 04  (the rest of the startup is close by)
                              DW   0   ; 06  spare
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)*CHECKED*QK   
                              JP   qinit   ; 04  (the skip cache is emptied first)
                              DB   0   ; 07  spare
0000                          ENDIF      
0000                          IF   EDGEN   
0000   AF                     XOR   A   ; 00  reset: no program yet. (This byte, AFh,
0001   32 00 83               LD   (PROG),A   ;     is also what an undefined word runs
0004   C3 A4 04               JP   init   ; 04  into in the checked build: see e_hi.)
0007   00                     NOP      ; 07  spare
0008                          ENDIF      
0008                          IF   CPM*(1-EDITOR)   
                              JP   start   ; 03
0008                          ENDIF      
0008                          IF   CPM*EDITOR*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
                                 ; is held back.
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
0008                          ENDIF      
0008                          IF   CPM*EDITOR   
                              CALL   load   ; the file named on the command line
                              JP   edit0   
0008                          ENDIF      
0008                          IF   1-CPM   
0008                             ; ---- RST 08h: rpop: pop the return stack into DE ---------------------------
0008   FD 5E 00     RPOP:     LD   E,(IY+0)   ; 08
000B   FD 56 01               LD   D,(IY+1)   
000E   18 1B                  JR   rp2   ; (the rest is at 2Bh)
0010                             ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
0010   C6 21        CTL:      ADD   A,21h   ; 10  back to c; zero only for NUL
0012   20 1D                  JR   NZ,next0   ;     the rest are ignored
0014   C3 EE 04     ENDPROG:   JP   EXIT   ;     the program has ended
0017   00                     NOP      ; 17  spare
0018                             ; ---- RST 18h: drop TOS, then next ------------------------------------------
0018   D1           RST18:    POP   DE   ; 18  discard the RST's return address
0019   E1           DRP:      POP   HL   ;     new TOS = NOS
001A   18 15                  JR   next0   
001C                          ENDIF      
001C   E5           H_FROMR:   PUSH   HL   ; 1C  "}" return stack to TOS
001D                          ;*Macro unroll:  POPR
001D   CF                     DS   1-CPM,0CFh   
001E                          DS   CPM,0CDh   
001E                          DS   CPM,AROP&0FFh   
001E                          DS   CPM,AROP/256   
001E   EB                     EX   DE,HL   
001F                          ;*Macro unroll:  NEXTZ
001F   F7                     DS   1-CPM,0F7h   
0020                          DS   CPM,0DDh   
0020                          DS   CPM,0E9h   
0020                          IF   1-CPM   
0020                             ; ---- RST 20h: neg16: HL = -HL (keeps BC, DE) -------------------------------
0020   AF           NEG16:    XOR   A   ; 20
0021   95                     SUB   L   
0022   6F                     LD   L,A   
0023   9F                     SBC   A,A   
0024   94                     SUB   H   
0025   67                     LD   H,A   
0026   C9                     RET      
0027   00                     NOP      ; 27  spare
0028                             ; ---- RST 28h: putc: print A (keeps BC, DE, HL, IY) -------------------------
0028                RST28:       
0028   C3 03 FF     PUTC:     JP   CONOUT   ; 28
002B   FD 23        RP2:      INC   IY   ; 2B  the rest of rpop
002D   FD 23                  INC   IY   
002F   C9                     RET      
0030                             ; ---- RST 30h: next character -----------------------------------------------
0030   D1           RST30:    POP   DE   ; 30  discard the RST's return address
0031                          ENDIF      
0031                          IF   CPM   
                                 ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
                    CTL:      ADD   A,21h   ; back to c; zero only for NUL
                              JR   NZ,next0   ; the rest are ignored
                    ENDPROG:   JP   EXIT   ; the program has ended
0031                          ENDIF      
0031                             ; =============================================================================
0031                             ;  The inner loop: read one character and sort it by range.
0031                             ; 
0031                             ;    00h          end of program
0031                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0031                             ;    30h-39h      digit: read a whole number
0031                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0031                             ;    61h-7Ah      a-z: push the address of that letter's cell
0031                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0031                             ; =============================================================================
0031                          IF   FAST   
                              ;*Macro unroll: next0:  NEXTF                   ; (the speed build: the table dispatcher)
                    NEXT0:    DS   FAST*CHECKED,0CDh   ; (the speed build: the table dispatcher)
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
0031                          ENDIF      
0031                          IF   1-FAST   
0031                NEXT0:       
0031                          ENDIF      
0031                          IF   CHECKED*(1-FAST)   
0031   CD 90 03               CALL   chkstk   ; both stacks are checked once per character
0034                          ENDIF      
0034                          IF   1-FAST   
0034   0A                     LD   A,(BC)   
0035   03                     INC   BC   
0036   D6 21                  SUB   21h   ; A = c - 21h
0038   38 D6                  JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
003A   FE 0F                  CP   0Fh   
003C   38 25                  JR   C,punct   ; 21h-2Fh: PTAB index 0-14
003E   D6 0F                  SUB   0Fh   ; A = c - 30h
0040   FE 0A                  CP   0Ah   
0042   38 5B                  JR   C,digit   ; 30h-39h
0044   FE 11                  CP   11h   
0046   38 19                  JR   C,p3a   ; 3Ah-40h
0048   D6 11                  SUB   11h   ; A = c - 41h
004A   FE 1A                  CP   1Ah   
004C   38 5D                  JR   C,upper   ; 41h-5Ah: A = letter index 0-25
004E   FE 20                  CP   20h   
0050   38 0D                  JR   C,p5b   ; 5Bh-60h
0052   FE 3A                  CP   3Ah   
0054   38 4F                  JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0056   FE 3E                  CP   3Eh   
0058                          ENDIF      
0058                          IF   (1-CHECKED)*(1-FAST)   
                              JR   NC,next0   ; 7Fh-FFh: ignored
0058                          ENDIF      
0058                          IF   CHECKED*(1-FAST)   
0058   28 D7                  JR   Z,next0   ; 7Fh, DEL: ignored
005A   D2 BD 03               JP   NC,e_hi   ; 80h-FFh: reserved
005D                          ENDIF      
005D                          IF   1-FAST   
005D   D6 1A                  SUB   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
005F   D6 09        P5B:      SUB   9   ; 5Bh-60h: -4 in all, index 22-27
0061   C6 05        P3A:      ADD   A,5   ; 3Ah-40h: index 15-21
0063                          ENDIF      
0063                .macro PTABLE,
0063                             ; 
0063                 DB      h_store & 0FFh  ; !
0063                 DB      h_str & 0FFh    ; "
0063                 DB      h_num & 0FFh    ; #
0063                 DB      h_print & 0FFh  ; $
0063                 DB      h_swap & 0FFh   ; %
0063                 DB      h_and & 0FFh    ; &
0063                 DB      h_emit & 0FFh   ; '
0063                 DB      h_open & 0FFh   ; (
0063                 DB      h_close & 0FFh  ; )
0063                 DB      h_mul & 0FFh    ; *
0063                 DB      h_add & 0FFh    ; +
0063                 DB      h_cfetch & 0FFh ; ,
0063                 DB      h_sub & 0FFh    ; -
0063                 DB      h_cstore & 0FFh ; .
0063                 DB      h_div & 0FFh    ; /
0063                 DB      h_dup & 0FFh    ; :
0063                 DB      h_drop & 0FFh   ; ;
0063                 DB      h_lt & 0FFh     ; <
0063                 DB      h_eq & 0FFh     ; =
0063                 DB      h_gt & 0FFh     ; >
0063                 DB      h_key & 0FFh    ; ?
0063                 DB      h_fetch & 0FFh  ; @
0063                 DB      h_def & 0FFh    ; [
0063                 DB      h_break & 0FFh  ; \
0063                 DB      h_ret & 0FFh    ; ]
0063                 DB      h_xor & 0FFh    ; ^
0063                 DB      h_alloc & 0FFh  ; _
0063                 DB      h_grave & 0FFh  ; `
0063                 DB      h_tor & 0FFh    ; {
0063                 DB      h_or & 0FFh     ; |
0063                 DB      h_fromr & 0FFh  ; }
0063                 DB      h_not & 0FFh    ; ~
0063                .endm
0063                 
0063                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
0063                             ; untouched, and A, DE free.
0063                          IF   1-FAST   
0063   C6 32        PUNCT:    ADD   A,PTAB & 0FFh   ; PTAB never crosses a page
0065   5F                     LD   E,A   
0066   16 03                  LD   D,PTAB / 256   ; (0 if the table is in page zero)
0068   FE 48                  CP   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
006A   1A                     LD   A,(DE)   
006B   5F                     LD   E,A   ; the handler's low byte
006C                          ENDIF      
006C                          IF   (1-CPM)*(1-TABP0)*(1-FAST)   
006C   16 00                  LD   D,0   
006E                          ENDIF      
006E                          IF   (1-CPM)*(1-FAST)   
006E   CB 12                  RL   D   ; its page: 0 + carry
0070                          ENDIF      
0070                          IF   CPM*(1-FAST)   
                              LD   D,1   
                              JR   NC,pu1   
                              INC   D   ; its page: 1 + carry
                    PU1:         
0070                          ENDIF      
0070                          IF   1-FAST   
0070   D5                     PUSH   DE   ; jump to it; the stack is balanced again
0071   C9                     RET      ;   when the handler starts
0072                          ENDIF      
0072                             ; The rest of the startup: here so that the generic reset code can reach it
0072                             ; with JR. st0: find the program's NUL; the heap starts after it.
0072                             ; (The editor build has its own copy of this, next to the editor.)
0072                             ; A checked build first clears the lower half of the letter page (A = 0):
0072                             ; every variable starts at 0, every word cell holds 0000h, the address an
0072                             ; undefined word is caught at (see e_hi), and no key is held back.
0072                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                    INIT:     LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
                              LD   BC,PROG   ; the IP
0072                          ENDIF      
0072                          IF   (1-CPM)*(1-EDITOR)   
                    ST0:      LD   H,B   
                              LD   L,C   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
0072                          ENDIF      
0072                          IF   1-EDITOR   
                    ST2:      LD   (HEAP),HL   
0072                          ENDIF      
0072                          IF   CHECKED*(1-EDITOR)   
                              ;*Macro unroll:  NEGH                    ; minus the heap's first address: '_' may not
                              DS   1-CPM,0E7h   ; minus the heap"s first address: "_' may not
                              DS   CPM,0CDh   
                              DS   CPM,ANEG&0FFh   
                              DS   CPM,ANEG/256   
                              LD   (NPEND),HL   ;   release below it
0072                          ENDIF      
0072                          IF   (1-CHECKED)*(1-EDITOR)*(1-CPM)   
                              LD   H,A   ; (A = 0) no key is held, and the break key
                              LD   L,A   ;   is on (the checked build has cleared
0072                          ENDIF      ;   these)
0072                          IF   (1-CHECKED)*(1-EDITOR)*CPM   
                              LD   HL,0   
0072                          ENDIF      
0072                          IF   (1-CHECKED)*(1-EDITOR)   
                              LD   (KEYBUF),HL   
0072                          ENDIF      
0072                          IF   1-EDITOR   
                              ;*Macro unroll:  SETIX
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,21h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
                              LD   IY,RSTOP   ; the return stack is empty
                              ;*Macro unroll:  NEXT                    ; (its return address is thrown away)
                              DS   (1-CPM)*(1-FAST),0F7h   ; (its return address is thrown away)
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
0072                          ENDIF      
0072                             ; In the unchecked generic editor build the table is here, in the first
0072                             ; page, which saves loading D twice. (The other builds have no room for it
0072                             ; here: theirs is further down.)
0072                          IF   TABP0   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0072                          ENDIF      
0072                             ; =============================================================================
0072                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
0072                             ;  (00bbIGFuZCA= are up among the RST routines.) The machine-code call, exec,
0072                             ;  is here too: it belongs to "`" and makes the page come out right.
0072                             ; =============================================================================
0072   D1           H_XOR:    POP   DE   
0073   7C                     LD   A,H   
0074   AA                     XOR   D   
0075   67                     LD   H,A   
0076   7D                     LD   A,L   
0077   AB                     XOR   E   
0078   6F                     LD   L,A   
0079                          ;*Macro unroll:  NEXT
0079   F7                     DS   (1-CPM)*(1-FAST),0F7h   
007A                          DS   CPM+FAST-CPM*FAST,0DDh   
007A                          DS   CPM+FAST-CPM*FAST,0E9h   
007A   D1           H_OR:     POP   DE   
007B   7C                     LD   A,H   
007C   B2                     OR   D   
007D   67                     LD   H,A   
007E   7D                     LD   A,L   
007F   B3                     OR   E   
0080   6F                     LD   L,A   
0081                          ;*Macro unroll:  NEXT
0081   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0082                          DS   CPM+FAST-CPM*FAST,0DDh   
0082                          DS   CPM+FAST-CPM*FAST,0E9h   
0082                          ;*Macro unroll: h_not:  NEGH                    ; ~x = -x - 1
0082   E7           H_NOT:    DS   1-CPM,0E7h   ; ~x = -x - 1
0083                          DS   CPM,0CDh   
0083                          DS   CPM,ANEG&0FFh   
0083                          DS   CPM,ANEG/256   
0083   2B                     DEC   HL   
0084                          ;*Macro unroll:  NEXT
0084   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0085                          DS   CPM+FAST-CPM*FAST,0DDh   
0085                          DS   CPM+FAST-CPM*FAST,0E9h   
0085                             ; "_" ( n -- addr ): the heap pointer moves by n, a signed count (the add is
0085                             ; the same either way); TOS is the old pointer.
0085   ED 5B 7C 82  H_ALLOC:   LD   DE,(HEAP)   
0089                          IF   CHECKED*CPM   
                              LD   A,H   ; the count's sign, for chkhp
0089                          ENDIF      
0089   19                     ADD   HL,DE   ; the new top
008A                          IF   CHECKED   
008A   CD C7 03               CALL   chkhp   
008D                          ENDIF      
008D   22 7C 82               LD   (HEAP),HL   
0090   EB                     EX   DE,HL   
0091                          ;*Macro unroll:  NEXT
0091   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0092                          DS   CPM+FAST-CPM*FAST,0DDh   
0092                          DS   CPM+FAST-CPM*FAST,0E9h   
0092                          IF   1-CPM*CHECKED   
0092   FD 22 34 82  EXEC:     LD   (RSAVE),IY   ; machine code may change IX and IY
0096   CD CD 00               CALL   jphl   
0099   FD 2A 34 82            LD   IY,(RSAVE)   
009D                          ;*Macro unroll:  SETIX
009D                          DS   CPM+FAST-CPM*FAST,0DDh   
009D                          DS   CPM+FAST-CPM*FAST,21h   
009D                          DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
009D                          DS   CPM+FAST-CPM*FAST,ANXT/256   
009D   E1                     POP   HL   
009E                          ;*Macro unroll:  NEXT
009E   F7                     DS   (1-CPM)*(1-FAST),0F7h   
009F                          DS   CPM+FAST-CPM*FAST,0DDh   
009F                          DS   CPM+FAST-CPM*FAST,0E9h   
009F                          ENDIF      
009F                             ; ---- the letters and digits (here, in the middle, so that the inner loop's
009F                             ; ---- short jumps reach them, and the handlers after them reach rpushn) ------
009F                             ; Digits: step back onto the first digit and read the whole number.
009F   E5           DIGIT:    PUSH   HL   
00A0   0B                     DEC   BC   
00A1   CD A0 02               CALL   rdnum   
00A4                          ;*Macro unroll:  NEXT
00A4   F7                     DS   (1-CPM)*(1-FAST),0F7h   
00A5                          DS   CPM+FAST-CPM*FAST,0DDh   
00A5                          DS   CPM+FAST-CPM*FAST,0E9h   
00A5                             ; a-z: push the cell's address (the cell is the variable)
00A5                             ;  (the unchecked builds with room do x@ and x! in one step: lowq)
00A5                          IF   1-QUICKU   
00A5   E5           LOWER:    PUSH   HL   
00A6   87                     ADD   A,A   
00A7   6F                     LD   L,A   
00A8   26 82                  LD   H,LETPAGE   
00AA                          ;*Macro unroll:  NEXT
00AA   F7                     DS   (1-CPM)*(1-FAST),0F7h   
00AB                          DS   CPM+FAST-CPM*FAST,0DDh   
00AB                          DS   CPM+FAST-CPM*FAST,0E9h   
00AB                          ENDIF      
00AB                          IF   QUICKU   
                    LOWER:    JP   lowq   
00AB                          ENDIF      
00AB                             ; A-Z: call the word. The return address (the IP after the letter) goes on
00AB                             ; the return stack, and the IP becomes the address in the letter's cell.
00AB   C5           UPPER:    PUSH   BC   ; the return address, for rpushn
00AC   EB                     EX   DE,HL   ; park TOS
00AD   87                     ADD   A,A   
00AE   6F                     LD   L,A   
00AF   26 82                  LD   H,LETPAGE   ; HL -> cell
00B1   4E                     LD   C,(HL)   
00B2   2C                     INC   L   
00B3   46                     LD   B,(HL)   ; IP = the word's body
00B4   EB                     EX   DE,HL   ; TOS back, and fall into rpushn
00B5                             ; rpushn: move the top cell of the data stack (in memory) to the return
00B5                             ; stack, then next. Everything that pushes the return stack ends here.
00B5                             ; 
00B5                             ; The break key is looked at here, so at every word call and loop-back (and
00B5                             ; block entry and "{"), but only one time in 256: PCNT counts them.
00B5                             ; Reading the keyboard can be slow (it is a BDOS call under CP/M).
00B5   D1           RPUSHN:   POP   DE   
00B6   FD 72 FF               LD   (IY-1),D   
00B9   FD 73 FE               LD   (IY-2),E   
00BC   FD 2B                  DEC   IY   
00BE   FD 2B                  DEC   IY   
00C0   E5                     PUSH   HL   
00C1   21 36 82               LD   HL,PCNT   
00C4   35                     DEC   (HL)   
00C5   E1                     POP   HL   ; (the zero flag lasts)
00C6   CC 52 03               CALL   Z,pollk   
00C9                          ;*Macro unroll:  NEXT
00C9   F7                     DS   (1-CPM)*(1-FAST),0F7h   
00CA                          DS   CPM+FAST-CPM*FAST,0DDh   
00CA                          DS   CPM+FAST-CPM*FAST,0E9h   
00CA                             ; "{" TOS to the return stack: the new TOS comes up, the old one goes across.
00CA   E3           H_TOR:    EX   (SP),HL   
00CB   18 E8                  JR   rpushn   
00CD   E9           JPHL:     JP   (HL)   ; (for the machine-code call)
00CE                             ; ---- machine code: the grave -----------------------------------------------
00CE                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
00CE                             ; are stored from addr until a non-hex character; then a RET (C9h) is
00CE                             ; written and its address is left. An odd last digit is consumed and dropped.
00CE                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
00CE                             ; code is entered by CALL with the data stack above the return address; it
00CE                             ; must keep BC, and on return the top cell becomes the new TOS.
00CE   CD 06 03     H_GRAVE:   CALL   hexc   
00D1                          IF   1-CPM*CHECKED   
00D1   30 BF                  JR   NC,exec   
00D3                          ENDIF      
00D3                          IF   CPM*CHECKED   
                              JP   NC,exec   ; (out of the way: see rpop)
00D3                          ENDIF      
00D3   77           HX1:      LD   (HL),A   ; the high digit goes in first ...
00D4   CD 06 03               CALL   hexc   
00D7   30 08                  JR   NC,hx2   ; odd digit: consumed, and the RET below
00D9   ED 6F                  RLD      ;   overwrites it
00DB   23                     INC   HL   ; ... and RLD shifts it up under the low one
00DC   CD 06 03               CALL   hexc   
00DF   38 F2                  JR   C,hx1   
00E1   36 C9        HX2:      LD   (HL),0C9h   ; (never range-checked: the spec says so)
00E3                          ;*Macro unroll:  NEXT
00E3   F7                     DS   (1-CPM)*(1-FAST),0F7h   
00E4                          DS   CPM+FAST-CPM*FAST,0DDh   
00E4                          DS   CPM+FAST-CPM*FAST,0E9h   
00E4                             ; ---- where the two pages meet ----------------------------------------------
00E4                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
00E4                             ; are in falling code order for this), and where exactly differs between the
00E4                             ; builds: NPG1 follows. Every handler below these four must start in the
00E4                             ; second page, and every one above in the first; chktab.py checks both.
00E4                             ; "]" returns: pop an address and jump to it.
00E4                          ;*Macro unroll: h_ret:  POPR
00E4   CF           H_RET:    DS   1-CPM,0CFh   
00E5                          DS   CPM,0CDh   
00E5                          DS   CPM,AROP&0FFh   
00E5                          DS   CPM,AROP/256   
00E5   42                     LD   B,D   
00E6   4B                     LD   C,E   
00E7                          ;*Macro unroll: brk1:   NEXT
00E7   F7           BRK1:     DS   (1-CPM)*(1-FAST),0F7h   
00E8                          DS   CPM+FAST-CPM*FAST,0DDh   
00E8                          DS   CPM+FAST-CPM*FAST,0E9h   
00E8                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
00E8                             ; drops the block start, "]" returns. No closer at all ends the program.
00E8   7C           H_BREAK:   LD   A,H   
00E9   B5                     OR   L   
00EA   E1                     POP   HL   
00EB   28 FA                  JR   Z,brk1   
00ED   CD C7 02               CALL   skip   
00F0   B7                     OR   A   ; skip returns 0 for ")"
00F1   20 F1                  JR   NZ,h_ret   
00F3                          ;*Macro unroll: rdrop:  POPR
00F3   CF           RDROP:    DS   1-CPM,0CFh   
00F4                          DS   CPM,0CDh   
00F4                          DS   CPM,AROP&0FFh   
00F4                          DS   CPM,AROP/256   
00F4                          ;*Macro unroll:  NEXT
00F4   F7                     DS   (1-CPM)*(1-FAST),0F7h   
00F5                          DS   CPM+FAST-CPM*FAST,0DDh   
00F5                          DS   CPM+FAST-CPM*FAST,0E9h   
00F5                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
00F5                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
00F5                             ; the body"s address instead. Either way it then skips to the matching "]'.
00F5                             ; (The unchecked build takes anything that is not a letter as the space; the
00F5                             ; checked build stops on it.)
00F5   0A           H_DEF:    LD   A,(BC)   
00F6   03                     INC   BC   
00F7   D6 41                  SUB   "A"   ; a letter gives 0-25 or 32-57: lowercase
00F9   5F                     LD   E,A   ;   lands 64 bytes up
00FA   E6 DF                  AND   0DFh   ; fold case
00FC   FE 1A                  CP   26   
00FE   30 0B                  JR   NC,def2   ; not a letter
0100   CB 23                  SLA   E   
0102   16 82                  LD   D,LETPAGE   ; DE -> cell
0104   79                     LD   A,C   
0105   12                     LD   (DE),A   
0106   1C                     INC   E   
0107   78                     LD   A,B   
0108   12                     LD   (DE),A   
0109   18 09                  JR   skipnx   
010B                DEF2:        
010B                          IF   CHECKED   
010B   7B                     LD   A,E   
010C   FE DF                  CP   " "-"A"+256   
010E   C2 03 04               JP   NZ,e_brack   ; anything but a letter or a space
0111                          ENDIF      
0111   E5                     PUSH   HL   ; an anonymous block: push its address
0112   60                     LD   H,B   
0113   69                     LD   L,C   
0114                SKIPNX:      
0114                          IF   CHECKED   
0114   0B                     DEC   BC   ; back onto the letter, so that skip finds its
0115                          ENDIF      ;   opener, the "[", just before where it starts
0115   CD C7 02     SKIPO:    CALL   skip   
0118                          ;*Macro unroll:  NEXT
0118   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0119                          DS   CPM+FAST-CPM*FAST,0DDh   
0119                          DS   CPM+FAST-CPM*FAST,0E9h   
0119   5E           H_FETCH:   LD   E,(HL)   ; "@"
011A   23                     INC   HL   
011B   56                     LD   D,(HL)   
011C   EB                     EX   DE,HL   
011D                          ;*Macro unroll:  NEXT
011D   F7                     DS   (1-CPM)*(1-FAST),0F7h   
011E                          DS   CPM+FAST-CPM*FAST,0DDh   
011E                          DS   CPM+FAST-CPM*FAST,0E9h   
011E                             ; =============================================================================
011E                             ;  Handlers that must start in the image's second page.
011E                             ;  "?" is the last (with "," inside it), so its long tail may run past that
011E                             ;  page.
011E                             ; =============================================================================
011E                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
011E                             ; the matching ")".
011E   7C           H_OPEN:   LD   A,H   
011F   B5                     OR   L   
0120   E1                     POP   HL   
0121   28 F2                  JR   Z,skipo   
0123   C5                     PUSH   BC   ; the block starts at the IP
0124   18 8F                  JR   rpushn   
0126                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
0126                             ; drops it and carries on.
0126   7C           H_CLOSE:   LD   A,H   
0127   B5                     OR   L   
0128   E1                     POP   HL   
0129   28 C8                  JR   Z,rdrop   
012B                          IF   QK   
                              JP   closeq   ; (out of the handlers' pages: see Speed-ups)
012B                          ENDIF      
012B                          IF   1-QK   
012B                          ;*Macro unroll:  POPR                    ; pop the block start ...
012B   CF                     DS   1-CPM,0CFh   ; pop the block start ...
012C                          DS   CPM,0CDh   
012C                          DS   CPM,AROP&0FFh   
012C                          DS   CPM,AROP/256   
012C   42                     LD   B,D   
012D   4B                     LD   C,E   
012E   C5                     PUSH   BC   
012F                          ENDIF      
012F                          IF   (1-QK)*(1-CPM)   
012F   18 84                  JR   rpushn   ; ... and push it back
0131                          ENDIF      
0131                          IF   (1-QK)*CPM   
                              JP   rpushn   
0131                          ENDIF      
0131                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
0131                             ; "-" has two jobs: directly before a digit it starts a negative number.
0131   0A           H_SUB:    LD   A,(BC)   
0132   D6 30                  SUB   "0"   
0134   FE 0A                  CP   10   
0136   38 04                  JR   C,negnum   
0138                          ;*Macro unroll:  NEGH                    ; a - b = a + (-b): fall into '+'
0138   E7                     DS   1-CPM,0E7h   ; a - b = a + (-b): fall into "+"
0139                          DS   CPM,0CDh   
0139                          DS   CPM,ANEG&0FFh   
0139                          DS   CPM,ANEG/256   
0139   D1           H_ADD:    POP   DE   
013A   19                     ADD   HL,DE   
013B                          ;*Macro unroll:  NEXT
013B   F7                     DS   (1-CPM)*(1-FAST),0F7h   
013C                          DS   CPM+FAST-CPM*FAST,0DDh   
013C                          DS   CPM+FAST-CPM*FAST,0E9h   
013C   E5           NEGNUM:   PUSH   HL   ; a negative number: read it, negate it
013D   CD A0 02               CALL   rdnum   
0140                          ;*Macro unroll:  NEGH
0140   E7                     DS   1-CPM,0E7h   
0141                          DS   CPM,0CDh   
0141                          DS   CPM,ANEG&0FFh   
0141                          DS   CPM,ANEG/256   
0141                          ;*Macro unroll:  NEXT
0141   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0142                          DS   CPM+FAST-CPM*FAST,0DDh   
0142                          DS   CPM+FAST-CPM*FAST,0E9h   
0142   D1           H_AND:    POP   DE   
0143   7C                     LD   A,H   
0144   A2                     AND   D   
0145   67                     LD   H,A   
0146   7D                     LD   A,L   
0147   A3                     AND   E   
0148   6F                     LD   L,A   
0149                          ;*Macro unroll:  NEXT
0149   F7                     DS   (1-CPM)*(1-FAST),0F7h   
014A                          DS   CPM+FAST-CPM*FAST,0DDh   
014A                          DS   CPM+FAST-CPM*FAST,0E9h   
014A                             ; Signed compares. Both are "HL < DE" for the right pair: "<" swaps the two
014A                             ; cells first. Flipping both sign bits turns a signed compare into an
014A                             ; unsigned one (and XOR clears the carry for SBC); SBC HL,HL then turns the
014A                             ; carry into -1 or 0 with no branch.
014A   E3           H_LT:     EX   (SP),HL   ; a < b: HL = a, and b is popped next
014B   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
014C   7C                     LD   A,H   
014D   EE 80                  XOR   80h   
014F   67                     LD   H,A   
0150   7A                     LD   A,D   
0151   EE 80                  XOR   80h   
0153   57                     LD   D,A   
0154   ED 52                  SBC   HL,DE   ; carry if HL < DE
0156   ED 62        TF:       SBC   HL,HL   ; carry -> -1 or 0
0158                          ;*Macro unroll:  NEXT
0158   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0159                          DS   CPM+FAST-CPM*FAST,0DDh   
0159                          DS   CPM+FAST-CPM*FAST,0E9h   
0159   D1           H_EQ:     POP   DE   
015A   B7                     OR   A   
015B   ED 52                  SBC   HL,DE   
015D   7C                     LD   A,H   
015E   B5                     OR   L   
015F   FE 01                  CP   1   ; carry only if a - b = 0
0161   18 F3                  JR   tf   
0163                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept. The
0163                             ; multiplier shifts up through A:C.
0163                          IF   1-QK   
0163   D1           H_MUL:    POP   DE   ; DE = multiplicand
0164   C5                     PUSH   BC   
0165   7C                     LD   A,H   
0166   4D                     LD   C,L   ; A:C = multiplier
0167   21 00 00               LD   HL,0   
016A   06 10                  LD   B,16   
016C   29           MUL1:     ADD   HL,HL   
016D   CB 21                  SLA   C   
016F   17                     RLA      
0170   30 01                  JR   NC,mul2   
0172   19                     ADD   HL,DE   
0173   10 F7        MUL2:     DJNZ   mul1   
0175   C1                     POP   BC   
0176                          ;*Macro unroll:  NEXT
0176   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0177                          DS   CPM+FAST-CPM*FAST,0DDh   
0177                          DS   CPM+FAST-CPM*FAST,0E9h   
0177                          ENDIF      
0177                          IF   QK   
                    H_MUL:    POP   DE   ; DE = multiplicand
                              JP   mulq   ; (out of the handlers' pages: see Speed-ups)
0177                          ENDIF      
0177                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
0177                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
0177                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
0177                             ; stops on it.
0177                H_DIV:       
0177                          IF   CHECKED   
0177   7C                     LD   A,H   
0178   B5                     OR   L   
0179   CA 00 04               JP   Z,e_zero   
017C                          ENDIF      
017C   D1                     POP   DE   ; DE = a, HL = b
017D   D5                     PUSH   DE   ; a, for r's sign
017E   7A                     LD   A,D   
017F   AC                     XOR   H   
0180   F5                     PUSH   AF   ; S flag = sign of q
0181   CB 7C                  BIT   7,H   
0183   C4 20 00               CALL   NZ,neg16   ; HL = |b|
0186   EB                     EX   DE,HL   
0187   CB 7C                  BIT   7,H   
0189   C4 20 00               CALL   NZ,neg16   ; HL = |a|, DE = |b|
018C   CD 78 02               CALL   udiv   ; HL = q, DE = r
018F   F1                     POP   AF   
0190   FC 20 00               CALL   M,neg16   ; q's sign
0193   EB                     EX   DE,HL   ; HL = r, DE = q
0194   F1                     POP   AF   ; A = a's high byte
0195   B7                     OR   A   
0196   FC 20 00               CALL   M,neg16   ; r's sign
0199   D5                     PUSH   DE   ; q under r
019A                          ;*Macro unroll:  NEXT
019A   F7                     DS   (1-CPM)*(1-FAST),0F7h   
019B                          DS   CPM+FAST-CPM*FAST,0DDh   
019B                          DS   CPM+FAST-CPM*FAST,0E9h   
019B                             ; ---- stack and storage -----------------------------------------------------
019B   E5           H_DUP:    PUSH   HL   ; ":"
019C                          ;*Macro unroll:  NEXT
019C   F7                     DS   (1-CPM)*(1-FAST),0F7h   
019D                          DS   CPM+FAST-CPM*FAST,0DDh   
019D                          DS   CPM+FAST-CPM*FAST,0E9h   
019D   E3           H_SWAP:   EX   (SP),HL   ; "%"
019E                          ;*Macro unroll:  NEXT
019E   F7                     DS   (1-CPM)*(1-FAST),0F7h   
019F                          DS   CPM+FAST-CPM*FAST,0DDh   
019F                          DS   CPM+FAST-CPM*FAST,0E9h   
019F                             ; (The checked build tests the address before it takes the value off the
019F                             ; stack, so that an error report shows both.)
019F                H_CSTORE:      ; "." ( c addr -- )
019F                          IF   CHECKED   
019F   CD DC 03               CALL   chkst   
01A2                          ENDIF      
01A2   D1                     POP   DE   
01A3   73                     LD   (HL),E   
01A4                          ;*Macro unroll: h_drop: DROP                    ; ';' is this one byte
01A4   DF           H_DROP:   DS   (1-CPM)*(1-FAST),0DFh   ; ";" is this one byte
01A5                          DS   CPM+FAST-CPM*FAST,0E1h   
01A5                          DS   CPM+FAST-CPM*FAST,0DDh   
01A5                          DS   CPM+FAST-CPM*FAST,0E9h   
01A5                H_STORE:      ; "!" ( n addr -- )
01A5                          IF   CHECKED   
01A5   CD DC 03               CALL   chkst   
01A8                          ENDIF      
01A8   D1                     POP   DE   
01A9   73                     LD   (HL),E   
01AA   23                     INC   HL   
01AB   72                     LD   (HL),D   
01AC                          ;*Macro unroll:  DROP
01AC   DF                     DS   (1-CPM)*(1-FAST),0DFh   
01AD                          DS   CPM+FAST-CPM*FAST,0E1h   
01AD                          DS   CPM+FAST-CPM*FAST,0DDh   
01AD                          DS   CPM+FAST-CPM*FAST,0E9h   
01AD                             ; ---- console ---------------------------------------------------------------
01AD                             ; 22h pushes the address of the text after it and skips the string.
01AD   E5           H_STR:    PUSH   HL   
01AE   60                     LD   H,B   
01AF   69                     LD   L,C   
01B0   CD B6 02               CALL   skipstr   
01B3                          IF   CHECKED   
01B3   B7                     OR   A   ; 0: the text ran out before the closing quote
01B4   CA F8 03               JP   Z,e_quote   
01B7                          ENDIF      
01B7                          ;*Macro unroll:  NEXT
01B7   F7                     DS   (1-CPM)*(1-FAST),0F7h   
01B8                          DS   CPM+FAST-CPM*FAST,0DDh   
01B8                          DS   CPM+FAST-CPM*FAST,0E9h   
01B8                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
01B8                             ; 60h to 7Eh is one of the escapes at pesc; "/" plus any other character
01B8                             ; clears that character"s bit 6 (/M is CR, and / then DEL gives "?"; "/',
01B8                             ; '"' and '?' have no bit 6, so //, /" and /? give themselves).
01B8                          IF   1-CHECKED   
                    H_PRINT:   LD   A,(HL)   
                              INC   HL   
                              CP   22h   
                              JR   Z,pr9   
                              CP   "/"   
                              JR   NZ,pr1   
                              LD   A,(HL)   
                              INC   HL   
                              CP   60h   
                              JR   C,pr0   
                              CP   7Fh   
                              JR   C,pesc   
                    PR0:      AND   0BFh   
                              ;*Macro unroll: pr1:    PUTA
                    PR1:      DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              JR   h_print   
                    PRLOOP:   EQU   h_print   ; (where the escapes go back to)
                    PRAGAIN:   EQU   h_print   ; (and where /~ goes back to)
01B8                          ENDIF      
01B8                          IF   CHECKED   
01B8                             ; (The checked build has the loop as a routine, prstr, which the error
01B8                             ; report uses too. The address is kept meanwhile, for a report: it shows
01B8                             ; the stack as it was before the "$". /~ comes back to hp1.)
01B8   22 34 82     H_PRINT:   LD   (RSAVE),HL   
01BB   CD 11 02     HP1:      CALL   prstr   
01BE                          ;*Macro unroll:  DROP
01BE   DF                     DS   (1-CPM)*(1-FAST),0DFh   
01BF                          DS   CPM+FAST-CPM*FAST,0E1h   
01BF                          DS   CPM+FAST-CPM*FAST,0DDh   
01BF                          DS   CPM+FAST-CPM*FAST,0E9h   
01BF                          ENDIF      
01BF   7D           H_EMIT:   LD   A,L   ; "'"
01C0                          ;*Macro unroll:  PUTA
01C0   EF                     DS   1-CPM,0EFh   
01C1                          DS   CPM,0CDh   
01C1                          DS   CPM,APUT&0FFh   
01C1                          DS   CPM,APUT/256   
01C1                          ;*Macro unroll: pr9:    DROP
01C1   DF           PR9:      DS   (1-CPM)*(1-FAST),0DFh   
01C2                          DS   CPM+FAST-CPM*FAST,0E1h   
01C2                          DS   CPM+FAST-CPM*FAST,0DDh   
01C2                          DS   CPM+FAST-CPM*FAST,0E9h   
01C2                             ; "#" prints TOS as a signed decimal number, with no space after it.
01C2   CD 18 03     H_NUM:    CALL   psgn   
01C5                          ;*Macro unroll:  DROP
01C5   DF                     DS   (1-CPM)*(1-FAST),0DFh   
01C6                          DS   CPM+FAST-CPM*FAST,0E1h   
01C6                          DS   CPM+FAST-CPM*FAST,0DDh   
01C6                          DS   CPM+FAST-CPM*FAST,0E9h   
01C6                             ; "?" ( n -- c ) or ( -n -- addr )
01C6                             ;   n > 0: wait about n ms for a key; 0 if none came
01C6                             ;   n = 0: wait for a key
01C6                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
01C6                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
01C6   CB 7C        H_KEY:    BIT   7,H   
01C8   20 19                  JR   NZ,line   
01CA   1E 28        KT1:      LD   E,MSLOOP   ; one millisecond, roughly
01CC   CD 80 03     KT2:      CALL   getk   
01CF   20 0E                  JR   NZ,kt3   
01D1   1D                     DEC   E   
01D2   20 F8                  JR   NZ,kt2   
01D4   7C                     LD   A,H   ; 0? never counts down: it waits
01D5   B5                     OR   L   
01D6   28 F2                  JR   Z,kt1   
01D8   2B                     DEC   HL   
01D9   7C                     LD   A,H   
01DA   B5                     OR   L   
01DB   20 ED                  JR   NZ,kt1   ; A = 0 if the time ran out
01DD   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
01DE   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
01DF   6F           KT3:      LD   L,A   
01E0   26 00                  LD   H,0   
01E2                          ;*Macro unroll:  NEXT
01E2   F7                     DS   (1-CPM)*(1-FAST),0F7h   
01E3                          DS   CPM+FAST-CPM*FAST,0DDh   
01E3                          DS   CPM+FAST-CPM*FAST,0E9h   
01E3                             ; Backspace takes the last character back (and is echoed as it
01E3                             ; is), CR ends (stored, not echoed), every other key is stored and
01E3                             ; echoed until the line is full. (CP/M too: getk reads through BDOS
01E3                             ; 6.) The line buffer starts at offset 80h of its page, so L alone
01E3                             ; is the place in the line: D holds the L of a full line.
01E3   11 7F 00     LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
01E6   19                     ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
01E7   9F                     SBC   A,A   
01E8   A5                     AND   L   ; (0 for a count that is too big)
01E9   2F                     CPL      
01EA   57                     LD   D,A   ; D = the L of a full line: 80h + count, FFh
01EB                             ;   at most
01EB   21 80 82               LD   HL,LINEBUF   
01EE   CD 80 03     LN2:      CALL   getk   
01F1   28 FB                  JR   Z,ln2   
01F3   FE 0D                  CP   13   
01F5   28 16                  JR   Z,ln5   
01F7   FE 08                  CP   8   
01F9   28 0B                  JR   Z,ln4   
01FB   5F                     LD   E,A   
01FC   7D                     LD   A,L   
01FD   BA                     CP   D   
01FE   28 EE                  JR   Z,ln2   ; full
0200   73                     LD   (HL),E   
0201   2C                     INC   L   
0202   7B                     LD   A,E   
0203                          ;*Macro unroll: ln3:    PUTA
0203   EF           LN3:      DS   1-CPM,0EFh   
0204                          DS   CPM,0CDh   
0204                          DS   CPM,APUT&0FFh   
0204                          DS   CPM,APUT/256   
0204   18 E8                  JR   ln2   
0206   2D           LN4:      DEC   L   ; Backspace: one back, and echo it,
0207   FA 03 02               JP   M,ln3   ;   unless the line was empty (L left the
020A   2C                     INC   L   ;   upper half of the page)
020B   18 E1                  JR   ln2   
020D   77           LN5:      LD   (HL),A   ; the CR
020E   2E 80                  LD   L,LINEBUF & 0FFh   
0210                          ;*Macro unroll:  NEXT
0210   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0211                          DS   CPM+FAST-CPM*FAST,0DDh   
0211                          DS   CPM+FAST-CPM*FAST,0E9h   
0211                             ; =============================================================================
0211                             ;  More routines (no handler starts past this point)
0211                             ; =============================================================================
0211                          IF   CHECKED   
0211                             ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
0211                             ; "$", and the texts of the report). A NUL first is an error: Q.
0211   7E           PRSTR:    LD   A,(HL)   
0212   23                     INC   HL   
0213   FE 22                  CP   22h   
0215   C8                     RET   Z   
0216   B7                     OR   A   
0217   CA EE 03               JP   Z,e_dollar   
021A   FE 2F                  CP   "/"   
021C   20 0C                  JR   NZ,prs1   
021E   7E                     LD   A,(HL)   
021F   23                     INC   HL   
0220   FE 60                  CP   60h   
0222   38 04                  JR   C,prs0   
0224   FE 7F                  CP   7Fh   
0226   38 11                  JR   C,pesc   
0228   E6 BF        PRS0:     AND   0BFh   
022A                          ;*Macro unroll: prs1:   PUTA
022A   EF           PRS1:     DS   1-CPM,0EFh   
022B                          DS   CPM,0CDh   
022B                          DS   CPM,APUT&0FFh   
022B                          DS   CPM,APUT/256   
022B   18 E4                  JR   prstr   
022D                PRLOOP:   EQU   prstr   ; (where the escapes go back to)
022D                PRAGAIN:   EQU   hp1   ; (and where /~ goes back to)
022D                             ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
022D                             ; pnl: the same, on a new line.
022D   CD 33 02     PNL:      CALL   pmsg   ; (pmsg's own CR LF, then on into pmsg for
0230   0D 0A 22               DB   13,10,22h   ;   the caller's text)
0233   E3           PMSG:     EX   (SP),HL   
0234   CD 11 02               CALL   prstr   
0237   E3                     EX   (SP),HL   
0238   C9                     RET      
0239                          ENDIF      
0239                             ; pesc: the escapes of "$". A = the character after the "/", 60h to 7Eh, and
0239                             ; HL points past it. Each goes back into the loop that prints the string
0239                             ; (PRLOOP), but /~ has the stack to see to, and goes back by PRAGAIN.
0239                             ;    /a-/z   print the variable, as "#" does
0239                             ;    /{      clear the screen, the cursor to the top left
0239                             ;    /}      clear from the cursor to the end of the line
0239                             ;    /|  /`  show the cursor, hide it
0239                             ;    /~      ( row col -- ) the cursor to that row and column, from 0
0239   FE 7E        PESC:     CP   7Eh   
023B   28 1C                  JR   Z,pat   
023D   11 11 02               LD   DE,PRLOOP   ; the others return into the loop
0240   D5                     PUSH   DE   
0241   D6 7B                  SUB   7Bh   ; 00bbIDAsIHwgMSwg 2, and no borrow
0243   30 26                  JR   NC,pcon   
0245   C6 1A                  ADD   A,1Ah   ; a-z: 0-25, and a carry; `: FFh, and none
0247   30 2B                  JR   NC,phide   
0249   87                     ADD   A,A   ; the variable's cell
024A   C6 40                  ADD   A,40h   
024C   E5                     PUSH   HL   
024D   6F                     LD   L,A   
024E   26 82                  LD   H,LETPAGE   
0250   7E                     LD   A,(HL)   
0251   2C                     INC   L   
0252   66                     LD   H,(HL)   
0253   6F                     LD   L,A   
0254   CD 18 03               CALL   psgn   
0257   E1                     POP   HL   
0258   C9                     RET      
0259                             ; /~ ( row col addr -- ): the two cells under the string's address go. In
0259                             ; the checked build "$" is the routine prstr: its own return address goes
0259                             ; first, and hp1 calls it again afterwards. There each /~ first looks that
0259                             ; its two cells are there, and is s if not, before it prints anything.
0259                PAT:         
0259                          IF   CHECKED   
0259   E3                     EX   (SP),HL   ; the text pointer over prstr's return address
025A   21 0A 7E               LD   HL,(6-DSTOP)&0FFFFh   ; a carry: the two cells aren't there
025D   39                     ADD   HL,SP   
025E   DA B6 03               JP   C,e_under   
0261   E1                     POP   HL   
0262                          ENDIF      
0262   D1                     POP   DE   ; DE = the column
0263   E3                     EX   (SP),HL   ; HL = the row; the text pointer is kept
0264                          IF   1-ANS   
0264   CD 15 FF               CALL   CONAT   
0267   E1                     POP   HL   
0268   C3 BB 01               JP   PRAGAIN   
026B                             ; With ANSI = 0 the machine's routines do the rest.
026B   CA 0C FF     PCON:     JP   Z,CONCLS   ; /{
026E   FE 02                  CP   2   
0270   CA 0F FF               JP   Z,CONEOL   ; /}
0273   FE                     DB   0FEh   ; /|  (CP n steps over the XOR: A = 1, show)
0274   AF           PHIDE:    XOR   A   ; /`  (A = 0: hide)
0275   C3 12 FF               JP   CONCUR   
0278                          ENDIF      
0278                          IF   ANS   
                              PUSH   DE   
                              CALL   csi   ; ESC [ row+1 ; col+1 H (ANSI counts from 1)
                              INC   HL   
                              CALL   pdec   
                              ;*Macro unroll:  PUTK    3Bh             ; ';'
                              DS   1-CPM,3Eh   ; ";"
                              DS   1-CPM,3Bh   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,3Bh   
                              POP   HL   
                              INC   HL   
                              CALL   pdec   
                              ;*Macro unroll:  PUTK    48h             ; 'H'
                              DS   1-CPM,3Eh   ; "H"
                              DS   1-CPM,48h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,48h   
                              POP   HL   
                              JP   PRAGAIN   
                                 ; With ANSI = 1 they are sequences. The carry is clear on the way in.
                    PSHOW:    LD   E,"h"   ; /|  ESC [ ? 2 5 h
                              DB   0DAh   ; (JP C,nn: with no carry it steps over two bytes)
                    PHIDE:    LD   E,"l"   ; /`  ESC [ ? 2 5 l
0278                          ENDIF      
0278                          IF   ANS*CHECKED   
                                 ; (The checked build prints the fixed parts with pmsg, which it has for the
                                 ; report: shorter than a character at a time.)
                              CALL   pmsg   
                              DB   27,"[?25",22h   
                    PSE:      LD   A,E   ; then E
                              ;*Macro unroll:  PUTAR
                              DS   1-CPM,0EFh   
                              DS   1-CPM,0C9h   
                              DS   CPM,0C3h   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                                 ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into cse.
                    PCON:     DEC   A   
                              JR   Z,pshow   ; /|
                              LD   E,"K"   
                              JP   P,cse   ; /}  ESC [ K
                              LD   E,"H"   ; /{  ESC [ H ESC [ J
                              CALL   cse   
                              LD   E,"J"   ; (on into cse)
                                 ; cse: ESC [ and then E. csi: ESC [. Both keep HL.
                    CSE:      CALL   csi   
                              JR   pse   
                    CSI:      CALL   pmsg   
                              DB   27,"[",22h   
                              RET      
0278                          ENDIF      
0278                          IF   ANS*(1-CHECKED)   
                              LD   A,"?"   
                              CALL   csia   
                              ;*Macro unroll:  PUTK    32h             ; '2'
                              DS   1-CPM,3Eh   ; "2"
                              DS   1-CPM,32h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,32h   
                              ;*Macro unroll:  PUTK    35h             ; '5'
                              DS   1-CPM,3Eh   ; "5"
                              DS   1-CPM,35h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,35h   
                              LD   A,E   
                              ;*Macro unroll:  PUTAR
                              DS   1-CPM,0EFh   
                              DS   1-CPM,0C9h   
                              DS   CPM,0C3h   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                                 ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into csia.
                    PCON:     DEC   A   
                              JR   Z,pshow   ; /|
                              LD   A,"K"   
                              JP   P,csia   ; /}  ESC [ K
                              LD   A,"H"   ; /{  ESC [ H ESC [ J
                              CALL   csia   
                              LD   A,"J"   ; (on into csia)
                                 ; csia: ESC [ and then A. csi: ESC [, keeping A.
                    CSIA:     CALL   csi   
                              ;*Macro unroll:  PUTAR
                              DS   1-CPM,0EFh   
                              DS   1-CPM,0C9h   
                              DS   CPM,0C3h   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                    CSI:      PUSH   AF   
                              ;*Macro unroll:  PUTK    1Bh             ; ESC
                              DS   1-CPM,3Eh   ; ESC
                              DS   1-CPM,1Bh   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,1Bh   
                              ;*Macro unroll:  PUTK    5Bh             ; '['
                              DS   1-CPM,3Eh   ; "["
                              DS   1-CPM,5Bh   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,5Bh   
                              POP   AF   
                              RET      
0278                          ENDIF      
0278                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
0278                             ; Uses A; keeps BC (the IP) itself. The dividend shifts up through A:C while
0278                             ; the quotient bits arrive at the bottom of C.
0278                             ; Dividing by 2 is one shift (the spec wants that fast).
0278                          IF   1-QK   
0278   7B           UDIV:     LD   A,E   
0279   EE 02                  XOR   2   
027B   B2                     OR   D   
027C   20 07                  JR   NZ,udv0   
027E   CB 3C                  SRL   H   
0280   CB 1D                  RR   L   ; the quotient
0282   8F                     ADC   A,A   
0283   5F                     LD   E,A   ; the remainder: the bit that fell out (D is 0)
0284   C9                     RET      
0285                          ENDIF      
0285                          IF   QK   
                                 ; (The builds with room divide by any power of two with shifts: 2, and 32,
                                 ; 64, 256 and the like, which fixed point and byte work use all the time.)
                    UDIV:     LD   A,D   
                              OR   A   
                              JR   NZ,uq1   ; 256 and up
                              OR   E   
                              JR   Z,udv0   ; by 0: the long way (it means nothing anyway)
                              DEC   A   
                              AND   E   
                              JR   NZ,udv0   ; not a power of two
                              LD   A,E   ; by 2^k below 256: q = HL >> k, and
                              DEC   A   ;   r = L & (2^k - 1)
                              AND   L   
                              PUSH   AF   
                    UQ2:      SRL   E   
                              JR   C,uq3   
                              SRL   H   
                              RR   L   
                              JR   uq2   
                    UQ3:      POP   AF   
                              LD   E,A   
                              LD   D,0   
                              RET      
                    UQ1:      LD   A,E   
                              OR   A   
                              JR   NZ,udv0   
                              LD   A,D   
                              DEC   A   
                              AND   D   
                              JR   NZ,udv0   ; not a power of two
                              LD   A,D   ; by 2^k, 256 and up: q = H >> (k - 8), and
                              DEC   A   ;   r = HL & (2^k - 1)
                              AND   H   
                              LD   E,A   ; (the remainder's high byte,
                              LD   A,L   ;   and its low byte)
                              LD   L,H   
                              LD   H,0   
                    UQ4:      SRL   D   
                              JR   C,uq5   
                              SRL   L   
                              JR   uq4   
                    UQ5:      LD   D,E   
                              LD   E,A   
                              RET      
0285                          ENDIF      
0285                          IF   1-FAST   
0285   C5           UDV0:     PUSH   BC   
0286   7C                     LD   A,H   
0287   4D                     LD   C,L   
0288   21 00 00               LD   HL,0   
028B   06 10                  LD   B,16   
028D   CB 21        UDV1:     SLA   C   
028F   17                     RLA      
0290   ED 6A                  ADC   HL,HL   
0292   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
0294   30 02                  JR   NC,udv2   ;   always fits in 16 bits
0296   19                     ADD   HL,DE   ; too much: put it back, and cancel the
0297   0D                     DEC   C   ;   INC below
0298   0C           UDV2:     INC   C   ; a quotient bit
0299   10 F2                  DJNZ   udv1   
029B   EB                     EX   DE,HL   ; DE = remainder
029C   67                     LD   H,A   
029D   69                     LD   L,C   ; HL = quotient
029E   C1                     POP   BC   
029F   C9                     RET      
02A0                          ENDIF      
02A0                          IF   FAST   
                                 ; (the speed build: the same 16 rounds, unrolled)
                    UDV0:     PUSH   BC   
                              LD   A,H   
                              LD   C,L   
                              LD   HL,0   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr0   
                              ADD   HL,DE   
                              DEC   C   
                    UVR0:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr1   
                              ADD   HL,DE   
                              DEC   C   
                    UVR1:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr2   
                              ADD   HL,DE   
                              DEC   C   
                    UVR2:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr3   
                              ADD   HL,DE   
                              DEC   C   
                    UVR3:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr4   
                              ADD   HL,DE   
                              DEC   C   
                    UVR4:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr5   
                              ADD   HL,DE   
                              DEC   C   
                    UVR5:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr6   
                              ADD   HL,DE   
                              DEC   C   
                    UVR6:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr7   
                              ADD   HL,DE   
                              DEC   C   
                    UVR7:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr8   
                              ADD   HL,DE   
                              DEC   C   
                    UVR8:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr9   
                              ADD   HL,DE   
                              DEC   C   
                    UVR9:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr10   
                              ADD   HL,DE   
                              DEC   C   
                    UVR10:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr11   
                              ADD   HL,DE   
                              DEC   C   
                    UVR11:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr12   
                              ADD   HL,DE   
                              DEC   C   
                    UVR12:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr13   
                              ADD   HL,DE   
                              DEC   C   
                    UVR13:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr14   
                              ADD   HL,DE   
                              DEC   C   
                    UVR14:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr15   
                              ADD   HL,DE   
                              DEC   C   
                    UVR15:    INC   C   
                              EX   DE,HL   ; DE = remainder
                              LD   H,A   
                              LD   L,C   ; HL = quotient
                              POP   BC   
                              RET      
02A0                          ENDIF      
02A0                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
02A0                             ; non-digit. Values wrap at 16 bits, as the spec says.
02A0   21 00 00     RDNUM:    LD   HL,0   
02A3   0A           RDN1:     LD   A,(BC)   
02A4   D6 30                  SUB   "0"   
02A6   FE 0A                  CP   10   
02A8   D0                     RET   NC   
02A9   03                     INC   BC   
02AA   54                     LD   D,H   
02AB   5D                     LD   E,L   
02AC   29                     ADD   HL,HL   
02AD   29                     ADD   HL,HL   
02AE   19                     ADD   HL,DE   
02AF   29                     ADD   HL,HL   ; HL * 10
02B0   5F                     LD   E,A   
02B1   16 00                  LD   D,0   
02B3   19                     ADD   HL,DE   
02B4   18 ED                  JR   rdn1   
02B6                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
02B6                             ; the next character, so "/"" does not end it. Leaves A = 22h.
02B6                          IF   1-CHECKED   
                    SS0:      INC   BC   
                    SKIPSTR:   LD   A,(BC)   
                              INC   BC   
                              CP   "/"   
                              JR   Z,ss0   
                              CP   22h   
                              JR   NZ,skipstr   
                              RET      
02B6                          ENDIF      
02B6                          IF   CHECKED   
02B6                             ; The checked build never steps over a NUL: if the text runs out first it
02B6                             ; returns A = 0 with the IP on the NUL.
02B6   0A           SKIPSTR:   LD   A,(BC)   
02B7   B7                     OR   A   
02B8   C8                     RET   Z   
02B9   03                     INC   BC   
02BA   FE 22                  CP   22h   
02BC   C8                     RET   Z   
02BD   FE 2F                  CP   "/"   
02BF   20 F5                  JR   NZ,skipstr   
02C1   0A                     LD   A,(BC)   ; the escaped character
02C2   B7                     OR   A   
02C3   C8                     RET   Z   
02C4   03                     INC   BC   
02C5   18 EF                  JR   skipstr   
02C7                          ENDIF      
02C7                             ; skip: read past text to the closer at this level, and return A = 0 if it
02C7                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
02C7                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
02C7                             ; no closer; anything else that runs into the NUL had unbalanced brackets
02C7                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
02C7                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
02C7                             ; 
02C7                             ; The checked build also looks at the character the skip was started by,
02C7                             ; which is always the one just before where it starts: "(" must end at ")",
02C7                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
02C7                             ; quote counts as running into it. "\" takes either closer. SKPL keeps the
02C7                             ; place where the skip started, for the report.
02C7                          IF   1-QK   
02C7                             ; (Without QUICK: no skip cache.)
02C7                SKIP:        
02C7                          ENDIF      
02C7                          IF   CHECKED*(1-QK)   
02C7   ED 43 3C 82            LD   (SKPL),BC   
02CB   0B                     DEC   BC   
02CC   0A                     LD   A,(BC)   
02CD   03                     INC   BC   
02CE   5F                     LD   E,A   ; E = the opener: ( [ or \
02CF                          ENDIF      
02CF                          IF   1-QK   
02CF   16 00                  LD   D,0   
02D1   14           SK3:      INC   D   ; an opener: one deeper
02D2   0A           SK1:      LD   A,(BC)   
02D3                          ENDIF      
02D3                          IF   (1-CHECKED)*(1-QK)   
                              INC   BC   
                              OR   A   
                              JP   Z,SKEND   ; (the end of the program)
02D3                          ENDIF      
02D3                          IF   CHECKED*(1-QK)   
02D3   B7                     OR   A   
02D4   28 22                  JR   Z,sk6   ; (the IP stays on the NUL)
02D6   03                     INC   BC   
02D7                          ENDIF      
02D7                          IF   1-QK   
02D7   FE 22                  CP   22h   
02D9   CC B6 02               CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
02DC   D6 28                  SUB   "("   ;   (or 0, and then the NUL is read next)
02DE   28 F1                  JR   Z,sk3   
02E0   3D                     DEC   A   ; ")"
02E1   28 08                  JR   Z,sk4   
02E3   D6 32                  SUB   "["-")"   
02E5   28 EA                  JR   Z,sk3   
02E7   FE 02                  CP   "]"-"["   
02E9   20 E7                  JR   NZ,sk1   
02EB   15           SK4:      DEC   D   
02EC                          ENDIF      
02EC                          IF   (1-CHECKED)*(1-QK)   
                              RET   Z   ; the closer at this level
                              JR   sk1   
02EC                          ENDIF      
02EC                          IF   CHECKED*(1-QK)   
02EC   20 E4                  JR   NZ,sk1   
02EE   57                     LD   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
02EF   AB                     XOR   E   ;   opener is 0 for "(" and 1 for "[", and only
02F0   E6 06                  AND   6   ;   "\" has bit 2: so this is 2 for the wrong
02F2   FE 02                  CP   2   ;   closer, and only then
02F4   7A                     LD   A,D   
02F5   C0                     RET   NZ   
02F6   18 05                  JR   sk7   
02F8   CB 53        SK6:      BIT   2,E   ; the text ran out:
02FA   C2 ED 04               JP   NZ,SKEND   ;   "\" with no closer ends the program
02FD   ED 4B 3C 82  SK7:      LD   BC,(SKPL)   ; N. The place is the opener
0301   3E 4E                  LD   A,"N"   
0303   C3 EB 03               JP   errp   ; (errp drops skip's return address)
0306                          ENDIF      
0306                          IF   QK   
                                 ; The skip cache. Nearly every skip is one that has happened before (a loop
                                 ; skips the same false block on every pass), so the first scan from each
                                 ; place is remembered: 64 entries of 00bbc3RhcnQsIGVuZA==, at CPAGE, found by the
                                 ; start's low byte. Only skips that start in the program text are kept (the
                                 ; line buffer changes); the cache is emptied whenever a run starts (skclr).
                                 ; A program that changes its own text while it runs is not looked after.
                    SKIP:     LD   (SKPL),BC   ; where it starts: the cache's key (and the
                              LD   A,B   ;   checked report's place)
                              CP   PROG/256   
                              JR   C,sks   ; below the program text: no cache
                              LD   A,C   
                              ADD   A,A   
                              ADD   A,A   
                              LD   E,A   
                              LD   D,CPAGE   ; DE -> the entry
                              LD   A,(DE)   
                              CP   C   
                              JR   NZ,sks   
                              INC   E   
                              LD   A,(DE)   
                              CP   B   
                              JR   NZ,sks   
                              INC   E   
                              LD   A,(DE)   
                              LD   C,A   
                              INC   E   
                              LD   A,(DE)   
                              LD   B,A   ; a hit: the IP is past the closer
                              DEC   BC   
                              LD   A,(BC)   
                              INC   BC   
                              SUB   ")"   ; 0 for ")", not 0 for "]"
                              RET      
                    SKS:         
0306                          ENDIF      
0306                          IF   QK*CHECKED   
                              DEC   BC   
                              LD   A,(BC)   
                              INC   BC   
                              LD   E,A   ; E = the opener: ( [ or \
0306                          ENDIF      
0306                          IF   QK   
                                 ; The scan. Most characters are nothing to it, and two range tests rule
                                 ; them out: * to Z, and ^ and up. Only NUL " ( ) [ ] count.
                              LD   D,0   
                    SQ3:      INC   D   ; an opener: one deeper
                    SQ1:      LD   A,(BC)   
                              INC   BC   
                              CP   5Eh   
                              JR   NC,sq1   ; ^ _ ` a-z 00bbIHwg ~ and up: nothing
                              CP   5Bh   
                              JR   NC,sqb   ; [ \ ]
                              CP   2Ah   
                              JR   NC,sq1   ; * to Z: nothing
                              CP   28h   
                              JR   Z,sq3   ; (
                              JR   NC,sqc   ; )
                              CP   22h   
                              JR   Z,sqq   ; a string
                              OR   A   
                              JR   NZ,sq1   ; the rest below "(": nothing
0306                          ENDIF      
0306                          IF   QK*(1-CHECKED)   
                              JP   SKEND   ; NUL: the end of the program
0306                          ENDIF      
0306                          IF   QK*CHECKED   
                              DEC   BC   ; NUL: the IP stays on it
                              BIT   2,E   ; the text ran out:
                              JP   NZ,SKEND   ;   "\" with no closer ends the program
                    SQ7:      LD   BC,(SKPL)   ; N. The place is the opener
                              LD   A,"N"   
                              JP   errp   ; (errp drops skip's return address)
0306                          ENDIF      
0306                          IF   QK   
                    SQQ:      CALL   skipstr   ; step over the string
                              JR   sq1   
                    SQB:      SUB   5Ch   ; [ -1, \ 0, ] 1
                              JR   Z,sq1   ; "\" is nothing here
                              JR   C,sq3   ; [
                              LD   A,2   ; ]
                              JR   sq4   
                    SQC:      XOR   A   ; )
                    SQ4:      DEC   D   
                              JR   NZ,sq1   
0306                          ENDIF      
0306                          IF   QK*CHECKED   
                              LD   D,A   ; the closer at this level (as above): 2 here
                              XOR   E   ;   means the wrong closer
                              AND   6   
                              CP   2   
                              LD   A,D   
                              JR   Z,sq7   
0306                          ENDIF      
0306                          IF   QK   
                                 ; The closer at this level: remember the skip (if it started in the program
                                 ; text), and return A = 0 for ")" or 2 for "]".
                              PUSH   AF   
                              PUSH   HL   
                              LD   HL,(SKPL)   
                              LD   A,H   
                              CP   PROG/256   
                              JR   C,sq9   
                              LD   A,L   
                              ADD   A,A   
                              ADD   A,A   
                              LD   E,A   
                              LD   D,CPAGE   
                              LD   A,L   
                              LD   (DE),A   
                              INC   E   
                              LD   A,H   
                              LD   (DE),A   
                              INC   E   
                              LD   A,C   
                              LD   (DE),A   
                              INC   E   
                              LD   A,B   
                              LD   (DE),A   
                    SQ9:      POP   HL   
                              POP   AF   
                              RET      
                                 ; skclr: empty the skip cache (a start of 0000h matches no skip). Keeps HL.
                    SKCLR:    PUSH   HL   
                              LD   HL,CPAGE*256   
                    SKC1:     LD   (HL),0   
                              INC   L   
                              JR   NZ,skc1   
                              POP   HL   
                              RET      
0306                          ENDIF      
0306                             ;  ---- Speed-ups (QUICK builds) -------------------------------------------
0306                             ;  The skip cache is above. These are the handlers' tails that the builds with
0306                             ;  room take, kept here, out of the handlers' first two pages.
0306                          IF   QK   
                                 ; "*" with an operand below 256 takes 8 rounds, not 16: that one becomes the
                                 ; multiplier (most multiplications have one, a count or a small constant).
                    MULQ:     LD   A,H   
                              OR   A   
                              JR   Z,mq8   ; the multiplier is below 256
                              LD   A,D   
                              OR   A   
                              JR   NZ,mq16   
                              EX   DE,HL   ; the multiplicand is: it becomes the multiplier
0306                          ENDIF      
0306                          IF   QK*(1-FAST)   
                    MQ8:      LD   A,L   
                              LD   HL,0   
                              PUSH   BC   
                              LD   B,8   
                    MQ1:      ADD   HL,HL   
                              RLA      
                              JR   NC,mq2   
                              ADD   HL,DE   
                    MQ2:      DJNZ   mq1   
                              POP   BC   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
                    MQ16:     PUSH   BC   ; 16 rounds; the multiplier shifts up through A:C
                              LD   A,H   
                              LD   C,L   
                              LD   HL,0   
                              LD   B,16   
                    MQ3:      ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mq4   
                              ADD   HL,DE   
                    MQ4:      DJNZ   mq3   
                              POP   BC   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
0306                          ENDIF      
0306                          IF   FAST   
                                 ; (the speed build: the same rounds, unrolled)
                    MQ8:      LD   A,L   
                              LD   HL,0   
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur0   
                              ADD   HL,DE   
                    MUR0:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur1   
                              ADD   HL,DE   
                    MUR1:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur2   
                              ADD   HL,DE   
                    MUR2:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur3   
                              ADD   HL,DE   
                    MUR3:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur4   
                              ADD   HL,DE   
                    MUR4:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur5   
                              ADD   HL,DE   
                    MUR5:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur6   
                              ADD   HL,DE   
                    MUR6:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur7   
                              ADD   HL,DE   
                    MUR7:        
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
                    MQ16:     PUSH   BC   
                              LD   A,H   
                              LD   C,L   
                              LD   HL,0   
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus0   
                              ADD   HL,DE   
                    MUS0:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus1   
                              ADD   HL,DE   
                    MUS1:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus2   
                              ADD   HL,DE   
                    MUS2:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus3   
                              ADD   HL,DE   
                    MUS3:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus4   
                              ADD   HL,DE   
                    MUS4:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus5   
                              ADD   HL,DE   
                    MUS5:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus6   
                              ADD   HL,DE   
                    MUS6:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus7   
                              ADD   HL,DE   
                    MUS7:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus8   
                              ADD   HL,DE   
                    MUS8:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus9   
                              ADD   HL,DE   
                    MUS9:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus10   
                              ADD   HL,DE   
                    MUS10:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus11   
                              ADD   HL,DE   
                    MUS11:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus12   
                              ADD   HL,DE   
                    MUS12:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus13   
                              ADD   HL,DE   
                    MUS13:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus14   
                              ADD   HL,DE   
                    MUS14:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus15   
                              ADD   HL,DE   
                    MUS15:       
                              POP   BC   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
0306                          ENDIF      
0306                          IF   QK   
                                 ; A true ")" reads the block start where it is, on top of the return stack,
                                 ; instead of popping it and pushing it back; the break key is looked at as
                                 ; rpushn would.
                    CLOSEQ:   LD   C,(IY+0)   
                              LD   B,(IY+1)   
                              PUSH   HL   
                              LD   HL,PCNT   
                              DEC   (HL)   
                              POP   HL   
                              CALL   Z,pollk   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
0306                          ENDIF      
0306                          IF   QUICKU   
                                 ; a-z, in the unchecked builds: a variable followed by "@" or "!" is fetched
                                 ; or stored in the same step (x@ is the commonest pair in most programs).
                                 ; (A checked build checks the stacks between the two, so it keeps them apart.)
                    LOWQ:     ADD   A,A   
                              LD   E,A   
                              LD   D,LETPAGE   ; DE -> the cell
                              LD   A,(BC)   
                              CP   "@"   
                              JR   Z,lwf   
                              CP   "!"   
                              JR   Z,lws   
                              PUSH   HL   
                              EX   DE,HL   ; TOS = the cell's address
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
                    LWF:      INC   BC   ; x@: TOS = the cell's value
                              PUSH   HL   
                              EX   DE,HL   
                              LD   E,(HL)   
                              INC   L   
                              LD   D,(HL)   
                              EX   DE,HL   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
                    LWS:      INC   BC   ; x!: the cell = TOS, and NOS comes up
                              EX   DE,HL   
                              LD   (HL),E   
                              INC   L   
                              LD   (HL),D   
                              POP   HL   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
0306                          ENDIF      
0306                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)*QK   
                    QSTART:   LD   BC,PROG   ; the generic reset goes on here: the IP,
                              CALL   skclr   ;   an empty skip cache, and the rest of the
                              JP   st0   ;   startup
0306                          ENDIF      
0306                          IF   (1-CPM)*(1-EDITOR)*CHECKED*QK   
                    QINIT:    CALL   skclr   ; (keeps A, which init wants 0)
                              JP   init   
0306                          ENDIF      
0306                             ; =============================================================================
0306                             ;  Dispatch table: the low byte of each handler's address, in code order
0306                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
0306                             ;  It must not cross a page (the dispatcher only adds to its low byte).
0306                             ; =============================================================================
0306                             ; The handlers of the first NPG1 characters start in the image's second page.
0306                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
0306                             ; differs between the builds, so the count is worked out here.
0306                             ; (One division to a line: asm80 only rounds down when it stores a value.)
0306                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
0306                PGBRK:    EQU   (h_break-BASE)/256   
0306                PGDEF:    EQU   (h_def-BASE)/256   
0306                PGFET:    EQU   (h_fetch-BASE)/256   
0306                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
0306                          IF   (1-TABP0)*(1-PTLATE)   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0306                          ENDIF      
0306                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
0306                             ; and return its value in A with the carry set; otherwise leave the IP and
0306                             ; return with the carry clear.
0306   0A           HEXC:     LD   A,(BC)   
0307   D6 30                  SUB   "0"   
0309   FE 0A                  CP   10   
030B   38 09                  JR   C,hc1   
030D   E6 DF                  AND   0DFh   
030F   D6 11                  SUB   11h   
0311   FE 06                  CP   6   
0313   D0                     RET   NC   
0314   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
0316   03           HC1:      INC   BC   
0317   C9                     RET      
0318                             ; psgn: print HL as a signed number. Keeps BC.
0318   CB 7C        PSGN:     BIT   7,H   
031A   28 04                  JR   Z,pdec   
031C                          ;*Macro unroll:  PUTK    2Dh             ; '-'
031C   3E                     DS   1-CPM,3Eh   ; "-"
031D   2D                     DS   1-CPM,2Dh   
031E   EF                     DS   1-CPM,0EFh   
031F                          DS   CPM,0CDh   
031F                          DS   CPM,APTK&0FFh   
031F                          DS   CPM,APTK/256   
031F                          DS   CPM,2Dh   
031F                          ;*Macro unroll:  NEGH
031F   E7                     DS   1-CPM,0E7h   
0320                          DS   CPM,0CDh   
0320                          DS   CPM,ANEG&0FFh   
0320                          DS   CPM,ANEG/256   
0320                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
0320                             ; Keeps BC.
0320   11 0A 00     PDEC:     LD   DE,10   
0323   CD 78 02               CALL   udiv   ; HL = HL / 10, E = the last digit
0326   7B                     LD   A,E   
0327   F5                     PUSH   AF   
0328   7C                     LD   A,H   
0329   B5                     OR   L   
032A   C4 20 03               CALL   NZ,pdec   
032D   F1                     POP   AF   
032E   C6 30                  ADD   A,"0"   
0330                          ;*Macro unroll:  PUTAR
0330   EF                     DS   1-CPM,0EFh   
0331   C9                     DS   1-CPM,0C9h   
0332                          DS   CPM,0C3h   
0332                          DS   CPM,APUT&0FFh   
0332                          DS   CPM,APUT/256   
0332                             ; (The table goes here instead in the builds where, before psgn, it would
0332                             ; cross a page: PTLATE. If it would cross one here too, it starts on the next
0332                             ; page: PTPAD is 0 unless it must.)
0332                          IF   (1-TABP0)*PTLATE   
0332                PTPH:     EQU   $ & 0FFh   
0332                PTPX:     EQU   (PTPH + 31) / 256   
0332                PTPAD:    EQU   PTPX * (256 - PTPH)   
0332                          DS   PTPAD   
0332                PTAB:        
0332                          ;*Macro unroll:  PTABLE
0332   A5                     DB   h_store & 0FFh   
0333   AD                     DB   h_str & 0FFh   
0334   C2                     DB   h_num & 0FFh   
0335   B8                     DB   h_print & 0FFh   
0336   9D                     DB   h_swap & 0FFh   
0337   42                     DB   h_and & 0FFh   
0338   BF                     DB   h_emit & 0FFh   
0339   1E                     DB   h_open & 0FFh   
033A   26                     DB   h_close & 0FFh   
033B   63                     DB   h_mul & 0FFh   
033C   39                     DB   h_add & 0FFh   
033D   DE                     DB   h_cfetch & 0FFh   
033E   31                     DB   h_sub & 0FFh   
033F   9F                     DB   h_cstore & 0FFh   
0340   77                     DB   h_div & 0FFh   
0341   9B                     DB   h_dup & 0FFh   
0342   A4                     DB   h_drop & 0FFh   
0343   4A                     DB   h_lt & 0FFh   
0344   59                     DB   h_eq & 0FFh   
0345   4B                     DB   h_gt & 0FFh   
0346   C6                     DB   h_key & 0FFh   
0347   19                     DB   h_fetch & 0FFh   
0348   F5                     DB   h_def & 0FFh   
0349   E8                     DB   h_break & 0FFh   
034A   E4                     DB   h_ret & 0FFh   
034B   72                     DB   h_xor & 0FFh   
034C   85                     DB   h_alloc & 0FFh   
034D   CE                     DB   h_grave & 0FFh   
034E   CA                     DB   h_tor & 0FFh   
034F   7A                     DB   h_or & 0FFh   
0350   1C                     DB   h_fromr & 0FFh   
0351   82                     DB   h_not & 0FFh   
0352                PTABEND:      
0352                          ENDIF      
0352                             ; =============================================================================
0352                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
0352                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
0352                             ;  (RST 28h) prints A. Both keep BC, DE, HL and IY. In the generic build
0352                             ;  they are the host's KEY and CONOUT routines themselves.
0352                             ; 
0352                             ;  A running program reads the keyboard only through getk and pollk, which
0352                             ;  between them give the break key its rules:
0352                             ;    - Ctrl-C stops the program;
0352                             ;    - any other key that the break check reads is held in KEYBUF for the
0352                             ;      next "?", and a newer one takes its place;
0352                             ;    - "?" (getk) takes the held key first;
0352                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
0352                             ;      key like any other, but two of them within about 250 ms still stop it.
0352                             ;  Both are called straight from a handler, never from a routine under one:
0352                             ;  the checked build's report counts on finding one return address above the
0352                             ;  data stack.
0352                             ; =============================================================================
0352                          IFN   CPM   
0352                RAWK:     EQU   KEY   
0352                          ENDIF      
0352                             ; pollk: the break check (see rpushn).
0352   CD 06 FF     POLLK:    CALL   rawk   
0355   C8                     RET   Z   ; no key
0356   32 7A 82               LD   (KEYBUF),A   ; held for the next "?"
0359   FE 03        PK1:      CP   3   ; (getk joins here)
035B   C0                     RET   NZ   
035C                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
035C                             ; the program has turned it off, wait about 250 ms for one more key: a
035C                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
035C                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
035C   3A 7B 82     CTLC:     LD   A,(BRKOFF)   
035F   B7                     OR   A   
0360   CA E9 03     CT0:      JP   Z,brk   
0363   D5                     PUSH   DE   
0364   11 10 27               LD   DE,250*MSLOOP   
0367   CD 06 FF     CT1:      CALL   rawk   
036A   20 05                  JR   NZ,ct2   
036C   1B                     DEC   DE   
036D   7A                     LD   A,D   
036E   B3                     OR   E   
036F   20 F6                  JR   NZ,ct1   
0371   D1           CT2:      POP   DE   ; A = the second key, or 0 if none came
0372   FE 03                  CP   3   
0374   28 EA                  JR   Z,ct0   ; (the zero flag takes the JP there)
0376   B7                     OR   A   
0377   28 03                  JR   Z,ct3   
0379   32 7A 82               LD   (KEYBUF),A   
037C   3E 03        CT3:      LD   A,3   
037E   B7                     OR   A   
037F   C9                     RET      
0380                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
0380   E5           GETK:     PUSH   HL   ; a held key goes first, and is taken out of
0381   21 7A 82               LD   HL,KEYBUF   ;   the buffer
0384   7E                     LD   A,(HL)   
0385   36 00                  LD   (HL),0   
0387   E1                     POP   HL   
0388   B7                     OR   A   
0389   C0                     RET   NZ   
038A   CD 06 FF               CALL   rawk   
038D   C8                     RET   Z   
038E   18 C9                  JR   pk1   ; Ctrl-C? If not, that is the key
0390                          IF   (1-CHECKED)*(1-EDITOR)   
                    BRK:      EQU   endprog   ; the unchecked build stops without a word
0390                          ENDIF      ;   (with the editor, both stacks are cleared);
0390                          IF   (1-CHECKED)*EDITOR   
                    BRK:      EQU   edit0   
0390                          ENDIF      
0390                          IF   CHECKED   
0390                BRK:      EQU   e_break   ;   the checked build reports B
0390                          ENDIF      
0390                          IF   CPM   
                                 ; The routines a generic build keeps in page zero (see there). Here they are
                                 ; out of the way of the handlers, which must fit in the image's first two
                                 ; pages.
                    RPOP:     LD   E,(IY+0)   ; pop the return stack into DE
                              LD   D,(IY+1)   
                              INC   IY   
                              INC   IY   
                              RET      
                    NEG16:    XOR   A   ; HL = -HL (keeps BC, DE)
                              SUB   L   
                              LD   L,A   
                              SBC   A,A   
                              SUB   H   
                              LD   H,A   
                              RET      
0390                          ENDIF      
0390                          IF   CPM*CHECKED   ; (the checked builds need the room)
                    EXEC:     LD   (RSAVE),IY   ; machine code may change IX and IY
                              CALL   jphl   
                              LD   IY,(RSAVE)   
                              ;*Macro unroll:  SETIX
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,21h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
                              POP   HL   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
0390                          ENDIF      
0390                          IF   CPM   
                    RAWK:     LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
                              JR   putc   
                    PUTK:     EX   (SP),HL   ; print the byte after the CALL
                              LD   A,(HL)   
                              INC   HL   
                              EX   (SP),HL   
                                 ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
                                 ; printing and could swallow a key that BDOS 6 then never sees.
                                 ; It keeps every register but A and the flags: BDOS may change any of them
                                 ; (IX and IY too, in a Z80 BDOS or BIOS).
                    PUTC:     PUSH   BC   
                              PUSH   DE   
                              PUSH   HL   
                              PUSH   IX   
                              PUSH   IY   
                              LD   E,A   
                              LD   C,6   
                              CALL   BDOS   
                              POP   IY   
                              POP   IX   
                              POP   HL   
                              POP   DE   
                              POP   BC   
                              OR   A   ; (for getk)
                              RET      
0390                          ENDIF      
0390                             ; =============================================================================
0390                             ;  Checked build: the checks and the error report
0390                             ; =============================================================================
0390                          IF   CHECKED   
0390                             ; chkstk: both stacks are checked once per character, not in every handler.
0390                             ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
0390                             ; the constant carries if it is above (cells were popped that were never
0390                             ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
0390                             ; a character late at most: the bytes above DSTOP and the guard band below
0390                             ; the page take what happens meanwhile. DE is free between characters.
0390   EB           CHKSTK:   EX   DE,HL   
0391   21 05 7E               LD   HL,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
0394   39                     ADD   HL,SP   
0395   EB                     EX   DE,HL   
0396   38 1E                  JR   C,e_under   
0398   14                     INC   D   
0399   20 17                  JR   NZ,e_over   
039B   FD E5                  PUSH   IY   ; the return stack: in its page (or it has
039D   D1                     POP   DE   ;   overflowed), and not above its empty
039E   7A                     LD   A,D   ;   position (an underflow stays inside the
039F   FE 80                  CP   RSPAGE   ;   page, in the guard band)
03A1   7B                     LD   A,E   
03A2   20 0B                  JR   NZ,e_rover   
03A4   FE E1                  CP   RSTOP&0FFh+1   
03A6   D8                     RET   C   
03A7   FD 21 E0 80            LD   IY,RSTOP   ; return stack underflow: it counts as empty
03AB   3E 72                  LD   A,"r"   
03AD   18 3C                  JR   errp   
03AF   3E 52        E_ROVER:   LD   A,"R"   ; return stack overflow
03B1   11                     DB   11h   ; (LD DE,nn hides the next entry)
03B2   3E 53        E_OVER:   LD   A,"S"   ; data stack overflow
03B4   18 35                  JR   errp   
03B6   31 FC 81     E_UNDER:   LD   SP,DSTOP   ; data stack underflow: it counts as empty
03B9   3E 73                  LD   A,"s"   
03BB   18 48                  JR   error   
03BD                             ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
03BD                             ; was never defined still holds 0000h, and the byte there is a reserved one
03BD                             ; in every build (AFh or C3h): if the IP is in page zero, this was a call of
03BD                             ; an undefined word. The call is undone, so the place is the call itself.
03BD   04           E_HI:     INC   B   
03BE   10 3D                  DJNZ   e_resv   ; (B is as it was, and is not 0)
03C0                          ;*Macro unroll:  POPR
03C0   CF                     DS   1-CPM,0CFh   
03C1                          DS   CPM,0CDh   
03C1                          DS   CPM,AROP&0FFh   
03C1                          DS   CPM,AROP/256   
03C1   42                     LD   B,D   
03C2   4B                     LD   C,E   
03C3   3E 55                  LD   A,"U"   
03C5   18 3E                  JR   error   
03C7                             ; chkhp: HL = the new heap top, DE = the old one, the carry is from adding
03C7                             ; the count. Stop if the top is not below the limit page, or is below the
03C7                             ; program's end.
03C7                CHKHP:       
03C7                          ENDIF      
03C7                          IF   CHECKED*CPM   
                                 ; With this much room a top that wrapped round can land back in
                                 ; range, so the add is tested too: growing (A, the count's high
                                 ; byte, is positive) must not carry, and releasing must.
                              RRA      ; the carry comes in above the sign:
                              ADD   A,40h   ;   bit 7 = carry XOR sign
                              ADD   A,A   
                              JR   C,e_heap   
                              LD   A,(0007h)   
                              DEC   A   
                              CP   H   
                              JR   C,e_heap   
03C7                          ENDIF      
03C7                          IF   CHECKED*(1-CPM)   
03C7                             ; (Here the program's space is under 32K, so a top that wrapped
03C7                             ; round always falls outside it.)
03C7   7C                     LD   A,H   
03C8   FE F0                  CP   HEAPLIM   
03CA   30 09                  JR   NC,e_heap   
03CC                          ENDIF      
03CC                          IF   CHECKED   
03CC   D5                     PUSH   DE   
03CD   EB                     EX   DE,HL   
03CE   2A 38 82               LD   HL,(NPEND)   
03D1   19                     ADD   HL,DE   ; carry: at or above the program's end
03D2   EB                     EX   DE,HL   
03D3   D1                     POP   DE   
03D4   D8                     RET   C   
03D5   B7           E_HEAP:   OR   A   ; put the count back in TOS for the report
03D6   ED 52                  SBC   HL,DE   
03D8   3E 48                  LD   A,"H"   
03DA   18 0F                  JR   errp   
03DC                             ; chkst: stop unless HL is in the program's own space: from the letter page
03DC                             ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
03DC                             ; whatever lies above the limit are safe. Memory above the heap top but
03DC                             ; below the limit is the program's own: Tiny BASIC keeps its lines there.
03DC                             ; It is the page of HL + 1 that is tested, so that one test serves both
03DC                             ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
03DC                             ; Keeps HL and BC. It runs on into its own error entry.
03DC   23           CHKST:    INC   HL   
03DD   7C                     LD   A,H   
03DE   2B                     DEC   HL   
03DF   FE 82                  CP   LETPAGE   
03E1   38 03                  JR   C,e_store   
03E3                          ENDIF      
03E3                          IF   CHECKED*(1-CPM)   
03E3   FE F0                  CP   HEAPLIM   
03E5   D8                     RET   C   
03E6                          ENDIF      
03E6                          IF   CHECKED*CPM   
                              LD   E,A   
                              LD   A,(0007h)   ; the BDOS page is the heap limit
                              DEC   A   
                              CP   E   
                              RET   NC   
03E6                          ENDIF      
03E6                          IF   CHECKED   
03E6                             ; Error entries. Each loads its letter and then hides the next entry inside
03E6                             ; a 3-byte LD DE,nn (the 11h), so they all fall through to `error`.
03E6   3E 4F        E_STORE:   LD   A,"O"   ; a store outside the program's space
03E8   11                     DB   11h   
03E9   3E 42        E_BREAK:   LD   A,"B"   ; Ctrl-C (found inside pollk or getk)
03EB                             ; errp: an error found inside a routine: drop its return address first.
03EB   D1           ERRP:     POP   DE   
03EC   18 17                  JR   error   
03EE                             ; e_dollar: "$" ran into a NUL (in prstr): Q, with the string's address
03EE                             ; back in TOS. prstr"s return address goes first. But if "$' had no
03EE                             ; address at all (the stack was empty), it is s, found now: chkstk, called
03EE                             ; one cell up, sees the stack past its empty place then.
03EE   D1           E_DOLLAR:   POP   DE   
03EF   E1                     POP   HL   
03F0   CD 90 03               CALL   chkstk   
03F3   E5                     PUSH   HL   
03F4   2A 34 82               LD   HL,(RSAVE)   
03F7   11                     DB   11h   ; (LD DE,nn hides e_quote's first two bytes)
03F8   44           E_QUOTE:   LD   B,H   ; an unclosed string: HL is its address, one
03F9   4D                     LD   C,L   ;   past the opening quote, which is the place
03FA   3E 51                  LD   A,"Q"   
03FC   11                     DB   11h   
03FD   3E 58        E_RESV:   LD   A,"X"   ; a reserved byte outside a string
03FF   11                     DB   11h   
0400   3E 5A        E_ZERO:   LD   A,"Z"   ; dividing by zero
0402   11                     DB   11h   
0403   3E 57        E_BRACK:   LD   A,"W"   ; bad character after [
0405                             ; error: the report, then the end. A = the letter, BC = one past the place,
0405                             ; HL = TOS, and both stacks as the report is to show them:
0405                             ; 
0405                             ;   Err X @ line,col
0405                             ;   D:n: the top 8 cells at most, bottom to top
0405                             ;   R:n
0405   E5           ERROR:    PUSH   HL   ; now the whole data stack is in memory
0406   5F                     LD   E,A   
0407   CD 2D 02               CALL   pnl   
040A   45 72 72 20 22         DB   "Err ",22h   
040F   7B                     LD   A,E   
0410                          ;*Macro unroll:  PUTA
0410   EF                     DS   1-CPM,0EFh   
0411                          DS   CPM,0CDh   
0411                          DS   CPM,APUT&0FFh   
0411                          DS   CPM,APUT/256   
0411   CD 33 02               CALL   pmsg   
0414   20 40 20 22            DB   " @ ",22h   
0418   0B                     DEC   BC   ; BC = the place
0419                             ; The line and column. A place below the program is in the line
0419                             ; buffer: line 0. Otherwise count the LFs from the program's start;
0419                             ; DE = the line's number, HL = where it starts.
0419   21 80 82               LD   HL,LINEBUF   
041C   11 00 00               LD   DE,0   
041F   78                     LD   A,B   
0420   FE 83                  CP   PROG/256   
0422   38 14                  JR   C,er3   
0424   24                     INC   H   
0425   6B                     LD   L,E   ; HL = PROG
0426   13           ER1:      INC   DE   ; a new line starts at HL
0427   E5                     PUSH   HL   
0428   7D           ER2:      LD   A,L   
0429   91                     SUB   C   
042A   7C                     LD   A,H   
042B   98                     SBC   A,B   
042C   30 09                  JR   NC,er2x   ; reached the place
042E   7E                     LD   A,(HL)   
042F   23                     INC   HL   
0430   FE 0A                  CP   10   
0432   20 F4                  JR   NZ,er2   
0434   F1                     POP   AF   
0435   18 EF                  JR   er1   
0437   E1           ER2X:     POP   HL   
0438   C5           ER3:      PUSH   BC   
0439   E5                     PUSH   HL   
043A   EB                     EX   DE,HL   
043B   CD 20 03               CALL   pdec   ; the line
043E                          ;*Macro unroll:  PUTK    2Ch             ; ','
043E   3E                     DS   1-CPM,3Eh   ; ","
043F   2C                     DS   1-CPM,2Ch   
0440   EF                     DS   1-CPM,0EFh   
0441                          DS   CPM,0CDh   
0441                          DS   CPM,APTK&0FFh   
0441                          DS   CPM,APTK/256   
0441                          DS   CPM,2Ch   
0441   D1                     POP   DE   
0442   E1                     POP   HL   
0443   B7                     OR   A   
0444   ED 52                  SBC   HL,DE   
0446   23                     INC   HL   
0447   CD 20 03               CALL   pdec   ; the column
044A                             ; The two stack lines:  D:n: the top 8 cells at most, bottom to top
044A                             ;                       R:n
044A                             ; TOS is in memory with the rest (pushed) by now.
044A   CD 2D 02               CALL   pnl   
044D   44 3A 22               DB   "D:",22h   
0450   21 FA 81               LD   HL,DSTOP-2   ; (DSTOP-2) - SP is twice the depth (the cell
0453   ED 72                  SBC   HL,SP   ;   at DSTOP-2 was pushed with the first value
0455                             ;   and holds nothing; pnl left the carry clear)
0455   CD 9A 04               CALL   phalf   ; the depth
0458                          ;*Macro unroll:  PUTK    3Ah             ; ':'
0458   3E                     DS   1-CPM,3Eh   ; ":"
0459   3A                     DS   1-CPM,3Ah   
045A   EF                     DS   1-CPM,0EFh   
045B                          DS   CPM,0CDh   
045B                          DS   CPM,APTK&0FFh   
045B                          DS   CPM,APTK/256   
045B                          DS   CPM,3Ah   
045B   79                     LD   A,C   
045C   FE 09                  CP   9   
045E   38 0A                  JR   C,er6   
0460   CD 33 02               CALL   pmsg   
0463   20 2E 2E 2E 22         DB   " ...",22h   
0468   0E 08                  LD   C,8   
046A   26 00        ER6:      LD   H,0   ; C = the number of cells to show
046C   69                     LD   L,C   
046D   29                     ADD   HL,HL   
046E   39                     ADD   HL,SP   ; HL -> just above the deepest of them
046F   0C                     INC   C   
0470   0D           ER7:      DEC   C   
0471   28 0F                  JR   Z,er8   
0473   2B                     DEC   HL   
0474   56                     LD   D,(HL)   
0475   2B                     DEC   HL   
0476   5E                     LD   E,(HL)   
0477   E5                     PUSH   HL   
0478                          ;*Macro unroll:  PUTK    20h             ; ' '
0478   3E                     DS   1-CPM,3Eh   ; " "
0479   20                     DS   1-CPM,20h   
047A   EF                     DS   1-CPM,0EFh   
047B                          DS   CPM,0CDh   
047B                          DS   CPM,APTK&0FFh   
047B                          DS   CPM,APTK/256   
047B                          DS   CPM,20h   
047B   EB                     EX   DE,HL   
047C   CD 18 03               CALL   psgn   
047F   E1                     POP   HL   
0480   18 EE                  JR   er7   
0482   CD 2D 02     ER8:      CALL   pnl   
0485   52 3A 22               DB   "R:",22h   
0488   FD E5                  PUSH   IY   ; RSTOP - IY is under 256 (the pointer is
048A   E1                     POP   HL   ;   at most one entry below its page), so
048B   3E E0                  LD   A,RSTOP&0FFh   ;   the low bytes are enough
048D   95                     SUB   L   
048E   6F                     LD   L,A   
048F   26 00                  LD   H,0   
0491   CD 9A 04               CALL   phalf   
0494   CD 2D 02               CALL   pnl   
0497   22                     DB   22h   
0498                          ENDIF      
0498                          IF   CHECKED*(1-EDITOR)   
                              JP   endprog   
0498                          ENDIF      
0498                          IF   CHECKED*EDITOR   
0498   18 4A                  JR   edit0   ; back to the editor, with both stacks cleared
049A                          ENDIF      
049A                          IF   CHECKED   
049A                             ; phalf: print half of HL, and leave it in C.
049A   CB 3C        PHALF:    SRL   H   
049C   CB 1D                  RR   L   
049E   E5                     PUSH   HL   
049F   CD 20 03               CALL   pdec   
04A2   C1                     POP   BC   
04A3   C9                     RET      
04A4                          ENDIF      
04A4                             ; =============================================================================
04A4                             ;  The line editor (EDITOR = 1)
04A4                             ; 
04A4                             ;  The interpreter starts here, and a program that ends comes back here.
04A4                             ;  There is no prompt. It follows the spec's suggested standard for a line
04A4                             ;  editor (docs/b8script.md, Environments). Type a line and press Return:
04A4                             ; 
04A4                             ;    n text    put the text in as line n; the lines from n on move down. A
04A4                             ;              number past the end (or 0) adds the line at the end.
04A4                             ;    n         take line n out
04A4                             ;    anything else is run at once, as B8Script. (Start such a line with a
04A4                             ;    space if it would begin with a digit.)
04A4                             ; 
04A4                             ;  A command key ends the line too, and takes what was typed as its argument:
04A4                             ; 
04A4                             ;    ^G        run the program
04A4                             ;    n ^L      list from line n (no number: all of it). Any key holds the
04A4                             ;              list until another key is pressed; Ctrl-C ends it.
04A4                             ;    n ^E      put line n in the input line; Return puts it back, changed
04A4                             ;    name ^R   read. CP/M: the file of that name (no name: the same file as
04A4                             ;              last time). Generic: what is typed, or pasted, from now until
04A4                             ;              ^Z replaces the program; it is not echoed.
04A4                             ;    name ^W   write. CP/M: to that file (no name: the same file as last
04A4                             ;              time). Generic: the text is printed, as it is.
04A4                             ;    ^N        new: no program
04A4                             ;    ^X        leave (to LEAVE)
04A4                             ; 
04A4                             ;  In the line: the left and right arrow keys move the cursor;
04A4                             ;  a character goes in at the cursor; Backspace and DEL take out the one
04A4                             ;  before it; Esc drops the line. Only CR, LF, BS and printing characters are
04A4                             ;  sent to the terminal, so any terminal will do.
04A4                             ; 
04A4                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
04A4                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
04A4                             ;  125 characters; the one character after a line number separates it from
04A4                             ;  the text and is not stored. The text is kept as it is typed, each line
04A4                             ;  ending in CR LF, at PROG.
04A4                             ; 
04A4                             ;  What lasts from one line to the next: the program, the words, the
04A4                             ;  variables and the data stack. An error or a break clears both stacks. The
04A4                             ;  return stack starts empty for every line.
04A4                             ; 
04A4                             ;  Things to know:
04A4                             ;    - Reset empties the program (generic builds).
04A4                             ;    - A word's address points into the program, so run the program again
04A4                             ;      after editing it.
04A4                             ;    - Nothing is printed between a program's output and what is typed next.
04A4                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
04A4                             ;      a line that calls -n? and carries on afterwards runs what was typed.
04A4                             ;      (The stored program never comes back to the line, so it may.)
04A4                             ;    - The editor"s own keys are not the program"s: -n? is the plain line
04A4                             ;      read of the other builds.
04A4                             ; 
04A4                             ;  The data stack is the CPU's stack, so the editor works on top of whatever
04A4                             ;  the last line left there, with TOS pushed like the rest.
04A4                             ; =============================================================================
04A4                          IF   EDGEN   
04A4                INIT:        ; reset (A = 0)
04A4                          ENDIF      
04A4                          IF   EDGEN*CHECKED   
04A4                             ; Clear the lower half of the letter page: every variable starts at 0, and
04A4                             ; every word cell holds 0000h, the address an undefined word is caught at
04A4                             ; (see e_hi).
04A4   21 00 82               LD   HL,LET   
04A7   77           INI1:     LD   (HL),A   
04A8   2C                     INC   L   
04A9   F2 A7 04               JP   P,ini1   ; +00h to +7Fh
04AC                          ENDIF      
04AC                          IF   EDGEN   
04AC   18 36                  JR   edit0   
04AE                          ENDIF      
04AE                          IF   EDITOR   
04AE                             ; Right arrow: one to the right, by printing the character there
04AE   7D           RIGHT:    LD   A,L   
04AF   BB                     CP   E   
04B0   28 4E                  JR   Z,ed1   ; at the end
04B2   7E                     LD   A,(HL)   
04B3   2C                     INC   L   
04B4   18 2B                  JR   lf1   
04B6                             ; Esc: alone it drops the line. An arrow key sends Esc [ and a letter, so
04B6                             ; wait about 5 ms for a second key: after a "[" read on to the letter that
04B6                             ; ends the sequence, and act on C (right) and D (left).
04B6   01 C8 00     ESC:      LD   BC,5*MSLOOP   
04B9   CD 06 FF     ES1:      CALL   rawk   
04BC   20 0A                  JR   NZ,es2   
04BE   0B                     DEC   BC   
04BF   78                     LD   A,B   
04C0   B1                     OR   C   
04C1   20 F6                  JR   NZ,es1   
04C3   CD 2D 05               CALL   fin   ; no second key: the line is dropped
04C6   18 27                  JR   edit   
04C8   FE 5B        ES2:      CP   "["   
04CA   20 34                  JR   NZ,ed1   ; not a sequence known here
04CC   CD 86 05     ES3:      CALL   ekey   
04CF   FE 40                  CP   40h   
04D1   38 F9                  JR   C,es3   ; (its parameters)
04D3   D6 43                  SUB   "C"   
04D5   28 D7                  JR   Z,right   
04D7   3D                     DEC   A   ; "D"?
04D8   20 26                  JR   NZ,ed1   ; no: on into left
04DA                             ; Left arrow: the cursor goes one to the left
04DA   7D           LEFT:     LD   A,L   
04DB   87                     ADD   A,A   
04DC   28 22                  JR   Z,ed1   ; (L = 80h: at the start)
04DE   2D                     DEC   L   
04DF   3E 08                  LD   A,8   
04E1                          ;*Macro unroll: lf1:    PUTA
04E1   EF           LF1:      DS   1-CPM,0EFh   
04E2                          DS   CPM,0CDh   
04E2                          DS   CPM,APUT&0FFh   
04E2                          DS   CPM,APUT/256   
04E2   18 1C                  JR   ed1   
04E4                             ; edit0: reset, an error or a break: both stacks are cleared, and the cursor
04E4                             ;   is shown, in case the program had hidden it and could not show it again.
04E4                             ; skend: a program that ended inside skip: its return address goes.
04E4                             ; edend: a program that ended: TOS joins the rest of the data stack.
04E4   31 FA 81     EDIT0:    LD   SP,DSTOP-2   ; empty (the cell that stands for TOS is pushed)
04E7                          ENDIF      
04E7                          IF   EDITOR*ANS   
                              XOR   A   ; (pshow wants the carry clear)
                              CALL   pshow   ; ESC [ ? 2 5 h
04E7                          ENDIF      
04E7                          IF   EDITOR*(1-ANS)   
04E7   3E 01                  LD   A,1   
04E9   CD 12 FF               CALL   CONCUR   ; show the cursor
04EC                          ENDIF      
04EC                          IF   EDITOR   
04EC   21                     DB   21h   ; (LD HL,nn: steps over the next two bytes)
04ED   D1           SKEND:    POP   DE   
04EE   E5           EDEND:    PUSH   HL   
04EF                             ; edit: start a new input line.
04EF   FD 21 E0 80  EDIT:     LD   IY,RSTOP   ; the return stack is empty
04F3                          ;*Macro unroll:  SETIX                   ; (a file read or written may have changed IX)
04F3                          DS   CPM+FAST-CPM*FAST,0DDh   ; (a file read or written may have changed IX)
04F3                          DS   CPM+FAST-CPM*FAST,21h   
04F3                          DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
04F3                          DS   CPM+FAST-CPM*FAST,ANXT/256   
04F3   21 00 00               LD   HL,0   
04F6   22 7A 82               LD   (KEYBUF),HL   ; no key is held, and the break key is on
04F9   22 3A 82               LD   (EDLN),HL   ; no line is being edited
04FC   21 80 82               LD   HL,LINEBUF   ; HL = the cursor,
04FF   5D                     LD   E,L   ;   E = the end of the line (its low byte)
0500   CD 86 05     ED1:      CALL   ekey   
0503   FE 7F                  CP   7Fh   
0505   28 38                  JR   Z,bsp   ; DEL
0507   FE 20                  CP   " "   
0509   30 4E                  JR   NC,insc   
050B   FE 09                  CP   9   
050D   28 4A                  JR   Z,insc   ; Tab is text
050F   FE 08                  CP   8   
0511   28 2C                  JR   Z,bsp   
0513   FE 1B                  CP   1Bh   
0515   28 9F                  JR   Z,esc   
0517   E5                     PUSH   HL   ; a command key? Look it up
0518   21 8C 05               LD   HL,cmds   
051B   06 08                  LD   B,NCMD   
051D   BE           ED2:      CP   (HL)   
051E   23                     INC   HL   
051F   28 07                  JR   Z,ed3   
0521   23                     INC   HL   
0522   23                     INC   HL   
0523   10 F8                  DJNZ   ed2   
0525   E1                     POP   HL   
0526   18 D8                  JR   ed1   ; no: the key is ignored
0528   7E           ED3:      LD   A,(HL)   
0529   23                     INC   HL   
052A   66                     LD   H,(HL)   
052B   6F                     LD   L,A   
052C   E3                     EX   (SP),HL   ; the command's address: fin returns to it
052D                             ; fin: end the input line: CR LF and a NUL after it, and a new line on the
052D                             ; terminal. Leaves BC -> the line and HL -> the NUL.
052D   26 82        FIN:      LD   H,LETPAGE   
052F   6B                     LD   L,E   
0530   36 0D                  LD   (HL),13   
0532   2C                     INC   L   
0533   36 0A                  LD   (HL),10   
0535   2D                     DEC   L   
0536   CD 8A 06               CALL   prl   ; (prints the CR LF)
0539   36 00                  LD   (HL),0   
053B   01 80 82               LD   BC,LINEBUF   
053E   C9                     RET      
053F                             ; Backspace, DEL: the character before the cursor goes. The cursor moves
053F                             ; left, the rest of the line moves down over it, and the last place (now a
053F                             ; space) is printed over along with the rest.
053F   7D           BSP:      LD   A,L   
0540   87                     ADD   A,A   
0541   28 BD                  JR   Z,ed1   ; at the start
0543   2D                     DEC   L   
0544                          ;*Macro unroll:  PUTK    08h             ; backspace
0544   3E                     DS   1-CPM,3Eh   ; backspace
0545   08                     DS   1-CPM,08h   
0546   EF                     DS   1-CPM,0EFh   
0547                          DS   CPM,0CDh   
0547                          DS   CPM,APTK&0FFh   
0547                          DS   CPM,APTK/256   
0547                          DS   CPM,08h   
0547   E5                     PUSH   HL   
0548   2C           BS1:      INC   L   
0549   7E                     LD   A,(HL)   
054A   2D                     DEC   L   
054B   77                     LD   (HL),A   
054C   2C                     INC   L   
054D   7D                     LD   A,L   
054E   BB                     CP   E   
054F   20 F7                  JR   NZ,bs1   
0551   2D                     DEC   L   
0552   36 20                  LD   (HL)," "   
0554   E1                     POP   HL   
0555   53                     LD   D,E   
0556   1D                     DEC   E   
0557   18 15                  JR   ic2   
0559                             ; A character goes in at the cursor: it ripples up through the rest of the
0559                             ; line, the cursor moves on, and the rest is printed again.
0559   47           INSC:     LD   B,A   
055A   7B                     LD   A,E   
055B   FE FD                  CP   0FDh   
055D   28 A1                  JR   Z,ed1   ; the line is full: 125 characters
055F   78                     LD   A,B   
0560                          ;*Macro unroll:  PUTA
0560   EF                     DS   1-CPM,0EFh   
0561                          DS   CPM,0CDh   
0561                          DS   CPM,APUT&0FFh   
0561                          DS   CPM,APUT/256   
0561   E5                     PUSH   HL   
0562   7E           IC1:      LD   A,(HL)   
0563   70                     LD   (HL),B   
0564   47                     LD   B,A   
0565   7D                     LD   A,L   
0566   2C                     INC   L   
0567   BB                     CP   E   
0568   20 F8                  JR   NZ,ic1   
056A   E1                     POP   HL   
056B   2C                     INC   L   
056C   1C                     INC   E   
056D   53                     LD   D,E   
056E   CD 73 05     IC2:      CALL   tail   
0571   18 8D                  JR   ed1   
0573                             ; tail: print the line from the cursor to D (a low byte), and bring the
0573                             ; cursor back with backspaces. Nothing at all if the cursor is at D.
0573   4D           TAIL:     LD   C,L   
0574   7D           TA1:      LD   A,L   
0575   BA                     CP   D   
0576   28 05                  JR   Z,ta2   
0578   7E                     LD   A,(HL)   
0579                          ;*Macro unroll:  PUTA
0579   EF                     DS   1-CPM,0EFh   
057A                          DS   CPM,0CDh   
057A                          DS   CPM,APUT&0FFh   
057A                          DS   CPM,APUT/256   
057A   2C                     INC   L   
057B   18 F7                  JR   ta1   
057D   7D           TA2:      LD   A,L   
057E   B9                     CP   C   
057F   C8                     RET   Z   
0580                          ;*Macro unroll:  PUTK    08h             ; backspace
0580   3E                     DS   1-CPM,3Eh   ; backspace
0581   08                     DS   1-CPM,08h   
0582   EF                     DS   1-CPM,0EFh   
0583                          DS   CPM,0CDh   
0583                          DS   CPM,APTK&0FFh   
0583                          DS   CPM,APTK/256   
0583                          DS   CPM,08h   
0583   2D                     DEC   L   
0584   18 F7                  JR   ta2   
0586                             ; ekey: wait for a key
0586   CD 06 FF     EKEY:     CALL   rawk   
0589   28 FB                  JR   Z,ekey   
058B   C9                     RET      
058C                             ; The command keys, and where each goes (after fin).
058C   0D           CMDS:     DB   13   
058D   D4 05                  DW   cret   
058F   07                     DB   7   ; ^G
0590   1C 06                  DW   crun   
0592   0C                     DB   12   ; ^L
0593   32 06                  DW   clist   
0595   05                     DB   5   ; ^E
0596   AA 05                  DW   cedln   
0598   12                     DB   18   ; ^R
0599   96 06                  DW   cread   
059B   17                     DB   23   ; ^W
059C   C3 06                  DW   cwrite   
059E   0E                     DB   14   ; ^N
059F   A4 05                  DW   cnew   
05A1   18                     DB   24   ; ^X
05A2   09 FF                  DW   LEAVE   
05A4                NCMD:     EQU   8   
05A4                             ; ^N: no program
05A4   AF           CNEW:     XOR   A   
05A5   32 00 83               LD   (PROG),A   
05A8   18 6F        GED0:     JR   gedit   
05AA                             ; ^E: line n goes into the input line, to be changed. EDLN remembers which
05AA                             ; line it was: Return puts the text back in its place.
05AA   CD A0 02     CEDLN:    CALL   rdnum   
05AD   E5                     PUSH   HL   
05AE   CD 72 06               CALL   find   ; HL -> the line, or the NUL if there is none
05B1   D1                     POP   DE   
05B2   7E                     LD   A,(HL)   
05B3   B7                     OR   A   
05B4   28 F2                  JR   Z,ged0   
05B6   ED 53 3A 82            LD   (EDLN),DE   
05BA   11 80 82               LD   DE,LINEBUF   
05BD   7E           CE1:      LD   A,(HL)   ; copy it, and show it, up to its CR (or LF)
05BE   FE 0D                  CP   13   
05C0   28 0D                  JR   Z,ce2   
05C2   FE 0A                  CP   10   
05C4   28 09                  JR   Z,ce2   
05C6   12                     LD   (DE),A   
05C7                          ;*Macro unroll:  PUTA
05C7   EF                     DS   1-CPM,0EFh   
05C8                          DS   CPM,0CDh   
05C8                          DS   CPM,APUT&0FFh   
05C8                          DS   CPM,APUT/256   
05C8   23                     INC   HL   
05C9   1C                     INC   E   
05CA   7B                     LD   A,E   
05CB   FE FD                  CP   0FDh   ; (a longer line is cut at 125 characters)
05CD   20 EE                  JR   NZ,ce1   
05CF   EB           CE2:      EX   DE,HL   ; the cursor is at the line's end
05D0   5D                     LD   E,L   
05D1   C3 00 05               JP   ed1   
05D4                             ; Return. If ^E put a line here, the text goes back in its place. If not:
05D4                             ; a number and text is a line to put in, a number alone a line to take out,
05D4                             ; and anything else is run where it is.
05D4   E5           CRET:     PUSH   HL   ; the end of what was typed
05D5   2A 3A 82               LD   HL,(EDLN)   
05D8   7C                     LD   A,H   
05D9   B5                     OR   L   
05DA   28 07                  JR   Z,cr1   
05DC   E5                     PUSH   HL   
05DD   CD 62 06               CALL   delln   
05E0   E1                     POP   HL   
05E1   18 13                  JR   ins   
05E3   CD A0 02     CR1:      CALL   rdnum   ; HL = the number it starts with, BC -> after
05E6   79                     LD   A,C   ; C is still 80h if there was no number:
05E7   87                     ADD   A,A   ;   only then is twice it 0
05E8   28 36                  JR   Z,st0p   ; no number: run the line
05EA   0A                     LD   A,(BC)   
05EB   FE 0D                  CP   13   
05ED   20 06                  JR   NZ,cr2   
05EF   D1                     POP   DE   ; the number alone: take that line out
05F0   CD 62 06               CALL   delln   
05F3   18 24                  JR   gedit   
05F5   03           CR2:      INC   BC   ; step over the one character after the number
05F6                             ; Put the text at BC in as line n (in HL): open a gap of its length there,
05F6                             ; CR and LF included, and copy it in.
05F6   CD 72 06     INS:      CALL   find   ; HL -> where it goes
05F9   D1                     POP   DE   ; the end of what was typed
05FA   7B                     LD   A,E   
05FB   91                     SUB   C   ; A = the length of the text, with its CR LF
05FC   C5                     PUSH   BC   ; the text
05FD   4F                     LD   C,A   
05FE   06 00                  LD   B,0   
0600   C5                     PUSH   BC   ; its length
0601   54                     LD   D,H   
0602   5D                     LD   E,L   ; DE = where it goes
0603   AF                     XOR   A   
0604   4F                     LD   C,A   ; BC = 0: CPIR looks as far as it needs to
0605   ED B1                  CPIR      ; HL -> one past the program's NUL
0607   ED 52                  SBC   HL,DE   ; the number of bytes to move up, NUL included
0609   44                     LD   B,H   
060A   4D                     LD   C,L   
060B   19                     ADD   HL,DE   
060C   2B                     DEC   HL   ; HL -> the NUL
060D   EB                     EX   DE,HL   
060E   E3                     EX   (SP),HL   ; HL = the length; where it goes is kept
060F   E5                     PUSH   HL   
0610   19                     ADD   HL,DE   ; the NUL's new place
0611   EB                     EX   DE,HL   
0612   ED B8                  LDDR      ; move the rest of the program up
0614   C1                     POP   BC   ; the length
0615   D1                     POP   DE   ; where it goes
0616   E1                     POP   HL   ; the text
0617   ED B0                  LDIR      
0619   C3 EF 04     GEDIT:    JP   edit   
061C                             ; ^G: run the program. st0p: run the typed line (BC -> it).
061C   01 00 83     CRUN:     LD   BC,PROG   
061F   3E                     DB   3Eh   ; (LD A,n: steps over the POP)
0620   E1           ST0P:     POP   HL   ; (the end of what was typed)
0621                             ; st0: start running at BC. The heap starts after the stored program's NUL.
0621   21 00 83     ST0:      LD   HL,PROG   
0624   AF                     XOR   A   
0625   BE           ST1:      CP   (HL)   
0626   23                     INC   HL   
0627   20 FC                  JR   NZ,st1   
0629   22 7C 82               LD   (HEAP),HL   
062C                          ENDIF      
062C                          IF   EDITOR*QK   
                              CALL   skclr   ; every run starts with an empty skip cache
062C                          ENDIF      
062C                          IF   EDITOR*CHECKED   
062C                          ;*Macro unroll:  NEGH                    ; minus the heap's first address: '_' may not
062C   E7                     DS   1-CPM,0E7h   ; minus the heap"s first address: "_' may not
062D                          DS   CPM,0CDh   
062D                          DS   CPM,ANEG&0FFh   
062D                          DS   CPM,ANEG/256   
062D   22 38 82               LD   (NPEND),HL   ;   release below it
0630                          ENDIF      
0630                          IF   EDITOR   
0630   E1                     POP   HL   ; TOS: the data stack is as the last line left it
0631                          ;*Macro unroll:  NEXT                    ; (its return address is thrown away)
0631   F7                     DS   (1-CPM)*(1-FAST),0F7h   ; (its return address is thrown away)
0632                          DS   CPM+FAST-CPM*FAST,0DDh   
0632                          DS   CPM+FAST-CPM*FAST,0E9h   
0632                             ; ^L: list from line n. DE = the number of the line at HL.
0632   CD A0 02     CLIST:    CALL   rdnum   ; HL = n, or 0 if there was none:
0635   7C                     LD   A,H   
0636   B5                     OR   L   
0637   20 01                  JR   NZ,li0   
0639   2C                     INC   L   ;   then from line 1
063A   E5           LI0:      PUSH   HL   
063B   CD 72 06               CALL   find   
063E   D1                     POP   DE   
063F   7E           LI1:      LD   A,(HL)   
0640   B7                     OR   A   
0641   28 D6                  JR   Z,gedit   ; the end of the text
0643   CD 06 FF               CALL   rawk   
0646   28 09                  JR   Z,li3   ; no key: carry on
0648   FE 03                  CP   3   
064A   C4 86 05               CALL   NZ,ekey   ; any key but Ctrl-C: wait for one more
064D   FE 03                  CP   3   
064F   28 C8                  JR   Z,gedit   ; Ctrl-C, first or second, ends the list
0651   E5           LI3:      PUSH   HL   
0652   D5                     PUSH   DE   
0653   EB                     EX   DE,HL   
0654   CD 20 03               CALL   pdec   ; the line's number,
0657   3E 20                  LD   A," "   
0659                          ;*Macro unroll:  PUTA                    ;   a space,
0659   EF                     DS   1-CPM,0EFh   ;   a space,
065A                          DS   CPM,0CDh   
065A                          DS   CPM,APUT&0FFh   
065A                          DS   CPM,APUT/256   
065A   D1                     POP   DE   
065B   E1                     POP   HL   
065C   13                     INC   DE   
065D   CD 8A 06               CALL   prl   ;   and the line
0660   18 DD                  JR   li1   
0662                             ; delln: take line n (in HL) out: copy everything after it down over it.
0662   CD 72 06     DELLN:    CALL   find   
0665   54                     LD   D,H   
0666   5D                     LD   E,L   
0667   CD 80 06               CALL   nxl   ; HL -> the next line
066A   7E           DE1:      LD   A,(HL)   
066B   12                     LD   (DE),A   
066C   23                     INC   HL   
066D   13                     INC   DE   
066E   B7                     OR   A   
066F   20 F9                  JR   NZ,de1   
0671   C9                     RET      
0672                             ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
0672                             ; of the text if there are fewer lines (or the number is 0). Keeps BC.
0672   EB           FIND:     EX   DE,HL   
0673   21 00 83               LD   HL,PROG   
0676   1B           FI1:      DEC   DE   
0677   7A                     LD   A,D   
0678   B3                     OR   E   
0679   C8                     RET   Z   
067A   CD 80 06               CALL   nxl   
067D   20 F7                  JR   NZ,fi1   
067F   C9                     RET      
0680                             ; nxl: step HL over one line, to just past its LF (and return not-zero), or
0680                             ; stop at the NUL that ends the text (and return zero).
0680   7E           NXL:      LD   A,(HL)   
0681   B7                     OR   A   
0682   C8                     RET   Z   
0683   23                     INC   HL   
0684   FE 0A                  CP   10   
0686   20 F8                  JR   NZ,nxl   
0688   B7                     OR   A   
0689   C9                     RET      
068A                             ; prl: print the line at HL, to its LF; HL -> just past it.
068A   7E           PRL:      LD   A,(HL)   
068B                          ;*Macro unroll:  PUTA
068B   EF                     DS   1-CPM,0EFh   
068C                          DS   CPM,0CDh   
068C                          DS   CPM,APUT&0FFh   
068C                          DS   CPM,APUT/256   
068C   7E                     LD   A,(HL)   
068D   23                     INC   HL   
068E   FE 0A                  CP   10   
0690   20 F8                  JR   NZ,prl   
0692   C9                     RET      
0693                          ENDIF      
0693                          IF   EDGEN   
0693   C3 EF 04     GED1:     JP   edit   
0696                             ; ^R, generic: what comes in from now until ^Z is the program. A CR is
0696                             ; stored as CR LF; a LF right after a line end is dropped (it is the CR's
0696                             ; own, or an empty line's), and a LF anywhere else ends a line too. A last
0696                             ; line with no end is given one. Nothing is echoed, and there is no check
0696                             ; for running out of memory.
0696   21 FF 82     CREAD:    LD   HL,PROG-1   
0699   36 0A                  LD   (HL),10   ; (as if a line had just ended: the byte is
069B   23                     INC   HL   ;   the line buffer's last, and spare)
069C   CD 86 05     RD1:      CALL   ekey   
069F   4F                     LD   C,A   
06A0   FE 1A                  CP   1Ah   
06A2   20 02                  JR   NZ,rd2   
06A4   3E 0A                  LD   A,10   ; ^Z ends the last line, as a LF would
06A6   FE 0A        RD2:      CP   10   
06A8   20 07                  JR   NZ,rd3   
06AA   2B                     DEC   HL   
06AB   BE                     CP   (HL)   
06AC   23                     INC   HL   
06AD   28 0B                  JR   Z,rd4   ; straight after a line end: dropped
06AF   3E 0D                  LD   A,13   ; anywhere else it ends the line
06B1   77           RD3:      LD   (HL),A   
06B2   23                     INC   HL   
06B3   FE 0D                  CP   13   
06B5   20 03                  JR   NZ,rd4   
06B7   36 0A                  LD   (HL),10   ; after a CR goes a LF
06B9   23                     INC   HL   
06BA   79           RD4:      LD   A,C   
06BB   FE 1A                  CP   1Ah   
06BD   20 DD                  JR   NZ,rd1   
06BF   36 00                  LD   (HL),0   
06C1   18 D0                  JR   ged1   
06C3                             ; ^W, generic: the text is printed as it is, for the terminal to capture.
06C3   21 00 83     CWRITE:   LD   HL,PROG   
06C6   7E           CW1:      LD   A,(HL)   
06C7   B7                     OR   A   
06C8   28 C9                  JR   Z,ged1   
06CA                          ;*Macro unroll:  PUTA
06CA   EF                     DS   1-CPM,0EFh   
06CB                          DS   CPM,0CDh   
06CB                          DS   CPM,APUT&0FFh   
06CB                          DS   CPM,APUT/256   
06CB   23                     INC   HL   
06CC   18 F8                  JR   cw1   
06CE                          ENDIF      
06CE                          IF   EDITOR*CPM   
                    CFCB:     EQU   005Ch   ; the file's name is kept here, where the CCP
                                 ;   put the one from the command line
                                 ; ^W, CP/M: write the file: delete the old one, make it anew, write the
                                 ; text in records of 128 bytes, and close it. The text's NUL and the 127
                                 ; bytes after it are set to ^Z meanwhile, which pads the last record. (A
                                 ; full disk or directory is not noticed: the calls fail and that is all.)
                    CWRITE:   CALL   setname   
                              LD   C,19   ; delete
                              CALL   fbdos   
                              LD   C,22   ; make
                              CALL   fbdos   
                              LD   HL,PROG   
                              XOR   A   
                    CW1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,cw1   
                              DEC   HL   ; HL -> the NUL
                              PUSH   HL   
                              LD   B,128   
                    CW2:      LD   (HL),1Ah   
                              INC   HL   
                              DJNZ   cw2   
                              POP   HL   
                              LD   DE,PROG   
                    CW3:      LD   A,E   ; a record that starts before the end is written
                              SUB   L   
                              LD   A,D   
                              SBC   A,H   
                              JR   NC,cw4   
                              PUSH   HL   
                              LD   C,21   ; write, from where the record lies
                              CALL   frec   
                              POP   HL   
                              JR   cw3   
                    CW4:      LD   (HL),0   ; the NUL again
                              LD   C,16   ; close
                              CALL   fbdos   
                              JP   edit   
                                 ; frec: BDOS function C (read or write a record) with the 128 bytes at DE.
                                 ; Returns A = the BDOS's answer, HL = DE and DE = DE + 128.
                    FREC:     PUSH   DE   
                              PUSH   BC   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              POP   BC   
                              CALL   fbdos   
                              POP   DE   
                              LD   HL,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              RET      
                                 ; setname: if a name was typed (the line does not start with its CR), put it
                                 ; in the FCB: up to 8 characters, a dot, up to 3 more, in capitals. The drive
                                 ; is the current one. Then, name or no name, clear the FCB after the name,
                                 ; as it must be before a file is opened or made.
                    SETNAME:   LD   DE,LINEBUF   
                              LD   A,(DE)   
                              CP   13   
                              JR   Z,fcbclr   
                              LD   HL,CFCB   
                              LD   (HL),0   ; the current drive
                              LD   B,11   
                    SN1:      INC   L   
                              LD   (HL)," "   
                              DJNZ   sn1   
                              LD   L,CFCB+1   
                    SN2:      LD   A,(DE)   
                              INC   DE   
                              CP   13   
                              JR   Z,fcbclr   
                              CP   "."   
                              JR   NZ,sn3   
                              LD   L,CFCB+9   ; the type
                              JR   sn2   
                    SN3:      CP   "a"   
                              JR   C,sn4   
                              AND   5Fh   ; a capital
                    SN4:      LD   (HL),A   
                              INC   L   
                              JR   sn2   
                    FCBCLR:   LD   HL,CFCB+12   
                              LD   B,24   
                    FC1:      LD   (HL),0   
                              INC   HL   
                              DJNZ   fc1   
                              RET      
                                 ; fbdos: BDOS function C on the file
                    FBDOS:    LD   DE,CFCB   
                              JP   BDOS   
                                 ; ^R, CP/M: read the file. A name typed before the key is the file's name
                                 ; from now on. (On into load, which returns to edit.)
                    CREAD:    CALL   setname   
                              LD   HL,edit   
                              PUSH   HL   
                                 ; load: read the file into PROG. No such file: no program. The text ends at
                                 ; the file"s first ^Z (1Ah), which pads a text file"s last record; one more
                                 ; goes after the last record, so the search always stops. And every line
                                 ; must end in LF: a last line without one is given a CR LF. (The FCB is
                                 ; clear after its name: the CCP left it so, or setname did.)
                    LOAD:     LD   C,15   ; open (no such file: the first read fails
                              CALL   fbdos   ;   too)
                              LD   DE,PROG   
                    LD1:      LD   C,20   ; read the next 128 bytes
                              CALL   frec   
                              OR   A   
                              JR   Z,ld1   
                              LD   (HL),1Ah   ; (HL = where the record that failed would be)
                              LD   HL,PROG-1   
                              LD   A,10   ; (a file with no text needs nothing added)
                    TR1:      INC   HL   
                              LD   E,A   ; E = the character before this one
                              LD   A,(HL)   
                              CP   1Ah   
                              JR   NZ,tr1   
                              LD   A,E   
                              CP   10   
                              JR   Z,tr2   
                              LD   (HL),13   
                              INC   HL   
                              LD   (HL),10   
                              INC   HL   
                    TR2:      LD   (HL),0   
                              RET      
06CE                          ENDIF      
06CE                             ; =============================================================================
06CE                          IF   CPM   
                                 ; The RAM pages follow the image; the heap may grow to the BDOS.
                    START:       
06CE                          ENDIF      
06CE                          IF   CPM*CHECKED*(1-EDITOR)   
                                 ; Clear the lower half of the letter page (as the editor build does
                                 ; at its start).
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
06CE                          ENDIF      
06CE                          IF   CPM*(1-EDITOR)   
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:      LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
06CE                          ENDIF      
06CE                          IF   CPM*(1-EDITOR)*QK   
                              CALL   skclr   ; an empty skip cache
06CE                          ENDIF      
06CE                          IF   CPM*(1-EDITOR)   
                              JP   st2   
06CE                          ENDIF      
06CE                          IF   FAST   
                                 ; =============================================================================
                                 ;  The speed build (FAST = 1)
                                 ; 
                                 ;  The inner loop is a table: 256 entries, the low bytes of the handlers'
                                 ;  addresses in one page and the high bytes in the next. The dispatcher (at
                                 ;  next0, and inline, as NEXTF, at the end of the speed build's own entries,
                                 ;  so there is no jump back to it; the ordinary handlers end in JP (IX), with
                                 ;  IX = next0, as in the CP/M builds):
                                 ; 
                                 ;      LD A,(BC) / INC BC / EX DE,HL / LD L,A / LD H,DTAB/256 /
                                 ;      LD A,(HL) / INC H / LD H,(HL) / LD L,A / JP (HL)
                                 ; 
                                 ;  So every entry starts with TOS in DE, not HL. The punctuation entries are
                                 ;  thunks into the ordinary handlers (EX DE,HL / JP handler); the letters and
                                 ;  digits have one entry each, which knows its cell or its value already.
                                 ; =============================================================================
                    FTSTORE:   EX   DE,HL   ; !
                              JP   h_store   
                    FTSTR:    EX   DE,HL   ; "
                              JP   h_str   
                    FTNUM:    EX   DE,HL   ; #
                              JP   h_num   
                    FTPRINT:   EX   DE,HL   ; $
                              JP   h_print   
                    FTSWAP:   EX   DE,HL   ; %
                              JP   h_swap   
                    FTAND:    EX   DE,HL   ; &
                              JP   h_and   
                    FTEMIT:   EX   DE,HL   ; '
                              JP   h_emit   
                    FTOPEN:   EX   DE,HL   ; (
                              JP   h_open   
                    FTCLOSE:   EX   DE,HL   ; )
                              JP   h_close   
                    FTMUL:    EX   DE,HL   ; *
                              JP   h_mul   
                    FTADD:    EX   DE,HL   ; +
                              JP   h_add   
                    FTCFETCH:   EX   DE,HL   ; ,
                              JP   h_cfetch   
                    FTSUB:    EX   DE,HL   ; -
                              JP   h_sub   
                    FTCSTORE:   EX   DE,HL   ; .
                              JP   h_cstore   
                    FTDIV:    EX   DE,HL   ; /
                              JP   h_div   
                    FTDUP:    EX   DE,HL   ; :
                              JP   h_dup   
                    FTDROP:   EX   DE,HL   ; ;
                              JP   h_drop   
                    FTLT:     EX   DE,HL   ; <
                              JP   h_lt   
                    FTEQ:     EX   DE,HL   ; =
                              JP   h_eq   
                    FTGT:     EX   DE,HL   ; >
                              JP   h_gt   
                    FTKEY:    EX   DE,HL   ; ?
                              JP   h_key   
                    FTFETCH:   EX   DE,HL   ; @
                              JP   h_fetch   
                    FTDEF:    EX   DE,HL   ; [
                              JP   h_def   
                    FTBREAK:   EX   DE,HL   ; \
                              JP   h_break   
                    FTRET:    EX   DE,HL   ; ]
                              JP   h_ret   
                    FTXOR:    EX   DE,HL   ; ^
                              JP   h_xor   
                    FTALLOC:   EX   DE,HL   ; _
                              JP   h_alloc   
                    FTGRAVE:   EX   DE,HL   ; `
                              JP   h_grave   
                    FTTOR:    EX   DE,HL   ; {
                              JP   h_tor   
                    FTOR:     EX   DE,HL   ; |
                              JP   h_or   
                    FTFROMR:   EX   DE,HL   ; }
                              JP   h_fromr   
                    FTNOT:    EX   DE,HL   ; ~
                              JP   h_not   
                                 ; The commonest punctuation, written for the speed build: TOS in DE on the
                                 ; way in, and the dispatcher inline on the way out.
                    FS_ADD:      ; +
                              POP   HL   
                              ADD   HL,DE   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_SUB:      ; -
                              LD   A,(BC)   ; a digit next: a negative number
                              SUB   "0"   
                              CP   10   
                              JR   C,fs_neg   
                              POP   HL   
                              OR   A   
                              SBC   HL,DE   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_NEG:   EX   DE,HL   
                              JP   h_sub   
                    FS_DUP:      ; :
                              PUSH   DE   
                              EX   DE,HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_DROP:      ; ;
                              POP   HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_SWAP:      ; %
                              POP   HL   
                              PUSH   DE   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_FET:      ; @
                              EX   DE,HL   
                              LD   E,(HL)   
                              INC   HL   
                              LD   D,(HL)   
                              EX   DE,HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_CFET:      ; ,
                              LD   A,(DE)   
                              LD   L,A   
                              LD   H,0   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_LT:       ; <
                              POP   HL   ; a < b: HL = a, DE = b
                    FS_LT1:   LD   A,H   
                              XOR   80h   
                              LD   H,A   
                              LD   A,D   
                              XOR   80h   
                              LD   D,A   
                              SBC   HL,DE   ; carry if HL < DE
                              SBC   HL,HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_GT:       ; >
                              POP   HL   ; a > b  is  b < a
                              EX   DE,HL   
                              JP   fs_lt1   
                    FS_EQ:       ; =
                              POP   HL   
                              OR   A   
                              SBC   HL,DE   
                              LD   A,H   
                              OR   L   
                              CP   1   ; carry only if a - b = 0
                              SBC   HL,HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_AND:      ; &
                              POP   HL   
                              LD   A,H   
                              AND   D   
                              LD   H,A   
                              LD   A,L   
                              AND   E   
                              LD   L,A   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
