0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Motorola 6809
0000                             ;  Spec: docs/b8script.md (2026-11-24).
0000                             ;  Follows the design of the Z80 interpreter (z80/b8s-z80.asm).
0000                             ; 
0000                             ;  Two switches, in the EQU lines below (CPM is always 0: the 6809 has no
0000                             ;  CP/M; the line is kept only so that build.sh works):
0000                             ;    CHECKED  0 = no checks (spec: an unchecked build checks nothing)
0000                             ;             1 = a checked build: variables start at 0, words start
0000                             ;                 undefined, and every error in the spec's table stops the
0000                             ;                 program with the four-line report, then goes to EXIT:
0000                             ;                   Err X @ line,col
0000                             ;                   <up to 16 characters of the text at the place>
0000                             ;                   Stk n: ... v v v      (n = depth, then the top 8 values)
0000                             ;                   Rtn n
0000                             ;                 S/s data stack over/underflow, R/r return stack over/
0000                             ;                 underflow, H heap, O store outside the program's space,
0000                             ;                 W bad character after [, U undefined word, Q no closing
0000                             ;                 quote, X reserved byte, Z divide by zero, N unbalanced or
0000                             ;                 mismatched brackets, B Ctrl-C.
0000                             ;    ANSI     what the console escapes of "$" (/00bbIC8= /| /` /~) do:
0000                             ;             1 = send ANSI (VT100) sequences through CONOUT
0000                             ;             0 = call the machine's own routines CONCLS, CONEOL, CONCUR and
0000                             ;                 CONAT (see the equates)
0000                             ; 
0000                             ;  In both builds Ctrl-C stops a running program (the unchecked build goes
0000                             ;  to EXIT without a word): see the console layer below for the rules, the
0000                             ;  held key and the break-off cell at 827Bh.
0000                             ; 
0000                             ;  Assembler: asm80, M6809 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   0   ; always 0 (no CP/M on the 6809)
0000                CHECKED:   EQU   1   ; 1 = checked build
0000                ANSI:     EQU   0   ; 1 = the console escapes send ANSI sequences
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    Y    IP: the address of the next program character to read
0000                             ;    U    the data stack pointer. The stack grows down and U points at the
0000                             ;         top cell (TOS); nothing is cached in a register, because every
0000                             ;         dispatch needs A, B and X as scratch. Cells are big-endian here.
0000                             ;         (Only the stacks are big-endian: cells in RAM that the program can
0000                             ;         see - variables, the heap pointer, anything @ and ! reach - are
0000                             ;         little-endian, as the spec says, so @ and ! swap the bytes.)
0000                             ;    S    the return stack. A word call is a plain push of Y. Entries are
0000                             ;         2 bytes, big-endian. Handlers are called with JSR, so the return
0000                             ;         address of the dispatcher is on top of S while a handler runs.
0000                             ;    DP   the letter page, so the letter-page variables below cost 2-byte
0000                             ;         direct addressing. Nothing else may change DP.
0000                             ;    A B X are scratch. Every handler is entered by JSR and ends in RTS (one
0000                             ;    byte). A handler that pushes or pops the return stack first pulls the
0000                             ;    dispatcher's return address into X (PULS X) and ends with JMP ,X.
0000                             ; 
0000                             ;  Dispatch (unchecked build). PTAB holds one byte per punctuation character:
0000                             ;  the low byte of the handler's distance from PTAB. The handlers of the last
0000                             ;  characters (in code order) start within 256 bytes after PTAB, the handlers
0000                             ;  of the first NPG1 characters in the 256 bytes after that. The assembler
0000                             ;  works NPG1 out from where five handlers landed, and testing/chktab09.py
0000                             ;  checks the layout. The checked build is bigger than that reach, so its
0000                             ;  table holds whole addresses instead.
0000                             ; -----------------------------------------------------------------------------
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM areas:
0000                             ; 
0000                             ;    8000h-80FFh  return stack (S); empty = 8100h. Unchecked: 127 entries.
0000                             ;                 Checked: 112 entries (S down to 8020h); the 32 bytes below
0000                             ;                 are a guard band for what a handler and an interrupt push
0000                             ;                 on top of a full stack before the check runs.
0000                             ;    8100h-81FFh  data stack (U). Unchecked: 127 cells, empty = 8200h.
0000                             ;                 Checked: 126 cells (U from 81FCh, empty, down to 8100h):
0000                             ;                 the 4 bytes above are a guard band, so a handler that runs
0000                             ;                 on an empty stack writes there and not on the letter
0000                             ;                 cells. A push past the last cell lands on the return
0000                             ;                 stack's bottom entry (80FEh), and the program stops with S
0000                             ;                 before anything reads it.
0000                             ;    8200h-82FFh  letter page (LET): A..Z at +00h..+33h, a..z at +40h..+73h
0000                             ;                 (a word cell is always 64 bytes below its variable), the
0000                             ;                 heap pointer at +7Ch (= z10+), interpreter variables in the
0000                             ;                 gaps, and the -n? line buffer at +80h..+FFh. The break-off
0000                             ;                 cell is at +7Bh (827Bh); +7Ah is free.
0000                             ;    8300h-       PROG, the program text, NUL-terminated; the heap starts
0000                             ;                 after the NUL and grows to HEAPLIM*256 (F000h)
0000                             ;    F000h-       this image (ROM). The reset vector (FFFEh) must point to
0000                             ;                 `start` (see the listing); the image does not contain it.
0000                             ;    FF03h-FF17h  the console routines (CONOUT, KEY, and with ANSI = 0
0000                             ;                 CONCLS, CONEOL, CONCUR, CONAT) and EXIT are supplied by
0000                             ;                 the system and need no space here.
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range LET..HEAPLIM*256.
0000                             ; -----------------------------------------------------------------------------
0000                             ; ---- generic machine: edit these to suit -----------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The Z flag must match A (end the
0000                             ;   routine with TSTA / RTS, or a plain LDA).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                             ;   Both are called with JSR. They may change A and CC and must preserve
0000                             ;   B, X, Y, U and DP.
0000                          IF   1-ANSI   
0000                             ; With ANSI = 0 the console escapes of "$" call these as subroutines (each
0000                             ; ends with RTS). All four may change A, B, X and CC, and must keep Y, U
0000                             ; and DP.
0000                CONCLS:   EQU   0FF0Ch   ; /{  clear the screen, the cursor to the top left
0000                CONEOL:   EQU   0FF0Fh   ; /}  clear from the cursor to the end of the line
0000                CONCUR:   EQU   0FF12h   ; /| and /`  show the cursor if A is not 0, hide
0000                             ;     it if A = 0
0000                CONAT:    EQU   0FF15h   ; /~  the cursor to row X, column D, both counted
0000                             ;     from 0
0000                          ENDIF      
0000                RSPAGE:   EQU   80h   
0000                DSPAGE:   EQU   81h   
0000                LETPAGE:   EQU   82h   
0000                PROG:     EQU   8300h   ; where the loader puts the program text
0000                             ; (the checked startup counts on it being
0000                             ; the page after LETPAGE)
0000                HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
0000                MSLOOP:   EQU   20   ; n? inner loop count for about 1 ms; tune it
0000                             ; for your clock and your KEY routine
0000                             ; letter-page layout (direct-page offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   7Ch   ; z10+, the heap pointer (little-endian)
0000                KEYBUF:   EQU   34h   ; gap after Z: a key held back by the break check
0000                COUNT:    EQU   35h   ; the break check's countdown (1 look in 256)
0000                AT:       EQU   36h   ; checked: the address of the character being
0000                             ;   run (big-endian), the place an error reports
0000                PEND:     EQU   38h   ; checked: the program's end, the first byte
0000                             ;   after its NUL (big-endian): the heap's floor
0000                SSAV:     EQU   3Ah   ; checked: S as each character starts (big-
0000                             ;   endian): the return stack an error reports
0000                PSAV:     EQU   3Ch   ; checked: the address "$" prints from (big-
0000                             ;   endian), put back on the stack for a Q
0000                BRKOFF:   EQU   7Bh   ; the break-off cell (827Bh, z9+): 0 = the
0000                             ;   break key is on
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+100h   ; empty return stack
0000                RSLIM:    EQU   RSPAGE*256+20h   ; checked: S may go no lower between characters
0000                RSREP:    EQU   RSTOP-16   ; checked: S while the error report runs
0000                DSTOP:    EQU   DSPAGE*256+100h-4*CHECKED   ; empty data stack (a guard if checked)
0000                DSLIM:    EQU   DSPAGE*256   ; checked: U may go no lower between characters
F000                          .ORG   0F000h   
F000                             ; =============================================================================
F000                             ;  Startup
F000                             ; =============================================================================
F000   10 CE 81 00  START:    LDS   #RSTOP   
F004   CE 81 FC               LDU   #DSTOP   
F007   86 82                  LDA   #LETPAGE   
F009   1F 8B                  TFR   A,DP   
F00B                          IF   CHECKED   
F00B                             ; Zero the whole letter page: every variable starts at 0, every word
F00B                             ; cell at 0 (undefined: a call stops with U), and so do the
F00B                             ; interpreter's own cells in the gaps (KEYBUF and the rest). A is
F00B                             ; still LETPAGE; 256 rounds leave X at the next page, PROG.
F00B   5F                     CLRB      
F00C   1F 01                  TFR   D,X   
F00E   6F 80        SZ:       CLR   ,X+   
F010   5A                     DECB      
F011   26 FB                  BNE   sz   
F013                          ENDIF      
F013                          IF   1-CHECKED   
                              CLR   <KEYBUF   ; no key held
                              CLR   <BRKOFF   ; the break key is on
                              LDX   #PROG   
F013                          ENDIF      
F013   1F 12                  TFR   X,Y   ; the reading position; the heap starts
F015   A6 80        SC:       LDA   ,X+   ;   after the program's NUL
F017   26 FC                  BNE   sc   
F019   1F 10                  TFR   X,D   
F01B   D7 7C                  STB   <HEAP   ; (little-endian)
F01D   97 7D                  STA   <HEAP+1   
F01F                          IF   CHECKED   
F01F   9F 38                  STX   <PEND   ; the heap may never go below this
F021                          ENDIF      
F021                             ; =============================================================================
F021                             ;  The inner loop: read one character and sort it by range.
F021                             ; 
F021                             ;    00h          end of program
F021                             ;    01h-20h, 7Fh       ignored (control, space, DEL)
F021                             ;    80h-FFh      reserved: ignored, or X in the checked build
F021                             ;    30h-39h      digit: read a whole number
F021                             ;    41h-5Ah      A-Z: call the word in that letter's cell
F021                             ;    61h-7Ah      a-z: push the address of that letter's cell
F021                             ;    the rest     punctuation: JSR through PTAB, 32 entries, in code order
F021                             ; =============================================================================
F021                NEXT:        
F021                          IF   CHECKED   
F021                             ; Both stacks are checked once per character, not in every handler:
F021                             ; the pointer minus its limit, taken as unsigned, must be no more
F021                             ; than the stack's size. Below the limit (an overflow) it wraps to
F021                             ; FFxxh, and the compare leaves N set; above the empty point (an
F021                             ; underflow) it is just over the size, and N is clear.
F021   30 C9 7F 00            LEAX   (0-DSLIM)&0FFFFh,U   
F025   8C 00 FC               CMPX   #DSTOP-DSLIM   
F028   22 61                  BHI   e_ds   
F02A   30 E9 7F E0            LEAX   (0-RSLIM)&0FFFFh,S   
F02E   8C 00 E0               CMPX   #RSTOP-RSLIM   
F031   22 61                  BHI   e_rs   
F033   10 9F 36               STY   <AT   ; the place, should this character fail
F036   10 DF 3A               STS   <SSAV   ; and the return stack, as it is now
F039                          ENDIF      
F039   A6 A0                  LDA   ,Y+   
F03B   27 72                  BEQ   fin   ; NUL ends the program
F03D   80 21                  SUBA   #21h   ; A = c - 21h
F03F   25 E0                  BLO   next   ; 01h-20h ignored
F041   81 0F                  CMPA   #0Fh   
F043   25 22                  BLO   punct   ; 21h-2Fh: PTAB index 0-14
F045   81 19                  CMPA   #19h   
F047   25 26                  BLO   digit   ; 30h-39h
F049   81 20                  CMPA   #20h   
F04B   25 18                  BLO   p3a   ; 3Ah-40h: A = 19h-1Fh
F04D   80 20                  SUBA   #20h   ; A = c - 41h
F04F   81 1A                  CMPA   #1Ah   
F051   25 28                  BLO   upper   ; 41h-5Ah: A = letter index 0-25
F053   81 20                  CMPA   #20h   
F055   25 0C                  BLO   p5b   ; 5Bh-60h
F057   81 3A                  CMPA   #3Ah   
F059   25 1A                  BLO   lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
F05B   81 3E                  CMPA   #3Eh   
F05D                          IF   1-CHECKED   
                              BHS   next   ; 7Fh-FFh: ignored
F05D                          ENDIF      
F05D                          IF   CHECKED   
F05D   27 C2                  BEQ   next   ; 7Fh (DEL): ignored
F05F   22 43                  BHI   e_resv   ; 80h-FFh: reserved
F061                          ENDIF      
F061   80 1A                  SUBA   #1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
F063   8B 06        P5B:      ADDA   #6   ; 5Bh-60h: -4 in all, index 22-27
F065   80 0A        P3A:      SUBA   #0Ah   ; 3Ah-40h: index 15-21
F067                             ; Punctuation: A = the PTAB index.
F067   8E F1 19     PUNCT:    LDX   #PTAB   
F06A                          IF   1-CHECKED   
                                 ; The handler is at PTAB + D, where B is the table byte and A is 1
                                 ; for the first NPG1 characters, 0 for the rest.
                              LDB   A,X   
                              CMPA   #NPG1   ; carry: one of the first NPG1
                              LDA   #0   ; (leaves the carry alone)
                              ROLA      
                              JSR   D,X   ; the handler ends in RTS
F06A                          ENDIF      
F06A                          IF   CHECKED   
F06A   48                     ASLA      ; the table holds whole addresses
F06B   AD 96                  JSR   [A,X]   
F06D                          ENDIF      
F06D   20 B2                  BRA   next   
F06F                             ; Digits: step back onto the first digit and read the whole number.
F06F   31 3F        DIGIT:    LEAY   -1,Y   
F071   8D 4D                  BSR   rdnum   
F073   20 AC                  BRA   next   
F075                             ; a-z: push the cell's address (the cell is the variable)
F075   8D 3B        LOWER:    BSR   cellx   
F077   36 10                  PSHU   X   
F079   20 A6                  BRA   next   
F07B                             ; A-Z: call the word. The IP (the address after the letter) goes on the
F07B                             ; return stack, and the IP becomes the address in the letter's cell.
F07B                             ; Checked: a cell still 0 (high byte 0) was never defined, since every
F07B                             ; address in the program's space is 8200h or more. The call has not been
F07B                             ; made yet, so the report shows the stacks as they were.
F07B   8D 35        UPPER:    BSR   cellx   
F07D   E6 84                  LDB   ,X   
F07F   A6 01                  LDA   1,X   
F081                          IF   CHECKED   
F081   27 27                  BEQ   e_undef   
F083                          ENDIF      
F083   34 20                  PSHS   Y   
F085   1F 02                  TFR   D,Y   
F087   8D 54                  BSR   pollk   ; the break check, at every word call
F089   20 96                  BRA   next   
F08B                             ; =============================================================================
F08B                             ;  Checked build: the error entries.
F08B                             ; 
F08B                             ;  Each entry loads its letter and then hides the next entry inside a 3-byte
F08B                             ;  CMPX # (the 8Ch), so that a run of them falls through to one place. The
F08B                             ;  place an error reports is the address in AT, which the inner loop sets to
F08B                             ;  each character before it runs it; the one error that reports another
F08B                             ;  place (W, at the character after the [) changes AT before it comes.
F08B                             ; 
F08B                             ;  The report counts the return stack from SSAV, which the inner loop sets
F08B                             ;  to S before each character, so an error may come from any depth of
F08B                             ;  calls: a handler, chkst under one, or ctlc under "?" or the break check.
F08B                             ;  (An r sets SSAV to the empty stack.) The inner loop's own entries are
F08B                             ;  here, where its short branches reach them; those reached from a handler
F08B                             ;  are after h_cstore, just ahead of the report.
F08B                             ; =============================================================================
F08B                          IF   CHECKED   
F08B                             ; ---- reached from the inner loop -------------------------------------------
F08B                             ; The stack checks branch here with N set for an overflow (the pointer is
F08B                             ; below its limit) and clear for an underflow. After an underflow that stack
F08B                             ; counts as empty.
F08B   2B 11        E_DS:     BMI   e_S   
F08D   CE 81 FC               LDU   #DSTOP   ; s
F090   86 73                  LDA   #"s"   
F092   20 18                  BRA   eall   
F094   2B 0B        E_RS:     BMI   e_R   
F096   8E 81 00               LDX   #RSTOP   ; r
F099   9F 3A                  STX   <SSAV   
F09B   86 72                  LDA   #"r"   
F09D   8C                     FCB   8Ch   
F09E   86 53        E_S:      LDA   #"S"   
F0A0   8C                     FCB   8Ch   
F0A1   86 52        E_R:      LDA   #"R"   
F0A3   8C                     FCB   8Ch   
F0A4   86 58        E_RESV:   LDA   #"X"   ; a reserved byte (80h-FFh) outside a string
F0A6   8C                     FCB   8Ch   
F0A7   86 42        E_BREAK:   LDA   #"B"   ; Ctrl-C (from ctlc, at any depth)
F0A9   8C                     FCB   8Ch   
F0AA   86 55        E_UNDEF:   LDA   #"U"   ; a word never defined (its cell is still 0)
F0AC   7E F3 4B     EALL:     JMP   error   
F0AF                          ENDIF      
F0AF   7E FF 09     FIN:      JMP   EXIT   ; the program has ended
F0B2                             ; cellx: A = letter index (0-25, or 32-57 for lowercase) -> X = cell address
F0B2   48           CELLX:    ASLA      
F0B3   8E 82 00               LDX   #LET   
F0B6   30 86                  LEAX   A,X   
F0B8   39                     RTS      
F0B9                             ; isdig: A = the character at IP minus "0"; the carry is set if it is a digit
F0B9   A6 A4        ISDIG:    LDA   ,Y   
F0BB   80 30                  SUBA   #"0"   
F0BD   81 0A                  CMPA   #10   
F0BF   39           AB9:      RTS      
F0C0                             ; rdnum: read decimal digits at IP and push the value; IP is left on the
F0C0                             ; first non-digit. Values wrap at 16 bits, as the spec says. The running
F0C0                             ; value lives in the new top cell: V = V*10 + digit.
F0C0   4F           RDNUM:    CLRA      
F0C1   5F                     CLRB      
F0C2   36 06                  PSHU   D   
F0C4   8D F3        RD1:      BSR   isdig   
F0C6   24 F7                  BHS   ab9   
F0C8   EC C4                  LDD   ,U   
F0CA   58                     ASLB      
F0CB   49                     ROLA      
F0CC   58                     ASLB      
F0CD   49                     ROLA      
F0CE   E3 C4                  ADDD   ,U   ; 5V
F0D0   58                     ASLB      
F0D1   49                     ROLA      ; 10V
F0D2   EB A0                  ADDB   ,Y+   ; and the digit, read again
F0D4   89 00                  ADCA   #0   
F0D6   83 00 30               SUBD   #30h   ; minus "0" (asm80 would put a quoted "0"
F0D9                             ;   in the high byte of a 16-bit operand)
F0D9   ED C4                  STD   ,U   
F0DB   20 E7                  BRA   rd1   
F0DD                             ; =============================================================================
F0DD                             ;  Console layer: the break key. A running program reads the keyboard only
F0DD                             ;  through pollk and getk, which between them give the break key its rules:
F0DD                             ;    - Ctrl-C (03h) stops the program;
F0DD                             ;    - any other key that the break check reads is held in KEYBUF for the
F0DD                             ;      next "?", and a newer one takes its place;
F0DD                             ;    - "?" (getk) takes the held key first;
F0DD                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
F0DD                             ;      key like any other, but two of them within about 250 ms still stop it.
F0DD                             ;  On a break the unchecked build ends without a word (EXIT); the checked
F0DD                             ;  one reports B. All three keep B, X, Y and U.
F0DD                             ; =============================================================================
F0DD                             ; pollk: the break check, at every word call and every true ")" loop-back.
F0DD                             ; It looks at the keyboard only once in 256 calls.
F0DD   0A 35        POLLK:    DEC   <COUNT   
F0DF   26 37                  BNE   cc9   
F0E1   BD FF 06               JSR   KEY   
F0E4   27 32                  BEQ   cc9   ; no key
F0E6   97 34                  STA   <KEYBUF   ; held for the next "?"
F0E8   20 0C                  BRA   ctlc   
F0EA                             ; getk: a key for "?", or A = 0 with the zero flag set if there is none.
F0EA   96 34        GETK:     LDA   <KEYBUF   ; a held key goes first, and is taken out of
F0EC   0F 34                  CLR   <KEYBUF   ;   the buffer (it has been through ctlc)
F0EE   4D                     TSTA      
F0EF   26 27                  BNE   cc9   
F0F1   BD FF 06               JSR   KEY   
F0F4   27 22                  BEQ   cc9   
F0F6                             ; ctlc: a key has been read. If it is Ctrl-C and the break key is on, that
F0F6                             ; is the end. If the program has turned it off, wait about 250 ms for one
F0F6                             ; more key: a second Ctrl-C is the end too; any other key is held (the
F0F6                             ; newest wins), and the Ctrl-C goes on: A = 3, zero flag clear.
F0F6   81 03        CTLC:     CMPA   #3   
F0F8   26 1E                  BNE   cc9   
F0FA   0D 7B                  TST   <BRKOFF   
F0FC   27 A9                  BEQ   brk   
F0FE   34 10                  PSHS   X   
F100   8E 13 88               LDX   #250*MSLOOP   
F103   BD FF 06     CC1:      JSR   KEY   
F106   26 06                  BNE   cc2   
F108   30 1F                  LEAX   -1,X   
F10A   26 F7                  BNE   cc1   
F10C   20 06                  BRA   cc3   
F10E   81 03        CC2:      CMPA   #3   
F110   27 95                  BEQ   brk   
F112   97 34                  STA   <KEYBUF   
F114   86 03        CC3:      LDA   #3   
F116   35 10                  PULS   X   
F118   39           CC9:      RTS      
F119                          IF   1-CHECKED   
                    BRK:      EQU   fin   ; the unchecked build stops without a word;
F119                          ENDIF      
F119                          IF   CHECKED   
F119                BRK:      EQU   e_break   ;   the checked build reports B (the report
F119                          ENDIF      ;   takes S from SSAV, so the depth of the
F119                             ;   calls here doesn't matter)
F119                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
F119                             ; and return its value in A with the carry set; otherwise leave the IP and
F119                             ; return with the carry clear.
F119                             ; (In the unchecked build it is here, ahead of the table, to leave room in
F119                             ; the two ranges after it; the checked build has it next to the grave.)
F119                          IF   1-CHECKED   
                    HEXC:     BSR   isdig   
                              BLO   hv1   ; C = 1
                              ANDA   #0DFh   
                              SUBA   #11h   
                              CMPA   #6   
                              BHS   hv9   ; C = 0
                              SUBA   #0F6h   ; + 10, and sets the carry
                    HV1:      LEAY   1,Y   ; (LEAY leaves the carry alone)
                    HV9:      RTS      
F119                          ENDIF      
F119                             ; =============================================================================
F119                             ;  Dispatch table, in code order.
F119                             ; 
F119                             ;  Unchecked build: one byte per character, the low byte of the handler's
F119                             ;  distance from PTAB. NPG1 is how many characters, from the start, have
F119                             ;  handlers more than 255 bytes past PTAB. ] \ [ @ ? sit where the two ranges
F119                             ;  meet (in falling code order for this), and which side each lands on is
F119                             ;  worked out here. (One division to a line: asm80 only rounds down when it
F119                             ;  stores a value.)
F119                             ; 
F119                             ;  Checked build: it has more code than the two ranges hold, so its table
F119                             ;  holds whole addresses and there are no rules about where handlers go.
F119                             ; =============================================================================
F119                          IF   1-CHECKED   
                    PGRET:    EQU   (h_ret-PTAB)/256   ; 0 = first range, 1 = second
                    PGBRK:    EQU   (h_break-PTAB)/256   
                    PGDEF:    EQU   (h_def-PTAB)/256   
                    PGFET:    EQU   (h_fetch-PTAB)/256   
                    PGKEY:    EQU   (h_key-PTAB)/256   
                    NPG1:     EQU   20 + PGKEY + PGFET + PGDEF + PGBRK + PGRET   
F119                          ENDIF      
F119                PTAB:        
F119                          IF   1-CHECKED   
                              FCB   (h_store-PTAB) & 0FFh   ; !
                              FCB   (h_str-PTAB) & 0FFh   ; "
                              FCB   (h_num-PTAB) & 0FFh   ; #
                              FCB   (h_print-PTAB) & 0FFh   ; $
                              FCB   (h_swap-PTAB) & 0FFh   ; %
                              FCB   (h_and-PTAB) & 0FFh   ; &
                              FCB   (h_emit-PTAB) & 0FFh   ; '
                              FCB   (h_open-PTAB) & 0FFh   ; (
                              FCB   (h_close-PTAB) & 0FFh   ; )
                              FCB   (h_mul-PTAB) & 0FFh   ; *
                              FCB   (h_add-PTAB) & 0FFh   ; +
                              FCB   (h_cfetch-PTAB) & 0FFh   ; ,
                              FCB   (h_sub-PTAB) & 0FFh   ; -
                              FCB   (h_cstore-PTAB) & 0FFh   ; .
                              FCB   (h_div-PTAB) & 0FFh   ; /
                              FCB   (h_dup-PTAB) & 0FFh   ; :
                              FCB   (h_drop-PTAB) & 0FFh   ; ;
                              FCB   (h_lt-PTAB) & 0FFh   ; <
                              FCB   (h_eq-PTAB) & 0FFh   ; =
                              FCB   (h_gt-PTAB) & 0FFh   ; >
                              FCB   (h_key-PTAB) & 0FFh   ; ?
                              FCB   (h_fetch-PTAB) & 0FFh   ; @
                              FCB   (h_def-PTAB) & 0FFh   ; [
                              FCB   (h_break-PTAB) & 0FFh   ; \
                              FCB   (h_ret-PTAB) & 0FFh   ; ]
                              FCB   (h_xor-PTAB) & 0FFh   ; ^
                              FCB   (h_alloc-PTAB) & 0FFh   ; _
                              FCB   (h_grave-PTAB) & 0FFh   ; `
                              FCB   (h_tor-PTAB) & 0FFh   ; {
                              FCB   (h_or-PTAB) & 0FFh   ; |
                              FCB   (h_fromr-PTAB) & 0FFh   ; }
                              FCB   (h_not-PTAB) & 0FFh   ; ~
F119                          ENDIF      
F119                          IF   CHECKED   
F119   F3 21                  FDB   h_store   ; !
F11B   F2 37                  FDB   h_str   ; "
F11D   F4 14                  FDB   h_num   ; #
F11F   F4 5F                  FDB   h_print   ; $
F121   F2 FE                  FDB   h_swap   ; %
F123   F3 12                  FDB   h_and   ; &
F125   F3 0A                  FDB   h_emit   ; '
F127   F2 A8                  FDB   h_open   ; (
F129   F2 BC                  FDB   h_close   ; )
F12B   F2 C8                  FDB   h_mul   ; *
F12D   F3 1A                  FDB   h_add   ; +
F12F   F2 B4                  FDB   h_cfetch   ; ,
F131   F4 8F                  FDB   h_sub   ; -
F133   F3 2D                  FDB   h_cstore   ; .
F135   F4 39                  FDB   h_div   ; /
F137   F3 05                  FDB   h_dup   ; :
F139   F3 0F                  FDB   h_drop   ; ;
F13B   F2 E6                  FDB   h_lt   ; <
F13D   F2 F2                  FDB   h_eq   ; =
F13F   F2 E4                  FDB   h_gt   ; >
F141   F2 5A                  FDB   h_key   ; ?
F143   F2 54                  FDB   h_fetch   ; @
F145   F1 EE                  FDB   h_def   ; [
F147   F1 CF                  FDB   h_break   ; \
F149   F1 CB                  FDB   h_ret   ; ]
F14B   F1 61                  FDB   h_xor   ; ^
F14D   F1 7D                  FDB   h_alloc   ; _
F14F   F1 99                  FDB   h_grave   ; `
F151   F1 6F                  FDB   h_tor   ; {
F153   F1 59                  FDB   h_or   ; |
F155   F1 77                  FDB   h_fromr   ; }
F157   F1 6A                  FDB   h_not   ; ~
F159                          ENDIF      
F159                PTABEND:      
F159                             ; =============================================================================
F159                             ;  Handlers that must start in the first range (within 255 bytes of PTAB)
F159                             ;  in the unchecked build: ^ _ ` 00bbIHwg ~
F159                             ; =============================================================================
F159   EC C1        H_OR:     LDD   ,U++   
F15B   AA C4                  ORA   ,U   
F15D   EA 41                  ORB   1,U   
F15F   20 06                  BRA   st0   
F161   EC C1        H_XOR:    LDD   ,U++   
F163   A8 C4                  EORA   ,U   
F165   E8 41                  EORB   1,U   
F167   ED C4        ST0:      STD   ,U   
F169   39                     RTS      
F16A   63 C4        H_NOT:    COM   ,U   
F16C   63 41                  COM   1,U   
F16E   39                     RTS      
F16F                             ; "{" ( n -- ) R: ( -- n )     The dispatcher's return address comes off the
F16F                             ; return stack first (PULS X) and is jumped to at the end.
F16F   35 10        H_TOR:    PULS   X   
F171   37 06                  PULU   D   
F173   34 06                  PSHS   D   
F175   6E 84                  JMP   ,X   
F177                             ; "}" ( -- n ) R: ( n -- )    The dispatcher's return address comes off
F177                             ; into D and the entry under it into X; D is then jumped to.
F177   35 16        H_FROMR:   PULS   D,X   
F179   36 10                  PSHU   X   
F17B   1F 05                  TFR   D,PC   
F17D                             ; "_" ( n -- addr ): the heap pointer moves by n (signed: a 16-bit add);
F17D                             ; TOS is the old pointer.
F17D                             ; Checked: the new top must be at least the program's end (PEND) and below
F17D                             ; the limit page. That also catches an add that wraps: the top is always
F17D                             ; 8301h-EFFFh and n is -32768..32767, so a sum that carries past FFFFh
F17D                             ; lands below 7000h, and one that borrows can't happen.
F17D   D6 7C        H_ALLOC:   LDB   <HEAP   
F17F   96 7D                  LDA   <HEAP+1   
F181   1F 01                  TFR   D,X   ; the old pointer
F183   E3 C4                  ADDD   ,U   
F185                          IF   CHECKED   
F185   10 93 38               CMPD   <PEND   
F188   25 04                  BLO   ah9   ; below the program's end
F18A   81 F0                  CMPA   #HEAPLIM   
F18C   25 04                  BLO   ah1   ; the new top must stay below the limit page
F18E   86 48        AH9:      LDA   #"H"   
F190   20 59                  BRA   ejmp   ; (with [ below)
F192                AH1:         
F192                          ENDIF      
F192   D7 7C                  STB   <HEAP   
F194   97 7D                  STA   <HEAP+1   
F196   AF C4                  STX   ,U   
F198   39                     RTS      
F199                             ; ---- machine code: the grave -----------------------------------------------
F199                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
F199                             ; are stored from addr until a non-hex character; then a RTS (39h) is
F199                             ; written and its address is left. An odd last digit is consumed and dropped.
F199                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
F199                             ; code is entered by JSR (the dispatcher's own), with the address already
F199                             ; popped: U points at the top data cell (big-endian, 2 bytes, stack grows
F199                             ; down) and the return address is on top of S. The code may pop and push
F199                             ; data cells by changing U; on return the cell at ,U is the new TOS. It must
F199                             ; keep Y (the interpreter's reading position), DP and S (balanced), and
F199                             ; return with RTS. A, B, X, CC may change.
F199                             ; Neither the loader's stores nor the code are checked, in either build.
F199   8D 1E        H_GRAVE:   BSR   hexc   ; the digit after the grave, if any
F19B   24 1A                  BCC   exec   
F19D   AE C4                  LDX   ,U   
F19F   C6 10        HX1:      LDB   #16   
F1A1   3D                     MUL      ; B = the digit, moved up to the high half
F1A2   E7 84                  STB   ,X   ; (an odd digit is overwritten by the RTS)
F1A4   8D 13                  BSR   hexc   
F1A6   24 08                  BCC   hx2   ; odd digit: already consumed, dropped
F1A8   AA 84                  ORA   ,X   
F1AA   A7 80                  STA   ,X+   
F1AC   8D 0B                  BSR   hexc   
F1AE   25 EF                  BCS   hx1   
F1B0   86 39        HX2:      LDA   #39h   ; RTS
F1B2   A7 84                  STA   ,X   
F1B4   AF C4                  STX   ,U   
F1B6   39                     RTS      
F1B7   37 80        EXEC:     PULU   PC   ; jump to it: the code's RTS returns to the
F1B9                             ;   dispatcher
F1B9                          IF   CHECKED   
F1B9   BD F0 B9     HEXC:     JSR   isdig   
F1BC   25 0A                  BLO   hv1   ; C = 1
F1BE   84 DF                  ANDA   #0DFh   
F1C0   80 11                  SUBA   #11h   
F1C2   81 06                  CMPA   #6   
F1C4   24 04                  BHS   hv9   ; C = 0
F1C6   80 F6                  SUBA   #0F6h   ; + 10, and sets the carry
F1C8   31 21        HV1:      LEAY   1,Y   ; (LEAY leaves the carry alone)
F1CA   39           HV9:      RTS      
F1CB                          ENDIF      
F1CB                             ; ---- where the two ranges meet ---------------------------------------------
F1CB                             ; The first range ends somewhere among the next five handlers, ] \ [ @ ?
F1CB                             ; (they are in falling code order for this): NPG1 follows. Every handler
F1CB                             ; below them must start in the second range, and every one above in the
F1CB                             ; first.
F1CB                             ; "]" returns: pop an address and jump to it. (PULS X,Y: the dispatcher's
F1CB                             ; return address into X, then the saved IP into Y.)
F1CB   35 30        H_RET:    PULS   X,Y   
F1CD   6E 84                  JMP   ,X   
F1CF                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
F1CF                             ; drops the block start, "]" returns. No closer at all ends the program.
F1CF   EC C1        H_BREAK:   LDD   ,U++   
F1D1   27 60                  BEQ   sk9   ; false: nothing to do
F1D3   8D 3F                  BSR   skip   
F1D5   4D                     TSTA      ; skip returns 0 for ")"
F1D6                          IF   CHECKED   
F1D6   10 2B FE D5            LBMI   fin   ; (and FFh for the NUL: the program ends)
F1DA                          ENDIF      
F1DA   26 EF                  BNE   h_ret   
F1DC   35 16        RDROP:    PULS   D,X   ; the return address and the block start
F1DE   1F 05                  TFR   D,PC   ; back to the dispatcher
F1E0                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
F1E0                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
F1E0                             ; the body"s address instead. Either way it then skips to the matching "]'.
F1E0                             ; (The unchecked build takes anything that is not a letter as the space; the
F1E0                             ; checked build stops on it.)
F1E0                          IF   CHECKED   
F1E0   81 DF        DEF1:     CMPA   #" "-"A"+256   
F1E2   27 20                  BEQ   def2   
F1E4   31 3F                  LEAY   -1,Y   ; anything but a letter or a space: W. The
F1E6   10 9F 36               STY   <AT   ;   place is that character, just read
F1E9   86 57                  LDA   #"W"   
F1EB   7E F3 4B     EJMP:     JMP   error   ; (H and N come here too)
F1EE                          ENDIF      
F1EE   A6 A0        H_DEF:    LDA   ,Y+   
F1F0   80 41                  SUBA   #"A"   ; a letter gives 0-25 or 32-57: lowercase
F1F2   1F 89                  TFR   A,B   ;   lands 64 bytes up
F1F4   C4 DF                  ANDB   #0DFh   ; fold case
F1F6   C1 1A                  CMPB   #26   
F1F8                          IF   1-CHECKED   
                              BHS   def2   ; not a letter
F1F8                          ENDIF      
F1F8                          IF   CHECKED   
F1F8   24 E6                  BHS   def1   
F1FA                          ENDIF      
F1FA   BD F0 B2               JSR   cellx   
F1FD   1F 20                  TFR   Y,D   
F1FF   E7 84                  STB   ,X   ; little-endian
F201   A7 01                  STA   1,X   
F203   8C                     FCB   8Ch   ; (CMPX #: steps over the PSHU)
F204   36 20        DEF2:     PSHU   Y   ; an anonymous block: push its address
F206                          IF   1-CHECKED   
                                 ; fall into skip
F206                          ENDIF      
F206                          IF   CHECKED   
F206                             ; Checked: the skip must end at a "]" (A = 2), or for a false "(",
F206                             ; which comes to opf, at a ")" (A = 0). Anything else stops with N.
F206   8D 0C                  BSR   skip   
F208   80 02                  SUBA   #2   
F20A   8C                     FCB   8Ch   ; (CMPX #: steps over the BSR)
F20B   8D 07        OPF:      BSR   skip   
F20D   4D                     TSTA      
F20E   27 23                  BEQ   sk9   ; (an RTS)
F210   86 4E                  LDA   #"N"   
F212   20 D7                  BRA   ejmp   
F214                          ENDIF      
F214                             ; skip: read past text to the closer at this level, and return A = 0 if it
F214                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
F214                             ; strings are stepped over whole. B counts the open levels.
F214                             ; Unchecked: a NUL first ends the program (for "\" with no closer; anything
F214                             ; else that runs into the NUL had unbalanced brackets anyway).
F214                             ; Checked: a NUL, or a string that runs into it, returns A = FFh, and the
F214                             ; caller decides: "\" ends the program, "(" and "[" stop with N, as they do
F214                             ; for a closer of the other kind. The place is the opener, still in AT.
F214   5F           SKIP:     CLRB      
F215   A6 A0        SK1:      LDA   ,Y+   
F217                          IF   1-CHECKED   
                              LBEQ   fin   
F217                          ENDIF      
F217                          IF   CHECKED   
F217   27 38                  BEQ   ssn   ; A = FFh
F219                          ENDIF      
F219   81 22                  CMPA   #22h   
F21B   26 04                  BNE   sk2   
F21D   8D 25                  BSR   skipstr   ; leaves A = 22h, which matches nothing below
F21F                          IF   CHECKED   
F21F   25 12                  BCS   sk9   ; (or FFh, with the carry set: unclosed)
F221                          ENDIF      
F221   80 28        SK2:      SUBA   #"("   
F223   27 0F                  BEQ   sk3   
F225   4A                     DECA      ; ")"
F226   27 08                  BEQ   sk4   
F228   80 32                  SUBA   #"["-")"   
F22A   27 08                  BEQ   sk3   
F22C   81 02                  CMPA   #"]"-"["   
F22E   26 E5                  BNE   sk1   
F230   5A           SK4:      DECB      
F231   2A E2                  BPL   sk1   
F233   39           SK9:      RTS      ; the closer at this level
F234   5C           SK3:      INCB      
F235   20 DE                  BRA   sk1   
F237                             ; 22h, checked build (the unchecked one is with the handlers below).
F237                             ; Checked: a NUL ends the string too, even right after a "/"; skipstr then
F237                             ; returns A = FFh with the carry set (the carry is clear at the quote), and
F237                             ; """ stops with Q, the string's address already pushed. (skip comes here
F237                             ; for its own NUL as well.)
F237                          IF   CHECKED   
F237   36 20        H_STR:    PSHU   Y   
F239   8D 09                  BSR   skipstr   
F23B   10 25 01 0A            LBCS   e_quote   
F23F   39                     RTS      
F240   A6 A0        SS0:      LDA   ,Y+   ; the character after the "/"
F242   27 0D                  BEQ   ssn   
F244   A6 A0        SKIPSTR:   LDA   ,Y+   
F246   27 09                  BEQ   ssn   
F248   81 2F                  CMPA   #"/"   
F24A   27 F4                  BEQ   ss0   
F24C   81 22                  CMPA   #22h   
F24E   26 F4                  BNE   skipstr   
F250   39                     RTS      ; the quote: C = 0
F251   80 01        SSN:      SUBA   #1   ; the NUL: A = FFh, C = 1
F253   39                     RTS      
F254                          ENDIF      
F254   AE C4        H_FETCH:   LDX   ,U   ; "@" (the cell in memory is little-endian)
F256   A6 01                  LDA   1,X   
F258   20 5D                  BRA   cf1   
F25A                             ; "?" ( n -- c ) or ( -n -- addr )
F25A                             ;   n > 0: wait about n ms for a key; 0 if none came
F25A                             ;   n = 0: wait for a key
F25A                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
F25A                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
F25A   AE C4        H_KEY:    LDX   ,U   
F25C   2B 17                  BMI   line   
F25E   C6 14        KT1:      LDB   #MSLOOP   ; one millisecond, roughly
F260   BD F0 EA     KT2:      JSR   getk   
F263   26 0B                  BNE   kt3   
F265   5A                     DECB      
F266   26 F8                  BNE   kt2   
F268   30 1F                  LEAX   -1,X   
F26A   26 F2                  BNE   kt1   ; A = 0 if the time ran out
F26C   AE C4                  LDX   ,U   ; 0?: the countdown from 0 took 65536 ms;
F26E   27 EE                  BEQ   kt1   ;   run it again, until a key comes
F270   6F C4        KT3:      CLR   ,U   
F272   A7 41                  STA   1,U   
F274   39                     RTS      
F275                             ; Backspace takes the last character back (and is echoed as it is), CR ends
F275                             ; (stored, not echoed), every other key is stored and echoed until the line
F275                             ; is full. B = the length so far; the low byte of the top cell becomes the
F275                             ; most allowed (it holds minus the count on entry).
F275   8C FF 81     LINE:     CMPX   #-127   ; (X = TOS, minus the count)
F278   24 04                  BHS   ln1   
F27A   86 81                  LDA   #-127   ; more than 127 is taken as 127
F27C   A7 41                  STA   1,U   
F27E   60 41        LN1:      NEG   1,U   
F280   8E 82 80               LDX   #LINEBUF   
F283   5F                     CLRB      
F284   BD F0 EA     LN2:      JSR   getk   
F287   27 FB                  BEQ   ln2   
F289   81 0D                  CMPA   #13   
F28B   27 16                  BEQ   ln5   
F28D   81 08                  CMPA   #8   
F28F   27 0C                  BEQ   ln4   
F291   E1 41                  CMPB   1,U   
F293   24 EF                  BHS   ln2   ; full
F295   A7 85                  STA   B,X   
F297   5C                     INCB      
F298   BD FF 03     LN3:      JSR   CONOUT   
F29B   20 E7                  BRA   ln2   
F29D   5D           LN4:      TSTB      ; Backspace: nothing to take back?
F29E   27 E4                  BEQ   ln2   
F2A0   5A                     DECB      
F2A1   20 F5                  BRA   ln3   ; echo it
F2A3   A7 85        LN5:      STA   B,X   ; A = 13
F2A5   AF C4                  STX   ,U   
F2A7   39                     RTS      
F2A8                             ; =============================================================================
F2A8                             ;  Handlers that must start in the second range (unchecked build).
F2A8                             ; =============================================================================
F2A8                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
F2A8                             ; the matching ")".
F2A8   EC C1        H_OPEN:   LDD   ,U++   
F2AA                          IF   1-CHECKED   
                              BEQ   skip   ; tail call: skip ends in RTS
F2AA                          ENDIF      
F2AA                          IF   CHECKED   
F2AA   10 27 FF 5D            LBEQ   opf   ; checked: skip, and check the closer
F2AE                          ENDIF      
F2AE   35 10                  PULS   X   
F2B0   34 20                  PSHS   Y   
F2B2   6E 84                  JMP   ,X   
F2B4                             ; 22h pushes the address of the text after it and skips the string.
F2B4                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
F2B4                             ; the next character, so "/"" does not end it. Leaves A = 22h. (The checked
F2B4                             ; build's is after skip.)
F2B4                          IF   1-CHECKED   
                    H_STR:    PSHU   Y   
                              FCB   8Ch   ; (CMPX #: steps over the LEAY)
                    SS0:      LEAY   1,Y   
                    SKIPSTR:   LDA   ,Y+   
                              CMPA   #"/"   
                              BEQ   ss0   
                              CMPA   #22h   
                              BNE   skipstr   
                              RTS      
F2B4                          ENDIF      
F2B4   AE C4        H_CFETCH:   LDX   ,U   ; ","
F2B6   4F                     CLRA      
F2B7   E6 84        CF1:      LDB   ,X   
F2B9   ED C4                  STD   ,U   
F2BB   39                     RTS      
F2BC                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
F2BC                             ; drops it and carries on.
F2BC   EC C1        H_CLOSE:   LDD   ,U++   
F2BE   10 27 FF 1A            LBEQ   rdrop   
F2C2   10 AE 62               LDY   2,S   ; the block start, under the return address
F2C5   7E F0 DD               JMP   pollk   ; the break check, at every loop-back
F2C8                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
F2C8                             ; "*": three 8x8 multiplies; only the low 16 bits are kept.
F2C8                             ; a = ah:al at 2,U.  b = bh:bl at ,U.
F2C8   A6 43        H_MUL:    LDA   3,U   
F2CA   E6 C4                  LDB   ,U   
F2CC   3D                     MUL      ; al*bh
F2CD   E7 C4                  STB   ,U   ; (bh is no longer needed)
F2CF   A6 42                  LDA   2,U   
F2D1   E6 41                  LDB   1,U   
F2D3   3D                     MUL      ; ah*bl
F2D4   EB C4                  ADDB   ,U   
F2D6   E7 C4                  STB   ,U   ; the cross terms, low byte
F2D8   A6 43                  LDA   3,U   
F2DA   E6 41                  LDB   1,U   
F2DC   3D                     MUL      ; al*bl
F2DD   AB C4                  ADDA   ,U   
F2DF   33 42                  LEAU   2,U   
F2E1   ED C4                  STD   ,U   
F2E3   39                     RTS      
F2E4                             ; Signed compares: a-b, then a branch to put -1 or 0 on the stack.
F2E4   8D 18        H_GT:     BSR   h_swap   ; a > b is b < a
F2E6   8D 10        H_LT:     BSR   cmp   
F2E8   2D 02                  BLT   true   
F2EA   5F           FALSE:    CLRB      
F2EB   8C                     FCB   8Ch   ; (CMPX #: steps over the LDB)
F2EC   C6 FF        TRUE:     LDB   #0FFh   
F2EE   1D                     SEX      ; D = 0000 or FFFF
F2EF   ED C4                  STD   ,U   
F2F1   39                     RTS      
F2F2   8D 04        H_EQ:     BSR   cmp   
F2F4   27 F6                  BEQ   true   
F2F6   20 F2                  BRA   false   
F2F8   EC 42        CMP:      LDD   2,U   
F2FA   10 A3 C1               CMPD   ,U++   
F2FD   39                     RTS      
F2FE                             ; ---- stack, and printing ----------------------------------------------------
F2FE   37 16        H_SWAP:   PULU   D,X   ; "%"
F300   36 06                  PSHU   D   
F302   36 10                  PSHU   X   
F304   39                     RTS      
F305   EC C4        H_DUP:    LDD   ,U   ; ":"
F307   36 06                  PSHU   D   
F309   39                     RTS      
F30A   A6 41        H_EMIT:   LDA   1,U   ; "'"
F30C                          IF   1-CHECKED   
                              BSR   putc   
F30C                          ENDIF      
F30C                          IF   CHECKED   
F30C   BD FF 03               JSR   CONOUT   ; (the checked build's report is in the way)
F30F                          ENDIF      
F30F   33 42        H_DROP:   LEAU   2,U   ; ";"
F311   39                     RTS      
F312                             ; ---- more arithmetic ---------------------------------------------------------
F312   EC C1        H_AND:    LDD   ,U++   
F314   A4 C4                  ANDA   ,U   
F316   E4 41                  ANDB   1,U   
F318   20 04                  BRA   st   
F31A   EC C1        H_ADD:    LDD   ,U++   
F31C   E3 C4                  ADDD   ,U   
F31E   ED C4        ST:       STD   ,U   
F320   39                     RTS      
F321                             ; "-" has two jobs: directly before a digit it starts a negative number.
F321                             ; (The checked build has it in the tail, near negnum: its report would be
F321                             ; in the way here.)
F321                          IF   1-CHECKED   
                    H_SUB:    JSR   isdig   
                              BLO   negnum   
                              LDD   2,U   
                              SUBD   ,U++   
                              BRA   st   
F321                          ENDIF      
F321                             ; "!" ( n addr -- ) is "." with the high byte stored first. The cell in
F321                             ; memory is little-endian.
F321                             ; Checked: both bytes must be in the program's space, and they are tested
F321                             ; before either is stored (chkst stops with O, the stack untouched).
F321                          IF   1-CHECKED   
                    H_STORE:   PULU   X   
                              LDA   ,U   
                              STA   1,X   
F321                          ENDIF      
F321                          IF   CHECKED   
F321   AE C4        H_STORE:   LDX   ,U   
F323   8D 13                  BSR   chkst   
F325   30 01                  LEAX   1,X   
F327   8D 0F                  BSR   chkst   
F329   A6 42                  LDA   2,U   
F32B   A7 84                  STA   ,X   
F32D                             ; and fall into ".", which loads X again (and checks it again)
F32D                          ENDIF      
F32D                          IF   1-CHECKED   
                              FCB   8Ch   ; (CMPX #: steps over the PULU)
                    H_CSTORE:   PULU   X   ; "." ( c addr -- )
F32D                          ENDIF      
F32D                          IF   CHECKED   
F32D   AE C4        H_CSTORE:   LDX   ,U   ; "." ( c addr -- )
F32F   8D 07                  BSR   chkst   
F331   33 42                  LEAU   2,U   
F333                          ENDIF      
F333   37 06                  PULU   D   
F335   E7 84                  STB   ,X   
F337   39                     RTS      
F338                          IF   CHECKED   
F338                             ; ---- reached from a handler ------------------------------------------------
F338                             ; chkst: stop with O unless X is in the program's own space: from the letter
F338                             ; page up to HEAPLIM, so the interpreter's stacks and whatever lies above the
F338                             ; limit are safe. Memory above the heap top but below the limit is the
F338                             ; program's own: Tiny BASIC keeps its lines there. Keeps every register.
F338   8C 82 00     CHKST:    CMPX   #LET   
F33B   25 06                  BLO   cs9   
F33D   8C F0 00               CMPX   #HEAPLIM*256   
F340   24 01                  BHS   cs9   
F342   39                     RTS      ; in range
F343   86 4F        CS9:      LDA   #"O"   
F345   8C                     FCB   8Ch   
F346   86 5A        E_ZERO:   LDA   #"Z"   ; / by zero
F348   8C                     FCB   8Ch   
F349   86 51        E_QUOTE:   LDA   #"Q"   ; " or $ ran into the NUL
F34B                             ; and fall into error. (H, W and N have their own entries, near
F34B                             ; their handlers, at ejmp.)
F34B                             ; =============================================================================
F34B                             ;  Checked build: the error report. A = the letter, AT = the place; U is
F34B                             ;  as the program left it, and SSAV holds S as the failing character began
F34B                             ;  (see "the error entries" after `upper`).
F34B                             ;  It sits here, ahead of h_num, pdec and putc, so that it reaches them with
F34B                             ;  short calls. Prints
F34B                             ; 
F34B                             ;     CR LF
F34B                             ;     Err X @ line,col CR LF
F34B                             ;     <up to 16 raw characters from the place, ending early at CR, LF, NUL>
F34B                             ;     CR LF
F34B                             ;     Stk n:[ ...][ v]*  CR LF     (the top 8 cells, bottom to top, signed)
F34B                             ;     Rtn n CR LF
F34B                             ; 
F34B                             ;  and goes to EXIT. Line and column count from 1: the line is one more
F34B                             ;  than the LFs between PROG and the place, the column the distance from the
F34B                             ;  last LF (or from PROG-1). A place below PROG is in the -n? line buffer:
F34B                             ;  line 0, column = its offset there + 1. Numbers other than the cells are
F34B                             ;  printed unsigned (pdec), the cells signed (h_num).
F34B                             ; 
F34B                             ;  The data stack may be one cell past its limit (S, U = 80FEh): the
F34B                             ;  report's own cells then reach 8 bytes further down, to 80F6h, into the
F34B                             ;  return stack page, so the report runs on a fresh return stack at RSREP
F34B                             ;  (80F0h), below those bytes.
F34B                             ; =============================================================================
F34B   10 CE 80 F0  ERROR:    LDS   #RSREP   
F34F   1F 89                  TFR   A,B   ; the letter (pmsg and CONOUT keep B)
F351   8D 34                  BSR   pmsg   
F353   0D 0A 45 72 72 A0      FCB   13,10,"Err"," "+80h   
F359   1F 98                  TFR   B,A   
F35B   BD FF 03               JSR   CONOUT   
F35E   8D 27                  BSR   pmsg   
F360   20 40 A0               FCB   " @"," "+80h   
F363                             ; the place: Y counts the lines, X walks, the cell at ,U holds the
F363                             ; address of the last LF (PROG-1 to begin with)
F363   10 8E 00 00            LDY   #0   
F367   8E 82 7F               LDX   #LINEBUF-1   
F36A   36 10                  PSHU   X   
F36C   8E 82 FF               LDX   #PROG-1   
F36F   9C 36                  CMPX   <AT   
F371   24 23                  BHS   lc3   ; the place is below PROG: line 0
F373   AF C4                  STX   ,U   
F375   31 21        LC1:      LEAY   1,Y   ; a line
F377   30 01        LC2:      LEAX   1,X   
F379   9C 36                  CMPX   <AT   
F37B   24 19                  BHS   lc3   
F37D   A6 84                  LDA   ,X   
F37F   81 0A                  CMPA   #10   
F381   26 F4                  BNE   lc2   
F383   AF C4                  STX   ,U   
F385   20 EE                  BRA   lc1   
F387                             ; pmsg: print the text after the call, up to and including the character
F387                             ; that has bit 7 set (it is printed without it), then return after it.
F387                             ; (It sits here, in the middle of the report, where all its calls reach.)
F387   35 10        PMSG:     PULS   X   
F389   A6 84        PM1:      LDA   ,X   
F38B   84 7F                  ANDA   #7Fh   
F38D   BD F4 36               JSR   putc   
F390   6D 80                  TST   ,X+   
F392   2A F5                  BPL   pm1   
F394   6E 84                  JMP   ,X   
F396   DC 36        LC3:      LDD   <AT   
F398   A3 C4                  SUBD   ,U   
F39A   ED C4                  STD   ,U   ; the column
F39C   36 20                  PSHU   Y   
F39E   8D 7E                  BSR   pdec   ; the line
F3A0   8D E5                  BSR   pmsg   
F3A2   AC                     FCB   ","+80h   
F3A3   8D 79                  BSR   pdec   ; the column
F3A5   8D E0                  BSR   pmsg   
F3A7   0D 8A                  FCB   13,10+80h   
F3A9                             ; the text at the place
F3A9   9E 36                  LDX   <AT   
F3AB   C6 10                  LDB   #16   
F3AD   A6 80        TX1:      LDA   ,X+   
F3AF   27 0D                  BEQ   tx9   
F3B1   81 0A                  CMPA   #10   
F3B3   27 09                  BEQ   tx9   
F3B5   81 0D                  CMPA   #13   
F3B7   27 05                  BEQ   tx9   
F3B9   8D 7B                  BSR   putc   
F3BB   5A                     DECB      
F3BC   26 EF                  BNE   tx1   
F3BE   8D C7        TX9:      BSR   pmsg   
F3C0   0D 0A 53 74 6B A0      FCB   13,10,"Stk"," "+80h   
F3C6                             ; the data stack: its depth, then its top 8 cells, from Y down to
F3C6                             ; the program's top cell, at ,U.
F3C6   34 40                  PSHS   U   ; where the walk ends
F3C8   CC 81 FC               LDD   #DSTOP   
F3CB   A3 E4                  SUBD   ,S   
F3CD   8D 3F                  BSR   pdh   ; the depth (pdec leaves U as it was)
F3CF   8D B6                  BSR   pmsg   
F3D1   BA                     FCB   ":"+80h   
F3D2   31 C8 10               LEAY   16,U   ; past the 8th cell from the top ...
F3D5   10 8C 81 FC            CMPY   #DSTOP   
F3D9   24 08                  BHS   sl1   
F3DB   8D AA                  BSR   pmsg   ; (there are more than 8)
F3DD   20 2E 2E AE            FCB   " ..","."+80h   
F3E1   20 04                  BRA   sl2   
F3E3   10 8E 81 FC  SL1:      LDY   #DSTOP   ; ... or the whole stack, if no more than 8
F3E7   10 AC E4     SL2:      CMPY   ,S   
F3EA   23 0B                  BLS   sl9   
F3EC   EC A3                  LDD   ,--Y   
F3EE   36 06                  PSHU   D   
F3F0   8D 95                  BSR   pmsg   
F3F2   A0                     FCB   " "+80h   
F3F3   8D 1F                  BSR   h_num   
F3F5   20 F0                  BRA   sl2   
F3F7   8D 8E        SL9:      BSR   pmsg   
F3F9   0D 0A 52 74 6E A0      FCB   13,10,"Rtn"," "+80h   
F3FF   CC 81 00               LDD   #RSTOP   ; the return stack's depth, (RSTOP - S) / 2,
F402   93 3A                  SUBD   <SSAV   ;   S as it was when this character began
F404   8D 08                  BSR   pdh   
F406   BD F3 87               JSR   pmsg   
F409   0D 8A                  FCB   13,10+80h   
F40B   7E FF 09               JMP   EXIT   
F40E                             ; pdh: print D/2 (a depth: D is twice it), unsigned.
F40E   44           PDH:      LSRA      
F40F   56                     RORB      
F410   36 06                  PSHU   D   
F412   20 0A                  BRA   pdec   
F414                          ENDIF      
F414                             ; "#" prints TOS as a signed decimal number, with no space after it.
F414   6D C4        H_NUM:    TST   ,U   
F416   2A 06                  BPL   pdec   
F418   86 2D                  LDA   #"-"   
F41A   8D 1A                  BSR   putc   
F41C   8D 7F                  BSR   negt   
F41E                             ; pdec: print the top cell as unsigned and drop it, by recursion on /10
F41E   CC 00 0A     PDEC:     LDD   #10   
F421   36 06                  PSHU   D   
F423                          IF   1-CHECKED   
                              BSR   udiv   ; NOS = quotient, TOS = digit
F423                          ENDIF      
F423                          IF   CHECKED   
F423   17 00 86               LBSR   udiv   ; (out of a BSR's reach here)
F426                          ENDIF      
F426   37 06                  PULU   D   ; the digit
F428   34 04                  PSHS   B   
F42A   EC C1                  LDD   ,U++   ; the quotient: if it is not 0, it goes
F42C   27 04                  BEQ   pd1   ;   back for the rest of the digits
F42E   36 06                  PSHU   D   
F430   8D EC                  BSR   pdec   
F432   35 02        PD1:      PULS   A   
F434   8B 30                  ADDA   #"0"   ; and fall into putc
F436   7E FF 03     PUTC:     JMP   CONOUT   
F439                             ; ---- the tail ---------------------------------------------------------------
F439                             ; "$" is the last handler, so what follows its first byte may lie past the
F439                             ; second range: its loop, the escapes, and the routines of "/".
F439                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
F439                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
F439                             ; of a. Unchecked, dividing by zero returns two cells of no meaning; checked,
F439                             ; it stops with Z, both operands still on the stack.
F439                H_DIV:       
F439                          IF   CHECKED   
F439   EC C4                  LDD   ,U   
F43B   10 27 FF 07            LBEQ   e_zero   
F43F                          ENDIF      
F43F   A6 42                  LDA   2,U   
F441   34 02                  PSHS   A   ; a's sign: for r
F443   A8 C4                  EORA   ,U   
F445   34 02                  PSHS   A   ; a xor b: for q
F447   30 42                  LEAX   2,U   
F449   8D 5B                  BSR   absx   ; |a|
F44B   1F 31                  TFR   U,X   
F44D   8D 57                  BSR   absx   ; |b|
F44F   8D 5B                  BSR   udiv   ; NOS = q, TOS = r
F451   30 42                  LEAX   2,U   
F453   6D E0                  TST   ,S+   
F455   2A 02                  BPL   dv1   
F457   8D 46                  BSR   negx   ; q's sign
F459   6D E0        DV1:      TST   ,S+   
F45B   2A 48                  BPL   ng9   
F45D   20 3E                  BRA   negt   ; r's sign
F45F                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
F45F                             ; 60h to 7Eh is one of the escapes at pesc; "/" plus any other character
F45F                             ; clears that character"s bit 6 (/M is CR, /? is DEL"s "?"; "/" and """ have
F45F                             ; no bit 6, so // and /" give themselves). The address comes off the stack
F45F                             ; first, and Y walks the string (the IP waits on S), so that /~ finds its
F45F                             ; row and column on top, and an escape may use A, B, X and the routines.
F45F                             ; Checked: a NUL (not one escaped by "/") stops with Q, the string's
F45F                             ; address put back on the stack (from PSAV) over what any /~ left.
F45F   34 20        H_PRINT:   PSHS   Y   
F461   37 20                  PULU   Y   
F463                          IF   CHECKED   
F463   10 9F 3C               STY   <PSAV   
F466                          ENDIF      
F466   A6 A0        PR0:      LDA   ,Y+   
F468                          IF   CHECKED   
F468   27 1E                  BEQ   prq   
F46A                          ENDIF      
F46A   81 22                  CMPA   #22h   
F46C   27 18                  BEQ   pr9   
F46E   81 2F                  CMPA   #"/"   
F470   26 10                  BNE   pr1   
F472   A6 A0                  LDA   ,Y+   
F474   80 60                  SUBA   #60h   ; ` 0, a-z 1-26, 00bbIDI3LCB8IDI4LCA= 29, ~ 30
F476   81 1F                  CMPA   #1Fh   
F478   24 04                  BHS   pr2   
F47A   8D 59                  BSR   pesc   
F47C   20 E8                  BRA   pr0   
F47E   8B 60        PR2:      ADDA   #60h   ; any other: bit 6 goes
F480   84 BF                  ANDA   #0BFh   
F482   8D B2        PR1:      BSR   putc   
F484   20 E0                  BRA   pr0   
F486   35 A0        PR9:      PULS   Y,PC   
F488                          IF   CHECKED   
F488   9E 3C        PRQ:      LDX   <PSAV   
F48A   36 10                  PSHU   X   
F48C   7E F3 49               JMP   e_quote   
F48F                          ENDIF      
F48F                             ; "-", checked build (see the unchecked one, before "!").
F48F                          IF   CHECKED   
F48F   BD F0 B9     H_SUB:    JSR   isdig   
F492   25 06                  BLO   negnum   
F494   EC 42                  LDD   2,U   
F496   A3 C1                  SUBD   ,U++   
F498   20 38                  BRA   ud3   ; (STD ,U / RTS)
F49A                          ENDIF      
F49A   BD F0 C0     NEGNUM:   JSR   rdnum   ; a negative literal: read it, then negate
F49D   1F 31        NEGT:     TFR   U,X   
F49F   4F           NEGX:     CLRA      ; negx: negate the cell at X
F4A0   5F                     CLRB      
F4A1   A3 84                  SUBD   ,X   
F4A3   ED 84                  STD   ,X   
F4A5   39           NG9:      RTS      
F4A6   6D 84        ABSX:     TST   ,X   ; absx: negate the cell at X if negative
F4A8   2A FB                  BPL   ng9   
F4AA   20 F3                  BRA   negx   
F4AC                             ; udiv: unsigned divide, in place. The dividend is the NOS cell and the
F4AC                             ; divisor the TOS cell, both <= 8000h; the NOS cell becomes the quotient and
F4AC                             ; the TOS cell the remainder. The remainder is built in D (always < the
F4AC                             ; divisor, so 2R+1 fits in 16 bits).
F4AC                             ; Dividing by 2 is one shift (the spec wants that fast).
F4AC   EC C4        UDIV:     LDD   ,U   
F4AE   83 00 02               SUBD   #2   
F4B1   26 07                  BNE   ud0   
F4B3   64 42                  LSR   2,U   
F4B5   66 43                  ROR   3,U   ; the quotient
F4B7   59                     ROLB      ; the remainder: the bit that fell out (D was 0)
F4B8   20 18                  BRA   ud3   
F4BA   8E 00 10     UD0:      LDX   #16   
F4BD   4F                     CLRA      
F4BE   5F                     CLRB      
F4BF   68 43        UD1:      ASL   3,U   
F4C1   69 42                  ROL   2,U   ; the dividend's top bit ...
F4C3   59                     ROLB      
F4C4   49                     ROLA      ; ... into the remainder
F4C5   10 A3 C4               CMPD   ,U   
F4C8   25 04                  BLO   ud2   
F4CA   A3 C4                  SUBD   ,U   
F4CC   6C 43                  INC   3,U   ; a quotient bit
F4CE   30 1F        UD2:      LEAX   -1,X   
F4D0   26 ED                  BNE   ud1   
F4D2   ED C4        UD3:      STD   ,U   
F4D4   39                     RTS      
F4D5                             ; pesc: the escapes of "$". A = the character after the "/", minus 60h
F4D5                             ; (0 to 30); Y points past it. Each returns to the loop with an RTS, its
F4D5                             ; own or that of the routine it ends by jumping to. A, B and X are free.
F4D5                             ;    /a-/z   print the variable, as "#" does
F4D5                             ;    /{      clear the screen, the cursor to the top left
F4D5                             ;    /}      clear from the cursor to the end of the line
F4D5                             ;    /|  /`  show the cursor, hide it
F4D5                             ;    /~      ( row col -- ) the cursor to that row and column, from 0
F4D5   81 1B        PESC:     CMPA   #27   
F4D7   24 0F                  BHS   pcon   
F4D9   48                     ASLA      ; (` leaves A = 0: hide)
F4DA   27 18                  BEQ   phide   
F4DC   8E 82 3E               LDX   #LET+40h-2   ; the variable's cell (little-endian)
F4DF   EC 86                  LDD   A,X   
F4E1   1E 89                  EXG   A,B   
F4E3   36 06                  PSHU   D   
F4E5   7E F4 14               JMP   h_num   
F4E8                          IF   1-ANSI   
F4E8   10 27 0A 20  PCON:     LBEQ   CONCLS   ; /{
F4EC   81 1D                  CMPA   #29   
F4EE   10 27 0A 1D            LBEQ   CONEOL   ; /}
F4F2   22 03                  BHI   pat   
F4F4   7E FF 12     PHIDE:    JMP   CONCUR   ; /|  (A = 28: show), /`  (A = 0: hide)
F4F7                          ENDIF      
F4F7                PAT:         
F4F7                          IF   CHECKED   
F4F7                             ; /~ checks first that there are a row and a column (with less it
F4F7                             ; is s, and the stack counts as empty): U is never let past the
F4F7                             ; top of the stack, however many /~ there are.
F4F7   11 83 81 F8            CMPU   #DSTOP-4   
F4FB   10 22 FB 8C            LBHI   e_ds   ; (N is clear: an underflow)
F4FF                          ENDIF      
F4FF                          IF   1-ANSI   
F4FF   37 16                  PULU   D,X   ; /~  D = the column, X = the row
F501   7E FF 15               JMP   CONAT   
F504                          ENDIF      
F504                          IF   ANSI   
                                 ; /~  ESC [ row+1 ; col+1 H (ANSI counts from 1)
                              PULU   D,X   ; D = the column, X = the row
                              ADDD   #1   
                              LEAX   1,X   
                              PSHU   D   
                              PSHU   X   
                              BSR   csi   
                              JSR   pdec   
                              BSR   pm   
                              FCB   ";"+80h   
                              JSR   pdec   
                              BSR   pm   
                              FCB   "H"+80h   
                              RTS      
                    PCON:     BEQ   pcls   ; /{
                              CMPA   #29   
                              BEQ   peol   ; /}
                              BHI   pat   
                              BSR   pcsi   ; /|  ESC [ ? 2 5 h
                              FCB   "?25","h"+80h   
                              RTS      
                    PHIDE:    BSR   pcsi   ; /`  ESC [ ? 2 5 l
                              FCB   "?25","l"+80h   
                              RTS      
                    PCLS:     BSR   pcsi   ; /{  ESC [ H ESC [ J
                              FCB   "H"+80h   
                              BSR   pcsi   
                              FCB   "J"+80h   
                              RTS      
                    PEOL:     BSR   pcsi   ; /}  ESC [ K
                              FCB   "K"+80h   
                              RTS      
                                 ; pcsi: ESC [ and then the text after the call, as pmsg. csi: ESC [.
                    CSI:      BSR   pm   
                              FCB   27,"["+80h   
                              RTS      
                    PCSI:     BSR   csi   
F504                          ENDIF      
F504                          IF   ANSI*(1-CHECKED)   
                                 ; pmsg: print the text after the call, up to and including the character
                                 ; that has bit 7 set (it is printed without it), then return after it.
                                 ; (The checked build has its own, with the report: pm leads to it.)
                    PM:          
                    PMSG:     PULS   X   
                    PM1:      LDA   ,X   
                              ANDA   #7Fh   
                              JSR   CONOUT   
                              TST   ,X+   
                              BPL   pm1   
                              JMP   ,X   
F504                          ENDIF      
F504                          IF   ANSI*CHECKED   
                    PM:       JMP   pmsg   
F504                          ENDIF      
F504                IMGEND:      


