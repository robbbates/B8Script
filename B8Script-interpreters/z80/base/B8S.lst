0739                          IF   CPM   
0739                             ; RAM pages, after the image
0739                CPAGE:    EQU   (imgend + 255) / 256   ; the skip cache (QK builds), first, so
0739                RSPAGE:   EQU   CPAGE + QK   ;   that the letter page is still the one
0739                DSPAGE:   EQU   RSPAGE + 1   ;   just below the program text
0739                LETPAGE:   EQU   RSPAGE + 2   
0739                PROG:     EQU   LETPAGE*256 + 256   
0739                          ENDIF      
0739                IMGEND:      


