0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Intel 8080
0000                             ;  Spec: docs/b8script.md (2026-11-24).
0000                             ;  Design follows the Z80 interpreter (z80/b8s-z80.asm), with 8080 opcodes
0000                             ;  only.
0000                             ; 
0000                             ;  Three switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    CHECKED  0 = no checks (spec: the programmer is responsible)
0000                             ;             1 = starts with every variable at 0 and every word undefined,
0000                             ;                 and stops on every error in the spec's table (and Ctrl-C)
0000                             ;                 with a four-line report: the letter and the place as line
0000                             ;                 and column, the text there, and both stacks. See `error`.
0000                             ;    ANSI     what the console escapes of "$" (/00bbIC8= /| /` /~) do:
0000                             ;             1 = send ANSI (VT100) sequences through CONOUT
0000                             ;             0 = call the machine's own routines CONCLS, CONEOL, CONCUR and
0000                             ;                 CONAT (see the equates). The CP/M builds always send ANSI.
0000                             ; 
0000                             ;  In every build Ctrl-C stops a running program (an unchecked build stops
0000                             ;  without a word): see the console layer for the rules, the held key and
0000                             ;  the break-off cell.
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), I8080 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   1   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   1   ; 1 = checked build
0000                ANSI:     EQU   0   ; 1 = the console escapes send ANSI sequences
0000                ANS:      EQU   ANSI+CPM-ANSI*CPM   ; (CP/M: always ANSI)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the 8080"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  The return stack pointer has no register (the 8080 has no spare pair): it
0000                             ;  is the RAM word RSP. Only rpop, rpushd and ")" (and the checks) touch it.
0000                             ; 
0000                             ;  One-byte calls. The routines used most are reached with RST, one byte
0000                             ;  instead of three. (asm80 wants the vector number: RST 1 = RST 08h.)
0000                             ; 
0000                             ;    RST 1  08h  rpop    pop the return stack into HL
0000                             ;    RST 3  18h  drop    drop TOS, then next character     (ends a handler)
0000                             ;    RST 4  20h  neg16   HL = -HL
0000                             ;    RST 5  28h  putc    print A
0000                             ;    RST 6  30h  next    next character                    (ends a handler)
0000                             ; 
0000                             ;  RST 3 and RST 6 never return: an RST is a CALL, so the first thing each
0000                             ;  of them does is POP D to throw the return address away.
0000                             ; 
0000                             ;  The CP/M build can't own page zero, so the block from `vecs` to `vecend`
0000                             ;  (image addresses 0108h-0133h) is copied to 0008h-0033h when it starts. The
0000                             ;  code in that block has no jumps inside itself, so it works at either place.
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; 
0000                             ;  What the 8080 lacks, and what replaces it: no JR (JMP/Jcc), no DJNZ, no
0000                             ;  SBC HL (byte-wise SUB/SBB, or negate and DAD), no shifts on register pairs
0000                             ;  (DAD H doubles; RAL/RAR through A), no LDIR/CPIR (small loops).
0000                             ; -----------------------------------------------------------------------------
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (the top four bytes of the page are spare,
0000                             ;             so a full stack runs two bytes into the page below)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch, interpreter variables in the gaps, and the -n? line buffer
0000                             ;             at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack has a guard band: the data stack can
0000                             ;  overrun by a cell or two (and the calls made while it is full, the error
0000                             ;  report's included) into the top 32 bytes of the return-stack page, which
0000                             ;  are never used, and the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
0000                BDOS:     EQU   0005h   
0000                EXIT:     EQU   0000h   ; warm boot
0000                BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IFN   CPM   
                                 ; ---- generic machine: edit these to suit -----------------------------------
                    KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
                                 ;   waiting. The zero flag must match A
                                 ;   (end the routine with ORA A / RET).
                    CONOUT:   EQU   0FF03h   ; print the character in A
                    EXIT:     EQU   0FF09h   ; where to go when the program ends
                                 ;   KEY and CONOUT must preserve BC, DE and HL.
0000                          ENDIF      
0000                          IF   1-ANS   
                                 ; With ANSI = 0 the console escapes call these. All four must keep BC, and
                                 ; all but CONAT also HL. They may change A, DE and the flags.
                    CONCLS:   EQU   0FF0Ch   ; /{  clear the screen, the cursor to the top left
                    CONEOL:   EQU   0FF0Fh   ; /}  clear from the cursor to the end of the line
                    CONCUR:   EQU   0FF12h   ; /| and /`  show the cursor if A is not 0, hide
                                 ;     it if A = 0
                    CONAT:    EQU   0FF15h   ; /~  the cursor to row HL, column DE, both
                                 ;     counted from 0. May change A, DE and HL
0000                          ENDIF      
0000                          IFN   CPM   
                    RSPAGE:   EQU   80h   ; 8000h return stack
                    DSPAGE:   EQU   81h   ; 8100h data stack
                    LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
                    PROG:     EQU   8300h   ; where the loader puts the program text
                    HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
                    BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms (1-255;
0000                             ; the wait for a second Ctrl-C uses it too):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer
0000                RSP:      EQU   LET+34h   ; gap after Z: the return stack pointer;
0000                BRKCNT:   EQU   LET+36h   ;   the break check's countdown;
0000                NPEND:    EQU   LET+38h   ;   minus the address of the program's end
0000                             ;   (the heap"s first byte), for the checked "_';
0000                PSAVE:    EQU   LET+3Ah   ;   the checked build: the address "$" prints
0000                             ;   from, for a report
0000                KEYBUF:   EQU   LET+7Ah   ; gap after z: a key read by the break check and
0000                             ;   held for the next "?" (0: none);
0000                BRKOFF:   EQU   LET+7Bh   ;   the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FCh   ; empty data stack. The four bytes above it
0000                             ; are spare: a character can pop two cells
0000                             ; too many before the checked build sees it,
0000                             ; and the next call must not land on the
0000                             ; letter cells.
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is the start of the .COM file, and 0108h-0133h is also copied to
0000                             ;  page zero (see the header).
0000                             ; =============================================================================
0100                          .ORG   BASE   
0100                          IF   1-(1-CPM)*CHECKED   
0100   31 FC 08               LXI   SP,DSTOP   ; 00  reset, or the start of the .COM file
0103                          ENDIF      
0103   C3 9C 06               JMP   start   ; In the checked generic build this is at 0000h
0106                             ;   (and `start` sets SP): its first byte, C3h,
0106                             ;   is what an undefined word runs into, as
0106                             ;   CP/M's own JMP at 0000h is in a .COM: e_hi.
0106                          IF   (1-CPM)*CHECKED   
                              DB   0,0,0   ; 03  spare
0106                          ENDIF      
0106   CF           RDROP:    RST   1   ; 06  drop the top of the return stack, then
0107   DF                     RST   3   ;     drop TOS (a spent flag) and go on
0108                VECS:        
0108                             ; ---- RST 1: rpop: pop the return stack into HL (DE is lost) -----------------
0108   2A 34 09     RPOP:     LHLD   RSP   ; 08
010B   5E                     MOV   E,M   
010C   23                     INX   H   
010D   56                     MOV   D,M   
010E   23                     INX   H   
010F   22 34 09               SHLD   RSP   
0112   EB                     XCHG      
0113   C9                     RET      ; 13  (so RST 2 is not used)
0114   EB           H_TOR:    XCHG      ; 14  "{" TOS to the return stack; rpushd
0115   C3 B7 01               JMP   rpushd   ;     brings up the new TOS
0118                             ; ---- RST 3: drop TOS, then next ---------------------------------------------
0118   D1           RST18:    POP   D   ; 18  discard the RST's return address
0119   E1                     POP   H   ;     new TOS = NOS
011A   C3 34 01               JMP   next0   
011D   E5           H_FROMR:   PUSH   H   ; 1D  "}" return stack to TOS
011E   CF                     RST   1   
011F   F7                     RST   6   
0120                             ; ---- RST 4: neg16: HL = -HL (keeps BC, DE) ----------------------------------
0120   AF           NEG16:    XRA   A   ; 20
0121   95                     SUB   L   
0122   6F                     MOV   L,A   
0123   9F                     SBB   A   
0124   94                     SUB   H   
0125   67                     MOV   H,A   
0126   C9                     RET      
0127   E9           JPHL:     PCHL      ; 27  (for the machine-code call)
0128                             ; ---- RST 5: putc: print A (keeps BC, DE, HL) --------------------------------
0128                RST28:       
0128                          IFN   CPM   
                    PUTC:     JMP   CONOUT   ; 28
0128                          ENDIF      
0128                          IF   CPM   
0128   C3 F2 04               JMP   putc   ; 28
012B                          ENDIF      
012B                             ; exec: "`" with no hex digit after it: call the machine code at TOS. It
012B                             ; returns here, with its top cell on the stack: that becomes the new TOS.
012B   CD 27 01     EXEC:     CALL   jphl   ; 2B
012E   E1                     POP   H   
012F   F7                     RST   6   
0130                             ; ---- RST 6: next character --------------------------------------------------
0130   D1           RST30:    POP   D   ; 30  discard the RST's return address
0131                          IF   CPM   
0131   C3 34 01               JMP   next0   ; (this copy runs in page zero)
0134                          ENDIF      
0134                VECEND:      
0134                             ; =============================================================================
0134                             ;  The inner loop: read one character and sort it by range.
0134                             ; 
0134                             ;    00h          end of program
0134                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0134                             ;    30h-39h      digit: read a whole number
0134                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0134                             ;    61h-7Ah      a-z: push the address of that letter's cell
0134                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0134                             ; =============================================================================
0134                NEXT0:       
0134                          IF   CHECKED   
0134   CD 63 05               CALL   chkstk   ; both stacks are checked once per character
0137                          ENDIF      
0137   0A                     LDAX   B   
0138   03                     INX   B   
0139   D6 21                  SUI   21h   ; A = c - 21h
013B   DA 7E 01               JC   ctl   ; c < 21h: NUL ends, the rest are ignored
013E   FE 0F                  CPI   0Fh   
0140   DA 6E 01               JC   punct   ; 21h-2Fh: PTAB index 0-14
0143   D6 0F                  SUI   0Fh   ; A = c - 30h
0145   FE 0A                  CPI   0Ah   
0147   DA 59 03               JC   digit   ; 30h-39h
014A   FE 11                  CPI   11h   
014C   DA 6C 01               JC   p3a   ; 3Ah-40h
014F   D6 11                  SUI   11h   ; A = c - 41h
0151   FE 1A                  CPI   1Ah   
0153   DA AD 01               JC   upper   ; 41h-5Ah: A = letter index 0-25
0156   FE 20                  CPI   20h   
0158   DA 6A 01               JC   p5b   ; 5Bh-60h
015B   FE 3A                  CPI   3Ah   
015D   DA A7 01               JC   lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0160   FE 3E                  CPI   3Eh   
0162                          IF   CHECKED   
0162   CA 34 01               JZ   next0   ; 7Fh, DEL: ignored
0165   D2 9A 05               JNC   e_hi   ; 80h-FFh: reserved
0168                          ENDIF      
0168                          IF   1-CHECKED   
                              JNC   next0   ; 7Fh-FFh: ignored
0168                          ENDIF      
0168   D6 1A                  SUI   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
016A   D6 09        P5B:      SUI   9   ; 5Bh-60h: -4 in all, index 22-27
016C   C6 05        P3A:      ADI   5   ; 3Ah-40h: index 15-21
016E                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
016E                             ; untouched, and A, DE free.
016E   C6 39        PUNCT:    ADI   PTAB & 0FFh   ; PTAB never crosses a page
0170   5F                     MOV   E,A   
0171   16 03                  MVI   D,PTAB / 256   
0173   FE 4F                  CPI   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
0175   1A                     LDAX   D   
0176   5F                     MOV   E,A   ; the handler's low byte
0177                          IFN   CPM   
                              MVI   A,0   
                              RAL      ; its page: 0 + carry
0177                          ENDIF      
0177                          IF   CPM   
0177   3E 01                  MVI   A,1   
0179   CE 00                  ACI   0   ; its page: 1 + carry
017B                          ENDIF      
017B   57                     MOV   D,A   
017C   D5                     PUSH   D   ; jump to it; the stack is balanced again
017D   C9                     RET      ;   when the handler starts
017E                             ; ctl: characters below 21h. A = c - 21h.
017E   C6 21        CTL:      ADI   21h   ; back to c; zero only for NUL
0180   C2 34 01               JNZ   next0   ; the rest are ignored
0183   C3 00 00     ENDPROG:   JMP   EXIT   ; the program has ended
0186                             ; =============================================================================
0186                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
0186                             ;  (00bbIGFuZCA= are up among the RST routines.)
0186                             ; =============================================================================
0186   D1           H_XOR:    POP   D   
0187   7C                     MOV   A,H   
0188   AA                     XRA   D   
0189   67                     MOV   H,A   
018A   7D                     MOV   A,L   
018B   AB                     XRA   E   
018C   6F                     MOV   L,A   
018D   F7                     RST   6   
018E   D1           H_OR:     POP   D   
018F   7C                     MOV   A,H   
0190   B2                     ORA   D   
0191   67                     MOV   H,A   
0192   7D                     MOV   A,L   
0193   B3                     ORA   E   
0194   6F                     MOV   L,A   
0195   F7                     RST   6   
0196   E7           H_NOT:    RST   4   ; ~x = -x - 1
0197   2B                     DCX   H   
0198   F7                     RST   6   
0199                             ; "_" ( n -- addr ): the heap pointer moves by n, a signed count (the add is
0199                             ; the same either way); TOS is the old pointer.
0199   EB           H_ALLOC:   XCHG      
019A   2A 7C 09               LHLD   HEAP   
019D   E5                     PUSH   H   
019E   19                     DAD   D   ; the new top
019F                          IF   CHECKED   
019F   CD 00 05               CALL   chkhp   
01A2                          ENDIF      
01A2   22 7C 09               SHLD   HEAP   
01A5   E1                     POP   H   
01A6   F7                     RST   6   
01A7                             ; ---- the letters and digits --------------------------------------------------
01A7                             ; a-z: push the cell's address (the cell is the variable)
01A7   E5           LOWER:    PUSH   H   
01A8   87                     ADD   A   
01A9   6F                     MOV   L,A   
01AA   26 09                  MVI   H,LETPAGE   
01AC   F7                     RST   6   
01AD                             ; A-Z: call the word. The return address (the IP after the letter) goes on
01AD                             ; the return stack, and the IP becomes the address in the letter's cell.
01AD   E5           UPPER:    PUSH   H   ; keep TOS: rpushd pops it back
01AE   87                     ADD   A   
01AF   6F                     MOV   L,A   
01B0   26 09                  MVI   H,LETPAGE   ; HL -> cell
01B2   50                     MOV   D,B   
01B3   59                     MOV   E,C   ; DE = the return address
01B4   4E                     MOV   C,M   
01B5   23                     INX   H   
01B6   46                     MOV   B,M   ; IP = the word's body, and fall into rpushd
01B7                             ; rpushd: push DE on the return stack, then pop TOS off the data stack and
01B7                             ; go on. Every push of the return stack ends here: for a word call the cell
01B7                             ; popped is the TOS that upper parked; for "(" and "{" it is the cell under
01B7                             ; the one that was used up.
01B7                             ; 
01B7                             ; The break key is looked at here, so at every word call and loop-back (and
01B7                             ; block entry and "{"), but only one time in 256: BRKCNT counts them. Reading
01B7                             ; the keyboard can be slow (it is a BDOS call under CP/M).
01B7   2A 34 09     RPUSHD:   LHLD   RSP   
01BA   2B                     DCX   H   
01BB   72                     MOV   M,D   
01BC   2B                     DCX   H   
01BD   73                     MOV   M,E   
01BE   22 34 09               SHLD   RSP   
01C1   21 36 09               LXI   H,BRKCNT   
01C4   35                     DCR   M   
01C5   E1                     POP   H   ; (keeps the flags)
01C6   CC AD 04               CZ   pollk   
01C9   F7                     RST   6   
01CA                             ; ---- machine code: the grave -----------------------------------------------
01CA                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
01CA                             ; are stored from addr until a non-hex character; then a RET (C9h) is
01CA                             ; written and its address is left. An odd last digit is consumed and dropped.
01CA                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
01CA                             ; code is entered by CALL with the data stack above the return address; it
01CA                             ; must keep BC, and on return the top cell becomes the new TOS.
01CA   CD 9A 04     H_GRAVE:   CALL   hexc   
01CD   D2 2B 01               JNC   exec   
01D0   87           HX1:      ADD   A   
01D1   87                     ADD   A   
01D2   87                     ADD   A   
01D3   87                     ADD   A   
01D4   57                     MOV   D,A   ; the high digit
01D5   CD 9A 04               CALL   hexc   
01D8   D2 E4 01               JNC   hx2   ; odd digit: consumed and dropped
01DB   B2                     ORA   D   
01DC   77                     MOV   M,A   
01DD   23                     INX   H   
01DE   CD 9A 04               CALL   hexc   
01E1   DA D0 01               JC   hx1   
01E4   36 C9        HX2:      MVI   M,0C9h   ; (never range-checked: the spec says so)
01E6   F7                     RST   6   
01E7                             ; ---- where the two pages meet ----------------------------------------------
01E7                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
01E7                             ; are in falling code order for this), and where exactly differs between the
01E7                             ; builds: NPG1 follows. Every handler below these four must start in the
01E7                             ; second page, and every one above in the first; chktab.py checks both.
01E7                             ; "]" returns: pop an address and jump to it. TOS is parked on the stack
01E7                             ; while rpop uses HL, and the drop at the end brings it back.
01E7   E5           H_RET:    PUSH   H   
01E8   CF           RET2:     RST   1   
01E9   44                     MOV   B,H   
01EA   4D                     MOV   C,L   
01EB   DF                     RST   3   
01EC                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
01EC                             ; drops the block start, "]" returns. No closer at all ends the program.
01EC                             ; The flag stays in HL as the spent cell that rdrop and ret2 drop.
01EC   7C           H_BREAK:   MOV   A,H   
01ED   B5                     ORA   L   
01EE   CA DA 02               JZ   h_drop   ; false: just drop the flag
01F1   CD 43 04               CALL   skip   
01F4   B7                     ORA   A   ; skip returns 0 for ")"
01F5   C2 E8 01               JNZ   ret2   
01F8   C3 06 01               JMP   rdrop   
01FB                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
01FB                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
01FB                             ; the body"s address instead. Either way it then skips to the matching "]'.
01FB                             ; (The unchecked build takes anything that is not a letter as the space; the
01FB                             ; checked build stops on it.)
01FB   0A           H_DEF:    LDAX   B   
01FC   03                     INX   B   
01FD   D6 41                  SUI   "A"   ; a letter gives 0-25 or 32-57: lowercase
01FF   5F                     MOV   E,A   ;   lands 64 bytes up
0200   E6 DF                  ANI   0DFh   ; fold case
0202   FE 1A                  CPI   26   
0204   D2 14 02               JNC   def2   ; not a letter
0207   7B                     MOV   A,E   
0208   87                     ADD   A   
0209   5F                     MOV   E,A   
020A   16 09                  MVI   D,LETPAGE   ; DE -> cell
020C   79                     MOV   A,C   
020D   12                     STAX   D   
020E   1C                     INR   E   
020F   78                     MOV   A,B   
0210   12                     STAX   D   
0211   C3 1D 02               JMP   skipnx   
0214                DEF2:        
0214                          IF   CHECKED   
0214   7B                     MOV   A,E   
0215   FE DF                  CPI   " "-"A"+256   
0217   C2 BE 05               JNZ   e_brack   ; anything but a letter or a space
021A                          ENDIF      
021A   E5                     PUSH   H   ; an anonymous block: push its address
021B   60                     MOV   H,B   
021C   69                     MOV   L,C   
021D                SKIPNX:      
021D                          IF   CHECKED   
021D   0B                     DCX   B   ; back onto the letter, so that skip finds its
021E                          ENDIF      ;   opener, the "[", just before where it starts
021E   CD 43 04     SKIPO:    CALL   skip   
0221   F7                     RST   6   
0222   5E           H_FETCH:   MOV   E,M   ; "@"
0223   23                     INX   H   
0224   56                     MOV   D,M   
0225   EB                     XCHG      
0226   F7                     RST   6   
0227                             ; =============================================================================
0227                             ;  Handlers that must start in the image's second page.
0227                             ;  "?" is the last (with "," inside it in the unchecked build), so its long
0227                             ;  tail may run past that page.
0227                             ; =============================================================================
0227                             ; ---- flow control ----------------------------------------------------------
0227                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
0227                             ; the matching ")".
0227   7C           H_OPEN:   MOV   A,H   
0228   B5                     ORA   L   
0229   E1                     POP   H   
022A   CA 1E 02               JZ   skipo   
022D   E5                     PUSH   H   ; (rpushd pops it again)
022E   50                     MOV   D,B   
022F   59                     MOV   E,C   ; the block starts at the IP
0230   C3 B7 01               JMP   rpushd   
0233                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
0233                             ; drops it and carries on.
0233   7C           H_CLOSE:   MOV   A,H   
0234   B5                     ORA   L   
0235   CA 06 01               JZ   rdrop   
0238   CF                     RST   1   ; pop the block start ...
0239   44                     MOV   B,H   
023A   4D                     MOV   C,L   ; ... jump to it ...
023B   EB                     XCHG      
023C   C3 B7 01               JMP   rpushd   ; ... and push it back (which drops the flag)
023F                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
023F                             ; "-" has two jobs: directly before a digit it starts a negative number.
023F   0A           H_SUB:    LDAX   B   
0240   D6 30                  SUI   "0"   
0242   FE 0A                  CPI   10   
0244   DA 5F 03               JC   negnum   
0247   E7                     RST   4   ; a - b = a + (-b): fall into "+"
0248   D1           H_ADD:    POP   D   
0249   19                     DAD   D   
024A   F7                     RST   6   
024B   D1           H_AND:    POP   D   
024C   7C                     MOV   A,H   
024D   A2                     ANA   D   
024E   67                     MOV   H,A   
024F   7D                     MOV   A,L   
0250   A3                     ANA   E   
0251   6F                     MOV   L,A   
0252   F7                     RST   6   
0253                             ; Signed compares. Both are "DE < HL" for the right pair: > swaps the two
0253                             ; cells first (XTHL), < doesn't. There is no overflow flag, so the signed
0253                             ; answer is the unsigned borrow of DE - HL, flipped when the signs differ.
0253                             ; SBB A turns a carry into -1 or 0 with no branch.
0253   E3           H_GT:     XTHL      ; a > b  is  b < a
0254   D1           H_LT:     POP   D   ; a < b: DE = a, HL = b
0255   7B                     MOV   A,E   
0256   95                     SUB   L   
0257   7A                     MOV   A,D   
0258   9C                     SBB   H   
0259   9F                     SBB   A   ; A = -1 if DE < HL unsigned
025A   6F                     MOV   L,A   
025B   7C                     MOV   A,H   
025C   AA                     XRA   D   
025D   17                     RAL      ; carry = the signs differ
025E   9F                     SBB   A   
025F   AD                     XRA   L   ; flip when they do
0260   67                     MOV   H,A   
0261   6F                     MOV   L,A   
0262   F7                     RST   6   
0263   D1           H_EQ:     POP   D   
0264   7D                     MOV   A,L   
0265   AB                     XRA   E   
0266   6F                     MOV   L,A   
0267   7C                     MOV   A,H   
0268   AA                     XRA   D   
0269   B5                     ORA   L   ; zero if equal
026A   D6 01                  SUI   1   ; carry only for zero
026C   9F                     SBB   A   
026D   67                     MOV   H,A   
026E   6F                     MOV   L,A   
026F   F7                     RST   6   
0270                             ; "*": shift-and-add on the multiplier's low bit, so it stops as soon as the
0270                             ; multiplier is used up; only the low 16 bits are kept.
0270   D1           H_MUL:    POP   D   ; DE = multiplicand
0271   C5                     PUSH   B   
0272   44                     MOV   B,H   
0273   4D                     MOV   C,L   ; BC = multiplier
0274   21 00 00               LXI   H,0   
0277   78           MUL1:     MOV   A,B   
0278   B7                     ORA   A   ; clear carry
0279   1F                     RAR      
027A   47                     MOV   B,A   
027B   79                     MOV   A,C   
027C   1F                     RAR      
027D   4F                     MOV   C,A   ; BC >> 1, carry = the bit shifted out
027E   D2 82 02               JNC   mul2   
0281   19                     DAD   D   
0282   EB           MUL2:     XCHG      
0283   29                     DAD   H   ; multiplicand << 1
0284   EB                     XCHG      
0285   78                     MOV   A,B   
0286   B1                     ORA   C   
0287   C2 77 02               JNZ   mul1   
028A   C1                     POP   B   
028B   F7                     RST   6   
028C                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
028C                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
028C                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
028C                             ; stops on it.
028C                H_DIV:       
028C                          IF   CHECKED   
028C   7C                     MOV   A,H   
028D   B5                     ORA   L   
028E   CA BB 05               JZ   e_zero   
0291                          ENDIF      
0291   D1                     POP   D   ; DE = a, HL = b
0292   C5                     PUSH   B   
0293   7A                     MOV   A,D   
0294   B7                     ORA   A   
0295   F5                     PUSH   PSW   ; S flag = sign of a (for r)
0296   AC                     XRA   H   
0297   F5                     PUSH   PSW   ; S flag = sign of q
0298   7C                     MOV   A,H   
0299   B7                     ORA   A   
029A   FC 20 01               CM   neg16   ; HL = |b|
029D   EB                     XCHG      
029E   7C                     MOV   A,H   
029F   B7                     ORA   A   
02A0   FC 20 01               CM   neg16   ; HL = |a|, DE = |b|
02A3   CD 7C 03               CALL   udiv   ; HL = q, BC = r
02A6   F1                     POP   PSW   
02A7   FC 20 01               CM   neg16   ; q's sign
02AA   EB                     XCHG      ; DE = q
02AB   60                     MOV   H,B   
02AC   69                     MOV   L,C   ; HL = r
02AD   F1                     POP   PSW   
02AE   FC 20 01               CM   neg16   ; r's sign
02B1   C1                     POP   B   
02B2   D5                     PUSH   D   ; q under r
02B3   F7                     RST   6   
02B4                             ; ---- stack and storage -----------------------------------------------------
02B4   E5           H_DUP:    PUSH   H   ; ":"
02B5   F7                     RST   6   
02B6   E3           H_SWAP:   XTHL      ; "%"
02B7   F7                     RST   6   
02B8                             ; (The checked build tests the address before it takes the value off the
02B8                             ; stack, so that an error report shows both.)
02B8                H_STORE:      ; "!" ( n addr -- )
02B8                          IF   CHECKED   
02B8   CD 20 05               CALL   chkst   
02BB                          ENDIF      
02BB   D1                     POP   D   
02BC   73                     MOV   M,E   
02BD   23                     INX   H   
02BE   72                     MOV   M,D   
02BF   DF                     RST   3   
02C0                H_CSTORE:      ; "." ( c addr -- )
02C0                          IF   CHECKED   
02C0   CD 20 05               CALL   chkst   
02C3                          ENDIF      
02C3   D1                     POP   D   
02C4   73                     MOV   M,E   
02C5   DF                     RST   3   
02C6                             ; ---- console ---------------------------------------------------------------
02C6                             ; 22h pushes the address of the text after it and skips the string.
02C6   E5           H_STR:    PUSH   H   
02C7   60                     MOV   H,B   
02C8   69                     MOV   L,C   
02C9   CD 87 04               CALL   skipstr   
02CC                          IF   CHECKED   
02CC   B7                     ORA   A   ; 0: the text ran out before the closing quote
02CD   CA B3 05               JZ   e_quote   
02D0                          ENDIF      
02D0   F7                     RST   6   
02D1                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
02D1                             ; 60h to 7Eh is one of the escapes at pesc; "/" plus any other character
02D1                             ; clears that character"s bit 6 (/M is CR, and / then DEL gives "?"; "/',
02D1                             ; '"' and '?' have no bit 6, so //, /" and /? give themselves).
02D1                          IF   1-CHECKED   
                    H_PRINT:   MOV   A,M   
                              INX   H   
                              CPI   22h   
                              JZ   h_drop   
                              CPI   "/"   
                              JNZ   pr1   
                              MOV   A,M   
                              INX   H   
                              CPI   60h   
                              JC   pr0   
                              CPI   7Fh   
                              JC   pesc   
                    PR0:      ANI   0BFh   
                    PR1:      RST   5   
                              JMP   h_print   
                    PRLOOP:   EQU   h_print   ; (where the escapes go back to)
                    PRAGAIN:   EQU   h_print   ; (and where /~ goes back to)
02D1                          ENDIF      
02D1                          IF   CHECKED   
02D1                             ; (The checked build has the loop as a routine, prstr, which the error
02D1                             ; report uses too. The address is kept meanwhile, for a report: it shows
02D1                             ; the stack as it was before the "$". /~ comes back to hp1.)
02D1   22 3A 09     H_PRINT:   SHLD   PSAVE   
02D4   CD 37 05     HP1:      CALL   prstr   
02D7   DF                     RST   3   
02D8                          ENDIF      
02D8   7D           H_EMIT:   MOV   A,L   ; "'"
02D9   EF                     RST   5   
02DA   DF           H_DROP:   RST   3   ; ";" is this one byte
02DB                             ; "#" prints TOS as a signed decimal number, with no space after it.
02DB   C5           H_NUM:    PUSH   B   
02DC   CD AE 03               CALL   psgn   
02DF   C1                     POP   B   
02E0   DF                     RST   3   
02E1                          IF   CHECKED   ; (the checked build has no room to start ","
02E1   6E           H_CFETCH:   MOV   L,M   ;   as late as the unchecked one does: see
02E2   26 00                  MVI   H,0   ;   the end of "?")
02E4   F7                     RST   6   
02E5                          ENDIF      
02E5                             ; "?" ( n -- c ) or ( -n -- addr )
02E5                             ;   n > 0: wait about n ms for a key; 0 if none came
02E5                             ;   n = 0: wait for a key
02E5                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
02E5                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
02E5   7C           H_KEY:    MOV   A,H   
02E6   B7                     ORA   A   
02E7   FA 05 03               JM   line   
02EA   1E 28        KT1:      MVI   E,MSLOOP   ; one millisecond, roughly
02EC   CD DF 04     KT2:      CALL   getk   
02EF   C2 01 03               JNZ   kt3   
02F2   1D                     DCR   E   
02F3   C2 EC 02               JNZ   kt2   
02F6   7C                     MOV   A,H   ; 0? never counts down: it waits
02F7   B5                     ORA   L   
02F8   CA EA 02               JZ   kt1   
02FB   2B                     DCX   H   
02FC   7C                     MOV   A,H   
02FD   B5                     ORA   L   
02FE   C2 EA 02               JNZ   kt1   ; A = 0 if the time ran out
0301                          IF   1-CHECKED   
                              DB   0FEh   ; (CPI: steps over the one byte of ",")
                    H_CFETCH:   MOV   A,M   ; "," shares "?"s ending: A becomes TOS
0301                          ENDIF      
0301   6F           KT3:      MOV   L,A   
0302   26 00                  MVI   H,0   
0304   F7                     RST   6   
0305                             ; Backspace takes the last character back (and is echoed as
0305                             ; it is), CR ends (stored, not echoed), every other key is stored and
0305                             ; echoed until the line is full. The line buffer starts at offset 80h
0305                             ; of its page, so L alone is the place in the line: D holds the L of
0305                             ; a full line.
0305   11 7F 00     LINE:     LXI   D,127   ; TOS is minus the count: adding 127 carries
0308   19                     DAD   D   ;   only for 1 to 127, and leaves 127 - count
0309   9F                     SBB   A   
030A   A5                     ANA   L   ; (0 for a count that is too big)
030B   2F                     CMA      
030C   57                     MOV   D,A   ; D = the L of a full line: 80h + count, FFh
030D                             ;   at most
030D   21 80 09               LXI   H,LINEBUF   
0310   CD DF 04     LN2:      CALL   getk   
0313   CA 10 03               JZ   ln2   
0316   FE 0D                  CPI   13   
0318   CA 35 03               JZ   ln5   
031B   FE 08                  CPI   8   
031D   CA 2D 03               JZ   ln4   
0320   5F                     MOV   E,A   
0321   7D                     MOV   A,L   
0322   BA                     CMP   D   
0323   CA 10 03               JZ   ln2   ; full
0326   73                     MOV   M,E   
0327   2C                     INR   L   
0328   7B                     MOV   A,E   
0329   EF           LN3:      RST   5   
032A   C3 10 03               JMP   ln2   
032D   2D           LN4:      DCR   L   ; Backspace: one back, and echo it,
032E   FA 29 03               JM   ln3   ;   unless the line was empty (L left the
0331   2C                     INR   L   ;   upper half of the page)
0332   C3 10 03               JMP   ln2   
0335   77           LN5:      MOV   M,A   ; the CR
0336   2E 80                  MVI   L,LINEBUF & 0FFh   
0338   F7                     RST   6   
0339                             ; =============================================================================
0339                             ;  Dispatch table: the low byte of each handler's address, in code order.
0339                             ;  It must not cross a page (the dispatcher only adds to its low byte).
0339                             ; =============================================================================
0339                             ; The handlers of the first NPG1 characters start in the image's second page.
0339                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
0339                             ; differs between the builds, so the count is worked out here.
0339                             ; (One division to a line: asm80 only rounds down when it stores a value.)
0339                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
0339                PGBRK:    EQU   (h_break-BASE)/256   
0339                PGDEF:    EQU   (h_def-BASE)/256   
0339                PGFET:    EQU   (h_fetch-BASE)/256   
0339                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
0339   B8           PTAB:     DB   h_store & 0FFh   ; !
033A   C6                     DB   h_str & 0FFh   ; "
033B   DB                     DB   h_num & 0FFh   ; #
033C   D1                     DB   h_print & 0FFh   ; $
033D   B6                     DB   h_swap & 0FFh   ; %
033E   4B                     DB   h_and & 0FFh   ; &
033F   D8                     DB   h_emit & 0FFh   ; '
0340   27                     DB   h_open & 0FFh   ; (
0341   33                     DB   h_close & 0FFh   ; )
0342   70                     DB   h_mul & 0FFh   ; *
0343   48                     DB   h_add & 0FFh   ; +
0344   E1                     DB   h_cfetch & 0FFh   ; ,
0345   3F                     DB   h_sub & 0FFh   ; -
0346   C0                     DB   h_cstore & 0FFh   ; .
0347   8C                     DB   h_div & 0FFh   ; /
0348   B4                     DB   h_dup & 0FFh   ; :
0349   DA                     DB   h_drop & 0FFh   ; ;
034A   54                     DB   h_lt & 0FFh   ; <
034B   63                     DB   h_eq & 0FFh   ; =
034C   53                     DB   h_gt & 0FFh   ; >
034D   E5                     DB   h_key & 0FFh   ; ?
034E   22                     DB   h_fetch & 0FFh   ; @
034F   FB                     DB   h_def & 0FFh   ; [
0350   EC                     DB   h_break & 0FFh   ; \
0351   E7                     DB   h_ret & 0FFh   ; ]
0352   86                     DB   h_xor & 0FFh   ; ^
0353   99                     DB   h_alloc & 0FFh   ; _
0354   CA                     DB   h_grave & 0FFh   ; `
0355   14                     DB   h_tor & 0FFh   ; {
0356   8E                     DB   h_or & 0FFh   ; |
0357   1D                     DB   h_fromr & 0FFh   ; }
0358   96                     DB   h_not & 0FFh   ; ~
0359                PTABEND:      
0359                             ; =============================================================================
0359                             ;  Routines (no handler starts past this point)
0359                             ; =============================================================================
0359                             ; Digits: step back onto the first digit and read the whole number.
0359   E5           DIGIT:    PUSH   H   
035A   0B                     DCX   B   
035B   CD 65 03               CALL   rdnum   
035E   F7                     RST   6   
035F                             ; negnum: "-" directly before a digit: read the number, negate it.
035F   E5           NEGNUM:   PUSH   H   
0360   CD 65 03               CALL   rdnum   
0363   E7                     RST   4   
0364   F7                     RST   6   
0365                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
0365                             ; non-digit. Values wrap at 16 bits, as the spec says.
0365   21 00 00     RDNUM:    LXI   H,0   
0368   0A           RDN1:     LDAX   B   
0369   D6 30                  SUI   "0"   
036B   FE 0A                  CPI   10   
036D   D0                     RNC      
036E   03                     INX   B   
036F   54                     MOV   D,H   
0370   5D                     MOV   E,L   
0371   29                     DAD   H   
0372   29                     DAD   H   
0373   19                     DAD   D   
0374   29                     DAD   H   ; HL * 10
0375   5F                     MOV   E,A   
0376   16 00                  MVI   D,0   
0378   19                     DAD   D   
0379   C3 68 03               JMP   rdn1   
037C                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, BC = remainder.
037C                             ; Uses A, BC; the caller saves the IP. HL holds the dividend and, as its bits
037C                             ; leave at the top, the quotient bits arrive at the bottom. The loop counter
037C                             ; lives on the stack, since A is busy with the shifts.
037C                             ; Dividing by 2 is one shift (the spec wants that fast).
037C   01 00 00     UDIV:     LXI   B,0   
037F   7B                     MOV   A,E   
0380   EE 02                  XRI   2   
0382   B2                     ORA   D   
0383   C2 90 03               JNZ   udv0   
0386   B4                     ORA   H   ; A was 0, and the carry is clear
0387   1F                     RAR      
0388   67                     MOV   H,A   
0389   7D                     MOV   A,L   
038A   1F                     RAR      
038B   6F                     MOV   L,A   ; the quotient
038C   78                     MOV   A,B   
038D   17                     RAL      
038E   4F                     MOV   C,A   ; the remainder: the bit that fell out
038F   C9                     RET      
0390   3E 10        UDV0:     MVI   A,16   
0392   F5                     PUSH   PSW   
0393   29           UDV1:     DAD   H   ; next dividend bit into the carry
0394   79                     MOV   A,C   
0395   17                     RAL      
0396   4F                     MOV   C,A   
0397   78                     MOV   A,B   
0398   17                     RAL      
0399   47                     MOV   B,A   ; BC = BC*2 + bit
039A   79                     MOV   A,C   
039B   93                     SUB   E   
039C   78                     MOV   A,B   
039D   9A                     SBB   D   ; carry if BC < DE
039E   DA A6 03               JC   udv2   
03A1   47                     MOV   B,A   ; BC - DE (high byte; A holds it)
03A2   79                     MOV   A,C   
03A3   93                     SUB   E   
03A4   4F                     MOV   C,A   
03A5   2C                     INR   L   ; quotient bit
03A6   F1           UDV2:     POP   PSW   
03A7   3D                     DCR   A   
03A8   F5                     PUSH   PSW   
03A9   C2 93 03               JNZ   udv1   
03AC   F1                     POP   PSW   
03AD   C9                     RET      
03AE                             ; psgn: print HL as a signed number. Uses BC.
03AE   7C           PSGN:     MOV   A,H   
03AF   B7                     ORA   A   
03B0   F2 B7 03               JP   pdec   
03B3   3E 2D                  MVI   A,"-"   
03B5   EF                     RST   5   
03B6   E7                     RST   4   
03B7                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
03B7                             ; Uses BC.
03B7   11 0A 00     PDEC:     LXI   D,10   
03BA   CD 7C 03               CALL   udiv   ; HL = HL / 10, C = the last digit
03BD   79                     MOV   A,C   
03BE   F5                     PUSH   PSW   
03BF   7C                     MOV   A,H   
03C0   B5                     ORA   L   
03C1   C4 B7 03               CNZ   pdec   
03C4   F1                     POP   PSW   
03C5   C6 30                  ADI   "0"   
03C7   EF                     RST   5   
03C8   C9                     RET      
03C9                             ;-----------------------------------------------------------------------------
03C9                             ; pesc: the escapes of "$". A = the character after the "/", 60h to 7Eh, and
03C9                             ; HL points past it. Each goes back into the loop that prints the string
03C9                             ; (PRLOOP), but /~ has the stack to see to, and goes back by PRAGAIN.
03C9                             ;    /a-/z   print the variable, as "#" does
03C9                             ;    /{      clear the screen, the cursor to the top left
03C9                             ;    /}      clear from the cursor to the end of the line
03C9                             ;    /|  /`  show the cursor, hide it
03C9                             ;    /~      ( row col -- ) the cursor to that row and column, from 0
03C9   FE 7E        PESC:     CPI   7Eh   
03CB   CA EE 03               JZ   pat   
03CE   11 37 05               LXI   D,PRLOOP   ; the others return into the loop
03D1   D5                     PUSH   D   
03D2   D6 7B                  SUI   7Bh   ; 00bbIDAsIHwgMSwg 2, and no borrow
03D4   D2 25 04               JNC   pcon   
03D7   C6 1A                  ADI   1Ah   ; a-z: 0-25, and a carry; `: FFh, and none
03D9   D2 15 04               JNC   phide   
03DC   87                     ADD   A   ; the variable's cell
03DD   C6 40                  ADI   40h   
03DF   E5                     PUSH   H   
03E0   C5                     PUSH   B   
03E1   6F                     MOV   L,A   
03E2   26 09                  MVI   H,LETPAGE   
03E4   7E                     MOV   A,M   
03E5   2C                     INR   L   
03E6   66                     MOV   H,M   
03E7   6F                     MOV   L,A   
03E8   CD AE 03               CALL   psgn   
03EB   C1                     POP   B   
03EC   E1                     POP   H   
03ED   C9                     RET      
03EE                             ; /~ ( row col addr -- ): the two cells under the string's address go. In
03EE                             ; the checked build "$" is the routine prstr: its own return address goes
03EE                             ; first, and hp1 calls it again afterwards. There each /~ first looks that
03EE                             ; its two cells are there, and is s if not, before it prints anything.
03EE                PAT:         
03EE                          IF   CHECKED   
03EE   E3                     XTHL      ; the text pointer over prstr's return address
03EF   21 0A F7               LXI   H,(6-DSTOP)&0FFFFh   ; a carry: the two cells aren't there
03F2   39                     DAD   SP   
03F3   DA 92 05               JC   e_under   
03F6   E1                     POP   H   
03F7                          ENDIF      
03F7   D1                     POP   D   ; DE = the column
03F8   E3                     XTHL      ; HL = the row; the text pointer is kept
03F9                          IF   1-ANS   
                              CALL   CONAT   
                              POP   H   
                              JMP   PRAGAIN   
                                 ; With ANSI = 0 the machine's routines do the rest.
                    PCON:     JZ   CONCLS   ; /{
                              CPI   2   
                              JZ   CONEOL   ; /}
                              DB   0FEh   ; /|  (CPI steps over the XRA: A = 1, show)
                    PHIDE:    XRA   A   ; /`  (A = 0: hide)
                              JMP   CONCUR   
03F9                          ENDIF      
03F9                          IF   ANS   
03F9   C5                     PUSH   B   ; (pdec uses BC)
03FA   D5                     PUSH   D   
03FB   CD 3C 04               CALL   csi   ; ESC [ row+1 ; col+1 H (ANSI counts from 1)
03FE   23                     INX   H   
03FF   CD B7 03               CALL   pdec   
0402   3E 3B                  MVI   A,";"   
0404   EF                     RST   5   
0405   E1                     POP   H   
0406   23                     INX   H   
0407   CD B7 03               CALL   pdec   
040A   3E 48                  MVI   A,"H"   
040C   EF                     RST   5   
040D   C1                     POP   B   
040E   E1                     POP   H   
040F   C3 D4 02               JMP   PRAGAIN   
0412                             ; With ANSI = 1 they are sequences. The carry is clear on the way in.
0412   1E 68        PSHOW:    MVI   E,"h"   ; /|  ESC [ ? 2 5 h
0414   DA                     DB   0DAh   ; (JC nn: with no carry it steps over two bytes)
0415   1E 6C        PHIDE:    MVI   E,"l"   ; /`  ESC [ ? 2 5 l
0417   3E 3F                  MVI   A,"?"   
0419   CD 35 04               CALL   csia   
041C   3E 32                  MVI   A,"2"   
041E   EF                     RST   5   
041F   3E 35                  MVI   A,"5"   
0421   EF                     RST   5   
0422   7B                     MOV   A,E   
0423   EF                     RST   5   
0424   C9                     RET      
0425                             ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into csia.
0425   3D           PCON:     DCR   A   
0426   CA 12 04               JZ   pshow   ; /|
0429   3E 4B                  MVI   A,"K"   
042B   F2 35 04               JP   csia   ; /}  ESC [ K
042E   3E 48                  MVI   A,"H"   ; /{  ESC [ H ESC [ J
0430   CD 35 04               CALL   csia   
0433   3E 4A                  MVI   A,"J"   ; (on into csia)
0435                             ; csia: ESC [ and then A. csi: ESC [. Both keep all but A.
0435   F5           CSIA:     PUSH   PSW   
0436   CD 3C 04               CALL   csi   
0439   F1                     POP   PSW   
043A   EF                     RST   5   
043B   C9                     RET      
043C   3E 1B        CSI:      MVI   A,27   
043E   EF                     RST   5   
043F   3E 5B                  MVI   A,"["   
0441   EF                     RST   5   
0442   C9                     RET      
0443                          ENDIF      
0443                             ; skip: read past text to the closer at this level, and return A = 0 if it
0443                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
0443                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
0443                             ; no closer; anything else that runs into the NUL had unbalanced brackets
0443                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
0443                             ; skip sets it to 0 and falls through the INR that an opener comes back to.
0443                             ; 
0443                             ; The checked build also looks at the character the skip was started by,
0443                             ; which is always the one just before where it starts: "(" must end at ")",
0443                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
0443                             ; quote counts as running into it. "\" takes either closer. The place where
0443                             ; the skip started is kept on the stack, for the report.
0443                SKIP:        
0443                          IF   CHECKED   
0443   C5                     PUSH   B   
0444   0B                     DCX   B   
0445   0A                     LDAX   B   
0446   03                     INX   B   
0447   5F                     MOV   E,A   ; E = the opener: ( [ or \
0448                          ENDIF      
0448   16 00                  MVI   D,0   
044A   14           SK3:      INR   D   ; an opener: one deeper
044B   0A           SK1:      LDAX   B   
044C                          IF   1-CHECKED   
                              INX   B   
                              ORA   A   
                              JZ   endprog   
044C                          ENDIF      
044C                          IF   CHECKED   
044C   B7                     ORA   A   
044D   CA 7B 04               JZ   sk6   ; (the IP stays on the NUL)
0450   03                     INX   B   
0451                          ENDIF      
0451   FE 22                  CPI   22h   
0453   CC 87 04               CZ   skipstr   ; leaves A = 22h, which matches nothing below
0456   D6 28                  SUI   "("   ;   (or 0, and then the NUL is read next)
0458   CA 4A 04               JZ   sk3   
045B   3D                     DCR   A   ; ")"
045C   CA 69 04               JZ   sk4   
045F   D6 32                  SUI   "["-")"   
0461   CA 4A 04               JZ   sk3   
0464   FE 02                  CPI   "]"-"["   
0466   C2 4B 04               JNZ   sk1   
0469   15           SK4:      DCR   D   
046A                          IF   1-CHECKED   
                              RZ      ; the closer at this level
                              JMP   sk1   
046A                          ENDIF      
046A                          IF   CHECKED   
046A   C2 4B 04               JNZ   sk1   
046D   57                     MOV   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
046E   AB                     XRA   E   ;   opener is 0 for "(" and 1 for "[", and only
046F   E6 06                  ANI   6   ;   "\" has bit 2: so this is 2 for the wrong
0471   FE 02                  CPI   2   ;   closer, and only then
0473   7A                     MOV   A,D   
0474   D1                     POP   D   ; (where the skip started)
0475   C0                     RNZ      
0476   42                     MOV   B,D   ; N. The place is the opener
0477   4B                     MOV   C,E   
0478   C3 82 04               JMP   sk7   
047B   7B           SK6:      MOV   A,E   ; the text ran out:
047C   E6 04                  ANI   4   
047E   C2 83 01               JNZ   endprog   ;   "\" with no closer ends the program
0481   C1                     POP   B   
0482   3E 4E        SK7:      MVI   A,"N"   
0484   C3 C1 05               JMP   errp   ; (errp drops skip's return address)
0487                          ENDIF      
0487                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
0487                             ; the next character, so "/"" does not end it. Leaves A = 22h.
0487                          IF   1-CHECKED   
                    SS0:      INX   B   
                    SKIPSTR:   LDAX   B   
                              INX   B   
                              CPI   "/"   
                              JZ   ss0   
                              CPI   22h   
                              JNZ   skipstr   
                              RET      
0487                          ENDIF      
0487                          IF   CHECKED   
0487                             ; The checked build never steps over a NUL: if the text runs out first it
0487                             ; returns A = 0 with the IP on the NUL.
0487   0A           SKIPSTR:   LDAX   B   
0488   B7                     ORA   A   
0489   C8                     RZ      
048A   03                     INX   B   
048B   FE 22                  CPI   22h   
048D   C8                     RZ      
048E   FE 2F                  CPI   "/"   
0490   C2 87 04               JNZ   skipstr   
0493   0A                     LDAX   B   ; the escaped character
0494   B7                     ORA   A   
0495   C8                     RZ      
0496   03                     INX   B   
0497   C3 87 04               JMP   skipstr   
049A                          ENDIF      
049A                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
049A                             ; and return its value in A with the carry set; otherwise leave the IP and
049A                             ; return with the carry clear.
049A   0A           HEXC:     LDAX   B   
049B   D6 30                  SUI   "0"   
049D   FE 0A                  CPI   10   
049F   DA AB 04               JC   hc1   
04A2   E6 DF                  ANI   0DFh   
04A4   D6 11                  SUI   11h   
04A6   FE 06                  CPI   6   
04A8   D0                     RNC      
04A9   D6 F6                  SUI   0F6h   ; + 10, and sets the carry
04AB   03           HC1:      INX   B   
04AC   C9                     RET      
04AD                             ; =============================================================================
04AD                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
04AD                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
04AD                             ;  (RST 5) prints A. Both keep BC, DE and HL. In the generic build they are
04AD                             ;  the host's KEY and CONOUT routines themselves.
04AD                             ; 
04AD                             ;  A running program reads the keyboard only through getk and pollk, which
04AD                             ;  between them give the break key its rules:
04AD                             ;    - Ctrl-C stops the program;
04AD                             ;    - any other key that the break check reads is held in KEYBUF for the
04AD                             ;      next "?", and a newer one takes its place;
04AD                             ;    - "?" (getk) takes the held key first;
04AD                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
04AD                             ;      key like any other, but two of them within about 250 ms still stop it.
04AD                             ;  Both are called straight from a handler, never from a routine under one:
04AD                             ;  the checked build's report counts on finding one return address above the
04AD                             ;  data stack, and TOS in HL.
04AD                             ; =============================================================================
04AD                          IFN   CPM   
                    RAWK:     EQU   KEY   
04AD                          ENDIF      
04AD                             ; pollk: the break check (see rpushd).
04AD   CD F0 04     POLLK:    CALL   rawk   
04B0   C8                     RZ      ; no key
04B1   32 7A 09               STA   KEYBUF   ; held for the next "?"
04B4   FE 03        PK1:      CPI   3   ; (getk joins here)
04B6   C0                     RNZ      
04B7                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
04B7                             ; the program has turned it off, wait about 250 ms for one more key: a
04B7                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
04B7                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
04B7   3A 7B 09     CTLC:     LDA   BRKOFF   
04BA   B7                     ORA   A   
04BB   CA 32 05               JZ   brk   
04BE   D5                     PUSH   D   
04BF   11 10 27               LXI   D,250*MSLOOP   
04C2   CD F0 04     CT1:      CALL   rawk   
04C5   C2 CE 04               JNZ   ct2   
04C8   1B                     DCX   D   
04C9   7A                     MOV   A,D   
04CA   B3                     ORA   E   
04CB   C2 C2 04               JNZ   ct1   
04CE   D1           CT2:      POP   D   ; A = the second key, or 0 if none came
04CF   FE 03                  CPI   3   
04D1   CA 32 05               JZ   brk   
04D4   B7                     ORA   A   
04D5   CA DB 04               JZ   ct3   
04D8   32 7A 09               STA   KEYBUF   
04DB   3E 03        CT3:      MVI   A,3   
04DD   B7                     ORA   A   
04DE   C9                     RET      
04DF                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
04DF   E5           GETK:     PUSH   H   ; a held key goes first, and is taken out of
04E0   21 7A 09               LXI   H,KEYBUF   ;   the buffer
04E3   7E                     MOV   A,M   
04E4   36 00                  MVI   M,0   
04E6   E1                     POP   H   
04E7   B7                     ORA   A   
04E8   C0                     RNZ      
04E9   CD F0 04               CALL   rawk   
04EC   C8                     RZ      
04ED   C3 B4 04               JMP   pk1   ; Ctrl-C? If not, that is the key
04F0                          IF   1-CHECKED   
                    BRK:      EQU   endprog   ; the unchecked build stops without a word;
04F0                          ENDIF      
04F0                          IF   CHECKED   
04F0                BRK:      EQU   e_break   ;   the checked build reports B
04F0                          ENDIF      
04F0                          IF   CPM   
04F0   3E FF        RAWK:     MVI   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
04F2                             ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
04F2                             ; printing and could swallow a key that BDOS 6 then never sees.
04F2   C5           PUTC:     PUSH   B   
04F3   D5                     PUSH   D   
04F4   E5                     PUSH   H   
04F5   5F                     MOV   E,A   
04F6   0E 06                  MVI   C,6   
04F8   CD 05 00               CALL   BDOS   
04FB   E1                     POP   H   
04FC   D1                     POP   D   
04FD   C1                     POP   B   
04FE   B7                     ORA   A   ; (for getk)
04FF   C9                     RET      
0500                          ENDIF      
0500                             ; =============================================================================
0500                             ;  Checked build: the checks and the error report
0500                             ; =============================================================================
0500                          IF   CHECKED   
0500                             ; chkhp: HL = the new heap top, DE = the count, the carry is from adding
0500                             ; it, and the old top is on the stack under the return address. Stop if the
0500                             ; new top is not below the limit page, or is below the program's end.
0500                CHKHP:       
0500                          ENDIF      
0500                          IF   CHECKED*CPM   
0500                             ; With this much room a top that wrapped round can land back in
0500                             ; range, so the add is tested too: growing must not carry, and
0500                             ; releasing must.
0500   7A                     MOV   A,D   
0501   1F                     RAR      ; the carry comes in above the count's sign:
0502   C6 40                  ADI   40h   ;   bit 7 = carry XOR sign
0504   87                     ADD   A   
0505   DA 19 05               JC   e_heap   
0508   3A 07 00               LDA   0007h   
050B   3D                     DCR   A   
050C   BC                     CMP   H   
050D   DA 19 05               JC   e_heap   
0510                          ENDIF      
0510                          IF   CHECKED*(1-CPM)   
                                 ; (Here the program's space is under 32K, so a top that wrapped
                                 ; round always falls outside it.)
                              MOV   A,H   
                              CPI   HEAPLIM   
                              JNC   e_heap   
0510                          ENDIF      
0510                          IF   CHECKED   
0510   EB                     XCHG      
0511   E5                     PUSH   H   ; the count
0512   2A 38 09               LHLD   NPEND   
0515   19                     DAD   D   ; carry: at or above the program's end
0516   E1                     POP   H   
0517   EB                     XCHG      
0518   D8                     RC      
0519   EB           E_HEAP:   XCHG      ; put the count back in TOS for the report,
051A   D1                     POP   D   ;   and drop the return address (errp drops
051B   3E 48                  MVI   A,"H"   ;   the old top)
051D   C3 C1 05               JMP   errp   
0520                             ; chkst: stop unless HL is in the program's own space: from the letter page
0520                             ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
0520                             ; whatever lies above the limit are safe. Memory above the heap top but
0520                             ; below the limit is the program's own: Tiny BASIC keeps its lines there.
0520                             ; It is the page of HL + 1 that is tested, so that one test serves both
0520                             ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
0520                             ; Keeps HL and BC. It runs on into its own error entry.
0520   23           CHKST:    INX   H   
0521   7C                     MOV   A,H   
0522   2B                     DCX   H   
0523   FE 09                  CPI   LETPAGE   
0525   DA 2F 05               JC   e_store   
0528                          ENDIF      
0528                          IF   CHECKED*(1-CPM)   
                              CPI   HEAPLIM   
                              RC      
0528                          ENDIF      
0528                          IF   CHECKED*CPM   
0528   5F                     MOV   E,A   
0529   3A 07 00               LDA   0007h   ; the BDOS page is the heap limit
052C   3D                     DCR   A   
052D   BB                     CMP   E   
052E   D0                     RNC      
052F                          ENDIF      
052F                          IF   CHECKED   
052F                             ; Two error entries for errors found inside a routine: the first hides the
052F                             ; second inside a 3-byte LXI D (the 11h); errp then drops the routine's
052F                             ; return address.
052F   3E 4F        E_STORE:   MVI   A,"O"   ; a store outside the program's space
0531   11                     DB   11h   
0532   3E 42        E_BREAK:   MVI   A,"B"   ; Ctrl-C (found inside pollk or getk)
0534   C3 C1 05               JMP   errp   
0537                             ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
0537                             ; "$", and the error report's texts). A NUL first is an error: Q.
0537   7E           PRSTR:    MOV   A,M   
0538   23                     INX   H   
0539   FE 22                  CPI   22h   
053B   C8                     RZ      
053C   B7                     ORA   A   
053D   CA A9 05               JZ   e_dollar   
0540   FE 2F                  CPI   "/"   
0542   C2 53 05               JNZ   prs1   
0545   7E                     MOV   A,M   
0546   23                     INX   H   
0547   FE 60                  CPI   60h   
0549   DA 51 05               JC   prs0   
054C   FE 7F                  CPI   7Fh   
054E   DA C9 03               JC   pesc   
0551   E6 BF        PRS0:     ANI   0BFh   
0553   EF           PRS1:     RST   5   
0554   C3 37 05               JMP   prstr   
0557                PRLOOP:   EQU   prstr   ; (where the escapes go back to)
0557                PRAGAIN:   EQU   hp1   ; (and where /~ goes back to)
0557                             ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
0557                             ; pnl: the same, on a new line.
0557   3E 0D        PNL:      MVI   A,13   
0559   EF                     RST   5   
055A   3E 0A                  MVI   A,10   
055C   EF                     RST   5   
055D   E3           PMSG:     XTHL      
055E   CD 37 05               CALL   prstr   
0561   E3                     XTHL      
0562   C9                     RET      
0563                             ; chkstk: both stacks are checked once per character, not in every handler.
0563                             ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
0563                             ; the constant carries if it is above (cells were popped that were never
0563                             ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
0563                             ; a character late at most: the bytes above DSTOP and the guard band below
0563                             ; the page take what happens meanwhile.
0563   EB           CHKSTK:   XCHG      ; DE = TOS (HL is needed for the pointers)
0564   21 05 F7               LXI   H,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
0567   39                     DAD   SP   
0568   DA 92 05               JC   e_under   
056B   24                     INR   H   
056C   C2 8C 05               JNZ   e_over   
056F   2A 34 09               LHLD   RSP   ; the return stack: in its page (or it has
0572   7C                     MOV   A,H   ;   overflowed), and not above its empty
0573   FE 07                  CPI   RSPAGE   ;   position (an underflow stays inside the
0575   C2 89 05               JNZ   e_rover   ;   page, in the guard band)
0578   7D                     MOV   A,L   
0579   FE E1                  CPI   RSTOP&0FFh+1   
057B   D2 80 05               JNC   e_runder   
057E   EB                     XCHG      ; TOS back
057F   C9                     RET      
0580   21 E0 07     E_RUNDER:   LXI   H,RSTOP   ; return stack underflow: it counts as empty
0583   22 34 09               SHLD   RSP   
0586   3E 72                  MVI   A,"r"   
0588   21                     DB   21h   ; (LXI H hides the next entry; HL is free)
0589   3E 52        E_ROVER:   MVI   A,"R"   ; return stack overflow
058B   21                     DB   21h   
058C   3E 53        E_OVER:   MVI   A,"S"   ; data stack overflow
058E   EB                     XCHG      ; TOS back
058F   C3 C1 05               JMP   errp   
0592   31 FC 08     E_UNDER:   LXI   SP,DSTOP   ; data stack underflow: it counts as empty
0595   3E 73                  MVI   A,"s"   
0597   C3 C2 05               JMP   error   
059A                             ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
059A                             ; was never defined still holds 0000h, and the byte there is a JMP, C3h, in
059A                             ; every build: if the IP is in page zero, this was a call of an undefined
059A                             ; word. The call is undone, so the place is the call itself.
059A   04           E_HI:     INR   B   
059B   05                     DCR   B   
059C   C2 B8 05               JNZ   e_resv   
059F   E5                     PUSH   H   
05A0   CF                     RST   1   
05A1   44                     MOV   B,H   
05A2   4D                     MOV   C,L   
05A3   E1                     POP   H   
05A4   3E 55                  MVI   A,"U"   
05A6   C3 C2 05               JMP   error   
05A9                             ; e_dollar: "$" ran into a NUL (in prstr): Q, with the string's address
05A9                             ; back in TOS. prstr"s return address goes first. But if "$' had no
05A9                             ; address at all (the stack was empty), it is s, found now: chkstk, called
05A9                             ; one cell up, sees the stack past its empty place then.
05A9   D1           E_DOLLAR:   POP   D   
05AA   E1                     POP   H   
05AB   CD 63 05               CALL   chkstk   
05AE   E5                     PUSH   H   
05AF   2A 3A 09               LHLD   PSAVE   
05B2   11                     DB   11h   ; (LXI D hides e_quote's first two bytes)
05B3                             ; Error entries. Each loads its letter and then hides the next entry inside
05B3                             ; a 3-byte LXI D (the 11h), so they all fall through to `error`.
05B3   44           E_QUOTE:   MOV   B,H   ; an unclosed string: HL is its address, one
05B4   4D                     MOV   C,L   ;   past the opening quote, which is the place
05B5   3E 51                  MVI   A,"Q"   
05B7   11                     DB   11h   
05B8   3E 58        E_RESV:   MVI   A,"X"   ; a reserved byte outside a string
05BA   11                     DB   11h   
05BB   3E 5A        E_ZERO:   MVI   A,"Z"   ; dividing by zero
05BD   11                     DB   11h   
05BE   3E 57        E_BRACK:   MVI   A,"W"   ; bad character after [
05C0   FE                     DB   0FEh   ; (CPI hides the one byte of errp)
05C1                             ; errp: an error found inside a routine: drop its return address first.
05C1   D1           ERRP:     POP   D   
05C2                             ; error: the report, then the end. A = the letter, BC = one past the place,
05C2                             ; HL = TOS, and both stacks as the report is to show them:
05C2                             ; 
05C2                             ;   Err X @ line,col
05C2                             ;   up to 16 characters of the text from the place
05C2                             ;   Stk n: the top 8 cells at most, bottom to top
05C2                             ;   Rtn n
05C2   E5           ERROR:    PUSH   H   ; now the whole data stack is in memory
05C3   5F                     MOV   E,A   
05C4   CD 57 05               CALL   pnl   
05C7   45 72 72 20 22         DB   "Err ",22h   
05CC   7B                     MOV   A,E   
05CD   EF                     RST   5   
05CE   CD 5D 05               CALL   pmsg   
05D1   20 40 20 22            DB   " @ ",22h   
05D5   0B                     DCX   B   ; BC = the place
05D6                             ; The line and column. A place below the program is in the line
05D6                             ; buffer: line 0. Otherwise count the LFs from the program's start;
05D6                             ; DE = the line's number, HL = where it starts.
05D6   21 80 09               LXI   H,LINEBUF   
05D9   11 00 00               LXI   D,0   
05DC   78                     MOV   A,B   
05DD   FE 0A                  CPI   PROG/256   
05DF   DA F9 05               JC   er3   
05E2   24                     INR   H   
05E3   6B                     MOV   L,E   ; HL = PROG
05E4   13           ER1:      INX   D   ; a new line starts at HL
05E5   E5                     PUSH   H   
05E6   7D           ER2:      MOV   A,L   
05E7   91                     SUB   C   
05E8   7C                     MOV   A,H   
05E9   98                     SBB   B   
05EA   D2 F8 05               JNC   er2x   ; reached the place
05ED   7E                     MOV   A,M   
05EE   23                     INX   H   
05EF   FE 0A                  CPI   10   
05F1   C2 E6 05               JNZ   er2   
05F4   F1                     POP   PSW   
05F5   C3 E4 05               JMP   er1   
05F8   E1           ER2X:     POP   H   
05F9   C5           ER3:      PUSH   B   
05FA   E5                     PUSH   H   
05FB   EB                     XCHG      
05FC   CD B7 03               CALL   pdec   ; the line
05FF   3E 2C                  MVI   A,","   
0601   EF                     RST   5   
0602   D1                     POP   D   
0603   E1                     POP   H   
0604   E5                     PUSH   H   
0605   CD 95 06               CALL   sub16   
0608   23                     INX   H   
0609   CD B7 03               CALL   pdec   ; the column
060C   CD 57 05               CALL   pnl   
060F   22                     DB   22h   
0610   E1                     POP   H   ; the text, as it is: 16 characters, or fewer
0611   06 10                  MVI   B,16   ;   if the line or the program ends first
0613   7E           ER4:      MOV   A,M   
0614   23                     INX   H   
0615   B7                     ORA   A   
0616   CA 2D 06               JZ   er5   
0619   FE 0D                  CPI   13   
061B   CA 2D 06               JZ   er5   
061E   FE 0A                  CPI   10   
0620   CA 2D 06               JZ   er5   
0623                          ENDIF      
0623                          IF   CHECKED*CPM   
0623   FE 1A                  CPI   1Ah   ; (the ^Z that pads a file's last record ends
0625   CA 2D 06               JZ   er5   ;   the text too: some terminals clear the
0628                          ENDIF      ;   screen on it)
0628                          IF   CHECKED   
0628   EF                     RST   5   
0629   05                     DCR   B   
062A   C2 13 06               JNZ   er4   
062D   CD 57 05     ER5:      CALL   pnl   
0630   53 74 6B 20 22         DB   "Stk ",22h   
0635   21 06 F7               LXI   H,(2-DSTOP)&0FFFFh   ; SP - (DSTOP-2) is minus twice the depth
0638   39                     DAD   SP   ;   (the cell at DSTOP-2 was pushed with the
0639   E7                     RST   4   ;   first value and holds nothing)
063A   7C                     MOV   A,H   
063B   CD 89 06               CALL   phal2   ; the depth
063E   3E 3A                  MVI   A,":"   
0640   EF                     RST   5   
0641   79                     MOV   A,C   
0642   FE 09                  CPI   9   
0644   DA 51 06               JC   er6   
0647   CD 5D 05               CALL   pmsg   
064A   20 2E 2E 2E 22         DB   " ...",22h   
064F   0E 08                  MVI   C,8   
0651   26 00        ER6:      MVI   H,0   ; C = the number of cells to show
0653   69                     MOV   L,C   
0654   29                     DAD   H   
0655   39                     DAD   SP   ; HL -> just above the deepest of them
0656   0C                     INR   C   
0657   0D           ER7:      DCR   C   
0658   CA 6D 06               JZ   er8   
065B   2B                     DCX   H   
065C   56                     MOV   D,M   
065D   2B                     DCX   H   
065E   5E                     MOV   E,M   
065F   E5                     PUSH   H   
0660   C5                     PUSH   B   
0661   3E 20                  MVI   A," "   
0663   EF                     RST   5   
0664   EB                     XCHG      
0665   CD AE 03               CALL   psgn   
0668   C1                     POP   B   
0669   E1                     POP   H   
066A   C3 57 06               JMP   er7   
066D   CD 57 05     ER8:      CALL   pnl   
0670   52 74 6E 20 22         DB   "Rtn ",22h   
0675   2A 34 09               LHLD   RSP   
0678   EB                     XCHG      
0679   21 E0 07               LXI   H,RSTOP   
067C   CD 86 06               CALL   phalf   
067F   CD 57 05               CALL   pnl   
0682   22                     DB   22h   
0683   C3 83 01               JMP   endprog   
0686                             ; phalf: print half of HL - DE, and leave it in BC
0686   CD 95 06     PHALF:    CALL   sub16   
0689   B7           PHAL2:    ORA   A   ; (A = H; this clears the carry)
068A   1F                     RAR      
068B   67                     MOV   H,A   
068C   7D                     MOV   A,L   
068D   1F                     RAR      
068E   6F                     MOV   L,A   
068F   E5                     PUSH   H   
0690   CD B7 03               CALL   pdec   
0693   C1                     POP   B   
0694   C9                     RET      
0695                             ; sub16: HL = HL - DE. Leaves A = H.
0695   7D           SUB16:    MOV   A,L   
0696   93                     SUB   E   
0697   6F                     MOV   L,A   
0698   7C                     MOV   A,H   
0699   9A                     SBB   D   
069A   67                     MOV   H,A   
069B   C9                     RET      
069C                          ENDIF      
069C                             ; =============================================================================
069C                             ;  Startup
069C                             ; =============================================================================
069C                START:       
069C                          IF   (1-CPM)*CHECKED   
                              LXI   SP,DSTOP   
069C                          ENDIF      
069C                          IF   CHECKED   
069C                             ; Clear the lower half of the letter page: every variable starts at
069C                             ; 0, every word cell holds 0000h, the address an undefined word is
069C                             ; caught at (see e_hi), and no key is held back.
069C   21 00 09               LXI   H,LET   
069F   AF                     XRA   A   
06A0   77           INI1:     MOV   M,A   
06A1   2C                     INR   L   
06A2   F2 A0 06               JP   ini1   ; +00h to +7Fh
06A5                          ENDIF      
06A5                          IF   CPM   
06A5                             ; CP/M: the RAM pages follow the image; the heap may grow to the BDOS
06A5   21 08 01               LXI   H,vecs   ; the RST routines go down into page zero
06A8   11 08 00               LXI   D,0008h   
06AB   06 2C                  MVI   B,vecend-vecs   
06AD   7E           CPY:      MOV   A,M   
06AE   12                     STAX   D   
06AF   23                     INX   H   
06B0   13                     INX   D   
06B1   05                     DCR   B   
06B2   C2 AD 06               JNZ   cpy   
06B5   11 5C 00               LXI   D,005Ch   ; open the file named on the command line
06B8   0E 0F                  MVI   C,15   ; (no such file: the first read fails too,
06BA   CD 05 00               CALL   BDOS   ;   and the program is empty)
06BD   11 00 0A               LXI   D,PROG   
06C0   D5           LD1:      PUSH   D   
06C1   0E 1A                  MVI   C,26   ; set the DMA address
06C3   CD 05 00               CALL   BDOS   
06C6   11 5C 00               LXI   D,005Ch   
06C9   0E 14                  MVI   C,20   ; read the next 128 bytes
06CB   CD 05 00               CALL   BDOS   
06CE   E1                     POP   H   ; HL = the address this record went to
06CF   B7                     ORA   A   
06D0   C2 DB 06               JNZ   ld2   
06D3   11 80 00               LXI   D,128   
06D6   19                     DAD   D   
06D7   EB                     XCHG      
06D8   C3 C0 06               JMP   ld1   
06DB   36 00        LD2:      MVI   M,0   ; the end of the file counts as NUL
06DD   23                     INX   H   ; the heap starts after it
06DE                          ENDIF      
06DE                          IFN   CPM   
                              LXI   H,PROG   ; the heap starts after the program's NUL
                    FNUL:     MOV   A,M   
                              INX   H   
                              ORA   A   
                              JNZ   fnul   
06DE                          ENDIF      
06DE   22 7C 09               SHLD   HEAP   
06E1                          IF   CHECKED   
06E1   E7                     RST   4   ; minus the heap"s first address: "_' may not
06E2   22 38 09               SHLD   NPEND   ;   release below it
06E5                          ENDIF      
06E5   21 E0 07               LXI   H,RSTOP   ; the return stack is empty
06E8   22 34 09               SHLD   RSP   
06EB                          IF   (1-CHECKED)*(1-CPM)   
                              MOV   H,A   ; (A = 0, from the search for the NUL) no key
                              MOV   L,A   ;   is held, and the break key is on (the
06EB                          ENDIF      ;   checked build has cleared these)
06EB                          IF   (1-CHECKED)*CPM   
                              LXI   H,0   
06EB                          ENDIF      
06EB                          IF   1-CHECKED   
                              SHLD   KEYBUF   
06EB                          ENDIF      
06EB   01 00 0A               LXI   B,PROG   ; the IP
06EE   F7                     RST   6   ; (its return address is thrown away)
06EF                          IF   CPM   
06EF                             ; RAM pages, after the image
06EF                RSPAGE:   EQU   (imgend + 255) / 256   
06EF                DSPAGE:   EQU   RSPAGE + 1   
06EF                LETPAGE:   EQU   RSPAGE + 2   
06EF                PROG:     EQU   LETPAGE*256 + 256   
06EF                          ENDIF      
06EF                IMGEND:      


