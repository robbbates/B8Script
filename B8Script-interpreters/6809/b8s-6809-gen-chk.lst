F229   5A                     DECB      
F22A   26 F8                  BNE   kt2   
F22C   30 1F                  LEAX   -1,X   
F22E   26 F2                  BNE   kt1   ; A = 0 if the time ran out
F230   AE C4                  LDX   ,U   ; 0?: the countdown from 0 took 65536 ms;
F232   27 EE                  BEQ   kt1   ;   run it again, until a key comes
F234   6F C4        KT3:      CLR   ,U   
F236   A7 41                  STA   1,U   
F238   39                     RTS      
F239                             ; Backspace takes the last character back (and is echoed as it is), CR ends
F239                             ; (stored, not echoed), every other key is stored and echoed until the line
