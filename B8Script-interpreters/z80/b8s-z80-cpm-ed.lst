06B3   C9                     RET      
06B4                             ; nxl: step HL over one line, to just past its LF (and return not-zero), or
06B4                             ; stop at the NUL that ends the text (and return zero).
06B4   7E           NXL:      LD   A,(HL)   
06B5   B7                     OR   A   
06B6   C8                     RET   Z   
06B7   23                     INC   HL   
06B8   FE 0A                  CP   10   
06BA   20 F8                  JR   NZ,nxl   
06BC   B7                     OR   A   
06BD   C9                     RET      
06BE                             ; prl: print the line at HL, to its LF; HL -> just past it.
06BE   7E           PRL:      LD   A,(HL)   
06BF   EF                     RST   28h   
06C0   7E                     LD   A,(HL)   
06C1   23                     INC   HL   
06C2   FE 0A                  CP   10   
06C4   20 F8                  JR   NZ,prl   
06C6   C9                     RET      
06C7                          ENDIF      
06C7                          IF   EDGEN   
                                 ; ^R, generic: what comes in from now until ^Z is the program. A CR is
                                 ; stored as CR LF; a LF right after a line end is dropped (it is the CR's
                                 ; own, or an empty line's), and a LF anywhere else ends a line too. A last
                                 ; line with no end is given one. Nothing is echoed, and there is no check
                                 ; for running out of memory.
                    CREAD:    LD   HL,PROG-1   
                              LD   A,10   
                              DB   0FEh   ; (CP n: steps over the LD A,13)
                    RD1:      LD   A,13   ; a LF alone ends a line
                    RD2:      LD   (HL),A   
                              INC   HL   
                              CP   13   
                              LD   A,10   
                              JR   Z,rd2   ; after a CR goes a LF
                    RD3:      CALL   ekey   
                              CP   1Ah   
                              JR   Z,rd4   
                              CP   10   
                              JR   NZ,rd2   
                              DEC   HL   
                              CP   (HL)   
                              INC   HL   
                              JR   Z,rd3   ; (the LF is dropped)
                              JR   rd1   
                    RD4:      DEC   HL   
                              LD   A,(HL)   
                              INC   HL   
                              CP   10   
                              JR   Z,rd5   
                              LD   (HL),13   
                              INC   HL   
                              LD   (HL),10   
                              INC   HL   
                    RD5:      LD   (HL),0   
                              JR   ged1   
                                 ; ^W, generic: the text is printed as it is, for the terminal to capture.
                    CWRITE:   LD   HL,PROG   
                    CW1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,ged1   
                              RST   28h   
                              INC   HL   
                              JR   cw1   
06C7                          ENDIF      
06C7                          IF   EDITOR*CPM   
06C7                CFCB:     EQU   005Ch   ; the file's name is kept here, where the CCP
06C7                             ;   put the one from the command line
06C7                             ; ^R, CP/M: read the file. A name typed before the key is the file's name
06C7                             ; from now on.
06C7   CD 1E 07     CREAD:    CALL   setname   
06CA   CD 5B 07               CALL   load   
06CD   C3 A1 04               JP   edit   
06D0                             ; ^W, CP/M: write the file: delete the old one, make it anew, write the
06D0                             ; text in records of 128 bytes, and close it. The text's NUL and the 127
06D0                             ; bytes after it are set to ^Z meanwhile, which pads the last record.
06D0   CD 1E 07     CWRITE:   CALL   setname   
06D3   CD 4A 07               CALL   fcbclr   
06D6   0E 13                  LD   C,19   ; delete
06D8   CD 55 07               CALL   fbdos   
06DB   0E 16                  LD   C,22   ; make
06DD   CD 55 07               CALL   fbdos   
06E0   3C                     INC   A   
06E1   CA A1 04               JP   Z,edit   ; no room in the directory
06E4   21 00 0B               LD   HL,PROG   
06E7   AF                     XOR   A   
06E8   BE           CW1:      CP   (HL)   
06E9   23                     INC   HL   
06EA   20 FC                  JR   NZ,cw1   
06EC   2B                     DEC   HL   ; HL -> the NUL
06ED   E5                     PUSH   HL   
06EE   06 80                  LD   B,128   
06F0   36 1A        CW2:      LD   (HL),1Ah   
06F2   23                     INC   HL   
06F3   10 FB                  DJNZ   cw2   
06F5   E1                     POP   HL   
06F6   11 00 0B               LD   DE,PROG   
06F9   7B           CW3:      LD   A,E   ; a record that starts before the end is written
06FA   95                     SUB   L   
06FB   7A                     LD   A,D   
06FC   9C                     SBC   A,H   
06FD   30 15                  JR   NC,cw4   
06FF   E5                     PUSH   HL   
0700   D5                     PUSH   DE   
0701   0E 1A                  LD   C,26   ; set the DMA address: the record is written
0703   CD 05 00               CALL   BDOS   ;   from where it lies
0706   0E 15                  LD   C,21   ; write
0708   CD 55 07               CALL   fbdos   
070B   E1                     POP   HL   
070C   11 80 00               LD   DE,128   
070F   19                     ADD   HL,DE   
0710   EB                     EX   DE,HL   
0711   E1                     POP   HL   
0712   18 E5                  JR   cw3   
0714   36 00        CW4:      LD   (HL),0   ; the NUL again
0716   0E 10                  LD   C,16   ; close
0718   CD 55 07               CALL   fbdos   
071B   C3 A1 04               JP   edit   
071E                             ; setname: if a name was typed (the line does not start with its CR), put it
071E                             ; in the CFCB: up to 8 characters, a dot, up to 3 more, in capitals. The drive
071E                             ; is the current one.
071E   11 80 0A     SETNAME:   LD   DE,LINEBUF   
0721   1A                     LD   A,(DE)   
0722   FE 0D                  CP   13   
0724   C8                     RET   Z   
0725   21 5C 00               LD   HL,CFCB   
0728   36 00                  LD   (HL),0   ; the current drive
072A   06 0B                  LD   B,11   
072C   2C           SN1:      INC   L   
072D   36 20                  LD   (HL)," "   
072F   10 FB                  DJNZ   sn1   
0731   2E 5D                  LD   L,CFCB+1   
0733   1A           SN2:      LD   A,(DE)   
0734   13                     INC   DE   
0735   FE 0D                  CP   13   
0737   C8                     RET   Z   
0738   FE 2E                  CP   "."   
073A   20 04                  JR   NZ,sn3   
073C   2E 65                  LD   L,CFCB+9   ; the type
073E   18 F3                  JR   sn2   
0740   FE 61        SN3:      CP   "a"   
0742   38 02                  JR   C,sn4   
0744   E6 5F                  AND   5Fh   ; a capital
0746   77           SN4:      LD   (HL),A   
0747   2C                     INC   L   
0748   18 E9                  JR   sn2   
074A                             ; fcbclr: clear the CFCB after its name, as it must be before a file is opened
074A   21 68 00     FCBCLR:   LD   HL,CFCB+12   
074D   06 18                  LD   B,24   
074F   36 00        FC1:      LD   (HL),0   
0751   23                     INC   HL   
0752   10 FB                  DJNZ   fc1   
0754   C9                     RET      
0755                             ; fbdos: BDOS function C on the file
0755   11 5C 00     FBDOS:    LD   DE,CFCB   
0758   C3 05 00               JP   BDOS   
075B                             ; load: read the file into PROG. No such file: no program. The text ends at
075B                             ; the file"s first ^Z (1Ah), which pads a text file"s last record; one more
075B                             ; goes after the last record, so the search always stops. And every line
075B                             ; must end in LF: a last line without one is given a CR LF.
075B   CD 4A 07     LOAD:     CALL   fcbclr   
075E   0E 0F                  LD   C,15   ; open (no such file: the first read fails
0760   CD 55 07               CALL   fbdos   ;   too)
0763   11 00 0B               LD   DE,PROG   
0766   D5           LD1:      PUSH   DE   
0767   0E 1A                  LD   C,26   ; set the DMA address
0769   CD 05 00               CALL   BDOS   
076C   0E 14                  LD   C,20   ; read the next 128 bytes
076E   CD 55 07               CALL   fbdos   
0771   E1                     POP   HL   ; HL = the address this record went to
0772   B7                     OR   A   
0773   20 07                  JR   NZ,ld2   
0775   11 80 00               LD   DE,128   
0778   19                     ADD   HL,DE   
0779   EB                     EX   DE,HL   
077A   18 EA                  JR   ld1   
077C   36 1A        LD2:      LD   (HL),1Ah   
077E   21 FF 0A               LD   HL,PROG-1   
0781   3E 0A                  LD   A,10   ; (a file with no text needs nothing added)
0783   23           TR1:      INC   HL   
0784   5F                     LD   E,A   ; E = the character before this one
0785   7E                     LD   A,(HL)   
0786   FE 1A                  CP   1Ah   
0788   20 F9                  JR   NZ,tr1   
078A   7B                     LD   A,E   
078B   FE 0A                  CP   10   
078D   28 06                  JR   Z,tr2   
078F   36 0D                  LD   (HL),13   
0791   23                     INC   HL   
0792   36 0A                  LD   (HL),10   
0794   23                     INC   HL   
0795   36 00        TR2:      LD   (HL),0   
0797   C9                     RET      
0798                          ENDIF      
0798                             ; =============================================================================
0798                             ;  CP/M startup (the generic build starts at address 0: see st0)
0798                             ; =============================================================================
0798                          IF   CPM   
0798                             ; The RAM pages follow the image; the heap may grow to the BDOS.
0798                START:       
0798                          ENDIF      
0798                          IF   CPM*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
                                 ; is held back.
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
0798                          ENDIF      
0798                          IF   CPM   
0798   21 08 01               LD   HL,vecs   ; the RST routines go down into page zero
079B   11 08 00               LD   DE,0008h   
079E   01 2C 00               LD   BC,vecend-vecs   
07A1   ED B0                  LDIR      
07A3                          ENDIF      
07A3                          IF   CPM*EDITOR   
07A3   CD 5B 07               CALL   load   ; the file named on the command line
07A6   C3 9B 04               JP   edit0   
07A9                          ENDIF      
07A9                          IF   CPM*(1-EDITOR)   
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:      LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
                              JP   st2   
07A9                          ENDIF      
07A9                          IF   CPM   
07A9                             ; RAM pages, after the image
07A9                RSPAGE:   EQU   (imgend + 255) / 256   
07A9                DSPAGE:   EQU   RSPAGE + 1   
07A9                LETPAGE:   EQU   RSPAGE + 2   
07A9                PROG:     EQU   LETPAGE*256 + 256   
07A9                          ENDIF      
07A9                IMGEND:      


