                    FVAT:     INC   BC   ; x@: TOS = the cell's value
                              PUSH   DE   
                              LD   A,(HL)   
                              INC   L   
                              LD   H,(HL)   
                              LD   L,A   
                              ;*Macro unroll:  NEXTF
