E2E1   E8                     INX      
E2E2   6C 04 00               JMP   (T0)   
E2E5                             ; ---- "_" is the last handler: its body may leave the page
E2E5                             ; "_" ( n -- addr ): the heap top moves by n, which is signed: a negative
E2E5                             ; count releases. TOS becomes the old top. (The carry is clear on the way in.)
E2E5                          IF   1-CHECKED   
                    H_ALLOC:   LDA   HEAP   
                              TAY      
                              ADC   0,X   
                              STA   HEAP   
                              STY   0,X   
                              LDA   HEAP+1   
                              TAY      
                              ADC   1,X   
                              STA   HEAP+1   
                              STY   1,X   
                              RTS      
E2E5                          ENDIF      
E2E5                             ; The checked build works the new top out first, in T0 and Y, and stops with
E2E5                             ; H, the count still on the stack, if it is at or past the limit, below the
E2E5                             ; program's end, or if the 16-bit add wrapped. A wrap is the V flag of the
E2E5                             ; high bytes" add with the old top"s sign bit flipped: that makes the old top
E2E5                             ; a signed number from -8000h, so the add overflows exactly when the true
E2E5                             ; sum leaves 0000h-FFFFh.
E2E5                          IF   CHECKED   
E2E5   AD 7C 04     H_ALLOC:   LDA   HEAP   
E2E8   75 00                  ADC   0,X   
E2EA   85 04                  STA   T0   
E2EC   AD 7D 04               LDA   HEAP+1   
E2EF   49 80                  EOR   #80h   
E2F1   75 01                  ADC   1,X   
E2F3   70 25                  BVS   e_heap   ; wrapped
E2F5   49 80                  EOR   #80h   ; the new top's high byte
E2F7   C9 E0                  CMP   #HEAPLIM   
E2F9   B0 1F                  BCS   e_heap   ; at or past the limit
E2FB   A8                     TAY      
E2FC   A5 04                  LDA   T0   
E2FE   CD 38 04               CMP   PEND   
E301   98                     TYA      
E302   ED 39 04               SBC   PEND+1   
E305   90 13                  BCC   e_heap   ; below the program's end
E307   AD 7C 04               LDA   HEAP   
E30A   95 00                  STA   0,X   
E30C   A5 04                  LDA   T0   
E30E   8D 7C 04               STA   HEAP   
E311   AD 7D 04               LDA   HEAP+1   
E314   95 01                  STA   1,X   
E316   8C 7D 04               STY   HEAP+1   
E319   60                     RTS      
