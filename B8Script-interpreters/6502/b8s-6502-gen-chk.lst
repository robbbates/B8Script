0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the 6502 (NMOS opcodes only)
0000                             ;  Spec: docs/b8script.md (2026-11-24). -n? does no more editing than
0000                             ;        Backspace. Ctrl-C stops every build (see the console layer); the
0000                             ;        break-off cell is BRKOFF, $047B.
0000                             ;  Design follows the Z80 interpreter; see b8s-z80.asm for the common ideas.
0000                             ; 
0000                             ;  This interpreter keeps the data stack in pages 2 and 3 (252 cells) and
0000                             ;  uses 10 bytes of zero page ($00-$09). b8s-6502-zp.asm is a smaller interpreter that
0000                             ;  keeps the stack in zero page instead (112 cells); its memory map and
0000                             ;  machine-code contract differ.
0000                             ; 
0000                             ;  Two switches, set in the EQU lines below:
0000                             ;    CHECKED  0 = no checks: whatever the spec calls unsafe is not caught
0000                             ;             1 = a checked build, as in the spec's "Errors and checked
0000                             ;                 builds": at startup every word cell points at 0000h (see
0000                             ;                 e_undef) and the variables and the interpreter's cells are
0000                             ;                 0. It stops with S s R r (stack over/underflow), H (heap),
0000                             ;                 O (a store outside the program's space), U (undefined
0000                             ;                 word), Q (no closing quote), W (bad character after [), X
0000                             ;                 (a reserved byte), Z (divide by zero), N (brackets) or B
0000                             ;                 (Ctrl-C), printing the spec's four-line report:
0000                             ;                   Err Z @ 3,4
0000                             ;                   0/ "no"$
0000                             ;                   Stk 2: 5 0
0000                             ;                   Rtn 0
0000                             ;                 and then goes to EXIT.
0000                             ;    ANSI     what the console escapes of "$" (/00bbIC8= /| /` /~) do:
0000                             ;             1 = send ANSI (VT100) sequences through CONOUT
0000                             ;             0 = call the machine's own routines CONCLS, CONEOL, CONCUR and
0000                             ;                 CONAT (see the equates)
0000                             ; 
0000                             ;  Assembler: asm80, C6502 mode.
0000                             ; =============================================================================
0000                CHECKED:   EQU   1   ; 1 = checked build
0000                ANSI:     EQU   0   ; 1 = the console escapes send ANSI sequences
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Registers and zero page
0000                             ; 
0000                             ;    IP      zero-page pointer to the next program character (16 bits)
0000                             ;    TL/TH   the top data-stack cell (TOS) lives in zero page, not in memory
0000                             ;    X       data-stack index. The stack is two byte-planes, grows down, and
0000                             ;            holds everything under TOS: NOS is DSL,X (low) and DSH,X (high).
0000                             ;            The stack never leaves its planes because X is 8 bits.
0000                             ;    S       the hardware stack is the RETURN stack: a word call or "(" pushes
0000                             ;            the reading position (high byte first, then low) and "]" or ")"
0000                             ;            pulls it. 100 entries (200 bytes) fit with room to spare.
0000                             ;    Y, A    scratch. Y is 0 after peek/getc, and the zero-page indirect reads
0000                             ;            (IP),Y rely on that.
0000                             ; 
0000                             ;  Dispatch: step is called with JSR, so a handler ends with a plain RTS and
0000                             ;  lands on "JMP next" in the loop. Punctuation goes through PTAB with the
0000                             ;  RTS trick (push handler-1, RTS). Handlers that use the return stack ( ( ) \
0000                             ;  ] 00bbIA== and word calls ) first pull the 2-byte JSR frame off (PLA PLA) and end
0000                             ;  with JMP next instead.
0000                             ; 
0000                             ;  Every punctuation handler starts with the carry clear (the range sort in
0000                             ;  step leaves it so). Several of them count on that, where the comments say.
0000                             ; 
0000                             ;  Machine-code contract (the grave): the code at TOS is entered as a
0000                             ;  subroutine, by JMP (T0) with the loop's return address on the hardware
0000                             ;  stack, so it ends with RTS (60h, which the hex loader appends). On entry
0000                             ;  TL/TH ($02/$03) hold the new TOS (the address is already consumed) and X is
0000                             ;  the data-stack index: NOS is DSL,X (low) and DSH,X (high), which is
0000                             ;  $0200,X and $0300,X.
0000                             ;  To push: DEX, store TL/TH at DSL,X/DSH,X, then set TL/TH. To drop: load
0000                             ;  TL/TH from DSL,X/DSH,X and INX. The code may change A, Y, X (it is the
0000                             ;  stack index, so it must stay consistent on return) and zero page $04-$06
0000                             ;  and $08-$09; it must keep IP ($00/$01) and the hardware stack balanced. On
0000                             ;  return TL/TH are the TOS. Zero page $0A-$0F is free for the code's own use.
0000                             ; -----------------------------------------------------------------------------
0000                IP:       EQU   00h   ; 00-01 reading position
0000                TL:       EQU   02h   ; TOS low
0000                TH:       EQU   03h   ; TOS high
0000                T0:       EQU   04h   ; scratch
0000                T1:       EQU   05h   
0000                T2:       EQU   06h   
0000                D0:       EQU   08h   ; divisor (division, number printing)
0000                D1:       EQU   09h   
0000                          IF   1-CHECKED   
                    KEYBUF:   EQU   07h   ; a key held back by the break check (0: none)
0000                          ENDIF      
0000                          IF   CHECKED   
0000                PLACE:    EQU   06h   ; 06-07 (T2 and $07) the address of the
0000                             ;   character being run, for the error report:
0000                             ;   no handler of the checked build uses T2.
0000                             ;   (Machine code may change T2: that matters
0000                             ;   only if it also leaves a stack overrun,
0000                             ;   whose report then shows a wrong place.)
0000                RSV:      EQU   LET+35h   ; S as it was before this character
0000                KEYBUF:   EQU   LET+7Ah   ; a key held back by the break check (0: none)
0000                             ; The error report runs after the program, so it may use the zero page that
0000                             ; machine code has ($0A-$0F):
0000                CL:       EQU   0Ah   ; 0A-0B where the reported line starts
0000                          ENDIF      
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map
0000                             ; 
0000                             ;    0000-00FF  zero page: the variables above
0000                             ;    0100-01FF  hardware stack = return stack, S starts at FF
0000                             ;    0200       DSL, data stack, low bytes (X = FC when empty: 252 cells)
0000                             ;    0300       DSH, data stack, high bytes
0000                             ;    0400       LET  letter cells: A..Z at +00..+33, a..z at +40..+73 (a word
0000                             ;               cell is 64 bytes below its variable), heap pointer at +7C,
0000                             ;               the -n? line buffer at +80..+FF. The checked build's cells
0000                             ;               are in the gaps: RSV at +35, PEND at +38, KEYBUF (the held
0000                             ;               key; $07 in the unchecked build) at +7A; and every build's:
0000                             ;               CDOWN at +79, BRKOFF (the break-off cell) at +7B.
0000                             ;    0500       PROG the program text, NUL-terminated; the heap follows
0000                             ;    E000       the interpreter (ROM)
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the page range LETPAGE..HEAPLIM-1.
0000                             ; -----------------------------------------------------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The Z flag must match A (it does
0000                             ;   if the routine ends with LDA / RTS).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                             ;   KEY and CONOUT must preserve X and Y.
0000                          IF   1-ANSI   
0000                             ; With ANSI = 0 the console escapes of "$" call these. All four must keep X;
0000                             ; they may change A, Y and the flags.
0000                CONCLS:   EQU   0FF0Ch   ; /{  clear the screen, the cursor to the top left
0000                CONEOL:   EQU   0FF0Fh   ; /}  clear from the cursor to the end of the line
0000                CONCUR:   EQU   0FF12h   ; /| and /`  show the cursor if the carry is set,
0000                             ;     hide it if the carry is clear
0000                CONAT:    EQU   0FF15h   ; /~  the cursor to row A, column Y, both
0000                             ;     counted from 0
0000                          ENDIF      
0000                DSL:      EQU   0200h   ; data stack, low bytes
0000                DSH:      EQU   0300h   ; data stack, high bytes
0000                DSE:      EQU   0FCh   ; X when the data stack is empty
0000                LETPAGE:   EQU   04h   
0000                LET:      EQU   LETPAGE*256   
0000                PROG:     EQU   0500h   ; where the loader puts the program text
0000                PROG1:    EQU   PROG+1   
0000                HEAPLIM:   EQU   0E0h   ; the heap must stay below E000h (a page)
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer (the heap top)
0000                CDOWN:    EQU   LET+79h   ; the break check's countdown (see pnext)
0000                BRKOFF:   EQU   LET+7Bh   ; the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                PEND:     EQU   LET+38h   ; checked: the program's end, where the heap
0000                             ;   starts: it may not be released below it
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSLIM:    EQU   20h   ; lowest S allowed (checked build)
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms; tune it
0000                             ;   (each pass calls KEY once; the wait for a
0000                             ;   second Ctrl-C uses it too: 250 ms)
0000                CWAIT:    EQU   250*MSLOOP/256   ; (that wait, in 256s)
E000                          .ORG   0E000h   
E000                             ; =============================================================================
E000                             ;  Startup: find the NUL, the heap starts after it
E000                             ; =============================================================================
E000   A2 FF        START:    LDX   #0FFh   
E002   9A                     TXS      ; return stack empty
E003                          IF   CHECKED   
E003                             ; The first half of the letter page is zeroed: every variable, every
E003                             ; cell of the interpreter's own (no key held back), and every word
E003                             ; cell, which then points at 0000h: calling an undefined word stops
E003                             ; with U (see e_undef).
E003   E8                     INX      
E004   8A                     TXA      ; A = 0
E005   A0 7F                  LDY   #7Fh   
E007   99 00 04     STZ:      STA   LET,Y   
E00A   88                     DEY      
E00B   10 FA                  BPL   stz   
E00D                          ENDIF      
E00D   20 9C E3               JSR   rstip   
E010   20 90 E3     ST1:      JSR   getc   
E013   D0 FB                  BNE   st1   ; IP ends just past the NUL
E015                          IF   1-CHECKED   
                              STA   KEYBUF   ; (A = 0) no key held, the break key on
                              STA   BRKOFF   
E015                          ENDIF      
E015   A5 00                  LDA   IP   
E017   8D 7C 04               STA   HEAP   
E01A                          IF   CHECKED   
E01A   8D 38 04               STA   PEND   
E01D                          ENDIF      
E01D   A5 01                  LDA   IP+1   
E01F   8D 7D 04               STA   HEAP+1   
E022                          IF   CHECKED   
E022   8D 39 04               STA   PEND+1   
E025                          ENDIF      
E025   20 9C E3               JSR   rstip   
E028   A2 FC                  LDX   #DSE   
E02A                             ; =============================================================================
E02A                             ;  The inner loop
E02A                             ; =============================================================================
E02A                             ; -----------------------------------------------------------------------------
E02A                             ;  The break key. A running program reads the keyboard only through getk
E02A                             ;  (for "?") and pnext (the break check), which between them give the break
E02A                             ;  key its rules:
E02A                             ;    - Ctrl-C (03h) stops the program: silently to EXIT in the unchecked
E02A                             ;      build, with the report (B) in the checked one;
E02A                             ;    - any other key that the break check reads is held in KEYBUF for the
E02A                             ;      next "?", and a newer one takes its place;
E02A                             ;    - "?" (getk) takes the held key first;
E02A                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
E02A                             ;      key like any other, but two of them within about 250 ms still stop it.
E02A                             ;  KEY is the host's: a waiting key in A, or A = 0 with the zero flag set.
E02A                             ; -----------------------------------------------------------------------------
E02A                             ; pnext: the break check, then (falling through) next. A word call, a true
E02A                             ; "(" and a true ")" end here, but the keyboard is looked at only once in 256
E02A                             ; of them: CDOWN counts them down. A key found is held; a Ctrl-C goes on to ctlc. (Startup
E02A                             ; falls in here too, which does no harm.)
E02A   CE 79 04     PNEXT:    DEC   CDOWN   
E02D   D0 0B                  BNE   next   
E02F   20 06 FF               JSR   KEY   
E032   F0 06                  BEQ   next   ; no key
E034   8D 7A 04               STA   KEYBUF   ; held for the next "?"
E037   20 CC E0               JSR   chk3   ; (Ctrl-C: back only if the break key is off)
E03A                NEXT:        
E03A                          IF   CHECKED   
E03A                             ; Both stacks are checked once per character, after it has run. The
E03A                             ; return stack has overrun when S is below RSLIM: an overflow leaves
E03A                             ; it at 1Eh or 1Fh, an underflow wraps it to 01h (no handler pulls
E03A                             ; more than one entry). The data stack has when X is above DSE: an
E03A                             ; underflow moves X up to FDh or FEh (no handler moves X by more
E03A                             ; than 2, but "$", whose /~ escapes each look first), and an
E03A                             ; overflow wraps it from 00h to FFh.
E03A                             ; S is kept in RSV, for the report's Rtn line (an error found inside
E03A                             ; a handler has its own calls on the hardware stack), and the place
E03A                             ; of the character about to run in PLACE.
E03A   8A                     TXA      ; TSX trashes X: keep it in A
E03B   BA                     TSX      
E03C   8E 35 04               STX   RSV   
E03F   E0 20                  CPX   #RSLIM   
E041   AA                     TAX      ; TAX leaves the carry alone
E042   90 12                  BCC   e_rstack   
E044   E0 FD                  CPX   #DSE+1   
E046   B0 20                  BCS   e_stack   
E048   A5 00                  LDA   IP   
E04A   85 06                  STA   PLACE   
E04C   A5 01                  LDA   IP+1   
E04E   85 07                  STA   PLACE+1   
E050                          ENDIF      
E050   20 12 E1               JSR   step   
E053   4C 3A E0               JMP   next   
E056                          IF   CHECKED   
E056                             ; S/R are overflows, s/r underflows. After an underflow that stack counts as
E056                             ; empty.
E056   AD 35 04     E_RSTACK:   LDA   RSV   
E059   C9 10                  CMP   #10h   
E05B   A9 52                  LDA   #"R"   
E05D   B0 13                  BCS   ejmp   ; S is 1Eh-1Fh: an overflow
E05F   A9 FF                  LDA   #0FFh   
E061   8D 35 04               STA   RSV   ; S wrapped to 01h: Rtn 0
E064   A9 72                  LDA   #"r"   
E066   D0 0A                  BNE   ejmp   ; always
E068   E0 FF        E_STACK:   CPX   #0FFh   
E06A   A9 53                  LDA   #"S"   
E06C   B0 04                  BCS   ejmp   ; X wrapped from 00h to FFh: an overflow
E06E   A2 FC                  LDX   #DSE   ; an underflow: Stk 0
E070   A9 73                  LDA   #"s"   
E072   4C EB E5     EJMP:     JMP   error   
E075                          ENDIF      
E075                             ; The handlers that work on the return stack sit here, where short branches
E075                             ; reach next and pnext.
E075                             ; "{" TOS to the return stack, "}" return stack to TOS
E075   68           H_TOR:    PLA      
E076   68                     PLA      
E077   A5 03                  LDA   TH   
E079   48                     PHA      
E07A   A5 02                  LDA   TL   
E07C   48                     PHA      
E07D   20 CD E3               JSR   drop   
E080   D0 B8                  BNE   next   ; always
E082   68           H_FROMR:   PLA      
E083   68                     PLA      
E084   20 76 E1               JSR   push   
E087   68                     PLA      
E088   85 02                  STA   TL   
E08A   68                     PLA      
E08B   85 03                  STA   TH   
E08D   90 AB                  BCC   next   ; always: the carry is clear on the way in
E08F                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
E08F                             ; drops it and carries on. It shares "]"s code: with the carry clear, as
E08F                             ; it is here, the address popped is pushed back.
E08F   20 A5 E3     H_CLOSE:   JSR   flag   
E092   F0 20                  BEQ   rdrop   
E094   24                     DB   24h   ; (BIT zp: steps over the SEC)
E095                             ; "]" returns: pull an address and jump to it.
E095   38           H_RET:    SEC      
E096   68                     PLA      
E097   68                     PLA      ; drop the step frame
E098   68                     PLA      
E099   85 00                  STA   IP   
E09B   68                     PLA      
E09C   85 01                  STA   IP+1   
E09E   B0 9A                  BCS   next   
E0A0   48                     PHA      ; ")": keep the block start
E0A1   A5 00                  LDA   IP   
E0A3   48                     PHA      
E0A4   90 84                  BCC   pnext   ; always: a loop-back, with the break check
E0A6                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
E0A6                             ; drops the block start, "]" returns.
E0A6   20 A5 E3     H_BREAK:   JSR   flag   
E0A9   F0 25                  BEQ   gk9   ; (an RTS)
E0AB                          IF   CHECKED   
E0AB   A9 00                  LDA   #0   ; \ takes either closer
E0AD                          ENDIF      
E0AD   20 D1 E1               JSR   skip   
E0B0   C9 29                  CMP   #")"   
E0B2   D0 E1                  BNE   h_ret   
E0B4   68           RDROP:    PLA      
E0B5   68                     PLA      
E0B6   68                     PLA      
E0B7   68                     PLA      ; (the block start's high byte: never 0)
E0B8   D0 80                  BNE   next   ; always
E0BA                             ; getk: a key for "?" in A (zero flag clear), or A = 0 with the zero flag
E0BA                             ; set when there is none. Keeps X and Y. The held key goes first, and is
E0BA                             ; taken out of KEYBUF.
E0BA   AD 7A 04     GETK:     LDA   KEYBUF   
E0BD   F0 08                  BEQ   gk1   
E0BF   48                     PHA      
E0C0   A9 00                  LDA   #0   
E0C2   8D 7A 04               STA   KEYBUF   
E0C5   68                     PLA      
E0C6   60                     RTS      
E0C7   20 06 FF     GK1:      JSR   KEY   
E0CA   F0 04                  BEQ   gk9   
E0CC                             ; chk3: a key in A (not 0). A Ctrl-C goes on to ctlc, which gives the 03h
E0CC                             ; back if it comes back at all.
E0CC   C9 03        CHK3:     CMP   #3   
E0CE   F0 01                  BEQ   ctlc   
E0D0   60           GK9:      RTS      
E0D1                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
E0D1                             ; the program has turned it off, wait about 250 ms (about 250 times MSLOOP
E0D1                             ; looks: D0 counts the 256s, D1 runs on from whatever it holds) for one more
E0D1                             ; key: a second Ctrl-C is the end too; any other key is held (the newest
E0D1                             ; wins). Returns A = 03h with the zero flag clear. Keeps X and Y.
E0D1   AD 7B 04     CTLC:     LDA   BRKOFF   
E0D4   F0 1D                  BEQ   cbreak   
E0D6   A9 28                  LDA   #CWAIT+1   
E0D8   85 08                  STA   D0   
E0DA   20 06 FF     CT2:      JSR   KEY   
E0DD   D0 0A                  BNE   ct3   
E0DF   C6 09                  DEC   D1   
E0E1   D0 F7                  BNE   ct2   
E0E3   C6 08                  DEC   D0   
E0E5   D0 F3                  BNE   ct2   
E0E7   F0 07                  BEQ   ct9   ; always: none came
E0E9   C9 03        CT3:      CMP   #3   
E0EB   F0 06                  BEQ   cbreak   
E0ED   8D 7A 04               STA   KEYBUF   
E0F0   A9 03        CT9:      LDA   #3   
E0F2   60                     RTS      
E0F3                          IF   1-CHECKED   
                    CBREAK:   EQU   endprog   ; the unchecked build stops without a word
E0F3                          ENDIF      
E0F3                          IF   CHECKED   
E0F3                CBREAK:   EQU   e_break   ; the checked build reports B
E0F3                          ENDIF      
E0F3                          IF   CHECKED   
E0F3   A9 42        E_BREAK:   LDA   #"B"   ; Ctrl-C (the stacks as they stand)
E0F5   2C                     DB   2Ch   
E0F6   A9 58        E_RESV:   LDA   #"X"   ; a reserved byte, 80h-FFh
E0F8   4C EB E5     EJMP3:    JMP   error   
E0FB                          ENDIF      
E0FB                          IF   CHECKED   
E0FB                             ; e_undef: the word cells of undefined words hold 0000h. A call there reads
E0FB                             ; the byte at 0000h, which is IP's own low byte: 00h while IP is 0000h, so
E0FB                             ; the call reads a NUL with IP in page zero, where no program can be. The
E0FB                             ; call is undone first: the step frame and the return address come off the
E0FB                             ; hardware stack, and the place is the call letter (the return address - 1).
E0FB   68           E_UNDEF:   PLA      
E0FC   68                     PLA      ; the step frame
E0FD   68                     PLA      
E0FE   38                     SEC      
E0FF   E9 01                  SBC   #1   
E101   85 06                  STA   PLACE   
E103   68                     PLA      
E104   E9 00                  SBC   #0   
E106   85 07                  STA   PLACE+1   
E108   EE 35 04               INC   RSV   
E10B   EE 35 04               INC   RSV   ; Rtn does not count the call
E10E   A9 55                  LDA   #"U"   
E110   D0 E6                  BNE   ejmp3   ; always
E112                          ENDIF      
E112                             ; step: read one character and sort it by range.
E112                             ;    00h          end of program
E112                             ;    01h-20h, 7Fh-FFh   ignored
E112                             ;    30h-39h      digit: read a whole number
E112                             ;    41h-5Ah      A-Z: call the word in that letter's cell
E112                             ;    61h-7Ah      a-z: push the address of that letter's cell
E112                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
E112                             ; Every way out of the sort has the carry clear, except "ignored". A checked
E112                             ; build stops on 80h-FFh (X) and still ignores DEL.
E112   20 90 E3     STEP:     JSR   getc   ; flags follow A
E115   F0 38                  BEQ   endprog   
E117   38                     SEC      
E118   E9 21                  SBC   #21h   ; A = c - 21h
E11A   90 32                  BCC   ign   ; 01h-20h
E11C   C9 0F                  CMP   #0Fh   
E11E   90 24                  BCC   punct   ; 21h-2Fh: index 0-14
E120   E9 0F                  SBC   #0Fh   ; (carry set) A = c - 30h
E122   C9 0A                  CMP   #10   
E124   90 35                  BCC   digit   
E126   C9 11                  CMP   #11h   
E128   90 18                  BCC   p3a   ; 3Ah-40h
E12A   E9 11                  SBC   #11h   ; (carry set) A = c - 41h
E12C   C9 1A                  CMP   #1Ah   
E12E   90 26                  BCC   upper   ; 41h-5Ah
E130   C9 20                  CMP   #20h   
E132   90 0C                  BCC   p5b   ; 5Bh-60h
E134   C9 3A                  CMP   #3Ah   
E136   90 2B                  BCC   lower   ; 61h-7Ah: A = 20h-39h
E138   C9 3E                  CMP   #3Eh   
E13A                          IF   1-CHECKED   
                              BCS   ign   ; 7Fh-FFh
E13A                          ENDIF      
E13A                          IF   CHECKED   
E13A   F0 12                  BEQ   ign   ; 7Fh
E13C   B0 B8                  BCS   e_resv   ; 80h-FFh: reserved
E13E                          ENDIF      
E13E                             ; The three adjustments below chain. Each ADC adds the carry the one
E13E                             ; before it left, which the constants allow for.
E13E   E9 1A                  SBC   #1Ah   ; 7Bh-7Eh: (carry clear: -1Bh) index 28-31
E140   69 F6        P5B:      ADC   #0F6h   ; 5Bh-60h: -10 (-9 when chained), index 22-27
E142   69 05        P3A:      ADC   #5   ; 3Ah-40h: +5 (+6 when chained), index 15-21
E144   0A           PUNCT:    ASL      ; (the index is small: the carry stays clear)
E145   A8                     TAY      
E146   B9 06 E3               LDA   PTAB+1,Y   
E149   48                     PHA      
E14A   B9 05 E3               LDA   PTAB,Y   
E14D   48                     PHA      
E14E   60           IGN:      RTS      ; RTS trick: goes to the handler. Reached
E14F                             ; directly, it just ends an ignored character.
E14F                ENDPROG:      
E14F                          IF   CHECKED   
E14F   A5 01                  LDA   IP+1   ; IP in page zero: an undefined word
E151   F0 A8                  BEQ   e_undef   
E153                          ENDIF      
E153   4C 09 FF               JMP   EXIT   
E156                             ; A-Z: call the word. The return address (the IP after the letter) goes on
E156                             ; the return stack, and the IP becomes the address in the letter's cell.
E156   0A           UPPER:    ASL      
E157   A8                     TAY      
E158   38                     SEC      
E159   B0 2C                  BCS   pushn   ; always
E15B                             ; Digits: the first one is in A; read the rest of the number.
E15B   A0 00        DIGIT:    LDY   #0   
E15D   20 6C E1               JSR   pushay   
E160   4C 6A E3               JMP   rdnum   
E163                             ; a-z: push the cell's address (the cell is the variable)
E163   0A           LOWER:    ASL      
E164   A0 04                  LDY   #>LET   
E166   D0 04                  BNE   pushay   ; always
E168   A5 00        PUSHIP:   LDA   IP   ; push the reading position
E16A   A4 01                  LDY   IP+1   
E16C                             ; pushay: push a cell: A = its low byte, Y = its high byte
E16C   48           PUSHAY:   PHA      
E16D   20 76 E1               JSR   push   
E170   68                     PLA      
E171   85 02                  STA   TL   
E173   84 03                  STY   TH   
E175   60                     RTS      
E176   CA           PUSH:     DEX      ; ":" and every push (keeps Y)
E177   A5 02                  LDA   TL   
E179   9D 00 02               STA   DSL,X   
E17C   A5 03                  LDA   TH   
E17E   9D 00 03               STA   DSH,X   
E181   60                     RTS      
E182                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
E182                             ; the matching ")".
E182   20 A5 E3     H_OPEN:   JSR   flag   ; (keeps the carry clear)
E185                          IF   1-CHECKED   
                              BEQ   skip   
E185                          ENDIF      
E185                          IF   CHECKED   
E185   F0 25                  BEQ   skpar   
E187                          ENDIF      
E187                             ; pushn: take the step frame off, push the reading position on the return
E187                             ; stack, and go on. With the carry set (a word call) the reading position
E187                             ; then becomes the address in the letter cell at LET,Y.
E187   68           PUSHN:    PLA      
E188   68                     PLA      ; drop the step frame
E189   A5 01                  LDA   IP+1   
E18B   48                     PHA      
E18C   A5 00                  LDA   IP   
E18E   48                     PHA      
E18F   90 0A                  BCC   nxt   
E191   B9 00 04               LDA   LET,Y   
E194   85 00                  STA   IP   
E196   B9 01 04               LDA   LET+1,Y   
E199   85 01                  STA   IP+1   
E19B   4C 2A E0     NXT:      JMP   pnext   
E19E                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
E19E                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
E19E                             ; the body"s address instead. Either way it then skips to the matching "]'.
E19E                             ; (The unchecked build takes anything that is not a letter as the space; the
E19E                             ; checked build stops on it.)
E19E                          IF   CHECKED   
E19E   C0 DF        DEF1:     CPY   #" "-"A"+256   
E1A0   F0 2A                  BEQ   def2   
E1A2                             ; W: anything but a letter or a space after [. The place is that character,
E1A2                             ; one past the [.
E1A2   E6 06                  INC   PLACE   
E1A4   D0 02                  BNE   eb1   
E1A6   E6 07                  INC   PLACE+1   
E1A8   A9 57        EB1:      LDA   #"W"   
E1AA   D0 70                  BNE   ejmp2   ; always
E1AC                             ; A false ( skips: the wrong closer for it is ].
E1AC   A9 5D        SKPAR:    LDA   #"]"   
E1AE   D0 21                  BNE   skip   ; always
E1B0                          ENDIF      
E1B0   20 90 E3     H_DEF:    JSR   getc   
E1B3   38                     SEC      
E1B4   E9 41                  SBC   #"A"   ; a letter gives 0-25 or 32-57: lowercase
E1B6   A8                     TAY      ;   lands 64 bytes up
E1B7   29 DF                  AND   #0DFh   ; fold case: 0-25 only for a letter
E1B9   C9 1A                  CMP   #26   
E1BB                          IF   1-CHECKED   
                              BCS   def2   ; not a letter
E1BB                          ENDIF      
E1BB                          IF   CHECKED   
E1BB   B0 E1                  BCS   def1   
E1BD                          ENDIF      
E1BD   98                     TYA      
E1BE   0A                     ASL      
E1BF   A8                     TAY      ; Y -> the cell
E1C0   A5 00                  LDA   IP   
E1C2   99 00 04               STA   LET,Y   
E1C5   A5 01                  LDA   IP+1   
E1C7   99 01 04               STA   LET+1,Y   
E1CA   D0 03                  BNE   skdef   ; always: no program is in page zero
E1CC   20 68 E1     DEF2:     JSR   puship   ; an anonymous block: push its address
E1CF                SKDEF:       
E1CF                          IF   CHECKED   
E1CF   A9 29                  LDA   #")"   ; the wrong closer for [
E1D1                          ENDIF      
E1D1                             ; skip: read past text to the closer at this level, and return it in A.
E1D1                             ; Brackets of both kinds count together; strings are stepped over whole. A
E1D1                             ; NUL first ends the program.
E1D1                             ; In the checked build A holds, on the way in, the wrong closer for the
E1D1                             ; opener that started the skip, kept in T0: ] for (, ) for [, and 0 for \,
E1D1                             ; which takes either. Meeting the wrong closer at this level, or the end
E1D1                             ; (a NUL, or a string that runs into it), stops with N, except for \,
E1D1                             ; which then ends the program as before.
E1D1                SKIP:        
E1D1                          IF   CHECKED   
E1D1   85 04                  STA   T0   
E1D3                          ENDIF      
E1D3   A9 00                  LDA   #0   
E1D5   85 09                  STA   D1   ; depth
E1D7   20 90 E3     SK1:      JSR   getc   
E1DA                          IF   1-CHECKED   
                              BEQ   endprog   
E1DA                          ENDIF      
E1DA                          IF   CHECKED   
E1DA   F0 26                  BEQ   sknul   
E1DC                          ENDIF      
E1DC   C9 22                  CMP   #22h   
E1DE   D0 05                  BNE   sk2   
E1E0   20 28 E2               JSR   skipstr   ; leaves A = 22h (11h when checked), which
E1E3                             ;   matches nothing below
E1E3                          IF   CHECKED   
E1E3   F0 1D                  BEQ   sknul   ; the string ran into the end
E1E5                          ENDIF      
E1E5   C9 28        SK2:      CMP   #"("   
E1E7   F0 15                  BEQ   sk3   
E1E9   C9 5B                  CMP   #"["   
E1EB   F0 11                  BEQ   sk3   
E1ED   C9 29                  CMP   #")"   
E1EF   F0 04                  BEQ   sk4   
E1F1   C9 5D                  CMP   #"]"   
E1F3   D0 E2                  BNE   sk1   
E1F5   C6 09        SK4:      DEC   D1   
E1F7   10 DE                  BPL   sk1   
E1F9                          IF   CHECKED   
E1F9   C5 04                  CMP   T0   
E1FB   F0 1D                  BEQ   e_nest   ; the wrong kind
E1FD                          ENDIF      
E1FD   60                     RTS      ; the closer at this level
E1FE   E6 09        SK3:      INC   D1   
E200   D0 D5                  BNE   sk1   
E202                          IF   CHECKED   
E202   A5 04        SKNUL:    LDA   T0   
E204   D0 14                  BNE   e_nest   ; ( and [ stop with N
E206   4C 09 FF               JMP   EXIT   ; \ ends the program
E209                             ; The end of "$" (h_print): the string's address goes back into TOS; then a
E209                             ; closing quote drops it, and a NUL (the carry clear) is Q.
E209   68           PQ:       PLA      
E20A   85 02                  STA   TL   
E20C   68                     PLA      
E20D   85 03                  STA   TH   
E20F   B0 5D                  BCS   pdrop   
E211   E0 FC                  CPX   #DSE   ; a NUL: Q, unless "$" had nothing on the
E213   A9 73                  LDA   #"s"   ;   stack at all (X at the empty mark): s
E215   B0 05                  BCS   ejmp2   
E217   A9 51        E_QUOTE:   LDA   #"Q"   ; a string runs into the end
E219   2C                     DB   2Ch   ; (BIT abs: hides the next instruction)
E21A   A9 4E        E_NEST:   LDA   #"N"   ; a skip from ( or [ found the wrong closer
E21C   4C EB E5     EJMP2:    JMP   error   ;   or the end: the place is the opener
E21F                          ENDIF      
E21F                             ; 22h pushes the address of the text after it and skips the string.
E21F   20 68 E1     H_STR:    JSR   puship   
E222                          IF   CHECKED   
E222   20 28 E2               JSR   skipstr   
E225   F0 F0                  BEQ   e_quote   ; it ran into the end: the place is the 22h
E227   60                     RTS      
E228                          ENDIF      
E228                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
E228                             ; the next character, so "/"" does not end it.
E228                             ; Unchecked, it returns with Z set and A = 22h, and it does not look for the
E228                             ; end. Checked, it returns with Z clear and A = 11h, or with Z set if the
E228                             ; text ended first (a NUL, also one just after "/").
E228                          IF   1-CHECKED   
                    SKIPSTR:   JSR   getc   
                              CMP   #"/"   
                              BEQ   ss0   
                              CMP   #22h   
                              BNE   skipstr   
                              RTS      
                    SS0:      JSR   incip   
                              BNE   skipstr   ; A is "/" here
E228                          ENDIF      
E228                          IF   CHECKED   
E228   20 90 E3     SKIPSTR:   JSR   getc   
E22B   F0 09                  BEQ   ss9   ; the end
E22D   C9 2F                  CMP   #"/"   
E22F   D0 06                  BNE   ss1   
E231   20 90 E3               JSR   getc   ; the escaped character
E234   D0 F2                  BNE   skipstr   
E236   60           SS9:      RTS      ; the end, just after "/"
E237   C9 22        SS1:      CMP   #22h   
E239   D0 ED                  BNE   skipstr   
E23B   4A                     LSR      ; A = 11h, Z clear
E23C   60                     RTS      
E23D                          ENDIF      
E23D                             ; =============================================================================
E23D                             ;  Console
E23D                             ; =============================================================================
E23D                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
E23D                             ; 60h to 7Eh is one of the escapes at pesc; "/" plus any other character
E23D                             ; clears that character"s bit 6 (/M is CR, /? is DEL"s "?"; "/" and """ have
E23D                             ; no bit 6, so // and /" give themselves). TOS walks along the string; the
E23D                             ; checked build keeps the address on the hardware stack meanwhile, for a Q
E23D                             ; report (see pq).
E23D                          IF   CHECKED   
E23D   A5 03        H_PRINT:   LDA   TH   
E23F   48                     PHA      
E240   A5 02                  LDA   TL   
E242   48                     PHA      
E243   90 03                  BCC   pr0   ; always: the carry is clear on the way in
E245                          ENDIF      
E245                          IF   1-CHECKED   
                    H_PRINT:   EQU   pr0   
E245                          ENDIF      
E245   20 7C E2     PESC0:    JSR   pesc   ; (an escape, and back into the loop)
E248   20 71 E2     PR0:      JSR   tosget   
E24B   C9 22                  CMP   #22h   
E24D                          IF   1-CHECKED   
                              BEQ   pdrop   
E24D                          ENDIF      
E24D                          IF   CHECKED   
E24D   F0 BA                  BEQ   pq   ; the closing quote, with the carry set
E24F   A8                     TAY      ; (Y is free here)
E250   F0 B7                  BEQ   pq   ; a NUL, with the carry clear
E252                          ENDIF      
E252   C9 2F                  CMP   #"/"   
E254   D0 0D                  BNE   pr1   
E256   20 71 E2               JSR   tosget   
E259   C9 60                  CMP   #60h   
E25B   90 04                  BCC   pr2   
E25D   C9 7F                  CMP   #7Fh   
E25F   90 E4                  BCC   pesc0   ; 60h-7Eh, and the carry is clear
E261   29 BF        PR2:      AND   #0BFh   
E263   20 03 FF     PR1:      JSR   CONOUT   
E266   4C 48 E2               JMP   pr0   
E269   A5 02        H_EMIT:   LDA   TL   ; "'"
E26B   20 03 FF               JSR   CONOUT   
E26E   4C CD E3     PDROP:    JMP   drop   
E271                             ; tosget: A = the byte at TOS, and TOS moves on.  inctos: TOS moves on.
E271   A0 00        TOSGET:   LDY   #0   
E273   B1 02                  LDA   (TL),Y   
E275   E6 02        INCTOS:   INC   TL   
E277   D0 02                  BNE   tg1   
E279   E6 03                  INC   TH   
E27B   60           TG1:      RTS      
E27C                             ; pesc: the escapes of "$". A = the character after the "/", 60h to 7Eh, and
E27C                             ; the carry is clear. Each returns into the loop.
E27C                             ;    /a-/z   print the variable, as "#" does
E27C                             ;    /{      clear the screen, the cursor to the top left
E27C                             ;    /}      clear from the cursor to the end of the line
E27C                             ;    /|  /`  show the cursor, hide it
E27C                             ;    /~      ( row col addr -- addr ): the cursor to that row and column,
E27C                             ;            from 0. The two cells under TOS (the string's address) go.
E27C                             ; A - 7Bh sorts them: 00bbIDAsIHwgMSwg 2, ~ 3 with the carry set, and ` E5h, a-z
E27C                             ; E6h-FFh with it clear.
E27C                          IF   1-ANSI   
E27C                             ; With ANSI = 0 the machine's routines do the work.
E27C   E9 7A        PESC:     SBC   #7Ah   ; (the carry is clear: - 7Bh)
E27E   90 0D                  BCC   pe1   
E280   F0 08                  BEQ   pcls   ; {
E282   4A                     LSR      ; | 0, } 1, ~ 1; the carry set for | and ~
E283   F0 0C                  BEQ   pcur   ; |  show: the carry is set
E285   B0 0D                  BCS   pat   ; ~
E287   4C 0F FF               JMP   CONEOL   ; }
E28A   4C 0C FF     PCLS:     JMP   CONCLS   
E28D   C9 E6        PE1:      CMP   #0E6h   
E28F   B0 15                  BCS   pvar   
E291   4C 12 FF     PCUR:     JMP   CONCUR   ; `  hide: the carry is clear
E294                          ENDIF      
E294                             ; /~: the column is NOS, the row the cell under it.
E294                PAT:         
E294                          IF   CHECKED   
E294   E0 FA                  CPX   #DSE-2   ; fewer than two cells under TOS: s
E296   B0 0B                  BCS   e_atu   
E298                          ENDIF      
E298                          IF   1-ANSI   
E298   BC 00 02               LDY   DSL,X   ; the column
E29B   BD 01 02               LDA   DSL+1,X   ; the row
E29E   E8                     INX      
E29F   E8                     INX      
E2A0   4C 15 FF               JMP   CONAT   
E2A3                          ENDIF      
E2A3                          IF   ANSI   
                                 ; ESC [ row+1 ; col+1 H (ANSI counts from 1). The row's cell and TOS change
                                 ; places first: then "#" prints the row and drops it, prints the column and
                                 ; drops it, and TOS is the string's address again.
                              INX      
                              JSR   h_swap   
                              DEX      
                              LDY   #M_CSI-MSG   
                              JSR   prs   ; ESC [
                              JSR   inctos   
                              JSR   h_num   ; the row + 1
                              LDA   #";"   
                              JSR   CONOUT   
                              JSR   inctos   
                              JSR   h_num   ; the column + 1
                              LDA   #"H"   
                              JMP   CONOUT   
E2A3                          ENDIF      
E2A3                          IF   CHECKED   
E2A3   4C 68 E0     E_ATU:    JMP   e_stack   ; (X is FAh-FCh: an underflow)
E2A6                          ENDIF      
E2A6                             ; a-z: the carry is set. A + 3Ah is the letter - 41h, as step hands it to
E2A6                             ; lower: that pushes the variable"s address, "@" fetches it, and "#' (next)
E2A6                             ; prints it and drops it: TOS is the string's address again.
E2A6   69 39        PVAR:     ADC   #39h   
E2A8   20 63 E1               JSR   lower   
E2AB   20 49 E5               JSR   h_fetch   
E2AE                             ; "#" prints TOS as a signed decimal number, with no space after it. The
E2AE                             ; digits are divided off and held on the hardware stack, ended by a 0.
E2AE   A5 03        H_NUM:    LDA   TH   
E2B0   10 08                  BPL   pn1   
E2B2   A9 2D                  LDA   #"-"   
E2B4   20 03 FF               JSR   CONOUT   
E2B7   20 29 E4               JSR   neg   
E2BA   A9 0A        PN1:      LDA   #10   
E2BC   85 08                  STA   D0   
E2BE   A9 00                  LDA   #0   
E2C0   85 09                  STA   D1   
E2C2   48                     PHA      ; the end marker
E2C3   20 11 E5     PN2:      JSR   udiv   
E2C6   A5 04                  LDA   T0   ; the remainder
E2C8   09 30                  ORA   #"0"   
E2CA   48                     PHA      
E2CB   A5 02                  LDA   TL   
E2CD   05 03                  ORA   TH   
E2CF   D0 F2                  BNE   pn2   
E2D1   68           PN3:      PLA      
E2D2   F0 9A                  BEQ   pdrop   
E2D4   20 03 FF               JSR   CONOUT   
E2D7   4C D1 E2               JMP   pn3   
E2DA                          IF   ANSI   
                                 ; With ANSI = 1 they are sequences, each a message at MSG, printed by prs,
                                 ; which pesc runs on into. (It sits here, just above prs, for that.)
                    PESC:     SBC   #7Ah   ; (the carry is clear: - 7Bh). Y is 0, as
                                 ;   tosget leaves it, and M_CLS is the first
                                 ;   message: Y already points at it
                              BCC   pe1   
                              BEQ   prs   ; {  ESC [ H ESC [ J
                              LDY   #M_SHOW-MSG   
                              LSR      ; | 0, } 1, ~ 1; the carry set for ~
                              BEQ   prs   ; |  ESC [ ? 2 5 h
                              BCS   pat   ; ~
                              LDY   #M_EOL-MSG   ; }  ESC [ K
                              BNE   prs   ; always
                    PE1:      CMP   #0E6h   
                              BCS   pvar   
                              LDY   #M_HIDE-MSG   ; `  ESC [ ? 2 5 l, and on into prs
E2DA                          ENDIF      
E2DA                          IF   CHECKED+ANSI   
E2DA                             ; prs: print the message at MSG+Y; its last byte has bit 7 set. Y ends just
E2DA                             ; past it, at the next message.
E2DA   B9 E8 E2     PRS:      LDA   MSG,Y   
E2DD   48                     PHA      
E2DE   29 7F                  AND   #7Fh   
E2E0   20 03 FF               JSR   CONOUT   
E2E3   C8                     INY      
E2E4   68                     PLA      
E2E5   10 F3                  BPL   prs   
E2E7   60                     RTS      
E2E8                MSG:         
E2E8                          ENDIF      
E2E8                          IF   ANSI   
                    M_CLS:    DB   27,"[","H",27,"[","J"+80h   ; (the first: pesc counts on it)
                    M_SHOW:   DB   27,"[","?","2","5","h"+80h   
                    M_HIDE:   DB   27,"[","?","2","5","l"+80h   
                    M_EOL:    DB   27,"[","K"+80h   
                    M_CSI:    DB   27,"["+80h   
E2E8                          ENDIF      
E2E8                          IF   CHECKED   
E2E8   0D 0A 45 72 72 A0 M_ERR:   DB   13,10,"Err"," "+80h   
E2EE   20 40 A0               DB   " @"," "+80h   
E2F1   0D 8A        M_NL:     DB   13,10+80h   
E2F3   0D 0A 53 74 6B A0 M_STK:   DB   13,10,"Stk"," "+80h   
E2F9   3A 20 2E 2E AE M_CD:   DB   ": ..","."+80h   
E2FE   BA           M_C:      DB   ":"+80h   
E2FF   0D 0A 52 74 6E A0 M_RTN:   DB   13,10,"Rtn"," "+80h   
E305                          ENDIF      
E305                             ; =============================================================================
E305                             ;  Dispatch table: one handler per punctuation character, in code order.
E305                             ;  Entries are handler-1 for the RTS trick.
E305                             ; =============================================================================
E305   AD E3        PTAB:     DW   h_store-1   ; !
E307   1E E2                  DW   h_str-1   ; "
E309   AD E2                  DW   h_num-1   ; #
E30B   3C E2                  DW   h_print-1   ; $
E30D   82 E4                  DW   h_swap-1   ; %
E30F   D8 E3                  DW   h_and-1   ; &
E311   68 E2                  DW   h_emit-1   ; '
E313   81 E1                  DW   h_open-1   ; (
E315   8E E0                  DW   h_close-1   ; )
E317   5B E4                  DW   h_mul-1   ; *
E319   0A E4                  DW   h_add-1   ; +
E31B   54 E5                  DW   h_cfetch-1   ; ,
E31D   02 E4                  DW   h_sub-1   ; -
E31F   BF E3                  DW   h_cstore-1   ; .
E321   97 E4                  DW   h_div-1   ; /
E323   75 E1                  DW   push-1   ; :
E325   CC E3                  DW   drop-1   ; ;
E327   39 E4                  DW   h_lt-1   ; <
E329   4B E4                  DW   h_eq-1   ; =
E32B   36 E4                  DW   h_gt-1   ; >
E32D   5D E5                  DW   h_key-1   ; ?
E32F   48 E5                  DW   h_fetch-1   ; @
E331   AF E1                  DW   h_def-1   ; [
E333   A5 E0                  DW   h_break-1   ; \
E335   94 E0                  DW   h_ret-1   ; ]
E337   F4 E3                  DW   h_xor-1   ; ^
E339   C7 E4                  DW   h_alloc-1   ; _
E33B   BB E5                  DW   h_grave-1   ; `
E33D   74 E0                  DW   h_tor-1   ; {
E33F   E6 E3                  DW   h_or-1   ; |
E341   81 E0                  DW   h_fromr-1   ; }
E343   22 E4                  DW   h_not-1   ; ~
E345                             ; rdnum: TOS = TOS*10 + digit for each digit at IP. Wraps at 16 bits. The
E345                             ; test is at the bottom so the loop closes with a branch. Returns with the
E345                             ; carry set.
E345   20 93 E3     RD1:      JSR   incip   ; (keeps A = the digit)
E348   06 02                  ASL   TL   
E34A   26 03                  ROL   TH   ; x2
E34C   18                     CLC      
E34D   65 02                  ADC   TL   
E34F   85 04                  STA   T0   
E351   A5 03                  LDA   TH   
E353   69 00                  ADC   #0   
E355   A8                     TAY      ; Y:T0 = x2 + digit
E356   06 02                  ASL   TL   
E358   26 03                  ROL   TH   
E35A   06 02                  ASL   TL   
E35C   26 03                  ROL   TH   ; x8
E35E   18                     CLC      
E35F   A5 02                  LDA   TL   
E361   65 04                  ADC   T0   
E363   85 02                  STA   TL   
E365   98                     TYA      
E366   65 03                  ADC   TH   
E368   85 03                  STA   TH   ; x8 + x2 + digit
E36A   20 70 E3     RDNUM:    JSR   isdig   
E36D   90 D6                  BCC   rd1   
E36F   60                     RTS      
E370                             ; isdig: A = the character at IP minus "0"; the carry is clear if it is a
E370                             ; digit. Y = 0.
E370   20 8B E3     ISDIG:    JSR   peek   
E373   38                     SEC      
E374   E9 30                  SBC   #"0"   
E376   C9 0A                  CMP   #10   
E378   60                     RTS      
E379                             ; =============================================================================
E379                             ;  Reading the program
E379                             ;    peek: A = the character at IP, IP unchanged, Y = 0
E379                             ;    getc: the same, then IP moves on; flags follow A
E379                             ;    incip: IP moves on; keeps A, the carry and Y
E379                             ; =============================================================================
E379                             ; rdhex: if IP is at a hex digit (0-9, A-F, a-f), return its value in A with
E379                             ; the carry clear and IP moved on; otherwise the carry is set and IP stays.
E379                             ; Y = 0.
E379   20 70 E3     RDHEX:    JSR   isdig   
E37C   90 0A                  BCC   rh1   
E37E   29 DF                  AND   #0DFh   
E380   E9 11                  SBC   #11h   ; (the carry is set)
E382   C9 06                  CMP   #6   
E384   B0 04                  BCS   rh9   
E386   69 0A                  ADC   #10   
E388   90 09        RH1:      BCC   incip   ; always: the carry is clear
E38A   60           RH9:      RTS      
E38B   A0 00        PEEK:     LDY   #0   
E38D   B1 00                  LDA   (IP),Y   
E38F   60                     RTS      
E390   20 8B E3     GETC:     JSR   peek   
E393   E6 00        INCIP:    INC   IP   
E395   D0 02                  BNE   ic1   
E397   E6 01                  INC   IP+1   
E399   09 00        IC1:      ORA   #0   
E39B   60                     RTS      
E39C                             ; rstip: point IP at the start of the program
E39C   A9 00        RSTIP:    LDA   #<PROG   
E39E   85 00                  STA   IP   
E3A0   A9 05                  LDA   #>PROG   
E3A2   85 01                  STA   IP+1   
E3A4   60                     RTS      
E3A5                             ; =============================================================================
E3A5                             ;  Stack
E3A5                             ; =============================================================================
E3A5                             ; flag: pops TOS and returns with Z set if it was 0. Keeps the carry.
E3A5   A5 02        FLAG:     LDA   TL   
E3A7   05 03                  ORA   TH   
E3A9   20 CD E3               JSR   drop   
E3AC   A8                     TAY      ; (drop's INX changed the flags)
E3AD   60                     RTS      
E3AE                             ; "!" ( n addr -- ) is "." plus the high byte. Both end in drop.
E3AE                H_STORE:      
E3AE                          IF   CHECKED   
E3AE   A5 02                  LDA   TL   ; both bytes must be in the program's space:
E3B0   69 01                  ADC   #1   ; check the page of addr+1 (the carry is
E3B2   A5 03                  LDA   TH   ; clear on the way in)
E3B4   69 00                  ADC   #0   
E3B6   20 08 E5               JSR   chkst   
E3B9                          ENDIF      
E3B9   BD 00 03               LDA   DSH,X   
E3BC   A0 01                  LDY   #1   
E3BE   91 02                  STA   (TL),Y   
E3C0                H_CSTORE:      ; "." ( c addr -- )
E3C0                          IF   CHECKED   
E3C0   A5 03                  LDA   TH   
E3C2   20 08 E5               JSR   chkst   
E3C5                          ENDIF      
E3C5   BD 00 02               LDA   DSL,X   
E3C8   A0 00                  LDY   #0   
E3CA   91 02                  STA   (TL),Y   
E3CC   E8                     INX      ; falls into drop
E3CD                             ; drop: ";" and every drop. It works through Y, so A and the carry are kept;
E3CD                             ; it returns with Z clear.
E3CD   BC 00 02     DROP:     LDY   DSL,X   
E3D0   84 02                  STY   TL   
E3D2   BC 00 03               LDY   DSH,X   
E3D5   84 03                  STY   TH   
E3D7   E8                     INX      
E3D8   60                     RTS      
E3D9                             ; =============================================================================
E3D9                             ;  Arithmetic and logic. Effects are ( NOS TOS -- result ).
E3D9                             ; =============================================================================
E3D9                             ; The logic operators leave the carry as they found it, clear, so they can
E3D9                             ; branch to fin.
E3D9   BD 00 02     H_AND:    LDA   DSL,X   
E3DC   25 02                  AND   TL   
E3DE   85 02                  STA   TL   
E3E0   BD 00 03               LDA   DSH,X   
E3E3   25 03                  AND   TH   
E3E5   90 31                  BCC   fin   ; always
E3E7   BD 00 02     H_OR:     LDA   DSL,X   
E3EA   05 02                  ORA   TL   
E3EC   85 02                  STA   TL   
E3EE   BD 00 03               LDA   DSH,X   
E3F1   05 03                  ORA   TH   
E3F3   90 23                  BCC   fin   ; always
E3F5   BD 00 02     H_XOR:    LDA   DSL,X   
E3F8   45 02                  EOR   TL   
E3FA   85 02                  STA   TL   
E3FC   BD 00 03               LDA   DSH,X   
E3FF   45 03                  EOR   TH   
E401   90 15                  BCC   fin   ; always
E403                             ; "-" has two jobs: directly before a digit it starts a negative number.
E403   20 70 E3     H_SUB:    JSR   isdig   
E406   90 14                  BCC   negnum   
E408   20 29 E4     SUB1:     JSR   neg   ; a - b = a + (-b)
E40B   18           H_ADD:    CLC      
E40C   BD 00 02               LDA   DSL,X   
E40F   65 02                  ADC   TL   
E411   85 02                  STA   TL   
E413   BD 00 03               LDA   DSH,X   
E416   65 03                  ADC   TH   ; falls into fin
E418                             ; fin: finish a two-operand op: A = the high byte of the result
E418   85 03        FIN:      STA   TH   
E41A   E8                     INX      
E41B   60                     RTS      
E41C   A9 00        NEGNUM:   LDA   #0   ; a number from 0 (the digit routine's start)
E41E   20 5B E1               JSR   digit   ; (comes back with the carry set)
E421   B0 06                  BCS   neg   ; always: the number, negated
E423                             ; "~": -x - 1, which is neg with the carry clear, as it is here
E423   90 05        H_NOT:    BCC   neg1   ; always
E425                             ; absv: TOS = |TOS|.  negm: TOS = -TOS if the N flag is set.
E425   A5 03        ABSV:     LDA   TH   
E427   10 0D        NEGM:     BPL   ab9   
E429                             ; neg: TOS = -TOS
E429   38           NEG:      SEC      
E42A   A9 00        NEG1:     LDA   #0   
E42C   E5 02                  SBC   TL   
E42E   85 02                  STA   TL   
E430   A9 00                  LDA   #0   
E432   E5 03                  SBC   TH   
E434   85 03                  STA   TH   
E436   60           AB9:      RTS      
E437                             ; Signed compares: a - b sets N and V; N xor V is "a < b". The carry ends up
E437                             ; clear for true, and bool turns it into -1 (true) or 0 (both pop NOS first).
E437   20 83 E4     H_GT:     JSR   h_swap   ; a > b is b < a
E43A   BD 00 02     H_LT:     LDA   DSL,X   
E43D   C5 02                  CMP   TL   
E43F   BD 00 03               LDA   DSH,X   
E442   E5 03                  SBC   TH   
E444   70 02                  BVS   lt1   
E446   49 80                  EOR   #80h   
E448   0A           LT1:      ASL      
E449   E8                     INX      ; (keeps the carry; never leaves X at 0)
E44A   D0 07                  BNE   bool   ; always
E44C   20 08 E4     H_EQ:     JSR   sub1   ; a - b: zero if equal; A = its high byte
E44F   05 02                  ORA   TL   
E451   C9 01                  CMP   #1   ; carry clear if A = 0
E453   A9 00        BOOL:     LDA   #0   
E455   69 FF                  ADC   #0FFh   ; carry clear: FF, set: 00
E457   85 02                  STA   TL   
E459   85 03                  STA   TH   
E45B   60                     RTS      
E45C                             ; "*": the classic shift-right multiply. The multiplier leaves TH:TL from the
E45C                             ; bottom while the product comes in at the top, through A:T0 above it; after
E45C                             ; 16 rounds TH:TL hold the low 16 bits, which are all that is kept.
E45C   A0 10        H_MUL:    LDY   #16   ; the round count
E45E   A9 00                  LDA   #0   
E460   85 04                  STA   T0   ; A:T0 = the upper half
E462   46 03                  LSR   TH   
E464   66 02                  ROR   TL   ; the first multiplier bit
E466   90 0F        ML1:      BCC   ml2   
E468   85 05                  STA   T1   
E46A   18                     CLC      
E46B   A5 04                  LDA   T0   
E46D   7D 00 02               ADC   DSL,X   
E470   85 04                  STA   T0   
E472   A5 05                  LDA   T1   
E474   7D 00 03               ADC   DSH,X   ; upper half += the multiplicand
E477   6A           ML2:      ROR      
E478   66 04                  ROR   T0   
E47A   66 03                  ROR   TH   
E47C   66 02                  ROR   TL   ; everything one place right; next bit out
E47E   88                     DEY      
E47F   D0 E5                  BNE   ml1   
E481   E8                     INX      ; drop the multiplicand
E482   60                     RTS      
E483   BC 00 02     H_SWAP:   LDY   DSL,X   ; "%"
E486   A5 02                  LDA   TL   
E488   9D 00 02               STA   DSL,X   
E48B   84 02                  STY   TL   
E48D   BC 00 03               LDY   DSH,X   
E490   A5 03                  LDA   TH   
E492   9D 00 03               STA   DSH,X   
E495   84 03                  STY   TH   
E497   60                     RTS      
E498                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
E498                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b, r is pushed
E498                             ; and gets the sign of a. Unchecked, dividing by zero returns two cells of no
E498                             ; meaning; checked, it stops with Z.
E498                H_DIV:       
E498                          IF   CHECKED   
E498   A5 02                  LDA   TL   
E49A   05 03                  ORA   TH   
E49C   F0 5F                  BEQ   e_zero   
E49E                          ENDIF      
E49E   BD 00 03               LDA   DSH,X   
E4A1   48                     PHA      ; a's sign: for r
E4A2   45 03                  EOR   TH   
E4A4   48                     PHA      ; a xor b: for q
E4A5   20 25 E4               JSR   absv   
E4A8   A5 02                  LDA   TL   
E4AA   85 08                  STA   D0   
E4AC   A5 03                  LDA   TH   
E4AE   85 09                  STA   D1   ; D = |b|
E4B0   20 CD E3               JSR   drop   ; TOS = a
E4B3   20 25 E4               JSR   absv   ; TOS = |a|
E4B6   20 11 E5               JSR   udiv   ; TOS = q, T0/T1 = r
E4B9   68                     PLA      
E4BA   20 27 E4               JSR   negm   ; q's sign
E4BD   A5 04                  LDA   T0   
E4BF   A4 05                  LDY   T1   
E4C1   20 6C E1               JSR   pushay   ; r on top
E4C4   68                     PLA      
E4C5   4C 27 E4               JMP   negm   ; r's sign
E4C8                             ; =============================================================================
E4C8                             ;  Storage
E4C8                             ; =============================================================================
E4C8                             ; "_" ( n -- addr ): the heap top moves by n, which is signed: a negative
E4C8                             ; count releases. TOS becomes the old top. (The carry is clear on the way in.)
E4C8                          IF   1-CHECKED   
                    H_ALLOC:   LDA   HEAP   
                              TAY      
                              ADC   TL   
                              STA   HEAP   
                              STY   TL   
                              LDA   HEAP+1   
                              TAY      
                              ADC   TH   
                              STA   HEAP+1   
                              STY   TH   
                              RTS      
E4C8                          ENDIF      
E4C8                             ; The checked build works the new top out first, in T0 and Y, and stops with
E4C8                             ; H, the count still on the stack, if it is at or past the limit, below the
E4C8                             ; program's end, or if the 16-bit add wrapped. A wrap is the V flag of the
E4C8                             ; high bytes" add with the old top"s sign bit flipped: that makes the old top
E4C8                             ; a signed number from -8000h, so the add overflows exactly when the true
E4C8                             ; sum leaves 0000h-FFFFh.
E4C8                          IF   CHECKED   
E4C8   AD 7C 04     H_ALLOC:   LDA   HEAP   
E4CB   65 02                  ADC   TL   
E4CD   85 04                  STA   T0   
E4CF   AD 7D 04               LDA   HEAP+1   
E4D2   49 80                  EOR   #80h   
E4D4   65 03                  ADC   TH   
E4D6   70 28                  BVS   e_heap   ; wrapped
E4D8   49 80                  EOR   #80h   ; the new top's high byte
E4DA   C9 E0                  CMP   #HEAPLIM   
E4DC   B0 22                  BCS   e_heap   ; at or past the limit
E4DE   A8                     TAY      
E4DF   A5 04                  LDA   T0   
E4E1   CD 38 04               CMP   PEND   
E4E4   98                     TYA      
E4E5   ED 39 04               SBC   PEND+1   
E4E8   90 16                  BCC   e_heap   ; below the program's end
E4EA   AD 7C 04               LDA   HEAP   
E4ED   85 02                  STA   TL   
E4EF   A5 04                  LDA   T0   
E4F1   8D 7C 04               STA   HEAP   
E4F4   AD 7D 04               LDA   HEAP+1   
E4F7   85 03                  STA   TH   
E4F9   8C 7D 04               STY   HEAP+1   
E4FC   60                     RTS      
E4FD                             ; Errors found by handlers. The stacks are as they were before the handler.
E4FD   A9 5A        E_ZERO:   LDA   #"Z"   ; divide by zero
E4FF   2C                     DB   2Ch   ; (BIT abs: hides the next instruction)
E500   A9 48        E_HEAP:   LDA   #"H"   ; heap past the limit or below the program
E502   2C                     DB   2Ch   
E503   A9 4F        E_STORE:   LDA   #"O"   ; a store outside the program's space
E505   4C EB E5               JMP   error   
E508                             ; chkst: stop unless the page in A is in the program's own space, from the
E508                             ; letter page up to the heap limit. Keeps Y.
E508   C9 04        CHKST:    CMP   #LETPAGE   
E50A   90 F7                  BCC   e_store   
E50C   C9 E0                  CMP   #HEAPLIM   
E50E   B0 F3                  BCS   e_store   
E510   60                     RTS      
E511                          ENDIF      
E511                             ; udiv: unsigned TOS / D (D <= 8000h). TOS becomes the quotient and T0/T1
E511                             ; the remainder. The low byte of each trial subtraction waits on the
E511                             ; hardware stack.
E511                             ; Dividing by 2 is one shift (the spec wants that fast).
E511   A9 00        UDIV:     LDA   #0   
E513   85 04                  STA   T0   
E515   85 05                  STA   T1   
E517   A5 08                  LDA   D0   
E519   49 02                  EOR   #2   
E51B   05 09                  ORA   D1   
E51D   D0 07                  BNE   ud0   
E51F   46 03                  LSR   TH   
E521   66 02                  ROR   TL   ; the quotient
E523   26 04                  ROL   T0   ; the remainder: the bit that fell out
E525   60                     RTS      
E526   A0 10        UD0:      LDY   #16   
E528   06 02        UD1:      ASL   TL   
E52A   26 03                  ROL   TH   
E52C   26 04                  ROL   T0   
E52E   26 05                  ROL   T1   
E530   38                     SEC      
E531   A5 04                  LDA   T0   
E533   E5 08                  SBC   D0   
E535   48                     PHA      
E536   A5 05                  LDA   T1   
E538   E5 09                  SBC   D1   
E53A   90 08                  BCC   ud2   
E53C   85 05                  STA   T1   
E53E   68                     PLA      
E53F   85 04                  STA   T0   
E541   E6 02                  INC   TL   ; the quotient bit (TL's bit 0 is free)
E543   24                     DB   24h   ; (BIT zp: steps over the PLA)
E544   68           UD2:      PLA      
E545   88                     DEY      
E546   D0 E0                  BNE   ud1   
E548   60                     RTS      
E549                             ; =============================================================================
E549                             ;  Fetches, and the keyboard
E549                             ; =============================================================================
E549   A0 01        H_FETCH:   LDY   #1   ; "@"
E54B   B1 02                  LDA   (TL),Y   
E54D   48                     PHA      ; the high byte, while "," gets the low one
E54E   20 55 E5               JSR   h_cfetch   
E551   68                     PLA      
E552   85 03                  STA   TH   
E554   60                     RTS      
E555                H_CFETCH:      ; ","
E555   A0 00                  LDY   #0   
E557   B1 02                  LDA   (TL),Y   
E559   85 02        CF2:      STA   TL   ; TOS = A (low), Y (high)
E55B   84 03                  STY   TH   
E55D   60                     RTS      
E55E                             ; "?" ( n -- c ) or ( -n -- addr )
E55E                             ;   n > 0: wait about n ms for a key; 0 if none came
E55E                             ;   n = 0: wait for a key
E55E                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
E55E                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
E55E   A5 03        H_KEY:    LDA   TH   
E560   30 20                  BMI   line   
E562   A0 28        KT1:      LDY   #MSLOOP   ; one millisecond, roughly
E564   20 BA E0     KT2:      JSR   getk   
E567   D0 15                  BNE   kt3   
E569   88                     DEY      
E56A   D0 F8                  BNE   kt2   
E56C   A5 02                  LDA   TL   ; count the millisecond off:
E56E   D0 06                  BNE   kt4   
E570   A5 03                  LDA   TH   
E572   F0 EE                  BEQ   kt1   ; 0? never counts down: it waits
E574   C6 03                  DEC   TH   
E576   C6 02        KT4:      DEC   TL   
E578   D0 E8                  BNE   kt1   
E57A   A5 03                  LDA   TH   
E57C   D0 E4                  BNE   kt1   ; A = 0 if the time ran out
E57E   A0 00        KT3:      LDY   #0   
E580   F0 D7                  BEQ   cf2   ; always: TOS = A
E582                             ; Backspace takes the last character back (and is echoed as it is), CR ends
E582                             ; (stored, not echoed), every other key is stored and echoed until the line
E582                             ; is full. Y = the length so far; TL = the most allowed.
E582   20 29 E4     LINE:     JSR   neg   ; TOS = the count, and A = its high byte
E585   D0 04                  BNE   ln0   
E587   A5 02                  LDA   TL   
E589   10 04                  BPL   ln1   
E58B   A9 7F        LN0:      LDA   #127   ; more than 127 is taken as 127
E58D   85 02                  STA   TL   
E58F   A0 00        LN1:      LDY   #0   
E591   F0 03                  BEQ   ln2   ; always
E593   20 03 FF     LN3:      JSR   CONOUT   
E596   20 BA E0     LN2:      JSR   getk   
E599   F0 FB                  BEQ   ln2   
E59B   C9 0D                  CMP   #13   
E59D   F0 14                  BEQ   ln5   
E59F   C9 08                  CMP   #8   
E5A1   F0 0A                  BEQ   ln4   
E5A3   C4 02                  CPY   TL   
E5A5   B0 EF                  BCS   ln2   ; full
E5A7   99 80 04               STA   LINEBUF,Y   
E5AA   C8                     INY      
E5AB   D0 E6                  BNE   ln3   ; always: echo it
E5AD   88           LN4:      DEY      ; Backspace: one back, and echo it,
E5AE   10 E3                  BPL   ln3   
E5B0   C8                     INY      ;   unless the line was empty
E5B1   F0 E3                  BEQ   ln2   ; always
E5B3   99 80 04     LN5:      STA   LINEBUF,Y   ; A = CR
E5B6   A9 80                  LDA   #<LINEBUF   
E5B8   A0 04                  LDY   #>LINEBUF   
E5BA   D0 9D                  BNE   cf2   ; always: TOS = the line's address
E5BC                             ; =============================================================================
E5BC                             ;  Machine code: the grave
E5BC                             ; =============================================================================
E5BC                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
E5BC                             ; are stored from addr until a non-hex character; then a RET (60h) is
E5BC                             ; written and its address is left. An odd last digit is consumed and dropped.
E5BC                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ); see the
E5BC                             ; contract in the header.
E5BC   20 79 E3     H_GRAVE:   JSR   rdhex   
E5BF   B0 1C                  BCS   exec   
E5C1   0A           HX1:      ASL      
E5C2   0A                     ASL      
E5C3   0A                     ASL      
E5C4   0A                     ASL      
E5C5   85 04                  STA   T0   
E5C7   20 79 E3               JSR   rdhex   
E5CA   B0 0C                  BCS   hx2   ; odd digit: already consumed, dropped
E5CC   05 04                  ORA   T0   
E5CE   91 02                  STA   (TL),Y   ; Y is 0 after rdhex (never checked)
E5D0   20 75 E2               JSR   inctos   
E5D3   20 79 E3               JSR   rdhex   
E5D6   90 E9                  BCC   hx1   
E5D8   A9 60        HX2:      LDA   #60h   
E5DA   91 02                  STA   (TL),Y   
E5DC   60                     RTS      
E5DD   A5 02        EXEC:     LDA   TL   
E5DF   85 04                  STA   T0   
E5E1   A5 03                  LDA   TH   
E5E3   85 05                  STA   T1   
E5E5   20 CD E3               JSR   drop   ; the address is consumed
E5E8   6C 04 00               JMP   (T0)   
E5EB                          IF   CHECKED   
E5EB                             ; =============================================================================
E5EB                             ;  Checked build: the error report
E5EB                             ; =============================================================================
E5EB                             ; error: the report, then EXIT. A = the letter, PLACE = the place, X = the
E5EB                             ; data stack to show, RSV = S for the Rtn line. Nothing here relies on S: an
E5EB                             ; overflowed or underflowed hardware stack wraps inside its page, and only
E5EB                             ; its depth is shown.
E5EB                             ;   CR LF
E5EB                             ;   Err X @ line,col CR LF
E5EB                             ;   up to 16 characters from the place, raw, up to a CR, LF or NUL  CR LF
E5EB                             ;   Stk n: [...] and the top 8 cells at most, bottom to top  CR LF
E5EB                             ;   Rtn n CR LF
E5EB                             ; The numbers go through "#" (h_num), each pushed over the data stack first
E5EB                             ; and popped again by "#", so the stack is shown as it was.
E5EB   48           ERROR:    PHA      ; the letter
E5EC   A0 00                  LDY   #M_ERR-MSG   
E5EE   20 DA E2               JSR   prs   ; CR LF "Err "
E5F1   68                     PLA      
E5F2   20 03 FF               JSR   CONOUT   
E5F5   20 DA E2               JSR   prs   ; " @ " (it follows M_ERR)
E5F8                             ; The line and the column of the place, both from 1. The line is counted in
E5F8                             ; a cell pushed over the data stack (TOS). A place below the program is in
E5F8                             ; the -n? line buffer: line 0, and the column is the place in the buffer.
E5F8                             ; Otherwise IP (free now: the program has stopped) runs from PROG to the
E5F8                             ; place, counting LFs; CL keeps where the last line started, and the column
E5F8                             ; is the place minus that, plus 1.
E5F8   A9 80                  LDA   #<LINEBUF   
E5FA   85 0A                  STA   CL   
E5FC   A9 04                  LDA   #>LINEBUF   
E5FE   85 0B                  STA   CL+1   
E600   A9 00                  LDA   #0   
E602   A8                     TAY      
E603   20 6C E1               JSR   pushay   ; TOS = the line, 0 so far
E606   A5 06                  LDA   PLACE   
E608   C9 00                  CMP   #<PROG   
E60A   A5 07                  LDA   PLACE+1   
E60C   E9 05                  SBC   #>PROG   
E60E   90 23                  BCC   lc9   ; below the program: line 0
E610   E6 02                  INC   TL   
E612   20 9C E3               JSR   rstip   
E615   A5 00        LC3:      LDA   IP   ; a line starts here
E617   85 0A                  STA   CL   
E619   A5 01                  LDA   IP+1   
E61B   85 0B                  STA   CL+1   
E61D   A5 00        LC1:      LDA   IP   
E61F   C5 06                  CMP   PLACE   
E621   A5 01                  LDA   IP+1   
E623   E5 07                  SBC   PLACE+1   
E625   B0 0C                  BCS   lc9   ; at the place
E627   20 90 E3               JSR   getc   
E62A   C9 0A                  CMP   #10   
E62C   D0 EF                  BNE   lc1   
E62E   20 75 E2               JSR   inctos   ; an LF: a new line starts after it
E631   D0 E2                  BNE   lc3   ; always (Z clear: fewer than 65536 lines)
E633   20 AE E2     LC9:      JSR   h_num   ; the line (and it is dropped)
E636   A9 2C                  LDA   #","   
E638   20 03 FF               JSR   CONOUT   
E63B   38                     SEC      
E63C   A5 06                  LDA   PLACE   
E63E   E5 0A                  SBC   CL   
E640   48                     PHA      
E641   A5 07                  LDA   PLACE+1   
E643   E5 0B                  SBC   CL+1   
E645   A8                     TAY      
E646   68                     PLA      
E647   20 6C E1               JSR   pushay   
E64A   20 75 E2               JSR   inctos   ; + 1
E64D   20 AE E2               JSR   h_num   ; the column
E650   A0 09                  LDY   #M_NL-MSG   
E652   20 DA E2               JSR   prs   
E655   A0 00                  LDY   #0   ; the text at the place
E657   B1 06        ER1:      LDA   (PLACE),Y   
E659   F0 10                  BEQ   er2   
E65B   C9 0D                  CMP   #13   
E65D   F0 0C                  BEQ   er2   
E65F   C9 0A                  CMP   #10   
E661   F0 08                  BEQ   er2   
E663   20 03 FF               JSR   CONOUT   
E666   C8                     INY      
E667   C0 10                  CPY   #16   
E669   D0 EC                  BNE   er1   
E66B   A0 0B        ER2:      LDY   #M_STK-MSG   
E66D   20 DA E2               JSR   prs   ; CR LF "Stk "
E670   8A                     TXA      
E671   49 FF                  EOR   #0FFh   
E673   38                     SEC      
E674   E9 03                  SBC   #0FFh-DSE   ; the depth, DSE - X (FFh, an overflow: 253)
E676   48                     PHA      
E677   20 C2 E6               JSR   prnum8   
E67A   68                     PLA      
E67B   A0 16                  LDY   #M_C-MSG   ; ":"
E67D   C9 09                  CMP   #9   
E67F   90 04                  BCC   er3   
E681   A9 08                  LDA   #8   ; more than 8: ": ..." and the top 8
E683   A0 11                  LDY   #M_CD-MSG   
E685   85 06        ER3:      STA   T2   ; T2 = how many cells to show (the place
E687                             ;   is no longer needed)
E687   20 DA E2               JSR   prs   
E68A   20 76 E1               JSR   push   ; TOS into memory with the rest: cell i from
E68D                             ;   the top is at DSL+X+i now
E68D   A5 06        ER4:      LDA   T2   ; cells T2-1 down to 0, the top last
E68F   F0 1B                  BEQ   er5   
E691   C6 06                  DEC   T2   
E693   A9 20                  LDA   #" "   
E695   20 03 FF               JSR   CONOUT   
E698   8A                     TXA      
E699   18                     CLC      
E69A   65 06                  ADC   T2   
E69C   A8                     TAY      
E69D   B9 00 02               LDA   DSL,Y   
E6A0   48                     PHA      
E6A1   B9 00 03               LDA   DSH,Y   
E6A4   A8                     TAY      
E6A5   68                     PLA      
E6A6   20 C4 E6               JSR   prnum   
E6A9   4C 8D E6               JMP   er4   
E6AC   A0 17        ER5:      LDY   #M_RTN-MSG   
E6AE   20 DA E2               JSR   prs   ; CR LF "Rtn "
E6B1   AD 35 04               LDA   RSV   
E6B4   49 FF                  EOR   #0FFh   
E6B6   4A                     LSR      ; (FFh - S) / 2 entries
E6B7   20 C2 E6               JSR   prnum8   
E6BA   A0 09                  LDY   #M_NL-MSG   
E6BC   20 DA E2               JSR   prs   
E6BF   4C 09 FF               JMP   EXIT   
E6C2                             ; prnum: print the number A (low), Y (high), signed, keeping the data stack.
E6C2                             ; prnum8: the same for A alone, 0-255.
E6C2   A0 00        PRNUM8:   LDY   #0   
E6C4   20 6C E1     PRNUM:    JSR   pushay   
E6C7   4C AE E2               JMP   h_num   
E6CA                          ENDIF      


