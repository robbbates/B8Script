0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Spec: docs/b8script.md (2026-11-24).
0000                             ; 
0000                             ;  The switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    EDITOR   1 = with the line editor built in (see the end of this file):
0000                             ;                 the spec's suggested standard. It goes with either setting
0000                             ;                 of the other two.
0000                             ;    CHECKED  0 = no checks (spec: the programmer is responsible)
0000                             ;             1 = starts with every variable at 0 and every word undefined,
0000                             ;                 and stops on every error in the spec's table (and Ctrl-C)
0000                             ;                 with a three-line report: the letter and the place as line
0000                             ;                 and column, and both stacks. See `error`.
0000                             ;    SPEED    0 = small: the smallest build
0000                             ;             1 = base, the default: the speed-ups that cost bytes: a skip
0000                             ;                 cache, a faster skip, "*" and "/" quicker for small and
0000                             ;                 power-of-two operands, and more (see "Speed-ups")
0000                             ;             2 = fast: base and a dispatch table besides, with no size
0000                             ;                 limit (see "The fast build"). Not with EDITOR.
0000                             ;    ANSI     what the console escapes of "$" (/00bbIC8= /| /` /~) do:
0000                             ;             1 = send ANSI (VT100) sequences through CONOUT
0000                             ;             0 = call the machine's own routines CONCLS, CONEOL, CONCUR and
0000                             ;                 CONAT (see the equates). The CP/M builds always send ANSI.
0000                             ; 
0000                             ;  In every build Ctrl-C stops a running program (an unchecked build stops
0000                             ;  without a word): see the console layer for the rules, the held key and
0000                             ;  the break-off cell.
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   1   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   0   ; 1 = checked build
0000                EDITOR:   EQU   1   ; 1 = with the line editor
0000                ANSI:     EQU   0   ; 1 = the console escapes send ANSI sequences
0000                SPEED:    EQU   1   ; 0 = small, 1 = base, 2 = fast (not with EDITOR) (see "Speed-ups")
0000                FAST:     EQU   SPEED/2   ; (1: the fast build)
0000                SBASE:    EQU   SPEED-FAST*2   ; (1: the base build)
0000                ANS:      EQU   ANSI+CPM-ANSI*CPM   ; (CP/M: always ANSI)
0000                EDGEN:    EQU   EDITOR*(1-CPM)   ; (the generic build with the editor)
0000                             ; (IF takes any value but 0 as true, so
0000                             ;  IF CHECKED+EDITOR means "either")
0000                TABP0:    EQU   EDGEN*(1-CHECKED)   ; (the build with its table in page zero)
0000                PTLATE:   EQU   1-(1-CPM)*(1-EDITOR)*(1-CHECKED)*(1-ANS)   ; (1: the table goes after psgn and pdec,
0000                             ;   not before them: wherever it doesn't cross a
0000                             ;   page. chktab.py says if it does)
0000                QK:       EQU   SBASE+FAST-SBASE*FAST   ; (the speed-ups: base, or the fast build)
0000                SBASEU:   EQU   QK*(1-CHECKED)*(1-FAST)   ; (and those that only the unchecked
0000                             ;  builds take; the fast build has its own)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    IY   return-stack pointer. Entries are 2 bytes; the stack grows down.
0000                             ;         Only rpop and rpushn (and the checks) touch it. The alternate
0000                             ;         registers are not used at all: an interrupt routine may use them.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  One-byte calls. In a generic build the routines used most are reached
0000                             ;  with RST, one byte instead of three. The source writes them as macros:
0000                             ; 
0000                             ;    POPR   RST 08h  rpop    pop the return stack into DE
0000                             ;    DROP   RST 18h  drp     drop TOS, then next character  (ends a handler)
0000                             ;    NEGH   RST 20h  neg16   HL = -HL
0000                             ;    PUTA   RST 28h  putc    print A
0000                             ;    NEXT   RST 30h  next0   next character                 (ends a handler)
0000                             ; 
0000                             ;  RST 18h and RST 30h never return: an RST is a CALL, so the first thing
0000                             ;  each of them does is POP DE to throw the return address away.
0000                             ; 
0000                             ;  A CP/M build leaves page zero alone: there the macros are CALLs, and
0000                             ;  DROP and NEXT are jumps (DROPR and NEXTR: JR, where it reaches).
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (the top four bytes of the page are spare,
0000                             ;             so a full stack runs two bytes into the page below)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch, interpreter variables in the gaps, and the -n? line buffer
0000                             ;             at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack has a guard band: the data stack can
0000                             ;  overrun by a cell or two (and the calls made while it is full, the error
0000                             ;  report's included) into the top 32 bytes of the return-stack page, which
0000                             ;  are never used, and the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
0000                BDOS:     EQU   0005h   
0000                BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IF   CPM*(1-EDITOR)   
                    EXIT:     EQU   0000h   ; warm boot
0000                          ENDIF      
0000                          IFN   CPM   
                                 ; ---- generic machine: edit these to suit -----------------------------------
                    KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
                                 ;   waiting. The zero flag must match A
                                 ;   (end the routine with OR A / RET).
                    CONOUT:   EQU   0FF03h   ; print the character in A
                                 ;   KEY and CONOUT must preserve BC, DE, HL and IY.
0000                          ENDIF      
0000                          IF   1-ANS   
                                 ; With ANSI = 0 the console escapes call these. All four must keep BC and
                                 ; IY, and all but CONAT also HL. They may change A, DE and the flags.
                    CONCLS:   EQU   0FF0Ch   ; /{  clear the screen, the cursor to the top left
                    CONEOL:   EQU   0FF0Fh   ; /}  clear from the cursor to the end of the line
                    CONCUR:   EQU   0FF12h   ; /| and /`  show the cursor if A is not 0, hide
                                 ;     it if A = 0
                    CONAT:    EQU   0FF15h   ; /~  the cursor to row HL, column DE, both
                                 ;     counted from 0. May change A, DE and HL
0000                          ENDIF      
0000                          IFN   CPM   
                    RSPAGE:   EQU   80h   ; 8000h return stack
                    DSPAGE:   EQU   81h   ; 8100h data stack
                    LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
                    PROG:     EQU   8300h   ; where the loader puts the program text
                    HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
                    CPAGE:    EQU   HEAPLIM   ; the skip cache's page (QK builds): the page
                                 ;   at the heap limit, which the heap never reaches
                    BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)   
                    EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                          ENDIF      
0000                          IF   EDGEN   
                    LEAVE:    EQU   0FF09h   ; where the editor's ^X goes
0000                          ENDIF      
0000                          IF   EDITOR*CPM   
0000                LEAVE:    EQU   0000h   ; the editor's ^X: warm boot
0000                          ENDIF      
0000                          IF   EDITOR   
0000                EXIT:     EQU   edend   ; a program that ends goes back to the editor,
0000                SKEND:    EQU   skend   ;   also when it ends inside skip
0000                          ENDIF      
0000                          IF   1-EDITOR   
                    SKEND:    EQU   EXIT   
0000                          ENDIF      
0000                MSLOOP:   EQU   40-36*CPM   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine. (The wait
0000                             ; for a second Ctrl-C uses it too: 250 ms.)
0000                             ; CP/M: 4, for a BDOS 6 call of about 280 us
0000                             ; (an RC2014 with RomWBW and ZPM3). A .COM can
0000                             ; be patched: see TIMING.B8S.
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                             ;   around machine code (and in the checked
0000                             ;   build the address "$" prints from);
0000                PCNT:     EQU   LET+36h   ;   the break-key poll count (see rpushn);
0000                SKPL:     EQU   LET+3Ch   ;   the checked skip's starting place;
0000                NPEND:    EQU   LET+38h   ;   minus the address of the program's end
0000                             ;   (the heap"s first byte), for the checked "_';
0000                EDLN:     EQU   LET+3Ah   ;   the editor: the number of the line that ^E
0000                             ;   put in the input line (0: none)
0000                KEYBUF:   EQU   LET+7Ah   ; gap after z: a key read by the break check and
0000                             ;   held for the next "?" (0: none);
0000                BRKOFF:   EQU   LET+7Bh   ;   the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FCh   ; empty data stack. The four bytes above it
0000                             ; are spare: a character can pop two cells
0000                             ; too many before the checked build sees it,
0000                             ; and the next call must not land on the
0000                             ; letter cells.
0000                             ; The five one-byte calls. A generic build owns page zero and reaches them
0000                             ; with RST. A CP/M build must leave page zero alone (CP/M keeps it for
0000                             ; interrupts, and RomWBW's BIOS calls itself through RST 08h), so there each
0000                             ; is a CALL, or a jump for the two that never return: DROP is a JP, and
0000                             ; NEXT is JP (IX), two bytes, with IX holding next0's address throughout.
0000                             ; (asm80 can't nest IF, so these are written with DS: a count of 0 writes
0000                             ; nothing. DS can't take a label that comes later, but EQU can, and DS can
0000                             ; take that.)
0000                AROP:     EQU   rpop   
0000                ANEG:     EQU   neg16   
0000                APUT:     EQU   putc   
0000                APTK:     EQU   putk   
0000                          IF   1-CPM   
                    PUTK:     EQU   putc   ; (CP/M only: here it is never used)
0000                          ENDIF      
0000                ANXT:     EQU   next0   
0000                          IF   CHECKED   
                    ACHK:     EQU   chkstk   ; (for the fast build's dispatcher)
0000                          ENDIF      
0000                          IF   1-CHECKED   
0000                ACHK:     EQU   0   
0000                          ENDIF      
0000                          IF   FAST   
                    DTPG:     EQU   DTAB/256   ; (the fast build"s table"s first page)
0000                          ENDIF      
0000                          IF   1-FAST   
0000                DTPG:     EQU   0   
0000                          ENDIF      
0000                .macro POPR,
0000                             ; 
0000                 DS      1-CPM,0CFh      ;   RST 08h
0000                 DS      CPM,0CDh        ;   CALL rpop
0000                 DS      CPM,AROP&0FFh
0000                 DS      CPM,AROP/256
0000                .endm
0000                 
0000                .macro DROP,
0000                             ; 
0000                 DS      (1-CPM)*(1-FAST),0DFh ; RST 18h
0000                 DS      CPM+FAST-CPM*FAST,0E1h ; POP HL
0000                 DS      CPM+FAST-CPM*FAST,0DDh ; JP (IX)
0000                 DS      CPM+FAST-CPM*FAST,0E9h
0000                .endm
0000                 
0000                .macro NEGH,
0000                             ; 
0000                 DS      1-CPM,0E7h      ;   RST 20h
0000                 DS      CPM,0CDh        ;   CALL neg16
0000                 DS      CPM,ANEG&0FFh
0000                 DS      CPM,ANEG/256
0000                .endm
0000                 
0000                .macro PUTA,
0000                             ; 
0000                 DS      1-CPM,0EFh      ;   RST 28h
0000                 DS      CPM,0CDh        ;   CALL putc
0000                 DS      CPM,APUT&0FFh
0000                 DS      CPM,APUT/256
0000                .endm
0000                 
0000                .macro PUTK,
0000                             ; 
0000                 DS      1-CPM,3Eh       ;   LD A,%%1 / RST 28h
0000                 DS      1-CPM,%%1
0000                 DS      1-CPM,0EFh
0000                 DS      CPM,0CDh        ;   CALL putk / DB %%1
0000                 DS      CPM,APTK&0FFh
0000                 DS      CPM,APTK/256
0000                 DS      CPM,%%1
0000                .endm
0000                 
0000                .macro PUTAR,
0000                             ; 
0000                 DS      1-CPM,0EFh      ;   RST 28h
0000                 DS      1-CPM,0C9h      ;   RET
0000                 DS      CPM,0C3h        ;   JP putc
0000                 DS      CPM,APUT&0FFh
0000                 DS      CPM,APUT/256
0000                .endm
0000                 
0000                .macro NEXT,
0000                             ; 
0000                 DS      (1-CPM)*(1-FAST),0F7h ; RST 30h
0000                 DS      CPM+FAST-CPM*FAST,0DDh ; JP (IX): IX holds next0
0000                 DS      CPM+FAST-CPM*FAST,0E9h
0000                .endm
0000                 
0000                .macro NEXTF,
0000                             ; 
0000                 DS      FAST*CHECKED,0CDh ;   (fast build: CALL chkstk, checked)
0000                 DS      FAST*CHECKED,ACHK&0FFh
0000                 DS      FAST*CHECKED,ACHK/256
0000                 DS      FAST,0Ah        ;   (fast build: the dispatcher: LD A,(BC)
0000                 DS      FAST,03h        ;   INC BC
0000                 DS      FAST,0EBh       ;   EX DE,HL
0000                 DS      FAST,6Fh        ;   LD L,A
0000                 DS      FAST,26h        ;   LD H,DTAB/256
0000                 DS      FAST,DTPG
0000                 DS      FAST,7Eh        ;   LD A,(HL)
0000                 DS      FAST,24h        ;   INC H
0000                 DS      FAST,66h        ;   LD H,(HL)
0000                 DS      FAST,6Fh        ;   LD L,A
0000                 DS      FAST,0E9h       ;   JP (HL))
0000                .endm
0000                 
0000                .macro NEXTZ,
0000                             ; 
0000                 DS      1-CPM,0F7h      ;   byte there in every build (RST 30h)
0000                 DS      CPM,0DDh        ; JP (IX)
0000                 DS      CPM,0E9h
0000                .endm
0000                 
0000                .macro SETIX,
0000                             ; 
0000                 DS      CPM+FAST-CPM*FAST,0DDh ; a generic build): LD IX,next0
0000                 DS      CPM+FAST-CPM*FAST,21h
0000                 DS      CPM+FAST-CPM*FAST,ANXT&0FFh
0000                 DS      CPM+FAST-CPM*FAST,ANXT/256
0000                .endm
0000                 
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is just the start of the .COM file.
0000                             ; =============================================================================
0100                          .ORG   BASE   
0100                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              XOR   A   ; 00  reset. (This byte, AFh, is also what an
0100                          ENDIF      ;     undefined word runs into: see e_hi.)
0100                          IF   1-EDGEN   
0100   31 FC 0B               LD   SP,DSTOP   ; 00  reset, or the start of the .COM file
0103                          ENDIF      
0103                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)*(1-QK)   
                              LD   BC,PROG   ; 03  the IP
                              JR   st0   ; 06  (the rest of the startup is close by)
0103                          ENDIF      
0103                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)*QK   
                              JP   qstart   ; 03  (the skip cache is emptied first)
                              DW   0   ; 06  spare
0103                          ENDIF      
0103                          IF   (1-CPM)*(1-EDITOR)*CHECKED*(1-QK)   
                              JR   init   ; 04  (the rest of the startup is close by)
                              DW   0   ; 06  spare
0103                          ENDIF      
0103                          IF   (1-CPM)*(1-EDITOR)*CHECKED*QK   
                              JP   qinit   ; 04  (the skip cache is emptied first)
                              DB   0   ; 07  spare
0103                          ENDIF      
0103                          IF   EDGEN   
                              XOR   A   ; 00  reset: no program yet. (This byte, AFh,
                              LD   (PROG),A   ;     is also what an undefined word runs
                              JP   init   ; 04  into in the checked build: see e_hi.)
                              NOP      ; 07  spare
0103                          ENDIF      
0103                          IF   CPM*(1-EDITOR)   
                              JP   start   ; 03
0103                          ENDIF      
0103                          IF   CPM*EDITOR*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
                                 ; is held back.
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
0103                          ENDIF      
0103                          IF   CPM*EDITOR   
0103   CD 18 08               CALL   load   ; the file named on the command line
0106   C3 C7 05               JP   edit0   
0109                          ENDIF      
0109                          IF   1-CPM   
                                 ; ---- RST 08h: rpop: pop the return stack into DE ---------------------------
                    RPOP:     LD   E,(IY+0)   ; 08
                              LD   D,(IY+1)   
                              JR   rp2   ; (the rest is at 2Bh)
                                 ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
                    CTL:      ADD   A,21h   ; 10  back to c; zero only for NUL
                              JR   NZ,next0   ;     the rest are ignored
                    ENDPROG:   JP   EXIT   ;     the program has ended
                              NOP      ; 17  spare
                                 ; ---- RST 18h: drop TOS, then next ------------------------------------------
                    RST18:    POP   DE   ; 18  discard the RST's return address
                    DRP:      POP   HL   ;     new TOS = NOS
                              JR   next0   
0109                          ENDIF      
0109   E5           H_FROMR:   PUSH   HL   ; 1C  "}" return stack to TOS
010A                          ;*Macro unroll:  POPR
010A                          DS   1-CPM,0CFh   
010A   CD                     DS   CPM,0CDh   
010B   5F                     DS   CPM,AROP&0FFh   
010C   05                     DS   CPM,AROP/256   
010D   EB                     EX   DE,HL   
010E                          ;*Macro unroll:  NEXTZ
010E                          DS   1-CPM,0F7h   
010E   DD                     DS   CPM,0DDh   
010F   E9                     DS   CPM,0E9h   
0110                          IF   1-CPM   
                                 ; ---- RST 20h: neg16: HL = -HL (keeps BC, DE) -------------------------------
                    NEG16:    XOR   A   ; 20
                              SUB   L   
                              LD   L,A   
                              SBC   A,A   
                              SUB   H   
                              LD   H,A   
                              RET      
                              NOP      ; 27  spare
                                 ; ---- RST 28h: putc: print A (keeps BC, DE, HL, IY) -------------------------
                    RST28:       
                    PUTC:     JP   CONOUT   ; 28
                    RP2:      INC   IY   ; 2B  the rest of rpop
                              INC   IY   
                              RET      
                                 ; ---- RST 30h: next character -----------------------------------------------
                    RST30:    POP   DE   ; 30  discard the RST's return address
0110                          ENDIF      
0110                          IF   CPM   
0110                             ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
0110   C6 21        CTL:      ADD   A,21h   ; back to c; zero only for NUL
0112   20 03                  JR   NZ,next0   ; the rest are ignored
0114   C3 D0 05     ENDPROG:   JP   EXIT   ; the program has ended
0117                          ENDIF      
0117                             ; =============================================================================
0117                             ;  The inner loop: read one character and sort it by range.
0117                             ; 
0117                             ;    00h          end of program
0117                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0117                             ;    30h-39h      digit: read a whole number
0117                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0117                             ;    61h-7Ah      a-z: push the address of that letter's cell
0117                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0117                             ; =============================================================================
0117                          IF   FAST   
                              ;*Macro unroll: next0:  NEXTF                   ; (the fast build: the table dispatcher)
                    NEXT0:    DS   FAST*CHECKED,0CDh   ; (the fast build: the table dispatcher)
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
0117                          ENDIF      
0117                          IF   1-FAST   
0117                NEXT0:       
0117                          ENDIF      
0117                          IF   CHECKED*(1-FAST)   
                              CALL   chkstk   ; both stacks are checked once per character
0117                          ENDIF      
0117                          IF   1-FAST   
0117   0A                     LD   A,(BC)   
0118   03                     INC   BC   
0119   D6 21                  SUB   21h   ; A = c - 21h
011B   38 F3                  JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
011D   FE 0F                  CP   0Fh   
011F   38 22                  JR   C,punct   ; 21h-2Fh: PTAB index 0-14
0121   D6 0F                  SUB   0Fh   ; A = c - 30h
0123   FE 0A                  CP   0Ah   
0125   38 61                  JR   C,digit   ; 30h-39h
0127   FE 11                  CP   11h   
0129   38 16                  JR   C,p3a   ; 3Ah-40h
012B   D6 11                  SUB   11h   ; A = c - 41h
012D   FE 1A                  CP   1Ah   
012F   38 61                  JR   C,upper   ; 41h-5Ah: A = letter index 0-25
0131   FE 20                  CP   20h   
0133   38 0A                  JR   C,p5b   ; 5Bh-60h
0135   FE 3A                  CP   3Ah   
0137   38 56                  JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0139   FE 3E                  CP   3Eh   
013B                          ENDIF      
013B                          IF   (1-CHECKED)*(1-FAST)   
013B   30 DA                  JR   NC,next0   ; 7Fh-FFh: ignored
013D                          ENDIF      
013D                          IF   CHECKED*(1-FAST)   
                              JR   Z,next0   ; 7Fh, DEL: ignored
                              JP   NC,e_hi   ; 80h-FFh: reserved
013D                          ENDIF      
013D                          IF   1-FAST   
013D   D6 1A                  SUB   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
013F   D6 09        P5B:      SUB   9   ; 5Bh-60h: -4 in all, index 22-27
0141   C6 05        P3A:      ADD   A,5   ; 3Ah-40h: index 15-21
0143                          ENDIF      
0143                .macro PTABLE,
0143                             ; 
0143                 DB      h_store & 0FFh  ; !
0143                 DB      h_str & 0FFh    ; "
0143                 DB      h_num & 0FFh    ; #
0143                 DB      h_print & 0FFh  ; $
0143                 DB      h_swap & 0FFh   ; %
0143                 DB      h_and & 0FFh    ; &
0143                 DB      h_emit & 0FFh   ; '
0143                 DB      h_open & 0FFh   ; (
0143                 DB      h_close & 0FFh  ; )
0143                 DB      h_mul & 0FFh    ; *
0143                 DB      h_add & 0FFh    ; +
0143                 DB      h_cfetch & 0FFh ; ,
0143                 DB      h_sub & 0FFh    ; -
0143                 DB      h_cstore & 0FFh ; .
0143                 DB      h_div & 0FFh    ; /
0143                 DB      h_dup & 0FFh    ; :
0143                 DB      h_drop & 0FFh   ; ;
0143                 DB      h_lt & 0FFh     ; <
0143                 DB      h_eq & 0FFh     ; =
0143                 DB      h_gt & 0FFh     ; >
0143                 DB      h_key & 0FFh    ; ?
0143                 DB      h_fetch & 0FFh  ; @
0143                 DB      h_def & 0FFh    ; [
0143                 DB      h_break & 0FFh  ; \
0143                 DB      h_ret & 0FFh    ; ]
0143                 DB      h_xor & 0FFh    ; ^
0143                 DB      h_alloc & 0FFh  ; _
0143                 DB      h_grave & 0FFh  ; `
0143                 DB      h_tor & 0FFh    ; {
0143                 DB      h_or & 0FFh     ; |
0143                 DB      h_fromr & 0FFh  ; }
0143                 DB      h_not & 0FFh    ; ~
0143                .endm
0143                 
0143                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
0143                             ; untouched, and A, DE free.
0143                          IF   1-FAST   
0143   C6 01        PUNCT:    ADD   A,PTAB & 0FFh   ; PTAB never crosses a page
0145   5F                     LD   E,A   
0146   16 05                  LD   D,PTAB / 256   ; (0 if the table is in page zero)
0148   FE 17                  CP   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
014A   1A                     LD   A,(DE)   
014B   5F                     LD   E,A   ; the handler's low byte
014C                          ENDIF      
014C                          IF   (1-CPM)*(1-TABP0)*(1-FAST)   
                              LD   D,0   
014C                          ENDIF      
014C                          IF   (1-CPM)*(1-FAST)   
                              RL   D   ; its page: 0 + carry
014C                          ENDIF      
014C                          IF   CPM*(1-FAST)   
014C   16 01                  LD   D,1   
014E   30 01                  JR   NC,pu1   
0150   14                     INC   D   ; its page: 1 + carry
0151                PU1:         
0151                          ENDIF      
0151                          IF   1-FAST   
0151   D5                     PUSH   DE   ; jump to it; the stack is balanced again
0152   C9                     RET      ;   when the handler starts
0153                          ENDIF      
0153                             ; The rest of the startup: here so that the generic reset code can reach it
0153                             ; with JR. st0: find the program's NUL; the heap starts after it.
0153                             ; (The editor build has its own copy of this, next to the editor.)
0153                             ; A checked build first clears the lower half of the letter page (A = 0):
0153                             ; every variable starts at 0, every word cell holds 0000h, the address an
0153                             ; undefined word is caught at (see e_hi), and no key is held back.
0153                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                    INIT:     LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
                              LD   BC,PROG   ; the IP
0153                          ENDIF      
0153                          IF   (1-CPM)*(1-EDITOR)   
                    ST0:      LD   H,B   
                              LD   L,C   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
0153                          ENDIF      
0153                          IF   1-EDITOR   
                    ST2:      LD   (HEAP),HL   
0153                          ENDIF      
0153                          IF   CHECKED*(1-EDITOR)   
                              ;*Macro unroll:  NEGH                    ; minus the heap's first address: '_' may not
                              DS   1-CPM,0E7h   ; minus the heap"s first address: "_' may not
                              DS   CPM,0CDh   
                              DS   CPM,ANEG&0FFh   
                              DS   CPM,ANEG/256   
                              LD   (NPEND),HL   ;   release below it
0153                          ENDIF      
0153                          IF   (1-CHECKED)*(1-EDITOR)*(1-CPM)   
                              LD   H,A   ; (A = 0) no key is held, and the break key
                              LD   L,A   ;   is on (the checked build has cleared
0153                          ENDIF      ;   these)
0153                          IF   (1-CHECKED)*(1-EDITOR)*CPM   
                              LD   HL,0   
0153                          ENDIF      
0153                          IF   (1-CHECKED)*(1-EDITOR)   
                              LD   (KEYBUF),HL   
0153                          ENDIF      
0153                          IF   1-EDITOR   
                              ;*Macro unroll:  SETIX
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,21h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
                              LD   IY,RSTOP   ; the return stack is empty
                              ;*Macro unroll:  NEXT                    ; (its return address is thrown away)
                              DS   (1-CPM)*(1-FAST),0F7h   ; (its return address is thrown away)
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
0153                          ENDIF      
0153                             ; In the unchecked generic editor build the table is here, in the first
0153                             ; page, which saves loading D twice. (The other builds have no room for it
0153                             ; here: theirs is further down.)
0153                          IF   TABP0   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0153                          ENDIF      
0153                             ; =============================================================================
0153                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
0153                             ;  (00bbIGFuZCA= are up among the RST routines.) The machine-code call, exec,
0153                             ;  is here too: it belongs to "`" and makes the page come out right.
0153                             ; =============================================================================
0153   D1           H_XOR:    POP   DE   
0154   7C                     LD   A,H   
0155   AA                     XOR   D   
0156   67                     LD   H,A   
0157   7D                     LD   A,L   
0158   AB                     XOR   E   
0159   6F                     LD   L,A   
015A                          ;*Macro unroll:  NEXT
015A                          DS   (1-CPM)*(1-FAST),0F7h   
015A   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
015B   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
015C   D1           H_OR:     POP   DE   
015D   7C                     LD   A,H   
015E   B2                     OR   D   
015F   67                     LD   H,A   
0160   7D                     LD   A,L   
0161   B3                     OR   E   
0162   6F                     LD   L,A   
0163                          ;*Macro unroll:  NEXT
0163                          DS   (1-CPM)*(1-FAST),0F7h   
0163   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0164   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0165                          ;*Macro unroll: h_not:  NEGH                    ; ~x = -x - 1
0165                H_NOT:    DS   1-CPM,0E7h   ; ~x = -x - 1
0165   CD                     DS   CPM,0CDh   
0166   6A                     DS   CPM,ANEG&0FFh   
0167   05                     DS   CPM,ANEG/256   
0168   2B                     DEC   HL   
0169                          ;*Macro unroll:  NEXT
0169                          DS   (1-CPM)*(1-FAST),0F7h   
0169   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
016A   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
016B                             ; "_" ( n -- addr ): the heap pointer moves by n, a signed count (the add is
016B                             ; the same either way); TOS is the old pointer.
016B   ED 5B 7C 0C  H_ALLOC:   LD   DE,(HEAP)   
016F                          IF   CHECKED*CPM   
                              LD   A,H   ; the count's sign, for chkhp
016F                          ENDIF      
016F   19                     ADD   HL,DE   ; the new top
0170                          IF   CHECKED   
                              CALL   chkhp   
0170                          ENDIF      
0170   22 7C 0C               LD   (HEAP),HL   
0173   EB                     EX   DE,HL   
0174                          ;*Macro unroll:  NEXT
0174                          DS   (1-CPM)*(1-FAST),0F7h   
0174   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0175   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0176                          IF   1-CPM*CHECKED   
0176   FD 22 34 0C  EXEC:     LD   (RSAVE),IY   ; machine code may change IX and IY
017A   CD B5 01               CALL   jphl   
017D   FD 2A 34 0C            LD   IY,(RSAVE)   
0181                          ;*Macro unroll:  SETIX
0181   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0182   21                     DS   CPM+FAST-CPM*FAST,21h   
0183   17                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
0184   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
0185   E1                     POP   HL   
0186                          ;*Macro unroll:  NEXT
0186                          DS   (1-CPM)*(1-FAST),0F7h   
0186   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0187   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0188                          ENDIF      
0188                             ; ---- the letters and digits (here, in the middle, so that the inner loop's
0188                             ; ---- short jumps reach them, and the handlers after them reach rpushn) ------
0188                             ; Digits: step back onto the first digit and read the whole number.
0188   E5           DIGIT:    PUSH   HL   
0189   0B                     DEC   BC   
018A   CD CD 03               CALL   rdnum   
018D                          ;*Macro unroll:  NEXT
018D                          DS   (1-CPM)*(1-FAST),0F7h   
018D   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
018E   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
018F                             ; a-z: push the cell's address (the cell is the variable)
018F                             ;  (the unchecked builds with room do x@ and x! in one step: lowq)
018F                          IF   1-SBASEU   
                    LOWER:    PUSH   HL   
                              ADD   A,A   
                              LD   L,A   
                              LD   H,LETPAGE   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
018F                          ENDIF      
018F                          IF   SBASEU   
018F   C3 AF 04     LOWER:    JP   lowq   
0192                          ENDIF      
0192                             ; A-Z: call the word. The return address (the IP after the letter) goes on
0192                             ; the return stack, and the IP becomes the address in the letter's cell.
0192   C5           UPPER:    PUSH   BC   ; the return address, for rpushn
0193   EB                     EX   DE,HL   ; park TOS
0194   87                     ADD   A,A   
0195   6F                     LD   L,A   
0196   26 0C                  LD   H,LETPAGE   ; HL -> cell
0198   4E                     LD   C,(HL)   
0199   2C                     INC   L   
019A   46                     LD   B,(HL)   ; IP = the word's body
019B   EB                     EX   DE,HL   ; TOS back, and fall into rpushn
019C                             ; rpushn: move the top cell of the data stack (in memory) to the return
019C                             ; stack, then next. Everything that pushes the return stack ends here.
019C                             ; 
019C                             ; The break key is looked at here, so at every word call and loop-back (and
019C                             ; block entry and "{"), but only one time in 256: PCNT counts them.
019C                             ; Reading the keyboard can be slow (it is a BDOS call under CP/M).
019C   D1           RPUSHN:   POP   DE   
019D   FD 72 FF               LD   (IY-1),D   
01A0   FD 73 FE               LD   (IY-2),E   
01A3   FD 2B                  DEC   IY   
01A5   FD 2B                  DEC   IY   
01A7   E5                     PUSH   HL   
01A8   21 36 0C               LD   HL,PCNT   
01AB   35                     DEC   (HL)   
01AC   E1                     POP   HL   ; (the zero flag lasts)
01AD   CC 21 05               CALL   Z,pollk   
01B0                          ;*Macro unroll:  NEXT
01B0                          DS   (1-CPM)*(1-FAST),0F7h   
01B0   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
01B1   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
01B2                             ; "{" TOS to the return stack: the new TOS comes up, the old one goes across.
01B2   E3           H_TOR:    EX   (SP),HL   
01B3   18 E7                  JR   rpushn   
01B5   E9           JPHL:     JP   (HL)   ; (for the machine-code call)
01B6                             ; ---- machine code: the grave -----------------------------------------------
01B6                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
01B6                             ; are stored from addr until a non-hex character; then a RET (C9h) is
01B6                             ; written and its address is left. An odd last digit is consumed and dropped.
01B6                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
01B6                             ; code is entered by CALL with the data stack above the return address; it
01B6                             ; must keep BC, and on return the top cell becomes the new TOS.
01B6   CD D1 04     H_GRAVE:   CALL   hexc   
01B9                          IF   1-CPM*CHECKED   
01B9   30 BB                  JR   NC,exec   
01BB                          ENDIF      
01BB                          IF   CPM*CHECKED   
                              JP   NC,exec   ; (out of the way: see rpop)
01BB                          ENDIF      
01BB   77           HX1:      LD   (HL),A   ; the high digit goes in first ...
01BC   CD D1 04               CALL   hexc   
01BF   30 08                  JR   NC,hx2   ; odd digit: consumed, and the RET below
01C1   ED 6F                  RLD      ;   overwrites it
01C3   23                     INC   HL   ; ... and RLD shifts it up under the low one
01C4   CD D1 04               CALL   hexc   
01C7   38 F2                  JR   C,hx1   
01C9   36 C9        HX2:      LD   (HL),0C9h   ; (never range-checked: the spec says so)
01CB                          ;*Macro unroll:  NEXT
01CB                          DS   (1-CPM)*(1-FAST),0F7h   
01CB   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
01CC   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
01CD                             ; ---- where the two pages meet ----------------------------------------------
01CD                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
01CD                             ; are in falling code order for this), and where exactly differs between the
01CD                             ; builds: NPG1 follows. Every handler below these four must start in the
01CD                             ; second page, and every one above in the first; chktab.py checks both.
01CD                             ; "]" returns: pop an address and jump to it.
01CD                          ;*Macro unroll: h_ret:  POPR
01CD                H_RET:    DS   1-CPM,0CFh   
01CD   CD                     DS   CPM,0CDh   
01CE   5F                     DS   CPM,AROP&0FFh   
01CF   05                     DS   CPM,AROP/256   
01D0   42                     LD   B,D   
01D1   4B                     LD   C,E   
01D2                          ;*Macro unroll: brk1:   NEXT
01D2                BRK1:     DS   (1-CPM)*(1-FAST),0F7h   
01D2   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
01D3   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
01D4                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
01D4                             ; drops the block start, "]" returns. No closer at all ends the program.
01D4   7C           H_BREAK:   LD   A,H   
01D5   B5                     OR   L   
01D6   E1                     POP   HL   
01D7   28 F9                  JR   Z,brk1   
01D9   CD EF 03               CALL   skip   
01DC   B7                     OR   A   ; skip returns 0 for ")"
01DD   20 EE                  JR   NZ,h_ret   
01DF                          ;*Macro unroll: rdrop:  POPR
01DF                RDROP:    DS   1-CPM,0CFh   
01DF   CD                     DS   CPM,0CDh   
01E0   5F                     DS   CPM,AROP&0FFh   
01E1   05                     DS   CPM,AROP/256   
01E2                          ;*Macro unroll:  NEXT
01E2                          DS   (1-CPM)*(1-FAST),0F7h   
01E2   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
01E3   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
01E4                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
01E4                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
01E4                             ; the body"s address instead. Either way it then skips to the matching "]'.
01E4                             ; (The unchecked build takes anything that is not a letter as the space; the
01E4                             ; checked build stops on it.)
01E4   0A           H_DEF:    LD   A,(BC)   
01E5   03                     INC   BC   
01E6   D6 41                  SUB   "A"   ; a letter gives 0-25 or 32-57: lowercase
01E8   5F                     LD   E,A   ;   lands 64 bytes up
01E9   E6 DF                  AND   0DFh   ; fold case
01EB   FE 1A                  CP   26   
01ED   30 0B                  JR   NC,def2   ; not a letter
01EF   CB 23                  SLA   E   
01F1   16 0C                  LD   D,LETPAGE   ; DE -> cell
01F3   79                     LD   A,C   
01F4   12                     LD   (DE),A   
01F5   1C                     INC   E   
01F6   78                     LD   A,B   
01F7   12                     LD   (DE),A   
01F8   18 03                  JR   skipnx   
01FA                DEF2:        
01FA                          IF   CHECKED   
                              LD   A,E   
                              CP   " "-"A"+256   
                              JP   NZ,e_brack   ; anything but a letter or a space
01FA                          ENDIF      
01FA   E5                     PUSH   HL   ; an anonymous block: push its address
01FB   60                     LD   H,B   
01FC   69                     LD   L,C   
01FD                SKIPNX:      
01FD                          IF   CHECKED   
                              DEC   BC   ; back onto the letter, so that skip finds its
01FD                          ENDIF      ;   opener, the "[", just before where it starts
01FD   CD EF 03     SKIPO:    CALL   skip   
0200                          ;*Macro unroll:  NEXT
0200                          DS   (1-CPM)*(1-FAST),0F7h   
0200   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0201   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0202   5E           H_FETCH:   LD   E,(HL)   ; "@"
0203   23                     INC   HL   
0204   56                     LD   D,(HL)   
0205   EB                     EX   DE,HL   
0206                          ;*Macro unroll:  NEXT
0206                          DS   (1-CPM)*(1-FAST),0F7h   
0206   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0207   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0208                             ; =============================================================================
0208                             ;  Handlers that must start in the image's second page.
0208                             ;  "?" is the last (with "," inside it), so its long tail may run past that
0208                             ;  page.
0208                             ; =============================================================================
0208                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
0208                             ; the matching ")".
0208   7C           H_OPEN:   LD   A,H   
0209   B5                     OR   L   
020A   E1                     POP   HL   
020B   28 F0                  JR   Z,skipo   
020D   C5                     PUSH   BC   ; the block starts at the IP
020E   18 8C                  JR   rpushn   
0210                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
0210                             ; drops it and carries on.
0210   7C           H_CLOSE:   LD   A,H   
0211   B5                     OR   L   
0212   E1                     POP   HL   
0213   28 CA                  JR   Z,rdrop   
0215                          IF   QK   
0215   C3 9E 04               JP   closeq   ; (out of the handlers' pages: see Speed-ups)
0218                          ENDIF      
0218                          IF   1-QK   
                              ;*Macro unroll:  POPR                    ; pop the block start ...
                              DS   1-CPM,0CFh   ; pop the block start ...
                              DS   CPM,0CDh   
                              DS   CPM,AROP&0FFh   
                              DS   CPM,AROP/256   
                              LD   B,D   
                              LD   C,E   
                              PUSH   BC   
0218                          ENDIF      
0218                          IF   (1-QK)*(1-CPM)   
                              JR   rpushn   ; ... and push it back
0218                          ENDIF      
0218                          IF   (1-QK)*CPM   
                              JP   rpushn   
0218                          ENDIF      
0218                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
0218                             ; "-" has two jobs: directly before a digit it starts a negative number.
0218   0A           H_SUB:    LD   A,(BC)   
0219   D6 30                  SUB   "0"   
021B   FE 0A                  CP   10   
021D   38 07                  JR   C,negnum   
021F                          ;*Macro unroll:  NEGH                    ; a - b = a + (-b): fall into '+'
021F                          DS   1-CPM,0E7h   ; a - b = a + (-b): fall into "+"
021F   CD                     DS   CPM,0CDh   
0220   6A                     DS   CPM,ANEG&0FFh   
0221   05                     DS   CPM,ANEG/256   
0222   D1           H_ADD:    POP   DE   
0223   19                     ADD   HL,DE   
0224                          ;*Macro unroll:  NEXT
0224                          DS   (1-CPM)*(1-FAST),0F7h   
0224   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0225   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0226   E5           NEGNUM:   PUSH   HL   ; a negative number: read it, negate it
0227   CD CD 03               CALL   rdnum   
022A                          ;*Macro unroll:  NEGH
022A                          DS   1-CPM,0E7h   
022A   CD                     DS   CPM,0CDh   
022B   6A                     DS   CPM,ANEG&0FFh   
022C   05                     DS   CPM,ANEG/256   
022D                          ;*Macro unroll:  NEXT
022D                          DS   (1-CPM)*(1-FAST),0F7h   
022D   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
022E   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
022F   D1           H_AND:    POP   DE   
0230   7C                     LD   A,H   
0231   A2                     AND   D   
0232   67                     LD   H,A   
0233   7D                     LD   A,L   
0234   A3                     AND   E   
0235   6F                     LD   L,A   
0236                          ;*Macro unroll:  NEXT
0236                          DS   (1-CPM)*(1-FAST),0F7h   
0236   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0237   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0238                             ; Signed compares. Both are "HL < DE" for the right pair: "<" swaps the two
0238                             ; cells first. Flipping both sign bits turns a signed compare into an
0238                             ; unsigned one (and XOR clears the carry for SBC); SBC HL,HL then turns the
0238                             ; carry into -1 or 0 with no branch.
0238   E3           H_LT:     EX   (SP),HL   ; a < b: HL = a, and b is popped next
0239   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
023A   7C                     LD   A,H   
023B   EE 80                  XOR   80h   
023D   67                     LD   H,A   
023E   7A                     LD   A,D   
023F   EE 80                  XOR   80h   
0241   57                     LD   D,A   
0242   ED 52                  SBC   HL,DE   ; carry if HL < DE
0244   ED 62        TF:       SBC   HL,HL   ; carry -> -1 or 0
0246                          ;*Macro unroll:  NEXT
0246                          DS   (1-CPM)*(1-FAST),0F7h   
0246   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0247   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0248   D1           H_EQ:     POP   DE   
0249   B7                     OR   A   
024A   ED 52                  SBC   HL,DE   
024C   7C                     LD   A,H   
024D   B5                     OR   L   
024E   FE 01                  CP   1   ; carry only if a - b = 0
0250   18 F2                  JR   tf   
0252                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept. The
0252                             ; multiplier shifts up through A:C.
0252                          IF   1-QK   
                    H_MUL:    POP   DE   ; DE = multiplicand
                              PUSH   BC   
                              LD   A,H   
                              LD   C,L   ; A:C = multiplier
                              LD   HL,0   
                              LD   B,16   
                    MUL1:     ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mul2   
                              ADD   HL,DE   
                    MUL2:     DJNZ   mul1   
                              POP   BC   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
0252                          ENDIF      
0252                          IF   QK   
0252   D1           H_MUL:    POP   DE   ; DE = multiplicand
0253   C3 70 04               JP   mulq   ; (out of the handlers' pages: see Speed-ups)
0256                          ENDIF      
0256                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
0256                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
0256                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
0256                             ; stops on it.
0256                H_DIV:       
0256                          IF   CHECKED   
                              LD   A,H   
                              OR   L   
                              JP   Z,e_zero   
0256                          ENDIF      
0256   D1                     POP   DE   ; DE = a, HL = b
0257   D5                     PUSH   DE   ; a, for r's sign
0258   7A                     LD   A,D   
0259   AC                     XOR   H   
025A   F5                     PUSH   AF   ; S flag = sign of q
025B   CB 7C                  BIT   7,H   
025D   C4 6A 05               CALL   NZ,neg16   ; HL = |b|
0260   EB                     EX   DE,HL   
0261   CB 7C                  BIT   7,H   
0263   C4 6A 05               CALL   NZ,neg16   ; HL = |a|, DE = |b|
0266   CD 78 03               CALL   udiv   ; HL = q, DE = r
0269   F1                     POP   AF   
026A   FC 6A 05               CALL   M,neg16   ; q's sign
026D   EB                     EX   DE,HL   ; HL = r, DE = q
026E   F1                     POP   AF   ; A = a's high byte
026F   B7                     OR   A   
0270   FC 6A 05               CALL   M,neg16   ; r's sign
0273   D5                     PUSH   DE   ; q under r
0274                          ;*Macro unroll:  NEXT
0274                          DS   (1-CPM)*(1-FAST),0F7h   
0274   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0275   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0276                             ; ---- stack and storage -----------------------------------------------------
0276   E5           H_DUP:    PUSH   HL   ; ":"
0277                          ;*Macro unroll:  NEXT
0277                          DS   (1-CPM)*(1-FAST),0F7h   
0277   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0278   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0279   E3           H_SWAP:   EX   (SP),HL   ; "%"
027A                          ;*Macro unroll:  NEXT
027A                          DS   (1-CPM)*(1-FAST),0F7h   
027A   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
027B   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
027C                             ; (The checked build tests the address before it takes the value off the
027C                             ; stack, so that an error report shows both.)
027C                H_CSTORE:      ; "." ( c addr -- )
027C                          IF   CHECKED   
                              CALL   chkst   
027C                          ENDIF      
027C   D1                     POP   DE   
027D   73                     LD   (HL),E   
027E                          ;*Macro unroll: h_drop: DROP                    ; ';' is this one byte
027E                H_DROP:   DS   (1-CPM)*(1-FAST),0DFh   ; ";" is this one byte
027E   E1                     DS   CPM+FAST-CPM*FAST,0E1h   
027F   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0280   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0281                H_STORE:      ; "!" ( n addr -- )
0281                          IF   CHECKED   
                              CALL   chkst   
0281                          ENDIF      
0281   D1                     POP   DE   
0282   73                     LD   (HL),E   
0283   23                     INC   HL   
0284   72                     LD   (HL),D   
0285                          ;*Macro unroll:  DROP
0285                          DS   (1-CPM)*(1-FAST),0DFh   
0285   E1                     DS   CPM+FAST-CPM*FAST,0E1h   
0286   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0287   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0288                             ; ---- console ---------------------------------------------------------------
0288                             ; 22h pushes the address of the text after it and skips the string.
0288   E5           H_STR:    PUSH   HL   
0289   60                     LD   H,B   
028A   69                     LD   L,C   
028B   CD E4 03               CALL   skipstr   
028E                          IF   CHECKED   
                              OR   A   ; 0: the text ran out before the closing quote
                              JP   Z,e_quote   
028E                          ENDIF      
028E                          ;*Macro unroll:  NEXT
028E                          DS   (1-CPM)*(1-FAST),0F7h   
028E   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
028F   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0290                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
0290                             ; 60h to 7Eh is one of the escapes at pesc; "/" plus any other character
0290                             ; clears that character"s bit 6 (/M is CR, and / then DEL gives "?"; "/',
0290                             ; '"' and '?' have no bit 6, so //, /" and /? give themselves).
0290                          IF   1-CHECKED   
0290   7E           H_PRINT:   LD   A,(HL)   
0291   23                     INC   HL   
0292   FE 22                  CP   22h   
0294   28 19                  JR   Z,pr9   
0296   FE 2F                  CP   "/"   
0298   20 0C                  JR   NZ,pr1   
029A   7E                     LD   A,(HL)   
029B   23                     INC   HL   
029C   FE 60                  CP   60h   
029E   38 04                  JR   C,pr0   
02A0   FE 7F                  CP   7Fh   
02A2   38 63                  JR   C,pesc   
02A4   E6 BF        PR0:      AND   0BFh   
02A6                          ;*Macro unroll: pr1:    PUTA
02A6                PR1:      DS   1-CPM,0EFh   
02A6   CD                     DS   CPM,0CDh   
02A7   79                     DS   CPM,APUT&0FFh   
02A8   05                     DS   CPM,APUT/256   
02A9   18 E5                  JR   h_print   
02AB                PRLOOP:   EQU   h_print   ; (where the escapes go back to)
02AB                PRAGAIN:   EQU   h_print   ; (and where /~ goes back to)
02AB                          ENDIF      
02AB                          IF   CHECKED   
                                 ; (The checked build has the loop as a routine, prstr, which the error
                                 ; report uses too. The address is kept meanwhile, for a report: it shows
                                 ; the stack as it was before the "$". /~ comes back to hp1.)
                    H_PRINT:   LD   (RSAVE),HL   
                    HP1:      CALL   prstr   
                              ;*Macro unroll:  DROP
                              DS   (1-CPM)*(1-FAST),0DFh   
                              DS   CPM+FAST-CPM*FAST,0E1h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
02AB                          ENDIF      
02AB   7D           H_EMIT:   LD   A,L   ; "'"
02AC                          ;*Macro unroll:  PUTA
02AC                          DS   1-CPM,0EFh   
02AC   CD                     DS   CPM,0CDh   
02AD   79                     DS   CPM,APUT&0FFh   
02AE   05                     DS   CPM,APUT/256   
02AF                          ;*Macro unroll: pr9:    DROP
02AF                PR9:      DS   (1-CPM)*(1-FAST),0DFh   
02AF   E1                     DS   CPM+FAST-CPM*FAST,0E1h   
02B0   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
02B1   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
02B2                             ; "#" prints TOS as a signed decimal number, with no space after it.
02B2   CD E3 04     H_NUM:    CALL   psgn   
02B5                          ;*Macro unroll:  DROP
02B5                          DS   (1-CPM)*(1-FAST),0DFh   
02B5   E1                     DS   CPM+FAST-CPM*FAST,0E1h   
02B6   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
02B7   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
02B8                             ; "?" ( n -- c ) or ( -n -- addr )
02B8                             ;   n > 0: wait about n ms for a key; 0 if none came
02B8                             ;   n = 0: wait for a key
02B8                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
02B8                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
02B8   CB 7C        H_KEY:    BIT   7,H   
02BA   20 1A                  JR   NZ,line   
02BC   1E 04        KT1:      LD   E,MSLOOP   ; one millisecond, roughly
02BE   CD 4F 05     KT2:      CALL   getk   
02C1   20 0E                  JR   NZ,kt3   
02C3   1D                     DEC   E   
02C4   20 F8                  JR   NZ,kt2   
02C6   7C                     LD   A,H   ; 0? never counts down: it waits
02C7   B5                     OR   L   
02C8   28 F2                  JR   Z,kt1   
02CA   2B                     DEC   HL   
02CB   7C                     LD   A,H   
02CC   B5                     OR   L   
02CD   20 ED                  JR   NZ,kt1   ; A = 0 if the time ran out
02CF   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
02D0   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
02D1   6F           KT3:      LD   L,A   
02D2   26 00                  LD   H,0   
02D4                          ;*Macro unroll:  NEXT
02D4                          DS   (1-CPM)*(1-FAST),0F7h   
02D4   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
02D5   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
02D6                             ; Backspace takes the last character back (and is echoed as it
02D6                             ; is), CR ends (stored, not echoed), every other key is stored and
02D6                             ; echoed until the line is full. (CP/M too: getk reads through BDOS
02D6                             ; 6.) The line buffer starts at offset 80h of its page, so L alone
02D6                             ; is the place in the line: D holds the L of a full line.
02D6   11 7F 00     LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
02D9   19                     ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
02DA   9F                     SBC   A,A   
02DB   A5                     AND   L   ; (0 for a count that is too big)
02DC   2F                     CPL      
02DD   57                     LD   D,A   ; D = the L of a full line: 80h + count, FFh
02DE                             ;   at most
02DE   21 80 0C               LD   HL,LINEBUF   
02E1   CD 4F 05     LN2:      CALL   getk   
02E4   28 FB                  JR   Z,ln2   
02E6   FE 0D                  CP   13   
02E8   28 18                  JR   Z,ln5   
02EA   FE 08                  CP   8   
02EC   28 0D                  JR   Z,ln4   
02EE   5F                     LD   E,A   
02EF   7D                     LD   A,L   
02F0   BA                     CP   D   
02F1   28 EE                  JR   Z,ln2   ; full
02F3   73                     LD   (HL),E   
02F4   2C                     INC   L   
02F5   7B                     LD   A,E   
02F6                          ;*Macro unroll: ln3:    PUTA
02F6                LN3:      DS   1-CPM,0EFh   
02F6   CD                     DS   CPM,0CDh   
02F7   79                     DS   CPM,APUT&0FFh   
02F8   05                     DS   CPM,APUT/256   
02F9   18 E6                  JR   ln2   
02FB   2D           LN4:      DEC   L   ; Backspace: one back, and echo it,
02FC   FA F6 02               JP   M,ln3   ;   unless the line was empty (L left the
02FF   2C                     INC   L   ;   upper half of the page)
0300   18 DF                  JR   ln2   
0302   77           LN5:      LD   (HL),A   ; the CR
0303   2E 80                  LD   L,LINEBUF & 0FFh   
0305                          ;*Macro unroll:  NEXT
0305                          DS   (1-CPM)*(1-FAST),0F7h   
0305   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0306   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0307                             ; =============================================================================
0307                             ;  More routines (no handler starts past this point)
0307                             ; =============================================================================
0307                          IF   CHECKED   
                                 ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
                                 ; "$", and the texts of the report). A NUL first is an error: Q.
                    PRSTR:    LD   A,(HL)   
                              INC   HL   
                              CP   22h   
                              RET   Z   
                              OR   A   
                              JP   Z,e_dollar   
                              CP   "/"   
                              JR   NZ,prs1   
                              LD   A,(HL)   
                              INC   HL   
                              CP   60h   
                              JR   C,prs0   
                              CP   7Fh   
                              JR   C,pesc   
                    PRS0:     AND   0BFh   
                              ;*Macro unroll: prs1:   PUTA
                    PRS1:     DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              JR   prstr   
                    PRLOOP:   EQU   prstr   ; (where the escapes go back to)
                    PRAGAIN:   EQU   hp1   ; (and where /~ goes back to)
                                 ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
                                 ; pnl: the same, on a new line.
                    PNL:      CALL   pmsg   ; (pmsg's own CR LF, then on into pmsg for
                              DB   13,10,22h   ;   the caller's text)
                    PMSG:     EX   (SP),HL   
                              CALL   prstr   
                              EX   (SP),HL   
                              RET      
0307                          ENDIF      
0307                             ; pesc: the escapes of "$". A = the character after the "/", 60h to 7Eh, and
0307                             ; HL points past it. Each goes back into the loop that prints the string
0307                             ; (PRLOOP), but /~ has the stack to see to, and goes back by PRAGAIN.
0307                             ;    /a-/z   print the variable, as "#" does
0307                             ;    /{      clear the screen, the cursor to the top left
0307                             ;    /}      clear from the cursor to the end of the line
0307                             ;    /|  /`  show the cursor, hide it
0307                             ;    /~      ( row col -- ) the cursor to that row and column, from 0
0307   FE 7E        PESC:     CP   7Eh   
0309   28 1C                  JR   Z,pat   
030B   11 90 02               LD   DE,PRLOOP   ; the others return into the loop
030E   D5                     PUSH   DE   
030F   D6 7B                  SUB   7Bh   ; 00bbIDAsIHwgMSwg 2, and no borrow
0311   30 45                  JR   NC,pcon   
0313   C6 1A                  ADD   A,1Ah   ; a-z: 0-25, and a carry; `: FFh, and none
0315   30 2E                  JR   NC,phide   
0317   87                     ADD   A,A   ; the variable's cell
0318   C6 40                  ADD   A,40h   
031A   E5                     PUSH   HL   
031B   6F                     LD   L,A   
031C   26 0C                  LD   H,LETPAGE   
031E   7E                     LD   A,(HL)   
031F   2C                     INC   L   
0320   66                     LD   H,(HL)   
0321   6F                     LD   L,A   
0322   CD E3 04               CALL   psgn   
0325   E1                     POP   HL   
0326   C9                     RET      
0327                             ; /~ ( row col addr -- ): the two cells under the string's address go. In
0327                             ; the checked build "$" is the routine prstr: its own return address goes
0327                             ; first, and hp1 calls it again afterwards. There each /~ first looks that
0327                             ; its two cells are there, and is s if not, before it prints anything.
0327                PAT:         
0327                          IF   CHECKED   
                              EX   (SP),HL   ; the text pointer over prstr's return address
                              LD   HL,(6-DSTOP)&0FFFFh   ; a carry: the two cells aren't there
                              ADD   HL,SP   
                              JP   C,e_under   
                              POP   HL   
0327                          ENDIF      
0327   D1                     POP   DE   ; DE = the column
0328   E3                     EX   (SP),HL   ; HL = the row; the text pointer is kept
0329                          IF   1-ANS   
                              CALL   CONAT   
                              POP   HL   
                              JP   PRAGAIN   
                                 ; With ANSI = 0 the machine's routines do the rest.
                    PCON:     JP   Z,CONCLS   ; /{
                              CP   2   
                              JP   Z,CONEOL   ; /}
                              DB   0FEh   ; /|  (CP n steps over the XOR: A = 1, show)
                    PHIDE:    XOR   A   ; /`  (A = 0: hide)
                              JP   CONCUR   
0329                          ENDIF      
0329                          IF   ANS   
0329   D5                     PUSH   DE   
032A   CD 6D 03               CALL   csi   ; ESC [ row+1 ; col+1 H (ANSI counts from 1)
032D   23                     INC   HL   
032E   CD EE 04               CALL   pdec   
0331                          ;*Macro unroll:  PUTK    3Bh             ; ';'
0331                          DS   1-CPM,3Eh   ; ";"
0331                          DS   1-CPM,3Bh   
0331                          DS   1-CPM,0EFh   
0331   CD                     DS   CPM,0CDh   
0332   75                     DS   CPM,APTK&0FFh   
0333   05                     DS   CPM,APTK/256   
0334   3B                     DS   CPM,3Bh   
0335   E1                     POP   HL   
0336   23                     INC   HL   
0337   CD EE 04               CALL   pdec   
033A                          ;*Macro unroll:  PUTK    48h             ; 'H'
033A                          DS   1-CPM,3Eh   ; "H"
033A                          DS   1-CPM,48h   
033A                          DS   1-CPM,0EFh   
033A   CD                     DS   CPM,0CDh   
033B   75                     DS   CPM,APTK&0FFh   
033C   05                     DS   CPM,APTK/256   
033D   48                     DS   CPM,48h   
033E   E1                     POP   HL   
033F   C3 90 02               JP   PRAGAIN   
0342                             ; With ANSI = 1 they are sequences. The carry is clear on the way in.
0342   1E 68        PSHOW:    LD   E,"h"   ; /|  ESC [ ? 2 5 h
0344   DA                     DB   0DAh   ; (JP C,nn: with no carry it steps over two bytes)
0345   1E 6C        PHIDE:    LD   E,"l"   ; /`  ESC [ ? 2 5 l
0347                          ENDIF      
0347                          IF   ANS*CHECKED   
                                 ; (The checked build prints the fixed parts with pmsg, which it has for the
                                 ; report: shorter than a character at a time.)
                              CALL   pmsg   
                              DB   27,"[?25",22h   
                    PSE:      LD   A,E   ; then E
                              ;*Macro unroll:  PUTAR
                              DS   1-CPM,0EFh   
                              DS   1-CPM,0C9h   
                              DS   CPM,0C3h   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                                 ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into cse.
                    PCON:     DEC   A   
                              JR   Z,pshow   ; /|
                              LD   E,"K"   
                              JP   P,cse   ; /}  ESC [ K
                              LD   E,"H"   ; /{  ESC [ H ESC [ J
                              CALL   cse   
                              LD   E,"J"   ; (on into cse)
                                 ; cse: ESC [ and then E. csi: ESC [. Both keep HL.
                    CSE:      CALL   csi   
                              JR   pse   
                    CSI:      CALL   pmsg   
                              DB   27,"[",22h   
                              RET      
0347                          ENDIF      
0347                          IF   ANS*(1-CHECKED)   
0347   3E 3F                  LD   A,"?"   
0349   CD 67 03               CALL   csia   
034C                          ;*Macro unroll:  PUTK    32h             ; '2'
034C                          DS   1-CPM,3Eh   ; "2"
034C                          DS   1-CPM,32h   
034C                          DS   1-CPM,0EFh   
034C   CD                     DS   CPM,0CDh   
034D   75                     DS   CPM,APTK&0FFh   
034E   05                     DS   CPM,APTK/256   
034F   32                     DS   CPM,32h   
0350                          ;*Macro unroll:  PUTK    35h             ; '5'
0350                          DS   1-CPM,3Eh   ; "5"
0350                          DS   1-CPM,35h   
0350                          DS   1-CPM,0EFh   
0350   CD                     DS   CPM,0CDh   
0351   75                     DS   CPM,APTK&0FFh   
0352   05                     DS   CPM,APTK/256   
0353   35                     DS   CPM,35h   
0354   7B                     LD   A,E   
0355                          ;*Macro unroll:  PUTAR
0355                          DS   1-CPM,0EFh   
0355                          DS   1-CPM,0C9h   
0355   C3                     DS   CPM,0C3h   
0356   79                     DS   CPM,APUT&0FFh   
0357   05                     DS   CPM,APUT/256   
0358                             ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into csia.
0358   3D           PCON:     DEC   A   
0359   28 E7                  JR   Z,pshow   ; /|
035B   3E 4B                  LD   A,"K"   
035D   F2 67 03               JP   P,csia   ; /}  ESC [ K
0360   3E 48                  LD   A,"H"   ; /{  ESC [ H ESC [ J
0362   CD 67 03               CALL   csia   
0365   3E 4A                  LD   A,"J"   ; (on into csia)
0367                             ; csia: ESC [ and then A. csi: ESC [, keeping A.
0367   CD 6D 03     CSIA:     CALL   csi   
036A                          ;*Macro unroll:  PUTAR
036A                          DS   1-CPM,0EFh   
036A                          DS   1-CPM,0C9h   
036A   C3                     DS   CPM,0C3h   
036B   79                     DS   CPM,APUT&0FFh   
036C   05                     DS   CPM,APUT/256   
036D   F5           CSI:      PUSH   AF   
036E                          ;*Macro unroll:  PUTK    1Bh             ; ESC
036E                          DS   1-CPM,3Eh   ; ESC
036E                          DS   1-CPM,1Bh   
036E                          DS   1-CPM,0EFh   
036E   CD                     DS   CPM,0CDh   
036F   75                     DS   CPM,APTK&0FFh   
0370   05                     DS   CPM,APTK/256   
0371   1B                     DS   CPM,1Bh   
0372                          ;*Macro unroll:  PUTK    5Bh             ; '['
0372                          DS   1-CPM,3Eh   ; "["
0372                          DS   1-CPM,5Bh   
0372                          DS   1-CPM,0EFh   
0372   CD                     DS   CPM,0CDh   
0373   75                     DS   CPM,APTK&0FFh   
0374   05                     DS   CPM,APTK/256   
0375   5B                     DS   CPM,5Bh   
0376   F1                     POP   AF   
0377   C9                     RET      
0378                          ENDIF      
0378                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
0378                             ; Uses A; keeps BC (the IP) itself. The dividend shifts up through A:C while
0378                             ; the quotient bits arrive at the bottom of C.
0378                             ; Dividing by 2 is one shift (the spec wants that fast).
0378                          IF   1-QK   
                    UDIV:     LD   A,E   
                              XOR   2   
                              OR   D   
                              JR   NZ,udv0   
                              SRL   H   
                              RR   L   ; the quotient
                              ADC   A,A   
                              LD   E,A   ; the remainder: the bit that fell out (D is 0)
                              RET      
0378                          ENDIF      
0378                          IF   QK   
0378                             ; (The builds with room divide by any power of two with shifts: 2, and 32,
0378                             ; 64, 256 and the like, which fixed point and byte work use all the time.)
0378   7A           UDIV:     LD   A,D   
0379   B7                     OR   A   
037A   20 1A                  JR   NZ,uq1   ; 256 and up
037C   B3                     OR   E   
037D   28 33                  JR   Z,udv0   ; by 0: the long way (it means nothing anyway)
037F   3D                     DEC   A   
0380   A3                     AND   E   
0381   20 2F                  JR   NZ,udv0   ; not a power of two
0383   7B                     LD   A,E   ; by 2^k below 256: q = HL >> k, and
0384   3D                     DEC   A   ;   r = L & (2^k - 1)
0385   A5                     AND   L   
0386   F5                     PUSH   AF   
0387   CB 3B        UQ2:      SRL   E   
0389   38 06                  JR   C,uq3   
038B   CB 3C                  SRL   H   
038D   CB 1D                  RR   L   
038F   18 F6                  JR   uq2   
0391   F1           UQ3:      POP   AF   
0392   5F                     LD   E,A   
0393   16 00                  LD   D,0   
0395   C9                     RET      
0396   7B           UQ1:      LD   A,E   
0397   B7                     OR   A   
0398   20 18                  JR   NZ,udv0   
039A   7A                     LD   A,D   
039B   3D                     DEC   A   
039C   A2                     AND   D   
039D   20 13                  JR   NZ,udv0   ; not a power of two
039F   7A                     LD   A,D   ; by 2^k, 256 and up: q = H >> (k - 8), and
03A0   3D                     DEC   A   ;   r = HL & (2^k - 1)
03A1   A4                     AND   H   
03A2   5F                     LD   E,A   ; (the remainder's high byte,
03A3   7D                     LD   A,L   ;   and its low byte)
03A4   6C                     LD   L,H   
03A5   26 00                  LD   H,0   
03A7   CB 3A        UQ4:      SRL   D   
03A9   38 04                  JR   C,uq5   
03AB   CB 3D                  SRL   L   
03AD   18 F8                  JR   uq4   
03AF   53           UQ5:      LD   D,E   
03B0   5F                     LD   E,A   
03B1   C9                     RET      
03B2                          ENDIF      
03B2                          IF   1-FAST   
03B2   C5           UDV0:     PUSH   BC   
03B3   7C                     LD   A,H   
03B4   4D                     LD   C,L   
03B5   21 00 00               LD   HL,0   
03B8   06 10                  LD   B,16   
03BA   CB 21        UDV1:     SLA   C   
03BC   17                     RLA      
03BD   ED 6A                  ADC   HL,HL   
03BF   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
03C1   30 02                  JR   NC,udv2   ;   always fits in 16 bits
03C3   19                     ADD   HL,DE   ; too much: put it back, and cancel the
03C4   0D                     DEC   C   ;   INC below
03C5   0C           UDV2:     INC   C   ; a quotient bit
03C6   10 F2                  DJNZ   udv1   
03C8   EB                     EX   DE,HL   ; DE = remainder
03C9   67                     LD   H,A   
03CA   69                     LD   L,C   ; HL = quotient
03CB   C1                     POP   BC   
03CC   C9                     RET      
03CD                          ENDIF      
03CD                          IF   FAST   
                                 ; (the fast build: the same 16 rounds, unrolled)
                    UDV0:     PUSH   BC   
                              LD   A,H   
                              LD   C,L   
                              LD   HL,0   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr0   
                              ADD   HL,DE   
                              DEC   C   
                    UVR0:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr1   
                              ADD   HL,DE   
                              DEC   C   
                    UVR1:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr2   
                              ADD   HL,DE   
                              DEC   C   
                    UVR2:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr3   
                              ADD   HL,DE   
                              DEC   C   
                    UVR3:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr4   
                              ADD   HL,DE   
                              DEC   C   
                    UVR4:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr5   
                              ADD   HL,DE   
                              DEC   C   
                    UVR5:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr6   
                              ADD   HL,DE   
                              DEC   C   
                    UVR6:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr7   
                              ADD   HL,DE   
                              DEC   C   
                    UVR7:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr8   
                              ADD   HL,DE   
                              DEC   C   
                    UVR8:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr9   
                              ADD   HL,DE   
                              DEC   C   
                    UVR9:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr10   
                              ADD   HL,DE   
                              DEC   C   
                    UVR10:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr11   
                              ADD   HL,DE   
                              DEC   C   
                    UVR11:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr12   
                              ADD   HL,DE   
                              DEC   C   
                    UVR12:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr13   
                              ADD   HL,DE   
                              DEC   C   
                    UVR13:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr14   
                              ADD   HL,DE   
                              DEC   C   
                    UVR14:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr15   
                              ADD   HL,DE   
                              DEC   C   
                    UVR15:    INC   C   
                              EX   DE,HL   ; DE = remainder
                              LD   H,A   
                              LD   L,C   ; HL = quotient
                              POP   BC   
                              RET      
03CD                          ENDIF      
03CD                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
03CD                             ; non-digit. Values wrap at 16 bits, as the spec says.
03CD   21 00 00     RDNUM:    LD   HL,0   
03D0   0A           RDN1:     LD   A,(BC)   
03D1   D6 30                  SUB   "0"   
03D3   FE 0A                  CP   10   
03D5   D0                     RET   NC   
03D6   03                     INC   BC   
03D7   54                     LD   D,H   
03D8   5D                     LD   E,L   
03D9   29                     ADD   HL,HL   
03DA   29                     ADD   HL,HL   
03DB   19                     ADD   HL,DE   
03DC   29                     ADD   HL,HL   ; HL * 10
03DD   5F                     LD   E,A   
03DE   16 00                  LD   D,0   
03E0   19                     ADD   HL,DE   
03E1   18 ED                  JR   rdn1   
03E3                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
03E3                             ; the next character, so "/"" does not end it. Leaves A = 22h.
03E3                          IF   1-CHECKED   
03E3   03           SS0:      INC   BC   
03E4   0A           SKIPSTR:   LD   A,(BC)   
03E5   03                     INC   BC   
03E6   FE 2F                  CP   "/"   
03E8   28 F9                  JR   Z,ss0   
03EA   FE 22                  CP   22h   
03EC   20 F6                  JR   NZ,skipstr   
03EE   C9                     RET      
03EF                          ENDIF      
03EF                          IF   CHECKED   
                                 ; The checked build never steps over a NUL: if the text runs out first it
                                 ; returns A = 0 with the IP on the NUL.
                    SKIPSTR:   LD   A,(BC)   
                              OR   A   
                              RET   Z   
                              INC   BC   
                              CP   22h   
                              RET   Z   
                              CP   "/"   
                              JR   NZ,skipstr   
                              LD   A,(BC)   ; the escaped character
                              OR   A   
                              RET   Z   
                              INC   BC   
                              JR   skipstr   
03EF                          ENDIF      
03EF                             ; skip: read past text to the closer at this level, and return A = 0 if it
03EF                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
03EF                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
03EF                             ; no closer; anything else that runs into the NUL had unbalanced brackets
03EF                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
03EF                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
03EF                             ; 
03EF                             ; The checked build also looks at the character the skip was started by,
03EF                             ; which is always the one just before where it starts: "(" must end at ")",
03EF                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
03EF                             ; quote counts as running into it. "\" takes either closer. SKPL keeps the
03EF                             ; place where the skip started, for the report.
03EF                          IF   1-QK   
                                 ; (Without base: no skip cache.)
                    SKIP:        
03EF                          ENDIF      
03EF                          IF   CHECKED*(1-QK)   
                              LD   (SKPL),BC   
                              DEC   BC   
                              LD   A,(BC)   
                              INC   BC   
                              LD   E,A   ; E = the opener: ( [ or \
03EF                          ENDIF      
03EF                          IF   1-QK   
                              LD   D,0   
                    SK3:      INC   D   ; an opener: one deeper
                    SK1:      LD   A,(BC)   
03EF                          ENDIF      
03EF                          IF   (1-CHECKED)*(1-QK)   
                              INC   BC   
                              OR   A   
                              JP   Z,SKEND   ; (the end of the program)
03EF                          ENDIF      
03EF                          IF   CHECKED*(1-QK)   
                              OR   A   
                              JR   Z,sk6   ; (the IP stays on the NUL)
                              INC   BC   
03EF                          ENDIF      
03EF                          IF   1-QK   
                              CP   22h   
                              CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
                              SUB   "("   ;   (or 0, and then the NUL is read next)
                              JR   Z,sk3   
                              DEC   A   ; ")"
                              JR   Z,sk4   
                              SUB   "["-")"   
                              JR   Z,sk3   
                              CP   "]"-"["   
                              JR   NZ,sk1   
                    SK4:      DEC   D   
03EF                          ENDIF      
03EF                          IF   (1-CHECKED)*(1-QK)   
                              RET   Z   ; the closer at this level
                              JR   sk1   
03EF                          ENDIF      
03EF                          IF   CHECKED*(1-QK)   
                              JR   NZ,sk1   
                              LD   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
                              XOR   E   ;   opener is 0 for "(" and 1 for "[", and only
                              AND   6   ;   "\" has bit 2: so this is 2 for the wrong
                              CP   2   ;   closer, and only then
                              LD   A,D   
                              RET   NZ   
                              JR   sk7   
                    SK6:      BIT   2,E   ; the text ran out:
                              JP   NZ,SKEND   ;   "\" with no closer ends the program
                    SK7:      LD   BC,(SKPL)   ; N. The place is the opener
                              LD   A,"N"   
                              JP   errp   ; (errp drops skip's return address)
03EF                          ENDIF      
03EF                          IF   QK   
03EF                             ; The skip cache. Nearly every skip is one that has happened before (a loop
03EF                             ; skips the same false block on every pass), so the first scan from each
03EF                             ; place is remembered: 64 entries of 00bbc3RhcnQsIGVuZA==, at CPAGE, found by the
03EF                             ; start's low byte. Only skips that start in the program text are kept (the
03EF                             ; line buffer changes); the cache is emptied whenever a run starts (skclr).
03EF                             ; A program that changes its own text while it runs is not looked after.
03EF   ED 43 3C 0C  SKIP:     LD   (SKPL),BC   ; where it starts: the cache's key (and the
03F3   78                     LD   A,B   ;   checked report's place)
03F4   FE 0D                  CP   PROG/256   
03F6   38 1B                  JR   C,sks   ; below the program text: no cache
03F8   79                     LD   A,C   
03F9   87                     ADD   A,A   
03FA   87                     ADD   A,A   
03FB   5F                     LD   E,A   
03FC   16 09                  LD   D,CPAGE   ; DE -> the entry
03FE   1A                     LD   A,(DE)   
03FF   B9                     CP   C   
0400   20 11                  JR   NZ,sks   
0402   1C                     INC   E   
0403   1A                     LD   A,(DE)   
0404   B8                     CP   B   
0405   20 0C                  JR   NZ,sks   
0407   1C                     INC   E   
0408   1A                     LD   A,(DE)   
0409   4F                     LD   C,A   
040A   1C                     INC   E   
040B   1A                     LD   A,(DE)   
040C   47                     LD   B,A   ; a hit: the IP is past the closer
040D   0B                     DEC   BC   
040E   0A                     LD   A,(BC)   
040F   03                     INC   BC   
0410   D6 29                  SUB   ")"   ; 0 for ")", not 0 for "]"
0412   C9                     RET      
0413                SKS:         
0413                          ENDIF      
0413                          IF   QK*CHECKED   
                              DEC   BC   
                              LD   A,(BC)   
                              INC   BC   
                              LD   E,A   ; E = the opener: ( [ or \
0413                          ENDIF      
0413                          IF   QK   
0413                             ; The scan. Most characters are nothing to it, and two range tests rule
0413                             ; them out: * to Z, and ^ and up. Only NUL " ( ) [ ] count.
0413   16 00                  LD   D,0   
0415   14           SQ3:      INC   D   ; an opener: one deeper
0416   0A           SQ1:      LD   A,(BC)   
0417   03                     INC   BC   
0418   FE 5E                  CP   5Eh   
041A   30 FA                  JR   NC,sq1   ; ^ _ ` a-z 00bbIHwg ~ and up: nothing
041C   FE 5B                  CP   5Bh   
041E   30 19                  JR   NC,sqb   ; [ \ ]
0420   FE 2A                  CP   2Ah   
0422   30 F2                  JR   NC,sq1   ; * to Z: nothing
0424   FE 28                  CP   28h   
0426   28 ED                  JR   Z,sq3   ; (
0428   30 19                  JR   NC,sqc   ; )
042A   FE 22                  CP   22h   
042C   28 06                  JR   Z,sqq   ; a string
042E   B7                     OR   A   
042F   20 E5                  JR   NZ,sq1   ; the rest below "(": nothing
0431                          ENDIF      
0431                          IF   QK*(1-CHECKED)   
0431   C3 CF 05               JP   SKEND   ; NUL: the end of the program
0434                          ENDIF      
0434                          IF   QK*CHECKED   
                              DEC   BC   ; NUL: the IP stays on it
                              BIT   2,E   ; the text ran out:
                              JP   NZ,SKEND   ;   "\" with no closer ends the program
                    SQ7:      LD   BC,(SKPL)   ; N. The place is the opener
                              LD   A,"N"   
                              JP   errp   ; (errp drops skip's return address)
0434                          ENDIF      
0434                          IF   QK   
0434   CD E4 03     SQQ:      CALL   skipstr   ; step over the string
0437   18 DD                  JR   sq1   
0439   D6 5C        SQB:      SUB   5Ch   ; [ -1, \ 0, ] 1
043B   28 D9                  JR   Z,sq1   ; "\" is nothing here
043D   38 D6                  JR   C,sq3   ; [
043F   3E 02                  LD   A,2   ; ]
0441   18 01                  JR   sq4   
0443   AF           SQC:      XOR   A   ; )
0444   15           SQ4:      DEC   D   
0445   20 CF                  JR   NZ,sq1   
0447                          ENDIF      
0447                          IF   QK*CHECKED   
                              LD   D,A   ; the closer at this level (as above): 2 here
                              XOR   E   ;   means the wrong closer
                              AND   6   
                              CP   2   
                              LD   A,D   
                              JR   Z,sq7   
0447                          ENDIF      
0447                          IF   QK   
0447                             ; The closer at this level: remember the skip (if it started in the program
0447                             ; text), and return A = 0 for ")" or 2 for "]".
0447   F5                     PUSH   AF   
0448   E5                     PUSH   HL   
0449   2A 3C 0C               LD   HL,(SKPL)   
044C   7C                     LD   A,H   
044D   FE 0D                  CP   PROG/256   
044F   38 11                  JR   C,sq9   
0451   7D                     LD   A,L   
0452   87                     ADD   A,A   
0453   87                     ADD   A,A   
0454   5F                     LD   E,A   
0455   16 09                  LD   D,CPAGE   
0457   7D                     LD   A,L   
0458   12                     LD   (DE),A   
0459   1C                     INC   E   
045A   7C                     LD   A,H   
045B   12                     LD   (DE),A   
045C   1C                     INC   E   
045D   79                     LD   A,C   
045E   12                     LD   (DE),A   
045F   1C                     INC   E   
0460   78                     LD   A,B   
0461   12                     LD   (DE),A   
0462   E1           SQ9:      POP   HL   
0463   F1                     POP   AF   
0464   C9                     RET      
0465                             ; skclr: empty the skip cache (a start of 0000h matches no skip). Keeps HL.
0465   E5           SKCLR:    PUSH   HL   
0466   21 00 09               LD   HL,CPAGE*256   
0469   36 00        SKC1:     LD   (HL),0   
046B   2C                     INC   L   
046C   20 FB                  JR   NZ,skc1   
046E   E1                     POP   HL   
046F   C9                     RET      
0470                          ENDIF      
0470                             ;  ---- Speed-ups (base builds) -------------------------------------------
0470                             ;  The skip cache is above. These are the handlers' tails that the builds with
0470                             ;  room take, kept here, out of the handlers' first two pages.
0470                          IF   QK   
0470                             ; "*" with an operand below 256 takes 8 rounds, not 16: that one becomes the
0470                             ; multiplier (most multiplications have one, a count or a small constant).
0470   7C           MULQ:     LD   A,H   
0471   B7                     OR   A   
0472   28 05                  JR   Z,mq8   ; the multiplier is below 256
0474   7A                     LD   A,D   
0475   B7                     OR   A   
0476   20 12                  JR   NZ,mq16   
0478   EB                     EX   DE,HL   ; the multiplicand is: it becomes the multiplier
0479                          ENDIF      
0479                          IF   QK*(1-FAST)   
0479   7D           MQ8:      LD   A,L   
047A   21 00 00               LD   HL,0   
047D   C5                     PUSH   BC   
047E   06 08                  LD   B,8   
0480   29           MQ1:      ADD   HL,HL   
0481   17                     RLA      
0482   30 01                  JR   NC,mq2   
0484   19                     ADD   HL,DE   
0485   10 F9        MQ2:      DJNZ   mq1   
0487   C1                     POP   BC   
0488                          ;*Macro unroll:  NEXT
0488                          DS   (1-CPM)*(1-FAST),0F7h   
0488   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0489   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
048A   C5           MQ16:     PUSH   BC   ; 16 rounds; the multiplier shifts up through A:C
048B   7C                     LD   A,H   
048C   4D                     LD   C,L   
048D   21 00 00               LD   HL,0   
0490   06 10                  LD   B,16   
0492   29           MQ3:      ADD   HL,HL   
0493   CB 21                  SLA   C   
0495   17                     RLA      
0496   30 01                  JR   NC,mq4   
0498   19                     ADD   HL,DE   
0499   10 F7        MQ4:      DJNZ   mq3   
049B   C1                     POP   BC   
049C                          ;*Macro unroll:  NEXT
049C                          DS   (1-CPM)*(1-FAST),0F7h   
049C   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
049D   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
049E                          ENDIF      
049E                          IF   FAST   
                                 ; (the fast build: the same rounds, unrolled)
                    MQ8:      LD   A,L   
                              LD   HL,0   
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur0   
                              ADD   HL,DE   
                    MUR0:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur1   
                              ADD   HL,DE   
                    MUR1:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur2   
                              ADD   HL,DE   
                    MUR2:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur3   
                              ADD   HL,DE   
                    MUR3:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur4   
                              ADD   HL,DE   
                    MUR4:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur5   
                              ADD   HL,DE   
                    MUR5:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur6   
                              ADD   HL,DE   
                    MUR6:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur7   
                              ADD   HL,DE   
                    MUR7:        
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
                    MQ16:     PUSH   BC   
                              LD   A,H   
                              LD   C,L   
                              LD   HL,0   
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus0   
                              ADD   HL,DE   
                    MUS0:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus1   
                              ADD   HL,DE   
                    MUS1:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus2   
                              ADD   HL,DE   
                    MUS2:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus3   
                              ADD   HL,DE   
                    MUS3:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus4   
                              ADD   HL,DE   
                    MUS4:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus5   
                              ADD   HL,DE   
                    MUS5:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus6   
                              ADD   HL,DE   
                    MUS6:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus7   
                              ADD   HL,DE   
                    MUS7:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus8   
                              ADD   HL,DE   
                    MUS8:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus9   
                              ADD   HL,DE   
                    MUS9:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus10   
                              ADD   HL,DE   
                    MUS10:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus11   
                              ADD   HL,DE   
                    MUS11:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus12   
                              ADD   HL,DE   
                    MUS12:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus13   
                              ADD   HL,DE   
                    MUS13:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus14   
                              ADD   HL,DE   
                    MUS14:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus15   
                              ADD   HL,DE   
                    MUS15:       
                              POP   BC   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
049E                          ENDIF      
049E                          IF   QK   
049E                             ; A true ")" reads the block start where it is, on top of the return stack,
049E                             ; instead of popping it and pushing it back; the break key is looked at as
049E                             ; rpushn would.
049E   FD 4E 00     CLOSEQ:   LD   C,(IY+0)   
04A1   FD 46 01               LD   B,(IY+1)   
04A4   E5                     PUSH   HL   
04A5   21 36 0C               LD   HL,PCNT   
04A8   35                     DEC   (HL)   
04A9   E1                     POP   HL   
04AA   CC 21 05               CALL   Z,pollk   
04AD                          ;*Macro unroll:  NEXT
04AD                          DS   (1-CPM)*(1-FAST),0F7h   
04AD   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
04AE   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
04AF                          ENDIF      
04AF                          IF   SBASEU   
04AF                             ; a-z, in the unchecked builds: a variable followed by "@" or "!" is fetched
04AF                             ; or stored in the same step (x@ is the commonest pair in most programs).
04AF                             ; (A checked build checks the stacks between the two, so it keeps them apart.)
04AF   87           LOWQ:     ADD   A,A   
04B0   5F                     LD   E,A   
04B1   16 0C                  LD   D,LETPAGE   ; DE -> the cell
04B3   0A                     LD   A,(BC)   
04B4   FE 40                  CP   "@"   
04B6   28 08                  JR   Z,lwf   
04B8   FE 21                  CP   "!"   
04BA   28 0D                  JR   Z,lws   
04BC   E5                     PUSH   HL   
04BD   EB                     EX   DE,HL   ; TOS = the cell's address
04BE                          ;*Macro unroll:  NEXT
04BE                          DS   (1-CPM)*(1-FAST),0F7h   
04BE   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
04BF   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
04C0   03           LWF:      INC   BC   ; x@: TOS = the cell's value
04C1   E5                     PUSH   HL   
04C2   EB                     EX   DE,HL   
04C3   5E                     LD   E,(HL)   
04C4   2C                     INC   L   
04C5   56                     LD   D,(HL)   
04C6   EB                     EX   DE,HL   
04C7                          ;*Macro unroll:  NEXT
04C7                          DS   (1-CPM)*(1-FAST),0F7h   
04C7   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
04C8   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
04C9   03           LWS:      INC   BC   ; x!: the cell = TOS, and NOS comes up
04CA   EB                     EX   DE,HL   
04CB   73                     LD   (HL),E   
04CC   2C                     INC   L   
04CD   72                     LD   (HL),D   
04CE   E1                     POP   HL   
04CF                          ;*Macro unroll:  NEXT
04CF                          DS   (1-CPM)*(1-FAST),0F7h   
04CF   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
04D0   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
04D1                          ENDIF      
04D1                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)*QK   
                    QSTART:   LD   BC,PROG   ; the generic reset goes on here: the IP,
                              CALL   skclr   ;   an empty skip cache, and the rest of the
                              JP   st0   ;   startup
04D1                          ENDIF      
04D1                          IF   (1-CPM)*(1-EDITOR)*CHECKED*QK   
                    QINIT:    CALL   skclr   ; (keeps A, which init wants 0)
                              JP   init   
04D1                          ENDIF      
04D1                             ; =============================================================================
04D1                             ;  Dispatch table: the low byte of each handler's address, in code order
04D1                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
04D1                             ;  It must not cross a page (the dispatcher only adds to its low byte).
04D1                             ; =============================================================================
04D1                             ; The handlers of the first NPG1 characters start in the image's second page.
04D1                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
04D1                             ; differs between the builds, so the count is worked out here.
04D1                             ; (One division to a line: asm80 only rounds down when it stores a value.)
04D1                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
04D1                PGBRK:    EQU   (h_break-BASE)/256   
04D1                PGDEF:    EQU   (h_def-BASE)/256   
04D1                PGFET:    EQU   (h_fetch-BASE)/256   
04D1                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
04D1                          IF   (1-TABP0)*(1-PTLATE)   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
04D1                          ENDIF      
04D1                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
04D1                             ; and return its value in A with the carry set; otherwise leave the IP and
04D1                             ; return with the carry clear.
04D1   0A           HEXC:     LD   A,(BC)   
04D2   D6 30                  SUB   "0"   
04D4   FE 0A                  CP   10   
04D6   38 09                  JR   C,hc1   
04D8   E6 DF                  AND   0DFh   
04DA   D6 11                  SUB   11h   
04DC   FE 06                  CP   6   
04DE   D0                     RET   NC   
04DF   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
04E1   03           HC1:      INC   BC   
04E2   C9                     RET      
04E3                             ; psgn: print HL as a signed number. Keeps BC.
04E3   CB 7C        PSGN:     BIT   7,H   
04E5   28 07                  JR   Z,pdec   
04E7                          ;*Macro unroll:  PUTK    2Dh             ; '-'
04E7                          DS   1-CPM,3Eh   ; "-"
04E7                          DS   1-CPM,2Dh   
04E7                          DS   1-CPM,0EFh   
04E7   CD                     DS   CPM,0CDh   
04E8   75                     DS   CPM,APTK&0FFh   
04E9   05                     DS   CPM,APTK/256   
04EA   2D                     DS   CPM,2Dh   
04EB                          ;*Macro unroll:  NEGH
04EB                          DS   1-CPM,0E7h   
04EB   CD                     DS   CPM,0CDh   
04EC   6A                     DS   CPM,ANEG&0FFh   
04ED   05                     DS   CPM,ANEG/256   
04EE                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
04EE                             ; Keeps BC.
04EE   11 0A 00     PDEC:     LD   DE,10   
04F1   CD 78 03               CALL   udiv   ; HL = HL / 10, E = the last digit
04F4   7B                     LD   A,E   
04F5   F5                     PUSH   AF   
04F6   7C                     LD   A,H   
04F7   B5                     OR   L   
04F8   C4 EE 04               CALL   NZ,pdec   
04FB   F1                     POP   AF   
04FC   C6 30                  ADD   A,"0"   
04FE                          ;*Macro unroll:  PUTAR
04FE                          DS   1-CPM,0EFh   
04FE                          DS   1-CPM,0C9h   
04FE   C3                     DS   CPM,0C3h   
04FF   79                     DS   CPM,APUT&0FFh   
0500   05                     DS   CPM,APUT/256   
0501                             ; (The table goes here instead in the builds where, before psgn, it would
0501                             ; cross a page: PTLATE. If it would cross one here too, it starts on the next
0501                             ; page: PTPAD is 0 unless it must.)
0501                          IF   (1-TABP0)*PTLATE   
0501                PTPH:     EQU   $ & 0FFh   
0501                PTPX:     EQU   (PTPH + 31) / 256   
0501                PTPAD:    EQU   PTPX * (256 - PTPH)   
0501                          DS   PTPAD   
0501                PTAB:        
0501                          ;*Macro unroll:  PTABLE
0501   81                     DB   h_store & 0FFh   
0502   88                     DB   h_str & 0FFh   
0503   B2                     DB   h_num & 0FFh   
0504   90                     DB   h_print & 0FFh   
0505   79                     DB   h_swap & 0FFh   
0506   2F                     DB   h_and & 0FFh   
0507   AB                     DB   h_emit & 0FFh   
0508   08                     DB   h_open & 0FFh   
0509   10                     DB   h_close & 0FFh   
050A   52                     DB   h_mul & 0FFh   
050B   22                     DB   h_add & 0FFh   
050C   D0                     DB   h_cfetch & 0FFh   
050D   18                     DB   h_sub & 0FFh   
050E   7C                     DB   h_cstore & 0FFh   
050F   56                     DB   h_div & 0FFh   
0510   76                     DB   h_dup & 0FFh   
0511   7E                     DB   h_drop & 0FFh   
0512   38                     DB   h_lt & 0FFh   
0513   48                     DB   h_eq & 0FFh   
0514   39                     DB   h_gt & 0FFh   
0515   B8                     DB   h_key & 0FFh   
0516   02                     DB   h_fetch & 0FFh   
0517   E4                     DB   h_def & 0FFh   
0518   D4                     DB   h_break & 0FFh   
0519   CD                     DB   h_ret & 0FFh   
051A   53                     DB   h_xor & 0FFh   
051B   6B                     DB   h_alloc & 0FFh   
051C   B6                     DB   h_grave & 0FFh   
051D   B2                     DB   h_tor & 0FFh   
051E   5C                     DB   h_or & 0FFh   
051F   09                     DB   h_fromr & 0FFh   
0520   65                     DB   h_not & 0FFh   
0521                PTABEND:      
0521                          ENDIF      
0521                             ; =============================================================================
0521                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
0521                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
0521                             ;  (RST 28h) prints A. Both keep BC, DE, HL and IY. In the generic build
0521                             ;  they are the host's KEY and CONOUT routines themselves.
0521                             ; 
0521                             ;  A running program reads the keyboard only through getk and pollk, which
0521                             ;  between them give the break key its rules:
0521                             ;    - Ctrl-C stops the program;
0521                             ;    - any other key that the break check reads is held in KEYBUF for the
0521                             ;      next "?", and a newer one takes its place;
0521                             ;    - "?" (getk) takes the held key first;
0521                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
0521                             ;      key like any other, but two of them within about 250 ms still stop it.
0521                             ;  Both are called straight from a handler, never from a routine under one:
0521                             ;  the checked build's report counts on finding one return address above the
0521                             ;  data stack.
0521                             ; =============================================================================
0521                          IFN   CPM   
                    RAWK:     EQU   KEY   
0521                          ENDIF      
0521                             ; pollk: the break check (see rpushn).
0521   CD 71 05     POLLK:    CALL   rawk   
0524   C8                     RET   Z   ; no key
0525   32 7A 0C               LD   (KEYBUF),A   ; held for the next "?"
0528   FE 03        PK1:      CP   3   ; (getk joins here)
052A   C0                     RET   NZ   
052B                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
052B                             ; the program has turned it off, wait about 250 ms for one more key: a
052B                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
052B                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
052B   3A 7B 0C     CTLC:     LD   A,(BRKOFF)   
052E   B7                     OR   A   
052F   CA C7 05     CT0:      JP   Z,brk   
0532   D5                     PUSH   DE   
0533   11 E8 03               LD   DE,250*MSLOOP   
0536   CD 71 05     CT1:      CALL   rawk   
0539   20 05                  JR   NZ,ct2   
053B   1B                     DEC   DE   
053C   7A                     LD   A,D   
053D   B3                     OR   E   
053E   20 F6                  JR   NZ,ct1   
0540   D1           CT2:      POP   DE   ; A = the second key, or 0 if none came
0541   FE 03                  CP   3   
0543   28 EA                  JR   Z,ct0   ; (the zero flag takes the JP there)
0545   B7                     OR   A   
0546   28 03                  JR   Z,ct3   
0548   32 7A 0C               LD   (KEYBUF),A   
054B   3E 03        CT3:      LD   A,3   
054D   B7                     OR   A   
054E   C9                     RET      
054F                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
054F   E5           GETK:     PUSH   HL   ; a held key goes first, and is taken out of
0550   21 7A 0C               LD   HL,KEYBUF   ;   the buffer
0553   7E                     LD   A,(HL)   
0554   36 00                  LD   (HL),0   
0556   E1                     POP   HL   
0557   B7                     OR   A   
0558   C0                     RET   NZ   
0559   CD 71 05               CALL   rawk   
055C   C8                     RET   Z   
055D   18 C9                  JR   pk1   ; Ctrl-C? If not, that is the key
055F                          IF   (1-CHECKED)*(1-EDITOR)   
                    BRK:      EQU   endprog   ; the unchecked build stops without a word
055F                          ENDIF      ;   (with the editor, both stacks are cleared);
055F                          IF   (1-CHECKED)*EDITOR   
055F                BRK:      EQU   edit0   
055F                          ENDIF      
055F                          IF   CHECKED   
                    BRK:      EQU   e_break   ;   the checked build reports B
055F                          ENDIF      
055F                          IF   CPM   
055F                             ; The routines a generic build keeps in page zero (see there). Here they are
055F                             ; out of the way of the handlers, which must fit in the image's first two
055F                             ; pages.
055F   FD 5E 00     RPOP:     LD   E,(IY+0)   ; pop the return stack into DE
0562   FD 56 01               LD   D,(IY+1)   
0565   FD 23                  INC   IY   
0567   FD 23                  INC   IY   
0569   C9                     RET      
056A   AF           NEG16:    XOR   A   ; HL = -HL (keeps BC, DE)
056B   95                     SUB   L   
056C   6F                     LD   L,A   
056D   9F                     SBC   A,A   
056E   94                     SUB   H   
056F   67                     LD   H,A   
0570   C9                     RET      
0571                          ENDIF      
0571                          IF   CPM*CHECKED   ; (the checked builds need the room)
                    EXEC:     LD   (RSAVE),IY   ; machine code may change IX and IY
                              CALL   jphl   
                              LD   IY,(RSAVE)   
                              ;*Macro unroll:  SETIX
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,21h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
                              POP   HL   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
0571                          ENDIF      
0571                          IF   CPM   
0571   3E FF        RAWK:     LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
0573   18 04                  JR   putc   
0575   E3           PUTK:     EX   (SP),HL   ; print the byte after the CALL
0576   7E                     LD   A,(HL)   
0577   23                     INC   HL   
0578   E3                     EX   (SP),HL   
0579                             ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
0579                             ; printing and could swallow a key that BDOS 6 then never sees.
0579                             ; It keeps every register but A and the flags: BDOS may change any of them
0579                             ; (IX and IY too, in a Z80 BDOS or BIOS).
0579   C5           PUTC:     PUSH   BC   
057A   D5                     PUSH   DE   
057B   E5                     PUSH   HL   
057C   DD E5                  PUSH   IX   
057E   FD E5                  PUSH   IY   
0580   5F                     LD   E,A   
0581   0E 06                  LD   C,6   
0583   CD 05 00               CALL   BDOS   
0586   FD E1                  POP   IY   
0588   DD E1                  POP   IX   
058A   E1                     POP   HL   
058B   D1                     POP   DE   
058C   C1                     POP   BC   
058D   B7                     OR   A   ; (for getk)
058E   C9                     RET      
058F                          ENDIF      
058F                             ; =============================================================================
058F                             ;  Checked build: the checks and the error report
058F                             ; =============================================================================
058F                          IF   CHECKED   
                                 ; chkstk: both stacks are checked once per character, not in every handler.
                                 ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
                                 ; the constant carries if it is above (cells were popped that were never
                                 ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
                                 ; a character late at most: the bytes above DSTOP and the guard band below
                                 ; the page take what happens meanwhile. DE is free between characters.
                    CHKSTK:   EX   DE,HL   
                              LD   HL,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
                              ADD   HL,SP   
                              EX   DE,HL   
                              JR   C,e_under   
                              INC   D   
                              JR   NZ,e_over   
                              PUSH   IY   ; the return stack: in its page (or it has
                              POP   DE   ;   overflowed), and not above its empty
                              LD   A,D   ;   position (an underflow stays inside the
                              CP   RSPAGE   ;   page, in the guard band)
                              LD   A,E   
                              JR   NZ,e_rover   
                              CP   RSTOP&0FFh+1   
                              RET   C   
                              LD   IY,RSTOP   ; return stack underflow: it counts as empty
                              LD   A,"r"   
                              JR   errp   
                    E_ROVER:   LD   A,"R"   ; return stack overflow
                              DB   11h   ; (LD DE,nn hides the next entry)
                    E_OVER:   LD   A,"S"   ; data stack overflow
                              JR   errp   
                    E_UNDER:   LD   SP,DSTOP   ; data stack underflow: it counts as empty
                              LD   A,"s"   
                              JR   error   
                                 ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
                                 ; was never defined still holds 0000h, and the byte there is a reserved one
                                 ; in every build (AFh or C3h): if the IP is in page zero, this was a call of
                                 ; an undefined word. The call is undone, so the place is the call itself.
                    E_HI:     INC   B   
                              DJNZ   e_resv   ; (B is as it was, and is not 0)
                              ;*Macro unroll:  POPR
                              DS   1-CPM,0CFh   
                              DS   CPM,0CDh   
                              DS   CPM,AROP&0FFh   
                              DS   CPM,AROP/256   
                              LD   B,D   
                              LD   C,E   
                              LD   A,"U"   
                              JR   error   
                                 ; chkhp: HL = the new heap top, DE = the old one, the carry is from adding
                                 ; the count. Stop if the top is not below the limit page, or is below the
                                 ; program's end.
                    CHKHP:       
058F                          ENDIF      
058F                          IF   CHECKED*CPM   
                                 ; With this much room a top that wrapped round can land back in
                                 ; range, so the add is tested too: growing (A, the count's high
                                 ; byte, is positive) must not carry, and releasing must.
                              RRA      ; the carry comes in above the sign:
                              ADD   A,40h   ;   bit 7 = carry XOR sign
                              ADD   A,A   
                              JR   C,e_heap   
                              LD   A,(0007h)   
                              DEC   A   
                              CP   H   
                              JR   C,e_heap   
058F                          ENDIF      
058F                          IF   CHECKED*(1-CPM)   
                                 ; (Here the program's space is under 32K, so a top that wrapped
                                 ; round always falls outside it.)
                              LD   A,H   
                              CP   HEAPLIM   
                              JR   NC,e_heap   
058F                          ENDIF      
058F                          IF   CHECKED   
                              PUSH   DE   
                              EX   DE,HL   
                              LD   HL,(NPEND)   
                              ADD   HL,DE   ; carry: at or above the program's end
                              EX   DE,HL   
                              POP   DE   
                              RET   C   
                    E_HEAP:   OR   A   ; put the count back in TOS for the report
                              SBC   HL,DE   
                              LD   A,"H"   
                              JR   errp   
                                 ; chkst: stop unless HL is in the program's own space: from the letter page
                                 ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
                                 ; whatever lies above the limit are safe. Memory above the heap top but
                                 ; below the limit is the program's own: Tiny BASIC keeps its lines there.
                                 ; It is the page of HL + 1 that is tested, so that one test serves both
                                 ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
                                 ; Keeps HL and BC. It runs on into its own error entry.
                    CHKST:    INC   HL   
                              LD   A,H   
                              DEC   HL   
                              CP   LETPAGE   
                              JR   C,e_store   
058F                          ENDIF      
058F                          IF   CHECKED*(1-CPM)   
                              CP   HEAPLIM   
                              RET   C   
058F                          ENDIF      
058F                          IF   CHECKED*CPM   
                              LD   E,A   
                              LD   A,(0007h)   ; the BDOS page is the heap limit
                              DEC   A   
                              CP   E   
                              RET   NC   
058F                          ENDIF      
058F                          IF   CHECKED   
                                 ; Error entries. Each loads its letter and then hides the next entry inside
                                 ; a 3-byte LD DE,nn (the 11h), so they all fall through to `error`.
                    E_STORE:   LD   A,"O"   ; a store outside the program's space
                              DB   11h   
                    E_BREAK:   LD   A,"B"   ; Ctrl-C (found inside pollk or getk)
                                 ; errp: an error found inside a routine: drop its return address first.
                    ERRP:     POP   DE   
                              JR   error   
                                 ; e_dollar: "$" ran into a NUL (in prstr): Q, with the string's address
                                 ; back in TOS. prstr"s return address goes first. But if "$' had no
                                 ; address at all (the stack was empty), it is s, found now: chkstk, called
                                 ; one cell up, sees the stack past its empty place then.
                    E_DOLLAR:   POP   DE   
                              POP   HL   
                              CALL   chkstk   
                              PUSH   HL   
                              LD   HL,(RSAVE)   
                              DB   11h   ; (LD DE,nn hides e_quote's first two bytes)
                    E_QUOTE:   LD   B,H   ; an unclosed string: HL is its address, one
                              LD   C,L   ;   past the opening quote, which is the place
                              LD   A,"Q"   
                              DB   11h   
                    E_RESV:   LD   A,"X"   ; a reserved byte outside a string
                              DB   11h   
                    E_ZERO:   LD   A,"Z"   ; dividing by zero
                              DB   11h   
                    E_BRACK:   LD   A,"W"   ; bad character after [
                                 ; error: the report, then the end. A = the letter, BC = one past the place,
                                 ; HL = TOS, and both stacks as the report is to show them:
                                 ; 
                                 ;   Err X @ line,col
                                 ;   D:n: the top 8 cells at most, bottom to top
                                 ;   R:n
                    ERROR:    PUSH   HL   ; now the whole data stack is in memory
                              LD   E,A   
                              CALL   pnl   
                              DB   "Err ",22h   
                              LD   A,E   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              CALL   pmsg   
                              DB   " @ ",22h   
                              DEC   BC   ; BC = the place
                                 ; The line and column. A place below the program is in the line
                                 ; buffer: line 0. Otherwise count the LFs from the program's start;
                                 ; DE = the line's number, HL = where it starts.
                              LD   HL,LINEBUF   
                              LD   DE,0   
                              LD   A,B   
                              CP   PROG/256   
                              JR   C,er3   
                              INC   H   
                              LD   L,E   ; HL = PROG
                    ER1:      INC   DE   ; a new line starts at HL
                              PUSH   HL   
                    ER2:      LD   A,L   
                              SUB   C   
                              LD   A,H   
                              SBC   A,B   
                              JR   NC,er2x   ; reached the place
                              LD   A,(HL)   
                              INC   HL   
                              CP   10   
                              JR   NZ,er2   
                              POP   AF   
                              JR   er1   
                    ER2X:     POP   HL   
                    ER3:      PUSH   BC   
                              PUSH   HL   
                              EX   DE,HL   
                              CALL   pdec   ; the line
                              ;*Macro unroll:  PUTK    2Ch             ; ','
                              DS   1-CPM,3Eh   ; ","
                              DS   1-CPM,2Ch   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,2Ch   
                              POP   DE   
                              POP   HL   
                              OR   A   
                              SBC   HL,DE   
                              INC   HL   
                              CALL   pdec   ; the column
                                 ; The two stack lines:  D:n: the top 8 cells at most, bottom to top
                                 ;                       R:n
                                 ; TOS is in memory with the rest (pushed) by now.
                              CALL   pnl   
                              DB   "D:",22h   
                              LD   HL,DSTOP-2   ; (DSTOP-2) - SP is twice the depth (the cell
                              SBC   HL,SP   ;   at DSTOP-2 was pushed with the first value
                                 ;   and holds nothing; pnl left the carry clear)
                              CALL   phalf   ; the depth
                              ;*Macro unroll:  PUTK    3Ah             ; ':'
                              DS   1-CPM,3Eh   ; ":"
                              DS   1-CPM,3Ah   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,3Ah   
                              LD   A,C   
                              CP   9   
                              JR   C,er6   
                              CALL   pmsg   
                              DB   " ...",22h   
                              LD   C,8   
                    ER6:      LD   H,0   ; C = the number of cells to show
                              LD   L,C   
                              ADD   HL,HL   
                              ADD   HL,SP   ; HL -> just above the deepest of them
                              INC   C   
                    ER7:      DEC   C   
                              JR   Z,er8   
                              DEC   HL   
                              LD   D,(HL)   
                              DEC   HL   
                              LD   E,(HL)   
                              PUSH   HL   
                              ;*Macro unroll:  PUTK    20h             ; ' '
                              DS   1-CPM,3Eh   ; " "
                              DS   1-CPM,20h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,20h   
                              EX   DE,HL   
                              CALL   psgn   
                              POP   HL   
                              JR   er7   
                    ER8:      CALL   pnl   
                              DB   "R:",22h   
                              PUSH   IY   ; RSTOP - IY is under 256 (the pointer is
                              POP   HL   ;   at most one entry below its page), so
                              LD   A,RSTOP&0FFh   ;   the low bytes are enough
                              SUB   L   
                              LD   L,A   
                              LD   H,0   
                              CALL   phalf   
                              CALL   pnl   
                              DB   22h   
058F                          ENDIF      
058F                          IF   CHECKED*(1-EDITOR)   
                              JP   endprog   
058F                          ENDIF      
058F                          IF   CHECKED*EDITOR   
                              JR   edit0   ; back to the editor, with both stacks cleared
058F                          ENDIF      
058F                          IF   CHECKED   
                                 ; phalf: print half of HL, and leave it in C.
                    PHALF:    SRL   H   
                              RR   L   
                              PUSH   HL   
                              CALL   pdec   
                              POP   BC   
                              RET      
058F                          ENDIF      
058F                             ; =============================================================================
058F                             ;  The line editor (EDITOR = 1)
058F                             ; 
058F                             ;  The interpreter starts here, and a program that ends comes back here.
058F                             ;  There is no prompt. It follows the spec's suggested standard for a line
058F                             ;  editor (docs/b8script.md, Environments). Type a line and press Return:
058F                             ; 
058F                             ;    n text    put the text in as line n; the lines from n on move down. A
058F                             ;              number past the end (or 0) adds the line at the end.
058F                             ;    n         take line n out
058F                             ;    anything else is run at once, as B8Script. (Start such a line with a
058F                             ;    space if it would begin with a digit.)
058F                             ; 
058F                             ;  A command key ends the line too, and takes what was typed as its argument:
058F                             ; 
058F                             ;    ^G        run the program
058F                             ;    n ^L      list from line n (no number: all of it). Any key holds the
058F                             ;              list until another key is pressed; Ctrl-C ends it.
058F                             ;    n ^E      put line n in the input line; Return puts it back, changed
058F                             ;    name ^R   read. CP/M: the file of that name (no name: the same file as
058F                             ;              last time). Generic: what is typed, or pasted, from now until
058F                             ;              ^Z replaces the program; it is not echoed.
058F                             ;    name ^W   write. CP/M: to that file (no name: the same file as last
058F                             ;              time). Generic: the text is printed, as it is.
058F                             ;    ^N        new: no program
058F                             ;    ^X        leave (to LEAVE)
058F                             ; 
058F                             ;  In the line: the left and right arrow keys move the cursor;
058F                             ;  a character goes in at the cursor; Backspace and DEL take out the one
058F                             ;  before it; Esc drops the line. Only CR, LF, BS and printing characters are
058F                             ;  sent to the terminal, so any terminal will do.
058F                             ; 
058F                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
058F                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
058F                             ;  125 characters; the one character after a line number separates it from
058F                             ;  the text and is not stored. The text is kept as it is typed, each line
058F                             ;  ending in CR LF, at PROG.
058F                             ; 
058F                             ;  What lasts from one line to the next: the program, the words, the
058F                             ;  variables and the data stack. An error or a break clears both stacks. The
058F                             ;  return stack starts empty for every line.
058F                             ; 
058F                             ;  Things to know:
058F                             ;    - Reset empties the program (generic builds).
058F                             ;    - A word's address points into the program, so run the program again
058F                             ;      after editing it.
058F                             ;    - Nothing is printed between a program's output and what is typed next.
058F                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
058F                             ;      a line that calls -n? and carries on afterwards runs what was typed.
058F                             ;      (The stored program never comes back to the line, so it may.)
058F                             ;    - The editor"s own keys are not the program"s: -n? is the plain line
058F                             ;      read of the other builds.
058F                             ; 
058F                             ;  The data stack is the CPU's stack, so the editor works on top of whatever
058F                             ;  the last line left there, with TOS pushed like the rest.
058F                             ; =============================================================================
058F                          IF   EDGEN   
                    INIT:        ; reset (A = 0)
058F                          ENDIF      
058F                          IF   EDGEN*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at 0, and
                                 ; every word cell holds 0000h, the address an undefined word is caught at
                                 ; (see e_hi).
                              LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
058F                          ENDIF      
058F                          IF   EDGEN   
                              JR   edit0   
058F                          ENDIF      
058F                          IF   EDITOR   
058F                             ; Right arrow: one to the right, by printing the character there
058F   7D           RIGHT:    LD   A,L   
0590   BB                     CP   E   
0591   28 53                  JR   Z,ed1   ; at the end
0593   7E                     LD   A,(HL)   
0594   2C                     INC   L   
0595   18 2B                  JR   lf1   
0597                             ; Esc: alone it drops the line. An arrow key sends Esc [ and a letter, so
0597                             ; wait about 5 ms for a second key: after a "[" read on to the letter that
0597                             ; ends the sequence, and act on C (right) and D (left).
0597   01 14 00     ESC:      LD   BC,5*MSLOOP   
059A   CD 71 05     ES1:      CALL   rawk   
059D   20 0A                  JR   NZ,es2   
059F   0B                     DEC   BC   
05A0   78                     LD   A,B   
05A1   B1                     OR   C   
05A2   20 F6                  JR   NZ,es1   
05A4   CD 13 06               CALL   fin   ; no second key: the line is dropped
05A7   18 28                  JR   edit   
05A9   FE 5B        ES2:      CP   "["   
05AB   20 39                  JR   NZ,ed1   ; not a sequence known here
05AD   CD 72 06     ES3:      CALL   ekey   
05B0   FE 40                  CP   40h   
05B2   38 F9                  JR   C,es3   ; (its parameters)
05B4   D6 43                  SUB   "C"   
05B6   28 D7                  JR   Z,right   
05B8   3D                     DEC   A   ; "D"?
05B9   20 2B                  JR   NZ,ed1   ; no: on into left
05BB                             ; Left arrow: the cursor goes one to the left
05BB   7D           LEFT:     LD   A,L   
05BC   87                     ADD   A,A   
05BD   28 27                  JR   Z,ed1   ; (L = 80h: at the start)
05BF   2D                     DEC   L   
05C0   3E 08                  LD   A,8   
05C2                          ;*Macro unroll: lf1:    PUTA
05C2                LF1:      DS   1-CPM,0EFh   
05C2   CD                     DS   CPM,0CDh   
05C3   79                     DS   CPM,APUT&0FFh   
05C4   05                     DS   CPM,APUT/256   
05C5   18 1F                  JR   ed1   
05C7                             ; edit0: reset, an error or a break: both stacks are cleared, and the cursor
05C7                             ;   is shown, in case the program had hidden it and could not show it again.
05C7                             ; skend: a program that ended inside skip: its return address goes.
05C7                             ; edend: a program that ended: TOS joins the rest of the data stack.
05C7   31 FA 0B     EDIT0:    LD   SP,DSTOP-2   ; empty (the cell that stands for TOS is pushed)
05CA                          ENDIF      
05CA                          IF   EDITOR*ANS   
05CA   AF                     XOR   A   ; (pshow wants the carry clear)
05CB   CD 42 03               CALL   pshow   ; ESC [ ? 2 5 h
05CE                          ENDIF      
05CE                          IF   EDITOR*(1-ANS)   
                              LD   A,1   
                              CALL   CONCUR   ; show the cursor
05CE                          ENDIF      
05CE                          IF   EDITOR   
05CE   21                     DB   21h   ; (LD HL,nn: steps over the next two bytes)
05CF   D1           SKEND:    POP   DE   
05D0   E5           EDEND:    PUSH   HL   
05D1                             ; edit: start a new input line.
05D1   FD 21 E0 0A  EDIT:     LD   IY,RSTOP   ; the return stack is empty
05D5                          ;*Macro unroll:  SETIX                   ; (a file read or written may have changed IX)
05D5   DD                     DS   CPM+FAST-CPM*FAST,0DDh   ; (a file read or written may have changed IX)
05D6   21                     DS   CPM+FAST-CPM*FAST,21h   
05D7   17                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
05D8   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
05D9   21 00 00               LD   HL,0   
05DC   22 7A 0C               LD   (KEYBUF),HL   ; no key is held, and the break key is on
05DF   22 3A 0C               LD   (EDLN),HL   ; no line is being edited
05E2   21 80 0C               LD   HL,LINEBUF   ; HL = the cursor,
05E5   5D                     LD   E,L   ;   E = the end of the line (its low byte)
05E6   CD 72 06     ED1:      CALL   ekey   
05E9   FE 7F                  CP   7Fh   
05EB   28 38                  JR   Z,bsp   ; DEL
05ED   FE 20                  CP   " "   
05EF   30 4F                  JR   NC,insc   
05F1   FE 09                  CP   9   
05F3   28 4B                  JR   Z,insc   ; Tab is text
05F5   FE 08                  CP   8   
05F7   28 2C                  JR   Z,bsp   
05F9   FE 1B                  CP   1Bh   
05FB   28 9A                  JR   Z,esc   
05FD   E5                     PUSH   HL   ; a command key? Look it up
05FE   21 78 06               LD   HL,cmds   
0601   06 08                  LD   B,NCMD   
0603   BE           ED2:      CP   (HL)   
0604   23                     INC   HL   
0605   28 07                  JR   Z,ed3   
0607   23                     INC   HL   
0608   23                     INC   HL   
0609   10 F8                  DJNZ   ed2   
060B   E1                     POP   HL   
060C   18 D8                  JR   ed1   ; no: the key is ignored
060E   7E           ED3:      LD   A,(HL)   
060F   23                     INC   HL   
0610   66                     LD   H,(HL)   
0611   6F                     LD   L,A   
0612   E3                     EX   (SP),HL   ; the command's address: fin returns to it
0613                             ; fin: end the input line: CR LF and a NUL after it, and a new line on the
0613                             ; terminal. Leaves BC -> the line and HL -> the NUL.
0613   26 0C        FIN:      LD   H,LETPAGE   
0615   6B                     LD   L,E   
0616   36 0D                  LD   (HL),13   
0618   2C                     INC   L   
0619   36 0A                  LD   (HL),10   
061B   2D                     DEC   L   
061C   CD 7A 07               CALL   prl   ; (prints the CR LF)
061F   36 00                  LD   (HL),0   
0621   01 80 0C               LD   BC,LINEBUF   
0624   C9                     RET      
0625                             ; Backspace, DEL: the character before the cursor goes. The cursor moves
0625                             ; left, the rest of the line moves down over it, and the last place (now a
0625                             ; space) is printed over along with the rest.
0625   7D           BSP:      LD   A,L   
0626   87                     ADD   A,A   
0627   28 BD                  JR   Z,ed1   ; at the start
0629   2D                     DEC   L   
062A                          ;*Macro unroll:  PUTK    08h             ; backspace
062A                          DS   1-CPM,3Eh   ; backspace
062A                          DS   1-CPM,08h   
062A                          DS   1-CPM,0EFh   
062A   CD                     DS   CPM,0CDh   
062B   75                     DS   CPM,APTK&0FFh   
062C   05                     DS   CPM,APTK/256   
062D   08                     DS   CPM,08h   
062E   E5                     PUSH   HL   
062F   2C           BS1:      INC   L   
0630   7E                     LD   A,(HL)   
0631   2D                     DEC   L   
0632   77                     LD   (HL),A   
0633   2C                     INC   L   
0634   7D                     LD   A,L   
0635   BB                     CP   E   
0636   20 F7                  JR   NZ,bs1   
0638   2D                     DEC   L   
0639   36 20                  LD   (HL)," "   
063B   E1                     POP   HL   
063C   53                     LD   D,E   
063D   1D                     DEC   E   
063E   18 17                  JR   ic2   
0640                             ; A character goes in at the cursor: it ripples up through the rest of the
0640                             ; line, the cursor moves on, and the rest is printed again.
0640   47           INSC:     LD   B,A   
0641   7B                     LD   A,E   
0642   FE FD                  CP   0FDh   
0644   28 A0                  JR   Z,ed1   ; the line is full: 125 characters
0646   78                     LD   A,B   
0647                          ;*Macro unroll:  PUTA
0647                          DS   1-CPM,0EFh   
0647   CD                     DS   CPM,0CDh   
0648   79                     DS   CPM,APUT&0FFh   
0649   05                     DS   CPM,APUT/256   
064A   E5                     PUSH   HL   
064B   7E           IC1:      LD   A,(HL)   
064C   70                     LD   (HL),B   
064D   47                     LD   B,A   
064E   7D                     LD   A,L   
064F   2C                     INC   L   
0650   BB                     CP   E   
0651   20 F8                  JR   NZ,ic1   
0653   E1                     POP   HL   
0654   2C                     INC   L   
0655   1C                     INC   E   
0656   53                     LD   D,E   
0657   CD 5C 06     IC2:      CALL   tail   
065A   18 8A                  JR   ed1   
065C                             ; tail: print the line from the cursor to D (a low byte), and bring the
065C                             ; cursor back with backspaces. Nothing at all if the cursor is at D.
065C   4D           TAIL:     LD   C,L   
065D   7D           TA1:      LD   A,L   
065E   BA                     CP   D   
065F   28 07                  JR   Z,ta2   
0661   7E                     LD   A,(HL)   
0662                          ;*Macro unroll:  PUTA
0662                          DS   1-CPM,0EFh   
0662   CD                     DS   CPM,0CDh   
0663   79                     DS   CPM,APUT&0FFh   
0664   05                     DS   CPM,APUT/256   
0665   2C                     INC   L   
0666   18 F5                  JR   ta1   
0668   7D           TA2:      LD   A,L   
0669   B9                     CP   C   
066A   C8                     RET   Z   
066B                          ;*Macro unroll:  PUTK    08h             ; backspace
066B                          DS   1-CPM,3Eh   ; backspace
066B                          DS   1-CPM,08h   
066B                          DS   1-CPM,0EFh   
066B   CD                     DS   CPM,0CDh   
066C   75                     DS   CPM,APTK&0FFh   
066D   05                     DS   CPM,APTK/256   
066E   08                     DS   CPM,08h   
066F   2D                     DEC   L   
0670   18 F6                  JR   ta2   
0672                             ; ekey: wait for a key
0672   CD 71 05     EKEY:     CALL   rawk   
0675   28 FB                  JR   Z,ekey   
0677   C9                     RET      
0678                             ; The command keys, and where each goes (after fin).
0678   0D           CMDS:     DB   13   
0679   C2 06                  DW   cret   
067B   07                     DB   7   ; ^G
067C   0A 07                  DW   crun   
067E   0C                     DB   12   ; ^L
067F   20 07                  DW   clist   
0681   05                     DB   5   ; ^E
0682   96 06                  DW   cedln   
0684   12                     DB   18   ; ^R
0685   11 08                  DW   cread   
0687   17                     DB   23   ; ^W
0688   85 07                  DW   cwrite   
068A   0E                     DB   14   ; ^N
068B   90 06                  DW   cnew   
068D   18                     DB   24   ; ^X
068E   00 00                  DW   LEAVE   
0690                NCMD:     EQU   8   
0690                             ; ^N: no program
0690   AF           CNEW:     XOR   A   
0691   32 00 0D               LD   (PROG),A   
0694   18 71        GED0:     JR   gedit   
0696                             ; ^E: line n goes into the input line, to be changed. EDLN remembers which
0696                             ; line it was: Return puts the text back in its place.
0696   CD CD 03     CEDLN:    CALL   rdnum   
0699   E5                     PUSH   HL   
069A   CD 62 07               CALL   find   ; HL -> the line, or the NUL if there is none
069D   D1                     POP   DE   
069E   7E                     LD   A,(HL)   
069F   B7                     OR   A   
06A0   28 F2                  JR   Z,ged0   
06A2   ED 53 3A 0C            LD   (EDLN),DE   
06A6   11 80 0C               LD   DE,LINEBUF   
06A9   7E           CE1:      LD   A,(HL)   ; copy it, and show it, up to its CR (or LF)
06AA   FE 0D                  CP   13   
06AC   28 0F                  JR   Z,ce2   
06AE   FE 0A                  CP   10   
06B0   28 0B                  JR   Z,ce2   
06B2   12                     LD   (DE),A   
06B3                          ;*Macro unroll:  PUTA
06B3                          DS   1-CPM,0EFh   
06B3   CD                     DS   CPM,0CDh   
06B4   79                     DS   CPM,APUT&0FFh   
06B5   05                     DS   CPM,APUT/256   
06B6   23                     INC   HL   
06B7   1C                     INC   E   
06B8   7B                     LD   A,E   
06B9   FE FD                  CP   0FDh   ; (a longer line is cut at 125 characters)
06BB   20 EC                  JR   NZ,ce1   
06BD   EB           CE2:      EX   DE,HL   ; the cursor is at the line's end
06BE   5D                     LD   E,L   
06BF   C3 E6 05               JP   ed1   
06C2                             ; Return. If ^E put a line here, the text goes back in its place. If not:
06C2                             ; a number and text is a line to put in, a number alone a line to take out,
06C2                             ; and anything else is run where it is.
06C2   E5           CRET:     PUSH   HL   ; the end of what was typed
06C3   2A 3A 0C               LD   HL,(EDLN)   
06C6   7C                     LD   A,H   
06C7   B5                     OR   L   
06C8   28 07                  JR   Z,cr1   
06CA   E5                     PUSH   HL   
06CB   CD 52 07               CALL   delln   
06CE   E1                     POP   HL   
06CF   18 13                  JR   ins   
06D1   CD CD 03     CR1:      CALL   rdnum   ; HL = the number it starts with, BC -> after
06D4   79                     LD   A,C   ; C is still 80h if there was no number:
06D5   87                     ADD   A,A   ;   only then is twice it 0
06D6   28 36                  JR   Z,st0p   ; no number: run the line
06D8   0A                     LD   A,(BC)   
06D9   FE 0D                  CP   13   
06DB   20 06                  JR   NZ,cr2   
06DD   D1                     POP   DE   ; the number alone: take that line out
06DE   CD 52 07               CALL   delln   
06E1   18 24                  JR   gedit   
06E3   03           CR2:      INC   BC   ; step over the one character after the number
06E4                             ; Put the text at BC in as line n (in HL): open a gap of its length there,
06E4                             ; CR and LF included, and copy it in.
06E4   CD 62 07     INS:      CALL   find   ; HL -> where it goes
06E7   D1                     POP   DE   ; the end of what was typed
06E8   7B                     LD   A,E   
06E9   91                     SUB   C   ; A = the length of the text, with its CR LF
06EA   C5                     PUSH   BC   ; the text
06EB   4F                     LD   C,A   
06EC   06 00                  LD   B,0   
06EE   C5                     PUSH   BC   ; its length
06EF   54                     LD   D,H   
06F0   5D                     LD   E,L   ; DE = where it goes
06F1   AF                     XOR   A   
06F2   4F                     LD   C,A   ; BC = 0: CPIR looks as far as it needs to
06F3   ED B1                  CPIR      ; HL -> one past the program's NUL
06F5   ED 52                  SBC   HL,DE   ; the number of bytes to move up, NUL included
06F7   44                     LD   B,H   
06F8   4D                     LD   C,L   
06F9   19                     ADD   HL,DE   
06FA   2B                     DEC   HL   ; HL -> the NUL
06FB   EB                     EX   DE,HL   
06FC   E3                     EX   (SP),HL   ; HL = the length; where it goes is kept
06FD   E5                     PUSH   HL   
06FE   19                     ADD   HL,DE   ; the NUL's new place
06FF   EB                     EX   DE,HL   
0700   ED B8                  LDDR      ; move the rest of the program up
0702   C1                     POP   BC   ; the length
0703   D1                     POP   DE   ; where it goes
0704   E1                     POP   HL   ; the text
0705   ED B0                  LDIR      
0707   C3 D1 05     GEDIT:    JP   edit   
070A                             ; ^G: run the program. st0p: run the typed line (BC -> it).
070A   01 00 0D     CRUN:     LD   BC,PROG   
070D   3E                     DB   3Eh   ; (LD A,n: steps over the POP)
070E   E1           ST0P:     POP   HL   ; (the end of what was typed)
070F                             ; st0: start running at BC. The heap starts after the stored program's NUL.
070F   21 00 0D     ST0:      LD   HL,PROG   
0712   AF                     XOR   A   
0713   BE           ST1:      CP   (HL)   
0714   23                     INC   HL   
0715   20 FC                  JR   NZ,st1   
0717   22 7C 0C               LD   (HEAP),HL   
071A                          ENDIF      
071A                          IF   EDITOR*QK   
071A   CD 65 04               CALL   skclr   ; every run starts with an empty skip cache
071D                          ENDIF      
071D                          IF   EDITOR*CHECKED   
                              ;*Macro unroll:  NEGH                    ; minus the heap's first address: '_' may not
                              DS   1-CPM,0E7h   ; minus the heap"s first address: "_' may not
                              DS   CPM,0CDh   
                              DS   CPM,ANEG&0FFh   
                              DS   CPM,ANEG/256   
                              LD   (NPEND),HL   ;   release below it
071D                          ENDIF      
071D                          IF   EDITOR   
071D   E1                     POP   HL   ; TOS: the data stack is as the last line left it
071E                          ;*Macro unroll:  NEXT                    ; (its return address is thrown away)
071E                          DS   (1-CPM)*(1-FAST),0F7h   ; (its return address is thrown away)
071E   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
071F   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0720                             ; ^L: list from line n. DE = the number of the line at HL.
0720   CD CD 03     CLIST:    CALL   rdnum   ; HL = n, or 0 if there was none:
0723   7C                     LD   A,H   
0724   B5                     OR   L   
0725   20 01                  JR   NZ,li0   
0727   2C                     INC   L   ;   then from line 1
0728   E5           LI0:      PUSH   HL   
0729   CD 62 07               CALL   find   
072C   D1                     POP   DE   
072D   7E           LI1:      LD   A,(HL)   
072E   B7                     OR   A   
072F   28 D6                  JR   Z,gedit   ; the end of the text
0731   CD 71 05               CALL   rawk   
0734   28 09                  JR   Z,li3   ; no key: carry on
0736   FE 03                  CP   3   
0738   C4 72 06               CALL   NZ,ekey   ; any key but Ctrl-C: wait for one more
073B   FE 03                  CP   3   
073D   28 C8                  JR   Z,gedit   ; Ctrl-C, first or second, ends the list
073F   E5           LI3:      PUSH   HL   
0740   D5                     PUSH   DE   
0741   EB                     EX   DE,HL   
0742   CD EE 04               CALL   pdec   ; the line's number,
0745   3E 20                  LD   A," "   
0747                          ;*Macro unroll:  PUTA                    ;   a space,
0747                          DS   1-CPM,0EFh   ;   a space,
0747   CD                     DS   CPM,0CDh   
0748   79                     DS   CPM,APUT&0FFh   
0749   05                     DS   CPM,APUT/256   
074A   D1                     POP   DE   
074B   E1                     POP   HL   
074C   13                     INC   DE   
074D   CD 7A 07               CALL   prl   ;   and the line
0750   18 DB                  JR   li1   
0752                             ; delln: take line n (in HL) out: copy everything after it down over it.
0752   CD 62 07     DELLN:    CALL   find   
0755   54                     LD   D,H   
0756   5D                     LD   E,L   
0757   CD 70 07               CALL   nxl   ; HL -> the next line
075A   7E           DE1:      LD   A,(HL)   
075B   12                     LD   (DE),A   
075C   23                     INC   HL   
075D   13                     INC   DE   
075E   B7                     OR   A   
075F   20 F9                  JR   NZ,de1   
0761   C9                     RET      
0762                             ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
0762                             ; of the text if there are fewer lines (or the number is 0). Keeps BC.
0762   EB           FIND:     EX   DE,HL   
0763   21 00 0D               LD   HL,PROG   
0766   1B           FI1:      DEC   DE   
0767   7A                     LD   A,D   
0768   B3                     OR   E   
0769   C8                     RET   Z   
076A   CD 70 07               CALL   nxl   
076D   20 F7                  JR   NZ,fi1   
076F   C9                     RET      
0770                             ; nxl: step HL over one line, to just past its LF (and return not-zero), or
0770                             ; stop at the NUL that ends the text (and return zero).
0770   7E           NXL:      LD   A,(HL)   
0771   B7                     OR   A   
0772   C8                     RET   Z   
0773   23                     INC   HL   
0774   FE 0A                  CP   10   
0776   20 F8                  JR   NZ,nxl   
0778   B7                     OR   A   
0779   C9                     RET      
077A                             ; prl: print the line at HL, to its LF; HL -> just past it.
077A   7E           PRL:      LD   A,(HL)   
077B                          ;*Macro unroll:  PUTA
077B                          DS   1-CPM,0EFh   
077B   CD                     DS   CPM,0CDh   
077C   79                     DS   CPM,APUT&0FFh   
077D   05                     DS   CPM,APUT/256   
077E   7E                     LD   A,(HL)   
077F   23                     INC   HL   
0780   FE 0A                  CP   10   
0782   20 F6                  JR   NZ,prl   
0784   C9                     RET      
0785                          ENDIF      
0785                          IF   EDGEN   
                    GED1:     JP   edit   
                                 ; ^R, generic: what comes in from now until ^Z is the program. A CR is
                                 ; stored as CR LF; a LF right after a line end is dropped (it is the CR's
                                 ; own, or an empty line's), and a LF anywhere else ends a line too. A last
                                 ; line with no end is given one. Nothing is echoed, and there is no check
                                 ; for running out of memory.
                    CREAD:    LD   HL,PROG-1   
                              LD   (HL),10   ; (as if a line had just ended: the byte is
                              INC   HL   ;   the line buffer's last, and spare)
                    RD1:      CALL   ekey   
                              LD   C,A   
                              CP   1Ah   
                              JR   NZ,rd2   
                              LD   A,10   ; ^Z ends the last line, as a LF would
                    RD2:      CP   10   
                              JR   NZ,rd3   
                              DEC   HL   
                              CP   (HL)   
                              INC   HL   
                              JR   Z,rd4   ; straight after a line end: dropped
                              LD   A,13   ; anywhere else it ends the line
                    RD3:      LD   (HL),A   
                              INC   HL   
                              CP   13   
                              JR   NZ,rd4   
                              LD   (HL),10   ; after a CR goes a LF
                              INC   HL   
                    RD4:      LD   A,C   
                              CP   1Ah   
                              JR   NZ,rd1   
                              LD   (HL),0   
                              JR   ged1   
                                 ; ^W, generic: the text is printed as it is, for the terminal to capture.
                    CWRITE:   LD   HL,PROG   
                    CW1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,ged1   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              INC   HL   
                              JR   cw1   
0785                          ENDIF      
0785                          IF   EDITOR*CPM   
0785                CFCB:     EQU   005Ch   ; the file's name is kept here, where the CCP
0785                             ;   put the one from the command line
0785                             ; ^W, CP/M: write the file: delete the old one, make it anew, write the
0785                             ; text in records of 128 bytes, and close it. The text's NUL and the 127
0785                             ; bytes after it are set to ^Z meanwhile, which pads the last record. (A
0785                             ; full disk or directory is not noticed: the calls fail and that is all.)
0785   CD D2 07     CWRITE:   CALL   setname   
0788   0E 13                  LD   C,19   ; delete
078A   CD 0B 08               CALL   fbdos   
078D   0E 16                  LD   C,22   ; make
078F   CD 0B 08               CALL   fbdos   
0792   21 00 0D               LD   HL,PROG   
0795   AF                     XOR   A   
0796   BE           CW1:      CP   (HL)   
0797   23                     INC   HL   
0798   20 FC                  JR   NZ,cw1   
079A   2B                     DEC   HL   ; HL -> the NUL
079B   E5                     PUSH   HL   
079C   06 80                  LD   B,128   
079E   36 1A        CW2:      LD   (HL),1Ah   
07A0   23                     INC   HL   
07A1   10 FB                  DJNZ   cw2   
07A3   E1                     POP   HL   
07A4   11 00 0D               LD   DE,PROG   
07A7   7B           CW3:      LD   A,E   ; a record that starts before the end is written
07A8   95                     SUB   L   
07A9   7A                     LD   A,D   
07AA   9C                     SBC   A,H   
07AB   30 09                  JR   NC,cw4   
07AD   E5                     PUSH   HL   
07AE   0E 15                  LD   C,21   ; write, from where the record lies
07B0   CD C0 07               CALL   frec   
07B3   E1                     POP   HL   
07B4   18 F1                  JR   cw3   
07B6   36 00        CW4:      LD   (HL),0   ; the NUL again
07B8   0E 10                  LD   C,16   ; close
07BA   CD 0B 08               CALL   fbdos   
07BD   C3 D1 05               JP   edit   
07C0                             ; frec: BDOS function C (read or write a record) with the 128 bytes at DE.
07C0                             ; Returns A = the BDOS's answer, HL = DE and DE = DE + 128.
07C0   D5           FREC:     PUSH   DE   
07C1   C5                     PUSH   BC   
07C2   0E 1A                  LD   C,26   ; set the DMA address
07C4   CD 05 00               CALL   BDOS   
07C7   C1                     POP   BC   
07C8   CD 0B 08               CALL   fbdos   
07CB   D1                     POP   DE   
07CC   21 80 00               LD   HL,128   
07CF   19                     ADD   HL,DE   
07D0   EB                     EX   DE,HL   
07D1   C9                     RET      
07D2                             ; setname: if a name was typed (the line does not start with its CR), put it
07D2                             ; in the FCB: up to 8 characters, a dot, up to 3 more, in capitals. The drive
07D2                             ; is the current one. Then, name or no name, clear the FCB after the name,
07D2                             ; as it must be before a file is opened or made.
07D2   11 80 0C     SETNAME:   LD   DE,LINEBUF   
07D5   1A                     LD   A,(DE)   
07D6   FE 0D                  CP   13   
07D8   28 26                  JR   Z,fcbclr   
07DA   21 5C 00               LD   HL,CFCB   
07DD   36 00                  LD   (HL),0   ; the current drive
07DF   06 0B                  LD   B,11   
07E1   2C           SN1:      INC   L   
07E2   36 20                  LD   (HL)," "   
07E4   10 FB                  DJNZ   sn1   
07E6   2E 5D                  LD   L,CFCB+1   
07E8   1A           SN2:      LD   A,(DE)   
07E9   13                     INC   DE   
07EA   FE 0D                  CP   13   
07EC   28 12                  JR   Z,fcbclr   
07EE   FE 2E                  CP   "."   
07F0   20 04                  JR   NZ,sn3   
07F2   2E 65                  LD   L,CFCB+9   ; the type
07F4   18 F2                  JR   sn2   
07F6   FE 61        SN3:      CP   "a"   
07F8   38 02                  JR   C,sn4   
07FA   E6 5F                  AND   5Fh   ; a capital
07FC   77           SN4:      LD   (HL),A   
07FD   2C                     INC   L   
07FE   18 E8                  JR   sn2   
0800   21 68 00     FCBCLR:   LD   HL,CFCB+12   
0803   06 18                  LD   B,24   
0805   36 00        FC1:      LD   (HL),0   
0807   23                     INC   HL   
0808   10 FB                  DJNZ   fc1   
080A   C9                     RET      
080B                             ; fbdos: BDOS function C on the file
080B   11 5C 00     FBDOS:    LD   DE,CFCB   
080E   C3 05 00               JP   BDOS   
0811                             ; ^R, CP/M: read the file. A name typed before the key is the file's name
0811                             ; from now on. (On into load, which returns to edit.)
0811   CD D2 07     CREAD:    CALL   setname   
0814   21 D1 05               LD   HL,edit   
0817   E5                     PUSH   HL   
0818                             ; load: read the file into PROG. No such file: no program. The text ends at
0818                             ; the file"s first ^Z (1Ah), which pads a text file"s last record; one more
0818                             ; goes after the last record, so the search always stops. And every line
0818                             ; must end in LF: a last line without one is given a CR LF. (The FCB is
0818                             ; clear after its name: the CCP left it so, or setname did.)
0818   0E 0F        LOAD:     LD   C,15   ; open (no such file: the first read fails
081A   CD 0B 08               CALL   fbdos   ;   too)
081D   11 00 0D               LD   DE,PROG   
0820   0E 14        LD1:      LD   C,20   ; read the next 128 bytes
0822   CD C0 07               CALL   frec   
0825   B7                     OR   A   
0826   28 F8                  JR   Z,ld1   
0828   36 1A                  LD   (HL),1Ah   ; (HL = where the record that failed would be)
082A   21 FF 0C               LD   HL,PROG-1   
082D   3E 0A                  LD   A,10   ; (a file with no text needs nothing added)
082F   23           TR1:      INC   HL   
0830   5F                     LD   E,A   ; E = the character before this one
0831   7E                     LD   A,(HL)   
0832   FE 1A                  CP   1Ah   
0834   20 F9                  JR   NZ,tr1   
0836   7B                     LD   A,E   
0837   FE 0A                  CP   10   
0839   28 06                  JR   Z,tr2   
083B   36 0D                  LD   (HL),13   
083D   23                     INC   HL   
083E   36 0A                  LD   (HL),10   
0840   23                     INC   HL   
0841   36 00        TR2:      LD   (HL),0   
0843   C9                     RET      
0844                          ENDIF      
0844                             ; =============================================================================
0844                          IF   CPM   
0844                             ; The RAM pages follow the image; the heap may grow to the BDOS.
0844                START:       
0844                          ENDIF      
0844                          IF   CPM*CHECKED*(1-EDITOR)   
                                 ; Clear the lower half of the letter page (as the editor build does
                                 ; at its start).
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
0844                          ENDIF      
0844                          IF   CPM*(1-EDITOR)   
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:      LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
0844                          ENDIF      
0844                          IF   CPM*(1-EDITOR)*QK   
                              CALL   skclr   ; an empty skip cache
0844                          ENDIF      
0844                          IF   CPM*(1-EDITOR)   
                              JP   st2   
0844                          ENDIF      
0844                          IF   FAST   
                                 ; =============================================================================
                                 ;  The fast build (SPEED = 2)
                                 ; 
                                 ;  The inner loop is a table: 256 entries, the low bytes of the handlers'
                                 ;  addresses in one page and the high bytes in the next. The dispatcher (at
                                 ;  next0, and inline, as NEXTF, at the end of the fast build's own entries,
                                 ;  so there is no jump back to it; the ordinary handlers end in JP (IX), with
                                 ;  IX = next0, as in the CP/M builds):
                                 ; 
                                 ;      LD A,(BC) / INC BC / EX DE,HL / LD L,A / LD H,DTAB/256 /
                                 ;      LD A,(HL) / INC H / LD H,(HL) / LD L,A / JP (HL)
                                 ; 
                                 ;  So every entry starts with TOS in DE, not HL. The punctuation entries are
                                 ;  thunks into the ordinary handlers (EX DE,HL / JP handler); the letters and
                                 ;  digits have one entry each, which knows its cell or its value already.
                                 ; =============================================================================
                    FTSTORE:   EX   DE,HL   ; !
                              JP   h_store   
                    FTSTR:    EX   DE,HL   ; "
                              JP   h_str   
                    FTNUM:    EX   DE,HL   ; #
                              JP   h_num   
                    FTPRINT:   EX   DE,HL   ; $
                              JP   h_print   
                    FTSWAP:   EX   DE,HL   ; %
                              JP   h_swap   
                    FTAND:    EX   DE,HL   ; &
                              JP   h_and   
                    FTEMIT:   EX   DE,HL   ; '
                              JP   h_emit   
                    FTOPEN:   EX   DE,HL   ; (
                              JP   h_open   
                    FTCLOSE:   EX   DE,HL   ; )
                              JP   h_close   
                    FTMUL:    EX   DE,HL   ; *
                              JP   h_mul   
                    FTADD:    EX   DE,HL   ; +
                              JP   h_add   
                    FTCFETCH:   EX   DE,HL   ; ,
                              JP   h_cfetch   
                    FTSUB:    EX   DE,HL   ; -
                              JP   h_sub   
                    FTCSTORE:   EX   DE,HL   ; .
                              JP   h_cstore   
                    FTDIV:    EX   DE,HL   ; /
                              JP   h_div   
                    FTDUP:    EX   DE,HL   ; :
                              JP   h_dup   
                    FTDROP:   EX   DE,HL   ; ;
                              JP   h_drop   
                    FTLT:     EX   DE,HL   ; <
                              JP   h_lt   
                    FTEQ:     EX   DE,HL   ; =
                              JP   h_eq   
                    FTGT:     EX   DE,HL   ; >
                              JP   h_gt   
                    FTKEY:    EX   DE,HL   ; ?
                              JP   h_key   
                    FTFETCH:   EX   DE,HL   ; @
                              JP   h_fetch   
                    FTDEF:    EX   DE,HL   ; [
                              JP   h_def   
                    FTBREAK:   EX   DE,HL   ; \
                              JP   h_break   
                    FTRET:    EX   DE,HL   ; ]
                              JP   h_ret   
                    FTXOR:    EX   DE,HL   ; ^
                              JP   h_xor   
                    FTALLOC:   EX   DE,HL   ; _
                              JP   h_alloc   
                    FTGRAVE:   EX   DE,HL   ; `
                              JP   h_grave   
                    FTTOR:    EX   DE,HL   ; {
                              JP   h_tor   
                    FTOR:     EX   DE,HL   ; |
                              JP   h_or   
                    FTFROMR:   EX   DE,HL   ; }
                              JP   h_fromr   
                    FTNOT:    EX   DE,HL   ; ~
                              JP   h_not   
                                 ; The commonest punctuation, written for the fast build: TOS in DE on the
                                 ; way in, and the dispatcher inline on the way out.
                    FS_ADD:      ; +
                              POP   HL   
                              ADD   HL,DE   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_SUB:      ; -
                              LD   A,(BC)   ; a digit next: a negative number
                              SUB   "0"   
                              CP   10   
                              JR   C,fs_neg   
                              POP   HL   
                              OR   A   
                              SBC   HL,DE   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_NEG:   EX   DE,HL   
                              JP   h_sub   
                    FS_DUP:      ; :
                              PUSH   DE   
                              EX   DE,HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_DROP:      ; ;
                              POP   HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_SWAP:      ; %
                              POP   HL   
                              PUSH   DE   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_FET:      ; @
                              EX   DE,HL   
                              LD   E,(HL)   
                              INC   HL   
                              LD   D,(HL)   
                              EX   DE,HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_CFET:      ; ,
                              LD   A,(DE)   
                              LD   L,A   
                              LD   H,0   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_LT:       ; <
                              POP   HL   ; a < b: HL = a, DE = b
                    FS_LT1:   LD   A,H   
                              XOR   80h   
                              LD   H,A   
                              LD   A,D   
                              XOR   80h   
                              LD   D,A   
                              SBC   HL,DE   ; carry if HL < DE
                              SBC   HL,HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_GT:       ; >
                              POP   HL   ; a > b  is  b < a
                              EX   DE,HL   
                              JP   fs_lt1   
                    FS_EQ:       ; =
                              POP   HL   
                              OR   A   
                              SBC   HL,DE   
                              LD   A,H   
                              OR   L   
                              CP   1   ; carry only if a - b = 0
                              SBC   HL,HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_AND:      ; &
                              POP   HL   
                              LD   A,H   
                              AND   D   
                              LD   H,A   
                              LD   A,L   
                              AND   E   
                              LD   L,A   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
