0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Intel 8080
0000                             ;  Spec: docs/b8script.md (2026-10-09) plus the 2026-11-20 changes:
0000                             ;        [x stores in a variable, "[ " pushes an anonymous block, any other
0000                             ;        character after [ is an error, the heap pointer lives at z10+.
0000                             ;        The string escape is "/" (it was ">").
0000                             ;        "/" leaves ( r q ), the quotient on top; dividing by zero is not
0000                             ;        checked. -n? does no more editing than Backspace.
0000                             ;  Design follows the Z80 interpreter (z80/b8s-z80.asm), with 8080 opcodes
0000                             ;  only.
0000                             ; 
0000                             ;  Two switches, set in the two EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    CHECKED  0 = no checks (spec: "B8Script checks nothing")
0000                             ;             1 = stops on stack overrun, Ctrl-C, heap past the limit, a store
0000                             ;                 outside the program's own space, and a bad character after [,
0000                             ;                 printing a letter and the place, like  S @ 245
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), I8080 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   0   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   0   ; 1 = checked build
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the 8080"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  The return stack pointer has no register (the 8080 has no spare pair): it
0000                             ;  is the RAM word RSP. Only rpop, rpushd and ")" (and the checks) touch it.
0000                             ; 
0000                             ;  One-byte calls. The routines used most are reached with RST, one byte
0000                             ;  instead of three. (asm80 wants the vector number: RST 1 = RST 08h.)
0000                             ; 
0000                             ;    RST 1  08h  rpop    pop the return stack into HL
0000                             ;    RST 3  18h  drop    drop TOS, then next character     (ends a handler)
0000                             ;    RST 4  20h  neg16   HL = -HL
0000                             ;    RST 5  28h  putc    print A
0000                             ;    RST 6  30h  next    next character                    (ends a handler)
0000                             ; 
0000                             ;  RST 3 and RST 6 never return: an RST is a CALL, so the first thing each
0000                             ;  of them does is POP D to throw the return address away.
0000                             ; 
0000                             ;  The CP/M build can't own page zero, so the block from `vecs` to `vecend`
0000                             ;  (image addresses 0108h-0133h) is copied to 0008h-0033h when it starts. The
0000                             ;  code in that block has no jumps inside itself, so it works at either place.
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; 
0000                             ;  What the 8080 lacks, and what replaces it: no JR (JMP/Jcc), no DJNZ, no
0000                             ;  SBC HL (byte-wise SUB/SBB, or negate and DAD), no shifts on register pairs
0000                             ;  (DAD H doubles; RAL/RAR through A), no LDIR/CPIR (small loops).
0000                             ; -----------------------------------------------------------------------------
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (SP stays inside this page)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch (= z10+), interpreter variables in the gaps, and the -n?
0000                             ;             line buffer at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack's page has a guard band: the data
0000                             ;  stack can overrun by a cell or two (and the calls made while it is full)
0000                             ;  into the top 32 bytes of the return-stack page, which are never used, and
0000                             ;  the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
                    BDOS:     EQU   0005h   
                    EXIT:     EQU   0000h   ; warm boot
                    BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IFN   CPM   
0000                             ; ---- generic machine: edit these to suit -----------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The zero flag must match A
0000                             ;   (end the routine with ORA A / RET).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                             ;   KEY and CONOUT must preserve BC, DE and HL.
0000                RSPAGE:   EQU   80h   ; 8000h return stack
0000                DSPAGE:   EQU   81h   ; 8100h data stack
0000                LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
0000                PROG:     EQU   8300h   ; where the loader puts the program text
0000                HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
0000                BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; z10+, the heap pointer
0000                RSP:      EQU   LET+34h   ; gap after Z: the return stack pointer;
0000                KEYBUF:   EQU   LET+36h   ;   a held-back key
0000                LBHDR:    EQU   LET+7Eh   ; CP/M BDOS 10 header: max, count
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FEh   ; empty data stack
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is the start of the .COM file, and 0108h-0133h is also copied to
0000                             ;  page zero (see the header).
0000                             ; =============================================================================
0000                          .ORG   BASE   
0000   31 FE 81               LXI   SP,DSTOP   ; 00  reset, or the start of the .COM file
0003   C3 DA 02               JMP   start   
0006   CF           RDROP:    RST   1   ; 06  drop the top of the return stack, then
0007   DF                     RST   3   ;     drop TOS (a spent flag) and go on
0008                VECS:        
0008                             ; ---- RST 1: rpop: pop the return stack into HL (DE is lost) -----------------
0008   2A 34 82     RPOP:     LHLD   RSP   ; 08
000B   5E                     MOV   E,M   
000C   23                     INX   H   
000D   56                     MOV   D,M   
000E   23                     INX   H   
000F   22 34 82               SHLD   RSP   
0012   EB                     XCHG      
0013   C9                     RET      ; 13  (so RST 2 is not used)
0014   EB           H_TOR:    XCHG      ; 14  "{" TOS to the return stack; rpushd
0015   C3 AA 00               JMP   rpushd   ;     brings up the new TOS
0018                             ; ---- RST 3: drop TOS, then next ---------------------------------------------
0018   D1           RST18:    POP   D   ; 18  discard the RST's return address
0019   E1                     POP   H   ;     new TOS = NOS
001A   C3 31 00               JMP   next0   
001D   E5           H_FROMR:   PUSH   H   ; 1D  "}" return stack to TOS
001E   CF                     RST   1   
001F   F7                     RST   6   
0020                             ; ---- RST 4: neg16: HL = -HL (keeps BC, DE) ----------------------------------
0020   AF           NEG16:    XRA   A   ; 20
0021   95                     SUB   L   
0022   6F                     MOV   L,A   
0023   9F                     SBB   A   
0024   94                     SUB   H   
0025   67                     MOV   H,A   
0026   C9                     RET      
0027   E9           JPHL:     PCHL      ; 27  (for the machine-code call)
0028                             ; ---- RST 5: putc: print A (keeps BC, DE, HL) --------------------------------
0028                RST28:       
0028                          IFN   CPM   
0028   C3 03 FF     PUTC:     JMP   CONOUT   ; 28
002B                          ENDIF      
002B                          IF   CPM   
                              JMP   putc   ; 28
002B                          ENDIF      
002B                             ; exec: "`" with no hex digit after it: call the machine code at TOS. It
002B                             ; returns here, with its top cell on the stack: that becomes the new TOS.
002B   CD 27 00     EXEC:     CALL   jphl   ; 2B
002E   E1                     POP   H   
002F   F7                     RST   6   
0030                             ; ---- RST 6: next character --------------------------------------------------
0030   D1           RST30:    POP   D   ; 30  discard the RST's return address
0031                          IF   CPM   
                              JMP   next0   ; (this copy runs in page zero)
0031                          ENDIF      
0031                VECEND:      
0031                             ; =============================================================================
0031                             ;  The inner loop: read one character and sort it by range.
0031                             ; 
0031                             ;    00h          end of program
0031                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0031                             ;    30h-39h      digit: read a whole number
0031                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0031                             ;    61h-7Ah      a-z: push the address of that letter's cell
0031                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0031                             ; =============================================================================
0031                NEXT0:       
0031                          IF   CHECKED   
                              CALL   chkstk   ; both stacks are checked once per character
0031                          ENDIF      
0031   0A                     LDAX   B   
0032   03                     INX   B   
0033   D6 21                  SUI   21h   ; A = c - 21h
0035   DA 74 00               JC   ctl   ; c < 21h: NUL ends, the rest are ignored
0038   FE 0F                  CPI   0Fh   
003A   DA 65 00               JC   punct   ; 21h-2Fh: PTAB index 0-14
003D   D6 0F                  SUI   0Fh   ; A = c - 30h
003F   FE 0A                  CPI   0Ah   
0041   DA 3A 02               JC   digit   ; 30h-39h
0044   FE 11                  CPI   11h   
0046   DA 63 00               JC   p3a   ; 3Ah-40h
0049   D6 11                  SUI   11h   ; A = c - 41h
004B   FE 1A                  CPI   1Ah   
004D   DA A0 00               JC   upper   ; 41h-5Ah: A = letter index 0-25
0050   FE 20                  CPI   20h   
0052   DA 61 00               JC   p5b   ; 5Bh-60h
0055   FE 3A                  CPI   3Ah   
0057   DA 9A 00               JC   lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
005A   FE 3E                  CPI   3Eh   
005C   D2 31 00               JNC   next0   ; 7Fh-FFh: ignored
005F   D6 1A                  SUI   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
0061   D6 09        P5B:      SUI   9   ; 5Bh-60h: -4 in all, index 22-27
0063   C6 05        P3A:      ADI   5   ; 3Ah-40h: index 15-21
0065                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
0065                             ; untouched, and A, DE free.
0065   C6 1A        PUNCT:    ADI   PTAB & 0FFh   ; PTAB never crosses a page
0067   5F                     MOV   E,A   
0068   16 02                  MVI   D,PTAB / 256   
006A   FE 30                  CPI   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
006C   1A                     LDAX   D   
006D   5F                     MOV   E,A   ; the handler's low byte
006E                          IFN   CPM   
006E   3E 00                  MVI   A,0   
0070   17                     RAL      ; its page: 0 + carry
0071                          ENDIF      
0071                          IF   CPM   
                              MVI   A,1   
                              ACI   0   ; its page: 1 + carry
0071                          ENDIF      
0071   57                     MOV   D,A   
0072   D5                     PUSH   D   ; jump to it; the stack is balanced again
0073   C9                     RET      ;   when the handler starts
0074                             ; ctl: characters below 21h. A = c - 21h.
0074   C6 21        CTL:      ADI   21h   ; back to c; zero only for NUL
0076   C2 31 00               JNZ   next0   ; the rest are ignored
0079   C3 09 FF     ENDPROG:   JMP   EXIT   ; the program has ended
007C                             ; =============================================================================
007C                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
007C                             ;  (00bbIGFuZCA= are up among the RST routines.)
007C                             ; =============================================================================
007C   D1           H_XOR:    POP   D   
007D   7C                     MOV   A,H   
007E   AA                     XRA   D   
007F   67                     MOV   H,A   
0080   7D                     MOV   A,L   
0081   AB                     XRA   E   
0082   6F                     MOV   L,A   
0083   F7                     RST   6   
0084   D1           H_OR:     POP   D   
0085   7C                     MOV   A,H   
0086   B2                     ORA   D   
0087   67                     MOV   H,A   
0088   7D                     MOV   A,L   
0089   B3                     ORA   E   
008A   6F                     MOV   L,A   
008B   F7                     RST   6   
008C   E7           H_NOT:    RST   4   ; ~x = -x - 1
008D   2B                     DCX   H   
008E   F7                     RST   6   
008F                             ; "_" ( n -- addr ): the heap pointer moves up by n; TOS is the old pointer.
008F   EB           H_ALLOC:   XCHG      
0090   2A 7C 82               LHLD   HEAP   
0093   E5                     PUSH   H   
0094   19                     DAD   D   ; the new top
0095                          IF   CHECKED   
                              CALL   chkhp   
0095                          ENDIF      
0095   22 7C 82               SHLD   HEAP   
0098   E1                     POP   H   
0099   F7                     RST   6   
009A                             ; ---- the letters and digits --------------------------------------------------
009A                             ; a-z: push the cell's address (the cell is the variable)
009A   E5           LOWER:    PUSH   H   
009B   87                     ADD   A   
009C   6F                     MOV   L,A   
009D   26 82                  MVI   H,LETPAGE   
009F   F7                     RST   6   
00A0                             ; A-Z: call the word. The return address (the IP after the letter) goes on
00A0                             ; the return stack, and the IP becomes the address in the letter's cell.
00A0   E5           UPPER:    PUSH   H   ; keep TOS: rpushd pops it back
00A1   87                     ADD   A   
00A2   6F                     MOV   L,A   
00A3   26 82                  MVI   H,LETPAGE   ; HL -> cell
00A5   50                     MOV   D,B   
00A6   59                     MOV   E,C   ; DE = the return address
00A7   4E                     MOV   C,M   
00A8   23                     INX   H   
00A9   46                     MOV   B,M   ; IP = the word's body, and fall into rpushd
00AA                             ; rpushd: push DE on the return stack, then pop TOS off the data stack and
00AA                             ; go on. Every push of the return stack ends here: for a word call the cell
00AA                             ; popped is the TOS that upper parked; for "(" and "{" it is the cell under
00AA                             ; the one that was used up.
00AA                RPUSHD:      
00AA                          IF   CHECKED   
                              CALL   chkbrk   ; Ctrl-C is checked at every word call, block
00AA                          ENDIF      ;   entry, loop-back and "{"
00AA   2A 34 82               LHLD   RSP   
00AD   2B                     DCX   H   
00AE   72                     MOV   M,D   
00AF   2B                     DCX   H   
00B0   73                     MOV   M,E   
00B1   22 34 82               SHLD   RSP   
00B4   E1                     POP   H   
00B5   F7                     RST   6   
00B6                             ; ---- machine code: the grave -----------------------------------------------
00B6                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
00B6                             ; are stored from addr until a non-hex character; then a RET (C9h) is
00B6                             ; written and its address is left. An odd last digit is consumed and dropped.
00B6                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
00B6                             ; code is entered by CALL with the data stack above the return address; it
00B6                             ; must keep BC, and on return the top cell becomes the new TOS.
00B6   CD C7 02     H_GRAVE:   CALL   hexc   
00B9   D2 2B 00               JNC   exec   
00BC   87           HX1:      ADD   A   
00BD   87                     ADD   A   
00BE   87                     ADD   A   
00BF   87                     ADD   A   
00C0   57                     MOV   D,A   ; the high digit
00C1   CD C7 02               CALL   hexc   
00C4   D2 D0 00               JNC   hx2   ; odd digit: consumed and dropped
00C7   B2                     ORA   D   
00C8                          IF   CHECKED   
                              CALL   chkst   
00C8                          ENDIF      
00C8   77                     MOV   M,A   
00C9   23                     INX   H   
00CA   CD C7 02               CALL   hexc   
00CD   DA BC 00               JC   hx1   
00D0                HX2:         
00D0                          IF   CHECKED   
                              CALL   chkst   
00D0                          ENDIF      
00D0   36 C9                  MVI   M,0C9h   
00D2   F7                     RST   6   
00D3                             ; ---- where the two pages meet ----------------------------------------------
00D3                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
00D3                             ; are in falling code order for this), and where exactly differs between the
00D3                             ; builds: NPG1 follows. Every handler below these four must start in the
00D3                             ; second page, and every one above in the first; chktab.py checks both.
00D3                             ; "]" returns: pop an address and jump to it. TOS is parked on the stack
00D3                             ; while rpop uses HL, and the drop at the end brings it back.
00D3   E5           H_RET:    PUSH   H   
00D4   CF           RET2:     RST   1   
00D5   44                     MOV   B,H   
00D6   4D                     MOV   C,L   
00D7   DF                     RST   3   
00D8                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
00D8                             ; drops the block start, "]" returns. No closer at all ends the program.
00D8                             ; The flag stays in HL as the spent cell that rdrop and ret2 drop.
00D8   7C           H_BREAK:   MOV   A,H   
00D9   B5                     ORA   L   
00DA   CA B8 01               JZ   h_drop   ; false: just drop the flag
00DD   CD 90 02               CALL   skip   
00E0   B7                     ORA   A   ; skip returns 0 for ")"
00E1   C2 D4 00               JNZ   ret2   
00E4   C3 06 00               JMP   rdrop   
00E7                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
00E7                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
00E7                             ; the body"s address instead. Either way it then skips to the matching "]'.
00E7                             ; (The unchecked build takes anything below "A" as the space, and anything
00E7                             ; from "A" up as a letter.)
00E7   0A           H_DEF:    LDAX   B   
00E8   03                     INX   B   
00E9   D6 41                  SUI   "A"   ; 0-25 or 32-57: lowercase lands 64 bytes up
00EB                          IF   1-CHECKED   
00EB   DA FA 00               JC   def2   
00EE                          ENDIF      
00EE                          IF   CHECKED   
                              CPI   " "-"A"+256   
                              JZ   def2   
                              MOV   E,A   
                              ANI   0DFh   ; fold case
                              CPI   26   
                              JNC   e_brack   ; anything but a letter or a space
                              MOV   A,E   
00EE                          ENDIF      
00EE   87                     ADD   A   
00EF   5F                     MOV   E,A   
00F0   16 82                  MVI   D,LETPAGE   ; DE -> cell
00F2   79                     MOV   A,C   
00F3   12                     STAX   D   
00F4   1C                     INR   E   
00F5   78                     MOV   A,B   
00F6   12                     STAX   D   
00F7   C3 FD 00               JMP   skipnx   
00FA   E5           DEF2:     PUSH   H   ; an anonymous block: push its address
00FB   60                     MOV   H,B   
00FC   69                     MOV   L,C   
00FD   CD 90 02     SKIPNX:   CALL   skip   
0100   F7                     RST   6   
0101   5E           H_FETCH:   MOV   E,M   ; "@"
0102   23                     INX   H   
0103   56                     MOV   D,M   
0104   EB                     XCHG      
0105   F7                     RST   6   
0106                             ; =============================================================================
0106                             ;  Handlers that must start in the image's second page.
0106                             ;  "?" is the last (with "," inside it in the unchecked build), so its long
0106                             ;  tail may run past that page.
0106                             ; =============================================================================
0106                             ; ---- flow control ----------------------------------------------------------
0106                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
0106                             ; the matching ")".
0106   7C           H_OPEN:   MOV   A,H   
0107   B5                     ORA   L   
0108   E1                     POP   H   
0109   CA FD 00               JZ   skipnx   
010C   E5                     PUSH   H   ; (rpushd pops it again)
010D   50                     MOV   D,B   
010E   59                     MOV   E,C   ; the block starts at the IP
010F   C3 AA 00               JMP   rpushd   
0112                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
0112                             ; drops it and carries on.
0112   7C           H_CLOSE:   MOV   A,H   
0113   B5                     ORA   L   
0114   CA 06 00               JZ   rdrop   
0117   CF                     RST   1   ; pop the block start ...
0118   44                     MOV   B,H   
0119   4D                     MOV   C,L   ; ... jump to it ...
011A   EB                     XCHG      
011B   C3 AA 00               JMP   rpushd   ; ... and push it back (which drops the flag)
011E                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
011E                             ; "-" has two jobs: directly before a digit it starts a negative number.
011E   0A           H_SUB:    LDAX   B   
011F   D6 30                  SUI   "0"   
0121   FE 0A                  CPI   10   
0123   DA 40 02               JC   negnum   
0126   E7                     RST   4   ; a - b = a + (-b): fall into "+"
0127   D1           H_ADD:    POP   D   
0128   19                     DAD   D   
0129   F7                     RST   6   
012A   D1           H_AND:    POP   D   
012B   7C                     MOV   A,H   
012C   A2                     ANA   D   
012D   67                     MOV   H,A   
012E   7D                     MOV   A,L   
012F   A3                     ANA   E   
0130   6F                     MOV   L,A   
0131   F7                     RST   6   
0132                             ; Signed compares. Both are "DE < HL" for the right pair: > swaps the two
0132                             ; cells first (XTHL), < doesn't. There is no overflow flag, so the signed
0132                             ; answer is the unsigned borrow of DE - HL, flipped when the signs differ.
0132                             ; SBB A turns a carry into -1 or 0 with no branch.
0132   E3           H_GT:     XTHL      ; a > b  is  b < a
0133   D1           H_LT:     POP   D   ; a < b: DE = a, HL = b
0134   7B                     MOV   A,E   
0135   95                     SUB   L   
0136   7A                     MOV   A,D   
0137   9C                     SBB   H   
0138   9F                     SBB   A   ; A = -1 if DE < HL unsigned
0139   6F                     MOV   L,A   
013A   7C                     MOV   A,H   
013B   AA                     XRA   D   
013C   17                     RAL      ; carry = the signs differ
013D   9F                     SBB   A   
013E   AD                     XRA   L   ; flip when they do
013F   67                     MOV   H,A   
0140   6F                     MOV   L,A   
0141   F7                     RST   6   
0142   D1           H_EQ:     POP   D   
0143   7D                     MOV   A,L   
0144   AB                     XRA   E   
0145   6F                     MOV   L,A   
0146   7C                     MOV   A,H   
0147   AA                     XRA   D   
0148   B5                     ORA   L   ; zero if equal
0149   D6 01                  SUI   1   ; carry only for zero
014B   9F                     SBB   A   
014C   67                     MOV   H,A   
014D   6F                     MOV   L,A   
014E   F7                     RST   6   
014F                             ; "*": shift-and-add on the multiplier's low bit, so it stops as soon as the
014F                             ; multiplier is used up; only the low 16 bits are kept.
014F   D1           H_MUL:    POP   D   ; DE = multiplicand
0150   C5                     PUSH   B   
0151   44                     MOV   B,H   
0152   4D                     MOV   C,L   ; BC = multiplier
0153   21 00 00               LXI   H,0   
0156   78           MUL1:     MOV   A,B   
0157   B7                     ORA   A   ; clear carry
0158   1F                     RAR      
0159   47                     MOV   B,A   
015A   79                     MOV   A,C   
015B   1F                     RAR      
015C   4F                     MOV   C,A   ; BC >> 1, carry = the bit shifted out
015D   D2 61 01               JNC   mul2   
0160   19                     DAD   D   
0161   EB           MUL2:     XCHG      
0162   29                     DAD   H   ; multiplicand << 1
0163   EB                     XCHG      
0164   78                     MOV   A,B   
0165   B1                     ORA   C   
0166   C2 56 01               JNZ   mul1   
0169   C1                     POP   B   
016A   F7                     RST   6   
016B                             ; "/" ( a b -- r q ): the quotient is on top. Truncates toward zero; r takes
016B                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
016B                             ; of a. Dividing by zero is not checked: it returns two cells of no meaning.
016B   D1           H_DIV:    POP   D   ; DE = a, HL = b
016C   C5                     PUSH   B   
016D   7A                     MOV   A,D   
016E   B7                     ORA   A   
016F   F5                     PUSH   PSW   ; S flag = sign of a (for r)
0170   AC                     XRA   H   
0171   F5                     PUSH   PSW   ; S flag = sign of q
0172   7C                     MOV   A,H   
0173   B7                     ORA   A   
0174   FC 20 00               CM   neg16   ; HL = |b|
0177   EB                     XCHG      
0178   7C                     MOV   A,H   
0179   B7                     ORA   A   
017A   FC 20 00               CM   neg16   ; HL = |a|, DE = |b|
017D   CD 5D 02               CALL   udiv   ; HL = q, BC = r
0180   F1                     POP   PSW   
0181   FC 20 00               CM   neg16   ; q's sign
0184   EB                     XCHG      ; DE = q
0185   60                     MOV   H,B   
0186   69                     MOV   L,C   ; HL = r
0187   F1                     POP   PSW   
0188   FC 20 00               CM   neg16   ; r's sign
018B   C1                     POP   B   
018C   E5                     PUSH   H   ; r under q
018D   EB                     XCHG      ; HL = q
018E   F7                     RST   6   
018F                             ; ---- stack and storage -----------------------------------------------------
018F   E5           H_DUP:    PUSH   H   ; ":"
0190   F7                     RST   6   
0191   E3           H_SWAP:   XTHL      ; "%"
0192   F7                     RST   6   
0193   D1           H_STORE:   POP   D   ; "!" ( n addr -- )
0194                          IF   CHECKED   
                              INX   H   ; both bytes must be in the program's space
                              CALL   chkst   
                              DCX   H   
0194                          ENDIF      
0194   73                     MOV   M,E   
0195   23                     INX   H   
0196   72                     MOV   M,D   
0197   DF                     RST   3   
0198   D1           H_CSTORE:   POP   D   ; "." ( c addr -- )
0199                          IF   CHECKED   
                              CALL   chkst   
0199                          ENDIF      
0199   73                     MOV   M,E   
019A   DF                     RST   3   
019B                             ; ---- console ---------------------------------------------------------------
019B                             ; 22h pushes the address of the text after it and skips the string.
019B   E5           H_STR:    PUSH   H   
019C   60                     MOV   H,B   
019D   69                     MOV   L,C   
019E   CD BA 02               CALL   skipstr   
01A1   F7                     RST   6   
01A2                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character
01A2                             ; clears that character"s bit 6 (/M is CR, /` is space; "/" and ""' have no
01A2                             ; bit 6, so // and /" give themselves).
01A2   7E           H_PRINT:   MOV   A,M   
01A3   23                     INX   H   
01A4   FE 22                  CPI   22h   
01A6   CA B8 01               JZ   h_drop   
01A9   FE 2F                  CPI   "/"   
01AB   C2 B2 01               JNZ   pr1   
01AE   7E                     MOV   A,M   
01AF   23                     INX   H   
01B0   E6 BF                  ANI   0BFh   
01B2   EF           PR1:      RST   5   
01B3   C3 A2 01               JMP   h_print   
01B6   7D           H_EMIT:   MOV   A,L   ; "'"
01B7   EF                     RST   5   
01B8   DF           H_DROP:   RST   3   ; ";" is this one byte
01B9                             ; "#" prints TOS as a signed decimal number, with no space after it.
01B9   7C           H_NUM:    MOV   A,H   
01BA   B7                     ORA   A   
01BB   F2 C2 01               JP   num1   
01BE   3E 2D                  MVI   A,"-"   
01C0   EF                     RST   5   
01C1   E7                     RST   4   
01C2   C5           NUM1:     PUSH   B   
01C3   CD 7E 02               CALL   pdec   
01C6   C1                     POP   B   
01C7   DF                     RST   3   
01C8                          IF   CHECKED   ; (the checked build has no room to start ","
                    H_CFETCH:   MOV   L,M   ;   as late as the unchecked one does: see
                              MVI   H,0   ;   the end of "?")
                              RST   6   
01C8                          ENDIF      
01C8                             ; "?" ( n -- c ) or ( -n -- addr )
01C8                             ;   n > 0: wait about n ms for a key; 0 if none came
01C8                             ;   n = 0: wait for a key
01C8                             ;   n < 0: read a line of at most -n characters, with echo. n is not
01C8                             ;          checked: the buffer holds 127 characters and the CR, so a
01C8                             ;          program must ask for 127 or fewer.
01C8   7C           H_KEY:    MOV   A,H   
01C9   B7                     ORA   A   
01CA   FA EA 01               JM   line   
01CD   1E 28        KT1:      MVI   E,MSLOOP   ; one millisecond, roughly
01CF   CD 06 FF     KT2:      CALL   getk   
01D2   C2 E6 01               JNZ   kt3   
01D5   1D                     DCR   E   
01D6   C2 CF 01               JNZ   kt2   
01D9   7C                     MOV   A,H   ; 0? never counts down: it waits
01DA   B5                     ORA   L   
01DB   CA CD 01               JZ   kt1   
01DE   2B                     DCX   H   
01DF   7C                     MOV   A,H   
01E0   B5                     ORA   L   
01E1   C2 CD 01               JNZ   kt1   ; A = 0 if the time ran out
01E4                          IF   1-CHECKED   
01E4   FE                     DB   0FEh   ; (CPI: steps over the one byte of ",")
01E5   7E           H_CFETCH:   MOV   A,M   ; "," shares "?"s ending: A becomes TOS
01E6                          ENDIF      
01E6   6F           KT3:      MOV   L,A   
01E7   26 00                  MVI   H,0   
01E9   F7                     RST   6   
01EA                          IF   CPM   
                                 ; CP/M: BDOS 10 does the editing (the spec allows the platform's
                                 ; own line editor). It doesn't store the CR, so it is added here.
                    LINE:     XRA   A   
                              SUB   L   ; A = the count (TOS is minus the count)
                              STA   LBHDR   
                              PUSH   B   
                              LXI   D,LBHDR   
                              MVI   C,10   
                              CALL   BDOS   
                              POP   B   
                              LXI   H,LBHDR+1   
                              MOV   A,M   ; the count typed (0-127)
                              INR   L   ; HL = LINEBUF, whose low byte is 80h:
                              ADD   L   ;   adding the count to L can't carry
                              MOV   L,A   
                              MVI   M,13   
                              MVI   L,LINEBUF & 0FFh   
                              RST   6   
01EA                          ENDIF      
01EA                          IFN   CPM   
01EA                             ; Generic: Backspace takes the last character back (and is echoed as
01EA                             ; it is), CR ends (stored, not echoed), every other key is stored and
01EA                             ; echoed until the line is full. The line buffer starts at offset 80h
01EA                             ; of its page, so L alone is the place in the line: D holds the L of
01EA                             ; a full line.
01EA   3E 80        LINE:     MVI   A,LINEBUF & 0FFh   
01EC   95                     SUB   L   ; (TOS is minus the count)
01ED   57                     MOV   D,A   ; D = the L of a full line
01EE   21 80 82               LXI   H,LINEBUF   
01F1   CD 06 FF     LN2:      CALL   getk   
01F4   CA F1 01               JZ   ln2   
01F7   FE 0D                  CPI   13   
01F9   CA 16 02               JZ   ln5   
01FC   FE 08                  CPI   8   
01FE   CA 0E 02               JZ   ln4   
0201   5F                     MOV   E,A   
0202   7D                     MOV   A,L   
0203   BA                     CMP   D   
0204   CA F1 01               JZ   ln2   ; full
0207   73                     MOV   M,E   
0208   2C                     INR   L   
0209   7B                     MOV   A,E   
020A   EF           LN3:      RST   5   
020B   C3 F1 01               JMP   ln2   
020E   2D           LN4:      DCR   L   ; Backspace: one back, and echo it,
020F   FA 0A 02               JM   ln3   ;   unless the line was empty (L left the
0212   2C                     INR   L   ;   upper half of the page)
0213   C3 F1 01               JMP   ln2   
0216   77           LN5:      MOV   M,A   ; the CR
0217   2E 80                  MVI   L,LINEBUF & 0FFh   
0219   F7                     RST   6   
021A                          ENDIF      
021A                             ; =============================================================================
021A                             ;  Dispatch table: the low byte of each handler's address, in code order.
021A                             ;  It must not cross a page (the dispatcher only adds to its low byte).
021A                             ; =============================================================================
021A                             ; The handlers of the first NPG1 characters start in the image's second page.
021A                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
021A                             ; differs between the builds, so the count is worked out here.
021A                             ; (One division to a line: asm80 only rounds down when it stores a value.)
021A                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
021A                PGBRK:    EQU   (h_break-BASE)/256   
021A                PGDEF:    EQU   (h_def-BASE)/256   
021A                PGFET:    EQU   (h_fetch-BASE)/256   
021A                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
021A   93           PTAB:     DB   h_store & 0FFh   ; !
021B   9B                     DB   h_str & 0FFh   ; "
021C   B9                     DB   h_num & 0FFh   ; #
021D   A2                     DB   h_print & 0FFh   ; $
021E   91                     DB   h_swap & 0FFh   ; %
021F   2A                     DB   h_and & 0FFh   ; &
0220   B6                     DB   h_emit & 0FFh   ; '
0221   06                     DB   h_open & 0FFh   ; (
0222   12                     DB   h_close & 0FFh   ; )
0223   4F                     DB   h_mul & 0FFh   ; *
0224   27                     DB   h_add & 0FFh   ; +
0225   E5                     DB   h_cfetch & 0FFh   ; ,
0226   1E                     DB   h_sub & 0FFh   ; -
0227   98                     DB   h_cstore & 0FFh   ; .
0228   6B                     DB   h_div & 0FFh   ; /
0229   8F                     DB   h_dup & 0FFh   ; :
022A   B8                     DB   h_drop & 0FFh   ; ;
022B   33                     DB   h_lt & 0FFh   ; <
022C   42                     DB   h_eq & 0FFh   ; =
022D   32                     DB   h_gt & 0FFh   ; >
022E   C8                     DB   h_key & 0FFh   ; ?
022F   01                     DB   h_fetch & 0FFh   ; @
0230   E7                     DB   h_def & 0FFh   ; [
0231   D8                     DB   h_break & 0FFh   ; \
0232   D3                     DB   h_ret & 0FFh   ; ]
0233   7C                     DB   h_xor & 0FFh   ; ^
0234   8F                     DB   h_alloc & 0FFh   ; _
0235   B6                     DB   h_grave & 0FFh   ; `
0236   14                     DB   h_tor & 0FFh   ; {
0237   84                     DB   h_or & 0FFh   ; |
0238   1D                     DB   h_fromr & 0FFh   ; }
0239   8C                     DB   h_not & 0FFh   ; ~
023A                PTABEND:      
023A                             ; =============================================================================
023A                             ;  Routines (no handler starts past this point)
023A                             ; =============================================================================
023A                             ; Digits: step back onto the first digit and read the whole number.
023A   E5           DIGIT:    PUSH   H   
023B   0B                     DCX   B   
023C   CD 46 02               CALL   rdnum   
023F   F7                     RST   6   
0240                             ; negnum: "-" directly before a digit: read the number, negate it.
0240   E5           NEGNUM:   PUSH   H   
0241   CD 46 02               CALL   rdnum   
0244   E7                     RST   4   
0245   F7                     RST   6   
0246                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
0246                             ; non-digit. Values wrap at 16 bits, as the spec says.
0246   21 00 00     RDNUM:    LXI   H,0   
0249   0A           RDN1:     LDAX   B   
024A   D6 30                  SUI   "0"   
024C   FE 0A                  CPI   10   
024E   D0                     RNC      
024F   03                     INX   B   
0250   54                     MOV   D,H   
0251   5D                     MOV   E,L   
0252   29                     DAD   H   
0253   29                     DAD   H   
0254   19                     DAD   D   
0255   29                     DAD   H   ; HL * 10
0256   5F                     MOV   E,A   
0257   16 00                  MVI   D,0   
0259   19                     DAD   D   
025A   C3 49 02               JMP   rdn1   
025D                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, BC = remainder.
025D                             ; Uses A, BC; the caller saves the IP. HL holds the dividend and, as its bits
025D                             ; leave at the top, the quotient bits arrive at the bottom. The loop counter
025D                             ; lives on the stack, since A is busy with the shifts.
025D   01 00 00     UDIV:     LXI   B,0   
0260   3E 10                  MVI   A,16   
0262   F5                     PUSH   PSW   
0263   29           UDV1:     DAD   H   ; next dividend bit into the carry
0264   79                     MOV   A,C   
0265   17                     RAL      
0266   4F                     MOV   C,A   
0267   78                     MOV   A,B   
0268   17                     RAL      
0269   47                     MOV   B,A   ; BC = BC*2 + bit
026A   79                     MOV   A,C   
026B   93                     SUB   E   
026C   78                     MOV   A,B   
026D   9A                     SBB   D   ; carry if BC < DE
026E   DA 76 02               JC   udv2   
0271   47                     MOV   B,A   ; BC - DE (high byte; A holds it)
0272   79                     MOV   A,C   
0273   93                     SUB   E   
0274   4F                     MOV   C,A   
0275   2C                     INR   L   ; quotient bit
0276   F1           UDV2:     POP   PSW   
0277   3D                     DCR   A   
0278   F5                     PUSH   PSW   
0279   C2 63 02               JNZ   udv1   
027C   F1                     POP   PSW   
027D   C9                     RET      
027E                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
027E                             ; Uses BC.
027E   11 0A 00     PDEC:     LXI   D,10   
0281   CD 5D 02               CALL   udiv   ; HL = HL / 10, C = the last digit
0284   79                     MOV   A,C   
0285   F5                     PUSH   PSW   
0286   7C                     MOV   A,H   
0287   B5                     ORA   L   
0288   C4 7E 02               CNZ   pdec   
028B   F1                     POP   PSW   
028C   C6 30                  ADI   "0"   
028E   EF                     RST   5   
028F   C9                     RET      
0290                             ; skip: read past text to the closer at this level, and return A = 0 if it
0290                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
0290                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
0290                             ; no closer; anything else that runs into the NUL had unbalanced brackets
0290                             ; anyway). D counts the open levels, starting at 1 for the one we are in.
0290   16 01        SKIP:     MVI   D,1   
0292   0A           SK1:      LDAX   B   
0293   03                     INX   B   
0294   B7                     ORA   A   
0295   CA 79 00               JZ   endprog   
0298   FE 22                  CPI   22h   
029A   CC BA 02               CZ   skipstr   ; leaves A = 22h, which matches nothing below
029D   D6 28                  SUI   "("   
029F   CA B5 02               JZ   sk3   
02A2   3D                     DCR   A   ; ")"
02A3   CA B0 02               JZ   sk4   
02A6   D6 32                  SUI   "["-")"   
02A8   CA B5 02               JZ   sk3   
02AB   FE 02                  CPI   "]"-"["   
02AD   C2 92 02               JNZ   sk1   
02B0   15           SK4:      DCR   D   
02B1   C8                     RZ      ; the closer at this level
02B2   C3 92 02               JMP   sk1   
02B5   14           SK3:      INR   D   
02B6   C3 92 02               JMP   sk1   
02B9                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
02B9                             ; the next character, so "/"" does not end it. Leaves A = 22h.
02B9   03           SS0:      INX   B   
02BA   0A           SKIPSTR:   LDAX   B   
02BB   03                     INX   B   
02BC   FE 2F                  CPI   "/"   
02BE   CA B9 02               JZ   ss0   
02C1   FE 22                  CPI   22h   
02C3   C2 BA 02               JNZ   skipstr   
02C6   C9                     RET      
02C7                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
02C7                             ; and return its value in A with the carry set; otherwise leave the IP and
02C7                             ; return with the carry clear.
02C7   0A           HEXC:     LDAX   B   
02C8   D6 30                  SUI   "0"   
02CA   FE 0A                  CPI   10   
02CC   DA D8 02               JC   hc1   
02CF   E6 DF                  ANI   0DFh   
02D1   D6 11                  SUI   11h   
02D3   FE 06                  CPI   6   
02D5   D0                     RNC      
02D6   D6 F6                  SUI   0F6h   ; + 10, and sets the carry
02D8   03           HC1:      INX   B   
02D9   C9                     RET      
02DA                             ; =============================================================================
02DA                             ;  Console layer: getk returns a waiting key in A (zero flag clear), or
02DA                             ;  A = 0 with the zero flag set when none is waiting. putc (RST 5) prints A.
02DA                             ;  Both keep BC, DE and HL. In the generic build they are the host's KEY and
02DA                             ;  CONOUT routines themselves.
02DA                             ; =============================================================================
02DA                          IF   (1-CPM)*(1-CHECKED)   
02DA                GETK:     EQU   KEY   ; the host's routine does the whole job
02DA                          ENDIF      
02DA                          IF   CHECKED   
                    GETK:     PUSH   H   ; a key held back by the break check goes
                              LXI   H,KEYBUF   ;   first, and is taken out of the buffer
                              MOV   A,M   
                              MVI   M,0   
                              POP   H   
                              ORA   A   
                              RNZ      
02DA                          ENDIF      
02DA                          IF   (1-CPM)*CHECKED   
                              JMP   KEY   
02DA                          ENDIF      
02DA                          IF   CPM*(1-CHECKED)   
                    GETK:        
02DA                          ENDIF      
02DA                          IF   CPM   
                              MVI   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
                                 ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
                                 ; printing and could swallow a key that BDOS 6 then never sees.
                    PUTC:     PUSH   B   
                              PUSH   D   
                              PUSH   H   
                              MOV   E,A   
                              MVI   C,6   
                              CALL   BDOS   
                              POP   H   
                              POP   D   
                              POP   B   
                              ORA   A   ; (for getk)
                              RET      
02DA                          ENDIF      
02DA                             ; =============================================================================
02DA                             ;  Checked build: the checks and the error report
02DA                             ; =============================================================================
02DA                          IF   CHECKED   
                                 ; chkstk: both stacks are checked once per character, not in every handler.
                                 ; Each stack lives in one page, so it has overrun exactly when the pointer's
                                 ; high byte has left that page. Errors are caught one cell late at most; the
                                 ; page below each stack is a guard band. (The call itself is on the data
                                 ; stack, but in the same page whenever the stack is in range.)
                    CHKSTK:   XCHG      ; DE = TOS (HL is needed for the pointers)
                              LXI   H,0   
                              DAD   SP   
                              MOV   A,H   
                              CPI   DSPAGE   
                              JNZ   e_stack   
                              LHLD   RSP   ; the return stack: in its page, and not
                              MOV   A,L   ;   above its empty position (an underflow
                              CPI   RSTOP&0FFh+1   ;   would stay inside the page, in the
                              JNC   e_rstack   ;   guard band)
                              MOV   A,H   
                              CPI   RSPAGE   
                              JNZ   e_rstack   
                              XCHG      ; TOS back
                              RET      
                                 ; chkbrk: a waiting key is read now; Ctrl-C stops the program, anything
                                 ; else is held for the next "?". Keeps BC, DE, HL.
                    CHKBRK:   CALL   getk   
                              RZ      
                              CPI   3   
                              JZ   e_break   
                              STA   KEYBUF   
                              RET      
                                 ; chkst: stop unless HL is in the program's own space: from the letter page
                                 ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
                                 ; whatever lies above the limit are safe. Memory above the heap top but
                                 ; below the limit is the program's own: Tiny BASIC keeps its lines there.
                                 ; Keeps every register.
                    CHKST:    PUSH   PSW   
                              MOV   A,H   
                              CPI   LETPAGE   
                              JC   e_store   
02DA                          ENDIF      
02DA                          IF   CHECKED*(1-CPM)   
                              CPI   HEAPLIM   
                              JNC   e_store   
02DA                          ENDIF      
02DA                          IF   CHECKED*CPM   
                              LDA   0007h   ; the BDOS page is the heap limit
                              DCR   A   
                              CMP   H   
                              JC   e_store   
02DA                          ENDIF      
02DA                          IF   CHECKED   
                              POP   PSW   
                              RET      
                                 ; chkhp: stop if working out the new heap top carried (a negative count
                                 ; wraps: too big), or if the new top in HL is not below the limit page.
                    CHKHP:    JC   e_heap   
02DA                          ENDIF      
02DA                          IF   CHECKED*(1-CPM)   
                              MOV   A,H   
                              CPI   HEAPLIM   
                              RC      
02DA                          ENDIF      
02DA                          IF   CHECKED*CPM   
                              LDA   0007h   
                              DCR   A   
                              CMP   H   
                              RNC      
02DA                          ENDIF      
02DA                          IF   CHECKED   
                                 ; Error entries. Each loads its letter and then hides the next entry inside
                                 ; a 3-byte LXI H (the 21h), so they all fall through to `error`.
                    E_HEAP:   MVI   A,"H"   ; heap past the limit
                              DB   21h   
                    E_STORE:   MVI   A,"W"   ; write outside the program's space
                              DB   21h   
                    E_STACK:   MVI   A,"S"   ; data stack over or under
                              DB   21h   
                    E_RSTACK:   MVI   A,"R"   ; return stack over or under
                              DB   21h   
                    E_BREAK:   MVI   A,"B"   ; Ctrl-C
                              DB   21h   
                    E_BRACK:   MVI   A,"D"   ; bad character after [
                                 ; error: print the letter in A, " @ " and the offset in the program of the
                                 ; character just read, then end. For example: S @ 245
                    ERROR:    LXI   SP,DSTOP   ; the stacks may be wrecked: start clean
                              RST   5   
                              MVI   A," "   
                              RST   5   
                              MVI   A,"@"   
                              RST   5   
                              MVI   A," "   
                              RST   5   
                              LXI   H,(0-PROG-1)&0FFFFh   ; minus the address of the character
                              DAD   B   ;   just read: HL = its offset
                              CALL   pdec   
                              JMP   endprog   
02DA                          ENDIF      
02DA                             ; =============================================================================
02DA                             ;  Startup
02DA                             ; =============================================================================
02DA                START:       
02DA                          IF   CPM   
                                 ; CP/M: the RAM pages follow the image; the heap may grow to the BDOS
                              LXI   H,vecs   ; the RST routines go down into page zero
                              LXI   D,0008h   
                              MVI   B,vecend-vecs   
                    CPY:      MOV   A,M   
                              STAX   D   
                              INX   H   
                              INX   D   
                              DCR   B   
                              JNZ   cpy   
                              LXI   D,005Ch   ; open the file named on the command line
                              MVI   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LXI   D,PROG   
                    LD1:      PUSH   D   
                              MVI   C,26   ; set the DMA address
                              CALL   BDOS   
                              LXI   D,005Ch   
                              MVI   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   H   ; HL = the address this record went to
                              ORA   A   
                              JNZ   ld2   
                              LXI   D,128   
                              DAD   D   
                              XCHG      
                              JMP   ld1   
                    LD2:      MVI   M,0   ; the end of the file counts as NUL
                              INX   H   ; the heap starts after it
02DA                          ENDIF      
02DA                          IFN   CPM   
02DA   21 00 83               LXI   H,PROG   ; the heap starts after the program's NUL
02DD   7E           FNUL:     MOV   A,M   
02DE   23                     INX   H   
02DF   B7                     ORA   A   
02E0   C2 DD 02               JNZ   fnul   
02E3                          ENDIF      
02E3   22 7C 82               SHLD   HEAP   
02E6   21 E0 80               LXI   H,RSTOP   ; the return stack is empty
02E9   22 34 82               SHLD   RSP   
02EC                          IF   CHECKED   
                              XRA   A   
                              STA   KEYBUF   ; no key held back
02EC                          ENDIF      
02EC   01 00 83               LXI   B,PROG   ; the IP
02EF   F7                     RST   6   ; (its return address is thrown away)
02F0                          IF   CPM   
                                 ; RAM pages, after the image
                    RSPAGE:   EQU   (imgend + 255) / 256   
                    DSPAGE:   EQU   RSPAGE + 1   
                    LETPAGE:   EQU   RSPAGE + 2   
                    PROG:     EQU   LETPAGE*256 + 256   
02F0                          ENDIF      
02F0                IMGEND:      


