015E   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
015F   31                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
0160   00                     DS   CPM+FAST-CPM*FAST,ANXT/256   
0161                             ; ---- stack and storage -----------------------------------------------------
0161   E5           H_DUP:    PUSH   H   ; ":"
0162                          ;*Macro unroll:  NEXT
0162                          DS   (1-CPM)*(1-FAST),0F7h   
0162   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
0163   31                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
0164   00                     DS   CPM+FAST-CPM*FAST,ANXT/256   
0165   E3           H_SWAP:   XTHL      ; "%"
0166                          ;*Macro unroll:  NEXT
0166                          DS   (1-CPM)*(1-FAST),0F7h   
0166   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
0167   31                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
0168   00                     DS   CPM+FAST-CPM*FAST,ANXT/256   
0169                             ; (The checked build tests the address before it takes the value off the
0169                             ; stack, so that an error report shows both.)
0169                H_STORE:      ; "!" ( n addr -- )
0169                          IF   CHECKED   
                              CALL   chkst   
0169                          ENDIF      
0169   D1                     POP   D   
016A   73                     MOV   M,E   
016B   23                     INX   H   
016C   72                     MOV   M,D   
016D                          ;*Macro unroll:  DROP
016D                          DS   (1-CPM)*(1-FAST),0DFh   
016D                          DS   CPM*(1-FAST),0C3h   
016D                          DS   CPM*(1-FAST),ADRP&0FFh   
016D                          DS   CPM*(1-FAST),ADRP/256   
016D   E1                     DS   FAST,0E1h   
016E   C3                     DS   FAST,0C3h   
016F   31                     DS   FAST,ANXT&0FFh   
0170   00                     DS   FAST,ANXT/256   
0171                H_CSTORE:      ; "." ( c addr -- )
0171                          IF   CHECKED   
                              CALL   chkst   
0171                          ENDIF      
0171   D1                     POP   D   
0172   73                     MOV   M,E   
0173                          ;*Macro unroll:  DROP
0173                          DS   (1-CPM)*(1-FAST),0DFh   
0173                          DS   CPM*(1-FAST),0C3h   
0173                          DS   CPM*(1-FAST),ADRP&0FFh   
0173                          DS   CPM*(1-FAST),ADRP/256   
0173   E1                     DS   FAST,0E1h   
0174   C3                     DS   FAST,0C3h   
0175   31                     DS   FAST,ANXT&0FFh   
0176   00                     DS   FAST,ANXT/256   
0177                             ; ---- console ---------------------------------------------------------------
0177                             ; 22h pushes the address of the text after it and skips the string.
0177   E5           H_STR:    PUSH   H   
0178   60                     MOV   H,B   
0179   69                     MOV   L,C   
017A   CD B2 04               CALL   skipstr   
017D                          IF   CHECKED   
                              ORA   A   ; 0: the text ran out before the closing quote
                              JZ   e_quote   
017D                          ENDIF      
017D                          ;*Macro unroll:  NEXT
017D                          DS   (1-CPM)*(1-FAST),0F7h   
017D   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
017E   31                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
017F   00                     DS   CPM+FAST-CPM*FAST,ANXT/256   
0180                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
0180                             ; 60h to 7Eh is one of the escapes at pesc; "/" plus any other character
0180                             ; clears that character"s bit 6 (/M is CR, and / then DEL gives "?"; "/',
0180                             ; '"' and '?' have no bit 6, so //, /" and /? give themselves).
0180                          IF   1-CHECKED   
0180   C3 DA 03     H_PRINT:   JMP   prlp   ; (the loop is with the escapes, out of the
0183                PRLOOP:   EQU   prlp   ;   way of the handlers, which must fit in
0183                PRAGAIN:   EQU   prlp   ;   the image's first two pages)
0183                          ENDIF      
0183                          IF   CHECKED   
                                 ; (The checked build has the loop as a routine, prstr, which the error
                                 ; report uses too. The address is kept meanwhile, for a report: it shows
                                 ; the stack as it was before the "$". /~ comes back to hp1.)
                    H_PRINT:   SHLD   PSAVE   
                    HP1:      CALL   prstr   
                              ;*Macro unroll:  DROP
                              DS   (1-CPM)*(1-FAST),0DFh   
                              DS   CPM*(1-FAST),0C3h   
                              DS   CPM*(1-FAST),ADRP&0FFh   
                              DS   CPM*(1-FAST),ADRP/256   
                              DS   FAST,0E1h   
                              DS   FAST,0C3h   
                              DS   FAST,ANXT&0FFh   
                              DS   FAST,ANXT/256   
0183                          ENDIF      
0183   7D           H_EMIT:   MOV   A,L   ; "'"
0184                          ;*Macro unroll:  PUTA
0184   EF                     DS   1-CPM,0EFh   
0185                          DS   CPM,0CDh   
0185                          DS   CPM,APUT&0FFh   
0185                          DS   CPM,APUT/256   
0185                          ;*Macro unroll: h_drop: DROP                    ; ';' is this one byte
0185                H_DROP:   DS   (1-CPM)*(1-FAST),0DFh   ; ";" is this one byte
0185                          DS   CPM*(1-FAST),0C3h   
0185                          DS   CPM*(1-FAST),ADRP&0FFh   
0185                          DS   CPM*(1-FAST),ADRP/256   
0185   E1                     DS   FAST,0E1h   
0186   C3                     DS   FAST,0C3h   
0187   31                     DS   FAST,ANXT&0FFh   
0188   00                     DS   FAST,ANXT/256   
0189                             ; "#" prints TOS as a signed decimal number, with no space after it.
0189   C5           H_NUM:    PUSH   B   
018A   CD BF 03               CALL   psgn   
018D   C1                     POP   B   
018E                          ;*Macro unroll:  DROP
018E                          DS   (1-CPM)*(1-FAST),0DFh   
018E                          DS   CPM*(1-FAST),0C3h   
018E                          DS   CPM*(1-FAST),ADRP&0FFh   
018E                          DS   CPM*(1-FAST),ADRP/256   
018E   E1                     DS   FAST,0E1h   
018F   C3                     DS   FAST,0C3h   
0190   31                     DS   FAST,ANXT&0FFh   
0191   00                     DS   FAST,ANXT/256   
0192                          IF   CHECKED   ; (the checked build has no room to start ","
                    H_CFETCH:   MOV   L,M   ;   as late as the unchecked one does: see
                              MVI   H,0   ;   the end of "?")
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0C3h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
0192                          ENDIF      
0192                             ; "?" ( n -- c ) or ( -n -- addr )
0192                             ;   n > 0: wait about n ms for a key; 0 if none came
0192                             ;   n = 0: wait for a key
0192                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
0192                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
0192   7C           H_KEY:    MOV   A,H   
0193   B7                     ORA   A   
0194   FA B6 01               JM   line   
0197   1E 28        KT1:      MVI   E,MSLOOP   ; one millisecond, roughly
0199   CD 62 05     KT2:      CALL   getk   
019C   C2 B0 01               JNZ   kt3   
019F   1D                     DCR   E   
01A0   C2 99 01               JNZ   kt2   
01A3   7C                     MOV   A,H   ; 0? never counts down: it waits
01A4   B5                     ORA   L   
01A5   CA 97 01               JZ   kt1   
01A8   2B                     DCX   H   
01A9   7C                     MOV   A,H   
01AA   B5                     ORA   L   
01AB   C2 97 01               JNZ   kt1   ; A = 0 if the time ran out
01AE                          IF   1-CHECKED   
01AE   FE                     DB   0FEh   ; (CPI: steps over the one byte of ",")
01AF   7E           H_CFETCH:   MOV   A,M   ; "," shares "?"s ending: A becomes TOS
01B0                          ENDIF      
01B0   6F           KT3:      MOV   L,A   
01B1   26 00                  MVI   H,0   
01B3                          ;*Macro unroll:  NEXT
01B3                          DS   (1-CPM)*(1-FAST),0F7h   
01B3   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
01B4   31                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
01B5   00                     DS   CPM+FAST-CPM*FAST,ANXT/256   
01B6                             ; Backspace takes the last character back (and is echoed as
01B6                             ; it is), CR ends (stored, not echoed), every other key is stored and
01B6                             ; echoed until the line is full. The line buffer starts at offset 80h
01B6                             ; of its page, so L alone is the place in the line: D holds the L of
01B6                             ; a full line.
01B6   11 7F 00     LINE:     LXI   D,127   ; TOS is minus the count: adding 127 carries
01B9   19                     DAD   D   ;   only for 1 to 127, and leaves 127 - count
01BA   9F                     SBB   A   
01BB   A5                     ANA   L   ; (0 for a count that is too big)
01BC   2F                     CMA      
01BD   57                     MOV   D,A   ; D = the L of a full line: 80h + count, FFh
01BE                             ;   at most
01BE   21 80 82               LXI   H,LINEBUF   
01C1   CD 62 05     LN2:      CALL   getk   
01C4   CA C1 01               JZ   ln2   
01C7   FE 0D                  CPI   13   
01C9   CA E6 01               JZ   ln5   
01CC   FE 08                  CPI   8   
01CE   CA DE 01               JZ   ln4   
01D1   5F                     MOV   E,A   
01D2   7D                     MOV   A,L   
01D3   BA                     CMP   D   
01D4   CA C1 01               JZ   ln2   ; full
01D7   73                     MOV   M,E   
01D8   2C                     INR   L   
01D9   7B                     MOV   A,E   
01DA                          ;*Macro unroll: ln3:    PUTA
01DA   EF           LN3:      DS   1-CPM,0EFh   
01DB                          DS   CPM,0CDh   
01DB                          DS   CPM,APUT&0FFh   
01DB                          DS   CPM,APUT/256   
01DB   C3 C1 01               JMP   ln2   
01DE   2D           LN4:      DCR   L   ; Backspace: one back, and echo it,
01DF   FA DA 01               JM   ln3   ;   unless the line was empty (L left the
01E2   2C                     INR   L   ;   upper half of the page)
01E3   C3 C1 01               JMP   ln2   
01E6   77           LN5:      MOV   M,A   ; the CR
01E7   2E 80                  MVI   L,LINEBUF & 0FFh   
01E9                          ;*Macro unroll:  NEXT
01E9                          DS   (1-CPM)*(1-FAST),0F7h   
01E9   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
01EA   31                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
01EB   00                     DS   CPM+FAST-CPM*FAST,ANXT/256   
01EC                             ; =============================================================================
01EC                             ;  Dispatch table: the low byte of each handler's address, in code order.
01EC                             ;  It must not cross a page (the dispatcher only adds to its low byte).
01EC                             ; =============================================================================
01EC                             ; The handlers of the first NPG1 characters start in the image's second page.
01EC                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
01EC                             ; differs between the builds, so the count is worked out here.
01EC                             ; (One division to a line: asm80 only rounds down when it stores a value.)
01EC                          IF   1-FAST   
                    PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
                    PGBRK:    EQU   (h_break-BASE)/256   
                    PGDEF:    EQU   (h_def-BASE)/256   
                    PGFET:    EQU   (h_fetch-BASE)/256   
                    NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
01EC                          ENDIF      
01EC                          IF   (1-FAST)*(1-PTLATE)   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
01EC                          ENDIF      
01EC                             ; =============================================================================
01EC                             ;  Routines (no handler starts past this point)
01EC                             ; =============================================================================
01EC                             ; Digits: step back onto the first digit and read the whole number.
01EC   E5           DIGIT:    PUSH   H   
01ED   0B                     DCX   B   
01EE   CD FC 01               CALL   rdnum   
01F1                          ;*Macro unroll:  NEXT
01F1                          DS   (1-CPM)*(1-FAST),0F7h   
01F1   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
01F2   31                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
01F3   00                     DS   CPM+FAST-CPM*FAST,ANXT/256   
01F4                             ; negnum: "-" directly before a digit: read the number, negate it.
01F4   E5           NEGNUM:   PUSH   H   
01F5   CD FC 01               CALL   rdnum   
01F8                          ;*Macro unroll:  NEGH
01F8   E7                     DS   1-CPM,0E7h   
01F9                          DS   CPM,0CDh   
01F9                          DS   CPM,ANEG&0FFh   
01F9                          DS   CPM,ANEG/256   
01F9                          ;*Macro unroll:  NEXT
01F9                          DS   (1-CPM)*(1-FAST),0F7h   
01F9   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
01FA   31                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
01FB   00                     DS   CPM+FAST-CPM*FAST,ANXT/256   
01FC                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
01FC                             ; non-digit. Values wrap at 16 bits, as the spec says.
01FC   21 00 00     RDNUM:    LXI   H,0   
01FF   0A           RDN1:     LDAX   B   
0200   D6 30                  SUI   "0"   
0202   FE 0A                  CPI   10   
0204   D0                     RNC      
0205   03                     INX   B   
0206   54                     MOV   D,H   
0207   5D                     MOV   E,L   
0208   29                     DAD   H   
0209   29                     DAD   H   
020A   19                     DAD   D   
020B   29                     DAD   H   ; HL * 10
020C   5F                     MOV   E,A   
020D   16 00                  MVI   D,0   
020F   19                     DAD   D   
0210   C3 FF 01               JMP   rdn1   
0213                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, BC = remainder.
0213                             ; Uses A, BC; the caller saves the IP. HL holds the dividend and, as its bits
0213                             ; leave at the top, the quotient bits arrive at the bottom. The loop counter
0213                             ; lives on the stack, since A is busy with the shifts.
0213                             ; Dividing by 2 is one shift (the spec wants that fast).
0213   01 00 00     UDIV:     LXI   B,0   
0216                          IF   1-QK   
                              MOV   A,E   
                              XRI   2   
                              ORA   D   
                              JNZ   udv0   
                              ORA   H   ; A was 0, and the carry is clear
                              RAR      
                              MOV   H,A   
                              MOV   A,L   
                              RAR      
                              MOV   L,A   ; the quotient
                              MOV   A,B   
                              RAL      
                              MOV   C,A   ; the remainder: the bit that fell out
                              RET      
0216                          ENDIF      
0216                          IF   QK   
0216                             ; (The builds with room divide by any power of two with shifts: 2, and 32,
0216                             ; 64, 256 and the like, which fixed point and byte work use all the time.)
0216   7A                     MOV   A,D   
0217   B7                     ORA   A   
0218   C2 6C 02               JNZ   uq1   ; 256 and up
021B   B3                     ORA   E   
021C   CA 83 02               JZ   udv0   ; by 0: the long way (it means nothing anyway)
021F   3D                     DCR   A   
0220   A3                     ANA   E   
0221   C2 83 02               JNZ   udv0   ; not a power of two
0224   7B                     MOV   A,E   ; by 2^k below 256: q = HL >> k, and
0225   3D                     DCR   A   ;   r = L & (2^k - 1)
0226   A5                     ANA   L   
0227   4F                     MOV   C,A   
0228                          ENDIF      
0228                          IF   QK*(1-FAST)   
                    UQ2:      MOV   A,E   ; one shift for each halving of E down to 1
                              ORA   A   
                              RAR      
                              RC      
                              MOV   E,A   
                              MOV   A,H   ; (the carry is clear: E's bit 0 was 0)
                              RAR      
                              MOV   H,A   
                              MOV   A,L   
                              RAR      
                              MOV   L,A   
                              JMP   uq2   
0228                          ENDIF      
0228                          IF   FAST   
0228                             ; (the fast build: the shifts unrolled. By 16 to 128 it is fewer shifts to
0228                             ; go the other way: A:HL up by 8 - k, and A:H is the quotient)
0228   7B           UQ2:      MOV   A,E   
0229   FE 10                  CPI   16   
022B   D2 4F 02               JNC   uqh   
022E   FE 02                  CPI   2   
0230   D8                     RC      ; by 1
0231   CA 47 02               JZ   ur1   
0234   FE 04                  CPI   4   
0236   CA 40 02               JZ   ur2   
0239                UR3:         
0239   7C                     MOV   A,H   
023A   B7                     ORA   A   
023B   1F                     RAR      
023C   67                     MOV   H,A   
023D   7D                     MOV   A,L   
023E   1F                     RAR      
023F   6F                     MOV   L,A   
0240                UR2:         
0240   7C                     MOV   A,H   
0241   B7                     ORA   A   
0242   1F                     RAR      
0243   67                     MOV   H,A   
0244   7D                     MOV   A,L   
0245   1F                     RAR      
0246   6F                     MOV   L,A   
0247                UR1:         
0247   7C                     MOV   A,H   
0248   B7                     ORA   A   
0249   1F                     RAR      
024A   67                     MOV   H,A   
024B   7D                     MOV   A,L   
024C   1F                     RAR      
024D   6F                     MOV   L,A   
024E   C9                     RET      
024F   FE 40        UQH:      CPI   64   
0251   3E 00                  MVI   A,0   
0253   CA 65 02               JZ   ul2   
0256   D2 67 02               JNC   ul1   
0259   7B                     MOV   A,E   
025A   FE 20                  CPI   32   
025C   3E 00                  MVI   A,0   
025E   CA 63 02               JZ   ul3   
0261   29                     DAD   H   ; by 16
0262   8F                     ADC   A   
0263   29           UL3:      DAD   H   
0264   8F                     ADC   A   
0265   29           UL2:      DAD   H   
0266   8F                     ADC   A   
0267   29           UL1:      DAD   H   
0268   8F                     ADC   A   
0269   6C                     MOV   L,H   
026A   67                     MOV   H,A   
026B   C9                     RET      
026C                          ENDIF      
026C                          IF   QK   
026C   7B           UQ1:      MOV   A,E   
026D   B7                     ORA   A   
026E   C2 83 02               JNZ   udv0   
0271   7A                     MOV   A,D   
0272   3D                     DCR   A   
0273   A2                     ANA   D   
0274   C2 83 02               JNZ   udv0   ; not a power of two
0277   7A                     MOV   A,D   ; by 2^k, 256 and up: r = HL & (2^k - 1), and
0278   3D                     DCR   A   ;   q = H >> (k - 8)
0279   A4                     ANA   H   
027A   47                     MOV   B,A   
027B   4D                     MOV   C,L   
027C   6C                     MOV   L,H   
027D   26 00                  MVI   H,0   
027F   5A                     MOV   E,D   
0280   C3 28 02               JMP   uq2   
0283                          ENDIF      
0283                          IF   1-FAST   
                    UDV0:     MVI   A,16   
                              PUSH   PSW   
                    UDV1:     DAD   H   ; next dividend bit into the carry
                              MOV   A,C   
                              RAL      
                              MOV   C,A   
                              MOV   A,B   
                              RAL      
                              MOV   B,A   ; BC = BC*2 + bit
                              MOV   A,C   
                              SUB   E   
                              MOV   A,B   
                              SBB   D   ; carry if BC < DE
                              JC   udv2   
                              MOV   B,A   ; BC - DE (high byte; A holds it)
                              MOV   A,C   
                              SUB   E   
                              MOV   C,A   
                              INR   L   ; quotient bit
                    UDV2:     POP   PSW   
                              DCR   A   
                              PUSH   PSW   
                              JNZ   udv1   
                              POP   PSW   
                              RET      
0283                          ENDIF      
0283                          IF   FAST   
0283                             ; (the fast build: the same 16 rounds, unrolled; and a dividend below 256
0283                             ; starts 8 bits up and takes only the last 8, since its first 8 would only
0283                             ; shift zeros)
0283   7C           UDV0:     MOV   A,H   
0284   B7                     ORA   A   
0285   CA B9 03               JZ   uvs   
0288   29           UV0:      DAD   H   
0289   79                     MOV   A,C   
028A   17                     RAL      
028B   4F                     MOV   C,A   
028C   78                     MOV   A,B   
028D   17                     RAL      
028E   47                     MOV   B,A   ; BC = BC*2 + bit
028F   79                     MOV   A,C   
0290   93                     SUB   E   
0291   78                     MOV   A,B   
0292   9A                     SBB   D   ; carry if BC < DE
0293   DA 9B 02               JC   uw0   
0296   47                     MOV   B,A   
0297   79                     MOV   A,C   
0298   93                     SUB   E   
0299   4F                     MOV   C,A   
029A   2C                     INR   L   ; quotient bit
029B                UW0:         
029B   29           UV1:      DAD   H   
029C   79                     MOV   A,C   
029D   17                     RAL      
029E   4F                     MOV   C,A   
029F   78                     MOV   A,B   
02A0   17                     RAL      
02A1   47                     MOV   B,A   ; BC = BC*2 + bit
02A2   79                     MOV   A,C   
02A3   93                     SUB   E   
02A4   78                     MOV   A,B   
02A5   9A                     SBB   D   ; carry if BC < DE
02A6   DA AE 02               JC   uw1   
02A9   47                     MOV   B,A   
02AA   79                     MOV   A,C   
