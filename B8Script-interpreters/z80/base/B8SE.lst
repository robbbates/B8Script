0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Required Notice: Copyright 2026 Robb Bates (https://github.com/robbbates)
0000                             ;  Licence: PolyForm Noncommercial License 1.0.0 (LICENSE.md at the top of
0000                             ;  the repository, or https://polyformproject.org/licenses/noncommercial/1.0.0)
0000                             ;  Spec: docs/b8script.md (2026-11-24).
0000                             ; 
0000                             ;  The switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    EDITOR   1 = with the line editor built in (see the end of this file):
0000                             ;                 the spec's suggested standard. It goes with either setting
0000                             ;                 of the other two.
0000                             ;    CHECKED  0 = no checks (spec: the programmer is responsible)
0000                             ;             1 = starts with every variable at 0 and every word undefined,
0000                             ;                 and stops on every error in the spec's table (and Ctrl-C)
0000                             ;                 with a three-line report: the letter and the place as line
0000                             ;                 and column, and both stacks. See `error`.
0000                             ;    SPEED    0 = small: the smallest build
0000                             ;             1 = base, the default: the speed-ups that cost bytes: a skip
0000                             ;                 cache, a faster skip, "*" and "/" quicker for small and
0000                             ;                 power-of-two operands, and more (see "Speed-ups")
0000                             ;             2 = fast: base and a dispatch table besides, with no size
0000                             ;                 limit (see "The fast build"). Not with EDITOR.
0000                             ;    ANSI     what the console escapes of "$" (/00bbIC8= /| /` /~) do:
0000                             ;             1 = send ANSI (VT100) sequences through CONOUT
0000                             ;             0 = call the machine's own routines CONCLS, CONEOL, CONCUR and
0000                             ;                 CONAT (see the equates). The CP/M builds always send ANSI.
0000                             ; 
0000                             ;  In every build Ctrl-C stops a running program (an unchecked build stops
0000                             ;  without a word): see the console layer for the rules, the held key and
0000                             ;  the break-off cell.
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   1   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   1   ; 1 = checked build
0000                EDITOR:   EQU   1   ; 1 = with the line editor
0000                ANSI:     EQU   0   ; 1 = the console escapes send ANSI sequences
0000                SPEED:    EQU   1   ; 0 = small, 1 = base, 2 = fast (not with EDITOR) (see "Speed-ups")
0000                FAST:     EQU   SPEED/2   ; (1: the fast build)
0000                SBASE:    EQU   SPEED-FAST*2   ; (1: the base build)
0000                ANS:      EQU   ANSI+CPM-ANSI*CPM   ; (CP/M: always ANSI)
0000                EDGEN:    EQU   EDITOR*(1-CPM)   ; (the generic build with the editor)
0000                             ; (IF takes any value but 0 as true, so
0000                             ;  IF CHECKED+EDITOR means "either")
0000                TABP0:    EQU   EDGEN*(1-CHECKED)   ; (the build with its table in page zero)
0000                PTLATE:   EQU   1-(1-CPM)*(1-EDITOR)*(1-CHECKED)*(1-ANS)   ; (1: the table goes after psgn and pdec,
0000                             ;   not before them: wherever it doesn't cross a
0000                             ;   page. chktab.py says if it does)
0000                QK:       EQU   SBASE+FAST-SBASE*FAST   ; (the speed-ups: base, or the fast build)
0000                SBASEU:   EQU   QK*(1-CHECKED)*(1-FAST)   ; (and those that only the unchecked
0000                             ;  builds take; the fast build has its own)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    IY   return-stack pointer. Entries are 2 bytes; the stack grows down.
0000                             ;         Only rpop and rpushn (and the checks) touch it. The alternate
0000                             ;         registers are not used at all: an interrupt routine may use them.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  One-byte calls. In a generic build the routines used most are reached
0000                             ;  with RST, one byte instead of three. The source writes them as macros:
0000                             ; 
0000                             ;    POPR   RST 08h  rpop    pop the return stack into DE
0000                             ;    DROP   RST 18h  drp     drop TOS, then next character  (ends a handler)
0000                             ;    NEGH   RST 20h  neg16   HL = -HL
0000                             ;    PUTA   RST 28h  putc    print A
0000                             ;    NEXT   RST 30h  next0   next character                 (ends a handler)
0000                             ; 
0000                             ;  RST 18h and RST 30h never return: an RST is a CALL, so the first thing
0000                             ;  each of them does is POP DE to throw the return address away.
0000                             ; 
0000                             ;  A CP/M build leaves page zero alone: there the macros are CALLs, and
0000                             ;  DROP and NEXT are jumps (DROPR and NEXTR: JR, where it reaches).
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (the top four bytes of the page are spare,
0000                             ;             so a full stack runs two bytes into the page below)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch, interpreter variables in the gaps, and the -n? line buffer
0000                             ;             at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack has a guard band: the data stack can
0000                             ;  overrun by a cell or two (and the calls made while it is full, the error
0000                             ;  report's included) into the top 32 bytes of the return-stack page, which
0000                             ;  are never used, and the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
0000                BDOS:     EQU   0005h   
0000                BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IF   CPM*(1-EDITOR)   
                    EXIT:     EQU   0000h   ; warm boot
0000                          ENDIF      
0000                          IFN   CPM   
                                 ; ---- generic machine: edit these to suit -----------------------------------
                    KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
                                 ;   waiting. The zero flag must match A
                                 ;   (end the routine with OR A / RET).
                    CONOUT:   EQU   0FF03h   ; print the character in A
                                 ;   KEY and CONOUT must preserve BC, DE, HL and IY.
0000                          ENDIF      
0000                          IF   1-ANS   
                                 ; With ANSI = 0 the console escapes call these. All four must keep BC and
                                 ; IY, and all but CONAT also HL. They may change A, DE and the flags.
                    CONCLS:   EQU   0FF0Ch   ; /{  clear the screen, the cursor to the top left
                    CONEOL:   EQU   0FF0Fh   ; /}  clear from the cursor to the end of the line
                    CONCUR:   EQU   0FF12h   ; /| and /`  show the cursor if A is not 0, hide
                                 ;     it if A = 0
                    CONAT:    EQU   0FF15h   ; /~  the cursor to row HL, column DE, both
                                 ;     counted from 0. May change A, DE and HL
0000                          ENDIF      
0000                          IFN   CPM   
                    RSPAGE:   EQU   80h   ; 8000h return stack
                    DSPAGE:   EQU   81h   ; 8100h data stack
                    LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
                    PROG:     EQU   8300h   ; where the loader puts the program text
                    HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
                    CPAGE:    EQU   HEAPLIM   ; the skip cache's page (QK builds): the page
                                 ;   at the heap limit, which the heap never reaches
                    BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)   
                    EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                          ENDIF      
0000                          IF   EDGEN   
                    LEAVE:    EQU   0FF09h   ; where the editor's ^X goes
0000                          ENDIF      
0000                          IF   EDITOR*CPM   
0000                LEAVE:    EQU   0000h   ; the editor's ^X: warm boot
0000                          ENDIF      
0000                          IF   EDITOR   
0000                EXIT:     EQU   edend   ; a program that ends goes back to the editor,
0000                SKEND:    EQU   skend   ;   also when it ends inside skip
0000                          ENDIF      
0000                          IF   1-EDITOR   
                    SKEND:    EQU   EXIT   
0000                          ENDIF      
0000                MSLOOP:   EQU   40-36*CPM   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine. (The wait
0000                             ; for a second Ctrl-C uses it too: 250 ms.)
0000                             ; CP/M: 4, for a BDOS 6 call of about 280 us
0000                             ; (an RC2014 with RomWBW and ZPM3). A .COM can
0000                             ; be patched: see TIMING.B8S.
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                             ;   around machine code (and in the checked
0000                             ;   build the address "$" prints from);
0000                PCNT:     EQU   LET+36h   ;   the break-key poll count (see rpushn);
0000                SKPL:     EQU   LET+3Ch   ;   the checked skip's starting place;
0000                NPEND:    EQU   LET+38h   ;   minus the address of the program's end
0000                             ;   (the heap"s first byte), for the checked "_';
0000                EDLN:     EQU   LET+3Ah   ;   the editor: the number of the line that ^E
0000                             ;   put in the input line (0: none)
0000                KEYBUF:   EQU   LET+7Ah   ; gap after z: a key read by the break check and
0000                             ;   held for the next "?" (0: none);
0000                BRKOFF:   EQU   LET+7Bh   ;   the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FCh   ; empty data stack. The four bytes above it
0000                             ; are spare: a character can pop two cells
0000                             ; too many before the checked build sees it,
0000                             ; and the next call must not land on the
0000                             ; letter cells.
0000                             ; The five one-byte calls. A generic build owns page zero and reaches them
0000                             ; with RST. A CP/M build must leave page zero alone (CP/M keeps it for
0000                             ; interrupts, and RomWBW's BIOS calls itself through RST 08h), so there each
0000                             ; is a CALL, or a jump for the two that never return: DROP is a JP, and
0000                             ; NEXT is JP (IX), two bytes, with IX holding next0's address throughout.
0000                             ; (asm80 can't nest IF, so these are written with DS: a count of 0 writes
0000                             ; nothing. DS can't take a label that comes later, but EQU can, and DS can
0000                             ; take that.)
0000                AROP:     EQU   rpop   
0000                ANEG:     EQU   neg16   
0000                APUT:     EQU   putc   
0000                APTK:     EQU   putk   
0000                          IF   1-CPM   
                    PUTK:     EQU   putc   ; (CP/M only: here it is never used)
0000                          ENDIF      
0000                ANXT:     EQU   next0   
0000                          IF   CHECKED   
0000                ACHK:     EQU   chkstk   ; (for the fast build's dispatcher)
0000                          ENDIF      
0000                          IF   1-CHECKED   
                    ACHK:     EQU   0   
0000                          ENDIF      
0000                          IF   FAST   
                    DTPG:     EQU   DTAB/256   ; (the fast build"s table"s first page)
0000                          ENDIF      
0000                          IF   1-FAST   
0000                DTPG:     EQU   0   
0000                          ENDIF      
0000                .macro POPR,
0000                             ; 
0000                 DS      1-CPM,0CFh      ;   RST 08h
0000                 DS      CPM,0CDh        ;   CALL rpop
0000                 DS      CPM,AROP&0FFh
0000                 DS      CPM,AROP/256
0000                .endm
0000                 
0000                .macro DROP,
0000                             ; 
0000                 DS      (1-CPM)*(1-FAST),0DFh ; RST 18h
0000                 DS      CPM+FAST-CPM*FAST,0E1h ; POP HL
0000                 DS      CPM+FAST-CPM*FAST,0DDh ; JP (IX)
0000                 DS      CPM+FAST-CPM*FAST,0E9h
0000                .endm
0000                 
0000                .macro NEGH,
0000                             ; 
0000                 DS      1-CPM,0E7h      ;   RST 20h
0000                 DS      CPM,0CDh        ;   CALL neg16
0000                 DS      CPM,ANEG&0FFh
0000                 DS      CPM,ANEG/256
0000                .endm
0000                 
0000                .macro PUTA,
0000                             ; 
0000                 DS      1-CPM,0EFh      ;   RST 28h
0000                 DS      CPM,0CDh        ;   CALL putc
0000                 DS      CPM,APUT&0FFh
0000                 DS      CPM,APUT/256
0000                .endm
0000                 
0000                .macro PUTK,
0000                             ; 
0000                 DS      1-CPM,3Eh       ;   LD A,%%1 / RST 28h
0000                 DS      1-CPM,%%1
0000                 DS      1-CPM,0EFh
0000                 DS      CPM,0CDh        ;   CALL putk / DB %%1
0000                 DS      CPM,APTK&0FFh
0000                 DS      CPM,APTK/256
0000                 DS      CPM,%%1
0000                .endm
0000                 
0000                .macro PUTAR,
0000                             ; 
0000                 DS      1-CPM,0EFh      ;   RST 28h
0000                 DS      1-CPM,0C9h      ;   RET
0000                 DS      CPM,0C3h        ;   JP putc
0000                 DS      CPM,APUT&0FFh
0000                 DS      CPM,APUT/256
0000                .endm
0000                 
0000                .macro NEXT,
0000                             ; 
0000                 DS      (1-CPM)*(1-FAST),0F7h ; RST 30h
0000                 DS      CPM+FAST-CPM*FAST,0DDh ; JP (IX): IX holds next0
0000                 DS      CPM+FAST-CPM*FAST,0E9h
0000                .endm
0000                 
0000                .macro NEXTF,
0000                             ; 
0000                 DS      FAST*CHECKED,0CDh ;   (fast build: CALL chkstk, checked)
0000                 DS      FAST*CHECKED,ACHK&0FFh
0000                 DS      FAST*CHECKED,ACHK/256
0000                 DS      FAST,0Ah        ;   (fast build: the dispatcher: LD A,(BC)
0000                 DS      FAST,03h        ;   INC BC
0000                 DS      FAST,0EBh       ;   EX DE,HL
0000                 DS      FAST,6Fh        ;   LD L,A
0000                 DS      FAST,26h        ;   LD H,DTAB/256
0000                 DS      FAST,DTPG
0000                 DS      FAST,7Eh        ;   LD A,(HL)
0000                 DS      FAST,24h        ;   INC H
0000                 DS      FAST,66h        ;   LD H,(HL)
0000                 DS      FAST,6Fh        ;   LD L,A
0000                 DS      FAST,0E9h       ;   JP (HL))
0000                .endm
0000                 
0000                .macro NEXTZ,
0000                             ; 
0000                 DS      1-CPM,0F7h      ;   byte there in every build (RST 30h)
0000                 DS      CPM,0DDh        ; JP (IX)
0000                 DS      CPM,0E9h
0000                .endm
0000                 
0000                .macro SETIX,
0000                             ; 
0000                 DS      CPM+FAST-CPM*FAST,0DDh ; a generic build): LD IX,next0
0000                 DS      CPM+FAST-CPM*FAST,21h
0000                 DS      CPM+FAST-CPM*FAST,ANXT&0FFh
0000                 DS      CPM+FAST-CPM*FAST,ANXT/256
0000                .endm
0000                 
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is just the start of the .COM file.
0000                             ; =============================================================================
0100                          .ORG   BASE   
0100                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              XOR   A   ; 00  reset. (This byte, AFh, is also what an
0100                          ENDIF      ;     undefined word runs into: see e_hi.)
0100                          IF   1-EDGEN   
0100   31 FC 0C               LD   SP,DSTOP   ; 00  reset, or the start of the .COM file
0103                          ENDIF      
0103                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)*(1-QK)   
                              LD   BC,PROG   ; 03  the IP
                              JR   st0   ; 06  (the rest of the startup is close by)
0103                          ENDIF      
0103                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)*QK   
                              JP   qstart   ; 03  (the skip cache is emptied first)
                              DW   0   ; 06  spare
0103                          ENDIF      
0103                          IF   (1-CPM)*(1-EDITOR)*CHECKED*(1-QK)   
                              JR   init   ; 04  (the rest of the startup is close by)
                              DW   0   ; 06  spare
0103                          ENDIF      
0103                          IF   (1-CPM)*(1-EDITOR)*CHECKED*QK   
                              JP   qinit   ; 04  (the skip cache is emptied first)
                              DB   0   ; 07  spare
0103                          ENDIF      
0103                          IF   EDGEN   
                              XOR   A   ; 00  reset: no program yet. (This byte, AFh,
                              LD   (PROG),A   ;     is also what an undefined word runs
                              JP   init   ; 04  into in the checked build: see e_hi.)
                              NOP      ; 07  spare
0103                          ENDIF      
0103                          IF   CPM*(1-EDITOR)   
                              JP   start   ; 03
0103                          ENDIF      
0103                          IF   CPM*EDITOR*CHECKED   
0103                             ; Clear the lower half of the letter page: every variable starts at
0103                             ; 0, every word cell holds 0000h, the address an undefined word is
0103                             ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
0103                             ; is held back.
0103   21 00 0D               LD   HL,LET   
0106   AF                     XOR   A   
0107   77           INI1:     LD   (HL),A   
0108   2C                     INC   L   
0109   F2 07 01               JP   P,ini1   ; +00h to +7Fh
010C                          ENDIF      
010C                          IF   CPM*EDITOR   
010C   CD 87 09               CALL   load   ; the file named on the command line
010F   C3 30 07               JP   edit0   
0112                          ENDIF      
0112                          IF   1-CPM   
                                 ; ---- RST 08h: rpop: pop the return stack into DE ---------------------------
                    RPOP:     LD   E,(IY+0)   ; 08
                              LD   D,(IY+1)   
                              JR   rp2   ; (the rest is at 2Bh)
                                 ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
                    CTL:      ADD   A,21h   ; 10  back to c; zero only for NUL
                              JR   NZ,next0   ;     the rest are ignored
                    ENDPROG:   JP   EXIT   ;     the program has ended
                              NOP      ; 17  spare
                                 ; ---- RST 18h: drop TOS, then next ------------------------------------------
                    RST18:    POP   DE   ; 18  discard the RST's return address
                    DRP:      POP   HL   ;     new TOS = NOS
                              JR   next0   
0112                          ENDIF      
0112   E5           H_FROMR:   PUSH   HL   ; 1C  "}" return stack to TOS
0113                          ;*Macro unroll:  POPR
0113                          DS   1-CPM,0CFh   
0113   CD                     DS   CPM,0CDh   
0114   8F                     DS   CPM,AROP&0FFh   
0115   05                     DS   CPM,AROP/256   
0116   EB                     EX   DE,HL   
0117                          ;*Macro unroll:  NEXTZ
0117                          DS   1-CPM,0F7h   
0117   DD                     DS   CPM,0DDh   
0118   E9                     DS   CPM,0E9h   
0119                          IF   1-CPM   
                                 ; ---- RST 20h: neg16: HL = -HL (keeps BC, DE) -------------------------------
                    NEG16:    XOR   A   ; 20
                              SUB   L   
                              LD   L,A   
                              SBC   A,A   
                              SUB   H   
                              LD   H,A   
                              RET      
                              NOP      ; 27  spare
                                 ; ---- RST 28h: putc: print A (keeps BC, DE, HL, IY) -------------------------
                    RST28:       
                    PUTC:     JP   CONOUT   ; 28
                    RP2:      INC   IY   ; 2B  the rest of rpop
                              INC   IY   
                              RET      
                                 ; ---- RST 30h: next character -----------------------------------------------
                    RST30:    POP   DE   ; 30  discard the RST's return address
0119                          ENDIF      
0119                          IF   CPM   
0119                             ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
0119   C6 21        CTL:      ADD   A,21h   ; back to c; zero only for NUL
011B   20 03                  JR   NZ,next0   ; the rest are ignored
011D   C3 39 07     ENDPROG:   JP   EXIT   ; the program has ended
0120                          ENDIF      
0120                             ; =============================================================================
0120                             ;  The inner loop: read one character and sort it by range.
0120                             ; 
0120                             ;    00h          end of program
0120                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0120                             ;    30h-39h      digit: read a whole number
0120                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0120                             ;    61h-7Ah      a-z: push the address of that letter's cell
0120                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0120                             ; =============================================================================
0120                          IF   FAST   
                              ;*Macro unroll: next0:  NEXTF                   ; (the fast build: the table dispatcher)
                    NEXT0:    DS   FAST*CHECKED,0CDh   ; (the fast build: the table dispatcher)
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
0120                          ENDIF      
0120                          IF   1-FAST   
0120                NEXT0:       
0120                          ENDIF      
0120                          IF   CHECKED*(1-FAST)   
0120   CD D1 05               CALL   chkstk   ; both stacks are checked once per character
0123                          ENDIF      
0123                          IF   1-FAST   
0123   0A                     LD   A,(BC)   
0124   03                     INC   BC   
0125   D6 21                  SUB   21h   ; A = c - 21h
0127   38 F0                  JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
0129   FE 0F                  CP   0Fh   
012B   38 25                  JR   C,punct   ; 21h-2Fh: PTAB index 0-14
012D   D6 0F                  SUB   0Fh   ; A = c - 30h
012F   FE 0A                  CP   0Ah   
0131   38 56                  JR   C,digit   ; 30h-39h
0133   FE 11                  CP   11h   
0135   38 19                  JR   C,p3a   ; 3Ah-40h
0137   D6 11                  SUB   11h   ; A = c - 41h
0139   FE 1A                  CP   1Ah   
013B   38 5A                  JR   C,upper   ; 41h-5Ah: A = letter index 0-25
013D   FE 20                  CP   20h   
013F   38 0D                  JR   C,p5b   ; 5Bh-60h
0141   FE 3A                  CP   3Ah   
0143   38 4B                  JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0145   FE 3E                  CP   3Eh   
0147                          ENDIF      
0147                          IF   (1-CHECKED)*(1-FAST)   
                              JR   NC,next0   ; 7Fh-FFh: ignored
0147                          ENDIF      
0147                          IF   CHECKED*(1-FAST)   
0147   28 D7                  JR   Z,next0   ; 7Fh, DEL: ignored
0149   D2 FE 05               JP   NC,e_hi   ; 80h-FFh: reserved
014C                          ENDIF      
014C                          IF   1-FAST   
014C   D6 1A                  SUB   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
014E   D6 09        P5B:      SUB   9   ; 5Bh-60h: -4 in all, index 22-27
0150   C6 05        P3A:      ADD   A,5   ; 3Ah-40h: index 15-21
0152                          ENDIF      
0152                .macro PTABLE,
0152                             ; 
0152                 DB      h_store & 0FFh  ; !
0152                 DB      h_str & 0FFh    ; "
0152                 DB      h_num & 0FFh    ; #
0152                 DB      h_print & 0FFh  ; $
0152                 DB      h_swap & 0FFh   ; %
0152                 DB      h_and & 0FFh    ; &
0152                 DB      h_emit & 0FFh   ; '
0152                 DB      h_open & 0FFh   ; (
0152                 DB      h_close & 0FFh  ; )
0152                 DB      h_mul & 0FFh    ; *
0152                 DB      h_add & 0FFh    ; +
0152                 DB      h_cfetch & 0FFh ; ,
0152                 DB      h_sub & 0FFh    ; -
0152                 DB      h_cstore & 0FFh ; .
0152                 DB      h_div & 0FFh    ; /
0152                 DB      h_dup & 0FFh    ; :
0152                 DB      h_drop & 0FFh   ; ;
0152                 DB      h_lt & 0FFh     ; <
0152                 DB      h_eq & 0FFh     ; =
0152                 DB      h_gt & 0FFh     ; >
0152                 DB      h_key & 0FFh    ; ?
0152                 DB      h_fetch & 0FFh  ; @
0152                 DB      h_def & 0FFh    ; [
0152                 DB      h_break & 0FFh  ; \
0152                 DB      h_ret & 0FFh    ; ]
0152                 DB      h_xor & 0FFh    ; ^
0152                 DB      h_alloc & 0FFh  ; _
0152                 DB      h_grave & 0FFh  ; `
0152                 DB      h_tor & 0FFh    ; {
0152                 DB      h_or & 0FFh     ; |
0152                 DB      h_fromr & 0FFh  ; }
0152                 DB      h_not & 0FFh    ; ~
0152                .endm
0152                 
0152                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
0152                             ; untouched, and A, DE free.
0152                          IF   1-FAST   
0152   C6 31        PUNCT:    ADD   A,PTAB & 0FFh   ; PTAB never crosses a page
0154   5F                     LD   E,A   
0155   16 05                  LD   D,PTAB / 256   ; (0 if the table is in page zero)
0157   FE 47                  CP   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
0159   1A                     LD   A,(DE)   
015A   5F                     LD   E,A   ; the handler's low byte
015B                          ENDIF      
015B                          IF   (1-CPM)*(1-TABP0)*(1-FAST)   
                              LD   D,0   
015B                          ENDIF      
015B                          IF   (1-CPM)*(1-FAST)   
                              RL   D   ; its page: 0 + carry
015B                          ENDIF      
015B                          IF   CPM*(1-FAST)   
015B   16 01                  LD   D,1   
015D   30 01                  JR   NC,pu1   
015F   14                     INC   D   ; its page: 1 + carry
0160                PU1:         
0160                          ENDIF      
0160                          IF   1-FAST   
0160   D5                     PUSH   DE   ; jump to it; the stack is balanced again
0161   C9                     RET      ;   when the handler starts
0162                          ENDIF      
0162                             ; The rest of the startup: here so that the generic reset code can reach it
0162                             ; with JR. st0: find the program's NUL; the heap starts after it.
0162                             ; (The editor build has its own copy of this, next to the editor.)
0162                             ; A checked build first clears the lower half of the letter page (A = 0):
0162                             ; every variable starts at 0, every word cell holds 0000h, the address an
0162                             ; undefined word is caught at (see e_hi), and no key is held back.
0162                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                    INIT:     LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
                              LD   BC,PROG   ; the IP
0162                          ENDIF      
0162                          IF   (1-CPM)*(1-EDITOR)   
                    ST0:      LD   H,B   
                              LD   L,C   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
0162                          ENDIF      
0162                          IF   1-EDITOR   
                    ST2:      LD   (HEAP),HL   
0162                          ENDIF      
0162                          IF   CHECKED*(1-EDITOR)   
                              ;*Macro unroll:  NEGH                    ; minus the heap's first address: '_' may not
                              DS   1-CPM,0E7h   ; minus the heap"s first address: "_' may not
                              DS   CPM,0CDh   
                              DS   CPM,ANEG&0FFh   
                              DS   CPM,ANEG/256   
                              LD   (NPEND),HL   ;   release below it
0162                          ENDIF      
0162                          IF   (1-CHECKED)*(1-EDITOR)*(1-CPM)   
                              LD   H,A   ; (A = 0) no key is held, and the break key
                              LD   L,A   ;   is on (the checked build has cleared
0162                          ENDIF      ;   these)
0162                          IF   (1-CHECKED)*(1-EDITOR)*CPM   
                              LD   HL,0   
0162                          ENDIF      
0162                          IF   (1-CHECKED)*(1-EDITOR)   
                              LD   (KEYBUF),HL   
0162                          ENDIF      
0162                          IF   1-EDITOR   
                              ;*Macro unroll:  SETIX
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,21h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
                              LD   IY,RSTOP   ; the return stack is empty
                              ;*Macro unroll:  NEXT                    ; (its return address is thrown away)
                              DS   (1-CPM)*(1-FAST),0F7h   ; (its return address is thrown away)
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
0162                          ENDIF      
0162                             ; In the unchecked generic editor build the table is here, in the first
0162                             ; page, which saves loading D twice. (The other builds have no room for it
0162                             ; here: theirs is further down.)
0162                          IF   TABP0   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0162                          ENDIF      
0162                             ; =============================================================================
0162                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
0162                             ;  (00bbIGFuZCA= are up among the RST routines.) The machine-code call, exec,
0162                             ;  is here too: it belongs to "`" and makes the page come out right.
0162                             ; =============================================================================
0162   D1           H_XOR:    POP   DE   
0163   7C                     LD   A,H   
0164   AA                     XOR   D   
0165   67                     LD   H,A   
0166   7D                     LD   A,L   
0167   AB                     XOR   E   
0168   6F                     LD   L,A   
0169                          ;*Macro unroll:  NEXT
0169                          DS   (1-CPM)*(1-FAST),0F7h   
0169   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
016A   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
016B   D1           H_OR:     POP   DE   
016C   7C                     LD   A,H   
016D   B2                     OR   D   
016E   67                     LD   H,A   
016F   7D                     LD   A,L   
0170   B3                     OR   E   
0171   6F                     LD   L,A   
0172                          ;*Macro unroll:  NEXT
0172                          DS   (1-CPM)*(1-FAST),0F7h   
0172   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0173   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0174                          ;*Macro unroll: h_not:  NEGH                    ; ~x = -x - 1
0174                H_NOT:    DS   1-CPM,0E7h   ; ~x = -x - 1
0174   CD                     DS   CPM,0CDh   
0175   9A                     DS   CPM,ANEG&0FFh   
0176   05                     DS   CPM,ANEG/256   
0177   2B                     DEC   HL   
0178                          ;*Macro unroll:  NEXT
0178                          DS   (1-CPM)*(1-FAST),0F7h   
0178   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0179   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
017A                             ; "_" ( n -- addr ): the heap pointer moves by n, a signed count (the add is
017A                             ; the same either way); TOS is the old pointer.
017A   ED 5B 7C 0D  H_ALLOC:   LD   DE,(HEAP)   
017E                          IF   CHECKED*CPM   
017E   7C                     LD   A,H   ; the count's sign, for chkhp
017F                          ENDIF      
017F   19                     ADD   HL,DE   ; the new top
0180                          IF   CHECKED   
0180   CD 0A 06               CALL   chkhp   
0183                          ENDIF      
0183   22 7C 0D               LD   (HEAP),HL   
0186   EB                     EX   DE,HL   
0187                          ;*Macro unroll:  NEXT
0187                          DS   (1-CPM)*(1-FAST),0F7h   
0187   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0188   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0189                          IF   1-CPM*CHECKED   
                    EXEC:     LD   (RSAVE),IY   ; machine code may change IX and IY
                              CALL   jphl   
                              LD   IY,(RSAVE)   
                              ;*Macro unroll:  SETIX
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,21h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
                              POP   HL   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
0189                          ENDIF      
0189                             ; ---- the letters and digits (here, in the middle, so that the inner loop's
0189                             ; ---- short jumps reach them, and the handlers after them reach rpushn) ------
0189                             ; Digits: step back onto the first digit and read the whole number.
0189   E5           DIGIT:    PUSH   HL   
018A   0B                     DEC   BC   
018B   CD 01 04               CALL   rdnum   
018E                          ;*Macro unroll:  NEXT
018E                          DS   (1-CPM)*(1-FAST),0F7h   
018E   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
018F   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0190                             ; a-z: push the cell's address (the cell is the variable)
0190                             ;  (the unchecked builds with room do x@ and x! in one step: lowq)
0190                          IF   1-SBASEU   
0190   E5           LOWER:    PUSH   HL   
0191   87                     ADD   A,A   
0192   6F                     LD   L,A   
0193   26 0D                  LD   H,LETPAGE   
0195                          ;*Macro unroll:  NEXT
0195                          DS   (1-CPM)*(1-FAST),0F7h   
0195   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0196   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0197                          ENDIF      
0197                          IF   SBASEU   
                    LOWER:    JP   lowq   
0197                          ENDIF      
0197                             ; A-Z: call the word. The return address (the IP after the letter) goes on
0197                             ; the return stack, and the IP becomes the address in the letter's cell.
0197   C5           UPPER:    PUSH   BC   ; the return address, for rpushn
0198   EB                     EX   DE,HL   ; park TOS
0199   87                     ADD   A,A   
019A   6F                     LD   L,A   
019B   26 0D                  LD   H,LETPAGE   ; HL -> cell
019D   4E                     LD   C,(HL)   
019E   2C                     INC   L   
019F   46                     LD   B,(HL)   ; IP = the word's body
01A0   EB                     EX   DE,HL   ; TOS back, and fall into rpushn
01A1                             ; rpushn: move the top cell of the data stack (in memory) to the return
01A1                             ; stack, then next. Everything that pushes the return stack ends here.
01A1                             ; 
01A1                             ; The break key is looked at here, so at every word call and loop-back (and
01A1                             ; block entry and "{"), but only one time in 256: PCNT counts them.
01A1                             ; Reading the keyboard can be slow (it is a BDOS call under CP/M).
01A1   D1           RPUSHN:   POP   DE   
01A2   FD 72 FF               LD   (IY-1),D   
01A5   FD 73 FE               LD   (IY-2),E   
01A8   FD 2B                  DEC   IY   
01AA   FD 2B                  DEC   IY   
01AC   E5                     PUSH   HL   
01AD   21 36 0D               LD   HL,PCNT   
01B0   35                     DEC   (HL)   
01B1   E1                     POP   HL   ; (the zero flag lasts)
01B2   CC 51 05               CALL   Z,pollk   
01B5                          ;*Macro unroll:  NEXT
01B5                          DS   (1-CPM)*(1-FAST),0F7h   
01B5   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
01B6   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
01B7                             ; "{" TOS to the return stack: the new TOS comes up, the old one goes across.
01B7   E3           H_TOR:    EX   (SP),HL   
01B8   18 E7                  JR   rpushn   
01BA   E9           JPHL:     JP   (HL)   ; (for the machine-code call)
01BB                             ; ---- machine code: the grave -----------------------------------------------
01BB                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
01BB                             ; are stored from addr until a non-hex character; then a RET (C9h) is
01BB                             ; written and its address is left. An odd last digit is consumed and dropped.
01BB                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
01BB                             ; code is entered by CALL with the data stack above the return address; it
01BB                             ; must keep BC, and on return the top cell becomes the new TOS.
01BB   CD 01 05     H_GRAVE:   CALL   hexc   
01BE                          IF   1-CPM*CHECKED   
                              JR   NC,exec   
01BE                          ENDIF      
01BE                          IF   CPM*CHECKED   
01BE   D2 A1 05               JP   NC,exec   ; (out of the way: see rpop)
01C1                          ENDIF      
01C1   77           HX1:      LD   (HL),A   ; the high digit goes in first ...
01C2   CD 01 05               CALL   hexc   
01C5   30 08                  JR   NC,hx2   ; odd digit: consumed, and the RET below
01C7   ED 6F                  RLD      ;   overwrites it
01C9   23                     INC   HL   ; ... and RLD shifts it up under the low one
01CA   CD 01 05               CALL   hexc   
01CD   38 F2                  JR   C,hx1   
01CF   36 C9        HX2:      LD   (HL),0C9h   ; (never range-checked: the spec says so)
01D1                          ;*Macro unroll:  NEXT
01D1                          DS   (1-CPM)*(1-FAST),0F7h   
01D1   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
01D2   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
01D3                             ; ---- where the two pages meet ----------------------------------------------
01D3                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
01D3                             ; are in falling code order for this), and where exactly differs between the
01D3                             ; builds: NPG1 follows. Every handler below these four must start in the
01D3                             ; second page, and every one above in the first; chktab.py checks both.
01D3                             ; "]" returns: pop an address and jump to it.
01D3                          ;*Macro unroll: h_ret:  POPR
01D3                H_RET:    DS   1-CPM,0CFh   
01D3   CD                     DS   CPM,0CDh   
01D4   8F                     DS   CPM,AROP&0FFh   
01D5   05                     DS   CPM,AROP/256   
01D6   42                     LD   B,D   
01D7   4B                     LD   C,E   
01D8                          ;*Macro unroll: brk1:   NEXT
01D8                BRK1:     DS   (1-CPM)*(1-FAST),0F7h   
01D8   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
01D9   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
01DA                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
01DA                             ; drops the block start, "]" returns. No closer at all ends the program.
01DA   7C           H_BREAK:   LD   A,H   
01DB   B5                     OR   L   
01DC   E1                     POP   HL   
01DD   28 F9                  JR   Z,brk1   
01DF   CD 28 04               CALL   skip   
01E2   B7                     OR   A   ; skip returns 0 for ")"
01E3   20 EE                  JR   NZ,h_ret   
01E5                          ;*Macro unroll: rdrop:  POPR
01E5                RDROP:    DS   1-CPM,0CFh   
01E5   CD                     DS   CPM,0CDh   
01E6   8F                     DS   CPM,AROP&0FFh   
01E7   05                     DS   CPM,AROP/256   
01E8                          ;*Macro unroll:  NEXT
01E8                          DS   (1-CPM)*(1-FAST),0F7h   
01E8   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
01E9   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
01EA                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
01EA                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
01EA                             ; the body"s address instead. Either way it then skips to the matching "]'.
01EA                             ; (The unchecked build takes anything that is not a letter as the space; the
01EA                             ; checked build stops on it.)
01EA   0A           H_DEF:    LD   A,(BC)   
01EB   03                     INC   BC   
01EC   D6 41                  SUB   "A"   ; a letter gives 0-25 or 32-57: lowercase
01EE   5F                     LD   E,A   ;   lands 64 bytes up
01EF   E6 DF                  AND   0DFh   ; fold case
01F1   FE 1A                  CP   26   
01F3   30 0B                  JR   NC,def2   ; not a letter
01F5   CB 23                  SLA   E   
01F7   16 0D                  LD   D,LETPAGE   ; DE -> cell
01F9   79                     LD   A,C   
01FA   12                     LD   (DE),A   
01FB   1C                     INC   E   
01FC   78                     LD   A,B   
01FD   12                     LD   (DE),A   
01FE   18 09                  JR   skipnx   
0200                DEF2:        
0200                          IF   CHECKED   
0200   7B                     LD   A,E   
0201   FE DF                  CP   " "-"A"+256   
0203   C2 52 06               JP   NZ,e_brack   ; anything but a letter or a space
0206                          ENDIF      
0206   E5                     PUSH   HL   ; an anonymous block: push its address
0207   60                     LD   H,B   
0208   69                     LD   L,C   
0209                SKIPNX:      
0209                          IF   CHECKED   
0209   0B                     DEC   BC   ; back onto the letter, so that skip finds its
020A                          ENDIF      ;   opener, the "[", just before where it starts
020A   CD 28 04     SKIPO:    CALL   skip   
020D                          ;*Macro unroll:  NEXT
020D                          DS   (1-CPM)*(1-FAST),0F7h   
020D   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
020E   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
020F   5E           H_FETCH:   LD   E,(HL)   ; "@"
0210   23                     INC   HL   
0211   56                     LD   D,(HL)   
0212   EB                     EX   DE,HL   
0213                          ;*Macro unroll:  NEXT
0213                          DS   (1-CPM)*(1-FAST),0F7h   
0213   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0214   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0215                             ; =============================================================================
0215                             ;  Handlers that must start in the image's second page.
0215                             ;  "?" is the last (with "," inside it), so its long tail may run past that
0215                             ;  page.
0215                             ; =============================================================================
0215                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
0215                             ; the matching ")".
0215   7C           H_OPEN:   LD   A,H   
0216   B5                     OR   L   
0217   E1                     POP   HL   
0218   28 F0                  JR   Z,skipo   
021A   C5                     PUSH   BC   ; the block starts at the IP
021B   18 84                  JR   rpushn   
021D                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
021D                             ; drops it and carries on.
021D   7C           H_CLOSE:   LD   A,H   
021E   B5                     OR   L   
021F   E1                     POP   HL   
0220   28 C3                  JR   Z,rdrop   
0222                          IF   QK   
0222   C3 F0 04               JP   closeq   ; (out of the handlers' pages: see Speed-ups)
0225                          ENDIF      
0225                          IF   1-QK   
                              ;*Macro unroll:  POPR                    ; pop the block start ...
                              DS   1-CPM,0CFh   ; pop the block start ...
                              DS   CPM,0CDh   
                              DS   CPM,AROP&0FFh   
                              DS   CPM,AROP/256   
                              LD   B,D   
                              LD   C,E   
                              PUSH   BC   
0225                          ENDIF      
0225                          IF   (1-QK)*(1-CPM)   
                              JR   rpushn   ; ... and push it back
0225                          ENDIF      
0225                          IF   (1-QK)*CPM   
                              JP   rpushn   
0225                          ENDIF      
0225                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
0225                             ; "-" has two jobs: directly before a digit it starts a negative number.
0225   0A           H_SUB:    LD   A,(BC)   
0226   D6 30                  SUB   "0"   
0228   FE 0A                  CP   10   
022A   38 07                  JR   C,negnum   
022C                          ;*Macro unroll:  NEGH                    ; a - b = a + (-b): fall into '+'
022C                          DS   1-CPM,0E7h   ; a - b = a + (-b): fall into "+"
022C   CD                     DS   CPM,0CDh   
022D   9A                     DS   CPM,ANEG&0FFh   
022E   05                     DS   CPM,ANEG/256   
022F   D1           H_ADD:    POP   DE   
0230   19                     ADD   HL,DE   
0231                          ;*Macro unroll:  NEXT
0231                          DS   (1-CPM)*(1-FAST),0F7h   
0231   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0232   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0233   E5           NEGNUM:   PUSH   HL   ; a negative number: read it, negate it
0234   CD 01 04               CALL   rdnum   
0237                          ;*Macro unroll:  NEGH
0237                          DS   1-CPM,0E7h   
0237   CD                     DS   CPM,0CDh   
0238   9A                     DS   CPM,ANEG&0FFh   
0239   05                     DS   CPM,ANEG/256   
023A                          ;*Macro unroll:  NEXT
023A                          DS   (1-CPM)*(1-FAST),0F7h   
023A   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
023B   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
023C   D1           H_AND:    POP   DE   
023D   7C                     LD   A,H   
023E   A2                     AND   D   
023F   67                     LD   H,A   
0240   7D                     LD   A,L   
0241   A3                     AND   E   
0242   6F                     LD   L,A   
0243                          ;*Macro unroll:  NEXT
0243                          DS   (1-CPM)*(1-FAST),0F7h   
0243   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0244   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0245                             ; Signed compares. Both are "HL < DE" for the right pair: "<" swaps the two
0245                             ; cells first. Flipping both sign bits turns a signed compare into an
0245                             ; unsigned one (and XOR clears the carry for SBC); SBC HL,HL then turns the
0245                             ; carry into -1 or 0 with no branch.
0245   E3           H_LT:     EX   (SP),HL   ; a < b: HL = a, and b is popped next
0246   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
0247   7C                     LD   A,H   
0248   EE 80                  XOR   80h   
024A   67                     LD   H,A   
024B   7A                     LD   A,D   
024C   EE 80                  XOR   80h   
024E   57                     LD   D,A   
024F   ED 52                  SBC   HL,DE   ; carry if HL < DE
0251   ED 62        TF:       SBC   HL,HL   ; carry -> -1 or 0
0253                          ;*Macro unroll:  NEXT
0253                          DS   (1-CPM)*(1-FAST),0F7h   
0253   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0254   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0255   D1           H_EQ:     POP   DE   
0256   B7                     OR   A   
0257   ED 52                  SBC   HL,DE   
0259   7C                     LD   A,H   
025A   B5                     OR   L   
025B   FE 01                  CP   1   ; carry only if a - b = 0
025D   18 F2                  JR   tf   
025F                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept. The
025F                             ; multiplier shifts up through A:C.
025F                          IF   1-QK   
                    H_MUL:    POP   DE   ; DE = multiplicand
                              PUSH   BC   
                              LD   A,H   
                              LD   C,L   ; A:C = multiplier
                              LD   HL,0   
                              LD   B,16   
                    MUL1:     ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mul2   
                              ADD   HL,DE   
                    MUL2:     DJNZ   mul1   
                              POP   BC   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
025F                          ENDIF      
025F                          IF   QK   
025F   D1           H_MUL:    POP   DE   ; DE = multiplicand
0260   C3 C2 04               JP   mulq   ; (out of the handlers' pages: see Speed-ups)
0263                          ENDIF      
0263                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
0263                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
0263                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
0263                             ; stops on it.
0263                H_DIV:       
0263                          IF   CHECKED   
0263   7C                     LD   A,H   
0264   B5                     OR   L   
0265   CA 4F 06               JP   Z,e_zero   
0268                          ENDIF      
0268   D1                     POP   DE   ; DE = a, HL = b
0269   D5                     PUSH   DE   ; a, for r's sign
026A   7A                     LD   A,D   
026B   AC                     XOR   H   
026C   F5                     PUSH   AF   ; S flag = sign of q
026D   CB 7C                  BIT   7,H   
026F   C4 9A 05               CALL   NZ,neg16   ; HL = |b|
0272   EB                     EX   DE,HL   
0273   CB 7C                  BIT   7,H   
0275   C4 9A 05               CALL   NZ,neg16   ; HL = |a|, DE = |b|
0278   CD AC 03               CALL   udiv   ; HL = q, DE = r
027B   F1                     POP   AF   
027C   FC 9A 05               CALL   M,neg16   ; q's sign
027F   EB                     EX   DE,HL   ; HL = r, DE = q
0280   F1                     POP   AF   ; A = a's high byte
0281   B7                     OR   A   
0282   FC 9A 05               CALL   M,neg16   ; r's sign
0285   D5                     PUSH   DE   ; q under r
0286                          ;*Macro unroll:  NEXT
0286                          DS   (1-CPM)*(1-FAST),0F7h   
0286   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0287   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0288                             ; ---- stack and storage -----------------------------------------------------
0288   E5           H_DUP:    PUSH   HL   ; ":"
0289                          ;*Macro unroll:  NEXT
0289                          DS   (1-CPM)*(1-FAST),0F7h   
0289   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
028A   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
028B   E3           H_SWAP:   EX   (SP),HL   ; "%"
028C                          ;*Macro unroll:  NEXT
028C                          DS   (1-CPM)*(1-FAST),0F7h   
028C   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
028D   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
028E                             ; (The checked build tests the address before it takes the value off the
028E                             ; stack, so that an error report shows both.)
028E                H_CSTORE:      ; "." ( c addr -- )
028E                          IF   CHECKED   
028E   CD 27 06               CALL   chkst   
0291                          ENDIF      
0291   D1                     POP   DE   
0292   73                     LD   (HL),E   
0293                          ;*Macro unroll: h_drop: DROP                    ; ';' is this one byte
0293                H_DROP:   DS   (1-CPM)*(1-FAST),0DFh   ; ";" is this one byte
0293   E1                     DS   CPM+FAST-CPM*FAST,0E1h   
0294   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0295   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0296                H_STORE:      ; "!" ( n addr -- )
0296                          IF   CHECKED   
0296   CD 27 06               CALL   chkst   
0299                          ENDIF      
0299   D1                     POP   DE   
029A   73                     LD   (HL),E   
029B   23                     INC   HL   
029C   72                     LD   (HL),D   
029D                          ;*Macro unroll:  DROP
029D                          DS   (1-CPM)*(1-FAST),0DFh   
029D   E1                     DS   CPM+FAST-CPM*FAST,0E1h   
029E   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
029F   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
02A0                             ; ---- console ---------------------------------------------------------------
02A0                             ; 22h pushes the address of the text after it and skips the string.
02A0   E5           H_STR:    PUSH   HL   
02A1   60                     LD   H,B   
02A2   69                     LD   L,C   
02A3   CD 17 04               CALL   skipstr   
02A6                          IF   CHECKED   
02A6   B7                     OR   A   ; 0: the text ran out before the closing quote
02A7   CA 47 06               JP   Z,e_quote   
02AA                          ENDIF      
02AA                          ;*Macro unroll:  NEXT
02AA                          DS   (1-CPM)*(1-FAST),0F7h   
02AA   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
02AB   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
02AC                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
02AC                             ; 60h to 7Eh is one of the escapes at pesc; "/" plus any other character
02AC                             ; clears that character"s bit 6 (/M is CR, and / then DEL gives "?"; "/',
02AC                             ; '"' and '?' have no bit 6, so //, /" and /? give themselves).
02AC                          IF   1-CHECKED   
                    H_PRINT:   LD   A,(HL)   
                              INC   HL   
                              CP   22h   
                              JR   Z,pr9   
                              CP   "/"   
                              JR   NZ,pr1   
                              LD   A,(HL)   
                              INC   HL   
                              CP   60h   
                              JR   C,pr0   
                              CP   7Fh   
                              JR   C,pesc   
                    PR0:      AND   0BFh   
                              ;*Macro unroll: pr1:    PUTA
                    PR1:      DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              JR   h_print   
                    PRLOOP:   EQU   h_print   ; (where the escapes go back to)
                    PRAGAIN:   EQU   h_print   ; (and where /~ goes back to)
02AC                          ENDIF      
02AC                          IF   CHECKED   
02AC                             ; (The checked build has the loop as a routine, prstr, which the error
02AC                             ; report uses too. The address is kept meanwhile, for a report: it shows
02AC                             ; the stack as it was before the "$". /~ comes back to hp1.)
02AC   22 34 0D     H_PRINT:   LD   (RSAVE),HL   
02AF   CD 11 03     HP1:      CALL   prstr   
02B2                          ;*Macro unroll:  DROP
02B2                          DS   (1-CPM)*(1-FAST),0DFh   
02B2   E1                     DS   CPM+FAST-CPM*FAST,0E1h   
02B3   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
02B4   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
02B5                          ENDIF      
02B5   7D           H_EMIT:   LD   A,L   ; "'"
02B6                          ;*Macro unroll:  PUTA
02B6                          DS   1-CPM,0EFh   
02B6   CD                     DS   CPM,0CDh   
02B7   BB                     DS   CPM,APUT&0FFh   
02B8   05                     DS   CPM,APUT/256   
02B9                          ;*Macro unroll: pr9:    DROP
02B9                PR9:      DS   (1-CPM)*(1-FAST),0DFh   
02B9   E1                     DS   CPM+FAST-CPM*FAST,0E1h   
02BA   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
02BB   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
02BC                             ; "#" prints TOS as a signed decimal number, with no space after it.
02BC   CD 13 05     H_NUM:    CALL   psgn   
02BF                          ;*Macro unroll:  DROP
02BF                          DS   (1-CPM)*(1-FAST),0DFh   
02BF   E1                     DS   CPM+FAST-CPM*FAST,0E1h   
02C0   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
02C1   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
02C2                             ; "?" ( n -- c ) or ( -n -- addr )
02C2                             ;   n > 0: wait about n ms for a key; 0 if none came
02C2                             ;   n = 0: wait for a key
02C2                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
02C2                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
02C2   CB 7C        H_KEY:    BIT   7,H   
02C4   20 1A                  JR   NZ,line   
02C6   1E 04        KT1:      LD   E,MSLOOP   ; one millisecond, roughly
02C8   CD 7F 05     KT2:      CALL   getk   
02CB   20 0E                  JR   NZ,kt3   
02CD   1D                     DEC   E   
02CE   20 F8                  JR   NZ,kt2   
02D0   7C                     LD   A,H   ; 0? never counts down: it waits
02D1   B5                     OR   L   
02D2   28 F2                  JR   Z,kt1   
02D4   2B                     DEC   HL   
02D5   7C                     LD   A,H   
02D6   B5                     OR   L   
02D7   20 ED                  JR   NZ,kt1   ; A = 0 if the time ran out
02D9   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
02DA   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
02DB   6F           KT3:      LD   L,A   
02DC   26 00                  LD   H,0   
02DE                          ;*Macro unroll:  NEXT
02DE                          DS   (1-CPM)*(1-FAST),0F7h   
02DE   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
02DF   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
02E0                             ; Backspace takes the last character back (and is echoed as it
02E0                             ; is), CR ends (stored, not echoed), every other key is stored and
02E0                             ; echoed until the line is full. (CP/M too: getk reads through BDOS
02E0                             ; 6.) The line buffer starts at offset 80h of its page, so L alone
02E0                             ; is the place in the line: D holds the L of a full line.
02E0   11 7F 00     LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
02E3   19                     ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
02E4   9F                     SBC   A,A   
02E5   A5                     AND   L   ; (0 for a count that is too big)
02E6   2F                     CPL      
02E7   57                     LD   D,A   ; D = the L of a full line: 80h + count, FFh
02E8                             ;   at most
02E8   21 80 0D               LD   HL,LINEBUF   
02EB   CD 7F 05     LN2:      CALL   getk   
02EE   28 FB                  JR   Z,ln2   
02F0   FE 0D                  CP   13   
02F2   28 18                  JR   Z,ln5   
02F4   FE 08                  CP   8   
02F6   28 0D                  JR   Z,ln4   
02F8   5F                     LD   E,A   
02F9   7D                     LD   A,L   
02FA   BA                     CP   D   
02FB   28 EE                  JR   Z,ln2   ; full
02FD   73                     LD   (HL),E   
02FE   2C                     INC   L   
02FF   7B                     LD   A,E   
0300                          ;*Macro unroll: ln3:    PUTA
0300                LN3:      DS   1-CPM,0EFh   
0300   CD                     DS   CPM,0CDh   
0301   BB                     DS   CPM,APUT&0FFh   
0302   05                     DS   CPM,APUT/256   
0303   18 E6                  JR   ln2   
0305   2D           LN4:      DEC   L   ; Backspace: one back, and echo it,
0306   FA 00 03               JP   M,ln3   ;   unless the line was empty (L left the
0309   2C                     INC   L   ;   upper half of the page)
030A   18 DF                  JR   ln2   
030C   77           LN5:      LD   (HL),A   ; the CR
030D   2E 80                  LD   L,LINEBUF & 0FFh   
030F                          ;*Macro unroll:  NEXT
030F                          DS   (1-CPM)*(1-FAST),0F7h   
030F   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0310   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0311                             ; =============================================================================
0311                             ;  More routines (no handler starts past this point)
0311                             ; =============================================================================
0311                          IF   CHECKED   
0311                             ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
0311                             ; "$", and the texts of the report). A NUL first is an error: Q.
0311   7E           PRSTR:    LD   A,(HL)   
0312   23                     INC   HL   
0313   FE 22                  CP   22h   
0315   C8                     RET   Z   
0316   B7                     OR   A   
0317   CA 3D 06               JP   Z,e_dollar   
031A   FE 2F                  CP   "/"   
031C   20 0C                  JR   NZ,prs1   
031E   7E                     LD   A,(HL)   
031F   23                     INC   HL   
0320   FE 60                  CP   60h   
0322   38 04                  JR   C,prs0   
0324   FE 7F                  CP   7Fh   
0326   38 13                  JR   C,pesc   
0328   E6 BF        PRS0:     AND   0BFh   
032A                          ;*Macro unroll: prs1:   PUTA
032A                PRS1:     DS   1-CPM,0EFh   
032A   CD                     DS   CPM,0CDh   
032B   BB                     DS   CPM,APUT&0FFh   
032C   05                     DS   CPM,APUT/256   
032D   18 E2                  JR   prstr   
032F                PRLOOP:   EQU   prstr   ; (where the escapes go back to)
032F                PRAGAIN:   EQU   hp1   ; (and where /~ goes back to)
032F                             ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
032F                             ; pnl: the same, on a new line.
032F   CD 35 03     PNL:      CALL   pmsg   ; (pmsg's own CR LF, then on into pmsg for
0332   0D 0A 22               DB   13,10,22h   ;   the caller's text)
0335   E3           PMSG:     EX   (SP),HL   
0336   CD 11 03               CALL   prstr   
0339   E3                     EX   (SP),HL   
033A   C9                     RET      
033B                          ENDIF      
033B                             ; pesc: the escapes of "$". A = the character after the "/", 60h to 7Eh, and
033B                             ; HL points past it. Each goes back into the loop that prints the string
033B                             ; (PRLOOP), but /~ has the stack to see to, and goes back by PRAGAIN.
033B                             ;    /a-/z   print the variable, as "#" does
033B                             ;    /{      clear the screen, the cursor to the top left
033B                             ;    /}      clear from the cursor to the end of the line
033B                             ;    /|  /`  show the cursor, hide it
033B                             ;    /~      ( row col -- ) the cursor to that row and column, from 0
033B   FE 7E        PESC:     CP   7Eh   
033D   28 1C                  JR   Z,pat   
033F   11 11 03               LD   DE,PRLOOP   ; the others return into the loop
0342   D5                     PUSH   DE   
0343   D6 7B                  SUB   7Bh   ; 00bbIDAsIHwgMSwg 2, and no borrow
0345   30 4A                  JR   NC,pcon   
0347   C6 1A                  ADD   A,1Ah   ; a-z: 0-25, and a carry; `: FFh, and none
0349   30 37                  JR   NC,phide   
034B   87                     ADD   A,A   ; the variable's cell
034C   C6 40                  ADD   A,40h   
034E   E5                     PUSH   HL   
034F   6F                     LD   L,A   
0350   26 0D                  LD   H,LETPAGE   
0352   7E                     LD   A,(HL)   
0353   2C                     INC   L   
0354   66                     LD   H,(HL)   
0355   6F                     LD   L,A   
0356   CD 13 05               CALL   psgn   
0359   E1                     POP   HL   
035A   C9                     RET      
035B                             ; /~ ( row col addr -- ): the two cells under the string's address go. In
035B                             ; the checked build "$" is the routine prstr: its own return address goes
035B                             ; first, and hp1 calls it again afterwards. There each /~ first looks that
035B                             ; its two cells are there, and is s if not, before it prints anything.
035B                PAT:         
035B                          IF   CHECKED   
035B   E3                     EX   (SP),HL   ; the text pointer over prstr's return address
035C   21 0A F3               LD   HL,(6-DSTOP)&0FFFFh   ; a carry: the two cells aren't there
035F   39                     ADD   HL,SP   
0360   DA F7 05               JP   C,e_under   
0363   E1                     POP   HL   
0364                          ENDIF      
0364   D1                     POP   DE   ; DE = the column
0365   E3                     EX   (SP),HL   ; HL = the row; the text pointer is kept
0366                          IF   1-ANS   
                              CALL   CONAT   
                              POP   HL   
                              JP   PRAGAIN   
                                 ; With ANSI = 0 the machine's routines do the rest.
                    PCON:     JP   Z,CONCLS   ; /{
                              CP   2   
                              JP   Z,CONEOL   ; /}
                              DB   0FEh   ; /|  (CP n steps over the XOR: A = 1, show)
                    PHIDE:    XOR   A   ; /`  (A = 0: hide)
                              JP   CONCUR   
0366                          ENDIF      
0366                          IF   ANS   
0366   D5                     PUSH   DE   
0367   CD A5 03               CALL   csi   ; ESC [ row+1 ; col+1 H (ANSI counts from 1)
036A   23                     INC   HL   
036B   CD 1E 05               CALL   pdec   
036E                          ;*Macro unroll:  PUTK    3Bh             ; ';'
036E                          DS   1-CPM,3Eh   ; ";"
036E                          DS   1-CPM,3Bh   
036E                          DS   1-CPM,0EFh   
036E   CD                     DS   CPM,0CDh   
036F   B7                     DS   CPM,APTK&0FFh   
0370   05                     DS   CPM,APTK/256   
0371   3B                     DS   CPM,3Bh   
0372   E1                     POP   HL   
0373   23                     INC   HL   
0374   CD 1E 05               CALL   pdec   
0377                          ;*Macro unroll:  PUTK    48h             ; 'H'
0377                          DS   1-CPM,3Eh   ; "H"
0377                          DS   1-CPM,48h   
0377                          DS   1-CPM,0EFh   
0377   CD                     DS   CPM,0CDh   
0378   B7                     DS   CPM,APTK&0FFh   
0379   05                     DS   CPM,APTK/256   
037A   48                     DS   CPM,48h   
037B   E1                     POP   HL   
037C   C3 AF 02               JP   PRAGAIN   
037F                             ; With ANSI = 1 they are sequences. The carry is clear on the way in.
037F   1E 68        PSHOW:    LD   E,"h"   ; /|  ESC [ ? 2 5 h
0381   DA                     DB   0DAh   ; (JP C,nn: with no carry it steps over two bytes)
0382   1E 6C        PHIDE:    LD   E,"l"   ; /`  ESC [ ? 2 5 l
0384                          ENDIF      
0384                          IF   ANS*CHECKED   
0384                             ; (The checked build prints the fixed parts with pmsg, which it has for the
0384                             ; report: shorter than a character at a time.)
0384   CD 35 03               CALL   pmsg   
0387   1B 5B 3F 32 35 22      DB   27,"[?25",22h   
038D   7B           PSE:      LD   A,E   ; then E
038E                          ;*Macro unroll:  PUTAR
038E                          DS   1-CPM,0EFh   
038E                          DS   1-CPM,0C9h   
038E   C3                     DS   CPM,0C3h   
038F   BB                     DS   CPM,APUT&0FFh   
0390   05                     DS   CPM,APUT/256   
0391                             ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into cse.
0391   3D           PCON:     DEC   A   
0392   28 EB                  JR   Z,pshow   ; /|
0394   1E 4B                  LD   E,"K"   
0396   F2 A0 03               JP   P,cse   ; /}  ESC [ K
0399   1E 48                  LD   E,"H"   ; /{  ESC [ H ESC [ J
039B   CD A0 03               CALL   cse   
039E   1E 4A                  LD   E,"J"   ; (on into cse)
03A0                             ; cse: ESC [ and then E. csi: ESC [. Both keep HL.
03A0   CD A5 03     CSE:      CALL   csi   
03A3   18 E8                  JR   pse   
03A5   CD 35 03     CSI:      CALL   pmsg   
03A8   1B 5B 22               DB   27,"[",22h   
03AB   C9                     RET      
03AC                          ENDIF      
03AC                          IF   ANS*(1-CHECKED)   
                              LD   A,"?"   
                              CALL   csia   
                              ;*Macro unroll:  PUTK    32h             ; '2'
                              DS   1-CPM,3Eh   ; "2"
                              DS   1-CPM,32h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,32h   
                              ;*Macro unroll:  PUTK    35h             ; '5'
                              DS   1-CPM,3Eh   ; "5"
                              DS   1-CPM,35h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,35h   
                              LD   A,E   
                              ;*Macro unroll:  PUTAR
                              DS   1-CPM,0EFh   
                              DS   1-CPM,0C9h   
                              DS   CPM,0C3h   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                                 ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into csia.
                    PCON:     DEC   A   
                              JR   Z,pshow   ; /|
                              LD   A,"K"   
                              JP   P,csia   ; /}  ESC [ K
                              LD   A,"H"   ; /{  ESC [ H ESC [ J
                              CALL   csia   
                              LD   A,"J"   ; (on into csia)
                                 ; csia: ESC [ and then A. csi: ESC [, keeping A.
                    CSIA:     CALL   csi   
                              ;*Macro unroll:  PUTAR
                              DS   1-CPM,0EFh   
                              DS   1-CPM,0C9h   
                              DS   CPM,0C3h   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                    CSI:      PUSH   AF   
                              ;*Macro unroll:  PUTK    1Bh             ; ESC
                              DS   1-CPM,3Eh   ; ESC
                              DS   1-CPM,1Bh   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,1Bh   
                              ;*Macro unroll:  PUTK    5Bh             ; '['
                              DS   1-CPM,3Eh   ; "["
                              DS   1-CPM,5Bh   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,5Bh   
                              POP   AF   
                              RET      
03AC                          ENDIF      
03AC                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
03AC                             ; Uses A; keeps BC (the IP) itself. The dividend shifts up through A:C while
03AC                             ; the quotient bits arrive at the bottom of C.
03AC                             ; Dividing by 2 is one shift (the spec wants that fast).
03AC                          IF   1-QK   
                    UDIV:     LD   A,E   
                              XOR   2   
                              OR   D   
                              JR   NZ,udv0   
                              SRL   H   
                              RR   L   ; the quotient
                              ADC   A,A   
                              LD   E,A   ; the remainder: the bit that fell out (D is 0)
                              RET      
03AC                          ENDIF      
03AC                          IF   QK   
03AC                             ; (The builds with room divide by any power of two with shifts: 2, and 32,
03AC                             ; 64, 256 and the like, which fixed point and byte work use all the time.)
03AC   7A           UDIV:     LD   A,D   
03AD   B7                     OR   A   
03AE   20 1A                  JR   NZ,uq1   ; 256 and up
03B0   B3                     OR   E   
03B1   28 33                  JR   Z,udv0   ; by 0: the long way (it means nothing anyway)
03B3   3D                     DEC   A   
03B4   A3                     AND   E   
03B5   20 2F                  JR   NZ,udv0   ; not a power of two
03B7   7B                     LD   A,E   ; by 2^k below 256: q = HL >> k, and
03B8   3D                     DEC   A   ;   r = L & (2^k - 1)
03B9   A5                     AND   L   
03BA   F5                     PUSH   AF   
03BB   CB 3B        UQ2:      SRL   E   
03BD   38 06                  JR   C,uq3   
03BF   CB 3C                  SRL   H   
03C1   CB 1D                  RR   L   
03C3   18 F6                  JR   uq2   
03C5   F1           UQ3:      POP   AF   
03C6   5F                     LD   E,A   
03C7   16 00                  LD   D,0   
03C9   C9                     RET      
03CA   7B           UQ1:      LD   A,E   
03CB   B7                     OR   A   
03CC   20 18                  JR   NZ,udv0   
03CE   7A                     LD   A,D   
03CF   3D                     DEC   A   
03D0   A2                     AND   D   
03D1   20 13                  JR   NZ,udv0   ; not a power of two
03D3   7A                     LD   A,D   ; by 2^k, 256 and up: q = H >> (k - 8), and
03D4   3D                     DEC   A   ;   r = HL & (2^k - 1)
03D5   A4                     AND   H   
03D6   5F                     LD   E,A   ; (the remainder's high byte,
03D7   7D                     LD   A,L   ;   and its low byte)
03D8   6C                     LD   L,H   
03D9   26 00                  LD   H,0   
03DB   CB 3A        UQ4:      SRL   D   
03DD   38 04                  JR   C,uq5   
03DF   CB 3D                  SRL   L   
03E1   18 F8                  JR   uq4   
03E3   53           UQ5:      LD   D,E   
03E4   5F                     LD   E,A   
03E5   C9                     RET      
03E6                          ENDIF      
03E6                          IF   1-FAST   
03E6   C5           UDV0:     PUSH   BC   
03E7   7C                     LD   A,H   
03E8   4D                     LD   C,L   
03E9   21 00 00               LD   HL,0   
03EC   06 10                  LD   B,16   
03EE   CB 21        UDV1:     SLA   C   
03F0   17                     RLA      
03F1   ED 6A                  ADC   HL,HL   
03F3   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
03F5   30 02                  JR   NC,udv2   ;   always fits in 16 bits
03F7   19                     ADD   HL,DE   ; too much: put it back, and cancel the
03F8   0D                     DEC   C   ;   INC below
03F9   0C           UDV2:     INC   C   ; a quotient bit
03FA   10 F2                  DJNZ   udv1   
03FC   EB                     EX   DE,HL   ; DE = remainder
03FD   67                     LD   H,A   
03FE   69                     LD   L,C   ; HL = quotient
03FF   C1                     POP   BC   
0400   C9                     RET      
0401                          ENDIF      
0401                          IF   FAST   
                                 ; (the fast build: the same 16 rounds, unrolled)
                    UDV0:     PUSH   BC   
                              LD   A,H   
                              LD   C,L   
                              LD   HL,0   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr0   
                              ADD   HL,DE   
                              DEC   C   
                    UVR0:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr1   
                              ADD   HL,DE   
                              DEC   C   
                    UVR1:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr2   
                              ADD   HL,DE   
                              DEC   C   
                    UVR2:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr3   
                              ADD   HL,DE   
                              DEC   C   
                    UVR3:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr4   
                              ADD   HL,DE   
                              DEC   C   
                    UVR4:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr5   
                              ADD   HL,DE   
                              DEC   C   
                    UVR5:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr6   
                              ADD   HL,DE   
                              DEC   C   
                    UVR6:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr7   
                              ADD   HL,DE   
                              DEC   C   
                    UVR7:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr8   
                              ADD   HL,DE   
                              DEC   C   
                    UVR8:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr9   
                              ADD   HL,DE   
                              DEC   C   
                    UVR9:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr10   
                              ADD   HL,DE   
                              DEC   C   
                    UVR10:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr11   
                              ADD   HL,DE   
                              DEC   C   
                    UVR11:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr12   
                              ADD   HL,DE   
                              DEC   C   
                    UVR12:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr13   
                              ADD   HL,DE   
                              DEC   C   
                    UVR13:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr14   
                              ADD   HL,DE   
                              DEC   C   
                    UVR14:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr15   
                              ADD   HL,DE   
                              DEC   C   
                    UVR15:    INC   C   
                              EX   DE,HL   ; DE = remainder
                              LD   H,A   
                              LD   L,C   ; HL = quotient
                              POP   BC   
                              RET      
0401                          ENDIF      
0401                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
0401                             ; non-digit. Values wrap at 16 bits, as the spec says.
0401   21 00 00     RDNUM:    LD   HL,0   
0404   0A           RDN1:     LD   A,(BC)   
0405   D6 30                  SUB   "0"   
0407   FE 0A                  CP   10   
0409   D0                     RET   NC   
040A   03                     INC   BC   
040B   54                     LD   D,H   
040C   5D                     LD   E,L   
040D   29                     ADD   HL,HL   
040E   29                     ADD   HL,HL   
040F   19                     ADD   HL,DE   
0410   29                     ADD   HL,HL   ; HL * 10
0411   5F                     LD   E,A   
0412   16 00                  LD   D,0   
0414   19                     ADD   HL,DE   
0415   18 ED                  JR   rdn1   
0417                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
0417                             ; the next character, so "/"" does not end it. Leaves A = 22h.
0417                          IF   1-CHECKED   
                    SS0:      INC   BC   
                    SKIPSTR:   LD   A,(BC)   
                              INC   BC   
                              CP   "/"   
                              JR   Z,ss0   
                              CP   22h   
                              JR   NZ,skipstr   
                              RET      
0417                          ENDIF      
0417                          IF   CHECKED   
0417                             ; The checked build never steps over a NUL: if the text runs out first it
0417                             ; returns A = 0 with the IP on the NUL.
0417   0A           SKIPSTR:   LD   A,(BC)   
0418   B7                     OR   A   
0419   C8                     RET   Z   
041A   03                     INC   BC   
041B   FE 22                  CP   22h   
041D   C8                     RET   Z   
041E   FE 2F                  CP   "/"   
0420   20 F5                  JR   NZ,skipstr   
0422   0A                     LD   A,(BC)   ; the escaped character
0423   B7                     OR   A   
0424   C8                     RET   Z   
0425   03                     INC   BC   
0426   18 EF                  JR   skipstr   
0428                          ENDIF      
0428                             ; skip: read past text to the closer at this level, and return A = 0 if it
0428                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
0428                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
0428                             ; no closer; anything else that runs into the NUL had unbalanced brackets
0428                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
0428                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
0428                             ; 
0428                             ; The checked build also looks at the character the skip was started by,
0428                             ; which is always the one just before where it starts: "(" must end at ")",
0428                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
0428                             ; quote counts as running into it. "\" takes either closer. SKPL keeps the
0428                             ; place where the skip started, for the report.
0428                          IF   1-QK   
                                 ; (Without base: no skip cache.)
                    SKIP:        
0428                          ENDIF      
0428                          IF   CHECKED*(1-QK)   
                              LD   (SKPL),BC   
                              DEC   BC   
                              LD   A,(BC)   
                              INC   BC   
                              LD   E,A   ; E = the opener: ( [ or \
0428                          ENDIF      
0428                          IF   1-QK   
                              LD   D,0   
                    SK3:      INC   D   ; an opener: one deeper
                    SK1:      LD   A,(BC)   
0428                          ENDIF      
0428                          IF   (1-CHECKED)*(1-QK)   
                              INC   BC   
                              OR   A   
                              JP   Z,SKEND   ; (the end of the program)
0428                          ENDIF      
0428                          IF   CHECKED*(1-QK)   
                              OR   A   
                              JR   Z,sk6   ; (the IP stays on the NUL)
                              INC   BC   
0428                          ENDIF      
0428                          IF   1-QK   
                              CP   22h   
                              CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
                              SUB   "("   ;   (or 0, and then the NUL is read next)
                              JR   Z,sk3   
                              DEC   A   ; ")"
                              JR   Z,sk4   
                              SUB   "["-")"   
                              JR   Z,sk3   
                              CP   "]"-"["   
                              JR   NZ,sk1   
                    SK4:      DEC   D   
0428                          ENDIF      
0428                          IF   (1-CHECKED)*(1-QK)   
                              RET   Z   ; the closer at this level
                              JR   sk1   
0428                          ENDIF      
0428                          IF   CHECKED*(1-QK)   
                              JR   NZ,sk1   
                              LD   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
                              XOR   E   ;   opener is 0 for "(" and 1 for "[", and only
                              AND   6   ;   "\" has bit 2: so this is 2 for the wrong
                              CP   2   ;   closer, and only then
                              LD   A,D   
                              RET   NZ   
                              JR   sk7   
                    SK6:      BIT   2,E   ; the text ran out:
                              JP   NZ,SKEND   ;   "\" with no closer ends the program
                    SK7:      LD   BC,(SKPL)   ; N. The place is the opener
                              LD   A,"N"   
                              JP   errp   ; (errp drops skip's return address)
0428                          ENDIF      
0428                          IF   QK   
0428                             ; The skip cache. Nearly every skip is one that has happened before (a loop
0428                             ; skips the same false block on every pass), so the first scan from each
0428                             ; place is remembered: 64 entries of 00bbc3RhcnQsIGVuZA==, at CPAGE, found by the
0428                             ; start's low byte. Only skips that start in the program text are kept (the
0428                             ; line buffer changes); the cache is emptied whenever a run starts (skclr).
0428                             ; A program that changes its own text while it runs is not looked after.
0428   ED 43 3C 0D  SKIP:     LD   (SKPL),BC   ; where it starts: the cache's key (and the
042C   78                     LD   A,B   ;   checked report's place)
042D   FE 0E                  CP   PROG/256   
042F   38 1B                  JR   C,sks   ; below the program text: no cache
0431   79                     LD   A,C   
0432   87                     ADD   A,A   
0433   87                     ADD   A,A   
0434   5F                     LD   E,A   
0435   16 0A                  LD   D,CPAGE   ; DE -> the entry
0437   1A                     LD   A,(DE)   
0438   B9                     CP   C   
0439   20 11                  JR   NZ,sks   
043B   1C                     INC   E   
043C   1A                     LD   A,(DE)   
043D   B8                     CP   B   
043E   20 0C                  JR   NZ,sks   
0440   1C                     INC   E   
0441   1A                     LD   A,(DE)   
0442   4F                     LD   C,A   
0443   1C                     INC   E   
0444   1A                     LD   A,(DE)   
0445   47                     LD   B,A   ; a hit: the IP is past the closer
0446   0B                     DEC   BC   
0447   0A                     LD   A,(BC)   
0448   03                     INC   BC   
0449   D6 29                  SUB   ")"   ; 0 for ")", not 0 for "]"
044B   C9                     RET      
044C                SKS:         
044C                          ENDIF      
044C                          IF   QK*CHECKED   
044C   0B                     DEC   BC   
044D   0A                     LD   A,(BC)   
044E   03                     INC   BC   
044F   5F                     LD   E,A   ; E = the opener: ( [ or \
0450                          ENDIF      
0450                          IF   QK   
0450                             ; The scan. Most characters are nothing to it, and two range tests rule
0450                             ; them out: * to Z, and ^ and up. Only NUL " ( ) [ ] count.
0450   16 00                  LD   D,0   
0452   14           SQ3:      INC   D   ; an opener: one deeper
0453   0A           SQ1:      LD   A,(BC)   
0454   03                     INC   BC   
0455   FE 5E                  CP   5Eh   
0457   30 FA                  JR   NC,sq1   ; ^ _ ` a-z 00bbIHwg ~ and up: nothing
0459   FE 5B                  CP   5Bh   
045B   30 25                  JR   NC,sqb   ; [ \ ]
045D   FE 2A                  CP   2Ah   
045F   30 F2                  JR   NC,sq1   ; * to Z: nothing
0461   FE 28                  CP   28h   
0463   28 ED                  JR   Z,sq3   ; (
0465   30 25                  JR   NC,sqc   ; )
0467   FE 22                  CP   22h   
0469   28 12                  JR   Z,sqq   ; a string
046B   B7                     OR   A   
046C   20 E5                  JR   NZ,sq1   ; the rest below "(": nothing
046E                          ENDIF      
046E                          IF   QK*(1-CHECKED)   
                              JP   SKEND   ; NUL: the end of the program
046E                          ENDIF      
046E                          IF   QK*CHECKED   
046E   0B                     DEC   BC   ; NUL: the IP stays on it
046F   CB 53                  BIT   2,E   ; the text ran out:
0471   C2 38 07               JP   NZ,SKEND   ;   "\" with no closer ends the program
0474   ED 4B 3C 0D  SQ7:      LD   BC,(SKPL)   ; N. The place is the opener
0478   3E 4E                  LD   A,"N"   
047A   C3 3A 06               JP   errp   ; (errp drops skip's return address)
047D                          ENDIF      
047D                          IF   QK   
047D   CD 17 04     SQQ:      CALL   skipstr   ; step over the string
0480   18 D1                  JR   sq1   
0482   D6 5C        SQB:      SUB   5Ch   ; [ -1, \ 0, ] 1
0484   28 CD                  JR   Z,sq1   ; "\" is nothing here
0486   38 CA                  JR   C,sq3   ; [
0488   3E 02                  LD   A,2   ; ]
048A   18 01                  JR   sq4   
048C   AF           SQC:      XOR   A   ; )
048D   15           SQ4:      DEC   D   
048E   20 C3                  JR   NZ,sq1   
0490                          ENDIF      
0490                          IF   QK*CHECKED   
0490   57                     LD   D,A   ; the closer at this level (as above): 2 here
0491   AB                     XOR   E   ;   means the wrong closer
0492   E6 06                  AND   6   
0494   FE 02                  CP   2   
0496   7A                     LD   A,D   
0497   28 DB                  JR   Z,sq7   
0499                          ENDIF      
0499                          IF   QK   
0499                             ; The closer at this level: remember the skip (if it started in the program
0499                             ; text), and return A = 0 for ")" or 2 for "]".
0499   F5                     PUSH   AF   
049A   E5                     PUSH   HL   
049B   2A 3C 0D               LD   HL,(SKPL)   
049E   7C                     LD   A,H   
049F   FE 0E                  CP   PROG/256   
04A1   38 11                  JR   C,sq9   
04A3   7D                     LD   A,L   
04A4   87                     ADD   A,A   
04A5   87                     ADD   A,A   
04A6   5F                     LD   E,A   
04A7   16 0A                  LD   D,CPAGE   
04A9   7D                     LD   A,L   
04AA   12                     LD   (DE),A   
04AB   1C                     INC   E   
04AC   7C                     LD   A,H   
04AD   12                     LD   (DE),A   
04AE   1C                     INC   E   
04AF   79                     LD   A,C   
04B0   12                     LD   (DE),A   
04B1   1C                     INC   E   
04B2   78                     LD   A,B   
04B3   12                     LD   (DE),A   
04B4   E1           SQ9:      POP   HL   
04B5   F1                     POP   AF   
04B6   C9                     RET      
04B7                             ; skclr: empty the skip cache (a start of 0000h matches no skip). Keeps HL.
04B7   E5           SKCLR:    PUSH   HL   
04B8   21 00 0A               LD   HL,CPAGE*256   
04BB   36 00        SKC1:     LD   (HL),0   
04BD   2C                     INC   L   
04BE   20 FB                  JR   NZ,skc1   
04C0   E1                     POP   HL   
04C1   C9                     RET      
04C2                          ENDIF      
04C2                             ;  ---- Speed-ups (base builds) -------------------------------------------
04C2                             ;  The skip cache is above. These are the handlers' tails that the builds with
04C2                             ;  room take, kept here, out of the handlers' first two pages.
04C2                          IF   QK   
04C2                             ; "*" with an operand below 256 takes 8 rounds, not 16: that one becomes the
04C2                             ; multiplier (most multiplications have one, a count or a small constant).
04C2   7C           MULQ:     LD   A,H   
04C3   B7                     OR   A   
04C4   28 05                  JR   Z,mq8   ; the multiplier is below 256
04C6   7A                     LD   A,D   
04C7   B7                     OR   A   
04C8   20 12                  JR   NZ,mq16   
04CA   EB                     EX   DE,HL   ; the multiplicand is: it becomes the multiplier
04CB                          ENDIF      
04CB                          IF   QK*(1-FAST)   
04CB   7D           MQ8:      LD   A,L   
04CC   21 00 00               LD   HL,0   
04CF   C5                     PUSH   BC   
04D0   06 08                  LD   B,8   
04D2   29           MQ1:      ADD   HL,HL   
04D3   17                     RLA      
04D4   30 01                  JR   NC,mq2   
04D6   19                     ADD   HL,DE   
04D7   10 F9        MQ2:      DJNZ   mq1   
04D9   C1                     POP   BC   
04DA                          ;*Macro unroll:  NEXT
04DA                          DS   (1-CPM)*(1-FAST),0F7h   
04DA   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
04DB   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
04DC   C5           MQ16:     PUSH   BC   ; 16 rounds; the multiplier shifts up through A:C
04DD   7C                     LD   A,H   
04DE   4D                     LD   C,L   
04DF   21 00 00               LD   HL,0   
04E2   06 10                  LD   B,16   
04E4   29           MQ3:      ADD   HL,HL   
04E5   CB 21                  SLA   C   
04E7   17                     RLA      
04E8   30 01                  JR   NC,mq4   
04EA   19                     ADD   HL,DE   
04EB   10 F7        MQ4:      DJNZ   mq3   
04ED   C1                     POP   BC   
04EE                          ;*Macro unroll:  NEXT
04EE                          DS   (1-CPM)*(1-FAST),0F7h   
04EE   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
04EF   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
04F0                          ENDIF      
04F0                          IF   FAST   
                                 ; (the fast build: the same rounds, unrolled)
                    MQ8:      LD   A,L   
                              LD   HL,0   
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur0   
                              ADD   HL,DE   
                    MUR0:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur1   
                              ADD   HL,DE   
                    MUR1:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur2   
                              ADD   HL,DE   
                    MUR2:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur3   
                              ADD   HL,DE   
                    MUR3:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur4   
                              ADD   HL,DE   
                    MUR4:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur5   
                              ADD   HL,DE   
                    MUR5:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur6   
                              ADD   HL,DE   
                    MUR6:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur7   
                              ADD   HL,DE   
                    MUR7:        
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
                    MQ16:     PUSH   BC   
                              LD   A,H   
                              LD   C,L   
                              LD   HL,0   
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus0   
                              ADD   HL,DE   
                    MUS0:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus1   
                              ADD   HL,DE   
                    MUS1:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus2   
                              ADD   HL,DE   
                    MUS2:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus3   
                              ADD   HL,DE   
                    MUS3:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus4   
                              ADD   HL,DE   
                    MUS4:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus5   
                              ADD   HL,DE   
                    MUS5:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus6   
                              ADD   HL,DE   
                    MUS6:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus7   
                              ADD   HL,DE   
                    MUS7:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus8   
                              ADD   HL,DE   
                    MUS8:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus9   
                              ADD   HL,DE   
                    MUS9:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus10   
                              ADD   HL,DE   
                    MUS10:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus11   
                              ADD   HL,DE   
                    MUS11:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus12   
                              ADD   HL,DE   
                    MUS12:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus13   
                              ADD   HL,DE   
                    MUS13:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus14   
                              ADD   HL,DE   
                    MUS14:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus15   
                              ADD   HL,DE   
                    MUS15:       
                              POP   BC   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
04F0                          ENDIF      
04F0                          IF   QK   
04F0                             ; A true ")" reads the block start where it is, on top of the return stack,
04F0                             ; instead of popping it and pushing it back; the break key is looked at as
04F0                             ; rpushn would.
04F0   FD 4E 00     CLOSEQ:   LD   C,(IY+0)   
04F3   FD 46 01               LD   B,(IY+1)   
04F6   E5                     PUSH   HL   
04F7   21 36 0D               LD   HL,PCNT   
04FA   35                     DEC   (HL)   
04FB   E1                     POP   HL   
04FC   CC 51 05               CALL   Z,pollk   
04FF                          ;*Macro unroll:  NEXT
04FF                          DS   (1-CPM)*(1-FAST),0F7h   
04FF   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0500   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0501                          ENDIF      
0501                          IF   SBASEU   
                                 ; a-z, in the unchecked builds: a variable followed by "@" or "!" is fetched
                                 ; or stored in the same step (x@ is the commonest pair in most programs).
                                 ; (A checked build checks the stacks between the two, so it keeps them apart.)
                    LOWQ:     ADD   A,A   
                              LD   E,A   
                              LD   D,LETPAGE   ; DE -> the cell
                              LD   A,(BC)   
                              CP   "@"   
                              JR   Z,lwf   
                              CP   "!"   
                              JR   Z,lws   
                              PUSH   HL   
                              EX   DE,HL   ; TOS = the cell's address
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
                    LWF:      INC   BC   ; x@: TOS = the cell's value
                              PUSH   HL   
                              EX   DE,HL   
                              LD   E,(HL)   
                              INC   L   
                              LD   D,(HL)   
                              EX   DE,HL   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
                    LWS:      INC   BC   ; x!: the cell = TOS, and NOS comes up
                              EX   DE,HL   
                              LD   (HL),E   
                              INC   L   
                              LD   (HL),D   
                              POP   HL   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
0501                          ENDIF      
0501                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)*QK   
                    QSTART:   LD   BC,PROG   ; the generic reset goes on here: the IP,
                              CALL   skclr   ;   an empty skip cache, and the rest of the
                              JP   st0   ;   startup
0501                          ENDIF      
0501                          IF   (1-CPM)*(1-EDITOR)*CHECKED*QK   
                    QINIT:    CALL   skclr   ; (keeps A, which init wants 0)
                              JP   init   
0501                          ENDIF      
0501                             ; =============================================================================
0501                             ;  Dispatch table: the low byte of each handler's address, in code order
0501                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
0501                             ;  It must not cross a page (the dispatcher only adds to its low byte).
0501                             ; =============================================================================
0501                             ; The handlers of the first NPG1 characters start in the image's second page.
0501                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
0501                             ; differs between the builds, so the count is worked out here.
0501                             ; (One division to a line: asm80 only rounds down when it stores a value.)
0501                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
0501                PGBRK:    EQU   (h_break-BASE)/256   
0501                PGDEF:    EQU   (h_def-BASE)/256   
0501                PGFET:    EQU   (h_fetch-BASE)/256   
0501                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
0501                          IF   (1-TABP0)*(1-PTLATE)   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0501                          ENDIF      
0501                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
0501                             ; and return its value in A with the carry set; otherwise leave the IP and
0501                             ; return with the carry clear.
0501   0A           HEXC:     LD   A,(BC)   
0502   D6 30                  SUB   "0"   
0504   FE 0A                  CP   10   
0506   38 09                  JR   C,hc1   
0508   E6 DF                  AND   0DFh   
050A   D6 11                  SUB   11h   
050C   FE 06                  CP   6   
050E   D0                     RET   NC   
050F   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
0511   03           HC1:      INC   BC   
0512   C9                     RET      
0513                             ; psgn: print HL as a signed number. Keeps BC.
0513   CB 7C        PSGN:     BIT   7,H   
0515   28 07                  JR   Z,pdec   
0517                          ;*Macro unroll:  PUTK    2Dh             ; '-'
0517                          DS   1-CPM,3Eh   ; "-"
0517                          DS   1-CPM,2Dh   
0517                          DS   1-CPM,0EFh   
0517   CD                     DS   CPM,0CDh   
0518   B7                     DS   CPM,APTK&0FFh   
0519   05                     DS   CPM,APTK/256   
051A   2D                     DS   CPM,2Dh   
051B                          ;*Macro unroll:  NEGH
051B                          DS   1-CPM,0E7h   
051B   CD                     DS   CPM,0CDh   
051C   9A                     DS   CPM,ANEG&0FFh   
051D   05                     DS   CPM,ANEG/256   
051E                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
051E                             ; Keeps BC.
051E   11 0A 00     PDEC:     LD   DE,10   
0521   CD AC 03               CALL   udiv   ; HL = HL / 10, E = the last digit
0524   7B                     LD   A,E   
0525   F5                     PUSH   AF   
0526   7C                     LD   A,H   
0527   B5                     OR   L   
0528   C4 1E 05               CALL   NZ,pdec   
052B   F1                     POP   AF   
052C   C6 30                  ADD   A,"0"   
052E                          ;*Macro unroll:  PUTAR
052E                          DS   1-CPM,0EFh   
052E                          DS   1-CPM,0C9h   
052E   C3                     DS   CPM,0C3h   
052F   BB                     DS   CPM,APUT&0FFh   
0530   05                     DS   CPM,APUT/256   
0531                             ; (The table goes here instead in the builds where, before psgn, it would
0531                             ; cross a page: PTLATE. If it would cross one here too, it starts on the next
0531                             ; page: PTPAD is 0 unless it must.)
0531                          IF   (1-TABP0)*PTLATE   
0531                PTPH:     EQU   $ & 0FFh   
0531                PTPX:     EQU   (PTPH + 31) / 256   
0531                PTPAD:    EQU   PTPX * (256 - PTPH)   
0531                          DS   PTPAD   
0531                PTAB:        
0531                          ;*Macro unroll:  PTABLE
0531   96                     DB   h_store & 0FFh   
0532   A0                     DB   h_str & 0FFh   
0533   BC                     DB   h_num & 0FFh   
0534   AC                     DB   h_print & 0FFh   
0535   8B                     DB   h_swap & 0FFh   
0536   3C                     DB   h_and & 0FFh   
0537   B5                     DB   h_emit & 0FFh   
0538   15                     DB   h_open & 0FFh   
0539   1D                     DB   h_close & 0FFh   
053A   5F                     DB   h_mul & 0FFh   
053B   2F                     DB   h_add & 0FFh   
053C   DA                     DB   h_cfetch & 0FFh   
053D   25                     DB   h_sub & 0FFh   
053E   8E                     DB   h_cstore & 0FFh   
053F   63                     DB   h_div & 0FFh   
0540   88                     DB   h_dup & 0FFh   
0541   93                     DB   h_drop & 0FFh   
0542   45                     DB   h_lt & 0FFh   
0543   55                     DB   h_eq & 0FFh   
0544   46                     DB   h_gt & 0FFh   
0545   C2                     DB   h_key & 0FFh   
0546   0F                     DB   h_fetch & 0FFh   
0547   EA                     DB   h_def & 0FFh   
0548   DA                     DB   h_break & 0FFh   
0549   D3                     DB   h_ret & 0FFh   
054A   62                     DB   h_xor & 0FFh   
054B   7A                     DB   h_alloc & 0FFh   
054C   BB                     DB   h_grave & 0FFh   
054D   B7                     DB   h_tor & 0FFh   
054E   6B                     DB   h_or & 0FFh   
054F   12                     DB   h_fromr & 0FFh   
0550   74                     DB   h_not & 0FFh   
0551                PTABEND:      
0551                          ENDIF      
0551                             ; =============================================================================
0551                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
0551                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
0551                             ;  (RST 28h) prints A. Both keep BC, DE, HL and IY. In the generic build
0551                             ;  they are the host's KEY and CONOUT routines themselves.
0551                             ; 
0551                             ;  A running program reads the keyboard only through getk and pollk, which
0551                             ;  between them give the break key its rules:
0551                             ;    - Ctrl-C stops the program;
0551                             ;    - any other key that the break check reads is held in KEYBUF for the
0551                             ;      next "?", and a newer one takes its place;
0551                             ;    - "?" (getk) takes the held key first;
0551                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
0551                             ;      key like any other, but two of them within about 250 ms still stop it.
0551                             ;  Both are called straight from a handler, never from a routine under one:
0551                             ;  the checked build's report counts on finding one return address above the
0551                             ;  data stack.
0551                             ; =============================================================================
0551                          IFN   CPM   
                    RAWK:     EQU   KEY   
0551                          ENDIF      
0551                             ; pollk: the break check (see rpushn).
0551   CD B3 05     POLLK:    CALL   rawk   
0554   C8                     RET   Z   ; no key
0555   32 7A 0D               LD   (KEYBUF),A   ; held for the next "?"
0558   FE 03        PK1:      CP   3   ; (getk joins here)
055A   C0                     RET   NZ   
055B                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
055B                             ; the program has turned it off, wait about 250 ms for one more key: a
055B                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
055B                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
055B   3A 7B 0D     CTLC:     LD   A,(BRKOFF)   
055E   B7                     OR   A   
055F   CA 38 06     CT0:      JP   Z,brk   
0562   D5                     PUSH   DE   
0563   11 E8 03               LD   DE,250*MSLOOP   
0566   CD B3 05     CT1:      CALL   rawk   
0569   20 05                  JR   NZ,ct2   
056B   1B                     DEC   DE   
056C   7A                     LD   A,D   
056D   B3                     OR   E   
056E   20 F6                  JR   NZ,ct1   
0570   D1           CT2:      POP   DE   ; A = the second key, or 0 if none came
0571   FE 03                  CP   3   
0573   28 EA                  JR   Z,ct0   ; (the zero flag takes the JP there)
0575   B7                     OR   A   
0576   28 03                  JR   Z,ct3   
0578   32 7A 0D               LD   (KEYBUF),A   
057B   3E 03        CT3:      LD   A,3   
057D   B7                     OR   A   
057E   C9                     RET      
057F                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
057F   E5           GETK:     PUSH   HL   ; a held key goes first, and is taken out of
0580   21 7A 0D               LD   HL,KEYBUF   ;   the buffer
0583   7E                     LD   A,(HL)   
0584   36 00                  LD   (HL),0   
0586   E1                     POP   HL   
0587   B7                     OR   A   
0588   C0                     RET   NZ   
0589   CD B3 05               CALL   rawk   
058C   C8                     RET   Z   
058D   18 C9                  JR   pk1   ; Ctrl-C? If not, that is the key
058F                          IF   (1-CHECKED)*(1-EDITOR)   
                    BRK:      EQU   endprog   ; the unchecked build stops without a word
058F                          ENDIF      ;   (with the editor, both stacks are cleared);
058F                          IF   (1-CHECKED)*EDITOR   
                    BRK:      EQU   edit0   
058F                          ENDIF      
058F                          IF   CHECKED   
058F                BRK:      EQU   e_break   ;   the checked build reports B
058F                          ENDIF      
058F                          IF   CPM   
058F                             ; The routines a generic build keeps in page zero (see there). Here they are
058F                             ; out of the way of the handlers, which must fit in the image's first two
058F                             ; pages.
058F   FD 5E 00     RPOP:     LD   E,(IY+0)   ; pop the return stack into DE
0592   FD 56 01               LD   D,(IY+1)   
0595   FD 23                  INC   IY   
0597   FD 23                  INC   IY   
0599   C9                     RET      
059A   AF           NEG16:    XOR   A   ; HL = -HL (keeps BC, DE)
059B   95                     SUB   L   
059C   6F                     LD   L,A   
059D   9F                     SBC   A,A   
059E   94                     SUB   H   
059F   67                     LD   H,A   
05A0   C9                     RET      
05A1                          ENDIF      
05A1                          IF   CPM*CHECKED   ; (the checked builds need the room)
05A1   FD 22 34 0D  EXEC:     LD   (RSAVE),IY   ; machine code may change IX and IY
05A5   CD BA 01               CALL   jphl   
05A8   FD 2A 34 0D            LD   IY,(RSAVE)   
05AC                          ;*Macro unroll:  SETIX
05AC   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
05AD   21                     DS   CPM+FAST-CPM*FAST,21h   
05AE   20                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
05AF   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
05B0   E1                     POP   HL   
05B1                          ;*Macro unroll:  NEXT
05B1                          DS   (1-CPM)*(1-FAST),0F7h   
05B1   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
05B2   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
05B3                          ENDIF      
05B3                          IF   CPM   
05B3   3E FF        RAWK:     LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
05B5   18 04                  JR   putc   
05B7   E3           PUTK:     EX   (SP),HL   ; print the byte after the CALL
05B8   7E                     LD   A,(HL)   
05B9   23                     INC   HL   
05BA   E3                     EX   (SP),HL   
05BB                             ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
05BB                             ; printing and could swallow a key that BDOS 6 then never sees.
05BB                             ; It keeps every register but A and the flags: BDOS may change any of them
05BB                             ; (IX and IY too, in a Z80 BDOS or BIOS).
05BB   C5           PUTC:     PUSH   BC   
05BC   D5                     PUSH   DE   
05BD   E5                     PUSH   HL   
05BE   DD E5                  PUSH   IX   
05C0   FD E5                  PUSH   IY   
05C2   5F                     LD   E,A   
05C3   0E 06                  LD   C,6   
05C5   CD 05 00               CALL   BDOS   
05C8   FD E1                  POP   IY   
05CA   DD E1                  POP   IX   
05CC   E1                     POP   HL   
05CD   D1                     POP   DE   
05CE   C1                     POP   BC   
05CF   B7                     OR   A   ; (for getk)
05D0   C9                     RET      
05D1                          ENDIF      
05D1                             ; =============================================================================
05D1                             ;  Checked build: the checks and the error report
05D1                             ; =============================================================================
05D1                          IF   CHECKED   
05D1                             ; chkstk: both stacks are checked once per character, not in every handler.
05D1                             ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
05D1                             ; the constant carries if it is above (cells were popped that were never
05D1                             ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
05D1                             ; a character late at most: the bytes above DSTOP and the guard band below
05D1                             ; the page take what happens meanwhile. DE is free between characters.
05D1   EB           CHKSTK:   EX   DE,HL   
05D2   21 05 F3               LD   HL,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
05D5   39                     ADD   HL,SP   
05D6   EB                     EX   DE,HL   
05D7   38 1E                  JR   C,e_under   
05D9   14                     INC   D   
05DA   20 17                  JR   NZ,e_over   
05DC   FD E5                  PUSH   IY   ; the return stack: in its page (or it has
05DE   D1                     POP   DE   ;   overflowed), and not above its empty
05DF   7A                     LD   A,D   ;   position (an underflow stays inside the
05E0   FE 0B                  CP   RSPAGE   ;   page, in the guard band)
05E2   7B                     LD   A,E   
05E3   20 0B                  JR   NZ,e_rover   
05E5   FE E1                  CP   RSTOP&0FFh+1   
05E7   D8                     RET   C   
05E8   FD 21 E0 0B            LD   IY,RSTOP   ; return stack underflow: it counts as empty
05EC   3E 72                  LD   A,"r"   
05EE   18 4A                  JR   errp   
05F0   3E 52        E_ROVER:   LD   A,"R"   ; return stack overflow
05F2   11                     DB   11h   ; (LD DE,nn hides the next entry)
05F3   3E 53        E_OVER:   LD   A,"S"   ; data stack overflow
05F5   18 43                  JR   errp   
05F7   31 FC 0C     E_UNDER:   LD   SP,DSTOP   ; data stack underflow: it counts as empty
05FA   3E 73                  LD   A,"s"   
05FC   18 56                  JR   error   
05FE                             ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
05FE                             ; was never defined still holds 0000h, and the byte there is a reserved one
05FE                             ; in every build (AFh or C3h): if the IP is in page zero, this was a call of
05FE                             ; an undefined word. The call is undone, so the place is the call itself.
05FE   04           E_HI:     INC   B   
05FF   10 4B                  DJNZ   e_resv   ; (B is as it was, and is not 0)
0601                          ;*Macro unroll:  POPR
0601                          DS   1-CPM,0CFh   
0601   CD                     DS   CPM,0CDh   
0602   8F                     DS   CPM,AROP&0FFh   
0603   05                     DS   CPM,AROP/256   
0604   42                     LD   B,D   
0605   4B                     LD   C,E   
0606   3E 55                  LD   A,"U"   
0608   18 4A                  JR   error   
060A                             ; chkhp: HL = the new heap top, DE = the old one, the carry is from adding
060A                             ; the count. Stop if the top is not below the limit page, or is below the
060A                             ; program's end.
060A                CHKHP:       
060A                          ENDIF      
060A                          IF   CHECKED*CPM   
060A                             ; With this much room a top that wrapped round can land back in
060A                             ; range, so the add is tested too: growing (A, the count's high
060A                             ; byte, is positive) must not carry, and releasing must.
060A   1F                     RRA      ; the carry comes in above the sign:
060B   C6 40                  ADD   A,40h   ;   bit 7 = carry XOR sign
060D   87                     ADD   A,A   
060E   38 10                  JR   C,e_heap   
0610   3A 07 00               LD   A,(0007h)   
0613   3D                     DEC   A   
0614   BC                     CP   H   
0615   38 09                  JR   C,e_heap   
0617                          ENDIF      
0617                          IF   CHECKED*(1-CPM)   
                                 ; (Here the program's space is under 32K, so a top that wrapped
                                 ; round always falls outside it.)
                              LD   A,H   
                              CP   HEAPLIM   
                              JR   NC,e_heap   
0617                          ENDIF      
0617                          IF   CHECKED   
0617   D5                     PUSH   DE   
0618   EB                     EX   DE,HL   
0619   2A 38 0D               LD   HL,(NPEND)   
061C   19                     ADD   HL,DE   ; carry: at or above the program's end
061D   EB                     EX   DE,HL   
061E   D1                     POP   DE   
061F   D8                     RET   C   
0620   B7           E_HEAP:   OR   A   ; put the count back in TOS for the report
0621   ED 52                  SBC   HL,DE   
0623   3E 48                  LD   A,"H"   
0625   18 13                  JR   errp   
0627                             ; chkst: stop unless HL is in the program's own space: from the letter page
0627                             ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
0627                             ; whatever lies above the limit are safe. Memory above the heap top but
0627                             ; below the limit is the program's own: Tiny BASIC keeps its lines there.
0627                             ; It is the page of HL + 1 that is tested, so that one test serves both
0627                             ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
0627                             ; Keeps HL and BC. It runs on into its own error entry.
0627   23           CHKST:    INC   HL   
0628   7C                     LD   A,H   
0629   2B                     DEC   HL   
062A   FE 0D                  CP   LETPAGE   
062C   38 07                  JR   C,e_store   
062E                          ENDIF      
062E                          IF   CHECKED*(1-CPM)   
                              CP   HEAPLIM   
                              RET   C   
062E                          ENDIF      
062E                          IF   CHECKED*CPM   
062E   5F                     LD   E,A   
062F   3A 07 00               LD   A,(0007h)   ; the BDOS page is the heap limit
0632   3D                     DEC   A   
0633   BB                     CP   E   
0634   D0                     RET   NC   
0635                          ENDIF      
0635                          IF   CHECKED   
0635                             ; Error entries. Each loads its letter and then hides the next entry inside
0635                             ; a 3-byte LD DE,nn (the 11h), so they all fall through to `error`.
0635   3E 4F        E_STORE:   LD   A,"O"   ; a store outside the program's space
0637   11                     DB   11h   
0638   3E 42        E_BREAK:   LD   A,"B"   ; Ctrl-C (found inside pollk or getk)
063A                             ; errp: an error found inside a routine: drop its return address first.
063A   D1           ERRP:     POP   DE   
063B   18 17                  JR   error   
063D                             ; e_dollar: "$" ran into a NUL (in prstr): Q, with the string's address
063D                             ; back in TOS. prstr"s return address goes first. But if "$' had no
063D                             ; address at all (the stack was empty), it is s, found now: chkstk, called
063D                             ; one cell up, sees the stack past its empty place then.
063D   D1           E_DOLLAR:   POP   DE   
063E   E1                     POP   HL   
063F   CD D1 05               CALL   chkstk   
0642   E5                     PUSH   HL   
0643   2A 34 0D               LD   HL,(RSAVE)   
0646   11                     DB   11h   ; (LD DE,nn hides e_quote's first two bytes)
0647   44           E_QUOTE:   LD   B,H   ; an unclosed string: HL is its address, one
0648   4D                     LD   C,L   ;   past the opening quote, which is the place
0649   3E 51                  LD   A,"Q"   
064B   11                     DB   11h   
064C   3E 58        E_RESV:   LD   A,"X"   ; a reserved byte outside a string
064E   11                     DB   11h   
064F   3E 5A        E_ZERO:   LD   A,"Z"   ; dividing by zero
0651   11                     DB   11h   
0652   3E 57        E_BRACK:   LD   A,"W"   ; bad character after [
0654                             ; error: the report, then the end. A = the letter, BC = one past the place,
0654                             ; HL = TOS, and both stacks as the report is to show them:
0654                             ; 
0654                             ;   Err X @ line,col
0654                             ;   D:n: the top 8 cells at most, bottom to top
0654                             ;   R:n
0654   E5           ERROR:    PUSH   HL   ; now the whole data stack is in memory
0655   5F                     LD   E,A   
0656   CD 2F 03               CALL   pnl   
0659   45 72 72 20 22         DB   "Err ",22h   
065E   7B                     LD   A,E   
065F                          ;*Macro unroll:  PUTA
065F                          DS   1-CPM,0EFh   
065F   CD                     DS   CPM,0CDh   
0660   BB                     DS   CPM,APUT&0FFh   
0661   05                     DS   CPM,APUT/256   
0662   CD 35 03               CALL   pmsg   
0665   20 40 20 22            DB   " @ ",22h   
0669   0B                     DEC   BC   ; BC = the place
066A                             ; The line and column. A place below the program is in the line
066A                             ; buffer: line 0. Otherwise count the LFs from the program's start;
066A                             ; DE = the line's number, HL = where it starts.
066A   21 80 0D               LD   HL,LINEBUF   
066D   11 00 00               LD   DE,0   
0670   78                     LD   A,B   
0671   FE 0E                  CP   PROG/256   
0673   38 14                  JR   C,er3   
0675   24                     INC   H   
0676   6B                     LD   L,E   ; HL = PROG
0677   13           ER1:      INC   DE   ; a new line starts at HL
0678   E5                     PUSH   HL   
0679   7D           ER2:      LD   A,L   
067A   91                     SUB   C   
067B   7C                     LD   A,H   
067C   98                     SBC   A,B   
067D   30 09                  JR   NC,er2x   ; reached the place
067F   7E                     LD   A,(HL)   
0680   23                     INC   HL   
0681   FE 0A                  CP   10   
0683   20 F4                  JR   NZ,er2   
0685   F1                     POP   AF   
0686   18 EF                  JR   er1   
0688   E1           ER2X:     POP   HL   
0689   C5           ER3:      PUSH   BC   
068A   E5                     PUSH   HL   
068B   EB                     EX   DE,HL   
068C   CD 1E 05               CALL   pdec   ; the line
068F                          ;*Macro unroll:  PUTK    2Ch             ; ','
068F                          DS   1-CPM,3Eh   ; ","
068F                          DS   1-CPM,2Ch   
068F                          DS   1-CPM,0EFh   
068F   CD                     DS   CPM,0CDh   
0690   B7                     DS   CPM,APTK&0FFh   
0691   05                     DS   CPM,APTK/256   
0692   2C                     DS   CPM,2Ch   
0693   D1                     POP   DE   
0694   E1                     POP   HL   
0695   B7                     OR   A   
0696   ED 52                  SBC   HL,DE   
0698   23                     INC   HL   
0699   CD 1E 05               CALL   pdec   ; the column
069C                             ; The two stack lines:  D:n: the top 8 cells at most, bottom to top
069C                             ;                       R:n
069C                             ; TOS is in memory with the rest (pushed) by now.
069C   CD 2F 03               CALL   pnl   
069F   44 3A 22               DB   "D:",22h   
06A2   21 FA 0C               LD   HL,DSTOP-2   ; (DSTOP-2) - SP is twice the depth (the cell
06A5   ED 72                  SBC   HL,SP   ;   at DSTOP-2 was pushed with the first value
06A7                             ;   and holds nothing; pnl left the carry clear)
06A7   CD EE 06               CALL   phalf   ; the depth
06AA                          ;*Macro unroll:  PUTK    3Ah             ; ':'
06AA                          DS   1-CPM,3Eh   ; ":"
06AA                          DS   1-CPM,3Ah   
06AA                          DS   1-CPM,0EFh   
06AA   CD                     DS   CPM,0CDh   
06AB   B7                     DS   CPM,APTK&0FFh   
06AC   05                     DS   CPM,APTK/256   
06AD   3A                     DS   CPM,3Ah   
06AE   79                     LD   A,C   
06AF   FE 09                  CP   9   
06B1   38 0A                  JR   C,er6   
06B3   CD 35 03               CALL   pmsg   
06B6   20 2E 2E 2E 22         DB   " ...",22h   
06BB   0E 08                  LD   C,8   
06BD   26 00        ER6:      LD   H,0   ; C = the number of cells to show
06BF   69                     LD   L,C   
06C0   29                     ADD   HL,HL   
06C1   39                     ADD   HL,SP   ; HL -> just above the deepest of them
06C2   0C                     INC   C   
06C3   0D           ER7:      DEC   C   
06C4   28 10                  JR   Z,er8   
06C6   2B                     DEC   HL   
06C7   56                     LD   D,(HL)   
06C8   2B                     DEC   HL   
06C9   5E                     LD   E,(HL)   
06CA   E5                     PUSH   HL   
06CB                          ;*Macro unroll:  PUTK    20h             ; ' '
06CB                          DS   1-CPM,3Eh   ; " "
06CB                          DS   1-CPM,20h   
06CB                          DS   1-CPM,0EFh   
06CB   CD                     DS   CPM,0CDh   
06CC   B7                     DS   CPM,APTK&0FFh   
06CD   05                     DS   CPM,APTK/256   
06CE   20                     DS   CPM,20h   
06CF   EB                     EX   DE,HL   
06D0   CD 13 05               CALL   psgn   
06D3   E1                     POP   HL   
06D4   18 ED                  JR   er7   
06D6   CD 2F 03     ER8:      CALL   pnl   
06D9   52 3A 22               DB   "R:",22h   
06DC   FD E5                  PUSH   IY   ; RSTOP - IY is under 256 (the pointer is
06DE   E1                     POP   HL   ;   at most one entry below its page), so
06DF   3E E0                  LD   A,RSTOP&0FFh   ;   the low bytes are enough
06E1   95                     SUB   L   
06E2   6F                     LD   L,A   
06E3   26 00                  LD   H,0   
06E5   CD EE 06               CALL   phalf   
06E8   CD 2F 03               CALL   pnl   
06EB   22                     DB   22h   
06EC                          ENDIF      
06EC                          IF   CHECKED*(1-EDITOR)   
                              JP   endprog   
06EC                          ENDIF      
06EC                          IF   CHECKED*EDITOR   
06EC   18 42                  JR   edit0   ; back to the editor, with both stacks cleared
06EE                          ENDIF      
06EE                          IF   CHECKED   
06EE                             ; phalf: print half of HL, and leave it in C.
06EE   CB 3C        PHALF:    SRL   H   
06F0   CB 1D                  RR   L   
06F2   E5                     PUSH   HL   
06F3   CD 1E 05               CALL   pdec   
06F6   C1                     POP   BC   
06F7   C9                     RET      
06F8                          ENDIF      
06F8                             ; =============================================================================
06F8                             ;  The line editor (EDITOR = 1)
06F8                             ; 
06F8                             ;  The interpreter starts here, and a program that ends comes back here.
06F8                             ;  There is no prompt. It follows the spec's suggested standard for a line
06F8                             ;  editor (docs/b8script.md, Environments). Type a line and press Return:
06F8                             ; 
06F8                             ;    n text    put the text in as line n; the lines from n on move down. A
06F8                             ;              number past the end (or 0) adds the line at the end.
06F8                             ;    n         take line n out
06F8                             ;    anything else is run at once, as B8Script. (Start such a line with a
06F8                             ;    space if it would begin with a digit.)
06F8                             ; 
06F8                             ;  A command key ends the line too, and takes what was typed as its argument:
06F8                             ; 
06F8                             ;    ^G        run the program
06F8                             ;    n ^L      list from line n (no number: all of it). Any key holds the
06F8                             ;              list until another key is pressed; Ctrl-C ends it.
06F8                             ;    n ^E      put line n in the input line; Return puts it back, changed
06F8                             ;    name ^R   read. CP/M: the file of that name (no name: the same file as
06F8                             ;              last time). Generic: what is typed, or pasted, from now until
06F8                             ;              ^Z replaces the program; it is not echoed.
06F8                             ;    name ^W   write. CP/M: to that file (no name: the same file as last
06F8                             ;              time). Generic: the text is printed, as it is.
06F8                             ;    ^N        new: no program
06F8                             ;    ^X        leave (to LEAVE)
06F8                             ; 
06F8                             ;  In the line: the left and right arrow keys move the cursor;
06F8                             ;  a character goes in at the cursor; Backspace and DEL take out the one
06F8                             ;  before it; Esc drops the line. Only CR, LF, BS and printing characters are
06F8                             ;  sent to the terminal, so any terminal will do.
06F8                             ; 
06F8                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
06F8                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
06F8                             ;  125 characters; the one character after a line number separates it from
06F8                             ;  the text and is not stored. The text is kept as it is typed, each line
06F8                             ;  ending in CR LF, at PROG.
06F8                             ; 
06F8                             ;  What lasts from one line to the next: the program, the words, the
06F8                             ;  variables and the data stack. An error or a break clears both stacks. The
06F8                             ;  return stack starts empty for every line.
06F8                             ; 
06F8                             ;  Things to know:
06F8                             ;    - Reset empties the program (generic builds).
06F8                             ;    - A word's address points into the program, so run the program again
06F8                             ;      after editing it.
06F8                             ;    - Nothing is printed between a program's output and what is typed next.
06F8                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
06F8                             ;      a line that calls -n? and carries on afterwards runs what was typed.
06F8                             ;      (The stored program never comes back to the line, so it may.)
06F8                             ;    - The editor"s own keys are not the program"s: -n? is the plain line
06F8                             ;      read of the other builds.
06F8                             ; 
06F8                             ;  The data stack is the CPU's stack, so the editor works on top of whatever
06F8                             ;  the last line left there, with TOS pushed like the rest.
06F8                             ; =============================================================================
06F8                          IF   EDGEN   
                    INIT:        ; reset (A = 0)
06F8                          ENDIF      
06F8                          IF   EDGEN*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at 0, and
                                 ; every word cell holds 0000h, the address an undefined word is caught at
                                 ; (see e_hi).
                              LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
06F8                          ENDIF      
06F8                          IF   EDGEN   
                              JR   edit0   
06F8                          ENDIF      
06F8                          IF   EDITOR   
06F8                             ; Right arrow: one to the right, by printing the character there
06F8   7D           RIGHT:    LD   A,L   
06F9   BB                     CP   E   
06FA   28 53                  JR   Z,ed1   ; at the end
06FC   7E                     LD   A,(HL)   
06FD   2C                     INC   L   
06FE   18 2B                  JR   lf1   
0700                             ; Esc: alone it drops the line. An arrow key sends Esc [ and a letter, so
0700                             ; wait about 5 ms for a second key: after a "[" read on to the letter that
0700                             ; ends the sequence, and act on C (right) and D (left).
0700   01 14 00     ESC:      LD   BC,5*MSLOOP   
0703   CD B3 05     ES1:      CALL   rawk   
0706   20 0A                  JR   NZ,es2   
0708   0B                     DEC   BC   
0709   78                     LD   A,B   
070A   B1                     OR   C   
070B   20 F6                  JR   NZ,es1   
070D   CD 7C 07               CALL   fin   ; no second key: the line is dropped
0710   18 28                  JR   edit   
0712   FE 5B        ES2:      CP   "["   
0714   20 39                  JR   NZ,ed1   ; not a sequence known here
0716   CD DB 07     ES3:      CALL   ekey   
0719   FE 40                  CP   40h   
071B   38 F9                  JR   C,es3   ; (its parameters)
071D   D6 43                  SUB   "C"   
071F   28 D7                  JR   Z,right   
0721   3D                     DEC   A   ; "D"?
0722   20 2B                  JR   NZ,ed1   ; no: on into left
0724                             ; Left arrow: the cursor goes one to the left
0724   7D           LEFT:     LD   A,L   
0725   87                     ADD   A,A   
0726   28 27                  JR   Z,ed1   ; (L = 80h: at the start)
0728   2D                     DEC   L   
0729   3E 08                  LD   A,8   
072B                          ;*Macro unroll: lf1:    PUTA
072B                LF1:      DS   1-CPM,0EFh   
072B   CD                     DS   CPM,0CDh   
072C   BB                     DS   CPM,APUT&0FFh   
072D   05                     DS   CPM,APUT/256   
072E   18 1F                  JR   ed1   
0730                             ; edit0: reset, an error or a break: both stacks are cleared, and the cursor
0730                             ;   is shown, in case the program had hidden it and could not show it again.
0730                             ; skend: a program that ended inside skip: its return address goes.
0730                             ; edend: a program that ended: TOS joins the rest of the data stack.
0730   31 FA 0C     EDIT0:    LD   SP,DSTOP-2   ; empty (the cell that stands for TOS is pushed)
0733                          ENDIF      
0733                          IF   EDITOR*ANS   
0733   AF                     XOR   A   ; (pshow wants the carry clear)
0734   CD 7F 03               CALL   pshow   ; ESC [ ? 2 5 h
0737                          ENDIF      
0737                          IF   EDITOR*(1-ANS)   
                              LD   A,1   
                              CALL   CONCUR   ; show the cursor
0737                          ENDIF      
0737                          IF   EDITOR   
0737   21                     DB   21h   ; (LD HL,nn: steps over the next two bytes)
0738   D1           SKEND:    POP   DE   
0739   E5           EDEND:    PUSH   HL   
073A                             ; edit: start a new input line.
073A   FD 21 E0 0B  EDIT:     LD   IY,RSTOP   ; the return stack is empty
073E                          ;*Macro unroll:  SETIX                   ; (a file read or written may have changed IX)
073E   DD                     DS   CPM+FAST-CPM*FAST,0DDh   ; (a file read or written may have changed IX)
073F   21                     DS   CPM+FAST-CPM*FAST,21h   
0740   20                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
0741   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
0742   21 00 00               LD   HL,0   
0745   22 7A 0D               LD   (KEYBUF),HL   ; no key is held, and the break key is on
0748   22 3A 0D               LD   (EDLN),HL   ; no line is being edited
074B   21 80 0D               LD   HL,LINEBUF   ; HL = the cursor,
074E   5D                     LD   E,L   ;   E = the end of the line (its low byte)
074F   CD DB 07     ED1:      CALL   ekey   
0752   FE 7F                  CP   7Fh   
0754   28 38                  JR   Z,bsp   ; DEL
0756   FE 20                  CP   " "   
0758   30 4F                  JR   NC,insc   
075A   FE 09                  CP   9   
075C   28 4B                  JR   Z,insc   ; Tab is text
075E   FE 08                  CP   8   
0760   28 2C                  JR   Z,bsp   
0762   FE 1B                  CP   1Bh   
0764   28 9A                  JR   Z,esc   
0766   E5                     PUSH   HL   ; a command key? Look it up
0767   21 E1 07               LD   HL,cmds   
076A   06 08                  LD   B,NCMD   
076C   BE           ED2:      CP   (HL)   
076D   23                     INC   HL   
076E   28 07                  JR   Z,ed3   
0770   23                     INC   HL   
0771   23                     INC   HL   
0772   10 F8                  DJNZ   ed2   
0774   E1                     POP   HL   
0775   18 D8                  JR   ed1   ; no: the key is ignored
0777   7E           ED3:      LD   A,(HL)   
0778   23                     INC   HL   
0779   66                     LD   H,(HL)   
077A   6F                     LD   L,A   
077B   E3                     EX   (SP),HL   ; the command's address: fin returns to it
077C                             ; fin: end the input line: CR LF and a NUL after it, and a new line on the
077C                             ; terminal. Leaves BC -> the line and HL -> the NUL.
077C   26 0D        FIN:      LD   H,LETPAGE   
077E   6B                     LD   L,E   
077F   36 0D                  LD   (HL),13   
0781   2C                     INC   L   
0782   36 0A                  LD   (HL),10   
0784   2D                     DEC   L   
0785   CD E9 08               CALL   prl   ; (prints the CR LF)
0788   36 00                  LD   (HL),0   
078A   01 80 0D               LD   BC,LINEBUF   
078D   C9                     RET      
078E                             ; Backspace, DEL: the character before the cursor goes. The cursor moves
078E                             ; left, the rest of the line moves down over it, and the last place (now a
078E                             ; space) is printed over along with the rest.
078E   7D           BSP:      LD   A,L   
078F   87                     ADD   A,A   
0790   28 BD                  JR   Z,ed1   ; at the start
0792   2D                     DEC   L   
0793                          ;*Macro unroll:  PUTK    08h             ; backspace
0793                          DS   1-CPM,3Eh   ; backspace
0793                          DS   1-CPM,08h   
0793                          DS   1-CPM,0EFh   
0793   CD                     DS   CPM,0CDh   
0794   B7                     DS   CPM,APTK&0FFh   
0795   05                     DS   CPM,APTK/256   
0796   08                     DS   CPM,08h   
0797   E5                     PUSH   HL   
0798   2C           BS1:      INC   L   
0799   7E                     LD   A,(HL)   
079A   2D                     DEC   L   
079B   77                     LD   (HL),A   
079C   2C                     INC   L   
079D   7D                     LD   A,L   
079E   BB                     CP   E   
079F   20 F7                  JR   NZ,bs1   
07A1   2D                     DEC   L   
07A2   36 20                  LD   (HL)," "   
07A4   E1                     POP   HL   
07A5   53                     LD   D,E   
07A6   1D                     DEC   E   
07A7   18 17                  JR   ic2   
07A9                             ; A character goes in at the cursor: it ripples up through the rest of the
07A9                             ; line, the cursor moves on, and the rest is printed again.
07A9   47           INSC:     LD   B,A   
07AA   7B                     LD   A,E   
07AB   FE FD                  CP   0FDh   
07AD   28 A0                  JR   Z,ed1   ; the line is full: 125 characters
07AF   78                     LD   A,B   
07B0                          ;*Macro unroll:  PUTA
07B0                          DS   1-CPM,0EFh   
07B0   CD                     DS   CPM,0CDh   
07B1   BB                     DS   CPM,APUT&0FFh   
07B2   05                     DS   CPM,APUT/256   
07B3   E5                     PUSH   HL   
07B4   7E           IC1:      LD   A,(HL)   
07B5   70                     LD   (HL),B   
07B6   47                     LD   B,A   
07B7   7D                     LD   A,L   
07B8   2C                     INC   L   
07B9   BB                     CP   E   
07BA   20 F8                  JR   NZ,ic1   
07BC   E1                     POP   HL   
07BD   2C                     INC   L   
07BE   1C                     INC   E   
07BF   53                     LD   D,E   
07C0   CD C5 07     IC2:      CALL   tail   
07C3   18 8A                  JR   ed1   
07C5                             ; tail: print the line from the cursor to D (a low byte), and bring the
07C5                             ; cursor back with backspaces. Nothing at all if the cursor is at D.
07C5   4D           TAIL:     LD   C,L   
07C6   7D           TA1:      LD   A,L   
07C7   BA                     CP   D   
07C8   28 07                  JR   Z,ta2   
07CA   7E                     LD   A,(HL)   
07CB                          ;*Macro unroll:  PUTA
07CB                          DS   1-CPM,0EFh   
07CB   CD                     DS   CPM,0CDh   
07CC   BB                     DS   CPM,APUT&0FFh   
07CD   05                     DS   CPM,APUT/256   
07CE   2C                     INC   L   
07CF   18 F5                  JR   ta1   
07D1   7D           TA2:      LD   A,L   
07D2   B9                     CP   C   
07D3   C8                     RET   Z   
07D4                          ;*Macro unroll:  PUTK    08h             ; backspace
07D4                          DS   1-CPM,3Eh   ; backspace
07D4                          DS   1-CPM,08h   
07D4                          DS   1-CPM,0EFh   
07D4   CD                     DS   CPM,0CDh   
07D5   B7                     DS   CPM,APTK&0FFh   
07D6   05                     DS   CPM,APTK/256   
07D7   08                     DS   CPM,08h   
07D8   2D                     DEC   L   
07D9   18 F6                  JR   ta2   
07DB                             ; ekey: wait for a key
07DB   CD B3 05     EKEY:     CALL   rawk   
07DE   28 FB                  JR   Z,ekey   
07E0   C9                     RET      
07E1                             ; The command keys, and where each goes (after fin).
07E1   0D           CMDS:     DB   13   
07E2   2B 08                  DW   cret   
07E4   07                     DB   7   ; ^G
07E5   73 08                  DW   crun   
07E7   0C                     DB   12   ; ^L
07E8   8F 08                  DW   clist   
07EA   05                     DB   5   ; ^E
07EB   FF 07                  DW   cedln   
07ED   12                     DB   18   ; ^R
07EE   80 09                  DW   cread   
07F0   17                     DB   23   ; ^W
07F1   F4 08                  DW   cwrite   
07F3   0E                     DB   14   ; ^N
07F4   F9 07                  DW   cnew   
07F6   18                     DB   24   ; ^X
07F7   00 00                  DW   LEAVE   
07F9                NCMD:     EQU   8   
07F9                             ; ^N: no program
07F9   AF           CNEW:     XOR   A   
07FA   32 00 0E               LD   (PROG),A   
07FD   18 71        GED0:     JR   gedit   
07FF                             ; ^E: line n goes into the input line, to be changed. EDLN remembers which
07FF                             ; line it was: Return puts the text back in its place.
07FF   CD 01 04     CEDLN:    CALL   rdnum   
0802   E5                     PUSH   HL   
0803   CD D1 08               CALL   find   ; HL -> the line, or the NUL if there is none
0806   D1                     POP   DE   
0807   7E                     LD   A,(HL)   
0808   B7                     OR   A   
0809   28 F2                  JR   Z,ged0   
080B   ED 53 3A 0D            LD   (EDLN),DE   
080F   11 80 0D               LD   DE,LINEBUF   
0812   7E           CE1:      LD   A,(HL)   ; copy it, and show it, up to its CR (or LF)
0813   FE 0D                  CP   13   
0815   28 0F                  JR   Z,ce2   
0817   FE 0A                  CP   10   
0819   28 0B                  JR   Z,ce2   
081B   12                     LD   (DE),A   
081C                          ;*Macro unroll:  PUTA
081C                          DS   1-CPM,0EFh   
081C   CD                     DS   CPM,0CDh   
081D   BB                     DS   CPM,APUT&0FFh   
081E   05                     DS   CPM,APUT/256   
081F   23                     INC   HL   
0820   1C                     INC   E   
0821   7B                     LD   A,E   
0822   FE FD                  CP   0FDh   ; (a longer line is cut at 125 characters)
0824   20 EC                  JR   NZ,ce1   
0826   EB           CE2:      EX   DE,HL   ; the cursor is at the line's end
0827   5D                     LD   E,L   
0828   C3 4F 07               JP   ed1   
082B                             ; Return. If ^E put a line here, the text goes back in its place. If not:
082B                             ; a number and text is a line to put in, a number alone a line to take out,
082B                             ; and anything else is run where it is.
082B   E5           CRET:     PUSH   HL   ; the end of what was typed
082C   2A 3A 0D               LD   HL,(EDLN)   
082F   7C                     LD   A,H   
0830   B5                     OR   L   
0831   28 07                  JR   Z,cr1   
0833   E5                     PUSH   HL   
0834   CD C1 08               CALL   delln   
0837   E1                     POP   HL   
0838   18 13                  JR   ins   
083A   CD 01 04     CR1:      CALL   rdnum   ; HL = the number it starts with, BC -> after
083D   79                     LD   A,C   ; C is still 80h if there was no number:
083E   87                     ADD   A,A   ;   only then is twice it 0
083F   28 36                  JR   Z,st0p   ; no number: run the line
0841   0A                     LD   A,(BC)   
0842   FE 0D                  CP   13   
0844   20 06                  JR   NZ,cr2   
0846   D1                     POP   DE   ; the number alone: take that line out
0847   CD C1 08               CALL   delln   
084A   18 24                  JR   gedit   
084C   03           CR2:      INC   BC   ; step over the one character after the number
084D                             ; Put the text at BC in as line n (in HL): open a gap of its length there,
084D                             ; CR and LF included, and copy it in.
084D   CD D1 08     INS:      CALL   find   ; HL -> where it goes
0850   D1                     POP   DE   ; the end of what was typed
0851   7B                     LD   A,E   
0852   91                     SUB   C   ; A = the length of the text, with its CR LF
0853   C5                     PUSH   BC   ; the text
0854   4F                     LD   C,A   
0855   06 00                  LD   B,0   
0857   C5                     PUSH   BC   ; its length
0858   54                     LD   D,H   
0859   5D                     LD   E,L   ; DE = where it goes
085A   AF                     XOR   A   
085B   4F                     LD   C,A   ; BC = 0: CPIR looks as far as it needs to
085C   ED B1                  CPIR      ; HL -> one past the program's NUL
085E   ED 52                  SBC   HL,DE   ; the number of bytes to move up, NUL included
0860   44                     LD   B,H   
0861   4D                     LD   C,L   
0862   19                     ADD   HL,DE   
0863   2B                     DEC   HL   ; HL -> the NUL
0864   EB                     EX   DE,HL   
0865   E3                     EX   (SP),HL   ; HL = the length; where it goes is kept
0866   E5                     PUSH   HL   
0867   19                     ADD   HL,DE   ; the NUL's new place
0868   EB                     EX   DE,HL   
0869   ED B8                  LDDR      ; move the rest of the program up
086B   C1                     POP   BC   ; the length
086C   D1                     POP   DE   ; where it goes
086D   E1                     POP   HL   ; the text
086E   ED B0                  LDIR      
0870   C3 3A 07     GEDIT:    JP   edit   
0873                             ; ^G: run the program. st0p: run the typed line (BC -> it).
0873   01 00 0E     CRUN:     LD   BC,PROG   
0876   3E                     DB   3Eh   ; (LD A,n: steps over the POP)
0877   E1           ST0P:     POP   HL   ; (the end of what was typed)
0878                             ; st0: start running at BC. The heap starts after the stored program's NUL.
0878   21 00 0E     ST0:      LD   HL,PROG   
087B   AF                     XOR   A   
087C   BE           ST1:      CP   (HL)   
087D   23                     INC   HL   
087E   20 FC                  JR   NZ,st1   
0880   22 7C 0D               LD   (HEAP),HL   
0883                          ENDIF      
0883                          IF   EDITOR*QK   
0883   CD B7 04               CALL   skclr   ; every run starts with an empty skip cache
0886                          ENDIF      
0886                          IF   EDITOR*CHECKED   
0886                          ;*Macro unroll:  NEGH                    ; minus the heap's first address: '_' may not
0886                          DS   1-CPM,0E7h   ; minus the heap"s first address: "_' may not
0886   CD                     DS   CPM,0CDh   
0887   9A                     DS   CPM,ANEG&0FFh   
0888   05                     DS   CPM,ANEG/256   
0889   22 38 0D               LD   (NPEND),HL   ;   release below it
088C                          ENDIF      
088C                          IF   EDITOR   
088C   E1                     POP   HL   ; TOS: the data stack is as the last line left it
088D                          ;*Macro unroll:  NEXT                    ; (its return address is thrown away)
088D                          DS   (1-CPM)*(1-FAST),0F7h   ; (its return address is thrown away)
088D   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
088E   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
088F                             ; ^L: list from line n. DE = the number of the line at HL.
088F   CD 01 04     CLIST:    CALL   rdnum   ; HL = n, or 0 if there was none:
0892   7C                     LD   A,H   
0893   B5                     OR   L   
0894   20 01                  JR   NZ,li0   
0896   2C                     INC   L   ;   then from line 1
0897   E5           LI0:      PUSH   HL   
0898   CD D1 08               CALL   find   
089B   D1                     POP   DE   
089C   7E           LI1:      LD   A,(HL)   
089D   B7                     OR   A   
089E   28 D0                  JR   Z,gedit   ; the end of the text
08A0   CD B3 05               CALL   rawk   
08A3   28 09                  JR   Z,li3   ; no key: carry on
08A5   FE 03                  CP   3   
08A7   C4 DB 07               CALL   NZ,ekey   ; any key but Ctrl-C: wait for one more
08AA   FE 03                  CP   3   
08AC   28 C2                  JR   Z,gedit   ; Ctrl-C, first or second, ends the list
08AE   E5           LI3:      PUSH   HL   
08AF   D5                     PUSH   DE   
08B0   EB                     EX   DE,HL   
08B1   CD 1E 05               CALL   pdec   ; the line's number,
08B4   3E 20                  LD   A," "   
08B6                          ;*Macro unroll:  PUTA                    ;   a space,
08B6                          DS   1-CPM,0EFh   ;   a space,
08B6   CD                     DS   CPM,0CDh   
08B7   BB                     DS   CPM,APUT&0FFh   
08B8   05                     DS   CPM,APUT/256   
08B9   D1                     POP   DE   
08BA   E1                     POP   HL   
08BB   13                     INC   DE   
08BC   CD E9 08               CALL   prl   ;   and the line
08BF   18 DB                  JR   li1   
08C1                             ; delln: take line n (in HL) out: copy everything after it down over it.
08C1   CD D1 08     DELLN:    CALL   find   
08C4   54                     LD   D,H   
08C5   5D                     LD   E,L   
08C6   CD DF 08               CALL   nxl   ; HL -> the next line
08C9   7E           DE1:      LD   A,(HL)   
08CA   12                     LD   (DE),A   
08CB   23                     INC   HL   
08CC   13                     INC   DE   
08CD   B7                     OR   A   
08CE   20 F9                  JR   NZ,de1   
08D0   C9                     RET      
08D1                             ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
08D1                             ; of the text if there are fewer lines (or the number is 0). Keeps BC.
08D1   EB           FIND:     EX   DE,HL   
08D2   21 00 0E               LD   HL,PROG   
08D5   1B           FI1:      DEC   DE   
08D6   7A                     LD   A,D   
08D7   B3                     OR   E   
08D8   C8                     RET   Z   
08D9   CD DF 08               CALL   nxl   
08DC   20 F7                  JR   NZ,fi1   
08DE   C9                     RET      
08DF                             ; nxl: step HL over one line, to just past its LF (and return not-zero), or
08DF                             ; stop at the NUL that ends the text (and return zero).
08DF   7E           NXL:      LD   A,(HL)   
08E0   B7                     OR   A   
08E1   C8                     RET   Z   
08E2   23                     INC   HL   
08E3   FE 0A                  CP   10   
08E5   20 F8                  JR   NZ,nxl   
08E7   B7                     OR   A   
08E8   C9                     RET      
08E9                             ; prl: print the line at HL, to its LF; HL -> just past it.
08E9   7E           PRL:      LD   A,(HL)   
08EA                          ;*Macro unroll:  PUTA
08EA                          DS   1-CPM,0EFh   
08EA   CD                     DS   CPM,0CDh   
08EB   BB                     DS   CPM,APUT&0FFh   
08EC   05                     DS   CPM,APUT/256   
08ED   7E                     LD   A,(HL)   
08EE   23                     INC   HL   
08EF   FE 0A                  CP   10   
08F1   20 F6                  JR   NZ,prl   
08F3   C9                     RET      
08F4                          ENDIF      
08F4                          IF   EDGEN   
                    GED1:     JP   edit   
                                 ; ^R, generic: what comes in from now until ^Z is the program. A CR is
                                 ; stored as CR LF; a LF right after a line end is dropped (it is the CR's
                                 ; own, or an empty line's), and a LF anywhere else ends a line too. A last
                                 ; line with no end is given one. Nothing is echoed, and there is no check
                                 ; for running out of memory.
                    CREAD:    LD   HL,PROG-1   
                              LD   (HL),10   ; (as if a line had just ended: the byte is
                              INC   HL   ;   the line buffer's last, and spare)
                    RD1:      CALL   ekey   
                              LD   C,A   
                              CP   1Ah   
                              JR   NZ,rd2   
                              LD   A,10   ; ^Z ends the last line, as a LF would
                    RD2:      CP   10   
                              JR   NZ,rd3   
                              DEC   HL   
                              CP   (HL)   
                              INC   HL   
                              JR   Z,rd4   ; straight after a line end: dropped
                              LD   A,13   ; anywhere else it ends the line
                    RD3:      LD   (HL),A   
                              INC   HL   
                              CP   13   
                              JR   NZ,rd4   
                              LD   (HL),10   ; after a CR goes a LF
                              INC   HL   
                    RD4:      LD   A,C   
                              CP   1Ah   
                              JR   NZ,rd1   
                              LD   (HL),0   
                              JR   ged1   
                                 ; ^W, generic: the text is printed as it is, for the terminal to capture.
                    CWRITE:   LD   HL,PROG   
                    CW1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,ged1   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              INC   HL   
                              JR   cw1   
08F4                          ENDIF      
08F4                          IF   EDITOR*CPM   
08F4                CFCB:     EQU   005Ch   ; the file's name is kept here, where the CCP
08F4                             ;   put the one from the command line
08F4                             ; ^W, CP/M: write the file: delete the old one, make it anew, write the
08F4                             ; text in records of 128 bytes, and close it. The text's NUL and the 127
08F4                             ; bytes after it are set to ^Z meanwhile, which pads the last record. (A
08F4                             ; full disk or directory is not noticed: the calls fail and that is all.)
08F4   CD 41 09     CWRITE:   CALL   setname   
08F7   0E 13                  LD   C,19   ; delete
08F9   CD 7A 09               CALL   fbdos   
08FC   0E 16                  LD   C,22   ; make
08FE   CD 7A 09               CALL   fbdos   
0901   21 00 0E               LD   HL,PROG   
0904   AF                     XOR   A   
0905   BE           CW1:      CP   (HL)   
0906   23                     INC   HL   
0907   20 FC                  JR   NZ,cw1   
0909   2B                     DEC   HL   ; HL -> the NUL
090A   E5                     PUSH   HL   
090B   06 80                  LD   B,128   
090D   36 1A        CW2:      LD   (HL),1Ah   
090F   23                     INC   HL   
0910   10 FB                  DJNZ   cw2   
0912   E1                     POP   HL   
0913   11 00 0E               LD   DE,PROG   
0916   7B           CW3:      LD   A,E   ; a record that starts before the end is written
0917   95                     SUB   L   
0918   7A                     LD   A,D   
0919   9C                     SBC   A,H   
091A   30 09                  JR   NC,cw4   
091C   E5                     PUSH   HL   
091D   0E 15                  LD   C,21   ; write, from where the record lies
091F   CD 2F 09               CALL   frec   
0922   E1                     POP   HL   
0923   18 F1                  JR   cw3   
0925   36 00        CW4:      LD   (HL),0   ; the NUL again
0927   0E 10                  LD   C,16   ; close
0929   CD 7A 09               CALL   fbdos   
092C   C3 3A 07               JP   edit   
092F                             ; frec: BDOS function C (read or write a record) with the 128 bytes at DE.
092F                             ; Returns A = the BDOS's answer, HL = DE and DE = DE + 128.
092F   D5           FREC:     PUSH   DE   
0930   C5                     PUSH   BC   
0931   0E 1A                  LD   C,26   ; set the DMA address
0933   CD 05 00               CALL   BDOS   
0936   C1                     POP   BC   
0937   CD 7A 09               CALL   fbdos   
093A   D1                     POP   DE   
093B   21 80 00               LD   HL,128   
093E   19                     ADD   HL,DE   
093F   EB                     EX   DE,HL   
0940   C9                     RET      
0941                             ; setname: if a name was typed (the line does not start with its CR), put it
0941                             ; in the FCB: up to 8 characters, a dot, up to 3 more, in capitals. The drive
0941                             ; is the current one. Then, name or no name, clear the FCB after the name,
0941                             ; as it must be before a file is opened or made.
0941   11 80 0D     SETNAME:   LD   DE,LINEBUF   
0944   1A                     LD   A,(DE)   
0945   FE 0D                  CP   13   
0947   28 26                  JR   Z,fcbclr   
0949   21 5C 00               LD   HL,CFCB   
094C   36 00                  LD   (HL),0   ; the current drive
094E   06 0B                  LD   B,11   
0950   2C           SN1:      INC   L   
0951   36 20                  LD   (HL)," "   
0953   10 FB                  DJNZ   sn1   
0955   2E 5D                  LD   L,CFCB+1   
0957   1A           SN2:      LD   A,(DE)   
0958   13                     INC   DE   
0959   FE 0D                  CP   13   
095B   28 12                  JR   Z,fcbclr   
095D   FE 2E                  CP   "."   
095F   20 04                  JR   NZ,sn3   
0961   2E 65                  LD   L,CFCB+9   ; the type
0963   18 F2                  JR   sn2   
0965   FE 61        SN3:      CP   "a"   
0967   38 02                  JR   C,sn4   
0969   E6 5F                  AND   5Fh   ; a capital
096B   77           SN4:      LD   (HL),A   
096C   2C                     INC   L   
096D   18 E8                  JR   sn2   
096F   21 68 00     FCBCLR:   LD   HL,CFCB+12   
0972   06 18                  LD   B,24   
0974   36 00        FC1:      LD   (HL),0   
0976   23                     INC   HL   
0977   10 FB                  DJNZ   fc1   
0979   C9                     RET      
097A                             ; fbdos: BDOS function C on the file
097A   11 5C 00     FBDOS:    LD   DE,CFCB   
097D   C3 05 00               JP   BDOS   
0980                             ; ^R, CP/M: read the file. A name typed before the key is the file's name
0980                             ; from now on. (On into load, which returns to edit.)
0980   CD 41 09     CREAD:    CALL   setname   
0983   21 3A 07               LD   HL,edit   
0986   E5                     PUSH   HL   
0987                             ; load: read the file into PROG. No such file: no program. The text ends at
0987                             ; the file"s first ^Z (1Ah), which pads a text file"s last record; one more
0987                             ; goes after the last record, so the search always stops. And every line
0987                             ; must end in LF: a last line without one is given a CR LF. (The FCB is
0987                             ; clear after its name: the CCP left it so, or setname did.)
0987   0E 0F        LOAD:     LD   C,15   ; open (no such file: the first read fails
0989   CD 7A 09               CALL   fbdos   ;   too)
098C   11 00 0E               LD   DE,PROG   
098F   0E 14        LD1:      LD   C,20   ; read the next 128 bytes
0991   CD 2F 09               CALL   frec   
0994   B7                     OR   A   
0995   28 F8                  JR   Z,ld1   
0997   36 1A                  LD   (HL),1Ah   ; (HL = where the record that failed would be)
0999   21 FF 0D               LD   HL,PROG-1   
099C   3E 0A                  LD   A,10   ; (a file with no text needs nothing added)
099E   23           TR1:      INC   HL   
099F   5F                     LD   E,A   ; E = the character before this one
09A0   7E                     LD   A,(HL)   
09A1   FE 1A                  CP   1Ah   
09A3   20 F9                  JR   NZ,tr1   
09A5   7B                     LD   A,E   
09A6   FE 0A                  CP   10   
09A8   28 06                  JR   Z,tr2   
09AA   36 0D                  LD   (HL),13   
09AC   23                     INC   HL   
09AD   36 0A                  LD   (HL),10   
09AF   23                     INC   HL   
09B0   36 00        TR2:      LD   (HL),0   
09B2   C9                     RET      
09B3                          ENDIF      
09B3                             ; =============================================================================
09B3                          IF   CPM   
09B3                             ; The RAM pages follow the image; the heap may grow to the BDOS.
09B3                START:       
09B3                          ENDIF      
09B3                          IF   CPM*CHECKED*(1-EDITOR)   
                                 ; Clear the lower half of the letter page (as the editor build does
                                 ; at its start).
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
09B3                          ENDIF      
09B3                          IF   CPM*(1-EDITOR)   
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:      LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
09B3                          ENDIF      
09B3                          IF   CPM*(1-EDITOR)*QK   
                              CALL   skclr   ; an empty skip cache
09B3                          ENDIF      
09B3                          IF   CPM*(1-EDITOR)   
                              JP   st2   
09B3                          ENDIF      
09B3                          IF   FAST   
                                 ; =============================================================================
                                 ;  The fast build (SPEED = 2)
                                 ; 
                                 ;  The inner loop is a table: 256 entries, the low bytes of the handlers'
                                 ;  addresses in one page and the high bytes in the next. The dispatcher (at
                                 ;  next0, and inline, as NEXTF, at the end of the fast build's own entries,
                                 ;  so there is no jump back to it; the ordinary handlers end in JP (IX), with
                                 ;  IX = next0, as in the CP/M builds):
                                 ; 
                                 ;      LD A,(BC) / INC BC / EX DE,HL / LD L,A / LD H,DTAB/256 /
                                 ;      LD A,(HL) / INC H / LD H,(HL) / LD L,A / JP (HL)
                                 ; 
                                 ;  So every entry starts with TOS in DE, not HL. The punctuation entries are
                                 ;  thunks into the ordinary handlers (EX DE,HL / JP handler); the letters and
                                 ;  digits have one entry each, which knows its cell or its value already.
                                 ; =============================================================================
                    FTSTORE:   EX   DE,HL   ; !
                              JP   h_store   
                    FTSTR:    EX   DE,HL   ; "
                              JP   h_str   
                    FTNUM:    EX   DE,HL   ; #
                              JP   h_num   
                    FTPRINT:   EX   DE,HL   ; $
                              JP   h_print   
                    FTSWAP:   EX   DE,HL   ; %
                              JP   h_swap   
                    FTAND:    EX   DE,HL   ; &
                              JP   h_and   
                    FTEMIT:   EX   DE,HL   ; '
                              JP   h_emit   
                    FTOPEN:   EX   DE,HL   ; (
                              JP   h_open   
                    FTCLOSE:   EX   DE,HL   ; )
                              JP   h_close   
                    FTMUL:    EX   DE,HL   ; *
                              JP   h_mul   
                    FTADD:    EX   DE,HL   ; +
                              JP   h_add   
                    FTCFETCH:   EX   DE,HL   ; ,
                              JP   h_cfetch   
                    FTSUB:    EX   DE,HL   ; -
                              JP   h_sub   
                    FTCSTORE:   EX   DE,HL   ; .
                              JP   h_cstore   
                    FTDIV:    EX   DE,HL   ; /
                              JP   h_div   
                    FTDUP:    EX   DE,HL   ; :
                              JP   h_dup   
                    FTDROP:   EX   DE,HL   ; ;
                              JP   h_drop   
                    FTLT:     EX   DE,HL   ; <
                              JP   h_lt   
                    FTEQ:     EX   DE,HL   ; =
                              JP   h_eq   
                    FTGT:     EX   DE,HL   ; >
                              JP   h_gt   
                    FTKEY:    EX   DE,HL   ; ?
                              JP   h_key   
                    FTFETCH:   EX   DE,HL   ; @
                              JP   h_fetch   
                    FTDEF:    EX   DE,HL   ; [
                              JP   h_def   
                    FTBREAK:   EX   DE,HL   ; \
                              JP   h_break   
                    FTRET:    EX   DE,HL   ; ]
                              JP   h_ret   
                    FTXOR:    EX   DE,HL   ; ^
                              JP   h_xor   
                    FTALLOC:   EX   DE,HL   ; _
                              JP   h_alloc   
                    FTGRAVE:   EX   DE,HL   ; `
                              JP   h_grave   
                    FTTOR:    EX   DE,HL   ; {
                              JP   h_tor   
                    FTOR:     EX   DE,HL   ; |
                              JP   h_or   
                    FTFROMR:   EX   DE,HL   ; }
                              JP   h_fromr   
                    FTNOT:    EX   DE,HL   ; ~
                              JP   h_not   
                                 ; The commonest punctuation, written for the fast build: TOS in DE on the
                                 ; way in, and the dispatcher inline on the way out.
                    FS_ADD:      ; +
                              POP   HL   
                              ADD   HL,DE   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_SUB:      ; -
                              LD   A,(BC)   ; a digit next: a negative number
                              SUB   "0"   
                              CP   10   
                              JR   C,fs_neg   
                              POP   HL   
                              OR   A   
                              SBC   HL,DE   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_NEG:   EX   DE,HL   
                              JP   h_sub   
                    FS_DUP:      ; :
                              PUSH   DE   
                              EX   DE,HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_DROP:      ; ;
                              POP   HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_SWAP:      ; %
                              POP   HL   
                              PUSH   DE   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_FET:      ; @
                              EX   DE,HL   
                              LD   E,(HL)   
                              INC   HL   
                              LD   D,(HL)   
                              EX   DE,HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_CFET:      ; ,
                              LD   A,(DE)   
                              LD   L,A   
                              LD   H,0   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_LT:       ; <
                              POP   HL   ; a < b: HL = a, DE = b
                    FS_LT1:   LD   A,H   
                              XOR   80h   
                              LD   H,A   
                              LD   A,D   
                              XOR   80h   
                              LD   D,A   
                              SBC   HL,DE   ; carry if HL < DE
                              SBC   HL,HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_GT:       ; >
                              POP   HL   ; a > b  is  b < a
                              EX   DE,HL   
                              JP   fs_lt1   
                    FS_EQ:       ; =
                              POP   HL   
                              OR   A   
                              SBC   HL,DE   
                              LD   A,H   
                              OR   L   
                              CP   1   ; carry only if a - b = 0
                              SBC   HL,HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_AND:      ; &
                              POP   HL   
                              LD   A,H   
                              AND   D   
                              LD   H,A   
                              LD   A,L   
                              AND   E   
                              LD   L,A   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_OR:       ; |
                              POP   HL   
                              LD   A,H   
                              OR   D   
                              LD   H,A   
                              LD   A,L   
                              OR   E   
                              LD   L,A   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_XOR:      ; ^
                              POP   HL   
                              LD   A,H   
                              XOR   D   
                              LD   H,A   
                              LD   A,L   
                              XOR   E   
                              LD   L,A   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_NOT:      ; ~
                              LD   A,E   
                              CPL      
                              LD   L,A   
                              LD   A,D   
                              CPL      
                              LD   H,A   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_MUL:      ; *
                              POP   HL   ; (the two the other way round: the same)
                              JP   mulq   
                    FS_OPEN:      ; (
                              LD   A,D   
                              OR   E   
                              POP   HL   
                              JR   Z,fs_op0   
                              PUSH   BC   ; the block start
                              JP   rpushn   
                    FS_OP0:   CALL   skip   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_CLOSE:      ; )
                              LD   A,D   
                              OR   E   
                              POP   HL   
                              JR   Z,fs_cl0   
                              LD   C,(IY+0)   ; the block start, read where it is
                              LD   B,(IY+1)   
                              PUSH   HL   
                              LD   HL,PCNT   
                              DEC   (HL)   
                              POP   HL   
                              CALL   Z,pollk   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                              ;*Macro unroll: fs_cl0: POPR
                    FS_CL0:   DS   1-CPM,0CFh   
                              DS   CPM,0CDh   
                              DS   CPM,AROP&0FFh   
                              DS   CPM,AROP/256   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_RET:   EX   DE,HL   ; ]
                              LD   C,(IY+0)   
                              LD   B,(IY+1)   
                              INC   IY   
                              INC   IY   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FD0:      EX   DE,HL   ; 0
                              PUSH   HL   
                              LD   HL,0   
                              LD   A,(BC)   
                              SUB   "0"   
                              CP   10   
                              JP   C,fdm   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FD1:      EX   DE,HL   ; 1
                              PUSH   HL   
                              LD   HL,1   
                              LD   A,(BC)   
                              SUB   "0"   
                              CP   10   
                              JP   C,fdm   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FD2:      EX   DE,HL   ; 2
                              PUSH   HL   
                              LD   HL,2   
                              LD   A,(BC)   
                              SUB   "0"   
                              CP   10   
                              JP   C,fdm   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FD3:      EX   DE,HL   ; 3
                              PUSH   HL   
                              LD   HL,3   
                              LD   A,(BC)   
                              SUB   "0"   
                              CP   10   
                              JP   C,fdm   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FD4:      EX   DE,HL   ; 4
                              PUSH   HL   
                              LD   HL,4   
                              LD   A,(BC)   
                              SUB   "0"   
                              CP   10   
                              JP   C,fdm   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FD5:      EX   DE,HL   ; 5
                              PUSH   HL   
                              LD   HL,5   
                              LD   A,(BC)   
                              SUB   "0"   
                              CP   10   
                              JP   C,fdm   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FD6:      EX   DE,HL   ; 6
                              PUSH   HL   
                              LD   HL,6   
                              LD   A,(BC)   
                              SUB   "0"   
                              CP   10   
                              JP   C,fdm   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FD7:      EX   DE,HL   ; 7
                              PUSH   HL   
                              LD   HL,7   
                              LD   A,(BC)   
                              SUB   "0"   
                              CP   10   
                              JP   C,fdm   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FD8:      EX   DE,HL   ; 8
                              PUSH   HL   
                              LD   HL,8   
                              LD   A,(BC)   
                              SUB   "0"   
                              CP   10   
                              JP   C,fdm   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
