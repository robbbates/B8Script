0213                          ENDIF      
0213                             ; =============================================================================
0213                             ;  More routines (no handler starts past this point)
0213                             ; =============================================================================
0213                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
0213                             ; Uses A, BC; the caller saves the IP. The dividend shifts up through A:C
0213                             ; while the quotient bits arrive at the bottom of C.
0213   7C           UDIV:     LD   A,H   
0214   4D                     LD   C,L   
0215   21 00 00               LD   HL,0   
0218   06 10                  LD   B,16   
021A   CB 21        UDV1:     SLA   C   
021C   17                     RLA      
021D   ED 6A                  ADC   HL,HL   
021F   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
0221   30 02                  JR   NC,udv2   ;   always fits in 16 bits
0223   19                     ADD   HL,DE   ; too much: put it back, and cancel the
0224   0D                     DEC   C   ;   INC below
0225   0C           UDV2:     INC   C   ; a quotient bit
0226   10 F2                  DJNZ   udv1   
0228   EB                     EX   DE,HL   ; DE = remainder
0229   67                     LD   H,A   
022A   69                     LD   L,C   ; HL = quotient
022B   C9                     RET      
022C                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
022C                             ; non-digit. Values wrap at 16 bits, as the spec says.
022C   21 00 00     RDNUM:    LD   HL,0   
022F   0A           RDN1:     LD   A,(BC)   
0230   D6 30                  SUB   "0"   
0232   FE 0A                  CP   10   
0234   D0                     RET   NC   
0235   03                     INC   BC   
0236   54                     LD   D,H   
0237   5D                     LD   E,L   
0238   29                     ADD   HL,HL   
0239   29                     ADD   HL,HL   
023A   19                     ADD   HL,DE   
023B   29                     ADD   HL,HL   ; HL * 10
023C   5F                     LD   E,A   
023D   16 00                  LD   D,0   
023F   19                     ADD   HL,DE   
0240   18 ED                  JR   rdn1   
0242                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
0242                             ; the next character, so "/"" does not end it. Leaves A = 22h.
0242   03           SS0:      INC   BC   
0243   0A           SKIPSTR:   LD   A,(BC)   
0244   03                     INC   BC   
0245   FE 2F                  CP   "/"   
0247   28 F9                  JR   Z,ss0   
0249   FE 22                  CP   22h   
024B   20 F6                  JR   NZ,skipstr   
024D   C9                     RET      
024E                             ; skip: read past text to the closer at this level, and return A = 0 if it
024E                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
024E                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
024E                             ; no closer; anything else that runs into the NUL had unbalanced brackets
024E                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
024E                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
024E   16 00        SKIP:     LD   D,0   
0250   14           SK3:      INC   D   ; an opener: one deeper
0251   0A           SK1:      LD   A,(BC)   
0252   03                     INC   BC   
0253   B7                     OR   A   
0254   CA 15 00               JP   Z,endprog   
0257   FE 22                  CP   22h   
0259   CC 43 02               CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
025C   D6 28                  SUB   "("   
025E   28 F0                  JR   Z,sk3   
0260   3D                     DEC   A   ; ")"
0261   28 08                  JR   Z,sk4   
0263   D6 32                  SUB   "["-")"   
0265   28 E9                  JR   Z,sk3   
0267   FE 02                  CP   "]"-"["   
0269   20 E6                  JR   NZ,sk1   
026B   15           SK4:      DEC   D   
026C   C8                     RET   Z   ; the closer at this level
026D   18 E2                  JR   sk1   
026F                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
026F                             ; Uses BC.
026F   11 0A 00     PDEC:     LD   DE,10   
0272   CD 13 02               CALL   udiv   ; HL = HL / 10, E = the last digit
0275   7B                     LD   A,E   
0276   F5                     PUSH   AF   
0277   7C                     LD   A,H   
0278   B5                     OR   L   
0279   C4 6F 02               CALL   NZ,pdec   
027C   F1                     POP   AF   
027D   C6 30                  ADD   A,"0"   
027F   EF                     RST   28h   
0280   C9                     RET      
0281                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
0281                             ; and return its value in A with the carry set; otherwise leave the IP and
0281                             ; return with the carry clear.
0281   0A           HEXC:     LD   A,(BC)   
0282   D6 30                  SUB   "0"   
0284   FE 0A                  CP   10   
0286   38 09                  JR   C,hc1   
0288   E6 DF                  AND   0DFh   
028A   D6 11                  SUB   11h   
028C   FE 06                  CP   6   
028E   D0                     RET   NC   
028F   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
0291   03           HC1:      INC   BC   
0292   C9                     RET      
0293                             ; =============================================================================
0293                             ;  Dispatch table: the low byte of each handler's address, in code order
0293                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
0293                             ;  It must not cross a page (the dispatcher only adds to its low byte).
0293                             ; =============================================================================
0293                             ; The handlers of the first NPG1 characters start in the image's second page.
0293                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
0293                             ; differs between the builds, so the count is worked out here.
0293                             ; (One division to a line: asm80 only rounds down when it stores a value.)
0293                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
0293                PGBRK:    EQU   (h_break-BASE)/256   
0293                PGDEF:    EQU   (h_def-BASE)/256   
0293                PGFET:    EQU   (h_fetch-BASE)/256   
0293                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
0293                          IF   1-EDITOR   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0293                          ENDIF      
0293                             ; =============================================================================
0293                             ;  Console layer: getk returns a waiting key in A (zero flag clear), or
0293                             ;  A = 0 with the zero flag set when none is waiting. putc (RST 28h) prints
0293                             ;  A. Both keep BC, DE, HL and HL". In the generic build they are the host"s
0293                             ;  KEY and CONOUT routines themselves.
0293                             ; =============================================================================
0293                          IF   (1-CPM)*(1-CHECKED)   
0293                GETK:     EQU   KEY   ; the host's routine does the whole job
0293                          ENDIF      
0293                          IF   CHECKED   
                    GETK:     PUSH   HL   ; a key held back by the break check goes
                              LD   HL,KEYBUF   ;   first, and is taken out of the buffer
                              LD   A,(HL)   
                              LD   (HL),0   
                              POP   HL   
                              OR   A   
                              RET   NZ   
0293                          ENDIF      
0293                          IF   (1-CPM)*CHECKED   
                              JP   KEY   
0293                          ENDIF      
0293                          IF   CPM*(1-CHECKED)   
                    GETK:        
0293                          ENDIF      
0293                          IF   CPM   
                              LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
                                 ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
                                 ; printing and could swallow a key that BDOS 6 then never sees.
                    PUTC:     PUSH   DE   
                              PUSH   HL   
                              LD   E,A   
                              LD   A,6   
                              CALL   bdosx   
                              POP   HL   
                              POP   DE   
                              OR   A   ; (for getk)
                              RET      
                                 ; bdosx: call BDOS function A with DE, keeping BC and HL'
                    BDOSX:    PUSH   BC   
                              EXX      
                              PUSH   HL   
                              EXX      
                              LD   C,A   
                              CALL   BDOS   
                              EXX      
                              POP   HL   
                              EXX      
                              POP   BC   
                              RET      
0293                          ENDIF      
0293                             ; =============================================================================
0293                             ;  Checked build: the checks and the error report
0293                             ; =============================================================================
0293                          IF   CHECKED   
                                 ; chkstk: both stacks are checked once per character, not in every handler.
                                 ; Each stack lives in one page, so it has overrun exactly when the pointer's
                                 ; high byte has left that page. Errors are caught one cell late at most; the
                                 ; page below each stack is a guard band. (The call itself is on the data
                                 ; stack, but in the same page whenever the stack is in range.)
                    CHKSTK:   LD   (SPTMP),SP   
                              LD   A,(SPTMP+1)   
                              CP   DSPAGE   
                              JR   NZ,e_stack   
                              EXX      ; the return stack: in its page, and not
                              LD   A,L   ;   above its empty position (an underflow
                              CP   RSTOP&0FFh+1   ;   would stay inside the page, in the
                              LD   A,H   ;   guard band)
                              EXX      
                              JR   NC,e_rstack   
                              CP   RSPAGE   
                              RET   Z   
                              JR   e_rstack   
                                 ; chkbrk: a waiting key is read now; Ctrl-C stops the program, anything
                                 ; else is held for the next "?".
                    CHKBRK:   CALL   getk   
                              RET   Z   
                              CP   3   
                              JR   Z,e_break   
                              LD   (KEYBUF),A   
                              RET      
                                 ; chkst: stop unless HL is in the program's own space: from the letter page
                                 ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
                                 ; whatever lies above the limit are safe. Memory above the heap top but
                                 ; below the limit is the program's own: Tiny BASIC keeps its lines there.
                                 ; Keeps every register.
                    CHKST:    PUSH   AF   
                              LD   A,H   
                              CP   LETPAGE   
                              JR   C,e_store   
0293                          ENDIF      
0293                          IF   CHECKED*(1-CPM)   
                              CP   HEAPLIM   
                              JR   NC,e_store   
0293                          ENDIF      
0293                          IF   CHECKED*CPM   
                              LD   A,(0007h)   ; the BDOS page is the heap limit
                              DEC   A   
                              CP   H   
                              JR   C,e_store   
0293                          ENDIF      
0293                          IF   CHECKED   
                              POP   AF   
                              RET      
                                 ; chkhp: stop if working out the new heap top carried (a negative count
                                 ; wraps: too big), or if the new top in HL is not below the limit page.
                    CHKHP:    JR   C,e_heap   
0293                          ENDIF      
0293                          IF   CHECKED*(1-CPM)   
                              LD   A,H   
                              CP   HEAPLIM   
                              RET   C   
0293                          ENDIF      
0293                          IF   CHECKED*CPM   
                              LD   A,(0007h)   
                              DEC   A   
                              CP   H   
                              RET   NC   
0293                          ENDIF      
0293                          IF   CHECKED   
                                 ; Error entries. Each loads its letter and then hides the next entry inside
                                 ; a 3-byte LD HL,nn (the 21h), so they all fall through to `error`.
                    E_HEAP:   LD   A,"H"   ; heap past the limit
                              DB   21h   
                    E_STORE:   LD   A,"W"   ; write outside the program's space
                              DB   21h   
                    E_STACK:   LD   A,"S"   ; data stack over or under
                              DB   21h   
                    E_RSTACK:   LD   A,"R"   ; return stack over or under
                              DB   21h   
                    E_BREAK:   LD   A,"B"   ; Ctrl-C
                              DB   21h   
                    E_BRACK:   LD   A,"D"   ; bad character after [
                                 ; error: print the letter in A, " @ " and the offset in the program of the
                                 ; character just read, then end. For example: S @ 245
                    ERROR:    LD   SP,DSTOP   ; the stacks may be wrecked: start clean
                              RST   28h   
                              LD   A," "   
                              RST   28h   
                              LD   A,"@"   
                              RST   28h   
                              LD   A," "   
                              RST   28h   
                              LD   HL,(0-PROG-1)&0FFFFh   ; minus the address of the character
                              ADD   HL,BC   ;   just read: HL = its offset
                              CALL   pdec   
                              JP   endprog   
0293                          ENDIF      
0293                             ; =============================================================================
0293                             ;  The line editor (EDITOR = 1)
0293                             ; 
0293                             ;  The interpreter starts here, and a program that ends comes back here. Type
0293                             ;  a line and press Return:
0293                             ; 
0293                             ;    n text    put the text in as line n; the lines from n on move down.
0293                             ;              A number past the end adds the line at the end.
0293                             ;    n         take line n out
0293                             ;    0         list the program
0293                             ;    anything that does not start with a digit is run at once, as B8Script
0293                             ; 
0293                             ;  To run the program, jump to it from such a line:  33536{]   (33536 is
0293                             ;  PROG, 8300h). Lines are counted, not numbered: there are no line numbers in
0293                             ;  the text. Line numbers go from 1 to 128, a line holds 125 characters, and
0293                             ;  nothing is checked. The text is stored as it is typed, each line ending in
0293                             ;  CR LF, at PROG; the space after the line number is stored too.
0293                             ; 
0293                             ;  A line is put in one character at a time, each one rippling the rest of
0293                             ;  the program up by a byte: small code, but slow in a long program.
0293                             ; 
0293                             ;  Things to know:
0293                             ;    - Reset empties the program.
0293                             ;    - The list shows no line numbers and only the first 128 lines. A line
0293                             ;      number above 128 lists part of the program on its way to the line.
0293                             ;    - Words and variables last from one line to the next. A word's address
0293                             ;      points into the program, so run the program again after editing it.
0293                             ;    - Nothing is printed between a program's output and what is typed next.
0293                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
0293                             ;      a line that calls -n? and carries on afterwards runs what was typed.
0293                             ;      (A program started with {] never comes back to the line, so it may.)
0293                             ; =============================================================================
0293                          IF   EDITOR   
0293                             ; a line number came first: L = the number, BC -> what follows it
0293   55           ED1:      LD   D,L   ; D counts down to the line wanted. From 0 it
0294   21 00 83               LD   HL,PROG   ;   wraps to FFh: bit 7 of D makes nxl list.
0297   15           F1:       DEC   D   
0298   28 06                  JR   Z,found   
029A   CD F0 02               CALL   nxl   ; step over one line
029D   B7                     OR   A   
029E   20 F7                  JR   NZ,f1   ; (A = 0: that was the end of the text)
02A0   0A           FOUND:    LD   A,(BC)   ; HL -> line n, or the end of the text
02A1   FE 0D                  CP   13   
02A3   28 13                  JR   Z,del   ; nothing after the number: take the line out
02A5                             ; Put the typed text in at HL: CR, LF and all, up to the NUL after them.
02A5   0A           INS:      LD   A,(BC)   
02A6   03                     INC   BC   
02A7   B7                     OR   A   
02A8   28 1A                  JR   Z,edit   
02AA   E5                     PUSH   HL   
02AB   57                     LD   D,A   ; D = the byte to put down
02AC   7E           IN1:      LD   A,(HL)   ; pick up the byte that was there,
02AD   72                     LD   (HL),D   ;   put ours down,
02AE   23                     INC   HL   
02AF   57                     LD   D,A   ;   and carry the old one on,
02B0   B7                     OR   A   
02B1   20 F9                  JR   NZ,in1   ;   until the NUL has been moved
02B3   77                     LD   (HL),A   ; the new NUL
02B4   E1                     POP   HL   
02B5   23                     INC   HL   
02B6   18 ED                  JR   ins   
02B8                             ; Take the line at HL out: copy everything after it down over it.
02B8   E5           DEL:      PUSH   HL   
02B9   CD F0 02               CALL   nxl   ; HL -> the next line (D is 0 here: no listing)
02BC   D1                     POP   DE   
02BD   7E           DE1:      LD   A,(HL)   
02BE   12                     LD   (DE),A   
02BF   23                     INC   HL   
02C0   13                     INC   DE   
02C1   B7                     OR   A   
02C2   20 F9                  JR   NZ,de1   ; and fall into the editor
02C4   31 FE 81     EDIT:     LD   SP,DSTOP   
02C7   2E 83                  LD   L,83h   ; (minus 125)
02C9   CD EB 01               CALL   rdline   ; HL -> the CR that ended the line
02CC   2C                     INC   L   
02CD   36 0A                  LD   (HL),10   ; a LF after it,
02CF   2D                     DEC   L   ; (D is FDh after rdline: bit 7 is set, so
02D0   CD F0 02               CALL   nxl   ;   nxl echoes the CR LF as a new line)
02D3   36 00                  LD   (HL),0   ;   and a NUL after that
02D5   01 80 82               LD   BC,LINEBUF   
02D8   CD 2C 02               CALL   rdnum   ; HL = the number it starts with, BC -> after
02DB   79                     LD   A,C   ; C is still 80h if there was no number:
02DC   87                     ADD   A,A   ;   only then is twice it 0
02DD   20 B4                  JR   NZ,ed1   ; there was a number
02DF                             ; No number: run the line where it is (BC = LINEBUF).
02DF                             ; st0: start running at BC. The heap starts after the stored program's NUL.
02DF   21 00 83     ST0:      LD   HL,PROG   
02E2   AF                     XOR   A   
02E3   BE           ST1:      CP   (HL)   
02E4   23                     INC   HL   
02E5   20 FC                  JR   NZ,st1   
02E7   22 7C 82               LD   (HEAP),HL   
02EA   D9                     EXX      
02EB   21 E0 80               LD   HL,RSTOP   ; the return stack is empty
02EE   D9                     EXX      
02EF   F7                     RST   30h   ; (its return address is thrown away)
02F0                             ; nxl: step HL over one line, to just past its LF, and return A = 10; or stop
02F0                             ; at the NUL that ends the text and return A = 0. If bit 7 of D is set, print
02F0                             ; the line on the way.
02F0   7E           NXL:      LD   A,(HL)   
02F1   B7                     OR   A   
02F2   C8                     RET   Z   
02F3   CB 7A                  BIT   7,D   
02F5   28 01                  JR   Z,nx2   
02F7   EF                     RST   28h   
02F8   7E           NX2:      LD   A,(HL)   
02F9   23                     INC   HL   
02FA   FE 0A                  CP   10   
02FC   20 F2                  JR   NZ,nxl   
02FE   C9                     RET      
02FF                          ENDIF      
02FF                             ; =============================================================================
02FF                             ;  CP/M startup (the generic build starts at address 0: see st0)
02FF                             ; =============================================================================
02FF                          IF   CPM   
                                 ; The RAM pages follow the image; the heap may grow to the BDOS.
                    START:    LD   HL,vecs   ; the RST routines go down into page zero
                              LD   DE,0008h   
                              LD   BC,vecend-vecs   
                              LDIR      
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:      LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
                              JP   st2   
02FF                          ENDIF      
02FF                          IF   CPM   
                                 ; RAM pages, after the image
                    RSPAGE:   EQU   (imgend + 255) / 256   
                    DSPAGE:   EQU   RSPAGE + 1   
                    LETPAGE:   EQU   RSPAGE + 2   
                    PROG:     EQU   LETPAGE*256 + 256   
02FF                          ENDIF      
02FF                IMGEND:      


