033B                             ; the screen. `_: ESC [ K clears to the end of the line.
033B   CD 7C 03     G_CLS:    CALL   csi   
033E   3E 48                  MVI   A,"H"   
0340   EF                     RST   5   
0341   3E 4A                  MVI   A,"J"   
0343   11                     DB   11h   ; (LXI D: steps over the two bytes of g_eol)
0344   3E 4B        G_EOL:    MVI   A,"K"   
0346   5F                     MOV   E,A   
0347   CD 7C 03               CALL   csi   
034A   7B                     MOV   A,E   
034B   EF                     RST   5   
034C   F7                     RST   6   
