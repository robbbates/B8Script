0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Motorola 6809
0000                             ;  Spec: docs/b8script.md (2026-10-09) plus the 2026-11-20 changes:
0000                             ;        [x stores in a variable, "[ " pushes an anonymous block, any other
0000                             ;        character after [ is an error, the heap pointer lives at z10+.
0000                             ;        The string escape is "/" (it was ">").
0000                             ;  Follows the design of the Z80 interpreter (z80/b8s-z80.asm).
0000                             ; 
0000                             ;  Two builds, selected by the CHECKED line below (CPM is always 0: the 6809
0000                             ;  has no CP/M; the line is kept only so that build.sh works):
0000                             ;    CHECKED  0 = no checks (spec: "B8Script checks nothing")
0000                             ;             1 = stops on stack overrun, Ctrl-C, heap past the limit, a store
0000                             ;                 outside the program's own space, and a bad character after [,
0000                             ;                 printing a letter and the place, like  S @ 245
0000                             ; 
0000                             ;  Assembler: asm80, M6809 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   0   ; always 0 (no CP/M on the 6809)
0000                CHECKED:   EQU   1   ; 1 = checked build
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    Y    IP: the address of the next program character to read
0000                             ;    U    the data stack pointer. The stack grows down and U points at the
0000                             ;         top cell (TOS); nothing is cached in a register, because every
0000                             ;         dispatch needs A, B and X as scratch. Cells are big-endian here.
0000                             ;         (Only the stacks are big-endian: cells in RAM that the program can
0000                             ;         see - variables, the heap pointer, anything @ and ! reach - are
0000                             ;         little-endian, as the spec says, so @ and ! swap the bytes.)
0000                             ;    S    the return stack. A word call is a plain push of Y. Entries are
0000                             ;         2 bytes, big-endian. Handlers are called with JSR, so the return
0000                             ;         address of the dispatcher is on top of S while a handler runs.
0000                             ;    DP   the letter page, so the letter-page variables below cost 2-byte
0000                             ;         direct addressing. Nothing else may change DP.
0000                             ;    A B X are scratch. Every handler is entered by JSR [A,X] and ends in RTS
0000                             ;    (one byte); the handlers that push or pop the return stack first throw
0000                             ;    the dispatcher's return address away (LEAS 2,S) and end in BRA next.
0000                             ; -----------------------------------------------------------------------------
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM areas:
0000                             ; 
0000                             ;    8000h-80FFh  return stack, 127 entries; empty = 8100h; S stays inside
0000                             ;    8100h-81FFh  data stack, 127 cells; empty = 8200h; U stays inside
0000                             ;    8200h-82FFh  letter page (LET): A..Z at +00h..+33h, a..z at +40h..+73h
0000                             ;                 (a word cell is always 64 bytes below its variable), the
0000                             ;                 heap pointer at +7Ch (= z10+), interpreter variables in the
0000                             ;                 gaps, and the -n? line buffer at +80h..+FFh
0000                             ;    8300h-       PROG, the program text, NUL-terminated; the heap starts
0000                             ;                 after the NUL and grows to HEAPLIM*256 (F000h)
0000                             ;    F000h-       this image (ROM). The reset vector (FFFEh) must point to
0000                             ;                 `start` (F003h); the image does not contain it.
0000                             ;    FF03h-FF0Bh  the console routines (CONOUT, KEY) and EXIT are supplied
0000                             ;                 by the system and need no space here.
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range LET..HEAPLIM*256.
0000                             ; -----------------------------------------------------------------------------
0000                             ; ---- generic machine: edit these to suit -----------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The Z flag must match A (end the
0000                             ;   routine with TSTA / RTS, or a plain LDA).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                             ;   Both are called with JSR. They may change A and CC and must preserve
0000                             ;   B, X, Y, U and DP.
0000                RSPAGE:   EQU   80h   
0000                DSPAGE:   EQU   81h   
0000                LETPAGE:   EQU   82h   
0000                PROG:     EQU   8300h   ; where the loader puts the program text
0000                HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
0000                MSLOOP:   EQU   20   ; n? inner loop count for about 1 ms; tune it
0000                             ; for your clock and your KEY routine
0000                             ; letter-page layout (direct-page offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   7Ch   ; z10+, the heap pointer (little-endian)
0000                KEYBUF:   EQU   34h   ; gap after Z: a key held back by the break check
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+100h   ; empty return stack
0000                DSTOP:    EQU   DSPAGE*256+100h   ; empty data stack
F000                          .ORG   0F000h   
F000                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
F000                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
F000                             ; the body"s address instead. Either way it then skips to the matching "]'.
F000   A6 A0        H_DEF:    LDA   ,Y+   
F002   1F 89                  TFR   A,B   
F004   C4 DF                  ANDB   #0DFh   ; fold case
F006   C0 41                  SUBB   #"A"   
F008   C1 1A                  CMPB   #26   
F00A   24 0D                  BHS   def2   ; not a letter
F00C   80 41                  SUBA   #"A"   ; 0-25 or 32-57: lowercase lands 64 bytes up
F00E   BD F1 19               JSR   cellx   
F011   1F 20                  TFR   Y,D   
F013   E7 84                  STB   ,X   ; little-endian
F015   A7 01                  STA   1,X   
F017   20 08                  BRA   skip   
F019                DEF2:        
F019                          IF   CHECKED   
F019   81 20                  CMPA   #" "   
F01B   10 26 03 7C            LBNE   e_brack   ; anything but a letter or a space
F01F                          ENDIF      
F01F   36 20                  PSHU   Y   ; an anonymous block: push its address
F021                             ; fall into skip
F021                             ; skip: read past text to the closer at this level, and return it in A.
F021                             ; Brackets of both kinds count together; strings are stepped over whole. A
F021                             ; NUL first ends the program (for "\" with no closer; anything else that runs
F021                             ; into the NUL had unbalanced brackets anyway).
F021   5F           SKIP:     CLRB      ; B = nesting level
F022   A6 A0        SK1:      LDA   ,Y+   
F024   27 6D                  BEQ   fin   
F026   81 22                  CMPA   #22h   
F028   26 04                  BNE   sk2   
F02A   8D 1B                  BSR   skipstr   
F02C   20 F4                  BRA   sk1   
F02E   81 28        SK2:      CMPA   #"("   
F030   27 10                  BEQ   sk3   
F032   81 5B                  CMPA   #"["   
F034   27 0C                  BEQ   sk3   
F036   81 29                  CMPA   #")"   
F038   27 04                  BEQ   sk4   
F03A   81 5D                  CMPA   #"]"   
F03C   26 E4                  BNE   sk1   
F03E   5A           SK4:      DECB      
F03F   2A E1                  BPL   sk1   
F041   39                     RTS      ; the closer at this level
F042   5C           SK3:      INCB      
F043   20 DD                  BRA   sk1   
F045                             ; 22h pushes the address of the text after it and skips the string.
F045   36 20        H_STR:    PSHU   Y   
F047                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
F047                             ; the next character, so "/"" does not end it.
F047   A6 A0        SKIPSTR:   LDA   ,Y+   
F049   81 2F                  CMPA   #"/"   
F04B   26 04                  BNE   ss1   
F04D   31 21                  LEAY   1,Y   
F04F   20 F6                  BRA   skipstr   
F051   81 22        SS1:      CMPA   #22h   
F053   26 F2                  BNE   skipstr   
F055   39                     RTS      
F056                             ; =============================================================================
F056                             ;  Handlers that use the return stack. The dispatcher's return address is on
F056                             ;  top of S when they start; they discard it (LEAS 2,S) and finish with
F056                             ;  BRA next, or leave it and finish with RTS when they don't touch S.
F056                             ; =============================================================================
F056                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
F056                             ; the matching ")".
F056   EC C1        H_OPEN:   LDD   ,U++   
F058   27 C7                  BEQ   skip   ; tail call: skip ends in RTS
F05A   32 62                  LEAS   2,S   
F05C   34 20                  PSHS   Y   
F05E   20 55                  BRA   next   
F060                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
F060                             ; drops it and carries on.
F060   EC C1        H_CLOSE:   LDD   ,U++   
F062   27 07                  BEQ   rdrop   
F064                          IF   CHECKED   
F064   BD F2 F1               JSR   chkbrk   ; Ctrl-C is checked at every loop-back
F067                          ENDIF      
F067   10 AE 62               LDY   2,S   ; the block start, under the return address
F06A   39                     RTS      
F06B   32 64        RDROP:    LEAS   4,S   ; the return address and the block start
F06D   20 46                  BRA   next   
F06F                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
F06F                             ; drops the block start, "]" returns. No closer at all ends the program.
F06F   EC C1        H_BREAK:   LDD   ,U++   
F071   26 01                  BNE   brk1   
F073   39                     RTS      
F074   8D AB        BRK1:     BSR   skip   
F076   81 29                  CMPA   #")"   
F078   27 F1                  BEQ   rdrop   
F07A                             ; fall into "]"
F07A                             ; "]" returns: pop an address and jump to it.
F07A   32 62        H_RET:    LEAS   2,S   
F07C   35 20                  PULS   Y   
F07E                          IF   CHECKED   
F07E   BD F2 F1               JSR   chkbrk   ; ... and at every word return
F081                          ENDIF      
F081   20 32                  BRA   next   
F083                             ; "{" ( n -- ) R: ( -- n )
F083   EC C1        H_TOR:    LDD   ,U++   
F085   32 62                  LEAS   2,S   
F087   34 06                  PSHS   D   
F089   20 2A                  BRA   next   
F08B                             ; "}" ( -- n ) R: ( n -- )
F08B   32 62        H_FROMR:   LEAS   2,S   
F08D   35 06                  PULS   D   
F08F   36 06                  PSHU   D   
F091   20 22                  BRA   next   
F093   7E FF 09     FIN:      JMP   EXIT   ; the program has ended
F096                             ; =============================================================================
F096                             ;  Startup
F096                             ; =============================================================================
F096   10 CE 81 00  START:    LDS   #RSTOP   
F09A   CE 82 00               LDU   #DSTOP   
F09D   86 82                  LDA   #LETPAGE   
F09F   1F 8B                  TFR   A,DP   
F0A1   10 8E 83 00            LDY   #PROG   ; the heap starts after the program's NUL
F0A5   6D A0        SC:       TST   ,Y+   
F0A7   26 FC                  BNE   sc   
F0A9   1F 20                  TFR   Y,D   
F0AB   D7 7C                  STB   <HEAP   
F0AD   97 7D                  STA   <HEAP+1   
F0AF                          IF   CHECKED   
F0AF   0F 34                  CLR   <KEYBUF   
F0B1                          ENDIF      
F0B1   10 8E 83 00            LDY   #PROG   
F0B5                             ; =============================================================================
F0B5                             ;  The inner loop: read one character and sort it by range.
F0B5                             ; 
F0B5                             ;    00h          end of program
F0B5                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
F0B5                             ;    30h-39h      digit: read a whole number
F0B5                             ;    41h-5Ah      A-Z: call the word in that letter's cell
F0B5                             ;    61h-7Ah      a-z: push the address of that letter's cell
F0B5                             ;    the rest     punctuation: JSR through PTAB, 32 entries, in code order
F0B5                             ; =============================================================================
F0B5                NEXT:        
F0B5                          IF   CHECKED   
F0B5                             ; Both stacks are checked once per character, not in every handler.
F0B5                             ; Each stack lives in one page, and "empty" is the first address of
F0B5                             ; the page above, so a stack is in range exactly when the address
F0B5                             ; one below its pointer is in the page (127 entries or cells).
F0B5   30 5F                  LEAX   -1,U   
F0B7   1F 10                  TFR   X,D   
F0B9   81 81                  CMPA   #DSPAGE   
F0BB   10 26 02 CD            LBNE   e_stack   
F0BF   30 7F                  LEAX   -1,S   
F0C1   1F 10                  TFR   X,D   
F0C3   81 80                  CMPA   #RSPAGE   
F0C5   10 26 02 C6            LBNE   e_rstack   
F0C9                          ENDIF      
F0C9   A6 A0                  LDA   ,Y+   
F0CB   27 C6                  BEQ   fin   ; NUL ends the program
F0CD   80 21                  SUBA   #21h   ; A = c - 21h
F0CF   25 E4                  BLO   next   ; 01h-20h ignored
F0D1   81 0F                  CMPA   #0Fh   
F0D3   25 20                  BLO   punct   ; 21h-2Fh: PTAB index 0-14
F0D5   80 0F                  SUBA   #0Fh   ; A = c - 30h
F0D7   81 0A                  CMPA   #0Ah   
F0D9   25 26                  BLO   digit   ; 30h-39h
F0DB   81 11                  CMPA   #11h   
F0DD   25 14                  BLO   p3a   ; 3Ah-40h: index 15-21
F0DF   80 11                  SUBA   #11h   ; A = c - 41h
F0E1   81 1A                  CMPA   #1Ah   
F0E3   25 28                  BLO   upper   ; 41h-5Ah: A = letter index 0-25
F0E5   81 20                  CMPA   #20h   
F0E7   25 14                  BLO   p5b   ; 5Bh-60h: index 22-27
F0E9   81 3A                  CMPA   #3Ah   
F0EB   25 1A                  BLO   lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
F0ED   81 3E                  CMPA   #3Eh   
F0EF   24 C4                  BHS   next   ; 7Fh-FFh: ignored
F0F1   80 23                  SUBA   #23h   ; 7Bh-7Eh: with the ADDA below, index 28-31
F0F3   8B 05        P3A:      ADDA   #5   ; 3Ah-40h: index 15-21
F0F5   48           PUNCT:    ASLA      ; PTAB entries are 2 bytes; A <= 62
F0F6   8E F1 20               LDX   #PTAB   
F0F9   AD 96                  JSR   [A,X]   ; the handler ends in RTS
F0FB   20 B8                  BRA   next   
F0FD   80 04        P5B:      SUBA   #4   
F0FF   20 F4                  BRA   punct   
F101                             ; Digits: step back onto the first digit and read the whole number.
F101   31 3F        DIGIT:    LEAY   -1,Y   
F103   8D 5B                  BSR   rdnum   
F105   20 AE                  BRA   next   
F107                             ; a-z: push the cell's address (the cell is the variable)
F107   8D 10        LOWER:    BSR   cellx   
F109   36 10                  PSHU   X   
F10B   20 A8                  BRA   next   
F10D                             ; A-Z: call the word. The IP (the address after the letter) goes on the
F10D                             ; return stack, and the IP becomes the address in the letter's cell.
F10D   8D 0A        UPPER:    BSR   cellx   
F10F   34 20                  PSHS   Y   
F111   E6 84                  LDB   ,X   
F113   A6 01                  LDA   1,X   
F115   1F 02                  TFR   D,Y   
F117   20 9C                  BRA   next   
F119                             ; cellx: A = letter index (0-25, or 32-57 for lowercase) -> X = cell address
F119   48           CELLX:    ASLA      
F11A   8E 82 00               LDX   #LET   
F11D   30 86                  LEAX   A,X   
F11F   39                     RTS      
F120                             ; =============================================================================
F120                             ;  Dispatch table: one handler per punctuation character, in code order.
F120                             ; =============================================================================
F120   F2 83        PTAB:     FDB   h_store   ; !
F122   F0 45                  FDB   h_str   ; "
F124   F1 E4                  FDB   h_num   ; #
F126   F2 C7                  FDB   h_print   ; $
F128   F2 6D                  FDB   h_swap   ; %
F12A   F2 2D                  FDB   h_and   ; &
F12C   F2 DF                  FDB   h_emit   ; '
F12E   F0 56                  FDB   h_open   ; (
F130   F0 60                  FDB   h_close   ; )
F132   F2 0B                  FDB   h_mul   ; *
F134   F2 27                  FDB   h_add   ; +
F136   F2 7C                  FDB   h_cfetch   ; ,
F138   F1 82                  FDB   h_sub   ; -
F13A   F2 94                  FDB   h_cstore   ; .
F13C   F1 A4                  FDB   h_div   ; /
F13E   F2 68                  FDB   h_dup   ; :
F140   F2 E3                  FDB   drop   ; ;
F142   F2 50                  FDB   h_lt   ; <
F144   F2 5E                  FDB   h_eq   ; =
F146   F2 58                  FDB   h_gt   ; >
F148   F3 05                  FDB   h_key   ; ?
F14A   F2 74                  FDB   h_fetch   ; @
F14C   F0 00                  FDB   h_def   ; [
F14E   F0 6F                  FDB   h_break   ; \
F150   F0 7A                  FDB   h_ret   ; ]
F152   F2 3D                  FDB   h_xor   ; ^
F154   F2 9D                  FDB   h_alloc   ; _
F156   F3 4C                  FDB   h_grave   ; `
F158   F0 83                  FDB   h_tor   ; {
F15A   F2 35                  FDB   h_or   ; |
F15C   F0 8B                  FDB   h_fromr   ; }
F15E   F2 45                  FDB   h_not   ; ~
F160                             ; rdnum: read decimal digits at IP and push the value; IP is left on the
F160                             ; first non-digit. Values wrap at 16 bits, as the spec says. The running
F160                             ; value lives in the new top cell: V = V*10 + digit.
F160   4F           RDNUM:    CLRA      
F161   5F                     CLRB      
F162   36 06                  PSHU   D   
F164   A6 A4        RD1:      LDA   ,Y   
F166   80 30                  SUBA   #"0"   
F168   81 0A                  CMPA   #10   
F16A   24 37                  BHS   ab9   
F16C   31 21                  LEAY   1,Y   
F16E   34 02                  PSHS   A   
F170   EC C4                  LDD   ,U   
F172   58                     ASLB      
F173   49                     ROLA      
F174   58                     ASLB      
F175   49                     ROLA      
F176   E3 C4                  ADDD   ,U   ; 5V
F178   58                     ASLB      
F179   49                     ROLA      ; 10V
F17A   EB E0                  ADDB   ,S+   
F17C   89 00                  ADCA   #0   
F17E   ED C4                  STD   ,U   
F180   20 E2                  BRA   rd1   
F182                             ; =============================================================================
F182                             ;  Arithmetic and logic. Effects are ( NOS TOS -- result ).
F182                             ; =============================================================================
F182                             ; "-" has two jobs: directly before a digit it starts a negative number.
F182   A6 A4        H_SUB:    LDA   ,Y   
F184   80 30                  SUBA   #"0"   
F186   81 0A                  CMPA   #10   
F188   25 0D                  BLO   negnum   
F18A   EC 42                  LDD   2,U   
F18C   A3 C1                  SUBD   ,U++   
F18E   ED C4                  STD   ,U   
F190   39                     RTS      
F191                             ; absx: negate the cell at X if it is negative. negt: negate the top cell.
F191                             ; negx: negate the cell at X.
F191   6D 84        ABSX:     TST   ,X   
F193   2A 0E                  BPL   ab9   
F195   20 04                  BRA   negx   
F197   8D C7        NEGNUM:   BSR   rdnum   ; a negative literal: read it, then negate
F199   1F 31        NEGT:     TFR   U,X   
F19B   EC 84        NEGX:     LDD   ,X   
F19D   40                     NEGA      
F19E   50                     NEGB      
F19F   82 00                  SBCA   #0   
F1A1   ED 84                  STD   ,X   
F1A3   39           AB9:      RTS      
F1A4                             ; "/" ( a b -- r q ): the quotient is on top. Truncates toward zero; r takes
F1A4                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
F1A4                             ; of a. Dividing by zero is not checked: it returns two cells of no meaning.
F1A4   A6 42        H_DIV:    LDA   2,U   
F1A6   34 02                  PSHS   A   ; a's sign: for r
F1A8   A8 C4                  EORA   ,U   
F1AA   34 02                  PSHS   A   ; a xor b: for q
F1AC   30 42                  LEAX   2,U   
F1AE   8D E1                  BSR   absx   ; |a|
F1B0   1F 31                  TFR   U,X   
F1B2   8D DD                  BSR   absx   ; |b|
F1B4   8D 13                  BSR   udiv   ; NOS = q, TOS = r
F1B6   BD F2 6D               JSR   h_swap   ; NOS = r, TOS = q
F1B9   1F 31                  TFR   U,X   
F1BB   6D E0                  TST   ,S+   
F1BD   2A 02                  BPL   dv1   
F1BF   8D DA                  BSR   negx   ; q's sign
F1C1   30 42        DV1:      LEAX   2,U   
F1C3   6D E0                  TST   ,S+   
F1C5   2A DC                  BPL   ab9   
F1C7   20 D2                  BRA   negx   ; r's sign
F1C9                             ; udiv: unsigned divide, in place. The dividend is the NOS cell and the
F1C9                             ; divisor the TOS cell, both <= 8000h; the NOS cell becomes the quotient and
F1C9                             ; the TOS cell the remainder. The remainder is built in D (always < the
F1C9                             ; divisor, so 2R+1 fits in 16 bits).
F1C9   8E 00 10     UDIV:     LDX   #16   
F1CC   4F                     CLRA      
F1CD   5F                     CLRB      
F1CE   68 43        UD1:      ASL   3,U   
F1D0   69 42                  ROL   2,U   ; the dividend's top bit ...
F1D2   59                     ROLB      
F1D3   49                     ROLA      ; ... into the remainder
F1D4   10 A3 C4               CMPD   ,U   
F1D7   25 04                  BLO   ud2   
F1D9   A3 C4                  SUBD   ,U   
F1DB   6C 43                  INC   3,U   ; a quotient bit
F1DD   30 1F        UD2:      LEAX   -1,X   
F1DF   26 ED                  BNE   ud1   
F1E1   ED C4                  STD   ,U   
F1E3   39                     RTS      
F1E4                             ; "#" prints TOS as a signed decimal number, with no space after it.
F1E4   6D C4        H_NUM:    TST   ,U   
F1E6   2A 07                  BPL   pdec   
F1E8   86 2D                  LDA   #"-"   
F1EA   BD FF 03               JSR   CONOUT   
F1ED   8D AA                  BSR   negt   
F1EF                             ; pdec: print the top cell as unsigned and drop it, by recursion on /10
F1EF   CC 00 0A     PDEC:     LDD   #10   
F1F2   36 06                  PSHU   D   
F1F4   8D D3                  BSR   udiv   ; NOS = quotient, TOS = digit
F1F6   37 06                  PULU   D   ; the digit
F1F8   34 04                  PSHS   B   
F1FA   EC C4                  LDD   ,U   
F1FC   27 04                  BEQ   pd1   
F1FE   8D EF                  BSR   pdec   
F200   20 02                  BRA   pd2   
F202   33 42        PD1:      LEAU   2,U   ; drop the zero quotient
F204   35 02        PD2:      PULS   A   
F206   8B 30                  ADDA   #"0"   
F208   7E FF 03               JMP   CONOUT   
F20B                             ; "*": three 8x8 multiplies; only the low 16 bits are kept.
F20B                             ; a = ah:al at 2,U.  b = bh:bl at ,U.
F20B   A6 43        H_MUL:    LDA   3,U   
F20D   E6 C4                  LDB   ,U   
F20F   3D                     MUL      ; al*bh
F210   E7 C4                  STB   ,U   ; (bh is no longer needed)
F212   A6 42                  LDA   2,U   
F214   E6 41                  LDB   1,U   
F216   3D                     MUL      ; ah*bl
F217   EB C4                  ADDB   ,U   
F219   E7 C4                  STB   ,U   ; the cross terms, low byte
F21B   A6 43                  LDA   3,U   
F21D   E6 41                  LDB   1,U   
F21F   3D                     MUL      ; al*bl
F220   AB C4                  ADDA   ,U   
F222   33 42                  LEAU   2,U   
F224   ED C4                  STD   ,U   
F226   39                     RTS      
F227   EC C1        H_ADD:    LDD   ,U++   
F229   E3 C4                  ADDD   ,U   
F22B   20 38                  BRA   st   
F22D   EC C1        H_AND:    LDD   ,U++   
F22F   A4 C4                  ANDA   ,U   
F231   E4 41                  ANDB   1,U   
F233   20 30                  BRA   st   
F235   EC C1        H_OR:     LDD   ,U++   
F237   AA C4                  ORA   ,U   
F239   EA 41                  ORB   1,U   
F23B   20 28                  BRA   st   
F23D   EC C1        H_XOR:    LDD   ,U++   
F23F   A8 C4                  EORA   ,U   
F241   E8 41                  EORB   1,U   
F243   20 20                  BRA   st   
F245   63 C4        H_NOT:    COM   ,U   
F247   63 41                  COM   1,U   
F249   39                     RTS      
F24A                             ; Signed compares: a-b, then a branch to put -1 or 0 on the stack.
F24A   EC 42        CMP:      LDD   2,U   
F24C   10 A3 C1               CMPD   ,U++   
F24F   39                     RTS      
F250   8D F8        H_LT:     BSR   cmp   
F252   2D 0E                  BLT   true   
F254   4F           FALSE:    CLRA      
F255   5F                     CLRB      
F256   20 0D                  BRA   st   
F258   8D F0        H_GT:     BSR   cmp   
F25A   2E 06                  BGT   true   
F25C   20 F6                  BRA   false   
F25E   8D EA        H_EQ:     BSR   cmp   
F260   26 F2                  BNE   false   
F262   CC FF FF     TRUE:     LDD   #-1   
F265   ED C4        ST:       STD   ,U   
F267   39                     RTS      
F268                             ; =============================================================================
F268                             ;  Stack
F268                             ; =============================================================================
F268   EC C4        H_DUP:    LDD   ,U   
F26A   36 06                  PSHU   D   
F26C   39                     RTS      
F26D   37 16        H_SWAP:   PULU   D,X   
F26F   36 06                  PSHU   D   
F271   36 10                  PSHU   X   
F273   39                     RTS      
F274                             ; =============================================================================
F274                             ;  Storage. The cells in RAM are little-endian: the byte order is swapped
F274                             ;  between the stack (big-endian) and memory.
F274                             ; =============================================================================
F274   AE C4        H_FETCH:   LDX   ,U   ; "@"
F276   E6 84                  LDB   ,X   
F278   A6 01                  LDA   1,X   
F27A   20 E9                  BRA   st   
F27C   AE C4        H_CFETCH:   LDX   ,U   ; ","
F27E   E6 84                  LDB   ,X   
F280   4F                     CLRA      
F281   20 E2                  BRA   st   
F283   AE C1        H_STORE:   LDX   ,U++   ; "!" ( n addr -- )
F285                          IF   CHECKED   
F285   8D 31                  BSR   chkst   ; both bytes must be in the program's space
F287   30 01                  LEAX   1,X   
F289   8D 2D                  BSR   chkst   
F28B   30 1F                  LEAX   -1,X   
F28D                          ENDIF      
F28D   37 06                  PULU   D   
F28F   E7 84                  STB   ,X   ; little-endian
F291   A7 01                  STA   1,X   
F293   39                     RTS      
F294   AE C1        H_CSTORE:   LDX   ,U++   ; "." ( c addr -- )
F296                          IF   CHECKED   
F296   8D 20                  BSR   chkst   
F298                          ENDIF      
F298   37 06                  PULU   D   
F29A   E7 84                  STB   ,X   
F29C   39                     RTS      
F29D                             ; "_" ( n -- addr ): the heap pointer moves up by n; TOS is the old pointer.
F29D   D6 7C        H_ALLOC:   LDB   <HEAP   
F29F   96 7D                  LDA   <HEAP+1   
F2A1   1F 01                  TFR   D,X   ; the old pointer
F2A3   E3 C4                  ADDD   ,U   
F2A5                          IF   CHECKED   
F2A5   10 25 00 EC            LBCS   e_heap   ; a negative count wraps: too big
F2A9   10 83 F0 00            CMPD   #HEAPLIM*256   
F2AD   10 24 00 E4            LBHS   e_heap   
F2B1                          ENDIF      
F2B1   D7 7C                  STB   <HEAP   
F2B3   97 7D                  STA   <HEAP+1   
F2B5   AF C4                  STX   ,U   
F2B7   39                     RTS      
F2B8                          IF   CHECKED   
F2B8                             ; chkst: stop unless X is in the program's own space: from the letter page
F2B8                             ; up to HEAPLIM, so the interpreter's stacks and whatever lies above the
F2B8                             ; limit are safe. Memory above the heap top but below the limit is the
F2B8                             ; program's own: Tiny BASIC keeps its lines there. Keeps every register.
F2B8   8C 82 00     CHKST:    CMPX   #LET   
F2BB   10 25 00 D9            LBLO   e_store   
F2BF   8C F0 00               CMPX   #HEAPLIM*256   
F2C2   10 24 00 D2            LBHS   e_store   
F2C6   39                     RTS      
F2C7                          ENDIF      
F2C7                             ; =============================================================================
F2C7                             ;  Flow control helpers
F2C7                             ; =============================================================================
F2C7                             ; =============================================================================
F2C7                             ;  Console
F2C7                             ; =============================================================================
F2C7                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
F2C7                             ; 40h-7Fh clears its bit 6 (/M is CR, /` is space); plus anything lower gives
F2C7                             ; that character itself.
F2C7   AE C4        H_PRINT:   LDX   ,U   
F2C9   A6 80        PR0:      LDA   ,X+   
F2CB   81 22                  CMPA   #22h   
F2CD   27 14                  BEQ   drop   
F2CF   81 2F                  CMPA   #"/"   
F2D1   26 08                  BNE   pr1   
F2D3   A6 80                  LDA   ,X+   
F2D5   81 40                  CMPA   #40h   
F2D7   25 02                  BLO   pr1   
F2D9   84 BF                  ANDA   #0BFh   
F2DB   8D 25        PR1:      BSR   putc   
F2DD   20 EA                  BRA   pr0   
F2DF   A6 41        H_EMIT:   LDA   1,U   ; "'"
F2E1   8D 1F                  BSR   putc   
F2E3   33 42        DROP:     LEAU   2,U   ; ";"
F2E5   39                     RTS      
F2E6                             ; =============================================================================
F2E6                             ;  Console layer: getk returns a waiting key in A (zero flag clear), or
F2E6                             ;  A = 0 with the zero flag set when none is waiting. It keeps B, X, Y, U.
F2E6                             ;  In the unchecked build getk is the host's KEY routine itself.
F2E6                             ; =============================================================================
F2E6                          IF   1-CHECKED   
                    GETK:     EQU   KEY   ; the host's routine does the whole job; it
F2E6                          ENDIF      ;   is too far for BSR, so it is called by JSR
F2E6                          IF   CHECKED   
F2E6   96 34        GETK:     LDA   <KEYBUF   ; a key held back by the break check
F2E8   27 04                  BEQ   gk1   
F2EA   0F 34                  CLR   <KEYBUF   
F2EC   4D                     TSTA      
F2ED   39                     RTS      
F2EE   7E FF 06     GK1:      JMP   KEY   
F2F1                          ENDIF      
F2F1                          IF   CHECKED   
F2F1                             ; chkbrk: a waiting key is read now; Ctrl-C stops the program, anything
F2F1                             ; else is held for the next "?".
F2F1   96 34        CHKBRK:   LDA   <KEYBUF   
F2F3   26 0C                  BNE   cb9   ; one key is already held
F2F5   8D EF                  BSR   getk   
F2F7   27 08                  BEQ   cb9   
F2F9   81 03                  CMPA   #3   
F2FB   10 27 00 93            LBEQ   e_break   
F2FF   97 34                  STA   <KEYBUF   
F301   39           CB9:      RTS      
F302                          ENDIF      
F302   7E FF 03     PUTC:     JMP   CONOUT   
F305                             ; "?" ( n -- c ) or ( -n -- addr )
F305                             ;   n > 0: wait about n ms for a key; 0 if none came
F305                             ;   n = 0: wait for a key
F305                             ;   n < 0: read a line of at most -n characters, with echo. n is not
F305                             ;          checked: the buffer holds 127 characters and the CR, so a
F305                             ;          program must ask for 127 or fewer.
F305   AE C4        H_KEY:    LDX   ,U   
F307   2B 16                  BMI   line   
F309   C6 14        KT1:      LDB   #MSLOOP   ; one millisecond, roughly
F30B                KT2:         
F30B                          IF   1-CHECKED   
                              JSR   getk   
F30B                          ENDIF      
F30B                          IF   CHECKED   
F30B   8D D9                  BSR   getk   
F30D                          ENDIF      
F30D   26 0B                  BNE   kt3   
F30F   5A                     DECB      
F310   26 F9                  BNE   kt2   
F312   30 1F                  LEAX   -1,X   
F314   26 F3                  BNE   kt1   ; A = 0 if the time ran out
F316   AE C4                  LDX   ,U   ; 0?: the countdown from 0 took 65536 ms;
F318   27 EF                  BEQ   kt1   ;   run it again, until a key comes
F31A   6F C4        KT3:      CLR   ,U   
F31C   A7 41                  STA   1,U   
F31E   39                     RTS      
F31F                             ; Backspace takes the last character back (and is echoed as it is), CR ends
F31F                             ; (stored, not echoed), every other key is stored and echoed until the line
F31F                             ; is full. B = the length so far; the low byte of the top cell becomes the
F31F                             ; most allowed (it holds minus the count on entry).
F31F   60 41        LINE:     NEG   1,U   
F321   8E 82 80               LDX   #LINEBUF   
F324   5F                     CLRB      
F325                LN2:         
F325                          IF   1-CHECKED   
                              JSR   getk   
F325                          ENDIF      
F325                          IF   CHECKED   
F325   8D BF                  BSR   getk   
F327                          ENDIF      
F327   27 FC                  BEQ   ln2   
F329   81 0D                  CMPA   #13   
F32B   27 17                  BEQ   ln5   
F32D   81 08                  CMPA   #8   
F32F   27 0B                  BEQ   ln4   
F331   E1 41                  CMPB   1,U   
F333   24 F0                  BHS   ln2   ; full
F335   A7 80                  STA   ,X+   
F337   5C                     INCB      
F338   8D C8        LN3:      BSR   putc   
F33A   20 E9                  BRA   ln2   
F33C   5D           LN4:      TSTB      ; Backspace: nothing to take back?
F33D   27 E6                  BEQ   ln2   
F33F   5A                     DECB      
F340   30 1F                  LEAX   -1,X   
F342   20 F4                  BRA   ln3   ; echo it
F344   A7 84        LN5:      STA   ,X   ; A = 13
F346   CC 82 80               LDD   #LINEBUF   
F349   ED C4                  STD   ,U   
F34B   39                     RTS      
F34C                             ; =============================================================================
F34C                             ;  Machine code: the grave
F34C                             ; =============================================================================
F34C                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
F34C                             ; are stored from addr until a non-hex character; then a RTS (39h) is
F34C                             ; written and its address is left. An odd last digit is consumed and dropped.
F34C                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
F34C                             ; code is entered by JSR (the dispatcher's own), with the address already
F34C                             ; popped: U points at the top data cell (big-endian, 2 bytes, stack grows
F34C                             ; down) and the return address is on top of S. The code may pop and push
F34C                             ; data cells by changing U; on return the cell at ,U is the new TOS. It must
F34C                             ; keep Y (the interpreter's reading position), DP and S (balanced), and
F34C                             ; return with RTS. A, B, X, CC may change.
F34C   8D 27        H_GRAVE:   BSR   hexc   ; the digit after the grave, if any
F34E   24 21                  BCC   exec   
F350   AE C4                  LDX   ,U   
F352   48           HX1:      ASLA      
F353   48                     ASLA      
F354   48                     ASLA      
F355   48                     ASLA      
F356                          IF   CHECKED   
F356   BD F2 B8               JSR   chkst   
F359                          ENDIF      
F359   A7 84                  STA   ,X   ; the high nibble; an odd digit is overwritten
F35B   8D 18                  BSR   hexc   
F35D   24 08                  BCC   hx2   ; odd digit: already consumed, dropped
F35F   AA 84                  ORA   ,X   
F361   A7 80                  STA   ,X+   
F363   8D 10                  BSR   hexc   
F365   25 EB                  BCS   hx1   
F367                HX2:         
F367                          IF   CHECKED   
F367   BD F2 B8               JSR   chkst   
F36A                          ENDIF      
F36A   86 39                  LDA   #39h   ; RTS
F36C   A7 84                  STA   ,X   
F36E   AF C4                  STX   ,U   
F370   39                     RTS      
F371   AE C1        EXEC:     LDX   ,U++   
F373   6E 84                  JMP   ,X   ; the code's RTS returns to the dispatcher
F375                             ; hexc: read the character at IP. If it is a hex digit (0-9, A-F, a-f), return
F375                             ; its value 0-15 in A with carry set and step over it; otherwise return with
F375                             ; carry clear and the IP unchanged.
F375   A6 A4        HEXC:     LDA   ,Y   
F377   80 30                  SUBA   #"0"   
F379   81 0A                  CMPA   #10   
F37B   25 0C                  BLO   hv1   ; C = 1
F37D   84 DF                  ANDA   #0DFh   
F37F   80 11                  SUBA   #11h   
F381   81 06                  CMPA   #6   
F383   24 06                  BHS   hv9   ; C = 0
F385   8B 0A                  ADDA   #10   
F387   81 10                  CMPA   #16   ; C = 1
F389   31 21        HV1:      LEAY   1,Y   ; (LEAY leaves the carry alone)
F38B   39           HV9:      RTS      
F38C                             ; =============================================================================
F38C                             ;  Checked build: break key and error reports
F38C                             ; =============================================================================
F38C                          IF   CHECKED   
F38C                             ; Error entries. Each loads its letter and then hides the next entry inside
F38C                             ; a 3-byte CMPX # (the 8Ch), so they all fall through to `error`.
F38C   86 53        E_STACK:   LDA   #"S"   ; data stack over or under
F38E   8C                     FCB   8Ch   
F38F   86 52        E_RSTACK:   LDA   #"R"   ; return stack over or under
F391   8C                     FCB   8Ch   
F392   86 42        E_BREAK:   LDA   #"B"   ; Ctrl-C
F394   8C                     FCB   8Ch   
F395   86 48        E_HEAP:   LDA   #"H"   ; heap past the limit
F397   8C                     FCB   8Ch   
F398   86 57        E_STORE:   LDA   #"W"   ; write outside the program's space
F39A   8C                     FCB   8Ch   
F39B   86 44        E_BRACK:   LDA   #"D"   ; bad character after [
F39D                             ; error: print the letter in A, " @ " and the offset in the program of the
F39D                             ; character just read, then end. For example: S @ 245
F39D   10 CE 81 00  ERROR:    LDS   #RSTOP   ; the stacks may be wrecked: start clean
F3A1   CE 82 00               LDU   #DSTOP   
F3A4   BD FF 03               JSR   CONOUT   
F3A7   86 20                  LDA   #" "   
F3A9   BD FF 03               JSR   CONOUT   
F3AC   86 40                  LDA   #"@"   
F3AE   BD FF 03               JSR   CONOUT   
F3B1   86 20                  LDA   #" "   
F3B3   BD FF 03               JSR   CONOUT   
F3B6   1F 20                  TFR   Y,D   
F3B8   83 83 01               SUBD   #PROG+1   ; the character just read
F3BB   36 06                  PSHU   D   
F3BD   BD F1 EF               JSR   pdec   
F3C0   7E FF 09               JMP   EXIT   
F3C3                          ENDIF      
F3C3                IMGEND:      


