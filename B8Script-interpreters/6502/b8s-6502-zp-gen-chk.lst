E4BB                             ;  character, in code order.
E4BB                             ; =============================================================================
E4BB   A7           PTAB:     DB   (h_store-1) & 0FFh   ; !
E4BC   55                     DB   (h_str-1) & 0FFh   ; "
E4BD   7B                     DB   (h_num-1) & 0FFh   ; #
E4BE   2C                     DB   (h_print-1) & 0FFh   ; $
E4BF   B6                     DB   (h_swap-1) & 0FFh   ; %
E4C0   C7                     DB   (h_and-1) & 0FFh   ; &
E4C1   73                     DB   (h_emit-1) & 0FFh   ; '
E4C2   D2                     DB   (h_open-1) & 0FFh   ; (
