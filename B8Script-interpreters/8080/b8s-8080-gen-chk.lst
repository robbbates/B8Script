0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Intel 8080
0000                             ;  Spec: docs/b8script.md (2026-10-09) plus the 2026-11-20 changes:
0000                             ;        [x stores in a variable, "[ " pushes an anonymous block, any other
0000                             ;        character after [ is an error, the heap pointer lives at z10+.
0000                             ;        The string escape is "/" (it was ">").
0000                             ;  A port of the Z80 interpreter (z80/b8s-z80.asm); same behaviour, same
0000                             ;  memory map, same switches.
0000                             ; 
0000                             ;  Two switches, set in the two EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    CHECKED  0 = no checks (spec: "B8Script checks nothing")
0000                             ;             1 = stops on stack overrun, Ctrl-C, heap past the limit, a store
0000                             ;                 outside the program's own space, and a bad character after [,
0000                             ;                 printing a letter and the place, like  S @ 245
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), I8080 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   0   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   1   ; 1 = checked build
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the 8080"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  The return stack pointer has no register (the 8080 has no spare pair): it
0000                             ;  is the RAM word RSP. Only rpush and rpop (and the checks) touch it; both
0000                             ;  destroy HL, so each caller makes sure TOS is parked or dead first.
0000                             ; 
0000                             ;  (asm80 wants the vector number: RST 1 = RST 08h, RST 2 = RST 10h.)
0000                             ;  A handler ends with RST 10h ("next character") or RST 08h ("drop, then
0000                             ;  next"), one byte each instead of a three-byte JMP. An RST is a CALL, so the
0000                             ;  first thing each stub does is POP D to throw the return address away.
0000                             ; 
0000                             ;  What the 8080 lacks, and what replaces it: no JR (JMP/Jcc), no DJNZ, no
0000                             ;  SBC HL (byte-wise SUB/SBB, or negate and DAD), no shifts on register pairs
0000                             ;  (DAD H doubles; RAL/RAR through A), no LDIR/CPIR (small loops).
0000                             ; -----------------------------------------------------------------------------
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (SP stays inside this page)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch (= z10+), interpreter variables in the gaps, and the -n?
0000                             ;             line buffer at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range LETPAGE..heap top.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
                    BDOS:     EQU   0005h   
0000                          ENDIF      
0000                          IFN   CPM   
0000                             ; ---- generic machine: edit these to suit -----------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The zero flag must match A
0000                             ;   (end the routine with ORA A / RET).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                             ;   KEY and CONOUT must preserve BC, DE and HL.
0000                RSPAGE:   EQU   80h   ; 8000h return stack
0000                DSPAGE:   EQU   81h   ; 8100h data stack
0000                LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
0000                PROG:     EQU   8300h   ; where the loader puts the program text
0000                HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms; tune it
0000                             ; for your clock and your KEY routine
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; z10+, the heap pointer
0000                RSP:      EQU   LET+34h   ; gap after Z: the return stack pointer;
0000                KEYBUF:   EQU   LET+36h   ;   a held-back key;
0000                HLIM:     EQU   LET+3Ah   ;   high byte of the heap limit
0000                LBHDR:    EQU   LET+7Eh   ; CP/M BDOS 10 header: max, count
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FEh   ; empty data stack
0000                             ; =============================================================================
0000                             ;  Page zero (generic ROM) or the start of the .COM file (CP/M)
0000                             ; =============================================================================
0000                          IF   CPM   
                              .ORG   0100h   
                              JMP   start   
0000                          ENDIF      
0000                          IFN   CPM   
0000                          .ORG   0000h   
0000   31 FE 81               LXI   SP,DSTOP   ; 0000h reset: the stack first,
0003   C3 E2 03               JMP   start   ;   then the rest of the startup
0006   E3           H_SWAP:   XTHL      ; 0006h the two-byte handlers fill the gaps
0007   D7                     RST   2   ;   between the vectors
0008                             ; ---- RST 08h: drop TOS, then next ------------------------------------------
0008   D1                     POP   D   ; 0008h discard the RST's return address
0009                DROP_NEXT:      
0009   E1                     POP   H   ; new TOS = NOS
000A   C3 11 00               JMP   next0   
000D   E5           H_DUP:    PUSH   H   ; 000Dh
000E   D7                     RST   2   
000F   00                     DB   0   ; 000Fh spare
0010                             ; ---- RST 10h: next character ------------------------------------------------
0010   D1                     POP   D   ; 0010h discard the RST's return address
0011                          ENDIF      
0011                             ; =============================================================================
0011                             ;  The inner loop: read one character and sort it by range.
0011                             ; 
0011                             ;    00h          end of program
0011                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0011                             ;    30h-39h      digit: read a whole number
0011                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0011                             ;    61h-7Ah      a-z: push the address of that letter's cell
0011                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0011                             ; =============================================================================
0011                NEXT0:       
0011                          IF   CHECKED   
0011                             ; Both stacks are checked once per character, not in every handler.
0011                             ; Each stack lives in one page, so it has overrun exactly when the
0011                             ; pointer's high byte has left that page. Errors are caught one cell
0011                             ; late at most; the page below each stack is a guard band.
0011   EB                     XCHG      ; DE = TOS (HL is needed for the pointers)
0012   21 00 00               LXI   H,0   
0015   39                     DAD   SP   
0016   7C                     MOV   A,H   
0017   FE 81                  CPI   DSPAGE   
0019   C2 B2 03               JNZ   e_stack   
001C   2A 34 82               LHLD   RSP   ; the return stack: in its page, and not
001F   7D                     MOV   A,L   ;   above its empty position (an underflow
0020   FE E1                  CPI   RSTOP&0FFh+1   ;   would stay inside the page, in the
0022   D2 B5 03               JNC   e_rstack   ;   guard band)
0025   7C                     MOV   A,H   
0026   FE 80                  CPI   RSPAGE   
0028   C2 B5 03               JNZ   e_rstack   
002B   EB                     XCHG      ; TOS back
002C                          ENDIF      
002C   0A                     LDAX   B   
002D   03                     INX   B   
002E   D6 21                  SUI   21h   ; A = c - 21h
0030   DA 73 00               JC   ctl   ; c < 21h: NUL ends, the rest are ignored
0033   FE 0F                  CPI   0Fh   
0035   DA 66 00               JC   punct   ; 21h-2Fh: PTAB index 0-14
0038   D6 0F                  SUI   0Fh   ; A = c - 30h
003A   FE 0A                  CPI   0Ah   
003C   DA 90 00               JC   digit   ; 30h-39h
003F   FE 11                  CPI   11h   
0041   D2 49 00               JNC   ab40   
0044   C6 05                  ADI   5   ; 3Ah-40h: index 15-21
0046   C3 66 00               JMP   punct   
0049   D6 11        AB40:     SUI   11h   ; A = c - 41h
004B   FE 1A                  CPI   1Ah   
004D   DA 81 00               JC   upper   ; 41h-5Ah: A = letter index 0-25
0050   FE 20                  CPI   20h   
0052   D2 5A 00               JNC   ab60   
0055   D6 04                  SUI   4   ; 5Bh-60h: index 22-27
0057   C3 66 00               JMP   punct   
005A   FE 3A        AB60:     CPI   3Ah   
005C   DA 7B 00               JC   lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
005F   FE 3E                  CPI   3Eh   
0061   D2 11 00               JNC   next0   ; 7Fh-FFh: ignored
0064   D6 1E                  SUI   1Eh   ; 7Bh-7Eh: index 28-31
0066                             ; Punctuation: HL holds TOS, so it is parked on the stack while the table is
0066                             ; read, then swapped for the handler's address: XTHL puts TOS back in HL and
0066                             ; leaves the address on the stack for RET to jump to. The stack is balanced
0066                             ; again when the handler starts. PTAB never crosses a page (checked in the
0066                             ; listing), so only L needs adding.
0066   E5           PUNCT:    PUSH   H   
0067   87                     ADD   A   
0068   C6 96                  ADI   PTAB & 0FFh   
006A   6F                     MOV   L,A   
006B   26 00                  MVI   H,PTAB / 256   
006D   7E                     MOV   A,M   
006E   23                     INX   H   
006F   66                     MOV   H,M   
0070   6F                     MOV   L,A   ; HL = handler
0071   E3                     XTHL      
0072   C9                     RET      
0073   C6 21        CTL:      ADI   21h   ; back to c; zero only for NUL
0075   C2 11 00               JNZ   next0   
0078                          IF   CPM   
                              JMP   endprog   
0078                          ENDIF      
0078                          IFN   CPM   
0078                ENDPROG:      
0078   C3 09 FF               JMP   EXIT   ; the program has ended
007B                          ENDIF      
007B                             ; a-z: push the cell's address (the cell is the variable)
007B   E5           LOWER:    PUSH   H   
007C   87                     ADD   A   
007D   6F                     MOV   L,A   
007E   26 82                  MVI   H,LETPAGE   
0080   D7                     RST   2   
0081                             ; A-Z: call the word. The return address (the IP after the letter) goes on
0081                             ; the return stack, and the IP becomes the address in the letter's cell.
0081   E5           UPPER:    PUSH   H   ; keep TOS
0082   87                     ADD   A   
0083   6F                     MOV   L,A   
0084   26 82                  MVI   H,LETPAGE   ; HL -> cell
0086   50                     MOV   D,B   
0087   59                     MOV   E,C   ; DE = return address
0088   4E                     MOV   C,M   
0089   23                     INX   H   
008A   46                     MOV   B,M   ; IP = the word's body
008B   CD ED 00               CALL   rpush   
008E   E1                     POP   H   ; TOS back
008F   D7                     RST   2   
0090                             ; Digits: step back onto the first digit and read the whole number.
0090   E5           DIGIT:    PUSH   H   
0091   0B                     DCX   B   
0092   CD D6 00               CALL   rdnum   
0095   D7                     RST   2   
0096                             ; =============================================================================
0096                             ;  Dispatch table: one handler per punctuation character, in code order.
0096                             ;  It sits right after the inner loop so that it can't cross a page (the
0096                             ;  loop only adds to the low byte of its address).
0096                             ; =============================================================================
0096   CE 01        PTAB:     DW   h_store   ; !
0098   A7 02                  DW   h_str   ; "
009A   CF 02                  DW   h_num   ; #
009C   AE 02                  DW   h_print   ; $
009E   06 00                  DW   h_swap   ; %
00A0   85 01                  DW   h_and   ; &
00A2   CA 02                  DW   h_emit   ; '
00A4   09 02                  DW   h_open   ; (
00A6   19 02                  DW   h_close   ; )
00A8   24 01                  DW   h_mul   ; *
00AA   04 01                  DW   h_add   ; +
00AC   D8 01                  DW   h_cfetch   ; ,
00AE   07 01                  DW   h_sub   ; -
00B0   DC 01                  DW   h_cstore   ; .
00B2   40 01                  DW   h_div   ; /
00B4   0D 00                  DW   h_dup   ; :
00B6   09 00                  DW   drop_next   ; ;
00B8   A3 01                  DW   h_lt   ; <
00BA   B2 01                  DW   h_eq   ; =
00BC   A2 01                  DW   h_gt   ; >
00BE   F5 02                  DW   h_key   ; ?
00C0   C9 01                  DW   h_fetch   ; @
00C2   47 02                  DW   h_def   ; [
00C4   2D 02                  DW   h_break   ; \
00C6   3C 02                  DW   h_ret   ; ]
00C8   95 01                  DW   h_xor   ; ^
00CA   E2 01                  DW   h_alloc   ; _
00CC   50 03                  DW   h_grave   ; `
00CE   BF 01                  DW   h_tor   ; {
00D0   8D 01                  DW   h_or   ; |
00D2   C4 01                  DW   h_fromr   ; }
00D4   9D 01                  DW   h_not   ; ~
00D6                PTABEND:      
00D6                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
00D6                             ; non-digit. Values wrap at 16 bits, as the spec says.
00D6   21 00 00     RDNUM:    LXI   H,0   
00D9   0A           RDN1:     LDAX   B   
00DA   D6 30                  SUI   "0"   
00DC   FE 0A                  CPI   10   
00DE   D0                     RNC      
00DF   03                     INX   B   
00E0   54                     MOV   D,H   
00E1   5D                     MOV   E,L   
00E2   29                     DAD   H   
00E3   29                     DAD   H   
00E4   19                     DAD   D   
00E5   29                     DAD   H   ; HL * 10
00E6   5F                     MOV   E,A   
00E7   16 00                  MVI   D,0   
00E9   19                     DAD   D   
00EA   C3 D9 00               JMP   rdn1   
00ED                             ; =============================================================================
00ED                             ;  Return stack. rpush pushes DE; rpop pops into HL. RSP is the pointer (a RAM
00ED                             ;  word, growing down). Both destroy HL; rpush also keeps DE, rpop clobbers DE.
00ED                             ; =============================================================================
00ED   2A 34 82     RPUSH:    LHLD   RSP   
00F0   2B                     DCX   H   
00F1   72                     MOV   M,D   
00F2   2B                     DCX   H   
00F3   73                     MOV   M,E   
00F4   22 34 82               SHLD   RSP   
00F7   C9                     RET      
00F8   2A 34 82     RPOP:     LHLD   RSP   
00FB   5E                     MOV   E,M   
00FC   23                     INX   H   
00FD   56                     MOV   D,M   
00FE   23                     INX   H   
00FF   22 34 82               SHLD   RSP   
0102   EB                     XCHG      
0103   C9                     RET      
0104                             ; =============================================================================
0104                             ;  Arithmetic and logic. Effects are ( NOS TOS -- result ).
0104                             ; =============================================================================
0104   D1           H_ADD:    POP   D   
0105   19                     DAD   D   
0106   D7                     RST   2   
0107                             ; "-" has two jobs: directly before a digit it starts a negative number.
0107                             ; Otherwise a - b is a + (-b): neg16 and DAD are shorter than a byte-wise SUB/SBB.
0107   0A           H_SUB:    LDAX   B   
0108   D6 30                  SUI   "0"   
010A   FE 0A                  CPI   10   
010C   DA 15 01               JC   negnum   
010F   D1                     POP   D   
0110   CD 1D 01               CALL   neg16   
0113   19                     DAD   D   
0114   D7                     RST   2   
0115   E5           NEGNUM:   PUSH   H   
0116   CD D6 00               CALL   rdnum   
0119   CD 1D 01               CALL   neg16   
011C   D7                     RST   2   
011D                             ; neg16: HL = -HL (keeps BC, DE)
011D   AF           NEG16:    XRA   A   
011E   95                     SUB   L   
011F   6F                     MOV   L,A   
0120   9F                     SBB   A   
0121   94                     SUB   H   
0122   67                     MOV   H,A   
0123   C9                     RET      
0124                             ; "*": shift-and-add on the multiplier's low bit, so it stops as soon as the
0124                             ; multiplier is used up; only the low 16 bits are kept.
0124   D1           H_MUL:    POP   D   ; DE = multiplicand
0125   C5                     PUSH   B   
0126   44                     MOV   B,H   
0127   4D                     MOV   C,L   ; BC = multiplier
0128   21 00 00               LXI   H,0   
012B   78           MUL1:     MOV   A,B   
012C   B7                     ORA   A   ; clear carry
012D   1F                     RAR      
012E   47                     MOV   B,A   
012F   79                     MOV   A,C   
0130   1F                     RAR      
0131   4F                     MOV   C,A   ; BC >> 1, carry = the bit shifted out
0132   D2 36 01               JNC   mul2   
0135   19                     DAD   D   
0136   EB           MUL2:     XCHG      
0137   29                     DAD   H   ; multiplicand << 1
0138   EB                     XCHG      
0139   78                     MOV   A,B   
013A   B1                     ORA   C   
013B   C2 2B 01               JNZ   mul1   
013E   C1                     POP   B   
013F   D7                     RST   2   
0140                             ; "/" ( a b -- r q ): the quotient is on top. Truncates toward zero; r takes
0140                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
0140                             ; of a. Dividing by zero is not checked: it returns two cells of no meaning.
0140   D1           H_DIV:    POP   D   ; DE = a, HL = b
0141   C5                     PUSH   B   
0142   7A                     MOV   A,D   
0143   B7                     ORA   A   
0144   F5                     PUSH   PSW   ; S flag = sign of a (for r)
0145   AC                     XRA   H   
0146   F5                     PUSH   PSW   ; S flag = sign of q
0147   7C                     MOV   A,H   
0148   B7                     ORA   A   
0149   FC 1D 01               CM   neg16   ; HL = |b|
014C   EB                     XCHG      
014D   7C                     MOV   A,H   
014E   B7                     ORA   A   
014F   FC 1D 01               CM   neg16   ; HL = |a|, DE = |b|
0152   CD 64 01               CALL   udiv   ; HL = q, BC = r
0155   F1                     POP   PSW   
0156   FC 1D 01               CM   neg16   ; q's sign
0159   EB                     XCHG      ; DE = q
015A   60                     MOV   H,B   
015B   69                     MOV   L,C   ; HL = r
015C   F1                     POP   PSW   
015D   FC 1D 01               CM   neg16   ; r's sign
0160   C1                     POP   B   
0161   E5                     PUSH   H   ; r under q
0162   EB                     XCHG      ; HL = q
0163   D7                     RST   2   
0164                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, BC = remainder.
0164                             ; Uses A, BC; the caller saves the IP. HL holds the dividend and, as its bits
0164                             ; leave at the top, the quotient bits arrive at the bottom. The loop counter
0164                             ; lives on the stack, since A is busy with the shifts.
0164   01 00 00     UDIV:     LXI   B,0   
0167   3E 10                  MVI   A,16   
0169   F5                     PUSH   PSW   
016A   29           UDV1:     DAD   H   ; next dividend bit into the carry
016B   79                     MOV   A,C   
016C   17                     RAL      
016D   4F                     MOV   C,A   
016E   78                     MOV   A,B   
016F   17                     RAL      
0170   47                     MOV   B,A   ; BC = BC*2 + bit
0171   79                     MOV   A,C   
0172   93                     SUB   E   
0173   78                     MOV   A,B   
0174   9A                     SBB   D   ; carry if BC < DE
0175   DA 7D 01               JC   udv2   
0178   47                     MOV   B,A   ; BC - DE (high byte; A holds it)
0179   79                     MOV   A,C   
017A   93                     SUB   E   
017B   4F                     MOV   C,A   
017C   2C                     INR   L   ; quotient bit
017D   F1           UDV2:     POP   PSW   
017E   3D                     DCR   A   
017F   F5                     PUSH   PSW   
0180   C2 6A 01               JNZ   udv1   
0183   F1                     POP   PSW   
0184   C9                     RET      
0185   D1           H_AND:    POP   D   
0186   7C                     MOV   A,H   
0187   A2                     ANA   D   
0188   67                     MOV   H,A   
0189   7D                     MOV   A,L   
018A   A3                     ANA   E   
018B   6F                     MOV   L,A   
018C   D7                     RST   2   
018D   D1           H_OR:     POP   D   
018E   7C                     MOV   A,H   
018F   B2                     ORA   D   
0190   67                     MOV   H,A   
0191   7D                     MOV   A,L   
0192   B3                     ORA   E   
0193   6F                     MOV   L,A   
0194   D7                     RST   2   
0195   D1           H_XOR:    POP   D   
0196   7C                     MOV   A,H   
0197   AA                     XRA   D   
0198   67                     MOV   H,A   
0199   7D                     MOV   A,L   
019A   AB                     XRA   E   
019B   6F                     MOV   L,A   
019C   D7                     RST   2   
019D                             ; ~x is -x - 1: shorter than complementing both bytes.
019D   CD 1D 01     H_NOT:    CALL   neg16   
01A0   2B                     DCX   H   
01A1   D7                     RST   2   
01A2                             ; Signed compares. Both are "DE < HL" for the right pair: > swaps the two
01A2                             ; cells first (XTHL), < doesn't. There is no overflow flag, so the signed
01A2                             ; answer is the unsigned borrow of DE - HL, flipped when the signs differ.
01A2                             ; SBB A turns a carry into -1 or 0 with no branch.
01A2   E3           H_GT:     XTHL      ; a > b  is  b < a
01A3   D1           H_LT:     POP   D   ; a < b: DE = a, HL = b
01A4   7B                     MOV   A,E   
01A5   95                     SUB   L   
01A6   7A                     MOV   A,D   
01A7   9C                     SBB   H   
01A8   9F                     SBB   A   ; A = -1 if DE < HL unsigned
01A9   6F                     MOV   L,A   
01AA   7C                     MOV   A,H   
01AB   AA                     XRA   D   
01AC   17                     RAL      ; carry = the signs differ
01AD   9F                     SBB   A   
01AE   AD                     XRA   L   ; flip when they do
01AF   67                     MOV   H,A   
01B0   6F                     MOV   L,A   
01B1   D7                     RST   2   
01B2   D1           H_EQ:     POP   D   
01B3   7D                     MOV   A,L   
01B4   AB                     XRA   E   
01B5   6F                     MOV   L,A   
01B6   7C                     MOV   A,H   
01B7   AA                     XRA   D   
01B8   B5                     ORA   L   ; zero if equal
01B9   D6 01                  SUI   1   ; carry only for zero
01BB   9F                     SBB   A   
01BC   67                     MOV   H,A   
01BD   6F                     MOV   L,A   
01BE   D7                     RST   2   
01BF                             ; =============================================================================
01BF                             ;  Stack
01BF                             ; =============================================================================
01BF                          IF   CPM   
                    H_SWAP:   XTHL      
                              RST   2   
01BF                          ENDIF      
01BF   EB           H_TOR:    XCHG      ; "{" TOS to the return stack
01C0   CD ED 00               CALL   rpush   
01C3   CF                     RST   1   
01C4   E5           H_FROMR:   PUSH   H   ; "}" return stack to TOS
01C5   CD F8 00               CALL   rpop   
01C8   D7                     RST   2   
01C9                             ; =============================================================================
01C9                             ;  Storage
01C9                             ; =============================================================================
01C9   5E           H_FETCH:   MOV   E,M   ; "@"
01CA   23                     INX   H   
01CB   56                     MOV   D,M   
01CC   EB                     XCHG      
01CD   D7                     RST   2   
01CE   D1           H_STORE:   POP   D   ; "!" ( n addr -- )
01CF                          IF   CHECKED   
01CF   23                     INX   H   ; both bytes must be in the program's space
01D0   CD F8 01               CALL   chkst   
01D3   2B                     DCX   H   
01D4                          ENDIF      
01D4   73                     MOV   M,E   
01D5   23                     INX   H   
01D6   72                     MOV   M,D   
01D7   CF                     RST   1   
01D8   6E           H_CFETCH:   MOV   L,M   ; ","
01D9   26 00                  MVI   H,0   
01DB   D7                     RST   2   
01DC   D1           H_CSTORE:   POP   D   ; "." ( c addr -- )
01DD                          IF   CHECKED   
01DD   CD F8 01               CALL   chkst   
01E0                          ENDIF      
01E0   73                     MOV   M,E   
01E1   CF                     RST   1   
01E2                             ; "_" ( n -- addr ): the heap pointer moves up by n; TOS is the old pointer.
01E2   EB           H_ALLOC:   XCHG      
01E3   2A 7C 82               LHLD   HEAP   
01E6   E5                     PUSH   H   
01E7   19                     DAD   D   
01E8                          IF   CHECKED   
01E8   DA BB 03               JC   e_heap   ; a negative count wraps: too big
01EB   3A 3A 82               LDA   HLIM   
01EE   3D                     DCR   A   
01EF   BC                     CMP   H   
01F0   DA BB 03               JC   e_heap   ; the new top must stay below the limit page
01F3                          ENDIF      
01F3   22 7C 82               SHLD   HEAP   
01F6   E1                     POP   H   
01F7   D7                     RST   2   
01F8                          IF   CHECKED   
01F8                             ; chkst: stop unless HL is in the program's own space: from the letter page
01F8                             ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
01F8                             ; whatever lies above the limit are safe. Memory above the heap top but
01F8                             ; below the limit is the program's own: Tiny BASIC keeps its lines there.
01F8                             ; Keeps every register.
01F8   F5           CHKST:    PUSH   PSW   
01F9   7C                     MOV   A,H   
01FA   FE 82                  CPI   LETPAGE   
01FC   DA 04 02               JC   chk1   
01FF   3A 3A 82               LDA   HLIM   
0202   3D                     DCR   A   
0203   BC                     CMP   H   
0204   DA BE 03     CHK1:     JC   e_store   
0207   F1                     POP   PSW   
0208   C9                     RET      
0209                          ENDIF      
0209                             ; =============================================================================
0209                             ;  Flow control
0209                             ; =============================================================================
0209                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
0209                             ; the matching ")".
0209   7C           H_OPEN:   MOV   A,H   
020A   B5                     ORA   L   
020B   CA 14 02               JZ   op_f   
020E   50                     MOV   D,B   
020F   59                     MOV   E,C   
0210   CD ED 00               CALL   rpush   ; (HL, the flag, is dead here)
0213   CF                     RST   1   ; = POP H, RST 2: the flag is dead, so drop it
0214   E1           OP_F:     POP   H   
0215   CD 6E 02     SKIPNX:   CALL   skip   
0218   D7                     RST   2   
0219                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
0219                             ; drops it and carries on.
0219   7C           H_CLOSE:   MOV   A,H   
021A   B5                     ORA   L   
021B   CA 29 02               JZ   rdrop   
021E                          IF   CHECKED   
021E   CD A0 03               CALL   chkbrk   ; Ctrl-C is checked at every loop-back
0221                          ENDIF      
0221   2A 34 82               LHLD   RSP   ; peek the block start
0224   4E                     MOV   C,M   
0225   23                     INX   H   
0226   46                     MOV   B,M   
0227   E1                     POP   H   
0228   D7                     RST   2   
0229   CD F8 00     RDROP:    CALL   rpop   ; (HL, the flag, is dead: NOS is next)
022C   CF                     RST   1   
022D                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
022D                             ; drops the block start, "]" returns. No closer at all ends the program.
022D   7C           H_BREAK:   MOV   A,H   
022E   B5                     ORA   L   
022F   C2 33 02               JNZ   brk1   
0232   CF                     RST   1   
0233   CD 6E 02     BRK1:     CALL   skip   
0236   FE 29                  CPI   ")"   
0238   CA 29 02               JZ   rdrop   
023B   E1                     POP   H   ; and fall into "]"
023C                             ; "]" returns: pop an address and jump to it.
023C   E5           H_RET:    PUSH   H   
023D   CD F8 00               CALL   rpop   
0240   44                     MOV   B,H   
0241   4D                     MOV   C,L   
0242   E1                     POP   H   
0243                          IF   CHECKED   
0243   CD A0 03               CALL   chkbrk   ; ... and at every word return
0246                          ENDIF      
0246   D7                     RST   2   
0247                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
0247                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
0247                             ; the body"s address instead. Either way it then skips to the matching "]'.
0247   0A           H_DEF:    LDAX   B   
0248   03                     INX   B   
0249   5F                     MOV   E,A   
024A   E6 DF                  ANI   0DFh   ; fold case
024C   D6 41                  SUI   "A"   
024E   FE 1A                  CPI   26   
0250   D2 62 02               JNC   def2   ; not a letter
0253   7B                     MOV   A,E   
0254   D6 41                  SUI   "A"   ; 0-25 or 32-57: lowercase lands 64 bytes up
0256   87                     ADD   A   
0257   5F                     MOV   E,A   
0258   16 82                  MVI   D,LETPAGE   ; DE -> cell
025A   79                     MOV   A,C   
025B   12                     STAX   D   
025C   1C                     INR   E   
025D   78                     MOV   A,B   
025E   12                     STAX   D   
025F   C3 15 02               JMP   skipnx   
0262                DEF2:        
0262                          IF   CHECKED   
0262   7B                     MOV   A,E   
0263   FE 20                  CPI   " "   
0265   C2 C1 03               JNZ   e_brack   ; anything but a letter or a space
0268                          ENDIF      
0268   E5                     PUSH   H   ; an anonymous block: push its address
0269   60                     MOV   H,B   
026A   69                     MOV   L,C   
026B   C3 15 02               JMP   skipnx   
026E                             ; skip: read past text to the closer at this level, and return it in A.
026E                             ; Brackets of both kinds count together; strings are stepped over whole. A
026E                             ; NUL first ends the program (for "\" with no closer; anything else that runs
026E                             ; into the NUL had unbalanced brackets anyway). D counts the open levels,
026E                             ; starting at 1 for the one we are in.
026E   16 01        SKIP:     MVI   D,1   
0270   0A           SK1:      LDAX   B   
0271   03                     INX   B   
0272   B7                     ORA   A   
0273   CA 78 00               JZ   endprog   
0276   FE 22                  CPI   22h   
0278   CC 9A 02               CZ   skipstr   ; leaves A = 22h, which matches nothing below
027B   FE 28                  CPI   "("   
027D   CA 94 02               JZ   sk3   
0280   FE 5B                  CPI   "["   
0282   CA 94 02               JZ   sk3   
0285   FE 29                  CPI   ")"   
0287   CA 8F 02               JZ   sk4   
028A   FE 5D                  CPI   "]"   
028C   C2 70 02               JNZ   sk1   
028F   15           SK4:      DCR   D   
0290   C8                     RZ      ; the closer at this level
0291   C3 70 02               JMP   sk1   
0294   14           SK3:      INR   D   ; an opener: one deeper (the DCR below makes
0295   14                     INR   D   ;   it +1 net, and can't reach zero)
0296   C3 8F 02               JMP   sk4   
0299                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
0299                             ; the next character, so "/"" does not end it.
0299   03           SS0:      INX   B   
029A   0A           SKIPSTR:   LDAX   B   
029B   03                     INX   B   
029C   FE 2F                  CPI   "/"   
029E   CA 99 02               JZ   ss0   
02A1   FE 22                  CPI   22h   
02A3   C2 9A 02               JNZ   skipstr   
02A6   C9                     RET      
02A7                             ; =============================================================================
02A7                             ;  Console
02A7                             ; =============================================================================
02A7                             ; 22h pushes the address of the text after it and skips the string.
02A7   E5           H_STR:    PUSH   H   
02A8   60                     MOV   H,B   
02A9   69                     MOV   L,C   
02AA   CD 9A 02               CALL   skipstr   
02AD   D7                     RST   2   
02AE                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
02AE                             ; 40h-7Fh clears its bit 6 (/M is CR, /` is space); plus anything lower gives
02AE                             ; that character itself.
02AE   7E           H_PRINT:   MOV   A,M   
02AF   23                     INX   H   
02B0   FE 22                  CPI   22h   
02B2   CA C9 02               JZ   prdone   
02B5   FE 2F                  CPI   "/"   
02B7   C2 C3 02               JNZ   pr1   
02BA   7E                     MOV   A,M   
02BB   23                     INX   H   
02BC   FE 40                  CPI   40h   
02BE   DA C3 02               JC   pr1   
02C1   E6 BF                  ANI   0BFh   
02C3   CD 03 FF     PR1:      CALL   putc   
02C6   C3 AE 02               JMP   h_print   
02C9   CF           PRDONE:   RST   1   
02CA   7D           H_EMIT:   MOV   A,L   ; "'"
02CB   CD 03 FF               CALL   putc   
02CE   CF                     RST   1   
02CF                             ; "#" prints TOS as a signed decimal number, with no space after it.
02CF   7C           H_NUM:    MOV   A,H   
02D0   B7                     ORA   A   
02D1   F2 DC 02               JP   num1   
02D4   3E 2D                  MVI   A,"-"   
02D6   CD 03 FF               CALL   putc   
02D9   CD 1D 01               CALL   neg16   
02DC   C5           NUM1:     PUSH   B   
02DD   CD E2 02               CALL   pdec   
02E0   C1                     POP   B   
02E1   CF                     RST   1   
02E2                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits)
02E2   11 0A 00     PDEC:     LXI   D,10   
02E5   CD 64 01               CALL   udiv   ; HL = HL / 10, BC = digit
02E8   79                     MOV   A,C   
02E9   F5                     PUSH   PSW   
02EA   7C                     MOV   A,H   
02EB   B5                     ORA   L   
02EC   C4 E2 02               CNZ   pdec   
02EF   F1                     POP   PSW   
02F0   C6 30                  ADI   "0"   
02F2   C3 03 FF               JMP   putc   
02F5                             ; "?" ( n -- c ) or ( -n -- addr )
02F5                             ;   n > 0: wait about n ms for a key; 0 if none came
02F5                             ;   n = 0: wait for a key
02F5                             ;   n < 0: read a line of at most -n characters, with echo. n is not
02F5                             ;          checked: the buffer holds 127 characters and the CR, so a
02F5                             ;          program must ask for 127 or fewer.
02F5   7C           H_KEY:    MOV   A,H   
02F6   B7                     ORA   A   
02F7   FA 1E 03               JM   line   
02FA   B5                     ORA   L   
02FB   C2 08 03               JNZ   kt1   
02FE   CD 92 03     KW:       CALL   getk   ; 0?: wait
0301   CA FE 02               JZ   kw   
0304   6F           KT3:      MOV   L,A   
0305   26 00                  MVI   H,0   
0307   D7                     RST   2   
0308   11 28 00     KT1:      LXI   D,MSLOOP   ; one millisecond, roughly
030B   CD 92 03     KT2:      CALL   getk   
030E   C2 04 03               JNZ   kt3   
0311   1B                     DCX   D   
0312   7A                     MOV   A,D   
0313   B3                     ORA   E   
0314   C2 0B 03               JNZ   kt2   
0317   2B                     DCX   H   
0318   7C                     MOV   A,H   
0319   B5                     ORA   L   
031A   C2 08 03               JNZ   kt1   
031D   D7                     RST   2   ; time ran out: HL is already 0
031E                          IF   CPM   
                                 ; CP/M: BDOS 10 does the editing (the spec allows the platform's
                                 ; own line editor). It doesn't store the CR, so it is added here.
                    LINE:     XRA   A   
                              SUB   L   ; A = the count (TOS is minus the count)
                              STA   LBHDR   
                              PUSH   B   
                              LXI   D,LBHDR   
                              MVI   C,10   
                              CALL   BDOS   
                              POP   B   
                              LXI   H,LBHDR+1   
                              MOV   A,M   ; count (0-127)
                              INX   H   ; HL = LINEBUF, whose low byte is 80h:
                              PUSH   H   
                              ADD   L   ;   adding the count to L can't carry
                              MOV   L,A   
                              MVI   M,13   
                              POP   H   
                              RST   2   
031E                          ENDIF      
031E                          IFN   CPM   
031E                             ; Generic: Backspace takes the last character back (and is echoed as
031E                             ; it is), CR ends (stored, not echoed), every other key is stored and
031E                             ; echoed until the line is full. The line buffer starts at offset 80h
031E                             ; of its page, so L alone is the place in the line: D holds the L of
031E                             ; a full line.
031E   3E 80        LINE:     MVI   A,LINEBUF & 0FFh   
0320   95                     SUB   L   ; (TOS is minus the count)
0321   57                     MOV   D,A   ; D = the L of a full line
0322   21 80 82               LXI   H,LINEBUF   
0325   CD 92 03     LN2:      CALL   getk   
0328   CA 25 03               JZ   ln2   
032B   FE 0D                  CPI   13   
032D   CA 4C 03               JZ   ln5   
0330   FE 08                  CPI   8   
0332   CA 44 03               JZ   ln4   
0335   5F                     MOV   E,A   
0336   7D                     MOV   A,L   
0337   BA                     CMP   D   
0338   CA 25 03               JZ   ln2   ; full
033B   73                     MOV   M,E   
033C   2C                     INR   L   
033D   7B                     MOV   A,E   
033E   CD 03 FF     LN3:      CALL   putc   
0341   C3 25 03               JMP   ln2   
0344   2D           LN4:      DCR   L   ; Backspace: one back, and echo it,
0345   FA 3E 03               JM   ln3   ;   unless the line was empty (L left the
0348   2C                     INR   L   ;   upper half of the page)
0349   C3 25 03               JMP   ln2   
034C   77           LN5:      MOV   M,A   ; the CR
034D   2E 80                  MVI   L,LINEBUF & 0FFh   
034F   D7                     RST   2   
0350                          ENDIF      
0350                             ; =============================================================================
0350                             ;  Machine code: the grave
0350                             ; =============================================================================
0350                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
0350                             ; are stored from addr until a non-hex character; then a RET (C9h) is
0350                             ; written and its address is left. An odd last digit is consumed and dropped.
0350                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
0350                             ; code is entered by CALL with the data stack above the return address; it
0350                             ; must keep BC, and on return the top cell becomes the new TOS.
0350   0A           H_GRAVE:   LDAX   B   
0351   CD 81 03               CALL   hexval   
0354   DA 7B 03               JC   exec   
0357   0A           HX1:      LDAX   B   
0358   CD 81 03               CALL   hexval   
035B   DA 75 03               JC   hx2   
035E   03                     INX   B   
035F   87                     ADD   A   
0360   87                     ADD   A   
0361   87                     ADD   A   
0362   87                     ADD   A   
0363   57                     MOV   D,A   
0364   0A                     LDAX   B   
0365   CD 81 03               CALL   hexval   
0368   DA 75 03               JC   hx2   ; odd digit: already consumed, dropped
036B   03                     INX   B   
036C   B2                     ORA   D   
036D                          IF   CHECKED   
036D   CD F8 01               CALL   chkst   
0370                          ENDIF      
0370   77                     MOV   M,A   
0371   23                     INX   H   
0372   C3 57 03               JMP   hx1   
0375                HX2:         
0375                          IF   CHECKED   
0375   CD F8 01               CALL   chkst   
0378                          ENDIF      
0378   36 C9                  MVI   M,0C9h   
037A   D7                     RST   2   
037B   CD 80 03     EXEC:     CALL   exjmp   ; the code returns here, with its top cell on
037E   E1                     POP   H   ;   the stack: that becomes the new TOS
037F   D7                     RST   2   
0380   E9           EXJMP:    PCHL      
0381                             ; hexval: A = a character; returns its value 0-15 with carry clear, or
0381                             ; carry set if it isn't a hex digit (0-9, A-F, a-f).
0381   D6 30        HEXVAL:   SUI   "0"   
0383   FE 0A                  CPI   10   
0385   3F                     CMC      
0386   D0                     RNC      
0387   E6 DF                  ANI   0DFh   
0389   D6 11                  SUI   11h   
038B   FE 06                  CPI   6   
038D   3F                     CMC      
038E   D8                     RC      
038F   C6 0A                  ADI   10   
0391   C9                     RET      
0392                             ; =============================================================================
0392                             ;  Console layer: getk returns a waiting key in A (zero flag clear), or
0392                             ;  A = 0 with the zero flag set when none is waiting. putc prints A.
0392                             ;  Both keep BC, DE and HL. In the generic build they are the host's KEY and
0392                             ;  CONOUT routines themselves.
0392                             ; =============================================================================
0392                          IF   (1-CPM)*(1-CHECKED)   
                    GETK:     EQU   KEY   ; the host's routine does the whole job
0392                          ENDIF      
0392                          IF   CHECKED   
0392   3A 36 82     GETK:     LDA   KEYBUF   ; a key held back by the break check
0395   B7                     ORA   A   
0396   CA 06 FF               JZ   gk1   
0399   F5                     PUSH   PSW   
039A   AF                     XRA   A   
039B   32 36 82               STA   KEYBUF   
039E   F1                     POP   PSW   
039F   C9                     RET      
03A0                          ENDIF      
03A0                          IF   (1-CPM)*CHECKED   
03A0                GK1:      EQU   KEY   
03A0                          ENDIF      
03A0                          IF   CPM*(1-CHECKED)   
                    GETK:        
03A0                          ENDIF      
03A0                          IF   CPM   
                    GK1:      MVI   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
                                 ; (putc ends with ORA A, for the zero flag)
                                 ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
                                 ; printing and could swallow a key that BDOS 6 then never sees.
                    PUTC:     PUSH   B   
                              PUSH   D   
                              PUSH   H   
                              MOV   E,A   
                              MVI   C,6   
                              CALL   BDOS   
                              POP   H   
                              POP   D   
                              POP   B   
                              ORA   A   
                              RET      
03A0                          ENDIF      
03A0                          IFN   CPM   
03A0                PUTC:     EQU   CONOUT   
03A0                          ENDIF      
03A0                             ; =============================================================================
03A0                             ;  Checked build: break key and error reports
03A0                             ; =============================================================================
03A0                          IF   CHECKED   
03A0                             ; chkbrk: a waiting key is read now; Ctrl-C stops the program, anything
03A0                             ; else is held for the next "?".
03A0   3A 36 82     CHKBRK:   LDA   KEYBUF   
03A3   B7                     ORA   A   
03A4   C0                     RNZ      ; one key is already held
03A5   CD 92 03               CALL   getk   
03A8   C8                     RZ      
03A9   FE 03                  CPI   3   
03AB   CA B8 03               JZ   e_break   
03AE   32 36 82               STA   KEYBUF   
03B1   C9                     RET      
03B2                             ; Error entries. Each loads its letter and then hides the next entry inside
03B2                             ; a 3-byte LXI H (the 21h), so they all fall through to `error`.
03B2   3E 53        E_STACK:   MVI   A,"S"   ; data stack over or under
03B4   21                     DB   21h   
03B5   3E 52        E_RSTACK:   MVI   A,"R"   ; return stack over or under
03B7   21                     DB   21h   
03B8   3E 42        E_BREAK:   MVI   A,"B"   ; Ctrl-C
03BA   21                     DB   21h   
03BB   3E 48        E_HEAP:   MVI   A,"H"   ; heap past the limit
03BD   21                     DB   21h   
03BE   3E 57        E_STORE:   MVI   A,"W"   ; write outside the program's space
03C0   21                     DB   21h   
03C1   3E 44        E_BRACK:   MVI   A,"D"   ; bad character after [
03C3                             ; error: print the letter in A, " @ " and the offset in the program of the
03C3                             ; character just read, then end. For example: S @ 245
03C3   31 FE 81     ERROR:    LXI   SP,DSTOP   ; the stacks may be wrecked: start clean
03C6   CD 03 FF               CALL   putc   
03C9   3E 20                  MVI   A," "   
03CB   CD 03 FF               CALL   putc   
03CE   3E 40                  MVI   A,"@"   
03D0   CD 03 FF               CALL   putc   
03D3   3E 20                  MVI   A," "   
03D5   CD 03 FF               CALL   putc   
03D8   21 FF 7C               LXI   H,(0-PROG-1)&0FFFFh   
03DB   09                     DAD   B   ; IP - (PROG+1): the character just read
03DC   CD E2 02               CALL   pdec   
03DF   C3 78 00               JMP   endprog   
03E2                          ENDIF      
03E2                             ; =============================================================================
03E2                             ;  Startup
03E2                             ; =============================================================================
03E2                START:       
03E2                          IF   CPM   
                              LXI   SP,DSTOP   
                                 ; CP/M: the RAM pages follow the image; the heap may grow to the BDOS
                              LXI   H,stubs   ; RST 08h and RST 10h stubs into page zero
                              LXI   D,0008h   
                              MVI   B,12   
                    CPY:      MOV   A,M   
                              STAX   D   
                              INX   H   
                              INX   D   
                              DCR   B   
                              JNZ   cpy   
                              LXI   D,005Ch   ; open the file named on the command line
                              MVI   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LXI   D,PROG   
                    LD1:      PUSH   D   
                              MVI   C,26   ; set the DMA address
                              CALL   BDOS   
                              LXI   D,005Ch   
                              MVI   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   H   ; HL = the address this record went to
                              ORA   A   
                              JNZ   ld2   
                              LXI   D,128   
                              DAD   D   
                              XCHG      
                              JMP   ld1   
                    LD2:      MVI   M,0   ; the end of the file counts as NUL
                              INX   H   
                              SHLD   HEAP   
                              LDA   0007h   ; the BDOS page is the heap limit
                              STA   HLIM   
03E2                          ENDIF      
03E2                          IFN   CPM   
03E2   21 00 83               LXI   H,PROG   ; the heap starts after the program's NUL
03E5   7E           FNUL:     MOV   A,M   
03E6   23                     INX   H   
03E7   B7                     ORA   A   
03E8   C2 E5 03               JNZ   fnul   
03EB   22 7C 82               SHLD   HEAP   
03EE                          ENDIF      
03EE                          IF   (1-CPM)*CHECKED   
03EE   3E F0                  MVI   A,HEAPLIM   
03F0   32 3A 82               STA   HLIM   
03F3                          ENDIF      
03F3   21 E0 80               LXI   H,RSTOP   
