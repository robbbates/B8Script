02B9                          DS   (1-CPM)*(1-FAST),0DFh   
02B9   E1                     DS   CPM+FAST-CPM*FAST,0E1h   
02BA   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
02BB   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
02BC                          ENDIF      
02BC   7D           H_EMIT:   LD   A,L   ; "'"
02BD                          ;*Macro unroll:  PUTA
02BD                          DS   1-CPM,0EFh   
02BD   CD                     DS   CPM,0CDh   
02BE   C2                     DS   CPM,APUT&0FFh   
02BF   05                     DS   CPM,APUT/256   
02C0                          ;*Macro unroll: pr9:    DROP
02C0                PR9:      DS   (1-CPM)*(1-FAST),0DFh   
02C0   E1                     DS   CPM+FAST-CPM*FAST,0E1h   
02C1   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
02C2   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
02C3                             ; "#" prints TOS as a signed decimal number, with no space after it.
02C3   CD 1A 05     H_NUM:    CALL   psgn   
02C6                          ;*Macro unroll:  DROP
02C6                          DS   (1-CPM)*(1-FAST),0DFh   
02C6   E1                     DS   CPM+FAST-CPM*FAST,0E1h   
02C7   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
02C8   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
02C9                             ; "?" ( n -- c ) or ( -n -- addr )
02C9                             ;   n > 0: wait about n ms for a key; 0 if none came
02C9                             ;   n = 0: wait for a key
02C9                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
02C9                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
02C9   CB 7C        H_KEY:    BIT   7,H   
02CB   20 1A                  JR   NZ,line   
02CD   1E 04        KT1:      LD   E,MSLOOP   ; one millisecond, roughly
02CF   CD 86 05     KT2:      CALL   getk   
02D2   20 0E                  JR   NZ,kt3   
02D4   1D                     DEC   E   
02D5   20 F8                  JR   NZ,kt2   
02D7   7C                     LD   A,H   ; 0? never counts down: it waits
02D8   B5                     OR   L   
02D9   28 F2                  JR   Z,kt1   
02DB   2B                     DEC   HL   
02DC   7C                     LD   A,H   
02DD   B5                     OR   L   
02DE   20 ED                  JR   NZ,kt1   ; A = 0 if the time ran out
02E0   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
02E1   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
02E2   6F           KT3:      LD   L,A   
02E3   26 00                  LD   H,0   
02E5                          ;*Macro unroll:  NEXT
02E5                          DS   (1-CPM)*(1-FAST),0F7h   
02E5   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
02E6   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
02E7                             ; Backspace takes the last character back (and is echoed as it
02E7                             ; is), CR ends (stored, not echoed), every other key is stored and
02E7                             ; echoed until the line is full. (CP/M too: getk reads through BDOS
02E7                             ; 6.) The line buffer starts at offset 80h of its page, so L alone
02E7                             ; is the place in the line: D holds the L of a full line.
02E7   11 7F 00     LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
02EA   19                     ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
02EB   9F                     SBC   A,A   
02EC   A5                     AND   L   ; (0 for a count that is too big)
02ED   2F                     CPL      
02EE   57                     LD   D,A   ; D = the L of a full line: 80h + count, FFh
02EF                             ;   at most
02EF   21 80 0B               LD   HL,LINEBUF   
02F2   CD 86 05     LN2:      CALL   getk   
02F5   28 FB                  JR   Z,ln2   
02F7   FE 0D                  CP   13   
02F9   28 18                  JR   Z,ln5   
02FB   FE 08                  CP   8   
02FD   28 0D                  JR   Z,ln4   
02FF   5F                     LD   E,A   
0300   7D                     LD   A,L   
0301   BA                     CP   D   
0302   28 EE                  JR   Z,ln2   ; full
0304   73                     LD   (HL),E   
0305   2C                     INC   L   
0306   7B                     LD   A,E   
0307                          ;*Macro unroll: ln3:    PUTA
0307                LN3:      DS   1-CPM,0EFh   
0307   CD                     DS   CPM,0CDh   
0308   C2                     DS   CPM,APUT&0FFh   
0309   05                     DS   CPM,APUT/256   
030A   18 E6                  JR   ln2   
030C   2D           LN4:      DEC   L   ; Backspace: one back, and echo it,
030D   FA 07 03               JP   M,ln3   ;   unless the line was empty (L left the
0310   2C                     INC   L   ;   upper half of the page)
0311   18 DF                  JR   ln2   
0313   77           LN5:      LD   (HL),A   ; the CR
0314   2E 80                  LD   L,LINEBUF & 0FFh   
0316                          ;*Macro unroll:  NEXT
0316                          DS   (1-CPM)*(1-FAST),0F7h   
0316   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0317   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0318                             ; =============================================================================
0318                             ;  More routines (no handler starts past this point)
0318                             ; =============================================================================
0318                          IF   CHECKED   
0318                             ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
0318                             ; "$", and the texts of the report). A NUL first is an error: Q.
0318   7E           PRSTR:    LD   A,(HL)   
0319   23                     INC   HL   
031A   FE 22                  CP   22h   
031C   C8                     RET   Z   
031D   B7                     OR   A   
031E   CA 44 06               JP   Z,e_dollar   
0321   FE 2F                  CP   "/"   
0323   20 0C                  JR   NZ,prs1   
0325   7E                     LD   A,(HL)   
0326   23                     INC   HL   
0327   FE 60                  CP   60h   
0329   38 04                  JR   C,prs0   
032B   FE 7F                  CP   7Fh   
032D   38 13                  JR   C,pesc   
032F   E6 BF        PRS0:     AND   0BFh   
0331                          ;*Macro unroll: prs1:   PUTA
0331                PRS1:     DS   1-CPM,0EFh   
0331   CD                     DS   CPM,0CDh   
0332   C2                     DS   CPM,APUT&0FFh   
0333   05                     DS   CPM,APUT/256   
0334   18 E2                  JR   prstr   
0336                PRLOOP:   EQU   prstr   ; (where the escapes go back to)
0336                PRAGAIN:   EQU   hp1   ; (and where /~ goes back to)
0336                             ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
0336                             ; pnl: the same, on a new line.
0336   CD 3C 03     PNL:      CALL   pmsg   ; (pmsg's own CR LF, then on into pmsg for
0339   0D 0A 22               DB   13,10,22h   ;   the caller's text)
033C   E3           PMSG:     EX   (SP),HL   
033D   CD 18 03               CALL   prstr   
0340   E3                     EX   (SP),HL   
0341   C9                     RET      
0342                          ENDIF      
0342                             ; pesc: the escapes of "$". A = the character after the "/", 60h to 7Eh, and
0342                             ; HL points past it. Each goes back into the loop that prints the string
0342                             ; (PRLOOP), but /~ has the stack to see to, and goes back by PRAGAIN.
0342                             ;    /a-/z   print the variable, as "#" does
0342                             ;    /{      clear the screen, the cursor to the top left
0342                             ;    /}      clear from the cursor to the end of the line
0342                             ;    /|  /`  show the cursor, hide it
0342                             ;    /~      ( row col -- ) the cursor to that row and column, from 0
0342   FE 7E        PESC:     CP   7Eh   
0344   28 1C                  JR   Z,pat   
0346   11 18 03               LD   DE,PRLOOP   ; the others return into the loop
0349   D5                     PUSH   DE   
034A   D6 7B                  SUB   7Bh   ; 00bbIDAsIHwgMSwg 2, and no borrow
034C   30 4A                  JR   NC,pcon   
034E   C6 1A                  ADD   A,1Ah   ; a-z: 0-25, and a carry; `: FFh, and none
0350   30 37                  JR   NC,phide   
0352   87                     ADD   A,A   ; the variable's cell
0353   C6 40                  ADD   A,40h   
0355   E5                     PUSH   HL   
0356   6F                     LD   L,A   
0357   26 0B                  LD   H,LETPAGE   
0359   7E                     LD   A,(HL)   
035A   2C                     INC   L   
035B   66                     LD   H,(HL)   
035C   6F                     LD   L,A   
035D   CD 1A 05               CALL   psgn   
0360   E1                     POP   HL   
0361   C9                     RET      
0362                             ; /~ ( row col addr -- ): the two cells under the string's address go. In
0362                             ; the checked build "$" is the routine prstr: its own return address goes
0362                             ; first, and hp1 calls it again afterwards. There each /~ first looks that
0362                             ; its two cells are there, and is s if not, before it prints anything.
0362                PAT:         
0362                          IF   CHECKED   
0362   E3                     EX   (SP),HL   ; the text pointer over prstr's return address
0363   21 0A F5               LD   HL,(6-DSTOP)&0FFFFh   ; a carry: the two cells aren't there
0366   39                     ADD   HL,SP   
0367   DA FE 05               JP   C,e_under   
036A   E1                     POP   HL   
036B                          ENDIF      
036B   D1                     POP   DE   ; DE = the column
036C   E3                     EX   (SP),HL   ; HL = the row; the text pointer is kept
036D                          IF   1-ANS   
                              CALL   CONAT   
                              POP   HL   
                              JP   PRAGAIN   
                                 ; With ANSI = 0 the machine's routines do the rest.
                    PCON:     JP   Z,CONCLS   ; /{
                              CP   2   
                              JP   Z,CONEOL   ; /}
                              DB   0FEh   ; /|  (CP n steps over the XOR: A = 1, show)
                    PHIDE:    XOR   A   ; /`  (A = 0: hide)
                              JP   CONCUR   
036D                          ENDIF      
036D                          IF   ANS   
036D   D5                     PUSH   DE   
036E   CD AC 03               CALL   csi   ; ESC [ row+1 ; col+1 H (ANSI counts from 1)
0371   23                     INC   HL   
0372   CD 25 05               CALL   pdec   
0375                          ;*Macro unroll:  PUTK    3Bh             ; ';'
0375                          DS   1-CPM,3Eh   ; ";"
0375                          DS   1-CPM,3Bh   
0375                          DS   1-CPM,0EFh   
0375   CD                     DS   CPM,0CDh   
0376   BE                     DS   CPM,APTK&0FFh   
0377   05                     DS   CPM,APTK/256   
0378   3B                     DS   CPM,3Bh   
0379   E1                     POP   HL   
037A   23                     INC   HL   
037B   CD 25 05               CALL   pdec   
037E                          ;*Macro unroll:  PUTK    48h             ; 'H'
037E                          DS   1-CPM,3Eh   ; "H"
037E                          DS   1-CPM,48h   
037E                          DS   1-CPM,0EFh   
037E   CD                     DS   CPM,0CDh   
037F   BE                     DS   CPM,APTK&0FFh   
0380   05                     DS   CPM,APTK/256   
0381   48                     DS   CPM,48h   
0382   E1                     POP   HL   
0383   C3 B6 02               JP   PRAGAIN   
0386                             ; With ANSI = 1 they are sequences. The carry is clear on the way in.
0386   1E 68        PSHOW:    LD   E,"h"   ; /|  ESC [ ? 2 5 h
0388   DA                     DB   0DAh   ; (JP C,nn: with no carry it steps over two bytes)
0389   1E 6C        PHIDE:    LD   E,"l"   ; /`  ESC [ ? 2 5 l
038B                          ENDIF      
038B                          IF   ANS*CHECKED   
038B                             ; (The checked build prints the fixed parts with pmsg, which it has for the
038B                             ; report: shorter than a character at a time.)
038B   CD 3C 03               CALL   pmsg   
038E   1B 5B 3F 32 35 22      DB   27,"[?25",22h   
0394   7B           PSE:      LD   A,E   ; then E
0395                          ;*Macro unroll:  PUTAR
0395                          DS   1-CPM,0EFh   
0395                          DS   1-CPM,0C9h   
0395   C3                     DS   CPM,0C3h   
0396   C2                     DS   CPM,APUT&0FFh   
0397   05                     DS   CPM,APUT/256   
0398                             ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into cse.
0398   3D           PCON:     DEC   A   
0399   28 EB                  JR   Z,pshow   ; /|
039B   1E 4B                  LD   E,"K"   
039D   F2 A7 03               JP   P,cse   ; /}  ESC [ K
03A0   1E 48                  LD   E,"H"   ; /{  ESC [ H ESC [ J
03A2   CD A7 03               CALL   cse   
03A5   1E 4A                  LD   E,"J"   ; (on into cse)
03A7                             ; cse: ESC [ and then E. csi: ESC [. Both keep HL.
03A7   CD AC 03     CSE:      CALL   csi   
03AA   18 E8                  JR   pse   
03AC   CD 3C 03     CSI:      CALL   pmsg   
03AF   1B 5B 22               DB   27,"[",22h   
03B2   C9                     RET      
03B3                          ENDIF      
03B3                          IF   ANS*(1-CHECKED)   
                              LD   A,"?"   
                              CALL   csia   
                              ;*Macro unroll:  PUTK    32h             ; '2'
                              DS   1-CPM,3Eh   ; "2"
                              DS   1-CPM,32h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,32h   
                              ;*Macro unroll:  PUTK    35h             ; '5'
                              DS   1-CPM,3Eh   ; "5"
                              DS   1-CPM,35h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,35h   
                              LD   A,E   
                              ;*Macro unroll:  PUTAR
                              DS   1-CPM,0EFh   
                              DS   1-CPM,0C9h   
                              DS   CPM,0C3h   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                                 ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into csia.
                    PCON:     DEC   A   
                              JR   Z,pshow   ; /|
                              LD   A,"K"   
                              JP   P,csia   ; /}  ESC [ K
                              LD   A,"H"   ; /{  ESC [ H ESC [ J
                              CALL   csia   
                              LD   A,"J"   ; (on into csia)
                                 ; csia: ESC [ and then A. csi: ESC [, keeping A.
                    CSIA:     CALL   csi   
                              ;*Macro unroll:  PUTAR
                              DS   1-CPM,0EFh   
                              DS   1-CPM,0C9h   
                              DS   CPM,0C3h   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                    CSI:      PUSH   AF   
                              ;*Macro unroll:  PUTK    1Bh             ; ESC
                              DS   1-CPM,3Eh   ; ESC
                              DS   1-CPM,1Bh   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,1Bh   
                              ;*Macro unroll:  PUTK    5Bh             ; '['
                              DS   1-CPM,3Eh   ; "["
                              DS   1-CPM,5Bh   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,5Bh   
                              POP   AF   
                              RET      
03B3                          ENDIF      
03B3                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
03B3                             ; Uses A; keeps BC (the IP) itself. The dividend shifts up through A:C while
03B3                             ; the quotient bits arrive at the bottom of C.
03B3                             ; Dividing by 2 is one shift (the spec wants that fast).
03B3                          IF   1-QK   
                    UDIV:     LD   A,E   
                              XOR   2   
                              OR   D   
                              JR   NZ,udv0   
                              SRL   H   
                              RR   L   ; the quotient
                              ADC   A,A   
                              LD   E,A   ; the remainder: the bit that fell out (D is 0)
                              RET      
03B3                          ENDIF      
03B3                          IF   QK   
03B3                             ; (The builds with room divide by any power of two with shifts: 2, and 32,
03B3                             ; 64, 256 and the like, which fixed point and byte work use all the time.)
03B3   7A           UDIV:     LD   A,D   
03B4   B7                     OR   A   
03B5   20 1A                  JR   NZ,uq1   ; 256 and up
03B7   B3                     OR   E   
03B8   28 33                  JR   Z,udv0   ; by 0: the long way (it means nothing anyway)
03BA   3D                     DEC   A   
03BB   A3                     AND   E   
03BC   20 2F                  JR   NZ,udv0   ; not a power of two
03BE   7B                     LD   A,E   ; by 2^k below 256: q = HL >> k, and
03BF   3D                     DEC   A   ;   r = L & (2^k - 1)
03C0   A5                     AND   L   
03C1   F5                     PUSH   AF   
03C2   CB 3B        UQ2:      SRL   E   
03C4   38 06                  JR   C,uq3   
03C6   CB 3C                  SRL   H   
03C8   CB 1D                  RR   L   
03CA   18 F6                  JR   uq2   
03CC   F1           UQ3:      POP   AF   
03CD   5F                     LD   E,A   
03CE   16 00                  LD   D,0   
03D0   C9                     RET      
03D1   7B           UQ1:      LD   A,E   
03D2   B7                     OR   A   
03D3   20 18                  JR   NZ,udv0   
03D5   7A                     LD   A,D   
03D6   3D                     DEC   A   
03D7   A2                     AND   D   
03D8   20 13                  JR   NZ,udv0   ; not a power of two
03DA   7A                     LD   A,D   ; by 2^k, 256 and up: q = H >> (k - 8), and
03DB   3D                     DEC   A   ;   r = HL & (2^k - 1)
03DC   A4                     AND   H   
03DD   5F                     LD   E,A   ; (the remainder's high byte,
03DE   7D                     LD   A,L   ;   and its low byte)
03DF   6C                     LD   L,H   
03E0   26 00                  LD   H,0   
03E2   CB 3A        UQ4:      SRL   D   
03E4   38 04                  JR   C,uq5   
03E6   CB 3D                  SRL   L   
03E8   18 F8                  JR   uq4   
03EA   53           UQ5:      LD   D,E   
03EB   5F                     LD   E,A   
03EC   C9                     RET      
03ED                          ENDIF      
03ED                          IF   1-FAST   
03ED   C5           UDV0:     PUSH   BC   
03EE   7C                     LD   A,H   
03EF   4D                     LD   C,L   
03F0   21 00 00               LD   HL,0   
03F3   06 10                  LD   B,16   
03F5   CB 21        UDV1:     SLA   C   
03F7   17                     RLA      
03F8   ED 6A                  ADC   HL,HL   
03FA   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
03FC   30 02                  JR   NC,udv2   ;   always fits in 16 bits
03FE   19                     ADD   HL,DE   ; too much: put it back, and cancel the
03FF   0D                     DEC   C   ;   INC below
0400   0C           UDV2:     INC   C   ; a quotient bit
0401   10 F2                  DJNZ   udv1   
0403   EB                     EX   DE,HL   ; DE = remainder
0404   67                     LD   H,A   
0405   69                     LD   L,C   ; HL = quotient
0406   C1                     POP   BC   
0407   C9                     RET      
0408                          ENDIF      
0408                          IF   FAST   
                                 ; (the fast build: the same 16 rounds, unrolled)
                    UDV0:     PUSH   BC   
                              LD   A,H   
                              LD   C,L   
                              LD   HL,0   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr0   
                              ADD   HL,DE   
                              DEC   C   
                    UVR0:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr1   
                              ADD   HL,DE   
                              DEC   C   
                    UVR1:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr2   
                              ADD   HL,DE   
                              DEC   C   
                    UVR2:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr3   
                              ADD   HL,DE   
                              DEC   C   
                    UVR3:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr4   
                              ADD   HL,DE   
                              DEC   C   
                    UVR4:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr5   
                              ADD   HL,DE   
                              DEC   C   
                    UVR5:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr6   
                              ADD   HL,DE   
                              DEC   C   
                    UVR6:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr7   
                              ADD   HL,DE   
                              DEC   C   
                    UVR7:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr8   
                              ADD   HL,DE   
                              DEC   C   
                    UVR8:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr9   
                              ADD   HL,DE   
                              DEC   C   
                    UVR9:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr10   
                              ADD   HL,DE   
                              DEC   C   
                    UVR10:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr11   
                              ADD   HL,DE   
                              DEC   C   
                    UVR11:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr12   
                              ADD   HL,DE   
                              DEC   C   
                    UVR12:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr13   
                              ADD   HL,DE   
                              DEC   C   
                    UVR13:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr14   
                              ADD   HL,DE   
                              DEC   C   
                    UVR14:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr15   
                              ADD   HL,DE   
                              DEC   C   
                    UVR15:    INC   C   
                              EX   DE,HL   ; DE = remainder
                              LD   H,A   
                              LD   L,C   ; HL = quotient
                              POP   BC   
                              RET      
0408                          ENDIF      
0408                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
0408                             ; non-digit. Values wrap at 16 bits, as the spec says.
0408   21 00 00     RDNUM:    LD   HL,0   
040B   0A           RDN1:     LD   A,(BC)   
040C   D6 30                  SUB   "0"   
040E   FE 0A                  CP   10   
0410   D0                     RET   NC   
0411   03                     INC   BC   
0412   54                     LD   D,H   
0413   5D                     LD   E,L   
0414   29                     ADD   HL,HL   
0415   29                     ADD   HL,HL   
0416   19                     ADD   HL,DE   
0417   29                     ADD   HL,HL   ; HL * 10
0418   5F                     LD   E,A   
0419   16 00                  LD   D,0   
041B   19                     ADD   HL,DE   
041C   18 ED                  JR   rdn1   
041E                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
041E                             ; the next character, so "/"" does not end it. Leaves A = 22h.
041E                          IF   1-CHECKED   
                    SS0:      INC   BC   
                    SKIPSTR:   LD   A,(BC)   
                              INC   BC   
                              CP   "/"   
                              JR   Z,ss0   
                              CP   22h   
                              JR   NZ,skipstr   
                              RET      
041E                          ENDIF      
041E                          IF   CHECKED   
041E                             ; The checked build never steps over a NUL: if the text runs out first it
041E                             ; returns A = 0 with the IP on the NUL.
041E   0A           SKIPSTR:   LD   A,(BC)   
041F   B7                     OR   A   
0420   C8                     RET   Z   
0421   03                     INC   BC   
0422   FE 22                  CP   22h   
0424   C8                     RET   Z   
0425   FE 2F                  CP   "/"   
0427   20 F5                  JR   NZ,skipstr   
0429   0A                     LD   A,(BC)   ; the escaped character
042A   B7                     OR   A   
042B   C8                     RET   Z   
042C   03                     INC   BC   
042D   18 EF                  JR   skipstr   
042F                          ENDIF      
042F                             ; skip: read past text to the closer at this level, and return A = 0 if it
042F                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
042F                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
042F                             ; no closer; anything else that runs into the NUL had unbalanced brackets
042F                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
042F                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
042F                             ; 
042F                             ; The checked build also looks at the character the skip was started by,
042F                             ; which is always the one just before where it starts: "(" must end at ")",
042F                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
042F                             ; quote counts as running into it. "\" takes either closer. SKPL keeps the
042F                             ; place where the skip started, for the report.
042F                          IF   1-QK   
                                 ; (Without base: no skip cache.)
                    SKIP:        
042F                          ENDIF      
042F                          IF   CHECKED*(1-QK)   
                              LD   (SKPL),BC   
                              DEC   BC   
                              LD   A,(BC)   
                              INC   BC   
                              LD   E,A   ; E = the opener: ( [ or \
042F                          ENDIF      
042F                          IF   1-QK   
                              LD   D,0   
                    SK3:      INC   D   ; an opener: one deeper
                    SK1:      LD   A,(BC)   
042F                          ENDIF      
042F                          IF   (1-CHECKED)*(1-QK)   
                              INC   BC   
                              OR   A   
                              JP   Z,SKEND   ; (the end of the program)
042F                          ENDIF      
042F                          IF   CHECKED*(1-QK)   
                              OR   A   
                              JR   Z,sk6   ; (the IP stays on the NUL)
                              INC   BC   
042F                          ENDIF      
042F                          IF   1-QK   
                              CP   22h   
                              CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
                              SUB   "("   ;   (or 0, and then the NUL is read next)
                              JR   Z,sk3   
                              DEC   A   ; ")"
                              JR   Z,sk4   
                              SUB   "["-")"   
                              JR   Z,sk3   
                              CP   "]"-"["   
                              JR   NZ,sk1   
                    SK4:      DEC   D   
042F                          ENDIF      
042F                          IF   (1-CHECKED)*(1-QK)   
                              RET   Z   ; the closer at this level
                              JR   sk1   
042F                          ENDIF      
042F                          IF   CHECKED*(1-QK)   
                              JR   NZ,sk1   
                              LD   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
                              XOR   E   ;   opener is 0 for "(" and 1 for "[", and only
                              AND   6   ;   "\" has bit 2: so this is 2 for the wrong
                              CP   2   ;   closer, and only then
                              LD   A,D   
                              RET   NZ   
                              JR   sk7   
                    SK6:      BIT   2,E   ; the text ran out:
                              JP   NZ,SKEND   ;   "\" with no closer ends the program
                    SK7:      LD   BC,(SKPL)   ; N. The place is the opener
                              LD   A,"N"   
                              JP   errp   ; (errp drops skip's return address)
042F                          ENDIF      
042F                          IF   QK   
042F                             ; The skip cache. Nearly every skip is one that has happened before (a loop
042F                             ; skips the same false block on every pass), so the first scan from each
042F                             ; place is remembered: 64 entries of 00bbc3RhcnQsIGVuZA==, at CPAGE, found by the
042F                             ; start's low byte. Only skips that start in the program text are kept (the
042F                             ; line buffer changes); the cache is emptied whenever a run starts (skclr).
042F                             ; A program that changes its own text while it runs is not looked after.
042F   ED 43 3C 0B  SKIP:     LD   (SKPL),BC   ; where it starts: the cache's key (and the
0433   78                     LD   A,B   ;   checked report's place)
0434   FE 0C                  CP   PROG/256   
0436   38 1B                  JR   C,sks   ; below the program text: no cache
0438   79                     LD   A,C   
0439   87                     ADD   A,A   
043A   87                     ADD   A,A   
043B   5F                     LD   E,A   
043C   16 08                  LD   D,CPAGE   ; DE -> the entry
043E   1A                     LD   A,(DE)   
043F   B9                     CP   C   
0440   20 11                  JR   NZ,sks   
0442   1C                     INC   E   
0443   1A                     LD   A,(DE)   
0444   B8                     CP   B   
0445   20 0C                  JR   NZ,sks   
0447   1C                     INC   E   
0448   1A                     LD   A,(DE)   
0449   4F                     LD   C,A   
044A   1C                     INC   E   
044B   1A                     LD   A,(DE)   
044C   47                     LD   B,A   ; a hit: the IP is past the closer
044D   0B                     DEC   BC   
044E   0A                     LD   A,(BC)   
044F   03                     INC   BC   
0450   D6 29                  SUB   ")"   ; 0 for ")", not 0 for "]"
0452   C9                     RET      
0453                SKS:         
0453                          ENDIF      
0453                          IF   QK*CHECKED   
0453   0B                     DEC   BC   
0454   0A                     LD   A,(BC)   
0455   03                     INC   BC   
0456   5F                     LD   E,A   ; E = the opener: ( [ or \
0457                          ENDIF      
0457                          IF   QK   
0457                             ; The scan. Most characters are nothing to it, and two range tests rule
0457                             ; them out: * to Z, and ^ and up. Only NUL " ( ) [ ] count.
0457   16 00                  LD   D,0   
0459   14           SQ3:      INC   D   ; an opener: one deeper
045A   0A           SQ1:      LD   A,(BC)   
045B   03                     INC   BC   
045C   FE 5E                  CP   5Eh   
045E   30 FA                  JR   NC,sq1   ; ^ _ ` a-z 00bbIHwg ~ and up: nothing
0460   FE 5B                  CP   5Bh   
0462   30 25                  JR   NC,sqb   ; [ \ ]
0464   FE 2A                  CP   2Ah   
0466   30 F2                  JR   NC,sq1   ; * to Z: nothing
0468   FE 28                  CP   28h   
046A   28 ED                  JR   Z,sq3   ; (
046C   30 25                  JR   NC,sqc   ; )
046E   FE 22                  CP   22h   
0470   28 12                  JR   Z,sqq   ; a string
0472   B7                     OR   A   
0473   20 E5                  JR   NZ,sq1   ; the rest below "(": nothing
0475                          ENDIF      
0475                          IF   QK*(1-CHECKED)   
                              JP   SKEND   ; NUL: the end of the program
0475                          ENDIF      
0475                          IF   QK*CHECKED   
0475   0B                     DEC   BC   ; NUL: the IP stays on it
0476   CB 53                  BIT   2,E   ; the text ran out:
0478   C2 00 00               JP   NZ,SKEND   ;   "\" with no closer ends the program
047B   ED 4B 3C 0B  SQ7:      LD   BC,(SKPL)   ; N. The place is the opener
047F   3E 4E                  LD   A,"N"   
0481   C3 41 06               JP   errp   ; (errp drops skip's return address)
0484                          ENDIF      
0484                          IF   QK   
0484   CD 1E 04     SQQ:      CALL   skipstr   ; step over the string
0487   18 D1                  JR   sq1   
0489   D6 5C        SQB:      SUB   5Ch   ; [ -1, \ 0, ] 1
048B   28 CD                  JR   Z,sq1   ; "\" is nothing here
048D   38 CA                  JR   C,sq3   ; [
048F   3E 02                  LD   A,2   ; ]
0491   18 01                  JR   sq4   
0493   AF           SQC:      XOR   A   ; )
0494   15           SQ4:      DEC   D   
0495   20 C3                  JR   NZ,sq1   
0497                          ENDIF      
0497                          IF   QK*CHECKED   
0497   57                     LD   D,A   ; the closer at this level (as above): 2 here
0498   AB                     XOR   E   ;   means the wrong closer
0499   E6 06                  AND   6   
049B   FE 02                  CP   2   
049D   7A                     LD   A,D   
049E   28 DB                  JR   Z,sq7   
04A0                          ENDIF      
04A0                          IF   QK   
04A0                             ; The closer at this level: remember the skip (if it started in the program
04A0                             ; text), and return A = 0 for ")" or 2 for "]".
04A0   F5                     PUSH   AF   
04A1   E5                     PUSH   HL   
04A2   2A 3C 0B               LD   HL,(SKPL)   
04A5   7C                     LD   A,H   
04A6   FE 0C                  CP   PROG/256   
04A8   38 11                  JR   C,sq9   
04AA   7D                     LD   A,L   
04AB   87                     ADD   A,A   
04AC   87                     ADD   A,A   
04AD   5F                     LD   E,A   
04AE   16 08                  LD   D,CPAGE   
04B0   7D                     LD   A,L   
04B1   12                     LD   (DE),A   
04B2   1C                     INC   E   
04B3   7C                     LD   A,H   
04B4   12                     LD   (DE),A   
04B5   1C                     INC   E   
04B6   79                     LD   A,C   
04B7   12                     LD   (DE),A   
04B8   1C                     INC   E   
04B9   78                     LD   A,B   
04BA   12                     LD   (DE),A   
04BB   E1           SQ9:      POP   HL   
04BC   F1                     POP   AF   
04BD   C9                     RET      
04BE                             ; skclr: empty the skip cache (a start of 0000h matches no skip). Keeps HL.
04BE   E5           SKCLR:    PUSH   HL   
04BF   21 00 08               LD   HL,CPAGE*256   
04C2   36 00        SKC1:     LD   (HL),0   
04C4   2C                     INC   L   
04C5   20 FB                  JR   NZ,skc1   
04C7   E1                     POP   HL   
04C8   C9                     RET      
04C9                          ENDIF      
04C9                             ;  ---- Speed-ups (base builds) -------------------------------------------
04C9                             ;  The skip cache is above. These are the handlers' tails that the builds with
04C9                             ;  room take, kept here, out of the handlers' first two pages.
04C9                          IF   QK   
04C9                             ; "*" with an operand below 256 takes 8 rounds, not 16: that one becomes the
04C9                             ; multiplier (most multiplications have one, a count or a small constant).
04C9   7C           MULQ:     LD   A,H   
04CA   B7                     OR   A   
04CB   28 05                  JR   Z,mq8   ; the multiplier is below 256
04CD   7A                     LD   A,D   
04CE   B7                     OR   A   
04CF   20 12                  JR   NZ,mq16   
04D1   EB                     EX   DE,HL   ; the multiplicand is: it becomes the multiplier
04D2                          ENDIF      
04D2                          IF   QK*(1-FAST)   
04D2   7D           MQ8:      LD   A,L   
04D3   21 00 00               LD   HL,0   
04D6   C5                     PUSH   BC   
04D7   06 08                  LD   B,8   
04D9   29           MQ1:      ADD   HL,HL   
04DA   17                     RLA      
04DB   30 01                  JR   NC,mq2   
04DD   19                     ADD   HL,DE   
04DE   10 F9        MQ2:      DJNZ   mq1   
04E0   C1                     POP   BC   
04E1                          ;*Macro unroll:  NEXT
04E1                          DS   (1-CPM)*(1-FAST),0F7h   
04E1   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
04E2   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
04E3   C5           MQ16:     PUSH   BC   ; 16 rounds; the multiplier shifts up through A:C
04E4   7C                     LD   A,H   
04E5   4D                     LD   C,L   
04E6   21 00 00               LD   HL,0   
04E9   06 10                  LD   B,16   
04EB   29           MQ3:      ADD   HL,HL   
04EC   CB 21                  SLA   C   
04EE   17                     RLA      
04EF   30 01                  JR   NC,mq4   
04F1   19                     ADD   HL,DE   
04F2   10 F7        MQ4:      DJNZ   mq3   
04F4   C1                     POP   BC   
04F5                          ;*Macro unroll:  NEXT
04F5                          DS   (1-CPM)*(1-FAST),0F7h   
04F5   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
04F6   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
04F7                          ENDIF      
04F7                          IF   FAST   
                                 ; (the fast build: the same rounds, unrolled)
                    MQ8:      LD   A,L   
                              LD   HL,0   
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur0   
                              ADD   HL,DE   
                    MUR0:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur1   
                              ADD   HL,DE   
                    MUR1:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur2   
                              ADD   HL,DE   
                    MUR2:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur3   
                              ADD   HL,DE   
                    MUR3:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur4   
                              ADD   HL,DE   
                    MUR4:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur5   
                              ADD   HL,DE   
                    MUR5:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur6   
                              ADD   HL,DE   
                    MUR6:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur7   
                              ADD   HL,DE   
                    MUR7:        
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
                    MQ16:     PUSH   BC   
                              LD   A,H   
                              LD   C,L   
                              LD   HL,0   
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus0   
                              ADD   HL,DE   
                    MUS0:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus1   
                              ADD   HL,DE   
                    MUS1:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus2   
                              ADD   HL,DE   
                    MUS2:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus3   
                              ADD   HL,DE   
                    MUS3:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus4   
                              ADD   HL,DE   
                    MUS4:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus5   
                              ADD   HL,DE   
                    MUS5:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus6   
                              ADD   HL,DE   
                    MUS6:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus7   
                              ADD   HL,DE   
                    MUS7:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus8   
                              ADD   HL,DE   
                    MUS8:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus9   
                              ADD   HL,DE   
                    MUS9:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus10   
                              ADD   HL,DE   
                    MUS10:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus11   
                              ADD   HL,DE   
                    MUS11:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus12   
                              ADD   HL,DE   
                    MUS12:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus13   
                              ADD   HL,DE   
                    MUS13:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus14   
                              ADD   HL,DE   
                    MUS14:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus15   
                              ADD   HL,DE   
                    MUS15:       
                              POP   BC   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
04F7                          ENDIF      
04F7                          IF   QK   
04F7                             ; A true ")" reads the block start where it is, on top of the return stack,
04F7                             ; instead of popping it and pushing it back; the break key is looked at as
04F7                             ; rpushn would.
04F7   FD 4E 00     CLOSEQ:   LD   C,(IY+0)   
04FA   FD 46 01               LD   B,(IY+1)   
04FD   E5                     PUSH   HL   
04FE   21 36 0B               LD   HL,PCNT   
0501   35                     DEC   (HL)   
0502   E1                     POP   HL   
0503   CC 58 05               CALL   Z,pollk   
0506                          ;*Macro unroll:  NEXT
0506                          DS   (1-CPM)*(1-FAST),0F7h   
0506   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0507   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0508                          ENDIF      
0508                          IF   SBASEU   
                                 ; a-z, in the unchecked builds: a variable followed by "@" or "!" is fetched
                                 ; or stored in the same step (x@ is the commonest pair in most programs).
                                 ; (A checked build checks the stacks between the two, so it keeps them apart.)
                    LOWQ:     ADD   A,A   
                              LD   E,A   
                              LD   D,LETPAGE   ; DE -> the cell
                              LD   A,(BC)   
                              CP   "@"   
                              JR   Z,lwf   
                              CP   "!"   
                              JR   Z,lws   
                              PUSH   HL   
                              EX   DE,HL   ; TOS = the cell's address
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
                    LWF:      INC   BC   ; x@: TOS = the cell's value
                              PUSH   HL   
                              EX   DE,HL   
                              LD   E,(HL)   
                              INC   L   
                              LD   D,(HL)   
                              EX   DE,HL   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
                    LWS:      INC   BC   ; x!: the cell = TOS, and NOS comes up
                              EX   DE,HL   
                              LD   (HL),E   
                              INC   L   
                              LD   (HL),D   
                              POP   HL   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
0508                          ENDIF      
0508                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)*QK   
                    QSTART:   LD   BC,PROG   ; the generic reset goes on here: the IP,
                              CALL   skclr   ;   an empty skip cache, and the rest of the
                              JP   st0   ;   startup
0508                          ENDIF      
0508                          IF   (1-CPM)*(1-EDITOR)*CHECKED*QK   
                    QINIT:    CALL   skclr   ; (keeps A, which init wants 0)
                              JP   init   
0508                          ENDIF      
0508                             ; =============================================================================
0508                             ;  Dispatch table: the low byte of each handler's address, in code order
0508                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
0508                             ;  It must not cross a page (the dispatcher only adds to its low byte).
0508                             ; =============================================================================
0508                             ; The handlers of the first NPG1 characters start in the image's second page.
0508                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
0508                             ; differs between the builds, so the count is worked out here.
0508                             ; (One division to a line: asm80 only rounds down when it stores a value.)
0508                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
0508                PGBRK:    EQU   (h_break-BASE)/256   
0508                PGDEF:    EQU   (h_def-BASE)/256   
0508                PGFET:    EQU   (h_fetch-BASE)/256   
0508                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
0508                          IF   (1-TABP0)*(1-PTLATE)   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0508                          ENDIF      
0508                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
0508                             ; and return its value in A with the carry set; otherwise leave the IP and
0508                             ; return with the carry clear.
0508   0A           HEXC:     LD   A,(BC)   
0509   D6 30                  SUB   "0"   
050B   FE 0A                  CP   10   
050D   38 09                  JR   C,hc1   
050F   E6 DF                  AND   0DFh   
0511   D6 11                  SUB   11h   
0513   FE 06                  CP   6   
0515   D0                     RET   NC   
0516   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
0518   03           HC1:      INC   BC   
0519   C9                     RET      
051A                             ; psgn: print HL as a signed number. Keeps BC.
051A   CB 7C        PSGN:     BIT   7,H   
051C   28 07                  JR   Z,pdec   
051E                          ;*Macro unroll:  PUTK    2Dh             ; '-'
051E                          DS   1-CPM,3Eh   ; "-"
051E                          DS   1-CPM,2Dh   
051E                          DS   1-CPM,0EFh   
051E   CD                     DS   CPM,0CDh   
051F   BE                     DS   CPM,APTK&0FFh   
0520   05                     DS   CPM,APTK/256   
0521   2D                     DS   CPM,2Dh   
0522                          ;*Macro unroll:  NEGH
0522                          DS   1-CPM,0E7h   
0522   CD                     DS   CPM,0CDh   
0523   A1                     DS   CPM,ANEG&0FFh   
0524   05                     DS   CPM,ANEG/256   
0525                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
0525                             ; Keeps BC.
0525   11 0A 00     PDEC:     LD   DE,10   
0528   CD B3 03               CALL   udiv   ; HL = HL / 10, E = the last digit
052B   7B                     LD   A,E   
052C   F5                     PUSH   AF   
052D   7C                     LD   A,H   
052E   B5                     OR   L   
052F   C4 25 05               CALL   NZ,pdec   
0532   F1                     POP   AF   
0533   C6 30                  ADD   A,"0"   
0535                          ;*Macro unroll:  PUTAR
0535                          DS   1-CPM,0EFh   
0535                          DS   1-CPM,0C9h   
0535   C3                     DS   CPM,0C3h   
0536   C2                     DS   CPM,APUT&0FFh   
0537   05                     DS   CPM,APUT/256   
0538                             ; (The table goes here instead in the builds where, before psgn, it would
0538                             ; cross a page: PTLATE. If it would cross one here too, it starts on the next
0538                             ; page: PTPAD is 0 unless it must.)
0538                          IF   (1-TABP0)*PTLATE   
0538                PTPH:     EQU   $ & 0FFh   
0538                PTPX:     EQU   (PTPH + 31) / 256   
0538                PTPAD:    EQU   PTPX * (256 - PTPH)   
0538                          DS   PTPAD   
0538                PTAB:        
0538                          ;*Macro unroll:  PTABLE
0538   9D                     DB   h_store & 0FFh   
0539   A7                     DB   h_str & 0FFh   
053A   C3                     DB   h_num & 0FFh   
053B   B3                     DB   h_print & 0FFh   
053C   92                     DB   h_swap & 0FFh   
053D   43                     DB   h_and & 0FFh   
053E   BC                     DB   h_emit & 0FFh   
053F   1C                     DB   h_open & 0FFh   
0540   24                     DB   h_close & 0FFh   
0541   66                     DB   h_mul & 0FFh   
0542   36                     DB   h_add & 0FFh   
0543   E1                     DB   h_cfetch & 0FFh   
0544   2C                     DB   h_sub & 0FFh   
0545   95                     DB   h_cstore & 0FFh   
0546   6A                     DB   h_div & 0FFh   
0547   8F                     DB   h_dup & 0FFh   
0548   9A                     DB   h_drop & 0FFh   
0549   4C                     DB   h_lt & 0FFh   
054A   5C                     DB   h_eq & 0FFh   
054B   4D                     DB   h_gt & 0FFh   
054C   C9                     DB   h_key & 0FFh   
054D   16                     DB   h_fetch & 0FFh   
054E   F1                     DB   h_def & 0FFh   
054F   E1                     DB   h_break & 0FFh   
0550   DA                     DB   h_ret & 0FFh   
0551   69                     DB   h_xor & 0FFh   
0552   81                     DB   h_alloc & 0FFh   
0553   C2                     DB   h_grave & 0FFh   
0554   BE                     DB   h_tor & 0FFh   
0555   72                     DB   h_or & 0FFh   
0556   06                     DB   h_fromr & 0FFh   
0557   7B                     DB   h_not & 0FFh   
0558                PTABEND:      
0558                          ENDIF      
0558                             ; =============================================================================
0558                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
0558                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
0558                             ;  (RST 28h) prints A. Both keep BC, DE, HL and IY. In the generic build
0558                             ;  they are the host's KEY and CONOUT routines themselves.
0558                             ; 
0558                             ;  A running program reads the keyboard only through getk and pollk, which
0558                             ;  between them give the break key its rules:
0558                             ;    - Ctrl-C stops the program;
0558                             ;    - any other key that the break check reads is held in KEYBUF for the
0558                             ;      next "?", and a newer one takes its place;
0558                             ;    - "?" (getk) takes the held key first;
0558                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
0558                             ;      key like any other, but two of them within about 250 ms still stop it.
0558                             ;  Both are called straight from a handler, never from a routine under one:
0558                             ;  the checked build's report counts on finding one return address above the
0558                             ;  data stack.
0558                             ; =============================================================================
0558                          IFN   CPM   
                    RAWK:     EQU   KEY   
0558                          ENDIF      
0558                             ; pollk: the break check (see rpushn).
0558   CD BA 05     POLLK:    CALL   rawk   
055B   C8                     RET   Z   ; no key
055C   32 7A 0B               LD   (KEYBUF),A   ; held for the next "?"
055F   FE 03        PK1:      CP   3   ; (getk joins here)
0561   C0                     RET   NZ   
0562                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
0562                             ; the program has turned it off, wait about 250 ms for one more key: a
0562                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
0562                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
0562   3A 7B 0B     CTLC:     LD   A,(BRKOFF)   
0565   B7                     OR   A   
0566   CA 3F 06     CT0:      JP   Z,brk   
0569   D5                     PUSH   DE   
056A   11 E8 03               LD   DE,250*MSLOOP   
056D   CD BA 05     CT1:      CALL   rawk   
0570   20 05                  JR   NZ,ct2   
0572   1B                     DEC   DE   
0573   7A                     LD   A,D   
0574   B3                     OR   E   
0575   20 F6                  JR   NZ,ct1   
0577   D1           CT2:      POP   DE   ; A = the second key, or 0 if none came
0578   FE 03                  CP   3   
057A   28 EA                  JR   Z,ct0   ; (the zero flag takes the JP there)
057C   B7                     OR   A   
057D   28 03                  JR   Z,ct3   
057F   32 7A 0B               LD   (KEYBUF),A   
0582   3E 03        CT3:      LD   A,3   
0584   B7                     OR   A   
0585   C9                     RET      
0586                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
0586   E5           GETK:     PUSH   HL   ; a held key goes first, and is taken out of
0587   21 7A 0B               LD   HL,KEYBUF   ;   the buffer
058A   7E                     LD   A,(HL)   
058B   36 00                  LD   (HL),0   
058D   E1                     POP   HL   
058E   B7                     OR   A   
058F   C0                     RET   NZ   
0590   CD BA 05               CALL   rawk   
0593   C8                     RET   Z   
0594   18 C9                  JR   pk1   ; Ctrl-C? If not, that is the key
0596                          IF   (1-CHECKED)*(1-EDITOR)   
                    BRK:      EQU   endprog   ; the unchecked build stops without a word
0596                          ENDIF      ;   (with the editor, both stacks are cleared);
0596                          IF   (1-CHECKED)*EDITOR   
                    BRK:      EQU   edit0   
0596                          ENDIF      
0596                          IF   CHECKED   
0596                BRK:      EQU   e_break   ;   the checked build reports B
0596                          ENDIF      
0596                          IF   CPM   
0596                             ; The routines a generic build keeps in page zero (see there). Here they are
0596                             ; out of the way of the handlers, which must fit in the image's first two
0596                             ; pages.
0596   FD 5E 00     RPOP:     LD   E,(IY+0)   ; pop the return stack into DE
0599   FD 56 01               LD   D,(IY+1)   
059C   FD 23                  INC   IY   
059E   FD 23                  INC   IY   
05A0   C9                     RET      
05A1   AF           NEG16:    XOR   A   ; HL = -HL (keeps BC, DE)
05A2   95                     SUB   L   
05A3   6F                     LD   L,A   
05A4   9F                     SBC   A,A   
05A5   94                     SUB   H   
05A6   67                     LD   H,A   
05A7   C9                     RET      
05A8                          ENDIF      
05A8                          IF   CPM*CHECKED   ; (the checked builds need the room)
05A8   FD 22 34 0B  EXEC:     LD   (RSAVE),IY   ; machine code may change IX and IY
05AC   CD C1 01               CALL   jphl   
05AF   FD 2A 34 0B            LD   IY,(RSAVE)   
05B3                          ;*Macro unroll:  SETIX
05B3   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
05B4   21                     DS   CPM+FAST-CPM*FAST,21h   
05B5   14                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
05B6   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
05B7   E1                     POP   HL   
05B8                          ;*Macro unroll:  NEXT
05B8                          DS   (1-CPM)*(1-FAST),0F7h   
05B8   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
05B9   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
05BA                          ENDIF      
05BA                          IF   CPM   
05BA   3E FF        RAWK:     LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
05BC   18 04                  JR   putc   
05BE   E3           PUTK:     EX   (SP),HL   ; print the byte after the CALL
05BF   7E                     LD   A,(HL)   
05C0   23                     INC   HL   
05C1   E3                     EX   (SP),HL   
05C2                             ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
05C2                             ; printing and could swallow a key that BDOS 6 then never sees.
05C2                             ; It keeps every register but A and the flags: BDOS may change any of them
05C2                             ; (IX and IY too, in a Z80 BDOS or BIOS).
05C2   C5           PUTC:     PUSH   BC   
05C3   D5                     PUSH   DE   
05C4   E5                     PUSH   HL   
05C5   DD E5                  PUSH   IX   
05C7   FD E5                  PUSH   IY   
05C9   5F                     LD   E,A   
05CA   0E 06                  LD   C,6   
05CC   CD 05 00               CALL   BDOS   
05CF   FD E1                  POP   IY   
05D1   DD E1                  POP   IX   
05D3   E1                     POP   HL   
05D4   D1                     POP   DE   
05D5   C1                     POP   BC   
05D6   B7                     OR   A   ; (for getk)
05D7   C9                     RET      
05D8                          ENDIF      
05D8                             ; =============================================================================
05D8                             ;  Checked build: the checks and the error report
05D8                             ; =============================================================================
05D8                          IF   CHECKED   
05D8                             ; chkstk: both stacks are checked once per character, not in every handler.
05D8                             ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
05D8                             ; the constant carries if it is above (cells were popped that were never
05D8                             ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
05D8                             ; a character late at most: the bytes above DSTOP and the guard band below
05D8                             ; the page take what happens meanwhile. DE is free between characters.
05D8   EB           CHKSTK:   EX   DE,HL   
05D9   21 05 F5               LD   HL,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
05DC   39                     ADD   HL,SP   
05DD   EB                     EX   DE,HL   
05DE   38 1E                  JR   C,e_under   
05E0   14                     INC   D   
05E1   20 17                  JR   NZ,e_over   
05E3   FD E5                  PUSH   IY   ; the return stack: in its page (or it has
05E5   D1                     POP   DE   ;   overflowed), and not above its empty
05E6   7A                     LD   A,D   ;   position (an underflow stays inside the
05E7   FE 09                  CP   RSPAGE   ;   page, in the guard band)
05E9   7B                     LD   A,E   
05EA   20 0B                  JR   NZ,e_rover   
05EC   FE E1                  CP   RSTOP&0FFh+1   
05EE   D8                     RET   C   
05EF   FD 21 E0 09            LD   IY,RSTOP   ; return stack underflow: it counts as empty
05F3   3E 72                  LD   A,"r"   
05F5   18 4A                  JR   errp   
05F7   3E 52        E_ROVER:   LD   A,"R"   ; return stack overflow
05F9   11                     DB   11h   ; (LD DE,nn hides the next entry)
05FA   3E 53        E_OVER:   LD   A,"S"   ; data stack overflow
05FC   18 43                  JR   errp   
05FE   31 FC 0A     E_UNDER:   LD   SP,DSTOP   ; data stack underflow: it counts as empty
0601   3E 73                  LD   A,"s"   
0603   18 56                  JR   error   
0605                             ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
0605                             ; was never defined still holds 0000h, and the byte there is a reserved one
0605                             ; in every build (AFh or C3h): if the IP is in page zero, this was a call of
0605                             ; an undefined word. The call is undone, so the place is the call itself.
0605   04           E_HI:     INC   B   
0606   10 4B                  DJNZ   e_resv   ; (B is as it was, and is not 0)
0608                          ;*Macro unroll:  POPR
0608                          DS   1-CPM,0CFh   
0608   CD                     DS   CPM,0CDh   
0609   96                     DS   CPM,AROP&0FFh   
060A   05                     DS   CPM,AROP/256   
060B   42                     LD   B,D   
060C   4B                     LD   C,E   
060D   3E 55                  LD   A,"U"   
060F   18 4A                  JR   error   
0611                             ; chkhp: HL = the new heap top, DE = the old one, the carry is from adding
0611                             ; the count. Stop if the top is not below the limit page, or is below the
0611                             ; program's end.
0611                CHKHP:       
0611                          ENDIF      
0611                          IF   CHECKED*CPM   
0611                             ; With this much room a top that wrapped round can land back in
0611                             ; range, so the add is tested too: growing (A, the count's high
0611                             ; byte, is positive) must not carry, and releasing must.
0611   1F                     RRA      ; the carry comes in above the sign:
0612   C6 40                  ADD   A,40h   ;   bit 7 = carry XOR sign
0614   87                     ADD   A,A   
0615   38 10                  JR   C,e_heap   
0617   3A 07 00               LD   A,(0007h)   
061A   3D                     DEC   A   
061B   BC                     CP   H   
061C   38 09                  JR   C,e_heap   
061E                          ENDIF      
061E                          IF   CHECKED*(1-CPM)   
                                 ; (Here the program's space is under 32K, so a top that wrapped
                                 ; round always falls outside it.)
                              LD   A,H   
                              CP   HEAPLIM   
                              JR   NC,e_heap   
061E                          ENDIF      
061E                          IF   CHECKED   
061E   D5                     PUSH   DE   
061F   EB                     EX   DE,HL   
0620   2A 38 0B               LD   HL,(NPEND)   
0623   19                     ADD   HL,DE   ; carry: at or above the program's end
0624   EB                     EX   DE,HL   
0625   D1                     POP   DE   
0626   D8                     RET   C   
0627   B7           E_HEAP:   OR   A   ; put the count back in TOS for the report
0628   ED 52                  SBC   HL,DE   
062A   3E 48                  LD   A,"H"   
062C   18 13                  JR   errp   
062E                             ; chkst: stop unless HL is in the program's own space: from the letter page
062E                             ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
062E                             ; whatever lies above the limit are safe. Memory above the heap top but
062E                             ; below the limit is the program's own: Tiny BASIC keeps its lines there.
062E                             ; It is the page of HL + 1 that is tested, so that one test serves both
062E                             ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
062E                             ; Keeps HL and BC. It runs on into its own error entry.
062E   23           CHKST:    INC   HL   
062F   7C                     LD   A,H   
0630   2B                     DEC   HL   
0631   FE 0B                  CP   LETPAGE   
0633   38 07                  JR   C,e_store   
0635                          ENDIF      
0635                          IF   CHECKED*(1-CPM)   
                              CP   HEAPLIM   
                              RET   C   
0635                          ENDIF      
0635                          IF   CHECKED*CPM   
0635   5F                     LD   E,A   
0636   3A 07 00               LD   A,(0007h)   ; the BDOS page is the heap limit
0639   3D                     DEC   A   
063A   BB                     CP   E   
063B   D0                     RET   NC   
063C                          ENDIF      
063C                          IF   CHECKED   
063C                             ; Error entries. Each loads its letter and then hides the next entry inside
063C                             ; a 3-byte LD DE,nn (the 11h), so they all fall through to `error`.
063C   3E 4F        E_STORE:   LD   A,"O"   ; a store outside the program's space
063E   11                     DB   11h   
063F   3E 42        E_BREAK:   LD   A,"B"   ; Ctrl-C (found inside pollk or getk)
0641                             ; errp: an error found inside a routine: drop its return address first.
0641   D1           ERRP:     POP   DE   
0642   18 17                  JR   error   
0644                             ; e_dollar: "$" ran into a NUL (in prstr): Q, with the string's address
0644                             ; back in TOS. prstr"s return address goes first. But if "$' had no
0644                             ; address at all (the stack was empty), it is s, found now: chkstk, called
0644                             ; one cell up, sees the stack past its empty place then.
0644   D1           E_DOLLAR:   POP   DE   
0645   E1                     POP   HL   
0646   CD D8 05               CALL   chkstk   
0649   E5                     PUSH   HL   
064A   2A 34 0B               LD   HL,(RSAVE)   
064D   11                     DB   11h   ; (LD DE,nn hides e_quote's first two bytes)
064E   44           E_QUOTE:   LD   B,H   ; an unclosed string: HL is its address, one
064F   4D                     LD   C,L   ;   past the opening quote, which is the place
0650   3E 51                  LD   A,"Q"   
0652   11                     DB   11h   
0653   3E 58        E_RESV:   LD   A,"X"   ; a reserved byte outside a string
0655   11                     DB   11h   
0656   3E 5A        E_ZERO:   LD   A,"Z"   ; dividing by zero
0658   11                     DB   11h   
0659   3E 57        E_BRACK:   LD   A,"W"   ; bad character after [
065B                             ; error: the report, then the end. A = the letter, BC = one past the place,
065B                             ; HL = TOS, and both stacks as the report is to show them:
065B                             ; 
065B                             ;   Err X @ line,col
065B                             ;   D:n: the top 8 cells at most, bottom to top
065B                             ;   R:n
065B   E5           ERROR:    PUSH   HL   ; now the whole data stack is in memory
065C   5F                     LD   E,A   
065D   CD 36 03               CALL   pnl   
0660   45 72 72 20 22         DB   "Err ",22h   
0665   7B                     LD   A,E   
0666                          ;*Macro unroll:  PUTA
0666                          DS   1-CPM,0EFh   
0666   CD                     DS   CPM,0CDh   
0667   C2                     DS   CPM,APUT&0FFh   
0668   05                     DS   CPM,APUT/256   
0669   CD 3C 03               CALL   pmsg   
066C   20 40 20 22            DB   " @ ",22h   
0670   0B                     DEC   BC   ; BC = the place
0671                             ; The line and column. A place below the program is in the line
0671                             ; buffer: line 0. Otherwise count the LFs from the program's start;
0671                             ; DE = the line's number, HL = where it starts.
0671   21 80 0B               LD   HL,LINEBUF   
0674   11 00 00               LD   DE,0   
0677   78                     LD   A,B   
0678   FE 0C                  CP   PROG/256   
067A   38 14                  JR   C,er3   
067C   24                     INC   H   
067D   6B                     LD   L,E   ; HL = PROG
067E   13           ER1:      INC   DE   ; a new line starts at HL
067F   E5                     PUSH   HL   
0680   7D           ER2:      LD   A,L   
0681   91                     SUB   C   
0682   7C                     LD   A,H   
0683   98                     SBC   A,B   
0684   30 09                  JR   NC,er2x   ; reached the place
0686   7E                     LD   A,(HL)   
0687   23                     INC   HL   
0688   FE 0A                  CP   10   
068A   20 F4                  JR   NZ,er2   
068C   F1                     POP   AF   
068D   18 EF                  JR   er1   
068F   E1           ER2X:     POP   HL   
0690   C5           ER3:      PUSH   BC   
0691   E5                     PUSH   HL   
0692   EB                     EX   DE,HL   
0693   CD 25 05               CALL   pdec   ; the line
0696                          ;*Macro unroll:  PUTK    2Ch             ; ','
0696                          DS   1-CPM,3Eh   ; ","
0696                          DS   1-CPM,2Ch   
0696                          DS   1-CPM,0EFh   
0696   CD                     DS   CPM,0CDh   
0697   BE                     DS   CPM,APTK&0FFh   
0698   05                     DS   CPM,APTK/256   
0699   2C                     DS   CPM,2Ch   
069A   D1                     POP   DE   
069B   E1                     POP   HL   
069C   B7                     OR   A   
069D   ED 52                  SBC   HL,DE   
069F   23                     INC   HL   
06A0   CD 25 05               CALL   pdec   ; the column
06A3                             ; The two stack lines:  D:n: the top 8 cells at most, bottom to top
06A3                             ;                       R:n
06A3                             ; TOS is in memory with the rest (pushed) by now.
06A3   CD 36 03               CALL   pnl   
06A6   44 3A 22               DB   "D:",22h   
06A9   21 FA 0A               LD   HL,DSTOP-2   ; (DSTOP-2) - SP is twice the depth (the cell
06AC   ED 72                  SBC   HL,SP   ;   at DSTOP-2 was pushed with the first value
06AE                             ;   and holds nothing; pnl left the carry clear)
06AE   CD F6 06               CALL   phalf   ; the depth
06B1                          ;*Macro unroll:  PUTK    3Ah             ; ':'
06B1                          DS   1-CPM,3Eh   ; ":"
06B1                          DS   1-CPM,3Ah   
06B1                          DS   1-CPM,0EFh   
06B1   CD                     DS   CPM,0CDh   
06B2   BE                     DS   CPM,APTK&0FFh   
06B3   05                     DS   CPM,APTK/256   
06B4   3A                     DS   CPM,3Ah   
06B5   79                     LD   A,C   
06B6   FE 09                  CP   9   
06B8   38 0A                  JR   C,er6   
06BA   CD 3C 03               CALL   pmsg   
06BD   20 2E 2E 2E 22         DB   " ...",22h   
06C2   0E 08                  LD   C,8   
06C4   26 00        ER6:      LD   H,0   ; C = the number of cells to show
06C6   69                     LD   L,C   
06C7   29                     ADD   HL,HL   
06C8   39                     ADD   HL,SP   ; HL -> just above the deepest of them
06C9   0C                     INC   C   
06CA   0D           ER7:      DEC   C   
06CB   28 10                  JR   Z,er8   
06CD   2B                     DEC   HL   
06CE   56                     LD   D,(HL)   
06CF   2B                     DEC   HL   
06D0   5E                     LD   E,(HL)   
06D1   E5                     PUSH   HL   
06D2                          ;*Macro unroll:  PUTK    20h             ; ' '
06D2                          DS   1-CPM,3Eh   ; " "
06D2                          DS   1-CPM,20h   
06D2                          DS   1-CPM,0EFh   
06D2   CD                     DS   CPM,0CDh   
06D3   BE                     DS   CPM,APTK&0FFh   
06D4   05                     DS   CPM,APTK/256   
06D5   20                     DS   CPM,20h   
06D6   EB                     EX   DE,HL   
06D7   CD 1A 05               CALL   psgn   
06DA   E1                     POP   HL   
06DB   18 ED                  JR   er7   
06DD   CD 36 03     ER8:      CALL   pnl   
06E0   52 3A 22               DB   "R:",22h   
06E3   FD E5                  PUSH   IY   ; RSTOP - IY is under 256 (the pointer is
06E5   E1                     POP   HL   ;   at most one entry below its page), so
06E6   3E E0                  LD   A,RSTOP&0FFh   ;   the low bytes are enough
06E8   95                     SUB   L   
06E9   6F                     LD   L,A   
06EA   26 00                  LD   H,0   
06EC   CD F6 06               CALL   phalf   
06EF   CD 36 03               CALL   pnl   
06F2   22                     DB   22h   
06F3                          ENDIF      
06F3                          IF   CHECKED*(1-EDITOR)   
06F3   C3 11 01               JP   endprog   
06F6                          ENDIF      
06F6                          IF   CHECKED*EDITOR   
                              JR   edit0   ; back to the editor, with both stacks cleared
06F6                          ENDIF      
06F6                          IF   CHECKED   
06F6                             ; phalf: print half of HL, and leave it in C.
06F6   CB 3C        PHALF:    SRL   H   
06F8   CB 1D                  RR   L   
06FA   E5                     PUSH   HL   
06FB   CD 25 05               CALL   pdec   
06FE   C1                     POP   BC   
06FF   C9                     RET      
0700                          ENDIF      
0700                             ; =============================================================================
0700                             ;  The line editor (EDITOR = 1)
0700                             ; 
0700                             ;  The interpreter starts here, and a program that ends comes back here.
0700                             ;  There is no prompt. It follows the spec's suggested standard for a line
0700                             ;  editor (docs/b8script.md, Environments). Type a line and press Return:
0700                             ; 
0700                             ;    n text    put the text in as line n; the lines from n on move down. A
0700                             ;              number past the end (or 0) adds the line at the end.
0700                             ;    n         take line n out
0700                             ;    anything else is run at once, as B8Script. (Start such a line with a
0700                             ;    space if it would begin with a digit.)
0700                             ; 
0700                             ;  A command key ends the line too, and takes what was typed as its argument:
0700                             ; 
0700                             ;    ^G        run the program
0700                             ;    n ^L      list from line n (no number: all of it). Any key holds the
0700                             ;              list until another key is pressed; Ctrl-C ends it.
0700                             ;    n ^E      put line n in the input line; Return puts it back, changed
0700                             ;    name ^R   read. CP/M: the file of that name (no name: the same file as
0700                             ;              last time). Generic: what is typed, or pasted, from now until
0700                             ;              ^Z replaces the program; it is not echoed.
0700                             ;    name ^W   write. CP/M: to that file (no name: the same file as last
0700                             ;              time). Generic: the text is printed, as it is.
0700                             ;    ^N        new: no program
0700                             ;    ^X        leave (to LEAVE)
0700                             ; 
0700                             ;  In the line: the left and right arrow keys move the cursor;
0700                             ;  a character goes in at the cursor; Backspace and DEL take out the one
0700                             ;  before it; Esc drops the line. Only CR, LF, BS and printing characters are
0700                             ;  sent to the terminal, so any terminal will do.
0700                             ; 
0700                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
0700                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
0700                             ;  125 characters; the one character after a line number separates it from
0700                             ;  the text and is not stored. The text is kept as it is typed, each line
0700                             ;  ending in CR LF, at PROG.
0700                             ; 
0700                             ;  What lasts from one line to the next: the program, the words, the
0700                             ;  variables and the data stack. An error or a break clears both stacks. The
0700                             ;  return stack starts empty for every line.
0700                             ; 
0700                             ;  Things to know:
0700                             ;    - Reset empties the program (generic builds).
0700                             ;    - A word's address points into the program, so run the program again
0700                             ;      after editing it.
0700                             ;    - Nothing is printed between a program's output and what is typed next.
0700                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
0700                             ;      a line that calls -n? and carries on afterwards runs what was typed.
0700                             ;      (The stored program never comes back to the line, so it may.)
0700                             ;    - The editor"s own keys are not the program"s: -n? is the plain line
0700                             ;      read of the other builds.
0700                             ; 
0700                             ;  The data stack is the CPU's stack, so the editor works on top of whatever
0700                             ;  the last line left there, with TOS pushed like the rest.
0700                             ; =============================================================================
0700                          IF   EDGEN   
                    INIT:        ; reset (A = 0)
0700                          ENDIF      
0700                          IF   EDGEN*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at 0, and
                                 ; every word cell holds 0000h, the address an undefined word is caught at
                                 ; (see e_hi).
                              LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
0700                          ENDIF      
0700                          IF   EDGEN   
                              JR   edit0   
0700                          ENDIF      
0700                          IF   EDITOR   
                                 ; Right arrow: one to the right, by printing the character there
                    RIGHT:    LD   A,L   
                              CP   E   
                              JR   Z,ed1   ; at the end
                              LD   A,(HL)   
                              INC   L   
                              JR   lf1   
                                 ; Esc: alone it drops the line. An arrow key sends Esc [ and a letter, so
                                 ; wait about 5 ms for a second key: after a "[" read on to the letter that
                                 ; ends the sequence, and act on C (right) and D (left).
                    ESC:      LD   BC,5*MSLOOP   
                    ES1:      CALL   rawk   
                              JR   NZ,es2   
                              DEC   BC   
                              LD   A,B   
                              OR   C   
                              JR   NZ,es1   
                              CALL   fin   ; no second key: the line is dropped
                              JR   edit   
                    ES2:      CP   "["   
                              JR   NZ,ed1   ; not a sequence known here
                    ES3:      CALL   ekey   
                              CP   40h   
                              JR   C,es3   ; (its parameters)
                              SUB   "C"   
                              JR   Z,right   
                              DEC   A   ; "D"?
                              JR   NZ,ed1   ; no: on into left
                                 ; Left arrow: the cursor goes one to the left
                    LEFT:     LD   A,L   
                              ADD   A,A   
                              JR   Z,ed1   ; (L = 80h: at the start)
                              DEC   L   
                              LD   A,8   
                              ;*Macro unroll: lf1:    PUTA
                    LF1:      DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              JR   ed1   
                                 ; edit0: reset, an error or a break: both stacks are cleared, and the cursor
                                 ;   is shown, in case the program had hidden it and could not show it again.
                                 ; skend: a program that ended inside skip: its return address goes.
                                 ; edend: a program that ended: TOS joins the rest of the data stack.
                    EDIT0:    LD   SP,DSTOP-2   ; empty (the cell that stands for TOS is pushed)
0700                          ENDIF      
0700                          IF   EDITOR*ANS   
                              XOR   A   ; (pshow wants the carry clear)
                              CALL   pshow   ; ESC [ ? 2 5 h
0700                          ENDIF      
0700                          IF   EDITOR*(1-ANS)   
                              LD   A,1   
                              CALL   CONCUR   ; show the cursor
0700                          ENDIF      
0700                          IF   EDITOR   
                              DB   21h   ; (LD HL,nn: steps over the next two bytes)
                    SKEND:    POP   DE   
                    EDEND:    PUSH   HL   
                                 ; edit: start a new input line.
                    EDIT:     LD   IY,RSTOP   ; the return stack is empty
                              ;*Macro unroll:  SETIX                   ; (a file read or written may have changed IX)
                              DS   CPM+FAST-CPM*FAST,0DDh   ; (a file read or written may have changed IX)
                              DS   CPM+FAST-CPM*FAST,21h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
                              LD   HL,0   
                              LD   (KEYBUF),HL   ; no key is held, and the break key is on
                              LD   (EDLN),HL   ; no line is being edited
                              LD   HL,LINEBUF   ; HL = the cursor,
                              LD   E,L   ;   E = the end of the line (its low byte)
                    ED1:      CALL   ekey   
                              CP   7Fh   
                              JR   Z,bsp   ; DEL
                              CP   " "   
                              JR   NC,insc   
                              CP   9   
                              JR   Z,insc   ; Tab is text
                              CP   8   
                              JR   Z,bsp   
                              CP   1Bh   
                              JR   Z,esc   
                              PUSH   HL   ; a command key? Look it up
                              LD   HL,cmds   
                              LD   B,NCMD   
                    ED2:      CP   (HL)   
                              INC   HL   
                              JR   Z,ed3   
                              INC   HL   
                              INC   HL   
                              DJNZ   ed2   
                              POP   HL   
                              JR   ed1   ; no: the key is ignored
                    ED3:      LD   A,(HL)   
                              INC   HL   
                              LD   H,(HL)   
                              LD   L,A   
                              EX   (SP),HL   ; the command's address: fin returns to it
                                 ; fin: end the input line: CR LF and a NUL after it, and a new line on the
                                 ; terminal. Leaves BC -> the line and HL -> the NUL.
                    FIN:      LD   H,LETPAGE   
                              LD   L,E   
                              LD   (HL),13   
                              INC   L   
                              LD   (HL),10   
                              DEC   L   
                              CALL   prl   ; (prints the CR LF)
                              LD   (HL),0   
                              LD   BC,LINEBUF   
                              RET      
                                 ; Backspace, DEL: the character before the cursor goes. The cursor moves
                                 ; left, the rest of the line moves down over it, and the last place (now a
                                 ; space) is printed over along with the rest.
                    BSP:      LD   A,L   
                              ADD   A,A   
                              JR   Z,ed1   ; at the start
                              DEC   L   
                              ;*Macro unroll:  PUTK    08h             ; backspace
                              DS   1-CPM,3Eh   ; backspace
                              DS   1-CPM,08h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,08h   
                              PUSH   HL   
                    BS1:      INC   L   
                              LD   A,(HL)   
                              DEC   L   
                              LD   (HL),A   
                              INC   L   
                              LD   A,L   
                              CP   E   
                              JR   NZ,bs1   
                              DEC   L   
                              LD   (HL)," "   
                              POP   HL   
                              LD   D,E   
                              DEC   E   
                              JR   ic2   
                                 ; A character goes in at the cursor: it ripples up through the rest of the
                                 ; line, the cursor moves on, and the rest is printed again.
                    INSC:     LD   B,A   
                              LD   A,E   
                              CP   0FDh   
                              JR   Z,ed1   ; the line is full: 125 characters
                              LD   A,B   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              PUSH   HL   
                    IC1:      LD   A,(HL)   
                              LD   (HL),B   
                              LD   B,A   
                              LD   A,L   
                              INC   L   
                              CP   E   
                              JR   NZ,ic1   
                              POP   HL   
                              INC   L   
                              INC   E   
                              LD   D,E   
                    IC2:      CALL   tail   
                              JR   ed1   
                                 ; tail: print the line from the cursor to D (a low byte), and bring the
                                 ; cursor back with backspaces. Nothing at all if the cursor is at D.
                    TAIL:     LD   C,L   
                    TA1:      LD   A,L   
                              CP   D   
                              JR   Z,ta2   
                              LD   A,(HL)   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              INC   L   
                              JR   ta1   
                    TA2:      LD   A,L   
                              CP   C   
                              RET   Z   
                              ;*Macro unroll:  PUTK    08h             ; backspace
                              DS   1-CPM,3Eh   ; backspace
                              DS   1-CPM,08h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,08h   
                              DEC   L   
                              JR   ta2   
                                 ; ekey: wait for a key
                    EKEY:     CALL   rawk   
                              JR   Z,ekey   
                              RET      
                                 ; The command keys, and where each goes (after fin).
                    CMDS:     DB   13   
                              DW   cret   
                              DB   7   ; ^G
                              DW   crun   
                              DB   12   ; ^L
                              DW   clist   
                              DB   5   ; ^E
                              DW   cedln   
                              DB   18   ; ^R
                              DW   cread   
                              DB   23   ; ^W
                              DW   cwrite   
                              DB   14   ; ^N
                              DW   cnew   
                              DB   24   ; ^X
                              DW   LEAVE   
                    NCMD:     EQU   8   
                                 ; ^N: no program
                    CNEW:     XOR   A   
                              LD   (PROG),A   
                    GED0:     JR   gedit   
                                 ; ^E: line n goes into the input line, to be changed. EDLN remembers which
                                 ; line it was: Return puts the text back in its place.
                    CEDLN:    CALL   rdnum   
                              PUSH   HL   
                              CALL   find   ; HL -> the line, or the NUL if there is none
                              POP   DE   
                              LD   A,(HL)   
                              OR   A   
                              JR   Z,ged0   
                              LD   (EDLN),DE   
                              LD   DE,LINEBUF   
                    CE1:      LD   A,(HL)   ; copy it, and show it, up to its CR (or LF)
                              CP   13   
                              JR   Z,ce2   
                              CP   10   
                              JR   Z,ce2   
                              LD   (DE),A   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              INC   HL   
                              INC   E   
                              LD   A,E   
                              CP   0FDh   ; (a longer line is cut at 125 characters)
                              JR   NZ,ce1   
                    CE2:      EX   DE,HL   ; the cursor is at the line's end
                              LD   E,L   
                              JP   ed1   
                                 ; Return. If ^E put a line here, the text goes back in its place. If not:
                                 ; a number and text is a line to put in, a number alone a line to take out,
                                 ; and anything else is run where it is.
                    CRET:     PUSH   HL   ; the end of what was typed
                              LD   HL,(EDLN)   
                              LD   A,H   
                              OR   L   
                              JR   Z,cr1   
                              PUSH   HL   
                              CALL   delln   
                              POP   HL   
                              JR   ins   
                    CR1:      CALL   rdnum   ; HL = the number it starts with, BC -> after
                              LD   A,C   ; C is still 80h if there was no number:
                              ADD   A,A   ;   only then is twice it 0
                              JR   Z,st0p   ; no number: run the line
                              LD   A,(BC)   
                              CP   13   
                              JR   NZ,cr2   
                              POP   DE   ; the number alone: take that line out
                              CALL   delln   
                              JR   gedit   
                    CR2:      INC   BC   ; step over the one character after the number
                                 ; Put the text at BC in as line n (in HL): open a gap of its length there,
                                 ; CR and LF included, and copy it in.
                    INS:      CALL   find   ; HL -> where it goes
                              POP   DE   ; the end of what was typed
                              LD   A,E   
                              SUB   C   ; A = the length of the text, with its CR LF
                              PUSH   BC   ; the text
                              LD   C,A   
                              LD   B,0   
                              PUSH   BC   ; its length
                              LD   D,H   
                              LD   E,L   ; DE = where it goes
                              XOR   A   
                              LD   C,A   ; BC = 0: CPIR looks as far as it needs to
                              CPIR      ; HL -> one past the program's NUL
                              SBC   HL,DE   ; the number of bytes to move up, NUL included
                              LD   B,H   
                              LD   C,L   
                              ADD   HL,DE   
                              DEC   HL   ; HL -> the NUL
                              EX   DE,HL   
                              EX   (SP),HL   ; HL = the length; where it goes is kept
                              PUSH   HL   
                              ADD   HL,DE   ; the NUL's new place
                              EX   DE,HL   
                              LDDR      ; move the rest of the program up
                              POP   BC   ; the length
                              POP   DE   ; where it goes
                              POP   HL   ; the text
                              LDIR      
                    GEDIT:    JP   edit   
                                 ; ^G: run the program. st0p: run the typed line (BC -> it).
                    CRUN:     LD   BC,PROG   
                              DB   3Eh   ; (LD A,n: steps over the POP)
                    ST0P:     POP   HL   ; (the end of what was typed)
                                 ; st0: start running at BC. The heap starts after the stored program's NUL.
                    ST0:      LD   HL,PROG   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
                              LD   (HEAP),HL   
0700                          ENDIF      
0700                          IF   EDITOR*QK   
                              CALL   skclr   ; every run starts with an empty skip cache
0700                          ENDIF      
0700                          IF   EDITOR*CHECKED   
                              ;*Macro unroll:  NEGH                    ; minus the heap's first address: '_' may not
                              DS   1-CPM,0E7h   ; minus the heap"s first address: "_' may not
                              DS   CPM,0CDh   
                              DS   CPM,ANEG&0FFh   
                              DS   CPM,ANEG/256   
                              LD   (NPEND),HL   ;   release below it
0700                          ENDIF      
0700                          IF   EDITOR   
                              POP   HL   ; TOS: the data stack is as the last line left it
                              ;*Macro unroll:  NEXT                    ; (its return address is thrown away)
                              DS   (1-CPM)*(1-FAST),0F7h   ; (its return address is thrown away)
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
                                 ; ^L: list from line n. DE = the number of the line at HL.
                    CLIST:    CALL   rdnum   ; HL = n, or 0 if there was none:
                              LD   A,H   
                              OR   L   
                              JR   NZ,li0   
                              INC   L   ;   then from line 1
                    LI0:      PUSH   HL   
                              CALL   find   
                              POP   DE   
                    LI1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,gedit   ; the end of the text
                              CALL   rawk   
                              JR   Z,li3   ; no key: carry on
                              CP   3   
                              CALL   NZ,ekey   ; any key but Ctrl-C: wait for one more
                              CP   3   
                              JR   Z,gedit   ; Ctrl-C, first or second, ends the list
                    LI3:      PUSH   HL   
                              PUSH   DE   
                              EX   DE,HL   
                              CALL   pdec   ; the line's number,
                              LD   A," "   
                              ;*Macro unroll:  PUTA                    ;   a space,
                              DS   1-CPM,0EFh   ;   a space,
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              POP   DE   
                              POP   HL   
                              INC   DE   
                              CALL   prl   ;   and the line
                              JR   li1   
                                 ; delln: take line n (in HL) out: copy everything after it down over it.
                    DELLN:    CALL   find   
                              LD   D,H   
                              LD   E,L   
                              CALL   nxl   ; HL -> the next line
                    DE1:      LD   A,(HL)   
                              LD   (DE),A   
                              INC   HL   
                              INC   DE   
                              OR   A   
                              JR   NZ,de1   
                              RET      
                                 ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
                                 ; of the text if there are fewer lines (or the number is 0). Keeps BC.
                    FIND:     EX   DE,HL   
                              LD   HL,PROG   
                    FI1:      DEC   DE   
                              LD   A,D   
                              OR   E   
                              RET   Z   
                              CALL   nxl   
                              JR   NZ,fi1   
                              RET      
                                 ; nxl: step HL over one line, to just past its LF (and return not-zero), or
                                 ; stop at the NUL that ends the text (and return zero).
                    NXL:      LD   A,(HL)   
                              OR   A   
                              RET   Z   
                              INC   HL   
                              CP   10   
                              JR   NZ,nxl   
                              OR   A   
                              RET      
                                 ; prl: print the line at HL, to its LF; HL -> just past it.
                    PRL:      LD   A,(HL)   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              LD   A,(HL)   
                              INC   HL   
                              CP   10   
                              JR   NZ,prl   
                              RET      
0700                          ENDIF      
0700                          IF   EDGEN   
                    GED1:     JP   edit   
                                 ; ^R, generic: what comes in from now until ^Z is the program. A CR is
                                 ; stored as CR LF; a LF right after a line end is dropped (it is the CR's
                                 ; own, or an empty line's), and a LF anywhere else ends a line too. A last
                                 ; line with no end is given one. Nothing is echoed, and there is no check
                                 ; for running out of memory.
                    CREAD:    LD   HL,PROG-1   
                              LD   (HL),10   ; (as if a line had just ended: the byte is
                              INC   HL   ;   the line buffer's last, and spare)
                    RD1:      CALL   ekey   
                              LD   C,A   
                              CP   1Ah   
                              JR   NZ,rd2   
                              LD   A,10   ; ^Z ends the last line, as a LF would
                    RD2:      CP   10   
                              JR   NZ,rd3   
                              DEC   HL   
                              CP   (HL)   
                              INC   HL   
                              JR   Z,rd4   ; straight after a line end: dropped
                              LD   A,13   ; anywhere else it ends the line
                    RD3:      LD   (HL),A   
                              INC   HL   
                              CP   13   
                              JR   NZ,rd4   
                              LD   (HL),10   ; after a CR goes a LF
                              INC   HL   
                    RD4:      LD   A,C   
                              CP   1Ah   
                              JR   NZ,rd1   
                              LD   (HL),0   
                              JR   ged1   
                                 ; ^W, generic: the text is printed as it is, for the terminal to capture.
                    CWRITE:   LD   HL,PROG   
                    CW1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,ged1   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              INC   HL   
                              JR   cw1   
0700                          ENDIF      
0700                          IF   EDITOR*CPM   
                    CFCB:     EQU   005Ch   ; the file's name is kept here, where the CCP
                                 ;   put the one from the command line
                                 ; ^W, CP/M: write the file: delete the old one, make it anew, write the
                                 ; text in records of 128 bytes, and close it. The text's NUL and the 127
                                 ; bytes after it are set to ^Z meanwhile, which pads the last record. (A
                                 ; full disk or directory is not noticed: the calls fail and that is all.)
                    CWRITE:   CALL   setname   
                              LD   C,19   ; delete
                              CALL   fbdos   
                              LD   C,22   ; make
                              CALL   fbdos   
                              LD   HL,PROG   
                              XOR   A   
                    CW1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,cw1   
                              DEC   HL   ; HL -> the NUL
                              PUSH   HL   
                              LD   B,128   
                    CW2:      LD   (HL),1Ah   
                              INC   HL   
                              DJNZ   cw2   
                              POP   HL   
                              LD   DE,PROG   
                    CW3:      LD   A,E   ; a record that starts before the end is written
                              SUB   L   
                              LD   A,D   
                              SBC   A,H   
                              JR   NC,cw4   
                              PUSH   HL   
                              LD   C,21   ; write, from where the record lies
                              CALL   frec   
                              POP   HL   
                              JR   cw3   
                    CW4:      LD   (HL),0   ; the NUL again
                              LD   C,16   ; close
                              CALL   fbdos   
                              JP   edit   
                                 ; frec: BDOS function C (read or write a record) with the 128 bytes at DE.
                                 ; Returns A = the BDOS's answer, HL = DE and DE = DE + 128.
                    FREC:     PUSH   DE   
                              PUSH   BC   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              POP   BC   
                              CALL   fbdos   
                              POP   DE   
                              LD   HL,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              RET      
                                 ; setname: if a name was typed (the line does not start with its CR), put it
                                 ; in the FCB: up to 8 characters, a dot, up to 3 more, in capitals. The drive
                                 ; is the current one. Then, name or no name, clear the FCB after the name,
                                 ; as it must be before a file is opened or made.
                    SETNAME:   LD   DE,LINEBUF   
                              LD   A,(DE)   
                              CP   13   
                              JR   Z,fcbclr   
                              LD   HL,CFCB   
                              LD   (HL),0   ; the current drive
                              LD   B,11   
                    SN1:      INC   L   
                              LD   (HL)," "   
                              DJNZ   sn1   
                              LD   L,CFCB+1   
                    SN2:      LD   A,(DE)   
                              INC   DE   
                              CP   13   
                              JR   Z,fcbclr   
                              CP   "."   
                              JR   NZ,sn3   
                              LD   L,CFCB+9   ; the type
                              JR   sn2   
                    SN3:      CP   "a"   
                              JR   C,sn4   
                              AND   5Fh   ; a capital
                    SN4:      LD   (HL),A   
                              INC   L   
                              JR   sn2   
                    FCBCLR:   LD   HL,CFCB+12   
                              LD   B,24   
                    FC1:      LD   (HL),0   
                              INC   HL   
                              DJNZ   fc1   
                              RET      
                                 ; fbdos: BDOS function C on the file
                    FBDOS:    LD   DE,CFCB   
                              JP   BDOS   
                                 ; ^R, CP/M: read the file. A name typed before the key is the file's name
                                 ; from now on. (On into load, which returns to edit.)
                    CREAD:    CALL   setname   
                              LD   HL,edit   
                              PUSH   HL   
                                 ; load: read the file into PROG. No such file: no program. The text ends at
                                 ; the file"s first ^Z (1Ah), which pads a text file"s last record; one more
                                 ; goes after the last record, so the search always stops. And every line
                                 ; must end in LF: a last line without one is given a CR LF. (The FCB is
                                 ; clear after its name: the CCP left it so, or setname did.)
                    LOAD:     LD   C,15   ; open (no such file: the first read fails
                              CALL   fbdos   ;   too)
                              LD   DE,PROG   
                    LD1:      LD   C,20   ; read the next 128 bytes
                              CALL   frec   
                              OR   A   
                              JR   Z,ld1   
                              LD   (HL),1Ah   ; (HL = where the record that failed would be)
                              LD   HL,PROG-1   
                              LD   A,10   ; (a file with no text needs nothing added)
                    TR1:      INC   HL   
                              LD   E,A   ; E = the character before this one
                              LD   A,(HL)   
                              CP   1Ah   
                              JR   NZ,tr1   
                              LD   A,E   
                              CP   10   
                              JR   Z,tr2   
                              LD   (HL),13   
                              INC   HL   
                              LD   (HL),10   
                              INC   HL   
                    TR2:      LD   (HL),0   
                              RET      
0700                          ENDIF      
0700                             ; =============================================================================
0700                          IF   CPM   
0700                             ; The RAM pages follow the image; the heap may grow to the BDOS.
0700                START:       
0700                          ENDIF      
0700                          IF   CPM*CHECKED*(1-EDITOR)   
0700                             ; Clear the lower half of the letter page (as the editor build does
0700                             ; at its start).
0700   21 00 0B               LD   HL,LET   
0703   AF                     XOR   A   
0704   77           INI1:     LD   (HL),A   
0705   2C                     INC   L   
0706   F2 04 07               JP   P,ini1   ; +00h to +7Fh
0709                          ENDIF      
0709                          IF   CPM*(1-EDITOR)   
0709   11 5C 00               LD   DE,005Ch   ; open the file named on the command line
070C   0E 0F                  LD   C,15   ; (no such file: the first read fails too,
070E   CD 05 00               CALL   BDOS   ;   and the program is empty)
0711   11 00 0C               LD   DE,PROG   
0714   D5           LD1:      PUSH   DE   
0715   0E 1A                  LD   C,26   ; set the DMA address
0717   CD 05 00               CALL   BDOS   
071A   11 5C 00               LD   DE,005Ch   
071D   0E 14                  LD   C,20   ; read the next 128 bytes
071F   CD 05 00               CALL   BDOS   
0722   E1                     POP   HL   ; HL = the address this record went to
0723   B7                     OR   A   
0724   20 07                  JR   NZ,ld2   
0726   11 80 00               LD   DE,128   
0729   19                     ADD   HL,DE   
072A   EB                     EX   DE,HL   
072B   18 E7                  JR   ld1   
072D   36 00        LD2:      LD   (HL),0   ; the end of the file counts as NUL
072F   23                     INC   HL   ; the heap starts after it
0730   01 00 0C               LD   BC,PROG   ; the IP
0733                          ENDIF      
0733                          IF   CPM*(1-EDITOR)*QK   
0733   CD BE 04               CALL   skclr   ; an empty skip cache
0736                          ENDIF      
0736                          IF   CPM*(1-EDITOR)   
0736   C3 56 01               JP   st2   
0739                          ENDIF      
0739                          IF   FAST   
                                 ; =============================================================================
                                 ;  The fast build (SPEED = 2)
                                 ; 
                                 ;  The inner loop is a table: 256 entries, the low bytes of the handlers'
                                 ;  addresses in one page and the high bytes in the next. The dispatcher (at
                                 ;  next0, and inline, as NEXTF, at the end of the fast build's own entries,
                                 ;  so there is no jump back to it; the ordinary handlers end in JP (IX), with
                                 ;  IX = next0, as in the CP/M builds):
                                 ; 
                                 ;      LD A,(BC) / INC BC / EX DE,HL / LD L,A / LD H,DTAB/256 /
                                 ;      LD A,(HL) / INC H / LD H,(HL) / LD L,A / JP (HL)
                                 ; 
                                 ;  So every entry starts with TOS in DE, not HL. The punctuation entries are
                                 ;  thunks into the ordinary handlers (EX DE,HL / JP handler); the letters and
                                 ;  digits have one entry each, which knows its cell or its value already.
                                 ; =============================================================================
                    FTSTORE:   EX   DE,HL   ; !
                              JP   h_store   
                    FTSTR:    EX   DE,HL   ; "
                              JP   h_str   
                    FTNUM:    EX   DE,HL   ; #
                              JP   h_num   
                    FTPRINT:   EX   DE,HL   ; $
                              JP   h_print   
                    FTSWAP:   EX   DE,HL   ; %
                              JP   h_swap   
                    FTAND:    EX   DE,HL   ; &
                              JP   h_and   
                    FTEMIT:   EX   DE,HL   ; '
                              JP   h_emit   
                    FTOPEN:   EX   DE,HL   ; (
                              JP   h_open   
                    FTCLOSE:   EX   DE,HL   ; )
                              JP   h_close   
                    FTMUL:    EX   DE,HL   ; *
                              JP   h_mul   
                    FTADD:    EX   DE,HL   ; +
                              JP   h_add   
                    FTCFETCH:   EX   DE,HL   ; ,
                              JP   h_cfetch   
                    FTSUB:    EX   DE,HL   ; -
                              JP   h_sub   
                    FTCSTORE:   EX   DE,HL   ; .
                              JP   h_cstore   
                    FTDIV:    EX   DE,HL   ; /
                              JP   h_div   
                    FTDUP:    EX   DE,HL   ; :
                              JP   h_dup   
                    FTDROP:   EX   DE,HL   ; ;
                              JP   h_drop   
                    FTLT:     EX   DE,HL   ; <
                              JP   h_lt   
                    FTEQ:     EX   DE,HL   ; =
                              JP   h_eq   
                    FTGT:     EX   DE,HL   ; >
                              JP   h_gt   
                    FTKEY:    EX   DE,HL   ; ?
                              JP   h_key   
                    FTFETCH:   EX   DE,HL   ; @
                              JP   h_fetch   
                    FTDEF:    EX   DE,HL   ; [
                              JP   h_def   
                    FTBREAK:   EX   DE,HL   ; \
                              JP   h_break   
                    FTRET:    EX   DE,HL   ; ]
                              JP   h_ret   
                    FTXOR:    EX   DE,HL   ; ^
                              JP   h_xor   
                    FTALLOC:   EX   DE,HL   ; _
                              JP   h_alloc   
                    FTGRAVE:   EX   DE,HL   ; `
                              JP   h_grave   
                    FTTOR:    EX   DE,HL   ; {
                              JP   h_tor   
                    FTOR:     EX   DE,HL   ; |
                              JP   h_or   
                    FTFROMR:   EX   DE,HL   ; }
                              JP   h_fromr   
                    FTNOT:    EX   DE,HL   ; ~
                              JP   h_not   
                                 ; The commonest punctuation, written for the fast build: TOS in DE on the
                                 ; way in, and the dispatcher inline on the way out.
                    FS_ADD:      ; +
                              POP   HL   
                              ADD   HL,DE   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_SUB:      ; -
                              LD   A,(BC)   ; a digit next: a negative number
                              SUB   "0"   
                              CP   10   
                              JR   C,fs_neg   
                              POP   HL   
                              OR   A   
                              SBC   HL,DE   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_NEG:   EX   DE,HL   
                              JP   h_sub   
                    FS_DUP:      ; :
                              PUSH   DE   
                              EX   DE,HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_DROP:      ; ;
                              POP   HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_SWAP:      ; %
                              POP   HL   
                              PUSH   DE   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_FET:      ; @
                              EX   DE,HL   
                              LD   E,(HL)   
                              INC   HL   
                              LD   D,(HL)   
                              EX   DE,HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_CFET:      ; ,
                              LD   A,(DE)   
                              LD   L,A   
                              LD   H,0   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_LT:       ; <
                              POP   HL   ; a < b: HL = a, DE = b
                    FS_LT1:   LD   A,H   
                              XOR   80h   
                              LD   H,A   
                              LD   A,D   
                              XOR   80h   
                              LD   D,A   
                              SBC   HL,DE   ; carry if HL < DE
                              SBC   HL,HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_GT:       ; >
                              POP   HL   ; a > b  is  b < a
                              EX   DE,HL   
                              JP   fs_lt1   
                    FS_EQ:       ; =
                              POP   HL   
                              OR   A   
                              SBC   HL,DE   
                              LD   A,H   
                              OR   L   
                              CP   1   ; carry only if a - b = 0
                              SBC   HL,HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_AND:      ; &
                              POP   HL   
                              LD   A,H   
                              AND   D   
                              LD   H,A   
                              LD   A,L   
                              AND   E   
                              LD   L,A   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
