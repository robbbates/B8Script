0152   6F                     MOV   L,A   
0153   7C                     MOV   A,H   
0154   AA                     XRA   D   
0155   17                     RAL      ; carry = the signs differ
0156   9F                     SBB   A   
0157   AD                     XRA   L   ; flip when they do
0158   67                     MOV   H,A   
0159   6F                     MOV   L,A   
015A                          ;*Macro unroll:  NEXT
015A   F7                     DS   (1-CPM)*(1-FAST),0F7h   
015B                          DS   CPM+FAST-CPM*FAST,0C3h   
015B                          DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
015B                          DS   CPM+FAST-CPM*FAST,ANXT/256   
015B   D1           H_EQ:     POP   D   
015C   7D                     MOV   A,L   
015D   AB                     XRA   E   
015E   6F                     MOV   L,A   
015F   7C                     MOV   A,H   
