                              LD   A,(0007h)   ; the BDOS page is the limit
                              LD   H,A   
                              LD   L,0   
                              DEC   HL   
0552                          ENDIF      
0552                          IF   EDITOR   
0552   B7                     OR   A   
0553   ED 52                  SBC   HL,DE   
0555   CD 3C 03               CALL   pnl   
0558   46 72 65 65 20 22      DB   "Free ",22h   
055E   CD 77 02               CALL   pdec   ; the room left for text and heap
0561   CD 3C 03               CALL   pnl   
0564   22                     DB   22h   
0565   C3 86 03     GED1:     JP   edit   
0568                             ; delln: take line n (in HL) out: copy everything after it down over it.
0568   CD 78 05     DELLN:    CALL   find   
056B   54                     LD   D,H   
056C   5D                     LD   E,L   
056D   CD 86 05               CALL   nxl   ; HL -> the next line
0570   7E           DE1:      LD   A,(HL)   
0571   12                     LD   (DE),A   
0572   23                     INC   HL   
0573   13                     INC   DE   
0574   B7                     OR   A   
0575   20 F9                  JR   NZ,de1   
0577   C9                     RET      
0578                             ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
0578                             ; of the text if there are fewer lines (or the number is 0). Keeps BC.
0578   EB           FIND:     EX   DE,HL   
0579   21 00 83               LD   HL,PROG   
057C   1B           FI1:      DEC   DE   
057D   7A                     LD   A,D   
057E   B3                     OR   E   
057F   C8                     RET   Z   
0580   CD 86 05               CALL   nxl   
0583   20 F7                  JR   NZ,fi1   
0585   C9                     RET      
0586                             ; nxl: step HL over one line, to just past its LF (and return not-zero), or
0586                             ; stop at the NUL that ends the text (and return zero).
0586   7E           NXL:      LD   A,(HL)   
0587   B7                     OR   A   
0588   C8                     RET   Z   
0589   23                     INC   HL   
058A   FE 0A                  CP   10   
058C   20 F8                  JR   NZ,nxl   
058E   B7                     OR   A   
058F   C9                     RET      
0590                             ; prl: print the line at HL, to its LF; HL -> just past it.
0590   7E           PRL:      LD   A,(HL)   
0591   EF                     RST   28h   
0592   7E                     LD   A,(HL)   
0593   23                     INC   HL   
0594   FE 0A                  CP   10   
0596   20 F8                  JR   NZ,prl   
0598   C9                     RET      
0599                          ENDIF      
0599                          IF   EDGEN   
0599                             ; ^R, generic: what comes in from now until ^Z is the program. A CR is
0599                             ; stored as CR LF; a LF right after a line end is dropped (it is the CR's
0599                             ; own, or an empty line's), and a LF anywhere else ends a line too. A last
0599                             ; line with no end is given one. Nothing is echoed, and there is no check
0599                             ; for running out of memory.
0599   21 FF 82     CREAD:    LD   HL,PROG-1   
059C   36 0A                  LD   (HL),10   ; (as if a line had just ended: the byte is
059E   23                     INC   HL   ;   the line buffer's last, and spare)
059F   CD 26 04     RD1:      CALL   ekey   
05A2   4F                     LD   C,A   
05A3   FE 1A                  CP   1Ah   
05A5   20 02                  JR   NZ,rd2   
05A7   3E 0A                  LD   A,10   ; ^Z ends the last line, as a LF would
05A9   FE 0A        RD2:      CP   10   
05AB   20 07                  JR   NZ,rd3   
05AD   2B                     DEC   HL   
05AE   BE                     CP   (HL)   
05AF   23                     INC   HL   
05B0   28 0B                  JR   Z,rd4   ; straight after a line end: dropped
05B2   3E 0D                  LD   A,13   ; anywhere else it ends the line
05B4   77           RD3:      LD   (HL),A   
05B5   23                     INC   HL   
05B6   FE 0D                  CP   13   
05B8   20 03                  JR   NZ,rd4   
05BA   36 0A                  LD   (HL),10   ; after a CR goes a LF
05BC   23                     INC   HL   
05BD   79           RD4:      LD   A,C   
05BE   FE 1A                  CP   1Ah   
05C0   20 DD                  JR   NZ,rd1   
05C2   36 00                  LD   (HL),0   
05C4   18 9F                  JR   ged1   
05C6                             ; ^W, generic: the text is printed as it is, for the terminal to capture.
05C6   21 00 83     CWRITE:   LD   HL,PROG   
05C9   7E           CW1:      LD   A,(HL)   
05CA   B7                     OR   A   
05CB   28 98                  JR   Z,ged1   
05CD   EF                     RST   28h   
05CE   23                     INC   HL   
05CF   18 F8                  JR   cw1   
05D1                          ENDIF      
05D1                          IF   EDITOR*CPM   
                    CFCB:     EQU   005Ch   ; the file's name is kept here, where the CCP
                                 ;   put the one from the command line
                                 ; ^R, CP/M: read the file. A name typed before the key is the file's name
                                 ; from now on.
                    CREAD:    CALL   setname   
                              CALL   load   
                              JP   edit   
                                 ; ^W, CP/M: write the file: delete the old one, make it anew, write the
                                 ; text in records of 128 bytes, and close it. The text's NUL and the 127
                                 ; bytes after it are set to ^Z meanwhile, which pads the last record. (A
                                 ; full disk or directory is not noticed: the calls fail and that is all.)
                    CWRITE:   CALL   setname   
                              LD   C,19   ; delete
                              CALL   fbdos   
                              LD   C,22   ; make
                              CALL   fbdos   
                              LD   HL,PROG   
                              XOR   A   
                    CW1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,cw1   
                              DEC   HL   ; HL -> the NUL
                              PUSH   HL   
                              LD   B,128   
                    CW2:      LD   (HL),1Ah   
                              INC   HL   
                              DJNZ   cw2   
                              POP   HL   
                              LD   DE,PROG   
                    CW3:      LD   A,E   ; a record that starts before the end is written
                              SUB   L   
                              LD   A,D   
                              SBC   A,H   
                              JR   NC,cw4   
                              PUSH   HL   
                              LD   C,21   ; write, from where the record lies
                              CALL   frec   
                              POP   HL   
                              JR   cw3   
                    CW4:      LD   (HL),0   ; the NUL again
                              LD   C,16   ; close
                              CALL   fbdos   
                              JP   edit   
                                 ; frec: BDOS function C (read or write a record) with the 128 bytes at DE.
                                 ; Returns A = the BDOS's answer, HL = DE and DE = DE + 128.
                    FREC:     PUSH   DE   
                              PUSH   BC   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              POP   BC   
                              CALL   fbdos   
                              POP   HL   
                              LD   DE,128   
                              EX   DE,HL   
                              ADD   HL,DE   
                              EX   DE,HL   
                              RET      
                                 ; setname: if a name was typed (the line does not start with its CR), put it
                                 ; in the FCB: up to 8 characters, a dot, up to 3 more, in capitals. The drive
                                 ; is the current one. Then, name or no name, clear the FCB after the name,
                                 ; as it must be before a file is opened or made.
                    SETNAME:   LD   DE,LINEBUF   
                              LD   A,(DE)   
                              CP   13   
                              JR   Z,fcbclr   
                              LD   HL,CFCB   
                              LD   (HL),0   ; the current drive
                              LD   B,11   
                    SN1:      INC   L   
                              LD   (HL)," "   
                              DJNZ   sn1   
                              LD   L,CFCB+1   
                    SN2:      LD   A,(DE)   
                              INC   DE   
                              CP   13   
                              JR   Z,fcbclr   
                              CP   "."   
                              JR   NZ,sn3   
                              LD   L,CFCB+9   ; the type
                              JR   sn2   
                    SN3:      CP   "a"   
                              JR   C,sn4   
                              AND   5Fh   ; a capital
                    SN4:      LD   (HL),A   
                              INC   L   
                              JR   sn2   
                    FCBCLR:   LD   HL,CFCB+12   
                              LD   B,24   
                    FC1:      LD   (HL),0   
                              INC   HL   
                              DJNZ   fc1   
                              RET      
                                 ; fbdos: BDOS function C on the file
                    FBDOS:    LD   DE,CFCB   
                              JP   BDOS   
                                 ; load: read the file into PROG. No such file: no program. The text ends at
                                 ; the file"s first ^Z (1Ah), which pads a text file"s last record; one more
                                 ; goes after the last record, so the search always stops. And every line
                                 ; must end in LF: a last line without one is given a CR LF. (The FCB is
                                 ; clear after its name: the CCP left it so, or setname did.)
                    LOAD:     LD   C,15   ; open (no such file: the first read fails
                              CALL   fbdos   ;   too)
                              LD   DE,PROG   
                    LD1:      LD   C,20   ; read the next 128 bytes
                              CALL   frec   
                              OR   A   
                              JR   Z,ld1   
                              LD   (HL),1Ah   ; (HL = where the record that failed would be)
                              LD   HL,PROG-1   
                              LD   A,10   ; (a file with no text needs nothing added)
                    TR1:      INC   HL   
                              LD   E,A   ; E = the character before this one
                              LD   A,(HL)   
                              CP   1Ah   
                              JR   NZ,tr1   
                              LD   A,E   
                              CP   10   
                              JR   Z,tr2   
                              LD   (HL),13   
                              INC   HL   
                              LD   (HL),10   
                              INC   HL   
                    TR2:      LD   (HL),0   
                              RET      
05D1                          ENDIF      
05D1                             ; =============================================================================
05D1                          IF   CPM   
                                 ; The RAM pages follow the image; the heap may grow to the BDOS.
                    START:       
05D1                          ENDIF      
05D1                          IF   CPM*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
                                 ; is held back.
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
05D1                          ENDIF      
05D1                          IF   CPM   
                              LD   HL,vecs   ; the RST routines go down into page zero
                              LD   DE,0008h   
                              LD   BC,vecend-vecs   
                              LDIR      
05D1                          ENDIF      
05D1                          IF   CPM*EDITOR   
                              CALL   load   ; the file named on the command line
                              JP   edit0   
05D1                          ENDIF      
05D1                          IF   CPM*(1-EDITOR)   
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:      LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
                              JP   st2   
05D1                          ENDIF      
05D1                          IF   CPM   
                                 ; RAM pages, after the image
                    RSPAGE:   EQU   (imgend + 255) / 256   
                    DSPAGE:   EQU   RSPAGE + 1   
                    LETPAGE:   EQU   RSPAGE + 2   
                    PROG:     EQU   LETPAGE*256 + 256   
05D1                          ENDIF      
05D1                IMGEND:      


