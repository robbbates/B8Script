                              LDY   DSH,X   
                              STY   TH   
                              INX      
                              TAY      
                              BEQ   fop1   
                              LDA   IP+1   ; true: the block starts at the IP
                              PHA      
                              LDA   IP   
                              PHA      
                              DEC   CDOWN   
                              BNE   fop2   
                              JSR   fpoll   
                              ;*Macro unroll: fop2:   NEXTF
                    FOP2:     DS   1-CHECKED,0A0h   
                              DS   1-CHECKED,0   
                              DS   1-CHECKED,0B1h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0D0h   
                              DS   1-CHECKED,2   
