0236                          DS   1-CPM,0E7h   ; a - b = a + (-b): fall into "+"
0236   CD                     DS   CPM,0CDh   
0237   27                     DS   CPM,ANEG&0FFh   
0238   01                     DS   CPM,ANEG/256   
0239   D1           H_ADD:    POP   D   
023A   19                     DAD   D   
023B                          ;*Macro unroll:  NEXT
023B                          DS   (1-CPM)*(1-FAST),0F7h   
023B   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
023C   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
023D   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
023E   D1           H_AND:    POP   D   
023F   7C                     MOV   A,H   
0240   A2                     ANA   D   
0241   67                     MOV   H,A   
0242   7D                     MOV   A,L   
0243   A3                     ANA   E   
0244   6F                     MOV   L,A   
0245                          ;*Macro unroll:  NEXT
0245                          DS   (1-CPM)*(1-FAST),0F7h   
0245   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
0246   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
0247   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
0248                             ; Signed compares. Both are "DE < HL" for the right pair: > swaps the two
0248                             ; cells first (XTHL), < doesn't. There is no overflow flag, so the signed
0248                             ; answer is the unsigned borrow of DE - HL, flipped when the signs differ.
0248                             ; SBB A turns a carry into -1 or 0 with no branch.
0248   E3           H_GT:     XTHL      ; a > b  is  b < a
0249   D1           H_LT:     POP   D   ; a < b: DE = a, HL = b
024A   7B                     MOV   A,E   
024B   95                     SUB   L   
024C   7A                     MOV   A,D   
024D   9C                     SBB   H   
024E   9F                     SBB   A   ; A = -1 if DE < HL unsigned
024F   6F                     MOV   L,A   
0250   7C                     MOV   A,H   
0251   AA                     XRA   D   
0252   17                     RAL      ; carry = the signs differ
0253   9F                     SBB   A   
0254   AD                     XRA   L   ; flip when they do
0255   67                     MOV   H,A   
0256   6F                     MOV   L,A   
0257                          ;*Macro unroll:  NEXT
0257                          DS   (1-CPM)*(1-FAST),0F7h   
0257   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
0258   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
0259   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
025A   D1           H_EQ:     POP   D   
025B   7D                     MOV   A,L   
025C   AB                     XRA   E   
025D   6F                     MOV   L,A   
025E   7C                     MOV   A,H   
025F   AA                     XRA   D   
0260   B5                     ORA   L   ; zero if equal
0261   D6 01                  SUI   1   ; carry only for zero
0263   9F                     SBB   A   
0264   67                     MOV   H,A   
0265   6F                     MOV   L,A   
0266                          ;*Macro unroll:  NEXT
0266                          DS   (1-CPM)*(1-FAST),0F7h   
0266   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
0267   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
0268   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
0269                             ; "*": shift-and-add on the multiplier's low bit, so it stops as soon as the
0269                             ; multiplier is used up; only the low 16 bits are kept.
0269                          IF   QK   
0269   D1           H_MUL:    POP   D   ; DE = multiplicand
026A   C3 43 05               JMP   mulq   ; (out of the handlers' pages: see Speed-ups)
026D                          ENDIF      
026D                          IF   1-QK   
                    H_MUL:    POP   D   ; DE = multiplicand
                              PUSH   B   
                              MOV   B,H   
                              MOV   C,L   ; BC = multiplier
                              LXI   H,0   
                    MUL1:     MOV   A,B   
                              ORA   A   ; clear carry
                              RAR      
                              MOV   B,A   
                              MOV   A,C   
                              RAR      
                              MOV   C,A   ; BC >> 1, carry = the bit shifted out
                              JNC   mul2   
                              DAD   D   
                    MUL2:     XCHG      
                              DAD   H   ; multiplicand << 1
                              XCHG      
                              MOV   A,B   
                              ORA   C   
                              JNZ   mul1   
                              POP   B   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0C3h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
026D                          ENDIF      
026D                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
026D                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
026D                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
026D                             ; stops on it.
026D                H_DIV:       
026D                          IF   CHECKED   
026D   7C                     MOV   A,H   
026E   B5                     ORA   L   
026F   CA CE 06               JZ   e_zero   
0272                          ENDIF      
0272   D1                     POP   D   ; DE = a, HL = b
0273   C5                     PUSH   B   
0274   7A                     MOV   A,D   
0275   B7                     ORA   A   
0276   F5                     PUSH   PSW   ; S flag = sign of a (for r)
0277   AC                     XRA   H   
0278   F5                     PUSH   PSW   ; S flag = sign of q
0279   7C                     MOV   A,H   
027A   B7                     ORA   A   
027B   FC 27 01               CM   neg16   ; HL = |b|
027E   EB                     XCHG      
027F   7C                     MOV   A,H   
0280   B7                     ORA   A   
0281   FC 27 01               CM   neg16   ; HL = |a|, DE = |b|
0284   CD 7F 03               CALL   udiv   ; HL = q, BC = r
0287   F1                     POP   PSW   
0288   FC 27 01               CM   neg16   ; q's sign
028B   EB                     XCHG      ; DE = q
028C   60                     MOV   H,B   
