0718                          ENDIF      
0718                          IF   QK   
0718   21 00 F0               LXI   H,CPAGE*256   ; every run starts with an empty skip cache (a
071B   AF                     XRA   A   ;   start of 0000h matches no skip)
071C   77           SKC1:     MOV   M,A   
071D   2C                     INR   L   
071E   C2 1C 07               JNZ   skc1   
0721                          ENDIF      
0721                          IF   CHECKED   
0721                             ; Clear the lower half of the letter page: every variable starts at
0721                             ; 0, every word cell holds 0000h, the address an undefined word is
0721                             ; caught at (see e_hi), and no key is held back.
0721   21 00 82               LXI   H,LET   
0724   AF                     XRA   A   
