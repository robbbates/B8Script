  1294                              <1> %endif
  1295                              <1> 
  1296                              <1> ; -n?: Backspace takes the last character back (and is echoed as it is),
  1297                              <1> ; CR ends (stored, not echoed), every other key is stored and echoed until
  1298                              <1> ; the line is full. The buffer is at offset 80h of the letter page, so DL
  1299                              <1> ; alone is the place in the line; BL is the DL of a full line.
  1300 00000618 66F7DB              <1> line:   neg     bx                      ; the count (8000h for -32768)
  1301 0000061B 6683FB7F            <1>         cmp     bx,127
  1302 0000061F 7602                <1>         jbe     .ln1
  1303 00000621 B37F                <1>         mov     bl,127
  1304 00000623 80C380              <1> .ln1:   add     bl,80h
  1305 00000626 BA80014100          <1>         mov     edx,ARENA+LINEBUF
  1306 0000062B 31C9                <1>         xor     ecx,ecx                 ; getk waits for ever
  1307 0000062D E82EFFFFFF          <1> .ln2:   call    getk
  1308 00000632 3C0D                <1>         cmp     al,13
  1309 00000634 7418                <1>         je      .ln5
  1310 00000636 3C08                <1>         cmp     al,8
  1311 00000638 740C                <1>         je      .ln4
  1312 0000063A 38DA                <1>         cmp     dl,bl
  1313 0000063C 74EF                <1>         je      .ln2                    ; full
  1314 0000063E 8802                <1>         mov     [edx],al
  1315 00000640 42                  <1>         inc     edx
  1316                              <1> .ln3:   CALLP   putc
  1316                              <2> .ln3: 
   192                              <2>  %if P_%1
   193 00000641 FF55CD              <2>  call [V(p_%1)]
   194                              <2>  %else
   195                              <2>  call %1
   196                              <2>  %endif
  1317 00000644 EBE7                <1>         jmp     .ln2
  1318 00000646 FECA                <1> .ln4:   dec     dl                      ; Backspace: one back, and echo it,
  1319 00000648 78F7                <1>         js      .ln3                    ;   unless the line was empty (DL left
  1320 0000064A FEC2                <1>         inc     dl                      ;   the upper half of the page)
  1321 0000064C EBDF                <1>         jmp     .ln2
  1322 0000064E 8802                <1> .ln5:   mov     [edx],al                ; the CR
  1323 00000650 66BB8001            <1>         mov     bx,LINEBUF
  1324 00000654 FFE5                <1>         jmp     ebp
