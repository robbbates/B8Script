  1326                              <1> ; =============================================================================
  1327                              <1> ;  Routines
  1328                              <1> ; =============================================================================
  1329                              <1> 
  1330                              <1> ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
  1331                              <1> ; and return its value in AL with the carry set; otherwise leave the IP and
  1332                              <1> ; return with the carry clear.
  1333 00000656 8A06                <1> hexc:   mov     al,[esi]
  1334 00000658 2C30                <1>         sub     al,'0'
  1335 0000065A 3C0A                <1>         cmp     al,10
  1336 0000065C 720A                <1>         jb      .hc1
  1337 0000065E 24DF                <1>         and     al,0DFh
  1338 00000660 2C11                <1>         sub     al,11h
  1339 00000662 3C06                <1>         cmp     al,6
  1340 00000664 7303                <1>         jae     .hc2
  1341 00000666 2CF6                <1>         sub     al,0F6h                 ; + 10, and sets the carry
  1342 00000668 46                  <1> .hc1:   inc     esi
  1343 00000669 C3                  <1> .hc2:   ret
  1344                              <1> 
  1345                              <1> ; rdnum: read decimal digits at IP into BX (and DX); IP is left on the
  1346                              <1> ; first non-digit. Values wrap at 16 bits, as the spec says.
  1347 0000066A 31D2                <1> rdnum:  xor     edx,edx
  1348 0000066C 0FB606              <1> .rn1:   movzx   eax,byte [esi]
  1349 0000066F 2C30                <1>         sub     al,'0'
  1350 00000671 3C0A                <1>         cmp     al,10
  1351 00000673 7308                <1>         jae     .rn2
  1352 00000675 46                  <1>         inc     esi
  1353 00000676 6BD20A              <1>         imul    edx,edx,10
  1354 00000679 01C2                <1>         add     edx,eax
  1355 0000067B EBEF                <1>         jmp     .rn1
  1356 0000067D 6689D3              <1> .rn2:   mov     bx,dx
  1357 00000680 C3                  <1>         ret
  1358                              <1> 
  1359                              <1> 
  1360                              <1> %if CHECKED
  1361                              <1> ; pmsg: print the text that follows the CALL, to its closing quote (through
  1362                              <1> ; prstr), and carry on after it. Uses EBX.
  1363 00000681 5B                  <1> pmsg:   pop     ebx
  1364 00000682 E83BFDFFFF          <1>         call    prstr
  1365 00000687 FFE3                <1>         jmp     ebx
  1366                              <1> %endif
