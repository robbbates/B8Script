   528                              <1> ; ---- machine code: the grave -----------------------------------------------
   529                              <1> ; '`' plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
   530                              <1> ; are stored from addr until a non-hex character; then a RET (C3h) is
   531                              <1> ; written and its address is left. An odd last digit is consumed and its
   532                              <1> ; byte is overwritten by the RET. (Never range-checked: the spec says so.)
   533                              <1> ; '`' plus anything else calls the machine code at TOS: ( addr -- ).
   534                              <1> ;
   535                              <1> ; The machine-code contract: the code is entered by CALL, with the return
   536                              <1> ; address at [ESP] and the data stack above it: [ESP+4] is the top cell
   537                              <1> ; (the one under the address, which was consumed), [ESP+8] the next, one
   538                              <1> ; dword per cell, the cell in the low word. EBX holds the code's own
   539                              <1> ; address (ARENA + addr), and its high word is the arena's (0041h): a
   540                              <1> ; B8Script address a is the byte at ARENA + a. The code may push and pop
   541                              <1> ; dwords, and may change EAX, EBX, ECX, EDX and the flags; it must keep
   542                              <1> ; ESI, EDI and EBP, leave the direction flag clear, and return with RET
   543                              <1> ; (C3h, which the loader writes). On return the dword on top of the stack
   544                              <1> ; becomes TOS. Only the low word of each cell counts: the interpreter puts
   545                              <1> ; the arena's high word back into every cell on the stack.
   546 000001C5 E8F8010000          <1> grave1: call    hexc
   547 000001CA 731B                <1>         jnc     .ex
   548 000001CC 8803                <1> .hx1:   mov     [ebx],al                ; the high digit goes in first ...
   549 000001CE E8EF010000          <1>         call    hexc
   550 000001D3 730D                <1>         jnc     .hx2                    ; odd digit: consumed, and the RET
   551 000001D5 C02304              <1>         shl     byte [ebx],4            ;   overwrites it
   552 000001D8 0803                <1>         or      [ebx],al                ; ... and the low one joins it
   553 000001DA 43                  <1>         inc     ebx
   554 000001DB E8E2010000          <1>         call    hexc
   555 000001E0 72EA                <1>         jc      .hx1
   556 000001E2 C603C3              <1> .hx2:   mov     byte [ebx],0C3h
   557 000001E5 FFE5                <1>         jmp     ebp
