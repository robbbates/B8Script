F324   99 77                  ADCA   <SEED+1   ; * 5
F326   9B 76                  ADDA   <SEED   ; + * 256: * 261
F328   C3 00 01               ADDD   #1   
F32B   D7 76                  STB   <SEED   
F32D   97 77                  STA   <SEED+1   
F32F   D8 77                  EORB   <SEED+1   
F331   AE C4                  LDX   ,U   ; n
F333   ED C4                  STD   ,U   ; the dividend under it
F335   36 10                  PSHU   X   
F337   8D B8                  BSR   udiv   ; NOS = the quotient, TOS = the remainder
F339   37 06                  PULU   D   
F33B   ED C4                  STD   ,U   
F33D   39                     RTS      
