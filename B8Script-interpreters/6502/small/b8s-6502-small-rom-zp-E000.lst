E2EE   81 00                  STA   (0,X)   
E2F0   60                     RTS      
E2F1   B5 00        EXEC:     LDA   0,X   
E2F3   85 04                  STA   T0   
E2F5   B5 01                  LDA   1,X   
E2F7   85 05                  STA   T1   
E2F9   E8                     INX      ; the address is consumed
E2FA   E8                     INX      
E2FB   6C 04 00               JMP   (T0)   
E2FE                             ; ---- "_" is the last handler: its body may leave the page
E2FE                             ; "_" ( n -- addr ): the heap top moves by n, which is signed: a negative
E2FE                             ; count releases. TOS becomes the old top. (The carry is clear on the way in.)
E2FE                          IF   1-CHECKED   
                    H_ALLOC:   LDA   HEAP   
                              TAY      
                              ADC   0,X   
                              STA   HEAP   
                              STY   0,X   
                              LDA   HEAP+1   
                              TAY      
                              ADC   1,X   
                              STA   HEAP+1   
                              STY   1,X   
                              RTS      
E2FE                          ENDIF      
E2FE                             ; The checked build works the new top out first, in T0 and Y, and stops with
E2FE                             ; H, the count still on the stack, if it is at or past the limit, below the
E2FE                             ; program's end, or if the 16-bit add wrapped. A wrap is the V flag of the
E2FE                             ; high bytes" add with the old top"s sign bit flipped: that makes the old top
E2FE                             ; a signed number from -8000h, so the add overflows exactly when the true
E2FE                             ; sum leaves 0000h-FFFFh.
E2FE                          IF   CHECKED   
E2FE   AD 7C 04     H_ALLOC:   LDA   HEAP   
