015F                          DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
015F                          DS   CPM+FAST-CPM*FAST,ANXT/256   
015F   D1           H_EQ:     POP   D   
0160   7D                     MOV   A,L   
0161   AB                     XRA   E   
0162   6F                     MOV   L,A   
0163   7C                     MOV   A,H   
0164   AA                     XRA   D   
