   978                              <1> ; `! The machine-code contract: the code is entered by CALL, with the return
   979                              <1> ; address at [ESP] and the data stack above it: [ESP+4] is the top cell
   980                              <1> ; (the one under the address, which was consumed), [ESP+8] the next, one
   981                              <1> ; dword per cell, the cell in the low word. EBX holds the code's own
   982                              <1> ; address (ARENA + addr), and its high word is the arena's (0041h): a
   983                              <1> ; B8Script address a is the byte at ARENA + a. The code may push and pop
   984                              <1> ; dwords, and may change EAX, EBX, ECX, EDX and the flags; it must keep
   985                              <1> ; ESI, EDI and EBP, leave the direction flag clear, and return with RET
   986                              <1> ; (C3h, which the loader writes). On return the dword on top of the stack
   987                              <1> ; becomes TOS. Only the low word of each cell counts: the interpreter puts
   988                              <1> ; the arena's high word back into every cell on the stack.
   989 000004B3 FFD3                <1> g_exec: call    ebx
   990 000004B5 89E0                <1>         mov     eax,esp                 ; (the stack holds one cell at least,
   991 000004B7 66C740024100        <1> .ex1:   mov     word [eax+2],ARENA>>16  ;   the one that stands for TOS)
   992 000004BD 83C004              <1>         add     eax,4
