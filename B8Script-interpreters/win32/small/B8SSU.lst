     1                                  %define CHECKED 0
     2                                  %define EDITOR 0
     3                                  %define SPEED 0
     4                                  [map all B8SSU.map]
     5                                  %include "/home/user/B8Script/B8Script-interpreters/win32/b8s-win32.asm"
     1                              <1> ; =============================================================================
     2                              <1> ;  B8Script interpreter for 32-bit Windows (x86, console subsystem)
     3                              <1> ;  Spec: docs/b8script.md (2026-11-24).
     4                              <1> ;
     5                              <1> ;  Assembler: NASM 2.16, flat binary output: the PE header is laid out by
     6                              <1> ;  hand at the top of this file, so the output IS the .EXE:
     7                              <1> ;
     8                              <1> ;      nasm -f bin -DCHECKED=1 -o B8S.EXE b8s-win32.asm
     9                              <1> ;      nasm -f bin -o B8SU.EXE b8s-win32.asm
    10                              <1> ;      nasm -f bin -DEDITOR=1 -DCHECKED=1 -o B8SE.EXE b8s-win32.asm
    11                              <1> ;      nasm -f bin -DEDITOR=1 -o B8SEU.EXE b8s-win32.asm
    12                              <1> ;
    13                              <1> ;  Those are the base builds. Add -DSPEED=0 for the small ones (B8SS.EXE,
    14                              <1> ;  B8SSU.EXE, B8SSE.EXE, B8SSEU.EXE) or -DSPEED=2 for the fast ones (B8SF*).
    15                              <1> ;
    16                              <1> ;  Three switches (the defaults below, or -D on the command line):
    17                              <1> ;    CHECKED  0 = no checks (spec: the programmer is responsible)
    18                              <1> ;             1 = starts with every variable at 0 and every word undefined,
    19                              <1> ;                 and stops on every error in the spec's table (and Ctrl-C)
    20                              <1> ;                 with the four-line report, on the standard error handle.
    21                              <1> ;    EDITOR   0 = a runner: B8S PROG.B8S loads the file, runs it, exits
    22                              <1> ;             1 = the line editor of the spec's suggested standard (the same
    23                              <1> ;                 editor as the Z80's, key for key); the file named on the
    24                              <1> ;                 command line is the program to start with.
    25                              <1> ;    SPEED    0 = small: the smallest build
    26                              <1> ;             1 = base, the default: the speed-ups that cost few bytes: a
    27                              <1> ;                 skip cache, a faster skip, '/' by a power of two as shifts,
    28                              <1> ;                 and (unchecked) a variable then '@' or '!' in one step (see
    29                              <1> ;                 "Speed-ups")
    30                              <1> ;             2 = fast: base, and a 256-entry jump table besides, with no
    31                              <1> ;                 size limit (see "The fast build")
    32                              <1> ;             Each goes with either setting of the other two.
    33                              <1> ;
    34                              <1> ;  In every build Ctrl-C stops a running program (an unchecked runner stops
    35                              <1> ;  without a word): see the console layer for the rules, the held key and
    36                              <1> ;  the break-off cell.
    37                              <1> ;
    38                              <1> ;  The console escapes of '$' (/{ /} /| /` /~) always send ANSI (VT100)
    39                              <1> ;  sequences: the output's console mode asks for them to be obeyed (see
    40                              <1> ;  the startup).
    41                              <1> ; =============================================================================
    42                              <1> 
    43                              <1> %ifndef CHECKED
    44                              <1> %define CHECKED 0
    45                              <1> %endif
    46                              <1> %ifndef EDITOR
    47                              <1> %define EDITOR  0
    48                              <1> %endif
    49                              <1> %ifndef SPEED
    50                              <1> %define SPEED   1               ; 0 = small, 1 = base, 2 = fast
    51                              <1> %endif
    52                              <1> %assign FAST    SPEED/2         ; (1: the fast build)
    53                              <1> %assign SBASE   SPEED-FAST*2    ; (1: the base build)
    54                              <1> %if SBASE || FAST
    55                              <1>  %define QK     1               ; (the speed-ups: base, or the fast build)
    56                              <1> %else
    57                              <1>  %define QK     0
    58                              <1> %endif
    59                              <1> %if QK && !CHECKED && !FAST
    60                              <1>  %define SBASEU 1               ; (and those that only the unchecked base
    61                              <1> %else                           ;   builds take; the fast build has its own)
    62                              <1>  %define SBASEU 0
    63                              <1> %endif
    64                              <1> 
    65                              <1> ; -----------------------------------------------------------------------------
    66                              <1> ;  The machine model
    67                              <1> ;
    68                              <1> ;  B8Script is defined for a 64 KB machine with 16-bit cells, and that is what
    69                              <1> ;  runs here. The 64 KB arena sits at ARENA (00410000h), a multiple of 64 KB,
    70                              <1> ;  inside the image (its last 64 KB of uninitialised space): the B8Script
    71                              <1> ;  address a is the byte at ARENA + a. Because the arena is 64 KB aligned,
    72                              <1> ;  "ARENA + a" is simply a 32-bit register whose high word is 0041h and whose
    73                              <1> ;  low word is a. Every cell the interpreter keeps in a 32-bit register or
    74                              <1> ;  stack slot is kept in that form, so it is at once the 16-bit cell (its low
    75                              <1> ;  word) and a pointer to that cell's address:
    76                              <1> ;
    77                              <1> ;    EBX  TOS. 16-bit operations work on BX; EBX's high word is always 0041h,
    78                              <1> ;         so [EBX] is the byte TOS points at.
    79                              <1> ;    ESI  IP: a pointer to the next program character (LODSB reads it).
    80                              <1> ;    ESP  the data stack: one dword per cell, low word the cell, high word
    81                              <1> ;         0041h. [ESP] is NOS. It is the thread's own stack (the API calls
    82                              <1> ;         push their arguments below it). V_DSTOP holds ESP for the empty
    83                              <1> ;         stack.
    84                              <1> ;    EDI  the return stack pointer: dword entries (IP values and cells parked
    85                              <1> ;         with '{', all in the same form), growing down from RSTOP. A pop is
    86                              <1> ;         MOV r,[EDI] / SCASD (SCASD only steps EDI on by 4).
    87                              <1> ;    EBP  the address of `next`: every handler ends with JMP EBP (2 bytes),
    88                              <1> ;         and the interpreter's own variables, the import address table
    89                              <1> ;         and the pointers to the routines called most (see CALLP) lie
    90                              <1> ;         within 127 bytes of `next`, so [EBP+d8] reaches them in 3-byte
    91                              <1> ;         instructions. (V() below names them.)
    92                              <1> ;    EAX ECX EDX  scratch. (The Windows API keeps EBX, ESI, EDI and EBP.)
    93                              <1> ;
    94                              <1> ;  Memory map of the arena (B8Script addresses):
    95                              <1> ;    0000h-00FFh  page zero: unused, and left zero. An undefined word's cell
    96                              <1> ;                 holds 0000h, so calling it runs into the NUL at 0000h; the
    97                              <1> ;                 checked build sees that the IP is 0001h there and reports U.
    98                              <1> ;    0100h        the letter page: A-Z at +00h..+33h, a-z at +40h..+73h (a
    99                              <1> ;                 word's cell is 64 bytes below its variable's), the held key
   100                              <1> ;                 at +7Ah, the break-off cell at +7Bh, the heap pointer at +7Ch,
   101                              <1> ;                 and the -n? line buffer at +80h..+FFh (127 characters and CR;
   102                              <1> ;                 the editor's input line uses it too)
   103                              <1> ;    0200h        PROG: the program text, ending in NUL; the heap starts after
   104                              <1> ;                 the NUL and may grow up to the heap limit, FF00h
   105                              <1> ;    FF00h-FFFFh  above the limit: not the program's (unused)
   106                              <1> ;  The stacks are outside the arena: the return stack is 112 entries below
   107                              <1> ;  RSTOP (in the image's uninitialised space below the arena) and the data
   108                              <1> ;  stack is the thread's stack (127 cells in the checked builds, as deep as
   109                              <1> ;  the 1 MB stack reserve allows in the others). The base and fast builds
   110                              <1> ;  keep their skip cache (64 entries, 512 bytes) after the interpreter's
   111                              <1> ;  variables, in the image's uninitialised space below NAMEBUF.
   112                              <1> ;
   113                              <1> ;  The whole image (code, arena) is one section, readable, writable and
   114                              <1> ;  executable, so machine code can run in the arena (see h_grave).
   115                              <1> ; -----------------------------------------------------------------------------
   116                              <1> 
   117                              <1> IB      equ     400000h         ; ImageBase
   118                              <1> SECTVA  equ     1000h           ; the section's RVA
   119                              <1> ARENA   equ     410000h         ; the 64 KB B8Script memory (RVA 10000h)
   120                              <1> IMGSIZE equ     20000h          ; SizeOfImage: the arena is its last 64 KB
   121                              <1> 
   122                              <1> LET     equ     0100h           ; the letter page (a B8Script address)
   123                              <1> HELD    equ     LET+7Ah         ; a key read by the break check, held for the
   124                              <1>                                 ;   next '?' (0: none)
   125                              <1> BRKOFF  equ     LET+7Bh         ; the break-off cell: a non-zero byte here
   126                              <1>                                 ;   makes Ctrl-C a key like any other
   127                              <1> HEAP    equ     LET+7Ch         ; the heap pointer (a cell)
   128                              <1> LINEBUF equ     LET+80h         ; the -n? line buffer
   129                              <1> PROG    equ     0200h           ; the program text
   130                              <1> HEAPLIM equ     0FFh            ; the heap limit, as a page: FF00h
   131                              <1> LIMIT   equ     HEAPLIM*256
   132                              <1> MAXFILE equ     LIMIT-PROG-3    ; the most a file may bring (room for CR LF NUL)
   133                              <1> 
   134                              <1> RSTOP   equ     IB+0FF00h       ; the empty return stack (it grows down)
   135                              <1> RSMAX   equ     112             ; return stack entries (checked builds)
   136                              <1> DSMAX   equ     127             ; data stack cells (checked builds)
   137                              <1> NAMEBUF equ     IB+0F000h       ; the file's name, as typed (up to 3.5 KB)
   138                              <1> %if QK
   139                              <1> NSKC    equ     64              ; the skip cache's entries (base)
   140                              <1> %endif
   141                              <1> 
   142                              <1> ; -----------------------------------------------------------------------------
   143                              <1> ;  The PE header, by the documented rules: a 64-byte DOS header whose
   144                              <1> ;  e_lfanew points at the PE signature, the COFF header, the PE32 optional
   145                              <1> ;  header with its 16 data directories, and one section header. Then zeros
   146                              <1> ;  up to SizeOfHeaders (200h, one FileAlignment).
   147                              <1> ; -----------------------------------------------------------------------------
   148                              <1>         bits    32
   149                              <1>         section hdr start=0 vstart=IB
   150 00000000 4D5A                <1>         dw      'MZ'                    ; e_magic
   151 00000002 00<rep 3Ah>         <1>         times   3Ch-($-$$) db 0
   152 0000003C [4000C0FF]          <1>         dd      pe-IB                   ; e_lfanew
   153 00000040 50450000            <1> pe:     db      'PE',0,0
   154 00000044 4C01                <1>         dw      14Ch                    ; Machine: i386
   155 00000046 0100                <1>         dw      1                       ; NumberOfSections
   156 00000048 00000000            <1>         dd      0                       ; TimeDateStamp
   157 0000004C 0000000000000000    <1>         dd      0, 0                    ; no COFF symbols
   158 00000054 E000                <1>         dw      opthdr_end-opthdr       ; SizeOfOptionalHeader (224)
   159 00000056 0F01                <1>         dw      010Fh                   ; RELOCS_STRIPPED, EXECUTABLE_IMAGE,
   160                              <1>                                         ;   LINE_NUMS_STRIPPED,
   161                              <1>                                         ;   LOCAL_SYMS_STRIPPED, 32BIT_MACHINE
   162 00000058 0B01                <1> opthdr: dw      10Bh                    ; PE32
   163 0000005A 0100                <1>         db      1, 0                    ; linker version
   164 0000005C 00080000            <1>         dd      RAWSIZE                 ; SizeOfCode
   165 00000060 00080000            <1>         dd      RAWSIZE                 ; SizeOfInitializedData
   166 00000064 00000000            <1>         dd      0                       ; SizeOfUninitializedData
   167 00000068 [0000C0FF]          <1>         dd      start-IB                ; AddressOfEntryPoint
   168 0000006C 00100000            <1>         dd      SECTVA                  ; BaseOfCode
   169 00000070 00100000            <1>         dd      SECTVA                  ; BaseOfData
   170 00000074 00004000            <1>         dd      IB                      ; ImageBase
   171 00000078 00100000            <1>         dd      1000h                   ; SectionAlignment
   172 0000007C 00020000            <1>         dd      200h                    ; FileAlignment
   173 00000080 04000000            <1>         dw      4, 0                    ; OS version 4.0
   174 00000084 00000000            <1>         dw      0, 0                    ; image version
   175 00000088 04000000            <1>         dw      4, 0                    ; subsystem version 4.0
   176 0000008C 00000000            <1>         dd      0                       ; Win32VersionValue
   177 00000090 00000200            <1>         dd      IMGSIZE                 ; SizeOfImage
   178 00000094 00020000            <1>         dd      200h                    ; SizeOfHeaders
   179 00000098 00000000            <1>         dd      0                       ; CheckSum
   180 0000009C 0300                <1>         dw      3                       ; Subsystem: Windows console
   181 0000009E 0000                <1>         dw      0                       ; DllCharacteristics: none
   182 000000A0 0000100000100000    <1>         dd      100000h, 1000h          ; stack reserve, commit
   183 000000A8 0000100000100000    <1>         dd      100000h, 1000h          ; heap reserve, commit
   184 000000B0 00000000            <1>         dd      0                       ; LoaderFlags
   185 000000B4 10000000            <1>         dd      16                      ; NumberOfRvaAndSizes
   186 000000B8 0000000000000000    <1>         dd      0, 0                    ; 0 export
   187 000000C0 [C404C0FF]28000000  <1>         dd      idesc-IB, idesc_end-idesc ; 1 import
   188 000000C8 00000000<rep 14h>   <1>         times   10*2 dd 0               ; 2-11
   189 00000118 [0406C0FF]34000000  <1>         dd      iat-IB, iat_end-iat     ; 12 IAT
   190 00000120 00000000<rep 6h>    <1>         times   3*2 dd 0                ; 13-15
   191                              <1> opthdr_end:
   192 00000138 2E74657874000000    <1>         db      '.text',0,0,0           ; the one section
   193 00000140 00F00100            <1>         dd      IMGSIZE-SECTVA          ; VirtualSize: code, then zeros up to
   194                              <1>                                         ;   the arena's end
   195 00000144 00100000            <1>         dd      SECTVA                  ; VirtualAddress
   196 00000148 00080000            <1>         dd      RAWSIZE                 ; SizeOfRawData
   197 0000014C 00020000            <1>         dd      200h                    ; PointerToRawData
   198 00000150 0000000000000000    <1>         dd      0, 0                    ; no relocations, no line numbers
   199 00000158 00000000            <1>         dw      0, 0
   200 0000015C 600000E0            <1>         dd      0E0000060h              ; code, initialised data, execute,
   201                              <1>                                         ;   read, write
   202 00000160 00<rep A0h>         <1>         times   200h-($-$$) db 0
   203                              <1> 
   204                              <1> ; =============================================================================
   205                              <1> ;  The code
   206                              <1> ; =============================================================================
   207                              <1>         section text start=200h vstart=IB+SECTVA
   208                              <1> tstart:
   209                              <1> %define V(x) ebp+(x)-next               ; a variable or IAT slot near `next`
   210                              <1> 
   211                              <1> ; The routines called from many places are called through a pointer near
   212                              <1> ; `next` (CALL [EBP+d8], 3 bytes, instead of 5): the pointers are at ptrs,
   213                              <1> ; after the IAT. P_x says whether routine x has one in this build.
   214                              <1> %define P_putc  1
   215                              <1> %define P_waitk EDITOR
   216                              <1> %define P_ekey  EDITOR
   217                              <1> %define P_rdnum EDITOR
   218                              <1> %define P_find  EDITOR
   219                              <1> %define P_pmsg  CHECKED
   220                              <1> %define P_pdec  CHECKED
   221                              <1> %define P_hexc  1
   222                              <1> %macro  CALLP 1
   223                              <1>  %if P_%1
   224                              <1>         call    [V(p_%1)]
   225                              <1>  %else
   226                              <1>         call    %1
   227                              <1>  %endif
   228                              <1> %endmacro
   229                              <1> %macro  JMPP 1
   230                              <1>  %if P_%1
   231                              <1>         jmp     [V(p_%1)]
   232                              <1>  %else
   233                              <1>         jmp     %1
   234                              <1>  %endif
   235                              <1> %endmacro
   236                              <1> %define NEXTJ   jmp ebp                 ; (how DIVCODE ends: the fast build's
   237                              <1>                                         ;   own '/' has the dispatcher there)
   238                              <1> 
   239                              <1> ; NEXTF (the fast build): the dispatcher. It is `next`, and it is inline at
   240                              <1> ; the end of the fast build's own handlers, so they never jump back to it.
   241                              <1> ; Every handler is entered with EAX = its character, zero-extended. NEXTD is
   242                              <1> ; the one after a digit: through dtabd, where a digit goes on with the number.
   243                              <1> %macro  NEXTF 0
   244                              <1> %if CHECKED
   245                              <1>         call    chkstk                  ; both stacks, once per character
   246                              <1> %endif
   247                              <1>         movzx   eax,byte [esi]
   248                              <1>         inc     esi
   249                              <1>         jmp     [dtab+eax*4]
   250                              <1> %endmacro
   251                              <1> %macro  NEXTD 0
   252                              <1>         movzx   eax,byte [esi]
   253                              <1>         inc     esi
   254                              <1>         jmp     [dtabd+eax*4]
   255                              <1> %endmacro
   256                              <1> 
   257                              <1> ; run0: start running at ESI. The heap starts after the stored program's
   258                              <1> ; NUL. TOS is popped: the data stack is as the last line left it. (The
   259                              <1> ; runner's startup runs on into it; in the editor builds it follows ^G.)
   260                              <1> %macro  RUN0CODE 0
   261                              <1> run0:   mov     edx,ARENA+PROG
   262                              <1> .st1:   inc     edx
   263                              <1>         cmp     byte [edx-1],0
   264                              <1>         jne     .st1
   265                              <1>         mov     [ARENA+HEAP],dx
   266                              <1> %if CHECKED
   267                              <1>         movzx   eax,dx                  ; '_' may not release below this
   268                              <1>         mov     [V(v_npend)],eax
   269                              <1> %endif
   270                              <1> %if QK
   271                              <1>         lea     eax,[edx-(ARENA+PROG)]  ; the text's length, NUL included: only
   272                              <1>         mov     [v_tlen],eax            ;   skips that start inside it are kept
   273                              <1>         push    edi                     ; the skip cache is emptied (a start of
   274                              <1>         mov     edi,skc                 ;   0 matches no skip: every IP is in
   275                              <1>         mov     ecx,2*NSKC              ;   the arena)
   276                              <1>         xor     eax,eax
   277                              <1>         rep     stosd
   278                              <1>         pop     edi
   279                              <1> %endif
   280                              <1>         pop     ebx
   281                              <1>         jmp     ebp
   282                              <1> %endmacro
   283                              <1> 
   284                              <1> ; ---- startup ----------------------------------------------------------------
   285                              <1> ; The data stack starts empty; the cell pushed here stands for TOS, as when
   286                              <1> ; the editor has the stack in memory: the run starts by popping it.
   287 00000000 BD[5C060000]        <1> start:  mov     ebp,next
   288 00000005 BE00024100          <1>         mov     esi,ARENA+PROG
   289 0000000A 89654F              <1>         mov     [V(v_dstop)],esp
   290 0000000D 56                  <1>         push    esi                     ; (the cell that stands for TOS)
   291 0000000E 6AF6                <1>         push    -10                     ; STD_INPUT_HANDLE
   292 00000010 FF55A8              <1>         call    [V(iat_GetStdHandle)]
   293 00000013 894543              <1>         mov     [V(v_hin)],eax
   294 00000016 97                  <1>         xchg    eax,edi                 ; (EDI = the input handle, for now)
   295                              <1>         ; ANSI escape sequences: the output mode becomes processed output,
   296                              <1>         ; wrap at the end of a line and virtual terminal processing (1+2+4),
   297                              <1>         ; so the console obeys ESC [ ... as a terminal does. 1+2 is the
   298                              <1>         ; console's usual output mode. On Windows before 10, or when the
   299                              <1>         ; output is not a console, the call fails and nothing changes. The
   300                              <1>         ; mode is left on at the end, which does no harm. (The arguments
   301                              <1>         ; are pushed now, and the call made after the input's two.)
   302 00000017 6A07                <1>         push    7
   303 00000019 6AF5                <1>         push    -11                     ; STD_OUTPUT_HANDLE
   304 0000001B FF55A8              <1>         call    [V(iat_GetStdHandle)]
   305 0000001E 89454B              <1>         mov     [V(v_outh)],eax
   306 00000021 50                  <1>         push    eax
   307                              <1>         ; Raw keys: no echo, no line editing, Ctrl-C as a key (mode 0). If
   308                              <1>         ; the input is not a console, GetConsoleMode fails, and the keys are
   309                              <1>         ; read as bytes with ReadFile (see waitk).
   310 00000022 8D4D55              <1>         lea     ecx,[V(v_mode)]
   311 00000025 51                  <1>         push    ecx
   312 00000026 57                  <1>         push    edi
   313 00000027 FF55AC              <1>         call    [V(iat_GetConsoleMode)]
   314 0000002A 884553              <1>         mov     [V(v_iscon)],al
   315 0000002D 6A00                <1>         push    0
   316 0000002F 57                  <1>         push    edi
   317 00000030 FF55B0              <1>         call    [V(iat_SetConsoleMode)]
   318 00000033 FF55B0              <1>         call    [V(iat_SetConsoleMode)] ; (the output's, pushed above)
   319                              <1>         ; A high-resolution waitable timer for the timed waits of '?' (Windows
   320                              <1>         ; 10 1803 and later). A plain wait only ends on the system's tick,
   321                              <1>         ; every 15.6 ms, so 1? would take about 16 ms. Older Windows refuses
   322                              <1>         ; the flag; then v_htm is 0 and the waits are plain ones.
   323 00000036 6803001F00          <1>         push    1F0003h                 ; TIMER_ALL_ACCESS
   324 0000003B 6A02                <1>         push    2                       ; CREATE_WAITABLE_TIMER_HIGH_RESOLUTION
   325 0000003D 6A00                <1>         push    0
   326 0000003F 6A00                <1>         push    0
   327 00000041 FF55C8              <1>         call    [V(iat_CreateWaitableTimerExW)]
   328 00000044 894547              <1>         mov     [V(v_htm)],eax
   329                              <1>         ; The command line: the program's own name, then the file's.
   330 00000047 FF55B4              <1>         call    [V(iat_GetCommandLineA)]
   331 0000004A 96                  <1>         xchg    eax,esi
   332 0000004B E82A000000          <1>         call    token
   333 00000050 E825000000          <1>         call    token
   334 00000055 E844000000          <1>         call    load                    ; (no file, or no such file: no text)
   335                              <1> %if EDITOR
   336                              <1>         mov     eax,6835323Fh           ; ESC [ ? 2 5 h: the editor shows the
   337                              <1>         call    pseq                    ;   cursor when it starts, as after an
   338                              <1>         jmp     edit                    ;   error or a break (edit0)
   339                              <1> %else
   340 0000005A BF00FF4000          <1>         mov     edi,RSTOP               ; the return stack is empty
   341 0000005F BE00024100          <1>         mov     esi,ARENA+PROG          ; the IP
   342                              <1>         RUN0CODE                        ; (on into run0)
   261 00000064 BA00024100          <2> run0: mov edx,ARENA+PROG
   262 00000069 42                  <2> .st1: inc edx
   263 0000006A 807AFF00            <2>  cmp byte [edx-1],0
   264 0000006E 75F9                <2>  jne .st1
   265 00000070 6689157C014100      <2>  mov [ARENA+HEAP],dx
   266                              <2> %if CHECKED
   267                              <2>  movzx eax,dx
   268                              <2>  mov [V(v_npend)],eax
   269                              <2> %endif
   270                              <2> %if QK
   271                              <2>  lea eax,[edx-(ARENA+PROG)]
   272                              <2>  mov [v_tlen],eax
   273                              <2>  push edi
   274                              <2>  mov edi,skc
