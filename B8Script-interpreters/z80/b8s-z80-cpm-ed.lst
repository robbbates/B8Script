04F4   36 00                  LD   (HL),0   
04F6   01 80 0A               LD   BC,LINEBUF   
04F9   C9                     RET      
04FA                             ; Backspace, DEL: the character before the cursor goes. The cursor moves
04FA                             ; left, the rest of the line moves down over it, and the last place (now a
04FA                             ; space) is printed over along with the rest.
04FA   7D           BSP:      LD   A,L   
04FB   87                     ADD   A,A   
04FC   28 B5                  JR   Z,ed1   ; at the start
04FE   2D                     DEC   L   
04FF   3E 08                  LD   A,8   
0501   EF                     RST   28h   
0502   E5                     PUSH   HL   
0503   2C           BS1:      INC   L   
