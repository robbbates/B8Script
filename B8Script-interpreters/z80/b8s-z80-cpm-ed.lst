051A   78                     LD   A,B   
051B   EF                     RST   28h   
051C   E5                     PUSH   HL   
051D   7E           IC1:      LD   A,(HL)   
051E   70                     LD   (HL),B   
051F   47                     LD   B,A   
0520   7D                     LD   A,L   
0521   2C                     INC   L   
0522   BB                     CP   E   
0523   20 F8                  JR   NZ,ic1   
0525   E1                     POP   HL   
0526   2C                     INC   L   
0527   1C                     INC   E   
0528   53                     LD   D,E   
0529   CD 2E 05     IC2:      CALL   tail   
052C   18 85                  JR   ed1   
