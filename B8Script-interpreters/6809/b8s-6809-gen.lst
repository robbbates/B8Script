F0EE   35 10        H_FROMR:   PULS   X   
F0F0   35 06                  PULS   D   
F0F2   36 06                  PSHU   D   
F0F4   6E 84                  JMP   ,X   
F0F6                             ; "_" ( n -- addr ): the heap pointer moves by n (signed: a 16-bit add);
F0F6                             ; TOS is the old pointer.
F0F6                             ; Checked: the new top must be at least the program's end (PEND) and below
F0F6                             ; the limit page. That also catches an add that wraps: the top is always
F0F6                             ; 8301h-EFFFh and n is -32768..32767, so a sum that carries past FFFFh
F0F6                             ; lands below 7000h, and one that borrows can't happen.
F0F6   D6 7C        H_ALLOC:   LDB   <HEAP   
F0F8   96 7D                  LDA   <HEAP+1   
F0FA   1F 01                  TFR   D,X   ; the old pointer
F0FC   E3 C4                  ADDD   ,U   
