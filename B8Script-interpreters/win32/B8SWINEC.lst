  1175                              <1> ; =============================================================================
  1176                              <1> ;  The line editor (EDITOR = 1)
  1177                              <1> ;
  1178                              <1> ;  The interpreter starts here, and a program that ends comes back here.
  1179                              <1> ;  There is no prompt. It follows the spec's suggested standard for a line
  1180                              <1> ;  editor (docs/b8script.md, Environments), and is the Z80's editor, key for
  1181                              <1> ;  key. Type a line and press Return:
  1182                              <1> ;
  1183                              <1> ;    n text    put the text in as line n; the lines from n on move down. A
  1184                              <1> ;              number past the end (or 0) adds the line at the end.
  1185                              <1> ;    n         take line n out
  1186                              <1> ;    anything else is run at once, as B8Script. (Start such a line with a
  1187                              <1> ;    space if it would begin with a digit.)
  1188                              <1> ;
  1189                              <1> ;  A command key ends the line too, and takes what was typed as its argument:
  1190                              <1> ;
  1191                              <1> ;    ^G        run the program
  1192                              <1> ;    n ^L      list from line n (no number: all of it). Any key holds the
  1193                              <1> ;              list until another key is pressed; Ctrl-C ends it.
  1194                              <1> ;    n ^E      put line n in the input line; Return puts it back, changed
  1195                              <1> ;    name ^R   read the file of that name (no name: the current one: the
  1196                              <1> ;              one from the command line, or the last one typed)
  1197                              <1> ;    name ^W   write the program to that file (no name: the current one)
  1198                              <1> ;    ^N ^N     new: no program (the key twice in a row)
  1199                              <1> ;    ^V        view: the build, both stacks, and the program's size, lines
  1200                              <1> ;              and free memory
  1201                              <1> ;    ^X        leave
  1202                              <1> ;
  1203                              <1> ;  In the line: ^B and ^F, or the left and right arrow keys, move the cursor;
  1204                              <1> ;  a character goes in at the cursor; Backspace and DEL take out the one
  1205                              <1> ;  before it; Esc drops the line (after Esc it waits 5 ms for a '[': Esc [ C
  1206                              <1> ;  and Esc [ D are right and left too). Only CR, LF, BS and printing
  1207                              <1> ;  characters are sent to the terminal.
  1208                              <1> ;
  1209                              <1> ;  Lines are counted, not numbered. A typed line holds 125 characters; the
  1210                              <1> ;  one character after a line number separates it from the text and is not
  1211                              <1> ;  stored. The text is kept as typed, each line ending in CR LF, at PROG. A
  1212                              <1> ;  file is read up to its first ^Z, and a last line with no line end is
  1213                              <1> ;  given one; it is written as it is, with no padding.
  1214                              <1> ;
  1215                              <1> ;  What lasts from one line to the next: the program, the words, the
  1216                              <1> ;  variables and the data stack (TOS is kept pushed while the editor runs).
  1217                              <1> ;  An error or a break clears both stacks. The return stack starts empty for
  1218                              <1> ;  every line.
  1219                              <1> ;
  1220                              <1> ;  Registers in the editor: EBX = the cursor, EDX = the end of the line
  1221                              <1> ;  (pointers into the line buffer); EDI is free (edit resets it).
  1222                              <1> ; =============================================================================
  1223                              <1> %if EDITOR
  1224                              <1> ; ^F, right arrow: one to the right, by printing the character there
  1225 0000061F 39D3                <1> right:  cmp     ebx,edx
  1226 00000621 745F                <1>         je      ed1                     ; at the end
  1227 00000623 8A03                <1>         mov     al,[ebx]
  1228 00000625 43                  <1>         inc     ebx
  1229 00000626 EB2E                <1>         jmp     short lf1
  1230                              <1> 
  1231                              <1> ; Esc: alone it drops the line. An arrow key sends Esc [ and a letter, so
  1232                              <1> ; wait about 5 ms for a second key: after a '[' read on to the letter that
  1233                              <1> ; ends the sequence, and act on C (right) and D (left).
  1234 00000628 6A05                <1> esc:    push    5
  1235 0000062A 58                  <1>         pop     eax
