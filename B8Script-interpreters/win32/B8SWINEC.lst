  1957                              <1> iat_end:
  1958                              <1> 
  1959                              <1> ; =============================================================================
  1960                              <1> ;  The letters and digits, the return stack's push, and the inner loop
  1961                              <1> ; =============================================================================
  1962                              <1> 
  1963                              <1> ; A-Z: call the word. The return address (the IP after the letter) goes on
  1964                              <1> ; the return stack, and the IP becomes the address in the letter's cell.
  1965 00000D20 89F2                <1> upper:  mov     edx,esi
  1966 00000D22 668BB40000014100    <1>         mov     si,[ARENA+LET+eax*2]
  1967                              <1> 
  1968                              <1> ; rpush: push EDX on the return stack, then next. Everything that pushes the
  1969                              <1> ; return stack ends here, and the true ')' comes to rpoll.
  1970                              <1> ;
  1971                              <1> ; The break key is looked at here, so at every word call and loop-back (and
  1972                              <1> ; block entry and '{'), but only one time in 256: V_PCNT counts them.
  1973 00000D2A 83EF04              <1> rpush:  sub     edi,4
  1974 00000D2D 8917                <1>         mov     [edi],edx
  1975 00000D2F FE4D6B              <1> rpoll:  dec     byte [V(v_pcnt)]
  1976 00000D32 7505                <1>         jnz     .rp1
  1977 00000D34 E8BDF9FFFF          <1>         call    pollk
  1978 00000D39 FFE5                <1> .rp1:   jmp     ebp
  1979                              <1> 
  1980                              <1> ; =============================================================================
  1981                              <1> ;  The inner loop: read one character and sort it by range.
  1982                              <1> ;
  1983                              <1> ;    00h          end of program
  1984                              <1> ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes; the checked
  1985                              <1> ;                 build stops on 80h-FFh: X)
  1986                              <1> ;    30h-39h      digit: read a whole number
  1987                              <1> ;    41h-5Ah      A-Z: call the word in that letter's cell
  1988                              <1> ;    61h-7Ah      a-z: push the address of that letter's cell
  1989                              <1> ;    the rest     punctuation: jump through PTAB, 32 entries
  1990                              <1> ; =============================================================================
  1991                              <1> ; Digits: step back onto the first digit and read the whole number.
  1992 00000D3B 53                  <1> digit:  push    ebx
  1993 00000D3C 4E                  <1>         dec     esi
  1994 00000D3D E8BFF6FFFF          <1>         call    rdnum
  1995 00000D42 FFE5                <1>         jmp     ebp
  1996                              <1> 
  1997                              <1> ; a-z: push the cell's address (the cell is the variable).
  1998 00000D44 53                  <1> lower:  push    ebx
  1999 00000D45 8D9C0000014100      <1>         lea     ebx,[ARENA+LET+eax*2]
  2000 00000D4C FFE5                <1>         jmp     ebp
  2001                              <1> ; (digit, lower and ctl are here, before next, to keep the variables after
  2002                              <1> ; next in reach)
  2003 00000D4E 0421                <1> ctl:    add     al,21h                  ; back to c; zero only for NUL
  2004 00000D50 750C                <1>         jnz     next                    ; the rest are ignored
  2005 00000D52 E9DAF9FFFF          <1>         jmp     endprog
  2006                              <1> %if CHECKED
  2007 00000D57 B058                <1> e_hi:   mov     al,'X'                  ; a reserved byte outside a string
  2008 00000D59 E9A1F5FFFF          <1>         jmp     error
  2009                              <1> %endif
  2010                              <1> next:
  2011                              <1> %if CHECKED
  2012 00000D5E E84AF5FFFF          <1>         call    chkstk                  ; both stacks, once per character
  2013                              <1> %endif
  2014 00000D63 31C0                <1>         xor     eax,eax
  2015 00000D65 AC                  <1>         lodsb
  2016 00000D66 2C21                <1>         sub     al,21h                  ; AL = c - 21h
  2017 00000D68 72E4                <1>         jb      ctl                     ; c < 21h: NUL ends, the rest are ignored
  2018 00000D6A 3C0F                <1>         cmp     al,0Fh
  2019 00000D6C 7224                <1>         jb      punct                   ; 21h-2Fh: PTAB index 0-14
  2020 00000D6E 2C0F                <1>         sub     al,0Fh                  ; AL = c - 30h
  2021 00000D70 3C0A                <1>         cmp     al,0Ah
  2022 00000D72 72C7                <1>         jb      digit                   ; 30h-39h
  2023 00000D74 3C11                <1>         cmp     al,11h
  2024 00000D76 7218                <1>         jb      p3a                     ; 3Ah-40h
  2025 00000D78 2C11                <1>         sub     al,11h                  ; AL = c - 41h
  2026 00000D7A 3C1A                <1>         cmp     al,1Ah
  2027 00000D7C 72A2                <1>         jb      upper                   ; 41h-5Ah: AL = letter index 0-25
  2028 00000D7E 3C20                <1>         cmp     al,20h
  2029 00000D80 720C                <1>         jb      p5b                     ; 5Bh-60h
  2030 00000D82 3C3A                <1>         cmp     al,3Ah
  2031 00000D84 72BE                <1>         jb      lower                   ; 61h-7Ah: AL = 20h-39h (cell +64 bytes)
  2032 00000D86 3C3E                <1>         cmp     al,3Eh
  2033                              <1> %if CHECKED
  2034 00000D88 74D4                <1>         je      next                    ; 7Fh, DEL: ignored
  2035 00000D8A 73CB                <1>         jae     e_hi                    ; 80h-FFh: reserved
  2036                              <1> %else
  2037                              <1>         jae     next                    ; 7Fh-FFh: ignored
  2038                              <1> %endif
  2039 00000D8C 2C1A                <1>         sub     al,1Ah                  ; 7Bh-7Eh: -1Eh in all, index 28-31
  2040 00000D8E 2C09                <1> p5b:    sub     al,9                    ; 5Bh-60h: -4 in all, index 22-27
  2041 00000D90 0405                <1> p3a:    add     al,5                    ; 3Ah-40h: index 15-21
  2042 00000D92 8A80[400B0000]      <1> punct:  mov     al,[ptab+eax]
  2043 00000D98 8D80[01010000]      <1>         lea     eax,[hbase+eax]
  2044 00000D9E FFE0                <1>         jmp     eax
  2045                              <1> 
