E5CA   C8                     INY      
E5CB   68                     PLA      
E5CC   10 F3                  BPL   prs   
E5CE   60                     RTS      
E5CF                MSG:         
E5CF   0D 0A 45 72 72 A0 M_ERR:   DB   13,10,"Err"," "+80h   
E5D5   20 40 A0               DB   " @"," "+80h   
E5D8   0D 8A        M_NL:     DB   13,10+80h   
E5DA   0D 0A 53 74 6B A0 M_STK:   DB   13,10,"Stk"," "+80h   
E5E0   3A 20 2E 2E AE M_CD:   DB   ": ..","."+80h   
E5E5   BA           M_C:      DB   ":"+80h   
E5E6   0D 0A 52 74 6E A0 M_RTN:   DB   13,10,"Rtn"," "+80h   
E5EC                             ; lcol: the line (D0/D1) and the column (T1/T2) of the place at P, both from
E5EC                             ; 1. A place below the program is in the -n? line buffer: line 0, and the
E5EC                             ; column is the place in the buffer. Otherwise the LFs before the place are
E5EC                             ; counted from PROG; T1/T2 holds the address before the line's first
E5EC                             ; character (the last LF, or PROG - 1), and the column is P minus that.
E5EC   A0 00        LCOL:     LDY   #0   
E5EE   84 09                  STY   D1   
E5F0   84 08                  STY   D0   
