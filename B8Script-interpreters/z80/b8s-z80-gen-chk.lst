0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Spec: docs/b8script.md (2026-10-09) plus the 2026-11-20 changes:
0000                             ;        [x stores in a variable, "[ " pushes an anonymous block, any other
0000                             ;        character after [ is an error, the heap pointer lives at z10+.
0000                             ;        The string escape is "/" (it was ">").
0000                             ; 
0000                             ;  Two switches, set in the two EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    CHECKED  0 = no checks (spec: "B8Script checks nothing")
0000                             ;             1 = stops on stack overrun, Ctrl-C, heap past the limit, a store
0000                             ;                 outside the program's own space, and a bad character after [,
0000                             ;                 printing a letter and the place, like  S @ 245
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   0   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   1   ; 1 = checked build
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    HL'  return-stack pointer (the alternate HL). Entries are 2 bytes; the
0000                             ;         stack grows down. Only rpush and rpop (and the checks) touch it.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  A handler ends with RST 10h ("next character") or RST 08h ("drop, then
0000                             ;  next"), one byte each instead of a three-byte JP. An RST is a CALL, so the
0000                             ;  first thing each stub does is POP DE to throw the return address away.
0000                             ; -----------------------------------------------------------------------------
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (SP stays inside this page)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch (= z10+), interpreter variables in the gaps, and the -n?
0000                             ;             line buffer at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack's page has a guard band: the data
0000                             ;  stack can overrun by a cell or two (and the calls made while it is full)
0000                             ;  into the top 32 bytes of the return-stack page, which are never used, and
0000                             ;  the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
                    BDOS:     EQU   0005h   
0000                          ENDIF      
0000                          IFN   CPM   
0000                             ; ---- generic machine: edit these to suit -----------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The zero flag must match A
0000                             ;   (end the routine with OR A / RET).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                             ;   KEY and CONOUT must preserve BC, DE, HL and HL'.
0000                RSPAGE:   EQU   80h   ; 8000h return stack
0000                DSPAGE:   EQU   81h   ; 8100h data stack
0000                LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
0000                PROG:     EQU   8300h   ; where the loader puts the program text
0000                HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms: each pass
0000                             ; calls getk once, so tune it for your clock
0000                             ; and your CONST routine
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; z10+, the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                KEYBUF:   EQU   LET+36h   ;   around machine code; a held-back key;
0000                SPTMP:    EQU   LET+38h   ;   scratch for the SP check;
0000                HLIM:     EQU   LET+3Ah   ;   high byte of the heap limit
0000                LBHDR:    EQU   LET+7Eh   ; CP/M BDOS 10 header: max, count
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FEh   ; empty data stack
0000                             ; =============================================================================
0000                             ;  Page zero (generic ROM) or the start of the .COM file (CP/M)
0000                             ; =============================================================================
0000                          IF   CPM   
                              .ORG   0100h   
                              JP   start   
0000                          ENDIF      
0000                          IFN   CPM   
0000                          .ORG   0000h   
0000   C3 AD 03               JP   start   ; 0000h reset
0003                ENDPROG:      
0003   C3 09 FF               JP   EXIT   ; 0003h the program has ended
0006   E5           H_DUP:    PUSH   HL   ; 0006h ":" (two-byte handlers fill the gaps)
0007   D7                     RST   10h   
0008                             ; ---- RST 08h: drop TOS, then next ------------------------------------------
0008   D1                     POP   DE   ; 0008h discard the RST's return address
0009                DROP_NEXT:      
0009   E1                     POP   HL   ; new TOS = NOS
000A   18 05                  JR   next0   
000C   E3           H_SWAP:   EX   (SP),HL   ; 000Ch "%"
000D   D7                     RST   10h   
000E   00 00                  DB   0,0   ; 000Eh spare
0010                             ; ---- RST 10h: next character ------------------------------------------------
0010   D1                     POP   DE   ; 0010h discard the RST's return address
0011                          ENDIF      
0011                             ; =============================================================================
0011                             ;  The inner loop: read one character and sort it by range.
0011                             ; 
0011                             ;    00h          end of program
0011                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0011                             ;    30h-39h      digit: read a whole number
0011                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0011                             ;    61h-7Ah      a-z: push the address of that letter's cell
0011                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0011                             ; =============================================================================
0011                NEXT0:       
0011                          IF   CHECKED   
0011                             ; Both stacks are checked once per character, not in every handler.
0011                             ; Each stack lives in one page, so it has overrun exactly when the
0011                             ; pointer's high byte has left that page. Errors are caught one cell
0011                             ; late at most; the page below each stack is a guard band.
0011   ED 73 38 82            LD   (SPTMP),SP   
0015   3A 39 82               LD   A,(SPTMP+1)   
0018   FE 81                  CP   DSPAGE   
001A   C2 7D 03               JP   NZ,e_stack   
001D   D9                     EXX      ; the return stack: in its page, and not
001E   7D                     LD   A,L   ;   above its empty position (an underflow
001F   FE E1                  CP   RSTOP&0FFh+1   ;   would stay inside the page, in the
0021   7C                     LD   A,H   ;   guard band)
0022   D9                     EXX      
0023   D2 80 03               JP   NC,e_rstack   
0026   FE 80                  CP   RSPAGE   
0028   C2 80 03               JP   NZ,e_rstack   
002B                          ENDIF      
002B   0A                     LD   A,(BC)   
002C   03                     INC   BC   
002D   D6 21                  SUB   21h   ; A = c - 21h
002F   38 38                  JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
0031   FE 0F                  CP   0Fh   
0033   38 26                  JR   C,punct   ; 21h-2Fh: PTAB index 0-14
0035   D6 0F                  SUB   0Fh   ; A = c - 30h
0037   FE 0A                  CP   0Ah   
0039   38 4A                  JR   C,digit   ; 30h-39h
003B   FE 11                  CP   11h   
003D   30 04                  JR   NC,ab40   
003F   C6 05                  ADD   A,5   ; 3Ah-40h: index 15-21
0041   18 18                  JR   punct   
0043   D6 11        AB40:     SUB   11h   ; A = c - 41h
0045   FE 1A                  CP   1Ah   
0047   38 2D                  JR   C,upper   ; 41h-5Ah: A = letter index 0-25
0049   FE 20                  CP   20h   
004B   30 04                  JR   NC,ab60   
004D   D6 04                  SUB   4   ; 5Bh-60h: index 22-27
004F   18 0A                  JR   punct   
0051   FE 3A        AB60:     CP   3Ah   
0053   38 1B                  JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0055   FE 3E                  CP   3Eh   
0057   30 B8                  JR   NC,next0   ; 7Fh-FFh: ignored
0059   D6 1E                  SUB   1Eh   ; 7Bh-7Eh: index 28-31
005B                             ; Punctuation: HL holds TOS, so it is parked in DE while the table is read.
005B                             ; PTAB never crosses a page (checked at assembly), so only L needs adding.
005B   EB           PUNCT:    EX   DE,HL   ; DE = TOS
005C   87                     ADD   A,A   
005D   C6 8B                  ADD   A,PTAB & 0FFh   
005F   6F                     LD   L,A   
0060   26 00                  LD   H,PTAB / 256   
0062   7E                     LD   A,(HL)   
0063   2C                     INC   L   
0064   66                     LD   H,(HL)   
0065   6F                     LD   L,A   ; HL = handler
0066   EB                     EX   DE,HL   ; HL = TOS, DE = handler
0067   D5                     PUSH   DE   ; jump to it; the stack is balanced again
0068   C9                     RET      ;   when the handler starts
0069   C6 21        CTL:      ADD   A,21h   ; back to c; zero only for NUL
006B   20 A4                  JR   NZ,next0   
006D   C3 03 00               JP   endprog   
0070                             ; a-z: push the cell's address (the cell is the variable)
0070   E5           LOWER:    PUSH   HL   
0071   87                     ADD   A,A   
0072   6F                     LD   L,A   
0073   26 82                  LD   H,LETPAGE   
0075   D7                     RST   10h   
0076                             ; A-Z: call the word. The return address (the IP after the letter) goes on
0076                             ; the return stack, and the IP becomes the address in the letter's cell.
0076   E5           UPPER:    PUSH   HL   ; keep TOS
0077   87                     ADD   A,A   
0078   6F                     LD   L,A   
0079   26 82                  LD   H,LETPAGE   ; HL -> cell
007B   5E                     LD   E,(HL)   
007C   2C                     INC   L   
007D   56                     LD   D,(HL)   ; DE = the word's body
007E   E1                     POP   HL   ; TOS back
007F   CD E1 00               CALL   rpush   ; push the return address (IP)
0082   42                     LD   B,D   
0083   4B                     LD   C,E   ; IP = body
0084   D7                     RST   10h   
0085                             ; Digits: step back onto the first digit and read the whole number.
0085   E5           DIGIT:    PUSH   HL   
0086   0B                     DEC   BC   
0087   CD CB 00               CALL   rdnum   
008A   D7                     RST   10h   
008B                             ; =============================================================================
008B                             ;  Dispatch table: one handler per punctuation character, in code order.
008B                             ;  It sits right after the inner loop so that it can't cross a page (the
008B                             ;  loop only adds to the low byte of its address).
008B                             ; =============================================================================
008B   B3 01        PTAB:     DW   h_store   ; !
008D   7F 02                  DW   h_str   ; "
008F   A3 02                  DW   h_num   ; #
0091   86 02                  DW   h_print   ; $
0093   0C 00                  DW   h_swap   ; %
0095   65 01                  DW   h_and   ; &
0097   9E 02                  DW   h_emit   ; '
0099   E9 01                  DW   h_open   ; (
009B   F6 01                  DW   h_close   ; )
009D   12 01                  DW   h_mul   ; *
009F   F3 00                  DW   h_add   ; +
00A1   CA 02                  DW   h_cfetch   ; ,
00A3   F6 00                  DW   h_sub   ; -
00A5   BD 01                  DW   h_cstore   ; .
00A7   28 01                  DW   h_div   ; /
00A9   06 00                  DW   h_dup   ; :
00AB   09 00                  DW   drop_next   ; ;
00AD   85 01                  DW   h_lt   ; <
00AF   95 01                  DW   h_eq   ; =
00B1   82 01                  DW   h_gt   ; >
00B3   CD 02                  DW   h_key   ; ?
00B5   AE 01                  DW   h_fetch   ; @
00B7   23 02                  DW   h_def   ; [
00B9   0B 02                  DW   h_break   ; \
00BB   1A 02                  DW   h_ret   ; ]
00BD   75 01                  DW   h_xor   ; ^
00BF   C3 01                  DW   h_alloc   ; _
00C1   17 03                  DW   h_grave   ; `
00C3   A0 01                  DW   h_tor   ; {
00C5   6D 01                  DW   h_or   ; |
00C7   A8 01                  DW   h_fromr   ; }
00C9   7D 01                  DW   h_not   ; ~
00CB                PTABEND:      
00CB                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
00CB                             ; non-digit. Values wrap at 16 bits, as the spec says.
00CB   21 00 00     RDNUM:    LD   HL,0   
00CE   0A           RDN1:     LD   A,(BC)   
00CF   D6 30                  SUB   "0"   
00D1   FE 0A                  CP   10   
00D3   D0                     RET   NC   
00D4   03                     INC   BC   
00D5   54                     LD   D,H   
00D6   5D                     LD   E,L   
00D7   29                     ADD   HL,HL   
00D8   29                     ADD   HL,HL   
00D9   19                     ADD   HL,DE   
00DA   29                     ADD   HL,HL   ; HL * 10
00DB   5F                     LD   E,A   
00DC   16 00                  LD   D,0   
00DE   19                     ADD   HL,DE   
00DF   18 ED                  JR   rdn1   
00E1                             ; =============================================================================
00E1                             ;  Return stack. rpush pushes BC (nearly always the IP); rpop pops into DE.
00E1                             ;  HL' is the pointer. Both go through the Z80 stack to cross between the
00E1                             ;  register sets.
00E1                             ; =============================================================================
00E1   C5           RPUSH:    PUSH   BC   
00E2   D9                     EXX      
00E3   D1                     POP   DE   
00E4   2B                     DEC   HL   
00E5   72                     LD   (HL),D   
00E6   2B                     DEC   HL   
00E7   73                     LD   (HL),E   
00E8   D9                     EXX      
00E9   C9                     RET      
00EA   D9           RPOP:     EXX      
00EB   5E                     LD   E,(HL)   
00EC   23                     INC   HL   
00ED   56                     LD   D,(HL)   
00EE   23                     INC   HL   
00EF   D5                     PUSH   DE   
00F0   D9                     EXX      
00F1   D1                     POP   DE   
00F2   C9                     RET      
00F3                             ; =============================================================================
00F3                             ;  Arithmetic and logic. Effects are ( NOS TOS -- result ).
00F3                             ; =============================================================================
00F3   D1           H_ADD:    POP   DE   
00F4   19                     ADD   HL,DE   
00F5   D7                     RST   10h   
00F6                             ; "-" has two jobs: directly before a digit it starts a negative number.
00F6   0A           H_SUB:    LD   A,(BC)   
00F7   D6 30                  SUB   "0"   
00F9   FE 0A                  CP   10   
00FB   38 06                  JR   C,negnum   
00FD   CD 0B 01               CALL   neg16   ; a - b = a + (-b)
0100   D1                     POP   DE   
0101   19                     ADD   HL,DE   
0102   D7                     RST   10h   
0103   E5           NEGNUM:   PUSH   HL   
0104   CD CB 00               CALL   rdnum   
0107   CD 0B 01               CALL   neg16   
010A   D7                     RST   10h   
010B                             ; neg16: HL = -HL (keeps BC, DE)
010B   AF           NEG16:    XOR   A   
010C   95                     SUB   L   
010D   6F                     LD   L,A   
010E   9F                     SBC   A,A   
010F   94                     SUB   H   
0110   67                     LD   H,A   
0111   C9                     RET      
0112                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept.
0112   D1           H_MUL:    POP   DE   ; DE = multiplicand
0113   C5                     PUSH   BC   
0114   44                     LD   B,H   
0115   4D                     LD   C,L   ; BC = multiplier
0116   21 00 00               LD   HL,0   
0119   3E 10                  LD   A,16   
011B   29           MUL1:     ADD   HL,HL   
011C   CB 21                  SLA   C   
011E   CB 10                  RL   B   
0120   30 01                  JR   NC,mul2   
0122   19                     ADD   HL,DE   
0123   3D           MUL2:     DEC   A   
0124   20 F5                  JR   NZ,mul1   
0126   C1                     POP   BC   
0127   D7                     RST   10h   
0128                             ; "/" ( a b -- r q ): the quotient is on top. Truncates toward zero; r takes
0128                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
0128                             ; of a. Dividing by zero is not checked: it returns two cells of no meaning.
0128   D1           H_DIV:    POP   DE   ; DE = a, HL = b
0129   C5                     PUSH   BC   ; free BC for udiv
012A   7A                     LD   A,D   
012B   AC                     XOR   H   
012C   F5                     PUSH   AF   ; S flag = sign of q
012D   7A                     LD   A,D   
012E   B7                     OR   A   
012F   F5                     PUSH   AF   ; S flag = sign of a (for r)
0130   CB 7C                  BIT   7,H   
0132   C4 0B 01               CALL   NZ,neg16   ; HL = |b|
0135   EB                     EX   DE,HL   
0136   CB 7C                  BIT   7,H   
0138   C4 0B 01               CALL   NZ,neg16   ; HL = |a|, DE = |b|
013B   CD 4C 01               CALL   udiv   ; BC = q, HL = r
013E   F1                     POP   AF   
013F   FC 0B 01               CALL   M,neg16   ; r's sign
0142   EB                     EX   DE,HL   ; DE = r
0143   60                     LD   H,B   
0144   69                     LD   L,C   ; HL = q
0145   F1                     POP   AF   
0146   FC 0B 01               CALL   M,neg16   ; q's sign
0149   C1                     POP   BC   
014A   D5                     PUSH   DE   ; r under q
014B   D7                     RST   10h   
014C                             ; udiv: unsigned HL / DE. Returns BC = quotient, HL = remainder.
014C                             ; Uses A, BC; the caller saves the IP.
014C   44           UDIV:     LD   B,H   
014D   4D                     LD   C,L   
014E   21 00 00               LD   HL,0   
0151   3E 10                  LD   A,16   
0153   CB 21        UDV1:     SLA   C   
0155   CB 10                  RL   B   
0157   ED 6A                  ADC   HL,HL   
0159   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
015B   30 03                  JR   NC,udv2   ;   always fits in 16 bits
015D   19                     ADD   HL,DE   
015E   18 01                  JR   udv3   
0160   0C           UDV2:     INC   C   
0161   3D           UDV3:     DEC   A   
0162   20 EF                  JR   NZ,udv1   
0164   C9                     RET      
0165   D1           H_AND:    POP   DE   
0166   7C                     LD   A,H   
0167   A2                     AND   D   
0168   67                     LD   H,A   
0169   7D                     LD   A,L   
016A   A3                     AND   E   
016B   6F                     LD   L,A   
016C   D7                     RST   10h   
016D   D1           H_OR:     POP   DE   
016E   7C                     LD   A,H   
016F   B2                     OR   D   
0170   67                     LD   H,A   
0171   7D                     LD   A,L   
0172   B3                     OR   E   
0173   6F                     LD   L,A   
0174   D7                     RST   10h   
0175   D1           H_XOR:    POP   DE   
0176   7C                     LD   A,H   
0177   AA                     XOR   D   
0178   67                     LD   H,A   
0179   7D                     LD   A,L   
017A   AB                     XOR   E   
017B   6F                     LD   L,A   
017C   D7                     RST   10h   
017D   CD 0B 01     H_NOT:    CALL   neg16   ; ~x = -x - 1
0180   2B                     DEC   HL   
0181   D7                     RST   10h   
0182                             ; Signed compares. Flipping both sign bits turns a signed compare into an
0182                             ; unsigned one; SBC HL,HL then turns the carry into -1 or 0 with no branch.
0182   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
0183   18 02                  JR   cmp   
0185   D1           H_LT:     POP   DE   ; a < b: HL = a, DE = b
0186   EB                     EX   DE,HL   
0187   7C           CMP:      LD   A,H   
0188   EE 80                  XOR   80h   
018A   67                     LD   H,A   
018B   7A                     LD   A,D   
018C   EE 80                  XOR   80h   
018E   57                     LD   D,A   
018F   B7                     OR   A   
0190   ED 52                  SBC   HL,DE   ; carry if HL < DE
0192   ED 62                  SBC   HL,HL   
0194   D7                     RST   10h   
0195   D1           H_EQ:     POP   DE   
0196   B7                     OR   A   
0197   ED 52                  SBC   HL,DE   
0199   21 00 00               LD   HL,0   
019C   20 01                  JR   NZ,eq1   
019E   2B                     DEC   HL   
019F   D7           EQ1:      RST   10h   
01A0                             ; =============================================================================
01A0                             ;  Stack
01A0                             ; =============================================================================
01A0                          IF   CPM   ; (the generic build has these in page zero)
                    H_DUP:    PUSH   HL   
                              RST   10h   
                    H_SWAP:   EX   (SP),HL   
                              RST   10h   
01A0                          ENDIF      
01A0   C5           H_TOR:    PUSH   BC   ; "{" TOS to the return stack
01A1   44                     LD   B,H   
01A2   4D                     LD   C,L   
01A3   CD E1 00               CALL   rpush   
01A6   C1                     POP   BC   
01A7   CF                     RST   08h   
01A8   E5           H_FROMR:   PUSH   HL   ; "}" return stack to TOS
01A9   CD EA 00               CALL   rpop   
01AC   EB                     EX   DE,HL   
01AD   D7                     RST   10h   
01AE                             ; =============================================================================
01AE                             ;  Storage
01AE                             ; =============================================================================
01AE   5E           H_FETCH:   LD   E,(HL)   ; "@"
01AF   23                     INC   HL   
01B0   56                     LD   D,(HL)   
01B1   EB                     EX   DE,HL   
01B2   D7                     RST   10h   
01B3   D1           H_STORE:   POP   DE   ; "!" ( n addr -- )
01B4                          IF   CHECKED   
01B4   23                     INC   HL   ; both bytes must be in the program's space
01B5   CD D9 01               CALL   chkst   
01B8   2B                     DEC   HL   
01B9                          ENDIF      
01B9   73                     LD   (HL),E   
01BA   23                     INC   HL   
01BB   72                     LD   (HL),D   
01BC   CF                     RST   08h   
01BD   D1           H_CSTORE:   POP   DE   ; "." ( c addr -- )
01BE                          IF   CHECKED   
01BE   CD D9 01               CALL   chkst   
01C1                          ENDIF      
01C1   73                     LD   (HL),E   
01C2   CF                     RST   08h   
01C3                             ; "_" ( n -- addr ): the heap pointer moves up by n; TOS is the old pointer.
01C3   EB           H_ALLOC:   EX   DE,HL   
01C4   2A 7C 82               LD   HL,(HEAP)   
01C7   E5                     PUSH   HL   
01C8   19                     ADD   HL,DE   
01C9                          IF   CHECKED   
01C9   DA 86 03               JP   C,e_heap   ; a negative count wraps: too big
01CC   3A 3A 82               LD   A,(HLIM)   
01CF   3D                     DEC   A   
01D0   BC                     CP   H   
01D1   DA 86 03               JP   C,e_heap   ; the new top must stay below the limit page
01D4                          ENDIF      
01D4   22 7C 82               LD   (HEAP),HL   
01D7   E1                     POP   HL   
01D8   D7                     RST   10h   
01D9                          IF   CHECKED   
01D9                             ; chkst: stop unless HL is in the program's own space: from the letter page
01D9                             ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
01D9                             ; whatever lies above the limit are safe. Memory above the heap top but
01D9                             ; below the limit is the program's own: Tiny BASIC keeps its lines there.
01D9                             ; Keeps every register.
01D9   F5           CHKST:    PUSH   AF   
01DA   7C                     LD   A,H   
01DB   FE 82                  CP   LETPAGE   
01DD   38 05                  JR   C,chk1   
01DF   3A 3A 82               LD   A,(HLIM)   
01E2   3D                     DEC   A   
01E3   BC                     CP   H   
01E4   DA 89 03     CHK1:     JP   C,e_store   
01E7   F1                     POP   AF   
01E8   C9                     RET      
01E9                          ENDIF      
01E9                             ; =============================================================================
01E9                             ;  Flow control
01E9                             ; =============================================================================
01E9                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
01E9                             ; the matching ")".
01E9   7C           H_OPEN:   LD   A,H   
01EA   B5                     OR   L   
01EB   E1                     POP   HL   
01EC   28 04                  JR   Z,skipnx   
01EE   CD E1 00               CALL   rpush   ; the block starts at the IP
01F1   D7                     RST   10h   
01F2   CD 47 02     SKIPNX:   CALL   skip   
01F5   D7                     RST   10h   
01F6                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
01F6                             ; drops it and carries on.
01F6   7C           H_CLOSE:   LD   A,H   
01F7   B5                     OR   L   
01F8   E1                     POP   HL   
01F9   28 0C                  JR   Z,rdrop   
01FB                          IF   CHECKED   
01FB   CD 6C 03               CALL   chkbrk   ; Ctrl-C is checked at every loop-back
01FE                          ENDIF      
01FE   CD EA 00               CALL   rpop   ; peek: pop the block start ...
0201   42                     LD   B,D   
0202   4B                     LD   C,E   
0203   CD E1 00               CALL   rpush   ; ... and push it back
0206   D7                     RST   10h   
0207   CD EA 00     RDROP:    CALL   rpop   
020A   D7                     RST   10h   
020B                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
020B                             ; drops the block start, "]" returns. No closer at all ends the program.
020B   7C           H_BREAK:   LD   A,H   
020C   B5                     OR   L   
020D   E1                     POP   HL   
020E   28 09                  JR   Z,brk1   
0210   CD 47 02               CALL   skip   
0213   FE 29                  CP   ")"   
0215   28 F0                  JR   Z,rdrop   
0217   18 01                  JR   h_ret   
0219   D7           BRK1:     RST   10h   
021A                             ; "]" returns: pop an address and jump to it.
021A   CD EA 00     H_RET:    CALL   rpop   
021D   42                     LD   B,D   
021E   4B                     LD   C,E   
021F                          IF   CHECKED   
021F   CD 6C 03               CALL   chkbrk   ; ... and at every word return
0222                          ENDIF      
0222   D7                     RST   10h   
0223                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
0223                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
0223                             ; the body"s address instead. Either way it then skips to the matching "]'.
0223   0A           H_DEF:    LD   A,(BC)   
0224   03                     INC   BC   
0225   5F                     LD   E,A   
0226   E6 DF                  AND   0DFh   ; fold case
0228   D6 41                  SUB   "A"   
022A   FE 1A                  CP   26   
022C   30 0E                  JR   NC,def2   ; not a letter
022E   7B                     LD   A,E   
022F   D6 41                  SUB   "A"   ; 0-25 or 32-57: lowercase lands 64 bytes up
0231   87                     ADD   A,A   
0232   5F                     LD   E,A   
0233   16 82                  LD   D,LETPAGE   ; DE -> cell
0235   79                     LD   A,C   
0236   12                     LD   (DE),A   
0237   1C                     INC   E   
0238   78                     LD   A,B   
0239   12                     LD   (DE),A   
023A   18 B6                  JR   skipnx   
023C                DEF2:        
023C                          IF   CHECKED   
023C   7B                     LD   A,E   
023D   FE 20                  CP   " "   
023F   C2 8C 03               JP   NZ,e_brack   ; anything but a letter or a space
0242                          ENDIF      
0242   E5                     PUSH   HL   ; an anonymous block: push its address
0243   60                     LD   H,B   
0244   69                     LD   L,C   
0245   18 AB                  JR   skipnx   
0247                             ; skip: read past text to the closer at this level, and return it in A.
0247                             ; Brackets of both kinds count together; strings are stepped over whole. A
0247                             ; NUL first ends the program (for "\" with no closer; anything else that runs
0247                             ; into the NUL had unbalanced brackets anyway).
0247   16 00        SKIP:     LD   D,0   
0249   0A           SK1:      LD   A,(BC)   
024A   03                     INC   BC   
024B   B7                     OR   A   
024C   CA 03 00               JP   Z,endprog   
024F   FE 22                  CP   22h   
0251   20 05                  JR   NZ,sk2   
0253   CD 71 02               CALL   skipstr   
0256   18 F1                  JR   sk1   
0258   FE 28        SK2:      CP   "("   
025A   28 12                  JR   Z,sk3   
025C   FE 5B                  CP   "["   
025E   28 0E                  JR   Z,sk3   
0260   FE 29                  CP   ")"   
0262   28 04                  JR   Z,sk4   
0264   FE 5D                  CP   "]"   
0266   20 E1                  JR   NZ,sk1   
0268   14           SK4:      INC   D   
0269   15                     DEC   D   
026A   C8                     RET   Z   ; the closer at this level
026B   15                     DEC   D   
026C   18 DB                  JR   sk1   
026E   14           SK3:      INC   D   
026F   18 D8                  JR   sk1   
0271                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
0271                             ; the next character, so "/"" does not end it.
0271   0A           SKIPSTR:   LD   A,(BC)   
0272   03                     INC   BC   
0273   FE 2F                  CP   "/"   
0275   20 03                  JR   NZ,ss1   
0277   03                     INC   BC   
0278   18 F7                  JR   skipstr   
027A   FE 22        SS1:      CP   22h   
027C   20 F3                  JR   NZ,skipstr   
027E   C9                     RET      
027F                             ; =============================================================================
027F                             ;  Console
027F                             ; =============================================================================
027F                             ; 22h pushes the address of the text after it and skips the string.
027F   E5           H_STR:    PUSH   HL   
0280   60                     LD   H,B   
0281   69                     LD   L,C   
0282   CD 71 02               CALL   skipstr   
0285   D7                     RST   10h   
0286                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
0286                             ; 40h-7Fh clears its bit 6 (/M is CR, /` is space); plus anything lower gives
0286                             ; that character itself.
0286   7E           H_PRINT:   LD   A,(HL)   
0287   23                     INC   HL   
0288   FE 22                  CP   22h   
028A   28 11                  JR   Z,prdone   
028C   FE 2F                  CP   "/"   
028E   20 08                  JR   NZ,pr1   
0290   7E                     LD   A,(HL)   
0291   23                     INC   HL   
0292   FE 40                  CP   40h   
0294   38 02                  JR   C,pr1   
0296   E6 BF                  AND   0BFh   
0298   CD 03 FF     PR1:      CALL   putc   
029B   18 E9                  JR   h_print   
029D   CF           PRDONE:   RST   08h   
029E   7D           H_EMIT:   LD   A,L   ; "'"
029F   CD 03 FF               CALL   putc   
02A2   CF                     RST   08h   
02A3                             ; "#" prints TOS as a signed decimal number, with no space after it.
02A3   CB 7C        H_NUM:    BIT   7,H   
02A5   28 08                  JR   Z,num1   
02A7   3E 2D                  LD   A,"-"   
02A9   CD 03 FF               CALL   putc   
02AC   CD 0B 01               CALL   neg16   
02AF   C5           NUM1:     PUSH   BC   
02B0   CD B5 02               CALL   pdec   
02B3   C1                     POP   BC   
02B4   CF                     RST   08h   
02B5                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits)
02B5   11 0A 00     PDEC:     LD   DE,10   
02B8   CD 4C 01               CALL   udiv   ; BC = HL / 10, HL = digit
02BB   7D                     LD   A,L   
02BC   F5                     PUSH   AF   
02BD   60                     LD   H,B   
02BE   69                     LD   L,C   
02BF   7C                     LD   A,H   
02C0   B5                     OR   L   
02C1   C4 B5 02               CALL   NZ,pdec   
02C4   F1                     POP   AF   
02C5   C6 30                  ADD   A,"0"   
02C7   C3 03 FF               JP   putc   
02CA   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
02CB   18 1A                  JR   kt3   
02CD                             ; "?" ( n -- c ) or ( -n -- addr )
02CD                             ;   n > 0: wait about n ms for a key; 0 if none came
02CD                             ;   n = 0: wait for a key
02CD                             ;   n < 0: read a line of at most -n characters, with echo. n is not
02CD                             ;          checked: the buffer holds 127 characters and the CR, so a
02CD                             ;          program must ask for 127 or fewer.
02CD   CB 7C        H_KEY:    BIT   7,H   
02CF   20 1A                  JR   NZ,line   
02D1   11 28 00     KT1:      LD   DE,MSLOOP   ; one millisecond, roughly
02D4   CD 5C 03     KT2:      CALL   getk   
02D7   20 0E                  JR   NZ,kt3   
02D9   1B                     DEC   DE   
02DA   7A                     LD   A,D   
02DB   B3                     OR   E   
02DC   20 F6                  JR   NZ,kt2   
02DE   7C                     LD   A,H   ; 0? never counts down: it waits
02DF   B5                     OR   L   
02E0   28 EF                  JR   Z,kt1   
02E2   2B                     DEC   HL   
02E3   7C                     LD   A,H   
02E4   B5                     OR   L   
02E5   20 EA                  JR   NZ,kt1   ; A = 0 if the time ran out
02E7   6F           KT3:      LD   L,A   
02E8   26 00                  LD   H,0   
02EA   D7                     RST   10h   
02EB                          IF   CPM   
                                 ; CP/M: BDOS 10 does the editing (the spec allows the platform's
                                 ; own line editor). It doesn't store the CR, so it is added here.
                    LINE:     XOR   A   
                              SUB   L   ; A = the count (TOS is minus the count)
                              LD   (LBHDR),A   
                              PUSH   BC   
                              EXX      
                              PUSH   HL   
                              EXX      
                              LD   DE,LBHDR   
                              LD   C,10   
                              CALL   BDOS   
                              EXX      
                              POP   HL   
                              EXX      
                              POP   BC   
                              LD   HL,LBHDR+1   
                              LD   E,(HL)   ; count
                              LD   D,0   
                              INC   HL   ; HL = LINEBUF
                              PUSH   HL   
                              ADD   HL,DE   
                              LD   (HL),13   
                              POP   HL   
                              RST   10h   
02EB                          ENDIF      
02EB                          IFN   CPM   
02EB                             ; Generic: Backspace takes the last character back (and is echoed as
02EB                             ; it is), CR ends (stored, not echoed), every other key is stored and
02EB                             ; echoed until the line is full. The line buffer starts at offset 80h
02EB                             ; of its page, so L alone is the place in the line: D holds the L of
02EB                             ; a full line.
02EB   3E 80        LINE:     LD   A,LINEBUF & 0FFh   
02ED   95                     SUB   L   ; (TOS is minus the count)
02EE   57                     LD   D,A   ; D = the L of a full line
02EF   21 80 82               LD   HL,LINEBUF   
02F2   CD 5C 03     LN2:      CALL   getk   
02F5   28 FB                  JR   Z,ln2   
02F7   FE 0D                  CP   13   
02F9   28 18                  JR   Z,ln5   
02FB   FE 08                  CP   8   
02FD   28 0D                  JR   Z,ln4   
02FF   5F                     LD   E,A   
0300   7D                     LD   A,L   
0301   BA                     CP   D   
0302   28 EE                  JR   Z,ln2   ; full
0304   73                     LD   (HL),E   
0305   2C                     INC   L   
0306   7B                     LD   A,E   
0307   CD 03 FF     LN3:      CALL   putc   
030A   18 E6                  JR   ln2   
030C   2D           LN4:      DEC   L   ; Backspace: one back, and echo it,
030D   FA 07 03               JP   M,ln3   ;   unless the line was empty (L left the
0310   2C                     INC   L   ;   upper half of the page)
0311   18 DF                  JR   ln2   
0313   77           LN5:      LD   (HL),A   ; the CR
0314   2E 80                  LD   L,LINEBUF & 0FFh   
0316   D7                     RST   10h   
0317                          ENDIF      
0317                             ; =============================================================================
0317                             ;  Machine code: the grave
0317                             ; =============================================================================
0317                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
0317                             ; are stored from addr until a non-hex character; then a RET (C9h) is
0317                             ; written and its address is left. An odd last digit is consumed and dropped.
0317                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
0317                             ; code is entered by CALL with the data stack above the return address; it
0317                             ; must keep BC, and on return the top cell becomes the new TOS.
0317   0A           H_GRAVE:   LD   A,(BC)   
0318   CD 4B 03               CALL   hexval   
031B   38 1D                  JR   C,exec   
031D   0A           HX1:      LD   A,(BC)   
031E   CD 4B 03               CALL   hexval   
0321   38 11                  JR   C,hx2   
0323   03                     INC   BC   
0324                          IF   CHECKED   
0324   CD D9 01               CALL   chkst   
0327                          ENDIF      
0327   77                     LD   (HL),A   ; the high digit goes in first ...
0328   0A                     LD   A,(BC)   
0329   CD 4B 03               CALL   hexval   
032C   38 06                  JR   C,hx2   ; odd digit: consumed, and the RET below
032E   03                     INC   BC   ;   overwrites it
032F   ED 6F                  RLD      ; ... and RLD shifts it up under the low one
0331   23                     INC   HL   
0332   18 E9                  JR   hx1   
0334                HX2:         
0334                          IF   CHECKED   
0334   CD D9 01               CALL   chkst   
0337                          ENDIF      
0337   36 C9                  LD   (HL),0C9h   
0339   D7                     RST   10h   
033A   D9           EXEC:     EXX      
033B   22 34 82               LD   (RSAVE),HL   ; machine code may change the alternates
033E   D9                     EXX      
033F   11 44 03               LD   DE,exret   
0342   D5                     PUSH   DE   
0343   E9                     JP   (HL)   
0344   D9           EXRET:    EXX      
0345   2A 34 82               LD   HL,(RSAVE)   
0348   D9                     EXX      
0349   E1                     POP   HL   
034A   D7                     RST   10h   
034B                             ; hexval: A = a character; returns its value 0-15 with carry clear, or
034B                             ; carry set if it isn't a hex digit (0-9, A-F, a-f).
034B   D6 30        HEXVAL:   SUB   "0"   
034D   FE 0A                  CP   10   
034F   3F                     CCF      
0350   D0                     RET   NC   
0351   E6 DF                  AND   0DFh   
0353   D6 11                  SUB   11h   
0355   FE 06                  CP   6   
0357   3F                     CCF      
0358   D8                     RET   C   
0359   C6 0A                  ADD   A,10   
035B   C9                     RET      
035C                             ; =============================================================================
035C                             ;  Console layer: getk returns a waiting key in A (zero flag clear), or
035C                             ;  A = 0 with the zero flag set when none is waiting. putc prints A.
035C                             ;  Both keep BC, DE, HL and HL". In the generic build they are the host"s
035C                             ;  KEY and CONOUT routines themselves.
035C                             ; =============================================================================
035C                          IF   (1-CPM)*(1-CHECKED)   
                    GETK:     EQU   KEY   ; the host's routine does the whole job
035C                          ENDIF      
035C                          IF   CHECKED   
035C   3A 36 82     GETK:     LD   A,(KEYBUF)   ; a key held back by the break check
035F   B7                     OR   A   
0360   28 07                  JR   Z,gk1   
0362   F5                     PUSH   AF   
0363   AF                     XOR   A   
0364   32 36 82               LD   (KEYBUF),A   
0367   F1                     POP   AF   
0368   C9                     RET      
0369                          ENDIF      
0369                          IF   (1-CPM)*CHECKED   
0369   C3 06 FF     GK1:      JP   KEY   
036C                          ENDIF      
036C                          IF   CPM*(1-CHECKED)   
                    GETK:        
036C                          ENDIF      
036C                          IF   CPM   
                    GK1:      LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
                              CALL   putc   
                              OR   A   
                              RET      
                                 ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
                                 ; printing and could swallow a key that BDOS 6 then never sees.
                    PUTC:     PUSH   BC   
                              PUSH   DE   
                              PUSH   HL   
                              EXX      
                              PUSH   HL   
                              EXX      
                              LD   E,A   
                              LD   C,6   
                              CALL   BDOS   
                              EXX      
                              POP   HL   
                              EXX      
                              POP   HL   
                              POP   DE   
                              POP   BC   
                              RET      
036C                          ENDIF      
036C                          IFN   CPM   
036C                PUTC:     EQU   CONOUT   
036C                          ENDIF      
036C                             ; =============================================================================
036C                             ;  Checked build: break key and error reports
036C                             ; =============================================================================
036C                          IF   CHECKED   
036C                             ; chkbrk: a waiting key is read now; Ctrl-C stops the program, anything
036C                             ; else is held for the next "?".
036C   3A 36 82     CHKBRK:   LD   A,(KEYBUF)   
036F   B7                     OR   A   
0370   C0                     RET   NZ   ; one key is already held
0371   CD 5C 03               CALL   getk   
0374   C8                     RET   Z   
0375   FE 03                  CP   3   
0377   28 0A                  JR   Z,e_break   
0379   32 36 82               LD   (KEYBUF),A   
037C   C9                     RET      
037D                             ; Error entries. Each loads its letter and then hides the next entry inside
037D                             ; a 3-byte LD HL,nn (the 21h), so they all fall through to `error`.
037D   3E 53        E_STACK:   LD   A,"S"   ; data stack over or under
037F   21                     DB   21h   
0380   3E 52        E_RSTACK:   LD   A,"R"   ; return stack over or under
0382   21                     DB   21h   
0383   3E 42        E_BREAK:   LD   A,"B"   ; Ctrl-C
0385   21                     DB   21h   
0386   3E 48        E_HEAP:   LD   A,"H"   ; heap past the limit
0388   21                     DB   21h   
0389   3E 57        E_STORE:   LD   A,"W"   ; write outside the program's space
038B   21                     DB   21h   
038C   3E 44        E_BRACK:   LD   A,"D"   ; bad character after [
038E                             ; error: print the letter in A, " @ " and the offset in the program of the
038E                             ; character just read, then end. For example: S @ 245
038E   31 FE 81     ERROR:    LD   SP,DSTOP   ; the stacks may be wrecked: start clean
0391   CD 03 FF               CALL   putc   
0394   3E 20                  LD   A," "   
0396   CD 03 FF               CALL   putc   
0399   3E 40                  LD   A,"@"   
039B   CD 03 FF               CALL   putc   
039E   3E 20                  LD   A," "   
03A0   CD 03 FF               CALL   putc   
03A3   21 FF 7C               LD   HL,(0-PROG-1)&0FFFFh   ; minus the address of the character
03A6   09                     ADD   HL,BC   ;   just read: HL = its offset
03A7   CD B5 02               CALL   pdec   
03AA   C3 03 00               JP   endprog   
03AD                          ENDIF      
03AD                             ; =============================================================================
03AD                             ;  Startup
03AD                             ; =============================================================================
03AD                START:       
03AD                          IF   CPM   
                                 ; CP/M: the RAM pages follow the image; the heap may grow to the BDOS
                              LD   SP,DSTOP   
                              LD   HL,stubs   ; RST 08h and RST 10h stubs into page zero
                              LD   DE,0008h   
                              LD   BC,13   
                              LDIR      
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   
                              CALL   BDOS   
                              INC   A   
                              JP   Z,0   ; no such file: back to CP/M
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              OR   A   
                              JR   Z,ld1   
                              LD   HL,-128   ; the failed read left nothing: back up
                              ADD   HL,DE   
                              LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   
                              LD   (HEAP),HL   
                              LD   A,(0007h)   ; the BDOS page is the heap limit
                              LD   (HLIM),A   
03AD                          ENDIF      
03AD                          IFN   CPM   
03AD   31 FE 81               LD   SP,DSTOP   
03B0   21 00 83               LD   HL,PROG   ; the heap starts after the program's NUL
03B3   AF                     XOR   A   
03B4   47                     LD   B,A   
03B5   4F                     LD   C,A   
03B6   ED B1                  CPIR      
03B8   22 7C 82               LD   (HEAP),HL   
03BB                          ENDIF      
03BB                          IF   (1-CPM)*CHECKED   
03BB   3E F0                  LD   A,HEAPLIM   
03BD   32 3A 82               LD   (HLIM),A   
03C0                          ENDIF      
03C0   D9                     EXX      
03C1   21 E0 80               LD   HL,RSTOP   
03C4   D9                     EXX      
03C5                          IF   CHECKED   
03C5   AF                     XOR   A   
03C6   32 36 82               LD   (KEYBUF),A   
03C9                          ENDIF      
03C9   01 00 83               LD   BC,PROG   
03CC   C3 11 00               JP   next0   
03CF                          IF   CPM   
                    STUBS:    POP   DE   ; 0008h: drop, then next
                              POP   HL   
                              JP   next0   
                              DB   0,0,0   
                              POP   DE   ; 0010h: next
                              JP   next0   
                    ENDPROG:   EQU   0   ; warm boot
                    DROP_NEXT:   EQU   0009h   
                                 ; RAM pages, after the image
                    RSPAGE:   EQU   (imgend + 255) / 256   
                    DSPAGE:   EQU   RSPAGE + 1   
                    LETPAGE:   EQU   RSPAGE + 2   
                    PROG:     EQU   LETPAGE*256 + 256   
03CF                          ENDIF      
03CF                IMGEND:      


