0170   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
0171   31                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
0172   00                     DS   CPM+FAST-CPM*FAST,ANXT/256   
0173                             ; ---- stack and storage -----------------------------------------------------
0173   E5           H_DUP:    PUSH   H   ; ":"
0174                          ;*Macro unroll:  NEXT
0174                          DS   (1-CPM)*(1-FAST),0F7h   
0174   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
0175   31                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
0176   00                     DS   CPM+FAST-CPM*FAST,ANXT/256   
0177   E3           H_SWAP:   XTHL      ; "%"
0178                          ;*Macro unroll:  NEXT
0178                          DS   (1-CPM)*(1-FAST),0F7h   
0178   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
0179   31                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
017A   00                     DS   CPM+FAST-CPM*FAST,ANXT/256   
017B                             ; (The checked build tests the address before it takes the value off the
017B                             ; stack, so that an error report shows both.)
017B                H_STORE:      ; "!" ( n addr -- )
017B                          IF   CHECKED   
017B   CD C3 05               CALL   chkst   
017E                          ENDIF      
017E   D1                     POP   D   
017F   73                     MOV   M,E   
0180   23                     INX   H   
0181   72                     MOV   M,D   
0182                          ;*Macro unroll:  DROP
0182                          DS   (1-CPM)*(1-FAST),0DFh   
0182                          DS   CPM*(1-FAST),0C3h   
0182                          DS   CPM*(1-FAST),ADRP&0FFh   
0182                          DS   CPM*(1-FAST),ADRP/256   
0182   E1                     DS   FAST,0E1h   
0183   C3                     DS   FAST,0C3h   
0184   31                     DS   FAST,ANXT&0FFh   
0185   00                     DS   FAST,ANXT/256   
0186                H_CSTORE:      ; "." ( c addr -- )
0186                          IF   CHECKED   
0186   CD C3 05               CALL   chkst   
0189                          ENDIF      
0189   D1                     POP   D   
018A   73                     MOV   M,E   
018B                          ;*Macro unroll:  DROP
018B                          DS   (1-CPM)*(1-FAST),0DFh   
018B                          DS   CPM*(1-FAST),0C3h   
018B                          DS   CPM*(1-FAST),ADRP&0FFh   
018B                          DS   CPM*(1-FAST),ADRP/256   
018B   E1                     DS   FAST,0E1h   
018C   C3                     DS   FAST,0C3h   
018D   31                     DS   FAST,ANXT&0FFh   
018E   00                     DS   FAST,ANXT/256   
018F                             ; ---- console ---------------------------------------------------------------
018F                             ; 22h pushes the address of the text after it and skips the string.
018F   E5           H_STR:    PUSH   H   
0190   60                     MOV   H,B   
0191   69                     MOV   L,C   
0192   CD E0 04               CALL   skipstr   
0195                          IF   CHECKED   
0195   B7                     ORA   A   ; 0: the text ran out before the closing quote
0196   CA 52 06               JZ   e_quote   
0199                          ENDIF      
0199                          ;*Macro unroll:  NEXT
0199                          DS   (1-CPM)*(1-FAST),0F7h   
0199   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
019A   31                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
019B   00                     DS   CPM+FAST-CPM*FAST,ANXT/256   
019C                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
019C                             ; 60h to 7Eh is one of the escapes at pesc; "/" plus any other character
019C                             ; clears that character"s bit 6 (/M is CR, and / then DEL gives "?"; "/',
019C                             ; '"' and '?' have no bit 6, so //, /" and /? give themselves).
019C                          IF   1-CHECKED   
                    H_PRINT:   JMP   prlp   ; (the loop is with the escapes, out of the
                    PRLOOP:   EQU   prlp   ;   way of the handlers, which must fit in
                    PRAGAIN:   EQU   prlp   ;   the image's first two pages)
019C                          ENDIF      
019C                          IF   CHECKED   
019C                             ; (The checked build has the loop as a routine, prstr, which the error
019C                             ; report uses too. The address is kept meanwhile, for a report: it shows
019C                             ; the stack as it was before the "$". /~ comes back to hp1.)
019C   22 3A 82     H_PRINT:   SHLD   PSAVE   
019F   CD D6 05     HP1:      CALL   prstr   
01A2                          ;*Macro unroll:  DROP
01A2                          DS   (1-CPM)*(1-FAST),0DFh   
01A2                          DS   CPM*(1-FAST),0C3h   
01A2                          DS   CPM*(1-FAST),ADRP&0FFh   
01A2                          DS   CPM*(1-FAST),ADRP/256   
01A2   E1                     DS   FAST,0E1h   
01A3   C3                     DS   FAST,0C3h   
01A4   31                     DS   FAST,ANXT&0FFh   
01A5   00                     DS   FAST,ANXT/256   
01A6                          ENDIF      
01A6   7D           H_EMIT:   MOV   A,L   ; "'"
01A7                          ;*Macro unroll:  PUTA
01A7   EF                     DS   1-CPM,0EFh   
01A8                          DS   CPM,0CDh   
01A8                          DS   CPM,APUT&0FFh   
01A8                          DS   CPM,APUT/256   
01A8                          ;*Macro unroll: h_drop: DROP                    ; ';' is this one byte
01A8                H_DROP:   DS   (1-CPM)*(1-FAST),0DFh   ; ";" is this one byte
01A8                          DS   CPM*(1-FAST),0C3h   
01A8                          DS   CPM*(1-FAST),ADRP&0FFh   
01A8                          DS   CPM*(1-FAST),ADRP/256   
01A8   E1                     DS   FAST,0E1h   
01A9   C3                     DS   FAST,0C3h   
01AA   31                     DS   FAST,ANXT&0FFh   
01AB   00                     DS   FAST,ANXT/256   
01AC                             ; "#" prints TOS as a signed decimal number, with no space after it.
01AC   C5           H_NUM:    PUSH   B   
01AD   CD E6 03               CALL   psgn   
01B0   C1                     POP   B   
01B1                          ;*Macro unroll:  DROP
01B1                          DS   (1-CPM)*(1-FAST),0DFh   
01B1                          DS   CPM*(1-FAST),0C3h   
01B1                          DS   CPM*(1-FAST),ADRP&0FFh   
01B1                          DS   CPM*(1-FAST),ADRP/256   
01B1   E1                     DS   FAST,0E1h   
01B2   C3                     DS   FAST,0C3h   
01B3   31                     DS   FAST,ANXT&0FFh   
01B4   00                     DS   FAST,ANXT/256   
01B5                          IF   CHECKED   ; (the checked build has no room to start ","
01B5   6E           H_CFETCH:   MOV   L,M   ;   as late as the unchecked one does: see
01B6   26 00                  MVI   H,0   ;   the end of "?")
01B8                          ;*Macro unroll:  NEXT
01B8                          DS   (1-CPM)*(1-FAST),0F7h   
01B8   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
01B9   31                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
01BA   00                     DS   CPM+FAST-CPM*FAST,ANXT/256   
01BB                          ENDIF      
01BB                             ; "?" ( n -- c ) or ( -n -- addr )
01BB                             ;   n > 0: wait about n ms for a key; 0 if none came
01BB                             ;   n = 0: wait for a key
01BB                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
01BB                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
01BB   7C           H_KEY:    MOV   A,H   
01BC   B7                     ORA   A   
01BD   FA DD 01               JM   line   
01C0   1E 28        KT1:      MVI   E,MSLOOP   ; one millisecond, roughly
01C2   CD 9C 05     KT2:      CALL   getk   
01C5   C2 D7 01               JNZ   kt3   
01C8   1D                     DCR   E   
01C9   C2 C2 01               JNZ   kt2   
01CC   7C                     MOV   A,H   ; 0? never counts down: it waits
01CD   B5                     ORA   L   
01CE   CA C0 01               JZ   kt1   
01D1   2B                     DCX   H   
01D2   7C                     MOV   A,H   
01D3   B5                     ORA   L   
01D4   C2 C0 01               JNZ   kt1   ; A = 0 if the time ran out
01D7                          IF   1-CHECKED   
                              DB   0FEh   ; (CPI: steps over the one byte of ",")
                    H_CFETCH:   MOV   A,M   ; "," shares "?"s ending: A becomes TOS
01D7                          ENDIF      
01D7   6F           KT3:      MOV   L,A   
01D8   26 00                  MVI   H,0   
01DA                          ;*Macro unroll:  NEXT
01DA                          DS   (1-CPM)*(1-FAST),0F7h   
01DA   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
01DB   31                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
01DC   00                     DS   CPM+FAST-CPM*FAST,ANXT/256   
01DD                             ; Backspace takes the last character back (and is echoed as
01DD                             ; it is), CR ends (stored, not echoed), every other key is stored and
01DD                             ; echoed until the line is full. The line buffer starts at offset 80h
01DD                             ; of its page, so L alone is the place in the line: D holds the L of
01DD                             ; a full line.
01DD   11 7F 00     LINE:     LXI   D,127   ; TOS is minus the count: adding 127 carries
01E0   19                     DAD   D   ;   only for 1 to 127, and leaves 127 - count
01E1   9F                     SBB   A   
01E2   A5                     ANA   L   ; (0 for a count that is too big)
01E3   2F                     CMA      
01E4   57                     MOV   D,A   ; D = the L of a full line: 80h + count, FFh
01E5                             ;   at most
01E5   21 80 82               LXI   H,LINEBUF   
01E8   CD 9C 05     LN2:      CALL   getk   
01EB   CA E8 01               JZ   ln2   
01EE   FE 0D                  CPI   13   
01F0   CA 0D 02               JZ   ln5   
01F3   FE 08                  CPI   8   
01F5   CA 05 02               JZ   ln4   
01F8   5F                     MOV   E,A   
01F9   7D                     MOV   A,L   
01FA   BA                     CMP   D   
01FB   CA E8 01               JZ   ln2   ; full
01FE   73                     MOV   M,E   
01FF   2C                     INR   L   
0200   7B                     MOV   A,E   
0201                          ;*Macro unroll: ln3:    PUTA
0201   EF           LN3:      DS   1-CPM,0EFh   
0202                          DS   CPM,0CDh   
0202                          DS   CPM,APUT&0FFh   
0202                          DS   CPM,APUT/256   
0202   C3 E8 01               JMP   ln2   
0205   2D           LN4:      DCR   L   ; Backspace: one back, and echo it,
0206   FA 01 02               JM   ln3   ;   unless the line was empty (L left the
0209   2C                     INR   L   ;   upper half of the page)
020A   C3 E8 01               JMP   ln2   
020D   77           LN5:      MOV   M,A   ; the CR
020E   2E 80                  MVI   L,LINEBUF & 0FFh   
0210                          ;*Macro unroll:  NEXT
0210                          DS   (1-CPM)*(1-FAST),0F7h   
0210   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
0211   31                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
0212   00                     DS   CPM+FAST-CPM*FAST,ANXT/256   
0213                             ; =============================================================================
0213                             ;  Dispatch table: the low byte of each handler's address, in code order.
0213                             ;  It must not cross a page (the dispatcher only adds to its low byte).
0213                             ; =============================================================================
0213                             ; The handlers of the first NPG1 characters start in the image's second page.
0213                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
0213                             ; differs between the builds, so the count is worked out here.
0213                             ; (One division to a line: asm80 only rounds down when it stores a value.)
0213                          IF   1-FAST   
                    PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
                    PGBRK:    EQU   (h_break-BASE)/256   
                    PGDEF:    EQU   (h_def-BASE)/256   
                    PGFET:    EQU   (h_fetch-BASE)/256   
                    NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
0213                          ENDIF      
0213                          IF   (1-FAST)*(1-PTLATE)   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0213                          ENDIF      
0213                             ; =============================================================================
0213                             ;  Routines (no handler starts past this point)
0213                             ; =============================================================================
0213                             ; Digits: step back onto the first digit and read the whole number.
0213   E5           DIGIT:    PUSH   H   
0214   0B                     DCX   B   
0215   CD 23 02               CALL   rdnum   
0218                          ;*Macro unroll:  NEXT
0218                          DS   (1-CPM)*(1-FAST),0F7h   
0218   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
0219   31                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
021A   00                     DS   CPM+FAST-CPM*FAST,ANXT/256   
021B                             ; negnum: "-" directly before a digit: read the number, negate it.
021B   E5           NEGNUM:   PUSH   H   
021C   CD 23 02               CALL   rdnum   
021F                          ;*Macro unroll:  NEGH
021F   E7                     DS   1-CPM,0E7h   
0220                          DS   CPM,0CDh   
0220                          DS   CPM,ANEG&0FFh   
0220                          DS   CPM,ANEG/256   
0220                          ;*Macro unroll:  NEXT
0220                          DS   (1-CPM)*(1-FAST),0F7h   
0220   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
0221   31                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
0222   00                     DS   CPM+FAST-CPM*FAST,ANXT/256   
0223                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
0223                             ; non-digit. Values wrap at 16 bits, as the spec says.
0223   21 00 00     RDNUM:    LXI   H,0   
0226   0A           RDN1:     LDAX   B   
0227   D6 30                  SUI   "0"   
0229   FE 0A                  CPI   10   
022B   D0                     RNC      
022C   03                     INX   B   
022D   54                     MOV   D,H   
022E   5D                     MOV   E,L   
022F   29                     DAD   H   
0230   29                     DAD   H   
0231   19                     DAD   D   
0232   29                     DAD   H   ; HL * 10
0233   5F                     MOV   E,A   
0234   16 00                  MVI   D,0   
0236   19                     DAD   D   
0237   C3 26 02               JMP   rdn1   
023A                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, BC = remainder.
023A                             ; Uses A, BC; the caller saves the IP. HL holds the dividend and, as its bits
023A                             ; leave at the top, the quotient bits arrive at the bottom. The loop counter
023A                             ; lives on the stack, since A is busy with the shifts.
023A                             ; Dividing by 2 is one shift (the spec wants that fast).
023A   01 00 00     UDIV:     LXI   B,0   
023D                          IF   1-QK   
                              MOV   A,E   
                              XRI   2   
                              ORA   D   
                              JNZ   udv0   
                              ORA   H   ; A was 0, and the carry is clear
                              RAR      
                              MOV   H,A   
                              MOV   A,L   
                              RAR      
                              MOV   L,A   ; the quotient
                              MOV   A,B   
                              RAL      
                              MOV   C,A   ; the remainder: the bit that fell out
                              RET      
023D                          ENDIF      
023D                          IF   QK   
023D                             ; (The builds with room divide by any power of two with shifts: 2, and 32,
023D                             ; 64, 256 and the like, which fixed point and byte work use all the time.)
023D   7A                     MOV   A,D   
023E   B7                     ORA   A   
023F   C2 93 02               JNZ   uq1   ; 256 and up
0242   B3                     ORA   E   
0243   CA AA 02               JZ   udv0   ; by 0: the long way (it means nothing anyway)
0246   3D                     DCR   A   
0247   A3                     ANA   E   
0248   C2 AA 02               JNZ   udv0   ; not a power of two
024B   7B                     MOV   A,E   ; by 2^k below 256: q = HL >> k, and
024C   3D                     DCR   A   ;   r = L & (2^k - 1)
024D   A5                     ANA   L   
024E   4F                     MOV   C,A   
024F                          ENDIF      
024F                          IF   QK*(1-FAST)   
                    UQ2:      MOV   A,E   ; one shift for each halving of E down to 1
                              ORA   A   
                              RAR      
                              RC      
                              MOV   E,A   
                              MOV   A,H   ; (the carry is clear: E's bit 0 was 0)
                              RAR      
                              MOV   H,A   
                              MOV   A,L   
                              RAR      
                              MOV   L,A   
                              JMP   uq2   
024F                          ENDIF      
024F                          IF   FAST   
024F                             ; (the fast build: the shifts unrolled. By 16 to 128 it is fewer shifts to
024F                             ; go the other way: A:HL up by 8 - k, and A:H is the quotient)
024F   7B           UQ2:      MOV   A,E   
0250   FE 10                  CPI   16   
0252   D2 76 02               JNC   uqh   
0255   FE 02                  CPI   2   
0257   D8                     RC      ; by 1
0258   CA 6E 02               JZ   ur1   
025B   FE 04                  CPI   4   
025D   CA 67 02               JZ   ur2   
0260                UR3:         
0260   7C                     MOV   A,H   
0261   B7                     ORA   A   
0262   1F                     RAR      
0263   67                     MOV   H,A   
0264   7D                     MOV   A,L   
0265   1F                     RAR      
0266   6F                     MOV   L,A   
0267                UR2:         
0267   7C                     MOV   A,H   
0268   B7                     ORA   A   
0269   1F                     RAR      
026A   67                     MOV   H,A   
026B   7D                     MOV   A,L   
026C   1F                     RAR      
026D   6F                     MOV   L,A   
026E                UR1:         
026E   7C                     MOV   A,H   
026F   B7                     ORA   A   
0270   1F                     RAR      
0271   67                     MOV   H,A   
0272   7D                     MOV   A,L   
0273   1F                     RAR      
0274   6F                     MOV   L,A   
0275   C9                     RET      
0276   FE 40        UQH:      CPI   64   
0278   3E 00                  MVI   A,0   
027A   CA 8C 02               JZ   ul2   
027D   D2 8E 02               JNC   ul1   
0280   7B                     MOV   A,E   
0281   FE 20                  CPI   32   
0283   3E 00                  MVI   A,0   
0285   CA 8A 02               JZ   ul3   
0288   29                     DAD   H   ; by 16
0289   8F                     ADC   A   
028A   29           UL3:      DAD   H   
028B   8F                     ADC   A   
028C   29           UL2:      DAD   H   
028D   8F                     ADC   A   
028E   29           UL1:      DAD   H   
028F   8F                     ADC   A   
0290   6C                     MOV   L,H   
0291   67                     MOV   H,A   
0292   C9                     RET      
0293                          ENDIF      
0293                          IF   QK   
0293   7B           UQ1:      MOV   A,E   
0294   B7                     ORA   A   
0295   C2 AA 02               JNZ   udv0   
0298   7A                     MOV   A,D   
0299   3D                     DCR   A   
029A   A2                     ANA   D   
029B   C2 AA 02               JNZ   udv0   ; not a power of two
029E   7A                     MOV   A,D   ; by 2^k, 256 and up: r = HL & (2^k - 1), and
029F   3D                     DCR   A   ;   q = H >> (k - 8)
02A0   A4                     ANA   H   
02A1   47                     MOV   B,A   
02A2   4D                     MOV   C,L   
02A3   6C                     MOV   L,H   
02A4   26 00                  MVI   H,0   
02A6   5A                     MOV   E,D   
02A7   C3 4F 02               JMP   uq2   
02AA                          ENDIF      
02AA                          IF   1-FAST   
                    UDV0:     MVI   A,16   
                              PUSH   PSW   
                    UDV1:     DAD   H   ; next dividend bit into the carry
                              MOV   A,C   
                              RAL      
                              MOV   C,A   
                              MOV   A,B   
                              RAL      
                              MOV   B,A   ; BC = BC*2 + bit
                              MOV   A,C   
                              SUB   E   
                              MOV   A,B   
                              SBB   D   ; carry if BC < DE
                              JC   udv2   
                              MOV   B,A   ; BC - DE (high byte; A holds it)
                              MOV   A,C   
                              SUB   E   
                              MOV   C,A   
                              INR   L   ; quotient bit
                    UDV2:     POP   PSW   
                              DCR   A   
                              PUSH   PSW   
                              JNZ   udv1   
                              POP   PSW   
                              RET      
02AA                          ENDIF      
02AA                          IF   FAST   
02AA                             ; (the fast build: the same 16 rounds, unrolled; and a dividend below 256
02AA                             ; starts 8 bits up and takes only the last 8, since its first 8 would only
02AA                             ; shift zeros)
02AA   7C           UDV0:     MOV   A,H   
02AB   B7                     ORA   A   
02AC   CA E0 03               JZ   uvs   
02AF   29           UV0:      DAD   H   
02B0   79                     MOV   A,C   
02B1   17                     RAL      
02B2   4F                     MOV   C,A   
02B3   78                     MOV   A,B   
02B4   17                     RAL      
02B5   47                     MOV   B,A   ; BC = BC*2 + bit
02B6   79                     MOV   A,C   
02B7   93                     SUB   E   
02B8   78                     MOV   A,B   
02B9   9A                     SBB   D   ; carry if BC < DE
02BA   DA C2 02               JC   uw0   
02BD   47                     MOV   B,A   
02BE   79                     MOV   A,C   
02BF   93                     SUB   E   
02C0   4F                     MOV   C,A   
02C1   2C                     INR   L   ; quotient bit
02C2                UW0:         
02C2   29           UV1:      DAD   H   
02C3   79                     MOV   A,C   
02C4   17                     RAL      
02C5   4F                     MOV   C,A   
02C6   78                     MOV   A,B   
02C7   17                     RAL      
