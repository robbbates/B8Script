  1896                              <1> ;  The letters and digits, the return stack's push, and the inner loop
  1897                              <1> ; =============================================================================
  1898                              <1> 
  1899                              <1> 
  1900                              <1> ; =============================================================================
  1901                              <1> ;  The inner loop: read one character and sort it by range.
  1902                              <1> ;
  1903                              <1> ;    00h          end of program
  1904                              <1> ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes; the checked
  1905                              <1> ;                 build stops on 80h-FFh: X)
  1906                              <1> ;    30h-39h      digit: read a whole number
  1907                              <1> ;    41h-5Ah      A-Z: call the word in that letter's cell
  1908                              <1> ;    61h-7Ah      a-z: push the address of that letter's cell
  1909                              <1> ;    the rest     punctuation: jump through PTAB, 32 entries
  1910                              <1> ; =============================================================================
  1911                              <1> ; Digits: step back onto the first digit and read the whole number.
  1912 00000840 53                  <1> digit:  push    ebx
  1913 00000841 4E                  <1>         dec     esi
  1914                              <1>         CALLP   rdnum
   192                              <2>  %if P_%1
   193                              <2>  call [V(p_%1)]
   194                              <2>  %else
   195 00000842 E834FEFFFF          <2>  call %1
   196                              <2>  %endif
  1915 00000847 FFE5                <1>         jmp     ebp
  1916                              <1> 
  1917                              <1> ; a-z: push the cell's address (the cell is the variable).
  1918 00000849 53                  <1> lower:  push    ebx
  1919 0000084A 8D9C0000014100      <1>         lea     ebx,[ARENA+LET+eax*2]
  1920 00000851 FFE5                <1>         jmp     ebp
  1921                              <1> ; (digit, lower and ctl are here, before next, to keep the variables after
  1922                              <1> ; next in reach)
  1923 00000853 0421                <1> ctl:    add     al,21h                  ; back to c; zero only for NUL
  1924 00000855 750C                <1>         jnz     next                    ; the rest are ignored
  1925 00000857 E9F7FCFFFF          <1>         jmp     endprog
  1926                              <1> %if CHECKED
  1927 0000085C B058                <1> e_hi:   mov     al,'X'                  ; a reserved byte outside a string
  1928 0000085E E9A1FAFFFF          <1>         jmp     error
  1929                              <1> %endif
  1930                              <1> next:
  1931                              <1> %if CHECKED
  1932 00000863 E847FAFFFF          <1>         call    chkstk                  ; both stacks, once per character
  1933                              <1> %endif
  1934 00000868 31C0                <1>         xor     eax,eax
  1935 0000086A AC                  <1>         lodsb
  1936 0000086B 2C21                <1>         sub     al,21h                  ; AL = c - 21h
  1937 0000086D 72E4                <1>         jb      ctl                     ; c < 21h: NUL ends, the rest are ignored
  1938 0000086F 3C0F                <1>         cmp     al,0Fh
  1939 00000871 7228                <1>         jb      punct                   ; 21h-2Fh: PTAB index 0-14
  1940 00000873 2C0F                <1>         sub     al,0Fh                  ; AL = c - 30h
  1941 00000875 3C0A                <1>         cmp     al,0Ah
  1942 00000877 72C7                <1>         jb      digit                   ; 30h-39h
  1943 00000879 3C11                <1>         cmp     al,11h
  1944 0000087B 721C                <1>         jb      p3a                     ; 3Ah-40h
  1945 0000087D 2C11                <1>         sub     al,11h                  ; AL = c - 41h
  1946 0000087F 3C1A                <1>         cmp     al,1Ah
  1947 00000881 0F8254F8FFFF        <1>         jb      upper                   ; 41h-5Ah: AL = letter index 0-25
  1948 00000887 3C20                <1>         cmp     al,20h
  1949 00000889 720C                <1>         jb      p5b                     ; 5Bh-60h
  1950 0000088B 3C3A                <1>         cmp     al,3Ah
  1951 0000088D 72BA                <1>         jb      lower                   ; 61h-7Ah: AL = 20h-39h (cell +64 bytes)
  1952 0000088F 3C3E                <1>         cmp     al,3Eh
  1953                              <1> %if CHECKED
  1954 00000891 74D0                <1>         je      next                    ; 7Fh, DEL: ignored
  1955 00000893 73C7                <1>         jae     e_hi                    ; 80h-FFh: reserved
  1956                              <1> %else
  1957                              <1>         jae     next                    ; 7Fh-FFh: ignored
  1958                              <1> %endif
  1959 00000895 2C1A                <1>         sub     al,1Ah                  ; 7Bh-7Eh: -1Eh in all, index 28-31
  1960 00000897 2C09                <1> p5b:    sub     al,9                    ; 5Bh-60h: -4 in all, index 22-27
  1961 00000899 0405                <1> p3a:    add     al,5                    ; 3Ah-40h: index 15-21
  1962 0000089B 8A80[9A060000]      <1> punct:  mov     al,[ptab+eax]
  1963 000008A1 8D80[01010000]      <1>         lea     eax,[hbase+eax]
  1964 000008A7 FFE0                <1>         jmp     eax
