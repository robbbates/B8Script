0439   21 80 82               LD   HL,LINEBUF   
043C   11 00 00               LD   DE,0   
043F   78                     LD   A,B   
0440   FE 83                  CP   PROG/256   
0442   38 14                  JR   C,er3   
0444   24                     INC   H   
0445   6B                     LD   L,E   ; HL = PROG
0446   13           ER1:      INC   DE   ; a new line starts at HL
0447   E5                     PUSH   HL   
0448   7D           ER2:      LD   A,L   
0449   91                     SUB   C   
044A   7C                     LD   A,H   
044B   98                     SBC   A,B   
044C   30 09                  JR   NC,er2x   ; reached the place
044E   7E                     LD   A,(HL)   
044F   23                     INC   HL   
0450   FE 0A                  CP   10   
0452   20 F4                  JR   NZ,er2   
0454   F1                     POP   AF   
0455   18 EF                  JR   er1   
0457   E1           ER2X:     POP   HL   
0458   C5           ER3:      PUSH   BC   
0459   E5                     PUSH   HL   
045A   EB                     EX   DE,HL   
045B   CD 4B 03               CALL   pdec   ; the line
045E   3E 2C                  LD   A,","   
0460   EF                     RST   28h   
0461   D1                     POP   DE   
0462   E1                     POP   HL   
0463   E5                     PUSH   HL   
0464   B7                     OR   A   
0465   ED 52                  SBC   HL,DE   
0467   23                     INC   HL   
0468   CD 4B 03               CALL   pdec   ; the column
046B   CD 21 02               CALL   pnl   
046E   22                     DB   22h   
