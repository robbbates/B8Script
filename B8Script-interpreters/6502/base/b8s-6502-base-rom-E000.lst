0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the 6502 (NMOS opcodes only)
0000                             ;  Spec: docs/b8script.md (2026-11-24). -n? does no more editing than
0000                             ;        Backspace. Ctrl-C stops every build (see the console layer); the
0000                             ;        break-off cell is BRKOFF, $047B.
0000                             ;  Design follows the Z80 interpreter; see b8s-z80.asm for the common ideas.
0000                             ; 
0000                             ;  This interpreter keeps the data stack in pages 2 and 3 (252 cells) and
0000                             ;  uses 10 bytes of zero page ($00-$09). b8s-6502-zp.asm is a smaller interpreter that
0000                             ;  keeps the stack in zero page instead (112 cells); its memory map and
0000                             ;  machine-code contract differ.
0000                             ; 
0000                             ;  The switches, set in the EQU lines below:
0000                             ;    CHECKED  0 = no checks: whatever the spec calls unsafe is not caught
0000                             ;             1 = a checked build, as in the spec's "Errors and checked
0000                             ;                 builds": at startup every word cell points at 0000h (see
0000                             ;                 e_undef) and the variables and the interpreter's cells are
0000                             ;                 0. It stops with S s R r (stack over/underflow), H (heap),
0000                             ;                 O (a store outside the program's space), U (undefined
0000                             ;                 word), Q (no closing quote), W (bad character after [), X
0000                             ;                 (a reserved byte), Z (divide by zero), N (brackets) or B
0000                             ;                 (Ctrl-C), printing the spec's three-line report:
0000                             ;                   Err Z @ 3,4
0000                             ;                   D:2: 5 0
0000                             ;                   R:0
0000                             ;                 and then goes to EXIT.
0000                             ;    ANSI     what the console escapes of "$" (/00bbIC8= /| /` /~) do:
0000                             ;             1 = send ANSI (VT100) sequences through CONOUT
0000                             ;             0 = call the machine's own routines CONCLS, CONEOL, CONCUR and
0000                             ;                 CONAT (see the equates)
0000                             ;    SPEED    0 = small: the smallest build
0000                             ;             1 = base, the default: the speed-ups that cost bytes: a skip
0000                             ;                 cache, a faster skip, "*" and "/" quicker for small and
0000                             ;                 power-of-two operands, and more (see "Speed-ups")
0000                             ;             2 = fast: base and a dispatch table besides, with no size
0000                             ;                 limit (see "The fast build").
0000                             ;  The base and fast builds use one more RAM page, for the skip cache: the page
0000                             ;  at the heap limit, which is DF00h in them (E000h in the others).
0000                             ; 
0000                             ;  Assembler: asm80, C6502 mode.
0000                             ; =============================================================================
0000                CHECKED:   EQU   1   ; 1 = checked build
0000                ANSI:     EQU   0   ; 1 = the console escapes send ANSI sequences
0000                SPEED:    EQU   1   ; 0 = small, 1 = base, 2 = fast (see "Speed-ups")
0000                FAST:     EQU   SPEED/2   ; (1: the fast build)
0000                SBASE:    EQU   SPEED-FAST*2   ; (1: the base build)
0000                QK:       EQU   SBASE+FAST-SBASE*FAST   ; (the speed-ups: base, or the fast build)
0000                SBASEU:   EQU   QK*(1-CHECKED)*(1-FAST)   ; (and those that only the unchecked
0000                             ;  builds take; the fast build has its own)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Registers and zero page
0000                             ; 
0000                             ;    IP      zero-page pointer to the next program character (16 bits)
0000                             ;    TL/TH   the top data-stack cell (TOS) lives in zero page, not in memory
0000                             ;    X       data-stack index. The stack is two byte-planes, grows down, and
0000                             ;            holds everything under TOS: NOS is DSL,X (low) and DSH,X (high).
0000                             ;            The stack never leaves its planes because X is 8 bits.
0000                             ;    S       the hardware stack is the RETURN stack: a word call or "(" pushes
0000                             ;            the reading position (high byte first, then low) and "]" or ")"
0000                             ;            pulls it. 100 entries (200 bytes) fit with room to spare.
0000                             ;    Y, A    scratch. Y is 0 after peek/getc, and the zero-page indirect reads
0000                             ;            (IP),Y rely on that.
0000                             ; 
0000                             ;  Dispatch: step is called with JSR, so a handler ends with a plain RTS and
0000                             ;  lands on "JMP next" in the loop. Punctuation goes through PTAB with the
0000                             ;  RTS trick (push handler-1, RTS). Handlers that use the return stack ( ( ) \
0000                             ;  ] 00bbIA== and word calls ) first pull the 2-byte JSR frame off (PLA PLA) and end
0000                             ;  with JMP next instead.
0000                             ;  The fast build (SPEED = 2) dispatches through a full table instead: see
0000                             ;  "The fast build" at the end.
0000                             ; 
0000                             ;  Every punctuation handler starts with the carry clear (the range sort in
0000                             ;  step leaves it so). Several of them count on that, where the comments say.
0000                             ; 
0000                             ;  Machine-code contract (the grave): the code at TOS is entered as a
0000                             ;  subroutine, by JMP (T0) with the loop's return address on the hardware
0000                             ;  stack, so it ends with RTS (60h, which the hex loader appends). On entry
0000                             ;  TL/TH ($02/$03) hold the new TOS (the address is already consumed) and X is
0000                             ;  the data-stack index: NOS is DSL,X (low) and DSH,X (high), which is
0000                             ;  $0200,X and $0300,X.
0000                             ;  To push: DEX, store TL/TH at DSL,X/DSH,X, then set TL/TH. To drop: load
0000                             ;  TL/TH from DSL,X/DSH,X and INX. The code may change A, Y, X (it is the
0000                             ;  stack index, so it must stay consistent on return) and zero page $04-$06
0000                             ;  and $08-$09; it must keep IP ($00/$01) and the hardware stack balanced. On
0000                             ;  return TL/TH are the TOS. Zero page $0A-$0F is free for the code's own use.
0000                             ; -----------------------------------------------------------------------------
0000                IP:       EQU   00h   ; 00-01 reading position
0000                TL:       EQU   02h   ; TOS low
0000                TH:       EQU   03h   ; TOS high
0000                T0:       EQU   04h   ; scratch
0000                T1:       EQU   05h   
0000                T2:       EQU   06h   
0000                D0:       EQU   08h   ; divisor (division, number printing)
0000                D1:       EQU   09h   
0000                SKL:      EQU   T1   ; (QK) 05 and 08: where a skip started, for
0000                SKH:      EQU   D0   ;   the skip cache
0000                V:        EQU   T0   ; (FAST) 04-05 the dispatcher's jump vector
0000                          IF   1-CHECKED   
                    KEYBUF:   EQU   07h   ; a key held back by the break check (0: none)
0000                          ENDIF      
0000                          IF   CHECKED   
0000                PLACE:    EQU   06h   ; 06-07 (T2 and $07) the address of the
0000                             ;   character being run, for the error report:
0000                             ;   no handler of the checked build uses T2.
0000                             ;   (Machine code may change T2: that matters
0000                             ;   only if it also leaves a stack overrun,
0000                             ;   whose report then shows a wrong place.)
0000                RSV:      EQU   LET+35h   ; S as it was before this character
0000                KEYBUF:   EQU   LET+7Ah   ; a key held back by the break check (0: none)
0000                             ; The error report runs after the program, so it may use the zero page that
0000                             ; machine code has ($0A-$0F):
0000                CL:       EQU   0Ah   ; 0A-0B where the reported line starts
0000                          ENDIF      
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map
0000                             ; 
0000                             ;    0000-00FF  zero page: the variables above
0000                             ;    0100-01FF  hardware stack = return stack, S starts at FF
0000                             ;    0200       DSL, data stack, low bytes (X = FC when empty: 252 cells)
0000                             ;    0300       DSH, data stack, high bytes
0000                             ;    0400       LET  letter cells: A..Z at +00..+33, a..z at +40..+73 (a word
0000                             ;               cell is 64 bytes below its variable), heap pointer at +7C,
0000                             ;               the -n? line buffer at +80..+FF. The checked build's cells
0000                             ;               are in the gaps: RSV at +35, PEND at +38, KEYBUF (the held
0000                             ;               key; $07 in the unchecked build) at +7A; and every build's:
0000                             ;               CDOWN at +79, BRKOFF (the break-off cell) at +7B.
0000                             ;    0500       PROG the program text, NUL-terminated; the heap follows
0000                             ;    DF00       CPAGE (QK builds only): the skip cache, at the heap limit
0000                             ;    E000       the interpreter (ROM). In the fast build its first two
0000                             ;               pages are the dispatch table, and start is at E200
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the page range LETPAGE..HEAPLIM-1.
0000                             ; -----------------------------------------------------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The Z flag must match A (it does
0000                             ;   if the routine ends with LDA / RTS).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                             ;   KEY and CONOUT must preserve X and Y.
0000                          IF   1-ANSI   
0000                             ; With ANSI = 0 the console escapes of "$" call these. All four must keep X;
0000                             ; they may change A, Y and the flags.
0000                CONCLS:   EQU   0FF0Ch   ; /{  clear the screen, the cursor to the top left
0000                CONEOL:   EQU   0FF0Fh   ; /}  clear from the cursor to the end of the line
0000                CONCUR:   EQU   0FF12h   ; /| and /`  show the cursor if the carry is set,
0000                             ;     hide it if the carry is clear
0000                CONAT:    EQU   0FF15h   ; /~  the cursor to row A, column Y, both
0000                             ;     counted from 0
0000                          ENDIF      
0000                DSL:      EQU   0200h   ; data stack, low bytes
0000                DSH:      EQU   0300h   ; data stack, high bytes
0000                DSE:      EQU   0FCh   ; X when the data stack is empty
0000                LETPAGE:   EQU   04h   
0000                LET:      EQU   LETPAGE*256   
0000                PROG:     EQU   0500h   ; where the loader puts the program text
0000                PROG1:    EQU   PROG+1   
0000                HEAPLIM:   EQU   0E0h-QK   ; the heap must stay below E000h (a page);
0000                             ;   below DF00h in the QK builds, where
0000                CPAGE:    EQU   HEAPLIM   ;   DF00h is the skip cache's page: the page
0000                             ;   at the heap limit, which the heap never reaches
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer (the heap top)
0000                CDOWN:    EQU   LET+79h   ; the break check's countdown (see pnext)
0000                BRKOFF:   EQU   LET+7Bh   ; the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                PEND:     EQU   LET+38h   ; checked: the program's end, where the heap
0000                             ;   starts: it may not be released below it
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSLIM:    EQU   20h   ; lowest S allowed (checked build)
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms; tune it
0000                             ;   (each pass calls KEY once; the wait for a
0000                             ;   second Ctrl-C uses it too: 250 ms)
0000                CWAIT:    EQU   250*MSLOOP/256   ; (that wait, in 256s)
0000                             ; The fast build's dispatcher (SPEED = 2; see "The fast build"), inline at
0000                             ; the end of its own entries. NEXTF reads the next character and jumps
0000                             ; through the table:
0000                             ;     LDY #0 / LDA (IP),Y / INC IP / BNE $+4 / INC IP+1 / TAY /
0000                             ;     LDA DTL,Y / STA V / LDA DTH,Y / STA V+1 / JMP (V)
0000                             ; NEXTA is the same from INC IP on: the character is already in A, and IP is
0000                             ; still at it (it skips the LDY and the LDA); NEXTY is the same with the
0000                             ; character in Y (it skips the TAY too). In the checked build all three are
0000                             ; JMP fnext, which checks the stacks first. (The bytes are written out with
0000                             ; DS, because asm80 does not nest an IF in a macro inside another IF; and
0000                             ; DS takes the addresses as these equates.)
0000                          IF   FAST   
                    ADTL:     EQU   DTL   
                    ADTH:     EQU   DTH   
                    AFNX:     EQU   fnext   
0000                          ENDIF      
0000                          IF   1-FAST   
0000                ADTL:     EQU   0   
0000                ADTH:     EQU   0   
0000                AFNX:     EQU   0   
0000                          ENDIF      
0000                .macro NEXTF,
0000                             ; 
0000                 DS      1-CHECKED,0A0h  ; LDY #0
0000                 DS      1-CHECKED,0
0000                 DS      1-CHECKED,0B1h  ; LDA (IP),Y
0000                 DS      1-CHECKED,IP
0000                 DS      1-CHECKED,0E6h  ; INC IP
0000                 DS      1-CHECKED,IP
0000                 DS      1-CHECKED,0D0h  ; BNE $+4
0000                 DS      1-CHECKED,2
0000                 DS      1-CHECKED,0E6h  ; INC IP+1
0000                 DS      1-CHECKED,IP+1
0000                 DS      1-CHECKED,0A8h  ; TAY
0000                 DS      1-CHECKED,0B9h  ; LDA DTL,Y
0000                 DS      1-CHECKED,ADTL&0FFh
0000                 DS      1-CHECKED,ADTL/256
0000                 DS      1-CHECKED,85h   ; STA V
0000                 DS      1-CHECKED,V
0000                 DS      1-CHECKED,0B9h  ; LDA DTH,Y
0000                 DS      1-CHECKED,ADTH&0FFh
0000                 DS      1-CHECKED,ADTH/256
0000                 DS      1-CHECKED,85h   ; STA V+1
0000                 DS      1-CHECKED,V+1
0000                 DS      1-CHECKED,6Ch   ; JMP (V)
0000                 DS      1-CHECKED,V
0000                 DS      1-CHECKED,0
0000                 DS      CHECKED,4Ch     ; JMP fnext (checked)
0000                 DS      CHECKED,AFNX&0FFh
0000                 DS      CHECKED,AFNX/256
0000                .endm
0000                 
0000                .macro NEXTA,
0000                             ; 
0000                 DS      1-CHECKED,0E6h  ; INC IP
0000                 DS      1-CHECKED,IP
0000                 DS      1-CHECKED,0D0h  ; BNE $+4
0000                 DS      1-CHECKED,2
0000                 DS      1-CHECKED,0E6h  ; INC IP+1
0000                 DS      1-CHECKED,IP+1
0000                 DS      1-CHECKED,0A8h  ; TAY
0000                 DS      1-CHECKED,0B9h  ; LDA DTL,Y
0000                 DS      1-CHECKED,ADTL&0FFh
0000                 DS      1-CHECKED,ADTL/256
0000                 DS      1-CHECKED,85h   ; STA V
0000                 DS      1-CHECKED,V
0000                 DS      1-CHECKED,0B9h  ; LDA DTH,Y
0000                 DS      1-CHECKED,ADTH&0FFh
0000                 DS      1-CHECKED,ADTH/256
0000                 DS      1-CHECKED,85h   ; STA V+1
0000                 DS      1-CHECKED,V+1
0000                 DS      1-CHECKED,6Ch   ; JMP (V)
0000                 DS      1-CHECKED,V
0000                 DS      1-CHECKED,0
0000                 DS      CHECKED,4Ch     ; JMP fnext (checked)
0000                 DS      CHECKED,AFNX&0FFh
0000                 DS      CHECKED,AFNX/256
0000                .endm
0000                 
0000                .macro NEXTY,
0000                             ; 
0000                 DS      1-CHECKED,0E6h  ; INC IP
0000                 DS      1-CHECKED,IP
0000                 DS      1-CHECKED,0D0h  ; BNE $+4
0000                 DS      1-CHECKED,2
0000                 DS      1-CHECKED,0E6h  ; INC IP+1
0000                 DS      1-CHECKED,IP+1
0000                 DS      1-CHECKED,0B9h  ; LDA DTL,Y
0000                 DS      1-CHECKED,ADTL&0FFh
0000                 DS      1-CHECKED,ADTL/256
0000                 DS      1-CHECKED,85h   ; STA V
0000                 DS      1-CHECKED,V
0000                 DS      1-CHECKED,0B9h  ; LDA DTH,Y
0000                 DS      1-CHECKED,ADTH&0FFh
0000                 DS      1-CHECKED,ADTH/256
0000                 DS      1-CHECKED,85h   ; STA V+1
0000                 DS      1-CHECKED,V+1
0000                 DS      1-CHECKED,6Ch   ; JMP (V)
0000                 DS      1-CHECKED,V
0000                 DS      1-CHECKED,0
0000                 DS      CHECKED,4Ch     ; JMP fnext (checked)
0000                 DS      CHECKED,AFNX&0FFh
0000                 DS      CHECKED,AFNX/256
0000                .endm
0000                 
0000                FTAB:     EQU   0E000h   ; (FAST: the fast build's table, two pages,
E000                          .ORG   FTAB+FAST*512   ;   comes first, and the code after it)
E000                             ; =============================================================================
E000                             ;  Startup: find the NUL, the heap starts after it
E000                             ; =============================================================================
E000   A2 FF        START:    LDX   #0FFh   
E002   9A                     TXS      ; return stack empty
E003                          IF   CHECKED   
E003                             ; The first half of the letter page is zeroed: every variable, every
E003                             ; cell of the interpreter's own (no key held back), and every word
E003                             ; cell, which then points at 0000h: calling an undefined word stops
E003                             ; with U (see e_undef).
E003   E8                     INX      
E004   8A                     TXA      ; A = 0
E005   A0 7F                  LDY   #7Fh   
E007   99 00 04     STZ:      STA   LET,Y   
E00A   88                     DEY      
E00B   10 FA                  BPL   stz   
E00D                          ENDIF      
E00D                          IF   QK   
E00D   A9 00                  LDA   #0   ; an empty skip cache (a start of 0000h
E00F   A8                     TAY      ;   matches no skip)
E010   99 00 DF     SKC:      STA   CPAGE*256,Y   
E013   C8                     INY      
E014   D0 FA                  BNE   skc   
E016                          ENDIF      
E016   20 40 E4               JSR   rstip   
E019   20 34 E4     ST1:      JSR   getc   
E01C   D0 FB                  BNE   st1   ; IP ends just past the NUL
E01E                          IF   1-CHECKED   
                              STA   KEYBUF   ; (A = 0) no key held, the break key on
                              STA   BRKOFF   
E01E                          ENDIF      
E01E   A5 00                  LDA   IP   
E020   8D 7C 04               STA   HEAP   
E023                          IF   CHECKED   
E023   8D 38 04               STA   PEND   
E026                          ENDIF      
E026   A5 01                  LDA   IP+1   
E028   8D 7D 04               STA   HEAP+1   
E02B                          IF   CHECKED   
E02B   8D 39 04               STA   PEND+1   
E02E                          ENDIF      
E02E   20 40 E4               JSR   rstip   
E031   A2 FC                  LDX   #DSE   
E033                             ; =============================================================================
E033                             ;  The inner loop
E033                             ; =============================================================================
E033                             ; -----------------------------------------------------------------------------
E033                             ;  The break key. A running program reads the keyboard only through getk
E033                             ;  (for "?") and pnext (the break check), which between them give the break
E033                             ;  key its rules:
E033                             ;    - Ctrl-C (03h) stops the program: silently to EXIT in the unchecked
E033                             ;      build, with the report (B) in the checked one;
E033                             ;    - any other key that the break check reads is held in KEYBUF for the
E033                             ;      next "?", and a newer one takes its place;
E033                             ;    - "?" (getk) takes the held key first;
E033                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
E033                             ;      key like any other, but two of them within about 250 ms still stop it.
E033                             ;  KEY is the host's: a waiting key in A, or A = 0 with the zero flag set.
E033                             ; -----------------------------------------------------------------------------
E033                             ; pnext: the break check, then (falling through) next. A word call, a true
E033                             ; "(" and a true ")" end here, but the keyboard is looked at only once in 256
E033                             ; of them: CDOWN counts them down. A key found is held; a Ctrl-C goes on to ctlc. (Startup
E033                             ; falls in here too, which does no harm.)
E033   CE 79 04     PNEXT:    DEC   CDOWN   
E036   D0 0B                  BNE   next   
E038   20 06 FF     PKEY:     JSR   KEY   
E03B   F0 06                  BEQ   next   ; no key
E03D   8D 7A 04               STA   KEYBUF   ; held for the next "?"
E040   20 D8 E0               JSR   chk3   ; (Ctrl-C: back only if the break key is off)
E043                NEXT:        
E043                          IF   FAST   
                              JMP   fnext   ; (the fast build: see "The fast build")
E043                          ENDIF      
E043                          IF   CHECKED*(1-FAST)   
E043                             ; Both stacks are checked once per character, after it has run. The
E043                             ; return stack has overrun when S is below RSLIM: an overflow leaves
E043                             ; it at 1Eh or 1Fh, an underflow wraps it to 01h (no handler pulls
E043                             ; more than one entry). The data stack has when X is above DSE: an
E043                             ; underflow moves X up to FDh or FEh (no handler moves X by more
E043                             ; than 2, but "$", whose /~ escapes each look first), and an
E043                             ; overflow wraps it from 00h to FFh.
E043                             ; S is kept in RSV, for the report's R: line (an error found inside
E043                             ; a handler has its own calls on the hardware stack), and the place
E043                             ; of the character about to run in PLACE.
E043   8A                     TXA      ; TSX trashes X: keep it in A
E044   BA                     TSX      
E045   8E 35 04               STX   RSV   
E048   E0 20                  CPX   #RSLIM   
E04A   AA                     TAX      ; TAX leaves the carry alone
E04B   90 12                  BCC   e_rstack   
E04D   E0 FD                  CPX   #DSE+1   
E04F   B0 20                  BCS   e_stack   
E051   A5 00                  LDA   IP   
E053   85 06                  STA   PLACE   
E055   A5 01                  LDA   IP+1   
E057   85 07                  STA   PLACE+1   
E059                          ENDIF      
E059                          IF   1-FAST   
E059   20 1E E1               JSR   step   
E05C   4C 43 E0               JMP   next   
E05F                          ENDIF      
E05F                          IF   CHECKED   
E05F                             ; S/R are overflows, s/r underflows. After an underflow that stack counts as
E05F                             ; empty.
E05F   AD 35 04     E_RSTACK:   LDA   RSV   
E062   C9 10                  CMP   #10h   
E064   A9 52                  LDA   #"R"   
E066   B0 13                  BCS   ejmp   ; S is 1Eh-1Fh: an overflow
E068   A9 FF                  LDA   #0FFh   
E06A   8D 35 04               STA   RSV   ; S wrapped to 01h: R:0
E06D   A9 72                  LDA   #"r"   
E06F   D0 0A                  BNE   ejmp   ; always
E071   E0 FF        E_STACK:   CPX   #0FFh   
E073   A9 53                  LDA   #"S"   
E075   B0 04                  BCS   ejmp   ; X wrapped from 00h to FFh: an overflow
E077   A2 FC                  LDX   #DSE   ; an underflow: D:0
E079   A9 73                  LDA   #"s"   
E07B   4C F4 E6     EJMP:     JMP   error   
E07E                          ENDIF      
E07E                             ; The handlers that work on the return stack sit here, where short branches
E07E                             ; reach next and pnext.
E07E                             ; "{" TOS to the return stack, "}" return stack to TOS
E07E   68           H_TOR:    PLA      
E07F   68                     PLA      
E080   A5 03                  LDA   TH   
E082   48                     PHA      
E083   A5 02                  LDA   TL   
E085   48                     PHA      
E086   20 71 E4               JSR   drop   
E089   D0 B8                  BNE   next   ; always
E08B   68           H_FROMR:   PLA      
E08C   68                     PLA      
E08D   20 82 E1               JSR   push   
E090   68                     PLA      
E091   85 02                  STA   TL   
E093   68                     PLA      
E094   85 03                  STA   TH   
E096   90 AB                  BCC   next   ; always: the carry is clear on the way in
E098                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
E098                             ; drops it and carries on. It shares "]"s code: with the carry clear, as
E098                             ; it is here, the address popped is pushed back.
E098   20 49 E4     H_CLOSE:   JSR   flag   
E09B   F0 22                  BEQ   rdrop   
E09D                          IF   1-QK   
                              DB   24h   ; (BIT zp: steps over the SEC)
E09D                          ENDIF      
E09D                          IF   QK   
E09D   4C 8E E1               JMP   closeq   ; (QK: see Speed-ups)
E0A0                          ENDIF      
E0A0                             ; "]" returns: pull an address and jump to it.
E0A0   38           H_RET:    SEC      
E0A1   68                     PLA      
E0A2   68                     PLA      ; drop the step frame
E0A3   68                     PLA      
E0A4   85 00                  STA   IP   
E0A6   68                     PLA      
E0A7   85 01                  STA   IP+1   
E0A9   B0 98                  BCS   next   
E0AB   48                     PHA      ; ")": keep the block start
E0AC   A5 00                  LDA   IP   
E0AE   48                     PHA      
E0AF   90 82                  BCC   pnext   ; always: a loop-back, with the break check
E0B1                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
E0B1                             ; drops the block start, "]" returns.
E0B1   20 49 E4     H_BREAK:   JSR   flag   
E0B4   F0 26                  BEQ   gk9   ; (an RTS)
E0B6                          IF   CHECKED   
E0B6   A9 00                  LDA   #0   ; \ takes either closer
E0B8                          ENDIF      
E0B8   20 F6 E1               JSR   skip   
E0BB   C9 29                  CMP   #")"   
E0BD   D0 E1                  BNE   h_ret   
E0BF   68           RDROP:    PLA      
E0C0   68                     PLA      
E0C1   68                     PLA      
E0C2   68                     PLA      ; (the block start's high byte: never 0)
E0C3                          IF   1-QK   
                              BNE   next   ; always
E0C3                          ENDIF      
E0C3                          IF   QK   
E0C3   4C 43 E0               JMP   next   ; (closeq moved next out of reach)
E0C6                          ENDIF      
E0C6                             ; getk: a key for "?" in A (zero flag clear), or A = 0 with the zero flag
E0C6                             ; set when there is none. Keeps X and Y. The held key goes first, and is
E0C6                             ; taken out of KEYBUF.
E0C6   AD 7A 04     GETK:     LDA   KEYBUF   
E0C9   F0 08                  BEQ   gk1   
E0CB   48                     PHA      
E0CC   A9 00                  LDA   #0   
E0CE   8D 7A 04               STA   KEYBUF   
E0D1   68                     PLA      
E0D2   60                     RTS      
E0D3   20 06 FF     GK1:      JSR   KEY   
E0D6   F0 04                  BEQ   gk9   
E0D8                             ; chk3: a key in A (not 0). A Ctrl-C goes on to ctlc, which gives the 03h
E0D8                             ; back if it comes back at all.
E0D8   C9 03        CHK3:     CMP   #3   
E0DA   F0 01                  BEQ   ctlc   
E0DC   60           GK9:      RTS      
E0DD                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
E0DD                             ; the program has turned it off, wait about 250 ms (about 250 times MSLOOP
E0DD                             ; looks: D0 counts the 256s, D1 runs on from whatever it holds) for one more
E0DD                             ; key: a second Ctrl-C is the end too; any other key is held (the newest
E0DD                             ; wins). Returns A = 03h with the zero flag clear. Keeps X and Y.
E0DD   AD 7B 04     CTLC:     LDA   BRKOFF   
E0E0   F0 1D                  BEQ   cbreak   
E0E2   A9 28                  LDA   #CWAIT+1   
E0E4   85 08                  STA   D0   
E0E6   20 06 FF     CT2:      JSR   KEY   
E0E9   D0 0A                  BNE   ct3   
E0EB   C6 09                  DEC   D1   
E0ED   D0 F7                  BNE   ct2   
E0EF   C6 08                  DEC   D0   
E0F1   D0 F3                  BNE   ct2   
E0F3   F0 07                  BEQ   ct9   ; always: none came
E0F5   C9 03        CT3:      CMP   #3   
E0F7   F0 06                  BEQ   cbreak   
E0F9   8D 7A 04               STA   KEYBUF   
E0FC   A9 03        CT9:      LDA   #3   
E0FE   60                     RTS      
E0FF                          IF   1-CHECKED   
                    CBREAK:   EQU   endprog   ; the unchecked build stops without a word
E0FF                          ENDIF      
E0FF                          IF   CHECKED   
E0FF                CBREAK:   EQU   e_break   ; the checked build reports B
E0FF                          ENDIF      
E0FF                          IF   CHECKED   
E0FF   A9 42        E_BREAK:   LDA   #"B"   ; Ctrl-C (the stacks as they stand)
E101   2C                     DB   2Ch   
E102   A9 58        E_RESV:   LDA   #"X"   ; a reserved byte, 80h-FFh
E104   4C F4 E6     EJMP3:    JMP   error   
E107                          ENDIF      
E107                          IF   CHECKED   
E107                             ; e_undef: the word cells of undefined words hold 0000h. A call there reads
E107                             ; the byte at 0000h, which is IP's own low byte: 00h while IP is 0000h, so
E107                             ; the call reads a NUL with IP in page zero, where no program can be. The
E107                             ; call is undone first: the step frame and the return address come off the
E107                             ; hardware stack, and the place is the call letter (the return address - 1).
E107   68           E_UNDEF:   PLA      
E108   68                     PLA      ; the step frame
E109   68                     PLA      
E10A   38                     SEC      
E10B   E9 01                  SBC   #1   
E10D   85 06                  STA   PLACE   
E10F   68                     PLA      
E110   E9 00                  SBC   #0   
E112   85 07                  STA   PLACE+1   
E114   EE 35 04               INC   RSV   
E117   EE 35 04               INC   RSV   ; R: does not count the call
E11A   A9 55                  LDA   #"U"   
E11C   D0 E6                  BNE   ejmp3   ; always
E11E                          ENDIF      
E11E                             ; step: read one character and sort it by range.
E11E                             ;    00h          end of program
E11E                             ;    01h-20h, 7Fh-FFh   ignored
E11E                             ;    30h-39h      digit: read a whole number
E11E                             ;    41h-5Ah      A-Z: call the word in that letter's cell
E11E                             ;    61h-7Ah      a-z: push the address of that letter's cell
E11E                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
E11E                             ; Every way out of the sort has the carry clear, except "ignored". A checked
E11E                             ; build stops on 80h-FFh (X) and still ignores DEL.
E11E   20 34 E4     STEP:     JSR   getc   ; flags follow A
E121   F0 38                  BEQ   endprog   
E123   38                     SEC      
E124   E9 21                  SBC   #21h   ; A = c - 21h
E126   90 32                  BCC   ign   ; 01h-20h
E128   C9 0F                  CMP   #0Fh   
E12A   90 24                  BCC   punct   ; 21h-2Fh: index 0-14
E12C   E9 0F                  SBC   #0Fh   ; (carry set) A = c - 30h
E12E   C9 0A                  CMP   #10   
E130   90 35                  BCC   digit   
E132   C9 11                  CMP   #11h   
E134   90 18                  BCC   p3a   ; 3Ah-40h
E136   E9 11                  SBC   #11h   ; (carry set) A = c - 41h
E138   C9 1A                  CMP   #1Ah   
E13A   90 26                  BCC   upper   ; 41h-5Ah
E13C   C9 20                  CMP   #20h   
E13E   90 0C                  BCC   p5b   ; 5Bh-60h
E140   C9 3A                  CMP   #3Ah   
E142                          IF   1-SBASEU   
E142   90 2B                  BCC   lower   ; 61h-7Ah: A = 20h-39h
E144                          ENDIF      
E144                          IF   SBASEU   
                              BCC   lowq   ; 61h-7Ah: A = 20h-39h
E144                          ENDIF      
E144   C9 3E                  CMP   #3Eh   
E146                          IF   1-CHECKED   
                              BCS   ign   ; 7Fh-FFh
E146                          ENDIF      
E146                          IF   CHECKED   
E146   F0 12                  BEQ   ign   ; 7Fh
E148   B0 B8                  BCS   e_resv   ; 80h-FFh: reserved
E14A                          ENDIF      
E14A                             ; The three adjustments below chain. Each ADC adds the carry the one
E14A                             ; before it left, which the constants allow for.
E14A   E9 1A                  SBC   #1Ah   ; 7Bh-7Eh: (carry clear: -1Bh) index 28-31
E14C   69 F6        P5B:      ADC   #0F6h   ; 5Bh-60h: -10 (-9 when chained), index 22-27
E14E   69 05        P3A:      ADC   #5   ; 3Ah-40h: +5 (+6 when chained), index 15-21
E150   0A           PUNCT:    ASL      ; (the index is small: the carry stays clear)
E151   A8                     TAY      
E152   B9 AA E3               LDA   PTAB+1,Y   
E155   48                     PHA      
E156   B9 A9 E3               LDA   PTAB,Y   
E159   48                     PHA      
E15A   60           IGN:      RTS      ; RTS trick: goes to the handler. Reached
E15B                             ; directly, it just ends an ignored character.
E15B                ENDPROG:      
E15B                          IF   CHECKED   
E15B   A5 01                  LDA   IP+1   ; IP in page zero: an undefined word
E15D   F0 A8                  BEQ   e_undef   
E15F                          ENDIF      
E15F   4C 09 FF               JMP   EXIT   
E162                             ; A-Z: call the word. The return address (the IP after the letter) goes on
E162                             ; the return stack, and the IP becomes the address in the letter's cell.
E162   0A           UPPER:    ASL      
E163   A8                     TAY      
E164   38                     SEC      
E165   B0 44                  BCS   pushn   ; always
E167                             ; Digits: the first one is in A; read the rest of the number.
E167   A0 00        DIGIT:    LDY   #0   
E169   20 78 E1               JSR   pushay   
E16C   4C 0E E4               JMP   rdnum   
E16F                             ; a-z: push the cell's address (the cell is the variable)
E16F   0A           LOWER:    ASL      
E170   A0 04                  LDY   #>LET   
E172   D0 04                  BNE   pushay   ; always
E174   A5 00        PUSHIP:   LDA   IP   ; push the reading position
E176   A4 01                  LDY   IP+1   
E178                             ; pushay: push a cell: A = its low byte, Y = its high byte
E178   48           PUSHAY:   PHA      
E179   20 82 E1               JSR   push   
E17C   68                     PLA      
E17D   85 02                  STA   TL   
E17F   84 03                  STY   TH   
E181   60                     RTS      
E182   CA           PUSH:     DEX      ; ":" and every push (keeps Y)
E183   A5 02                  LDA   TL   
E185   9D 00 02               STA   DSL,X   
E188   A5 03                  LDA   TH   
E18A   9D 00 03               STA   DSH,X   
E18D   60                     RTS      
E18E                          IF   SBASEU   
                                 ; a-z, in the unchecked QK builds: a variable followed by "@" or "!" is
                                 ; fetched or stored in the same step (x@ is the commonest pair in most
                                 ; programs). A checked build checks the stacks between the two, so it keeps
                                 ; them apart. (pvar calls lower, which only pushes.)
                    LOWQ:     ASL      
                              STA   T0   ; the cell's offset in the letter page
                              LDY   #0   
                              LDA   (IP),Y   
                              CMP   #"@"   
                              BEQ   lwf   
                              CMP   #"!"   
                              BEQ   lws   
                              LDA   T0   
                              LDY   #>LET   
                              BNE   pushay   ; always: the address
                    LWF:      JSR   incip   ; x@: TOS = the cell's value
                              JSR   push   
                              LDY   T0   
                              LDA   LET,Y   
                              STA   TL   
                              LDA   LET+1,Y   
                              STA   TH   
                              RTS      
                    LWS:      JSR   incip   ; x!: the cell = TOS, and NOS comes up
                              LDY   T0   
                              LDA   TL   
                              STA   LET,Y   
                              LDA   TH   
                              STA   LET+1,Y   
                              JMP   drop   
E18E                          ENDIF      
E18E                          IF   QK   
E18E                             ;  ---- Speed-ups (QK builds) ---------------------------------------------
E18E                             ;  The skip cache and the faster skip are at skip, "*" at h_mul and "/" at
E18E                             ;  udiv; x@ and x! (unchecked) at lowq, above.
E18E                             ; A true ")" reads the block start where it is, under the step frame,
E18E                             ; instead of popping it and pushing it back. The break key is looked at as
E18E                             ; pnext would.
E18E   8A           CLOSEQ:   TXA      ; (TSX trashes X)
E18F   BA                     TSX      
E190   BC 03 01               LDY   103h,X   
E193   84 00                  STY   IP   
E195   BC 04 01               LDY   104h,X   
E198   84 01                  STY   IP+1   
E19A   AA                     TAX      
E19B   CE 79 04               DEC   CDOWN   
E19E   F0 01                  BEQ   cq1   
E1A0   60                     RTS      ; into the loop
E1A1   68           CQ1:      PLA      
E1A2   68                     PLA      ; the step frame
E1A3   4C 38 E0               JMP   pkey   
E1A6                          ENDIF      
E1A6                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
E1A6                             ; the matching ")".
E1A6   20 49 E4     H_OPEN:   JSR   flag   ; (keeps the carry clear)
E1A9                          IF   1-CHECKED   
                              BEQ   skip   
E1A9                          ENDIF      
E1A9                          IF   CHECKED   
E1A9   F0 26                  BEQ   skpar   
E1AB                          ENDIF      
E1AB                             ; pushn: take the step frame off, push the reading position on the return
E1AB                             ; stack, and go on. With the carry set (a word call) the reading position
E1AB                             ; then becomes the address in the letter cell at LET,Y.
E1AB   68           PUSHN:    PLA      
E1AC   68                     PLA      ; drop the step frame
E1AD   A5 01                  LDA   IP+1   
E1AF   48                     PHA      
E1B0   A5 00                  LDA   IP   
E1B2   48                     PHA      
E1B3   90 0A                  BCC   nxt   
E1B5   B9 00 04               LDA   LET,Y   
E1B8   85 00                  STA   IP   
E1BA   B9 01 04               LDA   LET+1,Y   
E1BD   85 01                  STA   IP+1   
E1BF   4C 33 E0     NXT:      JMP   pnext   
E1C2                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
E1C2                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
E1C2                             ; the body"s address instead. Either way it then skips to the matching "]'.
E1C2                             ; (The unchecked build takes anything that is not a letter as the space; the
E1C2                             ; checked build stops on it.)
E1C2                          IF   CHECKED   
E1C2   C0 DF        DEF1:     CPY   #" "-"A"+256   
E1C4   F0 2B                  BEQ   def2   
E1C6                             ; W: anything but a letter or a space after [. The place is that character,
E1C6                             ; one past the [.
E1C6   E6 06                  INC   PLACE   
E1C8   D0 02                  BNE   eb1   
E1CA   E6 07                  INC   PLACE+1   
E1CC   A9 57        EB1:      LDA   #"W"   
E1CE                          ENDIF      
E1CE                          IF   CHECKED*(1-QK)   
                              BNE   ejmp2   ; always
E1CE                          ENDIF      
E1CE                          IF   CHECKED*QK   
E1CE   4C F4 E6               JMP   error   ; (the skip cache moved ejmp2 out of reach)
E1D1                          ENDIF      
E1D1                          IF   CHECKED   
E1D1                             ; A false ( skips: the wrong closer for it is ].
E1D1   A9 5D        SKPAR:    LDA   #"]"   
E1D3   D0 21                  BNE   skip   ; always
E1D5                          ENDIF      
E1D5   20 34 E4     H_DEF:    JSR   getc   
E1D8   38                     SEC      
E1D9   E9 41                  SBC   #"A"   ; a letter gives 0-25 or 32-57: lowercase
E1DB   A8                     TAY      ;   lands 64 bytes up
E1DC   29 DF                  AND   #0DFh   ; fold case: 0-25 only for a letter
E1DE   C9 1A                  CMP   #26   
E1E0                          IF   1-CHECKED   
                              BCS   def2   ; not a letter
E1E0                          ENDIF      
E1E0                          IF   CHECKED   
E1E0   B0 E0                  BCS   def1   
E1E2                          ENDIF      
E1E2   98                     TYA      
E1E3   0A                     ASL      
E1E4   A8                     TAY      ; Y -> the cell
E1E5   A5 00                  LDA   IP   
E1E7   99 00 04               STA   LET,Y   
E1EA   A5 01                  LDA   IP+1   
E1EC   99 01 04               STA   LET+1,Y   
E1EF   D0 03                  BNE   skdef   ; always: no program is in page zero
E1F1   20 74 E1     DEF2:     JSR   puship   ; an anonymous block: push its address
E1F4                SKDEF:       
E1F4                          IF   CHECKED   
E1F4   A9 29                  LDA   #")"   ; the wrong closer for [
E1F6                          ENDIF      
E1F6                             ; skip: read past text to the closer at this level, and return it in A.
E1F6                             ; Brackets of both kinds count together; strings are stepped over whole. A
E1F6                             ; NUL first ends the program.
E1F6                             ; In the checked build A holds, on the way in, the wrong closer for the
E1F6                             ; opener that started the skip, kept in T0: ] for (, ) for [, and 0 for \,
E1F6                             ; which takes either. Meeting the wrong closer at this level, or the end
E1F6                             ; (a NUL, or a string that runs into it), stops with N, except for \,
E1F6                             ; which then ends the program as before.
E1F6                SKIP:        
E1F6                          IF   CHECKED   
E1F6   85 04                  STA   T0   
E1F8                          ENDIF      
E1F8                          IF   1-QK   
                              LDA   #0   
                              STA   D1   ; depth
                    SK1:      JSR   getc   
E1F8                          ENDIF      
E1F8                          IF   (1-QK)*(1-CHECKED)   
                              BEQ   endprog   
E1F8                          ENDIF      
E1F8                          IF   (1-QK)*CHECKED   
                              BEQ   sknul   
E1F8                          ENDIF      
E1F8                          IF   1-QK   
                              CMP   #22h   
                              BNE   sk2   
                              JSR   skipstr   ; leaves A = 22h (11h when checked), which
                                 ;   matches nothing below
E1F8                          ENDIF      
E1F8                          IF   (1-QK)*CHECKED   
                              BEQ   sknul   ; the string ran into the end
E1F8                          ENDIF      
E1F8                          IF   1-QK   
                    SK2:      CMP   #"("   
                              BEQ   sk3   
                              CMP   #"["   
                              BEQ   sk3   
                              CMP   #")"   
                              BEQ   sk4   
                              CMP   #"]"   
                              BNE   sk1   
                    SK4:      DEC   D1   
                              BPL   sk1   
E1F8                          ENDIF      
E1F8                          IF   (1-QK)*CHECKED   
                              CMP   T0   
                              BEQ   e_nest   ; the wrong kind
E1F8                          ENDIF      
E1F8                          IF   1-QK   
                              RTS      ; the closer at this level
                    SK3:      INC   D1   
                              BNE   sk1   
E1F8                          ENDIF      
E1F8                          IF   QK   
E1F8                             ; The skip cache (QK builds). Nearly every skip is one that has happened
E1F8                             ; before (a loop skips the same false block on every pass), so the first
E1F8                             ; scan from each place is remembered: 64 entries of {start, the closer's
E1F8                             ; address}, in CPAGE, found by the start's low byte times 4. Only skips that
E1F8                             ; start in the program text are kept (the line buffer changes); the cache is
E1F8                             ; emptied when the program starts. A program that changes its own text while
E1F8                             ; it runs is not looked after.
E1F8   A5 01                  LDA   IP+1   
E1FA   C9 05                  CMP   #>PROG   
E1FC   90 24                  BCC   sks   ; below the program text: no cache
E1FE   A5 00                  LDA   IP   
E200   0A                     ASL      
E201   0A                     ASL      
E202   A8                     TAY      ; Y -> the entry
E203   A5 00                  LDA   IP   
E205   D9 00 DF               CMP   CPAGE*256,Y   
E208   D0 18                  BNE   sks   
E20A   A5 01                  LDA   IP+1   
E20C   D9 01 DF               CMP   CPAGE*256+1,Y   
E20F   D0 11                  BNE   sks   
E211   B9 02 DF               LDA   CPAGE*256+2,Y   ; a hit: the IP goes to the closer, which is
E214   85 00                  STA   IP   ;   read
E216   B9 03 DF               LDA   CPAGE*256+3,Y   
E219   85 01                  STA   IP+1   
E21B   A0 00                  LDY   #0   
E21D   B1 00                  LDA   (IP),Y   
E21F   4C 37 E4               JMP   incip   
E222   A5 00        SKS:      LDA   IP   
E224   85 05                  STA   SKL   
E226   A5 01                  LDA   IP+1   
E228   85 08                  STA   SKH   
E22A   A0 00                  LDY   #0   
E22C   84 09                  STY   D1   ; depth
E22E                             ; The scan reads at IP+Y. Most characters are nothing to it, and two range
E22E                             ; tests rule them out: * to Z, and ^ and up. Only NUL " ( ) [ ] count.
E22E   B1 00        SQ1:      LDA   (IP),Y   
E230   C8                     INY      
E231   F0 1D                  BEQ   sqw   
E233   C9 5E        SQ2:      CMP   #5Eh   
E235   B0 F7                  BCS   sq1   ; ^ _ ` a-z 00bbIHwg ~ and up: nothing
E237   C9 5B                  CMP   #5Bh   
E239   B0 2A                  BCS   sqb   ; [ \ ]
E23B   C9 2A                  CMP   #2Ah   
E23D   B0 EF                  BCS   sq1   ; * to Z: nothing
E23F   C9 28                  CMP   #28h   
E241   F0 1D                  BEQ   sqo   ; (
E243   B0 26                  BCS   sqc   ; )
E245   C9 22                  CMP   #22h   
E247   F0 0B                  BEQ   sqq   ; a string
E249   C9 01                  CMP   #1   
E24B   B0 E1                  BCS   sq1   ; the rest below "(": nothing
E24D                          ENDIF      
E24D                          IF   QK*(1-CHECKED)   
                              JMP   EXIT   ; NUL: the end of the program
E24D                          ENDIF      
E24D                          IF   QK*CHECKED   
E24D   4C AA E2               JMP   sknul   
E250                          ENDIF      
E250                          IF   QK   
E250   E6 01        SQW:      INC   IP+1   ; Y went round: on into the next page
E252   D0 DF                  BNE   sq2   ; always
E254   20 9D E2     SQQ:      JSR   sqip   ; a string: step over it
E257   20 D0 E2               JSR   skipstr   
E25A                          ENDIF      
E25A                          IF   QK*CHECKED   
E25A   F0 4E                  BEQ   sknul   ; the string ran into the end
E25C                          ENDIF      
E25C                          IF   QK   
E25C   A0 00                  LDY   #0   
E25E   F0 CE                  BEQ   sq1   ; always
E260   E6 09        SQO:      INC   D1   ; an opener
E262   4C 2E E2               JMP   sq1   
E265   C9 5C        SQB:      CMP   #5Ch   
E267   F0 C5                  BEQ   sq1   ; "\" is nothing here
E269   90 F5                  BCC   sqo   ; [
E26B   C6 09        SQC:      DEC   D1   ; ) ]
E26D   10 BF                  BPL   sq1   
E26F   20 9D E2               JSR   sqip   ; the closer at this level: the IP past it
E272                          ENDIF      
E272                          IF   QK*CHECKED   
E272   C5 04                  CMP   T0   
E274   F0 4C                  BEQ   e_nest   ; the wrong kind
E276                          ENDIF      
E276                          IF   QK   
E276   48                     PHA      
E277   A5 08                  LDA   SKH   ; remember the skip, if it started in the
E279   C9 05                  CMP   #>PROG   ;   program text
E27B   90 1E                  BCC   sq9   
E27D   A5 05                  LDA   SKL   
E27F   0A                     ASL      
E280   0A                     ASL      
E281   A8                     TAY      
E282   A5 05                  LDA   SKL   
E284   99 00 DF               STA   CPAGE*256,Y   
E287   A5 08                  LDA   SKH   
E289   99 01 DF               STA   CPAGE*256+1,Y   
E28C   A5 00                  LDA   IP   
E28E   38                     SEC      
E28F   E9 01                  SBC   #1   
E291   99 02 DF               STA   CPAGE*256+2,Y   ; the closer's address
E294   A5 01                  LDA   IP+1   
E296   E9 00                  SBC   #0   
E298   99 03 DF               STA   CPAGE*256+3,Y   
E29B   68           SQ9:      PLA      
E29C   60                     RTS      ; the closer at this level
E29D                             ; sqip: IP = IP + Y. Keeps A.
E29D   48           SQIP:     PHA      
E29E   98                     TYA      
E29F   18                     CLC      
E2A0   65 00                  ADC   IP   
E2A2   85 00                  STA   IP   
E2A4   90 02                  BCC   sp1   
E2A6   E6 01                  INC   IP+1   
E2A8   68           SP1:      PLA      
E2A9   60                     RTS      
E2AA                          ENDIF      
E2AA                          IF   CHECKED   
E2AA   A5 04        SKNUL:    LDA   T0   
E2AC   D0 14                  BNE   e_nest   ; ( and [ stop with N
E2AE   4C 09 FF               JMP   EXIT   ; \ ends the program
E2B1                             ; The end of "$" (h_print): the string's address goes back into TOS; then a
E2B1                             ; closing quote drops it, and a NUL (the carry clear) is Q.
E2B1   68           PQ:       PLA      
E2B2   85 02                  STA   TL   
E2B4   68                     PLA      
E2B5   85 03                  STA   TH   
E2B7   B0 5D                  BCS   pdrop   
E2B9   E0 FC                  CPX   #DSE   ; a NUL: Q, unless "$" had nothing on the
E2BB   A9 73                  LDA   #"s"   ;   stack at all (X at the empty mark): s
E2BD   B0 05                  BCS   ejmp2   
E2BF   A9 51        E_QUOTE:   LDA   #"Q"   ; a string runs into the end
E2C1   2C                     DB   2Ch   ; (BIT abs: hides the next instruction)
E2C2   A9 4E        E_NEST:   LDA   #"N"   ; a skip from ( or [ found the wrong closer
E2C4   4C F4 E6     EJMP2:    JMP   error   ;   or the end: the place is the opener
E2C7                          ENDIF      
E2C7                             ; 22h pushes the address of the text after it and skips the string.
E2C7   20 74 E1     H_STR:    JSR   puship   
E2CA                          IF   CHECKED   
E2CA   20 D0 E2               JSR   skipstr   
E2CD   F0 F0                  BEQ   e_quote   ; it ran into the end: the place is the 22h
E2CF   60                     RTS      
E2D0                          ENDIF      
E2D0                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
E2D0                             ; the next character, so "/"" does not end it.
E2D0                             ; Unchecked, it returns with Z set and A = 22h, and it does not look for the
E2D0                             ; end. Checked, it returns with Z clear and A = 11h, or with Z set if the
E2D0                             ; text ended first (a NUL, also one just after "/").
E2D0                          IF   1-CHECKED   
                    SKIPSTR:   JSR   getc   
                              CMP   #"/"   
                              BEQ   ss0   
                              CMP   #22h   
                              BNE   skipstr   
                              RTS      
                    SS0:      JSR   incip   
                              BNE   skipstr   ; A is "/" here
E2D0                          ENDIF      
E2D0                          IF   CHECKED   
E2D0   20 34 E4     SKIPSTR:   JSR   getc   
E2D3   F0 09                  BEQ   ss9   ; the end
E2D5   C9 2F                  CMP   #"/"   
E2D7   D0 06                  BNE   ss1   
E2D9   20 34 E4               JSR   getc   ; the escaped character
E2DC   D0 F2                  BNE   skipstr   
E2DE   60           SS9:      RTS      ; the end, just after "/"
E2DF   C9 22        SS1:      CMP   #22h   
E2E1   D0 ED                  BNE   skipstr   
E2E3   4A                     LSR      ; A = 11h, Z clear
E2E4   60                     RTS      
E2E5                          ENDIF      
E2E5                             ; =============================================================================
E2E5                             ;  Console
E2E5                             ; =============================================================================
E2E5                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
E2E5                             ; 60h to 7Eh is one of the escapes at pesc; "/" plus any other character
E2E5                             ; clears that character"s bit 6 (/M is CR, /? is DEL"s "?"; "/" and """ have
E2E5                             ; no bit 6, so // and /" give themselves). TOS walks along the string; the
E2E5                             ; checked build keeps the address on the hardware stack meanwhile, for a Q
E2E5                             ; report (see pq).
E2E5                          IF   CHECKED   
E2E5   A5 03        H_PRINT:   LDA   TH   
E2E7   48                     PHA      
E2E8   A5 02                  LDA   TL   
E2EA   48                     PHA      
E2EB   90 03                  BCC   pr0   ; always: the carry is clear on the way in
E2ED                          ENDIF      
E2ED                          IF   1-CHECKED   
                    H_PRINT:   EQU   pr0   
E2ED                          ENDIF      
E2ED   20 24 E3     PESC0:    JSR   pesc   ; (an escape, and back into the loop)
E2F0   20 19 E3     PR0:      JSR   tosget   
E2F3   C9 22                  CMP   #22h   
E2F5                          IF   1-CHECKED   
                              BEQ   pdrop   
E2F5                          ENDIF      
E2F5                          IF   CHECKED   
E2F5   F0 BA                  BEQ   pq   ; the closing quote, with the carry set
E2F7   A8                     TAY      ; (Y is free here)
E2F8   F0 B7                  BEQ   pq   ; a NUL, with the carry clear
E2FA                          ENDIF      
E2FA   C9 2F                  CMP   #"/"   
E2FC   D0 0D                  BNE   pr1   
E2FE   20 19 E3               JSR   tosget   
E301   C9 60                  CMP   #60h   
E303   90 04                  BCC   pr2   
E305   C9 7F                  CMP   #7Fh   
E307   90 E4                  BCC   pesc0   ; 60h-7Eh, and the carry is clear
E309   29 BF        PR2:      AND   #0BFh   
E30B   20 03 FF     PR1:      JSR   CONOUT   
E30E   4C F0 E2               JMP   pr0   
E311   A5 02        H_EMIT:   LDA   TL   ; "'"
E313   20 03 FF               JSR   CONOUT   
E316   4C 71 E4     PDROP:    JMP   drop   
E319                             ; tosget: A = the byte at TOS, and TOS moves on.  inctos: TOS moves on.
E319   A0 00        TOSGET:   LDY   #0   
E31B   B1 02                  LDA   (TL),Y   
E31D   E6 02        INCTOS:   INC   TL   
E31F   D0 02                  BNE   tg1   
E321   E6 03                  INC   TH   
E323   60           TG1:      RTS      
E324                             ; pesc: the escapes of "$". A = the character after the "/", 60h to 7Eh, and
E324                             ; the carry is clear. Each returns into the loop.
E324                             ;    /a-/z   print the variable, as "#" does
E324                             ;    /{      clear the screen, the cursor to the top left
E324                             ;    /}      clear from the cursor to the end of the line
E324                             ;    /|  /`  show the cursor, hide it
E324                             ;    /~      ( row col addr -- addr ): the cursor to that row and column,
E324                             ;            from 0. The two cells under TOS (the string's address) go.
E324                             ; A - 7Bh sorts them: 00bbIDAsIHwgMSwg 2, ~ 3 with the carry set, and ` E5h, a-z
E324                             ; E6h-FFh with it clear.
E324                          IF   1-ANSI   
E324                             ; With ANSI = 0 the machine's routines do the work.
E324   E9 7A        PESC:     SBC   #7Ah   ; (the carry is clear: - 7Bh)
E326   90 0D                  BCC   pe1   
E328   F0 08                  BEQ   pcls   ; {
E32A   4A                     LSR      ; | 0, } 1, ~ 1; the carry set for | and ~
E32B   F0 0C                  BEQ   pcur   ; |  show: the carry is set
E32D   B0 0D                  BCS   pat   ; ~
E32F   4C 0F FF               JMP   CONEOL   ; }
E332   4C 0C FF     PCLS:     JMP   CONCLS   
E335   C9 E6        PE1:      CMP   #0E6h   
E337   B0 15                  BCS   pvar   
E339   4C 12 FF     PCUR:     JMP   CONCUR   ; `  hide: the carry is clear
E33C                          ENDIF      
E33C                             ; /~: the column is NOS, the row the cell under it.
E33C                PAT:         
E33C                          IF   CHECKED   
E33C   E0 FA                  CPX   #DSE-2   ; fewer than two cells under TOS: s
E33E   B0 0B                  BCS   e_atu   
E340                          ENDIF      
E340                          IF   1-ANSI   
E340   BC 00 02               LDY   DSL,X   ; the column
E343   BD 01 02               LDA   DSL+1,X   ; the row
E346   E8                     INX      
E347   E8                     INX      
E348   4C 15 FF               JMP   CONAT   
E34B                          ENDIF      
E34B                          IF   ANSI   
                                 ; ESC [ row+1 ; col+1 H (ANSI counts from 1). The row's cell and TOS change
                                 ; places first: then "#" prints the row and drops it, prints the column and
                                 ; drops it, and TOS is the string's address again.
                              INX      
                              JSR   h_swap   
                              DEX      
                              LDY   #M_CSI-MSG   
                              JSR   prs   ; ESC [
                              JSR   inctos   
                              JSR   h_num   ; the row + 1
                              LDA   #";"   
                              JSR   CONOUT   
                              JSR   inctos   
                              JSR   h_num   ; the column + 1
                              LDA   #"H"   
                              JMP   CONOUT   
E34B                          ENDIF      
E34B                          IF   CHECKED   
E34B   4C 71 E0     E_ATU:    JMP   e_stack   ; (X is FAh-FCh: an underflow)
E34E                          ENDIF      
E34E                             ; a-z: the carry is set. A + 3Ah is the letter - 41h, as step hands it to
E34E                             ; lower: that pushes the variable"s address, "@" fetches it, and "#' (next)
E34E                             ; prints it and drops it: TOS is the string's address again.
E34E   69 39        PVAR:     ADC   #39h   
E350   20 6F E1               JSR   lower   
E353   20 52 E6               JSR   h_fetch   
E356                             ; "#" prints TOS as a signed decimal number, with no space after it. The
E356                             ; digits are divided off and held on the hardware stack, ended by a 0.
E356   A5 03        H_NUM:    LDA   TH   
E358   10 08                  BPL   pn1   
E35A   A9 2D                  LDA   #"-"   
E35C   20 03 FF               JSR   CONOUT   
E35F   20 CD E4               JSR   neg   
E362   A9 0A        PN1:      LDA   #10   
E364   85 08                  STA   D0   
E366   A9 00                  LDA   #0   
E368   85 09                  STA   D1   
E36A   48                     PHA      ; the end marker
E36B   20 E8 E5     PN2:      JSR   udiv   
E36E   A5 04                  LDA   T0   ; the remainder
E370   09 30                  ORA   #"0"   
E372   48                     PHA      
E373   A5 02                  LDA   TL   
E375   05 03                  ORA   TH   
E377   D0 F2                  BNE   pn2   
E379   68           PN3:      PLA      
E37A   F0 9A                  BEQ   pdrop   
E37C   20 03 FF               JSR   CONOUT   
E37F   4C 79 E3               JMP   pn3   
E382                          IF   ANSI   
                                 ; With ANSI = 1 they are sequences, each a message at MSG, printed by prs,
                                 ; which pesc runs on into. (It sits here, just above prs, for that.)
                    PESC:     SBC   #7Ah   ; (the carry is clear: - 7Bh). Y is 0, as
                                 ;   tosget leaves it, and M_CLS is the first
                                 ;   message: Y already points at it
                              BCC   pe1   
                              BEQ   prs   ; {  ESC [ H ESC [ J
                              LDY   #M_SHOW-MSG   
                              LSR      ; | 0, } 1, ~ 1; the carry set for ~
                              BEQ   prs   ; |  ESC [ ? 2 5 h
                              BCS   pat   ; ~
                              LDY   #M_EOL-MSG   ; }  ESC [ K
                              BNE   prs   ; always
                    PE1:      CMP   #0E6h   
                              BCS   pvar   
                              LDY   #M_HIDE-MSG   ; `  ESC [ ? 2 5 l, and on into prs
E382                          ENDIF      
E382                          IF   CHECKED+ANSI   
E382                             ; prs: print the message at MSG+Y; its last byte has bit 7 set. Y ends just
E382                             ; past it, at the next message.
E382   B9 90 E3     PRS:      LDA   MSG,Y   
E385   48                     PHA      
E386   29 7F                  AND   #7Fh   
E388   20 03 FF               JSR   CONOUT   
E38B   C8                     INY      
E38C   68                     PLA      
E38D   10 F3                  BPL   prs   
E38F   60                     RTS      
E390                MSG:         
E390                          ENDIF      
E390                          IF   ANSI   
                    M_CLS:    DB   27,"[","H",27,"[","J"+80h   ; (the first: pesc counts on it)
                    M_SHOW:   DB   27,"[","?","2","5","h"+80h   
                    M_HIDE:   DB   27,"[","?","2","5","l"+80h   
                    M_EOL:    DB   27,"[","K"+80h   
                    M_CSI:    DB   27,"["+80h   
E390                          ENDIF      
E390                          IF   CHECKED   
E390   0D 0A 45 72 72 A0 M_ERR:   DB   13,10,"Err"," "+80h   
E396   20 40 A0               DB   " @"," "+80h   
E399   0D 8A        M_NL:     DB   13,10+80h   
E39B   0D 0A 44 BA  M_STK:    DB   13,10,"D",":"+80h   
E39F   3A 20 2E 2E AE M_CD:   DB   ": ..","."+80h   
E3A4   BA           M_C:      DB   ":"+80h   
E3A5   0D 0A 52 BA  M_RTN:    DB   13,10,"R",":"+80h   
E3A9                          ENDIF      
E3A9                             ; =============================================================================
E3A9                             ;  Dispatch table: one handler per punctuation character, in code order.
E3A9                             ;  Entries are handler-1 for the RTS trick.
E3A9                             ; =============================================================================
E3A9   51 E4        PTAB:     DW   h_store-1   ; !
E3AB   C6 E2                  DW   h_str-1   ; "
E3AD   55 E3                  DW   h_num-1   ; #
E3AF   E4 E2                  DW   h_print-1   ; $
E3B1   59 E5                  DW   h_swap-1   ; %
E3B3   7C E4                  DW   h_and-1   ; &
E3B5   10 E3                  DW   h_emit-1   ; '
E3B7   A5 E1                  DW   h_open-1   ; (
E3B9   97 E0                  DW   h_close-1   ; )
E3BB   FF E4                  DW   h_mul-1   ; *
E3BD   AE E4                  DW   h_add-1   ; +
E3BF   5D E6                  DW   h_cfetch-1   ; ,
E3C1   A6 E4                  DW   h_sub-1   ; -
E3C3   63 E4                  DW   h_cstore-1   ; .
E3C5   6E E5                  DW   h_div-1   ; /
E3C7   81 E1                  DW   push-1   ; :
E3C9   70 E4                  DW   drop-1   ; ;
E3CB   DD E4                  DW   h_lt-1   ; <
E3CD   EF E4                  DW   h_eq-1   ; =
E3CF   DA E4                  DW   h_gt-1   ; >
E3D1   66 E6                  DW   h_key-1   ; ?
E3D3   51 E6                  DW   h_fetch-1   ; @
E3D5   D4 E1                  DW   h_def-1   ; [
E3D7   B0 E0                  DW   h_break-1   ; \
E3D9   9F E0                  DW   h_ret-1   ; ]
E3DB   98 E4                  DW   h_xor-1   ; ^
E3DD   9E E5                  DW   h_alloc-1   ; _
E3DF   C4 E6                  DW   h_grave-1   ; `
E3E1   7D E0                  DW   h_tor-1   ; {
E3E3   8A E4                  DW   h_or-1   ; |
E3E5   8A E0                  DW   h_fromr-1   ; }
E3E7   C6 E4                  DW   h_not-1   ; ~
E3E9                             ; rdnum: TOS = TOS*10 + digit for each digit at IP. Wraps at 16 bits. The
E3E9                             ; test is at the bottom so the loop closes with a branch. Returns with the
E3E9                             ; carry set.
E3E9   20 37 E4     RD1:      JSR   incip   ; (keeps A = the digit)
E3EC   06 02                  ASL   TL   
E3EE   26 03                  ROL   TH   ; x2
E3F0   18                     CLC      
E3F1   65 02                  ADC   TL   
E3F3   85 04                  STA   T0   
E3F5   A5 03                  LDA   TH   
E3F7   69 00                  ADC   #0   
E3F9   A8                     TAY      ; Y:T0 = x2 + digit
E3FA   06 02                  ASL   TL   
E3FC   26 03                  ROL   TH   
E3FE   06 02                  ASL   TL   
E400   26 03                  ROL   TH   ; x8
E402   18                     CLC      
E403   A5 02                  LDA   TL   
E405   65 04                  ADC   T0   
E407   85 02                  STA   TL   
E409   98                     TYA      
E40A   65 03                  ADC   TH   
E40C   85 03                  STA   TH   ; x8 + x2 + digit
E40E   20 14 E4     RDNUM:    JSR   isdig   
E411   90 D6                  BCC   rd1   
E413   60                     RTS      
E414                             ; isdig: A = the character at IP minus "0"; the carry is clear if it is a
E414                             ; digit. Y = 0.
E414   20 2F E4     ISDIG:    JSR   peek   
E417   38                     SEC      
E418   E9 30                  SBC   #"0"   
E41A   C9 0A                  CMP   #10   
E41C   60                     RTS      
E41D                             ; =============================================================================
E41D                             ;  Reading the program
E41D                             ;    peek: A = the character at IP, IP unchanged, Y = 0
E41D                             ;    getc: the same, then IP moves on; flags follow A
E41D                             ;    incip: IP moves on; keeps A, the carry and Y
E41D                             ; =============================================================================
E41D                             ; rdhex: if IP is at a hex digit (0-9, A-F, a-f), return its value in A with
E41D                             ; the carry clear and IP moved on; otherwise the carry is set and IP stays.
E41D                             ; Y = 0.
E41D   20 14 E4     RDHEX:    JSR   isdig   
E420   90 0A                  BCC   rh1   
E422   29 DF                  AND   #0DFh   
E424   E9 11                  SBC   #11h   ; (the carry is set)
E426   C9 06                  CMP   #6   
E428   B0 04                  BCS   rh9   
E42A   69 0A                  ADC   #10   
E42C   90 09        RH1:      BCC   incip   ; always: the carry is clear
E42E   60           RH9:      RTS      
E42F   A0 00        PEEK:     LDY   #0   
E431   B1 00                  LDA   (IP),Y   
E433   60                     RTS      
E434   20 2F E4     GETC:     JSR   peek   
E437   E6 00        INCIP:    INC   IP   
E439   D0 02                  BNE   ic1   
E43B   E6 01                  INC   IP+1   
E43D   09 00        IC1:      ORA   #0   
E43F   60                     RTS      
E440                             ; rstip: point IP at the start of the program
E440   A9 00        RSTIP:    LDA   #<PROG   
E442   85 00                  STA   IP   
E444   A9 05                  LDA   #>PROG   
E446   85 01                  STA   IP+1   
E448   60                     RTS      
E449                             ; =============================================================================
E449                             ;  Stack
E449                             ; =============================================================================
E449                             ; flag: pops TOS and returns with Z set if it was 0. Keeps the carry.
E449   A5 02        FLAG:     LDA   TL   
E44B   05 03                  ORA   TH   
E44D   20 71 E4               JSR   drop   
E450   A8                     TAY      ; (drop's INX changed the flags)
E451   60                     RTS      
E452                             ; "!" ( n addr -- ) is "." plus the high byte. Both end in drop.
E452                H_STORE:      
E452                          IF   CHECKED   
E452   A5 02                  LDA   TL   ; both bytes must be in the program's space:
E454   69 01                  ADC   #1   ; check the page of addr+1 (the carry is
E456   A5 03                  LDA   TH   ; clear on the way in)
E458   69 00                  ADC   #0   
E45A   20 DF E5               JSR   chkst   
E45D                          ENDIF      
E45D   BD 00 03               LDA   DSH,X   
E460   A0 01                  LDY   #1   
E462   91 02                  STA   (TL),Y   
E464                H_CSTORE:      ; "." ( c addr -- )
E464                          IF   CHECKED   
E464   A5 03                  LDA   TH   
E466   20 DF E5               JSR   chkst   
E469                          ENDIF      
E469   BD 00 02               LDA   DSL,X   
E46C   A0 00                  LDY   #0   
E46E   91 02                  STA   (TL),Y   
E470   E8                     INX      ; falls into drop
E471                             ; drop: ";" and every drop. It works through Y, so A and the carry are kept;
E471                             ; it returns with Z clear.
E471   BC 00 02     DROP:     LDY   DSL,X   
E474   84 02                  STY   TL   
E476   BC 00 03               LDY   DSH,X   
E479   84 03                  STY   TH   
E47B   E8                     INX      
E47C   60                     RTS      
E47D                             ; =============================================================================
E47D                             ;  Arithmetic and logic. Effects are ( NOS TOS -- result ).
E47D                             ; =============================================================================
E47D                             ; The logic operators leave the carry as they found it, clear, so they can
E47D                             ; branch to fin.
E47D   BD 00 02     H_AND:    LDA   DSL,X   
E480   25 02                  AND   TL   
E482   85 02                  STA   TL   
E484   BD 00 03               LDA   DSH,X   
E487   25 03                  AND   TH   
E489   90 31                  BCC   fin   ; always
E48B   BD 00 02     H_OR:     LDA   DSL,X   
E48E   05 02                  ORA   TL   
E490   85 02                  STA   TL   
E492   BD 00 03               LDA   DSH,X   
E495   05 03                  ORA   TH   
E497   90 23                  BCC   fin   ; always
E499   BD 00 02     H_XOR:    LDA   DSL,X   
E49C   45 02                  EOR   TL   
E49E   85 02                  STA   TL   
E4A0   BD 00 03               LDA   DSH,X   
E4A3   45 03                  EOR   TH   
E4A5   90 15                  BCC   fin   ; always
E4A7                             ; "-" has two jobs: directly before a digit it starts a negative number.
E4A7   20 14 E4     H_SUB:    JSR   isdig   
E4AA   90 14                  BCC   negnum   
E4AC   20 CD E4     SUB1:     JSR   neg   ; a - b = a + (-b)
E4AF   18           H_ADD:    CLC      
E4B0   BD 00 02               LDA   DSL,X   
E4B3   65 02                  ADC   TL   
E4B5   85 02                  STA   TL   
E4B7   BD 00 03               LDA   DSH,X   
E4BA   65 03                  ADC   TH   ; falls into fin
E4BC                             ; fin: finish a two-operand op: A = the high byte of the result
E4BC   85 03        FIN:      STA   TH   
E4BE   E8                     INX      
E4BF   60                     RTS      
E4C0   A9 00        NEGNUM:   LDA   #0   ; a number from 0 (the digit routine's start)
E4C2   20 67 E1               JSR   digit   ; (comes back with the carry set)
E4C5   B0 06                  BCS   neg   ; always: the number, negated
E4C7                             ; "~": -x - 1, which is neg with the carry clear, as it is here
E4C7   90 05        H_NOT:    BCC   neg1   ; always
E4C9                             ; absv: TOS = |TOS|.  negm: TOS = -TOS if the N flag is set.
E4C9   A5 03        ABSV:     LDA   TH   
E4CB   10 0D        NEGM:     BPL   ab9   
E4CD                             ; neg: TOS = -TOS
E4CD   38           NEG:      SEC      
E4CE   A9 00        NEG1:     LDA   #0   
E4D0   E5 02                  SBC   TL   
E4D2   85 02                  STA   TL   
E4D4   A9 00                  LDA   #0   
E4D6   E5 03                  SBC   TH   
E4D8   85 03                  STA   TH   
E4DA   60           AB9:      RTS      
E4DB                             ; Signed compares: a - b sets N and V; N xor V is "a < b". The carry ends up
E4DB                             ; clear for true, and bool turns it into -1 (true) or 0 (both pop NOS first).
E4DB   20 5A E5     H_GT:     JSR   h_swap   ; a > b is b < a
E4DE   BD 00 02     H_LT:     LDA   DSL,X   
E4E1   C5 02                  CMP   TL   
E4E3   BD 00 03               LDA   DSH,X   
E4E6   E5 03                  SBC   TH   
E4E8   70 02                  BVS   lt1   
E4EA   49 80                  EOR   #80h   
E4EC   0A           LT1:      ASL      
E4ED   E8                     INX      ; (keeps the carry; never leaves X at 0)
E4EE   D0 07                  BNE   bool   ; always
E4F0   20 AC E4     H_EQ:     JSR   sub1   ; a - b: zero if equal; A = its high byte
E4F3   05 02                  ORA   TL   
E4F5   C9 01                  CMP   #1   ; carry clear if A = 0
E4F7   A9 00        BOOL:     LDA   #0   
E4F9   69 FF                  ADC   #0FFh   ; carry clear: FF, set: 00
E4FB   85 02                  STA   TL   
E4FD   85 03                  STA   TH   
E4FF   60                     RTS      
E500                             ; "*": the classic shift-right multiply. The multiplier leaves TH:TL from the
E500                             ; bottom while the product comes in at the top, through A:T0 above it; after
E500                             ; 16 rounds TH:TL hold the low 16 bits, which are all that is kept.
E500                          IF   FAST   
