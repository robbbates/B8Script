0844                          IF   CPM   
0844                             ; RAM pages, after the image
0844                CPAGE:    EQU   (imgend + 255) / 256   ; the skip cache (QK builds), first, so
0844                RSPAGE:   EQU   CPAGE + QK   ;   that the letter page is still the one
0844                DSPAGE:   EQU   RSPAGE + 1   ;   just below the program text
0844                LETPAGE:   EQU   RSPAGE + 2   
0844                PROG:     EQU   LETPAGE*256 + 256   
0844                          ENDIF      
0844                IMGEND:      


