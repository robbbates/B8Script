0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Spec: docs/b8script.md (2026-11-23).
0000                             ; 
0000                             ;  Four switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    EDITOR   1 = with the line editor built in (see the end of this file):
0000                             ;                 the spec's suggested standard. It goes with either setting
0000                             ;                 of the other two.
0000                             ;    CHECKED  0 = no checks (spec: the programmer is responsible)
0000                             ;             1 = starts with every variable at 0 and every word undefined,
0000                             ;                 and stops on every error in the spec's table (and Ctrl-C)
0000                             ;                 with a four-line report: the letter and the place as line
0000                             ;                 and column, the text there, and both stacks. See `error`.
0000                             ;    ANSI     1 = the four console codes (`@ `^ `_ `?) send ANSI escape
0000                             ;                 sequences through CONOUT
0000                             ;             0 = they call four routines of the machine's own instead:
0000                             ;                 CONAT, CONCLS, CONEOL and CONCUR (see the equates)
0000                             ; 
0000                             ;  In every build Ctrl-C stops a running program (an unchecked build stops
0000                             ;  without a word): see the console layer for the rules, the held key and
0000                             ;  the break-off cell.
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   0   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   1   ; 1 = checked build
0000                EDITOR:   EQU   1   ; 1 = with the line editor
0000                ANSI:     EQU   1   ; 1 = the console codes send ANSI sequences
0000                EDGEN:    EQU   EDITOR*(1-CPM)   ; (the generic build with the editor)
0000                             ; (IF takes any value but 0 as true, so
0000                             ;  IF CHECKED+EDITOR means "either")
0000                TABP0:    EQU   EDGEN*(1-CHECKED)   ; (the build with its table in page zero)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    HL'  return-stack pointer (the alternate HL). Entries are 2 bytes; the
0000                             ;         stack grows down. Only rpop and rpushn (and the checks) touch it.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  One-byte calls. The routines used most are reached with RST, one byte
0000                             ;  instead of three:
0000                             ; 
0000                             ;    RST 08h  rpop    pop the return stack into DE
0000                             ;    RST 18h  drop    drop TOS, then next character     (ends a handler)
0000                             ;    RST 20h  neg16   HL = -HL
0000                             ;    RST 28h  putc    print A
0000                             ;    RST 30h  next    next character                    (ends a handler)
0000                             ; 
0000                             ;  RST 18h and RST 30h never return: an RST is a CALL, so the first thing
0000                             ;  each of them does is POP DE to throw the return address away.
0000                             ; 
0000                             ;  The CP/M build can't own page zero, so the block from `vecs` to `vecend`
0000                             ;  (image addresses 0108h-0133h) is copied to 0008h-0033h when it starts. The
0000                             ;  code in that block is written to work at either place.
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (the top four bytes of the page are spare,
0000                             ;             so a full stack runs two bytes into the page below)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch, interpreter variables in the gaps, and the -n? line buffer
0000                             ;             at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack has a guard band: the data stack can
0000                             ;  overrun by a cell or two (and the calls made while it is full, the error
0000                             ;  report's included) into the top 32 bytes of the return-stack page, which
0000                             ;  are never used, and the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
                    BDOS:     EQU   0005h   
                    BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IF   CPM*(1-EDITOR)   
                    EXIT:     EQU   0000h   ; warm boot
0000                          ENDIF      
0000                          IFN   CPM   
0000                             ; ---- generic machine: edit these to suit -----------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The zero flag must match A
0000                             ;   (end the routine with OR A / RET).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                             ;   KEY and CONOUT must preserve BC, DE, HL and HL'.
0000                RSPAGE:   EQU   80h   ; 8000h return stack
0000                DSPAGE:   EQU   81h   ; 8100h data stack
0000                LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
0000                PROG:     EQU   8300h   ; where the loader puts the program text
0000                HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
0000                BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-ANSI)   
                                 ; ---- generic machine with ANSI = 0: the console codes call these ------------
                    CONAT:    EQU   0FF0Ch   ; `@  cursor to row E, column L, both from 0
                                 ;     (DE and HL hold the whole cells). May
                                 ;     change A, DE and HL
                    CONCLS:   EQU   0FF0Fh   ; `^  clear the screen and home the cursor
                    CONEOL:   EQU   0FF12h   ; `_  clear from the cursor to the end of the line
                    CONCUR:   EQU   0FF15h   ; `?  cursor off if A = 0 (the zero flag is set
                                 ;     to match), on if not. May change A, DE, HL
                                 ;   All four must preserve BC and HL'; CONCLS and CONEOL also DE and HL.
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)   
                    EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                          ENDIF      
0000                          IF   EDGEN   
0000                LEAVE:    EQU   0FF09h   ; where the editor's ^X goes
0000                          ENDIF      
0000                          IF   EDITOR*CPM   
                    LEAVE:    EQU   0000h   ; the editor's ^X: warm boot
0000                          ENDIF      
0000                          IF   EDITOR   
0000                EXIT:     EQU   edend   ; a program that ends goes back to the editor,
0000                SKEND:    EQU   skend   ;   also when it ends inside skip
0000                          ENDIF      
0000                          IF   1-EDITOR   
                    SKEND:    EQU   EXIT   
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine. (The wait
0000                             ; for a second Ctrl-C uses it too: 250 ms.)
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                             ;   around machine code;
0000                NPEND:    EQU   LET+38h   ;   minus the address of the program's end
0000                             ;   (the heap"s first byte), for the checked "_';
0000                EDLN:     EQU   LET+3Ah   ;   the editor: the number of the line that ^E
0000                             ;   put in the input line (0: none)
0000                SEED:     EQU   LET+76h   ; gap after z: the random seed, the cell whose
0000                             ;   address `. gives. Nothing sets it at the
0000                             ;   start but the checked build's clearing;
0000                KEYBUF:   EQU   LET+7Ah   ;   a key read by the break check and
0000                             ;   held for the next "?" (0: none);
0000                BRKOFF:   EQU   LET+7Bh   ;   the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                LBHDR:    EQU   LET+7Eh   ; CP/M BDOS 10 header: max, count
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FCh   ; empty data stack. The four bytes above it
0000                             ; are spare: a character can pop two cells
0000                             ; too many before the checked build sees it,
0000                             ; and the next call must not land on the
0000                             ; letter cells.
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is the start of the .COM file, and 0108h-0133h is also copied to
0000                             ;  page zero (see the header).
0000                             ; =============================================================================
0000                          .ORG   BASE   
0000                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              XOR   A   ; 00  reset. (This byte, AFh, is also what an
0000                          ENDIF      ;     undefined word runs into: see e_hi.)
0000                          IF   1-EDGEN   
                              LD   SP,DSTOP   ; 00  reset, or the start of the .COM file
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)   
                              LD   BC,PROG   ; 03  the IP
                              JR   st0   ; 06  (the rest of the startup is close by)
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              JR   init   ; 04  (the rest of the startup is close by)
                              DW   0   ; 06  spare
0000                          ENDIF      
0000                          IF   EDGEN   
0000   AF                     XOR   A   ; 00  reset: no program yet. (This byte, AFh,
0001   32 00 83               LD   (PROG),A   ;     is also what an undefined word runs
0004   C3 3E 05               JP   init   ; 04  into in the checked build: see e_hi.)
0007   00                     NOP      ; 07  spare
0008                          ENDIF      
0008                          IF   CPM   
                              JP   start   ; 03
                              DW   0   ; 06  spare
0008                          ENDIF      
0008                VECS:        
0008                             ; ---- RST 08h: rpop: pop the return stack into DE ---------------------------
0008   D9           RPOP:     EXX      ; 08
0009   5E                     LD   E,(HL)   
000A   23                     INC   HL   
000B   56                     LD   D,(HL)   
000C   23                     INC   HL   
000D   D5                     PUSH   DE   ; across to the main registers
000E   D9                     EXX      
000F   D1                     POP   DE   
0010   C9                     RET      ; 10  (so RST 10h is not used)
0011                             ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
0011   C6 21        CTL:      ADD   A,21h   ; 11  back to c; zero only for NUL
0013   20 1C                  JR   NZ,next0   ;     the rest are ignored
0015   C3 83 05     ENDPROG:   JP   EXIT   ;     the program has ended
0018                             ; ---- RST 18h: drop TOS, then next ------------------------------------------
0018   D1           RST18:    POP   DE   ; 18  discard the RST's return address
0019   E1                     POP   HL   ;     new TOS = NOS
001A   18 15                  JR   nx   
001C   E5           H_FROMR:   PUSH   HL   ; 1C  "}" return stack to TOS
001D   CF                     RST   08h   
001E   EB                     EX   DE,HL   
001F   F7                     RST   30h   
0020                             ; ---- RST 20h: neg16: HL = -HL (keeps BC, DE) -------------------------------
0020   AF           NEG16:    XOR   A   ; 20
0021   95                     SUB   L   
0022   6F                     LD   L,A   
0023   9F                     SBC   A,A   
0024   94                     SUB   H   
0025   67                     LD   H,A   
0026   C9                     RET      
0027   00                     NOP      ; 27  spare
0028                             ; ---- RST 28h: putc: print A (keeps BC, DE, HL, HL') ------------------------
0028                RST28:       
0028                          IFN   CPM   
0028   C3 03 FF     PUTC:     JP   CONOUT   ; 28
002B                          ENDIF      
002B                          IF   CPM   
                              JP   putc   ; 28
002B                          ENDIF      
002B   E9           JPHL:     JP   (HL)   ; 2B  (for the machine-code call)
002C   E3           H_TOR:    EX   (SP),HL   ; 2C  "{" TOS to the return stack: the new TOS
002D   C3 B7 00               JP   rpushn   ;     comes up, the old one goes across
0030                             ; ---- RST 30h: next character -----------------------------------------------
0030   D1           RST30:    POP   DE   ; 30  discard the RST's return address
0031                NX:          
0031                          IF   CPM   
                              JP   next0   ; (this copy runs in page zero)
0031                          ENDIF      
0031                VECEND:      
0031                             ; =============================================================================
0031                             ;  The inner loop: read one character and sort it by range.
0031                             ; 
0031                             ;    00h          end of program
0031                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0031                             ;    30h-39h      digit: read a whole number
0031                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0031                             ;    61h-7Ah      a-z: push the address of that letter's cell
0031                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0031                             ; =============================================================================
0031                NEXT0:       
0031                          IF   CHECKED   
0031   CD ED 03               CALL   chkstk   ; both stacks are checked once per character
0034                          ENDIF      
0034   0A                     LD   A,(BC)   
0035   03                     INC   BC   
0036   D6 21                  SUB   21h   ; A = c - 21h
0038   38 D7                  JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
003A   FE 0F                  CP   0Fh   
003C   38 25                  JR   C,punct   ; 21h-2Fh: PTAB index 0-14
003E   D6 0F                  SUB   0Fh   ; A = c - 30h
0040   FE 0A                  CP   0Ah   
0042   38 5D                  JR   C,digit   ; 30h-39h
0044   FE 11                  CP   11h   
0046   38 19                  JR   C,p3a   ; 3Ah-40h
0048   D6 11                  SUB   11h   ; A = c - 41h
004A   FE 1A                  CP   1Ah   
004C   38 5F                  JR   C,upper   ; 41h-5Ah: A = letter index 0-25
004E   FE 20                  CP   20h   
0050   38 0D                  JR   C,p5b   ; 5Bh-60h
0052   FE 3A                  CP   3Ah   
0054   38 51                  JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0056   FE 3E                  CP   3Eh   
0058                          IF   1-CHECKED   
                              JR   NC,next0   ; 7Fh-FFh: ignored
0058                          ENDIF      
0058                          IF   CHECKED   
0058   28 D7                  JR   Z,next0   ; 7Fh, DEL: ignored
005A   D2 19 04               JP   NC,e_hi   ; 80h-FFh: reserved
005D                          ENDIF      
005D   D6 1A                  SUB   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
005F   D6 09        P5B:      SUB   9   ; 5Bh-60h: -4 in all, index 22-27
0061   C6 05        P3A:      ADD   A,5   ; 3Ah-40h: index 15-21
0063                .macro PTABLE,
0063                             ; 
0063                 DB      h_store & 0FFh  ; !
0063                 DB      h_str & 0FFh    ; "
0063                 DB      h_num & 0FFh    ; #
0063                 DB      h_print & 0FFh  ; $
0063                 DB      h_swap & 0FFh   ; %
0063                 DB      h_and & 0FFh    ; &
0063                 DB      h_emit & 0FFh   ; '
0063                 DB      h_open & 0FFh   ; (
0063                 DB      h_close & 0FFh  ; )
0063                 DB      h_mul & 0FFh    ; *
0063                 DB      h_add & 0FFh    ; +
0063                 DB      h_cfetch & 0FFh ; ,
0063                 DB      h_sub & 0FFh    ; -
0063                 DB      h_cstore & 0FFh ; .
0063                 DB      h_div & 0FFh    ; /
0063                 DB      h_dup & 0FFh    ; :
0063                 DB      h_drop & 0FFh   ; ;
0063                 DB      h_lt & 0FFh     ; <
0063                 DB      h_eq & 0FFh     ; =
0063                 DB      h_gt & 0FFh     ; >
0063                 DB      h_key & 0FFh    ; ?
0063                 DB      h_fetch & 0FFh  ; @
0063                 DB      h_def & 0FFh    ; [
0063                 DB      h_break & 0FFh  ; \
0063                 DB      h_ret & 0FFh    ; ]
0063                 DB      h_xor & 0FFh    ; ^
0063                 DB      h_alloc & 0FFh  ; _
0063                 DB      h_grave & 0FFh  ; `
0063                 DB      h_tor & 0FFh    ; {
0063                 DB      h_or & 0FFh     ; |
0063                 DB      h_fromr & 0FFh  ; }
0063                 DB      h_not & 0FFh    ; ~
0063                .endm
0063                 
0063                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
0063                             ; untouched, and A, DE free.
0063   C6 7D        PUNCT:    ADD   A,PTAB & 0FFh   ; PTAB never crosses a page
0065   5F                     LD   E,A   
0066   16 03                  LD   D,PTAB / 256   ; (0 if the table is in page zero)
0068   FE 93                  CP   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
006A   1A                     LD   A,(DE)   
006B   5F                     LD   E,A   ; the handler's low byte
006C                          IF   (1-CPM)*(1-TABP0)   
006C   16 00                  LD   D,0   
006E                          ENDIF      
006E                          IFN   CPM   
006E   CB 12                  RL   D   ; its page: 0 + carry
0070                          ENDIF      
0070                          IF   CPM   
                              LD   D,1   
                              JR   NC,pu1   
                              INC   D   ; its page: 1 + carry
                    PU1:         
0070                          ENDIF      
0070   D5                     PUSH   DE   ; jump to it; the stack is balanced again
0071   C9                     RET      ;   when the handler starts
0072                             ; The rest of the startup: here so that the generic reset code can reach it
0072                             ; with JR. st0: find the program's NUL; the heap starts after it.
0072                             ; (The editor build has its own copy of this, next to the editor.)
0072                             ; A checked build first clears the lower half of the letter page (A = 0):
0072                             ; every variable starts at 0, every word cell holds 0000h, the address an
0072                             ; undefined word is caught at (see e_hi), and no key is held back.
0072                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                    INIT:     LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
                              LD   BC,PROG   ; the IP
0072                          ENDIF      
0072                          IF   (1-CPM)*(1-EDITOR)   
                    ST0:      LD   H,B   
                              LD   L,C   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
0072                          ENDIF      
0072                          IF   1-EDITOR   
                    ST2:      LD   (HEAP),HL   
0072                          ENDIF      
0072                          IF   CHECKED*(1-EDITOR)   
                              RST   20h   ; minus the heap"s first address: "_' may not
                              LD   (NPEND),HL   ;   release below it
0072                          ENDIF      
0072                          IF   (1-CHECKED)*(1-EDITOR)*(1-CPM)   
                              LD   H,A   ; (A = 0) no key is held, and the break key
                              LD   L,A   ;   is on (the checked build has cleared
0072                          ENDIF      ;   these)
0072                          IF   (1-CHECKED)*(1-EDITOR)*CPM   
                              LD   HL,0   
0072                          ENDIF      
0072                          IF   (1-CHECKED)*(1-EDITOR)   
                              LD   (KEYBUF),HL   
0072                          ENDIF      
0072                          IF   1-EDITOR   
                              EXX      
                              LD   HL,RSTOP   ; the return stack is empty
                              EXX      
                              RST   30h   ; (its return address is thrown away)
0072                          ENDIF      
0072                             ; In the unchecked generic editor build the table is here, in the first
0072                             ; page, which saves loading D twice. (The other builds have no room for it
0072                             ; here: theirs is further down.)
0072                          IF   TABP0   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0072                          ENDIF      
0072                             ; =============================================================================
0072                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
0072                             ;  (00bbIGFuZCA= are up among the RST routines.) The machine-code call, exec,
0072                             ;  is here too: it belongs to "`" and makes the page come out right.
0072                             ; =============================================================================
0072   D1           H_XOR:    POP   DE   
0073   7C                     LD   A,H   
0074   AA                     XOR   D   
0075   67                     LD   H,A   
0076   7D                     LD   A,L   
0077   AB                     XOR   E   
0078   6F                     LD   L,A   
0079   F7                     RST   30h   
007A   D1           H_OR:     POP   DE   
007B   7C                     LD   A,H   
007C   B2                     OR   D   
007D   67                     LD   H,A   
007E   7D                     LD   A,L   
007F   B3                     OR   E   
0080   6F                     LD   L,A   
0081   F7                     RST   30h   
0082   E7           H_NOT:    RST   20h   ; ~x = -x - 1
0083   2B                     DEC   HL   
0084   F7                     RST   30h   
0085                             ; "_" ( n -- addr ): the heap pointer moves by n, a signed count (the add is
0085                             ; the same either way); TOS is the old pointer.
0085   ED 5B 7C 82  H_ALLOC:   LD   DE,(HEAP)   
0089                          IF   CHECKED*CPM   
                              LD   A,H   ; the count's sign, for chkhp
0089                          ENDIF      
0089   19                     ADD   HL,DE   ; the new top
008A                          IF   CHECKED   
008A   CD 23 04               CALL   chkhp   
008D                          ENDIF      
008D   22 7C 82               LD   (HEAP),HL   
0090   EB                     EX   DE,HL   
0091   F7                     RST   30h   
0092   D9           EXEC:     EXX      
0093   22 34 82               LD   (RSAVE),HL   ; machine code may change the alternates
0096   D9                     EXX      
0097   CD 2B 00               CALL   jphl   
009A   D9                     EXX      
009B   2A 34 82               LD   HL,(RSAVE)   
009E   D9                     EXX      
009F   E1                     POP   HL   
00A0   F7                     RST   30h   
00A1                             ; ---- the letters and digits (here, in the middle, so that the inner loop's
00A1                             ; ---- short jumps reach them, and the handlers after them reach rpushn) ------
00A1                             ; Digits: step back onto the first digit and read the whole number.
00A1   E5           DIGIT:    PUSH   HL   
00A2   0B                     DEC   BC   
00A3   CD 34 02               CALL   rdnum   
00A6   F7                     RST   30h   
00A7                             ; a-z: push the cell's address (the cell is the variable)
00A7   E5           LOWER:    PUSH   HL   
00A8   87                     ADD   A,A   
00A9   6F                     LD   L,A   
00AA   26 82                  LD   H,LETPAGE   
00AC   F7                     RST   30h   
00AD                             ; A-Z: call the word. The return address (the IP after the letter) goes on
00AD                             ; the return stack, and the IP becomes the address in the letter's cell.
00AD   C5           UPPER:    PUSH   BC   ; the return address, for rpushn
00AE   EB                     EX   DE,HL   ; park TOS
00AF   87                     ADD   A,A   
00B0   6F                     LD   L,A   
00B1   26 82                  LD   H,LETPAGE   ; HL -> cell
00B3   4E                     LD   C,(HL)   
00B4   2C                     INC   L   
00B5   46                     LD   B,(HL)   ; IP = the word's body
00B6   EB                     EX   DE,HL   ; TOS back, and fall into rpushn
00B7                             ; rpushn: move the top cell of the data stack (in memory) to the return
00B7                             ; stack, then next. Everything that pushes the return stack ends here.
00B7                             ; 
00B7                             ; The break key is looked at here, so at every word call and loop-back (and
00B7                             ; block entry and "{"), but only one time in 256: B', which nothing else
00B7                             ; uses, counts them. Reading the keyboard can be slow (it is a BDOS call
00B7                             ; under CP/M), and this way it costs a loop four bytes and 14 T-states.
00B7                             ; (DEC B, not DJNZ: its zero flag lasts through the EXX, so one EXX serves
00B7                             ; both ways out.)
00B7   D9           RPUSHN:   EXX      
00B8   D1                     POP   DE   
00B9   2B                     DEC   HL   
00BA   72                     LD   (HL),D   
00BB   2B                     DEC   HL   
00BC   73                     LD   (HL),E   
00BD   05                     DEC   B   
00BE   D9                     EXX      
00BF   CC AF 03               CALL   Z,pollk   
00C2   F7                     RST   30h   
00C3                             ; ---- the grave -------------------------------------------------------------
00C3                             ; The grave is a prefix: with the character after it, it is one command.
00C3                             ; The characters are tested one after another, each SUB taking off the step
00C3                             ; from the one before, so A is 0 (and the carry clear) when a handler is
00C3                             ; reached. Two are here, where they keep the first page as full as the
00C3                             ; layout needs; grave2 has the rest.
00C3                             ; 
00C3                             ;   `!  ( addr -- )  calls the machine code at TOS. The code is entered by
00C3                             ;       CALL with the data stack above the return address; it must keep BC,
00C3                             ;       and on return the top cell becomes the new TOS.
00C3                             ;   `'  ( -- )  new line: CR LF
00C3   0A           H_GRAVE:   LD   A,(BC)   
00C4   03                     INC   BC   
00C5   D6 21                  SUB   "!"   
00C7   28 C9                  JR   Z,exec   
00C9   D6 06                  SUB   27h-"!"   ; "'"
00CB   C2 B2 02               JP   NZ,grave2   
00CE   3E 0D                  LD   A,13   
00D0   EF                     RST   28h   
00D1   3E 0A                  LD   A,10   
00D3   EF                     RST   28h   
00D4   F7                     RST   30h   
00D5                             ; ---- where the two pages meet ----------------------------------------------
00D5                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
00D5                             ; are in falling code order for this), and where exactly differs between the
00D5                             ; builds: NPG1 follows. Every handler below these four must start in the
00D5                             ; second page, and every one above in the first; chktab.py checks both.
00D5                             ; "]" returns: pop an address and jump to it.
00D5   CF           H_RET:    RST   08h   
00D6   42                     LD   B,D   
00D7   4B                     LD   C,E   
00D8   F7           BRK1:     RST   30h   
00D9                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
00D9                             ; drops the block start, "]" returns. No closer at all ends the program.
00D9   7C           H_BREAK:   LD   A,H   
00DA   B5                     OR   L   
00DB   E1                     POP   HL   
00DC   28 FA                  JR   Z,brk1   
00DE   CD 5B 02               CALL   skip   
00E1   B7                     OR   A   ; skip returns 0 for ")"
00E2   20 F1                  JR   NZ,h_ret   
00E4   CF           RDROP:    RST   08h   
00E5   F7                     RST   30h   
00E6                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
00E6                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
00E6                             ; the body"s address instead. Either way it then skips to the matching "]'.
00E6                             ; (The unchecked build takes anything that is not a letter as the space; the
00E6                             ; checked build stops on it.)
00E6   0A           H_DEF:    LD   A,(BC)   
00E7   03                     INC   BC   
00E8   D6 41                  SUB   "A"   ; a letter gives 0-25 or 32-57: lowercase
00EA   5F                     LD   E,A   ;   lands 64 bytes up
00EB   E6 DF                  AND   0DFh   ; fold case
00ED   FE 1A                  CP   26   
00EF   30 0B                  JR   NC,def2   ; not a letter
00F1   CB 23                  SLA   E   
00F3   16 82                  LD   D,LETPAGE   ; DE -> cell
00F5   79                     LD   A,C   
00F6   12                     LD   (DE),A   
00F7   1C                     INC   E   
00F8   78                     LD   A,B   
00F9   12                     LD   (DE),A   
00FA   18 09                  JR   skipnx   
00FC                DEF2:        
00FC                          IF   CHECKED   
00FC   7B                     LD   A,E   
00FD   FE DF                  CP   " "-"A"+256   
00FF   C2 55 04               JP   NZ,e_brack   ; anything but a letter or a space
0102                          ENDIF      
0102   E5                     PUSH   HL   ; an anonymous block: push its address
0103   60                     LD   H,B   
0104   69                     LD   L,C   
0105                SKIPNX:      
0105                          IF   CHECKED   
0105   0B                     DEC   BC   ; back onto the letter, so that skip finds its
0106                          ENDIF      ;   opener, the "[", just before where it starts
0106   CD 5B 02     SKIPO:    CALL   skip   
0109   F7                     RST   30h   
010A   5E           H_FETCH:   LD   E,(HL)   ; "@"
010B   23                     INC   HL   
010C   56                     LD   D,(HL)   
010D   EB                     EX   DE,HL   
010E   F7                     RST   30h   
010F                             ; =============================================================================
010F                             ;  Handlers that must start in the image's second page.
010F                             ;  "?" is the last (with "," inside it), so its long tail may run past that
010F                             ;  page.
010F                             ; =============================================================================
010F                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
010F                             ; the matching ")".
010F   7C           H_OPEN:   LD   A,H   
0110   B5                     OR   L   
0111   E1                     POP   HL   
0112   28 F2                  JR   Z,skipo   
0114   C5                     PUSH   BC   ; the block starts at the IP
0115   18 A0                  JR   rpushn   
0117                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
0117                             ; drops it and carries on.
0117   7C           H_CLOSE:   LD   A,H   
0118   B5                     OR   L   
0119   E1                     POP   HL   
011A   28 C8                  JR   Z,rdrop   
011C   CF                     RST   08h   ; pop the block start ...
011D   42                     LD   B,D   
011E   4B                     LD   C,E   
011F   C5                     PUSH   BC   
0120   18 95                  JR   rpushn   ; ... and push it back
0122                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
0122                             ; "-" has two jobs: directly before a digit it starts a negative number.
0122   0A           H_SUB:    LD   A,(BC)   
0123   D6 30                  SUB   "0"   
0125   FE 0A                  CP   10   
0127   38 04                  JR   C,negnum   
0129   E7                     RST   20h   ; a - b = a + (-b): fall into "+"
012A   D1           H_ADD:    POP   DE   
012B   19                     ADD   HL,DE   
012C   F7                     RST   30h   
012D   E5           NEGNUM:   PUSH   HL   ; a negative number: read it, negate it
012E   CD 34 02               CALL   rdnum   
0131   E7                     RST   20h   
0132   F7                     RST   30h   
0133   D1           H_AND:    POP   DE   
0134   7C                     LD   A,H   
0135   A2                     AND   D   
0136   67                     LD   H,A   
0137   7D                     LD   A,L   
0138   A3                     AND   E   
0139   6F                     LD   L,A   
013A   F7                     RST   30h   
013B                             ; Signed compares. Both are "HL < DE" for the right pair: "<" swaps the two
013B                             ; cells first. Flipping both sign bits turns a signed compare into an
013B                             ; unsigned one (and XOR clears the carry for SBC); SBC HL,HL then turns the
013B                             ; carry into -1 or 0 with no branch.
013B   E3           H_LT:     EX   (SP),HL   ; a < b: HL = a, and b is popped next
013C   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
013D   7C                     LD   A,H   
013E   EE 80                  XOR   80h   
0140   67                     LD   H,A   
0141   7A                     LD   A,D   
0142   EE 80                  XOR   80h   
0144   57                     LD   D,A   
0145   ED 52                  SBC   HL,DE   ; carry if HL < DE
0147   ED 62        TF:       SBC   HL,HL   ; carry -> -1 or 0
0149   F7                     RST   30h   
014A   D1           H_EQ:     POP   DE   
014B   B7                     OR   A   
014C   ED 52                  SBC   HL,DE   
014E   7C                     LD   A,H   
014F   B5                     OR   L   
0150   FE 01                  CP   1   ; carry only if a - b = 0
0152   18 F3                  JR   tf   
0154                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept. The
0154                             ; multiplier shifts up through A:C.
0154   D1           H_MUL:    POP   DE   ; DE = multiplicand
0155   C5                     PUSH   BC   
0156   7C                     LD   A,H   
0157   4D                     LD   C,L   ; A:C = multiplier
0158   21 00 00               LD   HL,0   
015B   06 10                  LD   B,16   
015D   29           MUL1:     ADD   HL,HL   
015E   CB 21                  SLA   C   
0160   17                     RLA      
0161   30 01                  JR   NC,mul2   
0163   19                     ADD   HL,DE   
0164   10 F7        MUL2:     DJNZ   mul1   
0166   C1                     POP   BC   
0167   F7                     RST   30h   
0168                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
0168                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
0168                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
0168                             ; stops on it.
0168                H_DIV:       
0168                          IF   CHECKED   
0168   7C                     LD   A,H   
0169   B5                     OR   L   
016A   CA 52 04               JP   Z,e_zero   
016D                          ENDIF      
016D   D1                     POP   DE   ; DE = a, HL = b
016E   C5                     PUSH   BC   ; free BC for udiv
016F   D5                     PUSH   DE   ; a, for r's sign
0170   7A                     LD   A,D   
0171   AC                     XOR   H   
0172   F5                     PUSH   AF   ; S flag = sign of q
0173   CB 7C                  BIT   7,H   
0175   C4 20 00               CALL   NZ,neg16   ; HL = |b|
0178   EB                     EX   DE,HL   
0179   CB 7C                  BIT   7,H   
017B   C4 20 00               CALL   NZ,neg16   ; HL = |a|, DE = |b|
017E   CD 0E 02               CALL   udiv   ; HL = q, DE = r
0181   F1                     POP   AF   
0182   FC 20 00               CALL   M,neg16   ; q's sign
0185   EB                     EX   DE,HL   ; HL = r, DE = q
0186   F1                     POP   AF   ; A = a's high byte
0187   B7                     OR   A   
0188   FC 20 00               CALL   M,neg16   ; r's sign
018B   C1                     POP   BC   
018C   D5                     PUSH   DE   ; q under r
018D   F7                     RST   30h   
018E                             ; ---- stack and storage -----------------------------------------------------
018E   E5           H_DUP:    PUSH   HL   ; ":"
018F   F7                     RST   30h   
0190   E3           H_SWAP:   EX   (SP),HL   ; "%"
0191   F7                     RST   30h   
0192                             ; (The checked build tests the address before it takes the value off the
0192                             ; stack, so that an error report shows both.)
0192                H_CSTORE:      ; "." ( c addr -- )
0192                          IF   CHECKED   
0192   CD 38 04               CALL   chkst   
0195                          ENDIF      
0195   D1                     POP   DE   
0196   73                     LD   (HL),E   
0197   DF           H_DROP:   RST   18h   ; ";" is this one byte
0198                H_STORE:      ; "!" ( n addr -- )
0198                          IF   CHECKED   
0198   CD 38 04               CALL   chkst   
019B                          ENDIF      
019B   D1                     POP   DE   
019C   73                     LD   (HL),E   
019D   23                     INC   HL   
019E   72                     LD   (HL),D   
019F   DF                     RST   18h   
01A0                             ; ---- console ---------------------------------------------------------------
01A0                             ; 22h pushes the address of the text after it and skips the string.
01A0   E5           H_STR:    PUSH   HL   
01A1   60                     LD   H,B   
01A2   69                     LD   L,C   
01A3   CD 4A 02               CALL   skipstr   
01A6                          IF   CHECKED   
01A6   B7                     OR   A   ; 0: the text ran out before the closing quote
01A7   CA 4A 04               JP   Z,e_quote   
01AA                          ENDIF      
01AA   F7                     RST   30h   
01AB                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character
01AB                             ; clears that character"s bit 6 (/M is CR, /` is space; "/" and ""' have no
01AB                             ; bit 6, so // and /" give themselves).
01AB                          IF   (1-CHECKED)*(1-EDITOR)   
                    H_PRINT:   LD   A,(HL)   
                              INC   HL   
                              CP   22h   
                              JR   Z,pr9   
                              CP   "/"   
                              JR   NZ,pr1   
                              LD   A,(HL)   
                              INC   HL   
                              AND   0BFh   
                    PR1:      RST   28h   
                              JR   h_print   
01AB                          ENDIF      
01AB                          IF   CHECKED   
01AB                             ; (The checked build has the loop as a routine, prstr, which the error
01AB                             ; report uses too. The address is kept on the stack meanwhile: a report
01AB                             ; shows the stack as it was before the "$".)
01AB   E5           H_PRINT:   PUSH   HL   
01AC   CD 18 05               CALL   prstr   
01AF   D1                     POP   DE   
01B0   DF                     RST   18h   
01B1                          ENDIF      
01B1                          IF   (1-CHECKED)*EDITOR   
                                 ; (With the editor the loop is a routine, prstr, which ^V uses too.)
                    H_PRINT:   CALL   prstr   
                              RST   18h   
01B1                          ENDIF      
01B1   7D           H_EMIT:   LD   A,L   ; "'"
01B2   EF                     RST   28h   
01B3   DF           PR9:      RST   18h   
01B4                             ; "#" prints TOS as a signed decimal number, with no space after it.
01B4   C5           H_NUM:    PUSH   BC   
01B5   CD 98 02               CALL   psgn   
01B8   C1                     POP   BC   
01B9   DF                     RST   18h   
01BA                             ; "?" ( n -- c ) or ( -n -- addr )
01BA                             ;   n > 0: wait about n ms for a key; 0 if none came
01BA                             ;   n = 0: wait for a key
01BA                             ;          (both stir the random seed while they wait: see kt2)
01BA                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
01BA                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
01BA   CB 7C        H_KEY:    BIT   7,H   
01BC   20 22                  JR   NZ,line   
01BE   1E 28        KT1:      LD   E,MSLOOP   ; one millisecond, roughly
01C0   CD DD 03     KT2:      CALL   getk   
01C3   20 17                  JR   NZ,kt3   
01C5   1D                     DEC   E   
01C6   20 F8                  JR   NZ,kt2   
01C8   EB                     EX   DE,HL   ; a millisecond with no key stirs the random
01C9   2A 76 82               LD   HL,(SEED)   ;   seed by one: how long a key takes to come
01CC   23                     INC   HL   ;   is the one thing here that is not the
01CD   22 76 82               LD   (SEED),HL   ;   same every time
01D0   EB                     EX   DE,HL   
01D1   7C                     LD   A,H   ; 0? never counts down: it waits
01D2   B5                     OR   L   
01D3   28 E9                  JR   Z,kt1   
01D5   2B                     DEC   HL   
01D6   7C                     LD   A,H   
01D7   B5                     OR   L   
01D8   20 E4                  JR   NZ,kt1   ; A = 0 if the time ran out
01DA   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
01DB   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
01DC   6F           KT3:      LD   L,A   
01DD   26 00                  LD   H,0   
01DF   F7                     RST   30h   
01E0                          IF   CPM   
                                 ; CP/M: BDOS 10 does the editing (the spec allows the platform's
                                 ; own line editor). It doesn't store the CR, so it is added here.
                    LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
                              ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
                              SBC   A,A   
                              AND   L   ; (0 for a count that is too big)
                              XOR   127   ; A = the count, 127 at most
                              LD   (LBHDR),A   
                              LD   DE,LBHDR   
                              LD   A,10   
                              CALL   bdosx   
                              LD   HL,LBHDR+1   
                              LD   A,(HL)   ; the count typed (0-127)
                              INC   L   ; HL = LINEBUF, whose low byte is 80h:
                              ADD   A,L   ;   adding the count to L can't carry
                              LD   L,A   
                              LD   (HL),13   
01E0                          ENDIF      
01E0                          IFN   CPM   
01E0                             ; Generic: Backspace takes the last character back (and is echoed as
01E0                             ; it is), CR ends (stored, not echoed), every other key is stored and
01E0                             ; echoed until the line is full. The line buffer starts at offset 80h
01E0                             ; of its page, so L alone is the place in the line: D holds the L of
01E0                             ; a full line.
01E0   11 7F 00     LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
01E3   19                     ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
01E4   9F                     SBC   A,A   
01E5   A5                     AND   L   ; (0 for a count that is too big)
01E6   2F                     CPL      
01E7   57                     LD   D,A   ; D = the L of a full line: 80h + count, FFh
01E8                             ;   at most
01E8   21 80 82               LD   HL,LINEBUF   
01EB   CD DD 03     LN2:      CALL   getk   
01EE   28 FB                  JR   Z,ln2   
01F0   FE 0D                  CP   13   
01F2   28 16                  JR   Z,ln5   
01F4   FE 08                  CP   8   
01F6   28 0B                  JR   Z,ln4   
01F8   5F                     LD   E,A   
01F9   7D                     LD   A,L   
01FA   BA                     CP   D   
01FB   28 EE                  JR   Z,ln2   ; full
01FD   73                     LD   (HL),E   
01FE   2C                     INC   L   
01FF   7B                     LD   A,E   
0200   EF           LN3:      RST   28h   
0201   18 E8                  JR   ln2   
0203   2D           LN4:      DEC   L   ; Backspace: one back, and echo it,
0204   FA 00 02               JP   M,ln3   ;   unless the line was empty (L left the
0207   2C                     INC   L   ;   upper half of the page)
0208   18 E1                  JR   ln2   
020A   77           LN5:      LD   (HL),A   ; the CR
020B                          ENDIF      
020B   2E 80                  LD   L,LINEBUF & 0FFh   
020D   F7                     RST   30h   
020E                             ; =============================================================================
020E                             ;  More routines (no handler starts past this point)
020E                             ; =============================================================================
020E                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
020E                             ; Uses A, BC; the caller saves the IP. The dividend shifts up through A:C
020E                             ; while the quotient bits arrive at the bottom of C.
020E                             ; Dividing by 2 is one shift (the spec wants that fast).
020E   7B           UDIV:     LD   A,E   
020F   EE 02                  XOR   2   
0211   B2                     OR   D   
0212   20 07                  JR   NZ,udv0   
0214   CB 3C                  SRL   H   
0216   CB 1D                  RR   L   ; the quotient
0218   8F                     ADC   A,A   
0219   5F                     LD   E,A   ; the remainder: the bit that fell out (D is 0)
021A   C9                     RET      
021B   7C           UDV0:     LD   A,H   
021C   4D                     LD   C,L   
021D   21 00 00               LD   HL,0   
0220   06 10                  LD   B,16   
0222   CB 21        UDV1:     SLA   C   
0224   17                     RLA      
0225   ED 6A                  ADC   HL,HL   
0227   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
0229   30 02                  JR   NC,udv2   ;   always fits in 16 bits
022B   19                     ADD   HL,DE   ; too much: put it back, and cancel the
022C   0D                     DEC   C   ;   INC below
022D   0C           UDV2:     INC   C   ; a quotient bit
022E   10 F2                  DJNZ   udv1   
0230   EB                     EX   DE,HL   ; DE = remainder
0231   67                     LD   H,A   
0232   69                     LD   L,C   ; HL = quotient
0233   C9                     RET      
0234                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
0234                             ; non-digit. Values wrap at 16 bits, as the spec says.
0234   21 00 00     RDNUM:    LD   HL,0   
0237   0A           RDN1:     LD   A,(BC)   
0238   D6 30                  SUB   "0"   
023A   FE 0A                  CP   10   
023C   D0                     RET   NC   
023D   03                     INC   BC   
023E   54                     LD   D,H   
023F   5D                     LD   E,L   
0240   29                     ADD   HL,HL   
0241   29                     ADD   HL,HL   
0242   19                     ADD   HL,DE   
0243   29                     ADD   HL,HL   ; HL * 10
0244   5F                     LD   E,A   
0245   16 00                  LD   D,0   
0247   19                     ADD   HL,DE   
0248   18 ED                  JR   rdn1   
024A                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
024A                             ; the next character, so "/"" does not end it. Leaves A = 22h.
024A                          IF   1-CHECKED   
                    SS0:      INC   BC   
                    SKIPSTR:   LD   A,(BC)   
                              INC   BC   
                              CP   "/"   
                              JR   Z,ss0   
                              CP   22h   
                              JR   NZ,skipstr   
                              RET      
024A                          ENDIF      
024A                          IF   CHECKED   
024A                             ; The checked build never steps over a NUL: if the text runs out first it
024A                             ; returns A = 0 with the IP on the NUL.
024A   0A           SKIPSTR:   LD   A,(BC)   
024B   B7                     OR   A   
024C   C8                     RET   Z   
024D   03                     INC   BC   
024E   FE 22                  CP   22h   
0250   C8                     RET   Z   
0251   FE 2F                  CP   "/"   
0253   20 F5                  JR   NZ,skipstr   
0255   0A                     LD   A,(BC)   ; the escaped character
0256   B7                     OR   A   
0257   C8                     RET   Z   
0258   03                     INC   BC   
0259   18 EF                  JR   skipstr   
025B                          ENDIF      
025B                             ; skip: read past text to the closer at this level, and return A = 0 if it
025B                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
025B                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
025B                             ; no closer; anything else that runs into the NUL had unbalanced brackets
025B                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
025B                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
025B                             ; 
025B                             ; The checked build also looks at the character the skip was started by,
025B                             ; which is always the one just before where it starts: "(" must end at ")",
025B                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
025B                             ; quote counts as running into it. "\" takes either closer. IX keeps the
025B                             ; place where the skip started, for the report.
025B                SKIP:        
025B                          IF   CHECKED   
025B   C5                     PUSH   BC   
025C   DD E1                  POP   IX   
025E   0B                     DEC   BC   
025F   0A                     LD   A,(BC)   
0260   03                     INC   BC   
0261   5F                     LD   E,A   ; E = the opener: ( [ or \
0262                          ENDIF      
0262   16 00                  LD   D,0   
0264   14           SK3:      INC   D   ; an opener: one deeper
0265   0A           SK1:      LD   A,(BC)   
0266                          IF   1-CHECKED   
                              INC   BC   
                              OR   A   
                              JP   Z,SKEND   ; (the end of the program)
0266                          ENDIF      
0266                          IF   CHECKED   
0266   B7                     OR   A   
0267   28 22                  JR   Z,sk6   ; (the IP stays on the NUL)
0269   03                     INC   BC   
026A                          ENDIF      
026A   FE 22                  CP   22h   
026C   CC 4A 02               CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
026F   D6 28                  SUB   "("   ;   (or 0, and then the NUL is read next)
0271   28 F1                  JR   Z,sk3   
0273   3D                     DEC   A   ; ")"
0274   28 08                  JR   Z,sk4   
0276   D6 32                  SUB   "["-")"   
0278   28 EA                  JR   Z,sk3   
027A   FE 02                  CP   "]"-"["   
027C   20 E7                  JR   NZ,sk1   
027E   15           SK4:      DEC   D   
027F                          IF   1-CHECKED   
                              RET   Z   ; the closer at this level
                              JR   sk1   
027F                          ENDIF      
027F                          IF   CHECKED   
027F   20 E4                  JR   NZ,sk1   
0281   57                     LD   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
0282   AB                     XOR   E   ;   opener is 0 for "(" and 1 for "[", and only
0283   E6 06                  AND   6   ;   "\" has bit 2: so this is 2 for the wrong
0285   FE 02                  CP   2   ;   closer, and only then
0287   7A                     LD   A,D   
0288   C0                     RET   NZ   
0289   18 05                  JR   sk7   
028B   CB 53        SK6:      BIT   2,E   ; the text ran out:
028D   C2 82 05               JP   NZ,SKEND   ;   "\" with no closer ends the program
0290   DD E5        SK7:      PUSH   IX   ; N. The place is the opener
0292   C1                     POP   BC   
0293   3E 4E                  LD   A,"N"   
0295   C3 47 04               JP   errp   ; (errp drops skip's return address)
0298                          ENDIF      
0298                             ; psgn: print HL as a signed number. Uses BC.
0298   CB 7C        PSGN:     BIT   7,H   
029A   28 04                  JR   Z,pdec   
029C   3E 2D                  LD   A,"-"   
029E   EF                     RST   28h   
029F   E7                     RST   20h   
02A0                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
02A0                             ; Uses BC.
02A0   11 0A 00     PDEC:     LD   DE,10   
02A3   CD 0E 02               CALL   udiv   ; HL = HL / 10, E = the last digit
02A6   7B                     LD   A,E   
02A7   F5                     PUSH   AF   
02A8   7C                     LD   A,H   
02A9   B5                     OR   L   
02AA   C4 A0 02               CALL   NZ,pdec   
02AD   F1                     POP   AF   
02AE   C6 30                  ADD   A,"0"   
02B0   EF                     RST   28h   
02B1   C9                     RET      
02B2                             ; =============================================================================
02B2                             ;  The grave's other codes. h_grave comes here with A = the character minus
02B2                             ;  27h, not zero; the tests carry on from there. The four characters from
02B2                             ;  "+" to "." follow one another, so one range test finds them and two
02B2                             ;  rotates tell them apart.
02B2                             ; 
02B2                             ;    `$  ( addr -- addr' )  the hex loader: pairs of hex digits are stored
02B2                             ;        from addr until a non-hex character; then a RET (C9h) is written
02B2                             ;        and its address is left. An odd last digit is consumed and dropped.
02B2                             ;    `+  ( addr -- n )   add 1 to the cell at addr and leave its new value
02B2                             ;    `,  ( n -- r )      a random number from 0 to n-1 (n is 1 to 32767)
02B2                             ;    `-  ( addr -- n )   subtract 1 from the cell at addr, the same way
02B2                             ;    `.  ( -- addr )     the address of the random seed
02B2                             ;    `<  ( a b -- n )    the smaller of the two (signed)
02B2                             ;    `>  ( a b -- n )    the larger
02B2                             ;    `?  ( flag -- )     the cursor off (0) or on
02B2                             ;    `@  ( row col -- )  the cursor to that row and column, both from 0
02B2                             ;    `^  ( -- )          clear the screen and home the cursor
02B2                             ;    `_  ( -- )          clear from the cursor to the end of the line
02B2                             ; 
02B2                             ;  Any other character is unsafe: the unchecked build takes it as "_", the
02B2                             ;  checked build stops with W.
02B2                             ; =============================================================================
02B2   D6 04        GRAVE2:   SUB   "+"-27h   ; "+" "," "-" "." leave 0 to 3
02B4   FE 04                  CP   4   
02B6   30 3E                  JR   NC,gv2   
02B8   1F                     RRA      ; carry: "," or "."; bit 0 of A: "-" or "."
02B9   38 13                  JR   C,gv3   
02BB                             ; `+ and `-: one routine.
02BB                          IF   CHECKED   
02BB   57                     LD   D,A   ; (the checked build tests the address first,
02BC   CD 38 04               CALL   chkst   ;   as "!" does: the test uses A, and under
02BF   7A                     LD   A,D   ;   CP/M E too)
02C0                          ENDIF      
02C0   5E                     LD   E,(HL)   
02C1   23                     INC   HL   
02C2   56                     LD   D,(HL)   
02C3   1F                     RRA      ; carry: "-"
02C4   38 02                  JR   C,gi1   
02C6   13                     INC   DE   
02C7   13                     INC   DE   
02C8   1B           GI1:      DEC   DE   
02C9   72                     LD   (HL),D   
02CA   2B                     DEC   HL   
02CB   73                     LD   (HL),E   
02CC   EB                     EX   DE,HL   ; the new value is TOS
02CD   F7                     RST   30h   
02CE   1F           GV3:      RRA      ; carry: "."
02CF   38 20                  JR   C,g_seed   
02D1                             ; `, ( n -- r ). The seed goes one step on: seed * 261 + 1, which takes
02D1                             ; every 16-bit value in turn. The high bits of such a seed are the good ones
02D1                             ; and the low ones repeat soon, so the high byte is folded into the low
02D1                             ; (XOR) before the remainder of dividing by n is taken.
02D1                             ; n must be 1 to 32767: the checked build stops with Z on anything less
02D1                             ; than 1.
02D1                G_RND:       
02D1                          IF   CHECKED   
02D1   2B                     DEC   HL   
02D2   CB 7C                  BIT   7,H   ; n - 1 negative: n is 0 or less
02D4   23                     INC   HL   
02D5   C2 52 04               JP   NZ,e_zero   
02D8                          ENDIF      
02D8   EB                     EX   DE,HL   ; DE = n
02D9   C5                     PUSH   BC   
02DA   2A 76 82               LD   HL,(SEED)   
02DD   44                     LD   B,H   
02DE   4D                     LD   C,L   
02DF   29                     ADD   HL,HL   
02E0   29                     ADD   HL,HL   
02E1   09                     ADD   HL,BC   ; * 5
02E2   23                     INC   HL   ; + 1
02E3   7C                     LD   A,H   
02E4   81                     ADD   A,C   
02E5   67                     LD   H,A   ; + * 256: * 261 + 1
02E6   22 76 82               LD   (SEED),HL   
02E9   AD                     XOR   L   ; (A is still the high byte)
02EA   6F                     LD   L,A   
02EB   CD 0E 02               CALL   udiv   ; DE = the remainder
02EE   EB                     EX   DE,HL   
02EF   C1                     POP   BC   
02F0   F7                     RST   30h   
02F1                             ; `. pushes the address of the random seed.
02F1   E5           G_SEED:   PUSH   HL   
02F2   21 76 82               LD   HL,SEED   
02F5   F7                     RST   30h   
02F6   C6 07        GV2:      ADD   A,"+"-"$"   ; "$"
02F8   20 13                  JR   NZ,gv4   
02FA   CD 9D 03     HX1:      CALL   hexc   
02FD   30 0B                  JR   NC,hx2   
02FF   77                     LD   (HL),A   ; the high digit goes in first ...
0300   CD 9D 03               CALL   hexc   
0303   30 05                  JR   NC,hx2   ; odd digit: consumed, and the RET below
0305   ED 6F                  RLD      ;   overwrites it
0307   23                     INC   HL   ; ... and RLD shifts it up under the low one
0308   18 F0                  JR   hx1   
030A   36 C9        HX2:      LD   (HL),0C9h   ; (never range-checked: the spec says so)
030C   F7                     RST   30h   
030D   D6 18        GV4:      SUB   "<"-"$"   
030F   28 25                  JR   Z,g_min   
0311   D6 02                  SUB   ">"-"<"   
0313   28 20                  JR   Z,g_max   
0315   3D                     DEC   A   ; "?"
0316   28 30                  JR   Z,g_cur   
0318   3D                     DEC   A   ; "@"
0319   28 43                  JR   Z,g_at   
031B   D6 1E                  SUB   "^"-"@"   ; "^" leaves 0 and "_" leaves 1
031D                          IF   CHECKED   
031D   FE 02                  CP   2   
031F   D2 55 04               JP   NC,e_brack   ; anything else: W. The place is the character
0322   B7                     OR   A   
0323                          ENDIF      
0323                          IF   ANSI   
0323   20 07                  JR   NZ,ge1   
0325   CD 76 03               CALL   csi   ; "^": ESC [ H homes the cursor, and then
0328   3E 48                  LD   A,"H"   ;   ESC [ J clears from there to the end of
032A   EF                     RST   28h   ;   the screen
032B   AF                     XOR   A   
032C   C6 4A        GE1:      ADD   A,"J"   ; "_": ESC [ K clears to the end of the line
032E   5F                     LD   E,A   
032F   CD 76 03               CALL   csi   
0332   7B                     LD   A,E   
0333   EF                     RST   28h   
0334   F7                     RST   30h   
0335                          ENDIF      
0335                          IF   1-ANSI   
                              JR   NZ,ge1   
                              CALL   CONCLS   
                              RST   30h   
                    GE1:      CALL   CONEOL   
                              RST   30h   
0335                          ENDIF      
0335                             ; `< and `>. The carry says which: set for the larger. The two are put in
0335                             ; order, HL the smaller and DE the larger, and then swapped for ">".
0335                             ; b < a (signed) is the borrow of b - a, turned round if the two signs
0335                             ; differ: RRA puts the borrow in bit 7, where the two XORs meet it.
0335   37           G_MAX:    SCF      ; ("<" comes in with the carry clear)
0336   D1           G_MIN:    POP   DE   ; DE = a, HL = b
0337   F5                     PUSH   AF   
0338   7D                     LD   A,L   
0339   93                     SUB   E   
033A   7C                     LD   A,H   
033B   9A                     SBC   A,D   
033C   1F                     RRA      
033D   AC                     XOR   H   
033E   AA                     XOR   D   
033F   17                     RLA      ; carry: b < a
0340   38 01                  JR   C,gm2   
0342   EB                     EX   DE,HL   
0343   F1           GM2:      POP   AF   
0344   30 01                  JR   NC,gm3   
0346   EB                     EX   DE,HL   
0347   F7           GM3:      RST   30h   
0348                          IF   ANSI   
0348                             ; `? ( flag -- ): ESC [ ? 2 5 l hides the cursor, ESC [ ? 2 5 h shows it.
0348   CD 76 03     G_CUR:    CALL   csi   
034B   3E 3F                  LD   A,"?"   
034D   EF                     RST   28h   
034E   3E 32                  LD   A,"2"   
0350   EF                     RST   28h   
0351   3E 35                  LD   A,"5"   
0353   EF                     RST   28h   
0354   7C                     LD   A,H   
0355   B5                     OR   L   
0356   3E 6C                  LD   A,"l"   
0358   28 02                  JR   Z,gc1   
035A   3E 68                  LD   A,"h"   
035C   EF           GC1:      RST   28h   
035D   DF                     RST   18h   
035E                             ; `@ ( row col -- ): ESC [ row+1 ; col+1 H. (ANSI counts from 1.)
035E   D1           G_AT:     POP   DE   ; DE = the row
035F   C5                     PUSH   BC   ; (pdec uses BC)
0360   E5                     PUSH   HL   ; the column
0361   EB                     EX   DE,HL   
0362   CD 76 03               CALL   csi   
0365   23                     INC   HL   
0366   CD A0 02               CALL   pdec   
0369   3E 3B                  LD   A,";"   
036B   EF                     RST   28h   
036C   E1                     POP   HL   
036D   23                     INC   HL   
036E   CD A0 02               CALL   pdec   
0371   3E 48                  LD   A,"H"   
0373   EF                     RST   28h   
0374   C1                     POP   BC   
0375   DF                     RST   18h   
0376                             ; csi: print ESC [, which starts every ANSI sequence. Keeps all but A.
0376   3E 1B        CSI:      LD   A,27   
0378   EF                     RST   28h   
0379   3E 5B                  LD   A,"["   
037B   EF                     RST   28h   
037C   C9                     RET      
037D                          ENDIF      
037D                          IF   1-ANSI   
                                 ; With ANSI = 0 the machine's own routines do the work (see the equates).
                    G_CUR:    LD   A,H   
                              OR   L   
                              CALL   CONCUR   
                              RST   18h   
                    G_AT:     POP   DE   ; DE = the row, HL = the column
                              CALL   CONAT   
                              RST   18h   
037D                          ENDIF      
037D                             ; =============================================================================
037D                             ;  Dispatch table: the low byte of each handler's address, in code order
037D                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
037D                             ;  It must not cross a page (the dispatcher only adds to its low byte).
037D                             ; =============================================================================
037D                             ; The handlers of the first NPG1 characters start in the image's second page.
037D                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
037D                             ; differs between the builds, so the count is worked out here.
037D                             ; (One division to a line: asm80 only rounds down when it stores a value.)
037D                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
037D                PGBRK:    EQU   (h_break-BASE)/256   
037D                PGDEF:    EQU   (h_def-BASE)/256   
037D                PGFET:    EQU   (h_fetch-BASE)/256   
037D                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
037D                          IF   1-TABP0   
037D                PTAB:        
037D                          ;*Macro unroll:  PTABLE
037D   98                     DB   h_store & 0FFh   
037E   A0                     DB   h_str & 0FFh   
037F   B4                     DB   h_num & 0FFh   
0380   AB                     DB   h_print & 0FFh   
0381   90                     DB   h_swap & 0FFh   
0382   33                     DB   h_and & 0FFh   
0383   B1                     DB   h_emit & 0FFh   
0384   0F                     DB   h_open & 0FFh   
0385   17                     DB   h_close & 0FFh   
0386   54                     DB   h_mul & 0FFh   
0387   2A                     DB   h_add & 0FFh   
0388   DB                     DB   h_cfetch & 0FFh   
0389   22                     DB   h_sub & 0FFh   
038A   92                     DB   h_cstore & 0FFh   
038B   68                     DB   h_div & 0FFh   
038C   8E                     DB   h_dup & 0FFh   
038D   97                     DB   h_drop & 0FFh   
038E   3B                     DB   h_lt & 0FFh   
038F   4A                     DB   h_eq & 0FFh   
0390   3C                     DB   h_gt & 0FFh   
0391   BA                     DB   h_key & 0FFh   
0392   0A                     DB   h_fetch & 0FFh   
0393   E6                     DB   h_def & 0FFh   
0394   D9                     DB   h_break & 0FFh   
0395   D5                     DB   h_ret & 0FFh   
0396   72                     DB   h_xor & 0FFh   
0397   85                     DB   h_alloc & 0FFh   
0398   C3                     DB   h_grave & 0FFh   
0399   2C                     DB   h_tor & 0FFh   
039A   7A                     DB   h_or & 0FFh   
039B   1C                     DB   h_fromr & 0FFh   
039C   82                     DB   h_not & 0FFh   
039D                PTABEND:      
039D                          ENDIF      
039D                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
039D                             ; and return its value in A with the carry set; otherwise leave the IP and
039D                             ; return with the carry clear.
039D   0A           HEXC:     LD   A,(BC)   
039E   D6 30                  SUB   "0"   
03A0   FE 0A                  CP   10   
03A2   38 09                  JR   C,hc1   
03A4   E6 DF                  AND   0DFh   
03A6   D6 11                  SUB   11h   
03A8   FE 06                  CP   6   
03AA   D0                     RET   NC   
03AB   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
03AD   03           HC1:      INC   BC   
03AE   C9                     RET      
03AF                             ; =============================================================================
03AF                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
03AF                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
03AF                             ;  (RST 28h) prints A. Both keep BC, DE, HL and HL'. In the generic build
03AF                             ;  they are the host's KEY and CONOUT routines themselves.
03AF                             ; 
03AF                             ;  A running program reads the keyboard only through getk and pollk, which
03AF                             ;  between them give the break key its rules:
03AF                             ;    - Ctrl-C stops the program;
03AF                             ;    - any other key that the break check reads is held in KEYBUF for the
03AF                             ;      next "?", and a newer one takes its place;
03AF                             ;    - "?" (getk) takes the held key first;
03AF                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
03AF                             ;      key like any other, but two of them within about 250 ms still stop it.
03AF                             ;  Both are called straight from a handler, never from a routine under one:
03AF                             ;  the checked build's report counts on finding one return address above the
03AF                             ;  data stack.
03AF                             ; =============================================================================
03AF                          IFN   CPM   
03AF                RAWK:     EQU   KEY   
03AF                          ENDIF      
03AF                             ; pollk: the break check (see rpushn).
03AF   CD 06 FF     POLLK:    CALL   rawk   
03B2   C8                     RET   Z   ; no key
03B3   32 7A 82               LD   (KEYBUF),A   ; held for the next "?"
03B6   FE 03        PK1:      CP   3   ; (getk joins here)
03B8   C0                     RET   NZ   
03B9                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
03B9                             ; the program has turned it off, wait about 250 ms for one more key: a
03B9                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
03B9                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
03B9   3A 7B 82     CTLC:     LD   A,(BRKOFF)   
03BC   B7                     OR   A   
03BD   CA 45 04     CT0:      JP   Z,brk   
03C0   D5                     PUSH   DE   
03C1   11 10 27               LD   DE,250*MSLOOP   
03C4   CD 06 FF     CT1:      CALL   rawk   
03C7   20 05                  JR   NZ,ct2   
03C9   1B                     DEC   DE   
03CA   7A                     LD   A,D   
03CB   B3                     OR   E   
03CC   20 F6                  JR   NZ,ct1   
03CE   D1           CT2:      POP   DE   ; A = the second key, or 0 if none came
03CF   FE 03                  CP   3   
03D1   28 EA                  JR   Z,ct0   ; (the zero flag takes the JP there)
03D3   B7                     OR   A   
03D4   28 03                  JR   Z,ct3   
03D6   32 7A 82               LD   (KEYBUF),A   
03D9   3E 03        CT3:      LD   A,3   
03DB   B7                     OR   A   
03DC   C9                     RET      
03DD                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
03DD   E5           GETK:     PUSH   HL   ; a held key goes first, and is taken out of
03DE   21 7A 82               LD   HL,KEYBUF   ;   the buffer
03E1   7E                     LD   A,(HL)   
03E2   36 00                  LD   (HL),0   
03E4   E1                     POP   HL   
03E5   B7                     OR   A   
03E6   C0                     RET   NZ   
03E7   CD 06 FF               CALL   rawk   
03EA   C8                     RET   Z   
03EB   18 C9                  JR   pk1   ; Ctrl-C? If not, that is the key
03ED                          IF   (1-CHECKED)*(1-EDITOR)   
                    BRK:      EQU   endprog   ; the unchecked build stops without a word
03ED                          ENDIF      ;   (with the editor, both stacks are cleared);
03ED                          IF   (1-CHECKED)*EDITOR   
                    BRK:      EQU   edit0   
03ED                          ENDIF      
03ED                          IF   CHECKED   
03ED                BRK:      EQU   e_break   ;   the checked build reports B
03ED                          ENDIF      
03ED                          IF   CPM   
                    RAWK:     LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
                                 ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
                                 ; printing and could swallow a key that BDOS 6 then never sees.
                    PUTC:     PUSH   DE   
                              PUSH   HL   
                              LD   E,A   
                              LD   A,6   
                              CALL   bdosx   
                              POP   HL   
                              POP   DE   
                              OR   A   ; (for getk)
                              RET      
                                 ; bdosx: call BDOS function A with DE, keeping BC and HL'
                    BDOSX:    PUSH   BC   
                              EXX      
                              PUSH   HL   
                              EXX      
                              LD   C,A   
                              CALL   BDOS   
                              EXX      
                              POP   HL   
                              EXX      
                              POP   BC   
                              RET      
03ED                          ENDIF      
03ED                             ; =============================================================================
03ED                             ;  Checked build: the checks and the error report
03ED                             ; =============================================================================
03ED                          IF   CHECKED   
03ED                             ; chkstk: both stacks are checked once per character, not in every handler.
03ED                             ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
03ED                             ; the constant carries if it is above (cells were popped that were never
03ED                             ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
03ED                             ; a character late at most: the bytes above DSTOP and the guard band below
03ED                             ; the page take what happens meanwhile. DE is free between characters.
03ED   EB           CHKSTK:   EX   DE,HL   
03EE   21 05 7E               LD   HL,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
03F1   39                     ADD   HL,SP   
03F2   EB                     EX   DE,HL   
03F3   38 1D                  JR   C,e_under   
03F5   14                     INC   D   
03F6   20 16                  JR   NZ,e_over   
03F8   D9                     EXX      ; the return stack: in its page (or it has
03F9   7C                     LD   A,H   ;   overflowed), and not above its empty
03FA   FE 80                  CP   RSPAGE   ;   position (an underflow stays inside the
03FC   7D                     LD   A,L   ;   page, in the guard band)
03FD   D9                     EXX      
03FE   20 0B                  JR   NZ,e_rover   
0400   FE E1                  CP   RSTOP&0FFh+1   
0402   D8                     RET   C   
0403   D9                     EXX      ; return stack underflow: it counts as empty
0404   2E E0                  LD   L,RSTOP&0FFh   ;   (H is right: the pointer is in its page)
0406   D9                     EXX      
0407   3E 72                  LD   A,"r"   
0409   18 3C                  JR   errp   
040B   3E 52        E_ROVER:   LD   A,"R"   ; return stack overflow
040D   11                     DB   11h   ; (LD DE,nn hides the next entry)
040E   3E 53        E_OVER:   LD   A,"S"   ; data stack overflow
0410   18 35                  JR   errp   
0412   31 FC 81     E_UNDER:   LD   SP,DSTOP   ; data stack underflow: it counts as empty
0415   3E 73                  LD   A,"s"   
0417   18 3E                  JR   error   
0419                             ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
0419                             ; was never defined still holds 0000h, and the byte there is a reserved one
0419                             ; in every build (AFh or C3h): if the IP is in page zero, this was a call of
0419                             ; an undefined word. The call is undone, so the place is the call itself.
0419   04           E_HI:     INC   B   
041A   10 33                  DJNZ   e_resv   ; (B is as it was, and is not 0)
041C   CF                     RST   08h   
041D   42                     LD   B,D   
041E   4B                     LD   C,E   
041F   3E 55                  LD   A,"U"   
0421   18 34                  JR   error   
0423                             ; chkhp: HL = the new heap top, DE = the old one, the carry is from adding
0423                             ; the count. Stop if the top is not below the limit page, or is below the
0423                             ; program's end.
0423                CHKHP:       
0423                          ENDIF      
0423                          IF   CHECKED*CPM   
                                 ; With this much room a top that wrapped round can land back in
                                 ; range, so the add is tested too: growing (A, the count's high
                                 ; byte, is positive) must not carry, and releasing must.
                              RRA      ; the carry comes in above the sign:
                              ADD   A,40h   ;   bit 7 = carry XOR sign
                              ADD   A,A   
                              JR   C,e_heap   
                              LD   A,(0007h)   
                              DEC   A   
                              CP   H   
                              JR   C,e_heap   
0423                          ENDIF      
0423                          IF   CHECKED*(1-CPM)   
0423                             ; (Here the program's space is under 32K, so a top that wrapped
0423                             ; round always falls outside it.)
0423   7C                     LD   A,H   
0424   FE F0                  CP   HEAPLIM   
0426   30 09                  JR   NC,e_heap   
0428                          ENDIF      
0428                          IF   CHECKED   
0428   D5                     PUSH   DE   
0429   EB                     EX   DE,HL   
042A   2A 38 82               LD   HL,(NPEND)   
042D   19                     ADD   HL,DE   ; carry: at or above the program's end
042E   EB                     EX   DE,HL   
042F   D1                     POP   DE   
0430   D8                     RET   C   
0431   B7           E_HEAP:   OR   A   ; put the count back in TOS for the report
0432   ED 52                  SBC   HL,DE   
0434   3E 48                  LD   A,"H"   
0436   18 0F                  JR   errp   
0438                             ; chkst: stop unless HL is in the program's own space: from the letter page
0438                             ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
0438                             ; whatever lies above the limit are safe. Memory above the heap top but
0438                             ; below the limit is the program's own: Tiny BASIC keeps its lines there.
0438                             ; It is the page of HL + 1 that is tested, so that one test serves both
0438                             ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
0438                             ; Keeps HL and BC. It runs on into its own error entry.
0438   23           CHKST:    INC   HL   
0439   7C                     LD   A,H   
043A   2B                     DEC   HL   
043B   FE 82                  CP   LETPAGE   
043D   38 03                  JR   C,e_store   
043F                          ENDIF      
043F                          IF   CHECKED*(1-CPM)   
043F   FE F0                  CP   HEAPLIM   
0441   D8                     RET   C   
0442                          ENDIF      
0442                          IF   CHECKED*CPM   
                              LD   E,A   
                              LD   A,(0007h)   ; the BDOS page is the heap limit
                              DEC   A   
                              CP   E   
                              RET   NC   
0442                          ENDIF      
0442                          IF   CHECKED   
0442                             ; Error entries. Each loads its letter and then hides the next entry inside
0442                             ; a 3-byte LD DE,nn (the 11h), so they all fall through to `error`.
0442   3E 4F        E_STORE:   LD   A,"O"   ; a store outside the program's space
0444   11                     DB   11h   
0445   3E 42        E_BREAK:   LD   A,"B"   ; Ctrl-C (found inside pollk or getk)
0447                             ; errp: an error found inside a routine: drop its return address first.
0447   D1           ERRP:     POP   DE   
0448   18 0D                  JR   error   
044A   44           E_QUOTE:   LD   B,H   ; an unclosed string: HL is its address, one
044B   4D                     LD   C,L   ;   past the opening quote, which is the place
044C   3E 51                  LD   A,"Q"   
044E   11                     DB   11h   
044F   3E 58        E_RESV:   LD   A,"X"   ; a reserved byte outside a string
0451   11                     DB   11h   
0452   3E 5A        E_ZERO:   LD   A,"Z"   ; dividing by zero
0454   11                     DB   11h   
0455   3E 57        E_BRACK:   LD   A,"W"   ; bad character after [
0457                             ; error: the report, then the end. A = the letter, BC = one past the place,
0457                             ; HL = TOS, and both stacks as the report is to show them:
0457                             ; 
0457                             ;   Err X @ line,col
0457                             ;   up to 16 characters of the text from the place
0457                             ;   Stk n: the top 8 cells at most, bottom to top
0457                             ;   Rtn n
0457   E5           ERROR:    PUSH   HL   ; now the whole data stack is in memory
0458   5F                     LD   E,A   
0459   CD 2B 05               CALL   pnl   
045C   45 72 72 20 22         DB   "Err ",22h   
0461   7B                     LD   A,E   
0462   EF                     RST   28h   
0463   CD 31 05               CALL   pmsg   
0466   20 40 20 22            DB   " @ ",22h   
046A   0B                     DEC   BC   ; BC = the place
046B                             ; The line and column. A place below the program is in the line
046B                             ; buffer: line 0. Otherwise count the LFs from the program's start;
046B                             ; DE = the line's number, HL = where it starts.
046B   21 80 82               LD   HL,LINEBUF   
046E   11 00 00               LD   DE,0   
0471   78                     LD   A,B   
0472   FE 83                  CP   PROG/256   
0474   38 14                  JR   C,er3   
0476   24                     INC   H   
0477   6B                     LD   L,E   ; HL = PROG
0478   13           ER1:      INC   DE   ; a new line starts at HL
0479   E5                     PUSH   HL   
047A   7D           ER2:      LD   A,L   
047B   91                     SUB   C   
047C   7C                     LD   A,H   
047D   98                     SBC   A,B   
047E   30 09                  JR   NC,er2x   ; reached the place
0480   7E                     LD   A,(HL)   
0481   23                     INC   HL   
0482   FE 0A                  CP   10   
0484   20 F4                  JR   NZ,er2   
0486   F1                     POP   AF   
0487   18 EF                  JR   er1   
0489   E1           ER2X:     POP   HL   
048A   C5           ER3:      PUSH   BC   
048B   E5                     PUSH   HL   
048C   EB                     EX   DE,HL   
048D   CD A0 02               CALL   pdec   ; the line
0490   3E 2C                  LD   A,","   
0492   EF                     RST   28h   
0493   D1                     POP   DE   
0494   E1                     POP   HL   
0495   E5                     PUSH   HL   
0496   B7                     OR   A   
0497   ED 52                  SBC   HL,DE   
0499   23                     INC   HL   
049A   CD A0 02               CALL   pdec   ; the column
049D   CD 2B 05               CALL   pnl   
04A0   22                     DB   22h   
04A1   E1                     POP   HL   ; the text, as it is: 16 characters, or fewer
04A2   06 10                  LD   B,16   ;   if the line or the program ends first
04A4   7E           ER4:      LD   A,(HL)   
04A5   23                     INC   HL   
04A6   B7                     OR   A   
04A7   28 0B                  JR   Z,er5   
04A9   FE 0D                  CP   13   
04AB   28 07                  JR   Z,er5   
04AD   FE 0A                  CP   10   
04AF   28 03                  JR   Z,er5   
04B1                          ENDIF      
04B1                          IF   CHECKED*CPM   
                              CP   1Ah   ; (the ^Z that pads a file's last record ends
                              JR   Z,er5   ;   the text too: some terminals clear the
04B1                          ENDIF      ;   screen on it)
04B1                          IF   CHECKED   
04B1   EF                     RST   28h   
04B2   10 F0                  DJNZ   er4   
04B4                ER5:         ; (without the editor: on into pstk)
04B4                          ENDIF      
04B4                          IF   CHECKED*EDITOR   
04B4   CD BE 04               CALL   pstk   
04B7   CD 2B 05               CALL   pnl   
04BA   22                     DB   22h   
04BB   C3 7E 05               JP   edit0   ; back to the editor, with both stacks cleared
04BE                          ENDIF      
04BE                             ; =============================================================================
04BE                             ;  Routines that the checked build's report and the editor share
04BE                             ; =============================================================================
04BE                SPADJ:    EQU   2*EDITOR   ; (with the editor pstk is called, not fallen
04BE                             ;   into: the stack is one address deeper)
04BE                          IF   CHECKED+EDITOR   
04BE                             ; pstk: the two stack lines:  Stk n: the top 8 cells at most, bottom to top
04BE                             ;                             Rtn n
04BE                             ; TOS must be in memory with the rest (pushed). In a build without the
04BE                             ; editor this is the end of `error`, which runs on into it.
04BE   CD 2B 05     PSTK:     CALL   pnl   
04C1   53 74 6B 20 22         DB   "Stk ",22h   
04C6   21 08 7E               LD   HL,(2+SPADJ-DSTOP)&0FFFFh   ; SP - (DSTOP-2) is minus twice the
04C9   39                     ADD   HL,SP   ;   depth (the cell at DSTOP-2 was pushed
04CA   E7                     RST   20h   ;   with the first value and holds nothing)
04CB   CD 0E 05               CALL   phalf   ; the depth
04CE   3E 3A                  LD   A,":"   
04D0   EF                     RST   28h   
04D1   79                     LD   A,C   
04D2   FE 09                  CP   9   
04D4   38 0A                  JR   C,er6   
04D6   CD 31 05               CALL   pmsg   
04D9   20 2E 2E 2E 22         DB   " ...",22h   
04DE   0E 08                  LD   C,8   
04E0   26 00        ER6:      LD   H,0   ; C = the number of cells to show
04E2   69                     LD   L,C   
04E3   29                     ADD   HL,HL   
04E4   39                     ADD   HL,SP   ; HL -> just above the deepest of them
04E5                          ENDIF      
04E5                          IF   EDITOR   
04E5   23                     INC   HL   
04E6   23                     INC   HL   
04E7                          ENDIF      
04E7                          IF   CHECKED+EDITOR   
04E7   0C                     INC   C   
04E8   0D           ER7:      DEC   C   
04E9   28 11                  JR   Z,er8   
04EB   2B                     DEC   HL   
04EC   56                     LD   D,(HL)   
04ED   2B                     DEC   HL   
04EE   5E                     LD   E,(HL)   
04EF   E5                     PUSH   HL   
04F0   C5                     PUSH   BC   
04F1   3E 20                  LD   A," "   
04F3   EF                     RST   28h   
04F4   EB                     EX   DE,HL   
04F5   CD 98 02               CALL   psgn   
04F8   C1                     POP   BC   
04F9   E1                     POP   HL   
04FA   18 EC                  JR   er7   
04FC   CD 2B 05     ER8:      CALL   pnl   
04FF                          ENDIF      
04FF                          IF   (1-CHECKED)*EDITOR   
                              DB   "Rtn 0",22h   ; (only ^V comes here, and at the editor the
                              RET      ;   return stack is always empty)
04FF                          ENDIF      
04FF                          IF   CHECKED   
04FF   52 74 6E 20 22         DB   "Rtn ",22h   
0504   D9                     EXX      
0505   E5                     PUSH   HL   
0506   D9                     EXX      
0507   D1                     POP   DE   
0508   21 E0 80               LD   HL,RSTOP   
050B   B7                     OR   A   
050C   ED 52                  SBC   HL,DE   
050E                          ENDIF      
050E                          IF   CHECKED*(1-EDITOR)   
                              CALL   phalf   
                              CALL   pnl   
                              DB   22h   
                              JP   endprog   
050E                          ENDIF      
050E                          IF   CHECKED+EDITOR   
050E                             ; phalf: print half of HL, and leave it in C. (With the editor, pstk ends by
050E                             ; running on into this.)
050E   CB 3C        PHALF:    SRL   H   
0510   CB 1D                  RR   L   
0512   E5                     PUSH   HL   
0513   CD A0 02               CALL   pdec   
0516   C1                     POP   BC   
0517   C9                     RET      
0518                             ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
0518                             ; "$", and the texts of the report and the editor). In the checked build a
0518                             ; NUL first is an error: Q.
0518   7E           PRSTR:    LD   A,(HL)   
0519   23                     INC   HL   
051A   FE 22                  CP   22h   
051C   C8                     RET   Z   
051D                          ENDIF      
051D                          IF   CHECKED   
051D   B7                     OR   A   
051E   28 17                  JR   Z,e_dollar   
0520                          ENDIF      
0520                          IF   CHECKED+EDITOR   
0520   FE 2F                  CP   "/"   
0522   20 04                  JR   NZ,prs1   
0524   7E                     LD   A,(HL)   
0525   23                     INC   HL   
0526   E6 BF                  AND   0BFh   
0528   EF           PRS1:     RST   28h   
0529   18 ED                  JR   prstr   
052B                             ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
052B                             ; pnl: the same, on a new line.
052B   3E 0D        PNL:      LD   A,13   
052D   EF                     RST   28h   
052E   3E 0A                  LD   A,10   
0530   EF                     RST   28h   
0531   E3           PMSG:     EX   (SP),HL   
0532   CD 18 05               CALL   prstr   
0535   E3                     EX   (SP),HL   
0536   C9                     RET      
0537                          ENDIF      
0537                          IF   CHECKED   
0537   D1           E_DOLLAR:   POP   DE   ; "$" ran into a NUL: drop the return address,
0538   E1                     POP   HL   ;   and put the string's address back in TOS
0539   3E 51                  LD   A,"Q"   
053B   C3 57 04               JP   error   
053E                          ENDIF      
053E                             ; =============================================================================
053E                             ;  The line editor (EDITOR = 1)
053E                             ; 
053E                             ;  The interpreter starts here, and a program that ends comes back here.
053E                             ;  There is no prompt. It follows the spec's suggested standard for a line
053E                             ;  editor (docs/b8script.md, Environments). Type a line and press Return:
053E                             ; 
053E                             ;    n text    put the text in as line n; the lines from n on move down. A
053E                             ;              number past the end (or 0) adds the line at the end.
053E                             ;    n         take line n out
053E                             ;    anything else is run at once, as B8Script. (Start such a line with a
053E                             ;    space if it would begin with a digit.)
053E                             ; 
053E                             ;  A command key ends the line too, and takes what was typed as its argument:
053E                             ; 
053E                             ;    ^G        run the program
053E                             ;    n ^L      list from line n (no number: all of it). Any key holds the
053E                             ;              list until another key is pressed; Ctrl-C ends it.
053E                             ;    n ^E      put line n in the input line; Return puts it back, changed
053E                             ;    name ^R   read. CP/M: the file of that name (no name: the same file as
053E                             ;              last time). Generic: what is typed, or pasted, from now until
053E                             ;              ^Z replaces the program; it is not echoed.
053E                             ;    name ^W   write. CP/M: to that file (no name: the same file as last
053E                             ;              time). Generic: the text is printed, as it is.
053E                             ;    ^N ^N     new: no program (the key twice in a row)
053E                             ;    ^V        view: the build, both stacks, and the program's size, lines
053E                             ;              and free memory
053E                             ;    ^X        leave (to LEAVE)
053E                             ; 
053E                             ;  In the line: ^B and ^F, or the left and right arrow keys, move the cursor;
053E                             ;  a character goes in at the cursor; Backspace and DEL take out the one
053E                             ;  before it; Esc drops the line. Only CR, LF, BS and printing characters are
053E                             ;  sent to the terminal, so any terminal will do.
053E                             ; 
053E                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
053E                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
053E                             ;  125 characters; the one character after a line number separates it from
053E                             ;  the text and is not stored. The text is kept as it is typed, each line
053E                             ;  ending in CR LF, at PROG.
053E                             ; 
053E                             ;  What lasts from one line to the next: the program, the words, the
053E                             ;  variables and the data stack. An error or a break clears both stacks. The
053E                             ;  return stack starts empty for every line.
053E                             ; 
053E                             ;  Things to know:
053E                             ;    - Reset empties the program (generic builds).
053E                             ;    - A word's address points into the program, so run the program again
053E                             ;      after editing it.
053E                             ;    - Nothing is printed between a program's output and what is typed next.
053E                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
053E                             ;      a line that calls -n? and carries on afterwards runs what was typed.
053E                             ;      (The stored program never comes back to the line, so it may.)
053E                             ;    - The editor"s own keys are not the program"s: -n? is the plain line
053E                             ;      read of the other builds (BDOS 10 under CP/M).
053E                             ; 
053E                             ;  The data stack is the CPU's stack, so the editor works on top of whatever
053E                             ;  the last line left there, with TOS pushed like the rest.
053E                             ; =============================================================================
053E                          IF   EDGEN   
053E                INIT:        ; reset (A = 0)
053E                          ENDIF      
053E                          IF   EDGEN*CHECKED   
053E                             ; Clear the lower half of the letter page: every variable starts at 0, and
053E                             ; every word cell holds 0000h, the address an undefined word is caught at
053E                             ; (see e_hi).
053E   21 00 82               LD   HL,LET   
0541   77           INI1:     LD   (HL),A   
0542   2C                     INC   L   
0543   F2 41 05               JP   P,ini1   ; +00h to +7Fh
0546                          ENDIF      
0546                          IF   EDGEN   
0546   18 36                  JR   edit0   
0548                          ENDIF      
0548                          IF   EDITOR   
0548                             ; ^F, right arrow: one to the right, by printing the character there
0548   7D           RIGHT:    LD   A,L   
0549   BB                     CP   E   
054A   28 4A                  JR   Z,ed1   ; at the end
054C   7E                     LD   A,(HL)   
054D   2C                     INC   L   
054E   18 2B                  JR   lf1   
0550                             ; Esc: alone it drops the line. An arrow key sends Esc [ and a letter, so
0550                             ; wait about 5 ms for a second key: after a "[" read on to the letter that
0550                             ; ends the sequence, and act on C (right) and D (left).
0550   01 C8 00     ESC:      LD   BC,5*MSLOOP   
0553   CD 06 FF     ES1:      CALL   rawk   
0556   20 0A                  JR   NZ,es2   
0558   0B                     DEC   BC   
0559   78                     LD   A,B   
055A   B1                     OR   C   
055B   20 F6                  JR   NZ,es1   
055D   CD CB 05               CALL   fin   ; no second key: the line is dropped
0560   18 22                  JR   edit   
0562   FE 5B        ES2:      CP   "["   
0564   20 30                  JR   NZ,ed1   ; not a sequence known here
0566   CD 24 06     ES3:      CALL   ekey   
0569   FE 40                  CP   40h   
056B   38 F9                  JR   C,es3   ; (its parameters)
056D   D6 43                  SUB   "C"   
056F   28 D7                  JR   Z,right   
0571   3D                     DEC   A   ; "D"?
0572   20 22                  JR   NZ,ed1   ; no: on into left
0574                             ; ^B, left arrow: the cursor goes one to the left
0574   7D           LEFT:     LD   A,L   
0575   87                     ADD   A,A   
0576   28 1E                  JR   Z,ed1   ; (L = 80h: at the start)
0578   2D                     DEC   L   
0579   3E 08                  LD   A,8   
057B   EF           LF1:      RST   28h   
057C   18 18                  JR   ed1   
057E                             ; edit0: reset, an error or a break: both stacks are cleared.
057E                             ; skend: a program that ended inside skip: its return address goes.
057E                             ; edend: a program that ended: TOS joins the rest of the data stack.
057E   31 FA 81     EDIT0:    LD   SP,DSTOP-2   ; empty (the cell that stands for TOS is pushed)
0581   21                     DB   21h   ; (LD HL,nn: steps over the next two bytes)
0582   D1           SKEND:    POP   DE   
0583   E5           EDEND:    PUSH   HL   
0584                             ; edit: start a new input line.
0584   D9           EDIT:     EXX      
0585   21 E0 80               LD   HL,RSTOP   ; the return stack is empty
0588   D9                     EXX      
0589   21 00 00               LD   HL,0   
058C   22 7A 82               LD   (KEYBUF),HL   ; no key is held, and the break key is on
058F   22 3A 82               LD   (EDLN),HL   ; no line is being edited
0592   21 80 82               LD   HL,LINEBUF   ; HL = the cursor,
0595   5D                     LD   E,L   ;   E = the end of the line (its low byte)
0596   CD 24 06     ED1:      CALL   ekey   
0599   FE 7F                  CP   7Fh   
059B   28 40                  JR   Z,bsp   ; DEL
059D   FE 20                  CP   " "   
059F   30 56                  JR   NC,insc   
05A1   FE 09                  CP   9   
05A3   28 52                  JR   Z,insc   ; Tab is text
05A5   FE 08                  CP   8   
05A7   28 34                  JR   Z,bsp   
05A9   FE 02                  CP   2   
05AB   28 C7                  JR   Z,left   ; ^B
05AD   FE 06                  CP   6   
05AF   28 97                  JR   Z,right   ; ^F
05B1   FE 1B                  CP   1Bh   
05B3   28 9B                  JR   Z,esc   
05B5   E5                     PUSH   HL   ; a command key? Look it up
05B6   21 2A 06               LD   HL,cmds   
05B9   06 09                  LD   B,NCMD   
05BB   BE           ED2:      CP   (HL)   
05BC   23                     INC   HL   
05BD   28 07                  JR   Z,ed3   
05BF   23                     INC   HL   
05C0   23                     INC   HL   
05C1   10 F8                  DJNZ   ed2   
05C3   E1                     POP   HL   
05C4   18 D0                  JR   ed1   ; no: the key is ignored
05C6   7E           ED3:      LD   A,(HL)   
05C7   23                     INC   HL   
05C8   66                     LD   H,(HL)   
05C9   6F                     LD   L,A   
05CA   E3                     EX   (SP),HL   ; the command's address: fin returns to it
05CB                             ; fin: end the input line: CR LF and a NUL after it, and a new line on the
05CB                             ; terminal. Leaves BC -> the line and HL -> the NUL.
05CB   26 82        FIN:      LD   H,LETPAGE   
05CD   6B                     LD   L,E   
05CE   36 0D                  LD   (HL),13   
05D0   2C                     INC   L   
05D1   36 0A                  LD   (HL),10   
05D3   2D                     DEC   L   
05D4   CD 93 07               CALL   prl   ; (prints the CR LF)
05D7   36 00                  LD   (HL),0   
05D9   01 80 82               LD   BC,LINEBUF   
05DC   C9                     RET      
05DD                             ; Backspace, DEL: the character before the cursor goes. The cursor moves
05DD                             ; left, the rest of the line moves down over it, and the last place (now a
05DD                             ; space) is printed over along with the rest.
05DD   7D           BSP:      LD   A,L   
05DE   87                     ADD   A,A   
05DF   28 B5                  JR   Z,ed1   ; at the start
05E1   2D                     DEC   L   
05E2   3E 08                  LD   A,8   
05E4   EF                     RST   28h   
05E5   E5                     PUSH   HL   
05E6   2C           BS1:      INC   L   
05E7   7E                     LD   A,(HL)   
05E8   2D                     DEC   L   
05E9   77                     LD   (HL),A   
05EA   2C                     INC   L   
05EB   7D                     LD   A,L   
05EC   BB                     CP   E   
05ED   20 F7                  JR   NZ,bs1   
05EF   2D                     DEC   L   
05F0   36 20                  LD   (HL)," "   
05F2   E1                     POP   HL   
05F3   53                     LD   D,E   
05F4   1D                     DEC   E   
05F5   18 15                  JR   ic2   
05F7                             ; A character goes in at the cursor: it ripples up through the rest of the
05F7                             ; line, the cursor moves on, and the rest is printed again.
05F7   47           INSC:     LD   B,A   
05F8   7B                     LD   A,E   
05F9   FE FD                  CP   0FDh   
05FB   28 99                  JR   Z,ed1   ; the line is full: 125 characters
05FD   78                     LD   A,B   
05FE   EF                     RST   28h   
05FF   E5                     PUSH   HL   
0600   7E           IC1:      LD   A,(HL)   
0601   70                     LD   (HL),B   
0602   47                     LD   B,A   
0603   7D                     LD   A,L   
0604   2C                     INC   L   
0605   BB                     CP   E   
0606   20 F8                  JR   NZ,ic1   
0608   E1                     POP   HL   
0609   2C                     INC   L   
060A   1C                     INC   E   
060B   53                     LD   D,E   
060C   CD 11 06     IC2:      CALL   tail   
060F   18 85                  JR   ed1   
0611                             ; tail: print the line from the cursor to D (a low byte), and bring the
0611                             ; cursor back with backspaces. Nothing at all if the cursor is at D.
0611   4D           TAIL:     LD   C,L   
0612   7D           TA1:      LD   A,L   
0613   BA                     CP   D   
0614   28 05                  JR   Z,ta2   
0616   7E                     LD   A,(HL)   
0617   EF                     RST   28h   
0618   2C                     INC   L   
0619   18 F7                  JR   ta1   
061B   7D           TA2:      LD   A,L   
061C   B9                     CP   C   
061D   C8                     RET   Z   
061E   3E 08                  LD   A,8   
0620   EF                     RST   28h   
0621   2D                     DEC   L   
0622   18 F7                  JR   ta2   
0624                             ; ekey: wait for a key
0624   CD 06 FF     EKEY:     CALL   rawk   
0627   28 FB                  JR   Z,ekey   
0629   C9                     RET      
062A                             ; The command keys, and where each goes (after fin).
062A   0D           CMDS:     DB   13   
062B   7D 06                  DW   cret   
062D   07                     DB   7   ; ^G
062E   C5 06                  DW   crun   
0630   0C                     DB   12   ; ^L
0631   DB 06                  DW   clist   
0633   05                     DB   5   ; ^E
0634   53 06                  DW   cedln   
0636   12                     DB   18   ; ^R
0637   9C 07                  DW   cread   
0639   17                     DB   23   ; ^W
063A   C9 07                  DW   cwrite   
063C   0E                     DB   14   ; ^N
063D   45 06                  DW   cnew   
063F   16                     DB   22   ; ^V
0640   0B 07                  DW   cview   
0642   18                     DB   24   ; ^X
0643   09 FF                  DW   LEAVE   
0645                NCMD:     EQU   9   
0645                             ; ^N ^N: no program, if the next key is ^N too
0645   CD 24 06     CNEW:     CALL   ekey   
0648   FE 0E                  CP   14   
064A   20 04                  JR   NZ,ged0   
064C   AF                     XOR   A   
064D   32 00 83               LD   (PROG),A   
0650   C3 84 05     GED0:     JP   edit   
0653                             ; ^E: line n goes into the input line, to be changed. EDLN remembers which
0653                             ; line it was: Return puts the text back in its place.
0653   CD 34 02     CEDLN:    CALL   rdnum   
0656   E5                     PUSH   HL   
0657   CD 7B 07               CALL   find   ; HL -> the line, or the NUL if there is none
065A   D1                     POP   DE   
065B   7E                     LD   A,(HL)   
065C   B7                     OR   A   
065D   28 F1                  JR   Z,ged0   
065F   ED 53 3A 82            LD   (EDLN),DE   
0663   11 80 82               LD   DE,LINEBUF   
0666   7E           CE1:      LD   A,(HL)   ; copy it, and show it, up to its CR (or LF)
0667   FE 0D                  CP   13   
0669   28 0D                  JR   Z,ce2   
066B   FE 0A                  CP   10   
066D   28 09                  JR   Z,ce2   
066F   12                     LD   (DE),A   
0670   EF                     RST   28h   
0671   23                     INC   HL   
0672   1C                     INC   E   
0673   7B                     LD   A,E   
0674   FE FD                  CP   0FDh   ; (a longer line is cut at 125 characters)
0676   20 EE                  JR   NZ,ce1   
0678   EB           CE2:      EX   DE,HL   ; the cursor is at the line's end
0679   5D                     LD   E,L   
067A   C3 96 05               JP   ed1   
067D                             ; Return. If ^E put a line here, the text goes back in its place. If not:
067D                             ; a number and text is a line to put in, a number alone a line to take out,
067D                             ; and anything else is run where it is.
067D   E5           CRET:     PUSH   HL   ; the end of what was typed
067E   2A 3A 82               LD   HL,(EDLN)   
0681   7C                     LD   A,H   
0682   B5                     OR   L   
0683   28 07                  JR   Z,cr1   
0685   E5                     PUSH   HL   
0686   CD 6B 07               CALL   delln   
0689   E1                     POP   HL   
068A   18 13                  JR   ins   
068C   CD 34 02     CR1:      CALL   rdnum   ; HL = the number it starts with, BC -> after
068F   79                     LD   A,C   ; C is still 80h if there was no number:
0690   87                     ADD   A,A   ;   only then is twice it 0
0691   28 36                  JR   Z,st0p   ; no number: run the line
0693   0A                     LD   A,(BC)   
0694   FE 0D                  CP   13   
0696   20 06                  JR   NZ,cr2   
0698   D1                     POP   DE   ; the number alone: take that line out
0699   CD 6B 07               CALL   delln   
069C   18 24                  JR   gedit   
069E   03           CR2:      INC   BC   ; step over the one character after the number
069F                             ; Put the text at BC in as line n (in HL): open a gap of its length there,
069F                             ; CR and LF included, and copy it in.
069F   CD 7B 07     INS:      CALL   find   ; HL -> where it goes
06A2   D1                     POP   DE   ; the end of what was typed
06A3   7B                     LD   A,E   
06A4   91                     SUB   C   ; A = the length of the text, with its CR LF
06A5   C5                     PUSH   BC   ; the text
06A6   4F                     LD   C,A   
06A7   06 00                  LD   B,0   
06A9   C5                     PUSH   BC   ; its length
06AA   54                     LD   D,H   
06AB   5D                     LD   E,L   ; DE = where it goes
06AC   AF                     XOR   A   
06AD   4F                     LD   C,A   ; BC = 0: CPIR looks as far as it needs to
06AE   ED B1                  CPIR      ; HL -> one past the program's NUL
06B0   ED 52                  SBC   HL,DE   ; the number of bytes to move up, NUL included
06B2   44                     LD   B,H   
06B3   4D                     LD   C,L   
06B4   19                     ADD   HL,DE   
06B5   2B                     DEC   HL   ; HL -> the NUL
06B6   EB                     EX   DE,HL   
06B7   E3                     EX   (SP),HL   ; HL = the length; where it goes is kept
06B8   E5                     PUSH   HL   
06B9   19                     ADD   HL,DE   ; the NUL's new place
06BA   EB                     EX   DE,HL   
06BB   ED B8                  LDDR      ; move the rest of the program up
06BD   C1                     POP   BC   ; the length
06BE   D1                     POP   DE   ; where it goes
06BF   E1                     POP   HL   ; the text
06C0   ED B0                  LDIR      
06C2   C3 84 05     GEDIT:    JP   edit   
06C5                             ; ^G: run the program. st0p: run the typed line (BC -> it).
06C5   01 00 83     CRUN:     LD   BC,PROG   
06C8   3E                     DB   3Eh   ; (LD A,n: steps over the POP)
06C9   E1           ST0P:     POP   HL   ; (the end of what was typed)
06CA                             ; st0: start running at BC. The heap starts after the stored program's NUL.
06CA   21 00 83     ST0:      LD   HL,PROG   
06CD   AF                     XOR   A   
06CE   BE           ST1:      CP   (HL)   
06CF   23                     INC   HL   
06D0   20 FC                  JR   NZ,st1   
06D2   22 7C 82               LD   (HEAP),HL   
06D5                          ENDIF      
06D5                          IF   EDITOR*CHECKED   
06D5   E7                     RST   20h   ; minus the heap"s first address: "_' may not
06D6   22 38 82               LD   (NPEND),HL   ;   release below it
06D9                          ENDIF      
06D9                          IF   EDITOR   
06D9   E1                     POP   HL   ; TOS: the data stack is as the last line left it
06DA   F7                     RST   30h   ; (its return address is thrown away)
06DB                             ; ^L: list from line n. DE = the number of the line at HL.
06DB   CD 34 02     CLIST:    CALL   rdnum   ; HL = n, or 0 if there was none:
06DE   7C                     LD   A,H   
06DF   B5                     OR   L   
06E0   20 01                  JR   NZ,li0   
06E2   2C                     INC   L   ;   then from line 1
06E3   E5           LI0:      PUSH   HL   
06E4   CD 7B 07               CALL   find   
06E7   D1                     POP   DE   
06E8   7E           LI1:      LD   A,(HL)   
06E9   B7                     OR   A   
06EA   28 D6                  JR   Z,gedit   ; the end of the text
06EC   CD 06 FF               CALL   rawk   
06EF   28 09                  JR   Z,li3   ; no key: carry on
06F1   FE 03                  CP   3   
06F3   C4 24 06               CALL   NZ,ekey   ; any key but Ctrl-C: wait for one more
06F6   FE 03                  CP   3   
06F8   28 C8                  JR   Z,gedit   ; Ctrl-C, first or second, ends the list
06FA   E5           LI3:      PUSH   HL   
06FB   D5                     PUSH   DE   
06FC   EB                     EX   DE,HL   
06FD   CD A0 02               CALL   pdec   ; the line's number,
0700   3E 20                  LD   A," "   
0702   EF                     RST   28h   ;   a space,
0703   D1                     POP   DE   
0704   E1                     POP   HL   
0705   13                     INC   DE   
0706   CD 93 07               CALL   prl   ;   and the line
0709   18 DD                  JR   li1   
070B                             ; ^V: view.
070B   CD 31 05     CVIEW:    CALL   pmsg   
070E   42 38 53 5A 38 30 45   DB   "B8SZ80E"   
0715                          ENDIF      
0715                          IF   EDITOR*CHECKED   
0715   43                     DB   "C"   
0716                          ENDIF      
0716                          IF   EDITOR   
0716   20 32 30 32 36 2D 31 31 2D 32 31 22 DB   " 2026-11-21",22h   
0722   CD BE 04               CALL   pstk   ; both stacks
0725   21 00 83               LD   HL,PROG   
0728   11 FF FF               LD   DE,0FFFFh   
072B   13           CV1:      INC   DE   ; count the lines, and find the end
072C   CD 89 07               CALL   nxl   
072F   20 FA                  JR   NZ,cv1   
0731   E5                     PUSH   HL   ; the NUL
0732   D5                     PUSH   DE   ; the lines
0733   11 00 7D               LD   DE,(0-PROG)&0FFFFh   
0736   19                     ADD   HL,DE   
0737   CD 2B 05               CALL   pnl   
073A   50 72 6F 67 20 22      DB   "Prog ",22h   
0740   CD A0 02               CALL   pdec   ; the program's size
0743   E1                     POP   HL   
0744   CD 2B 05               CALL   pnl   
0747   4C 69 6E 65 73 20 22   DB   "Lines ",22h   
074E   CD A0 02               CALL   pdec   
0751   D1                     POP   DE   
0752                          ENDIF      
0752                          IF   EDGEN   
0752   21 FF EF               LD   HL,HEAPLIM*256-1   
0755                          ENDIF      
0755                          IF   EDITOR*CPM   
                              LD   A,(0007h)   ; the BDOS page is the limit
                              LD   H,A   
                              LD   L,0   
                              DEC   HL   
0755                          ENDIF      
0755                          IF   EDITOR   
0755   B7                     OR   A   
0756   ED 52                  SBC   HL,DE   
0758   CD 2B 05               CALL   pnl   
075B   46 72 65 65 20 22      DB   "Free ",22h   
0761   CD A0 02               CALL   pdec   ; the room left for text and heap
0764   CD 2B 05               CALL   pnl   
0767   22                     DB   22h   
0768   C3 84 05     GED1:     JP   edit   
076B                             ; delln: take line n (in HL) out: copy everything after it down over it.
076B   CD 7B 07     DELLN:    CALL   find   
076E   54                     LD   D,H   
076F   5D                     LD   E,L   
0770   CD 89 07               CALL   nxl   ; HL -> the next line
0773   7E           DE1:      LD   A,(HL)   
0774   12                     LD   (DE),A   
0775   23                     INC   HL   
0776   13                     INC   DE   
0777   B7                     OR   A   
0778   20 F9                  JR   NZ,de1   
077A   C9                     RET      
077B                             ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
077B                             ; of the text if there are fewer lines (or the number is 0). Keeps BC.
077B   EB           FIND:     EX   DE,HL   
077C   21 00 83               LD   HL,PROG   
077F   1B           FI1:      DEC   DE   
0780   7A                     LD   A,D   
0781   B3                     OR   E   
0782   C8                     RET   Z   
0783   CD 89 07               CALL   nxl   
0786   20 F7                  JR   NZ,fi1   
0788   C9                     RET      
0789                             ; nxl: step HL over one line, to just past its LF (and return not-zero), or
0789                             ; stop at the NUL that ends the text (and return zero).
0789   7E           NXL:      LD   A,(HL)   
078A   B7                     OR   A   
078B   C8                     RET   Z   
078C   23                     INC   HL   
078D   FE 0A                  CP   10   
078F   20 F8                  JR   NZ,nxl   
0791   B7                     OR   A   
0792   C9                     RET      
0793                             ; prl: print the line at HL, to its LF; HL -> just past it.
0793   7E           PRL:      LD   A,(HL)   
0794   EF                     RST   28h   
0795   7E                     LD   A,(HL)   
0796   23                     INC   HL   
0797   FE 0A                  CP   10   
0799   20 F8                  JR   NZ,prl   
079B   C9                     RET      
079C                          ENDIF      
079C                          IF   EDGEN   
079C                             ; ^R, generic: what comes in from now until ^Z is the program. A CR is
079C                             ; stored as CR LF; a LF right after a line end is dropped (it is the CR's
079C                             ; own, or an empty line's), and a LF anywhere else ends a line too. A last
079C                             ; line with no end is given one. Nothing is echoed, and there is no check
079C                             ; for running out of memory.
079C   21 FF 82     CREAD:    LD   HL,PROG-1   
079F   36 0A                  LD   (HL),10   ; (as if a line had just ended: the byte is
07A1   23                     INC   HL   ;   the line buffer's last, and spare)
07A2   CD 24 06     RD1:      CALL   ekey   
07A5   4F                     LD   C,A   
07A6   FE 1A                  CP   1Ah   
07A8   20 02                  JR   NZ,rd2   
07AA   3E 0A                  LD   A,10   ; ^Z ends the last line, as a LF would
07AC   FE 0A        RD2:      CP   10   
07AE   20 07                  JR   NZ,rd3   
07B0   2B                     DEC   HL   
07B1   BE                     CP   (HL)   
07B2   23                     INC   HL   
07B3   28 0B                  JR   Z,rd4   ; straight after a line end: dropped
07B5   3E 0D                  LD   A,13   ; anywhere else it ends the line
07B7   77           RD3:      LD   (HL),A   
07B8   23                     INC   HL   
07B9   FE 0D                  CP   13   
07BB   20 03                  JR   NZ,rd4   
07BD   36 0A                  LD   (HL),10   ; after a CR goes a LF
07BF   23                     INC   HL   
07C0   79           RD4:      LD   A,C   
07C1   FE 1A                  CP   1Ah   
07C3   20 DD                  JR   NZ,rd1   
07C5   36 00                  LD   (HL),0   
07C7   18 9F                  JR   ged1   
07C9                             ; ^W, generic: the text is printed as it is, for the terminal to capture.
07C9   21 00 83     CWRITE:   LD   HL,PROG   
07CC   7E           CW1:      LD   A,(HL)   
07CD   B7                     OR   A   
07CE   28 98                  JR   Z,ged1   
07D0   EF                     RST   28h   
07D1   23                     INC   HL   
07D2   18 F8                  JR   cw1   
07D4                          ENDIF      
07D4                          IF   EDITOR*CPM   
                    CFCB:     EQU   005Ch   ; the file's name is kept here, where the CCP
                                 ;   put the one from the command line
                                 ; ^R, CP/M: read the file. A name typed before the key is the file's name
                                 ; from now on.
                    CREAD:    CALL   setname   
                              CALL   load   
                              JP   edit   
                                 ; ^W, CP/M: write the file: delete the old one, make it anew, write the
                                 ; text in records of 128 bytes, and close it. The text's NUL and the 127
                                 ; bytes after it are set to ^Z meanwhile, which pads the last record. (A
                                 ; full disk or directory is not noticed: the calls fail and that is all.)
                    CWRITE:   CALL   setname   
                              LD   C,19   ; delete
                              CALL   fbdos   
                              LD   C,22   ; make
                              CALL   fbdos   
                              LD   HL,PROG   
                              XOR   A   
                    CW1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,cw1   
                              DEC   HL   ; HL -> the NUL
                              PUSH   HL   
                              LD   B,128   
                    CW2:      LD   (HL),1Ah   
                              INC   HL   
                              DJNZ   cw2   
                              POP   HL   
                              LD   DE,PROG   
                    CW3:      LD   A,E   ; a record that starts before the end is written
                              SUB   L   
                              LD   A,D   
                              SBC   A,H   
                              JR   NC,cw4   
                              PUSH   HL   
                              LD   C,21   ; write, from where the record lies
                              CALL   frec   
                              POP   HL   
                              JR   cw3   
                    CW4:      LD   (HL),0   ; the NUL again
                              LD   C,16   ; close
                              CALL   fbdos   
                              JP   edit   
                                 ; frec: BDOS function C (read or write a record) with the 128 bytes at DE.
                                 ; Returns A = the BDOS's answer, HL = DE and DE = DE + 128.
                    FREC:     PUSH   DE   
                              PUSH   BC   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              POP   BC   
                              CALL   fbdos   
                              POP   HL   
                              LD   DE,128   
                              EX   DE,HL   
                              ADD   HL,DE   
                              EX   DE,HL   
                              RET      
                                 ; setname: if a name was typed (the line does not start with its CR), put it
                                 ; in the FCB: up to 8 characters, a dot, up to 3 more, in capitals. The drive
                                 ; is the current one. Then, name or no name, clear the FCB after the name,
                                 ; as it must be before a file is opened or made.
                    SETNAME:   LD   DE,LINEBUF   
                              LD   A,(DE)   
                              CP   13   
                              JR   Z,fcbclr   
                              LD   HL,CFCB   
                              LD   (HL),0   ; the current drive
                              LD   B,11   
                    SN1:      INC   L   
                              LD   (HL)," "   
                              DJNZ   sn1   
                              LD   L,CFCB+1   
                    SN2:      LD   A,(DE)   
                              INC   DE   
                              CP   13   
                              JR   Z,fcbclr   
                              CP   "."   
                              JR   NZ,sn3   
                              LD   L,CFCB+9   ; the type
                              JR   sn2   
                    SN3:      CP   "a"   
                              JR   C,sn4   
                              AND   5Fh   ; a capital
                    SN4:      LD   (HL),A   
                              INC   L   
                              JR   sn2   
                    FCBCLR:   LD   HL,CFCB+12   
                              LD   B,24   
                    FC1:      LD   (HL),0   
                              INC   HL   
                              DJNZ   fc1   
                              RET      
                                 ; fbdos: BDOS function C on the file
                    FBDOS:    LD   DE,CFCB   
                              JP   BDOS   
                                 ; load: read the file into PROG. No such file: no program. The text ends at
                                 ; the file"s first ^Z (1Ah), which pads a text file"s last record; one more
                                 ; goes after the last record, so the search always stops. And every line
                                 ; must end in LF: a last line without one is given a CR LF. (The FCB is
                                 ; clear after its name: the CCP left it so, or setname did.)
                    LOAD:     LD   C,15   ; open (no such file: the first read fails
                              CALL   fbdos   ;   too)
                              LD   DE,PROG   
                    LD1:      LD   C,20   ; read the next 128 bytes
                              CALL   frec   
                              OR   A   
                              JR   Z,ld1   
                              LD   (HL),1Ah   ; (HL = where the record that failed would be)
                              LD   HL,PROG-1   
                              LD   A,10   ; (a file with no text needs nothing added)
                    TR1:      INC   HL   
                              LD   E,A   ; E = the character before this one
                              LD   A,(HL)   
                              CP   1Ah   
                              JR   NZ,tr1   
                              LD   A,E   
                              CP   10   
                              JR   Z,tr2   
                              LD   (HL),13   
                              INC   HL   
                              LD   (HL),10   
                              INC   HL   
                    TR2:      LD   (HL),0   
                              RET      
07D4                          ENDIF      
07D4                             ; =============================================================================
07D4                          IF   CPM   
                                 ; The RAM pages follow the image; the heap may grow to the BDOS.
                    START:       
07D4                          ENDIF      
07D4                          IF   CPM*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
                                 ; is held back.
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
07D4                          ENDIF      
07D4                          IF   CPM   
                              LD   HL,vecs   ; the RST routines go down into page zero
                              LD   DE,0008h   
                              LD   BC,vecend-vecs   
                              LDIR      
07D4                          ENDIF      
07D4                          IF   CPM*EDITOR   
                              CALL   load   ; the file named on the command line
                              JP   edit0   
07D4                          ENDIF      
07D4                          IF   CPM*(1-EDITOR)   
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:      LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
                              JP   st2   
07D4                          ENDIF      
07D4                          IF   CPM   
                                 ; RAM pages, after the image
                    RSPAGE:   EQU   (imgend + 255) / 256   
                    DSPAGE:   EQU   RSPAGE + 1   
                    LETPAGE:   EQU   RSPAGE + 2   
                    PROG:     EQU   LETPAGE*256 + 256   
07D4                          ENDIF      
