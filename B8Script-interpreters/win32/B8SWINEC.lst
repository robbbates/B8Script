  2057 00000DB4 ????????            <1> v_cnt:  resd    1               ; a count for ReadFile and the like
  2058 00000DB8 ????????            <1> v_hin:  resd    1               ; the standard input handle
  2059 00000DBC ????????            <1> v_htm:  resd    1               ; the timer, or 0 (must follow v_hin)
  2060 00000DC0 ????????            <1> v_outh: resd    1               ; the handle putc writes to
  2061 00000DC4 ????????            <1> v_dstop:resd    1               ; ESP for the empty data stack
  2062 00000DC8 ??                  <1> v_iscon:resb    1               ; non-zero if the input is a console
  2063 00000DC9 ??                  <1> v_pcnt: resb    1               ; the break key's countdown
  2064 00000DCA ????????            <1> v_mode: resd    1               ; the console's input mode at the start
  2065 00000DCE ????????            <1> v_npend:resd    1               ; the heap's first address (checked '_')
  2066 00000DD2 ????????            <1> v_skat: resd    1               ; where the skip started (checked N)
  2067 00000DD6 ????????            <1> v_edln: resd    1               ; the editor: the line ^E put in the input
  2068                              <1> v_end:
  2069                              <1>         times   -((v_end-next) > 128) db 0      ; (an error if out of reach)
  2070                              <1>         times   -((next-iat) > 128) db 0
