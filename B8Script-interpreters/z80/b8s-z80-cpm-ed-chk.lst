                              CALL   CONAT   
                              POP   HL   
                              JP   PRAGAIN   
                                 ; With ANSI = 0 the machine's routines do the rest.
                    PHIDE:    XOR   A   ; /`  (A = 0: hide)
                              JP   CONCUR   
                    PCON:     JP   Z,CONCLS   ; /{
                              CP   2   
                              JP   Z,CONEOL   ; /}
                              JP   CONCUR   ; /|  (A = 1: show)
0361                          ENDIF      
0361                          IF   ANS   
0361   D5                     PUSH   DE   
0362   CD A1 03               CALL   csi   ; ESC [ row+1 ; col+1 H (ANSI counts from 1)
0365   23                     INC   HL   
0366   CD 50 04               CALL   pdec   
0369   3E 3B                  LD   A,";"   
036B   EF                     RST   28h   
036C   E1                     POP   HL   
036D   23                     INC   HL   
036E   CD 50 04               CALL   pdec   
0371   3E 48                  LD   A,"H"   
0373   EF                     RST   28h   
0374   E1                     POP   HL   
0375   C3 B5 02               JP   PRAGAIN   
0378                             ; With ANSI = 1 they are sequences. The carry is clear on the way in.
0378   3D           PCON:     DEC   A   
0379   28 0E                  JR   Z,pshow   ; /|
037B   3E 4B                  LD   A,"K"   
037D   F2 9C 03               JP   P,csia   ; /}  ESC [ K
0380   3E 48                  LD   A,"H"   ; /{  ESC [ H ESC [ J
0382   CD 9C 03               CALL   csia   
0385   3E 4A                  LD   A,"J"   
0387   18 13                  JR   csia   
0389   1E 68        PSHOW:    LD   E,"h"   ; /|  ESC [ ? 2 5 h
038B   DA                     DB   0DAh   ; (JP C,nn: with no carry it steps over two bytes)
038C   1E 6C        PHIDE:    LD   E,"l"   ; /`  ESC [ ? 2 5 l
038E   3E 3F                  LD   A,"?"   
0390   CD 9C 03               CALL   csia   
0393   3E 32                  LD   A,"2"   
0395   EF                     RST   28h   
0396   3E 35                  LD   A,"5"   
0398   EF                     RST   28h   
0399   7B                     LD   A,E   
039A   EF                     RST   28h   
039B   C9                     RET      
039C                             ; csia: ESC [ and then A. csi: ESC [, keeping A.
039C   CD A1 03     CSIA:     CALL   csi   
039F   EF                     RST   28h   
03A0   C9                     RET      
03A1   F5           CSI:      PUSH   AF   
03A2   3E 1B                  LD   A,27   
03A4   EF                     RST   28h   
03A5   3E 5B                  LD   A,"["   
03A7   EF                     RST   28h   
03A8   F1                     POP   AF   
03A9   C9                     RET      
03AA                          ENDIF      
03AA                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
03AA                             ; Uses A; keeps BC (the IP) itself. The dividend shifts up through A:C while
03AA                             ; the quotient bits arrive at the bottom of C.
03AA                             ; Dividing by 2 is one shift (the spec wants that fast).
03AA   7B           UDIV:     LD   A,E   
03AB   EE 02                  XOR   2   
03AD   B2                     OR   D   
03AE   20 07                  JR   NZ,udv0   
03B0   CB 3C                  SRL   H   
03B2   CB 1D                  RR   L   ; the quotient
03B4   8F                     ADC   A,A   
03B5   5F                     LD   E,A   ; the remainder: the bit that fell out (D is 0)
03B6   C9                     RET      
03B7   C5           UDV0:     PUSH   BC   
03B8   7C                     LD   A,H   
03B9   4D                     LD   C,L   
03BA   21 00 00               LD   HL,0   
03BD   06 10                  LD   B,16   
03BF   CB 21        UDV1:     SLA   C   
03C1   17                     RLA      
03C2   ED 6A                  ADC   HL,HL   
03C4   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
03C6   30 02                  JR   NC,udv2   ;   always fits in 16 bits
03C8   19                     ADD   HL,DE   ; too much: put it back, and cancel the
03C9   0D                     DEC   C   ;   INC below
03CA   0C           UDV2:     INC   C   ; a quotient bit
03CB   10 F2                  DJNZ   udv1   
03CD   EB                     EX   DE,HL   ; DE = remainder
03CE   67                     LD   H,A   
03CF   69                     LD   L,C   ; HL = quotient
03D0   C1                     POP   BC   
03D1   C9                     RET      
03D2                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
03D2                             ; non-digit. Values wrap at 16 bits, as the spec says.
03D2   21 00 00     RDNUM:    LD   HL,0   
03D5   0A           RDN1:     LD   A,(BC)   
03D6   D6 30                  SUB   "0"   
03D8   FE 0A                  CP   10   
03DA   D0                     RET   NC   
03DB   03                     INC   BC   
03DC   54                     LD   D,H   
03DD   5D                     LD   E,L   
03DE   29                     ADD   HL,HL   
03DF   29                     ADD   HL,HL   
03E0   19                     ADD   HL,DE   
03E1   29                     ADD   HL,HL   ; HL * 10
03E2   5F                     LD   E,A   
03E3   16 00                  LD   D,0   
03E5   19                     ADD   HL,DE   
03E6   18 ED                  JR   rdn1   
03E8                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
03E8                             ; the next character, so "/"" does not end it. Leaves A = 22h.
03E8                          IF   1-CHECKED   
                    SS0:      INC   BC   
                    SKIPSTR:   LD   A,(BC)   
                              INC   BC   
                              CP   "/"   
                              JR   Z,ss0   
                              CP   22h   
                              JR   NZ,skipstr   
                              RET      
03E8                          ENDIF      
03E8                          IF   CHECKED   
03E8                             ; The checked build never steps over a NUL: if the text runs out first it
03E8                             ; returns A = 0 with the IP on the NUL.
03E8   0A           SKIPSTR:   LD   A,(BC)   
03E9   B7                     OR   A   
03EA   C8                     RET   Z   
03EB   03                     INC   BC   
03EC   FE 22                  CP   22h   
03EE   C8                     RET   Z   
03EF   FE 2F                  CP   "/"   
03F1   20 F5                  JR   NZ,skipstr   
03F3   0A                     LD   A,(BC)   ; the escaped character
03F4   B7                     OR   A   
03F5   C8                     RET   Z   
03F6   03                     INC   BC   
03F7   18 EF                  JR   skipstr   
03F9                          ENDIF      
03F9                             ; skip: read past text to the closer at this level, and return A = 0 if it
03F9                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
03F9                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
03F9                             ; no closer; anything else that runs into the NUL had unbalanced brackets
03F9                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
03F9                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
03F9                             ; 
03F9                             ; The checked build also looks at the character the skip was started by,
03F9                             ; which is always the one just before where it starts: "(" must end at ")",
03F9                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
03F9                             ; quote counts as running into it. "\" takes either closer. IX keeps the
03F9                             ; place where the skip started, for the report.
03F9                SKIP:        
03F9                          IF   CHECKED   
03F9   C5                     PUSH   BC   
03FA   DD E1                  POP   IX   
03FC   0B                     DEC   BC   
03FD   0A                     LD   A,(BC)   
03FE   03                     INC   BC   
03FF   5F                     LD   E,A   ; E = the opener: ( [ or \
0400                          ENDIF      
0400   16 00                  LD   D,0   
0402   14           SK3:      INC   D   ; an opener: one deeper
0403   0A           SK1:      LD   A,(BC)   
0404                          IF   1-CHECKED   
                              INC   BC   
                              OR   A   
                              JP   Z,SKEND   ; (the end of the program)
0404                          ENDIF      
0404                          IF   CHECKED   
0404   B7                     OR   A   
0405   28 22                  JR   Z,sk6   ; (the IP stays on the NUL)
0407   03                     INC   BC   
0408                          ENDIF      
0408   FE 22                  CP   22h   
040A   CC E8 03               CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
040D   D6 28                  SUB   "("   ;   (or 0, and then the NUL is read next)
040F   28 F1                  JR   Z,sk3   
0411   3D                     DEC   A   ; ")"
0412   28 08                  JR   Z,sk4   
0414   D6 32                  SUB   "["-")"   
0416   28 EA                  JR   Z,sk3   
0418   FE 02                  CP   "]"-"["   
041A   20 E7                  JR   NZ,sk1   
041C   15           SK4:      DEC   D   
041D                          IF   1-CHECKED   
                              RET   Z   ; the closer at this level
                              JR   sk1   
041D                          ENDIF      
041D                          IF   CHECKED   
041D   20 E4                  JR   NZ,sk1   
041F   57                     LD   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
0420   AB                     XOR   E   ;   opener is 0 for "(" and 1 for "[", and only
0421   E6 06                  AND   6   ;   "\" has bit 2: so this is 2 for the wrong
0423   FE 02                  CP   2   ;   closer, and only then
0425   7A                     LD   A,D   
0426   C0                     RET   NZ   
0427   18 05                  JR   sk7   
0429   CB 53        SK6:      BIT   2,E   ; the text ran out:
042B   C2 48 06               JP   NZ,SKEND   ;   "\" with no closer ends the program
042E   DD E5        SK7:      PUSH   IX   ; N. The place is the opener
0430   C1                     POP   BC   
0431   3E 4E                  LD   A,"N"   
0433   C3 41 05               JP   errp   ; (errp drops skip's return address)
0436                          ENDIF      
0436                             ; =============================================================================
0436                             ;  Dispatch table: the low byte of each handler's address, in code order
0436                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
0436                             ;  It must not cross a page (the dispatcher only adds to its low byte).
0436                             ; =============================================================================
0436                             ; The handlers of the first NPG1 characters start in the image's second page.
0436                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
0436                             ; differs between the builds, so the count is worked out here.
0436                             ; (One division to a line: asm80 only rounds down when it stores a value.)
0436                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
0436                PGBRK:    EQU   (h_break-BASE)/256   
0436                PGDEF:    EQU   (h_def-BASE)/256   
0436                PGFET:    EQU   (h_fetch-BASE)/256   
0436                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
0436                          IF   (1-TABP0)*(1-PTLATE)   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0436                          ENDIF      
0436                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
0436                             ; and return its value in A with the carry set; otherwise leave the IP and
0436                             ; return with the carry clear.
0436   0A           HEXC:     LD   A,(BC)   
0437   D6 30                  SUB   "0"   
0439   FE 0A                  CP   10   
043B   38 09                  JR   C,hc1   
043D   E6 DF                  AND   0DFh   
043F   D6 11                  SUB   11h   
0441   FE 06                  CP   6   
0443   D0                     RET   NC   
0444   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
0446   03           HC1:      INC   BC   
0447   C9                     RET      
0448                             ; psgn: print HL as a signed number. Keeps BC.
0448   CB 7C        PSGN:     BIT   7,H   
044A   28 04                  JR   Z,pdec   
044C   3E 2D                  LD   A,"-"   
044E   EF                     RST   28h   
044F   E7                     RST   20h   
0450                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
0450                             ; Keeps BC.
0450   11 0A 00     PDEC:     LD   DE,10   
0453   CD AA 03               CALL   udiv   ; HL = HL / 10, E = the last digit
0456   7B                     LD   A,E   
0457   F5                     PUSH   AF   
0458   7C                     LD   A,H   
0459   B5                     OR   L   
045A   C4 50 04               CALL   NZ,pdec   
045D   F1                     POP   AF   
045E   C6 30                  ADD   A,"0"   
0460   EF                     RST   28h   
0461   C9                     RET      
0462                             ; (The table goes here instead in the builds where, before psgn, it would
0462                             ; cross a page: PTLATE.)
0462                          IF   (1-TABP0)*PTLATE   
0462                PTAB:        
0462                          ;*Macro unroll:  PTABLE
0462   9F                     DB   h_store & 0FFh   
0463   A7                     DB   h_str & 0FFh   
0464   BC                     DB   h_num & 0FFh   
0465   B2                     DB   h_print & 0FFh   
0466   97                     DB   h_swap & 0FFh   
0467   3C                     DB   h_and & 0FFh   
0468   B9                     DB   h_emit & 0FFh   
0469   18                     DB   h_open & 0FFh   
046A   20                     DB   h_close & 0FFh   
046B   5D                     DB   h_mul & 0FFh   
046C   33                     DB   h_add & 0FFh   
046D   D8                     DB   h_cfetch & 0FFh   
046E   2B                     DB   h_sub & 0FFh   
046F   99                     DB   h_cstore & 0FFh   
0470   71                     DB   h_div & 0FFh   
0471   95                     DB   h_dup & 0FFh   
0472   9E                     DB   h_drop & 0FFh   
0473   44                     DB   h_lt & 0FFh   
0474   53                     DB   h_eq & 0FFh   
0475   45                     DB   h_gt & 0FFh   
0476   C0                     DB   h_key & 0FFh   
0477   13                     DB   h_fetch & 0FFh   
0478   EF                     DB   h_def & 0FFh   
0479   E2                     DB   h_break & 0FFh   
047A   DE                     DB   h_ret & 0FFh   
047B   76                     DB   h_xor & 0FFh   
047C   89                     DB   h_alloc & 0FFh   
047D   C8                     DB   h_grave & 0FFh   
047E   2C                     DB   h_tor & 0FFh   
047F   7E                     DB   h_or & 0FFh   
0480   1C                     DB   h_fromr & 0FFh   
0481   86                     DB   h_not & 0FFh   
0482                PTABEND:      
0482                          ENDIF      
0482                             ; =============================================================================
0482                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
0482                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
0482                             ;  (RST 28h) prints A. Both keep BC, DE, HL and HL'. In the generic build
0482                             ;  they are the host's KEY and CONOUT routines themselves.
0482                             ; 
0482                             ;  A running program reads the keyboard only through getk and pollk, which
0482                             ;  between them give the break key its rules:
0482                             ;    - Ctrl-C stops the program;
0482                             ;    - any other key that the break check reads is held in KEYBUF for the
0482                             ;      next "?", and a newer one takes its place;
0482                             ;    - "?" (getk) takes the held key first;
0482                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
0482                             ;      key like any other, but two of them within about 250 ms still stop it.
0482                             ;  Both are called straight from a handler, never from a routine under one:
0482                             ;  the checked build's report counts on finding one return address above the
0482                             ;  data stack.
0482                             ; =============================================================================
0482                          IFN   CPM   
                    RAWK:     EQU   KEY   
0482                          ENDIF      
0482                             ; pollk: the break check (see rpushn).
0482   CD C0 04     POLLK:    CALL   rawk   
0485   C8                     RET   Z   ; no key
0486   32 7A 0B               LD   (KEYBUF),A   ; held for the next "?"
0489   FE 03        PK1:      CP   3   ; (getk joins here)
048B   C0                     RET   NZ   
048C                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
048C                             ; the program has turned it off, wait about 250 ms for one more key: a
048C                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
048C                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
048C   3A 7B 0B     CTLC:     LD   A,(BRKOFF)   
048F   B7                     OR   A   
0490   CA 3F 05     CT0:      JP   Z,brk   
0493   D5                     PUSH   DE   
0494   11 10 27               LD   DE,250*MSLOOP   
0497   CD C0 04     CT1:      CALL   rawk   
049A   20 05                  JR   NZ,ct2   
049C   1B                     DEC   DE   
049D   7A                     LD   A,D   
049E   B3                     OR   E   
049F   20 F6                  JR   NZ,ct1   
04A1   D1           CT2:      POP   DE   ; A = the second key, or 0 if none came
04A2   FE 03                  CP   3   
04A4   28 EA                  JR   Z,ct0   ; (the zero flag takes the JP there)
04A6   B7                     OR   A   
04A7   28 03                  JR   Z,ct3   
04A9   32 7A 0B               LD   (KEYBUF),A   
04AC   3E 03        CT3:      LD   A,3   
04AE   B7                     OR   A   
04AF   C9                     RET      
04B0                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
04B0   E5           GETK:     PUSH   HL   ; a held key goes first, and is taken out of
04B1   21 7A 0B               LD   HL,KEYBUF   ;   the buffer
04B4   7E                     LD   A,(HL)   
04B5   36 00                  LD   (HL),0   
04B7   E1                     POP   HL   
04B8   B7                     OR   A   
04B9   C0                     RET   NZ   
04BA   CD C0 04               CALL   rawk   
04BD   C8                     RET   Z   
04BE   18 C9                  JR   pk1   ; Ctrl-C? If not, that is the key
04C0                          IF   (1-CHECKED)*(1-EDITOR)   
                    BRK:      EQU   endprog   ; the unchecked build stops without a word
04C0                          ENDIF      ;   (with the editor, both stacks are cleared);
04C0                          IF   (1-CHECKED)*EDITOR   
                    BRK:      EQU   edit0   
04C0                          ENDIF      
04C0                          IF   CHECKED   
04C0                BRK:      EQU   e_break   ;   the checked build reports B
04C0                          ENDIF      
04C0                          IF   CPM   
04C0   3E FF        RAWK:     LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
04C2                             ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
04C2                             ; printing and could swallow a key that BDOS 6 then never sees.
04C2   D5           PUTC:     PUSH   DE   
04C3   E5                     PUSH   HL   
04C4   5F                     LD   E,A   
04C5   3E 06                  LD   A,6   
04C7   CD CE 04               CALL   bdosx   
04CA   E1                     POP   HL   
04CB   D1                     POP   DE   
04CC   B7                     OR   A   ; (for getk)
04CD   C9                     RET      
04CE                             ; bdosx: call BDOS function A with DE, keeping BC and HL'
04CE   C5           BDOSX:    PUSH   BC   
04CF   D9                     EXX      
04D0   E5                     PUSH   HL   
04D1   D9                     EXX      
04D2   4F                     LD   C,A   
04D3   CD 05 00               CALL   BDOS   
04D6   D9                     EXX      
04D7   E1                     POP   HL   
04D8   D9                     EXX      
04D9   C1                     POP   BC   
04DA   C9                     RET      
04DB                          ENDIF      
04DB                             ; =============================================================================
04DB                             ;  Checked build: the checks and the error report
04DB                             ; =============================================================================
04DB                          IF   CHECKED   
04DB                             ; chkstk: both stacks are checked once per character, not in every handler.
04DB                             ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
04DB                             ; the constant carries if it is above (cells were popped that were never
04DB                             ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
04DB                             ; a character late at most: the bytes above DSTOP and the guard band below
04DB                             ; the page take what happens meanwhile. DE is free between characters.
04DB   EB           CHKSTK:   EX   DE,HL   
04DC   21 05 F5               LD   HL,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
04DF   39                     ADD   HL,SP   
04E0   EB                     EX   DE,HL   
04E1   38 1D                  JR   C,e_under   
04E3   14                     INC   D   
04E4   20 16                  JR   NZ,e_over   
04E6   D9                     EXX      ; the return stack: in its page (or it has
04E7   7C                     LD   A,H   ;   overflowed), and not above its empty
04E8   FE 09                  CP   RSPAGE   ;   position (an underflow stays inside the
04EA   7D                     LD   A,L   ;   page, in the guard band)
04EB   D9                     EXX      
04EC   20 0B                  JR   NZ,e_rover   
04EE   FE E1                  CP   RSTOP&0FFh+1   
04F0   D8                     RET   C   
04F1   D9                     EXX      ; return stack underflow: it counts as empty
04F2   2E E0                  LD   L,RSTOP&0FFh   ;   (H is right: the pointer is in its page)
04F4   D9                     EXX      
04F5   3E 72                  LD   A,"r"   
04F7   18 48                  JR   errp   
04F9   3E 52        E_ROVER:   LD   A,"R"   ; return stack overflow
04FB   11                     DB   11h   ; (LD DE,nn hides the next entry)
04FC   3E 53        E_OVER:   LD   A,"S"   ; data stack overflow
04FE   18 41                  JR   errp   
0500   31 FC 0A     E_UNDER:   LD   SP,DSTOP   ; data stack underflow: it counts as empty
0503   3E 73                  LD   A,"s"   
0505   18 4A                  JR   error   
0507                             ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
0507                             ; was never defined still holds 0000h, and the byte there is a reserved one
0507                             ; in every build (AFh or C3h): if the IP is in page zero, this was a call of
0507                             ; an undefined word. The call is undone, so the place is the call itself.
0507   04           E_HI:     INC   B   
0508   10 3F                  DJNZ   e_resv   ; (B is as it was, and is not 0)
050A   CF                     RST   08h   
050B   42                     LD   B,D   
050C   4B                     LD   C,E   
050D   3E 55                  LD   A,"U"   
050F   18 40                  JR   error   
0511                             ; chkhp: HL = the new heap top, DE = the old one, the carry is from adding
0511                             ; the count. Stop if the top is not below the limit page, or is below the
0511                             ; program's end.
0511                CHKHP:       
0511                          ENDIF      
0511                          IF   CHECKED*CPM   
0511                             ; With this much room a top that wrapped round can land back in
0511                             ; range, so the add is tested too: growing (A, the count's high
0511                             ; byte, is positive) must not carry, and releasing must.
0511   1F                     RRA      ; the carry comes in above the sign:
0512   C6 40                  ADD   A,40h   ;   bit 7 = carry XOR sign
0514   87                     ADD   A,A   
0515   38 10                  JR   C,e_heap   
0517   3A 07 00               LD   A,(0007h)   
051A   3D                     DEC   A   
051B   BC                     CP   H   
051C   38 09                  JR   C,e_heap   
051E                          ENDIF      
051E                          IF   CHECKED*(1-CPM)   
                                 ; (Here the program's space is under 32K, so a top that wrapped
                                 ; round always falls outside it.)
                              LD   A,H   
                              CP   HEAPLIM   
                              JR   NC,e_heap   
051E                          ENDIF      
051E                          IF   CHECKED   
051E   D5                     PUSH   DE   
051F   EB                     EX   DE,HL   
0520   2A 38 0B               LD   HL,(NPEND)   
0523   19                     ADD   HL,DE   ; carry: at or above the program's end
0524   EB                     EX   DE,HL   
0525   D1                     POP   DE   
0526   D8                     RET   C   
0527   B7           E_HEAP:   OR   A   ; put the count back in TOS for the report
0528   ED 52                  SBC   HL,DE   
052A   3E 48                  LD   A,"H"   
052C   18 13                  JR   errp   
052E                             ; chkst: stop unless HL is in the program's own space: from the letter page
052E                             ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
052E                             ; whatever lies above the limit are safe. Memory above the heap top but
052E                             ; below the limit is the program's own: Tiny BASIC keeps its lines there.
052E                             ; It is the page of HL + 1 that is tested, so that one test serves both
052E                             ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
052E                             ; Keeps HL and BC. It runs on into its own error entry.
052E   23           CHKST:    INC   HL   
052F   7C                     LD   A,H   
0530   2B                     DEC   HL   
0531   FE 0B                  CP   LETPAGE   
0533   38 07                  JR   C,e_store   
0535                          ENDIF      
0535                          IF   CHECKED*(1-CPM)   
                              CP   HEAPLIM   
                              RET   C   
0535                          ENDIF      
0535                          IF   CHECKED*CPM   
0535   5F                     LD   E,A   
0536   3A 07 00               LD   A,(0007h)   ; the BDOS page is the heap limit
0539   3D                     DEC   A   
053A   BB                     CP   E   
053B   D0                     RET   NC   
053C                          ENDIF      
053C                          IF   CHECKED   
053C                             ; Error entries. Each loads its letter and then hides the next entry inside
053C                             ; a 3-byte LD DE,nn (the 11h), so they all fall through to `error`.
053C   3E 4F        E_STORE:   LD   A,"O"   ; a store outside the program's space
053E   11                     DB   11h   
053F   3E 42        E_BREAK:   LD   A,"B"   ; Ctrl-C (found inside pollk or getk)
0541                             ; errp: an error found inside a routine: drop its return address first.
0541   D1           ERRP:     POP   DE   
0542   18 0D                  JR   error   
0544   44           E_QUOTE:   LD   B,H   ; an unclosed string: HL is its address, one
0545   4D                     LD   C,L   ;   past the opening quote, which is the place
0546   3E 51                  LD   A,"Q"   
0548   11                     DB   11h   
0549   3E 58        E_RESV:   LD   A,"X"   ; a reserved byte outside a string
054B   11                     DB   11h   
054C   3E 5A        E_ZERO:   LD   A,"Z"   ; dividing by zero
054E   11                     DB   11h   
054F   3E 57        E_BRACK:   LD   A,"W"   ; bad character after [
0551                             ; error: the report, then the end. A = the letter, BC = one past the place,
0551                             ; HL = TOS, and both stacks as the report is to show them:
0551                             ; 
0551                             ;   Err X @ line,col
0551                             ;   up to 16 characters of the text from the place
0551                             ;   Stk n: the top 8 cells at most, bottom to top
0551                             ;   Rtn n
0551   E5           ERROR:    PUSH   HL   ; now the whole data stack is in memory
0552   5F                     LD   E,A   
0553   CD 26 03               CALL   pnl   
0556   45 72 72 20 22         DB   "Err ",22h   
055B   7B                     LD   A,E   
055C   EF                     RST   28h   
055D   CD 2C 03               CALL   pmsg   
0560   20 40 20 22            DB   " @ ",22h   
0564   0B                     DEC   BC   ; BC = the place
0565                             ; The line and column. A place below the program is in the line
0565                             ; buffer: line 0. Otherwise count the LFs from the program's start;
0565                             ; DE = the line's number, HL = where it starts.
0565   21 80 0B               LD   HL,LINEBUF   
0568   11 00 00               LD   DE,0   
056B   78                     LD   A,B   
056C   FE 0C                  CP   PROG/256   
056E   38 14                  JR   C,er3   
0570   24                     INC   H   
0571   6B                     LD   L,E   ; HL = PROG
0572   13           ER1:      INC   DE   ; a new line starts at HL
0573   E5                     PUSH   HL   
0574   7D           ER2:      LD   A,L   
0575   91                     SUB   C   
0576   7C                     LD   A,H   
0577   98                     SBC   A,B   
0578   30 09                  JR   NC,er2x   ; reached the place
057A   7E                     LD   A,(HL)   
057B   23                     INC   HL   
057C   FE 0A                  CP   10   
057E   20 F4                  JR   NZ,er2   
0580   F1                     POP   AF   
0581   18 EF                  JR   er1   
0583   E1           ER2X:     POP   HL   
0584   C5           ER3:      PUSH   BC   
0585   E5                     PUSH   HL   
0586   EB                     EX   DE,HL   
0587   CD 50 04               CALL   pdec   ; the line
058A   3E 2C                  LD   A,","   
058C   EF                     RST   28h   
058D   D1                     POP   DE   
058E   E1                     POP   HL   
058F   E5                     PUSH   HL   
0590   B7                     OR   A   
0591   ED 52                  SBC   HL,DE   
0593   23                     INC   HL   
0594   CD 50 04               CALL   pdec   ; the column
0597   CD 26 03               CALL   pnl   
059A   22                     DB   22h   
059B   E1                     POP   HL   ; the text, as it is: 16 characters, or fewer
059C   06 10                  LD   B,16   ;   if the line or the program ends first
059E   7E           ER4:      LD   A,(HL)   
059F   23                     INC   HL   
05A0   B7                     OR   A   
05A1   28 0B                  JR   Z,er5   
05A3   FE 0D                  CP   13   
05A5   28 07                  JR   Z,er5   
05A7   FE 0A                  CP   10   
05A9   28 03                  JR   Z,er5   
05AB                          ENDIF      
05AB                          IF   CHECKED*CPM*(1-EDITOR)   
                              CP   1Ah   ; (the ^Z that pads a file's last record ends
                              JR   Z,er5   ;   the text too: some terminals clear the
05AB                          ENDIF      ;   screen on it. The editor's loader ends
05AB                          IF   CHECKED   ;   the text at the first ^Z.)
05AB   EF                     RST   28h   
05AC   10 F0                  DJNZ   er4   
05AE                ER5:         ; (on into the two stack lines)
05AE                             ; The two stack lines:  Stk n: the top 8 cells at most, bottom to top
05AE                             ;                       Rtn n
05AE                             ; TOS is in memory with the rest (pushed) by now.
05AE   CD 26 03               CALL   pnl   
05B1   53 74 6B 20 22         DB   "Stk ",22h   
05B6   21 06 F5               LD   HL,(2-DSTOP)&0FFFFh   ; SP - (DSTOP-2) is minus twice the
05B9   39                     ADD   HL,SP   ;   depth (the cell at DSTOP-2 was pushed
05BA   E7                     RST   20h   ;   with the first value and holds nothing)
05BB   CD 04 06               CALL   phalf   ; the depth
05BE   3E 3A                  LD   A,":"   
05C0   EF                     RST   28h   
05C1   79                     LD   A,C   
05C2   FE 09                  CP   9   
05C4   38 0A                  JR   C,er6   
05C6   CD 2C 03               CALL   pmsg   
05C9   20 2E 2E 2E 22         DB   " ...",22h   
05CE   0E 08                  LD   C,8   
05D0   26 00        ER6:      LD   H,0   ; C = the number of cells to show
05D2   69                     LD   L,C   
05D3   29                     ADD   HL,HL   
05D4   39                     ADD   HL,SP   ; HL -> just above the deepest of them
05D5   0C                     INC   C   
05D6   0D           ER7:      DEC   C   
05D7   28 0F                  JR   Z,er8   
05D9   2B                     DEC   HL   
05DA   56                     LD   D,(HL)   
05DB   2B                     DEC   HL   
05DC   5E                     LD   E,(HL)   
05DD   E5                     PUSH   HL   
05DE   3E 20                  LD   A," "   
05E0   EF                     RST   28h   
05E1   EB                     EX   DE,HL   
05E2   CD 48 04               CALL   psgn   
05E5   E1                     POP   HL   
05E6   18 EE                  JR   er7   
05E8   CD 26 03     ER8:      CALL   pnl   
05EB   52 74 6E 20 22         DB   "Rtn ",22h   
05F0   D9                     EXX      
05F1   E5                     PUSH   HL   
05F2   D9                     EXX      
05F3   D1                     POP   DE   
05F4   21 E0 09               LD   HL,RSTOP   
05F7   B7                     OR   A   
05F8   ED 52                  SBC   HL,DE   
05FA   CD 04 06               CALL   phalf   
05FD   CD 26 03               CALL   pnl   
0600   22                     DB   22h   
0601                          ENDIF      
0601                          IF   CHECKED*(1-EDITOR)   
                              JP   endprog   
0601                          ENDIF      
0601                          IF   CHECKED*EDITOR   
0601   C3 44 06               JP   edit0   ; back to the editor, with both stacks cleared
0604                          ENDIF      
0604                          IF   CHECKED   
0604                             ; phalf: print half of HL, and leave it in C.
0604   CB 3C        PHALF:    SRL   H   
0606   CB 1D                  RR   L   
0608   E5                     PUSH   HL   
0609   CD 50 04               CALL   pdec   
060C   C1                     POP   BC   
060D   C9                     RET      
060E                          ENDIF      
060E                             ; =============================================================================
060E                             ;  The line editor (EDITOR = 1)
060E                             ; 
060E                             ;  The interpreter starts here, and a program that ends comes back here.
060E                             ;  There is no prompt. It follows the spec's suggested standard for a line
060E                             ;  editor (docs/b8script.md, Environments). Type a line and press Return:
060E                             ; 
060E                             ;    n text    put the text in as line n; the lines from n on move down. A
060E                             ;              number past the end (or 0) adds the line at the end.
060E                             ;    n         take line n out
060E                             ;    anything else is run at once, as B8Script. (Start such a line with a
060E                             ;    space if it would begin with a digit.)
060E                             ; 
060E                             ;  A command key ends the line too, and takes what was typed as its argument:
060E                             ; 
060E                             ;    ^G        run the program
060E                             ;    n ^L      list from line n (no number: all of it). Any key holds the
060E                             ;              list until another key is pressed; Ctrl-C ends it.
060E                             ;    n ^E      put line n in the input line; Return puts it back, changed
060E                             ;    name ^R   read. CP/M: the file of that name (no name: the same file as
060E                             ;              last time). Generic: what is typed, or pasted, from now until
060E                             ;              ^Z replaces the program; it is not echoed.
060E                             ;    name ^W   write. CP/M: to that file (no name: the same file as last
060E                             ;              time). Generic: the text is printed, as it is.
060E                             ;    ^N ^N     new: no program (the key twice in a row)
060E                             ;    ^X        leave (to LEAVE)
060E                             ; 
060E                             ;  In the line: ^B and ^F, or the left and right arrow keys, move the cursor;
060E                             ;  a character goes in at the cursor; Backspace and DEL take out the one
060E                             ;  before it; Esc drops the line. Only CR, LF, BS and printing characters are
060E                             ;  sent to the terminal, so any terminal will do.
060E                             ; 
060E                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
060E                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
060E                             ;  125 characters; the one character after a line number separates it from
060E                             ;  the text and is not stored. The text is kept as it is typed, each line
060E                             ;  ending in CR LF, at PROG.
060E                             ; 
060E                             ;  What lasts from one line to the next: the program, the words, the
060E                             ;  variables and the data stack. An error or a break clears both stacks. The
060E                             ;  return stack starts empty for every line.
060E                             ; 
060E                             ;  Things to know:
060E                             ;    - Reset empties the program (generic builds).
060E                             ;    - A word's address points into the program, so run the program again
060E                             ;      after editing it.
060E                             ;    - Nothing is printed between a program's output and what is typed next.
060E                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
060E                             ;      a line that calls -n? and carries on afterwards runs what was typed.
060E                             ;      (The stored program never comes back to the line, so it may.)
060E                             ;    - The editor"s own keys are not the program"s: -n? is the plain line
060E                             ;      read of the other builds.
060E                             ; 
060E                             ;  The data stack is the CPU's stack, so the editor works on top of whatever
060E                             ;  the last line left there, with TOS pushed like the rest.
060E                             ; =============================================================================
060E                          IF   EDGEN   
                    INIT:        ; reset (A = 0)
060E                          ENDIF      
060E                          IF   EDGEN*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at 0, and
                                 ; every word cell holds 0000h, the address an undefined word is caught at
                                 ; (see e_hi).
                              LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
060E                          ENDIF      
060E                          IF   EDGEN   
                              JR   edit0   
060E                          ENDIF      
060E                          IF   EDITOR   
060E                             ; ^F, right arrow: one to the right, by printing the character there
060E   7D           RIGHT:    LD   A,L   
060F   BB                     CP   E   
0610   28 4A                  JR   Z,ed1   ; at the end
0612   7E                     LD   A,(HL)   
0613   2C                     INC   L   
0614   18 2B                  JR   lf1   
0616                             ; Esc: alone it drops the line. An arrow key sends Esc [ and a letter, so
0616                             ; wait about 5 ms for a second key: after a "[" read on to the letter that
0616                             ; ends the sequence, and act on C (right) and D (left).
0616   01 C8 00     ESC:      LD   BC,5*MSLOOP   
0619   CD C0 04     ES1:      CALL   rawk   
061C   20 0A                  JR   NZ,es2   
061E   0B                     DEC   BC   
061F   78                     LD   A,B   
0620   B1                     OR   C   
0621   20 F6                  JR   NZ,es1   
0623   CD 91 06               CALL   fin   ; no second key: the line is dropped
0626   18 22                  JR   edit   
0628   FE 5B        ES2:      CP   "["   
062A   20 30                  JR   NZ,ed1   ; not a sequence known here
062C   CD EA 06     ES3:      CALL   ekey   
062F   FE 40                  CP   40h   
0631   38 F9                  JR   C,es3   ; (its parameters)
0633   D6 43                  SUB   "C"   
0635   28 D7                  JR   Z,right   
0637   3D                     DEC   A   ; "D"?
0638   20 22                  JR   NZ,ed1   ; no: on into left
063A                             ; ^B, left arrow: the cursor goes one to the left
063A   7D           LEFT:     LD   A,L   
063B   87                     ADD   A,A   
063C   28 1E                  JR   Z,ed1   ; (L = 80h: at the start)
063E   2D                     DEC   L   
063F   3E 08                  LD   A,8   
0641   EF           LF1:      RST   28h   
0642   18 18                  JR   ed1   
0644                             ; edit0: reset, an error or a break: both stacks are cleared.
0644                             ; skend: a program that ended inside skip: its return address goes.
0644                             ; edend: a program that ended: TOS joins the rest of the data stack.
0644   31 FA 0A     EDIT0:    LD   SP,DSTOP-2   ; empty (the cell that stands for TOS is pushed)
0647   21                     DB   21h   ; (LD HL,nn: steps over the next two bytes)
0648   D1           SKEND:    POP   DE   
0649   E5           EDEND:    PUSH   HL   
064A                             ; edit: start a new input line.
064A   D9           EDIT:     EXX      
064B   21 E0 09               LD   HL,RSTOP   ; the return stack is empty
064E   D9                     EXX      
064F   21 00 00               LD   HL,0   
0652   22 7A 0B               LD   (KEYBUF),HL   ; no key is held, and the break key is on
0655   22 3A 0B               LD   (EDLN),HL   ; no line is being edited
0658   21 80 0B               LD   HL,LINEBUF   ; HL = the cursor,
065B   5D                     LD   E,L   ;   E = the end of the line (its low byte)
065C   CD EA 06     ED1:      CALL   ekey   
065F   FE 7F                  CP   7Fh   
0661   28 40                  JR   Z,bsp   ; DEL
0663   FE 20                  CP   " "   
0665   30 56                  JR   NC,insc   
0667   FE 09                  CP   9   
0669   28 52                  JR   Z,insc   ; Tab is text
066B   FE 08                  CP   8   
066D   28 34                  JR   Z,bsp   
066F   FE 02                  CP   2   
0671   28 C7                  JR   Z,left   ; ^B
0673   FE 06                  CP   6   
0675   28 97                  JR   Z,right   ; ^F
0677   FE 1B                  CP   1Bh   
0679   28 9B                  JR   Z,esc   
067B   E5                     PUSH   HL   ; a command key? Look it up
067C   21 F0 06               LD   HL,cmds   
067F   06 08                  LD   B,NCMD   
0681   BE           ED2:      CP   (HL)   
0682   23                     INC   HL   
0683   28 07                  JR   Z,ed3   
0685   23                     INC   HL   
0686   23                     INC   HL   
0687   10 F8                  DJNZ   ed2   
0689   E1                     POP   HL   
068A   18 D0                  JR   ed1   ; no: the key is ignored
068C   7E           ED3:      LD   A,(HL)   
068D   23                     INC   HL   
068E   66                     LD   H,(HL)   
068F   6F                     LD   L,A   
0690   E3                     EX   (SP),HL   ; the command's address: fin returns to it
0691                             ; fin: end the input line: CR LF and a NUL after it, and a new line on the
0691                             ; terminal. Leaves BC -> the line and HL -> the NUL.
0691   26 0B        FIN:      LD   H,LETPAGE   
0693   6B                     LD   L,E   
0694   36 0D                  LD   (HL),13   
0696   2C                     INC   L   
0697   36 0A                  LD   (HL),10   
0699   2D                     DEC   L   
069A   CD F9 07               CALL   prl   ; (prints the CR LF)
069D   36 00                  LD   (HL),0   
069F   01 80 0B               LD   BC,LINEBUF   
06A2   C9                     RET      
06A3                             ; Backspace, DEL: the character before the cursor goes. The cursor moves
06A3                             ; left, the rest of the line moves down over it, and the last place (now a
06A3                             ; space) is printed over along with the rest.
06A3   7D           BSP:      LD   A,L   
06A4   87                     ADD   A,A   
06A5   28 B5                  JR   Z,ed1   ; at the start
06A7   2D                     DEC   L   
06A8   3E 08                  LD   A,8   
06AA   EF                     RST   28h   
06AB   E5                     PUSH   HL   
06AC   2C           BS1:      INC   L   
06AD   7E                     LD   A,(HL)   
06AE   2D                     DEC   L   
06AF   77                     LD   (HL),A   
06B0   2C                     INC   L   
06B1   7D                     LD   A,L   
06B2   BB                     CP   E   
06B3   20 F7                  JR   NZ,bs1   
06B5   2D                     DEC   L   
06B6   36 20                  LD   (HL)," "   
06B8   E1                     POP   HL   
06B9   53                     LD   D,E   
06BA   1D                     DEC   E   
06BB   18 15                  JR   ic2   
06BD                             ; A character goes in at the cursor: it ripples up through the rest of the
06BD                             ; line, the cursor moves on, and the rest is printed again.
06BD   47           INSC:     LD   B,A   
06BE   7B                     LD   A,E   
06BF   FE FD                  CP   0FDh   
06C1   28 99                  JR   Z,ed1   ; the line is full: 125 characters
06C3   78                     LD   A,B   
06C4   EF                     RST   28h   
06C5   E5                     PUSH   HL   
06C6   7E           IC1:      LD   A,(HL)   
06C7   70                     LD   (HL),B   
06C8   47                     LD   B,A   
06C9   7D                     LD   A,L   
06CA   2C                     INC   L   
06CB   BB                     CP   E   
06CC   20 F8                  JR   NZ,ic1   
06CE   E1                     POP   HL   
06CF   2C                     INC   L   
06D0   1C                     INC   E   
06D1   53                     LD   D,E   
06D2   CD D7 06     IC2:      CALL   tail   
06D5   18 85                  JR   ed1   
06D7                             ; tail: print the line from the cursor to D (a low byte), and bring the
06D7                             ; cursor back with backspaces. Nothing at all if the cursor is at D.
06D7   4D           TAIL:     LD   C,L   
06D8   7D           TA1:      LD   A,L   
06D9   BA                     CP   D   
06DA   28 05                  JR   Z,ta2   
06DC   7E                     LD   A,(HL)   
06DD   EF                     RST   28h   
06DE   2C                     INC   L   
06DF   18 F7                  JR   ta1   
06E1   7D           TA2:      LD   A,L   
06E2   B9                     CP   C   
06E3   C8                     RET   Z   
06E4   3E 08                  LD   A,8   
06E6   EF                     RST   28h   
06E7   2D                     DEC   L   
06E8   18 F7                  JR   ta2   
06EA                             ; ekey: wait for a key
06EA   CD C0 04     EKEY:     CALL   rawk   
06ED   28 FB                  JR   Z,ekey   
06EF   C9                     RET      
06F0                             ; The command keys, and where each goes (after fin).
06F0   0D           CMDS:     DB   13   
06F1   40 07                  DW   cret   
06F3   07                     DB   7   ; ^G
06F4   88 07                  DW   crun   
06F6   0C                     DB   12   ; ^L
06F7   9E 07                  DW   clist   
06F9   05                     DB   5   ; ^E
06FA   16 07                  DW   cedln   
06FC   12                     DB   18   ; ^R
06FD   02 08                  DW   cread   
06FF   17                     DB   23   ; ^W
0700   0B 08                  DW   cwrite   
0702   0E                     DB   14   ; ^N
0703   08 07                  DW   cnew   
0705   18                     DB   24   ; ^X
0706   00 00                  DW   LEAVE   
0708                NCMD:     EQU   8   
0708                             ; ^N ^N: no program, if the next key is ^N too
0708   CD EA 06     CNEW:     CALL   ekey   
070B   FE 0E                  CP   14   
070D   20 04                  JR   NZ,ged0   
070F   AF                     XOR   A   
0710   32 00 0C               LD   (PROG),A   
0713   C3 4A 06     GED0:     JP   edit   
0716                             ; ^E: line n goes into the input line, to be changed. EDLN remembers which
0716                             ; line it was: Return puts the text back in its place.
0716   CD D2 03     CEDLN:    CALL   rdnum   
0719   E5                     PUSH   HL   
071A   CD E1 07               CALL   find   ; HL -> the line, or the NUL if there is none
071D   D1                     POP   DE   
071E   7E                     LD   A,(HL)   
071F   B7                     OR   A   
0720   28 F1                  JR   Z,ged0   
0722   ED 53 3A 0B            LD   (EDLN),DE   
0726   11 80 0B               LD   DE,LINEBUF   
0729   7E           CE1:      LD   A,(HL)   ; copy it, and show it, up to its CR (or LF)
072A   FE 0D                  CP   13   
072C   28 0D                  JR   Z,ce2   
072E   FE 0A                  CP   10   
0730   28 09                  JR   Z,ce2   
0732   12                     LD   (DE),A   
0733   EF                     RST   28h   
0734   23                     INC   HL   
0735   1C                     INC   E   
0736   7B                     LD   A,E   
0737   FE FD                  CP   0FDh   ; (a longer line is cut at 125 characters)
0739   20 EE                  JR   NZ,ce1   
073B   EB           CE2:      EX   DE,HL   ; the cursor is at the line's end
073C   5D                     LD   E,L   
073D   C3 5C 06               JP   ed1   
0740                             ; Return. If ^E put a line here, the text goes back in its place. If not:
0740                             ; a number and text is a line to put in, a number alone a line to take out,
0740                             ; and anything else is run where it is.
0740   E5           CRET:     PUSH   HL   ; the end of what was typed
0741   2A 3A 0B               LD   HL,(EDLN)   
0744   7C                     LD   A,H   
0745   B5                     OR   L   
0746   28 07                  JR   Z,cr1   
0748   E5                     PUSH   HL   
0749   CD D1 07               CALL   delln   
074C   E1                     POP   HL   
074D   18 13                  JR   ins   
074F   CD D2 03     CR1:      CALL   rdnum   ; HL = the number it starts with, BC -> after
0752   79                     LD   A,C   ; C is still 80h if there was no number:
0753   87                     ADD   A,A   ;   only then is twice it 0
0754   28 36                  JR   Z,st0p   ; no number: run the line
0756   0A                     LD   A,(BC)   
0757   FE 0D                  CP   13   
0759   20 06                  JR   NZ,cr2   
075B   D1                     POP   DE   ; the number alone: take that line out
075C   CD D1 07               CALL   delln   
075F   18 24                  JR   gedit   
0761   03           CR2:      INC   BC   ; step over the one character after the number
0762                             ; Put the text at BC in as line n (in HL): open a gap of its length there,
0762                             ; CR and LF included, and copy it in.
0762   CD E1 07     INS:      CALL   find   ; HL -> where it goes
0765   D1                     POP   DE   ; the end of what was typed
0766   7B                     LD   A,E   
0767   91                     SUB   C   ; A = the length of the text, with its CR LF
0768   C5                     PUSH   BC   ; the text
0769   4F                     LD   C,A   
076A   06 00                  LD   B,0   
076C   C5                     PUSH   BC   ; its length
076D   54                     LD   D,H   
076E   5D                     LD   E,L   ; DE = where it goes
076F   AF                     XOR   A   
0770   4F                     LD   C,A   ; BC = 0: CPIR looks as far as it needs to
0771   ED B1                  CPIR      ; HL -> one past the program's NUL
0773   ED 52                  SBC   HL,DE   ; the number of bytes to move up, NUL included
0775   44                     LD   B,H   
0776   4D                     LD   C,L   
0777   19                     ADD   HL,DE   
0778   2B                     DEC   HL   ; HL -> the NUL
0779   EB                     EX   DE,HL   
077A   E3                     EX   (SP),HL   ; HL = the length; where it goes is kept
077B   E5                     PUSH   HL   
077C   19                     ADD   HL,DE   ; the NUL's new place
077D   EB                     EX   DE,HL   
077E   ED B8                  LDDR      ; move the rest of the program up
0780   C1                     POP   BC   ; the length
0781   D1                     POP   DE   ; where it goes
0782   E1                     POP   HL   ; the text
0783   ED B0                  LDIR      
0785   C3 4A 06     GEDIT:    JP   edit   
0788                             ; ^G: run the program. st0p: run the typed line (BC -> it).
0788   01 00 0C     CRUN:     LD   BC,PROG   
078B   3E                     DB   3Eh   ; (LD A,n: steps over the POP)
078C   E1           ST0P:     POP   HL   ; (the end of what was typed)
078D                             ; st0: start running at BC. The heap starts after the stored program's NUL.
078D   21 00 0C     ST0:      LD   HL,PROG   
0790   AF                     XOR   A   
0791   BE           ST1:      CP   (HL)   
0792   23                     INC   HL   
0793   20 FC                  JR   NZ,st1   
0795   22 7C 0B               LD   (HEAP),HL   
0798                          ENDIF      
0798                          IF   EDITOR*CHECKED   
0798   E7                     RST   20h   ; minus the heap"s first address: "_' may not
0799   22 38 0B               LD   (NPEND),HL   ;   release below it
079C                          ENDIF      
079C                          IF   EDITOR   
079C   E1                     POP   HL   ; TOS: the data stack is as the last line left it
079D   F7                     RST   30h   ; (its return address is thrown away)
079E                             ; ^L: list from line n. DE = the number of the line at HL.
079E   CD D2 03     CLIST:    CALL   rdnum   ; HL = n, or 0 if there was none:
07A1   7C                     LD   A,H   
07A2   B5                     OR   L   
07A3   20 01                  JR   NZ,li0   
07A5   2C                     INC   L   ;   then from line 1
07A6   E5           LI0:      PUSH   HL   
07A7   CD E1 07               CALL   find   
07AA   D1                     POP   DE   
07AB   7E           LI1:      LD   A,(HL)   
07AC   B7                     OR   A   
07AD   28 D6                  JR   Z,gedit   ; the end of the text
07AF   CD C0 04               CALL   rawk   
07B2   28 09                  JR   Z,li3   ; no key: carry on
07B4   FE 03                  CP   3   
07B6   C4 EA 06               CALL   NZ,ekey   ; any key but Ctrl-C: wait for one more
07B9   FE 03                  CP   3   
07BB   28 C8                  JR   Z,gedit   ; Ctrl-C, first or second, ends the list
07BD   E5           LI3:      PUSH   HL   
07BE   D5                     PUSH   DE   
07BF   EB                     EX   DE,HL   
07C0   CD 50 04               CALL   pdec   ; the line's number,
07C3   3E 20                  LD   A," "   
07C5   EF                     RST   28h   ;   a space,
07C6   D1                     POP   DE   
07C7   E1                     POP   HL   
07C8   13                     INC   DE   
07C9   CD F9 07               CALL   prl   ;   and the line
07CC   18 DD                  JR   li1   
07CE   C3 4A 06     GED1:     JP   edit   
07D1                             ; delln: take line n (in HL) out: copy everything after it down over it.
07D1   CD E1 07     DELLN:    CALL   find   
07D4   54                     LD   D,H   
07D5   5D                     LD   E,L   
07D6   CD EF 07               CALL   nxl   ; HL -> the next line
07D9   7E           DE1:      LD   A,(HL)   
07DA   12                     LD   (DE),A   
07DB   23                     INC   HL   
07DC   13                     INC   DE   
07DD   B7                     OR   A   
07DE   20 F9                  JR   NZ,de1   
07E0   C9                     RET      
07E1                             ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
07E1                             ; of the text if there are fewer lines (or the number is 0). Keeps BC.
07E1   EB           FIND:     EX   DE,HL   
07E2   21 00 0C               LD   HL,PROG   
07E5   1B           FI1:      DEC   DE   
07E6   7A                     LD   A,D   
07E7   B3                     OR   E   
07E8   C8                     RET   Z   
07E9   CD EF 07               CALL   nxl   
07EC   20 F7                  JR   NZ,fi1   
07EE   C9                     RET      
07EF                             ; nxl: step HL over one line, to just past its LF (and return not-zero), or
07EF                             ; stop at the NUL that ends the text (and return zero).
07EF   7E           NXL:      LD   A,(HL)   
07F0   B7                     OR   A   
07F1   C8                     RET   Z   
07F2   23                     INC   HL   
07F3   FE 0A                  CP   10   
07F5   20 F8                  JR   NZ,nxl   
07F7   B7                     OR   A   
07F8   C9                     RET      
07F9                             ; prl: print the line at HL, to its LF; HL -> just past it.
07F9   7E           PRL:      LD   A,(HL)   
07FA   EF                     RST   28h   
07FB   7E                     LD   A,(HL)   
07FC   23                     INC   HL   
07FD   FE 0A                  CP   10   
07FF   20 F8                  JR   NZ,prl   
0801   C9                     RET      
0802                          ENDIF      
0802                          IF   EDGEN   
                                 ; ^R, generic: what comes in from now until ^Z is the program. A CR is
                                 ; stored as CR LF; a LF right after a line end is dropped (it is the CR's
                                 ; own, or an empty line's), and a LF anywhere else ends a line too. A last
                                 ; line with no end is given one. Nothing is echoed, and there is no check
                                 ; for running out of memory.
                    CREAD:    LD   HL,PROG-1   
                              LD   (HL),10   ; (as if a line had just ended: the byte is
                              INC   HL   ;   the line buffer's last, and spare)
                    RD1:      CALL   ekey   
                              LD   C,A   
                              CP   1Ah   
                              JR   NZ,rd2   
                              LD   A,10   ; ^Z ends the last line, as a LF would
                    RD2:      CP   10   
                              JR   NZ,rd3   
                              DEC   HL   
                              CP   (HL)   
                              INC   HL   
                              JR   Z,rd4   ; straight after a line end: dropped
                              LD   A,13   ; anywhere else it ends the line
                    RD3:      LD   (HL),A   
                              INC   HL   
                              CP   13   
                              JR   NZ,rd4   
                              LD   (HL),10   ; after a CR goes a LF
                              INC   HL   
                    RD4:      LD   A,C   
                              CP   1Ah   
                              JR   NZ,rd1   
                              LD   (HL),0   
                              JR   ged1   
                                 ; ^W, generic: the text is printed as it is, for the terminal to capture.
                    CWRITE:   LD   HL,PROG   
                    CW1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,ged1   
                              RST   28h   
                              INC   HL   
                              JR   cw1   
0802                          ENDIF      
0802                          IF   EDITOR*CPM   
0802                CFCB:     EQU   005Ch   ; the file's name is kept here, where the CCP
0802                             ;   put the one from the command line
0802                             ; ^R, CP/M: read the file. A name typed before the key is the file's name
0802                             ; from now on.
0802   CD 59 08     CREAD:    CALL   setname   
0805   CD 98 08               CALL   load   
0808   C3 4A 06               JP   edit   
080B                             ; ^W, CP/M: write the file: delete the old one, make it anew, write the
080B                             ; text in records of 128 bytes, and close it. The text's NUL and the 127
080B                             ; bytes after it are set to ^Z meanwhile, which pads the last record. (A
080B                             ; full disk or directory is not noticed: the calls fail and that is all.)
080B   CD 59 08     CWRITE:   CALL   setname   
080E   0E 13                  LD   C,19   ; delete
0810   CD 92 08               CALL   fbdos   
0813   0E 16                  LD   C,22   ; make
0815   CD 92 08               CALL   fbdos   
0818   21 00 0C               LD   HL,PROG   
081B   AF                     XOR   A   
081C   BE           CW1:      CP   (HL)   
081D   23                     INC   HL   
081E   20 FC                  JR   NZ,cw1   
0820   2B                     DEC   HL   ; HL -> the NUL
0821   E5                     PUSH   HL   
0822   06 80                  LD   B,128   
0824   36 1A        CW2:      LD   (HL),1Ah   
0826   23                     INC   HL   
0827   10 FB                  DJNZ   cw2   
0829   E1                     POP   HL   
082A   11 00 0C               LD   DE,PROG   
082D   7B           CW3:      LD   A,E   ; a record that starts before the end is written
082E   95                     SUB   L   
082F   7A                     LD   A,D   
0830   9C                     SBC   A,H   
0831   30 09                  JR   NC,cw4   
0833   E5                     PUSH   HL   
0834   0E 15                  LD   C,21   ; write, from where the record lies
0836   CD 46 08               CALL   frec   
0839   E1                     POP   HL   
083A   18 F1                  JR   cw3   
083C   36 00        CW4:      LD   (HL),0   ; the NUL again
083E   0E 10                  LD   C,16   ; close
0840   CD 92 08               CALL   fbdos   
0843   C3 4A 06               JP   edit   
0846                             ; frec: BDOS function C (read or write a record) with the 128 bytes at DE.
0846                             ; Returns A = the BDOS's answer, HL = DE and DE = DE + 128.
0846   D5           FREC:     PUSH   DE   
0847   C5                     PUSH   BC   
0848   0E 1A                  LD   C,26   ; set the DMA address
084A   CD 05 00               CALL   BDOS   
084D   C1                     POP   BC   
084E   CD 92 08               CALL   fbdos   
0851   E1                     POP   HL   
0852   11 80 00               LD   DE,128   
0855   EB                     EX   DE,HL   
0856   19                     ADD   HL,DE   
0857   EB                     EX   DE,HL   
0858   C9                     RET      
0859                             ; setname: if a name was typed (the line does not start with its CR), put it
0859                             ; in the FCB: up to 8 characters, a dot, up to 3 more, in capitals. The drive
0859                             ; is the current one. Then, name or no name, clear the FCB after the name,
0859                             ; as it must be before a file is opened or made.
0859   11 80 0B     SETNAME:   LD   DE,LINEBUF   
085C   1A                     LD   A,(DE)   
085D   FE 0D                  CP   13   
085F   28 26                  JR   Z,fcbclr   
0861   21 5C 00               LD   HL,CFCB   
0864   36 00                  LD   (HL),0   ; the current drive
0866   06 0B                  LD   B,11   
0868   2C           SN1:      INC   L   
0869   36 20                  LD   (HL)," "   
086B   10 FB                  DJNZ   sn1   
086D   2E 5D                  LD   L,CFCB+1   
086F   1A           SN2:      LD   A,(DE)   
0870   13                     INC   DE   
0871   FE 0D                  CP   13   
0873   28 12                  JR   Z,fcbclr   
0875   FE 2E                  CP   "."   
0877   20 04                  JR   NZ,sn3   
0879   2E 65                  LD   L,CFCB+9   ; the type
087B   18 F2                  JR   sn2   
087D   FE 61        SN3:      CP   "a"   
087F   38 02                  JR   C,sn4   
0881   E6 5F                  AND   5Fh   ; a capital
0883   77           SN4:      LD   (HL),A   
0884   2C                     INC   L   
0885   18 E8                  JR   sn2   
0887   21 68 00     FCBCLR:   LD   HL,CFCB+12   
088A   06 18                  LD   B,24   
088C   36 00        FC1:      LD   (HL),0   
088E   23                     INC   HL   
088F   10 FB                  DJNZ   fc1   
0891   C9                     RET      
0892                             ; fbdos: BDOS function C on the file
0892   11 5C 00     FBDOS:    LD   DE,CFCB   
0895   C3 05 00               JP   BDOS   
0898                             ; load: read the file into PROG. No such file: no program. The text ends at
0898                             ; the file"s first ^Z (1Ah), which pads a text file"s last record; one more
0898                             ; goes after the last record, so the search always stops. And every line
0898                             ; must end in LF: a last line without one is given a CR LF. (The FCB is
0898                             ; clear after its name: the CCP left it so, or setname did.)
0898   0E 0F        LOAD:     LD   C,15   ; open (no such file: the first read fails
089A   CD 92 08               CALL   fbdos   ;   too)
089D   11 00 0C               LD   DE,PROG   
08A0   0E 14        LD1:      LD   C,20   ; read the next 128 bytes
08A2   CD 46 08               CALL   frec   
08A5   B7                     OR   A   
08A6   28 F8                  JR   Z,ld1   
08A8   36 1A                  LD   (HL),1Ah   ; (HL = where the record that failed would be)
08AA   21 FF 0B               LD   HL,PROG-1   
08AD   3E 0A                  LD   A,10   ; (a file with no text needs nothing added)
08AF   23           TR1:      INC   HL   
08B0   5F                     LD   E,A   ; E = the character before this one
08B1   7E                     LD   A,(HL)   
08B2   FE 1A                  CP   1Ah   
08B4   20 F9                  JR   NZ,tr1   
08B6   7B                     LD   A,E   
08B7   FE 0A                  CP   10   
08B9   28 06                  JR   Z,tr2   
08BB   36 0D                  LD   (HL),13   
08BD   23                     INC   HL   
08BE   36 0A                  LD   (HL),10   
08C0   23                     INC   HL   
08C1   36 00        TR2:      LD   (HL),0   
08C3   C9                     RET      
08C4                          ENDIF      
08C4                             ; =============================================================================
08C4                          IF   CPM   
08C4                             ; The RAM pages follow the image; the heap may grow to the BDOS.
08C4                START:       
08C4                          ENDIF      
08C4                          IF   CPM*CHECKED   
08C4                             ; Clear the lower half of the letter page: every variable starts at
08C4                             ; 0, every word cell holds 0000h, the address an undefined word is
08C4                             ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
08C4                             ; is held back.
08C4   21 00 0B               LD   HL,LET   
08C7   AF                     XOR   A   
08C8   77           INI1:     LD   (HL),A   
08C9   2C                     INC   L   
08CA   F2 C8 08               JP   P,ini1   ; +00h to +7Fh
08CD                          ENDIF      
08CD                          IF   CPM   
08CD   21 08 01               LD   HL,vecs   ; the RST routines go down into page zero
08D0   11 08 00               LD   DE,0008h   
08D3   01 2C 00               LD   BC,vecend-vecs   
08D6   ED B0                  LDIR      
08D8                          ENDIF      
08D8                          IF   CPM*EDITOR   
08D8   CD 98 08               CALL   load   ; the file named on the command line
08DB   C3 44 06               JP   edit0   
08DE                          ENDIF      
08DE                          IF   CPM*(1-EDITOR)   
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:      LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
                              JP   st2   
08DE                          ENDIF      
08DE                          IF   CPM   
08DE                             ; RAM pages, after the image
08DE                RSPAGE:   EQU   (imgend + 255) / 256   
08DE                DSPAGE:   EQU   RSPAGE + 1   
08DE                LETPAGE:   EQU   RSPAGE + 2   
08DE                PROG:     EQU   LETPAGE*256 + 256   
08DE                          ENDIF      
08DE                IMGEND:      


