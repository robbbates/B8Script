  1563                              <1>         db      'B8SWINEC 2026-11-21',22h
  1564                              <1>  %else
  1565                              <1>         db      'B8SWINE 2026-11-21',22h
  1566                              <1>  %endif
  1567                              <1>         call    pstk                    ; both stacks
  1568                              <1>         mov     edi,ARENA+PROG
  1569                              <1>         or      ecx,-1
  1570                              <1> .cv1:   inc     ecx                     ; count the lines, and find the end
  1571                              <1>         call    nxl
  1572                              <1>         jnz     .cv1
  1573                              <1>         push    ecx
  1574                              <1>         call    pmsg
  1575                              <1>         db      '/M/JProg ',22h
  1576                              <1>         lea     eax,[edi-(ARENA+PROG)]
  1577                              <1>         call    pdec                    ; the program's size
  1578                              <1>         call    pmsg
  1579                              <1>         db      '/M/JLines ',22h
  1580                              <1>         pop     eax
  1581                              <1>         call    pdec
  1582                              <1>         call    pmsg
  1583                              <1>         db      '/M/JFree ',22h
  1584                              <1>         mov     eax,ARENA+LIMIT-1
  1585                              <1>         sub     eax,edi
  1586                              <1>         call    pdec                    ; the room left for text and heap
  1587                              <1>         call    pmsg
  1588                              <1>         db      '/M/J',22h
  1589                              <1>         jmp     gedit
  1590                              <1> 
  1591                              <1> ; delln: take line EAX out: copy everything after it down over it. Keeps ESI.
