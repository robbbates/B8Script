0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Intel 8080
0000                             ;  Spec: docs/b8script.md (2026-10-09) plus the 2026-11-20 changes:
0000                             ;        [x stores in a variable, "[ " pushes an anonymous block, any other
0000                             ;        character after [ is an error, the heap pointer lives at z10+.
0000                             ;        The string escape is "/" (it was ">").
0000                             ;        "/" leaves ( r q ), the quotient on top; dividing by zero is not
0000                             ;        checked. -n? does no more editing than Backspace.
0000                             ;  Design follows the Z80 interpreter (z80/b8s-z80.asm), with 8080 opcodes
0000                             ;  only.
0000                             ; 
0000                             ;  Two switches, set in the two EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    CHECKED  0 = no checks (spec: "B8Script checks nothing")
0000                             ;             1 = stops on stack overrun, Ctrl-C, heap past the limit, a store
0000                             ;                 outside the program's own space, and a bad character after [,
0000                             ;                 printing a letter and the place, like  S @ 245
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), I8080 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   1   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   0   ; 1 = checked build
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the 8080"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  The return stack pointer has no register (the 8080 has no spare pair): it
0000                             ;  is the RAM word RSP. Only rpop, rpushd and ")" (and the checks) touch it.
0000                             ; 
0000                             ;  One-byte calls. The routines used most are reached with RST, one byte
0000                             ;  instead of three. (asm80 wants the vector number: RST 1 = RST 08h.)
0000                             ; 
0000                             ;    RST 1  08h  rpop    pop the return stack into HL
0000                             ;    RST 3  18h  drop    drop TOS, then next character     (ends a handler)
0000                             ;    RST 4  20h  neg16   HL = -HL
0000                             ;    RST 5  28h  putc    print A
0000                             ;    RST 6  30h  next    next character                    (ends a handler)
0000                             ; 
0000                             ;  RST 3 and RST 6 never return: an RST is a CALL, so the first thing each
0000                             ;  of them does is POP D to throw the return address away.
0000                             ; 
0000                             ;  The CP/M build can't own page zero, so the block from `vecs` to `vecend`
0000                             ;  (image addresses 0108h-0133h) is copied to 0008h-0033h when it starts. The
0000                             ;  code in that block has no jumps inside itself, so it works at either place.
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; 
0000                             ;  What the 8080 lacks, and what replaces it: no JR (JMP/Jcc), no DJNZ, no
0000                             ;  SBC HL (byte-wise SUB/SBB, or negate and DAD), no shifts on register pairs
0000                             ;  (DAD H doubles; RAL/RAR through A), no LDIR/CPIR (small loops).
0000                             ; -----------------------------------------------------------------------------
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (SP stays inside this page)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch (= z10+), interpreter variables in the gaps, and the -n?
0000                             ;             line buffer at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack's page has a guard band: the data
0000                             ;  stack can overrun by a cell or two (and the calls made while it is full)
0000                             ;  into the top 32 bytes of the return-stack page, which are never used, and
0000                             ;  the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
0000                BDOS:     EQU   0005h   
0000                EXIT:     EQU   0000h   ; warm boot
0000                BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IFN   CPM   
                                 ; ---- generic machine: edit these to suit -----------------------------------
                    KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
                                 ;   waiting. The zero flag must match A
                                 ;   (end the routine with ORA A / RET).
                    CONOUT:   EQU   0FF03h   ; print the character in A
                    EXIT:     EQU   0FF09h   ; where to go when the program ends
                                 ;   KEY and CONOUT must preserve BC, DE and HL.
                    RSPAGE:   EQU   80h   ; 8000h return stack
                    DSPAGE:   EQU   81h   ; 8100h data stack
                    LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
                    PROG:     EQU   8300h   ; where the loader puts the program text
                    HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
                    BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; z10+, the heap pointer
0000                RSP:      EQU   LET+34h   ; gap after Z: the return stack pointer;
0000                KEYBUF:   EQU   LET+36h   ;   a held-back key
0000                LBHDR:    EQU   LET+7Eh   ; CP/M BDOS 10 header: max, count
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FEh   ; empty data stack
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is the start of the .COM file, and 0108h-0133h is also copied to
0000                             ;  page zero (see the header).
0000                             ; =============================================================================
0100                          .ORG   BASE   
0100   31 FE 06               LXI   SP,DSTOP   ; 00  reset, or the start of the .COM file
0103   C3 D9 03               JMP   start   
0106   CF           RDROP:    RST   1   ; 06  drop the top of the return stack, then
0107   DF                     RST   3   ;     drop TOS (a spent flag) and go on
0108                VECS:        
0108                             ; ---- RST 1: rpop: pop the return stack into HL (DE is lost) -----------------
0108   2A 34 07     RPOP:     LHLD   RSP   ; 08
010B   5E                     MOV   E,M   
010C   23                     INX   H   
010D   56                     MOV   D,M   
010E   23                     INX   H   
010F   22 34 07               SHLD   RSP   
0112   EB                     XCHG      
0113   C9                     RET      ; 13  (so RST 2 is not used)
0114   EB           H_TOR:    XCHG      ; 14  "{" TOS to the return stack; rpushd
0115   C3 AE 01               JMP   rpushd   ;     brings up the new TOS
0118                             ; ---- RST 3: drop TOS, then next ---------------------------------------------
0118   D1           RST18:    POP   D   ; 18  discard the RST's return address
0119   E1                     POP   H   ;     new TOS = NOS
011A   C3 34 01               JMP   next0   
011D   E5           H_FROMR:   PUSH   H   ; 1D  "}" return stack to TOS
011E   CF                     RST   1   
011F   F7                     RST   6   
0120                             ; ---- RST 4: neg16: HL = -HL (keeps BC, DE) ----------------------------------
0120   AF           NEG16:    XRA   A   ; 20
0121   95                     SUB   L   
0122   6F                     MOV   L,A   
0123   9F                     SBB   A   
0124   94                     SUB   H   
0125   67                     MOV   H,A   
0126   C9                     RET      
0127   E9           JPHL:     PCHL      ; 27  (for the machine-code call)
0128                             ; ---- RST 5: putc: print A (keeps BC, DE, HL) --------------------------------
0128                RST28:       
0128                          IFN   CPM   
                    PUTC:     JMP   CONOUT   ; 28
0128                          ENDIF      
0128                          IF   CPM   
0128   C3 CB 03               JMP   putc   ; 28
012B                          ENDIF      
012B                             ; exec: "`" with no hex digit after it: call the machine code at TOS. It
012B                             ; returns here, with its top cell on the stack: that becomes the new TOS.
012B   CD 27 01     EXEC:     CALL   jphl   ; 2B
012E   E1                     POP   H   
012F   F7                     RST   6   
0130                             ; ---- RST 6: next character --------------------------------------------------
0130   D1           RST30:    POP   D   ; 30  discard the RST's return address
0131                          IF   CPM   
0131   C3 34 01               JMP   next0   ; (this copy runs in page zero)
0134                          ENDIF      
0134                VECEND:      
0134                             ; =============================================================================
0134                             ;  The inner loop: read one character and sort it by range.
0134                             ; 
0134                             ;    00h          end of program
0134                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0134                             ;    30h-39h      digit: read a whole number
0134                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0134                             ;    61h-7Ah      a-z: push the address of that letter's cell
0134                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0134                             ; =============================================================================
0134                NEXT0:       
0134                          IF   CHECKED   
                              CALL   chkstk   ; both stacks are checked once per character
0134                          ENDIF      
0134   0A                     LDAX   B   
0135   03                     INX   B   
0136   D6 21                  SUI   21h   ; A = c - 21h
0138   DA 78 01               JC   ctl   ; c < 21h: NUL ends, the rest are ignored
013B   FE 0F                  CPI   0Fh   
013D   DA 68 01               JC   punct   ; 21h-2Fh: PTAB index 0-14
0140   D6 0F                  SUI   0Fh   ; A = c - 30h
0142   FE 0A                  CPI   0Ah   
0144   DA 29 03               JC   digit   ; 30h-39h
0147   FE 11                  CPI   11h   
0149   DA 66 01               JC   p3a   ; 3Ah-40h
014C   D6 11                  SUI   11h   ; A = c - 41h
014E   FE 1A                  CPI   1Ah   
0150   DA A4 01               JC   upper   ; 41h-5Ah: A = letter index 0-25
0153   FE 20                  CPI   20h   
0155   DA 64 01               JC   p5b   ; 5Bh-60h
0158   FE 3A                  CPI   3Ah   
015A   DA 9E 01               JC   lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
015D   FE 3E                  CPI   3Eh   
015F   D2 34 01               JNC   next0   ; 7Fh-FFh: ignored
0162   D6 1A                  SUI   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
0164   D6 09        P5B:      SUI   9   ; 5Bh-60h: -4 in all, index 22-27
0166   C6 05        P3A:      ADI   5   ; 3Ah-40h: index 15-21
0168                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
0168                             ; untouched, and A, DE free.
0168   C6 09        PUNCT:    ADI   PTAB & 0FFh   ; PTAB never crosses a page
016A   5F                     MOV   E,A   
016B   16 03                  MVI   D,PTAB / 256   
016D   FE 1F                  CPI   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
016F   1A                     LDAX   D   
0170   5F                     MOV   E,A   ; the handler's low byte
0171                          IFN   CPM   
                              MVI   A,0   
                              RAL      ; its page: 0 + carry
0171                          ENDIF      
0171                          IF   CPM   
0171   3E 01                  MVI   A,1   
0173   CE 00                  ACI   0   ; its page: 1 + carry
0175                          ENDIF      
0175   57                     MOV   D,A   
0176   D5                     PUSH   D   ; jump to it; the stack is balanced again
0177   C9                     RET      ;   when the handler starts
0178                             ; ctl: characters below 21h. A = c - 21h.
0178   C6 21        CTL:      ADI   21h   ; back to c; zero only for NUL
017A   C2 34 01               JNZ   next0   ; the rest are ignored
017D   C3 00 00     ENDPROG:   JMP   EXIT   ; the program has ended
0180                             ; =============================================================================
0180                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
0180                             ;  (00bbIGFuZCA= are up among the RST routines.)
0180                             ; =============================================================================
0180   D1           H_XOR:    POP   D   
0181   7C                     MOV   A,H   
0182   AA                     XRA   D   
0183   67                     MOV   H,A   
0184   7D                     MOV   A,L   
0185   AB                     XRA   E   
0186   6F                     MOV   L,A   
0187   F7                     RST   6   
0188   D1           H_OR:     POP   D   
0189   7C                     MOV   A,H   
018A   B2                     ORA   D   
018B   67                     MOV   H,A   
018C   7D                     MOV   A,L   
018D   B3                     ORA   E   
018E   6F                     MOV   L,A   
018F   F7                     RST   6   
0190   E7           H_NOT:    RST   4   ; ~x = -x - 1
0191   2B                     DCX   H   
0192   F7                     RST   6   
0193                             ; "_" ( n -- addr ): the heap pointer moves up by n; TOS is the old pointer.
0193   EB           H_ALLOC:   XCHG      
0194   2A 7C 07               LHLD   HEAP   
0197   E5                     PUSH   H   
0198   19                     DAD   D   ; the new top
0199                          IF   CHECKED   
                              CALL   chkhp   
0199                          ENDIF      
0199   22 7C 07               SHLD   HEAP   
019C   E1                     POP   H   
019D   F7                     RST   6   
019E                             ; ---- the letters and digits --------------------------------------------------
019E                             ; a-z: push the cell's address (the cell is the variable)
019E   E5           LOWER:    PUSH   H   
019F   87                     ADD   A   
01A0   6F                     MOV   L,A   
01A1   26 07                  MVI   H,LETPAGE   
01A3   F7                     RST   6   
01A4                             ; A-Z: call the word. The return address (the IP after the letter) goes on
01A4                             ; the return stack, and the IP becomes the address in the letter's cell.
01A4   E5           UPPER:    PUSH   H   ; keep TOS: rpushd pops it back
01A5   87                     ADD   A   
01A6   6F                     MOV   L,A   
01A7   26 07                  MVI   H,LETPAGE   ; HL -> cell
01A9   50                     MOV   D,B   
01AA   59                     MOV   E,C   ; DE = the return address
01AB   4E                     MOV   C,M   
01AC   23                     INX   H   
01AD   46                     MOV   B,M   ; IP = the word's body, and fall into rpushd
01AE                             ; rpushd: push DE on the return stack, then pop TOS off the data stack and
01AE                             ; go on. Every push of the return stack ends here: for a word call the cell
01AE                             ; popped is the TOS that upper parked; for "(" and "{" it is the cell under
01AE                             ; the one that was used up.
01AE                RPUSHD:      
01AE                          IF   CHECKED   
                              CALL   chkbrk   ; Ctrl-C is checked at every word call, block
01AE                          ENDIF      ;   entry, loop-back and "{"
01AE   2A 34 07               LHLD   RSP   
01B1   2B                     DCX   H   
01B2   72                     MOV   M,D   
01B3   2B                     DCX   H   
01B4   73                     MOV   M,E   
01B5   22 34 07               SHLD   RSP   
01B8   E1                     POP   H   
01B9   F7                     RST   6   
01BA                             ; ---- machine code: the grave -----------------------------------------------
01BA                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
01BA                             ; are stored from addr until a non-hex character; then a RET (C9h) is
01BA                             ; written and its address is left. An odd last digit is consumed and dropped.
01BA                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
01BA                             ; code is entered by CALL with the data stack above the return address; it
01BA                             ; must keep BC, and on return the top cell becomes the new TOS.
01BA   CD B6 03     H_GRAVE:   CALL   hexc   
01BD   D2 2B 01               JNC   exec   
01C0   87           HX1:      ADD   A   
01C1   87                     ADD   A   
01C2   87                     ADD   A   
01C3   87                     ADD   A   
01C4   57                     MOV   D,A   ; the high digit
01C5   CD B6 03               CALL   hexc   
01C8   D2 D4 01               JNC   hx2   ; odd digit: consumed and dropped
01CB   B2                     ORA   D   
01CC                          IF   CHECKED   
                              CALL   chkst   
01CC                          ENDIF      
01CC   77                     MOV   M,A   
01CD   23                     INX   H   
01CE   CD B6 03               CALL   hexc   
01D1   DA C0 01               JC   hx1   
01D4                HX2:         
01D4                          IF   CHECKED   
                              CALL   chkst   
01D4                          ENDIF      
01D4   36 C9                  MVI   M,0C9h   
01D6   F7                     RST   6   
01D7                             ; ---- where the two pages meet ----------------------------------------------
01D7                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
01D7                             ; are in falling code order for this), and where exactly differs between the
01D7                             ; builds: NPG1 follows. Every handler below these four must start in the
01D7                             ; second page, and every one above in the first; chktab.py checks both.
01D7                             ; "]" returns: pop an address and jump to it. TOS is parked on the stack
01D7                             ; while rpop uses HL, and the drop at the end brings it back.
01D7   E5           H_RET:    PUSH   H   
01D8   CF           RET2:     RST   1   
01D9   44                     MOV   B,H   
01DA   4D                     MOV   C,L   
01DB   DF                     RST   3   
01DC                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
01DC                             ; drops the block start, "]" returns. No closer at all ends the program.
01DC                             ; The flag stays in HL as the spent cell that rdrop and ret2 drop.
01DC   7C           H_BREAK:   MOV   A,H   
01DD   B5                     ORA   L   
01DE   CA BC 02               JZ   h_drop   ; false: just drop the flag
01E1   CD 7F 03               CALL   skip   
01E4   B7                     ORA   A   ; skip returns 0 for ")"
01E5   C2 D8 01               JNZ   ret2   
01E8   C3 06 01               JMP   rdrop   
01EB                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
01EB                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
01EB                             ; the body"s address instead. Either way it then skips to the matching "]'.
01EB                             ; (The unchecked build takes anything below "A" as the space, and anything
01EB                             ; from "A" up as a letter.)
01EB   0A           H_DEF:    LDAX   B   
01EC   03                     INX   B   
01ED   D6 41                  SUI   "A"   ; 0-25 or 32-57: lowercase lands 64 bytes up
01EF                          IF   1-CHECKED   
01EF   DA FE 01               JC   def2   
01F2                          ENDIF      
01F2                          IF   CHECKED   
                              CPI   " "-"A"+256   
                              JZ   def2   
                              MOV   E,A   
                              ANI   0DFh   ; fold case
                              CPI   26   
                              JNC   e_brack   ; anything but a letter or a space
                              MOV   A,E   
01F2                          ENDIF      
01F2   87                     ADD   A   
01F3   5F                     MOV   E,A   
01F4   16 07                  MVI   D,LETPAGE   ; DE -> cell
01F6   79                     MOV   A,C   
01F7   12                     STAX   D   
01F8   1C                     INR   E   
01F9   78                     MOV   A,B   
01FA   12                     STAX   D   
01FB   C3 01 02               JMP   skipnx   
01FE   E5           DEF2:     PUSH   H   ; an anonymous block: push its address
01FF   60                     MOV   H,B   
0200   69                     MOV   L,C   
0201   CD 7F 03     SKIPNX:   CALL   skip   
0204   F7                     RST   6   
0205   5E           H_FETCH:   MOV   E,M   ; "@"
0206   23                     INX   H   
0207   56                     MOV   D,M   
0208   EB                     XCHG      
0209   F7                     RST   6   
020A                             ; =============================================================================
020A                             ;  Handlers that must start in the image's second page.
020A                             ;  "?" is the last (with "," inside it in the unchecked build), so its long
020A                             ;  tail may run past that page.
020A                             ; =============================================================================
020A                             ; ---- flow control ----------------------------------------------------------
020A                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
020A                             ; the matching ")".
020A   7C           H_OPEN:   MOV   A,H   
020B   B5                     ORA   L   
020C   E1                     POP   H   
020D   CA 01 02               JZ   skipnx   
0210   E5                     PUSH   H   ; (rpushd pops it again)
0211   50                     MOV   D,B   
0212   59                     MOV   E,C   ; the block starts at the IP
0213   C3 AE 01               JMP   rpushd   
0216                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
0216                             ; drops it and carries on.
0216   7C           H_CLOSE:   MOV   A,H   
0217   B5                     ORA   L   
0218   CA 06 01               JZ   rdrop   
021B   CF                     RST   1   ; pop the block start ...
021C   44                     MOV   B,H   
021D   4D                     MOV   C,L   ; ... jump to it ...
021E   EB                     XCHG      
021F   C3 AE 01               JMP   rpushd   ; ... and push it back (which drops the flag)
0222                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
0222                             ; "-" has two jobs: directly before a digit it starts a negative number.
0222   0A           H_SUB:    LDAX   B   
0223   D6 30                  SUI   "0"   
0225   FE 0A                  CPI   10   
0227   DA 2F 03               JC   negnum   
022A   E7                     RST   4   ; a - b = a + (-b): fall into "+"
022B   D1           H_ADD:    POP   D   
022C   19                     DAD   D   
022D   F7                     RST   6   
022E   D1           H_AND:    POP   D   
022F   7C                     MOV   A,H   
0230   A2                     ANA   D   
0231   67                     MOV   H,A   
0232   7D                     MOV   A,L   
0233   A3                     ANA   E   
0234   6F                     MOV   L,A   
0235   F7                     RST   6   
0236                             ; Signed compares. Both are "DE < HL" for the right pair: > swaps the two
0236                             ; cells first (XTHL), < doesn't. There is no overflow flag, so the signed
0236                             ; answer is the unsigned borrow of DE - HL, flipped when the signs differ.
0236                             ; SBB A turns a carry into -1 or 0 with no branch.
0236   E3           H_GT:     XTHL      ; a > b  is  b < a
0237   D1           H_LT:     POP   D   ; a < b: DE = a, HL = b
0238   7B                     MOV   A,E   
0239   95                     SUB   L   
023A   7A                     MOV   A,D   
023B   9C                     SBB   H   
023C   9F                     SBB   A   ; A = -1 if DE < HL unsigned
023D   6F                     MOV   L,A   
023E   7C                     MOV   A,H   
023F   AA                     XRA   D   
0240   17                     RAL      ; carry = the signs differ
0241   9F                     SBB   A   
0242   AD                     XRA   L   ; flip when they do
0243   67                     MOV   H,A   
0244   6F                     MOV   L,A   
0245   F7                     RST   6   
0246   D1           H_EQ:     POP   D   
0247   7D                     MOV   A,L   
0248   AB                     XRA   E   
0249   6F                     MOV   L,A   
024A   7C                     MOV   A,H   
024B   AA                     XRA   D   
024C   B5                     ORA   L   ; zero if equal
024D   D6 01                  SUI   1   ; carry only for zero
024F   9F                     SBB   A   
0250   67                     MOV   H,A   
0251   6F                     MOV   L,A   
0252   F7                     RST   6   
0253                             ; "*": shift-and-add on the multiplier's low bit, so it stops as soon as the
0253                             ; multiplier is used up; only the low 16 bits are kept.
0253   D1           H_MUL:    POP   D   ; DE = multiplicand
0254   C5                     PUSH   B   
0255   44                     MOV   B,H   
0256   4D                     MOV   C,L   ; BC = multiplier
0257   21 00 00               LXI   H,0   
025A   78           MUL1:     MOV   A,B   
025B   B7                     ORA   A   ; clear carry
025C   1F                     RAR      
025D   47                     MOV   B,A   
025E   79                     MOV   A,C   
025F   1F                     RAR      
0260   4F                     MOV   C,A   ; BC >> 1, carry = the bit shifted out
0261   D2 65 02               JNC   mul2   
0264   19                     DAD   D   
0265   EB           MUL2:     XCHG      
0266   29                     DAD   H   ; multiplicand << 1
0267   EB                     XCHG      
0268   78                     MOV   A,B   
0269   B1                     ORA   C   
026A   C2 5A 02               JNZ   mul1   
026D   C1                     POP   B   
026E   F7                     RST   6   
026F                             ; "/" ( a b -- r q ): the quotient is on top. Truncates toward zero; r takes
026F                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
026F                             ; of a. Dividing by zero is not checked: it returns two cells of no meaning.
026F   D1           H_DIV:    POP   D   ; DE = a, HL = b
0270   C5                     PUSH   B   
0271   7A                     MOV   A,D   
0272   B7                     ORA   A   
0273   F5                     PUSH   PSW   ; S flag = sign of a (for r)
0274   AC                     XRA   H   
0275   F5                     PUSH   PSW   ; S flag = sign of q
0276   7C                     MOV   A,H   
0277   B7                     ORA   A   
0278   FC 20 01               CM   neg16   ; HL = |b|
027B   EB                     XCHG      
027C   7C                     MOV   A,H   
027D   B7                     ORA   A   
027E   FC 20 01               CM   neg16   ; HL = |a|, DE = |b|
0281   CD 4C 03               CALL   udiv   ; HL = q, BC = r
0284   F1                     POP   PSW   
0285   FC 20 01               CM   neg16   ; q's sign
0288   EB                     XCHG      ; DE = q
0289   60                     MOV   H,B   
028A   69                     MOV   L,C   ; HL = r
028B   F1                     POP   PSW   
028C   FC 20 01               CM   neg16   ; r's sign
028F   C1                     POP   B   
0290   E5                     PUSH   H   ; r under q
0291   EB                     XCHG      ; HL = q
0292   F7                     RST   6   
0293                             ; ---- stack and storage -----------------------------------------------------
0293   E5           H_DUP:    PUSH   H   ; ":"
0294   F7                     RST   6   
0295   E3           H_SWAP:   XTHL      ; "%"
0296   F7                     RST   6   
0297   D1           H_STORE:   POP   D   ; "!" ( n addr -- )
0298                          IF   CHECKED   
                              INX   H   ; both bytes must be in the program's space
                              CALL   chkst   
                              DCX   H   
0298                          ENDIF      
0298   73                     MOV   M,E   
0299   23                     INX   H   
029A   72                     MOV   M,D   
029B   DF                     RST   3   
029C   D1           H_CSTORE:   POP   D   ; "." ( c addr -- )
029D                          IF   CHECKED   
                              CALL   chkst   
029D                          ENDIF      
029D   73                     MOV   M,E   
029E   DF                     RST   3   
029F                             ; ---- console ---------------------------------------------------------------
029F                             ; 22h pushes the address of the text after it and skips the string.
029F   E5           H_STR:    PUSH   H   
02A0   60                     MOV   H,B   
02A1   69                     MOV   L,C   
02A2   CD A9 03               CALL   skipstr   
02A5   F7                     RST   6   
02A6                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character
02A6                             ; clears that character"s bit 6 (/M is CR, /` is space; "/" and ""' have no
02A6                             ; bit 6, so // and /" give themselves).
02A6   7E           H_PRINT:   MOV   A,M   
02A7   23                     INX   H   
02A8   FE 22                  CPI   22h   
02AA   CA BC 02               JZ   h_drop   
02AD   FE 2F                  CPI   "/"   
02AF   C2 B6 02               JNZ   pr1   
02B2   7E                     MOV   A,M   
02B3   23                     INX   H   
02B4   E6 BF                  ANI   0BFh   
02B6   EF           PR1:      RST   5   
02B7   C3 A6 02               JMP   h_print   
02BA   7D           H_EMIT:   MOV   A,L   ; "'"
02BB   EF                     RST   5   
02BC   DF           H_DROP:   RST   3   ; ";" is this one byte
02BD                             ; "#" prints TOS as a signed decimal number, with no space after it.
02BD   7C           H_NUM:    MOV   A,H   
02BE   B7                     ORA   A   
02BF   F2 C6 02               JP   num1   
02C2   3E 2D                  MVI   A,"-"   
02C4   EF                     RST   5   
02C5   E7                     RST   4   
02C6   C5           NUM1:     PUSH   B   
02C7   CD 6D 03               CALL   pdec   
02CA   C1                     POP   B   
02CB   DF                     RST   3   
02CC                          IF   CHECKED   ; (the checked build has no room to start ","
                    H_CFETCH:   MOV   L,M   ;   as late as the unchecked one does: see
                              MVI   H,0   ;   the end of "?")
                              RST   6   
02CC                          ENDIF      
02CC                             ; "?" ( n -- c ) or ( -n -- addr )
02CC                             ;   n > 0: wait about n ms for a key; 0 if none came
02CC                             ;   n = 0: wait for a key
02CC                             ;   n < 0: read a line of at most -n characters, with echo. n is not
02CC                             ;          checked: the buffer holds 127 characters and the CR, so a
02CC                             ;          program must ask for 127 or fewer.
02CC   7C           H_KEY:    MOV   A,H   
02CD   B7                     ORA   A   
02CE   FA EE 02               JM   line   
02D1   1E 28        KT1:      MVI   E,MSLOOP   ; one millisecond, roughly
02D3   CD C9 03     KT2:      CALL   getk   
02D6   C2 EA 02               JNZ   kt3   
02D9   1D                     DCR   E   
02DA   C2 D3 02               JNZ   kt2   
02DD   7C                     MOV   A,H   ; 0? never counts down: it waits
02DE   B5                     ORA   L   
02DF   CA D1 02               JZ   kt1   
02E2   2B                     DCX   H   
02E3   7C                     MOV   A,H   
02E4   B5                     ORA   L   
02E5   C2 D1 02               JNZ   kt1   ; A = 0 if the time ran out
02E8                          IF   1-CHECKED   
02E8   FE                     DB   0FEh   ; (CPI: steps over the one byte of ",")
02E9   7E           H_CFETCH:   MOV   A,M   ; "," shares "?"s ending: A becomes TOS
02EA                          ENDIF      
02EA   6F           KT3:      MOV   L,A   
02EB   26 00                  MVI   H,0   
02ED   F7                     RST   6   
02EE                          IF   CPM   
02EE                             ; CP/M: BDOS 10 does the editing (the spec allows the platform's
02EE                             ; own line editor). It doesn't store the CR, so it is added here.
02EE   AF           LINE:     XRA   A   
02EF   95                     SUB   L   ; A = the count (TOS is minus the count)
02F0   32 7E 07               STA   LBHDR   
02F3   C5                     PUSH   B   
02F4   11 7E 07               LXI   D,LBHDR   
02F7   0E 0A                  MVI   C,10   
02F9   CD 05 00               CALL   BDOS   
02FC   C1                     POP   B   
02FD   21 7F 07               LXI   H,LBHDR+1   
0300   7E                     MOV   A,M   ; the count typed (0-127)
0301   2C                     INR   L   ; HL = LINEBUF, whose low byte is 80h:
0302   85                     ADD   L   ;   adding the count to L can't carry
0303   6F                     MOV   L,A   
0304   36 0D                  MVI   M,13   
0306   2E 80                  MVI   L,LINEBUF & 0FFh   
0308   F7                     RST   6   
0309                          ENDIF      
0309                          IFN   CPM   
                                 ; Generic: Backspace takes the last character back (and is echoed as
                                 ; it is), CR ends (stored, not echoed), every other key is stored and
                                 ; echoed until the line is full. The line buffer starts at offset 80h
                                 ; of its page, so L alone is the place in the line: D holds the L of
                                 ; a full line.
                    LINE:     MVI   A,LINEBUF & 0FFh   
                              SUB   L   ; (TOS is minus the count)
                              MOV   D,A   ; D = the L of a full line
                              LXI   H,LINEBUF   
                    LN2:      CALL   getk   
                              JZ   ln2   
                              CPI   13   
                              JZ   ln5   
                              CPI   8   
                              JZ   ln4   
                              MOV   E,A   
                              MOV   A,L   
                              CMP   D   
                              JZ   ln2   ; full
                              MOV   M,E   
                              INR   L   
                              MOV   A,E   
                    LN3:      RST   5   
                              JMP   ln2   
                    LN4:      DCR   L   ; Backspace: one back, and echo it,
                              JM   ln3   ;   unless the line was empty (L left the
                              INR   L   ;   upper half of the page)
                              JMP   ln2   
                    LN5:      MOV   M,A   ; the CR
                              MVI   L,LINEBUF & 0FFh   
                              RST   6   
0309                          ENDIF      
0309                             ; =============================================================================
0309                             ;  Dispatch table: the low byte of each handler's address, in code order.
0309                             ;  It must not cross a page (the dispatcher only adds to its low byte).
0309                             ; =============================================================================
0309                             ; The handlers of the first NPG1 characters start in the image's second page.
0309                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
0309                             ; differs between the builds, so the count is worked out here.
0309                             ; (One division to a line: asm80 only rounds down when it stores a value.)
0309                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
0309                PGBRK:    EQU   (h_break-BASE)/256   
0309                PGDEF:    EQU   (h_def-BASE)/256   
0309                PGFET:    EQU   (h_fetch-BASE)/256   
0309                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
0309   97           PTAB:     DB   h_store & 0FFh   ; !
030A   9F                     DB   h_str & 0FFh   ; "
030B   BD                     DB   h_num & 0FFh   ; #
030C   A6                     DB   h_print & 0FFh   ; $
030D   95                     DB   h_swap & 0FFh   ; %
030E   2E                     DB   h_and & 0FFh   ; &
030F   BA                     DB   h_emit & 0FFh   ; '
0310   0A                     DB   h_open & 0FFh   ; (
0311   16                     DB   h_close & 0FFh   ; )
0312   53                     DB   h_mul & 0FFh   ; *
0313   2B                     DB   h_add & 0FFh   ; +
0314   E9                     DB   h_cfetch & 0FFh   ; ,
0315   22                     DB   h_sub & 0FFh   ; -
0316   9C                     DB   h_cstore & 0FFh   ; .
0317   6F                     DB   h_div & 0FFh   ; /
0318   93                     DB   h_dup & 0FFh   ; :
0319   BC                     DB   h_drop & 0FFh   ; ;
031A   37                     DB   h_lt & 0FFh   ; <
031B   46                     DB   h_eq & 0FFh   ; =
031C   36                     DB   h_gt & 0FFh   ; >
031D   CC                     DB   h_key & 0FFh   ; ?
031E   05                     DB   h_fetch & 0FFh   ; @
031F   EB                     DB   h_def & 0FFh   ; [
0320   DC                     DB   h_break & 0FFh   ; \
0321   D7                     DB   h_ret & 0FFh   ; ]
0322   80                     DB   h_xor & 0FFh   ; ^
0323   93                     DB   h_alloc & 0FFh   ; _
0324   BA                     DB   h_grave & 0FFh   ; `
0325   14                     DB   h_tor & 0FFh   ; {
0326   88                     DB   h_or & 0FFh   ; |
0327   1D                     DB   h_fromr & 0FFh   ; }
0328   90                     DB   h_not & 0FFh   ; ~
0329                PTABEND:      
0329                             ; =============================================================================
0329                             ;  Routines (no handler starts past this point)
0329                             ; =============================================================================
0329                             ; Digits: step back onto the first digit and read the whole number.
0329   E5           DIGIT:    PUSH   H   
032A   0B                     DCX   B   
032B   CD 35 03               CALL   rdnum   
032E   F7                     RST   6   
032F                             ; negnum: "-" directly before a digit: read the number, negate it.
032F   E5           NEGNUM:   PUSH   H   
0330   CD 35 03               CALL   rdnum   
0333   E7                     RST   4   
0334   F7                     RST   6   
0335                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
0335                             ; non-digit. Values wrap at 16 bits, as the spec says.
0335   21 00 00     RDNUM:    LXI   H,0   
0338   0A           RDN1:     LDAX   B   
0339   D6 30                  SUI   "0"   
033B   FE 0A                  CPI   10   
033D   D0                     RNC      
033E   03                     INX   B   
033F   54                     MOV   D,H   
0340   5D                     MOV   E,L   
0341   29                     DAD   H   
0342   29                     DAD   H   
0343   19                     DAD   D   
0344   29                     DAD   H   ; HL * 10
0345   5F                     MOV   E,A   
0346   16 00                  MVI   D,0   
0348   19                     DAD   D   
0349   C3 38 03               JMP   rdn1   
034C                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, BC = remainder.
034C                             ; Uses A, BC; the caller saves the IP. HL holds the dividend and, as its bits
034C                             ; leave at the top, the quotient bits arrive at the bottom. The loop counter
034C                             ; lives on the stack, since A is busy with the shifts.
034C   01 00 00     UDIV:     LXI   B,0   
034F   3E 10                  MVI   A,16   
0351   F5                     PUSH   PSW   
0352   29           UDV1:     DAD   H   ; next dividend bit into the carry
0353   79                     MOV   A,C   
0354   17                     RAL      
0355   4F                     MOV   C,A   
0356   78                     MOV   A,B   
0357   17                     RAL      
0358   47                     MOV   B,A   ; BC = BC*2 + bit
0359   79                     MOV   A,C   
035A   93                     SUB   E   
035B   78                     MOV   A,B   
035C   9A                     SBB   D   ; carry if BC < DE
035D   DA 65 03               JC   udv2   
0360   47                     MOV   B,A   ; BC - DE (high byte; A holds it)
0361   79                     MOV   A,C   
0362   93                     SUB   E   
0363   4F                     MOV   C,A   
0364   2C                     INR   L   ; quotient bit
0365   F1           UDV2:     POP   PSW   
0366   3D                     DCR   A   
0367   F5                     PUSH   PSW   
0368   C2 52 03               JNZ   udv1   
036B   F1                     POP   PSW   
036C   C9                     RET      
036D                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
036D                             ; Uses BC.
036D   11 0A 00     PDEC:     LXI   D,10   
0370   CD 4C 03               CALL   udiv   ; HL = HL / 10, C = the last digit
0373   79                     MOV   A,C   
0374   F5                     PUSH   PSW   
0375   7C                     MOV   A,H   
0376   B5                     ORA   L   
0377   C4 6D 03               CNZ   pdec   
037A   F1                     POP   PSW   
037B   C6 30                  ADI   "0"   
037D   EF                     RST   5   
037E   C9                     RET      
037F                             ; skip: read past text to the closer at this level, and return A = 0 if it
037F                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
037F                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
037F                             ; no closer; anything else that runs into the NUL had unbalanced brackets
037F                             ; anyway). D counts the open levels, starting at 1 for the one we are in.
037F   16 01        SKIP:     MVI   D,1   
0381   0A           SK1:      LDAX   B   
0382   03                     INX   B   
0383   B7                     ORA   A   
0384   CA 7D 01               JZ   endprog   
0387   FE 22                  CPI   22h   
0389   CC A9 03               CZ   skipstr   ; leaves A = 22h, which matches nothing below
038C   D6 28                  SUI   "("   
038E   CA A4 03               JZ   sk3   
0391   3D                     DCR   A   ; ")"
0392   CA 9F 03               JZ   sk4   
0395   D6 32                  SUI   "["-")"   
0397   CA A4 03               JZ   sk3   
039A   FE 02                  CPI   "]"-"["   
039C   C2 81 03               JNZ   sk1   
039F   15           SK4:      DCR   D   
03A0   C8                     RZ      ; the closer at this level
03A1   C3 81 03               JMP   sk1   
03A4   14           SK3:      INR   D   
03A5   C3 81 03               JMP   sk1   
03A8                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
03A8                             ; the next character, so "/"" does not end it. Leaves A = 22h.
03A8   03           SS0:      INX   B   
03A9   0A           SKIPSTR:   LDAX   B   
03AA   03                     INX   B   
03AB   FE 2F                  CPI   "/"   
03AD   CA A8 03               JZ   ss0   
03B0   FE 22                  CPI   22h   
03B2   C2 A9 03               JNZ   skipstr   
03B5   C9                     RET      
03B6                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
03B6                             ; and return its value in A with the carry set; otherwise leave the IP and
03B6                             ; return with the carry clear.
03B6   0A           HEXC:     LDAX   B   
03B7   D6 30                  SUI   "0"   
03B9   FE 0A                  CPI   10   
03BB   DA C7 03               JC   hc1   
03BE   E6 DF                  ANI   0DFh   
03C0   D6 11                  SUI   11h   
03C2   FE 06                  CPI   6   
03C4   D0                     RNC      
03C5   D6 F6                  SUI   0F6h   ; + 10, and sets the carry
03C7   03           HC1:      INX   B   
03C8   C9                     RET      
03C9                             ; =============================================================================
03C9                             ;  Console layer: getk returns a waiting key in A (zero flag clear), or
03C9                             ;  A = 0 with the zero flag set when none is waiting. putc (RST 5) prints A.
03C9                             ;  Both keep BC, DE and HL. In the generic build they are the host's KEY and
03C9                             ;  CONOUT routines themselves.
03C9                             ; =============================================================================
03C9                          IF   (1-CPM)*(1-CHECKED)   
                    GETK:     EQU   KEY   ; the host's routine does the whole job
03C9                          ENDIF      
03C9                          IF   CHECKED   
                    GETK:     PUSH   H   ; a key held back by the break check goes
                              LXI   H,KEYBUF   ;   first, and is taken out of the buffer
                              MOV   A,M   
                              MVI   M,0   
                              POP   H   
                              ORA   A   
                              RNZ      
03C9                          ENDIF      
03C9                          IF   (1-CPM)*CHECKED   
                              JMP   KEY   
03C9                          ENDIF      
03C9                          IF   CPM*(1-CHECKED)   
03C9                GETK:        
03C9                          ENDIF      
03C9                          IF   CPM   
03C9   3E FF                  MVI   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
03CB                             ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
03CB                             ; printing and could swallow a key that BDOS 6 then never sees.
03CB   C5           PUTC:     PUSH   B   
03CC   D5                     PUSH   D   
03CD   E5                     PUSH   H   
03CE   5F                     MOV   E,A   
03CF   0E 06                  MVI   C,6   
03D1   CD 05 00               CALL   BDOS   
03D4   E1                     POP   H   
03D5   D1                     POP   D   
03D6   C1                     POP   B   
03D7   B7                     ORA   A   ; (for getk)
03D8   C9                     RET      
03D9                          ENDIF      
03D9                             ; =============================================================================
03D9                             ;  Checked build: the checks and the error report
03D9                             ; =============================================================================
03D9                          IF   CHECKED   
                                 ; chkstk: both stacks are checked once per character, not in every handler.
                                 ; Each stack lives in one page, so it has overrun exactly when the pointer's
                                 ; high byte has left that page. Errors are caught one cell late at most; the
                                 ; page below each stack is a guard band. (The call itself is on the data
                                 ; stack, but in the same page whenever the stack is in range.)
                    CHKSTK:   XCHG      ; DE = TOS (HL is needed for the pointers)
                              LXI   H,0   
                              DAD   SP   
                              MOV   A,H   
                              CPI   DSPAGE   
                              JNZ   e_stack   
                              LHLD   RSP   ; the return stack: in its page, and not
                              MOV   A,L   ;   above its empty position (an underflow
                              CPI   RSTOP&0FFh+1   ;   would stay inside the page, in the
                              JNC   e_rstack   ;   guard band)
                              MOV   A,H   
                              CPI   RSPAGE   
                              JNZ   e_rstack   
                              XCHG      ; TOS back
                              RET      
                                 ; chkbrk: a waiting key is read now; Ctrl-C stops the program, anything
                                 ; else is held for the next "?". Keeps BC, DE, HL.
                    CHKBRK:   CALL   getk   
                              RZ      
                              CPI   3   
                              JZ   e_break   
                              STA   KEYBUF   
                              RET      
                                 ; chkst: stop unless HL is in the program's own space: from the letter page
                                 ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
                                 ; whatever lies above the limit are safe. Memory above the heap top but
                                 ; below the limit is the program's own: Tiny BASIC keeps its lines there.
                                 ; Keeps every register.
                    CHKST:    PUSH   PSW   
                              MOV   A,H   
                              CPI   LETPAGE   
                              JC   e_store   
03D9                          ENDIF      
03D9                          IF   CHECKED*(1-CPM)   
                              CPI   HEAPLIM   
                              JNC   e_store   
03D9                          ENDIF      
03D9                          IF   CHECKED*CPM   
                              LDA   0007h   ; the BDOS page is the heap limit
                              DCR   A   
                              CMP   H   
                              JC   e_store   
03D9                          ENDIF      
03D9                          IF   CHECKED   
                              POP   PSW   
                              RET      
                                 ; chkhp: stop if working out the new heap top carried (a negative count
                                 ; wraps: too big), or if the new top in HL is not below the limit page.
                    CHKHP:    JC   e_heap   
03D9                          ENDIF      
03D9                          IF   CHECKED*(1-CPM)   
                              MOV   A,H   
                              CPI   HEAPLIM   
                              RC      
03D9                          ENDIF      
03D9                          IF   CHECKED*CPM   
                              LDA   0007h   
                              DCR   A   
                              CMP   H   
                              RNC      
03D9                          ENDIF      
03D9                          IF   CHECKED   
                                 ; Error entries. Each loads its letter and then hides the next entry inside
                                 ; a 3-byte LXI H (the 21h), so they all fall through to `error`.
                    E_HEAP:   MVI   A,"H"   ; heap past the limit
                              DB   21h   
                    E_STORE:   MVI   A,"W"   ; write outside the program's space
                              DB   21h   
                    E_STACK:   MVI   A,"S"   ; data stack over or under
                              DB   21h   
                    E_RSTACK:   MVI   A,"R"   ; return stack over or under
                              DB   21h   
                    E_BREAK:   MVI   A,"B"   ; Ctrl-C
                              DB   21h   
                    E_BRACK:   MVI   A,"D"   ; bad character after [
                                 ; error: print the letter in A, " @ " and the offset in the program of the
                                 ; character just read, then end. For example: S @ 245
                    ERROR:    LXI   SP,DSTOP   ; the stacks may be wrecked: start clean
                              RST   5   
                              MVI   A," "   
                              RST   5   
                              MVI   A,"@"   
                              RST   5   
                              MVI   A," "   
                              RST   5   
                              LXI   H,(0-PROG-1)&0FFFFh   ; minus the address of the character
                              DAD   B   ;   just read: HL = its offset
                              CALL   pdec   
                              JMP   endprog   
03D9                          ENDIF      
03D9                             ; =============================================================================
03D9                             ;  Startup
03D9                             ; =============================================================================
03D9                START:       
03D9                          IF   CPM   
03D9                             ; CP/M: the RAM pages follow the image; the heap may grow to the BDOS
03D9   21 08 01               LXI   H,vecs   ; the RST routines go down into page zero
03DC   11 08 00               LXI   D,0008h   
03DF   06 2C                  MVI   B,vecend-vecs   
03E1   7E           CPY:      MOV   A,M   
03E2   12                     STAX   D   
03E3   23                     INX   H   
03E4   13                     INX   D   
03E5   05                     DCR   B   
03E6   C2 E1 03               JNZ   cpy   
03E9   11 5C 00               LXI   D,005Ch   ; open the file named on the command line
03EC   0E 0F                  MVI   C,15   ; (no such file: the first read fails too,
03EE   CD 05 00               CALL   BDOS   ;   and the program is empty)
03F1   11 00 08               LXI   D,PROG   
03F4   D5           LD1:      PUSH   D   
03F5   0E 1A                  MVI   C,26   ; set the DMA address
03F7   CD 05 00               CALL   BDOS   
03FA   11 5C 00               LXI   D,005Ch   
03FD   0E 14                  MVI   C,20   ; read the next 128 bytes
03FF   CD 05 00               CALL   BDOS   
0402   E1                     POP   H   ; HL = the address this record went to
0403   B7                     ORA   A   
0404   C2 0F 04               JNZ   ld2   
0407   11 80 00               LXI   D,128   
040A   19                     DAD   D   
040B   EB                     XCHG      
040C   C3 F4 03               JMP   ld1   
040F   36 00        LD2:      MVI   M,0   ; the end of the file counts as NUL
0411   23                     INX   H   ; the heap starts after it
0412                          ENDIF      
0412                          IFN   CPM   
                              LXI   H,PROG   ; the heap starts after the program's NUL
                    FNUL:     MOV   A,M   
                              INX   H   
                              ORA   A   
                              JNZ   fnul   
0412                          ENDIF      
0412   22 7C 07               SHLD   HEAP   
0415   21 E0 05               LXI   H,RSTOP   ; the return stack is empty
0418   22 34 07               SHLD   RSP   
041B                          IF   CHECKED   
                              XRA   A   
                              STA   KEYBUF   ; no key held back
041B                          ENDIF      
041B   01 00 08               LXI   B,PROG   ; the IP
041E   F7                     RST   6   ; (its return address is thrown away)
041F                          IF   CPM   
041F                             ; RAM pages, after the image
041F                RSPAGE:   EQU   (imgend + 255) / 256   
041F                DSPAGE:   EQU   RSPAGE + 1   
041F                LETPAGE:   EQU   RSPAGE + 2   
041F                PROG:     EQU   LETPAGE*256 + 256   
041F                          ENDIF      
041F                IMGEND:      


