06D3   CA E8 06               JZ   er8   
06D6   2B                     DCX   H   
06D7   56                     MOV   D,M   
06D8   2B                     DCX   H   
06D9   5E                     MOV   E,M   
06DA   E5                     PUSH   H   
06DB   C5                     PUSH   B   
06DC   3E 20                  MVI   A," "   
