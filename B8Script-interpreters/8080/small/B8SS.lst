072F                          IF   CPM   
072F                             ; RAM pages, after the image
072F                CPAGE:    EQU   (imgend + 255) / 256   ; the skip cache (QK builds), first, so
072F                RSPAGE:   EQU   CPAGE + QK   ;   that the letter page is still the one
072F                DSPAGE:   EQU   RSPAGE + 1   ;   just below the program text
072F                LETPAGE:   EQU   RSPAGE + 2   
072F                PROG:     EQU   LETPAGE*256 + 256   
072F                          ENDIF      
072F                IMGEND:      


