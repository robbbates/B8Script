   422                              <1> ; ---- before the window: what its handlers jump to, within a short jump --
   423                              <1> ; A-Z: call the word. The return address (the IP after the letter) goes on
   424                              <1> ; the return stack, and the IP becomes the address in the letter's cell.
   425 000000ED 89F2                <1> upper:  mov     edx,esi
   426 000000EF 668BB40000014100    <1>         mov     si,[ARENA+LET+eax*2]
   427                              <1> 
   428                              <1> ; rpush: push EDX on the return stack, then next. Everything that pushes the
   429                              <1> ; return stack ends here, and the true ')' comes to rpoll.
   430                              <1> ;
   431                              <1> ; The break key is looked at here, so at every word call and loop-back (and
   432                              <1> ; block entry and '{'), but only one time in 256: V_PCNT counts them.
   433 000000F7 83EF04              <1> rpush:  sub     edi,4
   434 000000FA 8917                <1>         mov     [edi],edx
   435 000000FC FE4D5B              <1> rpoll:  dec     byte [V(v_pcnt)]
