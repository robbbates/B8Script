0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Spec: docs/b8script.md (2026-10-09) plus the 2026-11-20 changes:
0000                             ;        [x stores in a variable, "[ " pushes an anonymous block, any other
0000                             ;        character after [ is an error, the heap pointer lives at z10+.
0000                             ;        The string escape is "/" (it was ">").
0000                             ; 
0000                             ;  Two switches, set in the two EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    CHECKED  0 = no checks (spec: "B8Script checks nothing")
0000                             ;             1 = stops on stack overrun, Ctrl-C, heap past the limit, a store
0000                             ;                 outside the program's own space, and a bad character after [,
0000                             ;                 printing a letter and the place, like  S @ 245
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   1   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   0   ; 1 = checked build
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    HL'  return-stack pointer (the alternate HL). Entries are 2 bytes; the
0000                             ;         stack grows down. Only rpush and rpop (and the checks) touch it.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  A handler ends with RST 10h ("next character") or RST 08h ("drop, then
0000                             ;  next"), one byte each instead of a three-byte JP. An RST is a CALL, so the
0000                             ;  first thing each stub does is POP DE to throw the return address away.
0000                             ; -----------------------------------------------------------------------------
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (SP stays inside this page)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch (= z10+), interpreter variables in the gaps, and the -n?
0000                             ;             line buffer at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack's page has a guard band: the data
0000                             ;  stack can overrun by a cell or two (and the calls made while it is full)
0000                             ;  into the top 32 bytes of the return-stack page, which are never used, and
0000                             ;  the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
0000                BDOS:     EQU   0005h   
0000                          ENDIF      
0000                          IFN   CPM   
                                 ; ---- generic machine: edit these to suit -----------------------------------
                    KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
                                 ;   waiting. The zero flag must match A
                                 ;   (end the routine with OR A / RET).
                    CONOUT:   EQU   0FF03h   ; print the character in A
                    EXIT:     EQU   0FF09h   ; where to go when the program ends
                                 ;   KEY and CONOUT must preserve BC, DE, HL and HL'.
                    RSPAGE:   EQU   80h   ; 8000h return stack
                    DSPAGE:   EQU   81h   ; 8100h data stack
                    LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
                    PROG:     EQU   8300h   ; where the loader puts the program text
                    HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms: each pass
0000                             ; calls getk once, so tune it for your clock
0000                             ; and your CONST routine
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; z10+, the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                KEYBUF:   EQU   LET+36h   ;   around machine code; a held-back key;
0000                SPTMP:    EQU   LET+38h   ;   scratch for the SP check;
0000                HLIM:     EQU   LET+3Ah   ;   high byte of the heap limit
0000                LBHDR:    EQU   LET+7Eh   ; CP/M BDOS 10 header: max, count
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FEh   ; empty data stack
0000                             ; =============================================================================
0000                             ;  Page zero (generic ROM) or the start of the .COM file (CP/M)
0000                             ; =============================================================================
0000                          IF   CPM   
0100                          .ORG   0100h   
0100   C3 13 04               JP   start   
0103                          ENDIF      
0103                          IFN   CPM   
                              .ORG   0000h   
                              JP   start   ; 0000h reset
                    ENDPROG:      
                              JP   EXIT   ; 0003h the program has ended
                    H_DUP:    PUSH   HL   ; 0006h ":" (two-byte handlers fill the gaps)
                              RST   10h   
                                 ; ---- RST 08h: drop TOS, then next ------------------------------------------
                              POP   DE   ; 0008h discard the RST's return address
                    DROP_NEXT:      
                              POP   HL   ; new TOS = NOS
                              JR   next0   
                    H_SWAP:   EX   (SP),HL   ; 000Ch "%"
                              RST   10h   
                              DB   0,0   ; 000Eh spare
                                 ; ---- RST 10h: next character ------------------------------------------------
                              POP   DE   ; 0010h discard the RST's return address
0103                          ENDIF      
0103                             ; =============================================================================
0103                             ;  The inner loop: read one character and sort it by range.
0103                             ; 
0103                             ;    00h          end of program
0103                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0103                             ;    30h-39h      digit: read a whole number
0103                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0103                             ;    61h-7Ah      a-z: push the address of that letter's cell
0103                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0103                             ; =============================================================================
0103                NEXT0:       
0103                          IF   CHECKED   
                                 ; Both stacks are checked once per character, not in every handler.
                                 ; Each stack lives in one page, so it has overrun exactly when the
                                 ; pointer's high byte has left that page. Errors are caught one cell
                                 ; late at most; the page below each stack is a guard band.
                              LD   (SPTMP),SP   
                              LD   A,(SPTMP+1)   
                              CP   DSPAGE   
                              JP   NZ,e_stack   
                              EXX      ; the return stack: in its page, and not
                              LD   A,L   ;   above its empty position (an underflow
                              CP   RSTOP&0FFh+1   ;   would stay inside the page, in the
                              LD   A,H   ;   guard band)
                              EXX      
                              JP   NC,e_rstack   
                              CP   RSPAGE   
                              JP   NZ,e_rstack   
0103                          ENDIF      
0103   0A                     LD   A,(BC)   
0104   03                     INC   BC   
0105   D6 21                  SUB   21h   ; A = c - 21h
0107   38 38                  JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
0109   FE 0F                  CP   0Fh   
010B   38 26                  JR   C,punct   ; 21h-2Fh: PTAB index 0-14
010D   D6 0F                  SUB   0Fh   ; A = c - 30h
010F   FE 0A                  CP   0Ah   
0111   38 4A                  JR   C,digit   ; 30h-39h
0113   FE 11                  CP   11h   
0115   30 04                  JR   NC,ab40   
0117   C6 05                  ADD   A,5   ; 3Ah-40h: index 15-21
0119   18 18                  JR   punct   
011B   D6 11        AB40:     SUB   11h   ; A = c - 41h
011D   FE 1A                  CP   1Ah   
011F   38 2D                  JR   C,upper   ; 41h-5Ah: A = letter index 0-25
0121   FE 20                  CP   20h   
0123   30 04                  JR   NC,ab60   
0125   D6 04                  SUB   4   ; 5Bh-60h: index 22-27
0127   18 0A                  JR   punct   
0129   FE 3A        AB60:     CP   3Ah   
012B   38 1B                  JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
012D   FE 3E                  CP   3Eh   
012F   30 D2                  JR   NC,next0   ; 7Fh-FFh: ignored
0131   D6 1E                  SUB   1Eh   ; 7Bh-7Eh: index 28-31
0133                             ; Punctuation: HL holds TOS, so it is parked in DE while the table is read.
0133                             ; PTAB never crosses a page (checked at assembly), so only L needs adding.
0133   EB           PUNCT:    EX   DE,HL   ; DE = TOS
0134   87                     ADD   A,A   
0135   C6 63                  ADD   A,PTAB & 0FFh   
0137   6F                     LD   L,A   
0138   26 01                  LD   H,PTAB / 256   
013A   7E                     LD   A,(HL)   
013B   2C                     INC   L   
013C   66                     LD   H,(HL)   
013D   6F                     LD   L,A   ; HL = handler
013E   EB                     EX   DE,HL   ; HL = TOS, DE = handler
013F   D5                     PUSH   DE   ; jump to it; the stack is balanced again
0140   C9                     RET      ;   when the handler starts
0141   C6 21        CTL:      ADD   A,21h   ; back to c; zero only for NUL
0143   20 BE                  JR   NZ,next0   
0145   C3 00 00               JP   endprog   
0148                             ; a-z: push the cell's address (the cell is the variable)
0148   E5           LOWER:    PUSH   HL   
0149   87                     ADD   A,A   
014A   6F                     LD   L,A   
014B   26 07                  LD   H,LETPAGE   
014D   D7                     RST   10h   
014E                             ; A-Z: call the word. The return address (the IP after the letter) goes on
014E                             ; the return stack, and the IP becomes the address in the letter's cell.
014E   E5           UPPER:    PUSH   HL   ; keep TOS
014F   87                     ADD   A,A   
0150   6F                     LD   L,A   
0151   26 07                  LD   H,LETPAGE   ; HL -> cell
0153   5E                     LD   E,(HL)   
0154   2C                     INC   L   
0155   56                     LD   D,(HL)   ; DE = the word's body
0156   E1                     POP   HL   ; TOS back
0157   CD B9 01               CALL   rpush   ; push the return address (IP)
015A   42                     LD   B,D   
015B   4B                     LD   C,E   ; IP = body
015C   D7                     RST   10h   
015D                             ; Digits: step back onto the first digit and read the whole number.
015D   E5           DIGIT:    PUSH   HL   
015E   0B                     DEC   BC   
015F   CD A3 01               CALL   rdnum   
0162   D7                     RST   10h   
0163                             ; =============================================================================
0163                             ;  Dispatch table: one handler per punctuation character, in code order.
0163                             ;  It sits right after the inner loop so that it can't cross a page (the
0163                             ;  loop only adds to the low byte of its address).
0163                             ; =============================================================================
0163   8F 02        PTAB:     DW   h_store   ; !
0165   2C 03                  DW   h_str   ; "
0167   50 03                  DW   h_num   ; #
0169   33 03                  DW   h_print   ; $
016B   7A 02                  DW   h_swap   ; %
016D   3D 02                  DW   h_and   ; &
016F   4B 03                  DW   h_emit   ; '
0171   A2 02                  DW   h_open   ; (
0173   AF 02                  DW   h_close   ; )
0175   EA 01                  DW   h_mul   ; *
0177   CB 01                  DW   h_add   ; +
0179   77 03                  DW   h_cfetch   ; ,
017B   CE 01                  DW   h_sub   ; -
017D   94 02                  DW   h_cstore   ; .
017F   00 02                  DW   h_div   ; /
0181   78 02                  DW   h_dup   ; :
0183   09 00                  DW   drop_next   ; ;
0185   5D 02                  DW   h_lt   ; <
0187   6D 02                  DW   h_eq   ; =
0189   5A 02                  DW   h_gt   ; >
018B   7A 03                  DW   h_key   ; ?
018D   8A 02                  DW   h_fetch   ; @
018F   D6 02                  DW   h_def   ; [
0191   C1 02                  DW   h_break   ; \
0193   D0 02                  DW   h_ret   ; ]
0195   4D 02                  DW   h_xor   ; ^
0197   97 02                  DW   h_alloc   ; _
0199   BA 03                  DW   h_grave   ; `
019B   7C 02                  DW   h_tor   ; {
019D   45 02                  DW   h_or   ; |
019F   84 02                  DW   h_fromr   ; }
01A1   55 02                  DW   h_not   ; ~
01A3                PTABEND:      
01A3                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
01A3                             ; non-digit. Values wrap at 16 bits, as the spec says.
01A3   21 00 00     RDNUM:    LD   HL,0   
01A6   0A           RDN1:     LD   A,(BC)   
01A7   D6 30                  SUB   "0"   
01A9   FE 0A                  CP   10   
01AB   D0                     RET   NC   
01AC   03                     INC   BC   
01AD   54                     LD   D,H   
01AE   5D                     LD   E,L   
01AF   29                     ADD   HL,HL   
01B0   29                     ADD   HL,HL   
01B1   19                     ADD   HL,DE   
01B2   29                     ADD   HL,HL   ; HL * 10
01B3   5F                     LD   E,A   
01B4   16 00                  LD   D,0   
01B6   19                     ADD   HL,DE   
01B7   18 ED                  JR   rdn1   
01B9                             ; =============================================================================
01B9                             ;  Return stack. rpush pushes BC (nearly always the IP); rpop pops into DE.
01B9                             ;  HL' is the pointer. Both go through the Z80 stack to cross between the
01B9                             ;  register sets.
01B9                             ; =============================================================================
01B9   C5           RPUSH:    PUSH   BC   
01BA   D9                     EXX      
01BB   D1                     POP   DE   
01BC   2B                     DEC   HL   
01BD   72                     LD   (HL),D   
01BE   2B                     DEC   HL   
01BF   73                     LD   (HL),E   
01C0   D9                     EXX      
01C1   C9                     RET      
01C2   D9           RPOP:     EXX      
01C3   5E                     LD   E,(HL)   
01C4   23                     INC   HL   
01C5   56                     LD   D,(HL)   
01C6   23                     INC   HL   
01C7   D5                     PUSH   DE   
01C8   D9                     EXX      
01C9   D1                     POP   DE   
01CA   C9                     RET      
01CB                             ; =============================================================================
01CB                             ;  Arithmetic and logic. Effects are ( NOS TOS -- result ).
01CB                             ; =============================================================================
01CB   D1           H_ADD:    POP   DE   
01CC   19                     ADD   HL,DE   
01CD   D7                     RST   10h   
01CE                             ; "-" has two jobs: directly before a digit it starts a negative number.
01CE   0A           H_SUB:    LD   A,(BC)   
01CF   D6 30                  SUB   "0"   
01D1   FE 0A                  CP   10   
01D3   38 06                  JR   C,negnum   
01D5   CD E3 01               CALL   neg16   ; a - b = a + (-b)
01D8   D1                     POP   DE   
01D9   19                     ADD   HL,DE   
01DA   D7                     RST   10h   
01DB   E5           NEGNUM:   PUSH   HL   
01DC   CD A3 01               CALL   rdnum   
01DF   CD E3 01               CALL   neg16   
01E2   D7                     RST   10h   
01E3                             ; neg16: HL = -HL (keeps BC, DE)
01E3   AF           NEG16:    XOR   A   
01E4   95                     SUB   L   
01E5   6F                     LD   L,A   
01E6   9F                     SBC   A,A   
01E7   94                     SUB   H   
01E8   67                     LD   H,A   
01E9   C9                     RET      
01EA                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept.
01EA   D1           H_MUL:    POP   DE   ; DE = multiplicand
01EB   C5                     PUSH   BC   
01EC   44                     LD   B,H   
01ED   4D                     LD   C,L   ; BC = multiplier
01EE   21 00 00               LD   HL,0   
01F1   3E 10                  LD   A,16   
01F3   29           MUL1:     ADD   HL,HL   
01F4   CB 21                  SLA   C   
01F6   CB 10                  RL   B   
01F8   30 01                  JR   NC,mul2   
01FA   19                     ADD   HL,DE   
01FB   3D           MUL2:     DEC   A   
01FC   20 F5                  JR   NZ,mul1   
01FE   C1                     POP   BC   
01FF   D7                     RST   10h   
0200                             ; "/" ( a b -- r q ): the quotient is on top. Truncates toward zero; r takes
0200                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
0200                             ; of a. Dividing by zero is not checked: it returns two cells of no meaning.
0200   D1           H_DIV:    POP   DE   ; DE = a, HL = b
0201   C5                     PUSH   BC   ; free BC for udiv
0202   7A                     LD   A,D   
0203   AC                     XOR   H   
0204   F5                     PUSH   AF   ; S flag = sign of q
0205   7A                     LD   A,D   
0206   B7                     OR   A   
0207   F5                     PUSH   AF   ; S flag = sign of a (for r)
0208   CB 7C                  BIT   7,H   
020A   C4 E3 01               CALL   NZ,neg16   ; HL = |b|
020D   EB                     EX   DE,HL   
020E   CB 7C                  BIT   7,H   
0210   C4 E3 01               CALL   NZ,neg16   ; HL = |a|, DE = |b|
0213   CD 24 02               CALL   udiv   ; BC = q, HL = r
0216   F1                     POP   AF   
0217   FC E3 01               CALL   M,neg16   ; r's sign
021A   EB                     EX   DE,HL   ; DE = r
021B   60                     LD   H,B   
021C   69                     LD   L,C   ; HL = q
021D   F1                     POP   AF   
021E   FC E3 01               CALL   M,neg16   ; q's sign
0221   C1                     POP   BC   
0222   D5                     PUSH   DE   ; r under q
0223   D7                     RST   10h   
0224                             ; udiv: unsigned HL / DE. Returns BC = quotient, HL = remainder.
0224                             ; Uses A, BC; the caller saves the IP.
0224   44           UDIV:     LD   B,H   
0225   4D                     LD   C,L   
0226   21 00 00               LD   HL,0   
0229   3E 10                  LD   A,16   
022B   CB 21        UDV1:     SLA   C   
022D   CB 10                  RL   B   
022F   ED 6A                  ADC   HL,HL   
0231   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
0233   30 03                  JR   NC,udv2   ;   always fits in 16 bits
0235   19                     ADD   HL,DE   
0236   18 01                  JR   udv3   
0238   0C           UDV2:     INC   C   
0239   3D           UDV3:     DEC   A   
023A   20 EF                  JR   NZ,udv1   
023C   C9                     RET      
023D   D1           H_AND:    POP   DE   
023E   7C                     LD   A,H   
023F   A2                     AND   D   
0240   67                     LD   H,A   
0241   7D                     LD   A,L   
0242   A3                     AND   E   
0243   6F                     LD   L,A   
0244   D7                     RST   10h   
0245   D1           H_OR:     POP   DE   
0246   7C                     LD   A,H   
0247   B2                     OR   D   
0248   67                     LD   H,A   
0249   7D                     LD   A,L   
024A   B3                     OR   E   
024B   6F                     LD   L,A   
024C   D7                     RST   10h   
024D   D1           H_XOR:    POP   DE   
024E   7C                     LD   A,H   
024F   AA                     XOR   D   
0250   67                     LD   H,A   
0251   7D                     LD   A,L   
0252   AB                     XOR   E   
0253   6F                     LD   L,A   
0254   D7                     RST   10h   
0255   CD E3 01     H_NOT:    CALL   neg16   ; ~x = -x - 1
0258   2B                     DEC   HL   
0259   D7                     RST   10h   
025A                             ; Signed compares. Flipping both sign bits turns a signed compare into an
025A                             ; unsigned one; SBC HL,HL then turns the carry into -1 or 0 with no branch.
025A   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
025B   18 02                  JR   cmp   
025D   D1           H_LT:     POP   DE   ; a < b: HL = a, DE = b
025E   EB                     EX   DE,HL   
025F   7C           CMP:      LD   A,H   
0260   EE 80                  XOR   80h   
0262   67                     LD   H,A   
0263   7A                     LD   A,D   
0264   EE 80                  XOR   80h   
0266   57                     LD   D,A   
0267   B7                     OR   A   
0268   ED 52                  SBC   HL,DE   ; carry if HL < DE
026A   ED 62                  SBC   HL,HL   
026C   D7                     RST   10h   
026D   D1           H_EQ:     POP   DE   
026E   B7                     OR   A   
026F   ED 52                  SBC   HL,DE   
0271   21 00 00               LD   HL,0   
0274   20 01                  JR   NZ,eq1   
0276   2B                     DEC   HL   
0277   D7           EQ1:      RST   10h   
0278                             ; =============================================================================
0278                             ;  Stack
0278                             ; =============================================================================
0278                          IF   CPM   ; (the generic build has these in page zero)
0278   E5           H_DUP:    PUSH   HL   
0279   D7                     RST   10h   
027A   E3           H_SWAP:   EX   (SP),HL   
027B   D7                     RST   10h   
027C                          ENDIF      
027C   C5           H_TOR:    PUSH   BC   ; "{" TOS to the return stack
027D   44                     LD   B,H   
027E   4D                     LD   C,L   
027F   CD B9 01               CALL   rpush   
0282   C1                     POP   BC   
0283   CF                     RST   08h   
0284   E5           H_FROMR:   PUSH   HL   ; "}" return stack to TOS
0285   CD C2 01               CALL   rpop   
0288   EB                     EX   DE,HL   
0289   D7                     RST   10h   
028A                             ; =============================================================================
028A                             ;  Storage
028A                             ; =============================================================================
028A   5E           H_FETCH:   LD   E,(HL)   ; "@"
028B   23                     INC   HL   
028C   56                     LD   D,(HL)   
028D   EB                     EX   DE,HL   
028E   D7                     RST   10h   
028F   D1           H_STORE:   POP   DE   ; "!" ( n addr -- )
0290                          IF   CHECKED   
                              INC   HL   ; both bytes must be in the program's space
                              CALL   chkst   
                              DEC   HL   
0290                          ENDIF      
0290   73                     LD   (HL),E   
0291   23                     INC   HL   
0292   72                     LD   (HL),D   
0293   CF                     RST   08h   
0294   D1           H_CSTORE:   POP   DE   ; "." ( c addr -- )
0295                          IF   CHECKED   
                              CALL   chkst   
0295                          ENDIF      
0295   73                     LD   (HL),E   
0296   CF                     RST   08h   
0297                             ; "_" ( n -- addr ): the heap pointer moves up by n; TOS is the old pointer.
0297   EB           H_ALLOC:   EX   DE,HL   
0298   2A 7C 07               LD   HL,(HEAP)   
029B   E5                     PUSH   HL   
029C   19                     ADD   HL,DE   
029D                          IF   CHECKED   
                              JP   C,e_heap   ; a negative count wraps: too big
                              LD   A,(HLIM)   
                              DEC   A   
                              CP   H   
                              JP   C,e_heap   ; the new top must stay below the limit page
029D                          ENDIF      
029D   22 7C 07               LD   (HEAP),HL   
02A0   E1                     POP   HL   
02A1   D7                     RST   10h   
02A2                          IF   CHECKED   
                                 ; chkst: stop unless HL is in the program's own space: from the letter page
                                 ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
                                 ; whatever lies above the limit are safe. Memory above the heap top but
                                 ; below the limit is the program's own: Tiny BASIC keeps its lines there.
                                 ; Keeps every register.
                    CHKST:    PUSH   AF   
                              LD   A,H   
                              CP   LETPAGE   
                              JR   C,chk1   
                              LD   A,(HLIM)   
                              DEC   A   
                              CP   H   
                    CHK1:     JP   C,e_store   
                              POP   AF   
                              RET      
02A2                          ENDIF      
02A2                             ; =============================================================================
02A2                             ;  Flow control
02A2                             ; =============================================================================
02A2                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
02A2                             ; the matching ")".
02A2   7C           H_OPEN:   LD   A,H   
02A3   B5                     OR   L   
02A4   E1                     POP   HL   
02A5   28 04                  JR   Z,skipnx   
02A7   CD B9 01               CALL   rpush   ; the block starts at the IP
02AA   D7                     RST   10h   
02AB   CD F4 02     SKIPNX:   CALL   skip   
02AE   D7                     RST   10h   
02AF                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
02AF                             ; drops it and carries on.
02AF   7C           H_CLOSE:   LD   A,H   
02B0   B5                     OR   L   
02B1   E1                     POP   HL   
02B2   28 09                  JR   Z,rdrop   
02B4                          IF   CHECKED   
                              CALL   chkbrk   ; Ctrl-C is checked at every loop-back
02B4                          ENDIF      
02B4   CD C2 01               CALL   rpop   ; peek: pop the block start ...
02B7   42                     LD   B,D   
02B8   4B                     LD   C,E   
02B9   CD B9 01               CALL   rpush   ; ... and push it back
02BC   D7                     RST   10h   
02BD   CD C2 01     RDROP:    CALL   rpop   
02C0   D7                     RST   10h   
02C1                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
02C1                             ; drops the block start, "]" returns. No closer at all ends the program.
02C1   7C           H_BREAK:   LD   A,H   
02C2   B5                     OR   L   
02C3   E1                     POP   HL   
02C4   28 09                  JR   Z,brk1   
02C6   CD F4 02               CALL   skip   
02C9   FE 29                  CP   ")"   
02CB   28 F0                  JR   Z,rdrop   
02CD   18 01                  JR   h_ret   
02CF   D7           BRK1:     RST   10h   
02D0                             ; "]" returns: pop an address and jump to it.
02D0   CD C2 01     H_RET:    CALL   rpop   
02D3   42                     LD   B,D   
02D4   4B                     LD   C,E   
02D5                          IF   CHECKED   
                              CALL   chkbrk   ; ... and at every word return
02D5                          ENDIF      
02D5   D7                     RST   10h   
02D6                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
02D6                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
02D6                             ; the body"s address instead. Either way it then skips to the matching "]'.
02D6   0A           H_DEF:    LD   A,(BC)   
02D7   03                     INC   BC   
02D8   5F                     LD   E,A   
02D9   E6 DF                  AND   0DFh   ; fold case
02DB   D6 41                  SUB   "A"   
02DD   FE 1A                  CP   26   
02DF   30 0E                  JR   NC,def2   ; not a letter
02E1   7B                     LD   A,E   
02E2   D6 41                  SUB   "A"   ; 0-25 or 32-57: lowercase lands 64 bytes up
02E4   87                     ADD   A,A   
02E5   5F                     LD   E,A   
02E6   16 07                  LD   D,LETPAGE   ; DE -> cell
02E8   79                     LD   A,C   
02E9   12                     LD   (DE),A   
02EA   1C                     INC   E   
02EB   78                     LD   A,B   
02EC   12                     LD   (DE),A   
02ED   18 BC                  JR   skipnx   
02EF                DEF2:        
02EF                          IF   CHECKED   
                              LD   A,E   
                              CP   " "   
                              JP   NZ,e_brack   ; anything but a letter or a space
02EF                          ENDIF      
02EF   E5                     PUSH   HL   ; an anonymous block: push its address
02F0   60                     LD   H,B   
02F1   69                     LD   L,C   
02F2   18 B7                  JR   skipnx   
02F4                             ; skip: read past text to the closer at this level, and return it in A.
02F4                             ; Brackets of both kinds count together; strings are stepped over whole. A
02F4                             ; NUL first ends the program (for "\" with no closer; anything else that runs
02F4                             ; into the NUL had unbalanced brackets anyway).
02F4   16 00        SKIP:     LD   D,0   
02F6   0A           SK1:      LD   A,(BC)   
02F7   03                     INC   BC   
02F8   B7                     OR   A   
02F9   CA 00 00               JP   Z,endprog   
02FC   FE 22                  CP   22h   
02FE   20 05                  JR   NZ,sk2   
0300   CD 1E 03               CALL   skipstr   
0303   18 F1                  JR   sk1   
0305   FE 28        SK2:      CP   "("   
0307   28 12                  JR   Z,sk3   
0309   FE 5B                  CP   "["   
030B   28 0E                  JR   Z,sk3   
030D   FE 29                  CP   ")"   
030F   28 04                  JR   Z,sk4   
0311   FE 5D                  CP   "]"   
0313   20 E1                  JR   NZ,sk1   
0315   14           SK4:      INC   D   
0316   15                     DEC   D   
0317   C8                     RET   Z   ; the closer at this level
0318   15                     DEC   D   
0319   18 DB                  JR   sk1   
031B   14           SK3:      INC   D   
031C   18 D8                  JR   sk1   
031E                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
031E                             ; the next character, so "/"" does not end it.
031E   0A           SKIPSTR:   LD   A,(BC)   
031F   03                     INC   BC   
0320   FE 2F                  CP   "/"   
0322   20 03                  JR   NZ,ss1   
0324   03                     INC   BC   
0325   18 F7                  JR   skipstr   
0327   FE 22        SS1:      CP   22h   
0329   20 F3                  JR   NZ,skipstr   
032B   C9                     RET      
032C                             ; =============================================================================
032C                             ;  Console
032C                             ; =============================================================================
032C                             ; 22h pushes the address of the text after it and skips the string.
032C   E5           H_STR:    PUSH   HL   
032D   60                     LD   H,B   
032E   69                     LD   L,C   
032F   CD 1E 03               CALL   skipstr   
0332   D7                     RST   10h   
0333                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
0333                             ; 40h-7Fh clears its bit 6 (/M is CR, /` is space); plus anything lower gives
0333                             ; that character itself.
0333   7E           H_PRINT:   LD   A,(HL)   
0334   23                     INC   HL   
0335   FE 22                  CP   22h   
0337   28 11                  JR   Z,prdone   
0339   FE 2F                  CP   "/"   
033B   20 08                  JR   NZ,pr1   
033D   7E                     LD   A,(HL)   
033E   23                     INC   HL   
033F   FE 40                  CP   40h   
0341   38 02                  JR   C,pr1   
0343   E6 BF                  AND   0BFh   
0345   CD 00 04     PR1:      CALL   putc   
0348   18 E9                  JR   h_print   
034A   CF           PRDONE:   RST   08h   
034B   7D           H_EMIT:   LD   A,L   ; "'"
034C   CD 00 04               CALL   putc   
034F   CF                     RST   08h   
0350                             ; "#" prints TOS as a signed decimal number, with no space after it.
0350   CB 7C        H_NUM:    BIT   7,H   
0352   28 08                  JR   Z,num1   
0354   3E 2D                  LD   A,"-"   
0356   CD 00 04               CALL   putc   
0359   CD E3 01               CALL   neg16   
035C   C5           NUM1:     PUSH   BC   
035D   CD 62 03               CALL   pdec   
0360   C1                     POP   BC   
0361   CF                     RST   08h   
0362                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits)
0362   11 0A 00     PDEC:     LD   DE,10   
0365   CD 24 02               CALL   udiv   ; BC = HL / 10, HL = digit
0368   7D                     LD   A,L   
0369   F5                     PUSH   AF   
036A   60                     LD   H,B   
036B   69                     LD   L,C   
036C   7C                     LD   A,H   
036D   B5                     OR   L   
036E   C4 62 03               CALL   NZ,pdec   
0371   F1                     POP   AF   
0372   C6 30                  ADD   A,"0"   
0374   C3 00 04               JP   putc   
0377   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
0378   18 1A                  JR   kt3   
037A                             ; "?" ( n -- c ) or ( -n -- addr )
037A                             ;   n > 0: wait about n ms for a key; 0 if none came
037A                             ;   n = 0: wait for a key
037A                             ;   n < 0: read a line of at most -n characters, with echo. n is not
037A                             ;          checked: the buffer holds 127 characters and the CR, so a
037A                             ;          program must ask for 127 or fewer.
037A   CB 7C        H_KEY:    BIT   7,H   
037C   20 1A                  JR   NZ,line   
037E   11 28 00     KT1:      LD   DE,MSLOOP   ; one millisecond, roughly
0381   CD F9 03     KT2:      CALL   getk   
0384   20 0E                  JR   NZ,kt3   
0386   1B                     DEC   DE   
0387   7A                     LD   A,D   
0388   B3                     OR   E   
0389   20 F6                  JR   NZ,kt2   
038B   7C                     LD   A,H   ; 0? never counts down: it waits
038C   B5                     OR   L   
038D   28 EF                  JR   Z,kt1   
038F   2B                     DEC   HL   
0390   7C                     LD   A,H   
0391   B5                     OR   L   
0392   20 EA                  JR   NZ,kt1   ; A = 0 if the time ran out
0394   6F           KT3:      LD   L,A   
0395   26 00                  LD   H,0   
0397   D7                     RST   10h   
0398                          IF   CPM   
0398                             ; CP/M: BDOS 10 does the editing (the spec allows the platform's
0398                             ; own line editor). It doesn't store the CR, so it is added here.
0398   AF           LINE:     XOR   A   
0399   95                     SUB   L   ; A = the count (TOS is minus the count)
039A   32 7E 07               LD   (LBHDR),A   
039D   C5                     PUSH   BC   
039E   D9                     EXX      
039F   E5                     PUSH   HL   
03A0   D9                     EXX      
03A1   11 7E 07               LD   DE,LBHDR   
03A4   0E 0A                  LD   C,10   
03A6   CD 05 00               CALL   BDOS   
03A9   D9                     EXX      
03AA   E1                     POP   HL   
03AB   D9                     EXX      
03AC   C1                     POP   BC   
03AD   21 7F 07               LD   HL,LBHDR+1   
03B0   5E                     LD   E,(HL)   ; count
03B1   16 00                  LD   D,0   
03B3   23                     INC   HL   ; HL = LINEBUF
03B4   E5                     PUSH   HL   
03B5   19                     ADD   HL,DE   
03B6   36 0D                  LD   (HL),13   
03B8   E1                     POP   HL   
03B9   D7                     RST   10h   
03BA                          ENDIF      
03BA                          IFN   CPM   
                                 ; Generic: Backspace takes the last character back (and is echoed as
                                 ; it is), CR ends (stored, not echoed), every other key is stored and
                                 ; echoed until the line is full. The line buffer starts at offset 80h
                                 ; of its page, so L alone is the place in the line: D holds the L of
                                 ; a full line.
                    LINE:     LD   A,LINEBUF & 0FFh   
                              SUB   L   ; (TOS is minus the count)
                              LD   D,A   ; D = the L of a full line
                              LD   HL,LINEBUF   
                    LN2:      CALL   getk   
                              JR   Z,ln2   
                              CP   13   
                              JR   Z,ln5   
                              CP   8   
                              JR   Z,ln4   
                              LD   E,A   
                              LD   A,L   
                              CP   D   
                              JR   Z,ln2   ; full
                              LD   (HL),E   
                              INC   L   
                              LD   A,E   
                    LN3:      CALL   putc   
                              JR   ln2   
                    LN4:      DEC   L   ; Backspace: one back, and echo it,
                              JP   M,ln3   ;   unless the line was empty (L left the
                              INC   L   ;   upper half of the page)
                              JR   ln2   
                    LN5:      LD   (HL),A   ; the CR
                              LD   L,LINEBUF & 0FFh   
                              RST   10h   
03BA                          ENDIF      
03BA                             ; =============================================================================
03BA                             ;  Machine code: the grave
03BA                             ; =============================================================================
03BA                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
03BA                             ; are stored from addr until a non-hex character; then a RET (C9h) is
03BA                             ; written and its address is left. An odd last digit is consumed and dropped.
03BA                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
03BA                             ; code is entered by CALL with the data stack above the return address; it
03BA                             ; must keep BC, and on return the top cell becomes the new TOS.
03BA   0A           H_GRAVE:   LD   A,(BC)   
03BB   CD E8 03               CALL   hexval   
03BE   38 17                  JR   C,exec   
03C0   0A           HX1:      LD   A,(BC)   
03C1   CD E8 03               CALL   hexval   
03C4   38 0E                  JR   C,hx2   
03C6   03                     INC   BC   
03C7                          IF   CHECKED   
                              CALL   chkst   
03C7                          ENDIF      
03C7   77                     LD   (HL),A   ; the high digit goes in first ...
03C8   0A                     LD   A,(BC)   
03C9   CD E8 03               CALL   hexval   
03CC   38 06                  JR   C,hx2   ; odd digit: consumed, and the RET below
03CE   03                     INC   BC   ;   overwrites it
03CF   ED 6F                  RLD      ; ... and RLD shifts it up under the low one
03D1   23                     INC   HL   
03D2   18 EC                  JR   hx1   
03D4                HX2:         
03D4                          IF   CHECKED   
                              CALL   chkst   
03D4                          ENDIF      
03D4   36 C9                  LD   (HL),0C9h   
03D6   D7                     RST   10h   
03D7   D9           EXEC:     EXX      
03D8   22 34 07               LD   (RSAVE),HL   ; machine code may change the alternates
03DB   D9                     EXX      
03DC   11 E1 03               LD   DE,exret   
03DF   D5                     PUSH   DE   
03E0   E9                     JP   (HL)   
03E1   D9           EXRET:    EXX      
03E2   2A 34 07               LD   HL,(RSAVE)   
03E5   D9                     EXX      
03E6   E1                     POP   HL   
03E7   D7                     RST   10h   
03E8                             ; hexval: A = a character; returns its value 0-15 with carry clear, or
03E8                             ; carry set if it isn't a hex digit (0-9, A-F, a-f).
03E8   D6 30        HEXVAL:   SUB   "0"   
03EA   FE 0A                  CP   10   
03EC   3F                     CCF      
03ED   D0                     RET   NC   
03EE   E6 DF                  AND   0DFh   
03F0   D6 11                  SUB   11h   
03F2   FE 06                  CP   6   
03F4   3F                     CCF      
03F5   D8                     RET   C   
03F6   C6 0A                  ADD   A,10   
03F8   C9                     RET      
03F9                             ; =============================================================================
03F9                             ;  Console layer: getk returns a waiting key in A (zero flag clear), or
03F9                             ;  A = 0 with the zero flag set when none is waiting. putc prints A.
03F9                             ;  Both keep BC, DE, HL and HL". In the generic build they are the host"s
03F9                             ;  KEY and CONOUT routines themselves.
03F9                             ; =============================================================================
03F9                          IF   (1-CPM)*(1-CHECKED)   
                    GETK:     EQU   KEY   ; the host's routine does the whole job
03F9                          ENDIF      
03F9                          IF   CHECKED   
                    GETK:     LD   A,(KEYBUF)   ; a key held back by the break check
                              OR   A   
                              JR   Z,gk1   
                              PUSH   AF   
                              XOR   A   
                              LD   (KEYBUF),A   
                              POP   AF   
                              RET      
03F9                          ENDIF      
03F9                          IF   (1-CPM)*CHECKED   
                    GK1:      JP   KEY   
03F9                          ENDIF      
03F9                          IF   CPM*(1-CHECKED)   
03F9                GETK:        
03F9                          ENDIF      
03F9                          IF   CPM   
03F9   3E FF        GK1:      LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
03FB   CD 00 04               CALL   putc   
03FE   B7                     OR   A   
03FF   C9                     RET      
0400                             ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
0400                             ; printing and could swallow a key that BDOS 6 then never sees.
0400   C5           PUTC:     PUSH   BC   
0401   D5                     PUSH   DE   
0402   E5                     PUSH   HL   
0403   D9                     EXX      
0404   E5                     PUSH   HL   
0405   D9                     EXX      
0406   5F                     LD   E,A   
0407   0E 06                  LD   C,6   
0409   CD 05 00               CALL   BDOS   
040C   D9                     EXX      
040D   E1                     POP   HL   
040E   D9                     EXX      
040F   E1                     POP   HL   
0410   D1                     POP   DE   
0411   C1                     POP   BC   
0412   C9                     RET      
0413                          ENDIF      
0413                          IFN   CPM   
                    PUTC:     EQU   CONOUT   
0413                          ENDIF      
0413                             ; =============================================================================
0413                             ;  Checked build: break key and error reports
0413                             ; =============================================================================
0413                          IF   CHECKED   
                                 ; chkbrk: a waiting key is read now; Ctrl-C stops the program, anything
                                 ; else is held for the next "?".
                    CHKBRK:   LD   A,(KEYBUF)   
                              OR   A   
                              RET   NZ   ; one key is already held
                              CALL   getk   
                              RET   Z   
                              CP   3   
                              JR   Z,e_break   
                              LD   (KEYBUF),A   
                              RET      
                                 ; Error entries. Each loads its letter and then hides the next entry inside
                                 ; a 3-byte LD HL,nn (the 21h), so they all fall through to `error`.
                    E_STACK:   LD   A,"S"   ; data stack over or under
                              DB   21h   
                    E_RSTACK:   LD   A,"R"   ; return stack over or under
                              DB   21h   
                    E_BREAK:   LD   A,"B"   ; Ctrl-C
                              DB   21h   
                    E_HEAP:   LD   A,"H"   ; heap past the limit
                              DB   21h   
                    E_STORE:   LD   A,"W"   ; write outside the program's space
                              DB   21h   
                    E_BRACK:   LD   A,"D"   ; bad character after [
                                 ; error: print the letter in A, " @ " and the offset in the program of the
                                 ; character just read, then end. For example: S @ 245
                    ERROR:    LD   SP,DSTOP   ; the stacks may be wrecked: start clean
                              CALL   putc   
                              LD   A," "   
                              CALL   putc   
                              LD   A,"@"   
                              CALL   putc   
                              LD   A," "   
                              CALL   putc   
                              LD   HL,(0-PROG-1)&0FFFFh   ; minus the address of the character
                              ADD   HL,BC   ;   just read: HL = its offset
                              CALL   pdec   
                              JP   endprog   
0413                          ENDIF      
0413                             ; =============================================================================
0413                             ;  Startup
0413                             ; =============================================================================
0413                START:       
0413                          IF   CPM   
0413                             ; CP/M: the RAM pages follow the image; the heap may grow to the BDOS
0413   31 FE 06               LD   SP,DSTOP   
0416   21 62 04               LD   HL,stubs   ; RST 08h and RST 10h stubs into page zero
0419   11 08 00               LD   DE,0008h   
041C   01 0D 00               LD   BC,13   
041F   ED B0                  LDIR      
0421   11 5C 00               LD   DE,005Ch   ; open the file named on the command line
0424   0E 0F                  LD   C,15   
0426   CD 05 00               CALL   BDOS   
0429   3C                     INC   A   
042A   CA 00 00               JP   Z,0   ; no such file: back to CP/M
042D   11 00 08               LD   DE,PROG   
0430   D5           LD1:      PUSH   DE   
0431   0E 1A                  LD   C,26   ; set the DMA address
0433   CD 05 00               CALL   BDOS   
0436   11 5C 00               LD   DE,005Ch   
0439   0E 14                  LD   C,20   ; read the next 128 bytes
043B   CD 05 00               CALL   BDOS   
043E   E1                     POP   HL   
043F   11 80 00               LD   DE,128   
0442   19                     ADD   HL,DE   
0443   EB                     EX   DE,HL   
0444   B7                     OR   A   
0445   28 E9                  JR   Z,ld1   
0447   21 80 FF               LD   HL,-128   ; the failed read left nothing: back up
044A   19                     ADD   HL,DE   
044B   36 00                  LD   (HL),0   ; the end of the file counts as NUL
044D   23                     INC   HL   
044E   22 7C 07               LD   (HEAP),HL   
0451   3A 07 00               LD   A,(0007h)   ; the BDOS page is the heap limit
0454   32 3A 07               LD   (HLIM),A   
0457                          ENDIF      
0457                          IFN   CPM   
                              LD   SP,DSTOP   
                              LD   HL,PROG   ; the heap starts after the program's NUL
                              XOR   A   
                              LD   B,A   
                              LD   C,A   
                              CPIR      
                              LD   (HEAP),HL   
0457                          ENDIF      
0457                          IF   (1-CPM)*CHECKED   
                              LD   A,HEAPLIM   
                              LD   (HLIM),A   
0457                          ENDIF      
0457   D9                     EXX      
0458   21 E0 05               LD   HL,RSTOP   
045B   D9                     EXX      
045C                          IF   CHECKED   
                              XOR   A   
                              LD   (KEYBUF),A   
045C                          ENDIF      
045C   01 00 08               LD   BC,PROG   
045F   C3 03 01               JP   next0   
0462                          IF   CPM   
0462   D1           STUBS:    POP   DE   ; 0008h: drop, then next
0463   E1                     POP   HL   
0464   C3 03 01               JP   next0   
0467   00 00 00               DB   0,0,0   
046A   D1                     POP   DE   ; 0010h: next
046B   C3 03 01               JP   next0   
046E                ENDPROG:   EQU   0   ; warm boot
046E                DROP_NEXT:   EQU   0009h   
046E                             ; RAM pages, after the image
046E                RSPAGE:   EQU   (imgend + 255) / 256   
046E                DSPAGE:   EQU   RSPAGE + 1   
046E                LETPAGE:   EQU   RSPAGE + 2   
046E                PROG:     EQU   LETPAGE*256 + 256   
046E                          ENDIF      
046E                IMGEND:      


