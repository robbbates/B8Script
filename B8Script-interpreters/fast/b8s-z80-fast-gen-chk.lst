                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FHIGH:    EQU   fign   ; (80h-FFh are ignored)
                    FS_STORE:      ; !
                              POP   HL   
                              EX   DE,HL   
                              LD   (HL),E   
                              INC   HL   
                              LD   (HL),D   
                              POP   HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_CSTORE:      ; .
                              POP   HL   
                              EX   DE,HL   
                              LD   (HL),E   
                              POP   HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FSTORE:   EQU   fs_store   
                    FCSTORE:   EQU   fs_cstore   
