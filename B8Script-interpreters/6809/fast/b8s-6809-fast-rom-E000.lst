E349   CC 00 0A     PDEC:     LDD   #10   
E34C   36 06                  PSHU   D   
E34E                          IF   (1-CHECKED)*(1-QK)   
                              BSR   udiv   ; NOS = quotient, TOS = digit
E34E                          ENDIF      
