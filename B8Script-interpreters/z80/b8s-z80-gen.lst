0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Spec: docs/b8script.md (2026-11-21).
0000                             ; 
0000                             ;  Three switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    EDITOR   1 = with a small line editor built in (see the end of this
0000                             ;                 file). It goes with either setting of the other two.
0000                             ;    CHECKED  0 = no checks (spec: the programmer is responsible)
0000                             ;             1 = starts with every variable at 0 and every word undefined,
0000                             ;                 and stops on every error in the spec's table (and Ctrl-C)
0000                             ;                 with a four-line report: the letter and the place as line
0000                             ;                 and column, the text there, and both stacks. See `error`.
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   0   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   0   ; 1 = checked build
0000                EDITOR:   EQU   0   ; 1 = with the line editor
0000                EDGEN:    EQU   EDITOR*(1-CPM)   ; (the generic build with the editor)
0000                TABP0:    EQU   EDGEN*(1-CHECKED)   ; (the build with its table in page zero)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    HL'  return-stack pointer (the alternate HL). Entries are 2 bytes; the
0000                             ;         stack grows down. Only rpop and rpushn (and the checks) touch it.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  One-byte calls. The routines used most are reached with RST, one byte
0000                             ;  instead of three:
0000                             ; 
0000                             ;    RST 08h  rpop    pop the return stack into DE
0000                             ;    RST 18h  drop    drop TOS, then next character     (ends a handler)
0000                             ;    RST 20h  neg16   HL = -HL
0000                             ;    RST 28h  putc    print A
0000                             ;    RST 30h  next    next character                    (ends a handler)
0000                             ; 
0000                             ;  RST 18h and RST 30h never return: an RST is a CALL, so the first thing
0000                             ;  each of them does is POP DE to throw the return address away.
0000                             ; 
0000                             ;  The CP/M build can't own page zero, so the block from `vecs` to `vecend`
0000                             ;  (image addresses 0108h-0133h) is copied to 0008h-0033h when it starts. The
0000                             ;  code in that block is written to work at either place.
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (the top four bytes of the page are spare,
0000                             ;             so a full stack runs two bytes into the page below)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch, interpreter variables in the gaps, and the -n? line buffer
0000                             ;             at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack has a guard band: the data stack can
0000                             ;  overrun by a cell or two (and the calls made while it is full, the error
0000                             ;  report's included) into the top 32 bytes of the return-stack page, which
0000                             ;  are never used, and the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
                    BDOS:     EQU   0005h   
                    BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IF   CPM*(1-EDITOR)   
                    EXIT:     EQU   0000h   ; warm boot
0000                          ENDIF      
0000                          IFN   CPM   
0000                             ; ---- generic machine: edit these to suit -----------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The zero flag must match A
0000                             ;   (end the routine with OR A / RET).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                             ;   KEY and CONOUT must preserve BC, DE, HL and HL'.
0000                RSPAGE:   EQU   80h   ; 8000h return stack
0000                DSPAGE:   EQU   81h   ; 8100h data stack
0000                LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
0000                PROG:     EQU   8300h   ; where the loader puts the program text
0000                HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
0000                BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)   
0000                EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                          ENDIF      
0000                          IF   EDITOR   
                    EXIT:     EQU   edit   ; a program that ends goes back to the editor
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine. (The wait
0000                             ; for a second Ctrl-C uses it too: 250 ms.)
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                             ;   around machine code;
0000                NPEND:    EQU   LET+38h   ;   minus the address of the program's end
0000                             ;   (the heap"s first byte), for the checked "_'
0000                KEYBUF:   EQU   LET+7Ah   ; gap after z: a key read by the break check and
0000                             ;   held for the next "?" (0: none);
0000                BRKOFF:   EQU   LET+7Bh   ;   the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                LBHDR:    EQU   LET+7Eh   ; CP/M BDOS 10 header: max, count
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FCh   ; empty data stack. The four bytes above it
0000                             ; are spare: a character can pop two cells
0000                             ; too many before the checked build sees it,
0000                             ; and the next call must not land on the
0000                             ; letter cells.
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is the start of the .COM file, and 0108h-0133h is also copied to
0000                             ;  page zero (see the header).
0000                             ; =============================================================================
0000                          .ORG   BASE   
0000                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              XOR   A   ; 00  reset. (This byte, AFh, is also what an
0000                          ENDIF      ;     undefined word runs into: see e_hi.)
0000                          IF   1-EDGEN   
0000   31 FC 81               LD   SP,DSTOP   ; 00  reset, or the start of the .COM file
0003                          ENDIF      
0003                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)   
0003   01 00 83               LD   BC,PROG   ; 03  the IP
0006   18 64                  JR   st0   ; 06  (the rest of the startup is close by)
0008                          ENDIF      
0008                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              JR   init   ; 04  (the rest of the startup is close by)
                              DW   0   ; 06  spare
0008                          ENDIF      
0008                          IF   EDGEN   
                              XOR   A   ; 00  reset: no program yet
                              LD   (PROG),A   
0008                          ENDIF      
0008                          IF   EDGEN*(1-CHECKED)   
                              JP   edit   ; 04
0008                          ENDIF      
0008                          IF   EDGEN*CHECKED   
                              JP   init   ; 04  (and no key held back)
0008                          ENDIF      
0008                          IF   EDGEN   
                              NOP      ; 07  spare
0008                          ENDIF      
0008                          IF   CPM   
                              JP   start   ; 03
                              DW   0   ; 06  spare
0008                          ENDIF      
0008                VECS:        
0008                             ; ---- RST 08h: rpop: pop the return stack into DE ---------------------------
0008   D9           RPOP:     EXX      ; 08
0009   5E                     LD   E,(HL)   
000A   23                     INC   HL   
000B   56                     LD   D,(HL)   
000C   23                     INC   HL   
000D   D5                     PUSH   DE   ; across to the main registers
000E   D9                     EXX      
000F   D1                     POP   DE   
0010   C9                     RET      ; 10  (so RST 10h is not used)
0011                             ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
0011   C6 21        CTL:      ADD   A,21h   ; 11  back to c; zero only for NUL
0013   20 1C                  JR   NZ,next0   ;     the rest are ignored
0015   C3 09 FF     ENDPROG:   JP   EXIT   ;     the program has ended
0018                             ; ---- RST 18h: drop TOS, then next ------------------------------------------
0018   D1           RST18:    POP   DE   ; 18  discard the RST's return address
0019   E1                     POP   HL   ;     new TOS = NOS
001A   18 15                  JR   nx   
001C   E5           H_FROMR:   PUSH   HL   ; 1C  "}" return stack to TOS
001D   CF                     RST   08h   
001E   EB                     EX   DE,HL   
001F   F7                     RST   30h   
0020                             ; ---- RST 20h: neg16: HL = -HL (keeps BC, DE) -------------------------------
0020   AF           NEG16:    XOR   A   ; 20
0021   95                     SUB   L   
0022   6F                     LD   L,A   
0023   9F                     SBC   A,A   
0024   94                     SUB   H   
0025   67                     LD   H,A   
0026   C9                     RET      
0027   00                     NOP      ; 27  spare
0028                             ; ---- RST 28h: putc: print A (keeps BC, DE, HL, HL') ------------------------
0028                RST28:       
0028                          IFN   CPM   
0028   C3 03 FF     PUTC:     JP   CONOUT   ; 28
002B                          ENDIF      
002B                          IF   CPM   
                              JP   putc   ; 28
002B                          ENDIF      
002B   E9           JPHL:     JP   (HL)   ; 2B  (for the machine-code call)
002C   E3           H_TOR:    EX   (SP),HL   ; 2C  "{" TOS to the return stack: the new TOS
002D   C3 C4 00               JP   rpushn   ;     comes up, the old one goes across
0030                             ; ---- RST 30h: next character -----------------------------------------------
0030   D1           RST30:    POP   DE   ; 30  discard the RST's return address
0031                NX:          
0031                          IF   CPM   
                              JP   next0   ; (this copy runs in page zero)
0031                          ENDIF      
0031                VECEND:      
0031                             ; =============================================================================
0031                             ;  The inner loop: read one character and sort it by range.
0031                             ; 
0031                             ;    00h          end of program
0031                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0031                             ;    30h-39h      digit: read a whole number
0031                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0031                             ;    61h-7Ah      a-z: push the address of that letter's cell
0031                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0031                             ; =============================================================================
0031                NEXT0:       
0031                          IF   CHECKED   
                              CALL   chkstk   ; both stacks are checked once per character
0031                          ENDIF      
0031   0A                     LD   A,(BC)   
0032   03                     INC   BC   
0033   D6 21                  SUB   21h   ; A = c - 21h
0035   38 DA                  JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
0037   FE 0F                  CP   0Fh   
0039   38 22                  JR   C,punct   ; 21h-2Fh: PTAB index 0-14
003B   D6 0F                  SUB   0Fh   ; A = c - 30h
003D   FE 0A                  CP   0Ah   
003F   38 6D                  JR   C,digit   ; 30h-39h
0041   FE 11                  CP   11h   
0043   38 16                  JR   C,p3a   ; 3Ah-40h
0045   D6 11                  SUB   11h   ; A = c - 41h
0047   FE 1A                  CP   1Ah   
0049   38 6F                  JR   C,upper   ; 41h-5Ah: A = letter index 0-25
004B   FE 20                  CP   20h   
004D   38 0A                  JR   C,p5b   ; 5Bh-60h
004F   FE 3A                  CP   3Ah   
0051   38 61                  JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0053   FE 3E                  CP   3Eh   
0055                          IF   1-CHECKED   
0055   30 DA                  JR   NC,next0   ; 7Fh-FFh: ignored
0057                          ENDIF      
0057                          IF   CHECKED   
                              JR   Z,next0   ; 7Fh, DEL: ignored
                              JP   NC,e_hi   ; 80h-FFh: reserved
0057                          ENDIF      
0057   D6 1A                  SUB   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
0059   D6 09        P5B:      SUB   9   ; 5Bh-60h: -4 in all, index 22-27
005B   C6 05        P3A:      ADD   A,5   ; 3Ah-40h: index 15-21
005D                .macro PTABLE,
005D                             ; 
005D                 DB      h_store & 0FFh  ; !
005D                 DB      h_str & 0FFh    ; "
005D                 DB      h_num & 0FFh    ; #
005D                 DB      h_print & 0FFh  ; $
005D                 DB      h_swap & 0FFh   ; %
005D                 DB      h_and & 0FFh    ; &
005D                 DB      h_emit & 0FFh   ; '
005D                 DB      h_open & 0FFh   ; (
005D                 DB      h_close & 0FFh  ; )
005D                 DB      h_mul & 0FFh    ; *
005D                 DB      h_add & 0FFh    ; +
005D                 DB      h_cfetch & 0FFh ; ,
005D                 DB      h_sub & 0FFh    ; -
005D                 DB      h_cstore & 0FFh ; .
005D                 DB      h_div & 0FFh    ; /
005D                 DB      h_dup & 0FFh    ; :
005D                 DB      h_drop & 0FFh   ; ;
005D                 DB      h_lt & 0FFh     ; <
005D                 DB      h_eq & 0FFh     ; =
005D                 DB      h_gt & 0FFh     ; >
005D                 DB      h_key & 0FFh    ; ?
005D                 DB      h_fetch & 0FFh  ; @
005D                 DB      h_def & 0FFh    ; [
005D                 DB      h_break & 0FFh  ; \
005D                 DB      h_ret & 0FFh    ; ]
005D                 DB      h_xor & 0FFh    ; ^
005D                 DB      h_alloc & 0FFh  ; _
005D                 DB      h_grave & 0FFh  ; `
005D                 DB      h_tor & 0FFh    ; {
005D                 DB      h_or & 0FFh     ; |
005D                 DB      h_fromr & 0FFh  ; }
005D                 DB      h_not & 0FFh    ; ~
005D                .endm
005D                 
005D                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
005D                             ; untouched, and A, DE free.
005D   C6 91        PUNCT:    ADD   A,PTAB & 0FFh   ; PTAB never crosses a page
005F   5F                     LD   E,A   
0060   16 02                  LD   D,PTAB / 256   ; (0 if the table is in page zero)
0062   FE A7                  CP   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
0064   1A                     LD   A,(DE)   
0065   5F                     LD   E,A   ; the handler's low byte
0066                          IF   (1-CPM)*(1-TABP0)   
0066   16 00                  LD   D,0   
0068                          ENDIF      
0068                          IFN   CPM   
0068   CB 12                  RL   D   ; its page: 0 + carry
006A                          ENDIF      
006A                          IF   CPM   
                              LD   D,1   
                              JR   NC,pu1   
                              INC   D   ; its page: 1 + carry
                    PU1:         
006A                          ENDIF      
006A   D5                     PUSH   DE   ; jump to it; the stack is balanced again
006B   C9                     RET      ;   when the handler starts
006C                             ; The rest of the startup: here so that the generic reset code can reach it
006C                             ; with JR. st0: find the program's NUL; the heap starts after it.
006C                             ; (The editor build has its own copy of this, next to the editor.)
006C                             ; A checked build first clears the lower half of the letter page (A = 0):
006C                             ; every variable starts at 0, every word cell holds 0000h, the address an
006C                             ; undefined word is caught at (see e_hi), and no key is held back.
006C                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                    INIT:     LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
                              LD   BC,PROG   ; the IP
006C                          ENDIF      
006C                          IF   (1-CPM)*(1-EDITOR)   
006C   60           ST0:      LD   H,B   
006D   69                     LD   L,C   
006E   AF                     XOR   A   
006F   BE           ST1:      CP   (HL)   
0070   23                     INC   HL   
0071   20 FC                  JR   NZ,st1   
0073                          ENDIF      
0073                          IF   1-EDITOR   
0073   22 7C 82     ST2:      LD   (HEAP),HL   
0076                          ENDIF      
0076                          IF   CHECKED*(1-EDITOR)   
                              RST   20h   ; minus the heap"s first address: "_' may not
                              LD   (NPEND),HL   ;   release below it
0076                          ENDIF      
0076                          IF   (1-CHECKED)*(1-EDITOR)   
0076   21 00 00               LD   HL,0   ; no key is held, and the break key is on
0079   22 7A 82               LD   (KEYBUF),HL   ;   (the checked build has cleared these)
007C                          ENDIF      
007C                          IF   1-EDITOR   
007C   D9                     EXX      
007D   21 E0 80               LD   HL,RSTOP   ; the return stack is empty
0080   D9                     EXX      
0081   F7                     RST   30h   ; (its return address is thrown away)
0082                          ENDIF      
0082                             ; In the unchecked generic editor build the table is here, in the first
0082                             ; page, which saves loading D twice. (The other builds have no room for it
0082                             ; here: theirs is further down.)
0082                          IF   TABP0   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0082                          ENDIF      
0082                             ; =============================================================================
0082                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
0082                             ;  (00bbIGFuZCA= are up among the RST routines.) The machine-code call, exec,
0082                             ;  is here too: it belongs to "`" and makes the page come out right.
0082                             ; =============================================================================
0082   D1           H_XOR:    POP   DE   
0083   7C                     LD   A,H   
0084   AA                     XOR   D   
0085   67                     LD   H,A   
0086   7D                     LD   A,L   
0087   AB                     XOR   E   
0088   6F                     LD   L,A   
0089   F7                     RST   30h   
008A   D1           H_OR:     POP   DE   
008B   7C                     LD   A,H   
008C   B2                     OR   D   
008D   67                     LD   H,A   
008E   7D                     LD   A,L   
008F   B3                     OR   E   
0090   6F                     LD   L,A   
0091   F7                     RST   30h   
0092   E7           H_NOT:    RST   20h   ; ~x = -x - 1
0093   2B                     DEC   HL   
0094   F7                     RST   30h   
0095                             ; "_" ( n -- addr ): the heap pointer moves by n, a signed count (the add is
0095                             ; the same either way); TOS is the old pointer.
0095   ED 5B 7C 82  H_ALLOC:   LD   DE,(HEAP)   
0099                          IF   CHECKED*CPM   
                              LD   A,H   ; the count's sign, for chkhp
0099                          ENDIF      
0099   19                     ADD   HL,DE   ; the new top
009A                          IF   CHECKED   
                              CALL   chkhp   
009A                          ENDIF      
009A   22 7C 82               LD   (HEAP),HL   
009D   EB                     EX   DE,HL   
009E   F7                     RST   30h   
009F   D9           EXEC:     EXX      
00A0   22 34 82               LD   (RSAVE),HL   ; machine code may change the alternates
00A3   D9                     EXX      
00A4   CD 2B 00               CALL   jphl   
00A7   D9                     EXX      
00A8   2A 34 82               LD   HL,(RSAVE)   
00AB   D9                     EXX      
00AC   E1                     POP   HL   
00AD   F7                     RST   30h   
00AE                             ; ---- the letters and digits (here, in the middle, so that the inner loop's
00AE                             ; ---- short jumps reach them, and the handlers after them reach rpushn) ------
00AE                             ; Digits: step back onto the first digit and read the whole number.
00AE   E5           DIGIT:    PUSH   HL   
00AF   0B                     DEC   BC   
00B0   CD 34 02               CALL   rdnum   
00B3   F7                     RST   30h   
00B4                             ; a-z: push the cell's address (the cell is the variable)
00B4   E5           LOWER:    PUSH   HL   
00B5   87                     ADD   A,A   
00B6   6F                     LD   L,A   
00B7   26 82                  LD   H,LETPAGE   
00B9   F7                     RST   30h   
00BA                             ; A-Z: call the word. The return address (the IP after the letter) goes on
00BA                             ; the return stack, and the IP becomes the address in the letter's cell.
00BA   C5           UPPER:    PUSH   BC   ; the return address, for rpushn
00BB   EB                     EX   DE,HL   ; park TOS
00BC   87                     ADD   A,A   
00BD   6F                     LD   L,A   
00BE   26 82                  LD   H,LETPAGE   ; HL -> cell
00C0   4E                     LD   C,(HL)   
00C1   2C                     INC   L   
00C2   46                     LD   B,(HL)   ; IP = the word's body
00C3   EB                     EX   DE,HL   ; TOS back, and fall into rpushn
00C4                             ; rpushn: move the top cell of the data stack (in memory) to the return
00C4                             ; stack, then next. Everything that pushes the return stack ends here.
00C4                             ; 
00C4                             ; The break key is looked at here, so at every word call and loop-back (and
00C4                             ; block entry and "{"), but only one time in 256: B', which nothing else
00C4                             ; uses, counts them. Reading the keyboard can be slow (it is a BDOS call
00C4                             ; under CP/M), and this way it costs a loop two bytes and 13 T-states.
00C4   D9           RPUSHN:   EXX      
00C5   D1                     POP   DE   
00C6   2B                     DEC   HL   
00C7   72                     LD   (HL),D   
00C8   2B                     DEC   HL   
00C9   73                     LD   (HL),E   
00CA   10 05                  DJNZ   rp1   
00CC   D9                     EXX      
00CD   CD C3 02               CALL   pollk   
00D0   F7                     RST   30h   
00D1   D9           RP1:      EXX      
00D2   F7                     RST   30h   
00D3                             ; ---- machine code: the grave -----------------------------------------------
00D3                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
00D3                             ; are stored from addr until a non-hex character; then a RET (C9h) is
00D3                             ; written and its address is left. An odd last digit is consumed and dropped.
00D3                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
00D3                             ; code is entered by CALL with the data stack above the return address; it
00D3                             ; must keep BC, and on return the top cell becomes the new TOS.
00D3   CD B1 02     H_GRAVE:   CALL   hexc   
00D6   30 C7                  JR   NC,exec   
00D8   77           HX1:      LD   (HL),A   ; the high digit goes in first ...
00D9   CD B1 02               CALL   hexc   
00DC   30 08                  JR   NC,hx2   ; odd digit: consumed, and the RET below
00DE   ED 6F                  RLD      ;   overwrites it
00E0   23                     INC   HL   ; ... and RLD shifts it up under the low one
00E1   CD B1 02               CALL   hexc   
00E4   38 F2                  JR   C,hx1   
00E6   36 C9        HX2:      LD   (HL),0C9h   ; (never range-checked: the spec says so)
00E8   F7                     RST   30h   
00E9                             ; ---- where the two pages meet ----------------------------------------------
00E9                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
00E9                             ; are in falling code order for this), and where exactly differs between the
00E9                             ; builds: NPG1 follows. Every handler below these four must start in the
00E9                             ; second page, and every one above in the first; chktab.py checks both.
00E9                             ; "]" returns: pop an address and jump to it.
00E9   CF           H_RET:    RST   08h   
00EA   42                     LD   B,D   
00EB   4B                     LD   C,E   
00EC   F7           BRK1:     RST   30h   
00ED                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
00ED                             ; drops the block start, "]" returns. No closer at all ends the program.
00ED   7C           H_BREAK:   LD   A,H   
00EE   B5                     OR   L   
00EF   E1                     POP   HL   
00F0   28 FA                  JR   Z,brk1   
00F2   CD 56 02               CALL   skip   
00F5   B7                     OR   A   ; skip returns 0 for ")"
00F6   20 F1                  JR   NZ,h_ret   
00F8   CF           RDROP:    RST   08h   
00F9   F7                     RST   30h   
00FA                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
00FA                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
00FA                             ; the body"s address instead. Either way it then skips to the matching "]'.
00FA                             ; (The unchecked build takes anything that is not a letter as the space; the
00FA                             ; checked build stops on it.)
00FA   0A           H_DEF:    LD   A,(BC)   
00FB   03                     INC   BC   
00FC   D6 41                  SUB   "A"   ; a letter gives 0-25 or 32-57: lowercase
00FE   5F                     LD   E,A   ;   lands 64 bytes up
00FF   E6 DF                  AND   0DFh   ; fold case
0101   FE 1A                  CP   26   
0103   30 0B                  JR   NC,def2   ; not a letter
0105   CB 23                  SLA   E   
0107   16 82                  LD   D,LETPAGE   ; DE -> cell
0109   79                     LD   A,C   
010A   12                     LD   (DE),A   
010B   1C                     INC   E   
010C   78                     LD   A,B   
010D   12                     LD   (DE),A   
010E   18 03                  JR   skipnx   
0110                DEF2:        
0110                          IF   CHECKED   
                              LD   A,E   
                              CP   " "-"A"+256   
                              JP   NZ,e_brack   ; anything but a letter or a space
0110                          ENDIF      
0110   E5                     PUSH   HL   ; an anonymous block: push its address
0111   60                     LD   H,B   
0112   69                     LD   L,C   
0113                SKIPNX:      
0113                          IF   CHECKED   
                              DEC   BC   ; back onto the letter, so that skip finds its
0113                          ENDIF      ;   opener, the "[", just before where it starts
0113   CD 56 02     SKIPO:    CALL   skip   
0116   F7                     RST   30h   
0117   5E           H_FETCH:   LD   E,(HL)   ; "@"
0118   23                     INC   HL   
0119   56                     LD   D,(HL)   
011A   EB                     EX   DE,HL   
011B   F7                     RST   30h   
011C                             ; =============================================================================
011C                             ;  Handlers that must start in the image's second page.
011C                             ;  "?" is the last (with "," inside it), so its long tail may run past that
011C                             ;  page.
011C                             ; =============================================================================
011C                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
011C                             ; the matching ")".
011C   7C           H_OPEN:   LD   A,H   
011D   B5                     OR   L   
011E   E1                     POP   HL   
011F   28 F2                  JR   Z,skipo   
0121   C5                     PUSH   BC   ; the block starts at the IP
0122   18 A0                  JR   rpushn   
0124                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
0124                             ; drops it and carries on.
0124   7C           H_CLOSE:   LD   A,H   
0125   B5                     OR   L   
0126   E1                     POP   HL   
0127   28 CF                  JR   Z,rdrop   
0129   CF                     RST   08h   ; pop the block start ...
012A   42                     LD   B,D   
012B   4B                     LD   C,E   
012C   C5                     PUSH   BC   
012D   18 95                  JR   rpushn   ; ... and push it back
012F                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
012F                             ; "-" has two jobs: directly before a digit it starts a negative number.
012F   0A           H_SUB:    LD   A,(BC)   
0130   D6 30                  SUB   "0"   
0132   FE 0A                  CP   10   
0134   38 04                  JR   C,negnum   
0136   E7                     RST   20h   ; a - b = a + (-b): fall into "+"
0137   D1           H_ADD:    POP   DE   
0138   19                     ADD   HL,DE   
0139   F7                     RST   30h   
013A   E5           NEGNUM:   PUSH   HL   ; a negative number: read it, negate it
013B   CD 34 02               CALL   rdnum   
013E   E7                     RST   20h   
013F   F7                     RST   30h   
0140   D1           H_AND:    POP   DE   
0141   7C                     LD   A,H   
0142   A2                     AND   D   
0143   67                     LD   H,A   
0144   7D                     LD   A,L   
0145   A3                     AND   E   
0146   6F                     LD   L,A   
0147   F7                     RST   30h   
0148                             ; Signed compares. Both are "HL < DE" for the right pair: "<" swaps the two
0148                             ; cells first. Flipping both sign bits turns a signed compare into an
0148                             ; unsigned one (and XOR clears the carry for SBC); SBC HL,HL then turns the
0148                             ; carry into -1 or 0 with no branch.
0148   E3           H_LT:     EX   (SP),HL   ; a < b: HL = a, and b is popped next
0149   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
014A   7C                     LD   A,H   
014B   EE 80                  XOR   80h   
014D   67                     LD   H,A   
014E   7A                     LD   A,D   
014F   EE 80                  XOR   80h   
0151   57                     LD   D,A   
0152   ED 52                  SBC   HL,DE   ; carry if HL < DE
0154   ED 62        TF:       SBC   HL,HL   ; carry -> -1 or 0
0156   F7                     RST   30h   
0157   D1           H_EQ:     POP   DE   
0158   B7                     OR   A   
0159   ED 52                  SBC   HL,DE   
015B   7C                     LD   A,H   
015C   B5                     OR   L   
015D   FE 01                  CP   1   ; carry only if a - b = 0
015F   18 F3                  JR   tf   
0161                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept. The
0161                             ; multiplier shifts up through A:C.
0161   D1           H_MUL:    POP   DE   ; DE = multiplicand
0162   C5                     PUSH   BC   
0163   7C                     LD   A,H   
0164   4D                     LD   C,L   ; A:C = multiplier
0165   21 00 00               LD   HL,0   
0168   06 10                  LD   B,16   
016A   29           MUL1:     ADD   HL,HL   
016B   CB 21                  SLA   C   
016D   17                     RLA      
016E   30 01                  JR   NC,mul2   
0170   19                     ADD   HL,DE   
0171   10 F7        MUL2:     DJNZ   mul1   
0173   C1                     POP   BC   
0174   F7                     RST   30h   
0175                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
0175                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
0175                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
0175                             ; stops on it.
0175                H_DIV:       
0175                          IF   CHECKED   
                              LD   A,H   
                              OR   L   
                              JP   Z,e_zero   
0175                          ENDIF      
0175   D1                     POP   DE   ; DE = a, HL = b
0176   C5                     PUSH   BC   ; free BC for udiv
0177   D5                     PUSH   DE   ; a, for r's sign
0178   7A                     LD   A,D   
0179   AC                     XOR   H   
017A   F5                     PUSH   AF   ; S flag = sign of q
017B   CB 7C                  BIT   7,H   
017D   C4 20 00               CALL   NZ,neg16   ; HL = |b|
0180   EB                     EX   DE,HL   
0181   CB 7C                  BIT   7,H   
0183   C4 20 00               CALL   NZ,neg16   ; HL = |a|, DE = |b|
0186   CD 0E 02               CALL   udiv   ; HL = q, DE = r
0189   F1                     POP   AF   
018A   FC 20 00               CALL   M,neg16   ; q's sign
018D   EB                     EX   DE,HL   ; HL = r, DE = q
018E   F1                     POP   AF   ; A = a's high byte
018F   B7                     OR   A   
0190   FC 20 00               CALL   M,neg16   ; r's sign
0193   C1                     POP   BC   
0194   D5                     PUSH   DE   ; q under r
0195   F7                     RST   30h   
0196                             ; ---- stack and storage -----------------------------------------------------
0196   E5           H_DUP:    PUSH   HL   ; ":"
0197   F7                     RST   30h   
0198   E3           H_SWAP:   EX   (SP),HL   ; "%"
0199   F7                     RST   30h   
019A                             ; (The checked build tests the address before it takes the value off the
019A                             ; stack, so that an error report shows both.)
019A                H_CSTORE:      ; "." ( c addr -- )
019A                          IF   CHECKED   
                              CALL   chkst   
019A                          ENDIF      
019A   D1                     POP   DE   
019B   73                     LD   (HL),E   
019C   DF           H_DROP:   RST   18h   ; ";" is this one byte
019D                H_STORE:      ; "!" ( n addr -- )
019D                          IF   CHECKED   
                              CALL   chkst   
019D                          ENDIF      
019D   D1                     POP   DE   
019E   73                     LD   (HL),E   
019F   23                     INC   HL   
01A0   72                     LD   (HL),D   
01A1   DF                     RST   18h   
01A2                             ; ---- console ---------------------------------------------------------------
01A2                             ; 22h pushes the address of the text after it and skips the string.
01A2   E5           H_STR:    PUSH   HL   
01A3   60                     LD   H,B   
01A4   69                     LD   L,C   
01A5   CD 4B 02               CALL   skipstr   
01A8                          IF   CHECKED   
                              OR   A   ; 0: the text ran out before the closing quote
                              JP   Z,e_quote   
01A8                          ENDIF      
01A8   F7                     RST   30h   
01A9                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character
01A9                             ; clears that character"s bit 6 (/M is CR, /` is space; "/" and ""' have no
01A9                             ; bit 6, so // and /" give themselves).
01A9                          IF   1-CHECKED   
01A9   7E           H_PRINT:   LD   A,(HL)   
01AA   23                     INC   HL   
01AB   FE 22                  CP   22h   
01AD   28 0D                  JR   Z,pr9   
01AF   FE 2F                  CP   "/"   
01B1   20 04                  JR   NZ,pr1   
01B3   7E                     LD   A,(HL)   
01B4   23                     INC   HL   
01B5   E6 BF                  AND   0BFh   
01B7   EF           PR1:      RST   28h   
01B8   18 EF                  JR   h_print   
01BA                          ENDIF      
01BA                          IF   CHECKED   
                                 ; (The checked build has the loop as a routine, prstr, which the error
                                 ; report uses too. The address is kept on the stack meanwhile: a report
                                 ; shows the stack as it was before the "$".)
                    H_PRINT:   PUSH   HL   
                              CALL   prstr   
                              POP   DE   
                              RST   18h   
01BA                          ENDIF      
01BA   7D           H_EMIT:   LD   A,L   ; "'"
01BB   EF                     RST   28h   
01BC   DF           PR9:      RST   18h   
01BD                             ; "#" prints TOS as a signed decimal number, with no space after it.
01BD   C5           H_NUM:    PUSH   BC   
01BE   CD 77 02               CALL   psgn   
01C1   C1                     POP   BC   
01C2   DF                     RST   18h   
01C3                             ; "?" ( n -- c ) or ( -n -- addr )
01C3                             ;   n > 0: wait about n ms for a key; 0 if none came
01C3                             ;   n = 0: wait for a key
01C3                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
01C3                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
01C3   CB 7C        H_KEY:    BIT   7,H   
01C5   20 19                  JR   NZ,line   
01C7   1E 28        KT1:      LD   E,MSLOOP   ; one millisecond, roughly
01C9   CD CF 02     KT2:      CALL   getk   
01CC   20 0E                  JR   NZ,kt3   
01CE   1D                     DEC   E   
01CF   20 F8                  JR   NZ,kt2   
01D1   7C                     LD   A,H   ; 0? never counts down: it waits
01D2   B5                     OR   L   
01D3   28 F2                  JR   Z,kt1   
01D5   2B                     DEC   HL   
01D6   7C                     LD   A,H   
01D7   B5                     OR   L   
01D8   20 ED                  JR   NZ,kt1   ; A = 0 if the time ran out
01DA   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
01DB   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
01DC   6F           KT3:      LD   L,A   
01DD   26 00                  LD   H,0   
01DF   F7                     RST   30h   
01E0                          IF   CPM   
                                 ; CP/M: BDOS 10 does the editing (the spec allows the platform's
                                 ; own line editor). It doesn't store the CR, so it is added here.
                    LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
                              ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
                              SBC   A,A   
                              AND   L   ; (0 for a count that is too big)
                              XOR   127   ; A = the count, 127 at most
01E0                          ENDIF      
01E0                          IF   CPM*EDITOR   
                              CALL   rdline   ; (the editor calls rdline too)
                              LD   L,LINEBUF & 0FFh   
                              RST   30h   
                                 ; rdline: read a line of at most A characters; HL -> the CR that ends it
                    RDLINE:      
01E0                          ENDIF      
01E0                          IF   CPM   
                              LD   (LBHDR),A   
                              LD   DE,LBHDR   
                              LD   A,10   
                              CALL   bdosx   
                              LD   HL,LBHDR+1   
                              LD   A,(HL)   ; the count typed (0-127)
                              INC   L   ; HL = LINEBUF, whose low byte is 80h:
                              ADD   A,L   ;   adding the count to L can't carry
                              LD   L,A   
                              LD   (HL),13   
01E0                          ENDIF      
01E0                          IF   CPM*(1-EDITOR)   
                              LD   L,LINEBUF & 0FFh   
                              RST   30h   
01E0                          ENDIF      
01E0                          IF   CPM*EDITOR   
                              RET      
01E0                          ENDIF      
01E0                          IFN   CPM   
01E0                             ; Generic: Backspace takes the last character back (and is echoed as
01E0                             ; it is), CR ends (stored, not echoed), every other key is stored and
01E0                             ; echoed until the line is full. The line buffer starts at offset 80h
01E0                             ; of its page, so L alone is the place in the line: D holds the L of
01E0                             ; a full line.
01E0                          ENDIF      
01E0                          IFN   CPM   
01E0   11 7F 00     LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
01E3   19                     ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
01E4   9F                     SBC   A,A   
01E5   A5                     AND   L   ; (0 for a count that is too big)
01E6   2F                     CPL      
01E7   57                     LD   D,A   ; D = the L of a full line: 80h + count, FFh
01E8                          ENDIF      ;   at most
01E8                          IF   EDGEN   
                              CALL   rdline   ; (the editor calls rdline too)
                              LD   L,LINEBUF & 0FFh   
                              RST   30h   
                                 ; rdline: read a line that is full when L reaches D; HL -> the CR that ends it
                    RDLINE:      
01E8                          ENDIF      
01E8                          IFN   CPM   
01E8   21 80 82               LD   HL,LINEBUF   
01EB   CD CF 02     LN2:      CALL   getk   
01EE   28 FB                  JR   Z,ln2   
01F0   FE 0D                  CP   13   
01F2   28 16                  JR   Z,ln5   
01F4   FE 08                  CP   8   
01F6   28 0B                  JR   Z,ln4   
01F8   5F                     LD   E,A   
01F9   7D                     LD   A,L   
01FA   BA                     CP   D   
01FB   28 EE                  JR   Z,ln2   ; full
01FD   73                     LD   (HL),E   
01FE   2C                     INC   L   
01FF   7B                     LD   A,E   
0200   EF           LN3:      RST   28h   
0201   18 E8                  JR   ln2   
0203   2D           LN4:      DEC   L   ; Backspace: one back, and echo it,
0204   FA 00 02               JP   M,ln3   ;   unless the line was empty (L left the
0207   2C                     INC   L   ;   upper half of the page)
0208   18 E1                  JR   ln2   
020A   77           LN5:      LD   (HL),A   ; the CR
020B                          ENDIF      
020B                          IF   (1-CPM)*(1-EDITOR)   
020B   2E 80                  LD   L,LINEBUF & 0FFh   
020D   F7                     RST   30h   
020E                          ENDIF      
020E                          IF   EDGEN   
                              RET      
020E                          ENDIF      
020E                             ; =============================================================================
020E                             ;  More routines (no handler starts past this point)
020E                             ; =============================================================================
020E                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
020E                             ; Uses A, BC; the caller saves the IP. The dividend shifts up through A:C
020E                             ; while the quotient bits arrive at the bottom of C.
020E                             ; Dividing by 2 is one shift (the spec wants that fast).
020E   7B           UDIV:     LD   A,E   
020F   EE 02                  XOR   2   
0211   B2                     OR   D   
0212   20 07                  JR   NZ,udv0   
0214   CB 3C                  SRL   H   
0216   CB 1D                  RR   L   ; the quotient
0218   8F                     ADC   A,A   
0219   5F                     LD   E,A   ; the remainder: the bit that fell out (D is 0)
021A   C9                     RET      
021B   7C           UDV0:     LD   A,H   
021C   4D                     LD   C,L   
021D   21 00 00               LD   HL,0   
0220   06 10                  LD   B,16   
0222   CB 21        UDV1:     SLA   C   
0224   17                     RLA      
0225   ED 6A                  ADC   HL,HL   
0227   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
0229   30 02                  JR   NC,udv2   ;   always fits in 16 bits
022B   19                     ADD   HL,DE   ; too much: put it back, and cancel the
022C   0D                     DEC   C   ;   INC below
022D   0C           UDV2:     INC   C   ; a quotient bit
022E   10 F2                  DJNZ   udv1   
0230   EB                     EX   DE,HL   ; DE = remainder
0231   67                     LD   H,A   
0232   69                     LD   L,C   ; HL = quotient
0233   C9                     RET      
0234                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
0234                             ; non-digit. Values wrap at 16 bits, as the spec says.
0234   21 00 00     RDNUM:    LD   HL,0   
0237   0A           RDN1:     LD   A,(BC)   
0238   D6 30                  SUB   "0"   
023A   FE 0A                  CP   10   
023C   D0                     RET   NC   
023D   03                     INC   BC   
023E   54                     LD   D,H   
023F   5D                     LD   E,L   
0240   29                     ADD   HL,HL   
0241   29                     ADD   HL,HL   
0242   19                     ADD   HL,DE   
0243   29                     ADD   HL,HL   ; HL * 10
0244   5F                     LD   E,A   
0245   16 00                  LD   D,0   
0247   19                     ADD   HL,DE   
0248   18 ED                  JR   rdn1   
024A                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
024A                             ; the next character, so "/"" does not end it. Leaves A = 22h.
024A                          IF   1-CHECKED   
024A   03           SS0:      INC   BC   
024B   0A           SKIPSTR:   LD   A,(BC)   
024C   03                     INC   BC   
024D   FE 2F                  CP   "/"   
024F   28 F9                  JR   Z,ss0   
0251   FE 22                  CP   22h   
0253   20 F6                  JR   NZ,skipstr   
0255   C9                     RET      
0256                          ENDIF      
0256                          IF   CHECKED   
                                 ; The checked build never steps over a NUL: if the text runs out first it
                                 ; returns A = 0 with the IP on the NUL.
                    SKIPSTR:   LD   A,(BC)   
                              OR   A   
                              RET   Z   
                              INC   BC   
                              CP   22h   
                              RET   Z   
                              CP   "/"   
                              JR   NZ,skipstr   
                              LD   A,(BC)   ; the escaped character
                              OR   A   
                              RET   Z   
                              INC   BC   
                              JR   skipstr   
0256                          ENDIF      
0256                             ; skip: read past text to the closer at this level, and return A = 0 if it
0256                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
0256                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
0256                             ; no closer; anything else that runs into the NUL had unbalanced brackets
0256                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
0256                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
0256                             ; 
0256                             ; The checked build also looks at the character the skip was started by,
0256                             ; which is always the one just before where it starts: "(" must end at ")",
0256                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
0256                             ; quote counts as running into it. "\" takes either closer. IX keeps the
0256                             ; place where the skip started, for the report.
0256                SKIP:        
0256                          IF   CHECKED   
                              PUSH   BC   
                              POP   IX   
                              DEC   BC   
                              LD   A,(BC)   
                              INC   BC   
                              LD   E,A   ; E = the opener: ( [ or \
0256                          ENDIF      
0256   16 00                  LD   D,0   
0258   14           SK3:      INC   D   ; an opener: one deeper
0259   0A           SK1:      LD   A,(BC)   
025A                          IF   1-CHECKED   
025A   03                     INC   BC   
025B   B7                     OR   A   
025C   CA 15 00               JP   Z,endprog   
025F                          ENDIF      
025F                          IF   CHECKED   
                              OR   A   
                              JR   Z,sk6   ; (the IP stays on the NUL)
                              INC   BC   
025F                          ENDIF      
025F   FE 22                  CP   22h   
0261   CC 4B 02               CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
0264   D6 28                  SUB   "("   ;   (or 0, and then the NUL is read next)
0266   28 F0                  JR   Z,sk3   
0268   3D                     DEC   A   ; ")"
0269   28 08                  JR   Z,sk4   
026B   D6 32                  SUB   "["-")"   
026D   28 E9                  JR   Z,sk3   
026F   FE 02                  CP   "]"-"["   
0271   20 E6                  JR   NZ,sk1   
0273   15           SK4:      DEC   D   
0274                          IF   1-CHECKED   
0274   C8                     RET   Z   ; the closer at this level
0275   18 E2                  JR   sk1   
0277                          ENDIF      
0277                          IF   CHECKED   
                              JR   NZ,sk1   
                              LD   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
                              XOR   E   ;   opener is 0 for "(" and 1 for "[", and only
                              AND   6   ;   "\" has bit 2: so this is 2 for the wrong
                              CP   2   ;   closer, and only then
                              LD   A,D   
                              RET   NZ   
                              JR   sk7   
                    SK6:      BIT   2,E   ; the text ran out:
                              JP   NZ,endprog   ;   "\" with no closer ends the program
                    SK7:      PUSH   IX   ; N. The place is the opener
                              POP   BC   
                              LD   A,"N"   
                              JP   errp   ; (errp drops skip's return address)
0277                          ENDIF      
0277                             ; psgn: print HL as a signed number. Uses BC.
0277   CB 7C        PSGN:     BIT   7,H   
0279   28 04                  JR   Z,pdec   
027B   3E 2D                  LD   A,"-"   
027D   EF                     RST   28h   
027E   E7                     RST   20h   
027F                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
027F                             ; Uses BC.
027F   11 0A 00     PDEC:     LD   DE,10   
0282   CD 0E 02               CALL   udiv   ; HL = HL / 10, E = the last digit
0285   7B                     LD   A,E   
0286   F5                     PUSH   AF   
0287   7C                     LD   A,H   
0288   B5                     OR   L   
0289   C4 7F 02               CALL   NZ,pdec   
028C   F1                     POP   AF   
028D   C6 30                  ADD   A,"0"   
028F   EF                     RST   28h   
0290   C9                     RET      
0291                             ; =============================================================================
0291                             ;  Dispatch table: the low byte of each handler's address, in code order
0291                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
0291                             ;  It must not cross a page (the dispatcher only adds to its low byte).
0291                             ; =============================================================================
0291                             ; The handlers of the first NPG1 characters start in the image's second page.
0291                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
0291                             ; differs between the builds, so the count is worked out here.
0291                             ; (One division to a line: asm80 only rounds down when it stores a value.)
0291                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
0291                PGBRK:    EQU   (h_break-BASE)/256   
0291                PGDEF:    EQU   (h_def-BASE)/256   
0291                PGFET:    EQU   (h_fetch-BASE)/256   
0291                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
0291                          IF   1-TABP0   
0291                PTAB:        
0291                          ;*Macro unroll:  PTABLE
0291   9D                     DB   h_store & 0FFh   
0292   A2                     DB   h_str & 0FFh   
0293   BD                     DB   h_num & 0FFh   
0294   A9                     DB   h_print & 0FFh   
0295   98                     DB   h_swap & 0FFh   
0296   40                     DB   h_and & 0FFh   
0297   BA                     DB   h_emit & 0FFh   
0298   1C                     DB   h_open & 0FFh   
0299   24                     DB   h_close & 0FFh   
029A   61                     DB   h_mul & 0FFh   
029B   37                     DB   h_add & 0FFh   
029C   DB                     DB   h_cfetch & 0FFh   
029D   2F                     DB   h_sub & 0FFh   
029E   9A                     DB   h_cstore & 0FFh   
029F   75                     DB   h_div & 0FFh   
02A0   96                     DB   h_dup & 0FFh   
02A1   9C                     DB   h_drop & 0FFh   
02A2   48                     DB   h_lt & 0FFh   
02A3   57                     DB   h_eq & 0FFh   
02A4   49                     DB   h_gt & 0FFh   
02A5   C3                     DB   h_key & 0FFh   
02A6   17                     DB   h_fetch & 0FFh   
02A7   FA                     DB   h_def & 0FFh   
02A8   ED                     DB   h_break & 0FFh   
02A9   E9                     DB   h_ret & 0FFh   
02AA   82                     DB   h_xor & 0FFh   
02AB   95                     DB   h_alloc & 0FFh   
02AC   D3                     DB   h_grave & 0FFh   
02AD   2C                     DB   h_tor & 0FFh   
02AE   8A                     DB   h_or & 0FFh   
02AF   1C                     DB   h_fromr & 0FFh   
02B0   92                     DB   h_not & 0FFh   
02B1                PTABEND:      
02B1                          ENDIF      
02B1                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
02B1                             ; and return its value in A with the carry set; otherwise leave the IP and
02B1                             ; return with the carry clear.
02B1   0A           HEXC:     LD   A,(BC)   
02B2   D6 30                  SUB   "0"   
02B4   FE 0A                  CP   10   
02B6   38 09                  JR   C,hc1   
02B8   E6 DF                  AND   0DFh   
02BA   D6 11                  SUB   11h   
02BC   FE 06                  CP   6   
02BE   D0                     RET   NC   
02BF   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
02C1   03           HC1:      INC   BC   
02C2   C9                     RET      
02C3                             ; =============================================================================
02C3                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
02C3                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
02C3                             ;  (RST 28h) prints A. Both keep BC, DE, HL and HL'. In the generic build
02C3                             ;  they are the host's KEY and CONOUT routines themselves.
02C3                             ; 
02C3                             ;  A running program reads the keyboard only through getk and pollk, which
02C3                             ;  between them give the break key its rules:
02C3                             ;    - Ctrl-C stops the program;
02C3                             ;    - any other key that the break check reads is held in KEYBUF for the
02C3                             ;      next "?", and a newer one takes its place;
02C3                             ;    - "?" (getk) takes the held key first;
02C3                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
02C3                             ;      key like any other, but two of them within about 250 ms still stop it.
02C3                             ;  Both are called straight from a handler, never from a routine under one:
02C3                             ;  the checked build's report counts on finding one return address above the
02C3                             ;  data stack.
02C3                             ; =============================================================================
02C3                          IFN   CPM   
02C3                RAWK:     EQU   KEY   
02C3                          ENDIF      
02C3                             ; pollk: the break check (see rpushn).
02C3   CD 06 FF     POLLK:    CALL   rawk   
02C6   C8                     RET   Z   ; no key
02C7   32 7A 82               LD   (KEYBUF),A   ; held for the next "?"
02CA   FE 03                  CP   3   
02CC   C0                     RET   NZ   
02CD   18 11                  JR   ctlc   
02CF                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
02CF   E5           GETK:     PUSH   HL   ; a held key goes first, and is taken out of
02D0   21 7A 82               LD   HL,KEYBUF   ;   the buffer
02D3   7E                     LD   A,(HL)   
02D4   36 00                  LD   (HL),0   
02D6   E1                     POP   HL   
02D7   B7                     OR   A   
02D8   C0                     RET   NZ   
02D9   CD 06 FF               CALL   rawk   
02DC   C8                     RET   Z   
02DD   FE 03                  CP   3   
02DF   C0                     RET   NZ   
02E0                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
02E0                             ; the program has turned it off, wait about 250 ms for one more key: a
02E0                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
02E0                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
02E0   3A 7B 82     CTLC:     LD   A,(BRKOFF)   
02E3   B7                     OR   A   
02E4   CA 15 00               JP   Z,brk   
02E7   D5                     PUSH   DE   
02E8   11 10 27               LD   DE,250*MSLOOP   
02EB   CD 06 FF     CT1:      CALL   rawk   
02EE   20 05                  JR   NZ,ct2   
02F0   1B                     DEC   DE   
02F1   7A                     LD   A,D   
02F2   B3                     OR   E   
02F3   20 F6                  JR   NZ,ct1   
02F5   D1           CT2:      POP   DE   ; A = the second key, or 0 if none came
02F6   FE 03                  CP   3   
02F8   CA 15 00               JP   Z,brk   
02FB   B7                     OR   A   
02FC   28 03                  JR   Z,ct3   
02FE   32 7A 82               LD   (KEYBUF),A   
0301   3E 03        CT3:      LD   A,3   
0303   B7                     OR   A   
0304   C9                     RET      
0305                          IF   1-CHECKED   
0305                BRK:      EQU   endprog   ; the unchecked build stops without a word;
0305                          ENDIF      
0305                          IF   CHECKED   
                    BRK:      EQU   e_break   ;   the checked build reports B
0305                          ENDIF      
0305                          IF   CPM   
                    RAWK:     LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
                                 ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
                                 ; printing and could swallow a key that BDOS 6 then never sees.
                    PUTC:     PUSH   DE   
                              PUSH   HL   
                              LD   E,A   
                              LD   A,6   
                              CALL   bdosx   
                              POP   HL   
                              POP   DE   
                              OR   A   ; (for getk)
                              RET      
                                 ; bdosx: call BDOS function A with DE, keeping BC and HL'
                    BDOSX:    PUSH   BC   
                              EXX      
                              PUSH   HL   
                              EXX      
                              LD   C,A   
                              CALL   BDOS   
                              EXX      
                              POP   HL   
                              EXX      
                              POP   BC   
                              RET      
0305                          ENDIF      
0305                             ; =============================================================================
0305                             ;  Checked build: the checks and the error report
0305                             ; =============================================================================
0305                          IF   CHECKED   
                                 ; chkst: stop unless HL is in the program's own space: from the letter page
                                 ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
                                 ; whatever lies above the limit are safe. Memory above the heap top but
                                 ; below the limit is the program's own: Tiny BASIC keeps its lines there.
                                 ; It is the page of HL + 1 that is tested, so that one test serves both
                                 ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
                                 ; Keeps HL and BC.
                    CHKST:    INC   HL   
                              LD   A,H   
                              DEC   HL   
                              CP   LETPAGE   
                              JR   C,chs1   
0305                          ENDIF      
0305                          IF   CHECKED*(1-CPM)   
                              CP   HEAPLIM   
                              RET   C   
0305                          ENDIF      
0305                          IF   CHECKED*CPM   
                              LD   E,A   
                              LD   A,(0007h)   ; the BDOS page is the heap limit
                              DEC   A   
                              CP   E   
                              RET   NC   
0305                          ENDIF      
0305                          IF   CHECKED   
                    CHS1:     JP   e_store   
                                 ; chkhp: HL = the new heap top, DE = the old one, the carry is from adding
                                 ; the count. Stop if the top is not below the limit page, or is below the
                                 ; program's end.
                    CHKHP:       
0305                          ENDIF      
0305                          IF   CHECKED*CPM   
                                 ; With this much room a top that wrapped round can land back in
                                 ; range, so the add is tested too: growing (A, the count's high
                                 ; byte, is positive) must not carry, and releasing must.
                              RRA      ; the carry comes in above the sign:
                              ADD   A,40h   ;   bit 7 = carry XOR sign
                              ADD   A,A   
                              JR   C,e_heap   
                              LD   A,(0007h)   
                              DEC   A   
                              CP   H   
                              JR   C,e_heap   
0305                          ENDIF      
0305                          IF   CHECKED*(1-CPM)   
                                 ; (Here the program's space is under 32K, so a top that wrapped
                                 ; round always falls outside it.)
                              LD   A,H   
                              CP   HEAPLIM   
                              JR   NC,e_heap   
0305                          ENDIF      
0305                          IF   CHECKED   
                              PUSH   DE   
                              EX   DE,HL   
                              LD   HL,(NPEND)   
                              ADD   HL,DE   ; carry: at or above the program's end
                              EX   DE,HL   
                              POP   DE   
                              RET   C   
                    E_HEAP:   OR   A   ; put the count back in TOS for the report
                              SBC   HL,DE   
                              JP   e_heap1   
                                 ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
                                 ; "$", and the error report's texts). A NUL first is an error: Q.
                    PRSTR:    LD   A,(HL)   
                              INC   HL   
                              CP   22h   
                              RET   Z   
                              OR   A   
                              JR   Z,e_dollar   
                              CP   "/"   
                              JR   NZ,prs1   
                              LD   A,(HL)   
                              INC   HL   
                              AND   0BFh   
                    PRS1:     RST   28h   
                              JR   prstr   
                    E_DOLLAR:   POP   DE   ; "$" ran into a NUL: drop the return address,
                              POP   HL   ;   and put the string's address back in TOS
                              LD   A,"Q"   
                              JP   error   
                                 ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
                                 ; pnl: the same, on a new line.
                    PNL:      LD   A,13   
                              RST   28h   
                              LD   A,10   
                              RST   28h   
                    PMSG:     EX   (SP),HL   
                              CALL   prstr   
                              EX   (SP),HL   
                              RET      
                                 ; chkstk: both stacks are checked once per character, not in every handler.
                                 ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
                                 ; the constant carries if it is above (cells were popped that were never
                                 ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
                                 ; a character late at most: the bytes above DSTOP and the guard band below
                                 ; the page take what happens meanwhile. DE is free between characters.
                    CHKSTK:   EX   DE,HL   
                              LD   HL,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
                              ADD   HL,SP   
                              EX   DE,HL   
                              JR   C,e_under   
                              INC   D   
                              JR   NZ,e_over   
                              EXX      ; the return stack: in its page (or it has
                              LD   A,H   ;   overflowed), and not above its empty
                              CP   RSPAGE   ;   position (an underflow stays inside the
                              LD   A,L   ;   page, in the guard band)
                              EXX      
                              JR   NZ,e_rover   
                              CP   RSTOP&0FFh+1   
                              RET   C   
                              EXX      ; return stack underflow: it counts as empty
                              LD   HL,RSTOP   
                              EXX      
                              LD   A,"r"   
                              JR   errp   
                    E_ROVER:   LD   A,"R"   ; return stack overflow
                              DB   11h   ; (LD DE,nn hides the next entry)
                    E_OVER:   LD   A,"S"   ; data stack overflow
                              JR   errp   
                    E_UNDER:   LD   SP,DSTOP   ; data stack underflow: it counts as empty
                              LD   A,"s"   
                              JR   error   
                                 ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
                                 ; was never defined still holds 0000h, and the byte there is a reserved one
                                 ; in every build (AFh or C3h): if the IP is in page zero, this was a call of
                                 ; an undefined word. The call is undone, so the place is the call itself.
                    E_HI:     INC   B   
                              DJNZ   e_resv   ; (B is as it was, and is not 0)
                              RST   08h   
                              LD   B,D   
                              LD   C,E   
                              LD   A,"U"   
                              JR   error   
                                 ; Error entries. Each loads its letter and then hides the next entry inside
                                 ; a 3-byte LD DE,nn (the 11h), so they all fall through to `error`.
                    E_BREAK:   LD   A,"B"   ; Ctrl-C (found inside pollk or getk)
                              DB   11h   
                    E_HEAP1:   LD   A,"H"   ; heap (found inside chkhp)
                              DB   11h   
                    E_STORE:   LD   A,"O"   ; a store outside the program's space (chkst)
                                 ; errp: an error found inside a routine: drop its return address first.
                    ERRP:     POP   DE   
                              JR   error   
                    E_QUOTE:   LD   B,H   ; an unclosed string: HL is its address, one
                              LD   C,L   ;   past the opening quote, which is the place
                              LD   A,"Q"   
                              DB   11h   
                    E_RESV:   LD   A,"X"   ; a reserved byte outside a string
                              DB   11h   
                    E_ZERO:   LD   A,"Z"   ; dividing by zero
                              DB   11h   
                    E_BRACK:   LD   A,"W"   ; bad character after [
                                 ; error: the report, then the end. A = the letter, BC = one past the place,
                                 ; HL = TOS, and both stacks as the report is to show them:
                                 ; 
                                 ;   Err X @ line,col
                                 ;   up to 16 characters of the text from the place
                                 ;   Stk n: the top 8 cells at most, bottom to top
                                 ;   Rtn n
                    ERROR:    PUSH   HL   ; now the whole data stack is in memory
                              LD   E,A   
                              CALL   pnl   
                              DB   "Err ",22h   
                              LD   A,E   
                              RST   28h   
                              CALL   pmsg   
                              DB   " @ ",22h   
                              DEC   BC   ; BC = the place
                                 ; The line and column. A place below the program is in the line
                                 ; buffer: line 0. Otherwise count the LFs from the program's start;
                                 ; DE = the line's number, HL = where it starts.
                              LD   HL,LINEBUF   
                              LD   DE,0   
                              LD   A,B   
                              CP   PROG/256   
                              JR   C,er3   
                              INC   H   
                              LD   L,E   ; HL = PROG
                    ER1:      INC   DE   ; a new line starts at HL
                              PUSH   HL   
                    ER2:      LD   A,L   
                              SUB   C   
                              LD   A,H   
                              SBC   A,B   
                              JR   NC,er2x   ; reached the place
                              LD   A,(HL)   
                              INC   HL   
                              CP   10   
                              JR   NZ,er2   
                              POP   AF   
                              JR   er1   
                    ER2X:     POP   HL   
                    ER3:      PUSH   BC   
                              PUSH   HL   
                              EX   DE,HL   
                              CALL   pdec   ; the line
                              LD   A,","   
                              RST   28h   
                              POP   DE   
                              POP   HL   
                              PUSH   HL   
                              OR   A   
                              SBC   HL,DE   
                              INC   HL   
                              CALL   pdec   ; the column
                              CALL   pnl   
                              DB   22h   
                              POP   HL   ; the text, as it is: 16 characters, or fewer
                              LD   B,16   ;   if the line or the program ends first
                    ER4:      LD   A,(HL)   
                              INC   HL   
                              OR   A   
                              JR   Z,er5   
                              CP   13   
                              JR   Z,er5   
                              CP   10   
                              JR   Z,er5   
0305                          ENDIF      
0305                          IF   CHECKED*CPM   
                              CP   1Ah   ; (the ^Z that pads a file's last record ends
                              JR   Z,er5   ;   the text too: some terminals clear the
0305                          ENDIF      ;   screen on it)
0305                          IF   CHECKED   
                              RST   28h   
                              DJNZ   er4   
                    ER5:      CALL   pnl   
                              DB   "Stk ",22h   
                              LD   HL,DSTOP-2   ; (the cell at DSTOP-2 was pushed with the
                              OR   A   ;   first value and holds nothing)
                              SBC   HL,SP   
                              CALL   phalf   ; the depth
                              LD   A,":"   
                              RST   28h   
                              LD   A,C   
                              CP   9   
                              JR   C,er6   
                              CALL   pmsg   
                              DB   " ...",22h   
                              LD   C,8   
                    ER6:      LD   H,0   ; C = the number of cells to show
                              LD   L,C   
                              ADD   HL,HL   
                              ADD   HL,SP   ; HL -> just above the deepest of them
                              INC   C   
                    ER7:      DEC   C   
                              JR   Z,er8   
                              DEC   HL   
                              LD   D,(HL)   
                              DEC   HL   
                              LD   E,(HL)   
                              PUSH   HL   
                              PUSH   BC   
                              LD   A," "   
                              RST   28h   
                              EX   DE,HL   
                              CALL   psgn   
                              POP   BC   
                              POP   HL   
                              JR   er7   
                    ER8:      CALL   pnl   
                              DB   "Rtn ",22h   
                              EXX      
                              PUSH   HL   
                              EXX      
                              POP   DE   
                              LD   HL,RSTOP   
                              OR   A   
                              SBC   HL,DE   
                              CALL   phalf   
                              CALL   pnl   
                              DB   22h   
                              JP   endprog   
                                 ; phalf: print half of HL, and leave it in C
                    PHALF:    SRL   H   
                              RR   L   
                              PUSH   HL   
                              CALL   pdec   
                              POP   BC   
                              RET      
0305                          ENDIF      
0305                             ; =============================================================================
0305                             ;  The line editor (EDITOR = 1)
0305                             ; 
0305                             ;  The interpreter starts here, and a program that ends comes back here. Type
0305                             ;  a line and press Return:
0305                             ; 
0305                             ;    n text    put the text in as line n; the lines from n on move down.
0305                             ;              A number past the end, or 0, adds the line at the end.
0305                             ;    n         take line n out
0305                             ;    0         run the program
0305                             ;    -n        list the program from line n on (-1 lists all of it). Any key
0305                             ;              stops the list until another key is pressed; Ctrl-C ends it.
0305                             ;    anything else is run at once, as B8Script. (Start such a line with a
0305                             ;    space if it would begin with a digit or a minus sign.)
0305                             ; 
0305                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
0305                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
0305                             ;  125 characters, the line number and the one character after it included;
0305                             ;  that character is not stored. The text is kept as it is typed, each line
0305                             ;  ending in CR LF, at PROG. Nothing is checked.
0305                             ; 
0305                             ;  With CPM = 1 the file named on the command line is the program to start
0305                             ;  with (no file, or no such file: no program). Lines are read by BDOS 10, so
0305                             ;  its editing keys work, and Ctrl-C as the first key of a line goes back to
0305                             ;  CP/M. Nothing is written back: there is no command to save.
0305                             ; 
0305                             ;  With CHECKED = 1 a program that is stopped (an error, or Ctrl-C) prints
0305                             ;  its report and comes back here, with both stacks empty. The place is a
0305                             ;  line and column of the program; in a line typed here it is line 0.
0305                             ; 
0305                             ;  Things to know:
0305                             ;    - Reset empties the program (generic builds).
0305                             ;    - Words and variables last from one line to the next. A word's address
0305                             ;      points into the program, so run the program again after editing it.
0305                             ;    - Nothing is printed between a program's output and what is typed next.
0305                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
0305                             ;      a line that calls -n? and carries on afterwards runs what was typed.
0305                             ;      (The stored program never comes back to the line, so it may.)
0305                             ; =============================================================================
0305                          IF   EDGEN*CHECKED   
                                 ; Reset (A = 0): clear the lower half of the letter page. Every variable
                                 ; starts at 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi), and no key is held back.
                    INIT:     LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
                              JR   edit   
0305                          ENDIF      
0305                          IF   EDITOR   
                                 ; -n: list from line n. DE = the number of the line at HL.
                    LIST:     INC   BC   
                              CALL   rdnum   ; HL = n
                              PUSH   HL   
                              CALL   find   
                              POP   DE   
                    LI1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,edit   ; the end of the text
                              CALL   rawk   
                              JR   Z,li3   ; no key: carry on
                              CP   3   
                              JR   Z,edit   ; Ctrl-C
                    LI2:      CALL   rawk   ; any other key: wait for one more
                              JR   Z,li2   
                              CP   3   
                              JR   Z,edit   
                    LI3:      PUSH   HL   
                              PUSH   DE   
                              EX   DE,HL   
                              CALL   pdec   ; the line's number,
                              LD   A," "   
                              RST   28h   ;   a space,
                              POP   DE   
                              POP   HL   
                              INC   DE   
                              CALL   prl   ;   and the line
                              JR   li1   
                                 ; Take line n (in HL) out: copy everything after it down over it.
                    DEL:      CALL   find   
                              LD   D,H   
                              LD   E,L   
                              CALL   nxl   ; HL -> the next line
                    DE1:      LD   A,(HL)   
                              LD   (DE),A   
                              INC   HL   
                              INC   DE   
                              OR   A   
                              JR   NZ,de1   ; and fall into the editor
                    EDIT:     LD   SP,DSTOP   
                              XOR   A   ; a key that the break check held while the
                              LD   (KEYBUF),A   ;   program ran is let go (the Ctrl-C that
0305                          ENDIF      ;   stopped it, for one)
0305                          IF   EDGEN   
                              LD   D,0FDh   ; 125 characters at most
0305                          ENDIF      
0305                          IF   EDITOR*CPM   
                              LD   A,125   
0305                          ENDIF      
0305                          IF   EDITOR   
                              CALL   rdline   ; HL -> the CR that ended the line
                              INC   L   
                              LD   (HL),10   ; a LF after it,
                              DEC   L   
                              CALL   prl   ; (print the CR LF: a new line)
                              LD   (HL),0   ;   and a NUL after that
                              PUSH   HL   ; the end of what was typed
                              LD   BC,LINEBUF   
                              LD   A,(BC)   
                              CP   "-"   
                              JR   Z,list   
                              CALL   rdnum   ; HL = the number it starts with, BC -> after
                              LD   A,C   ; C is still 80h if there was no number:
                              ADD   A,A   ;   only then is twice it 0
                              JR   Z,st0   ; no number: run the line where it is
                              LD   A,(BC)   
                              SUB   13   
                              JR   NZ,ins   ; text follows the number
                              OR   H   ; the number alone:
                              OR   L   
                              JR   NZ,del   ;   not 0: take that line out
                              LD   BC,PROG   ;   0: run the program
                                 ; st0: start running at BC. The heap starts after the stored program's NUL.
                    ST0:      POP   HL   ; (the end of what was typed: the stack is empty)
                              XOR   A   
                              LD   H,A   ; no key is held, and the break key is on: a
                              LD   L,A   ;   key left over from the last run is let go
                              LD   (KEYBUF),HL   
                              LD   HL,PROG   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
                              LD   (HEAP),HL   
0305                          ENDIF      
0305                          IF   EDITOR*CHECKED   
                              RST   20h   ; minus the heap"s first address: "_' may not
                              LD   (NPEND),HL   ;   release below it
0305                          ENDIF      
0305                          IF   EDITOR   
                              EXX      
                              LD   HL,RSTOP   ; the return stack is empty
                              EXX      
                              RST   30h   ; (its return address is thrown away)
                                 ; Put the typed text in as line n (in HL): open a gap of its length there,
                                 ; CR and LF included, and copy it in.
                    INS:      CALL   find   ; HL -> where it goes
                              INC   BC   ; step over the one character after the number
                              POP   DE   ; the end of what was typed
                              LD   A,E   
                              SUB   C   ; A = the length of the text, with its CR LF
                              PUSH   BC   ; the text
                              LD   C,A   
                              LD   B,0   
                              PUSH   BC   ; its length
                              LD   D,H   
                              LD   E,L   ; DE = where it goes
                              XOR   A   
                              LD   C,A   ; BC = 0: CPIR looks as far as it needs to
                              CPIR      ; HL -> one past the program's NUL
                              SBC   HL,DE   ; the number of bytes to move up, NUL included
                              LD   B,H   
                              LD   C,L   
                              ADD   HL,DE   
                              DEC   HL   ; HL -> the NUL
                              EX   DE,HL   
                              EX   (SP),HL   ; HL = the length; where it goes is kept
                              PUSH   HL   
                              ADD   HL,DE   ; the NUL's new place
                              EX   DE,HL   
                              LDDR      ; move the rest of the program up
                              POP   BC   ; the length
                              POP   DE   ; where it goes
                              POP   HL   ; the text
                              LDIR      
                              JR   edit   
                                 ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
                                 ; of the text if there are fewer lines (or the number is 0). Keeps BC.
                    FIND:     EX   DE,HL   
                              LD   HL,PROG   
                    FI1:      DEC   DE   
                              LD   A,D   
                              OR   E   
                              RET   Z   
                              CALL   nxl   
                              JR   NZ,fi1   
                              RET      
                                 ; nxl: step HL over one line, to just past its LF (and return not-zero), or
                                 ; stop at the NUL that ends the text (and return zero).
                    NXL:      LD   A,(HL)   
                              OR   A   
                              RET   Z   
                              INC   HL   
                              CP   10   
                              JR   NZ,nxl   
                              OR   A   
                              RET      
                                 ; prl: print the line at HL, to its LF; HL -> just past it.
                    PRL:      LD   A,(HL)   
                              RST   28h   
                              LD   A,(HL)   
                              INC   HL   
                              CP   10   
                              JR   NZ,prl   
                              RET      
0305                          ENDIF      
0305                             ; =============================================================================
0305                             ;  CP/M startup (the generic build starts at address 0: see st0)
0305                             ; =============================================================================
0305                          IF   CPM   
                                 ; The RAM pages follow the image; the heap may grow to the BDOS.
                    START:       
0305                          ENDIF      
0305                          IF   CPM*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
                                 ; is held back.
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
0305                          ENDIF      
0305                          IF   CPM   
                              LD   HL,vecs   ; the RST routines go down into page zero
                              LD   DE,0008h   
                              LD   BC,vecend-vecs   
                              LDIR      
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:         
0305                          ENDIF      
0305                          IF   CPM*(1-EDITOR)   
                              LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
                              JP   st2   
0305                          ENDIF      
0305                          IF   CPM*EDITOR   
                                 ; The editor wants the text to end where the file's text ends: at
                                 ; the first ^Z (1Ah), which pads a text file's last record. One more
                                 ; goes after the last record, so the search always stops. And every
                                 ; line must end in LF: a last line without one is given a CR LF.
                              LD   (HL),1Ah   
                              LD   HL,PROG-1   
                              LD   A,10   ; (a file with no text needs nothing added)
                    TR1:      INC   HL   
                              LD   E,A   ; E = the character before this one
                              LD   A,(HL)   
                              CP   1Ah   
                              JR   NZ,tr1   
                              LD   A,E   
                              CP   10   
                              JR   Z,tr2   
                              LD   (HL),13   
                              INC   HL   
                              LD   (HL),10   
                              INC   HL   
                    TR2:      LD   (HL),0   
                              JP   edit   
0305                          ENDIF      
0305                          IF   CPM   
                                 ; RAM pages, after the image
                    RSPAGE:   EQU   (imgend + 255) / 256   
                    DSPAGE:   EQU   RSPAGE + 1   
                    LETPAGE:   EQU   RSPAGE + 2   
                    PROG:     EQU   LETPAGE*256 + 256   
0305                          ENDIF      
0305                IMGEND:      


