  1276 000005F3 E8CEFFFFFF          <1>         call    skipstr                 ; leaves AL = 22h, which matches
  1277 000005F8 2C28                <1> .sk2:   sub     al,'('                  ;   nothing below (or 0: then the
  1278 000005FA 74EB                <1>         jz      .sk3                    ;   NUL is read next)
  1279 000005FC FEC8                <1>         dec     al                      ; ')'
  1280 000005FE 7408                <1>         jz      .sk4
  1281 00000600 2C32                <1>         sub     al,'['-')'
  1282 00000602 74E3                <1>         jz      .sk3
  1283 00000604 3C02                <1>         cmp     al,']'-'['
  1284 00000606 75E0                <1>         jne     .sk1
  1285 00000608 49                  <1> .sk4:   dec     ecx
  1286 00000609 75DD                <1>         jnz     .sk1
  1287                              <1> %if CHECKED
  1288 0000060B 30C4                <1>         xor     ah,al                   ; the closer at this level: 0 or 2. Bit
  1289 0000060D 80E406              <1>         and     ah,6                    ;   1 of the opener is 0 for '(' and 1
  1290 00000610 80FC02              <1>         cmp     ah,2                    ;   for '[', and only the backslash has
  1291 00000613 740A                <1>         je      .sk7                    ;   bit 2: so this is 2 for the wrong
  1292                              <1>                                         ;   closer, and only then
  1293 00000615 C3                  <1>         ret
  1294 00000616 F6C404              <1> .sk6:   test    ah,4                    ; the text ran out:
  1295 00000619 0F8544FFFFFF        <1>         jnz     SKEND                   ;   '\' with no closer ends the program
  1296 0000061F 8B7564              <1> .sk7:   mov     esi,[V(v_skat)]         ; N. The place is the opener
  1297 00000622 B04E                <1>         mov     al,'N'
  1298 00000624 E9D0FCFFFF          <1>         jmp     errp                    ; (errp drops skip's return address)
  1299                              <1> %else
  1300                              <1>         ret
  1301                              <1> %endif
  1302                              <1> 
  1303                              <1> ; -n?: Backspace takes the last character back (and is echoed as it is),
  1304                              <1> ; CR ends (stored, not echoed), every other key is stored and echoed until
  1305                              <1> ; the line is full. The buffer is at offset 80h of the letter page, so DL
  1306                              <1> ; alone is the place in the line; BL is the DL of a full line.
  1307 00000629 66F7DB              <1> line:   neg     bx                      ; the count (8000h for -32768)
  1308 0000062C 6683FB7F            <1>         cmp     bx,127
  1309 00000630 7602                <1>         jbe     .ln1
  1310 00000632 B37F                <1>         mov     bl,127
  1311 00000634 80C380              <1> .ln1:   add     bl,80h
  1312 00000637 BA80014100          <1>         mov     edx,ARENA+LINEBUF
  1313 0000063C 31C9                <1>         xor     ecx,ecx                 ; getk waits for ever
  1314 0000063E E82EFFFFFF          <1> .ln2:   call    getk
  1315 00000643 3C0D                <1>         cmp     al,13
  1316 00000645 7418                <1>         je      .ln5
  1317 00000647 3C08                <1>         cmp     al,8
  1318 00000649 740C                <1>         je      .ln4
  1319 0000064B 38DA                <1>         cmp     dl,bl
  1320 0000064D 74EF                <1>         je      .ln2                    ; full
  1321 0000064F 8802                <1>         mov     [edx],al
  1322 00000651 42                  <1>         inc     edx
  1323                              <1> .ln3:   CALLP   putc
  1323                              <2> .ln3: 
   192                              <2>  %if P_%1
   193 00000652 FF55CD              <2>  call [V(p_%1)]
   194                              <2>  %else
   195                              <2>  call %1
   196                              <2>  %endif
  1324 00000655 EBE7                <1>         jmp     .ln2
  1325 00000657 FECA                <1> .ln4:   dec     dl                      ; Backspace: one back, and echo it,
  1326 00000659 78F7                <1>         js      .ln3                    ;   unless the line was empty (DL left
  1327 0000065B FEC2                <1>         inc     dl                      ;   the upper half of the page)
  1328 0000065D EBDF                <1>         jmp     .ln2
  1329 0000065F 8802                <1> .ln5:   mov     [edx],al                ; the CR
  1330 00000661 66BB8001            <1>         mov     bx,LINEBUF
  1331 00000665 FFE5                <1>         jmp     ebp
