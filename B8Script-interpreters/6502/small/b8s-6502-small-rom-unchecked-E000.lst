E3F3                          IF   1-FAST   
E3F3   A0 10        UD0:      LDY   #16   
E3F5   06 02        UD1:      ASL   TL   
E3F7   26 03                  ROL   TH   
E3F9   26 04                  ROL   T0   
E3FB   26 05                  ROL   T1   
E3FD   38                     SEC      
E3FE   A5 04                  LDA   T0   
E400   E5 08                  SBC   D0   
E402   48                     PHA      
E403   A5 05                  LDA   T1   
E405   E5 09                  SBC   D1   
E407   90 08                  BCC   ud2   
E409   85 05                  STA   T1   
E40B   68                     PLA      
E40C   85 04                  STA   T0   
E40E   E6 02                  INC   TL   ; the quotient bit (TL's bit 0 is free)
E410   24                     DB   24h   ; (BIT zp: steps over the PLA)
E411   68           UD2:      PLA      
E412   88                     DEY      
E413   D0 E0                  BNE   ud1   
E415   60                     RTS      
