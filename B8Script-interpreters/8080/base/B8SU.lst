021B                          IF   QK   
021B   C3 4C 05               JMP   closeq   ; (out of the handlers' pages: see Speed-ups)
021E                          ENDIF      
021E                          IF   1-QK   
                              ;*Macro unroll:  POPR                    ; pop the block start ...
                              DS   1-CPM,0CFh   ; pop the block start ...
                              DS   CPM,0CDh   
                              DS   CPM,AROP&0FFh   
                              DS   CPM,AROP/256   
                              MOV   B,H   
                              MOV   C,L   ; ... jump to it ...
                              XCHG      
                              JMP   rpushd   ; ... and push it back (which drops the flag)
021E                          ENDIF      
021E                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
021E                             ; "-" has two jobs: directly before a digit it starts a negative number.
021E   0A           H_SUB:    LDAX   B   
021F   D6 30                  SUI   "0"   
0221   FE 0A                  CPI   10   
0223   DA 35 03               JC   negnum   
