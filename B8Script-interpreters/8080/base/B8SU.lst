03CB                          DS   1-CPM,0EFh   
03CB   CD                     DS   CPM,0CDh   
03CC   E8                     DS   CPM,APUT&0FFh   
03CD   05                     DS   CPM,APUT/256   
03CE   C9                     RET      
03CF                             ; (The table goes here instead in the builds where, before the routines, it
03CF                             ; would cross a page: PTLATE. If it would cross one here too, it starts on
03CF                             ; the next page: PTPAD is 0 unless it must.)
03CF                          IF   (1-FAST)*PTLATE   
                    PTPH:     EQU   $ & 0FFh   
                    PTPX:     EQU   (PTPH + 31) / 256   
                    PTPAD:    EQU   PTPX * (256 - PTPH)   
                              DS   PTPAD   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
