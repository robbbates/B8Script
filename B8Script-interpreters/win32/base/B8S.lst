     1                                  %define CHECKED 1
     2                                  %define EDITOR 0
     3                                  %define SPEED 1
     4                                  [map all B8S.map]
     5                                  %include "/home/user/B8Script/B8Script-interpreters/win32/b8s-win32.asm"
     1                              <1> ; =============================================================================
     2                              <1> ;  B8Script interpreter for 32-bit Windows (x86, console subsystem)
     3                              <1> ;  Required Notice: Copyright 2026 Robb Bates (https://github.com/robbbates)
     4                              <1> ;  Licence: PolyForm Noncommercial License 1.0.0 (LICENSE.md at the top of
     5                              <1> ;  the repository, or https://polyformproject.org/licenses/noncommercial/1.0.0)
     6                              <1> ;  Spec: docs/b8script.md (2026-11-24).
     7                              <1> ;
     8                              <1> ;  Assembler: NASM 2.16, flat binary output: the PE header is laid out by
     9                              <1> ;  hand at the top of this file, so the output IS the .EXE:
    10                              <1> ;
    11                              <1> ;      nasm -f bin -DCHECKED=1 -o B8S.EXE b8s-win32.asm
    12                              <1> ;      nasm -f bin -o B8SU.EXE b8s-win32.asm
    13                              <1> ;      nasm -f bin -DEDITOR=1 -DCHECKED=1 -o B8SE.EXE b8s-win32.asm
    14                              <1> ;      nasm -f bin -DEDITOR=1 -o B8SUE.EXE b8s-win32.asm
    15                              <1> ;
    16                              <1> ;  Those are the base builds. Add -DSPEED=0 for the small ones (B8SS.EXE,
    17                              <1> ;  B8SUS.EXE, B8SSE.EXE, B8SUSE.EXE) or -DSPEED=2 for the fast ones (B8SF*).
    18                              <1> ;
    19                              <1> ;  Three switches (the defaults below, or -D on the command line):
    20                              <1> ;    CHECKED  0 = no checks (spec: the programmer is responsible)
    21                              <1> ;             1 = starts with every variable at 0 and every word undefined,
    22                              <1> ;                 and stops on every error in the spec's table (and Ctrl-C)
    23                              <1> ;                 with the three-line report, on the standard error handle.
    24                              <1> ;    EDITOR   0 = a runner: B8S PROG.B8S loads the file, runs it, exits
    25                              <1> ;             1 = the line editor of the spec's suggested standard (the same
    26                              <1> ;                 editor as the Z80's, key for key); the file named on the
    27                              <1> ;                 command line is the program to start with.
    28                              <1> ;    SPEED    0 = small: the smallest build
    29                              <1> ;             1 = base, the default: the speed-ups that cost few bytes: a
    30                              <1> ;                 skip cache, a faster skip, '/' by a power of two as shifts,
    31                              <1> ;                 and (unchecked) a variable then '@' or '!' in one step (see
    32                              <1> ;                 "Speed-ups")
    33                              <1> ;             2 = fast: base, and a 256-entry jump table besides, with no
    34                              <1> ;                 size limit (see "The fast build")
    35                              <1> ;             Each goes with either setting of the other two.
    36                              <1> ;
    37                              <1> ;  In every build Ctrl-C stops a running program (an unchecked runner stops
    38                              <1> ;  without a word): see the console layer for the rules, the held key and
    39                              <1> ;  the break-off cell.
    40                              <1> ;
    41                              <1> ;  The console escapes of '$' (/{ /} /| /` /~) always send ANSI (VT100)
    42                              <1> ;  sequences: the output's console mode asks for them to be obeyed (see
    43                              <1> ;  the startup).
    44                              <1> ; =============================================================================
    45                              <1> 
    46                              <1> %ifndef CHECKED
    47                              <1> %define CHECKED 0
    48                              <1> %endif
    49                              <1> %ifndef EDITOR
    50                              <1> %define EDITOR  0
    51                              <1> %endif
    52                              <1> %ifndef SPEED
    53                              <1> %define SPEED   1               ; 0 = small, 1 = base, 2 = fast
    54                              <1> %endif
    55                              <1> %assign FAST    SPEED/2         ; (1: the fast build)
    56                              <1> %assign SBASE   SPEED-FAST*2    ; (1: the base build)
    57                              <1> %if SBASE || FAST
    58                              <1>  %define QK     1               ; (the speed-ups: base, or the fast build)
    59                              <1> %else
    60                              <1>  %define QK     0
    61                              <1> %endif
    62                              <1> %if QK && !CHECKED && !FAST
    63                              <1>  %define SBASEU 1               ; (and those that only the unchecked base
    64                              <1> %else                           ;   builds take; the fast build has its own)
    65                              <1>  %define SBASEU 0
    66                              <1> %endif
    67                              <1> 
    68                              <1> ; -----------------------------------------------------------------------------
    69                              <1> ;  The machine model
    70                              <1> ;
    71                              <1> ;  B8Script is defined for a 64 KB machine with 16-bit cells, and that is what
    72                              <1> ;  runs here. The 64 KB arena sits at ARENA (00410000h), a multiple of 64 KB,
    73                              <1> ;  inside the image (its last 64 KB of uninitialised space): the B8Script
    74                              <1> ;  address a is the byte at ARENA + a. Because the arena is 64 KB aligned,
    75                              <1> ;  "ARENA + a" is simply a 32-bit register whose high word is 0041h and whose
    76                              <1> ;  low word is a. Every cell the interpreter keeps in a 32-bit register or
    77                              <1> ;  stack slot is kept in that form, so it is at once the 16-bit cell (its low
    78                              <1> ;  word) and a pointer to that cell's address:
    79                              <1> ;
    80                              <1> ;    EBX  TOS. 16-bit operations work on BX; EBX's high word is always 0041h,
    81                              <1> ;         so [EBX] is the byte TOS points at.
    82                              <1> ;    ESI  IP: a pointer to the next program character (LODSB reads it).
    83                              <1> ;    ESP  the data stack: one dword per cell, low word the cell, high word
    84                              <1> ;         0041h. [ESP] is NOS. It is the thread's own stack (the API calls
    85                              <1> ;         push their arguments below it). V_DSTOP holds ESP for the empty
    86                              <1> ;         stack.
    87                              <1> ;    EDI  the return stack pointer: dword entries (IP values and cells parked
    88                              <1> ;         with '{', all in the same form), growing down from RSTOP. A pop is
    89                              <1> ;         MOV r,[EDI] / SCASD (SCASD only steps EDI on by 4).
    90                              <1> ;    EBP  the address of `next`: every handler ends with JMP EBP (2 bytes),
    91                              <1> ;         and the interpreter's own variables, the import address table
    92                              <1> ;         and the pointers to the routines called most (see CALLP) lie
    93                              <1> ;         within 127 bytes of `next`, so [EBP+d8] reaches them in 3-byte
    94                              <1> ;         instructions. (V() below names them.)
    95                              <1> ;    EAX ECX EDX  scratch. (The Windows API keeps EBX, ESI, EDI and EBP.)
    96                              <1> ;
    97                              <1> ;  Memory map of the arena (B8Script addresses):
    98                              <1> ;    0000h-00FFh  page zero: unused, and left zero. An undefined word's cell
    99                              <1> ;                 holds 0000h, so calling it runs into the NUL at 0000h; the
   100                              <1> ;                 checked build sees that the IP is 0001h there and reports U.
   101                              <1> ;    0100h        the letter page: A-Z at +00h..+33h, a-z at +40h..+73h (a
   102                              <1> ;                 word's cell is 64 bytes below its variable's), the held key
   103                              <1> ;                 at +7Ah, the break-off cell at +7Bh, the heap pointer at +7Ch,
   104                              <1> ;                 and the -n? line buffer at +80h..+FFh (127 characters and CR;
   105                              <1> ;                 the editor's input line uses it too)
   106                              <1> ;    0200h        PROG: the program text, ending in NUL; the heap starts after
   107                              <1> ;                 the NUL and may grow up to the heap limit, FF00h
   108                              <1> ;    FF00h-FFFFh  above the limit: not the program's (unused)
   109                              <1> ;  The stacks are outside the arena: the return stack is 112 entries below
   110                              <1> ;  RSTOP (in the image's uninitialised space below the arena) and the data
   111                              <1> ;  stack is the thread's stack (127 cells in the checked builds, as deep as
   112                              <1> ;  the 1 MB stack reserve allows in the others). The base and fast builds
   113                              <1> ;  keep their skip cache (64 entries, 512 bytes) after the interpreter's
   114                              <1> ;  variables, in the image's uninitialised space below NAMEBUF.
   115                              <1> ;
   116                              <1> ;  The whole image (code, arena) is one section, readable, writable and
   117                              <1> ;  executable, so machine code can run in the arena (see h_grave).
   118                              <1> ; -----------------------------------------------------------------------------
   119                              <1> 
   120                              <1> IB      equ     400000h         ; ImageBase
   121                              <1> SECTVA  equ     1000h           ; the section's RVA
   122                              <1> ARENA   equ     410000h         ; the 64 KB B8Script memory (RVA 10000h)
   123                              <1> IMGSIZE equ     20000h          ; SizeOfImage: the arena is its last 64 KB
   124                              <1> 
   125                              <1> LET     equ     0100h           ; the letter page (a B8Script address)
   126                              <1> HELD    equ     LET+7Ah         ; a key read by the break check, held for the
   127                              <1>                                 ;   next '?' (0: none)
   128                              <1> BRKOFF  equ     LET+7Bh         ; the break-off cell: a non-zero byte here
   129                              <1>                                 ;   makes Ctrl-C a key like any other
   130                              <1> HEAP    equ     LET+7Ch         ; the heap pointer (a cell)
   131                              <1> LINEBUF equ     LET+80h         ; the -n? line buffer
   132                              <1> PROG    equ     0200h           ; the program text
   133                              <1> HEAPLIM equ     0FFh            ; the heap limit, as a page: FF00h
   134                              <1> LIMIT   equ     HEAPLIM*256
   135                              <1> MAXFILE equ     LIMIT-PROG-3    ; the most a file may bring (room for CR LF NUL)
   136                              <1> 
   137                              <1> RSTOP   equ     IB+0FF00h       ; the empty return stack (it grows down)
   138                              <1> RSMAX   equ     112             ; return stack entries (checked builds)
   139                              <1> DSMAX   equ     127             ; data stack cells (checked builds)
   140                              <1> NAMEBUF equ     IB+0F000h       ; the file's name, as typed (up to 3.5 KB)
   141                              <1> %if QK
   142                              <1> NSKC    equ     64              ; the skip cache's entries (base)
   143                              <1> %endif
   144                              <1> 
   145                              <1> ; -----------------------------------------------------------------------------
   146                              <1> ;  The PE header, by the documented rules: a 64-byte DOS header whose
   147                              <1> ;  e_lfanew points at the PE signature, the COFF header, the PE32 optional
   148                              <1> ;  header with its 16 data directories, and one section header. Then zeros
   149                              <1> ;  up to SizeOfHeaders (200h, one FileAlignment).
   150                              <1> ; -----------------------------------------------------------------------------
   151                              <1>         bits    32
   152                              <1>         section hdr start=0 vstart=IB
   153 00000000 4D5A                <1>         dw      'MZ'                    ; e_magic
   154 00000002 00<rep 3Ah>         <1>         times   3Ch-($-$$) db 0
   155 0000003C [4000C0FF]          <1>         dd      pe-IB                   ; e_lfanew
   156 00000040 50450000            <1> pe:     db      'PE',0,0
   157 00000044 4C01                <1>         dw      14Ch                    ; Machine: i386
   158 00000046 0100                <1>         dw      1                       ; NumberOfSections
   159 00000048 00000000            <1>         dd      0                       ; TimeDateStamp
   160 0000004C 0000000000000000    <1>         dd      0, 0                    ; no COFF symbols
   161 00000054 E000                <1>         dw      opthdr_end-opthdr       ; SizeOfOptionalHeader (224)
   162 00000056 0F01                <1>         dw      010Fh                   ; RELOCS_STRIPPED, EXECUTABLE_IMAGE,
   163                              <1>                                         ;   LINE_NUMS_STRIPPED,
   164                              <1>                                         ;   LOCAL_SYMS_STRIPPED, 32BIT_MACHINE
   165 00000058 0B01                <1> opthdr: dw      10Bh                    ; PE32
   166 0000005A 0100                <1>         db      1, 0                    ; linker version
   167 0000005C 000A0000            <1>         dd      RAWSIZE                 ; SizeOfCode
   168 00000060 000A0000            <1>         dd      RAWSIZE                 ; SizeOfInitializedData
   169 00000064 00000000            <1>         dd      0                       ; SizeOfUninitializedData
   170 00000068 [0000C0FF]          <1>         dd      start-IB                ; AddressOfEntryPoint
   171 0000006C 00100000            <1>         dd      SECTVA                  ; BaseOfCode
   172 00000070 00100000            <1>         dd      SECTVA                  ; BaseOfData
   173 00000074 00004000            <1>         dd      IB                      ; ImageBase
   174 00000078 00100000            <1>         dd      1000h                   ; SectionAlignment
   175 0000007C 00020000            <1>         dd      200h                    ; FileAlignment
   176 00000080 04000000            <1>         dw      4, 0                    ; OS version 4.0
   177 00000084 00000000            <1>         dw      0, 0                    ; image version
   178 00000088 04000000            <1>         dw      4, 0                    ; subsystem version 4.0
   179 0000008C 00000000            <1>         dd      0                       ; Win32VersionValue
   180 00000090 00000200            <1>         dd      IMGSIZE                 ; SizeOfImage
   181 00000094 00020000            <1>         dd      200h                    ; SizeOfHeaders
   182 00000098 00000000            <1>         dd      0                       ; CheckSum
   183 0000009C 0300                <1>         dw      3                       ; Subsystem: Windows console
   184 0000009E 0000                <1>         dw      0                       ; DllCharacteristics: none
   185 000000A0 0000100000100000    <1>         dd      100000h, 1000h          ; stack reserve, commit
   186 000000A8 0000100000100000    <1>         dd      100000h, 1000h          ; heap reserve, commit
   187 000000B0 00000000            <1>         dd      0                       ; LoaderFlags
   188 000000B4 10000000            <1>         dd      16                      ; NumberOfRvaAndSizes
   189 000000B8 0000000000000000    <1>         dd      0, 0                    ; 0 export
   190 000000C0 [3C07C0FF]28000000  <1>         dd      idesc-IB, idesc_end-idesc ; 1 import
   191 000000C8 00000000<rep 14h>   <1>         times   10*2 dd 0               ; 2-11
   192 00000118 [7C08C0FF]34000000  <1>         dd      iat-IB, iat_end-iat     ; 12 IAT
   193 00000120 00000000<rep 6h>    <1>         times   3*2 dd 0                ; 13-15
   194                              <1> opthdr_end:
   195 00000138 2E74657874000000    <1>         db      '.text',0,0,0           ; the one section
   196 00000140 00F00100            <1>         dd      IMGSIZE-SECTVA          ; VirtualSize: code, then zeros up to
   197                              <1>                                         ;   the arena's end
   198 00000144 00100000            <1>         dd      SECTVA                  ; VirtualAddress
   199 00000148 000A0000            <1>         dd      RAWSIZE                 ; SizeOfRawData
   200 0000014C 00020000            <1>         dd      200h                    ; PointerToRawData
   201 00000150 0000000000000000    <1>         dd      0, 0                    ; no relocations, no line numbers
   202 00000158 00000000            <1>         dw      0, 0
   203 0000015C 600000E0            <1>         dd      0E0000060h              ; code, initialised data, execute,
   204                              <1>                                         ;   read, write
   205 00000160 00<rep A0h>         <1>         times   200h-($-$$) db 0
   206                              <1> 
   207                              <1> ; =============================================================================
   208                              <1> ;  The code
   209                              <1> ; =============================================================================
   210                              <1>         section text start=200h vstart=IB+SECTVA
   211                              <1> tstart:
   212                              <1> %define V(x) ebp+(x)-next               ; a variable or IAT slot near `next`
   213                              <1> 
   214                              <1> ; The routines called from many places are called through a pointer near
   215                              <1> ; `next` (CALL [EBP+d8], 3 bytes, instead of 5): the pointers are at ptrs,
   216                              <1> ; after the IAT. P_x says whether routine x has one in this build.
   217                              <1> %define P_putc  1
   218                              <1> %define P_waitk EDITOR
   219                              <1> %define P_ekey  EDITOR
   220                              <1> %define P_rdnum EDITOR
   221                              <1> %define P_find  EDITOR
   222                              <1> %define P_pmsg  CHECKED
   223                              <1> %define P_pdec  CHECKED
   224                              <1> %define P_hexc  1
   225                              <1> %macro  CALLP 1
   226                              <1>  %if P_%1
   227                              <1>         call    [V(p_%1)]
   228                              <1>  %else
   229                              <1>         call    %1
   230                              <1>  %endif
   231                              <1> %endmacro
   232                              <1> %macro  JMPP 1
   233                              <1>  %if P_%1
   234                              <1>         jmp     [V(p_%1)]
   235                              <1>  %else
   236                              <1>         jmp     %1
   237                              <1>  %endif
   238                              <1> %endmacro
   239                              <1> %define NEXTJ   jmp ebp                 ; (how DIVCODE ends: the fast build's
   240                              <1>                                         ;   own '/' has the dispatcher there)
   241                              <1> 
   242                              <1> ; NEXTF (the fast build): the dispatcher. It is `next`, and it is inline at
   243                              <1> ; the end of the fast build's own handlers, so they never jump back to it.
   244                              <1> ; Every handler is entered with EAX = its character, zero-extended. NEXTD is
   245                              <1> ; the one after a digit: through dtabd, where a digit goes on with the number.
   246                              <1> %macro  NEXTF 0
   247                              <1> %if CHECKED
   248                              <1>         call    chkstk                  ; both stacks, once per character
   249                              <1> %endif
   250                              <1>         movzx   eax,byte [esi]
   251                              <1>         inc     esi
   252                              <1>         jmp     [dtab+eax*4]
   253                              <1> %endmacro
   254                              <1> %macro  NEXTD 0
   255                              <1>         movzx   eax,byte [esi]
   256                              <1>         inc     esi
   257                              <1>         jmp     [dtabd+eax*4]
   258                              <1> %endmacro
   259                              <1> 
   260                              <1> ; run0: start running at ESI. The heap starts after the stored program's
   261                              <1> ; NUL. TOS is popped: the data stack is as the last line left it. (The
   262                              <1> ; runner's startup runs on into it; in the editor builds it follows ^G.)
   263                              <1> %macro  RUN0CODE 0
   264                              <1> run0:   mov     edx,ARENA+PROG
   265                              <1> .st1:   inc     edx
   266                              <1>         cmp     byte [edx-1],0
   267                              <1>         jne     .st1
   268                              <1>         mov     [ARENA+HEAP],dx
   269                              <1> %if CHECKED
   270                              <1>         movzx   eax,dx                  ; '_' may not release below this
   271                              <1>         mov     [V(v_npend)],eax
   272                              <1> %endif
   273                              <1> %if QK
   274                              <1>         lea     eax,[edx-(ARENA+PROG)]  ; the text's length, NUL included: only
   275                              <1>         mov     [v_tlen],eax            ;   skips that start inside it are kept
   276                              <1>         push    edi                     ; the skip cache is emptied (a start of
   277                              <1>         mov     edi,skc                 ;   0 matches no skip: every IP is in
   278                              <1>         mov     ecx,2*NSKC              ;   the arena)
   279                              <1>         xor     eax,eax
   280                              <1>         rep     stosd
   281                              <1>         pop     edi
   282                              <1> %endif
   283                              <1>         pop     ebx
   284                              <1>         jmp     ebp
   285                              <1> %endmacro
   286                              <1> 
   287                              <1> ; ---- startup ----------------------------------------------------------------
   288                              <1> ; The data stack starts empty; the cell pushed here stands for TOS, as when
   289                              <1> ; the editor has the stack in memory: the run starts by popping it.
   290 00000000 BD[E3080000]        <1> start:  mov     ebp,next
   291 00000005 BE00024100          <1>         mov     esi,ARENA+PROG
   292 0000000A 896556              <1>         mov     [V(v_dstop)],esp
   293 0000000D 56                  <1>         push    esi                     ; (the cell that stands for TOS)
   294 0000000E 6AF6                <1>         push    -10                     ; STD_INPUT_HANDLE
   295 00000010 FF5599              <1>         call    [V(iat_GetStdHandle)]
   296 00000013 89454A              <1>         mov     [V(v_hin)],eax
   297 00000016 97                  <1>         xchg    eax,edi                 ; (EDI = the input handle, for now)
   298                              <1>         ; ANSI escape sequences: the output mode becomes processed output,
   299                              <1>         ; wrap at the end of a line and virtual terminal processing (1+2+4),
   300                              <1>         ; so the console obeys ESC [ ... as a terminal does. 1+2 is the
   301                              <1>         ; console's usual output mode. On Windows before 10, or when the
   302                              <1>         ; output is not a console, the call fails and nothing changes. The
   303                              <1>         ; mode is left on at the end, which does no harm. (The arguments
   304                              <1>         ; are pushed now, and the call made after the input's two.)
   305 00000017 6A07                <1>         push    7
   306 00000019 6AF5                <1>         push    -11                     ; STD_OUTPUT_HANDLE
   307 0000001B FF5599              <1>         call    [V(iat_GetStdHandle)]
   308 0000001E 894552              <1>         mov     [V(v_outh)],eax
   309 00000021 50                  <1>         push    eax
   310                              <1>         ; Raw keys: no echo, no line editing, Ctrl-C as a key (mode 0). If
   311                              <1>         ; the input is not a console, GetConsoleMode fails, and the keys are
   312                              <1>         ; read as bytes with ReadFile (see waitk).
   313 00000022 8D4D5C              <1>         lea     ecx,[V(v_mode)]
   314 00000025 51                  <1>         push    ecx
   315 00000026 57                  <1>         push    edi
   316 00000027 FF559D              <1>         call    [V(iat_GetConsoleMode)]
   317 0000002A 88455A              <1>         mov     [V(v_iscon)],al
   318 0000002D 6A00                <1>         push    0
   319 0000002F 57                  <1>         push    edi
   320 00000030 FF55A1              <1>         call    [V(iat_SetConsoleMode)]
   321 00000033 FF55A1              <1>         call    [V(iat_SetConsoleMode)] ; (the output's, pushed above)
   322                              <1>         ; A high-resolution waitable timer for the timed waits of '?' (Windows
   323                              <1>         ; 10 1803 and later). A plain wait only ends on the system's tick,
   324                              <1>         ; every 15.6 ms, so 1? would take about 16 ms. Older Windows refuses
   325                              <1>         ; the flag; then v_htm is 0 and the waits are plain ones.
   326 00000036 6803001F00          <1>         push    1F0003h                 ; TIMER_ALL_ACCESS
   327 0000003B 6A02                <1>         push    2                       ; CREATE_WAITABLE_TIMER_HIGH_RESOLUTION
   328 0000003D 6A00                <1>         push    0
   329 0000003F 6A00                <1>         push    0
   330 00000041 FF55B9              <1>         call    [V(iat_CreateWaitableTimerExW)]
   331 00000044 89454E              <1>         mov     [V(v_htm)],eax
   332                              <1>         ; The command line: the program's own name, then the file's.
   333 00000047 FF55A5              <1>         call    [V(iat_GetCommandLineA)]
   334 0000004A 96                  <1>         xchg    eax,esi
   335 0000004B E84B000000          <1>         call    token
   336 00000050 E846000000          <1>         call    token
   337 00000055 E865000000          <1>         call    load                    ; (no file, or no such file: no text)
   338                              <1> %if EDITOR
   339                              <1>         mov     eax,6835323Fh           ; ESC [ ? 2 5 h: the editor shows the
   340                              <1>         call    pseq                    ;   cursor when it starts, as after an
   341                              <1>         jmp     edit                    ;   error or a break (edit0)
   342                              <1> %else
   343 0000005A BF00FF4000          <1>         mov     edi,RSTOP               ; the return stack is empty
   344 0000005F BE00024100          <1>         mov     esi,ARENA+PROG          ; the IP
   345                              <1>         RUN0CODE                        ; (on into run0)
   264 00000064 BA00024100          <2> run0: mov edx,ARENA+PROG
   265 00000069 42                  <2> .st1: inc edx
   266 0000006A 807AFF00            <2>  cmp byte [edx-1],0
   267 0000006E 75F9                <2>  jne .st1
   268 00000070 6689157C014100      <2>  mov [ARENA+HEAP],dx
   269                              <2> %if CHECKED
   270 00000077 0FB7C2              <2>  movzx eax,dx
   271 0000007A 894560              <2>  mov [V(v_npend)],eax
