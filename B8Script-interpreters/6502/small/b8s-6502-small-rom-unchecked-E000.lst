E416                             ; =============================================================================
E416                             ;  Fetches, and the keyboard
E416                             ; =============================================================================
E416   A0 01        H_FETCH:   LDY   #1   ; "@"
E418   B1 02                  LDA   (TL),Y   
E41A   48                     PHA      ; the high byte, while "," gets the low one
E41B   20 22 E4               JSR   h_cfetch   
E41E   68                     PLA      
E41F   85 03                  STA   TH   
E421   60                     RTS      
E422                H_CFETCH:      ; ","
E422   A0 00                  LDY   #0   
E424   B1 02                  LDA   (TL),Y   
E426   85 02        CF2:      STA   TL   ; TOS = A (low), Y (high)
E428   84 03                  STY   TH   
E42A   60                     RTS      
E42B                             ; "?" ( n -- c ) or ( -n -- addr )
E42B                             ;   n > 0: wait about n ms for a key; 0 if none came
E42B                             ;   n = 0: wait for a key
E42B                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
E42B                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
E42B   A5 03        H_KEY:    LDA   TH   
E42D   30 20                  BMI   line   
E42F   A0 28        KT1:      LDY   #MSLOOP   ; one millisecond, roughly
E431   20 77 E0     KT2:      JSR   getk   
E434   D0 15                  BNE   kt3   
E436   88                     DEY      
E437   D0 F8                  BNE   kt2   
E439   A5 02                  LDA   TL   ; count the millisecond off:
E43B   D0 06                  BNE   kt4   
E43D   A5 03                  LDA   TH   
E43F   F0 EE                  BEQ   kt1   ; 0? never counts down: it waits
E441   C6 03                  DEC   TH   
E443   C6 02        KT4:      DEC   TL   
E445   D0 E8                  BNE   kt1   
E447   A5 03                  LDA   TH   
E449   D0 E4                  BNE   kt1   ; A = 0 if the time ran out
E44B   A0 00        KT3:      LDY   #0   
E44D   F0 D7                  BEQ   cf2   ; always: TOS = A
E44F                             ; Backspace takes the last character back (and is echoed as it is), CR ends
E44F                             ; (stored, not echoed), every other key is stored and echoed until the line
E44F                             ; is full. Y = the length so far; TL = the most allowed.
E44F   20 2E E3     LINE:     JSR   neg   ; TOS = the count, and A = its high byte
E452   D0 04                  BNE   ln0   
E454   A5 02                  LDA   TL   
E456   10 04                  BPL   ln1   
E458   A9 7F        LN0:      LDA   #127   ; more than 127 is taken as 127
E45A   85 02                  STA   TL   
E45C   A0 00        LN1:      LDY   #0   
E45E   F0 03                  BEQ   ln2   ; always
E460   20 03 FF     LN3:      JSR   CONOUT   
E463   20 77 E0     LN2:      JSR   getk   
E466   F0 FB                  BEQ   ln2   
E468   C9 0D                  CMP   #13   
E46A   F0 14                  BEQ   ln5   
E46C   C9 08                  CMP   #8   
E46E   F0 0A                  BEQ   ln4   
E470   C4 02                  CPY   TL   
E472   B0 EF                  BCS   ln2   ; full
E474   99 80 04               STA   LINEBUF,Y   
E477   C8                     INY      
E478   D0 E6                  BNE   ln3   ; always: echo it
E47A   88           LN4:      DEY      ; Backspace: one back, and echo it,
E47B   10 E3                  BPL   ln3   
E47D   C8                     INY      ;   unless the line was empty
E47E   F0 E3                  BEQ   ln2   ; always
E480   99 80 04     LN5:      STA   LINEBUF,Y   ; A = CR
E483   A9 80                  LDA   #<LINEBUF   
E485   A0 04                  LDY   #>LINEBUF   
E487   D0 9D                  BNE   cf2   ; always: TOS = the line's address
E489                             ; =============================================================================
E489                             ;  Machine code: the grave
E489                             ; =============================================================================
E489                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
E489                             ; are stored from addr until a non-hex character; then a RET (60h) is
E489                             ; written and its address is left. An odd last digit is consumed and dropped.
E489                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ); see the
E489                             ; contract in the header.
E489   20 8E E2     H_GRAVE:   JSR   rdhex   
E48C   B0 1C                  BCS   exec   
E48E   0A           HX1:      ASL      
E48F   0A                     ASL      
E490   0A                     ASL      
E491   0A                     ASL      
E492   85 04                  STA   T0   
E494   20 8E E2               JSR   rdhex   
E497   B0 0C                  BCS   hx2   ; odd digit: already consumed, dropped
E499   05 04                  ORA   T0   
E49B   91 02                  STA   (TL),Y   ; Y is 0 after rdhex (never checked)
E49D   20 BC E1               JSR   inctos   
E4A0   20 8E E2               JSR   rdhex   
E4A3   90 E9                  BCC   hx1   
E4A5   A9 60        HX2:      LDA   #60h   
E4A7   91 02                  STA   (TL),Y   
E4A9   60                     RTS      
E4AA   A5 02        EXEC:     LDA   TL   
E4AC   85 04                  STA   T0   
E4AE   A5 03                  LDA   TH   
E4B0   85 05                  STA   T1   
E4B2   20 D2 E2               JSR   drop   ; the address is consumed
E4B5   6C 04 00               JMP   (T0)   
E4B8                          IF   CHECKED   
                                 ; =============================================================================
                                 ;  Checked build: the error report
                                 ; =============================================================================
                                 ; error: the report, then EXIT. A = the letter, PLACE = the place, X = the
                                 ; data stack to show, RSV = S for the R: line. Nothing here relies on S: an
                                 ; overflowed or underflowed hardware stack wraps inside its page, and only
                                 ; its depth is shown.
                                 ;   CR LF
                                 ;   Err X @ line,col CR LF
                                 ;   D:n: [...] and the top 8 cells at most, bottom to top  CR LF
                                 ;   R:n CR LF
                                 ; The numbers go through "#" (h_num), each pushed over the data stack first
                                 ; and popped again by "#", so the stack is shown as it was.
                    ERROR:    PHA      ; the letter
                              LDY   #M_ERR-MSG   
                              JSR   prs   ; CR LF "Err "
                              PLA      
                              JSR   CONOUT   
                              JSR   prs   ; " @ " (it follows M_ERR)
                                 ; The line and the column of the place, both from 1. The line is counted in
                                 ; a cell pushed over the data stack (TOS). A place below the program is in
                                 ; the -n? line buffer: line 0, and the column is the place in the buffer.
                                 ; Otherwise IP (free now: the program has stopped) runs from PROG to the
                                 ; place, counting LFs; CL keeps where the last line started, and the column
                                 ; is the place minus that, plus 1.
                              LDA   #<LINEBUF   
                              STA   CL   
                              LDA   #>LINEBUF   
                              STA   CL+1   
                              LDA   #0   
                              TAY      
                              JSR   pushay   ; TOS = the line, 0 so far
                              LDA   PLACE   
                              CMP   #<PROG   
                              LDA   PLACE+1   
                              SBC   #>PROG   
                              BCC   lc9   ; below the program: line 0
                              INC   TL   
                              JSR   rstip   
                    LC3:      LDA   IP   ; a line starts here
                              STA   CL   
                              LDA   IP+1   
                              STA   CL+1   
                    LC1:      LDA   IP   
                              CMP   PLACE   
                              LDA   IP+1   
                              SBC   PLACE+1   
                              BCS   lc9   ; at the place
                              JSR   getc   
                              CMP   #10   
                              BNE   lc1   
                              JSR   inctos   ; an LF: a new line starts after it
                              BNE   lc3   ; always (Z clear: fewer than 65536 lines)
                    LC9:      JSR   h_num   ; the line (and it is dropped)
                              LDA   #","   
                              JSR   CONOUT   
                              SEC      
                              LDA   PLACE   
                              SBC   CL   
                              PHA      
                              LDA   PLACE+1   
                              SBC   CL+1   
                              TAY      
                              PLA      
                              JSR   pushay   
                              JSR   inctos   ; + 1
                              JSR   h_num   ; the column
                              LDY   #M_STK-MSG   
                              JSR   prs   ; CR LF "D:"
                              TXA      
                              EOR   #0FFh   
                              SEC      
                              SBC   #0FFh-DSE   ; the depth, DSE - X (FFh, an overflow: 253)
                              PHA      
                              JSR   prnum8   
                              PLA      
                              LDY   #M_C-MSG   ; ":"
                              CMP   #9   
                              BCC   er3   
                              LDA   #8   ; more than 8: ": ..." and the top 8
                              LDY   #M_CD-MSG   
                    ER3:      STA   T2   ; T2 = how many cells to show (the place
                                 ;   is no longer needed)
                              JSR   prs   
                              JSR   push   ; TOS into memory with the rest: cell i from
                                 ;   the top is at DSL+X+i now
                    ER4:      LDA   T2   ; cells T2-1 down to 0, the top last
                              BEQ   er5   
                              DEC   T2   
                              LDA   #" "   
                              JSR   CONOUT   
                              TXA      
                              CLC      
                              ADC   T2   
                              TAY      
                              LDA   DSL,Y   
                              PHA      
                              LDA   DSH,Y   
                              TAY      
                              PLA      
                              JSR   prnum   
                              JMP   er4   
                    ER5:      LDY   #M_RTN-MSG   
                              JSR   prs   ; CR LF "R:"
                              LDA   RSV   
                              EOR   #0FFh   
                              LSR      ; (FFh - S) / 2 entries
                              JSR   prnum8   
                              LDY   #M_NL-MSG   
                              JSR   prs   
                              JMP   EXIT   
                                 ; prnum: print the number A (low), Y (high), signed, keeping the data stack.
                                 ; prnum8: the same for A alone, 0-255.
                    PRNUM8:   LDY   #0   
                    PRNUM:    JSR   pushay   
                              JMP   h_num   
E4B8                          ENDIF      
E4B8                             ; =============================================================================
E4B8                             ;  The fast build (SPEED = 2)
E4B8                             ; 
E4B8                             ;  The inner loop is a table: 256 entries, the low bytes of the handlers'
E4B8                             ;  addresses in one page (DTL) and the high bytes in the next (DTH). The
E4B8                             ;  dispatcher, NEXTF, is inline at the end of the fast build's own entries,
E4B8                             ;  so there is no JSR and no RTS per character:
E4B8                             ;      LDY #0 / LDA (IP),Y / INC IP / BNE $+4 / INC IP+1 / TAY /
E4B8                             ;      LDA DTL,Y / STA V / LDA DTH,Y / STA V+1 / JMP (V)
E4B8                             ;  The letters and digits have one entry each, which knows its cell or its
E4B8                             ;  value already; the commonest punctuation is written for the table; the
E4B8                             ;  rest reach the ordinary handlers through a thunk (CLC / JSR handler /
E4B8                             ;  NEXTF, or JMP fnext for the rare ones), which gives them the step frame
E4B8                             ;  and the clear carry they expect.
E4B8                             ;  The ordinary handlers that end at next or pnext go to fnext, the same
E4B8                             ;  dispatcher. In the checked build NEXTF is JMP fnext, which checks the
E4B8                             ;  stacks first, as next does in the other builds.
E4B8                             ;  Everything here is read-only: the image can be ROM, as the others are.
E4B8                             ;  The table takes the image's first two pages (E000h-E1FFh); the code
E4B8                             ;  starts after it.
E4B8                             ; =============================================================================
E4B8                          IF   FAST   
                                 ; fnext: the dispatcher, after the checks of the checked build
                    FNEXT:       
E4B8                          ENDIF      
E4B8                          IF   FAST*CHECKED   
                                 ; (the same checks as next in the other checked builds)
                              TXA      ; TSX trashes X: keep it in A
                              TSX      
                              STX   RSV   
                              CPX   #RSLIM   
                              TAX      
                              BCS   fn1   
                              JMP   e_rstack   
                    FN1:      CPX   #DSE+1   
                              BCC   fn3   
                              JMP   e_stack   
                    FN3:      LDA   IP   
                              STA   PLACE   
                              LDA   IP+1   
                              STA   PLACE+1   
E4B8                          ENDIF      
E4B8                          IF   FAST   
                              LDY   #0   
                              LDA   (IP),Y   
                              INC   IP   
                              BNE   fn4   
                              INC   IP+1   
                    FN4:      TAY      
                              LDA   DTL,Y   
                              STA   V   
                              LDA   DTH,Y   
                              STA   V+1   
                              JMP   (V)   
                                 ; fpoll: the break check of pnext, as a subroutine, for the entries that
                                 ; look at the keyboard (a word call, a true ( and a true ))
                    FPOLL:    JSR   KEY   
                              BEQ   fp9   ; no key
                              STA   KEYBUF   ; held for the next "?"
                              JMP   chk3   ; (Ctrl-C: back only if the break key is off)
                    FP9:      RTS      
                                 ; The thunks: the rest of the punctuation, through the ordinary handlers
                    FT_STR:   CLC      ; "
                              JSR   h_str   
                              JMP   fnext   ; (rare enough: the shared dispatcher)
                    FT_NUM:   CLC      ; #
                              JSR   h_num   
                              JMP   fnext   ; (rare enough: the shared dispatcher)
                    FT_PRT:   CLC      ; $
                              JSR   h_print   
                              JMP   fnext   ; (rare enough: the shared dispatcher)
                    FT_EMIT:   CLC      ; '
                              JSR   h_emit   
                              JMP   fnext   ; (rare enough: the shared dispatcher)
                    FT_DIV:   CLC      ; /
                              JSR   h_div   
                              ;*Macro unroll:  NEXTF
                              DS   1-CHECKED,0A0h   
                              DS   1-CHECKED,0   
                              DS   1-CHECKED,0B1h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0D0h   
                              DS   1-CHECKED,2   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP+1   
                              DS   1-CHECKED,0A8h   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTL&0FFh   
                              DS   1-CHECKED,ADTL/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTH&0FFh   
                              DS   1-CHECKED,ADTH/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V+1   
                              DS   1-CHECKED,6Ch   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0   
                              DS   CHECKED,4Ch   
                              DS   CHECKED,AFNX&0FFh   
                              DS   CHECKED,AFNX/256   
                    FT_KEY:   CLC      ; ?
                              JSR   h_key   
                              JMP   fnext   ; (rare enough: the shared dispatcher)
                    FT_DEF:   CLC      ; [
                              JSR   h_def   
                              ;*Macro unroll:  NEXTF
                              DS   1-CHECKED,0A0h   
                              DS   1-CHECKED,0   
                              DS   1-CHECKED,0B1h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0D0h   
                              DS   1-CHECKED,2   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP+1   
                              DS   1-CHECKED,0A8h   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTL&0FFh   
                              DS   1-CHECKED,ADTL/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTH&0FFh   
                              DS   1-CHECKED,ADTH/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V+1   
                              DS   1-CHECKED,6Ch   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0   
                              DS   CHECKED,4Ch   
                              DS   CHECKED,AFNX&0FFh   
                              DS   CHECKED,AFNX/256   
                    FT_BRK:   CLC      ; \
                              JSR   h_break   
                              ;*Macro unroll:  NEXTF
                              DS   1-CHECKED,0A0h   
                              DS   1-CHECKED,0   
                              DS   1-CHECKED,0B1h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0D0h   
                              DS   1-CHECKED,2   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP+1   
                              DS   1-CHECKED,0A8h   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTL&0FFh   
                              DS   1-CHECKED,ADTL/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTH&0FFh   
                              DS   1-CHECKED,ADTH/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V+1   
                              DS   1-CHECKED,6Ch   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0   
                              DS   CHECKED,4Ch   
                              DS   CHECKED,AFNX&0FFh   
                              DS   CHECKED,AFNX/256   
                    FT_ALC:   CLC      ; _
                              JSR   h_alloc   
                              JMP   fnext   ; (rare enough: the shared dispatcher)
                    FT_GRV:   CLC      ; `
                              JSR   h_grave   
                              JMP   fnext   ; (rare enough: the shared dispatcher)
                    FT_TOR:   CLC      ; {
                              JSR   h_tor   
                              JMP   fnext   ; (rare enough: the shared dispatcher)
                    FT_FRR:   CLC      ; }
                              JSR   h_fromr   
                              JMP   fnext   ; (rare enough: the shared dispatcher)
E4B8                          ENDIF      
E4B8                          IF   FAST*CHECKED   
                    FT_STO:   CLC      ; ! (checked: it checks the address)
                              JSR   h_store   
                              JMP   fnext   
                    FT_CST:   CLC      ; . (the same)
                              JSR   h_cstore   
                              JMP   fnext   
E4B8                          ENDIF      
E4B8                          IF   FAST   
                                 ; The commonest punctuation, written for the table
                    FS_ADD:   CLC      ; +
                              LDA   DSL,X   
                              ADC   TL   
                              STA   TL   
                              LDA   DSH,X   
                              ADC   TH   
                              STA   TH   
                              INX      
                              ;*Macro unroll:  NEXTF
                              DS   1-CHECKED,0A0h   
                              DS   1-CHECKED,0   
                              DS   1-CHECKED,0B1h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0D0h   
                              DS   1-CHECKED,2   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP+1   
                              DS   1-CHECKED,0A8h   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTL&0FFh   
                              DS   1-CHECKED,ADTL/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTH&0FFh   
                              DS   1-CHECKED,ADTH/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V+1   
                              DS   1-CHECKED,6Ch   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0   
                              DS   CHECKED,4Ch   
                              DS   CHECKED,AFNX&0FFh   
                              DS   CHECKED,AFNX/256   
                    FS_SUB:   LDY   #0   ; -
                              LDA   (IP),Y   
                              CMP   #3Ah   
                              BCS   fsb1   
                              CMP   #30h   
                              BCS   fsb2   ; a digit next: a negative number
                    FSB1:     SEC      
                              LDA   DSL,X   
                              SBC   TL   
                              STA   TL   
                              LDA   DSH,X   
                              SBC   TH   
                              STA   TH   
                              INX      
                              ;*Macro unroll:  NEXTF
                              DS   1-CHECKED,0A0h   
                              DS   1-CHECKED,0   
                              DS   1-CHECKED,0B1h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0D0h   
                              DS   1-CHECKED,2   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP+1   
                              DS   1-CHECKED,0A8h   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTL&0FFh   
                              DS   1-CHECKED,ADTL/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTH&0FFh   
                              DS   1-CHECKED,ADTH/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V+1   
                              DS   1-CHECKED,6Ch   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0   
                              DS   CHECKED,4Ch   
                              DS   CHECKED,AFNX&0FFh   
                              DS   CHECKED,AFNX/256   
                    FSB2:     JSR   negnum   
                              ;*Macro unroll:  NEXTF
                              DS   1-CHECKED,0A0h   
                              DS   1-CHECKED,0   
                              DS   1-CHECKED,0B1h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0D0h   
                              DS   1-CHECKED,2   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP+1   
                              DS   1-CHECKED,0A8h   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTL&0FFh   
                              DS   1-CHECKED,ADTL/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTH&0FFh   
                              DS   1-CHECKED,ADTH/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V+1   
                              DS   1-CHECKED,6Ch   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0   
                              DS   CHECKED,4Ch   
                              DS   CHECKED,AFNX&0FFh   
                              DS   CHECKED,AFNX/256   
                    FS_DUP:   DEX      ; :
                              LDA   TL   
                              STA   DSL,X   
                              LDA   TH   
                              STA   DSH,X   
                              ;*Macro unroll:  NEXTF
                              DS   1-CHECKED,0A0h   
                              DS   1-CHECKED,0   
                              DS   1-CHECKED,0B1h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0D0h   
                              DS   1-CHECKED,2   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP+1   
                              DS   1-CHECKED,0A8h   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTL&0FFh   
                              DS   1-CHECKED,ADTL/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTH&0FFh   
                              DS   1-CHECKED,ADTH/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V+1   
                              DS   1-CHECKED,6Ch   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0   
                              DS   CHECKED,4Ch   
                              DS   CHECKED,AFNX&0FFh   
                              DS   CHECKED,AFNX/256   
                    FS_DRP:   LDA   DSL,X   ; ;
                              STA   TL   
                              LDA   DSH,X   
                              STA   TH   
                              INX      
                              ;*Macro unroll:  NEXTF
                              DS   1-CHECKED,0A0h   
                              DS   1-CHECKED,0   
                              DS   1-CHECKED,0B1h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0D0h   
                              DS   1-CHECKED,2   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP+1   
                              DS   1-CHECKED,0A8h   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTL&0FFh   
                              DS   1-CHECKED,ADTL/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTH&0FFh   
                              DS   1-CHECKED,ADTH/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V+1   
                              DS   1-CHECKED,6Ch   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0   
                              DS   CHECKED,4Ch   
                              DS   CHECKED,AFNX&0FFh   
                              DS   CHECKED,AFNX/256   
                    FS_SWP:   LDY   DSL,X   ; %
                              LDA   TL   
                              STA   DSL,X   
                              STY   TL   
                              LDY   DSH,X   
                              LDA   TH   
                              STA   DSH,X   
                              STY   TH   
