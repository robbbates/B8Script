                              LD   (IY-2),C   ;   on the return stack,
                              DEC   IY   
                              DEC   IY   
                              LD   BC,(LET+0)   ;   the IP becomes the word's body, and the break
                              EX   DE,HL   ;   key is looked at as rpushn would
                              PUSH   HL   
                              LD   HL,PCNT   
                              DEC   (HL)   
                              POP   HL   
