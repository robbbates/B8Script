0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Spec: docs/b8script.md (2026-11-23).
0000                             ; 
0000                             ;  Four switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    EDITOR   1 = with the line editor built in (see the end of this file):
0000                             ;                 the spec's suggested standard. It goes with either setting
0000                             ;                 of the other two.
0000                             ;    CHECKED  0 = no checks (spec: the programmer is responsible)
0000                             ;             1 = starts with every variable at 0 and every word undefined,
0000                             ;                 and stops on every error in the spec's table (and Ctrl-C)
0000                             ;                 with a four-line report: the letter and the place as line
0000                             ;                 and column, the text there, and both stacks. See `error`.
0000                             ;    ANSI     1 = the four console codes (`@ `^ `_ `?) send ANSI escape
0000                             ;                 sequences through CONOUT
0000                             ;             0 = they call four routines of the machine's own instead:
0000                             ;                 CONAT, CONCLS, CONEOL and CONCUR (see the equates)
0000                             ; 
0000                             ;  In every build Ctrl-C stops a running program (an unchecked build stops
0000                             ;  without a word): see the console layer for the rules, the held key and
0000                             ;  the break-off cell.
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   0   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   1   ; 1 = checked build
0000                EDITOR:   EQU   0   ; 1 = with the line editor
0000                ANSI:     EQU   1   ; 1 = the console codes send ANSI sequences
0000                EDGEN:    EQU   EDITOR*(1-CPM)   ; (the generic build with the editor)
0000                             ; (IF takes any value but 0 as true, so
0000                             ;  IF CHECKED+EDITOR means "either")
0000                TABP0:    EQU   EDGEN*(1-CHECKED)   ; (the build with its table in page zero)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    HL'  return-stack pointer (the alternate HL). Entries are 2 bytes; the
0000                             ;         stack grows down. Only rpop and rpushn (and the checks) touch it.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  One-byte calls. The routines used most are reached with RST, one byte
0000                             ;  instead of three:
0000                             ; 
0000                             ;    RST 08h  rpop    pop the return stack into DE
0000                             ;    RST 18h  drop    drop TOS, then next character     (ends a handler)
0000                             ;    RST 20h  neg16   HL = -HL
0000                             ;    RST 28h  putc    print A
0000                             ;    RST 30h  next    next character                    (ends a handler)
0000                             ; 
0000                             ;  RST 18h and RST 30h never return: an RST is a CALL, so the first thing
0000                             ;  each of them does is POP DE to throw the return address away.
0000                             ; 
0000                             ;  The CP/M build can't own page zero, so the block from `vecs` to `vecend`
0000                             ;  (image addresses 0108h-0133h) is copied to 0008h-0033h when it starts. The
0000                             ;  code in that block is written to work at either place.
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (the top four bytes of the page are spare,
0000                             ;             so a full stack runs two bytes into the page below)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch, interpreter variables in the gaps, and the -n? line buffer
0000                             ;             at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack has a guard band: the data stack can
0000                             ;  overrun by a cell or two (and the calls made while it is full, the error
0000                             ;  report's included) into the top 32 bytes of the return-stack page, which
0000                             ;  are never used, and the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
                    BDOS:     EQU   0005h   
                    BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IF   CPM*(1-EDITOR)   
                    EXIT:     EQU   0000h   ; warm boot
0000                          ENDIF      
0000                          IFN   CPM   
0000                             ; ---- generic machine: edit these to suit -----------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The zero flag must match A
0000                             ;   (end the routine with OR A / RET).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                             ;   KEY and CONOUT must preserve BC, DE, HL and HL'.
0000                RSPAGE:   EQU   80h   ; 8000h return stack
0000                DSPAGE:   EQU   81h   ; 8100h data stack
0000                LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
0000                PROG:     EQU   8300h   ; where the loader puts the program text
0000                HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
0000                BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-ANSI)   
                                 ; ---- generic machine with ANSI = 0: the console codes call these ------------
                    CONAT:    EQU   0FF0Ch   ; `@  cursor to row E, column L, both from 0
                                 ;     (DE and HL hold the whole cells). May
                                 ;     change A, DE and HL
                    CONCLS:   EQU   0FF0Fh   ; `^  clear the screen and home the cursor
                    CONEOL:   EQU   0FF12h   ; `_  clear from the cursor to the end of the line
                    CONCUR:   EQU   0FF15h   ; `?  cursor off if A = 0 (the zero flag is set
                                 ;     to match), on if not. May change A, DE, HL
                                 ;   All four must preserve BC and HL'; CONCLS and CONEOL also DE and HL.
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)   
0000                EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                          ENDIF      
0000                          IF   EDGEN   
                    LEAVE:    EQU   0FF09h   ; where the editor's ^X goes
0000                          ENDIF      
0000                          IF   EDITOR*CPM   
                    LEAVE:    EQU   0000h   ; the editor's ^X: warm boot
0000                          ENDIF      
0000                          IF   EDITOR   
                    EXIT:     EQU   edend   ; a program that ends goes back to the editor,
                    SKEND:    EQU   skend   ;   also when it ends inside skip
0000                          ENDIF      
0000                          IF   1-EDITOR   
0000                SKEND:    EQU   EXIT   
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine. (The wait
0000                             ; for a second Ctrl-C uses it too: 250 ms.)
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                             ;   around machine code;
0000                NPEND:    EQU   LET+38h   ;   minus the address of the program's end
0000                             ;   (the heap"s first byte), for the checked "_';
0000                EDLN:     EQU   LET+3Ah   ;   the editor: the number of the line that ^E
0000                             ;   put in the input line (0: none)
0000                SEED:     EQU   LET+76h   ; gap after z: the random seed, the cell whose
0000                             ;   address `. gives. Nothing sets it at the
0000                             ;   start but the checked build's clearing;
0000                KEYBUF:   EQU   LET+7Ah   ;   a key read by the break check and
0000                             ;   held for the next "?" (0: none);
0000                BRKOFF:   EQU   LET+7Bh   ;   the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                LBHDR:    EQU   LET+7Eh   ; CP/M BDOS 10 header: max, count
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FCh   ; empty data stack. The four bytes above it
0000                             ; are spare: a character can pop two cells
0000                             ; too many before the checked build sees it,
0000                             ; and the next call must not land on the
0000                             ; letter cells.
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is the start of the .COM file, and 0108h-0133h is also copied to
0000                             ;  page zero (see the header).
0000                             ; =============================================================================
0000                          .ORG   BASE   
0000                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
0000   AF                     XOR   A   ; 00  reset. (This byte, AFh, is also what an
0001                          ENDIF      ;     undefined word runs into: see e_hi.)
0001                          IF   1-EDGEN   
0001   31 FC 81               LD   SP,DSTOP   ; 00  reset, or the start of the .COM file
0004                          ENDIF      
0004                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)   
                              LD   BC,PROG   ; 03  the IP
                              JR   st0   ; 06  (the rest of the startup is close by)
0004                          ENDIF      
0004                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
0004   18 6C                  JR   init   ; 04  (the rest of the startup is close by)
0006   00 00                  DW   0   ; 06  spare
0008                          ENDIF      
0008                          IF   EDGEN   
                              XOR   A   ; 00  reset: no program yet. (This byte, AFh,
                              LD   (PROG),A   ;     is also what an undefined word runs
                              JP   init   ; 04  into in the checked build: see e_hi.)
                              NOP      ; 07  spare
0008                          ENDIF      
0008                          IF   CPM   
                              JP   start   ; 03
                              DW   0   ; 06  spare
0008                          ENDIF      
0008                VECS:        
0008                             ; ---- RST 08h: rpop: pop the return stack into DE ---------------------------
0008   D9           RPOP:     EXX      ; 08
0009   5E                     LD   E,(HL)   
000A   23                     INC   HL   
000B   56                     LD   D,(HL)   
000C   23                     INC   HL   
000D   D5                     PUSH   DE   ; across to the main registers
000E   D9                     EXX      
000F   D1                     POP   DE   
0010   C9                     RET      ; 10  (so RST 10h is not used)
0011                             ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
0011   C6 21        CTL:      ADD   A,21h   ; 11  back to c; zero only for NUL
0013   20 1C                  JR   NZ,next0   ;     the rest are ignored
0015   C3 09 FF     ENDPROG:   JP   EXIT   ;     the program has ended
0018                             ; ---- RST 18h: drop TOS, then next ------------------------------------------
0018   D1           RST18:    POP   DE   ; 18  discard the RST's return address
0019   E1                     POP   HL   ;     new TOS = NOS
001A   18 15                  JR   nx   
001C   E5           H_FROMR:   PUSH   HL   ; 1C  "}" return stack to TOS
001D   CF                     RST   08h   
001E   EB                     EX   DE,HL   
001F   F7                     RST   30h   
0020                             ; ---- RST 20h: neg16: HL = -HL (keeps BC, DE) -------------------------------
0020   AF           NEG16:    XOR   A   ; 20
0021   95                     SUB   L   
0022   6F                     LD   L,A   
0023   9F                     SBC   A,A   
0024   94                     SUB   H   
0025   67                     LD   H,A   
0026   C9                     RET      
0027   00                     NOP      ; 27  spare
0028                             ; ---- RST 28h: putc: print A (keeps BC, DE, HL, HL') ------------------------
0028                RST28:       
0028                          IFN   CPM   
0028   C3 03 FF     PUTC:     JP   CONOUT   ; 28
002B                          ENDIF      
002B                          IF   CPM   
                              JP   putc   ; 28
002B                          ENDIF      
002B   E9           JPHL:     JP   (HL)   ; 2B  (for the machine-code call)
002C   E3           H_TOR:    EX   (SP),HL   ; 2C  "{" TOS to the return stack: the new TOS
002D   C3 D6 00               JP   rpushn   ;     comes up, the old one goes across
0030                             ; ---- RST 30h: next character -----------------------------------------------
0030   D1           RST30:    POP   DE   ; 30  discard the RST's return address
0031                NX:          
0031                          IF   CPM   
                              JP   next0   ; (this copy runs in page zero)
0031                          ENDIF      
0031                VECEND:      
0031                             ; =============================================================================
0031                             ;  The inner loop: read one character and sort it by range.
0031                             ; 
0031                             ;    00h          end of program
0031                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0031                             ;    30h-39h      digit: read a whole number
0031                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0031                             ;    61h-7Ah      a-z: push the address of that letter's cell
0031                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0031                             ; =============================================================================
0031                NEXT0:       
0031                          IF   CHECKED   
0031   CD 10 04               CALL   chkstk   ; both stacks are checked once per character
0034                          ENDIF      
0034   0A                     LD   A,(BC)   
0035   03                     INC   BC   
0036   D6 21                  SUB   21h   ; A = c - 21h
0038   38 D7                  JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
003A   FE 0F                  CP   0Fh   
003C   38 25                  JR   C,punct   ; 21h-2Fh: PTAB index 0-14
003E   D6 0F                  SUB   0Fh   ; A = c - 30h
0040   FE 0A                  CP   0Ah   
0042   38 7C                  JR   C,digit   ; 30h-39h
0044   FE 11                  CP   11h   
0046   38 19                  JR   C,p3a   ; 3Ah-40h
0048   D6 11                  SUB   11h   ; A = c - 41h
004A   FE 1A                  CP   1Ah   
004C   38 7E                  JR   C,upper   ; 41h-5Ah: A = letter index 0-25
004E   FE 20                  CP   20h   
0050   38 0D                  JR   C,p5b   ; 5Bh-60h
0052   FE 3A                  CP   3Ah   
0054   38 70                  JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0056   FE 3E                  CP   3Eh   
0058                          IF   1-CHECKED   
                              JR   NC,next0   ; 7Fh-FFh: ignored
0058                          ENDIF      
0058                          IF   CHECKED   
0058   28 D7                  JR   Z,next0   ; 7Fh, DEL: ignored
005A   D2 3C 04               JP   NC,e_hi   ; 80h-FFh: reserved
005D                          ENDIF      
005D   D6 1A                  SUB   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
005F   D6 09        P5B:      SUB   9   ; 5Bh-60h: -4 in all, index 22-27
0061   C6 05        P3A:      ADD   A,5   ; 3Ah-40h: index 15-21
0063                .macro PTABLE,
0063                             ; 
0063                 DB      h_store & 0FFh  ; !
0063                 DB      h_str & 0FFh    ; "
0063                 DB      h_num & 0FFh    ; #
0063                 DB      h_print & 0FFh  ; $
0063                 DB      h_swap & 0FFh   ; %
0063                 DB      h_and & 0FFh    ; &
0063                 DB      h_emit & 0FFh   ; '
0063                 DB      h_open & 0FFh   ; (
0063                 DB      h_close & 0FFh  ; )
0063                 DB      h_mul & 0FFh    ; *
0063                 DB      h_add & 0FFh    ; +
0063                 DB      h_cfetch & 0FFh ; ,
0063                 DB      h_sub & 0FFh    ; -
0063                 DB      h_cstore & 0FFh ; .
0063                 DB      h_div & 0FFh    ; /
0063                 DB      h_dup & 0FFh    ; :
0063                 DB      h_drop & 0FFh   ; ;
0063                 DB      h_lt & 0FFh     ; <
0063                 DB      h_eq & 0FFh     ; =
0063                 DB      h_gt & 0FFh     ; >
0063                 DB      h_key & 0FFh    ; ?
0063                 DB      h_fetch & 0FFh  ; @
0063                 DB      h_def & 0FFh    ; [
0063                 DB      h_break & 0FFh  ; \
0063                 DB      h_ret & 0FFh    ; ]
0063                 DB      h_xor & 0FFh    ; ^
0063                 DB      h_alloc & 0FFh  ; _
0063                 DB      h_grave & 0FFh  ; `
0063                 DB      h_tor & 0FFh    ; {
0063                 DB      h_or & 0FFh     ; |
0063                 DB      h_fromr & 0FFh  ; }
0063                 DB      h_not & 0FFh    ; ~
0063                .endm
0063                 
0063                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
0063                             ; untouched, and A, DE free.
0063   C6 A0        PUNCT:    ADD   A,PTAB & 0FFh   ; PTAB never crosses a page
0065   5F                     LD   E,A   
0066   16 03                  LD   D,PTAB / 256   ; (0 if the table is in page zero)
0068   FE B7                  CP   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
006A   1A                     LD   A,(DE)   
006B   5F                     LD   E,A   ; the handler's low byte
006C                          IF   (1-CPM)*(1-TABP0)   
006C   16 00                  LD   D,0   
006E                          ENDIF      
006E                          IFN   CPM   
006E   CB 12                  RL   D   ; its page: 0 + carry
0070                          ENDIF      
0070                          IF   CPM   
                              LD   D,1   
                              JR   NC,pu1   
                              INC   D   ; its page: 1 + carry
                    PU1:         
0070                          ENDIF      
0070   D5                     PUSH   DE   ; jump to it; the stack is balanced again
0071   C9                     RET      ;   when the handler starts
0072                             ; The rest of the startup: here so that the generic reset code can reach it
0072                             ; with JR. st0: find the program's NUL; the heap starts after it.
0072                             ; (The editor build has its own copy of this, next to the editor.)
0072                             ; A checked build first clears the lower half of the letter page (A = 0):
0072                             ; every variable starts at 0, every word cell holds 0000h, the address an
0072                             ; undefined word is caught at (see e_hi), and no key is held back.
0072                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
0072   21 00 82     INIT:     LD   HL,LET   
0075   77           INI1:     LD   (HL),A   
0076   2C                     INC   L   
0077   F2 75 00               JP   P,ini1   ; +00h to +7Fh
007A   01 00 83               LD   BC,PROG   ; the IP
007D                          ENDIF      
007D                          IF   (1-CPM)*(1-EDITOR)   
007D   60           ST0:      LD   H,B   
007E   69                     LD   L,C   
007F   AF                     XOR   A   
0080   BE           ST1:      CP   (HL)   
0081   23                     INC   HL   
0082   20 FC                  JR   NZ,st1   
0084                          ENDIF      
0084                          IF   1-EDITOR   
0084   22 7C 82     ST2:      LD   (HEAP),HL   
0087                          ENDIF      
0087                          IF   CHECKED*(1-EDITOR)   
0087   E7                     RST   20h   ; minus the heap"s first address: "_' may not
0088   22 38 82               LD   (NPEND),HL   ;   release below it
008B                          ENDIF      
008B                          IF   (1-CHECKED)*(1-EDITOR)*(1-CPM)   
                              LD   H,A   ; (A = 0) no key is held, and the break key
                              LD   L,A   ;   is on (the checked build has cleared
008B                          ENDIF      ;   these)
008B                          IF   (1-CHECKED)*(1-EDITOR)*CPM   
                              LD   HL,0   
008B                          ENDIF      
008B                          IF   (1-CHECKED)*(1-EDITOR)   
                              LD   (KEYBUF),HL   
008B                          ENDIF      
008B                          IF   1-EDITOR   
008B   D9                     EXX      
008C   21 E0 80               LD   HL,RSTOP   ; the return stack is empty
008F   D9                     EXX      
0090   F7                     RST   30h   ; (its return address is thrown away)
0091                          ENDIF      
0091                             ; In the unchecked generic editor build the table is here, in the first
0091                             ; page, which saves loading D twice. (The other builds have no room for it
0091                             ; here: theirs is further down.)
0091                          IF   TABP0   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0091                          ENDIF      
0091                             ; =============================================================================
0091                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
0091                             ;  (00bbIGFuZCA= are up among the RST routines.) The machine-code call, exec,
0091                             ;  is here too: it belongs to "`" and makes the page come out right.
0091                             ; =============================================================================
0091   D1           H_XOR:    POP   DE   
0092   7C                     LD   A,H   
0093   AA                     XOR   D   
0094   67                     LD   H,A   
0095   7D                     LD   A,L   
0096   AB                     XOR   E   
0097   6F                     LD   L,A   
0098   F7                     RST   30h   
0099   D1           H_OR:     POP   DE   
009A   7C                     LD   A,H   
009B   B2                     OR   D   
009C   67                     LD   H,A   
009D   7D                     LD   A,L   
009E   B3                     OR   E   
009F   6F                     LD   L,A   
00A0   F7                     RST   30h   
00A1   E7           H_NOT:    RST   20h   ; ~x = -x - 1
00A2   2B                     DEC   HL   
00A3   F7                     RST   30h   
00A4                             ; "_" ( n -- addr ): the heap pointer moves by n, a signed count (the add is
00A4                             ; the same either way); TOS is the old pointer.
00A4   ED 5B 7C 82  H_ALLOC:   LD   DE,(HEAP)   
00A8                          IF   CHECKED*CPM   
                              LD   A,H   ; the count's sign, for chkhp
00A8                          ENDIF      
00A8   19                     ADD   HL,DE   ; the new top
00A9                          IF   CHECKED   
00A9   CD 46 04               CALL   chkhp   
00AC                          ENDIF      
00AC   22 7C 82               LD   (HEAP),HL   
00AF   EB                     EX   DE,HL   
00B0   F7                     RST   30h   
00B1   D9           EXEC:     EXX      
00B2   22 34 82               LD   (RSAVE),HL   ; machine code may change the alternates
00B5   D9                     EXX      
00B6   CD 2B 00               CALL   jphl   
00B9   D9                     EXX      
00BA   2A 34 82               LD   HL,(RSAVE)   
00BD   D9                     EXX      
00BE   E1                     POP   HL   
00BF   F7                     RST   30h   
00C0                             ; ---- the letters and digits (here, in the middle, so that the inner loop's
00C0                             ; ---- short jumps reach them, and the handlers after them reach rpushn) ------
00C0                             ; Digits: step back onto the first digit and read the whole number.
00C0   E5           DIGIT:    PUSH   HL   
00C1   0B                     DEC   BC   
00C2   CD 53 02               CALL   rdnum   
00C5   F7                     RST   30h   
00C6                             ; a-z: push the cell's address (the cell is the variable)
00C6   E5           LOWER:    PUSH   HL   
00C7   87                     ADD   A,A   
00C8   6F                     LD   L,A   
00C9   26 82                  LD   H,LETPAGE   
00CB   F7                     RST   30h   
00CC                             ; A-Z: call the word. The return address (the IP after the letter) goes on
00CC                             ; the return stack, and the IP becomes the address in the letter's cell.
00CC   C5           UPPER:    PUSH   BC   ; the return address, for rpushn
00CD   EB                     EX   DE,HL   ; park TOS
00CE   87                     ADD   A,A   
00CF   6F                     LD   L,A   
00D0   26 82                  LD   H,LETPAGE   ; HL -> cell
00D2   4E                     LD   C,(HL)   
00D3   2C                     INC   L   
00D4   46                     LD   B,(HL)   ; IP = the word's body
00D5   EB                     EX   DE,HL   ; TOS back, and fall into rpushn
00D6                             ; rpushn: move the top cell of the data stack (in memory) to the return
00D6                             ; stack, then next. Everything that pushes the return stack ends here.
00D6                             ; 
00D6                             ; The break key is looked at here, so at every word call and loop-back (and
00D6                             ; block entry and "{"), but only one time in 256: B', which nothing else
00D6                             ; uses, counts them. Reading the keyboard can be slow (it is a BDOS call
00D6                             ; under CP/M), and this way it costs a loop four bytes and 14 T-states.
00D6                             ; (DEC B, not DJNZ: its zero flag lasts through the EXX, so one EXX serves
00D6                             ; both ways out.)
00D6   D9           RPUSHN:   EXX      
00D7   D1                     POP   DE   
00D8   2B                     DEC   HL   
00D9   72                     LD   (HL),D   
00DA   2B                     DEC   HL   
00DB   73                     LD   (HL),E   
00DC   05                     DEC   B   
00DD   D9                     EXX      
00DE   CC D2 03               CALL   Z,pollk   
00E1   F7                     RST   30h   
00E2                             ; ---- the grave -------------------------------------------------------------
00E2                             ; The grave is a prefix: with the character after it, it is one command.
00E2                             ; The characters are tested one after another, each SUB taking off the step
00E2                             ; from the one before, so A is 0 (and the carry clear) when a handler is
00E2                             ; reached. Two are here, where they keep the first page as full as the
00E2                             ; layout needs; grave2 has the rest.
00E2                             ; 
00E2                             ;   `!  ( addr -- )  calls the machine code at TOS. The code is entered by
00E2                             ;       CALL with the data stack above the return address; it must keep BC,
00E2                             ;       and on return the top cell becomes the new TOS.
00E2                             ;   `'  ( -- )  new line: CR LF
00E2   0A           H_GRAVE:   LD   A,(BC)   
00E3   03                     INC   BC   
00E4   D6 21                  SUB   "!"   
00E6   28 C9                  JR   Z,exec   
00E8   D6 06                  SUB   27h-"!"   ; "'"
00EA   C2 06 03               JP   NZ,grave2   
00ED   3E 0D                  LD   A,13   
00EF   EF                     RST   28h   
00F0   3E 0A                  LD   A,10   
00F2   EF                     RST   28h   
00F3   F7                     RST   30h   
00F4                             ; ---- where the two pages meet ----------------------------------------------
00F4                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
00F4                             ; are in falling code order for this), and where exactly differs between the
00F4                             ; builds: NPG1 follows. Every handler below these four must start in the
00F4                             ; second page, and every one above in the first; chktab.py checks both.
00F4                             ; "]" returns: pop an address and jump to it.
00F4   CF           H_RET:    RST   08h   
00F5   42                     LD   B,D   
00F6   4B                     LD   C,E   
00F7   F7           BRK1:     RST   30h   
00F8                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
00F8                             ; drops the block start, "]" returns. No closer at all ends the program.
00F8   7C           H_BREAK:   LD   A,H   
00F9   B5                     OR   L   
00FA   E1                     POP   HL   
00FB   28 FA                  JR   Z,brk1   
00FD   CD 7A 02               CALL   skip   
0100   B7                     OR   A   ; skip returns 0 for ")"
0101   20 F1                  JR   NZ,h_ret   
0103   CF           RDROP:    RST   08h   
0104   F7                     RST   30h   
0105                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
0105                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
0105                             ; the body"s address instead. Either way it then skips to the matching "]'.
0105                             ; (The unchecked build takes anything that is not a letter as the space; the
0105                             ; checked build stops on it.)
0105   0A           H_DEF:    LD   A,(BC)   
0106   03                     INC   BC   
0107   D6 41                  SUB   "A"   ; a letter gives 0-25 or 32-57: lowercase
0109   5F                     LD   E,A   ;   lands 64 bytes up
010A   E6 DF                  AND   0DFh   ; fold case
010C   FE 1A                  CP   26   
010E   30 0B                  JR   NC,def2   ; not a letter
0110   CB 23                  SLA   E   
0112   16 82                  LD   D,LETPAGE   ; DE -> cell
0114   79                     LD   A,C   
0115   12                     LD   (DE),A   
0116   1C                     INC   E   
0117   78                     LD   A,B   
0118   12                     LD   (DE),A   
0119   18 09                  JR   skipnx   
011B                DEF2:        
011B                          IF   CHECKED   
011B   7B                     LD   A,E   
011C   FE DF                  CP   " "-"A"+256   
011E   C2 78 04               JP   NZ,e_brack   ; anything but a letter or a space
0121                          ENDIF      
0121   E5                     PUSH   HL   ; an anonymous block: push its address
0122   60                     LD   H,B   
0123   69                     LD   L,C   
0124                SKIPNX:      
0124                          IF   CHECKED   
0124   0B                     DEC   BC   ; back onto the letter, so that skip finds its
0125                          ENDIF      ;   opener, the "[", just before where it starts
0125   CD 7A 02     SKIPO:    CALL   skip   
0128   F7                     RST   30h   
0129   5E           H_FETCH:   LD   E,(HL)   ; "@"
012A   23                     INC   HL   
012B   56                     LD   D,(HL)   
012C   EB                     EX   DE,HL   
012D   F7                     RST   30h   
012E                             ; =============================================================================
012E                             ;  Handlers that must start in the image's second page.
012E                             ;  "?" is the last (with "," inside it), so its long tail may run past that
012E                             ;  page.
012E                             ; =============================================================================
012E                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
012E                             ; the matching ")".
012E   7C           H_OPEN:   LD   A,H   
012F   B5                     OR   L   
0130   E1                     POP   HL   
0131   28 F2                  JR   Z,skipo   
0133   C5                     PUSH   BC   ; the block starts at the IP
0134   18 A0                  JR   rpushn   
0136                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
0136                             ; drops it and carries on.
0136   7C           H_CLOSE:   LD   A,H   
0137   B5                     OR   L   
0138   E1                     POP   HL   
0139   28 C8                  JR   Z,rdrop   
013B   CF                     RST   08h   ; pop the block start ...
013C   42                     LD   B,D   
013D   4B                     LD   C,E   
013E   C5                     PUSH   BC   
013F   18 95                  JR   rpushn   ; ... and push it back
0141                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
0141                             ; "-" has two jobs: directly before a digit it starts a negative number.
0141   0A           H_SUB:    LD   A,(BC)   
0142   D6 30                  SUB   "0"   
0144   FE 0A                  CP   10   
0146   38 04                  JR   C,negnum   
0148   E7                     RST   20h   ; a - b = a + (-b): fall into "+"
0149   D1           H_ADD:    POP   DE   
014A   19                     ADD   HL,DE   
014B   F7                     RST   30h   
014C   E5           NEGNUM:   PUSH   HL   ; a negative number: read it, negate it
014D   CD 53 02               CALL   rdnum   
0150   E7                     RST   20h   
0151   F7                     RST   30h   
0152   D1           H_AND:    POP   DE   
0153   7C                     LD   A,H   
0154   A2                     AND   D   
0155   67                     LD   H,A   
0156   7D                     LD   A,L   
0157   A3                     AND   E   
0158   6F                     LD   L,A   
0159   F7                     RST   30h   
015A                             ; Signed compares. Both are "HL < DE" for the right pair: "<" swaps the two
015A                             ; cells first. Flipping both sign bits turns a signed compare into an
015A                             ; unsigned one (and XOR clears the carry for SBC); SBC HL,HL then turns the
015A                             ; carry into -1 or 0 with no branch.
015A   E3           H_LT:     EX   (SP),HL   ; a < b: HL = a, and b is popped next
015B   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
015C   7C                     LD   A,H   
015D   EE 80                  XOR   80h   
015F   67                     LD   H,A   
0160   7A                     LD   A,D   
0161   EE 80                  XOR   80h   
0163   57                     LD   D,A   
0164   ED 52                  SBC   HL,DE   ; carry if HL < DE
0166   ED 62        TF:       SBC   HL,HL   ; carry -> -1 or 0
0168   F7                     RST   30h   
0169   D1           H_EQ:     POP   DE   
016A   B7                     OR   A   
016B   ED 52                  SBC   HL,DE   
016D   7C                     LD   A,H   
016E   B5                     OR   L   
016F   FE 01                  CP   1   ; carry only if a - b = 0
0171   18 F3                  JR   tf   
0173                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept. The
0173                             ; multiplier shifts up through A:C.
0173   D1           H_MUL:    POP   DE   ; DE = multiplicand
0174   C5                     PUSH   BC   
0175   7C                     LD   A,H   
0176   4D                     LD   C,L   ; A:C = multiplier
0177   21 00 00               LD   HL,0   
017A   06 10                  LD   B,16   
017C   29           MUL1:     ADD   HL,HL   
017D   CB 21                  SLA   C   
017F   17                     RLA      
0180   30 01                  JR   NC,mul2   
0182   19                     ADD   HL,DE   
0183   10 F7        MUL2:     DJNZ   mul1   
0185   C1                     POP   BC   
0186   F7                     RST   30h   
0187                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
0187                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
0187                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
0187                             ; stops on it.
0187                H_DIV:       
0187                          IF   CHECKED   
0187   7C                     LD   A,H   
0188   B5                     OR   L   
0189   CA 75 04               JP   Z,e_zero   
018C                          ENDIF      
018C   D1                     POP   DE   ; DE = a, HL = b
018D   C5                     PUSH   BC   ; free BC for udiv
018E   D5                     PUSH   DE   ; a, for r's sign
018F   7A                     LD   A,D   
0190   AC                     XOR   H   
0191   F5                     PUSH   AF   ; S flag = sign of q
0192   CB 7C                  BIT   7,H   
0194   C4 20 00               CALL   NZ,neg16   ; HL = |b|
0197   EB                     EX   DE,HL   
0198   CB 7C                  BIT   7,H   
019A   C4 20 00               CALL   NZ,neg16   ; HL = |a|, DE = |b|
019D   CD 2D 02               CALL   udiv   ; HL = q, DE = r
01A0   F1                     POP   AF   
01A1   FC 20 00               CALL   M,neg16   ; q's sign
01A4   EB                     EX   DE,HL   ; HL = r, DE = q
01A5   F1                     POP   AF   ; A = a's high byte
01A6   B7                     OR   A   
01A7   FC 20 00               CALL   M,neg16   ; r's sign
01AA   C1                     POP   BC   
01AB   D5                     PUSH   DE   ; q under r
01AC   F7                     RST   30h   
01AD                             ; ---- stack and storage -----------------------------------------------------
01AD   E5           H_DUP:    PUSH   HL   ; ":"
01AE   F7                     RST   30h   
01AF   E3           H_SWAP:   EX   (SP),HL   ; "%"
01B0   F7                     RST   30h   
01B1                             ; (The checked build tests the address before it takes the value off the
01B1                             ; stack, so that an error report shows both.)
01B1                H_CSTORE:      ; "." ( c addr -- )
01B1                          IF   CHECKED   
01B1   CD 5B 04               CALL   chkst   
01B4                          ENDIF      
01B4   D1                     POP   DE   
01B5   73                     LD   (HL),E   
01B6   DF           H_DROP:   RST   18h   ; ";" is this one byte
01B7                H_STORE:      ; "!" ( n addr -- )
01B7                          IF   CHECKED   
01B7   CD 5B 04               CALL   chkst   
01BA                          ENDIF      
01BA   D1                     POP   DE   
01BB   73                     LD   (HL),E   
01BC   23                     INC   HL   
01BD   72                     LD   (HL),D   
01BE   DF                     RST   18h   
01BF                             ; ---- console ---------------------------------------------------------------
01BF                             ; 22h pushes the address of the text after it and skips the string.
01BF   E5           H_STR:    PUSH   HL   
01C0   60                     LD   H,B   
01C1   69                     LD   L,C   
01C2   CD 69 02               CALL   skipstr   
01C5                          IF   CHECKED   
01C5   B7                     OR   A   ; 0: the text ran out before the closing quote
01C6   CA 6D 04               JP   Z,e_quote   
01C9                          ENDIF      
01C9   F7                     RST   30h   
01CA                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character
01CA                             ; clears that character"s bit 6 (/M is CR, /` is space; "/" and ""' have no
01CA                             ; bit 6, so // and /" give themselves).
01CA                          IF   (1-CHECKED)*(1-EDITOR)   
                    H_PRINT:   LD   A,(HL)   
                              INC   HL   
                              CP   22h   
                              JR   Z,pr9   
                              CP   "/"   
                              JR   NZ,pr1   
                              LD   A,(HL)   
                              INC   HL   
                              AND   0BFh   
                    PR1:      RST   28h   
                              JR   h_print   
01CA                          ENDIF      
01CA                          IF   CHECKED   
01CA                             ; (The checked build has the loop as a routine, prstr, which the error
01CA                             ; report uses too. The address is kept on the stack meanwhile: a report
01CA                             ; shows the stack as it was before the "$".)
01CA   E5           H_PRINT:   PUSH   HL   
01CB   CD 39 05               CALL   prstr   
01CE   D1                     POP   DE   
01CF   DF                     RST   18h   
01D0                          ENDIF      
01D0                          IF   (1-CHECKED)*EDITOR   
                                 ; (With the editor the loop is a routine, prstr, which ^V uses too.)
                    H_PRINT:   CALL   prstr   
                              RST   18h   
01D0                          ENDIF      
01D0   7D           H_EMIT:   LD   A,L   ; "'"
01D1   EF                     RST   28h   
01D2   DF           PR9:      RST   18h   
01D3                             ; "#" prints TOS as a signed decimal number, with no space after it.
01D3   C5           H_NUM:    PUSH   BC   
01D4   CD B7 02               CALL   psgn   
01D7   C1                     POP   BC   
01D8   DF                     RST   18h   
01D9                             ; "?" ( n -- c ) or ( -n -- addr )
01D9                             ;   n > 0: wait about n ms for a key; 0 if none came
01D9                             ;   n = 0: wait for a key
01D9                             ;          (both stir the random seed while they wait: see kt2)
01D9                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
01D9                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
01D9   CB 7C        H_KEY:    BIT   7,H   
01DB   20 22                  JR   NZ,line   
01DD   1E 28        KT1:      LD   E,MSLOOP   ; one millisecond, roughly
01DF   CD 00 04     KT2:      CALL   getk   
01E2   20 17                  JR   NZ,kt3   
01E4   1D                     DEC   E   
01E5   20 F8                  JR   NZ,kt2   
01E7   EB                     EX   DE,HL   ; a millisecond with no key stirs the random
01E8   2A 76 82               LD   HL,(SEED)   ;   seed by one: how long a key takes to come
01EB   23                     INC   HL   ;   is the one thing here that is not the
01EC   22 76 82               LD   (SEED),HL   ;   same every time
01EF   EB                     EX   DE,HL   
01F0   7C                     LD   A,H   ; 0? never counts down: it waits
01F1   B5                     OR   L   
01F2   28 E9                  JR   Z,kt1   
01F4   2B                     DEC   HL   
01F5   7C                     LD   A,H   
01F6   B5                     OR   L   
01F7   20 E4                  JR   NZ,kt1   ; A = 0 if the time ran out
01F9   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
01FA   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
01FB   6F           KT3:      LD   L,A   
01FC   26 00                  LD   H,0   
01FE   F7                     RST   30h   
01FF                          IF   CPM   
                                 ; CP/M: BDOS 10 does the editing (the spec allows the platform's
                                 ; own line editor). It doesn't store the CR, so it is added here.
                    LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
                              ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
                              SBC   A,A   
                              AND   L   ; (0 for a count that is too big)
                              XOR   127   ; A = the count, 127 at most
                              LD   (LBHDR),A   
                              LD   DE,LBHDR   
                              LD   A,10   
                              CALL   bdosx   
                              LD   HL,LBHDR+1   
                              LD   A,(HL)   ; the count typed (0-127)
                              INC   L   ; HL = LINEBUF, whose low byte is 80h:
                              ADD   A,L   ;   adding the count to L can't carry
                              LD   L,A   
                              LD   (HL),13   
01FF                          ENDIF      
01FF                          IFN   CPM   
01FF                             ; Generic: Backspace takes the last character back (and is echoed as
01FF                             ; it is), CR ends (stored, not echoed), every other key is stored and
01FF                             ; echoed until the line is full. The line buffer starts at offset 80h
01FF                             ; of its page, so L alone is the place in the line: D holds the L of
01FF                             ; a full line.
01FF   11 7F 00     LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
0202   19                     ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
0203   9F                     SBC   A,A   
0204   A5                     AND   L   ; (0 for a count that is too big)
0205   2F                     CPL      
0206   57                     LD   D,A   ; D = the L of a full line: 80h + count, FFh
0207                             ;   at most
0207   21 80 82               LD   HL,LINEBUF   
020A   CD 00 04     LN2:      CALL   getk   
020D   28 FB                  JR   Z,ln2   
020F   FE 0D                  CP   13   
0211   28 16                  JR   Z,ln5   
0213   FE 08                  CP   8   
0215   28 0B                  JR   Z,ln4   
0217   5F                     LD   E,A   
0218   7D                     LD   A,L   
0219   BA                     CP   D   
021A   28 EE                  JR   Z,ln2   ; full
021C   73                     LD   (HL),E   
021D   2C                     INC   L   
021E   7B                     LD   A,E   
021F   EF           LN3:      RST   28h   
0220   18 E8                  JR   ln2   
0222   2D           LN4:      DEC   L   ; Backspace: one back, and echo it,
0223   FA 1F 02               JP   M,ln3   ;   unless the line was empty (L left the
0226   2C                     INC   L   ;   upper half of the page)
0227   18 E1                  JR   ln2   
0229   77           LN5:      LD   (HL),A   ; the CR
022A                          ENDIF      
022A   2E 80                  LD   L,LINEBUF & 0FFh   
022C   F7                     RST   30h   
022D                             ; =============================================================================
022D                             ;  More routines (no handler starts past this point)
022D                             ; =============================================================================
022D                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
022D                             ; Uses A, BC; the caller saves the IP. The dividend shifts up through A:C
022D                             ; while the quotient bits arrive at the bottom of C.
022D                             ; Dividing by 2 is one shift (the spec wants that fast).
022D   7B           UDIV:     LD   A,E   
022E   EE 02                  XOR   2   
0230   B2                     OR   D   
0231   20 07                  JR   NZ,udv0   
0233   CB 3C                  SRL   H   
0235   CB 1D                  RR   L   ; the quotient
0237   8F                     ADC   A,A   
0238   5F                     LD   E,A   ; the remainder: the bit that fell out (D is 0)
0239   C9                     RET      
023A   7C           UDV0:     LD   A,H   
023B   4D                     LD   C,L   
023C   21 00 00               LD   HL,0   
023F   06 10                  LD   B,16   
0241   CB 21        UDV1:     SLA   C   
0243   17                     RLA      
0244   ED 6A                  ADC   HL,HL   
0246   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
0248   30 02                  JR   NC,udv2   ;   always fits in 16 bits
024A   19                     ADD   HL,DE   ; too much: put it back, and cancel the
024B   0D                     DEC   C   ;   INC below
024C   0C           UDV2:     INC   C   ; a quotient bit
024D   10 F2                  DJNZ   udv1   
024F   EB                     EX   DE,HL   ; DE = remainder
0250   67                     LD   H,A   
0251   69                     LD   L,C   ; HL = quotient
0252   C9                     RET      
0253                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
0253                             ; non-digit. Values wrap at 16 bits, as the spec says.
0253   21 00 00     RDNUM:    LD   HL,0   
0256   0A           RDN1:     LD   A,(BC)   
0257   D6 30                  SUB   "0"   
0259   FE 0A                  CP   10   
025B   D0                     RET   NC   
025C   03                     INC   BC   
025D   54                     LD   D,H   
025E   5D                     LD   E,L   
025F   29                     ADD   HL,HL   
0260   29                     ADD   HL,HL   
0261   19                     ADD   HL,DE   
0262   29                     ADD   HL,HL   ; HL * 10
0263   5F                     LD   E,A   
0264   16 00                  LD   D,0   
0266   19                     ADD   HL,DE   
0267   18 ED                  JR   rdn1   
0269                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
0269                             ; the next character, so "/"" does not end it. Leaves A = 22h.
0269                          IF   1-CHECKED   
                    SS0:      INC   BC   
                    SKIPSTR:   LD   A,(BC)   
                              INC   BC   
                              CP   "/"   
                              JR   Z,ss0   
                              CP   22h   
                              JR   NZ,skipstr   
                              RET      
0269                          ENDIF      
0269                          IF   CHECKED   
0269                             ; The checked build never steps over a NUL: if the text runs out first it
0269                             ; returns A = 0 with the IP on the NUL.
0269   0A           SKIPSTR:   LD   A,(BC)   
026A   B7                     OR   A   
026B   C8                     RET   Z   
026C   03                     INC   BC   
026D   FE 22                  CP   22h   
026F   C8                     RET   Z   
0270   FE 2F                  CP   "/"   
0272   20 F5                  JR   NZ,skipstr   
0274   0A                     LD   A,(BC)   ; the escaped character
0275   B7                     OR   A   
0276   C8                     RET   Z   
0277   03                     INC   BC   
0278   18 EF                  JR   skipstr   
027A                          ENDIF      
027A                             ; skip: read past text to the closer at this level, and return A = 0 if it
027A                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
027A                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
027A                             ; no closer; anything else that runs into the NUL had unbalanced brackets
027A                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
027A                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
027A                             ; 
027A                             ; The checked build also looks at the character the skip was started by,
027A                             ; which is always the one just before where it starts: "(" must end at ")",
027A                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
027A                             ; quote counts as running into it. "\" takes either closer. IX keeps the
027A                             ; place where the skip started, for the report.
027A                SKIP:        
027A                          IF   CHECKED   
027A   C5                     PUSH   BC   
027B   DD E1                  POP   IX   
027D   0B                     DEC   BC   
027E   0A                     LD   A,(BC)   
027F   03                     INC   BC   
0280   5F                     LD   E,A   ; E = the opener: ( [ or \
0281                          ENDIF      
0281   16 00                  LD   D,0   
0283   14           SK3:      INC   D   ; an opener: one deeper
0284   0A           SK1:      LD   A,(BC)   
0285                          IF   1-CHECKED   
                              INC   BC   
                              OR   A   
                              JP   Z,SKEND   ; (the end of the program)
0285                          ENDIF      
0285                          IF   CHECKED   
0285   B7                     OR   A   
0286   28 22                  JR   Z,sk6   ; (the IP stays on the NUL)
0288   03                     INC   BC   
0289                          ENDIF      
0289   FE 22                  CP   22h   
028B   CC 69 02               CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
028E   D6 28                  SUB   "("   ;   (or 0, and then the NUL is read next)
0290   28 F1                  JR   Z,sk3   
0292   3D                     DEC   A   ; ")"
0293   28 08                  JR   Z,sk4   
0295   D6 32                  SUB   "["-")"   
0297   28 EA                  JR   Z,sk3   
0299   FE 02                  CP   "]"-"["   
029B   20 E7                  JR   NZ,sk1   
029D   15           SK4:      DEC   D   
029E                          IF   1-CHECKED   
                              RET   Z   ; the closer at this level
                              JR   sk1   
029E                          ENDIF      
029E                          IF   CHECKED   
029E   20 E4                  JR   NZ,sk1   
02A0   57                     LD   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
02A1   AB                     XOR   E   ;   opener is 0 for "(" and 1 for "[", and only
02A2   E6 06                  AND   6   ;   "\" has bit 2: so this is 2 for the wrong
02A4   FE 02                  CP   2   ;   closer, and only then
02A6   7A                     LD   A,D   
02A7   C0                     RET   NZ   
02A8   18 05                  JR   sk7   
02AA   CB 53        SK6:      BIT   2,E   ; the text ran out:
02AC   C2 09 FF               JP   NZ,SKEND   ;   "\" with no closer ends the program
02AF   DD E5        SK7:      PUSH   IX   ; N. The place is the opener
02B1   C1                     POP   BC   
02B2   3E 4E                  LD   A,"N"   
02B4   C3 6A 04               JP   errp   ; (errp drops skip's return address)
02B7                          ENDIF      
02B7                             ; psgn: print HL as a signed number. Uses BC.
02B7   CB 7C        PSGN:     BIT   7,H   
02B9   28 04                  JR   Z,pdec   
02BB   3E 2D                  LD   A,"-"   
02BD   EF                     RST   28h   
02BE   E7                     RST   20h   
02BF                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
02BF                             ; Uses BC.
02BF   11 0A 00     PDEC:     LD   DE,10   
02C2   CD 2D 02               CALL   udiv   ; HL = HL / 10, E = the last digit
02C5   7B                     LD   A,E   
02C6   F5                     PUSH   AF   
02C7   7C                     LD   A,H   
02C8   B5                     OR   L   
02C9   C4 BF 02               CALL   NZ,pdec   
02CC   F1                     POP   AF   
02CD   C6 30                  ADD   A,"0"   
02CF   EF                     RST   28h   
02D0   C9                     RET      
02D1                             ; =============================================================================
02D1                             ;  The grave's other codes. h_grave comes here with A = the character minus
02D1                             ;  27h, not zero; the tests carry on from there.
02D1                             ; 
02D1                             ;    `$  ( addr -- addr' )  the hex loader: pairs of hex digits are stored
02D1                             ;        from addr until a non-hex character; then a RET (C9h) is written
02D1                             ;        and its address is left. An odd last digit is consumed and dropped.
02D1                             ;    `+  ( addr -- n )   add 1 to the cell at addr and leave its new value
02D1                             ;    `,  ( n -- r )      a random number from 0 to n-1 (n is 1 to 32767)
02D1                             ;    `-  ( addr -- n )   subtract 1 from the cell at addr, the same way
02D1                             ;    `.  ( -- addr )     the address of the random seed
02D1                             ;    `<  ( a b -- n )    the smaller of the two (signed)
02D1                             ;    `>  ( a b -- n )    the larger
02D1                             ;    `?  ( flag -- )     the cursor off (0) or on
02D1                             ;    `@  ( row col -- )  the cursor to that row and column, both from 0
02D1                             ;    `^  ( -- )          clear the screen and home the cursor
02D1                             ;    `_  ( -- )          clear from the cursor to the end of the line
02D1                             ; 
02D1                             ;  Any other character is unsafe: the unchecked build takes it as "_", the
02D1                             ;  checked build stops with W.
02D1                             ; =============================================================================
02D1                             ; (The console codes are here, before the tests, to be in reach of them.)
02D1                          IF   ANSI   
02D1                             ; `? ( flag -- ): ESC [ ? 2 5 l hides the cursor, ESC [ ? 2 5 h shows it.
02D1   CD FF 02     G_CUR:    CALL   csi   
02D4   3E 3F                  LD   A,"?"   
02D6   EF                     RST   28h   
02D7   3E 32                  LD   A,"2"   
02D9   EF                     RST   28h   
02DA   3E 35                  LD   A,"5"   
02DC   EF                     RST   28h   
02DD   7C                     LD   A,H   
02DE   B5                     OR   L   
02DF   3E 6C                  LD   A,"l"   
02E1   28 02                  JR   Z,gc1   
02E3   3E 68                  LD   A,"h"   
02E5   EF           GC1:      RST   28h   
02E6   DF                     RST   18h   
02E7                             ; `@ ( row col -- ): ESC [ row+1 ; col+1 H. (ANSI counts from 1.)
02E7   D1           G_AT:     POP   DE   ; DE = the row
02E8   C5                     PUSH   BC   ; (pdec uses BC)
02E9   E5                     PUSH   HL   ; the column
02EA   EB                     EX   DE,HL   
02EB   CD FF 02               CALL   csi   
02EE   23                     INC   HL   
02EF   CD BF 02               CALL   pdec   
02F2   3E 3B                  LD   A,";"   
02F4   EF                     RST   28h   
02F5   E1                     POP   HL   
02F6   23                     INC   HL   
02F7   CD BF 02               CALL   pdec   
02FA   3E 48                  LD   A,"H"   
02FC   EF                     RST   28h   
02FD   C1                     POP   BC   
02FE   DF                     RST   18h   
02FF                             ; csi: print ESC [, which starts every ANSI sequence. Keeps all but A.
02FF   3E 1B        CSI:      LD   A,27   
0301   EF                     RST   28h   
0302   3E 5B                  LD   A,"["   
0304   EF                     RST   28h   
0305   C9                     RET      
0306                          ENDIF      
0306                          IF   1-ANSI   
                                 ; With ANSI = 0 the machine's own routines do the work (see the equates).
                    G_CUR:    LD   A,H   
                              OR   L   
                              CALL   CONCUR   
                              RST   18h   
                    G_AT:     POP   DE   ; DE = the row, HL = the column
                              CALL   CONAT   
                              RST   18h   
0306                          ENDIF      
0306   C6 03        GRAVE2:   ADD   A,27h-"$"   ; "$"
0308   20 13                  JR   NZ,gv1   
030A   CD C0 03     HX1:      CALL   hexc   
030D   30 0B                  JR   NC,hx2   
030F   77                     LD   (HL),A   ; the high digit goes in first ...
0310   CD C0 03               CALL   hexc   
0313   30 05                  JR   NC,hx2   ; odd digit: consumed, and the RET below
0315   ED 6F                  RLD      ;   overwrites it
0317   23                     INC   HL   ; ... and RLD shifts it up under the low one
0318   18 F0                  JR   hx1   
031A   36 C9        HX2:      LD   (HL),0C9h   ; (never range-checked: the spec says so)
031C   F7                     RST   30h   
031D   D6 07        GV1:      SUB   "+"-"$"   
031F   28 31                  JR   Z,g_inc   
0321   3D                     DEC   A   ; ","
0322   28 48                  JR   Z,g_rnd   
0324   3D                     DEC   A   ; "-"
0325   28 2B                  JR   Z,g_dec   
0327   3D                     DEC   A   ; "."
0328   28 3D                  JR   Z,g_seed   
032A   D6 0E                  SUB   "<"-"."   
032C   28 60                  JR   Z,g_min   
032E   D6 02                  SUB   ">"-"<"   
0330   28 5B                  JR   Z,g_max   
0332   3D                     DEC   A   ; "?"
0333   28 9C                  JR   Z,g_cur   
0335   3D                     DEC   A   ; "@"
0336   28 AF                  JR   Z,g_at   
0338   D6 1E                  SUB   "^"-"@"   ; "^" leaves 0 and "_" leaves 1
033A                          IF   CHECKED   
033A   FE 02                  CP   2   
033C   D2 78 04               JP   NC,e_brack   ; anything else: W. The place is the character
033F   B7                     OR   A   
0340                          ENDIF      
0340                          IF   ANSI   
0340   20 07                  JR   NZ,ge1   
0342   CD FF 02               CALL   csi   ; "^": ESC [ H homes the cursor, and then
0345   3E 48                  LD   A,"H"   ;   ESC [ J clears from there to the end of
0347   EF                     RST   28h   ;   the screen
0348   AF                     XOR   A   
0349   C6 4A        GE1:      ADD   A,"J"   ; "_": ESC [ K clears to the end of the line
034B   5F                     LD   E,A   
034C   CD FF 02               CALL   csi   
034F   7B                     LD   A,E   
0350   EF                     RST   28h   
0351   F7                     RST   30h   
0352                          ENDIF      
0352                          IF   1-ANSI   
                              JR   NZ,ge1   
                              CALL   CONCLS   
                              RST   30h   
                    GE1:      CALL   CONEOL   
                              RST   30h   
0352                          ENDIF      
0352                             ; `+ and `-. The carry says which: set to add.
0352                          IF   1-CHECKED   
                    G_DEC:    DB   3Eh   ; (LD A,n: steps over the SCF, and "-" comes
                    G_INC:    SCF      ;   here with the carry clear)
0352                          ENDIF      
0352                          IF   CHECKED   
0352                             ; (The checked build tests the address first, as "!" does, and then looks at
0352                             ; the character again: the test has used the flags.)
0352                G_INC:       
0352   CD 5B 04     G_DEC:    CALL   chkst   
0355   0B                     DEC   BC   
0356   0A                     LD   A,(BC)   
0357   03                     INC   BC   
0358   FE 2C                  CP   ","   ; carry for "+"
035A                          ENDIF      
035A   5E                     LD   E,(HL)   
035B   23                     INC   HL   
035C   56                     LD   D,(HL)   
035D   30 02                  JR   NC,gi1   
035F   13                     INC   DE   
0360   13                     INC   DE   
0361   1B           GI1:      DEC   DE   
0362   72                     LD   (HL),D   
0363   2B                     DEC   HL   
0364   73                     LD   (HL),E   
0365   EB                     EX   DE,HL   ; the new value is TOS
0366   F7                     RST   30h   
0367                             ; `. pushes the address of the random seed.
0367   E5           G_SEED:   PUSH   HL   
0368   21 76 82               LD   HL,SEED   
036B   F7                     RST   30h   
036C                             ; `, ( n -- r ). The seed goes one step on: seed * 261 + 1, which takes
036C                             ; every 16-bit value in turn. The high bits of such a seed are the good ones
036C                             ; and the low ones repeat soon, so the high byte is folded into the low
036C                             ; (XOR) before the remainder of dividing by n is taken.
036C                             ; n must be 1 to 32767: the checked build stops with Z on anything less
036C                             ; than 1.
036C                G_RND:       
036C                          IF   CHECKED   
036C   2B                     DEC   HL   
036D   CB 7C                  BIT   7,H   ; n - 1 negative: n is 0 or less
036F   23                     INC   HL   
0370   C2 75 04               JP   NZ,e_zero   
0373                          ENDIF      
0373   EB                     EX   DE,HL   ; DE = n
0374   C5                     PUSH   BC   
0375   2A 76 82               LD   HL,(SEED)   
0378   44                     LD   B,H   
0379   4D                     LD   C,L   
037A   29                     ADD   HL,HL   
037B   29                     ADD   HL,HL   
037C   09                     ADD   HL,BC   ; * 5
037D   7C                     LD   A,H   
037E   81                     ADD   A,C   
037F   67                     LD   H,A   ; + * 256: * 261
0380   23                     INC   HL   
0381   22 76 82               LD   (SEED),HL   
0384   7C                     LD   A,H   
0385   AD                     XOR   L   
0386   6F                     LD   L,A   
0387   CD 2D 02               CALL   udiv   ; DE = the remainder
038A   EB                     EX   DE,HL   
038B   C1                     POP   BC   
038C   F7                     RST   30h   
038D                             ; `< and `>. The carry says which: set for the larger. The two are put in
038D                             ; order, HL the smaller and DE the larger, and then swapped for ">".
038D                             ; b < a (signed) is the borrow of b - a, turned round if the two signs
038D                             ; differ: RRA puts the borrow in bit 7, where the two XORs meet it.
038D   37           G_MAX:    SCF      ; ("<" comes in with the carry clear)
038E   D1           G_MIN:    POP   DE   ; DE = a, HL = b
038F   F5                     PUSH   AF   
0390   7D                     LD   A,L   
0391   93                     SUB   E   
0392   7C                     LD   A,H   
0393   9A                     SBC   A,D   
0394   1F                     RRA      
0395   AC                     XOR   H   
0396   AA                     XOR   D   
0397   17                     RLA      ; carry: b < a
0398   38 01                  JR   C,gm2   
039A   EB                     EX   DE,HL   
039B   F1           GM2:      POP   AF   
039C   30 01                  JR   NC,gm3   
039E   EB                     EX   DE,HL   
039F   F7           GM3:      RST   30h   
03A0                             ; =============================================================================
03A0                             ;  Dispatch table: the low byte of each handler's address, in code order
03A0                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
03A0                             ;  It must not cross a page (the dispatcher only adds to its low byte).
03A0                             ; =============================================================================
03A0                             ; The handlers of the first NPG1 characters start in the image's second page.
03A0                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
03A0                             ; differs between the builds, so the count is worked out here.
03A0                             ; (One division to a line: asm80 only rounds down when it stores a value.)
03A0                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
03A0                PGBRK:    EQU   (h_break-BASE)/256   
03A0                PGDEF:    EQU   (h_def-BASE)/256   
03A0                PGFET:    EQU   (h_fetch-BASE)/256   
03A0                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
03A0                          IF   1-TABP0   
03A0                PTAB:        
03A0                          ;*Macro unroll:  PTABLE
03A0   B7                     DB   h_store & 0FFh   
03A1   BF                     DB   h_str & 0FFh   
03A2   D3                     DB   h_num & 0FFh   
03A3   CA                     DB   h_print & 0FFh   
03A4   AF                     DB   h_swap & 0FFh   
03A5   52                     DB   h_and & 0FFh   
03A6   D0                     DB   h_emit & 0FFh   
03A7   2E                     DB   h_open & 0FFh   
03A8   36                     DB   h_close & 0FFh   
03A9   73                     DB   h_mul & 0FFh   
03AA   49                     DB   h_add & 0FFh   
03AB   FA                     DB   h_cfetch & 0FFh   
03AC   41                     DB   h_sub & 0FFh   
03AD   B1                     DB   h_cstore & 0FFh   
03AE   87                     DB   h_div & 0FFh   
03AF   AD                     DB   h_dup & 0FFh   
03B0   B6                     DB   h_drop & 0FFh   
03B1   5A                     DB   h_lt & 0FFh   
03B2   69                     DB   h_eq & 0FFh   
03B3   5B                     DB   h_gt & 0FFh   
03B4   D9                     DB   h_key & 0FFh   
03B5   29                     DB   h_fetch & 0FFh   
03B6   05                     DB   h_def & 0FFh   
03B7   F8                     DB   h_break & 0FFh   
03B8   F4                     DB   h_ret & 0FFh   
03B9   91                     DB   h_xor & 0FFh   
03BA   A4                     DB   h_alloc & 0FFh   
03BB   E2                     DB   h_grave & 0FFh   
03BC   2C                     DB   h_tor & 0FFh   
03BD   99                     DB   h_or & 0FFh   
03BE   1C                     DB   h_fromr & 0FFh   
03BF   A1                     DB   h_not & 0FFh   
03C0                PTABEND:      
03C0                          ENDIF      
03C0                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
03C0                             ; and return its value in A with the carry set; otherwise leave the IP and
03C0                             ; return with the carry clear.
03C0   0A           HEXC:     LD   A,(BC)   
03C1   D6 30                  SUB   "0"   
03C3   FE 0A                  CP   10   
03C5   38 09                  JR   C,hc1   
03C7   E6 DF                  AND   0DFh   
03C9   D6 11                  SUB   11h   
03CB   FE 06                  CP   6   
03CD   D0                     RET   NC   
03CE   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
03D0   03           HC1:      INC   BC   
03D1   C9                     RET      
03D2                             ; =============================================================================
03D2                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
03D2                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
03D2                             ;  (RST 28h) prints A. Both keep BC, DE, HL and HL'. In the generic build
03D2                             ;  they are the host's KEY and CONOUT routines themselves.
03D2                             ; 
03D2                             ;  A running program reads the keyboard only through getk and pollk, which
03D2                             ;  between them give the break key its rules:
03D2                             ;    - Ctrl-C stops the program;
03D2                             ;    - any other key that the break check reads is held in KEYBUF for the
03D2                             ;      next "?", and a newer one takes its place;
03D2                             ;    - "?" (getk) takes the held key first;
03D2                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
03D2                             ;      key like any other, but two of them within about 250 ms still stop it.
03D2                             ;  Both are called straight from a handler, never from a routine under one:
03D2                             ;  the checked build's report counts on finding one return address above the
03D2                             ;  data stack.
03D2                             ; =============================================================================
03D2                          IFN   CPM   
03D2                RAWK:     EQU   KEY   
03D2                          ENDIF      
03D2                             ; pollk: the break check (see rpushn).
03D2   CD 06 FF     POLLK:    CALL   rawk   
03D5   C8                     RET   Z   ; no key
03D6   32 7A 82               LD   (KEYBUF),A   ; held for the next "?"
03D9   FE 03        PK1:      CP   3   ; (getk joins here)
03DB   C0                     RET   NZ   
03DC                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
03DC                             ; the program has turned it off, wait about 250 ms for one more key: a
03DC                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
03DC                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
03DC   3A 7B 82     CTLC:     LD   A,(BRKOFF)   
03DF   B7                     OR   A   
03E0   CA 68 04     CT0:      JP   Z,brk   
03E3   D5                     PUSH   DE   
03E4   11 10 27               LD   DE,250*MSLOOP   
03E7   CD 06 FF     CT1:      CALL   rawk   
03EA   20 05                  JR   NZ,ct2   
03EC   1B                     DEC   DE   
03ED   7A                     LD   A,D   
03EE   B3                     OR   E   
03EF   20 F6                  JR   NZ,ct1   
03F1   D1           CT2:      POP   DE   ; A = the second key, or 0 if none came
03F2   FE 03                  CP   3   
03F4   28 EA                  JR   Z,ct0   ; (the zero flag takes the JP there)
03F6   B7                     OR   A   
03F7   28 03                  JR   Z,ct3   
03F9   32 7A 82               LD   (KEYBUF),A   
03FC   3E 03        CT3:      LD   A,3   
03FE   B7                     OR   A   
03FF   C9                     RET      
0400                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
0400   E5           GETK:     PUSH   HL   ; a held key goes first, and is taken out of
0401   21 7A 82               LD   HL,KEYBUF   ;   the buffer
0404   7E                     LD   A,(HL)   
0405   36 00                  LD   (HL),0   
0407   E1                     POP   HL   
0408   B7                     OR   A   
0409   C0                     RET   NZ   
040A   CD 06 FF               CALL   rawk   
040D   C8                     RET   Z   
040E   18 C9                  JR   pk1   ; Ctrl-C? If not, that is the key
0410                          IF   (1-CHECKED)*(1-EDITOR)   
                    BRK:      EQU   endprog   ; the unchecked build stops without a word
0410                          ENDIF      ;   (with the editor, both stacks are cleared);
0410                          IF   (1-CHECKED)*EDITOR   
                    BRK:      EQU   edit0   
0410                          ENDIF      
0410                          IF   CHECKED   
0410                BRK:      EQU   e_break   ;   the checked build reports B
0410                          ENDIF      
0410                          IF   CPM   
                    RAWK:     LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
                                 ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
                                 ; printing and could swallow a key that BDOS 6 then never sees.
                    PUTC:     PUSH   DE   
                              PUSH   HL   
                              LD   E,A   
                              LD   A,6   
                              CALL   bdosx   
                              POP   HL   
                              POP   DE   
                              OR   A   ; (for getk)
                              RET      
                                 ; bdosx: call BDOS function A with DE, keeping BC and HL'
                    BDOSX:    PUSH   BC   
                              EXX      
                              PUSH   HL   
                              EXX      
                              LD   C,A   
                              CALL   BDOS   
                              EXX      
                              POP   HL   
                              EXX      
                              POP   BC   
                              RET      
0410                          ENDIF      
0410                             ; =============================================================================
0410                             ;  Checked build: the checks and the error report
0410                             ; =============================================================================
0410                          IF   CHECKED   
0410                             ; chkstk: both stacks are checked once per character, not in every handler.
0410                             ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
0410                             ; the constant carries if it is above (cells were popped that were never
0410                             ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
0410                             ; a character late at most: the bytes above DSTOP and the guard band below
0410                             ; the page take what happens meanwhile. DE is free between characters.
0410   EB           CHKSTK:   EX   DE,HL   
0411   21 05 7E               LD   HL,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
0414   39                     ADD   HL,SP   
0415   EB                     EX   DE,HL   
0416   38 1D                  JR   C,e_under   
0418   14                     INC   D   
0419   20 16                  JR   NZ,e_over   
041B   D9                     EXX      ; the return stack: in its page (or it has
041C   7C                     LD   A,H   ;   overflowed), and not above its empty
041D   FE 80                  CP   RSPAGE   ;   position (an underflow stays inside the
041F   7D                     LD   A,L   ;   page, in the guard band)
0420   D9                     EXX      
0421   20 0B                  JR   NZ,e_rover   
0423   FE E1                  CP   RSTOP&0FFh+1   
0425   D8                     RET   C   
0426   D9                     EXX      ; return stack underflow: it counts as empty
0427   2E E0                  LD   L,RSTOP&0FFh   ;   (H is right: the pointer is in its page)
0429   D9                     EXX      
042A   3E 72                  LD   A,"r"   
042C   18 3C                  JR   errp   
042E   3E 52        E_ROVER:   LD   A,"R"   ; return stack overflow
0430   11                     DB   11h   ; (LD DE,nn hides the next entry)
0431   3E 53        E_OVER:   LD   A,"S"   ; data stack overflow
0433   18 35                  JR   errp   
0435   31 FC 81     E_UNDER:   LD   SP,DSTOP   ; data stack underflow: it counts as empty
0438   3E 73                  LD   A,"s"   
043A   18 3E                  JR   error   
043C                             ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
043C                             ; was never defined still holds 0000h, and the byte there is a reserved one
043C                             ; in every build (AFh or C3h): if the IP is in page zero, this was a call of
043C                             ; an undefined word. The call is undone, so the place is the call itself.
043C   04           E_HI:     INC   B   
043D   10 33                  DJNZ   e_resv   ; (B is as it was, and is not 0)
043F   CF                     RST   08h   
0440   42                     LD   B,D   
0441   4B                     LD   C,E   
0442   3E 55                  LD   A,"U"   
0444   18 34                  JR   error   
0446                             ; chkhp: HL = the new heap top, DE = the old one, the carry is from adding
0446                             ; the count. Stop if the top is not below the limit page, or is below the
0446                             ; program's end.
0446                CHKHP:       
0446                          ENDIF      
0446                          IF   CHECKED*CPM   
                                 ; With this much room a top that wrapped round can land back in
                                 ; range, so the add is tested too: growing (A, the count's high
                                 ; byte, is positive) must not carry, and releasing must.
                              RRA      ; the carry comes in above the sign:
                              ADD   A,40h   ;   bit 7 = carry XOR sign
                              ADD   A,A   
                              JR   C,e_heap   
                              LD   A,(0007h)   
                              DEC   A   
                              CP   H   
                              JR   C,e_heap   
0446                          ENDIF      
0446                          IF   CHECKED*(1-CPM)   
0446                             ; (Here the program's space is under 32K, so a top that wrapped
0446                             ; round always falls outside it.)
0446   7C                     LD   A,H   
0447   FE F0                  CP   HEAPLIM   
0449   30 09                  JR   NC,e_heap   
044B                          ENDIF      
044B                          IF   CHECKED   
044B   D5                     PUSH   DE   
044C   EB                     EX   DE,HL   
044D   2A 38 82               LD   HL,(NPEND)   
0450   19                     ADD   HL,DE   ; carry: at or above the program's end
0451   EB                     EX   DE,HL   
0452   D1                     POP   DE   
0453   D8                     RET   C   
0454   B7           E_HEAP:   OR   A   ; put the count back in TOS for the report
0455   ED 52                  SBC   HL,DE   
0457   3E 48                  LD   A,"H"   
0459   18 0F                  JR   errp   
045B                             ; chkst: stop unless HL is in the program's own space: from the letter page
045B                             ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
045B                             ; whatever lies above the limit are safe. Memory above the heap top but
045B                             ; below the limit is the program's own: Tiny BASIC keeps its lines there.
045B                             ; It is the page of HL + 1 that is tested, so that one test serves both
045B                             ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
045B                             ; Keeps HL and BC. It runs on into its own error entry.
045B   23           CHKST:    INC   HL   
045C   7C                     LD   A,H   
045D   2B                     DEC   HL   
045E   FE 82                  CP   LETPAGE   
0460   38 03                  JR   C,e_store   
0462                          ENDIF      
0462                          IF   CHECKED*(1-CPM)   
0462   FE F0                  CP   HEAPLIM   
0464   D8                     RET   C   
0465                          ENDIF      
0465                          IF   CHECKED*CPM   
                              LD   E,A   
                              LD   A,(0007h)   ; the BDOS page is the heap limit
                              DEC   A   
                              CP   E   
                              RET   NC   
0465                          ENDIF      
0465                          IF   CHECKED   
0465                             ; Error entries. Each loads its letter and then hides the next entry inside
0465                             ; a 3-byte LD DE,nn (the 11h), so they all fall through to `error`.
0465   3E 4F        E_STORE:   LD   A,"O"   ; a store outside the program's space
0467   11                     DB   11h   
0468   3E 42        E_BREAK:   LD   A,"B"   ; Ctrl-C (found inside pollk or getk)
046A                             ; errp: an error found inside a routine: drop its return address first.
046A   D1           ERRP:     POP   DE   
046B   18 0D                  JR   error   
046D   44           E_QUOTE:   LD   B,H   ; an unclosed string: HL is its address, one
046E   4D                     LD   C,L   ;   past the opening quote, which is the place
046F   3E 51                  LD   A,"Q"   
0471   11                     DB   11h   
0472   3E 58        E_RESV:   LD   A,"X"   ; a reserved byte outside a string
0474   11                     DB   11h   
0475   3E 5A        E_ZERO:   LD   A,"Z"   ; dividing by zero
0477   11                     DB   11h   
0478   3E 57        E_BRACK:   LD   A,"W"   ; bad character after [
047A                             ; error: the report, then the end. A = the letter, BC = one past the place,
047A                             ; HL = TOS, and both stacks as the report is to show them:
047A                             ; 
047A                             ;   Err X @ line,col
047A                             ;   up to 16 characters of the text from the place
047A                             ;   Stk n: the top 8 cells at most, bottom to top
047A                             ;   Rtn n
047A   E5           ERROR:    PUSH   HL   ; now the whole data stack is in memory
047B   5F                     LD   E,A   
047C   CD 4C 05               CALL   pnl   
047F   45 72 72 20 22         DB   "Err ",22h   
0484   7B                     LD   A,E   
0485   EF                     RST   28h   
0486   CD 52 05               CALL   pmsg   
0489   20 40 20 22            DB   " @ ",22h   
048D   0B                     DEC   BC   ; BC = the place
048E                             ; The line and column. A place below the program is in the line
048E                             ; buffer: line 0. Otherwise count the LFs from the program's start;
048E                             ; DE = the line's number, HL = where it starts.
048E   21 80 82               LD   HL,LINEBUF   
0491   11 00 00               LD   DE,0   
0494   78                     LD   A,B   
0495   FE 83                  CP   PROG/256   
0497   38 14                  JR   C,er3   
0499   24                     INC   H   
049A   6B                     LD   L,E   ; HL = PROG
049B   13           ER1:      INC   DE   ; a new line starts at HL
049C   E5                     PUSH   HL   
049D   7D           ER2:      LD   A,L   
049E   91                     SUB   C   
049F   7C                     LD   A,H   
04A0   98                     SBC   A,B   
04A1   30 09                  JR   NC,er2x   ; reached the place
04A3   7E                     LD   A,(HL)   
04A4   23                     INC   HL   
04A5   FE 0A                  CP   10   
04A7   20 F4                  JR   NZ,er2   
04A9   F1                     POP   AF   
04AA   18 EF                  JR   er1   
04AC   E1           ER2X:     POP   HL   
04AD   C5           ER3:      PUSH   BC   
04AE   E5                     PUSH   HL   
04AF   EB                     EX   DE,HL   
04B0   CD BF 02               CALL   pdec   ; the line
04B3   3E 2C                  LD   A,","   
04B5   EF                     RST   28h   
04B6   D1                     POP   DE   
04B7   E1                     POP   HL   
04B8   E5                     PUSH   HL   
04B9   B7                     OR   A   
04BA   ED 52                  SBC   HL,DE   
04BC   23                     INC   HL   
04BD   CD BF 02               CALL   pdec   ; the column
04C0   CD 4C 05               CALL   pnl   
04C3   22                     DB   22h   
04C4   E1                     POP   HL   ; the text, as it is: 16 characters, or fewer
04C5   06 10                  LD   B,16   ;   if the line or the program ends first
04C7   7E           ER4:      LD   A,(HL)   
04C8   23                     INC   HL   
04C9   B7                     OR   A   
04CA   28 0B                  JR   Z,er5   
04CC   FE 0D                  CP   13   
04CE   28 07                  JR   Z,er5   
04D0   FE 0A                  CP   10   
04D2   28 03                  JR   Z,er5   
04D4                          ENDIF      
04D4                          IF   CHECKED*CPM   
                              CP   1Ah   ; (the ^Z that pads a file's last record ends
                              JR   Z,er5   ;   the text too: some terminals clear the
04D4                          ENDIF      ;   screen on it)
04D4                          IF   CHECKED   
04D4   EF                     RST   28h   
04D5   10 F0                  DJNZ   er4   
04D7                ER5:         ; (without the editor: on into pstk)
04D7                          ENDIF      
04D7                          IF   CHECKED*EDITOR   
                              CALL   pstk   
                              CALL   pnl   
                              DB   22h   
                              JP   edit0   ; back to the editor, with both stacks cleared
04D7                          ENDIF      
04D7                             ; =============================================================================
04D7                             ;  Routines that the checked build's report and the editor share
04D7                             ; =============================================================================
04D7                SPADJ:    EQU   2*EDITOR   ; (with the editor pstk is called, not fallen
04D7                             ;   into: the stack is one address deeper)
04D7                          IF   CHECKED+EDITOR   
04D7                             ; pstk: the two stack lines:  Stk n: the top 8 cells at most, bottom to top
04D7                             ;                             Rtn n
04D7                             ; TOS must be in memory with the rest (pushed). In a build without the
04D7                             ; editor this is the end of `error`, which runs on into it.
04D7   CD 4C 05     PSTK:     CALL   pnl   
04DA   53 74 6B 20 22         DB   "Stk ",22h   
04DF   21 06 7E               LD   HL,(2+SPADJ-DSTOP)&0FFFFh   ; SP - (DSTOP-2) is minus twice the
04E2   39                     ADD   HL,SP   ;   depth (the cell at DSTOP-2 was pushed
04E3   E7                     RST   20h   ;   with the first value and holds nothing)
04E4   CD 2F 05               CALL   phalf   ; the depth
04E7   3E 3A                  LD   A,":"   
04E9   EF                     RST   28h   
04EA   79                     LD   A,C   
04EB   FE 09                  CP   9   
04ED   38 0A                  JR   C,er6   
04EF   CD 52 05               CALL   pmsg   
04F2   20 2E 2E 2E 22         DB   " ...",22h   
04F7   0E 08                  LD   C,8   
04F9   26 00        ER6:      LD   H,0   ; C = the number of cells to show
04FB   69                     LD   L,C   
04FC   29                     ADD   HL,HL   
04FD   39                     ADD   HL,SP   ; HL -> just above the deepest of them
04FE                          ENDIF      
04FE                          IF   EDITOR   
                              INC   HL   
                              INC   HL   
04FE                          ENDIF      
04FE                          IF   CHECKED+EDITOR   
04FE   0C                     INC   C   
04FF   0D           ER7:      DEC   C   
0500   28 11                  JR   Z,er8   
0502   2B                     DEC   HL   
0503   56                     LD   D,(HL)   
0504   2B                     DEC   HL   
0505   5E                     LD   E,(HL)   
0506   E5                     PUSH   HL   
0507   C5                     PUSH   BC   
0508   3E 20                  LD   A," "   
050A   EF                     RST   28h   
050B   EB                     EX   DE,HL   
050C   CD B7 02               CALL   psgn   
050F   C1                     POP   BC   
0510   E1                     POP   HL   
0511   18 EC                  JR   er7   
0513   CD 4C 05     ER8:      CALL   pnl   
0516                          ENDIF      
0516                          IF   (1-CHECKED)*EDITOR   
                              DB   "Rtn 0",22h   ; (only ^V comes here, and at the editor the
                              RET      ;   return stack is always empty)
0516                          ENDIF      
0516                          IF   CHECKED   
0516   52 74 6E 20 22         DB   "Rtn ",22h   
051B   D9                     EXX      
051C   E5                     PUSH   HL   
051D   D9                     EXX      
051E   D1                     POP   DE   
051F   21 E0 80               LD   HL,RSTOP   
0522   B7                     OR   A   
0523   ED 52                  SBC   HL,DE   
0525                          ENDIF      
0525                          IF   CHECKED*(1-EDITOR)   
0525   CD 2F 05               CALL   phalf   
0528   CD 4C 05               CALL   pnl   
052B   22                     DB   22h   
052C   C3 15 00               JP   endprog   
052F                          ENDIF      
052F                          IF   CHECKED+EDITOR   
052F                             ; phalf: print half of HL, and leave it in C. (With the editor, pstk ends by
052F                             ; running on into this.)
052F   CB 3C        PHALF:    SRL   H   
0531   CB 1D                  RR   L   
0533   E5                     PUSH   HL   
0534   CD BF 02               CALL   pdec   
0537   C1                     POP   BC   
0538   C9                     RET      
0539                             ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
0539                             ; "$", and the texts of the report and the editor). In the checked build a
0539                             ; NUL first is an error: Q.
0539   7E           PRSTR:    LD   A,(HL)   
053A   23                     INC   HL   
053B   FE 22                  CP   22h   
053D   C8                     RET   Z   
053E                          ENDIF      
053E                          IF   CHECKED   
053E   B7                     OR   A   
053F   28 17                  JR   Z,e_dollar   
0541                          ENDIF      
0541                          IF   CHECKED+EDITOR   
0541   FE 2F                  CP   "/"   
0543   20 04                  JR   NZ,prs1   
0545   7E                     LD   A,(HL)   
0546   23                     INC   HL   
0547   E6 BF                  AND   0BFh   
0549   EF           PRS1:     RST   28h   
054A   18 ED                  JR   prstr   
054C                             ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
054C                             ; pnl: the same, on a new line.
054C   3E 0D        PNL:      LD   A,13   
054E   EF                     RST   28h   
054F   3E 0A                  LD   A,10   
0551   EF                     RST   28h   
0552   E3           PMSG:     EX   (SP),HL   
0553   CD 39 05               CALL   prstr   
0556   E3                     EX   (SP),HL   
0557   C9                     RET      
0558                          ENDIF      
0558                          IF   CHECKED   
0558   D1           E_DOLLAR:   POP   DE   ; "$" ran into a NUL: drop the return address,
0559   E1                     POP   HL   ;   and put the string's address back in TOS
055A   3E 51                  LD   A,"Q"   
055C   C3 7A 04               JP   error   
055F                          ENDIF      
055F                             ; =============================================================================
055F                             ;  The line editor (EDITOR = 1)
055F                             ; 
055F                             ;  The interpreter starts here, and a program that ends comes back here.
055F                             ;  There is no prompt. It follows the spec's suggested standard for a line
055F                             ;  editor (docs/b8script.md, Environments). Type a line and press Return:
055F                             ; 
055F                             ;    n text    put the text in as line n; the lines from n on move down. A
055F                             ;              number past the end (or 0) adds the line at the end.
055F                             ;    n         take line n out
055F                             ;    anything else is run at once, as B8Script. (Start such a line with a
055F                             ;    space if it would begin with a digit.)
055F                             ; 
055F                             ;  A command key ends the line too, and takes what was typed as its argument:
055F                             ; 
055F                             ;    ^G        run the program
055F                             ;    n ^L      list from line n (no number: all of it). Any key holds the
055F                             ;              list until another key is pressed; Ctrl-C ends it.
055F                             ;    n ^E      put line n in the input line; Return puts it back, changed
055F                             ;    name ^R   read. CP/M: the file of that name (no name: the same file as
055F                             ;              last time). Generic: what is typed, or pasted, from now until
055F                             ;              ^Z replaces the program; it is not echoed.
055F                             ;    name ^W   write. CP/M: to that file (no name: the same file as last
055F                             ;              time). Generic: the text is printed, as it is.
055F                             ;    ^N ^N     new: no program (the key twice in a row)
055F                             ;    ^V        view: the build, both stacks, and the program's size, lines
055F                             ;              and free memory
055F                             ;    ^X        leave (to LEAVE)
055F                             ; 
055F                             ;  In the line: ^B and ^F, or the left and right arrow keys, move the cursor;
055F                             ;  a character goes in at the cursor; Backspace and DEL take out the one
055F                             ;  before it; Esc drops the line. Only CR, LF, BS and printing characters are
055F                             ;  sent to the terminal, so any terminal will do.
055F                             ; 
055F                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
055F                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
055F                             ;  125 characters; the one character after a line number separates it from
055F                             ;  the text and is not stored. The text is kept as it is typed, each line
055F                             ;  ending in CR LF, at PROG.
055F                             ; 
055F                             ;  What lasts from one line to the next: the program, the words, the
055F                             ;  variables and the data stack. An error or a break clears both stacks. The
055F                             ;  return stack starts empty for every line.
055F                             ; 
055F                             ;  Things to know:
055F                             ;    - Reset empties the program (generic builds).
055F                             ;    - A word's address points into the program, so run the program again
055F                             ;      after editing it.
055F                             ;    - Nothing is printed between a program's output and what is typed next.
055F                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
055F                             ;      a line that calls -n? and carries on afterwards runs what was typed.
055F                             ;      (The stored program never comes back to the line, so it may.)
055F                             ;    - The editor"s own keys are not the program"s: -n? is the plain line
055F                             ;      read of the other builds (BDOS 10 under CP/M).
055F                             ; 
055F                             ;  The data stack is the CPU's stack, so the editor works on top of whatever
055F                             ;  the last line left there, with TOS pushed like the rest.
055F                             ; =============================================================================
055F                          IF   EDGEN   
                    INIT:        ; reset (A = 0)
055F                          ENDIF      
055F                          IF   EDGEN*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at 0, and
                                 ; every word cell holds 0000h, the address an undefined word is caught at
                                 ; (see e_hi).
                              LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
055F                          ENDIF      
055F                          IF   EDGEN   
                              JR   edit0   
055F                          ENDIF      
055F                          IF   EDITOR   
                                 ; ^F, right arrow: one to the right, by printing the character there
                    RIGHT:    LD   A,L   
                              CP   E   
                              JR   Z,ed1   ; at the end
                              LD   A,(HL)   
                              INC   L   
                              JR   lf1   
                                 ; Esc: alone it drops the line. An arrow key sends Esc [ and a letter, so
                                 ; wait about 5 ms for a second key: after a "[" read on to the letter that
                                 ; ends the sequence, and act on C (right) and D (left).
                    ESC:      LD   BC,5*MSLOOP   
                    ES1:      CALL   rawk   
                              JR   NZ,es2   
                              DEC   BC   
                              LD   A,B   
                              OR   C   
                              JR   NZ,es1   
                              CALL   fin   ; no second key: the line is dropped
                              JR   edit   
                    ES2:      CP   "["   
                              JR   NZ,ed1   ; not a sequence known here
                    ES3:      CALL   ekey   
                              CP   40h   
                              JR   C,es3   ; (its parameters)
                              SUB   "C"   
                              JR   Z,right   
                              DEC   A   ; "D"?
                              JR   NZ,ed1   ; no: on into left
                                 ; ^B, left arrow: the cursor goes one to the left
                    LEFT:     LD   A,L   
                              ADD   A,A   
                              JR   Z,ed1   ; (L = 80h: at the start)
                              DEC   L   
                              LD   A,8   
                    LF1:      RST   28h   
                              JR   ed1   
                                 ; edit0: reset, an error or a break: both stacks are cleared.
                                 ; skend: a program that ended inside skip: its return address goes.
                                 ; edend: a program that ended: TOS joins the rest of the data stack.
                    EDIT0:    LD   SP,DSTOP-2   ; empty (the cell that stands for TOS is pushed)
                              DB   21h   ; (LD HL,nn: steps over the next two bytes)
                    SKEND:    POP   DE   
                    EDEND:    PUSH   HL   
                                 ; edit: start a new input line.
                    EDIT:     EXX      
                              LD   HL,RSTOP   ; the return stack is empty
                              EXX      
                              LD   HL,0   
                              LD   (KEYBUF),HL   ; no key is held, and the break key is on
                              LD   (EDLN),HL   ; no line is being edited
                              LD   HL,LINEBUF   ; HL = the cursor,
                              LD   E,L   ;   E = the end of the line (its low byte)
                    ED1:      CALL   ekey   
                              CP   7Fh   
                              JR   Z,bsp   ; DEL
                              CP   " "   
                              JR   NC,insc   
                              CP   9   
                              JR   Z,insc   ; Tab is text
                              CP   8   
                              JR   Z,bsp   
                              CP   2   
                              JR   Z,left   ; ^B
                              CP   6   
                              JR   Z,right   ; ^F
                              CP   1Bh   
                              JR   Z,esc   
                              PUSH   HL   ; a command key? Look it up
                              LD   HL,cmds   
                              LD   B,NCMD   
                    ED2:      CP   (HL)   
                              INC   HL   
                              JR   Z,ed3   
                              INC   HL   
                              INC   HL   
                              DJNZ   ed2   
                              POP   HL   
                              JR   ed1   ; no: the key is ignored
                    ED3:      LD   A,(HL)   
                              INC   HL   
                              LD   H,(HL)   
                              LD   L,A   
                              EX   (SP),HL   ; the command's address: fin returns to it
                                 ; fin: end the input line: CR LF and a NUL after it, and a new line on the
                                 ; terminal. Leaves BC -> the line and HL -> the NUL.
                    FIN:      LD   H,LETPAGE   
                              LD   L,E   
                              LD   (HL),13   
                              INC   L   
                              LD   (HL),10   
                              DEC   L   
                              CALL   prl   ; (prints the CR LF)
                              LD   (HL),0   
                              LD   BC,LINEBUF   
                              RET      
                                 ; Backspace, DEL: the character before the cursor goes. The cursor moves
                                 ; left, the rest of the line moves down over it, and the last place (now a
                                 ; space) is printed over along with the rest.
                    BSP:      LD   A,L   
                              ADD   A,A   
                              JR   Z,ed1   ; at the start
                              DEC   L   
                              LD   A,8   
                              RST   28h   
                              PUSH   HL   
                    BS1:      INC   L   
                              LD   A,(HL)   
                              DEC   L   
                              LD   (HL),A   
                              INC   L   
                              LD   A,L   
                              CP   E   
                              JR   NZ,bs1   
                              DEC   L   
                              LD   (HL)," "   
                              POP   HL   
                              LD   D,E   
                              DEC   E   
                              JR   ic2   
                                 ; A character goes in at the cursor: it ripples up through the rest of the
                                 ; line, the cursor moves on, and the rest is printed again.
                    INSC:     LD   B,A   
                              LD   A,E   
                              CP   0FDh   
                              JR   Z,ed1   ; the line is full: 125 characters
                              LD   A,B   
                              RST   28h   
                              PUSH   HL   
                    IC1:      LD   A,(HL)   
                              LD   (HL),B   
                              LD   B,A   
                              LD   A,L   
                              INC   L   
                              CP   E   
                              JR   NZ,ic1   
                              POP   HL   
                              INC   L   
                              INC   E   
                              LD   D,E   
                    IC2:      CALL   tail   
                              JR   ed1   
                                 ; tail: print the line from the cursor to D (a low byte), and bring the
                                 ; cursor back with backspaces. Nothing at all if the cursor is at D.
                    TAIL:     LD   C,L   
                    TA1:      LD   A,L   
                              CP   D   
                              JR   Z,ta2   
                              LD   A,(HL)   
                              RST   28h   
                              INC   L   
                              JR   ta1   
                    TA2:      LD   A,L   
                              CP   C   
                              RET   Z   
                              LD   A,8   
                              RST   28h   
                              DEC   L   
                              JR   ta2   
                                 ; ekey: wait for a key
                    EKEY:     CALL   rawk   
                              JR   Z,ekey   
                              RET      
                                 ; The command keys, and where each goes (after fin).
                    CMDS:     DB   13   
                              DW   cret   
                              DB   7   ; ^G
                              DW   crun   
                              DB   12   ; ^L
                              DW   clist   
                              DB   5   ; ^E
                              DW   cedln   
                              DB   18   ; ^R
                              DW   cread   
                              DB   23   ; ^W
                              DW   cwrite   
                              DB   14   ; ^N
                              DW   cnew   
                              DB   22   ; ^V
                              DW   cview   
                              DB   24   ; ^X
                              DW   LEAVE   
                    NCMD:     EQU   9   
                                 ; ^N ^N: no program, if the next key is ^N too
                    CNEW:     CALL   ekey   
                              CP   14   
                              JR   NZ,ged0   
                              XOR   A   
                              LD   (PROG),A   
                    GED0:     JP   edit   
                                 ; ^E: line n goes into the input line, to be changed. EDLN remembers which
                                 ; line it was: Return puts the text back in its place.
                    CEDLN:    CALL   rdnum   
                              PUSH   HL   
                              CALL   find   ; HL -> the line, or the NUL if there is none
                              POP   DE   
                              LD   A,(HL)   
                              OR   A   
                              JR   Z,ged0   
                              LD   (EDLN),DE   
                              LD   DE,LINEBUF   
                    CE1:      LD   A,(HL)   ; copy it, and show it, up to its CR (or LF)
                              CP   13   
                              JR   Z,ce2   
                              CP   10   
                              JR   Z,ce2   
                              LD   (DE),A   
                              RST   28h   
                              INC   HL   
                              INC   E   
                              LD   A,E   
                              CP   0FDh   ; (a longer line is cut at 125 characters)
                              JR   NZ,ce1   
                    CE2:      EX   DE,HL   ; the cursor is at the line's end
                              LD   E,L   
                              JP   ed1   
                                 ; Return. If ^E put a line here, the text goes back in its place. If not:
                                 ; a number and text is a line to put in, a number alone a line to take out,
                                 ; and anything else is run where it is.
                    CRET:     PUSH   HL   ; the end of what was typed
                              LD   HL,(EDLN)   
                              LD   A,H   
                              OR   L   
                              JR   Z,cr1   
                              PUSH   HL   
                              CALL   delln   
                              POP   HL   
                              JR   ins   
                    CR1:      CALL   rdnum   ; HL = the number it starts with, BC -> after
                              LD   A,C   ; C is still 80h if there was no number:
                              ADD   A,A   ;   only then is twice it 0
                              JR   Z,st0p   ; no number: run the line
                              LD   A,(BC)   
                              CP   13   
                              JR   NZ,cr2   
                              POP   DE   ; the number alone: take that line out
                              CALL   delln   
                              JR   gedit   
                    CR2:      INC   BC   ; step over the one character after the number
                                 ; Put the text at BC in as line n (in HL): open a gap of its length there,
                                 ; CR and LF included, and copy it in.
                    INS:      CALL   find   ; HL -> where it goes
                              POP   DE   ; the end of what was typed
                              LD   A,E   
                              SUB   C   ; A = the length of the text, with its CR LF
                              PUSH   BC   ; the text
                              LD   C,A   
                              LD   B,0   
                              PUSH   BC   ; its length
                              LD   D,H   
                              LD   E,L   ; DE = where it goes
                              XOR   A   
                              LD   C,A   ; BC = 0: CPIR looks as far as it needs to
                              CPIR      ; HL -> one past the program's NUL
                              SBC   HL,DE   ; the number of bytes to move up, NUL included
                              LD   B,H   
                              LD   C,L   
                              ADD   HL,DE   
                              DEC   HL   ; HL -> the NUL
                              EX   DE,HL   
                              EX   (SP),HL   ; HL = the length; where it goes is kept
                              PUSH   HL   
                              ADD   HL,DE   ; the NUL's new place
                              EX   DE,HL   
                              LDDR      ; move the rest of the program up
                              POP   BC   ; the length
                              POP   DE   ; where it goes
                              POP   HL   ; the text
                              LDIR      
                    GEDIT:    JP   edit   
                                 ; ^G: run the program. st0p: run the typed line (BC -> it).
                    CRUN:     LD   BC,PROG   
                              DB   3Eh   ; (LD A,n: steps over the POP)
                    ST0P:     POP   HL   ; (the end of what was typed)
                                 ; st0: start running at BC. The heap starts after the stored program's NUL.
                    ST0:      LD   HL,PROG   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
                              LD   (HEAP),HL   
055F                          ENDIF      
055F                          IF   EDITOR*CHECKED   
                              RST   20h   ; minus the heap"s first address: "_' may not
                              LD   (NPEND),HL   ;   release below it
055F                          ENDIF      
055F                          IF   EDITOR   
                              POP   HL   ; TOS: the data stack is as the last line left it
                              RST   30h   ; (its return address is thrown away)
                                 ; ^L: list from line n. DE = the number of the line at HL.
                    CLIST:    CALL   rdnum   ; HL = n, or 0 if there was none:
                              LD   A,H   
                              OR   L   
                              JR   NZ,li0   
                              INC   L   ;   then from line 1
                    LI0:      PUSH   HL   
                              CALL   find   
                              POP   DE   
                    LI1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,gedit   ; the end of the text
                              CALL   rawk   
                              JR   Z,li3   ; no key: carry on
                              CP   3   
                              CALL   NZ,ekey   ; any key but Ctrl-C: wait for one more
                              CP   3   
                              JR   Z,gedit   ; Ctrl-C, first or second, ends the list
                    LI3:      PUSH   HL   
                              PUSH   DE   
                              EX   DE,HL   
                              CALL   pdec   ; the line's number,
                              LD   A," "   
                              RST   28h   ;   a space,
                              POP   DE   
                              POP   HL   
                              INC   DE   
                              CALL   prl   ;   and the line
                              JR   li1   
                                 ; ^V: view.
                    CVIEW:    CALL   pmsg   
                              DB   "B8SZ80E"   
055F                          ENDIF      
055F                          IF   EDITOR*CHECKED   
                              DB   "C"   
055F                          ENDIF      
055F                          IF   EDITOR   
                              DB   " 2026-11-21",22h   
                              CALL   pstk   ; both stacks
                              LD   HL,PROG   
                              LD   DE,0FFFFh   
                    CV1:      INC   DE   ; count the lines, and find the end
                              CALL   nxl   
                              JR   NZ,cv1   
                              PUSH   HL   ; the NUL
                              PUSH   DE   ; the lines
                              LD   DE,(0-PROG)&0FFFFh   
                              ADD   HL,DE   
                              CALL   pnl   
                              DB   "Prog ",22h   
                              CALL   pdec   ; the program's size
                              POP   HL   
                              CALL   pnl   
                              DB   "Lines ",22h   
                              CALL   pdec   
                              POP   DE   
055F                          ENDIF      
055F                          IF   EDGEN   
                              LD   HL,HEAPLIM*256-1   
055F                          ENDIF      
055F                          IF   EDITOR*CPM   
                              LD   A,(0007h)   ; the BDOS page is the limit
                              LD   H,A   
                              LD   L,0   
                              DEC   HL   
055F                          ENDIF      
055F                          IF   EDITOR   
                              OR   A   
                              SBC   HL,DE   
                              CALL   pnl   
                              DB   "Free ",22h   
                              CALL   pdec   ; the room left for text and heap
                              CALL   pnl   
                              DB   22h   
                    GED1:     JP   edit   
                                 ; delln: take line n (in HL) out: copy everything after it down over it.
                    DELLN:    CALL   find   
                              LD   D,H   
                              LD   E,L   
                              CALL   nxl   ; HL -> the next line
                    DE1:      LD   A,(HL)   
                              LD   (DE),A   
                              INC   HL   
                              INC   DE   
                              OR   A   
                              JR   NZ,de1   
                              RET      
                                 ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
                                 ; of the text if there are fewer lines (or the number is 0). Keeps BC.
                    FIND:     EX   DE,HL   
                              LD   HL,PROG   
                    FI1:      DEC   DE   
                              LD   A,D   
                              OR   E   
                              RET   Z   
                              CALL   nxl   
                              JR   NZ,fi1   
                              RET      
                                 ; nxl: step HL over one line, to just past its LF (and return not-zero), or
                                 ; stop at the NUL that ends the text (and return zero).
                    NXL:      LD   A,(HL)   
                              OR   A   
                              RET   Z   
                              INC   HL   
                              CP   10   
                              JR   NZ,nxl   
                              OR   A   
                              RET      
                                 ; prl: print the line at HL, to its LF; HL -> just past it.
                    PRL:      LD   A,(HL)   
                              RST   28h   
                              LD   A,(HL)   
                              INC   HL   
                              CP   10   
                              JR   NZ,prl   
                              RET      
055F                          ENDIF      
055F                          IF   EDGEN   
                                 ; ^R, generic: what comes in from now until ^Z is the program. A CR is
                                 ; stored as CR LF; a LF right after a line end is dropped (it is the CR's
                                 ; own, or an empty line's), and a LF anywhere else ends a line too. A last
                                 ; line with no end is given one. Nothing is echoed, and there is no check
                                 ; for running out of memory.
                    CREAD:    LD   HL,PROG-1   
                              LD   (HL),10   ; (as if a line had just ended: the byte is
                              INC   HL   ;   the line buffer's last, and spare)
                    RD1:      CALL   ekey   
                              LD   C,A   
                              CP   1Ah   
                              JR   NZ,rd2   
                              LD   A,10   ; ^Z ends the last line, as a LF would
                    RD2:      CP   10   
                              JR   NZ,rd3   
                              DEC   HL   
                              CP   (HL)   
                              INC   HL   
                              JR   Z,rd4   ; straight after a line end: dropped
                              LD   A,13   ; anywhere else it ends the line
                    RD3:      LD   (HL),A   
                              INC   HL   
                              CP   13   
                              JR   NZ,rd4   
                              LD   (HL),10   ; after a CR goes a LF
                              INC   HL   
                    RD4:      LD   A,C   
                              CP   1Ah   
                              JR   NZ,rd1   
                              LD   (HL),0   
                              JR   ged1   
                                 ; ^W, generic: the text is printed as it is, for the terminal to capture.
                    CWRITE:   LD   HL,PROG   
                    CW1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,ged1   
                              RST   28h   
                              INC   HL   
                              JR   cw1   
055F                          ENDIF      
055F                          IF   EDITOR*CPM   
                    CFCB:     EQU   005Ch   ; the file's name is kept here, where the CCP
                                 ;   put the one from the command line
                                 ; ^R, CP/M: read the file. A name typed before the key is the file's name
                                 ; from now on.
                    CREAD:    CALL   setname   
                              CALL   load   
                              JP   edit   
                                 ; ^W, CP/M: write the file: delete the old one, make it anew, write the
                                 ; text in records of 128 bytes, and close it. The text's NUL and the 127
                                 ; bytes after it are set to ^Z meanwhile, which pads the last record. (A
                                 ; full disk or directory is not noticed: the calls fail and that is all.)
                    CWRITE:   CALL   setname   
                              LD   C,19   ; delete
                              CALL   fbdos   
                              LD   C,22   ; make
                              CALL   fbdos   
                              LD   HL,PROG   
                              XOR   A   
                    CW1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,cw1   
                              DEC   HL   ; HL -> the NUL
                              PUSH   HL   
                              LD   B,128   
                    CW2:      LD   (HL),1Ah   
                              INC   HL   
                              DJNZ   cw2   
                              POP   HL   
                              LD   DE,PROG   
                    CW3:      LD   A,E   ; a record that starts before the end is written
                              SUB   L   
                              LD   A,D   
                              SBC   A,H   
                              JR   NC,cw4   
                              PUSH   HL   
                              LD   C,21   ; write, from where the record lies
                              CALL   frec   
                              POP   HL   
                              JR   cw3   
                    CW4:      LD   (HL),0   ; the NUL again
                              LD   C,16   ; close
                              CALL   fbdos   
                              JP   edit   
                                 ; frec: BDOS function C (read or write a record) with the 128 bytes at DE.
                                 ; Returns A = the BDOS's answer, HL = DE and DE = DE + 128.
                    FREC:     PUSH   DE   
                              PUSH   BC   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              POP   BC   
                              CALL   fbdos   
                              POP   HL   
                              LD   DE,128   
                              EX   DE,HL   
                              ADD   HL,DE   
                              EX   DE,HL   
                              RET      
                                 ; setname: if a name was typed (the line does not start with its CR), put it
                                 ; in the FCB: up to 8 characters, a dot, up to 3 more, in capitals. The drive
                                 ; is the current one. Then, name or no name, clear the FCB after the name,
                                 ; as it must be before a file is opened or made.
                    SETNAME:   LD   DE,LINEBUF   
                              LD   A,(DE)   
                              CP   13   
                              JR   Z,fcbclr   
                              LD   HL,CFCB   
                              LD   (HL),0   ; the current drive
                              LD   B,11   
                    SN1:      INC   L   
                              LD   (HL)," "   
                              DJNZ   sn1   
                              LD   L,CFCB+1   
                    SN2:      LD   A,(DE)   
                              INC   DE   
                              CP   13   
                              JR   Z,fcbclr   
                              CP   "."   
                              JR   NZ,sn3   
                              LD   L,CFCB+9   ; the type
                              JR   sn2   
                    SN3:      CP   "a"   
                              JR   C,sn4   
                              AND   5Fh   ; a capital
                    SN4:      LD   (HL),A   
                              INC   L   
                              JR   sn2   
                    FCBCLR:   LD   HL,CFCB+12   
                              LD   B,24   
                    FC1:      LD   (HL),0   
                              INC   HL   
                              DJNZ   fc1   
                              RET      
                                 ; fbdos: BDOS function C on the file
                    FBDOS:    LD   DE,CFCB   
                              JP   BDOS   
                                 ; load: read the file into PROG. No such file: no program. The text ends at
                                 ; the file"s first ^Z (1Ah), which pads a text file"s last record; one more
                                 ; goes after the last record, so the search always stops. And every line
                                 ; must end in LF: a last line without one is given a CR LF. (The FCB is
                                 ; clear after its name: the CCP left it so, or setname did.)
                    LOAD:     LD   C,15   ; open (no such file: the first read fails
                              CALL   fbdos   ;   too)
                              LD   DE,PROG   
                    LD1:      LD   C,20   ; read the next 128 bytes
                              CALL   frec   
                              OR   A   
                              JR   Z,ld1   
                              LD   (HL),1Ah   ; (HL = where the record that failed would be)
                              LD   HL,PROG-1   
                              LD   A,10   ; (a file with no text needs nothing added)
                    TR1:      INC   HL   
                              LD   E,A   ; E = the character before this one
                              LD   A,(HL)   
                              CP   1Ah   
                              JR   NZ,tr1   
                              LD   A,E   
                              CP   10   
                              JR   Z,tr2   
                              LD   (HL),13   
                              INC   HL   
                              LD   (HL),10   
                              INC   HL   
                    TR2:      LD   (HL),0   
                              RET      
055F                          ENDIF      
055F                             ; =============================================================================
055F                          IF   CPM   
                                 ; The RAM pages follow the image; the heap may grow to the BDOS.
                    START:       
055F                          ENDIF      
055F                          IF   CPM*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
                                 ; is held back.
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
055F                          ENDIF      
055F                          IF   CPM   
                              LD   HL,vecs   ; the RST routines go down into page zero
                              LD   DE,0008h   
                              LD   BC,vecend-vecs   
                              LDIR      
055F                          ENDIF      
055F                          IF   CPM*EDITOR   
                              CALL   load   ; the file named on the command line
                              JP   edit0   
055F                          ENDIF      
055F                          IF   CPM*(1-EDITOR)   
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:      LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
                              JP   st2   
055F                          ENDIF      
055F                          IF   CPM   
                                 ; RAM pages, after the image
                    RSPAGE:   EQU   (imgend + 255) / 256   
                    DSPAGE:   EQU   RSPAGE + 1   
                    LETPAGE:   EQU   RSPAGE + 2   
                    PROG:     EQU   LETPAGE*256 + 256   
055F                          ENDIF      
055F                IMGEND:      


