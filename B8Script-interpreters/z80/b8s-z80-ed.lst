0102   5F                     LD   E,A   
0103   16 82                  LD   D,LETPAGE   ; DE -> cell
0105   79                     LD   A,C   
0106   12                     LD   (DE),A   
0107   1C                     INC   E   
0108   78                     LD   A,B   
0109   12                     LD   (DE),A   
010A   18 03                  JR   skipnx   
