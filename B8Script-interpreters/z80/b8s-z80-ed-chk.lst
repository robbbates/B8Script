0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Spec: docs/b8script.md (2026-11-23).
0000                             ; 
0000                             ;  Four switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    EDITOR   1 = with the line editor built in (see the end of this file):
0000                             ;                 the spec's suggested standard. It goes with either setting
0000                             ;                 of the other two.
0000                             ;    CHECKED  0 = no checks (spec: the programmer is responsible)
0000                             ;             1 = starts with every variable at 0 and every word undefined,
0000                             ;                 and stops on every error in the spec's table (and Ctrl-C)
0000                             ;                 with a four-line report: the letter and the place as line
0000                             ;                 and column, the text there, and both stacks. See `error`.
0000                             ;    ANSI     1 = the four console codes (`@ `^ `_ `?) send ANSI escape
0000                             ;                 sequences through CONOUT
0000                             ;             0 = they call four routines of the machine's own instead:
0000                             ;                 CONAT, CONCLS, CONEOL and CONCUR (see the equates)
0000                             ; 
0000                             ;  In every build Ctrl-C stops a running program (an unchecked build stops
0000                             ;  without a word): see the console layer for the rules, the held key and
0000                             ;  the break-off cell.
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   0   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   1   ; 1 = checked build
0000                EDITOR:   EQU   1   ; 1 = with the line editor
0000                ANSI:     EQU   1   ; 1 = the console codes send ANSI sequences
0000                EDGEN:    EQU   EDITOR*(1-CPM)   ; (the generic build with the editor)
0000                             ; (IF takes any value but 0 as true, so
0000                             ;  IF CHECKED+EDITOR means "either")
0000                TABP0:    EQU   EDGEN*(1-CHECKED)   ; (the build with its table in page zero)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    HL'  return-stack pointer (the alternate HL). Entries are 2 bytes; the
0000                             ;         stack grows down. Only rpop and rpushn (and the checks) touch it.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  One-byte calls. The routines used most are reached with RST, one byte
0000                             ;  instead of three:
0000                             ; 
0000                             ;    RST 08h  rpop    pop the return stack into DE
0000                             ;    RST 18h  drop    drop TOS, then next character     (ends a handler)
0000                             ;    RST 20h  neg16   HL = -HL
0000                             ;    RST 28h  putc    print A
0000                             ;    RST 30h  next    next character                    (ends a handler)
0000                             ; 
0000                             ;  RST 18h and RST 30h never return: an RST is a CALL, so the first thing
0000                             ;  each of them does is POP DE to throw the return address away.
0000                             ; 
0000                             ;  The CP/M build can't own page zero, so the block from `vecs` to `vecend`
0000                             ;  (image addresses 0108h-0133h) is copied to 0008h-0033h when it starts. The
0000                             ;  code in that block is written to work at either place.
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (the top four bytes of the page are spare,
0000                             ;             so a full stack runs two bytes into the page below)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch, interpreter variables in the gaps, and the -n? line buffer
0000                             ;             at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack has a guard band: the data stack can
0000                             ;  overrun by a cell or two (and the calls made while it is full, the error
0000                             ;  report's included) into the top 32 bytes of the return-stack page, which
0000                             ;  are never used, and the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
                    BDOS:     EQU   0005h   
                    BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IF   CPM*(1-EDITOR)   
                    EXIT:     EQU   0000h   ; warm boot
0000                          ENDIF      
0000                          IFN   CPM   
0000                             ; ---- generic machine: edit these to suit -----------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The zero flag must match A
0000                             ;   (end the routine with OR A / RET).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                             ;   KEY and CONOUT must preserve BC, DE, HL and HL'.
0000                RSPAGE:   EQU   80h   ; 8000h return stack
0000                DSPAGE:   EQU   81h   ; 8100h data stack
0000                LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
0000                PROG:     EQU   8300h   ; where the loader puts the program text
0000                HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
0000                BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-ANSI)   
                                 ; ---- generic machine with ANSI = 0: the console codes call these ------------
                    CONAT:    EQU   0FF0Ch   ; `@  cursor to row E, column L, both from 0
                                 ;     (DE and HL hold the whole cells). May
                                 ;     change A, DE and HL
                    CONCLS:   EQU   0FF0Fh   ; `^  clear the screen and home the cursor
                    CONEOL:   EQU   0FF12h   ; `_  clear from the cursor to the end of the line
                    CONCUR:   EQU   0FF15h   ; `?  cursor off if A = 0 (the zero flag is set
                                 ;     to match), on if not. May change A, DE, HL
                                 ;   All four must preserve BC and HL'; CONCLS and CONEOL also DE and HL.
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)   
                    EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                          ENDIF      
0000                          IF   EDGEN   
0000                LEAVE:    EQU   0FF09h   ; where the editor's ^X goes
0000                          ENDIF      
0000                          IF   EDITOR*CPM   
                    LEAVE:    EQU   0000h   ; the editor's ^X: warm boot
0000                          ENDIF      
0000                          IF   EDITOR   
0000                EXIT:     EQU   edend   ; a program that ends goes back to the editor,
0000                SKEND:    EQU   skend   ;   also when it ends inside skip
0000                          ENDIF      
0000                          IF   1-EDITOR   
                    SKEND:    EQU   EXIT   
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine. (The wait
0000                             ; for a second Ctrl-C uses it too: 250 ms.)
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                             ;   around machine code;
0000                NPEND:    EQU   LET+38h   ;   minus the address of the program's end
0000                             ;   (the heap"s first byte), for the checked "_';
0000                EDLN:     EQU   LET+3Ah   ;   the editor: the number of the line that ^E
0000                             ;   put in the input line (0: none)
0000                SEED:     EQU   LET+76h   ; gap after z: the random seed, the cell whose
0000                             ;   address `. gives. Nothing sets it at the
0000                             ;   start but the checked build's clearing;
0000                KEYBUF:   EQU   LET+7Ah   ;   a key read by the break check and
0000                             ;   held for the next "?" (0: none);
0000                BRKOFF:   EQU   LET+7Bh   ;   the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                LBHDR:    EQU   LET+7Eh   ; CP/M BDOS 10 header: max, count
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FCh   ; empty data stack. The four bytes above it
0000                             ; are spare: a character can pop two cells
0000                             ; too many before the checked build sees it,
0000                             ; and the next call must not land on the
0000                             ; letter cells.
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is the start of the .COM file, and 0108h-0133h is also copied to
0000                             ;  page zero (see the header).
0000                             ; =============================================================================
0000                          .ORG   BASE   
0000                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              XOR   A   ; 00  reset. (This byte, AFh, is also what an
0000                          ENDIF      ;     undefined word runs into: see e_hi.)
0000                          IF   1-EDGEN   
                              LD   SP,DSTOP   ; 00  reset, or the start of the .COM file
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)   
                              LD   BC,PROG   ; 03  the IP
                              JR   st0   ; 06  (the rest of the startup is close by)
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              JR   init   ; 04  (the rest of the startup is close by)
                              DW   0   ; 06  spare
0000                          ENDIF      
0000                          IF   EDGEN   
0000   AF                     XOR   A   ; 00  reset: no program yet. (This byte, AFh,
0001   32 00 83               LD   (PROG),A   ;     is also what an undefined word runs
0004   C3 42 05               JP   init   ; 04  into in the checked build: see e_hi.)
0007   00                     NOP      ; 07  spare
0008                          ENDIF      
0008                          IF   CPM   
                              JP   start   ; 03
                              DW   0   ; 06  spare
0008                          ENDIF      
0008                VECS:        
0008                             ; ---- RST 08h: rpop: pop the return stack into DE ---------------------------
0008   D9           RPOP:     EXX      ; 08
0009   5E                     LD   E,(HL)   
000A   23                     INC   HL   
000B   56                     LD   D,(HL)   
000C   23                     INC   HL   
000D   D5                     PUSH   DE   ; across to the main registers
000E   D9                     EXX      
000F   D1                     POP   DE   
0010   C9                     RET      ; 10  (so RST 10h is not used)
0011                             ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
0011   C6 21        CTL:      ADD   A,21h   ; 11  back to c; zero only for NUL
0013   20 1C                  JR   NZ,next0   ;     the rest are ignored
0015   C3 87 05     ENDPROG:   JP   EXIT   ;     the program has ended
0018                             ; ---- RST 18h: drop TOS, then next ------------------------------------------
0018   D1           RST18:    POP   DE   ; 18  discard the RST's return address
0019   E1                     POP   HL   ;     new TOS = NOS
001A   18 15                  JR   nx   
001C   E5           H_FROMR:   PUSH   HL   ; 1C  "}" return stack to TOS
001D   CF                     RST   08h   
001E   EB                     EX   DE,HL   
001F   F7                     RST   30h   
0020                             ; ---- RST 20h: neg16: HL = -HL (keeps BC, DE) -------------------------------
0020   AF           NEG16:    XOR   A   ; 20
0021   95                     SUB   L   
0022   6F                     LD   L,A   
0023   9F                     SBC   A,A   
0024   94                     SUB   H   
0025   67                     LD   H,A   
0026   C9                     RET      
0027   00                     NOP      ; 27  spare
0028                             ; ---- RST 28h: putc: print A (keeps BC, DE, HL, HL') ------------------------
0028                RST28:       
0028                          IFN   CPM   
0028   C3 03 FF     PUTC:     JP   CONOUT   ; 28
002B                          ENDIF      
002B                          IF   CPM   
                              JP   putc   ; 28
002B                          ENDIF      
002B   E9           JPHL:     JP   (HL)   ; 2B  (for the machine-code call)
002C   E3           H_TOR:    EX   (SP),HL   ; 2C  "{" TOS to the return stack: the new TOS
002D   C3 B7 00               JP   rpushn   ;     comes up, the old one goes across
0030                             ; ---- RST 30h: next character -----------------------------------------------
0030   D1           RST30:    POP   DE   ; 30  discard the RST's return address
0031                NX:          
0031                          IF   CPM   
                              JP   next0   ; (this copy runs in page zero)
0031                          ENDIF      
0031                VECEND:      
0031                             ; =============================================================================
0031                             ;  The inner loop: read one character and sort it by range.
0031                             ; 
0031                             ;    00h          end of program
0031                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0031                             ;    30h-39h      digit: read a whole number
0031                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0031                             ;    61h-7Ah      a-z: push the address of that letter's cell
0031                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0031                             ; =============================================================================
0031                NEXT0:       
0031                          IF   CHECKED   
0031   CD F1 03               CALL   chkstk   ; both stacks are checked once per character
0034                          ENDIF      
0034   0A                     LD   A,(BC)   
0035   03                     INC   BC   
0036   D6 21                  SUB   21h   ; A = c - 21h
0038   38 D7                  JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
003A   FE 0F                  CP   0Fh   
003C   38 25                  JR   C,punct   ; 21h-2Fh: PTAB index 0-14
003E   D6 0F                  SUB   0Fh   ; A = c - 30h
0040   FE 0A                  CP   0Ah   
0042   38 5D                  JR   C,digit   ; 30h-39h
0044   FE 11                  CP   11h   
0046   38 19                  JR   C,p3a   ; 3Ah-40h
0048   D6 11                  SUB   11h   ; A = c - 41h
004A   FE 1A                  CP   1Ah   
004C   38 5F                  JR   C,upper   ; 41h-5Ah: A = letter index 0-25
004E   FE 20                  CP   20h   
0050   38 0D                  JR   C,p5b   ; 5Bh-60h
0052   FE 3A                  CP   3Ah   
0054   38 51                  JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0056   FE 3E                  CP   3Eh   
0058                          IF   1-CHECKED   
                              JR   NC,next0   ; 7Fh-FFh: ignored
0058                          ENDIF      
0058                          IF   CHECKED   
0058   28 D7                  JR   Z,next0   ; 7Fh, DEL: ignored
005A   D2 1D 04               JP   NC,e_hi   ; 80h-FFh: reserved
005D                          ENDIF      
005D   D6 1A                  SUB   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
005F   D6 09        P5B:      SUB   9   ; 5Bh-60h: -4 in all, index 22-27
0061   C6 05        P3A:      ADD   A,5   ; 3Ah-40h: index 15-21
0063                .macro PTABLE,
0063                             ; 
0063                 DB      h_store & 0FFh  ; !
0063                 DB      h_str & 0FFh    ; "
0063                 DB      h_num & 0FFh    ; #
0063                 DB      h_print & 0FFh  ; $
0063                 DB      h_swap & 0FFh   ; %
0063                 DB      h_and & 0FFh    ; &
0063                 DB      h_emit & 0FFh   ; '
0063                 DB      h_open & 0FFh   ; (
0063                 DB      h_close & 0FFh  ; )
0063                 DB      h_mul & 0FFh    ; *
0063                 DB      h_add & 0FFh    ; +
0063                 DB      h_cfetch & 0FFh ; ,
0063                 DB      h_sub & 0FFh    ; -
0063                 DB      h_cstore & 0FFh ; .
0063                 DB      h_div & 0FFh    ; /
0063                 DB      h_dup & 0FFh    ; :
0063                 DB      h_drop & 0FFh   ; ;
0063                 DB      h_lt & 0FFh     ; <
0063                 DB      h_eq & 0FFh     ; =
0063                 DB      h_gt & 0FFh     ; >
0063                 DB      h_key & 0FFh    ; ?
0063                 DB      h_fetch & 0FFh  ; @
0063                 DB      h_def & 0FFh    ; [
0063                 DB      h_break & 0FFh  ; \
0063                 DB      h_ret & 0FFh    ; ]
0063                 DB      h_xor & 0FFh    ; ^
0063                 DB      h_alloc & 0FFh  ; _
0063                 DB      h_grave & 0FFh  ; `
0063                 DB      h_tor & 0FFh    ; {
0063                 DB      h_or & 0FFh     ; |
0063                 DB      h_fromr & 0FFh  ; }
0063                 DB      h_not & 0FFh    ; ~
0063                .endm
0063                 
0063                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
0063                             ; untouched, and A, DE free.
0063   C6 81        PUNCT:    ADD   A,PTAB & 0FFh   ; PTAB never crosses a page
0065   5F                     LD   E,A   
0066   16 03                  LD   D,PTAB / 256   ; (0 if the table is in page zero)
0068   FE 97                  CP   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
006A   1A                     LD   A,(DE)   
006B   5F                     LD   E,A   ; the handler's low byte
006C                          IF   (1-CPM)*(1-TABP0)   
006C   16 00                  LD   D,0   
006E                          ENDIF      
006E                          IFN   CPM   
006E   CB 12                  RL   D   ; its page: 0 + carry
0070                          ENDIF      
0070                          IF   CPM   
                              LD   D,1   
                              JR   NC,pu1   
                              INC   D   ; its page: 1 + carry
                    PU1:         
0070                          ENDIF      
0070   D5                     PUSH   DE   ; jump to it; the stack is balanced again
0071   C9                     RET      ;   when the handler starts
0072                             ; The rest of the startup: here so that the generic reset code can reach it
0072                             ; with JR. st0: find the program's NUL; the heap starts after it.
0072                             ; (The editor build has its own copy of this, next to the editor.)
0072                             ; A checked build first clears the lower half of the letter page (A = 0):
0072                             ; every variable starts at 0, every word cell holds 0000h, the address an
0072                             ; undefined word is caught at (see e_hi), and no key is held back.
0072                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                    INIT:     LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
                              LD   BC,PROG   ; the IP
0072                          ENDIF      
0072                          IF   (1-CPM)*(1-EDITOR)   
                    ST0:      LD   H,B   
                              LD   L,C   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
0072                          ENDIF      
0072                          IF   1-EDITOR   
                    ST2:      LD   (HEAP),HL   
0072                          ENDIF      
0072                          IF   CHECKED*(1-EDITOR)   
                              RST   20h   ; minus the heap"s first address: "_' may not
                              LD   (NPEND),HL   ;   release below it
0072                          ENDIF      
0072                          IF   (1-CHECKED)*(1-EDITOR)*(1-CPM)   
                              LD   H,A   ; (A = 0) no key is held, and the break key
                              LD   L,A   ;   is on (the checked build has cleared
0072                          ENDIF      ;   these)
0072                          IF   (1-CHECKED)*(1-EDITOR)*CPM   
                              LD   HL,0   
0072                          ENDIF      
0072                          IF   (1-CHECKED)*(1-EDITOR)   
                              LD   (KEYBUF),HL   
0072                          ENDIF      
0072                          IF   1-EDITOR   
                              EXX      
                              LD   HL,RSTOP   ; the return stack is empty
                              EXX      
                              RST   30h   ; (its return address is thrown away)
0072                          ENDIF      
0072                             ; In the unchecked generic editor build the table is here, in the first
0072                             ; page, which saves loading D twice. (The other builds have no room for it
0072                             ; here: theirs is further down.)
0072                          IF   TABP0   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0072                          ENDIF      
0072                             ; =============================================================================
0072                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
0072                             ;  (00bbIGFuZCA= are up among the RST routines.) The machine-code call, exec,
0072                             ;  is here too: it belongs to "`" and makes the page come out right.
0072                             ; =============================================================================
0072   D1           H_XOR:    POP   DE   
0073   7C                     LD   A,H   
0074   AA                     XOR   D   
0075   67                     LD   H,A   
0076   7D                     LD   A,L   
0077   AB                     XOR   E   
0078   6F                     LD   L,A   
0079   F7                     RST   30h   
007A   D1           H_OR:     POP   DE   
007B   7C                     LD   A,H   
007C   B2                     OR   D   
007D   67                     LD   H,A   
007E   7D                     LD   A,L   
007F   B3                     OR   E   
0080   6F                     LD   L,A   
0081   F7                     RST   30h   
0082   E7           H_NOT:    RST   20h   ; ~x = -x - 1
0083   2B                     DEC   HL   
0084   F7                     RST   30h   
0085                             ; "_" ( n -- addr ): the heap pointer moves by n, a signed count (the add is
0085                             ; the same either way); TOS is the old pointer.
0085   ED 5B 7C 82  H_ALLOC:   LD   DE,(HEAP)   
0089                          IF   CHECKED*CPM   
                              LD   A,H   ; the count's sign, for chkhp
0089                          ENDIF      
0089   19                     ADD   HL,DE   ; the new top
008A                          IF   CHECKED   
008A   CD 27 04               CALL   chkhp   
008D                          ENDIF      
008D   22 7C 82               LD   (HEAP),HL   
0090   EB                     EX   DE,HL   
0091   F7                     RST   30h   
0092   D9           EXEC:     EXX      
0093   22 34 82               LD   (RSAVE),HL   ; machine code may change the alternates
0096   D9                     EXX      
0097   CD 2B 00               CALL   jphl   
009A   D9                     EXX      
009B   2A 34 82               LD   HL,(RSAVE)   
009E   D9                     EXX      
009F   E1                     POP   HL   
00A0   F7                     RST   30h   
00A1                             ; ---- the letters and digits (here, in the middle, so that the inner loop's
00A1                             ; ---- short jumps reach them, and the handlers after them reach rpushn) ------
00A1                             ; Digits: step back onto the first digit and read the whole number.
00A1   E5           DIGIT:    PUSH   HL   
00A2   0B                     DEC   BC   
00A3   CD 34 02               CALL   rdnum   
00A6   F7                     RST   30h   
00A7                             ; a-z: push the cell's address (the cell is the variable)
00A7   E5           LOWER:    PUSH   HL   
00A8   87                     ADD   A,A   
00A9   6F                     LD   L,A   
00AA   26 82                  LD   H,LETPAGE   
00AC   F7                     RST   30h   
00AD                             ; A-Z: call the word. The return address (the IP after the letter) goes on
00AD                             ; the return stack, and the IP becomes the address in the letter's cell.
00AD   C5           UPPER:    PUSH   BC   ; the return address, for rpushn
00AE   EB                     EX   DE,HL   ; park TOS
00AF   87                     ADD   A,A   
00B0   6F                     LD   L,A   
00B1   26 82                  LD   H,LETPAGE   ; HL -> cell
00B3   4E                     LD   C,(HL)   
00B4   2C                     INC   L   
00B5   46                     LD   B,(HL)   ; IP = the word's body
00B6   EB                     EX   DE,HL   ; TOS back, and fall into rpushn
00B7                             ; rpushn: move the top cell of the data stack (in memory) to the return
00B7                             ; stack, then next. Everything that pushes the return stack ends here.
00B7                             ; 
00B7                             ; The break key is looked at here, so at every word call and loop-back (and
00B7                             ; block entry and "{"), but only one time in 256: B', which nothing else
00B7                             ; uses, counts them. Reading the keyboard can be slow (it is a BDOS call
00B7                             ; under CP/M), and this way it costs a loop four bytes and 14 T-states.
00B7                             ; (DEC B, not DJNZ: its zero flag lasts through the EXX, so one EXX serves
00B7                             ; both ways out.)
00B7   D9           RPUSHN:   EXX      
00B8   D1                     POP   DE   
00B9   2B                     DEC   HL   
00BA   72                     LD   (HL),D   
00BB   2B                     DEC   HL   
00BC   73                     LD   (HL),E   
00BD   05                     DEC   B   
00BE   D9                     EXX      
00BF   CC B3 03               CALL   Z,pollk   
00C2   F7                     RST   30h   
00C3                             ; ---- the grave -------------------------------------------------------------
00C3                             ; The grave is a prefix: with the character after it, it is one command.
00C3                             ; The characters are tested one after another, each SUB taking off the step
00C3                             ; from the one before, so A is 0 (and the carry clear) when a handler is
00C3                             ; reached. Two are here, where they keep the first page as full as the
00C3                             ; layout needs; grave2 has the rest.
00C3                             ; 
00C3                             ;   `!  ( addr -- )  calls the machine code at TOS. The code is entered by
00C3                             ;       CALL with the data stack above the return address; it must keep BC,
00C3                             ;       and on return the top cell becomes the new TOS.
00C3                             ;   `'  ( -- )  new line: CR LF
00C3   0A           H_GRAVE:   LD   A,(BC)   
00C4   03                     INC   BC   
00C5   D6 21                  SUB   "!"   
00C7   28 C9                  JR   Z,exec   
00C9   D6 06                  SUB   27h-"!"   ; "'"
00CB   C2 E7 02               JP   NZ,grave2   
00CE   3E 0D                  LD   A,13   
00D0   EF                     RST   28h   
00D1   3E 0A                  LD   A,10   
00D3   EF                     RST   28h   
00D4   F7                     RST   30h   
00D5                             ; ---- where the two pages meet ----------------------------------------------
00D5                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
00D5                             ; are in falling code order for this), and where exactly differs between the
00D5                             ; builds: NPG1 follows. Every handler below these four must start in the
00D5                             ; second page, and every one above in the first; chktab.py checks both.
00D5                             ; "]" returns: pop an address and jump to it.
00D5   CF           H_RET:    RST   08h   
00D6   42                     LD   B,D   
00D7   4B                     LD   C,E   
00D8   F7           BRK1:     RST   30h   
00D9                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
00D9                             ; drops the block start, "]" returns. No closer at all ends the program.
00D9   7C           H_BREAK:   LD   A,H   
00DA   B5                     OR   L   
00DB   E1                     POP   HL   
00DC   28 FA                  JR   Z,brk1   
00DE   CD 5B 02               CALL   skip   
00E1   B7                     OR   A   ; skip returns 0 for ")"
00E2   20 F1                  JR   NZ,h_ret   
00E4   CF           RDROP:    RST   08h   
00E5   F7                     RST   30h   
00E6                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
00E6                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
00E6                             ; the body"s address instead. Either way it then skips to the matching "]'.
00E6                             ; (The unchecked build takes anything that is not a letter as the space; the
00E6                             ; checked build stops on it.)
00E6   0A           H_DEF:    LD   A,(BC)   
00E7   03                     INC   BC   
00E8   D6 41                  SUB   "A"   ; a letter gives 0-25 or 32-57: lowercase
00EA   5F                     LD   E,A   ;   lands 64 bytes up
00EB   E6 DF                  AND   0DFh   ; fold case
00ED   FE 1A                  CP   26   
00EF   30 0B                  JR   NC,def2   ; not a letter
00F1   CB 23                  SLA   E   
00F3   16 82                  LD   D,LETPAGE   ; DE -> cell
00F5   79                     LD   A,C   
00F6   12                     LD   (DE),A   
00F7   1C                     INC   E   
00F8   78                     LD   A,B   
00F9   12                     LD   (DE),A   
00FA   18 09                  JR   skipnx   
00FC                DEF2:        
00FC                          IF   CHECKED   
00FC   7B                     LD   A,E   
00FD   FE DF                  CP   " "-"A"+256   
00FF   C2 59 04               JP   NZ,e_brack   ; anything but a letter or a space
0102                          ENDIF      
0102   E5                     PUSH   HL   ; an anonymous block: push its address
0103   60                     LD   H,B   
0104   69                     LD   L,C   
0105                SKIPNX:      
0105                          IF   CHECKED   
0105   0B                     DEC   BC   ; back onto the letter, so that skip finds its
0106                          ENDIF      ;   opener, the "[", just before where it starts
0106   CD 5B 02     SKIPO:    CALL   skip   
0109   F7                     RST   30h   
010A   5E           H_FETCH:   LD   E,(HL)   ; "@"
010B   23                     INC   HL   
010C   56                     LD   D,(HL)   
010D   EB                     EX   DE,HL   
010E   F7                     RST   30h   
010F                             ; =============================================================================
010F                             ;  Handlers that must start in the image's second page.
010F                             ;  "?" is the last (with "," inside it), so its long tail may run past that
010F                             ;  page.
010F                             ; =============================================================================
010F                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
010F                             ; the matching ")".
010F   7C           H_OPEN:   LD   A,H   
0110   B5                     OR   L   
0111   E1                     POP   HL   
0112   28 F2                  JR   Z,skipo   
0114   C5                     PUSH   BC   ; the block starts at the IP
0115   18 A0                  JR   rpushn   
0117                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
0117                             ; drops it and carries on.
0117   7C           H_CLOSE:   LD   A,H   
0118   B5                     OR   L   
0119   E1                     POP   HL   
011A   28 C8                  JR   Z,rdrop   
011C   CF                     RST   08h   ; pop the block start ...
011D   42                     LD   B,D   
011E   4B                     LD   C,E   
011F   C5                     PUSH   BC   
0120   18 95                  JR   rpushn   ; ... and push it back
0122                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
0122                             ; "-" has two jobs: directly before a digit it starts a negative number.
0122   0A           H_SUB:    LD   A,(BC)   
0123   D6 30                  SUB   "0"   
0125   FE 0A                  CP   10   
0127   38 04                  JR   C,negnum   
0129   E7                     RST   20h   ; a - b = a + (-b): fall into "+"
012A   D1           H_ADD:    POP   DE   
012B   19                     ADD   HL,DE   
012C   F7                     RST   30h   
012D   E5           NEGNUM:   PUSH   HL   ; a negative number: read it, negate it
012E   CD 34 02               CALL   rdnum   
0131   E7                     RST   20h   
0132   F7                     RST   30h   
0133   D1           H_AND:    POP   DE   
0134   7C                     LD   A,H   
0135   A2                     AND   D   
0136   67                     LD   H,A   
0137   7D                     LD   A,L   
0138   A3                     AND   E   
0139   6F                     LD   L,A   
013A   F7                     RST   30h   
013B                             ; Signed compares. Both are "HL < DE" for the right pair: "<" swaps the two
013B                             ; cells first. Flipping both sign bits turns a signed compare into an
013B                             ; unsigned one (and XOR clears the carry for SBC); SBC HL,HL then turns the
013B                             ; carry into -1 or 0 with no branch.
013B   E3           H_LT:     EX   (SP),HL   ; a < b: HL = a, and b is popped next
013C   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
013D   7C                     LD   A,H   
013E   EE 80                  XOR   80h   
0140   67                     LD   H,A   
0141   7A                     LD   A,D   
0142   EE 80                  XOR   80h   
0144   57                     LD   D,A   
0145   ED 52                  SBC   HL,DE   ; carry if HL < DE
0147   ED 62        TF:       SBC   HL,HL   ; carry -> -1 or 0
0149   F7                     RST   30h   
014A   D1           H_EQ:     POP   DE   
014B   B7                     OR   A   
014C   ED 52                  SBC   HL,DE   
014E   7C                     LD   A,H   
014F   B5                     OR   L   
0150   FE 01                  CP   1   ; carry only if a - b = 0
0152   18 F3                  JR   tf   
0154                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept. The
0154                             ; multiplier shifts up through A:C.
0154   D1           H_MUL:    POP   DE   ; DE = multiplicand
0155   C5                     PUSH   BC   
0156   7C                     LD   A,H   
0157   4D                     LD   C,L   ; A:C = multiplier
0158   21 00 00               LD   HL,0   
015B   06 10                  LD   B,16   
015D   29           MUL1:     ADD   HL,HL   
015E   CB 21                  SLA   C   
0160   17                     RLA      
0161   30 01                  JR   NC,mul2   
0163   19                     ADD   HL,DE   
0164   10 F7        MUL2:     DJNZ   mul1   
0166   C1                     POP   BC   
0167   F7                     RST   30h   
0168                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
0168                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
0168                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
0168                             ; stops on it.
0168                H_DIV:       
0168                          IF   CHECKED   
0168   7C                     LD   A,H   
0169   B5                     OR   L   
016A   CA 56 04               JP   Z,e_zero   
016D                          ENDIF      
016D   D1                     POP   DE   ; DE = a, HL = b
016E   C5                     PUSH   BC   ; free BC for udiv
016F   D5                     PUSH   DE   ; a, for r's sign
0170   7A                     LD   A,D   
0171   AC                     XOR   H   
0172   F5                     PUSH   AF   ; S flag = sign of q
0173   CB 7C                  BIT   7,H   
0175   C4 20 00               CALL   NZ,neg16   ; HL = |b|
0178   EB                     EX   DE,HL   
0179   CB 7C                  BIT   7,H   
017B   C4 20 00               CALL   NZ,neg16   ; HL = |a|, DE = |b|
017E   CD 0E 02               CALL   udiv   ; HL = q, DE = r
0181   F1                     POP   AF   
0182   FC 20 00               CALL   M,neg16   ; q's sign
0185   EB                     EX   DE,HL   ; HL = r, DE = q
0186   F1                     POP   AF   ; A = a's high byte
0187   B7                     OR   A   
0188   FC 20 00               CALL   M,neg16   ; r's sign
018B   C1                     POP   BC   
018C   D5                     PUSH   DE   ; q under r
018D   F7                     RST   30h   
018E                             ; ---- stack and storage -----------------------------------------------------
018E   E5           H_DUP:    PUSH   HL   ; ":"
018F   F7                     RST   30h   
0190   E3           H_SWAP:   EX   (SP),HL   ; "%"
0191   F7                     RST   30h   
0192                             ; (The checked build tests the address before it takes the value off the
0192                             ; stack, so that an error report shows both.)
0192                H_CSTORE:      ; "." ( c addr -- )
0192                          IF   CHECKED   
0192   CD 3C 04               CALL   chkst   
0195                          ENDIF      
0195   D1                     POP   DE   
0196   73                     LD   (HL),E   
0197   DF           H_DROP:   RST   18h   ; ";" is this one byte
0198                H_STORE:      ; "!" ( n addr -- )
0198                          IF   CHECKED   
0198   CD 3C 04               CALL   chkst   
019B                          ENDIF      
019B   D1                     POP   DE   
019C   73                     LD   (HL),E   
019D   23                     INC   HL   
019E   72                     LD   (HL),D   
019F   DF                     RST   18h   
01A0                             ; ---- console ---------------------------------------------------------------
01A0                             ; 22h pushes the address of the text after it and skips the string.
01A0   E5           H_STR:    PUSH   HL   
01A1   60                     LD   H,B   
01A2   69                     LD   L,C   
01A3   CD 4A 02               CALL   skipstr   
01A6                          IF   CHECKED   
01A6   B7                     OR   A   ; 0: the text ran out before the closing quote
01A7   CA 4E 04               JP   Z,e_quote   
01AA                          ENDIF      
01AA   F7                     RST   30h   
01AB                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character
01AB                             ; clears that character"s bit 6 (/M is CR, /` is space; "/" and ""' have no
01AB                             ; bit 6, so // and /" give themselves).
01AB                          IF   (1-CHECKED)*(1-EDITOR)   
                    H_PRINT:   LD   A,(HL)   
                              INC   HL   
                              CP   22h   
                              JR   Z,pr9   
                              CP   "/"   
                              JR   NZ,pr1   
                              LD   A,(HL)   
                              INC   HL   
                              AND   0BFh   
                    PR1:      RST   28h   
                              JR   h_print   
01AB                          ENDIF      
01AB                          IF   CHECKED   
01AB                             ; (The checked build has the loop as a routine, prstr, which the error
01AB                             ; report uses too. The address is kept on the stack meanwhile: a report
01AB                             ; shows the stack as it was before the "$".)
01AB   E5           H_PRINT:   PUSH   HL   
01AC   CD 1C 05               CALL   prstr   
01AF   D1                     POP   DE   
01B0   DF                     RST   18h   
01B1                          ENDIF      
01B1                          IF   (1-CHECKED)*EDITOR   
                                 ; (With the editor the loop is a routine, prstr, which ^V uses too.)
                    H_PRINT:   CALL   prstr   
                              RST   18h   
01B1                          ENDIF      
01B1   7D           H_EMIT:   LD   A,L   ; "'"
01B2   EF                     RST   28h   
01B3   DF           PR9:      RST   18h   
01B4                             ; "#" prints TOS as a signed decimal number, with no space after it.
01B4   C5           H_NUM:    PUSH   BC   
01B5   CD 98 02               CALL   psgn   
01B8   C1                     POP   BC   
01B9   DF                     RST   18h   
01BA                             ; "?" ( n -- c ) or ( -n -- addr )
01BA                             ;   n > 0: wait about n ms for a key; 0 if none came
01BA                             ;   n = 0: wait for a key
01BA                             ;          (both stir the random seed while they wait: see kt2)
01BA                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
01BA                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
01BA   CB 7C        H_KEY:    BIT   7,H   
01BC   20 22                  JR   NZ,line   
01BE   1E 28        KT1:      LD   E,MSLOOP   ; one millisecond, roughly
01C0   CD E1 03     KT2:      CALL   getk   
01C3   20 17                  JR   NZ,kt3   
01C5   1D                     DEC   E   
01C6   20 F8                  JR   NZ,kt2   
01C8   EB                     EX   DE,HL   ; a millisecond with no key stirs the random
01C9   2A 76 82               LD   HL,(SEED)   ;   seed by one: how long a key takes to come
01CC   23                     INC   HL   ;   is the one thing here that is not the
01CD   22 76 82               LD   (SEED),HL   ;   same every time
01D0   EB                     EX   DE,HL   
01D1   7C                     LD   A,H   ; 0? never counts down: it waits
01D2   B5                     OR   L   
01D3   28 E9                  JR   Z,kt1   
01D5   2B                     DEC   HL   
01D6   7C                     LD   A,H   
01D7   B5                     OR   L   
01D8   20 E4                  JR   NZ,kt1   ; A = 0 if the time ran out
01DA   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
01DB   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
01DC   6F           KT3:      LD   L,A   
01DD   26 00                  LD   H,0   
01DF   F7                     RST   30h   
01E0                          IF   CPM   
                                 ; CP/M: BDOS 10 does the editing (the spec allows the platform's
                                 ; own line editor). It doesn't store the CR, so it is added here.
                    LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
                              ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
                              SBC   A,A   
                              AND   L   ; (0 for a count that is too big)
                              XOR   127   ; A = the count, 127 at most
                              LD   (LBHDR),A   
                              LD   DE,LBHDR   
                              LD   A,10   
                              CALL   bdosx   
                              LD   HL,LBHDR+1   
                              LD   A,(HL)   ; the count typed (0-127)
                              INC   L   ; HL = LINEBUF, whose low byte is 80h:
                              ADD   A,L   ;   adding the count to L can't carry
                              LD   L,A   
                              LD   (HL),13   
01E0                          ENDIF      
01E0                          IFN   CPM   
01E0                             ; Generic: Backspace takes the last character back (and is echoed as
01E0                             ; it is), CR ends (stored, not echoed), every other key is stored and
01E0                             ; echoed until the line is full. The line buffer starts at offset 80h
01E0                             ; of its page, so L alone is the place in the line: D holds the L of
01E0                             ; a full line.
01E0   11 7F 00     LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
01E3   19                     ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
01E4   9F                     SBC   A,A   
01E5   A5                     AND   L   ; (0 for a count that is too big)
01E6   2F                     CPL      
01E7   57                     LD   D,A   ; D = the L of a full line: 80h + count, FFh
01E8                             ;   at most
01E8   21 80 82               LD   HL,LINEBUF   
01EB   CD E1 03     LN2:      CALL   getk   
01EE   28 FB                  JR   Z,ln2   
01F0   FE 0D                  CP   13   
01F2   28 16                  JR   Z,ln5   
01F4   FE 08                  CP   8   
01F6   28 0B                  JR   Z,ln4   
01F8   5F                     LD   E,A   
01F9   7D                     LD   A,L   
01FA   BA                     CP   D   
01FB   28 EE                  JR   Z,ln2   ; full
01FD   73                     LD   (HL),E   
01FE   2C                     INC   L   
01FF   7B                     LD   A,E   
0200   EF           LN3:      RST   28h   
0201   18 E8                  JR   ln2   
0203   2D           LN4:      DEC   L   ; Backspace: one back, and echo it,
0204   FA 00 02               JP   M,ln3   ;   unless the line was empty (L left the
0207   2C                     INC   L   ;   upper half of the page)
0208   18 E1                  JR   ln2   
020A   77           LN5:      LD   (HL),A   ; the CR
020B                          ENDIF      
020B   2E 80                  LD   L,LINEBUF & 0FFh   
020D   F7                     RST   30h   
020E                             ; =============================================================================
020E                             ;  More routines (no handler starts past this point)
020E                             ; =============================================================================
020E                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
020E                             ; Uses A, BC; the caller saves the IP. The dividend shifts up through A:C
020E                             ; while the quotient bits arrive at the bottom of C.
020E                             ; Dividing by 2 is one shift (the spec wants that fast).
020E   7B           UDIV:     LD   A,E   
020F   EE 02                  XOR   2   
0211   B2                     OR   D   
0212   20 07                  JR   NZ,udv0   
0214   CB 3C                  SRL   H   
0216   CB 1D                  RR   L   ; the quotient
0218   8F                     ADC   A,A   
0219   5F                     LD   E,A   ; the remainder: the bit that fell out (D is 0)
021A   C9                     RET      
021B   7C           UDV0:     LD   A,H   
021C   4D                     LD   C,L   
021D   21 00 00               LD   HL,0   
0220   06 10                  LD   B,16   
0222   CB 21        UDV1:     SLA   C   
0224   17                     RLA      
0225   ED 6A                  ADC   HL,HL   
0227   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
0229   30 02                  JR   NC,udv2   ;   always fits in 16 bits
022B   19                     ADD   HL,DE   ; too much: put it back, and cancel the
022C   0D                     DEC   C   ;   INC below
022D   0C           UDV2:     INC   C   ; a quotient bit
022E   10 F2                  DJNZ   udv1   
0230   EB                     EX   DE,HL   ; DE = remainder
0231   67                     LD   H,A   
0232   69                     LD   L,C   ; HL = quotient
0233   C9                     RET      
0234                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
0234                             ; non-digit. Values wrap at 16 bits, as the spec says.
0234   21 00 00     RDNUM:    LD   HL,0   
0237   0A           RDN1:     LD   A,(BC)   
0238   D6 30                  SUB   "0"   
023A   FE 0A                  CP   10   
023C   D0                     RET   NC   
023D   03                     INC   BC   
023E   54                     LD   D,H   
023F   5D                     LD   E,L   
0240   29                     ADD   HL,HL   
0241   29                     ADD   HL,HL   
0242   19                     ADD   HL,DE   
0243   29                     ADD   HL,HL   ; HL * 10
0244   5F                     LD   E,A   
0245   16 00                  LD   D,0   
0247   19                     ADD   HL,DE   
0248   18 ED                  JR   rdn1   
024A                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
024A                             ; the next character, so "/"" does not end it. Leaves A = 22h.
024A                          IF   1-CHECKED   
                    SS0:      INC   BC   
                    SKIPSTR:   LD   A,(BC)   
                              INC   BC   
                              CP   "/"   
                              JR   Z,ss0   
                              CP   22h   
                              JR   NZ,skipstr   
                              RET      
024A                          ENDIF      
024A                          IF   CHECKED   
024A                             ; The checked build never steps over a NUL: if the text runs out first it
024A                             ; returns A = 0 with the IP on the NUL.
024A   0A           SKIPSTR:   LD   A,(BC)   
024B   B7                     OR   A   
024C   C8                     RET   Z   
024D   03                     INC   BC   
024E   FE 22                  CP   22h   
0250   C8                     RET   Z   
0251   FE 2F                  CP   "/"   
0253   20 F5                  JR   NZ,skipstr   
0255   0A                     LD   A,(BC)   ; the escaped character
0256   B7                     OR   A   
0257   C8                     RET   Z   
0258   03                     INC   BC   
0259   18 EF                  JR   skipstr   
025B                          ENDIF      
025B                             ; skip: read past text to the closer at this level, and return A = 0 if it
025B                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
025B                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
025B                             ; no closer; anything else that runs into the NUL had unbalanced brackets
025B                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
025B                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
025B                             ; 
025B                             ; The checked build also looks at the character the skip was started by,
025B                             ; which is always the one just before where it starts: "(" must end at ")",
025B                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
025B                             ; quote counts as running into it. "\" takes either closer. IX keeps the
025B                             ; place where the skip started, for the report.
025B                SKIP:        
025B                          IF   CHECKED   
025B   C5                     PUSH   BC   
025C   DD E1                  POP   IX   
025E   0B                     DEC   BC   
025F   0A                     LD   A,(BC)   
0260   03                     INC   BC   
0261   5F                     LD   E,A   ; E = the opener: ( [ or \
0262                          ENDIF      
0262   16 00                  LD   D,0   
0264   14           SK3:      INC   D   ; an opener: one deeper
0265   0A           SK1:      LD   A,(BC)   
0266                          IF   1-CHECKED   
                              INC   BC   
                              OR   A   
                              JP   Z,SKEND   ; (the end of the program)
0266                          ENDIF      
0266                          IF   CHECKED   
0266   B7                     OR   A   
0267   28 22                  JR   Z,sk6   ; (the IP stays on the NUL)
0269   03                     INC   BC   
026A                          ENDIF      
026A   FE 22                  CP   22h   
026C   CC 4A 02               CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
026F   D6 28                  SUB   "("   ;   (or 0, and then the NUL is read next)
0271   28 F1                  JR   Z,sk3   
0273   3D                     DEC   A   ; ")"
0274   28 08                  JR   Z,sk4   
0276   D6 32                  SUB   "["-")"   
0278   28 EA                  JR   Z,sk3   
027A   FE 02                  CP   "]"-"["   
027C   20 E7                  JR   NZ,sk1   
027E   15           SK4:      DEC   D   
027F                          IF   1-CHECKED   
                              RET   Z   ; the closer at this level
                              JR   sk1   
027F                          ENDIF      
027F                          IF   CHECKED   
027F   20 E4                  JR   NZ,sk1   
0281   57                     LD   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
0282   AB                     XOR   E   ;   opener is 0 for "(" and 1 for "[", and only
0283   E6 06                  AND   6   ;   "\" has bit 2: so this is 2 for the wrong
0285   FE 02                  CP   2   ;   closer, and only then
0287   7A                     LD   A,D   
0288   C0                     RET   NZ   
0289   18 05                  JR   sk7   
028B   CB 53        SK6:      BIT   2,E   ; the text ran out:
028D   C2 86 05               JP   NZ,SKEND   ;   "\" with no closer ends the program
0290   DD E5        SK7:      PUSH   IX   ; N. The place is the opener
0292   C1                     POP   BC   
0293   3E 4E                  LD   A,"N"   
0295   C3 4B 04               JP   errp   ; (errp drops skip's return address)
0298                          ENDIF      
0298                             ; psgn: print HL as a signed number. Uses BC.
0298   CB 7C        PSGN:     BIT   7,H   
029A   28 04                  JR   Z,pdec   
029C   3E 2D                  LD   A,"-"   
029E   EF                     RST   28h   
029F   E7                     RST   20h   
02A0                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
02A0                             ; Uses BC.
02A0   11 0A 00     PDEC:     LD   DE,10   
02A3   CD 0E 02               CALL   udiv   ; HL = HL / 10, E = the last digit
02A6   7B                     LD   A,E   
02A7   F5                     PUSH   AF   
02A8   7C                     LD   A,H   
02A9   B5                     OR   L   
02AA   C4 A0 02               CALL   NZ,pdec   
02AD   F1                     POP   AF   
02AE   C6 30                  ADD   A,"0"   
02B0   EF                     RST   28h   
02B1   C9                     RET      
02B2                             ; =============================================================================
02B2                             ;  The grave's other codes. h_grave comes here with A = the character minus
02B2                             ;  27h, not zero; the tests carry on from there.
02B2                             ; 
02B2                             ;    `$  ( addr -- addr' )  the hex loader: pairs of hex digits are stored
02B2                             ;        from addr until a non-hex character; then a RET (C9h) is written
02B2                             ;        and its address is left. An odd last digit is consumed and dropped.
02B2                             ;    `+  ( addr -- n )   add 1 to the cell at addr and leave its new value
02B2                             ;    `,  ( n -- r )      a random number from 0 to n-1 (n is 1 to 32767)
02B2                             ;    `-  ( addr -- n )   subtract 1 from the cell at addr, the same way
02B2                             ;    `.  ( -- addr )     the address of the random seed
02B2                             ;    `<  ( a b -- n )    the smaller of the two (signed)
02B2                             ;    `>  ( a b -- n )    the larger
02B2                             ;    `?  ( flag -- )     the cursor off (0) or on
02B2                             ;    `@  ( row col -- )  the cursor to that row and column, both from 0
02B2                             ;    `^  ( -- )          clear the screen and home the cursor
02B2                             ;    `_  ( -- )          clear from the cursor to the end of the line
02B2                             ; 
02B2                             ;  Any other character is unsafe: the unchecked build takes it as "_", the
02B2                             ;  checked build stops with W.
02B2                             ; =============================================================================
02B2                             ; (The console codes are here, before the tests, to be in reach of them.)
02B2                          IF   ANSI   
02B2                             ; `? ( flag -- ): ESC [ ? 2 5 l hides the cursor, ESC [ ? 2 5 h shows it.
02B2   CD E0 02     G_CUR:    CALL   csi   
02B5   3E 3F                  LD   A,"?"   
02B7   EF                     RST   28h   
02B8   3E 32                  LD   A,"2"   
02BA   EF                     RST   28h   
02BB   3E 35                  LD   A,"5"   
02BD   EF                     RST   28h   
02BE   7C                     LD   A,H   
02BF   B5                     OR   L   
02C0   3E 6C                  LD   A,"l"   
02C2   28 02                  JR   Z,gc1   
02C4   3E 68                  LD   A,"h"   
02C6   EF           GC1:      RST   28h   
02C7   DF                     RST   18h   
02C8                             ; `@ ( row col -- ): ESC [ row+1 ; col+1 H. (ANSI counts from 1.)
02C8   D1           G_AT:     POP   DE   ; DE = the row
02C9   C5                     PUSH   BC   ; (pdec uses BC)
02CA   E5                     PUSH   HL   ; the column
02CB   EB                     EX   DE,HL   
02CC   CD E0 02               CALL   csi   
02CF   23                     INC   HL   
02D0   CD A0 02               CALL   pdec   
02D3   3E 3B                  LD   A,";"   
02D5   EF                     RST   28h   
02D6   E1                     POP   HL   
02D7   23                     INC   HL   
02D8   CD A0 02               CALL   pdec   
02DB   3E 48                  LD   A,"H"   
02DD   EF                     RST   28h   
02DE   C1                     POP   BC   
02DF   DF                     RST   18h   
02E0                             ; csi: print ESC [, which starts every ANSI sequence. Keeps all but A.
02E0   3E 1B        CSI:      LD   A,27   
02E2   EF                     RST   28h   
02E3   3E 5B                  LD   A,"["   
02E5   EF                     RST   28h   
02E6   C9                     RET      
02E7                          ENDIF      
02E7                          IF   1-ANSI   
                                 ; With ANSI = 0 the machine's own routines do the work (see the equates).
                    G_CUR:    LD   A,H   
                              OR   L   
                              CALL   CONCUR   
                              RST   18h   
                    G_AT:     POP   DE   ; DE = the row, HL = the column
                              CALL   CONAT   
                              RST   18h   
02E7                          ENDIF      
02E7   C6 03        GRAVE2:   ADD   A,27h-"$"   ; "$"
02E9   20 13                  JR   NZ,gv1   
02EB   CD A1 03     HX1:      CALL   hexc   
02EE   30 0B                  JR   NC,hx2   
02F0   77                     LD   (HL),A   ; the high digit goes in first ...
02F1   CD A1 03               CALL   hexc   
02F4   30 05                  JR   NC,hx2   ; odd digit: consumed, and the RET below
02F6   ED 6F                  RLD      ;   overwrites it
02F8   23                     INC   HL   ; ... and RLD shifts it up under the low one
02F9   18 F0                  JR   hx1   
02FB   36 C9        HX2:      LD   (HL),0C9h   ; (never range-checked: the spec says so)
02FD   F7                     RST   30h   
02FE   D6 07        GV1:      SUB   "+"-"$"   
0300   28 31                  JR   Z,g_inc   
0302   3D                     DEC   A   ; ","
0303   28 48                  JR   Z,g_rnd   
0305   3D                     DEC   A   ; "-"
0306   28 2B                  JR   Z,g_dec   
0308   3D                     DEC   A   ; "."
0309   28 3D                  JR   Z,g_seed   
030B   D6 0E                  SUB   "<"-"."   
030D   28 60                  JR   Z,g_min   
030F   D6 02                  SUB   ">"-"<"   
0311   28 5B                  JR   Z,g_max   
0313   3D                     DEC   A   ; "?"
0314   28 9C                  JR   Z,g_cur   
0316   3D                     DEC   A   ; "@"
0317   28 AF                  JR   Z,g_at   
0319   D6 1E                  SUB   "^"-"@"   ; "^" leaves 0 and "_" leaves 1
031B                          IF   CHECKED   
031B   FE 02                  CP   2   
031D   D2 59 04               JP   NC,e_brack   ; anything else: W. The place is the character
0320   B7                     OR   A   
0321                          ENDIF      
0321                          IF   ANSI   
0321   20 07                  JR   NZ,ge1   
0323   CD E0 02               CALL   csi   ; "^": ESC [ H homes the cursor, and then
0326   3E 48                  LD   A,"H"   ;   ESC [ J clears from there to the end of
0328   EF                     RST   28h   ;   the screen
0329   AF                     XOR   A   
032A   C6 4A        GE1:      ADD   A,"J"   ; "_": ESC [ K clears to the end of the line
032C   5F                     LD   E,A   
032D   CD E0 02               CALL   csi   
0330   7B                     LD   A,E   
0331   EF                     RST   28h   
0332   F7                     RST   30h   
0333                          ENDIF      
0333                          IF   1-ANSI   
                              JR   NZ,ge1   
                              CALL   CONCLS   
                              RST   30h   
                    GE1:      CALL   CONEOL   
                              RST   30h   
0333                          ENDIF      
0333                             ; `+ and `-. The carry says which: set to add.
0333                          IF   1-CHECKED   
                    G_DEC:    DB   3Eh   ; (LD A,n: steps over the SCF, and "-" comes
                    G_INC:    SCF      ;   here with the carry clear)
0333                          ENDIF      
0333                          IF   CHECKED   
0333                             ; (The checked build tests the address first, as "!" does, and then looks at
0333                             ; the character again: the test has used the flags.)
0333                G_INC:       
0333   CD 3C 04     G_DEC:    CALL   chkst   
0336   0B                     DEC   BC   
0337   0A                     LD   A,(BC)   
0338   03                     INC   BC   
0339   FE 2C                  CP   ","   ; carry for "+"
033B                          ENDIF      
033B   5E                     LD   E,(HL)   
033C   23                     INC   HL   
033D   56                     LD   D,(HL)   
033E   30 02                  JR   NC,gi1   
0340   13                     INC   DE   
0341   13                     INC   DE   
0342   1B           GI1:      DEC   DE   
0343   72                     LD   (HL),D   
0344   2B                     DEC   HL   
0345   73                     LD   (HL),E   
0346   EB                     EX   DE,HL   ; the new value is TOS
0347   F7                     RST   30h   
0348                             ; `. pushes the address of the random seed.
0348   E5           G_SEED:   PUSH   HL   
0349   21 76 82               LD   HL,SEED   
034C   F7                     RST   30h   
034D                             ; `, ( n -- r ). The seed goes one step on: seed * 261 + 1, which takes
034D                             ; every 16-bit value in turn. The high bits of such a seed are the good ones
034D                             ; and the low ones repeat soon, so the high byte is folded into the low
034D                             ; (XOR) before the remainder of dividing by n is taken.
034D                             ; n must be 1 to 32767: the checked build stops with Z on anything less
034D                             ; than 1.
034D                G_RND:       
034D                          IF   CHECKED   
034D   2B                     DEC   HL   
034E   CB 7C                  BIT   7,H   ; n - 1 negative: n is 0 or less
0350   23                     INC   HL   
0351   C2 56 04               JP   NZ,e_zero   
0354                          ENDIF      
0354   EB                     EX   DE,HL   ; DE = n
0355   C5                     PUSH   BC   
0356   2A 76 82               LD   HL,(SEED)   
0359   44                     LD   B,H   
035A   4D                     LD   C,L   
035B   29                     ADD   HL,HL   
035C   29                     ADD   HL,HL   
035D   09                     ADD   HL,BC   ; * 5
035E   7C                     LD   A,H   
035F   81                     ADD   A,C   
0360   67                     LD   H,A   ; + * 256: * 261
0361   23                     INC   HL   
0362   22 76 82               LD   (SEED),HL   
0365   7C                     LD   A,H   
0366   AD                     XOR   L   
0367   6F                     LD   L,A   
0368   CD 0E 02               CALL   udiv   ; DE = the remainder
036B   EB                     EX   DE,HL   
036C   C1                     POP   BC   
036D   F7                     RST   30h   
036E                             ; `< and `>. The carry says which: set for the larger. The two are put in
036E                             ; order, HL the smaller and DE the larger, and then swapped for ">".
036E                             ; b < a (signed) is the borrow of b - a, turned round if the two signs
036E                             ; differ: RRA puts the borrow in bit 7, where the two XORs meet it.
036E   37           G_MAX:    SCF      ; ("<" comes in with the carry clear)
036F   D1           G_MIN:    POP   DE   ; DE = a, HL = b
0370   F5                     PUSH   AF   
0371   7D                     LD   A,L   
0372   93                     SUB   E   
0373   7C                     LD   A,H   
0374   9A                     SBC   A,D   
0375   1F                     RRA      
0376   AC                     XOR   H   
0377   AA                     XOR   D   
0378   17                     RLA      ; carry: b < a
0379   38 01                  JR   C,gm2   
037B   EB                     EX   DE,HL   
037C   F1           GM2:      POP   AF   
037D   30 01                  JR   NC,gm3   
037F   EB                     EX   DE,HL   
0380   F7           GM3:      RST   30h   
0381                             ; =============================================================================
0381                             ;  Dispatch table: the low byte of each handler's address, in code order
0381                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
0381                             ;  It must not cross a page (the dispatcher only adds to its low byte).
0381                             ; =============================================================================
0381                             ; The handlers of the first NPG1 characters start in the image's second page.
0381                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
0381                             ; differs between the builds, so the count is worked out here.
0381                             ; (One division to a line: asm80 only rounds down when it stores a value.)
0381                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
0381                PGBRK:    EQU   (h_break-BASE)/256   
0381                PGDEF:    EQU   (h_def-BASE)/256   
0381                PGFET:    EQU   (h_fetch-BASE)/256   
0381                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
0381                          IF   1-TABP0   
0381                PTAB:        
0381                          ;*Macro unroll:  PTABLE
0381   98                     DB   h_store & 0FFh   
0382   A0                     DB   h_str & 0FFh   
0383   B4                     DB   h_num & 0FFh   
0384   AB                     DB   h_print & 0FFh   
0385   90                     DB   h_swap & 0FFh   
0386   33                     DB   h_and & 0FFh   
0387   B1                     DB   h_emit & 0FFh   
0388   0F                     DB   h_open & 0FFh   
0389   17                     DB   h_close & 0FFh   
038A   54                     DB   h_mul & 0FFh   
038B   2A                     DB   h_add & 0FFh   
038C   DB                     DB   h_cfetch & 0FFh   
038D   22                     DB   h_sub & 0FFh   
038E   92                     DB   h_cstore & 0FFh   
038F   68                     DB   h_div & 0FFh   
0390   8E                     DB   h_dup & 0FFh   
0391   97                     DB   h_drop & 0FFh   
0392   3B                     DB   h_lt & 0FFh   
0393   4A                     DB   h_eq & 0FFh   
0394   3C                     DB   h_gt & 0FFh   
0395   BA                     DB   h_key & 0FFh   
0396   0A                     DB   h_fetch & 0FFh   
0397   E6                     DB   h_def & 0FFh   
0398   D9                     DB   h_break & 0FFh   
0399   D5                     DB   h_ret & 0FFh   
039A   72                     DB   h_xor & 0FFh   
039B   85                     DB   h_alloc & 0FFh   
039C   C3                     DB   h_grave & 0FFh   
039D   2C                     DB   h_tor & 0FFh   
039E   7A                     DB   h_or & 0FFh   
039F   1C                     DB   h_fromr & 0FFh   
03A0   82                     DB   h_not & 0FFh   
03A1                PTABEND:      
03A1                          ENDIF      
03A1                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
03A1                             ; and return its value in A with the carry set; otherwise leave the IP and
03A1                             ; return with the carry clear.
03A1   0A           HEXC:     LD   A,(BC)   
03A2   D6 30                  SUB   "0"   
03A4   FE 0A                  CP   10   
03A6   38 09                  JR   C,hc1   
03A8   E6 DF                  AND   0DFh   
03AA   D6 11                  SUB   11h   
03AC   FE 06                  CP   6   
03AE   D0                     RET   NC   
03AF   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
03B1   03           HC1:      INC   BC   
03B2   C9                     RET      
03B3                             ; =============================================================================
03B3                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
03B3                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
03B3                             ;  (RST 28h) prints A. Both keep BC, DE, HL and HL'. In the generic build
03B3                             ;  they are the host's KEY and CONOUT routines themselves.
03B3                             ; 
03B3                             ;  A running program reads the keyboard only through getk and pollk, which
03B3                             ;  between them give the break key its rules:
03B3                             ;    - Ctrl-C stops the program;
03B3                             ;    - any other key that the break check reads is held in KEYBUF for the
03B3                             ;      next "?", and a newer one takes its place;
03B3                             ;    - "?" (getk) takes the held key first;
03B3                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
03B3                             ;      key like any other, but two of them within about 250 ms still stop it.
03B3                             ;  Both are called straight from a handler, never from a routine under one:
03B3                             ;  the checked build's report counts on finding one return address above the
03B3                             ;  data stack.
03B3                             ; =============================================================================
03B3                          IFN   CPM   
03B3                RAWK:     EQU   KEY   
03B3                          ENDIF      
03B3                             ; pollk: the break check (see rpushn).
03B3   CD 06 FF     POLLK:    CALL   rawk   
03B6   C8                     RET   Z   ; no key
03B7   32 7A 82               LD   (KEYBUF),A   ; held for the next "?"
03BA   FE 03        PK1:      CP   3   ; (getk joins here)
03BC   C0                     RET   NZ   
03BD                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
03BD                             ; the program has turned it off, wait about 250 ms for one more key: a
03BD                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
03BD                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
03BD   3A 7B 82     CTLC:     LD   A,(BRKOFF)   
03C0   B7                     OR   A   
03C1   CA 49 04     CT0:      JP   Z,brk   
03C4   D5                     PUSH   DE   
03C5   11 10 27               LD   DE,250*MSLOOP   
03C8   CD 06 FF     CT1:      CALL   rawk   
03CB   20 05                  JR   NZ,ct2   
03CD   1B                     DEC   DE   
03CE   7A                     LD   A,D   
03CF   B3                     OR   E   
03D0   20 F6                  JR   NZ,ct1   
03D2   D1           CT2:      POP   DE   ; A = the second key, or 0 if none came
03D3   FE 03                  CP   3   
03D5   28 EA                  JR   Z,ct0   ; (the zero flag takes the JP there)
03D7   B7                     OR   A   
03D8   28 03                  JR   Z,ct3   
03DA   32 7A 82               LD   (KEYBUF),A   
03DD   3E 03        CT3:      LD   A,3   
03DF   B7                     OR   A   
03E0   C9                     RET      
03E1                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
03E1   E5           GETK:     PUSH   HL   ; a held key goes first, and is taken out of
03E2   21 7A 82               LD   HL,KEYBUF   ;   the buffer
03E5   7E                     LD   A,(HL)   
03E6   36 00                  LD   (HL),0   
03E8   E1                     POP   HL   
03E9   B7                     OR   A   
03EA   C0                     RET   NZ   
03EB   CD 06 FF               CALL   rawk   
03EE   C8                     RET   Z   
03EF   18 C9                  JR   pk1   ; Ctrl-C? If not, that is the key
03F1                          IF   (1-CHECKED)*(1-EDITOR)   
                    BRK:      EQU   endprog   ; the unchecked build stops without a word
03F1                          ENDIF      ;   (with the editor, both stacks are cleared);
03F1                          IF   (1-CHECKED)*EDITOR   
                    BRK:      EQU   edit0   
03F1                          ENDIF      
03F1                          IF   CHECKED   
03F1                BRK:      EQU   e_break   ;   the checked build reports B
03F1                          ENDIF      
03F1                          IF   CPM   
                    RAWK:     LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
                                 ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
                                 ; printing and could swallow a key that BDOS 6 then never sees.
                    PUTC:     PUSH   DE   
                              PUSH   HL   
                              LD   E,A   
                              LD   A,6   
                              CALL   bdosx   
                              POP   HL   
                              POP   DE   
                              OR   A   ; (for getk)
                              RET      
                                 ; bdosx: call BDOS function A with DE, keeping BC and HL'
                    BDOSX:    PUSH   BC   
                              EXX      
                              PUSH   HL   
                              EXX      
                              LD   C,A   
                              CALL   BDOS   
                              EXX      
                              POP   HL   
                              EXX      
                              POP   BC   
                              RET      
03F1                          ENDIF      
03F1                             ; =============================================================================
03F1                             ;  Checked build: the checks and the error report
03F1                             ; =============================================================================
03F1                          IF   CHECKED   
03F1                             ; chkstk: both stacks are checked once per character, not in every handler.
03F1                             ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
03F1                             ; the constant carries if it is above (cells were popped that were never
03F1                             ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
03F1                             ; a character late at most: the bytes above DSTOP and the guard band below
03F1                             ; the page take what happens meanwhile. DE is free between characters.
03F1   EB           CHKSTK:   EX   DE,HL   
03F2   21 05 7E               LD   HL,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
03F5   39                     ADD   HL,SP   
03F6   EB                     EX   DE,HL   
03F7   38 1D                  JR   C,e_under   
03F9   14                     INC   D   
03FA   20 16                  JR   NZ,e_over   
03FC   D9                     EXX      ; the return stack: in its page (or it has
03FD   7C                     LD   A,H   ;   overflowed), and not above its empty
03FE   FE 80                  CP   RSPAGE   ;   position (an underflow stays inside the
0400   7D                     LD   A,L   ;   page, in the guard band)
0401   D9                     EXX      
0402   20 0B                  JR   NZ,e_rover   
0404   FE E1                  CP   RSTOP&0FFh+1   
0406   D8                     RET   C   
0407   D9                     EXX      ; return stack underflow: it counts as empty
0408   2E E0                  LD   L,RSTOP&0FFh   ;   (H is right: the pointer is in its page)
040A   D9                     EXX      
040B   3E 72                  LD   A,"r"   
040D   18 3C                  JR   errp   
040F   3E 52        E_ROVER:   LD   A,"R"   ; return stack overflow
0411   11                     DB   11h   ; (LD DE,nn hides the next entry)
0412   3E 53        E_OVER:   LD   A,"S"   ; data stack overflow
0414   18 35                  JR   errp   
0416   31 FC 81     E_UNDER:   LD   SP,DSTOP   ; data stack underflow: it counts as empty
0419   3E 73                  LD   A,"s"   
041B   18 3E                  JR   error   
041D                             ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
041D                             ; was never defined still holds 0000h, and the byte there is a reserved one
041D                             ; in every build (AFh or C3h): if the IP is in page zero, this was a call of
041D                             ; an undefined word. The call is undone, so the place is the call itself.
041D   04           E_HI:     INC   B   
041E   10 33                  DJNZ   e_resv   ; (B is as it was, and is not 0)
0420   CF                     RST   08h   
0421   42                     LD   B,D   
0422   4B                     LD   C,E   
0423   3E 55                  LD   A,"U"   
0425   18 34                  JR   error   
0427                             ; chkhp: HL = the new heap top, DE = the old one, the carry is from adding
0427                             ; the count. Stop if the top is not below the limit page, or is below the
0427                             ; program's end.
0427                CHKHP:       
0427                          ENDIF      
0427                          IF   CHECKED*CPM   
                                 ; With this much room a top that wrapped round can land back in
                                 ; range, so the add is tested too: growing (A, the count's high
                                 ; byte, is positive) must not carry, and releasing must.
                              RRA      ; the carry comes in above the sign:
                              ADD   A,40h   ;   bit 7 = carry XOR sign
                              ADD   A,A   
                              JR   C,e_heap   
                              LD   A,(0007h)   
                              DEC   A   
                              CP   H   
                              JR   C,e_heap   
0427                          ENDIF      
0427                          IF   CHECKED*(1-CPM)   
0427                             ; (Here the program's space is under 32K, so a top that wrapped
0427                             ; round always falls outside it.)
0427   7C                     LD   A,H   
0428   FE F0                  CP   HEAPLIM   
042A   30 09                  JR   NC,e_heap   
042C                          ENDIF      
042C                          IF   CHECKED   
042C   D5                     PUSH   DE   
042D   EB                     EX   DE,HL   
042E   2A 38 82               LD   HL,(NPEND)   
0431   19                     ADD   HL,DE   ; carry: at or above the program's end
0432   EB                     EX   DE,HL   
0433   D1                     POP   DE   
0434   D8                     RET   C   
0435   B7           E_HEAP:   OR   A   ; put the count back in TOS for the report
0436   ED 52                  SBC   HL,DE   
0438   3E 48                  LD   A,"H"   
043A   18 0F                  JR   errp   
043C                             ; chkst: stop unless HL is in the program's own space: from the letter page
043C                             ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
043C                             ; whatever lies above the limit are safe. Memory above the heap top but
043C                             ; below the limit is the program's own: Tiny BASIC keeps its lines there.
043C                             ; It is the page of HL + 1 that is tested, so that one test serves both
043C                             ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
043C                             ; Keeps HL and BC. It runs on into its own error entry.
043C   23           CHKST:    INC   HL   
043D   7C                     LD   A,H   
043E   2B                     DEC   HL   
043F   FE 82                  CP   LETPAGE   
0441   38 03                  JR   C,e_store   
0443                          ENDIF      
0443                          IF   CHECKED*(1-CPM)   
0443   FE F0                  CP   HEAPLIM   
0445   D8                     RET   C   
0446                          ENDIF      
0446                          IF   CHECKED*CPM   
                              LD   E,A   
                              LD   A,(0007h)   ; the BDOS page is the heap limit
                              DEC   A   
                              CP   E   
                              RET   NC   
0446                          ENDIF      
0446                          IF   CHECKED   
0446                             ; Error entries. Each loads its letter and then hides the next entry inside
0446                             ; a 3-byte LD DE,nn (the 11h), so they all fall through to `error`.
0446   3E 4F        E_STORE:   LD   A,"O"   ; a store outside the program's space
0448   11                     DB   11h   
0449   3E 42        E_BREAK:   LD   A,"B"   ; Ctrl-C (found inside pollk or getk)
044B                             ; errp: an error found inside a routine: drop its return address first.
044B   D1           ERRP:     POP   DE   
044C   18 0D                  JR   error   
044E   44           E_QUOTE:   LD   B,H   ; an unclosed string: HL is its address, one
044F   4D                     LD   C,L   ;   past the opening quote, which is the place
0450   3E 51                  LD   A,"Q"   
0452   11                     DB   11h   
0453   3E 58        E_RESV:   LD   A,"X"   ; a reserved byte outside a string
0455   11                     DB   11h   
0456   3E 5A        E_ZERO:   LD   A,"Z"   ; dividing by zero
0458   11                     DB   11h   
0459   3E 57        E_BRACK:   LD   A,"W"   ; bad character after [
045B                             ; error: the report, then the end. A = the letter, BC = one past the place,
045B                             ; HL = TOS, and both stacks as the report is to show them:
045B                             ; 
045B                             ;   Err X @ line,col
045B                             ;   up to 16 characters of the text from the place
045B                             ;   Stk n: the top 8 cells at most, bottom to top
045B                             ;   Rtn n
045B   E5           ERROR:    PUSH   HL   ; now the whole data stack is in memory
045C   5F                     LD   E,A   
045D   CD 2F 05               CALL   pnl   
0460   45 72 72 20 22         DB   "Err ",22h   
0465   7B                     LD   A,E   
0466   EF                     RST   28h   
0467   CD 35 05               CALL   pmsg   
046A   20 40 20 22            DB   " @ ",22h   
046E   0B                     DEC   BC   ; BC = the place
046F                             ; The line and column. A place below the program is in the line
046F                             ; buffer: line 0. Otherwise count the LFs from the program's start;
046F                             ; DE = the line's number, HL = where it starts.
046F   21 80 82               LD   HL,LINEBUF   
0472   11 00 00               LD   DE,0   
0475   78                     LD   A,B   
0476   FE 83                  CP   PROG/256   
0478   38 14                  JR   C,er3   
047A   24                     INC   H   
047B   6B                     LD   L,E   ; HL = PROG
047C   13           ER1:      INC   DE   ; a new line starts at HL
047D   E5                     PUSH   HL   
047E   7D           ER2:      LD   A,L   
047F   91                     SUB   C   
0480   7C                     LD   A,H   
0481   98                     SBC   A,B   
0482   30 09                  JR   NC,er2x   ; reached the place
0484   7E                     LD   A,(HL)   
0485   23                     INC   HL   
0486   FE 0A                  CP   10   
0488   20 F4                  JR   NZ,er2   
048A   F1                     POP   AF   
048B   18 EF                  JR   er1   
048D   E1           ER2X:     POP   HL   
048E   C5           ER3:      PUSH   BC   
048F   E5                     PUSH   HL   
0490   EB                     EX   DE,HL   
0491   CD A0 02               CALL   pdec   ; the line
0494   3E 2C                  LD   A,","   
0496   EF                     RST   28h   
0497   D1                     POP   DE   
0498   E1                     POP   HL   
0499   E5                     PUSH   HL   
049A   B7                     OR   A   
049B   ED 52                  SBC   HL,DE   
049D   23                     INC   HL   
049E   CD A0 02               CALL   pdec   ; the column
04A1   CD 2F 05               CALL   pnl   
04A4   22                     DB   22h   
04A5   E1                     POP   HL   ; the text, as it is: 16 characters, or fewer
04A6   06 10                  LD   B,16   ;   if the line or the program ends first
04A8   7E           ER4:      LD   A,(HL)   
04A9   23                     INC   HL   
04AA   B7                     OR   A   
04AB   28 0B                  JR   Z,er5   
04AD   FE 0D                  CP   13   
04AF   28 07                  JR   Z,er5   
04B1   FE 0A                  CP   10   
04B3   28 03                  JR   Z,er5   
04B5                          ENDIF      
04B5                          IF   CHECKED*CPM   
                              CP   1Ah   ; (the ^Z that pads a file's last record ends
                              JR   Z,er5   ;   the text too: some terminals clear the
04B5                          ENDIF      ;   screen on it)
04B5                          IF   CHECKED   
04B5   EF                     RST   28h   
04B6   10 F0                  DJNZ   er4   
04B8                ER5:         ; (without the editor: on into pstk)
04B8                          ENDIF      
04B8                          IF   CHECKED*EDITOR   
04B8   CD C2 04               CALL   pstk   
04BB   CD 2F 05               CALL   pnl   
04BE   22                     DB   22h   
04BF   C3 82 05               JP   edit0   ; back to the editor, with both stacks cleared
04C2                          ENDIF      
04C2                             ; =============================================================================
04C2                             ;  Routines that the checked build's report and the editor share
04C2                             ; =============================================================================
04C2                SPADJ:    EQU   2*EDITOR   ; (with the editor pstk is called, not fallen
04C2                             ;   into: the stack is one address deeper)
04C2                          IF   CHECKED+EDITOR   
04C2                             ; pstk: the two stack lines:  Stk n: the top 8 cells at most, bottom to top
04C2                             ;                             Rtn n
04C2                             ; TOS must be in memory with the rest (pushed). In a build without the
04C2                             ; editor this is the end of `error`, which runs on into it.
04C2   CD 2F 05     PSTK:     CALL   pnl   
04C5   53 74 6B 20 22         DB   "Stk ",22h   
04CA   21 08 7E               LD   HL,(2+SPADJ-DSTOP)&0FFFFh   ; SP - (DSTOP-2) is minus twice the
04CD   39                     ADD   HL,SP   ;   depth (the cell at DSTOP-2 was pushed
04CE   E7                     RST   20h   ;   with the first value and holds nothing)
04CF   CD 12 05               CALL   phalf   ; the depth
04D2   3E 3A                  LD   A,":"   
04D4   EF                     RST   28h   
04D5   79                     LD   A,C   
04D6   FE 09                  CP   9   
04D8   38 0A                  JR   C,er6   
04DA   CD 35 05               CALL   pmsg   
04DD   20 2E 2E 2E 22         DB   " ...",22h   
04E2   0E 08                  LD   C,8   
04E4   26 00        ER6:      LD   H,0   ; C = the number of cells to show
04E6   69                     LD   L,C   
04E7   29                     ADD   HL,HL   
04E8   39                     ADD   HL,SP   ; HL -> just above the deepest of them
04E9                          ENDIF      
04E9                          IF   EDITOR   
04E9   23                     INC   HL   
04EA   23                     INC   HL   
04EB                          ENDIF      
04EB                          IF   CHECKED+EDITOR   
04EB   0C                     INC   C   
04EC   0D           ER7:      DEC   C   
04ED   28 11                  JR   Z,er8   
04EF   2B                     DEC   HL   
04F0   56                     LD   D,(HL)   
04F1   2B                     DEC   HL   
04F2   5E                     LD   E,(HL)   
04F3   E5                     PUSH   HL   
04F4   C5                     PUSH   BC   
04F5   3E 20                  LD   A," "   
04F7   EF                     RST   28h   
04F8   EB                     EX   DE,HL   
04F9   CD 98 02               CALL   psgn   
04FC   C1                     POP   BC   
04FD   E1                     POP   HL   
04FE   18 EC                  JR   er7   
0500   CD 2F 05     ER8:      CALL   pnl   
0503                          ENDIF      
0503                          IF   (1-CHECKED)*EDITOR   
                              DB   "Rtn 0",22h   ; (only ^V comes here, and at the editor the
                              RET      ;   return stack is always empty)
0503                          ENDIF      
0503                          IF   CHECKED   
0503   52 74 6E 20 22         DB   "Rtn ",22h   
0508   D9                     EXX      
0509   E5                     PUSH   HL   
050A   D9                     EXX      
050B   D1                     POP   DE   
050C   21 E0 80               LD   HL,RSTOP   
050F   B7                     OR   A   
0510   ED 52                  SBC   HL,DE   
0512                          ENDIF      
0512                          IF   CHECKED*(1-EDITOR)   
                              CALL   phalf   
                              CALL   pnl   
                              DB   22h   
                              JP   endprog   
0512                          ENDIF      
0512                          IF   CHECKED+EDITOR   
0512                             ; phalf: print half of HL, and leave it in C. (With the editor, pstk ends by
0512                             ; running on into this.)
0512   CB 3C        PHALF:    SRL   H   
0514   CB 1D                  RR   L   
0516   E5                     PUSH   HL   
0517   CD A0 02               CALL   pdec   
051A   C1                     POP   BC   
051B   C9                     RET      
051C                             ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
051C                             ; "$", and the texts of the report and the editor). In the checked build a
051C                             ; NUL first is an error: Q.
051C   7E           PRSTR:    LD   A,(HL)   
051D   23                     INC   HL   
051E   FE 22                  CP   22h   
0520   C8                     RET   Z   
0521                          ENDIF      
0521                          IF   CHECKED   
0521   B7                     OR   A   
0522   28 17                  JR   Z,e_dollar   
0524                          ENDIF      
0524                          IF   CHECKED+EDITOR   
0524   FE 2F                  CP   "/"   
0526   20 04                  JR   NZ,prs1   
0528   7E                     LD   A,(HL)   
0529   23                     INC   HL   
052A   E6 BF                  AND   0BFh   
052C   EF           PRS1:     RST   28h   
052D   18 ED                  JR   prstr   
052F                             ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
052F                             ; pnl: the same, on a new line.
052F   3E 0D        PNL:      LD   A,13   
0531   EF                     RST   28h   
0532   3E 0A                  LD   A,10   
0534   EF                     RST   28h   
0535   E3           PMSG:     EX   (SP),HL   
0536   CD 1C 05               CALL   prstr   
0539   E3                     EX   (SP),HL   
053A   C9                     RET      
053B                          ENDIF      
053B                          IF   CHECKED   
053B   D1           E_DOLLAR:   POP   DE   ; "$" ran into a NUL: drop the return address,
053C   E1                     POP   HL   ;   and put the string's address back in TOS
053D   3E 51                  LD   A,"Q"   
053F   C3 5B 04               JP   error   
0542                          ENDIF      
0542                             ; =============================================================================
0542                             ;  The line editor (EDITOR = 1)
0542                             ; 
0542                             ;  The interpreter starts here, and a program that ends comes back here.
0542                             ;  There is no prompt. It follows the spec's suggested standard for a line
0542                             ;  editor (docs/b8script.md, Environments). Type a line and press Return:
0542                             ; 
0542                             ;    n text    put the text in as line n; the lines from n on move down. A
0542                             ;              number past the end (or 0) adds the line at the end.
0542                             ;    n         take line n out
0542                             ;    anything else is run at once, as B8Script. (Start such a line with a
0542                             ;    space if it would begin with a digit.)
0542                             ; 
0542                             ;  A command key ends the line too, and takes what was typed as its argument:
0542                             ; 
0542                             ;    ^G        run the program
0542                             ;    n ^L      list from line n (no number: all of it). Any key holds the
0542                             ;              list until another key is pressed; Ctrl-C ends it.
0542                             ;    n ^E      put line n in the input line; Return puts it back, changed
0542                             ;    name ^R   read. CP/M: the file of that name (no name: the same file as
0542                             ;              last time). Generic: what is typed, or pasted, from now until
0542                             ;              ^Z replaces the program; it is not echoed.
0542                             ;    name ^W   write. CP/M: to that file (no name: the same file as last
0542                             ;              time). Generic: the text is printed, as it is.
0542                             ;    ^N ^N     new: no program (the key twice in a row)
0542                             ;    ^V        view: the build, both stacks, and the program's size, lines
0542                             ;              and free memory
0542                             ;    ^X        leave (to LEAVE)
0542                             ; 
0542                             ;  In the line: ^B and ^F, or the left and right arrow keys, move the cursor;
0542                             ;  a character goes in at the cursor; Backspace and DEL take out the one
0542                             ;  before it; Esc drops the line. Only CR, LF, BS and printing characters are
0542                             ;  sent to the terminal, so any terminal will do.
0542                             ; 
0542                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
0542                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
0542                             ;  125 characters; the one character after a line number separates it from
0542                             ;  the text and is not stored. The text is kept as it is typed, each line
0542                             ;  ending in CR LF, at PROG.
0542                             ; 
0542                             ;  What lasts from one line to the next: the program, the words, the
0542                             ;  variables and the data stack. An error or a break clears both stacks. The
0542                             ;  return stack starts empty for every line.
0542                             ; 
0542                             ;  Things to know:
0542                             ;    - Reset empties the program (generic builds).
0542                             ;    - A word's address points into the program, so run the program again
0542                             ;      after editing it.
0542                             ;    - Nothing is printed between a program's output and what is typed next.
0542                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
0542                             ;      a line that calls -n? and carries on afterwards runs what was typed.
0542                             ;      (The stored program never comes back to the line, so it may.)
0542                             ;    - The editor"s own keys are not the program"s: -n? is the plain line
0542                             ;      read of the other builds (BDOS 10 under CP/M).
0542                             ; 
0542                             ;  The data stack is the CPU's stack, so the editor works on top of whatever
0542                             ;  the last line left there, with TOS pushed like the rest.
0542                             ; =============================================================================
0542                          IF   EDGEN   
0542                INIT:        ; reset (A = 0)
0542                          ENDIF      
0542                          IF   EDGEN*CHECKED   
0542                             ; Clear the lower half of the letter page: every variable starts at 0, and
0542                             ; every word cell holds 0000h, the address an undefined word is caught at
0542                             ; (see e_hi).
0542   21 00 82               LD   HL,LET   
0545   77           INI1:     LD   (HL),A   
0546   2C                     INC   L   
0547   F2 45 05               JP   P,ini1   ; +00h to +7Fh
054A                          ENDIF      
054A                          IF   EDGEN   
054A   18 36                  JR   edit0   
054C                          ENDIF      
054C                          IF   EDITOR   
054C                             ; ^F, right arrow: one to the right, by printing the character there
054C   7D           RIGHT:    LD   A,L   
054D   BB                     CP   E   
054E   28 4A                  JR   Z,ed1   ; at the end
0550   7E                     LD   A,(HL)   
0551   2C                     INC   L   
0552   18 2B                  JR   lf1   
0554                             ; Esc: alone it drops the line. An arrow key sends Esc [ and a letter, so
0554                             ; wait about 5 ms for a second key: after a "[" read on to the letter that
0554                             ; ends the sequence, and act on C (right) and D (left).
0554   01 C8 00     ESC:      LD   BC,5*MSLOOP   
0557   CD 06 FF     ES1:      CALL   rawk   
055A   20 0A                  JR   NZ,es2   
055C   0B                     DEC   BC   
055D   78                     LD   A,B   
055E   B1                     OR   C   
055F   20 F6                  JR   NZ,es1   
0561   CD CF 05               CALL   fin   ; no second key: the line is dropped
0564   18 22                  JR   edit   
0566   FE 5B        ES2:      CP   "["   
0568   20 30                  JR   NZ,ed1   ; not a sequence known here
056A   CD 28 06     ES3:      CALL   ekey   
056D   FE 40                  CP   40h   
056F   38 F9                  JR   C,es3   ; (its parameters)
0571   D6 43                  SUB   "C"   
0573   28 D7                  JR   Z,right   
0575   3D                     DEC   A   ; "D"?
0576   20 22                  JR   NZ,ed1   ; no: on into left
0578                             ; ^B, left arrow: the cursor goes one to the left
0578   7D           LEFT:     LD   A,L   
0579   87                     ADD   A,A   
057A   28 1E                  JR   Z,ed1   ; (L = 80h: at the start)
057C   2D                     DEC   L   
057D   3E 08                  LD   A,8   
057F   EF           LF1:      RST   28h   
0580   18 18                  JR   ed1   
0582                             ; edit0: reset, an error or a break: both stacks are cleared.
0582                             ; skend: a program that ended inside skip: its return address goes.
0582                             ; edend: a program that ended: TOS joins the rest of the data stack.
0582   31 FA 81     EDIT0:    LD   SP,DSTOP-2   ; empty (the cell that stands for TOS is pushed)
0585   21                     DB   21h   ; (LD HL,nn: steps over the next two bytes)
0586   D1           SKEND:    POP   DE   
0587   E5           EDEND:    PUSH   HL   
0588                             ; edit: start a new input line.
0588   D9           EDIT:     EXX      
0589   21 E0 80               LD   HL,RSTOP   ; the return stack is empty
058C   D9                     EXX      
058D   21 00 00               LD   HL,0   
0590   22 7A 82               LD   (KEYBUF),HL   ; no key is held, and the break key is on
0593   22 3A 82               LD   (EDLN),HL   ; no line is being edited
0596   21 80 82               LD   HL,LINEBUF   ; HL = the cursor,
0599   5D                     LD   E,L   ;   E = the end of the line (its low byte)
059A   CD 28 06     ED1:      CALL   ekey   
059D   FE 7F                  CP   7Fh   
059F   28 40                  JR   Z,bsp   ; DEL
05A1   FE 20                  CP   " "   
05A3   30 56                  JR   NC,insc   
05A5   FE 09                  CP   9   
05A7   28 52                  JR   Z,insc   ; Tab is text
05A9   FE 08                  CP   8   
05AB   28 34                  JR   Z,bsp   
05AD   FE 02                  CP   2   
05AF   28 C7                  JR   Z,left   ; ^B
05B1   FE 06                  CP   6   
05B3   28 97                  JR   Z,right   ; ^F
05B5   FE 1B                  CP   1Bh   
05B7   28 9B                  JR   Z,esc   
05B9   E5                     PUSH   HL   ; a command key? Look it up
05BA   21 2E 06               LD   HL,cmds   
05BD   06 09                  LD   B,NCMD   
05BF   BE           ED2:      CP   (HL)   
05C0   23                     INC   HL   
05C1   28 07                  JR   Z,ed3   
05C3   23                     INC   HL   
05C4   23                     INC   HL   
05C5   10 F8                  DJNZ   ed2   
05C7   E1                     POP   HL   
05C8   18 D0                  JR   ed1   ; no: the key is ignored
05CA   7E           ED3:      LD   A,(HL)   
05CB   23                     INC   HL   
05CC   66                     LD   H,(HL)   
05CD   6F                     LD   L,A   
05CE   E3                     EX   (SP),HL   ; the command's address: fin returns to it
05CF                             ; fin: end the input line: CR LF and a NUL after it, and a new line on the
05CF                             ; terminal. Leaves BC -> the line and HL -> the NUL.
05CF   26 82        FIN:      LD   H,LETPAGE   
05D1   6B                     LD   L,E   
05D2   36 0D                  LD   (HL),13   
05D4   2C                     INC   L   
05D5   36 0A                  LD   (HL),10   
05D7   2D                     DEC   L   
05D8   CD 97 07               CALL   prl   ; (prints the CR LF)
05DB   36 00                  LD   (HL),0   
05DD   01 80 82               LD   BC,LINEBUF   
05E0   C9                     RET      
05E1                             ; Backspace, DEL: the character before the cursor goes. The cursor moves
05E1                             ; left, the rest of the line moves down over it, and the last place (now a
05E1                             ; space) is printed over along with the rest.
05E1   7D           BSP:      LD   A,L   
05E2   87                     ADD   A,A   
05E3   28 B5                  JR   Z,ed1   ; at the start
05E5   2D                     DEC   L   
05E6   3E 08                  LD   A,8   
05E8   EF                     RST   28h   
05E9   E5                     PUSH   HL   
05EA   2C           BS1:      INC   L   
05EB   7E                     LD   A,(HL)   
05EC   2D                     DEC   L   
05ED   77                     LD   (HL),A   
05EE   2C                     INC   L   
05EF   7D                     LD   A,L   
05F0   BB                     CP   E   
05F1   20 F7                  JR   NZ,bs1   
05F3   2D                     DEC   L   
05F4   36 20                  LD   (HL)," "   
05F6   E1                     POP   HL   
05F7   53                     LD   D,E   
05F8   1D                     DEC   E   
05F9   18 15                  JR   ic2   
05FB                             ; A character goes in at the cursor: it ripples up through the rest of the
05FB                             ; line, the cursor moves on, and the rest is printed again.
05FB   47           INSC:     LD   B,A   
05FC   7B                     LD   A,E   
05FD   FE FD                  CP   0FDh   
05FF   28 99                  JR   Z,ed1   ; the line is full: 125 characters
0601   78                     LD   A,B   
0602   EF                     RST   28h   
0603   E5                     PUSH   HL   
0604   7E           IC1:      LD   A,(HL)   
0605   70                     LD   (HL),B   
0606   47                     LD   B,A   
0607   7D                     LD   A,L   
0608   2C                     INC   L   
0609   BB                     CP   E   
060A   20 F8                  JR   NZ,ic1   
060C   E1                     POP   HL   
060D   2C                     INC   L   
060E   1C                     INC   E   
060F   53                     LD   D,E   
0610   CD 15 06     IC2:      CALL   tail   
0613   18 85                  JR   ed1   
0615                             ; tail: print the line from the cursor to D (a low byte), and bring the
0615                             ; cursor back with backspaces. Nothing at all if the cursor is at D.
0615   4D           TAIL:     LD   C,L   
0616   7D           TA1:      LD   A,L   
0617   BA                     CP   D   
0618   28 05                  JR   Z,ta2   
061A   7E                     LD   A,(HL)   
061B   EF                     RST   28h   
061C   2C                     INC   L   
061D   18 F7                  JR   ta1   
061F   7D           TA2:      LD   A,L   
0620   B9                     CP   C   
0621   C8                     RET   Z   
0622   3E 08                  LD   A,8   
0624   EF                     RST   28h   
0625   2D                     DEC   L   
0626   18 F7                  JR   ta2   
0628                             ; ekey: wait for a key
0628   CD 06 FF     EKEY:     CALL   rawk   
062B   28 FB                  JR   Z,ekey   
062D   C9                     RET      
062E                             ; The command keys, and where each goes (after fin).
062E   0D           CMDS:     DB   13   
062F   81 06                  DW   cret   
0631   07                     DB   7   ; ^G
0632   C9 06                  DW   crun   
0634   0C                     DB   12   ; ^L
0635   DF 06                  DW   clist   
0637   05                     DB   5   ; ^E
0638   57 06                  DW   cedln   
063A   12                     DB   18   ; ^R
063B   A0 07                  DW   cread   
063D   17                     DB   23   ; ^W
063E   CD 07                  DW   cwrite   
0640   0E                     DB   14   ; ^N
0641   49 06                  DW   cnew   
0643   16                     DB   22   ; ^V
0644   0F 07                  DW   cview   
0646   18                     DB   24   ; ^X
0647   09 FF                  DW   LEAVE   
0649                NCMD:     EQU   9   
0649                             ; ^N ^N: no program, if the next key is ^N too
0649   CD 28 06     CNEW:     CALL   ekey   
064C   FE 0E                  CP   14   
064E   20 04                  JR   NZ,ged0   
0650   AF                     XOR   A   
0651   32 00 83               LD   (PROG),A   
0654   C3 88 05     GED0:     JP   edit   
0657                             ; ^E: line n goes into the input line, to be changed. EDLN remembers which
0657                             ; line it was: Return puts the text back in its place.
0657   CD 34 02     CEDLN:    CALL   rdnum   
065A   E5                     PUSH   HL   
065B   CD 7F 07               CALL   find   ; HL -> the line, or the NUL if there is none
065E   D1                     POP   DE   
065F   7E                     LD   A,(HL)   
0660   B7                     OR   A   
0661   28 F1                  JR   Z,ged0   
0663   ED 53 3A 82            LD   (EDLN),DE   
0667   11 80 82               LD   DE,LINEBUF   
066A   7E           CE1:      LD   A,(HL)   ; copy it, and show it, up to its CR (or LF)
066B   FE 0D                  CP   13   
066D   28 0D                  JR   Z,ce2   
066F   FE 0A                  CP   10   
0671   28 09                  JR   Z,ce2   
0673   12                     LD   (DE),A   
0674   EF                     RST   28h   
0675   23                     INC   HL   
0676   1C                     INC   E   
0677   7B                     LD   A,E   
0678   FE FD                  CP   0FDh   ; (a longer line is cut at 125 characters)
067A   20 EE                  JR   NZ,ce1   
067C   EB           CE2:      EX   DE,HL   ; the cursor is at the line's end
067D   5D                     LD   E,L   
067E   C3 9A 05               JP   ed1   
0681                             ; Return. If ^E put a line here, the text goes back in its place. If not:
0681                             ; a number and text is a line to put in, a number alone a line to take out,
0681                             ; and anything else is run where it is.
0681   E5           CRET:     PUSH   HL   ; the end of what was typed
0682   2A 3A 82               LD   HL,(EDLN)   
0685   7C                     LD   A,H   
0686   B5                     OR   L   
0687   28 07                  JR   Z,cr1   
0689   E5                     PUSH   HL   
068A   CD 6F 07               CALL   delln   
068D   E1                     POP   HL   
068E   18 13                  JR   ins   
0690   CD 34 02     CR1:      CALL   rdnum   ; HL = the number it starts with, BC -> after
0693   79                     LD   A,C   ; C is still 80h if there was no number:
0694   87                     ADD   A,A   ;   only then is twice it 0
0695   28 36                  JR   Z,st0p   ; no number: run the line
0697   0A                     LD   A,(BC)   
0698   FE 0D                  CP   13   
069A   20 06                  JR   NZ,cr2   
069C   D1                     POP   DE   ; the number alone: take that line out
069D   CD 6F 07               CALL   delln   
06A0   18 24                  JR   gedit   
06A2   03           CR2:      INC   BC   ; step over the one character after the number
06A3                             ; Put the text at BC in as line n (in HL): open a gap of its length there,
06A3                             ; CR and LF included, and copy it in.
06A3   CD 7F 07     INS:      CALL   find   ; HL -> where it goes
06A6   D1                     POP   DE   ; the end of what was typed
06A7   7B                     LD   A,E   
06A8   91                     SUB   C   ; A = the length of the text, with its CR LF
06A9   C5                     PUSH   BC   ; the text
06AA   4F                     LD   C,A   
06AB   06 00                  LD   B,0   
06AD   C5                     PUSH   BC   ; its length
06AE   54                     LD   D,H   
06AF   5D                     LD   E,L   ; DE = where it goes
06B0   AF                     XOR   A   
06B1   4F                     LD   C,A   ; BC = 0: CPIR looks as far as it needs to
06B2   ED B1                  CPIR      ; HL -> one past the program's NUL
06B4   ED 52                  SBC   HL,DE   ; the number of bytes to move up, NUL included
06B6   44                     LD   B,H   
06B7   4D                     LD   C,L   
06B8   19                     ADD   HL,DE   
06B9   2B                     DEC   HL   ; HL -> the NUL
06BA   EB                     EX   DE,HL   
06BB   E3                     EX   (SP),HL   ; HL = the length; where it goes is kept
06BC   E5                     PUSH   HL   
06BD   19                     ADD   HL,DE   ; the NUL's new place
06BE   EB                     EX   DE,HL   
06BF   ED B8                  LDDR      ; move the rest of the program up
06C1   C1                     POP   BC   ; the length
06C2   D1                     POP   DE   ; where it goes
06C3   E1                     POP   HL   ; the text
06C4   ED B0                  LDIR      
06C6   C3 88 05     GEDIT:    JP   edit   
06C9                             ; ^G: run the program. st0p: run the typed line (BC -> it).
06C9   01 00 83     CRUN:     LD   BC,PROG   
06CC   3E                     DB   3Eh   ; (LD A,n: steps over the POP)
06CD   E1           ST0P:     POP   HL   ; (the end of what was typed)
06CE                             ; st0: start running at BC. The heap starts after the stored program's NUL.
06CE   21 00 83     ST0:      LD   HL,PROG   
06D1   AF                     XOR   A   
06D2   BE           ST1:      CP   (HL)   
06D3   23                     INC   HL   
06D4   20 FC                  JR   NZ,st1   
06D6   22 7C 82               LD   (HEAP),HL   
06D9                          ENDIF      
06D9                          IF   EDITOR*CHECKED   
06D9   E7                     RST   20h   ; minus the heap"s first address: "_' may not
06DA   22 38 82               LD   (NPEND),HL   ;   release below it
06DD                          ENDIF      
06DD                          IF   EDITOR   
06DD   E1                     POP   HL   ; TOS: the data stack is as the last line left it
06DE   F7                     RST   30h   ; (its return address is thrown away)
06DF                             ; ^L: list from line n. DE = the number of the line at HL.
06DF   CD 34 02     CLIST:    CALL   rdnum   ; HL = n, or 0 if there was none:
06E2   7C                     LD   A,H   
06E3   B5                     OR   L   
06E4   20 01                  JR   NZ,li0   
06E6   2C                     INC   L   ;   then from line 1
06E7   E5           LI0:      PUSH   HL   
06E8   CD 7F 07               CALL   find   
06EB   D1                     POP   DE   
06EC   7E           LI1:      LD   A,(HL)   
06ED   B7                     OR   A   
06EE   28 D6                  JR   Z,gedit   ; the end of the text
06F0   CD 06 FF               CALL   rawk   
06F3   28 09                  JR   Z,li3   ; no key: carry on
06F5   FE 03                  CP   3   
06F7   C4 28 06               CALL   NZ,ekey   ; any key but Ctrl-C: wait for one more
06FA   FE 03                  CP   3   
06FC   28 C8                  JR   Z,gedit   ; Ctrl-C, first or second, ends the list
06FE   E5           LI3:      PUSH   HL   
06FF   D5                     PUSH   DE   
0700   EB                     EX   DE,HL   
0701   CD A0 02               CALL   pdec   ; the line's number,
0704   3E 20                  LD   A," "   
0706   EF                     RST   28h   ;   a space,
0707   D1                     POP   DE   
0708   E1                     POP   HL   
0709   13                     INC   DE   
070A   CD 97 07               CALL   prl   ;   and the line
070D   18 DD                  JR   li1   
070F                             ; ^V: view.
070F   CD 35 05     CVIEW:    CALL   pmsg   
0712   42 38 53 5A 38 30 45   DB   "B8SZ80E"   
0719                          ENDIF      
0719                          IF   EDITOR*CHECKED   
0719   43                     DB   "C"   
071A                          ENDIF      
071A                          IF   EDITOR   
071A   20 32 30 32 36 2D 31 31 2D 32 31 22 DB   " 2026-11-21",22h   
0726   CD C2 04               CALL   pstk   ; both stacks
0729   21 00 83               LD   HL,PROG   
072C   11 FF FF               LD   DE,0FFFFh   
072F   13           CV1:      INC   DE   ; count the lines, and find the end
0730   CD 8D 07               CALL   nxl   
0733   20 FA                  JR   NZ,cv1   
0735   E5                     PUSH   HL   ; the NUL
0736   D5                     PUSH   DE   ; the lines
0737   11 00 7D               LD   DE,(0-PROG)&0FFFFh   
073A   19                     ADD   HL,DE   
073B   CD 2F 05               CALL   pnl   
073E   50 72 6F 67 20 22      DB   "Prog ",22h   
0744   CD A0 02               CALL   pdec   ; the program's size
0747   E1                     POP   HL   
0748   CD 2F 05               CALL   pnl   
074B   4C 69 6E 65 73 20 22   DB   "Lines ",22h   
0752   CD A0 02               CALL   pdec   
0755   D1                     POP   DE   
0756                          ENDIF      
0756                          IF   EDGEN   
0756   21 FF EF               LD   HL,HEAPLIM*256-1   
0759                          ENDIF      
0759                          IF   EDITOR*CPM   
                              LD   A,(0007h)   ; the BDOS page is the limit
                              LD   H,A   
                              LD   L,0   
                              DEC   HL   
0759                          ENDIF      
0759                          IF   EDITOR   
0759   B7                     OR   A   
075A   ED 52                  SBC   HL,DE   
075C   CD 2F 05               CALL   pnl   
075F   46 72 65 65 20 22      DB   "Free ",22h   
0765   CD A0 02               CALL   pdec   ; the room left for text and heap
0768   CD 2F 05               CALL   pnl   
076B   22                     DB   22h   
076C   C3 88 05     GED1:     JP   edit   
076F                             ; delln: take line n (in HL) out: copy everything after it down over it.
076F   CD 7F 07     DELLN:    CALL   find   
0772   54                     LD   D,H   
0773   5D                     LD   E,L   
0774   CD 8D 07               CALL   nxl   ; HL -> the next line
0777   7E           DE1:      LD   A,(HL)   
0778   12                     LD   (DE),A   
0779   23                     INC   HL   
077A   13                     INC   DE   
077B   B7                     OR   A   
077C   20 F9                  JR   NZ,de1   
077E   C9                     RET      
077F                             ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
077F                             ; of the text if there are fewer lines (or the number is 0). Keeps BC.
077F   EB           FIND:     EX   DE,HL   
0780   21 00 83               LD   HL,PROG   
0783   1B           FI1:      DEC   DE   
0784   7A                     LD   A,D   
0785   B3                     OR   E   
0786   C8                     RET   Z   
0787   CD 8D 07               CALL   nxl   
078A   20 F7                  JR   NZ,fi1   
078C   C9                     RET      
078D                             ; nxl: step HL over one line, to just past its LF (and return not-zero), or
078D                             ; stop at the NUL that ends the text (and return zero).
078D   7E           NXL:      LD   A,(HL)   
078E   B7                     OR   A   
078F   C8                     RET   Z   
0790   23                     INC   HL   
0791   FE 0A                  CP   10   
0793   20 F8                  JR   NZ,nxl   
0795   B7                     OR   A   
0796   C9                     RET      
0797                             ; prl: print the line at HL, to its LF; HL -> just past it.
0797   7E           PRL:      LD   A,(HL)   
0798   EF                     RST   28h   
0799   7E                     LD   A,(HL)   
079A   23                     INC   HL   
079B   FE 0A                  CP   10   
079D   20 F8                  JR   NZ,prl   
079F   C9                     RET      
07A0                          ENDIF      
07A0                          IF   EDGEN   
07A0                             ; ^R, generic: what comes in from now until ^Z is the program. A CR is
07A0                             ; stored as CR LF; a LF right after a line end is dropped (it is the CR's
07A0                             ; own, or an empty line's), and a LF anywhere else ends a line too. A last
07A0                             ; line with no end is given one. Nothing is echoed, and there is no check
07A0                             ; for running out of memory.
07A0   21 FF 82     CREAD:    LD   HL,PROG-1   
07A3   36 0A                  LD   (HL),10   ; (as if a line had just ended: the byte is
07A5   23                     INC   HL   ;   the line buffer's last, and spare)
07A6   CD 28 06     RD1:      CALL   ekey   
07A9   4F                     LD   C,A   
07AA   FE 1A                  CP   1Ah   
07AC   20 02                  JR   NZ,rd2   
07AE   3E 0A                  LD   A,10   ; ^Z ends the last line, as a LF would
07B0   FE 0A        RD2:      CP   10   
07B2   20 07                  JR   NZ,rd3   
07B4   2B                     DEC   HL   
07B5   BE                     CP   (HL)   
07B6   23                     INC   HL   
07B7   28 0B                  JR   Z,rd4   ; straight after a line end: dropped
07B9   3E 0D                  LD   A,13   ; anywhere else it ends the line
07BB   77           RD3:      LD   (HL),A   
07BC   23                     INC   HL   
07BD   FE 0D                  CP   13   
07BF   20 03                  JR   NZ,rd4   
07C1   36 0A                  LD   (HL),10   ; after a CR goes a LF
07C3   23                     INC   HL   
07C4   79           RD4:      LD   A,C   
07C5   FE 1A                  CP   1Ah   
07C7   20 DD                  JR   NZ,rd1   
07C9   36 00                  LD   (HL),0   
07CB   18 9F                  JR   ged1   
07CD                             ; ^W, generic: the text is printed as it is, for the terminal to capture.
07CD   21 00 83     CWRITE:   LD   HL,PROG   
07D0   7E           CW1:      LD   A,(HL)   
07D1   B7                     OR   A   
07D2   28 98                  JR   Z,ged1   
07D4   EF                     RST   28h   
07D5   23                     INC   HL   
07D6   18 F8                  JR   cw1   
07D8                          ENDIF      
07D8                          IF   EDITOR*CPM   
                    CFCB:     EQU   005Ch   ; the file's name is kept here, where the CCP
                                 ;   put the one from the command line
                                 ; ^R, CP/M: read the file. A name typed before the key is the file's name
                                 ; from now on.
                    CREAD:    CALL   setname   
                              CALL   load   
                              JP   edit   
                                 ; ^W, CP/M: write the file: delete the old one, make it anew, write the
                                 ; text in records of 128 bytes, and close it. The text's NUL and the 127
                                 ; bytes after it are set to ^Z meanwhile, which pads the last record. (A
                                 ; full disk or directory is not noticed: the calls fail and that is all.)
                    CWRITE:   CALL   setname   
                              LD   C,19   ; delete
                              CALL   fbdos   
                              LD   C,22   ; make
                              CALL   fbdos   
                              LD   HL,PROG   
                              XOR   A   
                    CW1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,cw1   
                              DEC   HL   ; HL -> the NUL
                              PUSH   HL   
                              LD   B,128   
                    CW2:      LD   (HL),1Ah   
                              INC   HL   
                              DJNZ   cw2   
                              POP   HL   
                              LD   DE,PROG   
                    CW3:      LD   A,E   ; a record that starts before the end is written
                              SUB   L   
                              LD   A,D   
                              SBC   A,H   
                              JR   NC,cw4   
                              PUSH   HL   
                              LD   C,21   ; write, from where the record lies
                              CALL   frec   
                              POP   HL   
                              JR   cw3   
                    CW4:      LD   (HL),0   ; the NUL again
                              LD   C,16   ; close
                              CALL   fbdos   
                              JP   edit   
                                 ; frec: BDOS function C (read or write a record) with the 128 bytes at DE.
                                 ; Returns A = the BDOS's answer, HL = DE and DE = DE + 128.
                    FREC:     PUSH   DE   
                              PUSH   BC   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              POP   BC   
                              CALL   fbdos   
                              POP   HL   
                              LD   DE,128   
                              EX   DE,HL   
                              ADD   HL,DE   
                              EX   DE,HL   
                              RET      
                                 ; setname: if a name was typed (the line does not start with its CR), put it
                                 ; in the FCB: up to 8 characters, a dot, up to 3 more, in capitals. The drive
                                 ; is the current one. Then, name or no name, clear the FCB after the name,
                                 ; as it must be before a file is opened or made.
                    SETNAME:   LD   DE,LINEBUF   
                              LD   A,(DE)   
                              CP   13   
                              JR   Z,fcbclr   
                              LD   HL,CFCB   
                              LD   (HL),0   ; the current drive
                              LD   B,11   
                    SN1:      INC   L   
                              LD   (HL)," "   
                              DJNZ   sn1   
                              LD   L,CFCB+1   
                    SN2:      LD   A,(DE)   
                              INC   DE   
                              CP   13   
                              JR   Z,fcbclr   
                              CP   "."   
                              JR   NZ,sn3   
                              LD   L,CFCB+9   ; the type
                              JR   sn2   
                    SN3:      CP   "a"   
                              JR   C,sn4   
                              AND   5Fh   ; a capital
                    SN4:      LD   (HL),A   
                              INC   L   
                              JR   sn2   
                    FCBCLR:   LD   HL,CFCB+12   
                              LD   B,24   
                    FC1:      LD   (HL),0   
                              INC   HL   
                              DJNZ   fc1   
                              RET      
                                 ; fbdos: BDOS function C on the file
                    FBDOS:    LD   DE,CFCB   
                              JP   BDOS   
                                 ; load: read the file into PROG. No such file: no program. The text ends at
                                 ; the file"s first ^Z (1Ah), which pads a text file"s last record; one more
                                 ; goes after the last record, so the search always stops. And every line
                                 ; must end in LF: a last line without one is given a CR LF. (The FCB is
                                 ; clear after its name: the CCP left it so, or setname did.)
                    LOAD:     LD   C,15   ; open (no such file: the first read fails
                              CALL   fbdos   ;   too)
                              LD   DE,PROG   
                    LD1:      LD   C,20   ; read the next 128 bytes
                              CALL   frec   
                              OR   A   
                              JR   Z,ld1   
                              LD   (HL),1Ah   ; (HL = where the record that failed would be)
                              LD   HL,PROG-1   
                              LD   A,10   ; (a file with no text needs nothing added)
                    TR1:      INC   HL   
                              LD   E,A   ; E = the character before this one
                              LD   A,(HL)   
                              CP   1Ah   
                              JR   NZ,tr1   
                              LD   A,E   
                              CP   10   
                              JR   Z,tr2   
                              LD   (HL),13   
                              INC   HL   
                              LD   (HL),10   
                              INC   HL   
                    TR2:      LD   (HL),0   
                              RET      
07D8                          ENDIF      
07D8                             ; =============================================================================
07D8                          IF   CPM   
                                 ; The RAM pages follow the image; the heap may grow to the BDOS.
                    START:       
07D8                          ENDIF      
07D8                          IF   CPM*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
                                 ; is held back.
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
07D8                          ENDIF      
07D8                          IF   CPM   
                              LD   HL,vecs   ; the RST routines go down into page zero
                              LD   DE,0008h   
                              LD   BC,vecend-vecs   
                              LDIR      
07D8                          ENDIF      
07D8                          IF   CPM*EDITOR   
                              CALL   load   ; the file named on the command line
                              JP   edit0   
07D8                          ENDIF      
07D8                          IF   CPM*(1-EDITOR)   
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:      LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
                              JP   st2   
07D8                          ENDIF      
07D8                          IF   CPM   
                                 ; RAM pages, after the image
                    RSPAGE:   EQU   (imgend + 255) / 256   
                    DSPAGE:   EQU   RSPAGE + 1   
                    LETPAGE:   EQU   RSPAGE + 2   
                    PROG:     EQU   LETPAGE*256 + 256   
07D8                          ENDIF      
07D8                IMGEND:      


