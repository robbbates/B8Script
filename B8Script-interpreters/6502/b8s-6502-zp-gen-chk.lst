E331   A9 00        UDIV:     LDA   #0   
E333   95 FE                  STA   0FEh,X   
E335   95 FF                  STA   0FFh,X   
E337   A5 08                  LDA   D0   
E339   49 02                  EOR   #2   
E33B   05 09                  ORA   D1   
E33D   D0 07                  BNE   ud0   
E33F   56 01                  LSR   1,X   
E341   76 00                  ROR   0,X   
E343   36 FE                  ROL   0FEh,X   
E345   60                     RTS      
E346   A0 10        UD0:      LDY   #16   
E348   16 00        UD1:      ASL   0,X   
E34A   36 01                  ROL   1,X   
E34C   36 FE                  ROL   0FEh,X   
E34E   36 FF                  ROL   0FFh,X   
E350   38                     SEC      
E351   B5 FE                  LDA   0FEh,X   
E353   E5 08                  SBC   D0   
E355   85 04                  STA   T0   
E357   B5 FF                  LDA   0FFh,X   
E359   E5 09                  SBC   D1   
E35B   90 08                  BCC   ud2   
E35D   95 FF                  STA   0FFh,X   
E35F   A5 04                  LDA   T0   
E361   95 FE                  STA   0FEh,X   
E363   F6 00                  INC   0,X   
E365   88           UD2:      DEY      
E366   D0 E0                  BNE   ud1   
E368   60                     RTS      
E369                             ; =============================================================================
E369                             ;  The grave's codes (h_grave, in the third page, is the dispatcher). Each
E369                             ;  starts with Y = its place in the table, GCH.
E369                             ; 
E369                             ;    `!  ( addr -- )        call the machine code at addr
E369                             ;    `$  ( addr -- addr' )  the hex loader: pairs of hex digits are stored
E369                             ;                           from addr until a non-hex character; then a RTS
E369                             ;                           (60h) is written and its address is left. An odd
E369                             ;                           last digit is consumed and dropped.
E369                             ;    `'  ( -- )             new line: CR LF
E369                             ;    `+  ( addr -- n )      add 1 to the cell at addr and leave its new value
E369                             ;    `,  ( n -- r )         a random number from 0 to n-1 (n is 1 to 32767)
E369                             ;    `-  ( addr -- n )      subtract 1 from the cell at addr, the same way
E369                             ;    `.  ( -- addr )        the address of the random seed
E369                             ;    `<  ( a b -- n )       the smaller of the two (signed)
E369                             ;    `>  ( a b -- n )       the larger
E369                             ;    `?  ( flag -- )        the cursor off (0) or on
E369                             ;    `@  ( row col -- )     the cursor to that row and column, both from 0
E369                             ;    `^  ( -- )             clear the screen and home the cursor
E369                             ;    `_  ( -- )             clear from the cursor to the end of the line
E369                             ; =============================================================================
E369                             ; (The order matters: "-" just before "+", "<" at an even place and ">" at
E369                             ; the odd one after it, and the handlers in the same order in memory.)
E369   24 27        GCH:      DB   "$",27h   
E36B   2D 2B 2E 2C 3C 3E 3F 40 5E 5F 21 GMINUS:   DB   "-","+",".",",","<",">","?","@","^","_","!"   
E376   82           GLO:      DB   (g_hex-1) & 0FFh   
E377   A0                     DB   (g_nl-1) & 0FFh   
E378   AA                     DB   (g_inc-1) & 0FFh   
E379   AA                     DB   (g_inc-1) & 0FFh   
E37A   CE                     DB   (g_seed-1) & 0FFh   
E37B   D5                     DB   (g_rnd-1) & 0FFh   
E37C   17                     DB   (g_min-1) & 0FFh   
E37D   17                     DB   (g_min-1) & 0FFh   
E37E   26                     DB   (g_cur-1) & 0FFh   
E37F   43                     DB   (g_at-1) & 0FFh   
E380   69                     DB   (g_cls-1) & 0FFh   
E381   71                     DB   (g_eol-1) & 0FFh   
E382   7A                     DB   (g_exec-1) & 0FFh   
E383                             ; The page of each handler, and GK: 13 less the table entries whose handler
E383                             ; is in the second page. (One division to a line: asm80 only rounds down
E383                             ; when it stores a value.)
E383                GQ0:      EQU   (g_hex-1)/256   
E383                GQ1:      EQU   (g_nl-1)/256   
E383                GQ2:      EQU   (g_inc-1)/256   
E383                GQ4:      EQU   (g_seed-1)/256   
E383                GQ5:      EQU   (g_rnd-1)/256   
E383                GQ6:      EQU   (g_min-1)/256   
E383                GQ8:      EQU   (g_cur-1)/256   
E383                GQ9:      EQU   (g_at-1)/256   
E383                GQ10:     EQU   (g_cls-1)/256   
E383                GQ11:     EQU   (g_eol-1)/256   
E383                GQ12:     EQU   (g_exec-1)/256   
E383                GK:       EQU   13+12*GQ0-GQ1-GQ2-GQ2-GQ4-GQ5-GQ6-GQ6-GQ8-GQ9-GQ10-GQ11-GQ12   
E383                             ; `$ (never checked: the spec says so)
E383   20 2C E6     G_HEX:    JSR   rdhex   
E386   B0 14                  BCS   hx2   
E388   0A                     ASL      
E389   0A                     ASL      
E38A   0A                     ASL      
E38B   0A                     ASL      
E38C   85 04                  STA   T0   
E38E   20 2C E6               JSR   rdhex   
E391   B0 09                  BCS   hx2   ; odd digit: already consumed, dropped
E393   05 04                  ORA   T0   
E395   81 00                  STA   (0,X)   
E397   20 8B E2               JSR   inctos   
E39A   90 E7                  BCC   g_hex   ; always (rdhex left the carry clear)
E39C   A9 60        HX2:      LDA   #60h   
E39E   81 00                  STA   (0,X)   
E3A0   60                     RTS      
E3A1   A9 0D        G_NL:     LDA   #13   
E3A3   20 03 FF               JSR   CONOUT   
E3A6   A9 0A                  LDA   #10   
E3A8   4C 03 FF               JMP   CONOUT   
E3AB                             ; `+ and `-: one routine. It adds 0000h with the carry set, or FFFFh with it
E3AB                             ; clear: SBC turns the carry into that 00 or FF and leaves the carry as it
E3AB                             ; was. The cell is reached a byte at a time through the top cell, which
E3AB                             ; moves on between.
E3AB                G_INC:       
E3AB                          IF   CHECKED   
E3AB   20 24 E3               JSR   chkst   ; each byte"s address is tested, as for "!'
E3AE                          ENDIF      
E3AE   C0 03                  CPY   #GMINUS-GCH+1   ; carry: "+"
E3B0   A9 00                  LDA   #0   
E3B2   E9 00                  SBC   #0   
E3B4   85 05                  STA   T1   
E3B6   61 00                  ADC   (0,X)   
E3B8   81 00                  STA   (0,X)   
E3BA   48                     PHA      
E3BB   20 8B E2               JSR   inctos   ; (keeps the carry)
E3BE                          IF   CHECKED   
E3BE   08                     PHP      
E3BF   20 24 E3               JSR   chkst   
E3C2   28                     PLP      
E3C3                          ENDIF      
E3C3   A5 05                  LDA   T1   
E3C5   61 00                  ADC   (0,X)   
E3C7   81 00                  STA   (0,X)   
E3C9   95 01                  STA   1,X   ; the new value is TOS
E3CB   68                     PLA      
E3CC   95 00                  STA   0,X   
E3CE   60                     RTS      
E3CF                             ; `. pushes the address of the random seed.
E3CF   A9 76        G_SEED:   LDA   #<SEED   
E3D1   A0 04                  LDY   #>SEED   
E3D3   4C C1 E5               JMP   pushay   
E3D6                             ; `, ( n -- r ). The seed goes one step on: seed * 261 + 1, which takes
E3D6                             ; every 16-bit value in turn. The high bits of such a seed are the good ones
E3D6                             ; and the low ones repeat soon, so the high byte is folded into the low
E3D6                             ; (EOR) before the remainder of dividing by n is taken.
E3D6                             ; n must be 1 to 32767: the checked build stops with Z on anything less
E3D6                             ; than 1.
E3D6                G_RND:       
E3D6                          IF   CHECKED   
E3D6   B5 01                  LDA   1,X   
E3D8   30 04                  BMI   gr9   
E3DA   15 00                  ORA   0,X   
E3DC   D0 03                  BNE   gr8   
E3DE   4C 81 E1     GR9:      JMP   e_zero   
E3E1                GR8:         
E3E1                          ENDIF      
E3E1   B5 00                  LDA   0,X   
E3E3   85 08                  STA   D0   
E3E5   B5 01                  LDA   1,X   
E3E7   85 09                  STA   D1   ; D = n
E3E9   AD 76 04               LDA   SEED   
E3EC   AC 77 04               LDY   SEED+1   
E3EF   20 C3 E5               JSR   setay   ; the seed in n's place,
E3F2   A9 05                  LDA   #05h   ;   and 261 (0105h) on top of it
E3F4   A0 01                  LDY   #01h   
E3F6   20 C1 E5               JSR   pushay   
E3F9   20 5B E1               JSR   h_mul   ; TOS = seed * 261
E3FC   20 8B E2               JSR   inctos   
E3FF   B5 00                  LDA   0,X   
E401   8D 76 04               STA   SEED   
E404   B5 01                  LDA   1,X   
E406   8D 77 04               STA   SEED+1   
E409   55 00                  EOR   0,X   
E40B   95 00                  STA   0,X   
E40D   20 31 E3               JSR   udiv   ; TOS = the quotient, the remainder under it
E410   CA                     DEX      
E411   CA                     DEX      
E412   20 B6 E0               JSR   h_swap   
E415   4C 15 E1               JMP   drop   ; the remainder is TOS
E418                             ; `< and `>: one routine. scmp leaves the carry clear if a < b. Y is even
E418                             ; for "<" and odd for ">" (their places in the table), so the low bit of Y
E418                             ; plus the carry is clear when a, the cell below, is the one to keep.
E418   20 3D E1     G_MIN:    JSR   scmp   
E41B   98                     TYA      
E41C   69 00                  ADC   #0   
E41E   4A                     LSR      
E41F   90 03                  BCC   gm1   
E421   20 B6 E0               JSR   h_swap   ; b is wanted: a on top, to be dropped
E424   4C 15 E1     GM1:      JMP   drop   
E427                          IF   ANSI   
E427                             ; `? ( flag -- ): ESC [ ? 2 5 l hides the cursor, ESC [ ? 2 5 h shows it.
E427   A0 04        G_CUR:    LDY   #4   
E429   B9 3F E4     GC1:      LDA   GQ25,Y   
E42C   20 03 FF               JSR   CONOUT   
E42F   88                     DEY      
E430   10 F7                  BPL   gc1   
E432   20 C8 E5               JSR   flag   
E435   F0 03                  BEQ   gc2   
E437   A9 68                  LDA   #"h"   
E439   2C                     DB   2Ch   ; (BIT abs: hides the next instruction)
E43A   A9 6C        GC2:      LDA   #"l"   
E43C   4C 03 FF               JMP   CONOUT   
E43F   35 32 3F 5B 1B GQ25:   DB   "5","2","?","[",27   ; (printed from the end)
E444                             ; `@ ( row col -- ): ESC [ row+1 ; col+1 H. (ANSI counts from 1.)
E444   20 60 E4     G_AT:     JSR   csi   
E447   20 B6 E0               JSR   h_swap   ; the row on top
E44A   20 5A E4               JSR   pinc   
E44D   A9 3B                  LDA   #";"   
E44F   20 03 FF               JSR   CONOUT   
E452   20 5A E4               JSR   pinc   
E455   A9 48                  LDA   #"H"   
E457   4C 03 FF               JMP   CONOUT   
E45A                             ; pinc: print TOS + 1, unsigned, and drop it
E45A   20 8B E2     PINC:     JSR   inctos   
E45D   4C 87 E0               JMP   pn1   
E460                             ; csi: print ESC [, which starts every ANSI sequence. Keeps X and Y.
E460   A9 1B        CSI:      LDA   #27   
E462   20 03 FF               JSR   CONOUT   
E465   A9 5B                  LDA   #"["   
E467   4C 03 FF               JMP   CONOUT   
E46A                             ; `^: ESC [ H homes the cursor, and ESC [ J clears from there to the end of
E46A                             ; the screen. `_: ESC [ K clears to the end of the line.
E46A   A0 48        G_CLS:    LDY   #"H"   
E46C   20 74 E4               JSR   csiy   
E46F   A0 4A                  LDY   #"J"   
E471   2C                     DB   2Ch   ; (BIT abs: hides the next instruction)
E472   A0 4B        G_EOL:    LDY   #"K"   
E474                             ; csiy: print ESC [ and the character in Y
E474   20 60 E4     CSIY:     JSR   csi   
E477   98                     TYA      
E478   4C 03 FF               JMP   CONOUT   
E47B                          ENDIF      
E47B                          IF   1-ANSI   
                                 ; With ANSI = 0 the machine's own routines do the work (see the equates).
                    G_CUR:    JSR   flag   ; A = 0 and Z set: off
                              JMP   CONCUR   
                    G_AT:     LDY   2,X   ; Y = the row
                              LDA   0,X   ; A = the column
                              JSR   CONAT   
                              INX      
                              INX      
                              JMP   drop   
                    G_CLS:    JMP   CONCLS   
                    G_EOL:    JMP   CONEOL   
E47B                          ENDIF      
E47B                             ; `! ( addr -- ): call the machine code at addr; see the contract in the
E47B                             ; header.
E47B   B5 00        G_EXEC:   LDA   0,X   
E47D   85 04                  STA   T0   
E47F   B5 01                  LDA   1,X   
E481   85 05                  STA   T1   
E483   E8                     INX      ; the address is consumed
E484   E8                     INX      
E485   6C 04 00               JMP   (T0)   
E488                          IF   CHECKED   
E488                             ; The checked build's inner loop, out of page 1, where it would not fit,
E488                             ; and its break check (described with the unchecked one in page 1).
E488                             ; pnext: the break check, then (falling through) next. A word call, a true
E488                             ; "(" and a true ")" end here, but the keyboard is looked at only once in 256
E488                             ; of them: CDOWN counts them down. A key found is held; a Ctrl-C goes on to ctlc. (Startup
E488                             ; falls in here too, which does no harm.)
E488   CE 79 04     PNEXT:    DEC   CDOWN   
E48B   D0 0B                  BNE   next   
E48D   20 06 FF               JSR   KEY   
E490   F0 06                  BEQ   next   ; no key
E492   8D 7A 04               STA   KEYBUF   ; held for the next "?"
E495   20 23 E5               JSR   chk3   ; (Ctrl-C: back only if the break key is off)
E498                NEXT:        
E498                             ; Both stacks are checked once per character, after it has run. The
E498                             ; return stack has overrun when S is below RSLIM: an overflow leaves
E498                             ; it at 1Eh or 1Fh, an underflow wraps it to 01h (no handler pulls
E498                             ; more than one entry). The data stack has when X is above DSE (an
E498                             ; underflow) or below DSFULL (an overflow). No handler moves X by
E498                             ; more than 4, so X is caught before it wraps; an overrun by a cell
E498                             ; or two writes on the scratch bytes below or above the stack.
E498                             ; S is kept in RSV, for the report's Rtn line (an error found inside
E498                             ; a handler has its own calls on the hardware stack), and the place
E498                             ; of the character about to run in PLACE.
E498   8A                     TXA      ; TSX trashes X: keep it in A
E499   BA                     TSX      
E49A   8E 35 04               STX   RSV   
E49D   E0 20                  CPX   #RSLIM   
E49F   AA                     TAX      ; TAX leaves the carry alone
E4A0   90 16                  BCC   e_rstack   
E4A2   E0 F1                  CPX   #DSE+1   
E4A4   B0 24                  BCS   e_sund   
E4A6   E0 10                  CPX   #DSFULL   
E4A8   90 25                  BCC   e_sovr   
E4AA   A5 00                  LDA   IP   
E4AC   85 08                  STA   PLACE   
E4AE   A5 01                  LDA   IP+1   
E4B0   85 09                  STA   PLACE+1   
E4B2   20 69 E5               JSR   step   
E4B5   4C 98 E4               JMP   next   
E4B8                             ; S/R are overflows, s/r underflows. After an underflow that stack counts as
E4B8                             ; empty.
E4B8   AD 35 04     E_RSTACK:   LDA   RSV   
E4BB   C9 10                  CMP   #10h   
E4BD   A9 52                  LDA   #"R"   
E4BF   B0 10                  BCS   ejmp   ; S is 1Eh-1Fh: an overflow
E4C1   A9 FF                  LDA   #0FFh   
E4C3   8D 35 04               STA   RSV   ; S wrapped to 01h: Rtn 0
E4C6   A9 72                  LDA   #"r"   
E4C8   D0 07                  BNE   ejmp   ; always
E4CA   A2 F0        E_SUND:   LDX   #DSE   ; Stk 0
E4CC   A9 73                  LDA   #"s"   
E4CE   2C                     DB   2Ch   ; (BIT abs: hides the next instruction)
E4CF   A9 53        E_SOVR:   LDA   #"S"   
E4D1   4C 57 E6     EJMP:     JMP   error   
E4D4                             ; skip, checked: as the unchecked one above, and A holds, on the way in, the wrong closer for the
E4D4                             ; opener that started the skip, kept in T0: ] for (, ) for [, and 0 for \,
E4D4                             ; which takes either. Meeting the wrong closer at this level, or the end
E4D4                             ; (a NUL, or a string that runs into it), stops with N, except for \,
E4D4                             ; which then ends the program as before.
E4D4   85 04        SKIP:     STA   T0   
E4D6   A9 00                  LDA   #0   
E4D8   85 06                  STA   T2   ; depth
E4DA   20 3D E6     SK1:      JSR   getc   
E4DD   F0 26                  BEQ   sknul   
E4DF   C9 22                  CMP   #22h   
E4E1   D0 05                  BNE   sk2   
E4E3   20 5E E0               JSR   skipstr   ; leaves A = 11h, which matches nothing below
E4E6   F0 1D                  BEQ   sknul   ; the string ran into the end
E4E8   C9 28        SK2:      CMP   #"("   
E4EA   F0 15                  BEQ   sk3   
E4EC   C9 5B                  CMP   #"["   
E4EE   F0 11                  BEQ   sk3   
E4F0   C9 29                  CMP   #")"   
E4F2   F0 04                  BEQ   sk4   
E4F4   C9 5D                  CMP   #"]"   
E4F6   D0 E2                  BNE   sk1   
E4F8   C6 06        SK4:      DEC   T2   
E4FA   10 DE                  BPL   sk1   
E4FC   C5 04                  CMP   T0   
E4FE   F0 0C                  BEQ   e_nest   ; the wrong kind
E500   60                     RTS      ; the closer at this level
E501   E6 06        SK3:      INC   T2   
E503   D0 D5                  BNE   sk1   
E505   A5 04        SKNUL:    LDA   T0   
E507   D0 03                  BNE   e_nest   ; ( and [ stop with N
E509   4C 09 FF               JMP   EXIT   ; \ ends the program
E50C   A9 4E        E_NEST:   LDA   #"N"   ; a skip from ( or [ found the wrong closer
E50E   4C 57 E6               JMP   error   ;   or the end: the place is the opener
E511                          ENDIF      
E511                          IF   1-CHECKED   
                    CBREAK:   EQU   endp   ; the unchecked build stops without a word
E511                          ENDIF      
E511                          IF   CHECKED   
E511                CBREAK:   EQU   e_break   ; the checked build reports B
E511                          ENDIF      
E511                             ; getk: a key for "?" in A (zero flag clear), or A = 0 with the zero flag
E511                             ; set when there is none. Keeps X and Y. The held key goes first, and is
E511                             ; taken out of KEYBUF.
E511   AD 7A 04     GETK:     LDA   KEYBUF   
E514   F0 08                  BEQ   gk1   
E516   48                     PHA      
E517   A9 00                  LDA   #0   
E519   8D 7A 04               STA   KEYBUF   
E51C   68                     PLA      
E51D   60                     RTS      
E51E   20 06 FF     GK1:      JSR   KEY   
E521   F0 04                  BEQ   gk9   
E523                             ; chk3: a key in A (not 0). A Ctrl-C goes on to ctlc, which gives the 03h
E523                             ; back if it comes back at all.
E523   C9 03        CHK3:     CMP   #3   
E525   F0 01                  BEQ   ctlc   
E527   60           GK9:      RTS      
E528                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
E528                             ; the program has turned it off, wait about 250 ms (about 250 times MSLOOP
E528                             ; looks: T1 counts the 256s, T2 runs on from whatever it holds) for one more
E528                             ; key: a second Ctrl-C is the end too; any other key is held (the newest
E528                             ; wins). Returns A = 03h with the zero flag clear. Keeps X and Y. (Not D0/D1:
E528                             ; they hold the place in the checked build.)
E528   AD 7B 04     CTLC:     LDA   BRKOFF   
E52B   F0 1D                  BEQ   cbreak   
E52D   A9 28                  LDA   #CWAIT+1   
E52F   85 05                  STA   T1   
E531   20 06 FF     CT2:      JSR   KEY   
E534   D0 0A                  BNE   ct3   
E536   C6 06                  DEC   T2   
E538   D0 F7                  BNE   ct2   
E53A   C6 05                  DEC   T1   
E53C   D0 F3                  BNE   ct2   
E53E   F0 07                  BEQ   ct9   ; always: none came
E540   C9 03        CT3:      CMP   #3   
E542   F0 06                  BEQ   cbreak   
E544   8D 7A 04               STA   KEYBUF   
E547   A9 03        CT9:      LDA   #3   
E549   60                     RTS      
E54A                          IF   CHECKED   
E54A   A9 42        E_BREAK:   LDA   #"B"   ; Ctrl-C (the stacks as they stand)
E54C   2C                     DB   2Ch   ; (BIT abs: hides the next instruction)
E54D   A9 58        E_RESV:   LDA   #"X"   ; a reserved byte, 80h-FFh
E54F   4C 57 E6     EJMP2:    JMP   error   
E552                             ; e_undef: the word cells of undefined words hold 0000h. A call there reads
E552                             ; the byte at 0000h, which is IP's own low byte: 00h while IP is 0000h, so
E552                             ; the call reads a NUL with IP in page zero, where no program can be. The
E552                             ; call is undone first: the step frame and the return address come off the
E552                             ; hardware stack, and the place is the call letter (the return address - 1).
E552   68           E_UNDEF:   PLA      
E553   68                     PLA      ; the step frame
E554   68                     PLA      
E555   38                     SEC      
E556   E9 01                  SBC   #1   
E558   85 08                  STA   PLACE   
E55A   68                     PLA      
E55B   E9 00                  SBC   #0   
E55D   85 09                  STA   PLACE+1   
E55F   EE 35 04               INC   RSV   
E562   EE 35 04               INC   RSV   ; Rtn does not count the call
E565   A9 55                  LDA   #"U"   
E567   D0 E6                  BNE   ejmp2   ; always
E569                          ENDIF      
E569                             ; step: read one character and sort it by range.
E569                             ;    00h          end of program
E569                             ;    01h-20h, 7Fh-FFh   ignored
E569                             ;    30h-39h      digit: read a whole number
E569                             ;    41h-5Ah      A-Z: call the word in that letter's cell
E569                             ;    61h-7Ah      a-z: push the address of that letter's cell
E569                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
E569   20 3D E6     STEP:     JSR   getc   ; flags follow A
E56C   F0 3D                  BEQ   endp   
E56E   38                     SEC      
E56F   E9 21                  SBC   #21h   ; A = c - 21h
E571   90 37                  BCC   ign   ; 01h-20h
E573   C9 0F                  CMP   #0Fh   
E575   90 24                  BCC   punct   ; 21h-2Fh: index 0-14
E577   E9 0F                  SBC   #0Fh   ; (carry set) A = c - 30h
E579   C9 0A                  CMP   #10   
E57B   90 72                  BCC   digit   
E57D   C9 11                  CMP   #11h   
E57F   90 18                  BCC   p3a   ; 3Ah-40h
E581   E9 11                  SBC   #11h   ; (carry set) A = c - 41h
E583   C9 1A                  CMP   #1Ah   
E585   90 2B                  BCC   upper   ; 41h-5Ah
E587   C9 20                  CMP   #20h   
E589   90 0C                  BCC   p5b   ; 5Bh-60h
E58B   C9 3A                  CMP   #3Ah   
E58D   90 2F                  BCC   lower   ; 61h-7Ah: A = 20h-39h
E58F   C9 3E                  CMP   #3Eh   
E591                          IF   1-CHECKED   
                              BCS   ign   ; 7Fh-FFh
E591                          ENDIF      
E591                          IF   CHECKED   
E591   F0 17                  BEQ   ign   ; 7Fh
E593   B0 B8                  BCS   e_resv   ; 80h-FFh: reserved
E595                          ENDIF      
E595                             ; The three adjustments below chain. Each ADC adds the carry the one
E595                             ; before it left, which the constants allow for.
E595   E9 1A                  SBC   #1Ah   ; 7Bh-7Eh: (carry clear: -1Bh) index 28-31
E597   69 F6        P5B:      ADC   #0F6h   ; 5Bh-60h: -10 (-9 when chained), index 22-27
E599   69 05        P3A:      ADC   #5   ; 3Ah-40h: +5 (+6 when chained), index 15-21
E59B                             ; Punctuation: A = the index. The handler's page is the first, plus one if
E59B                             ; the index is N1 or more, plus one more if it is N2 or more.
E59B   C9 08        PUNCT:    CMP   #N1   
E59D   A8                     TAY      
E59E   A9 70                  LDA   #HALFPG   
E5A0   2A                     ROL      ; the first page, or the second (carry clear)
E5A1   C0 15                  CPY   #N2   
E5A3   69 00                  ADC   #0   ; ... or the third (and the carry is clear)
E5A5   48                     PHA      
E5A6   B9 CF E5               LDA   PTAB,Y   
E5A9   48                     PHA      
E5AA   60           IGN:      RTS      ; RTS trick: goes to the handler. Reached
E5AB                             ; directly, it just ends an ignored character.
E5AB                ENDP:        ; the program has ended
E5AB                          IF   CHECKED   
E5AB   A5 01                  LDA   IP+1   ; IP in page zero: an undefined word
E5AD   F0 A3                  BEQ   e_undef   
E5AF                          ENDIF      
E5AF   4C 09 FF               JMP   EXIT   
E5B2                             ; A-Z: call the word. The return address (the IP after the letter) goes on
E5B2                             ; the return stack, and the IP becomes the address in the letter's cell.
E5B2   0A           UPPER:    ASL      
E5B3   A8                     TAY      
E5B4   38                     SEC      
E5B5   4C D7 E0               JMP   pushn   
E5B8   A5 00        PUSHIP:   LDA   IP   ; push the reading position
E5BA   A4 01                  LDY   IP+1   
E5BC   D0 03                  BNE   pushay   ; always: no program is in page zero
E5BE                             ; a-z: push the cell's address (the cell is the variable)
E5BE   0A           LOWER:    ASL      
E5BF   A0 04                  LDY   #>LET   
E5C1                             ; pushay: push a cell: A = its low byte, Y = its high byte
E5C1   CA           PUSHAY:   DEX      
E5C2   CA                     DEX      
E5C3   95 00        SETAY:    STA   0,X   ; setay: TOS = A (low), Y (high)
E5C5   94 01                  STY   1,X   
E5C7   60                     RTS      
E5C8                             ; flag: pops TOS and returns with Z set if it was 0. Keeps the carry.
E5C8   E8           FLAG:     INX      
E5C9   E8                     INX      
E5CA   B5 FE                  LDA   0FEh,X   
E5CC   15 FF                  ORA   0FFh,X   
E5CE   60                     RTS      
E5CF                             ; =============================================================================
E5CF                             ;  Dispatch table: the low byte of (handler - 1) for each punctuation
E5CF                             ;  character, in code order.
E5CF                             ; =============================================================================
E5CF   A6           PTAB:     DB   (h_store-1) & 0FFh   ; !
E5D0   54                     DB   (h_str-1) & 0FFh   ; "
E5D1   7A                     DB   (h_num-1) & 0FFh   ; #
E5D2   2C                     DB   (h_print-1) & 0FFh   ; $
E5D3   B5                     DB   (h_swap-1) & 0FFh   ; %
E5D4   C6                     DB   (h_and-1) & 0FFh   ; &
E5D5   72                     DB   (h_emit-1) & 0FFh   ; '
E5D6   D1                     DB   (h_open-1) & 0FFh   ; (
E5D7   B7                     DB   (h_close-1) & 0FFh   ; )
E5D8   5A                     DB   (h_mul-1) & 0FFh   ; *
E5D9   20                     DB   (h_add-1) & 0FFh   ; +
E5DA   AE                     DB   (h_cfetch-1) & 0FFh   ; ,
E5DB   17                     DB   (h_sub-1) & 0FFh   ; -
E5DC   0B                     DB   (h_cstore-1) & 0FFh   ; .
E5DD   85                     DB   (h_div-1) & 0FFh   ; /
E5DE   04                     DB   (h_dup-1) & 0FFh   ; :
E5DF   14                     DB   (drop-1) & 0FFh   ; ;
E5E0   35                     DB   (h_lt-1) & 0FFh   ; <
E5E1   4A                     DB   (h_eq-1) & 0FFh   ; =
E5E2   32                     DB   (h_gt-1) & 0FFh   ; >
E5E3   BE                     DB   (h_key-1) & 0FFh   ; ?
E5E4   7B                     DB   (h_fetch-1) & 0FFh   ; @
E5E5   A0                     DB   (h_def-1) & 0FFh   ; [
E5E6   23                     DB   (h_break-1) & 0FFh   ; \
E5E7   37                     DB   (h_ret-1) & 0FFh   ; ]
E5E8   65                     DB   (h_xor-1) & 0FFh   ; ^
E5E9   E6                     DB   (h_alloc-1) & 0FFh   ; _
E5EA   C4                     DB   (h_grave-1) & 0FFh   ; `
E5EB   49                     DB   (h_tor-1) & 0FFh   ; {
E5EC   70                     DB   (h_or-1) & 0FFh   ; |
E5ED   55                     DB   (h_fromr-1) & 0FFh   ; }
E5EE   62                     DB   (h_not-1) & 0FFh   ; ~
E5EF                             ; Digits: the first one is in A; read the rest of the number.
E5EF   A0 00        DIGIT:    LDY   #0   
E5F1   20 C1 E5               JSR   pushay   
E5F4                             ; rdnum: TOS = TOS*10 + digit for each digit at IP. Wraps at 16 bits.
E5F4                             ; Returns with the carry set.
E5F4   20 23 E6     RDNUM:    JSR   isdig   
E5F7   B0 4F                  BCS   ic9   ; (an RTS)
E5F9   20 40 E6               JSR   incip   ; (keeps A = the digit)
E5FC   16 00                  ASL   0,X   
E5FE   36 01                  ROL   1,X   ; x2
E600   18                     CLC      
E601   75 00                  ADC   0,X   
E603   85 04                  STA   T0   
E605   B5 01                  LDA   1,X   
E607   69 00                  ADC   #0   
E609   85 05                  STA   T1   ; T = x2 + digit
E60B   16 00                  ASL   0,X   
E60D   36 01                  ROL   1,X   
E60F   16 00                  ASL   0,X   
E611   36 01                  ROL   1,X   ; x8
E613   18                     CLC      
E614   B5 00                  LDA   0,X   
E616   65 04                  ADC   T0   
E618   95 00                  STA   0,X   
E61A   B5 01                  LDA   1,X   
E61C   65 05                  ADC   T1   
E61E   95 01                  STA   1,X   ; x8 + x2 + digit
E620   4C F4 E5               JMP   rdnum   
E623                             ; isdig: A = the character at IP minus "0"; the carry is clear if it is a
E623                             ; digit. Y = 0.
E623   20 49 E6     ISDIG:    JSR   peek   
E626   38                     SEC      
E627   E9 30                  SBC   #"0"   
E629   C9 0A                  CMP   #10   
E62B   60                     RTS      
E62C                             ; rdhex: if IP is at a hex digit (0-9, A-F, a-f), return its value in A with
E62C                             ; the carry clear and IP moved on; otherwise the carry is set and IP stays.
E62C   20 23 E6     RDHEX:    JSR   isdig   
E62F   90 0F                  BCC   incip   
E631   29 DF                  AND   #0DFh   
E633   E9 11                  SBC   #11h   ; (the carry is set)
E635   C9 06                  CMP   #6   
E637   B0 0F                  BCS   ic9   
E639   69 0A                  ADC   #10   
E63B   D0 03                  BNE   incip   ; always
E63D                             ; Reading the program
E63D                             ;    peek: A = the character at IP, IP unchanged, Y = 0
E63D                             ;    getc: the same, then IP moves on; flags follow A
E63D                             ;    incip: IP moves on; keeps A, the carry and Y
E63D   20 49 E6     GETC:     JSR   peek   
E640   E6 00        INCIP:    INC   IP   
E642   D0 02                  BNE   ic1   
E644   E6 01                  INC   IP+1   
E646   09 00        IC1:      ORA   #0   
E648   60           IC9:      RTS      
E649   A0 00        PEEK:     LDY   #0   
E64B   B1 00                  LDA   (IP),Y   
E64D   60                     RTS      
E64E                             ; rstip: point IP at the start of the program
E64E   A9 00        RSTIP:    LDA   #<PROG   
E650   85 00                  STA   IP   
E652   A9 05                  LDA   #>PROG   
E654   85 01                  STA   IP+1   
E656   60                     RTS      
E657                          IF   CHECKED   
E657                             ; =============================================================================
E657                             ;  Checked build: the error report
E657                             ; =============================================================================
E657                             ; error: the report, then EXIT. A = the letter, PLACE = the place, X = the
E657                             ; data stack to show, RSV = S for the Rtn line. Nothing here relies on S: an
E657                             ; overflowed or underflowed hardware stack wraps inside its page, and only
E657                             ; its depth is shown.
E657                             ;   CR LF
E657                             ;   Err X @ line,col CR LF
E657                             ;   up to 16 characters from the place, raw, up to a CR, LF or NUL  CR LF
E657                             ;   Stk n: [...] and the top 8 cells at most, bottom to top  CR LF
E657                             ;   Rtn n CR LF
E657                             ; The numbers go through "#" (prnum), which pushes them over the data stack
E657                             ; and pops them again, so the stack is shown as it was. With the stack full
E657                             ; (X = 0Eh) that reaches down to 0Ah, so nothing the report keeps is there.
E657   48           ERROR:    PHA      ; the letter
E658   A5 08                  LDA   PLACE   
E65A   85 02                  STA   P   
E65C   A5 09                  LDA   PLACE+1   
E65E   85 03                  STA   P+1   ; (the numbers need D0/D1)
E660   A0 00                  LDY   #M_ERR-MSG   
E662   20 FE E6               JSR   prs   ; CR LF "Err "
E665   68                     PLA      
E666   20 03 FF               JSR   CONOUT   
E669   20 FE E6               JSR   prs   ; " @ " (it follows M_ERR)
E66C   20 29 E7               JSR   lcol   
E66F   A5 0A                  LDA   LN   
E671   A4 0B                  LDY   LN+1   
E673   20 F8 E6               JSR   prnum   ; the line
E676   A9 2C                  LDA   #","   
E678   20 03 FF               JSR   CONOUT   
E67B   A5 05                  LDA   T1   
E67D   A4 06                  LDY   T2   
E67F   20 F8 E6               JSR   prnum   ; the column
E682   A0 09                  LDY   #M_NL-MSG   
E684   20 FE E6               JSR   prs   
E687   A0 00                  LDY   #0   ; the text at the place
E689   B1 02        ER1:      LDA   (P),Y   
E68B   F0 10                  BEQ   er2   
E68D   C9 0D                  CMP   #13   
E68F   F0 0C                  BEQ   er2   
E691   C9 0A                  CMP   #10   
E693   F0 08                  BEQ   er2   
E695   20 03 FF               JSR   CONOUT   
E698   C8                     INY      
E699   C0 10                  CPY   #16   
E69B   D0 EC                  BNE   er1   
E69D   A0 0B        ER2:      LDY   #M_STK-MSG   
E69F   20 FE E6               JSR   prs   ; CR LF "Stk "
E6A2   8A                     TXA      
E6A3   49 FF                  EOR   #0FFh   
E6A5   38                     SEC      
E6A6   E9 0F                  SBC   #0FFh-DSE   
E6A8   4A                     LSR      ; the depth, (DSE - X) / 2
E6A9   48                     PHA      
E6AA   20 F6 E6               JSR   prnum8   
E6AD   68                     PLA      
E6AE   A0 16                  LDY   #M_C-MSG   ; ":"
E6B0   C9 09                  CMP   #9   
E6B2   90 04                  BCC   er3   
E6B4   A9 08                  LDA   #8   ; more than 8: ": ..." and the top 8
E6B6   A0 11                  LDY   #M_CD-MSG   
E6B8   85 05        ER3:      STA   T1   ; T1 = how many cells to show
E6BA   20 FE E6               JSR   prs   
E6BD   A5 05        ER4:      LDA   T1   ; cells T1-1 down to 0, the top last: cell i
E6BF   F0 1F                  BEQ   er5   ;   from the top is at X+2i
E6C1   C6 05                  DEC   T1   
E6C3   A9 20                  LDA   #" "   
E6C5   20 03 FF               JSR   CONOUT   
E6C8   A5 05                  LDA   T1   
E6CA   0A                     ASL      
E6CB   85 06                  STA   T2   
E6CD   8A                     TXA      
E6CE   65 06                  ADC   T2   ; (the carry is clear)
E6D0   A8                     TAY      
E6D1   B9 00 00               LDA   0,Y   
E6D4   48                     PHA      
E6D5   B9 01 00               LDA   1,Y   
E6D8   A8                     TAY      
E6D9   68                     PLA      
E6DA   20 F8 E6               JSR   prnum   
E6DD   4C BD E6               JMP   er4   
E6E0   A0 17        ER5:      LDY   #M_RTN-MSG   
E6E2   20 FE E6               JSR   prs   ; CR LF "Rtn "
E6E5   AD 35 04               LDA   RSV   
E6E8   49 FF                  EOR   #0FFh   
E6EA   4A                     LSR      ; (FFh - S) / 2 entries
E6EB   20 F6 E6               JSR   prnum8   
E6EE   A0 09                  LDY   #M_NL-MSG   
E6F0   20 FE E6               JSR   prs   
E6F3   4C 09 FF               JMP   EXIT   
E6F6                             ; prnum: print the number A (low), Y (high), signed, keeping the data stack.
E6F6                             ; prnum8: the same for A alone, 0-255.
E6F6   A0 00        PRNUM8:   LDY   #0   
E6F8   20 C1 E5     PRNUM:    JSR   pushay   
E6FB   4C 7B E0               JMP   h_num   
E6FE                             ; prs: print the message at MSG+Y; its last byte has bit 7 set. Y ends just
E6FE                             ; past it, at the next message.
E6FE   B9 0C E7     PRS:      LDA   MSG,Y   
E701   48                     PHA      
E702   29 7F                  AND   #7Fh   
E704   20 03 FF               JSR   CONOUT   
E707   C8                     INY      
E708   68                     PLA      
E709   10 F3                  BPL   prs   
E70B   60                     RTS      
E70C                MSG:         
E70C   0D 0A 45 72 72 A0 M_ERR:   DB   13,10,"Err"," "+80h   
E712   20 40 A0               DB   " @"," "+80h   
E715   0D 8A        M_NL:     DB   13,10+80h   
E717   0D 0A 53 74 6B A0 M_STK:   DB   13,10,"Stk"," "+80h   
E71D   3A 20 2E 2E AE M_CD:   DB   ": ..","."+80h   
E722   BA           M_C:      DB   ":"+80h   
E723   0D 0A 52 74 6E A0 M_RTN:   DB   13,10,"Rtn"," "+80h   
E729                             ; lcol: the line (LN) and the column (T1/T2) of the place at P, both from
E729                             ; 1. A place below the program is in the -n? line buffer: line 0, and the
E729                             ; column is the place in the buffer. Otherwise IP (free now: the program has
E729                             ; stopped) runs from PROG to the place, counting LFs; T1/T2 keeps where the
E729                             ; last line started, and the column is the place minus that, plus 1.
E729   A9 00        LCOL:     LDA   #0   
E72B   85 0B                  STA   LN+1   
E72D   85 0A                  STA   LN   
E72F   A9 80                  LDA   #<LINEBUF   
E731   85 05                  STA   T1   
E733   A9 04                  LDA   #>LINEBUF   
E735   85 06                  STA   T2   
E737   A5 02                  LDA   P   
E739   C9 00                  CMP   #<PROG   
E73B   A5 03                  LDA   P+1   
E73D   E9 05                  SBC   #>PROG   
E73F   90 26                  BCC   lc9   ; below the program: line 0
E741   E6 0A                  INC   LN   
E743   20 4E E6               JSR   rstip   
E746   A5 00        LC3:      LDA   IP   ; a line starts here
E748   85 05                  STA   T1   
E74A   A5 01                  LDA   IP+1   
E74C   85 06                  STA   T2   
E74E   A5 00        LC1:      LDA   IP   
E750   C5 02                  CMP   P   
E752   A5 01                  LDA   IP+1   
E754   E5 03                  SBC   P+1   
E756   B0 0F                  BCS   lc9   ; at the place
E758   20 3D E6               JSR   getc   
E75B   C9 0A                  CMP   #10   
E75D   D0 EF                  BNE   lc1   
E75F   E6 0A                  INC   LN   ; an LF: a new line starts after it
E761   D0 E3                  BNE   lc3   
E763   E6 0B                  INC   LN+1   
E765   D0 DF                  BNE   lc3   ; always
E767   A5 02        LC9:      LDA   P   
E769   38                     SEC      
E76A   E5 05                  SBC   T1   
E76C   85 05                  STA   T1   
E76E   A5 03                  LDA   P+1   
E770   E5 06                  SBC   T2   
E772   85 06                  STA   T2   
E774   E6 05                  INC   T1   ; + 1
E776   D0 02                  BNE   lc8   
E778   E6 06                  INC   T2   
E77A   60           LC8:      RTS      
E77B                          ENDIF      


