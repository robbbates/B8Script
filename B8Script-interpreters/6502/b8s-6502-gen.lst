E491                             ;  Machine code: the grave
E491                             ; =============================================================================
E491                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
E491                             ; are stored from addr until a non-hex character; then a RET (60h) is
E491                             ; written and its address is left. An odd last digit is consumed and dropped.
E491                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ); see the
E491                             ; contract in the header.
E491   20 C3 E4     H_GRAVE:   JSR   rdhex   
E494   B0 1F                  BCS   exec   
E496   0A           HX1:      ASL      
E497   0A                     ASL      
E498   0A                     ASL      
E499   0A                     ASL      
E49A   85 04                  STA   T0   
E49C   20 C3 E4               JSR   rdhex   
E49F   B0 0F                  BCS   hx2   ; odd digit: already consumed, dropped
E4A1   05 04                  ORA   T0   
E4A3                          IF   CHECKED   
                              STA   T0   
                              LDA   TH   
                              JSR   chkst   
                              LDA   T0   
E4A3                          ENDIF      
E4A3   91 02                  STA   (TL),Y   ; Y is 0 after rdhex
E4A5   E6 02                  INC   TL   
E4A7   D0 02                  BNE   hx3   
E4A9   E6 03                  INC   TH   
E4AB   20 C3 E4     HX3:      JSR   rdhex   
E4AE   90 E6                  BCC   hx1   
E4B0                HX2:         
E4B0                          IF   CHECKED   
                              LDA   TH   
                              JSR   chkst   
E4B0                          ENDIF      
E4B0   A9 60                  LDA   #60h   
E4B2   91 02                  STA   (TL),Y   
