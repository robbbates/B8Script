F54D   8D 17        G_CUR:    BSR   csi   
F54F   86 3F                  LDA   #"?"   
F551   8D 19                  BSR   gputc   
F553   86 32                  LDA   #"2"   
F555   8D 15                  BSR   gputc   
F557   86 35                  LDA   #"5"   
F559   8D 11                  BSR   gputc   
F55B   AE C1                  LDX   ,U++   ; the flag
F55D   27 03                  BEQ   gc1   
F55F   86 68                  LDA   #"h"   
F561   8C                     FCB   8Ch   ; (CMPX #: steps over the LDA)
F562   86 6C        GC1:      LDA   #"l"   
F564   20 06                  BRA   gputc   
F566                             ; csi: print ESC [, which starts every ANSI sequence.
F566   86 1B        CSI:      LDA   #27   
F568   8D 02                  BSR   gputc   
F56A   86 5B                  LDA   #"["   
F56C                          ENDIF      
F56C   7E FF 03     GPUTC:    JMP   CONOUT   
F56F                          IF   ANSI   
F56F                             ; `@ ( row col -- ): ESC [ row+1 ; col+1 H. (ANSI counts from 1.)
F56F   8D F5        G_AT:     BSR   csi   
F571   BD F2 EE               JSR   h_swap   ; the row on top
F574   8D 0A                  BSR   pinc   
F576   86 3B                  LDA   #";"   
F578   8D F2                  BSR   gputc   
F57A   8D 04                  BSR   pinc   
F57C   86 48                  LDA   #"H"   
F57E   20 EC                  BRA   gputc   
F580                             ; pinc: print the top cell plus 1, unsigned, and drop it
F580   6C 41        PINC:     INC   1,U   
F582   26 02                  BNE   pi1   
F584   6C C4                  INC   ,U   
F586   7E F4 19     PI1:      JMP   pdec   
F589                          ENDIF      
F589                          IF   1-ANSI   
                                 ; With ANSI = 0 the machine's own routines do the work (see the equates).
                    G_CLS:    JMP   CONCLS   
                    G_EOL:    JMP   CONEOL   
                    G_CUR:    LDD   ,U++   ; D = the flag, and the Z flag says the same
                              JMP   CONCUR   
                    G_AT:     LDD   ,U++   ; D = the column
                              LDX   ,U++   ; X = the row
                              JMP   CONAT   
F589                          ENDIF      
F589                             ; ---- the line reader of -n? (see h_key) --------------------------------------
F589                             ; Backspace takes the last character back (and is echoed as it is), CR ends
F589                             ; (stored, not echoed), every other key is stored and echoed until the line
F589                             ; is full. B = the length so far; the low byte of the top cell becomes the
F589                             ; most allowed (it holds minus the count on entry).
F589   8C FF 81     LINE:     CMPX   #-127   ; (X = TOS, minus the count)
F58C   24 04                  BHS   ln1   
F58E   86 81                  LDA   #-127   ; more than 127 is taken as 127
F590   A7 41                  STA   1,U   
F592   60 41        LN1:      NEG   1,U   
F594   8E 82 80               LDX   #LINEBUF   
F597   5F                     CLRB      
F598   BD F0 ED     LN2:      JSR   getk   
F59B   27 FB                  BEQ   ln2   
F59D   81 0D                  CMPA   #13   
F59F   27 16                  BEQ   ln5   
F5A1   81 08                  CMPA   #8   
F5A3   27 0C                  BEQ   ln4   
F5A5   E1 41                  CMPB   1,U   
F5A7   24 EF                  BHS   ln2   ; full
F5A9   A7 85                  STA   B,X   
F5AB   5C                     INCB      
F5AC   BD FF 03     LN3:      JSR   CONOUT   
F5AF   20 E7                  BRA   ln2   
F5B1   5D           LN4:      TSTB      ; Backspace: nothing to take back?
F5B2   27 E4                  BEQ   ln2   
F5B4   5A                     DECB      
F5B5   20 F5                  BRA   ln3   ; echo it
F5B7   A7 85        LN5:      STA   B,X   ; A = 13
F5B9   AF C4                  STX   ,U   
F5BB   39                     RTS      
F5BC                IMGEND:      


