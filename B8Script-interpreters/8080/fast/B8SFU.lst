0246   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
0247   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
0248   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
0249   E3           H_SWAP:   XTHL      ; "%"
024A                          ;*Macro unroll:  NEXT
024A                          DS   (1-CPM)*(1-FAST),0F7h   
024A   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
024B   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
024C   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
024D                             ; (The checked build tests the address before it takes the value off the
024D                             ; stack, so that an error report shows both.)
024D                H_STORE:      ; "!" ( n addr -- )
024D                          IF   CHECKED   
                              CALL   chkst   
024D                          ENDIF      
024D   D1                     POP   D   
024E   73                     MOV   M,E   
024F   23                     INX   H   
0250   72                     MOV   M,D   
0251                          ;*Macro unroll:  DROP
0251                          DS   (1-CPM)*(1-FAST),0DFh   
0251                          DS   CPM*(1-FAST),0C3h   
0251                          DS   CPM*(1-FAST),ADRP&0FFh   
0251                          DS   CPM*(1-FAST),ADRP/256   
0251   E1                     DS   FAST,0E1h   
0252   C3                     DS   FAST,0C3h   
0253   36                     DS   FAST,ANXT&0FFh   
0254   01                     DS   FAST,ANXT/256   
0255                H_CSTORE:      ; "." ( c addr -- )
0255                          IF   CHECKED   
                              CALL   chkst   
0255                          ENDIF      
0255   D1                     POP   D   
0256   73                     MOV   M,E   
0257                          ;*Macro unroll:  DROP
0257                          DS   (1-CPM)*(1-FAST),0DFh   
0257                          DS   CPM*(1-FAST),0C3h   
0257                          DS   CPM*(1-FAST),ADRP&0FFh   
0257                          DS   CPM*(1-FAST),ADRP/256   
0257   E1                     DS   FAST,0E1h   
0258   C3                     DS   FAST,0C3h   
0259   36                     DS   FAST,ANXT&0FFh   
025A   01                     DS   FAST,ANXT/256   
025B                             ; ---- console ---------------------------------------------------------------
025B                             ; 22h pushes the address of the text after it and skips the string.
025B   E5           H_STR:    PUSH   H   
025C   60                     MOV   H,B   
025D   69                     MOV   L,C   
025E   CD EA 05               CALL   skipstr   
0261                          IF   CHECKED   
                              ORA   A   ; 0: the text ran out before the closing quote
                              JZ   e_quote   
0261                          ENDIF      
0261                          ;*Macro unroll:  NEXT
0261                          DS   (1-CPM)*(1-FAST),0F7h   
0261   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
0262   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
0263   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
0264                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
0264                             ; 60h to 7Eh is one of the escapes at pesc; "/" plus any other character
0264                             ; clears that character"s bit 6 (/M is CR, and / then DEL gives "?"; "/',
0264                             ; '"' and '?' have no bit 6, so //, /" and /? give themselves).
0264                          IF   1-CHECKED   
0264   C3 CA 04     H_PRINT:   JMP   prlp   ; (the loop is with the escapes, out of the
0267                PRLOOP:   EQU   prlp   ;   way of the handlers, which must fit in
0267                PRAGAIN:   EQU   prlp   ;   the image's first two pages)
0267                          ENDIF      
0267                          IF   CHECKED   
                                 ; (The checked build has the loop as a routine, prstr, which the error
                                 ; report uses too. The address is kept meanwhile, for a report: it shows
                                 ; the stack as it was before the "$". /~ comes back to hp1.)
                    H_PRINT:   SHLD   PSAVE   
                    HP1:      CALL   prstr   
                              ;*Macro unroll:  DROP
                              DS   (1-CPM)*(1-FAST),0DFh   
                              DS   CPM*(1-FAST),0C3h   
                              DS   CPM*(1-FAST),ADRP&0FFh   
                              DS   CPM*(1-FAST),ADRP/256   
                              DS   FAST,0E1h   
                              DS   FAST,0C3h   
                              DS   FAST,ANXT&0FFh   
                              DS   FAST,ANXT/256   
0267                          ENDIF      
0267   7D           H_EMIT:   MOV   A,L   ; "'"
0268                          ;*Macro unroll:  PUTA
0268                          DS   1-CPM,0EFh   
0268   CD                     DS   CPM,0CDh   
0269   D4                     DS   CPM,APUT&0FFh   
026A   06                     DS   CPM,APUT/256   
026B                          ;*Macro unroll: h_drop: DROP                    ; ';' is this one byte
026B                H_DROP:   DS   (1-CPM)*(1-FAST),0DFh   ; ";" is this one byte
026B                          DS   CPM*(1-FAST),0C3h   
026B                          DS   CPM*(1-FAST),ADRP&0FFh   
026B                          DS   CPM*(1-FAST),ADRP/256   
026B   E1                     DS   FAST,0E1h   
026C   C3                     DS   FAST,0C3h   
026D   36                     DS   FAST,ANXT&0FFh   
026E   01                     DS   FAST,ANXT/256   
026F                             ; "#" prints TOS as a signed decimal number, with no space after it.
026F   C5           H_NUM:    PUSH   B   
0270   CD A9 04               CALL   psgn   
0273   C1                     POP   B   
0274                          ;*Macro unroll:  DROP
0274                          DS   (1-CPM)*(1-FAST),0DFh   
0274                          DS   CPM*(1-FAST),0C3h   
0274                          DS   CPM*(1-FAST),ADRP&0FFh   
0274                          DS   CPM*(1-FAST),ADRP/256   
0274   E1                     DS   FAST,0E1h   
0275   C3                     DS   FAST,0C3h   
0276   36                     DS   FAST,ANXT&0FFh   
0277   01                     DS   FAST,ANXT/256   
0278                          IF   CHECKED   ; (the checked build has no room to start ","
                    H_CFETCH:   MOV   L,M   ;   as late as the unchecked one does: see
                              MVI   H,0   ;   the end of "?")
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0C3h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
0278                          ENDIF      
0278                             ; "?" ( n -- c ) or ( -n -- addr )
0278                             ;   n > 0: wait about n ms for a key; 0 if none came
0278                             ;   n = 0: wait for a key
0278                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
0278                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
0278   7C           H_KEY:    MOV   A,H   
0279   B7                     ORA   A   
027A   FA 9C 02               JM   line   
027D   1E 04        KT1:      MVI   E,MSLOOP   ; one millisecond, roughly
027F   CD 9A 06     KT2:      CALL   getk   
0282   C2 96 02               JNZ   kt3   
0285   1D                     DCR   E   
0286   C2 7F 02               JNZ   kt2   
0289   7C                     MOV   A,H   ; 0? never counts down: it waits
028A   B5                     ORA   L   
028B   CA 7D 02               JZ   kt1   
028E   2B                     DCX   H   
028F   7C                     MOV   A,H   
0290   B5                     ORA   L   
0291   C2 7D 02               JNZ   kt1   ; A = 0 if the time ran out
0294                          IF   1-CHECKED   
0294   FE                     DB   0FEh   ; (CPI: steps over the one byte of ",")
0295   7E           H_CFETCH:   MOV   A,M   ; "," shares "?"s ending: A becomes TOS
0296                          ENDIF      
0296   6F           KT3:      MOV   L,A   
0297   26 00                  MVI   H,0   
0299                          ;*Macro unroll:  NEXT
0299                          DS   (1-CPM)*(1-FAST),0F7h   
0299   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
029A   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
029B   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
029C                             ; Backspace takes the last character back (and is echoed as
029C                             ; it is), CR ends (stored, not echoed), every other key is stored and
029C                             ; echoed until the line is full. The line buffer starts at offset 80h
029C                             ; of its page, so L alone is the place in the line: D holds the L of
029C                             ; a full line.
029C   11 7F 00     LINE:     LXI   D,127   ; TOS is minus the count: adding 127 carries
029F   19                     DAD   D   ;   only for 1 to 127, and leaves 127 - count
02A0   9F                     SBB   A   
02A1   A5                     ANA   L   ; (0 for a count that is too big)
02A2   2F                     CMA      
02A3   57                     MOV   D,A   ; D = the L of a full line: 80h + count, FFh
02A4                             ;   at most
02A4   21 80 16               LXI   H,LINEBUF   
02A7   CD 9A 06     LN2:      CALL   getk   
02AA   CA A7 02               JZ   ln2   
02AD   FE 0D                  CPI   13   
02AF   CA CE 02               JZ   ln5   
02B2   FE 08                  CPI   8   
02B4   CA C6 02               JZ   ln4   
02B7   5F                     MOV   E,A   
02B8   7D                     MOV   A,L   
02B9   BA                     CMP   D   
02BA   CA A7 02               JZ   ln2   ; full
02BD   73                     MOV   M,E   
02BE   2C                     INR   L   
02BF   7B                     MOV   A,E   
02C0                          ;*Macro unroll: ln3:    PUTA
02C0                LN3:      DS   1-CPM,0EFh   
02C0   CD                     DS   CPM,0CDh   
02C1   D4                     DS   CPM,APUT&0FFh   
02C2   06                     DS   CPM,APUT/256   
02C3   C3 A7 02               JMP   ln2   
02C6   2D           LN4:      DCR   L   ; Backspace: one back, and echo it,
02C7   FA C0 02               JM   ln3   ;   unless the line was empty (L left the
02CA   2C                     INR   L   ;   upper half of the page)
02CB   C3 A7 02               JMP   ln2   
02CE   77           LN5:      MOV   M,A   ; the CR
02CF   2E 80                  MVI   L,LINEBUF & 0FFh   
02D1                          ;*Macro unroll:  NEXT
02D1                          DS   (1-CPM)*(1-FAST),0F7h   
02D1   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
02D2   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
02D3   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
02D4                             ; =============================================================================
02D4                             ;  Dispatch table: the low byte of each handler's address, in code order.
02D4                             ;  It must not cross a page (the dispatcher only adds to its low byte).
02D4                             ; =============================================================================
02D4                             ; The handlers of the first NPG1 characters start in the image's second page.
02D4                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
02D4                             ; differs between the builds, so the count is worked out here.
02D4                             ; (One division to a line: asm80 only rounds down when it stores a value.)
02D4                          IF   1-FAST   
                    PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
                    PGBRK:    EQU   (h_break-BASE)/256   
                    PGDEF:    EQU   (h_def-BASE)/256   
                    PGFET:    EQU   (h_fetch-BASE)/256   
                    NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
02D4                          ENDIF      
02D4                          IF   (1-FAST)*(1-PTLATE)   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
02D4                          ENDIF      
02D4                             ; =============================================================================
02D4                             ;  Routines (no handler starts past this point)
02D4                             ; =============================================================================
02D4                             ; Digits: step back onto the first digit and read the whole number.
02D4   E5           DIGIT:    PUSH   H   
02D5   0B                     DCX   B   
02D6   CD E6 02               CALL   rdnum   
02D9                          ;*Macro unroll:  NEXT
02D9                          DS   (1-CPM)*(1-FAST),0F7h   
02D9   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
02DA   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
02DB   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
02DC                             ; negnum: "-" directly before a digit: read the number, negate it.
02DC   E5           NEGNUM:   PUSH   H   
02DD   CD E6 02               CALL   rdnum   
02E0                          ;*Macro unroll:  NEGH
02E0                          DS   1-CPM,0E7h   
02E0   CD                     DS   CPM,0CDh   
02E1   27                     DS   CPM,ANEG&0FFh   
02E2   01                     DS   CPM,ANEG/256   
02E3                          ;*Macro unroll:  NEXT
02E3                          DS   (1-CPM)*(1-FAST),0F7h   
02E3   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
02E4   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
02E5   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
02E6                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
02E6                             ; non-digit. Values wrap at 16 bits, as the spec says.
02E6   21 00 00     RDNUM:    LXI   H,0   
02E9   0A           RDN1:     LDAX   B   
02EA   D6 30                  SUI   "0"   
02EC   FE 0A                  CPI   10   
02EE   D0                     RNC      
02EF   03                     INX   B   
02F0   54                     MOV   D,H   
02F1   5D                     MOV   E,L   
02F2   29                     DAD   H   
02F3   29                     DAD   H   
02F4   19                     DAD   D   
02F5   29                     DAD   H   ; HL * 10
02F6   5F                     MOV   E,A   
02F7   16 00                  MVI   D,0   
02F9   19                     DAD   D   
02FA   C3 E9 02               JMP   rdn1   
02FD                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, BC = remainder.
02FD                             ; Uses A, BC; the caller saves the IP. HL holds the dividend and, as its bits
02FD                             ; leave at the top, the quotient bits arrive at the bottom. The loop counter
02FD                             ; lives on the stack, since A is busy with the shifts.
02FD                             ; Dividing by 2 is one shift (the spec wants that fast).
02FD   01 00 00     UDIV:     LXI   B,0   
0300                          IF   1-QK   
                              MOV   A,E   
                              XRI   2   
                              ORA   D   
                              JNZ   udv0   
                              ORA   H   ; A was 0, and the carry is clear
                              RAR      
                              MOV   H,A   
                              MOV   A,L   
                              RAR      
                              MOV   L,A   ; the quotient
                              MOV   A,B   
                              RAL      
                              MOV   C,A   ; the remainder: the bit that fell out
                              RET      
0300                          ENDIF      
0300                          IF   QK   
0300                             ; (The builds with room divide by any power of two with shifts: 2, and 32,
0300                             ; 64, 256 and the like, which fixed point and byte work use all the time.)
0300   7A                     MOV   A,D   
0301   B7                     ORA   A   
0302   C2 56 03               JNZ   uq1   ; 256 and up
0305   B3                     ORA   E   
0306   CA 6D 03               JZ   udv0   ; by 0: the long way (it means nothing anyway)
0309   3D                     DCR   A   
030A   A3                     ANA   E   
030B   C2 6D 03               JNZ   udv0   ; not a power of two
030E   7B                     MOV   A,E   ; by 2^k below 256: q = HL >> k, and
030F   3D                     DCR   A   ;   r = L & (2^k - 1)
0310   A5                     ANA   L   
0311   4F                     MOV   C,A   
0312                          ENDIF      
0312                          IF   QK*(1-FAST)   
                    UQ2:      MOV   A,E   ; one shift for each halving of E down to 1
                              ORA   A   
                              RAR      
                              RC      
                              MOV   E,A   
                              MOV   A,H   ; (the carry is clear: E's bit 0 was 0)
                              RAR      
                              MOV   H,A   
                              MOV   A,L   
                              RAR      
                              MOV   L,A   
                              JMP   uq2   
0312                          ENDIF      
0312                          IF   FAST   
0312                             ; (the fast build: the shifts unrolled. By 16 to 128 it is fewer shifts to
0312                             ; go the other way: A:HL up by 8 - k, and A:H is the quotient)
0312   7B           UQ2:      MOV   A,E   
0313   FE 10                  CPI   16   
0315   D2 39 03               JNC   uqh   
0318   FE 02                  CPI   2   
031A   D8                     RC      ; by 1
031B   CA 31 03               JZ   ur1   
031E   FE 04                  CPI   4   
0320   CA 2A 03               JZ   ur2   
0323                UR3:         
0323   7C                     MOV   A,H   
0324   B7                     ORA   A   
0325   1F                     RAR      
0326   67                     MOV   H,A   
0327   7D                     MOV   A,L   
0328   1F                     RAR      
0329   6F                     MOV   L,A   
032A                UR2:         
032A   7C                     MOV   A,H   
032B   B7                     ORA   A   
032C   1F                     RAR      
032D   67                     MOV   H,A   
032E   7D                     MOV   A,L   
032F   1F                     RAR      
0330   6F                     MOV   L,A   
0331                UR1:         
0331   7C                     MOV   A,H   
0332   B7                     ORA   A   
0333   1F                     RAR      
0334   67                     MOV   H,A   
0335   7D                     MOV   A,L   
0336   1F                     RAR      
0337   6F                     MOV   L,A   
0338   C9                     RET      
0339   FE 40        UQH:      CPI   64   
033B   3E 00                  MVI   A,0   
033D   CA 4F 03               JZ   ul2   
0340   D2 51 03               JNC   ul1   
0343   7B                     MOV   A,E   
0344   FE 20                  CPI   32   
0346   3E 00                  MVI   A,0   
0348   CA 4D 03               JZ   ul3   
034B   29                     DAD   H   ; by 16
034C   8F                     ADC   A   
034D   29           UL3:      DAD   H   
034E   8F                     ADC   A   
034F   29           UL2:      DAD   H   
0350   8F                     ADC   A   
0351   29           UL1:      DAD   H   
0352   8F                     ADC   A   
0353   6C                     MOV   L,H   
0354   67                     MOV   H,A   
0355   C9                     RET      
0356                          ENDIF      
0356                          IF   QK   
0356   7B           UQ1:      MOV   A,E   
0357   B7                     ORA   A   
0358   C2 6D 03               JNZ   udv0   
035B   7A                     MOV   A,D   
035C   3D                     DCR   A   
035D   A2                     ANA   D   
035E   C2 6D 03               JNZ   udv0   ; not a power of two
0361   7A                     MOV   A,D   ; by 2^k, 256 and up: r = HL & (2^k - 1), and
0362   3D                     DCR   A   ;   q = H >> (k - 8)
0363   A4                     ANA   H   
0364   47                     MOV   B,A   
0365   4D                     MOV   C,L   
0366   6C                     MOV   L,H   
0367   26 00                  MVI   H,0   
0369   5A                     MOV   E,D   
036A   C3 12 03               JMP   uq2   
036D                          ENDIF      
036D                          IF   1-FAST   
                    UDV0:     MVI   A,16   
                              PUSH   PSW   
                    UDV1:     DAD   H   ; next dividend bit into the carry
                              MOV   A,C   
                              RAL      
                              MOV   C,A   
                              MOV   A,B   
                              RAL      
                              MOV   B,A   ; BC = BC*2 + bit
                              MOV   A,C   
                              SUB   E   
                              MOV   A,B   
                              SBB   D   ; carry if BC < DE
                              JC   udv2   
                              MOV   B,A   ; BC - DE (high byte; A holds it)
                              MOV   A,C   
                              SUB   E   
                              MOV   C,A   
                              INR   L   ; quotient bit
                    UDV2:     POP   PSW   
                              DCR   A   
                              PUSH   PSW   
                              JNZ   udv1   
                              POP   PSW   
                              RET      
036D                          ENDIF      
036D                          IF   FAST   
036D                             ; (the fast build: the same 16 rounds, unrolled; and a dividend below 256
036D                             ; starts 8 bits up and takes only the last 8, since its first 8 would only
036D                             ; shift zeros)
036D   7C           UDV0:     MOV   A,H   
036E   B7                     ORA   A   
036F   CA A3 04               JZ   uvs   
0372   29           UV0:      DAD   H   
0373   79                     MOV   A,C   
0374   17                     RAL      
0375   4F                     MOV   C,A   
0376   78                     MOV   A,B   
0377   17                     RAL      
0378   47                     MOV   B,A   ; BC = BC*2 + bit
0379   79                     MOV   A,C   
037A   93                     SUB   E   
037B   78                     MOV   A,B   
037C   9A                     SBB   D   ; carry if BC < DE
037D   DA 85 03               JC   uw0   
0380   47                     MOV   B,A   
0381   79                     MOV   A,C   
0382   93                     SUB   E   
0383   4F                     MOV   C,A   
0384   2C                     INR   L   ; quotient bit
0385                UW0:         
0385   29           UV1:      DAD   H   
0386   79                     MOV   A,C   
0387   17                     RAL      
0388   4F                     MOV   C,A   
0389   78                     MOV   A,B   
038A   17                     RAL      
038B   47                     MOV   B,A   ; BC = BC*2 + bit
038C   79                     MOV   A,C   
038D   93                     SUB   E   
038E   78                     MOV   A,B   
038F   9A                     SBB   D   ; carry if BC < DE
0390   DA 98 03               JC   uw1   
0393   47                     MOV   B,A   
0394   79                     MOV   A,C   
0395   93                     SUB   E   
0396   4F                     MOV   C,A   
0397   2C                     INR   L   ; quotient bit
0398                UW1:         
0398   29           UV2:      DAD   H   
0399   79                     MOV   A,C   
039A   17                     RAL      
