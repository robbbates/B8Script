E73D                          IF   SBASEU   
                                 ; a-z, in the unchecked QK builds: a variable followed by "@" or "!" is
                                 ; fetched or stored in the same step (x@ is the commonest pair in most
                                 ; programs). A checked build checks the stacks between the two, so it keeps
                                 ; them apart. (pvar calls lowp, which only pushes.)
                    LOWQ:     ASL      
                              STA   T0   ; the cell's offset in the letter page
                              LDY   #0   
                              LDA   (IP),Y   
                              CMP   #"@"   
                              BEQ   lwf   
                              CMP   #"!"   
                              BEQ   lws   
                              LDA   T0   
                              LDY   #>LET   
                              JMP   pushay   ; the address
                    LWF:      JSR   incip   ; x@: TOS = the cell's value
                              LDY   T0   
                              DEX      
                              DEX      
                              LDA   LET,Y   
                              STA   0,X   
                              LDA   LET+1,Y   
                              STA   1,X   
                              RTS      
                    LWS:      JSR   incip   ; x!: the cell = TOS, and it is dropped
                              LDY   T0   
                              LDA   0,X   
                              STA   LET,Y   
                              LDA   1,X   
                              STA   LET+1,Y   
                              INX      
                              INX      
                              RTS      
E73D                          ENDIF      
E73D                          IF   QK   
E73D                             ; The skip cache. Nearly every skip is one that has happened before (a loop
E73D                             ; skips the same false block on every pass), so the first scan from each
E73D                             ; place is remembered: 64 entries of 00bbc3RhcnQsIHRoZSBjbG9zZXIncyBhZGRyZXNz, in CPAGE,
E73D                             ; found by the start's low byte times 4. Only skips that start in the
E73D                             ; program text are kept (the line buffer changes); the cache is emptied when
E73D                             ; the program starts. A program that changes its own text while it runs is
E73D                             ; not looked after. Where the skip started is kept in the scratch under the
E73D                             ; top cell, $FE,X and $FF,X. (The checked build: A holds the wrong closer on
E73D                             ; the way in, as at the checked skip above.)
E73D                SKIP:        
E73D                          ENDIF      
E73D                          IF   CHECKED*QK   
E73D   85 04                  STA   T0   
E73F                          ENDIF      
E73F                          IF   QK   
E73F   A5 01                  LDA   IP+1   
E741   C9 05                  CMP   #>PROG   
E743   90 24                  BCC   sks   ; below the program text: no cache
E745   A5 00                  LDA   IP   
E747   0A                     ASL      
E748   0A                     ASL      
E749   A8                     TAY      ; Y -> the entry
E74A   A5 00                  LDA   IP   
E74C   D9 00 02               CMP   CPAGE*256,Y   
E74F   D0 18                  BNE   sks   
E751   A5 01                  LDA   IP+1   
E753   D9 01 02               CMP   CPAGE*256+1,Y   
E756   D0 11                  BNE   sks   
E758   B9 02 02               LDA   CPAGE*256+2,Y   ; a hit: the IP goes to the closer, which is
E75B   85 00                  STA   IP   ;   read
E75D   B9 03 02               LDA   CPAGE*256+3,Y   
E760   85 01                  STA   IP+1   
E762   A0 00                  LDY   #0   
E764   B1 00                  LDA   (IP),Y   
E766   4C 8C EB               JMP   incip   
E769   A5 00        SKS:      LDA   IP   
E76B   95 FE                  STA   0FEh,X   
E76D   A5 01                  LDA   IP+1   
E76F   95 FF                  STA   0FFh,X   
E771   A0 00                  LDY   #0   
E773   84 06                  STY   T2   ; depth
E775                             ; The scan reads at IP+Y. Most characters are nothing to it, and two range
E775                             ; tests rule them out: * to Z, and ^ and up. Only NUL " ( ) [ ] count.
E775   B1 00        SQ1:      LDA   (IP),Y   
E777   C8                     INY      
E778   F0 1D                  BEQ   sqw   
E77A   C9 5E        SQ2:      CMP   #5Eh   
E77C   B0 F7                  BCS   sq1   ; ^ _ ` a-z 00bbIHwg ~ and up: nothing
E77E   C9 5B                  CMP   #5Bh   
E780   B0 2D                  BCS   sqb   ; [ \ ]
E782   C9 2A                  CMP   #2Ah   
E784   B0 EF                  BCS   sq1   ; * to Z: nothing
E786   C9 28                  CMP   #28h   
E788   F0 20                  BEQ   sqo   ; (
E78A   B0 29                  BCS   sqc   ; )
E78C   C9 22                  CMP   #22h   
E78E   F0 0B                  BEQ   sqq   ; a string
E790   C9 01                  CMP   #1   
E792   B0 E1                  BCS   sq1   ; the rest below "(": nothing
E794                          ENDIF      
