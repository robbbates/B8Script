E442                          IF   QK*(1-FAST)   
E442                             ; (QK: with an operand below 256, 8 rounds, not 16: that one becomes the
E442                             ; multiplier, so the product's low byte comes out of TL and its high byte is
E442                             ; left in T0. Most multiplications have one: a count or a small constant.)
E442   A5 03        H_MUL:    LDA   TH   
E444   F0 08                  BEQ   mq8   ; the multiplier is below 256
E446   BD 00 03               LDA   DSH,X   
E449   D0 2A                  BNE   mq16   
E44B   20 9C E4               JSR   h_swap   ; the multiplicand is: it becomes the multiplier
E44E   A0 08        MQ8:      LDY   #8   
E450   A9 00                  LDA   #0   
E452   85 04                  STA   T0   
E454   46 02                  LSR   TL   
E456   90 0F        MQ1:      BCC   mq2   
E458   85 05                  STA   T1   
E45A   18                     CLC      
E45B   A5 04                  LDA   T0   
E45D   7D 00 02               ADC   DSL,X   
E460   85 04                  STA   T0   
E462   A5 05                  LDA   T1   
E464   7D 00 03               ADC   DSH,X   
E467   6A           MQ2:      ROR      
E468   66 04                  ROR   T0   
E46A   66 02                  ROR   TL   
E46C   88                     DEY      
E46D   D0 E7                  BNE   mq1   
E46F   A5 04                  LDA   T0   
E471   85 03                  STA   TH   
E473   E8                     INX      
E474   60                     RTS      
E475                MQ16:        
E475                          ENDIF      
E475                          IF   1-QK   
                    H_MUL:       
E475                          ENDIF      
E475                          IF   1-FAST   
E475   A0 10                  LDY   #16   ; the round count
E477   A9 00                  LDA   #0   
E479   85 04                  STA   T0   ; A:T0 = the upper half
E47B   46 03                  LSR   TH   
E47D   66 02                  ROR   TL   ; the first multiplier bit
E47F   90 0F        ML1:      BCC   ml2   
E481   85 05                  STA   T1   
E483   18                     CLC      
E484   A5 04                  LDA   T0   
E486   7D 00 02               ADC   DSL,X   
E489   85 04                  STA   T0   
E48B   A5 05                  LDA   T1   
E48D   7D 00 03               ADC   DSH,X   ; upper half += the multiplicand
E490   6A           ML2:      ROR      
E491   66 04                  ROR   T0   
E493   66 03                  ROR   TH   
E495   66 02                  ROR   TL   ; everything one place right; next bit out
E497   88                     DEY      
E498   D0 E5                  BNE   ml1   
E49A   E8                     INX      ; drop the multiplicand
E49B   60                     RTS      
E49C                          ENDIF      
E49C   BC 00 02     H_SWAP:   LDY   DSL,X   ; "%"
E49F   A5 02                  LDA   TL   
E4A1   9D 00 02               STA   DSL,X   
E4A4   84 02                  STY   TL   
E4A6   BC 00 03               LDY   DSH,X   
E4A9   A5 03                  LDA   TH   
E4AB   9D 00 03               STA   DSH,X   
E4AE   84 03                  STY   TH   
E4B0   60                     RTS      
E4B1                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
E4B1                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b, r is pushed
E4B1                             ; and gets the sign of a. Unchecked, dividing by zero returns two cells of no
E4B1                             ; meaning; checked, it stops with Z.
E4B1                H_DIV:       
E4B1                          IF   CHECKED   
                              LDA   TL   
                              ORA   TH   
                              BEQ   e_zero   
E4B1                          ENDIF      
E4B1   BD 00 03               LDA   DSH,X   
E4B4   48                     PHA      ; a's sign: for r
E4B5   45 03                  EOR   TH   
E4B7   48                     PHA      ; a xor b: for q
E4B8   20 0B E4               JSR   absv   
E4BB   A5 02                  LDA   TL   
E4BD   85 08                  STA   D0   
E4BF   A5 03                  LDA   TH   
E4C1   85 09                  STA   D1   ; D = |b|
E4C3   20 B3 E3               JSR   drop   ; TOS = a
E4C6   20 0B E4               JSR   absv   ; TOS = |a|
E4C9   20 F2 E4               JSR   udiv   ; TOS = q, T0/T1 = r
E4CC   68                     PLA      
E4CD   20 0D E4               JSR   negm   ; q's sign
E4D0   A5 04                  LDA   T0   
E4D2   A4 05                  LDY   T1   
E4D4   20 0D E1               JSR   pushay   ; r on top
E4D7   68                     PLA      
E4D8   4C 0D E4               JMP   negm   ; r's sign
E4DB                             ; =============================================================================
E4DB                             ;  Storage
E4DB                             ; =============================================================================
E4DB                             ; "_" ( n -- addr ): the heap top moves by n, which is signed: a negative
E4DB                             ; count releases. TOS becomes the old top. (The carry is clear on the way in.)
E4DB                          IF   1-CHECKED   
E4DB   AD 7C 04     H_ALLOC:   LDA   HEAP   
E4DE   A8                     TAY      
E4DF   65 02                  ADC   TL   
E4E1   8D 7C 04               STA   HEAP   
E4E4   84 02                  STY   TL   
E4E6   AD 7D 04               LDA   HEAP+1   
E4E9   A8                     TAY      
E4EA   65 03                  ADC   TH   
E4EC   8D 7D 04               STA   HEAP+1   
E4EF   84 03                  STY   TH   
E4F1   60                     RTS      
E4F2                          ENDIF      
E4F2                             ; The checked build works the new top out first, in T0 and Y, and stops with
E4F2                             ; H, the count still on the stack, if it is at or past the limit, below the
E4F2                             ; program's end, or if the 16-bit add wrapped. A wrap is the V flag of the
E4F2                             ; high bytes" add with the old top"s sign bit flipped: that makes the old top
E4F2                             ; a signed number from -8000h, so the add overflows exactly when the true
E4F2                             ; sum leaves 0000h-FFFFh.
E4F2                          IF   CHECKED   
                    H_ALLOC:   LDA   HEAP   
                              ADC   TL   
                              STA   T0   
                              LDA   HEAP+1   
                              EOR   #80h   
                              ADC   TH   
                              BVS   e_heap   ; wrapped
                              EOR   #80h   ; the new top's high byte
                              CMP   #HEAPLIM   
                              BCS   e_heap   ; at or past the limit
                              TAY      
                              LDA   T0   
                              CMP   PEND   
                              TYA      
                              SBC   PEND+1   
                              BCC   e_heap   ; below the program's end
                              LDA   HEAP   
                              STA   TL   
                              LDA   T0   
                              STA   HEAP   
                              LDA   HEAP+1   
                              STA   TH   
                              STY   HEAP+1   
                              RTS      
                                 ; Errors found by handlers. The stacks are as they were before the handler.
                    E_ZERO:   LDA   #"Z"   ; divide by zero
                              DB   2Ch   ; (BIT abs: hides the next instruction)
                    E_HEAP:   LDA   #"H"   ; heap past the limit or below the program
                              DB   2Ch   
                    E_STORE:   LDA   #"O"   ; a store outside the program's space
                              JMP   error   
                                 ; chkst: stop unless the page in A is in the program's own space, from the
                                 ; letter page up to the heap limit. Keeps Y.
                    CHKST:    CMP   #LETPAGE   
                              BCC   e_store   
                              CMP   #HEAPLIM   
                              BCS   e_store   
                              RTS      
E4F2                          ENDIF      
E4F2                             ; udiv: unsigned TOS / D (D <= 8000h). TOS becomes the quotient and T0/T1
E4F2                             ; the remainder. The low byte of each trial subtraction waits on the
E4F2                             ; hardware stack.
E4F2                             ; Dividing by 2 is one shift (the spec wants that fast).
E4F2   A9 00        UDIV:     LDA   #0   
E4F4   85 04                  STA   T0   
E4F6   85 05                  STA   T1   
E4F8                          IF   1-QK   
                              LDA   D0   
                              EOR   #2   
                              ORA   D1   
                              BNE   ud0   
                              LSR   TH   
                              ROR   TL   ; the quotient
                              ROL   T0   ; the remainder: the bit that fell out
                              RTS      
E4F8                          ENDIF      
E4F8                          IF   QK   
E4F8                             ; (QK: any power of two is shifts: 2, and 32, 64, 256 and the like, which
E4F8                             ; fixed point and byte work use all the time.)
E4F8   A4 08                  LDY   D0   
E4FA   A5 09                  LDA   D1   
E4FC   D0 12                  BNE   uq1   ; 256 and up
E4FE   98                     TYA      
E4FF   F0 38                  BEQ   ud0   ; by 0: the long way (it means nothing anyway)
E501   88                     DEY      
E502   98                     TYA      
E503   25 08                  AND   D0   
E505   D0 32                  BNE   ud0   ; not a power of two
E507   98                     TYA      ; by 2^k below 256: r = a & (2^k - 1),
E508   25 02                  AND   TL   
E50A   85 04                  STA   T0   
E50C   A5 08                  LDA   D0   ;   and q = a >> k
E50E   D0 1E                  BNE   uq2   ; always
E510   98           UQ1:      TYA      
E511   D0 26                  BNE   ud0   ; not a power of two
E513   A4 09                  LDY   D1   
E515   88                     DEY      
E516   98                     TYA      
E517   25 09                  AND   D1   
E519   D0 1E                  BNE   ud0   ; not a power of two
E51B   98                     TYA      ; by 2^k, 256 and up: r = a & (2^k - 1),
E51C   25 03                  AND   TH   
E51E   85 05                  STA   T1   
E520   A5 02                  LDA   TL   
E522   85 04                  STA   T0   
E524   A5 03                  LDA   TH   ;   and q = (a >> 8) >> (k - 8)
E526   85 02                  STA   TL   
E528   A9 00                  LDA   #0   
E52A   85 03                  STA   TH   
E52C   A5 09                  LDA   D1   
E52E   4A           UQ2:      LSR      ; a bit of 2^k: one shift for each 0 below
E52F   B0 07                  BCS   uq9   ;   the 1
E531   46 03        UQ3:      LSR   TH   
E533   66 02                  ROR   TL   
E535   4A                     LSR      
E536   90 F9                  BCC   uq3   
E538   60           UQ9:      RTS      
E539                          ENDIF      
