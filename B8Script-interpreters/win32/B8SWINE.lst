  1823 00000A0A ????????            <1> v_dstop:resd    1               ; ESP for the empty data stack
  1824 00000A0E ??                  <1> v_iscon:resb    1               ; non-zero if the input is a console
  1825 00000A0F ??                  <1> v_pcnt: resb    1               ; the break key's countdown
  1826 00000A10 ????????            <1> v_mode: resd    1               ; the console's input mode at the start
  1827 00000A14 ????????            <1> v_npend:resd    1               ; the heap's first address (checked '_')
  1828 00000A18 ????????            <1> v_skat: resd    1               ; where the skip started (checked N)
  1829 00000A1C ????????            <1> v_edln: resd    1               ; the editor: the line ^E put in the input
  1830                              <1> v_end:
  1831                              <1>         times   -((v_end-next) > 128) db 0      ; (an error if out of reach)
  1832                              <1>         times   -((next-iat) > 128) db 0
