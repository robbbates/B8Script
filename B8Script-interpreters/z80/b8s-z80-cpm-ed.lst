0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Spec: docs/b8script.md (2026-11-23).
0000                             ; 
0000                             ;  Four switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    EDITOR   1 = with the line editor built in (see the end of this file):
0000                             ;                 the spec's suggested standard. It goes with either setting
0000                             ;                 of the other two.
0000                             ;    CHECKED  0 = no checks (spec: the programmer is responsible)
0000                             ;             1 = starts with every variable at 0 and every word undefined,
0000                             ;                 and stops on every error in the spec's table (and Ctrl-C)
0000                             ;                 with a four-line report: the letter and the place as line
0000                             ;                 and column, the text there, and both stacks. See `error`.
0000                             ;    ANSI     1 = the four console codes (`@ `^ `_ `?) send ANSI escape
0000                             ;                 sequences through CONOUT
0000                             ;             0 = they call four routines of the machine's own instead:
0000                             ;                 CONAT, CONCLS, CONEOL and CONCUR (see the equates)
0000                             ; 
0000                             ;  In every build Ctrl-C stops a running program (an unchecked build stops
0000                             ;  without a word): see the console layer for the rules, the held key and
0000                             ;  the break-off cell.
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   1   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   0   ; 1 = checked build
0000                EDITOR:   EQU   1   ; 1 = with the line editor
0000                ANSI:     EQU   1   ; 1 = the console codes send ANSI sequences
0000                EDGEN:    EQU   EDITOR*(1-CPM)   ; (the generic build with the editor)
0000                             ; (IF takes any value but 0 as true, so
0000                             ;  IF CHECKED+EDITOR means "either")
0000                TABP0:    EQU   EDGEN*(1-CHECKED)   ; (the build with its table in page zero)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    HL'  return-stack pointer (the alternate HL). Entries are 2 bytes; the
0000                             ;         stack grows down. Only rpop and rpushn (and the checks) touch it.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  One-byte calls. The routines used most are reached with RST, one byte
0000                             ;  instead of three:
0000                             ; 
0000                             ;    RST 08h  rpop    pop the return stack into DE
0000                             ;    RST 18h  drop    drop TOS, then next character     (ends a handler)
0000                             ;    RST 20h  neg16   HL = -HL
0000                             ;    RST 28h  putc    print A
0000                             ;    RST 30h  next    next character                    (ends a handler)
0000                             ; 
0000                             ;  RST 18h and RST 30h never return: an RST is a CALL, so the first thing
0000                             ;  each of them does is POP DE to throw the return address away.
0000                             ; 
0000                             ;  The CP/M build can't own page zero, so the block from `vecs` to `vecend`
0000                             ;  (image addresses 0108h-0133h) is copied to 0008h-0033h when it starts. The
0000                             ;  code in that block is written to work at either place.
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (the top four bytes of the page are spare,
0000                             ;             so a full stack runs two bytes into the page below)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch, interpreter variables in the gaps, and the -n? line buffer
0000                             ;             at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack has a guard band: the data stack can
0000                             ;  overrun by a cell or two (and the calls made while it is full, the error
0000                             ;  report's included) into the top 32 bytes of the return-stack page, which
0000                             ;  are never used, and the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
0000                BDOS:     EQU   0005h   
0000                BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IF   CPM*(1-EDITOR)   
                    EXIT:     EQU   0000h   ; warm boot
0000                          ENDIF      
0000                          IFN   CPM   
                                 ; ---- generic machine: edit these to suit -----------------------------------
                    KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
                                 ;   waiting. The zero flag must match A
                                 ;   (end the routine with OR A / RET).
                    CONOUT:   EQU   0FF03h   ; print the character in A
                                 ;   KEY and CONOUT must preserve BC, DE, HL and HL'.
                    RSPAGE:   EQU   80h   ; 8000h return stack
                    DSPAGE:   EQU   81h   ; 8100h data stack
                    LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
                    PROG:     EQU   8300h   ; where the loader puts the program text
                    HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
                    BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-ANSI)   
                                 ; ---- generic machine with ANSI = 0: the console codes call these ------------
                    CONAT:    EQU   0FF0Ch   ; `@  cursor to row E, column L, both from 0
                                 ;     (DE and HL hold the whole cells). May
                                 ;     change A, DE and HL
                    CONCLS:   EQU   0FF0Fh   ; `^  clear the screen and home the cursor
                    CONEOL:   EQU   0FF12h   ; `_  clear from the cursor to the end of the line
                    CONCUR:   EQU   0FF15h   ; `?  cursor off if A = 0 (the zero flag is set
                                 ;     to match), on if not. May change A, DE, HL
                                 ;   All four must preserve BC and HL'; CONCLS and CONEOL also DE and HL.
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)   
                    EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                          ENDIF      
0000                          IF   EDGEN   
                    LEAVE:    EQU   0FF09h   ; where the editor's ^X goes
0000                          ENDIF      
0000                          IF   EDITOR*CPM   
0000                LEAVE:    EQU   0000h   ; the editor's ^X: warm boot
0000                          ENDIF      
0000                          IF   EDITOR   
0000                EXIT:     EQU   edend   ; a program that ends goes back to the editor,
0000                SKEND:    EQU   skend   ;   also when it ends inside skip
0000                          ENDIF      
0000                          IF   1-EDITOR   
                    SKEND:    EQU   EXIT   
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine. (The wait
0000                             ; for a second Ctrl-C uses it too: 250 ms.)
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                             ;   around machine code;
0000                NPEND:    EQU   LET+38h   ;   minus the address of the program's end
0000                             ;   (the heap"s first byte), for the checked "_';
0000                EDLN:     EQU   LET+3Ah   ;   the editor: the number of the line that ^E
0000                             ;   put in the input line (0: none)
0000                SEED:     EQU   LET+76h   ; gap after z: the random seed, the cell whose
0000                             ;   address `. gives. Nothing sets it at the
0000                             ;   start but the checked build's clearing;
0000                KEYBUF:   EQU   LET+7Ah   ;   a key read by the break check and
0000                             ;   held for the next "?" (0: none);
0000                BRKOFF:   EQU   LET+7Bh   ;   the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                LBHDR:    EQU   LET+7Eh   ; CP/M BDOS 10 header: max, count
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FCh   ; empty data stack. The four bytes above it
0000                             ; are spare: a character can pop two cells
0000                             ; too many before the checked build sees it,
0000                             ; and the next call must not land on the
0000                             ; letter cells.
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is the start of the .COM file, and 0108h-0133h is also copied to
0000                             ;  page zero (see the header).
0000                             ; =============================================================================
0100                          .ORG   BASE   
0100                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              XOR   A   ; 00  reset. (This byte, AFh, is also what an
0100                          ENDIF      ;     undefined word runs into: see e_hi.)
0100                          IF   1-EDGEN   
0100   31 FC 0A               LD   SP,DSTOP   ; 00  reset, or the start of the .COM file
0103                          ENDIF      
0103                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)   
                              LD   BC,PROG   ; 03  the IP
                              JR   st0   ; 06  (the rest of the startup is close by)
0103                          ENDIF      
0103                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              JR   init   ; 04  (the rest of the startup is close by)
                              DW   0   ; 06  spare
0103                          ENDIF      
0103                          IF   EDGEN   
                              XOR   A   ; 00  reset: no program yet. (This byte, AFh,
                              LD   (PROG),A   ;     is also what an undefined word runs
                              JP   init   ; 04  into in the checked build: see e_hi.)
                              NOP      ; 07  spare
0103                          ENDIF      
0103                          IF   CPM   
0103   C3 2F 08               JP   start   ; 03
0106   00 00                  DW   0   ; 06  spare
0108                          ENDIF      
0108                VECS:        
0108                             ; ---- RST 08h: rpop: pop the return stack into DE ---------------------------
0108   D9           RPOP:     EXX      ; 08
0109   5E                     LD   E,(HL)   
010A   23                     INC   HL   
010B   56                     LD   D,(HL)   
010C   23                     INC   HL   
010D   D5                     PUSH   DE   ; across to the main registers
010E   D9                     EXX      
010F   D1                     POP   DE   
0110   C9                     RET      ; 10  (so RST 10h is not used)
0111                             ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
0111   C6 21        CTL:      ADD   A,21h   ; 11  back to c; zero only for NUL
0113   20 1F                  JR   NZ,next0   ;     the rest are ignored
0115   C3 55 05     ENDPROG:   JP   EXIT   ;     the program has ended
0118                             ; ---- RST 18h: drop TOS, then next ------------------------------------------
0118   D1           RST18:    POP   DE   ; 18  discard the RST's return address
0119   E1                     POP   HL   ;     new TOS = NOS
011A   18 15                  JR   nx   
011C   E5           H_FROMR:   PUSH   HL   ; 1C  "}" return stack to TOS
011D   CF                     RST   08h   
011E   EB                     EX   DE,HL   
011F   F7                     RST   30h   
0120                             ; ---- RST 20h: neg16: HL = -HL (keeps BC, DE) -------------------------------
0120   AF           NEG16:    XOR   A   ; 20
0121   95                     SUB   L   
0122   6F                     LD   L,A   
0123   9F                     SBC   A,A   
0124   94                     SUB   H   
0125   67                     LD   H,A   
0126   C9                     RET      
0127   00                     NOP      ; 27  spare
0128                             ; ---- RST 28h: putc: print A (keeps BC, DE, HL, HL') ------------------------
0128                RST28:       
0128                          IFN   CPM   
                    PUTC:     JP   CONOUT   ; 28
0128                          ENDIF      
0128                          IF   CPM   
0128   C3 93 04               JP   putc   ; 28
012B                          ENDIF      
012B   E9           JPHL:     JP   (HL)   ; 2B  (for the machine-code call)
012C   E3           H_TOR:    EX   (SP),HL   ; 2C  "{" TOS to the return stack: the new TOS
012D   C3 B2 01               JP   rpushn   ;     comes up, the old one goes across
0130                             ; ---- RST 30h: next character -----------------------------------------------
0130   D1           RST30:    POP   DE   ; 30  discard the RST's return address
0131                NX:          
0131                          IF   CPM   
0131   C3 34 01               JP   next0   ; (this copy runs in page zero)
0134                          ENDIF      
0134                VECEND:      
0134                             ; =============================================================================
0134                             ;  The inner loop: read one character and sort it by range.
0134                             ; 
0134                             ;    00h          end of program
0134                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0134                             ;    30h-39h      digit: read a whole number
0134                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0134                             ;    61h-7Ah      a-z: push the address of that letter's cell
0134                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0134                             ; =============================================================================
0134                NEXT0:       
0134                          IF   CHECKED   
                              CALL   chkstk   ; both stacks are checked once per character
0134                          ENDIF      
0134   0A                     LD   A,(BC)   
0135   03                     INC   BC   
0136   D6 21                  SUB   21h   ; A = c - 21h
0138   38 D7                  JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
013A   FE 0F                  CP   0Fh   
013C   38 22                  JR   C,punct   ; 21h-2Fh: PTAB index 0-14
013E   D6 0F                  SUB   0Fh   ; A = c - 30h
0140   FE 0A                  CP   0Ah   
0142   38 58                  JR   C,digit   ; 30h-39h
0144   FE 11                  CP   11h   
0146   38 16                  JR   C,p3a   ; 3Ah-40h
0148   D6 11                  SUB   11h   ; A = c - 41h
014A   FE 1A                  CP   1Ah   
014C   38 5A                  JR   C,upper   ; 41h-5Ah: A = letter index 0-25
014E   FE 20                  CP   20h   
0150   38 0A                  JR   C,p5b   ; 5Bh-60h
0152   FE 3A                  CP   3Ah   
0154   38 4C                  JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0156   FE 3E                  CP   3Eh   
0158                          IF   1-CHECKED   
0158   30 DA                  JR   NC,next0   ; 7Fh-FFh: ignored
015A                          ENDIF      
015A                          IF   CHECKED   
                              JR   Z,next0   ; 7Fh, DEL: ignored
                              JP   NC,e_hi   ; 80h-FFh: reserved
015A                          ENDIF      
015A   D6 1A                  SUB   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
015C   D6 09        P5B:      SUB   9   ; 5Bh-60h: -4 in all, index 22-27
015E   C6 05        P3A:      ADD   A,5   ; 3Ah-40h: index 15-21
0160                .macro PTABLE,
0160                             ; 
0160                 DB      h_store & 0FFh  ; !
0160                 DB      h_str & 0FFh    ; "
0160                 DB      h_num & 0FFh    ; #
0160                 DB      h_print & 0FFh  ; $
0160                 DB      h_swap & 0FFh   ; %
0160                 DB      h_and & 0FFh    ; &
0160                 DB      h_emit & 0FFh   ; '
0160                 DB      h_open & 0FFh   ; (
0160                 DB      h_close & 0FFh  ; )
0160                 DB      h_mul & 0FFh    ; *
0160                 DB      h_add & 0FFh    ; +
0160                 DB      h_cfetch & 0FFh ; ,
0160                 DB      h_sub & 0FFh    ; -
0160                 DB      h_cstore & 0FFh ; .
0160                 DB      h_div & 0FFh    ; /
0160                 DB      h_dup & 0FFh    ; :
0160                 DB      h_drop & 0FFh   ; ;
0160                 DB      h_lt & 0FFh     ; <
0160                 DB      h_eq & 0FFh     ; =
0160                 DB      h_gt & 0FFh     ; >
0160                 DB      h_key & 0FFh    ; ?
0160                 DB      h_fetch & 0FFh  ; @
0160                 DB      h_def & 0FFh    ; [
0160                 DB      h_break & 0FFh  ; \
0160                 DB      h_ret & 0FFh    ; ]
0160                 DB      h_xor & 0FFh    ; ^
0160                 DB      h_alloc & 0FFh  ; _
0160                 DB      h_grave & 0FFh  ; `
0160                 DB      h_tor & 0FFh    ; {
0160                 DB      h_or & 0FFh     ; |
0160                 DB      h_fromr & 0FFh  ; }
0160                 DB      h_not & 0FFh    ; ~
0160                .endm
0160                 
0160                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
0160                             ; untouched, and A, DE free.
0160   C6 21        PUNCT:    ADD   A,PTAB & 0FFh   ; PTAB never crosses a page
0162   5F                     LD   E,A   
0163   16 04                  LD   D,PTAB / 256   ; (0 if the table is in page zero)
0165   FE 36                  CP   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
0167   1A                     LD   A,(DE)   
0168   5F                     LD   E,A   ; the handler's low byte
0169                          IF   (1-CPM)*(1-TABP0)   
                              LD   D,0   
0169                          ENDIF      
0169                          IFN   CPM   
                              RL   D   ; its page: 0 + carry
0169                          ENDIF      
0169                          IF   CPM   
0169   16 01                  LD   D,1   
016B   30 01                  JR   NC,pu1   
016D   14                     INC   D   ; its page: 1 + carry
016E                PU1:         
016E                          ENDIF      
016E   D5                     PUSH   DE   ; jump to it; the stack is balanced again
016F   C9                     RET      ;   when the handler starts
0170                             ; The rest of the startup: here so that the generic reset code can reach it
0170                             ; with JR. st0: find the program's NUL; the heap starts after it.
0170                             ; (The editor build has its own copy of this, next to the editor.)
0170                             ; A checked build first clears the lower half of the letter page (A = 0):
0170                             ; every variable starts at 0, every word cell holds 0000h, the address an
0170                             ; undefined word is caught at (see e_hi), and no key is held back.
0170                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                    INIT:     LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
                              LD   BC,PROG   ; the IP
0170                          ENDIF      
0170                          IF   (1-CPM)*(1-EDITOR)   
                    ST0:      LD   H,B   
                              LD   L,C   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
0170                          ENDIF      
0170                          IF   1-EDITOR   
                    ST2:      LD   (HEAP),HL   
0170                          ENDIF      
0170                          IF   CHECKED*(1-EDITOR)   
                              RST   20h   ; minus the heap"s first address: "_' may not
                              LD   (NPEND),HL   ;   release below it
0170                          ENDIF      
0170                          IF   (1-CHECKED)*(1-EDITOR)*(1-CPM)   
                              LD   H,A   ; (A = 0) no key is held, and the break key
                              LD   L,A   ;   is on (the checked build has cleared
0170                          ENDIF      ;   these)
0170                          IF   (1-CHECKED)*(1-EDITOR)*CPM   
                              LD   HL,0   
0170                          ENDIF      
0170                          IF   (1-CHECKED)*(1-EDITOR)   
                              LD   (KEYBUF),HL   
0170                          ENDIF      
0170                          IF   1-EDITOR   
                              EXX      
                              LD   HL,RSTOP   ; the return stack is empty
                              EXX      
                              RST   30h   ; (its return address is thrown away)
0170                          ENDIF      
0170                             ; In the unchecked generic editor build the table is here, in the first
0170                             ; page, which saves loading D twice. (The other builds have no room for it
0170                             ; here: theirs is further down.)
0170                          IF   TABP0   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0170                          ENDIF      
0170                             ; =============================================================================
0170                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
0170                             ;  (00bbIGFuZCA= are up among the RST routines.) The machine-code call, exec,
0170                             ;  is here too: it belongs to "`" and makes the page come out right.
0170                             ; =============================================================================
0170   D1           H_XOR:    POP   DE   
0171   7C                     LD   A,H   
0172   AA                     XOR   D   
0173   67                     LD   H,A   
0174   7D                     LD   A,L   
0175   AB                     XOR   E   
0176   6F                     LD   L,A   
0177   F7                     RST   30h   
0178   D1           H_OR:     POP   DE   
0179   7C                     LD   A,H   
017A   B2                     OR   D   
017B   67                     LD   H,A   
017C   7D                     LD   A,L   
017D   B3                     OR   E   
017E   6F                     LD   L,A   
017F   F7                     RST   30h   
0180   E7           H_NOT:    RST   20h   ; ~x = -x - 1
0181   2B                     DEC   HL   
0182   F7                     RST   30h   
0183                             ; "_" ( n -- addr ): the heap pointer moves by n, a signed count (the add is
0183                             ; the same either way); TOS is the old pointer.
0183   ED 5B 7C 0B  H_ALLOC:   LD   DE,(HEAP)   
0187                          IF   CHECKED*CPM   
                              LD   A,H   ; the count's sign, for chkhp
0187                          ENDIF      
0187   19                     ADD   HL,DE   ; the new top
0188                          IF   CHECKED   
                              CALL   chkhp   
0188                          ENDIF      
0188   22 7C 0B               LD   (HEAP),HL   
018B   EB                     EX   DE,HL   
018C   F7                     RST   30h   
018D   D9           EXEC:     EXX      
018E   22 34 0B               LD   (RSAVE),HL   ; machine code may change the alternates
0191   D9                     EXX      
0192   CD 2B 01               CALL   jphl   
0195   D9                     EXX      
0196   2A 34 0B               LD   HL,(RSAVE)   
0199   D9                     EXX      
019A   E1                     POP   HL   
019B   F7                     RST   30h   
019C                             ; ---- the letters and digits (here, in the middle, so that the inner loop's
019C                             ; ---- short jumps reach them, and the handlers after them reach rpushn) ------
019C                             ; Digits: step back onto the first digit and read the whole number.
019C   E5           DIGIT:    PUSH   HL   
019D   0B                     DEC   BC   
019E   CD 08 03               CALL   rdnum   
01A1   F7                     RST   30h   
01A2                             ; a-z: push the cell's address (the cell is the variable)
01A2   E5           LOWER:    PUSH   HL   
01A3   87                     ADD   A,A   
01A4   6F                     LD   L,A   
01A5   26 0B                  LD   H,LETPAGE   
01A7   F7                     RST   30h   
01A8                             ; A-Z: call the word. The return address (the IP after the letter) goes on
01A8                             ; the return stack, and the IP becomes the address in the letter's cell.
01A8   C5           UPPER:    PUSH   BC   ; the return address, for rpushn
01A9   EB                     EX   DE,HL   ; park TOS
01AA   87                     ADD   A,A   
01AB   6F                     LD   L,A   
01AC   26 0B                  LD   H,LETPAGE   ; HL -> cell
01AE   4E                     LD   C,(HL)   
01AF   2C                     INC   L   
01B0   46                     LD   B,(HL)   ; IP = the word's body
01B1   EB                     EX   DE,HL   ; TOS back, and fall into rpushn
01B2                             ; rpushn: move the top cell of the data stack (in memory) to the return
01B2                             ; stack, then next. Everything that pushes the return stack ends here.
01B2                             ; 
01B2                             ; The break key is looked at here, so at every word call and loop-back (and
01B2                             ; block entry and "{"), but only one time in 256: B', which nothing else
01B2                             ; uses, counts them. Reading the keyboard can be slow (it is a BDOS call
01B2                             ; under CP/M), and this way it costs a loop four bytes and 14 T-states.
01B2                             ; (DEC B, not DJNZ: its zero flag lasts through the EXX, so one EXX serves
01B2                             ; both ways out.)
01B2   D9           RPUSHN:   EXX      
01B3   D1                     POP   DE   
01B4   2B                     DEC   HL   
01B5   72                     LD   (HL),D   
01B6   2B                     DEC   HL   
01B7   73                     LD   (HL),E   
01B8   05                     DEC   B   
01B9   D9                     EXX      
01BA   CC 53 04               CALL   Z,pollk   
01BD   F7                     RST   30h   
01BE                             ; ---- the grave -------------------------------------------------------------
01BE                             ; The grave is a prefix: with the character after it, it is one command.
01BE                             ; The characters are tested one after another, each SUB taking off the step
01BE                             ; from the one before, so A is 0 (and the carry clear) when a handler is
01BE                             ; reached. Two are here, where they keep the first page as full as the
01BE                             ; layout needs; grave2 has the rest.
01BE                             ; 
01BE                             ;   `!  ( addr -- )  calls the machine code at TOS. The code is entered by
01BE                             ;       CALL with the data stack above the return address; it must keep BC,
01BE                             ;       and on return the top cell becomes the new TOS.
01BE                             ;   `'  ( -- )  new line: CR LF
01BE   0A           H_GRAVE:   LD   A,(BC)   
01BF   03                     INC   BC   
01C0   D6 21                  SUB   "!"   
01C2   28 C9                  JR   Z,exec   
01C4   D6 06                  SUB   27h-"!"   ; "'"
01C6   C2 9A 03               JP   NZ,grave2   
01C9   3E 0D                  LD   A,13   
01CB   EF                     RST   28h   
01CC   3E 0A                  LD   A,10   
01CE   EF                     RST   28h   
01CF   F7                     RST   30h   
01D0                             ; ---- where the two pages meet ----------------------------------------------
01D0                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
01D0                             ; are in falling code order for this), and where exactly differs between the
01D0                             ; builds: NPG1 follows. Every handler below these four must start in the
01D0                             ; second page, and every one above in the first; chktab.py checks both.
01D0                             ; "]" returns: pop an address and jump to it.
01D0   CF           H_RET:    RST   08h   
01D1   42                     LD   B,D   
01D2   4B                     LD   C,E   
01D3   F7           BRK1:     RST   30h   
01D4                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
01D4                             ; drops the block start, "]" returns. No closer at all ends the program.
01D4   7C           H_BREAK:   LD   A,H   
01D5   B5                     OR   L   
01D6   E1                     POP   HL   
01D7   28 FA                  JR   Z,brk1   
01D9   CD 2A 03               CALL   skip   
01DC   B7                     OR   A   ; skip returns 0 for ")"
01DD   20 F1                  JR   NZ,h_ret   
01DF   CF           RDROP:    RST   08h   
01E0   F7                     RST   30h   
01E1                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
01E1                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
01E1                             ; the body"s address instead. Either way it then skips to the matching "]'.
01E1                             ; (The unchecked build takes anything that is not a letter as the space; the
01E1                             ; checked build stops on it.)
01E1   0A           H_DEF:    LD   A,(BC)   
01E2   03                     INC   BC   
01E3   D6 41                  SUB   "A"   ; a letter gives 0-25 or 32-57: lowercase
01E5   5F                     LD   E,A   ;   lands 64 bytes up
01E6   E6 DF                  AND   0DFh   ; fold case
01E8   FE 1A                  CP   26   
01EA   30 0B                  JR   NC,def2   ; not a letter
01EC   CB 23                  SLA   E   
01EE   16 0B                  LD   D,LETPAGE   ; DE -> cell
01F0   79                     LD   A,C   
01F1   12                     LD   (DE),A   
01F2   1C                     INC   E   
01F3   78                     LD   A,B   
01F4   12                     LD   (DE),A   
01F5   18 03                  JR   skipnx   
01F7                DEF2:        
01F7                          IF   CHECKED   
                              LD   A,E   
                              CP   " "-"A"+256   
                              JP   NZ,e_brack   ; anything but a letter or a space
01F7                          ENDIF      
01F7   E5                     PUSH   HL   ; an anonymous block: push its address
01F8   60                     LD   H,B   
01F9   69                     LD   L,C   
01FA                SKIPNX:      
01FA                          IF   CHECKED   
                              DEC   BC   ; back onto the letter, so that skip finds its
01FA                          ENDIF      ;   opener, the "[", just before where it starts
01FA   CD 2A 03     SKIPO:    CALL   skip   
01FD   F7                     RST   30h   
01FE   5E           H_FETCH:   LD   E,(HL)   ; "@"
01FF   23                     INC   HL   
0200   56                     LD   D,(HL)   
0201   EB                     EX   DE,HL   
0202   F7                     RST   30h   
0203                             ; =============================================================================
0203                             ;  Handlers that must start in the image's second page.
0203                             ;  "?" is the last (with "," inside it), so its long tail may run past that
0203                             ;  page.
0203                             ; =============================================================================
0203                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
0203                             ; the matching ")".
0203   7C           H_OPEN:   LD   A,H   
0204   B5                     OR   L   
0205   E1                     POP   HL   
0206   28 F2                  JR   Z,skipo   
0208   C5                     PUSH   BC   ; the block starts at the IP
0209   18 A7                  JR   rpushn   
020B                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
020B                             ; drops it and carries on.
020B   7C           H_CLOSE:   LD   A,H   
020C   B5                     OR   L   
020D   E1                     POP   HL   
020E   28 CF                  JR   Z,rdrop   
0210   CF                     RST   08h   ; pop the block start ...
0211   42                     LD   B,D   
0212   4B                     LD   C,E   
0213   C5                     PUSH   BC   
0214   18 9C                  JR   rpushn   ; ... and push it back
0216                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
0216                             ; "-" has two jobs: directly before a digit it starts a negative number.
0216   0A           H_SUB:    LD   A,(BC)   
0217   D6 30                  SUB   "0"   
0219   FE 0A                  CP   10   
021B   38 04                  JR   C,negnum   
021D   E7                     RST   20h   ; a - b = a + (-b): fall into "+"
021E   D1           H_ADD:    POP   DE   
021F   19                     ADD   HL,DE   
0220   F7                     RST   30h   
0221   E5           NEGNUM:   PUSH   HL   ; a negative number: read it, negate it
0222   CD 08 03               CALL   rdnum   
0225   E7                     RST   20h   
0226   F7                     RST   30h   
0227   D1           H_AND:    POP   DE   
0228   7C                     LD   A,H   
0229   A2                     AND   D   
022A   67                     LD   H,A   
022B   7D                     LD   A,L   
022C   A3                     AND   E   
022D   6F                     LD   L,A   
022E   F7                     RST   30h   
022F                             ; Signed compares. Both are "HL < DE" for the right pair: "<" swaps the two
022F                             ; cells first. Flipping both sign bits turns a signed compare into an
022F                             ; unsigned one (and XOR clears the carry for SBC); SBC HL,HL then turns the
022F                             ; carry into -1 or 0 with no branch.
022F   E3           H_LT:     EX   (SP),HL   ; a < b: HL = a, and b is popped next
0230   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
0231   7C                     LD   A,H   
0232   EE 80                  XOR   80h   
0234   67                     LD   H,A   
0235   7A                     LD   A,D   
0236   EE 80                  XOR   80h   
0238   57                     LD   D,A   
0239   ED 52                  SBC   HL,DE   ; carry if HL < DE
023B   ED 62        TF:       SBC   HL,HL   ; carry -> -1 or 0
023D   F7                     RST   30h   
023E   D1           H_EQ:     POP   DE   
023F   B7                     OR   A   
0240   ED 52                  SBC   HL,DE   
0242   7C                     LD   A,H   
0243   B5                     OR   L   
0244   FE 01                  CP   1   ; carry only if a - b = 0
0246   18 F3                  JR   tf   
0248                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept. The
0248                             ; multiplier shifts up through A:C.
0248   D1           H_MUL:    POP   DE   ; DE = multiplicand
0249   C5                     PUSH   BC   
024A   7C                     LD   A,H   
024B   4D                     LD   C,L   ; A:C = multiplier
024C   21 00 00               LD   HL,0   
024F   06 10                  LD   B,16   
0251   29           MUL1:     ADD   HL,HL   
0252   CB 21                  SLA   C   
0254   17                     RLA      
0255   30 01                  JR   NC,mul2   
0257   19                     ADD   HL,DE   
0258   10 F7        MUL2:     DJNZ   mul1   
025A   C1                     POP   BC   
025B   F7                     RST   30h   
025C                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
025C                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
025C                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
025C                             ; stops on it.
025C                H_DIV:       
025C                          IF   CHECKED   
                              LD   A,H   
                              OR   L   
                              JP   Z,e_zero   
025C                          ENDIF      
025C   D1                     POP   DE   ; DE = a, HL = b
025D   C5                     PUSH   BC   ; free BC for udiv
025E   D5                     PUSH   DE   ; a, for r's sign
025F   7A                     LD   A,D   
0260   AC                     XOR   H   
0261   F5                     PUSH   AF   ; S flag = sign of q
0262   CB 7C                  BIT   7,H   
0264   C4 20 01               CALL   NZ,neg16   ; HL = |b|
0267   EB                     EX   DE,HL   
0268   CB 7C                  BIT   7,H   
026A   C4 20 01               CALL   NZ,neg16   ; HL = |a|, DE = |b|
026D   CD E2 02               CALL   udiv   ; HL = q, DE = r
0270   F1                     POP   AF   
0271   FC 20 01               CALL   M,neg16   ; q's sign
0274   EB                     EX   DE,HL   ; HL = r, DE = q
0275   F1                     POP   AF   ; A = a's high byte
0276   B7                     OR   A   
0277   FC 20 01               CALL   M,neg16   ; r's sign
027A   C1                     POP   BC   
027B   D5                     PUSH   DE   ; q under r
027C   F7                     RST   30h   
027D                             ; ---- stack and storage -----------------------------------------------------
027D   E5           H_DUP:    PUSH   HL   ; ":"
027E   F7                     RST   30h   
027F   E3           H_SWAP:   EX   (SP),HL   ; "%"
0280   F7                     RST   30h   
0281                             ; (The checked build tests the address before it takes the value off the
0281                             ; stack, so that an error report shows both.)
0281                H_CSTORE:      ; "." ( c addr -- )
0281                          IF   CHECKED   
                              CALL   chkst   
0281                          ENDIF      
0281   D1                     POP   DE   
0282   73                     LD   (HL),E   
0283   DF           H_DROP:   RST   18h   ; ";" is this one byte
0284                H_STORE:      ; "!" ( n addr -- )
0284                          IF   CHECKED   
                              CALL   chkst   
0284                          ENDIF      
0284   D1                     POP   DE   
0285   73                     LD   (HL),E   
0286   23                     INC   HL   
0287   72                     LD   (HL),D   
0288   DF                     RST   18h   
0289                             ; ---- console ---------------------------------------------------------------
0289                             ; 22h pushes the address of the text after it and skips the string.
0289   E5           H_STR:    PUSH   HL   
028A   60                     LD   H,B   
028B   69                     LD   L,C   
028C   CD 1F 03               CALL   skipstr   
028F                          IF   CHECKED   
                              OR   A   ; 0: the text ran out before the closing quote
                              JP   Z,e_quote   
028F                          ENDIF      
028F   F7                     RST   30h   
0290                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character
0290                             ; clears that character"s bit 6 (/M is CR, /` is space; "/" and ""' have no
0290                             ; bit 6, so // and /" give themselves).
0290                          IF   (1-CHECKED)*(1-EDITOR)   
                    H_PRINT:   LD   A,(HL)   
                              INC   HL   
                              CP   22h   
                              JR   Z,pr9   
                              CP   "/"   
                              JR   NZ,pr1   
                              LD   A,(HL)   
                              INC   HL   
                              AND   0BFh   
                    PR1:      RST   28h   
                              JR   h_print   
0290                          ENDIF      
0290                          IF   CHECKED   
                                 ; (The checked build has the loop as a routine, prstr, which the error
                                 ; report uses too. The address is kept on the stack meanwhile: a report
                                 ; shows the stack as it was before the "$".)
                    H_PRINT:   PUSH   HL   
                              CALL   prstr   
                              POP   DE   
                              RST   18h   
0290                          ENDIF      
0290                          IF   (1-CHECKED)*EDITOR   
0290                             ; (With the editor the loop is a routine, prstr, which ^V uses too.)
0290   CD FE 04     H_PRINT:   CALL   prstr   
0293   DF                     RST   18h   
0294                          ENDIF      
0294   7D           H_EMIT:   LD   A,L   ; "'"
0295   EF                     RST   28h   
0296   DF           PR9:      RST   18h   
0297                             ; "#" prints TOS as a signed decimal number, with no space after it.
0297   C5           H_NUM:    PUSH   BC   
0298   CD 4B 03               CALL   psgn   
029B   C1                     POP   BC   
029C   DF                     RST   18h   
029D                             ; "?" ( n -- c ) or ( -n -- addr )
029D                             ;   n > 0: wait about n ms for a key; 0 if none came
029D                             ;   n = 0: wait for a key
029D                             ;          (both stir the random seed while they wait: see kt2)
029D                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
029D                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
029D   CB 7C        H_KEY:    BIT   7,H   
029F   20 22                  JR   NZ,line   
02A1   1E 28        KT1:      LD   E,MSLOOP   ; one millisecond, roughly
02A3   CD 81 04     KT2:      CALL   getk   
02A6   20 17                  JR   NZ,kt3   
02A8   1D                     DEC   E   
02A9   20 F8                  JR   NZ,kt2   
02AB   EB                     EX   DE,HL   ; a millisecond with no key stirs the random
02AC   2A 76 0B               LD   HL,(SEED)   ;   seed by one: how long a key takes to come
02AF   23                     INC   HL   ;   is the one thing here that is not the
02B0   22 76 0B               LD   (SEED),HL   ;   same every time
02B3   EB                     EX   DE,HL   
02B4   7C                     LD   A,H   ; 0? never counts down: it waits
02B5   B5                     OR   L   
02B6   28 E9                  JR   Z,kt1   
02B8   2B                     DEC   HL   
02B9   7C                     LD   A,H   
02BA   B5                     OR   L   
02BB   20 E4                  JR   NZ,kt1   ; A = 0 if the time ran out
02BD   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
02BE   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
02BF   6F           KT3:      LD   L,A   
02C0   26 00                  LD   H,0   
02C2   F7                     RST   30h   
02C3                          IF   CPM   
02C3                             ; CP/M: BDOS 10 does the editing (the spec allows the platform's
02C3                             ; own line editor). It doesn't store the CR, so it is added here.
02C3   11 7F 00     LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
02C6   19                     ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
02C7   9F                     SBC   A,A   
02C8   A5                     AND   L   ; (0 for a count that is too big)
02C9   EE 7F                  XOR   127   ; A = the count, 127 at most
02CB   32 7E 0B               LD   (LBHDR),A   
02CE   11 7E 0B               LD   DE,LBHDR   
02D1   3E 0A                  LD   A,10   
02D3   CD 9F 04               CALL   bdosx   
02D6   21 7F 0B               LD   HL,LBHDR+1   
02D9   7E                     LD   A,(HL)   ; the count typed (0-127)
02DA   2C                     INC   L   ; HL = LINEBUF, whose low byte is 80h:
02DB   85                     ADD   A,L   ;   adding the count to L can't carry
02DC   6F                     LD   L,A   
02DD   36 0D                  LD   (HL),13   
02DF                          ENDIF      
02DF                          IFN   CPM   
                                 ; Generic: Backspace takes the last character back (and is echoed as
                                 ; it is), CR ends (stored, not echoed), every other key is stored and
                                 ; echoed until the line is full. The line buffer starts at offset 80h
                                 ; of its page, so L alone is the place in the line: D holds the L of
                                 ; a full line.
                    LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
                              ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
                              SBC   A,A   
                              AND   L   ; (0 for a count that is too big)
                              CPL      
                              LD   D,A   ; D = the L of a full line: 80h + count, FFh
                                 ;   at most
                              LD   HL,LINEBUF   
                    LN2:      CALL   getk   
                              JR   Z,ln2   
                              CP   13   
                              JR   Z,ln5   
                              CP   8   
                              JR   Z,ln4   
                              LD   E,A   
                              LD   A,L   
                              CP   D   
                              JR   Z,ln2   ; full
                              LD   (HL),E   
                              INC   L   
                              LD   A,E   
                    LN3:      RST   28h   
                              JR   ln2   
                    LN4:      DEC   L   ; Backspace: one back, and echo it,
                              JP   M,ln3   ;   unless the line was empty (L left the
                              INC   L   ;   upper half of the page)
                              JR   ln2   
                    LN5:      LD   (HL),A   ; the CR
02DF                          ENDIF      
02DF   2E 80                  LD   L,LINEBUF & 0FFh   
02E1   F7                     RST   30h   
02E2                             ; =============================================================================
02E2                             ;  More routines (no handler starts past this point)
02E2                             ; =============================================================================
02E2                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
02E2                             ; Uses A, BC; the caller saves the IP. The dividend shifts up through A:C
02E2                             ; while the quotient bits arrive at the bottom of C.
02E2                             ; Dividing by 2 is one shift (the spec wants that fast).
02E2   7B           UDIV:     LD   A,E   
02E3   EE 02                  XOR   2   
02E5   B2                     OR   D   
02E6   20 07                  JR   NZ,udv0   
02E8   CB 3C                  SRL   H   
02EA   CB 1D                  RR   L   ; the quotient
02EC   8F                     ADC   A,A   
02ED   5F                     LD   E,A   ; the remainder: the bit that fell out (D is 0)
02EE   C9                     RET      
02EF   7C           UDV0:     LD   A,H   
02F0   4D                     LD   C,L   
02F1   21 00 00               LD   HL,0   
02F4   06 10                  LD   B,16   
02F6   CB 21        UDV1:     SLA   C   
02F8   17                     RLA      
02F9   ED 6A                  ADC   HL,HL   
02FB   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
02FD   30 02                  JR   NC,udv2   ;   always fits in 16 bits
02FF   19                     ADD   HL,DE   ; too much: put it back, and cancel the
0300   0D                     DEC   C   ;   INC below
0301   0C           UDV2:     INC   C   ; a quotient bit
0302   10 F2                  DJNZ   udv1   
0304   EB                     EX   DE,HL   ; DE = remainder
0305   67                     LD   H,A   
0306   69                     LD   L,C   ; HL = quotient
0307   C9                     RET      
0308                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
0308                             ; non-digit. Values wrap at 16 bits, as the spec says.
0308   21 00 00     RDNUM:    LD   HL,0   
030B   0A           RDN1:     LD   A,(BC)   
030C   D6 30                  SUB   "0"   
030E   FE 0A                  CP   10   
0310   D0                     RET   NC   
0311   03                     INC   BC   
0312   54                     LD   D,H   
0313   5D                     LD   E,L   
0314   29                     ADD   HL,HL   
0315   29                     ADD   HL,HL   
0316   19                     ADD   HL,DE   
0317   29                     ADD   HL,HL   ; HL * 10
0318   5F                     LD   E,A   
0319   16 00                  LD   D,0   
031B   19                     ADD   HL,DE   
031C   18 ED                  JR   rdn1   
031E                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
031E                             ; the next character, so "/"" does not end it. Leaves A = 22h.
031E                          IF   1-CHECKED   
031E   03           SS0:      INC   BC   
031F   0A           SKIPSTR:   LD   A,(BC)   
0320   03                     INC   BC   
0321   FE 2F                  CP   "/"   
0323   28 F9                  JR   Z,ss0   
0325   FE 22                  CP   22h   
0327   20 F6                  JR   NZ,skipstr   
0329   C9                     RET      
032A                          ENDIF      
032A                          IF   CHECKED   
                                 ; The checked build never steps over a NUL: if the text runs out first it
                                 ; returns A = 0 with the IP on the NUL.
                    SKIPSTR:   LD   A,(BC)   
                              OR   A   
                              RET   Z   
                              INC   BC   
                              CP   22h   
                              RET   Z   
                              CP   "/"   
                              JR   NZ,skipstr   
                              LD   A,(BC)   ; the escaped character
                              OR   A   
                              RET   Z   
                              INC   BC   
                              JR   skipstr   
032A                          ENDIF      
032A                             ; skip: read past text to the closer at this level, and return A = 0 if it
032A                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
032A                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
032A                             ; no closer; anything else that runs into the NUL had unbalanced brackets
032A                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
032A                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
032A                             ; 
032A                             ; The checked build also looks at the character the skip was started by,
032A                             ; which is always the one just before where it starts: "(" must end at ")",
032A                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
032A                             ; quote counts as running into it. "\" takes either closer. IX keeps the
032A                             ; place where the skip started, for the report.
032A                SKIP:        
032A                          IF   CHECKED   
                              PUSH   BC   
                              POP   IX   
                              DEC   BC   
                              LD   A,(BC)   
                              INC   BC   
                              LD   E,A   ; E = the opener: ( [ or \
032A                          ENDIF      
032A   16 00                  LD   D,0   
032C   14           SK3:      INC   D   ; an opener: one deeper
032D   0A           SK1:      LD   A,(BC)   
032E                          IF   1-CHECKED   
032E   03                     INC   BC   
032F   B7                     OR   A   
0330   CA 54 05               JP   Z,SKEND   ; (the end of the program)
0333                          ENDIF      
0333                          IF   CHECKED   
                              OR   A   
                              JR   Z,sk6   ; (the IP stays on the NUL)
                              INC   BC   
0333                          ENDIF      
0333   FE 22                  CP   22h   
0335   CC 1F 03               CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
0338   D6 28                  SUB   "("   ;   (or 0, and then the NUL is read next)
033A   28 F0                  JR   Z,sk3   
033C   3D                     DEC   A   ; ")"
033D   28 08                  JR   Z,sk4   
033F   D6 32                  SUB   "["-")"   
0341   28 E9                  JR   Z,sk3   
0343   FE 02                  CP   "]"-"["   
0345   20 E6                  JR   NZ,sk1   
0347   15           SK4:      DEC   D   
0348                          IF   1-CHECKED   
0348   C8                     RET   Z   ; the closer at this level
0349   18 E2                  JR   sk1   
034B                          ENDIF      
034B                          IF   CHECKED   
                              JR   NZ,sk1   
                              LD   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
                              XOR   E   ;   opener is 0 for "(" and 1 for "[", and only
                              AND   6   ;   "\" has bit 2: so this is 2 for the wrong
                              CP   2   ;   closer, and only then
                              LD   A,D   
                              RET   NZ   
                              JR   sk7   
                    SK6:      BIT   2,E   ; the text ran out:
                              JP   NZ,SKEND   ;   "\" with no closer ends the program
                    SK7:      PUSH   IX   ; N. The place is the opener
                              POP   BC   
                              LD   A,"N"   
                              JP   errp   ; (errp drops skip's return address)
034B                          ENDIF      
034B                             ; psgn: print HL as a signed number. Uses BC.
034B   CB 7C        PSGN:     BIT   7,H   
034D   28 04                  JR   Z,pdec   
034F   3E 2D                  LD   A,"-"   
0351   EF                     RST   28h   
0352   E7                     RST   20h   
0353                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
0353                             ; Uses BC.
0353   11 0A 00     PDEC:     LD   DE,10   
0356   CD E2 02               CALL   udiv   ; HL = HL / 10, E = the last digit
0359   7B                     LD   A,E   
035A   F5                     PUSH   AF   
035B   7C                     LD   A,H   
035C   B5                     OR   L   
035D   C4 53 03               CALL   NZ,pdec   
0360   F1                     POP   AF   
0361   C6 30                  ADD   A,"0"   
0363   EF                     RST   28h   
0364   C9                     RET      
0365                             ; =============================================================================
0365                             ;  The grave's other codes. h_grave comes here with A = the character minus
0365                             ;  27h, not zero; the tests carry on from there.
0365                             ; 
0365                             ;    `$  ( addr -- addr' )  the hex loader: pairs of hex digits are stored
0365                             ;        from addr until a non-hex character; then a RET (C9h) is written
0365                             ;        and its address is left. An odd last digit is consumed and dropped.
0365                             ;    `+  ( addr -- n )   add 1 to the cell at addr and leave its new value
0365                             ;    `,  ( n -- r )      a random number from 0 to n-1 (n is 1 to 32767)
0365                             ;    `-  ( addr -- n )   subtract 1 from the cell at addr, the same way
0365                             ;    `.  ( -- addr )     the address of the random seed
0365                             ;    `<  ( a b -- n )    the smaller of the two (signed)
0365                             ;    `>  ( a b -- n )    the larger
0365                             ;    `?  ( flag -- )     the cursor off (0) or on
0365                             ;    `@  ( row col -- )  the cursor to that row and column, both from 0
0365                             ;    `^  ( -- )          clear the screen and home the cursor
0365                             ;    `_  ( -- )          clear from the cursor to the end of the line
0365                             ; 
0365                             ;  Any other character is unsafe: the unchecked build takes it as "_", the
0365                             ;  checked build stops with W.
0365                             ; =============================================================================
0365                             ; (The console codes are here, before the tests, to be in reach of them.)
0365                          IF   ANSI   
0365                             ; `? ( flag -- ): ESC [ ? 2 5 l hides the cursor, ESC [ ? 2 5 h shows it.
0365   CD 93 03     G_CUR:    CALL   csi   
0368   3E 3F                  LD   A,"?"   
036A   EF                     RST   28h   
036B   3E 32                  LD   A,"2"   
036D   EF                     RST   28h   
036E   3E 35                  LD   A,"5"   
0370   EF                     RST   28h   
0371   7C                     LD   A,H   
0372   B5                     OR   L   
0373   3E 6C                  LD   A,"l"   
0375   28 02                  JR   Z,gc1   
0377   3E 68                  LD   A,"h"   
0379   EF           GC1:      RST   28h   
037A   DF                     RST   18h   
037B                             ; `@ ( row col -- ): ESC [ row+1 ; col+1 H. (ANSI counts from 1.)
037B   D1           G_AT:     POP   DE   ; DE = the row
037C   C5                     PUSH   BC   ; (pdec uses BC)
037D   E5                     PUSH   HL   ; the column
037E   EB                     EX   DE,HL   
037F   CD 93 03               CALL   csi   
0382   23                     INC   HL   
0383   CD 53 03               CALL   pdec   
0386   3E 3B                  LD   A,";"   
0388   EF                     RST   28h   
0389   E1                     POP   HL   
038A   23                     INC   HL   
038B   CD 53 03               CALL   pdec   
038E   3E 48                  LD   A,"H"   
0390   EF                     RST   28h   
0391   C1                     POP   BC   
0392   DF                     RST   18h   
0393                             ; csi: print ESC [, which starts every ANSI sequence. Keeps all but A.
0393   3E 1B        CSI:      LD   A,27   
0395   EF                     RST   28h   
0396   3E 5B                  LD   A,"["   
0398   EF                     RST   28h   
0399   C9                     RET      
039A                          ENDIF      
039A                          IF   1-ANSI   
                                 ; With ANSI = 0 the machine's own routines do the work (see the equates).
                    G_CUR:    LD   A,H   
                              OR   L   
                              CALL   CONCUR   
                              RST   18h   
                    G_AT:     POP   DE   ; DE = the row, HL = the column
                              CALL   CONAT   
                              RST   18h   
039A                          ENDIF      
039A   C6 03        GRAVE2:   ADD   A,27h-"$"   ; "$"
039C   20 13                  JR   NZ,gv1   
039E   CD 41 04     HX1:      CALL   hexc   
03A1   30 0B                  JR   NC,hx2   
03A3   77                     LD   (HL),A   ; the high digit goes in first ...
03A4   CD 41 04               CALL   hexc   
03A7   30 05                  JR   NC,hx2   ; odd digit: consumed, and the RET below
03A9   ED 6F                  RLD      ;   overwrites it
03AB   23                     INC   HL   ; ... and RLD shifts it up under the low one
03AC   18 F0                  JR   hx1   
03AE   36 C9        HX2:      LD   (HL),0C9h   ; (never range-checked: the spec says so)
03B0   F7                     RST   30h   
03B1   D6 07        GV1:      SUB   "+"-"$"   
03B3   28 2C                  JR   Z,g_inc   
03B5   3D                     DEC   A   ; ","
03B6   28 3C                  JR   Z,g_rnd   
03B8   3D                     DEC   A   ; "-"
03B9   28 25                  JR   Z,g_dec   
03BB   3D                     DEC   A   ; "."
03BC   28 31                  JR   Z,g_seed   
03BE   D6 0E                  SUB   "<"-"."   
03C0   28 4D                  JR   Z,g_min   
03C2   D6 02                  SUB   ">"-"<"   
03C4   28 48                  JR   Z,g_max   
03C6   3D                     DEC   A   ; "?"
03C7   28 9C                  JR   Z,g_cur   
03C9   3D                     DEC   A   ; "@"
03CA   28 AF                  JR   Z,g_at   
03CC   D6 1E                  SUB   "^"-"@"   ; "^" leaves 0 and "_" leaves 1
03CE                          IF   CHECKED   
                              CP   2   
                              JP   NC,e_brack   ; anything else: W. The place is the character
                              OR   A   
03CE                          ENDIF      
03CE                          IF   ANSI   
03CE   20 07                  JR   NZ,ge1   
03D0   CD 93 03               CALL   csi   ; "^": ESC [ H homes the cursor, and then
03D3   3E 48                  LD   A,"H"   ;   ESC [ J clears from there to the end of
03D5   EF                     RST   28h   ;   the screen
03D6   AF                     XOR   A   
03D7   C6 4A        GE1:      ADD   A,"J"   ; "_": ESC [ K clears to the end of the line
03D9   5F                     LD   E,A   
03DA   CD 93 03               CALL   csi   
03DD   7B                     LD   A,E   
03DE   EF                     RST   28h   
03DF   F7                     RST   30h   
03E0                          ENDIF      
03E0                          IF   1-ANSI   
                              JR   NZ,ge1   
                              CALL   CONCLS   
                              RST   30h   
                    GE1:      CALL   CONEOL   
                              RST   30h   
03E0                          ENDIF      
03E0                             ; `+ and `-. The carry says which: set to add.
03E0                          IF   1-CHECKED   
03E0   3E           G_DEC:    DB   3Eh   ; (LD A,n: steps over the SCF, and "-" comes
03E1   37           G_INC:    SCF      ;   here with the carry clear)
03E2                          ENDIF      
03E2                          IF   CHECKED   
                                 ; (The checked build tests the address first, as "!" does, and then looks at
                                 ; the character again: the test has used the flags.)
                    G_INC:       
                    G_DEC:    CALL   chkst   
                              DEC   BC   
                              LD   A,(BC)   
                              INC   BC   
                              CP   ","   ; carry for "+"
03E2                          ENDIF      
03E2   5E                     LD   E,(HL)   
03E3   23                     INC   HL   
03E4   56                     LD   D,(HL)   
03E5   30 02                  JR   NC,gi1   
03E7   13                     INC   DE   
03E8   13                     INC   DE   
03E9   1B           GI1:      DEC   DE   
03EA   72                     LD   (HL),D   
03EB   2B                     DEC   HL   
03EC   73                     LD   (HL),E   
03ED   EB                     EX   DE,HL   ; the new value is TOS
03EE   F7                     RST   30h   
03EF                             ; `. pushes the address of the random seed.
03EF   E5           G_SEED:   PUSH   HL   
03F0   21 76 0B               LD   HL,SEED   
03F3   F7                     RST   30h   
03F4                             ; `, ( n -- r ). The seed goes one step on: seed * 261 + 1, which takes
03F4                             ; every 16-bit value in turn. The high bits of such a seed are the good ones
03F4                             ; and the low ones repeat soon, so the high byte is folded into the low
03F4                             ; (XOR) before the remainder of dividing by n is taken.
03F4                             ; n must be 1 to 32767: the checked build stops with Z on anything less
03F4                             ; than 1.
03F4                G_RND:       
03F4                          IF   CHECKED   
                              DEC   HL   
                              BIT   7,H   ; n - 1 negative: n is 0 or less
                              INC   HL   
                              JP   NZ,e_zero   
03F4                          ENDIF      
03F4   EB                     EX   DE,HL   ; DE = n
03F5   C5                     PUSH   BC   
03F6   2A 76 0B               LD   HL,(SEED)   
03F9   44                     LD   B,H   
03FA   4D                     LD   C,L   
03FB   29                     ADD   HL,HL   
03FC   29                     ADD   HL,HL   
03FD   09                     ADD   HL,BC   ; * 5
03FE   7C                     LD   A,H   
03FF   81                     ADD   A,C   
0400   67                     LD   H,A   ; + * 256: * 261
0401   23                     INC   HL   
0402   22 76 0B               LD   (SEED),HL   
0405   7C                     LD   A,H   
0406   AD                     XOR   L   
0407   6F                     LD   L,A   
0408   CD E2 02               CALL   udiv   ; DE = the remainder
040B   EB                     EX   DE,HL   
040C   C1                     POP   BC   
040D   F7                     RST   30h   
040E                             ; `< and `>. The carry says which: set for the larger. The two are put in
040E                             ; order, HL the smaller and DE the larger, and then swapped for ">".
040E                             ; b < a (signed) is the borrow of b - a, turned round if the two signs
040E                             ; differ: RRA puts the borrow in bit 7, where the two XORs meet it.
040E   37           G_MAX:    SCF      ; ("<" comes in with the carry clear)
040F   D1           G_MIN:    POP   DE   ; DE = a, HL = b
0410   F5                     PUSH   AF   
0411   7D                     LD   A,L   
0412   93                     SUB   E   
0413   7C                     LD   A,H   
0414   9A                     SBC   A,D   
0415   1F                     RRA      
0416   AC                     XOR   H   
0417   AA                     XOR   D   
0418   17                     RLA      ; carry: b < a
0419   38 01                  JR   C,gm2   
041B   EB                     EX   DE,HL   
041C   F1           GM2:      POP   AF   
041D   30 01                  JR   NC,gm3   
041F   EB                     EX   DE,HL   
0420   F7           GM3:      RST   30h   
0421                             ; =============================================================================
0421                             ;  Dispatch table: the low byte of each handler's address, in code order
0421                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
0421                             ;  It must not cross a page (the dispatcher only adds to its low byte).
0421                             ; =============================================================================
0421                             ; The handlers of the first NPG1 characters start in the image's second page.
0421                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
0421                             ; differs between the builds, so the count is worked out here.
0421                             ; (One division to a line: asm80 only rounds down when it stores a value.)
0421                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
0421                PGBRK:    EQU   (h_break-BASE)/256   
0421                PGDEF:    EQU   (h_def-BASE)/256   
0421                PGFET:    EQU   (h_fetch-BASE)/256   
0421                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
0421                          IF   1-TABP0   
0421                PTAB:        
0421                          ;*Macro unroll:  PTABLE
0421   84                     DB   h_store & 0FFh   
0422   89                     DB   h_str & 0FFh   
0423   97                     DB   h_num & 0FFh   
0424   90                     DB   h_print & 0FFh   
0425   7F                     DB   h_swap & 0FFh   
0426   27                     DB   h_and & 0FFh   
0427   94                     DB   h_emit & 0FFh   
0428   03                     DB   h_open & 0FFh   
0429   0B                     DB   h_close & 0FFh   
042A   48                     DB   h_mul & 0FFh   
042B   1E                     DB   h_add & 0FFh   
042C   BE                     DB   h_cfetch & 0FFh   
042D   16                     DB   h_sub & 0FFh   
042E   81                     DB   h_cstore & 0FFh   
042F   5C                     DB   h_div & 0FFh   
0430   7D                     DB   h_dup & 0FFh   
0431   83                     DB   h_drop & 0FFh   
0432   2F                     DB   h_lt & 0FFh   
0433   3E                     DB   h_eq & 0FFh   
0434   30                     DB   h_gt & 0FFh   
0435   9D                     DB   h_key & 0FFh   
0436   FE                     DB   h_fetch & 0FFh   
0437   E1                     DB   h_def & 0FFh   
0438   D4                     DB   h_break & 0FFh   
0439   D0                     DB   h_ret & 0FFh   
043A   70                     DB   h_xor & 0FFh   
043B   83                     DB   h_alloc & 0FFh   
043C   BE                     DB   h_grave & 0FFh   
043D   2C                     DB   h_tor & 0FFh   
043E   78                     DB   h_or & 0FFh   
043F   1C                     DB   h_fromr & 0FFh   
0440   80                     DB   h_not & 0FFh   
0441                PTABEND:      
0441                          ENDIF      
0441                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
0441                             ; and return its value in A with the carry set; otherwise leave the IP and
0441                             ; return with the carry clear.
0441   0A           HEXC:     LD   A,(BC)   
0442   D6 30                  SUB   "0"   
0444   FE 0A                  CP   10   
0446   38 09                  JR   C,hc1   
0448   E6 DF                  AND   0DFh   
044A   D6 11                  SUB   11h   
044C   FE 06                  CP   6   
044E   D0                     RET   NC   
044F   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
0451   03           HC1:      INC   BC   
0452   C9                     RET      
0453                             ; =============================================================================
0453                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
0453                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
0453                             ;  (RST 28h) prints A. Both keep BC, DE, HL and HL'. In the generic build
0453                             ;  they are the host's KEY and CONOUT routines themselves.
0453                             ; 
0453                             ;  A running program reads the keyboard only through getk and pollk, which
0453                             ;  between them give the break key its rules:
0453                             ;    - Ctrl-C stops the program;
0453                             ;    - any other key that the break check reads is held in KEYBUF for the
0453                             ;      next "?", and a newer one takes its place;
0453                             ;    - "?" (getk) takes the held key first;
0453                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
0453                             ;      key like any other, but two of them within about 250 ms still stop it.
0453                             ;  Both are called straight from a handler, never from a routine under one:
0453                             ;  the checked build's report counts on finding one return address above the
0453                             ;  data stack.
0453                             ; =============================================================================
0453                          IFN   CPM   
                    RAWK:     EQU   KEY   
0453                          ENDIF      
0453                             ; pollk: the break check (see rpushn).
0453   CD 91 04     POLLK:    CALL   rawk   
0456   C8                     RET   Z   ; no key
0457   32 7A 0B               LD   (KEYBUF),A   ; held for the next "?"
045A   FE 03        PK1:      CP   3   ; (getk joins here)
045C   C0                     RET   NZ   
045D                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
045D                             ; the program has turned it off, wait about 250 ms for one more key: a
045D                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
045D                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
045D   3A 7B 0B     CTLC:     LD   A,(BRKOFF)   
0460   B7                     OR   A   
0461   CA 50 05     CT0:      JP   Z,brk   
0464   D5                     PUSH   DE   
0465   11 10 27               LD   DE,250*MSLOOP   
0468   CD 91 04     CT1:      CALL   rawk   
046B   20 05                  JR   NZ,ct2   
046D   1B                     DEC   DE   
046E   7A                     LD   A,D   
046F   B3                     OR   E   
0470   20 F6                  JR   NZ,ct1   
0472   D1           CT2:      POP   DE   ; A = the second key, or 0 if none came
0473   FE 03                  CP   3   
0475   28 EA                  JR   Z,ct0   ; (the zero flag takes the JP there)
0477   B7                     OR   A   
0478   28 03                  JR   Z,ct3   
047A   32 7A 0B               LD   (KEYBUF),A   
047D   3E 03        CT3:      LD   A,3   
047F   B7                     OR   A   
0480   C9                     RET      
0481                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
0481   E5           GETK:     PUSH   HL   ; a held key goes first, and is taken out of
0482   21 7A 0B               LD   HL,KEYBUF   ;   the buffer
0485   7E                     LD   A,(HL)   
0486   36 00                  LD   (HL),0   
0488   E1                     POP   HL   
0489   B7                     OR   A   
048A   C0                     RET   NZ   
048B   CD 91 04               CALL   rawk   
048E   C8                     RET   Z   
048F   18 C9                  JR   pk1   ; Ctrl-C? If not, that is the key
0491                          IF   (1-CHECKED)*(1-EDITOR)   
                    BRK:      EQU   endprog   ; the unchecked build stops without a word
0491                          ENDIF      ;   (with the editor, both stacks are cleared);
0491                          IF   (1-CHECKED)*EDITOR   
0491                BRK:      EQU   edit0   
0491                          ENDIF      
0491                          IF   CHECKED   
                    BRK:      EQU   e_break   ;   the checked build reports B
0491                          ENDIF      
0491                          IF   CPM   
0491   3E FF        RAWK:     LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
0493                             ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
0493                             ; printing and could swallow a key that BDOS 6 then never sees.
0493   D5           PUTC:     PUSH   DE   
0494   E5                     PUSH   HL   
0495   5F                     LD   E,A   
0496   3E 06                  LD   A,6   
0498   CD 9F 04               CALL   bdosx   
049B   E1                     POP   HL   
049C   D1                     POP   DE   
049D   B7                     OR   A   ; (for getk)
049E   C9                     RET      
049F                             ; bdosx: call BDOS function A with DE, keeping BC and HL'
049F   C5           BDOSX:    PUSH   BC   
04A0   D9                     EXX      
04A1   E5                     PUSH   HL   
04A2   D9                     EXX      
04A3   4F                     LD   C,A   
04A4   CD 05 00               CALL   BDOS   
04A7   D9                     EXX      
04A8   E1                     POP   HL   
04A9   D9                     EXX      
04AA   C1                     POP   BC   
04AB   C9                     RET      
04AC                          ENDIF      
04AC                             ; =============================================================================
04AC                             ;  Checked build: the checks and the error report
04AC                             ; =============================================================================
04AC                          IF   CHECKED   
                                 ; chkstk: both stacks are checked once per character, not in every handler.
                                 ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
                                 ; the constant carries if it is above (cells were popped that were never
                                 ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
                                 ; a character late at most: the bytes above DSTOP and the guard band below
                                 ; the page take what happens meanwhile. DE is free between characters.
                    CHKSTK:   EX   DE,HL   
                              LD   HL,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
                              ADD   HL,SP   
                              EX   DE,HL   
                              JR   C,e_under   
                              INC   D   
                              JR   NZ,e_over   
                              EXX      ; the return stack: in its page (or it has
                              LD   A,H   ;   overflowed), and not above its empty
                              CP   RSPAGE   ;   position (an underflow stays inside the
                              LD   A,L   ;   page, in the guard band)
                              EXX      
                              JR   NZ,e_rover   
                              CP   RSTOP&0FFh+1   
                              RET   C   
                              EXX      ; return stack underflow: it counts as empty
                              LD   L,RSTOP&0FFh   ;   (H is right: the pointer is in its page)
                              EXX      
                              LD   A,"r"   
                              JR   errp   
                    E_ROVER:   LD   A,"R"   ; return stack overflow
                              DB   11h   ; (LD DE,nn hides the next entry)
                    E_OVER:   LD   A,"S"   ; data stack overflow
                              JR   errp   
                    E_UNDER:   LD   SP,DSTOP   ; data stack underflow: it counts as empty
                              LD   A,"s"   
                              JR   error   
                                 ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
                                 ; was never defined still holds 0000h, and the byte there is a reserved one
                                 ; in every build (AFh or C3h): if the IP is in page zero, this was a call of
                                 ; an undefined word. The call is undone, so the place is the call itself.
                    E_HI:     INC   B   
                              DJNZ   e_resv   ; (B is as it was, and is not 0)
                              RST   08h   
                              LD   B,D   
                              LD   C,E   
                              LD   A,"U"   
                              JR   error   
                                 ; chkhp: HL = the new heap top, DE = the old one, the carry is from adding
                                 ; the count. Stop if the top is not below the limit page, or is below the
                                 ; program's end.
                    CHKHP:       
04AC                          ENDIF      
04AC                          IF   CHECKED*CPM   
                                 ; With this much room a top that wrapped round can land back in
                                 ; range, so the add is tested too: growing (A, the count's high
                                 ; byte, is positive) must not carry, and releasing must.
                              RRA      ; the carry comes in above the sign:
                              ADD   A,40h   ;   bit 7 = carry XOR sign
                              ADD   A,A   
                              JR   C,e_heap   
                              LD   A,(0007h)   
                              DEC   A   
                              CP   H   
                              JR   C,e_heap   
04AC                          ENDIF      
04AC                          IF   CHECKED*(1-CPM)   
                                 ; (Here the program's space is under 32K, so a top that wrapped
                                 ; round always falls outside it.)
                              LD   A,H   
                              CP   HEAPLIM   
                              JR   NC,e_heap   
04AC                          ENDIF      
04AC                          IF   CHECKED   
                              PUSH   DE   
                              EX   DE,HL   
                              LD   HL,(NPEND)   
                              ADD   HL,DE   ; carry: at or above the program's end
                              EX   DE,HL   
                              POP   DE   
                              RET   C   
                    E_HEAP:   OR   A   ; put the count back in TOS for the report
                              SBC   HL,DE   
                              LD   A,"H"   
                              JR   errp   
                                 ; chkst: stop unless HL is in the program's own space: from the letter page
                                 ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
                                 ; whatever lies above the limit are safe. Memory above the heap top but
                                 ; below the limit is the program's own: Tiny BASIC keeps its lines there.
                                 ; It is the page of HL + 1 that is tested, so that one test serves both
                                 ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
                                 ; Keeps HL and BC. It runs on into its own error entry.
                    CHKST:    INC   HL   
                              LD   A,H   
                              DEC   HL   
                              CP   LETPAGE   
                              JR   C,e_store   
04AC                          ENDIF      
04AC                          IF   CHECKED*(1-CPM)   
                              CP   HEAPLIM   
                              RET   C   
04AC                          ENDIF      
04AC                          IF   CHECKED*CPM   
                              LD   E,A   
                              LD   A,(0007h)   ; the BDOS page is the heap limit
                              DEC   A   
                              CP   E   
                              RET   NC   
04AC                          ENDIF      
04AC                          IF   CHECKED   
                                 ; Error entries. Each loads its letter and then hides the next entry inside
                                 ; a 3-byte LD DE,nn (the 11h), so they all fall through to `error`.
                    E_STORE:   LD   A,"O"   ; a store outside the program's space
                              DB   11h   
                    E_BREAK:   LD   A,"B"   ; Ctrl-C (found inside pollk or getk)
                                 ; errp: an error found inside a routine: drop its return address first.
                    ERRP:     POP   DE   
                              JR   error   
                    E_QUOTE:   LD   B,H   ; an unclosed string: HL is its address, one
                              LD   C,L   ;   past the opening quote, which is the place
                              LD   A,"Q"   
                              DB   11h   
                    E_RESV:   LD   A,"X"   ; a reserved byte outside a string
                              DB   11h   
                    E_ZERO:   LD   A,"Z"   ; dividing by zero
                              DB   11h   
                    E_BRACK:   LD   A,"W"   ; bad character after [
                                 ; error: the report, then the end. A = the letter, BC = one past the place,
                                 ; HL = TOS, and both stacks as the report is to show them:
                                 ; 
                                 ;   Err X @ line,col
                                 ;   up to 16 characters of the text from the place
                                 ;   Stk n: the top 8 cells at most, bottom to top
                                 ;   Rtn n
                    ERROR:    PUSH   HL   ; now the whole data stack is in memory
                              LD   E,A   
                              CALL   pnl   
                              DB   "Err ",22h   
                              LD   A,E   
                              RST   28h   
                              CALL   pmsg   
                              DB   " @ ",22h   
                              DEC   BC   ; BC = the place
                                 ; The line and column. A place below the program is in the line
                                 ; buffer: line 0. Otherwise count the LFs from the program's start;
                                 ; DE = the line's number, HL = where it starts.
                              LD   HL,LINEBUF   
                              LD   DE,0   
                              LD   A,B   
                              CP   PROG/256   
                              JR   C,er3   
                              INC   H   
                              LD   L,E   ; HL = PROG
                    ER1:      INC   DE   ; a new line starts at HL
                              PUSH   HL   
                    ER2:      LD   A,L   
                              SUB   C   
                              LD   A,H   
                              SBC   A,B   
                              JR   NC,er2x   ; reached the place
                              LD   A,(HL)   
                              INC   HL   
                              CP   10   
                              JR   NZ,er2   
                              POP   AF   
                              JR   er1   
                    ER2X:     POP   HL   
                    ER3:      PUSH   BC   
                              PUSH   HL   
                              EX   DE,HL   
                              CALL   pdec   ; the line
                              LD   A,","   
                              RST   28h   
                              POP   DE   
                              POP   HL   
                              PUSH   HL   
                              OR   A   
                              SBC   HL,DE   
                              INC   HL   
                              CALL   pdec   ; the column
                              CALL   pnl   
                              DB   22h   
                              POP   HL   ; the text, as it is: 16 characters, or fewer
                              LD   B,16   ;   if the line or the program ends first
                    ER4:      LD   A,(HL)   
                              INC   HL   
                              OR   A   
                              JR   Z,er5   
                              CP   13   
                              JR   Z,er5   
                              CP   10   
                              JR   Z,er5   
04AC                          ENDIF      
04AC                          IF   CHECKED*CPM   
                              CP   1Ah   ; (the ^Z that pads a file's last record ends
                              JR   Z,er5   ;   the text too: some terminals clear the
04AC                          ENDIF      ;   screen on it)
04AC                          IF   CHECKED   
                              RST   28h   
                              DJNZ   er4   
                    ER5:         ; (without the editor: on into pstk)
04AC                          ENDIF      
04AC                          IF   CHECKED*EDITOR   
                              CALL   pstk   
                              CALL   pnl   
                              DB   22h   
                              JP   edit0   ; back to the editor, with both stacks cleared
04AC                          ENDIF      
04AC                             ; =============================================================================
04AC                             ;  Routines that the checked build's report and the editor share
04AC                             ; =============================================================================
04AC                SPADJ:    EQU   2*EDITOR   ; (with the editor pstk is called, not fallen
04AC                             ;   into: the stack is one address deeper)
04AC                          IF   CHECKED+EDITOR   
04AC                             ; pstk: the two stack lines:  Stk n: the top 8 cells at most, bottom to top
04AC                             ;                             Rtn n
04AC                             ; TOS must be in memory with the rest (pushed). In a build without the
04AC                             ; editor this is the end of `error`, which runs on into it.
04AC   CD 0E 05     PSTK:     CALL   pnl   
04AF   53 74 6B 20 22         DB   "Stk ",22h   
04B4   21 08 F5               LD   HL,(2+SPADJ-DSTOP)&0FFFFh   ; SP - (DSTOP-2) is minus twice the
04B7   39                     ADD   HL,SP   ;   depth (the cell at DSTOP-2 was pushed
04B8   E7                     RST   20h   ;   with the first value and holds nothing)
04B9   CD F4 04               CALL   phalf   ; the depth
04BC   3E 3A                  LD   A,":"   
04BE   EF                     RST   28h   
04BF   79                     LD   A,C   
04C0   FE 09                  CP   9   
04C2   38 0A                  JR   C,er6   
04C4   CD 14 05               CALL   pmsg   
04C7   20 2E 2E 2E 22         DB   " ...",22h   
04CC   0E 08                  LD   C,8   
04CE   26 00        ER6:      LD   H,0   ; C = the number of cells to show
04D0   69                     LD   L,C   
04D1   29                     ADD   HL,HL   
04D2   39                     ADD   HL,SP   ; HL -> just above the deepest of them
04D3                          ENDIF      
04D3                          IF   EDITOR   
04D3   23                     INC   HL   
04D4   23                     INC   HL   
04D5                          ENDIF      
04D5                          IF   CHECKED+EDITOR   
04D5   0C                     INC   C   
04D6   0D           ER7:      DEC   C   
04D7   28 11                  JR   Z,er8   
04D9   2B                     DEC   HL   
04DA   56                     LD   D,(HL)   
04DB   2B                     DEC   HL   
04DC   5E                     LD   E,(HL)   
04DD   E5                     PUSH   HL   
04DE   C5                     PUSH   BC   
04DF   3E 20                  LD   A," "   
04E1   EF                     RST   28h   
04E2   EB                     EX   DE,HL   
04E3   CD 4B 03               CALL   psgn   
04E6   C1                     POP   BC   
04E7   E1                     POP   HL   
04E8   18 EC                  JR   er7   
04EA   CD 0E 05     ER8:      CALL   pnl   
04ED                          ENDIF      
04ED                          IF   (1-CHECKED)*EDITOR   
04ED   52 74 6E 20 30 22      DB   "Rtn 0",22h   ; (only ^V comes here, and at the editor the
04F3   C9                     RET      ;   return stack is always empty)
04F4                          ENDIF      
04F4                          IF   CHECKED   
                              DB   "Rtn ",22h   
                              EXX      
                              PUSH   HL   
                              EXX      
                              POP   DE   
                              LD   HL,RSTOP   
                              OR   A   
                              SBC   HL,DE   
04F4                          ENDIF      
04F4                          IF   CHECKED*(1-EDITOR)   
                              CALL   phalf   
                              CALL   pnl   
                              DB   22h   
                              JP   endprog   
04F4                          ENDIF      
04F4                          IF   CHECKED+EDITOR   
04F4                             ; phalf: print half of HL, and leave it in C. (With the editor, pstk ends by
04F4                             ; running on into this.)
04F4   CB 3C        PHALF:    SRL   H   
04F6   CB 1D                  RR   L   
04F8   E5                     PUSH   HL   
04F9   CD 53 03               CALL   pdec   
04FC   C1                     POP   BC   
04FD   C9                     RET      
04FE                             ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
04FE                             ; "$", and the texts of the report and the editor). In the checked build a
04FE                             ; NUL first is an error: Q.
04FE   7E           PRSTR:    LD   A,(HL)   
04FF   23                     INC   HL   
0500   FE 22                  CP   22h   
0502   C8                     RET   Z   
0503                          ENDIF      
0503                          IF   CHECKED   
                              OR   A   
                              JR   Z,e_dollar   
0503                          ENDIF      
0503                          IF   CHECKED+EDITOR   
0503   FE 2F                  CP   "/"   
0505   20 04                  JR   NZ,prs1   
0507   7E                     LD   A,(HL)   
0508   23                     INC   HL   
0509   E6 BF                  AND   0BFh   
050B   EF           PRS1:     RST   28h   
050C   18 F0                  JR   prstr   
050E                             ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
050E                             ; pnl: the same, on a new line.
050E   3E 0D        PNL:      LD   A,13   
0510   EF                     RST   28h   
0511   3E 0A                  LD   A,10   
0513   EF                     RST   28h   
0514   E3           PMSG:     EX   (SP),HL   
0515   CD FE 04               CALL   prstr   
0518   E3                     EX   (SP),HL   
0519   C9                     RET      
051A                          ENDIF      
051A                          IF   CHECKED   
                    E_DOLLAR:   POP   DE   ; "$" ran into a NUL: drop the return address,
                              POP   HL   ;   and put the string's address back in TOS
                              LD   A,"Q"   
                              JP   error   
051A                          ENDIF      
051A                             ; =============================================================================
051A                             ;  The line editor (EDITOR = 1)
051A                             ; 
051A                             ;  The interpreter starts here, and a program that ends comes back here.
051A                             ;  There is no prompt. It follows the spec's suggested standard for a line
051A                             ;  editor (docs/b8script.md, Environments). Type a line and press Return:
051A                             ; 
051A                             ;    n text    put the text in as line n; the lines from n on move down. A
051A                             ;              number past the end (or 0) adds the line at the end.
051A                             ;    n         take line n out
051A                             ;    anything else is run at once, as B8Script. (Start such a line with a
051A                             ;    space if it would begin with a digit.)
051A                             ; 
051A                             ;  A command key ends the line too, and takes what was typed as its argument:
051A                             ; 
051A                             ;    ^G        run the program
051A                             ;    n ^L      list from line n (no number: all of it). Any key holds the
051A                             ;              list until another key is pressed; Ctrl-C ends it.
051A                             ;    n ^E      put line n in the input line; Return puts it back, changed
051A                             ;    name ^R   read. CP/M: the file of that name (no name: the same file as
051A                             ;              last time). Generic: what is typed, or pasted, from now until
051A                             ;              ^Z replaces the program; it is not echoed.
051A                             ;    name ^W   write. CP/M: to that file (no name: the same file as last
051A                             ;              time). Generic: the text is printed, as it is.
051A                             ;    ^N ^N     new: no program (the key twice in a row)
051A                             ;    ^V        view: the build, both stacks, and the program's size, lines
051A                             ;              and free memory
051A                             ;    ^X        leave (to LEAVE)
051A                             ; 
051A                             ;  In the line: ^B and ^F, or the left and right arrow keys, move the cursor;
051A                             ;  a character goes in at the cursor; Backspace and DEL take out the one
051A                             ;  before it; Esc drops the line. Only CR, LF, BS and printing characters are
051A                             ;  sent to the terminal, so any terminal will do.
051A                             ; 
051A                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
051A                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
051A                             ;  125 characters; the one character after a line number separates it from
051A                             ;  the text and is not stored. The text is kept as it is typed, each line
051A                             ;  ending in CR LF, at PROG.
051A                             ; 
051A                             ;  What lasts from one line to the next: the program, the words, the
051A                             ;  variables and the data stack. An error or a break clears both stacks. The
051A                             ;  return stack starts empty for every line.
051A                             ; 
051A                             ;  Things to know:
051A                             ;    - Reset empties the program (generic builds).
051A                             ;    - A word's address points into the program, so run the program again
051A                             ;      after editing it.
051A                             ;    - Nothing is printed between a program's output and what is typed next.
051A                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
051A                             ;      a line that calls -n? and carries on afterwards runs what was typed.
051A                             ;      (The stored program never comes back to the line, so it may.)
051A                             ;    - The editor"s own keys are not the program"s: -n? is the plain line
051A                             ;      read of the other builds (BDOS 10 under CP/M).
051A                             ; 
051A                             ;  The data stack is the CPU's stack, so the editor works on top of whatever
051A                             ;  the last line left there, with TOS pushed like the rest.
051A                             ; =============================================================================
051A                          IF   EDGEN   
                    INIT:        ; reset (A = 0)
051A                          ENDIF      
051A                          IF   EDGEN*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at 0, and
                                 ; every word cell holds 0000h, the address an undefined word is caught at
                                 ; (see e_hi).
                              LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
051A                          ENDIF      
051A                          IF   EDGEN   
                              JR   edit0   
051A                          ENDIF      
051A                          IF   EDITOR   
051A                             ; ^F, right arrow: one to the right, by printing the character there
051A   7D           RIGHT:    LD   A,L   
051B   BB                     CP   E   
051C   28 4A                  JR   Z,ed1   ; at the end
051E   7E                     LD   A,(HL)   
051F   2C                     INC   L   
0520   18 2B                  JR   lf1   
0522                             ; Esc: alone it drops the line. An arrow key sends Esc [ and a letter, so
0522                             ; wait about 5 ms for a second key: after a "[" read on to the letter that
0522                             ; ends the sequence, and act on C (right) and D (left).
0522   01 C8 00     ESC:      LD   BC,5*MSLOOP   
0525   CD 91 04     ES1:      CALL   rawk   
0528   20 0A                  JR   NZ,es2   
052A   0B                     DEC   BC   
052B   78                     LD   A,B   
052C   B1                     OR   C   
052D   20 F6                  JR   NZ,es1   
052F   CD 9D 05               CALL   fin   ; no second key: the line is dropped
0532   18 22                  JR   edit   
0534   FE 5B        ES2:      CP   "["   
0536   20 30                  JR   NZ,ed1   ; not a sequence known here
0538   CD F6 05     ES3:      CALL   ekey   
053B   FE 40                  CP   40h   
053D   38 F9                  JR   C,es3   ; (its parameters)
053F   D6 43                  SUB   "C"   
0541   28 D7                  JR   Z,right   
0543   3D                     DEC   A   ; "D"?
0544   20 22                  JR   NZ,ed1   ; no: on into left
0546                             ; ^B, left arrow: the cursor goes one to the left
0546   7D           LEFT:     LD   A,L   
0547   87                     ADD   A,A   
0548   28 1E                  JR   Z,ed1   ; (L = 80h: at the start)
054A   2D                     DEC   L   
054B   3E 08                  LD   A,8   
054D   EF           LF1:      RST   28h   
054E   18 18                  JR   ed1   
0550                             ; edit0: reset, an error or a break: both stacks are cleared.
0550                             ; skend: a program that ended inside skip: its return address goes.
0550                             ; edend: a program that ended: TOS joins the rest of the data stack.
0550   31 FA 0A     EDIT0:    LD   SP,DSTOP-2   ; empty (the cell that stands for TOS is pushed)
0553   21                     DB   21h   ; (LD HL,nn: steps over the next two bytes)
0554   D1           SKEND:    POP   DE   
0555   E5           EDEND:    PUSH   HL   
0556                             ; edit: start a new input line.
0556   D9           EDIT:     EXX      
0557   21 E0 09               LD   HL,RSTOP   ; the return stack is empty
055A   D9                     EXX      
055B   21 00 00               LD   HL,0   
055E   22 7A 0B               LD   (KEYBUF),HL   ; no key is held, and the break key is on
0561   22 3A 0B               LD   (EDLN),HL   ; no line is being edited
0564   21 80 0B               LD   HL,LINEBUF   ; HL = the cursor,
0567   5D                     LD   E,L   ;   E = the end of the line (its low byte)
0568   CD F6 05     ED1:      CALL   ekey   
056B   FE 7F                  CP   7Fh   
056D   28 40                  JR   Z,bsp   ; DEL
056F   FE 20                  CP   " "   
0571   30 56                  JR   NC,insc   
0573   FE 09                  CP   9   
0575   28 52                  JR   Z,insc   ; Tab is text
0577   FE 08                  CP   8   
0579   28 34                  JR   Z,bsp   
057B   FE 02                  CP   2   
057D   28 C7                  JR   Z,left   ; ^B
057F   FE 06                  CP   6   
0581   28 97                  JR   Z,right   ; ^F
0583   FE 1B                  CP   1Bh   
0585   28 9B                  JR   Z,esc   
0587   E5                     PUSH   HL   ; a command key? Look it up
0588   21 FC 05               LD   HL,cmds   
058B   06 09                  LD   B,NCMD   
058D   BE           ED2:      CP   (HL)   
058E   23                     INC   HL   
058F   28 07                  JR   Z,ed3   
0591   23                     INC   HL   
0592   23                     INC   HL   
0593   10 F8                  DJNZ   ed2   
0595   E1                     POP   HL   
0596   18 D0                  JR   ed1   ; no: the key is ignored
0598   7E           ED3:      LD   A,(HL)   
0599   23                     INC   HL   
059A   66                     LD   H,(HL)   
059B   6F                     LD   L,A   
059C   E3                     EX   (SP),HL   ; the command's address: fin returns to it
059D                             ; fin: end the input line: CR LF and a NUL after it, and a new line on the
059D                             ; terminal. Leaves BC -> the line and HL -> the NUL.
059D   26 0B        FIN:      LD   H,LETPAGE   
059F   6B                     LD   L,E   
05A0   36 0D                  LD   (HL),13   
05A2   2C                     INC   L   
05A3   36 0A                  LD   (HL),10   
05A5   2D                     DEC   L   
05A6   CD 64 07               CALL   prl   ; (prints the CR LF)
05A9   36 00                  LD   (HL),0   
05AB   01 80 0B               LD   BC,LINEBUF   
05AE   C9                     RET      
05AF                             ; Backspace, DEL: the character before the cursor goes. The cursor moves
05AF                             ; left, the rest of the line moves down over it, and the last place (now a
05AF                             ; space) is printed over along with the rest.
05AF   7D           BSP:      LD   A,L   
05B0   87                     ADD   A,A   
05B1   28 B5                  JR   Z,ed1   ; at the start
05B3   2D                     DEC   L   
05B4   3E 08                  LD   A,8   
05B6   EF                     RST   28h   
05B7   E5                     PUSH   HL   
05B8   2C           BS1:      INC   L   
05B9   7E                     LD   A,(HL)   
05BA   2D                     DEC   L   
05BB   77                     LD   (HL),A   
05BC   2C                     INC   L   
05BD   7D                     LD   A,L   
05BE   BB                     CP   E   
05BF   20 F7                  JR   NZ,bs1   
05C1   2D                     DEC   L   
05C2   36 20                  LD   (HL)," "   
05C4   E1                     POP   HL   
05C5   53                     LD   D,E   
05C6   1D                     DEC   E   
05C7   18 15                  JR   ic2   
05C9                             ; A character goes in at the cursor: it ripples up through the rest of the
05C9                             ; line, the cursor moves on, and the rest is printed again.
05C9   47           INSC:     LD   B,A   
05CA   7B                     LD   A,E   
05CB   FE FD                  CP   0FDh   
05CD   28 99                  JR   Z,ed1   ; the line is full: 125 characters
05CF   78                     LD   A,B   
05D0   EF                     RST   28h   
05D1   E5                     PUSH   HL   
05D2   7E           IC1:      LD   A,(HL)   
05D3   70                     LD   (HL),B   
05D4   47                     LD   B,A   
05D5   7D                     LD   A,L   
05D6   2C                     INC   L   
05D7   BB                     CP   E   
05D8   20 F8                  JR   NZ,ic1   
05DA   E1                     POP   HL   
05DB   2C                     INC   L   
05DC   1C                     INC   E   
05DD   53                     LD   D,E   
05DE   CD E3 05     IC2:      CALL   tail   
05E1   18 85                  JR   ed1   
05E3                             ; tail: print the line from the cursor to D (a low byte), and bring the
05E3                             ; cursor back with backspaces. Nothing at all if the cursor is at D.
05E3   4D           TAIL:     LD   C,L   
05E4   7D           TA1:      LD   A,L   
05E5   BA                     CP   D   
05E6   28 05                  JR   Z,ta2   
05E8   7E                     LD   A,(HL)   
05E9   EF                     RST   28h   
05EA   2C                     INC   L   
05EB   18 F7                  JR   ta1   
05ED   7D           TA2:      LD   A,L   
05EE   B9                     CP   C   
05EF   C8                     RET   Z   
05F0   3E 08                  LD   A,8   
05F2   EF                     RST   28h   
05F3   2D                     DEC   L   
05F4   18 F7                  JR   ta2   
05F6                             ; ekey: wait for a key
05F6   CD 91 04     EKEY:     CALL   rawk   
05F9   28 FB                  JR   Z,ekey   
05FB   C9                     RET      
05FC                             ; The command keys, and where each goes (after fin).
05FC   0D           CMDS:     DB   13   
05FD   4F 06                  DW   cret   
05FF   07                     DB   7   ; ^G
0600   97 06                  DW   crun   
0602   0C                     DB   12   ; ^L
0603   A9 06                  DW   clist   
0605   05                     DB   5   ; ^E
0606   25 06                  DW   cedln   
0608   12                     DB   18   ; ^R
0609   6D 07                  DW   cread   
060B   17                     DB   23   ; ^W
060C   76 07                  DW   cwrite   
060E   0E                     DB   14   ; ^N
060F   17 06                  DW   cnew   
0611   16                     DB   22   ; ^V
0612   D9 06                  DW   cview   
0614   18                     DB   24   ; ^X
0615   00 00                  DW   LEAVE   
0617                NCMD:     EQU   9   
0617                             ; ^N ^N: no program, if the next key is ^N too
0617   CD F6 05     CNEW:     CALL   ekey   
061A   FE 0E                  CP   14   
061C   20 04                  JR   NZ,ged0   
061E   AF                     XOR   A   
061F   32 00 0C               LD   (PROG),A   
0622   C3 56 05     GED0:     JP   edit   
0625                             ; ^E: line n goes into the input line, to be changed. EDLN remembers which
0625                             ; line it was: Return puts the text back in its place.
0625   CD 08 03     CEDLN:    CALL   rdnum   
0628   E5                     PUSH   HL   
0629   CD 4C 07               CALL   find   ; HL -> the line, or the NUL if there is none
062C   D1                     POP   DE   
062D   7E                     LD   A,(HL)   
062E   B7                     OR   A   
062F   28 F1                  JR   Z,ged0   
0631   ED 53 3A 0B            LD   (EDLN),DE   
0635   11 80 0B               LD   DE,LINEBUF   
0638   7E           CE1:      LD   A,(HL)   ; copy it, and show it, up to its CR (or LF)
0639   FE 0D                  CP   13   
063B   28 0D                  JR   Z,ce2   
063D   FE 0A                  CP   10   
063F   28 09                  JR   Z,ce2   
0641   12                     LD   (DE),A   
0642   EF                     RST   28h   
0643   23                     INC   HL   
0644   1C                     INC   E   
0645   7B                     LD   A,E   
0646   FE FD                  CP   0FDh   ; (a longer line is cut at 125 characters)
0648   20 EE                  JR   NZ,ce1   
064A   EB           CE2:      EX   DE,HL   ; the cursor is at the line's end
064B   5D                     LD   E,L   
064C   C3 68 05               JP   ed1   
064F                             ; Return. If ^E put a line here, the text goes back in its place. If not:
064F                             ; a number and text is a line to put in, a number alone a line to take out,
064F                             ; and anything else is run where it is.
064F   E5           CRET:     PUSH   HL   ; the end of what was typed
0650   2A 3A 0B               LD   HL,(EDLN)   
0653   7C                     LD   A,H   
0654   B5                     OR   L   
0655   28 07                  JR   Z,cr1   
0657   E5                     PUSH   HL   
0658   CD 3C 07               CALL   delln   
065B   E1                     POP   HL   
065C   18 13                  JR   ins   
065E   CD 08 03     CR1:      CALL   rdnum   ; HL = the number it starts with, BC -> after
0661   79                     LD   A,C   ; C is still 80h if there was no number:
0662   87                     ADD   A,A   ;   only then is twice it 0
0663   28 36                  JR   Z,st0p   ; no number: run the line
0665   0A                     LD   A,(BC)   
0666   FE 0D                  CP   13   
0668   20 06                  JR   NZ,cr2   
066A   D1                     POP   DE   ; the number alone: take that line out
066B   CD 3C 07               CALL   delln   
066E   18 24                  JR   gedit   
0670   03           CR2:      INC   BC   ; step over the one character after the number
0671                             ; Put the text at BC in as line n (in HL): open a gap of its length there,
0671                             ; CR and LF included, and copy it in.
0671   CD 4C 07     INS:      CALL   find   ; HL -> where it goes
0674   D1                     POP   DE   ; the end of what was typed
0675   7B                     LD   A,E   
0676   91                     SUB   C   ; A = the length of the text, with its CR LF
0677   C5                     PUSH   BC   ; the text
0678   4F                     LD   C,A   
0679   06 00                  LD   B,0   
067B   C5                     PUSH   BC   ; its length
067C   54                     LD   D,H   
067D   5D                     LD   E,L   ; DE = where it goes
067E   AF                     XOR   A   
067F   4F                     LD   C,A   ; BC = 0: CPIR looks as far as it needs to
0680   ED B1                  CPIR      ; HL -> one past the program's NUL
0682   ED 52                  SBC   HL,DE   ; the number of bytes to move up, NUL included
0684   44                     LD   B,H   
0685   4D                     LD   C,L   
0686   19                     ADD   HL,DE   
0687   2B                     DEC   HL   ; HL -> the NUL
0688   EB                     EX   DE,HL   
0689   E3                     EX   (SP),HL   ; HL = the length; where it goes is kept
068A   E5                     PUSH   HL   
068B   19                     ADD   HL,DE   ; the NUL's new place
068C   EB                     EX   DE,HL   
068D   ED B8                  LDDR      ; move the rest of the program up
068F   C1                     POP   BC   ; the length
0690   D1                     POP   DE   ; where it goes
0691   E1                     POP   HL   ; the text
0692   ED B0                  LDIR      
0694   C3 56 05     GEDIT:    JP   edit   
0697                             ; ^G: run the program. st0p: run the typed line (BC -> it).
0697   01 00 0C     CRUN:     LD   BC,PROG   
069A   3E                     DB   3Eh   ; (LD A,n: steps over the POP)
069B   E1           ST0P:     POP   HL   ; (the end of what was typed)
069C                             ; st0: start running at BC. The heap starts after the stored program's NUL.
069C   21 00 0C     ST0:      LD   HL,PROG   
069F   AF                     XOR   A   
06A0   BE           ST1:      CP   (HL)   
06A1   23                     INC   HL   
06A2   20 FC                  JR   NZ,st1   
06A4   22 7C 0B               LD   (HEAP),HL   
06A7                          ENDIF      
06A7                          IF   EDITOR*CHECKED   
                              RST   20h   ; minus the heap"s first address: "_' may not
                              LD   (NPEND),HL   ;   release below it
06A7                          ENDIF      
06A7                          IF   EDITOR   
06A7   E1                     POP   HL   ; TOS: the data stack is as the last line left it
06A8   F7                     RST   30h   ; (its return address is thrown away)
06A9                             ; ^L: list from line n. DE = the number of the line at HL.
06A9   CD 08 03     CLIST:    CALL   rdnum   ; HL = n, or 0 if there was none:
06AC   7C                     LD   A,H   
06AD   B5                     OR   L   
06AE   20 01                  JR   NZ,li0   
06B0   2C                     INC   L   ;   then from line 1
06B1   E5           LI0:      PUSH   HL   
06B2   CD 4C 07               CALL   find   
06B5   D1                     POP   DE   
06B6   7E           LI1:      LD   A,(HL)   
06B7   B7                     OR   A   
06B8   28 DA                  JR   Z,gedit   ; the end of the text
06BA   CD 91 04               CALL   rawk   
06BD   28 09                  JR   Z,li3   ; no key: carry on
06BF   FE 03                  CP   3   
06C1   C4 F6 05               CALL   NZ,ekey   ; any key but Ctrl-C: wait for one more
06C4   FE 03                  CP   3   
06C6   28 CC                  JR   Z,gedit   ; Ctrl-C, first or second, ends the list
06C8   E5           LI3:      PUSH   HL   
06C9   D5                     PUSH   DE   
06CA   EB                     EX   DE,HL   
06CB   CD 53 03               CALL   pdec   ; the line's number,
06CE   3E 20                  LD   A," "   
06D0   EF                     RST   28h   ;   a space,
06D1   D1                     POP   DE   
06D2   E1                     POP   HL   
06D3   13                     INC   DE   
06D4   CD 64 07               CALL   prl   ;   and the line
06D7   18 DD                  JR   li1   
06D9                             ; ^V: view.
06D9   CD 14 05     CVIEW:    CALL   pmsg   
06DC   42 38 53 5A 38 30 45   DB   "B8SZ80E"   
06E3                          ENDIF      
06E3                          IF   EDITOR*CHECKED   
                              DB   "C"   
06E3                          ENDIF      
06E3                          IF   EDITOR   
06E3   20 32 30 32 36 2D 31 31 2D 32 31 22 DB   " 2026-11-21",22h   
06EF   CD AC 04               CALL   pstk   ; both stacks
06F2   21 00 0C               LD   HL,PROG   
06F5   11 FF FF               LD   DE,0FFFFh   
06F8   13           CV1:      INC   DE   ; count the lines, and find the end
06F9   CD 5A 07               CALL   nxl   
06FC   20 FA                  JR   NZ,cv1   
06FE   E5                     PUSH   HL   ; the NUL
06FF   D5                     PUSH   DE   ; the lines
0700   11 00 F4               LD   DE,(0-PROG)&0FFFFh   
0703   19                     ADD   HL,DE   
0704   CD 0E 05               CALL   pnl   
0707   50 72 6F 67 20 22      DB   "Prog ",22h   
070D   CD 53 03               CALL   pdec   ; the program's size
0710   E1                     POP   HL   
0711   CD 0E 05               CALL   pnl   
0714   4C 69 6E 65 73 20 22   DB   "Lines ",22h   
071B   CD 53 03               CALL   pdec   
071E   D1                     POP   DE   
071F                          ENDIF      
071F                          IF   EDGEN   
                              LD   HL,HEAPLIM*256-1   
071F                          ENDIF      
071F                          IF   EDITOR*CPM   
071F   3A 07 00               LD   A,(0007h)   ; the BDOS page is the limit
0722   67                     LD   H,A   
0723   2E 00                  LD   L,0   
0725   2B                     DEC   HL   
0726                          ENDIF      
0726                          IF   EDITOR   
0726   B7                     OR   A   
0727   ED 52                  SBC   HL,DE   
0729   CD 0E 05               CALL   pnl   
072C   46 72 65 65 20 22      DB   "Free ",22h   
0732   CD 53 03               CALL   pdec   ; the room left for text and heap
0735   CD 0E 05               CALL   pnl   
0738   22                     DB   22h   
0739   C3 56 05     GED1:     JP   edit   
073C                             ; delln: take line n (in HL) out: copy everything after it down over it.
073C   CD 4C 07     DELLN:    CALL   find   
073F   54                     LD   D,H   
0740   5D                     LD   E,L   
0741   CD 5A 07               CALL   nxl   ; HL -> the next line
0744   7E           DE1:      LD   A,(HL)   
0745   12                     LD   (DE),A   
0746   23                     INC   HL   
0747   13                     INC   DE   
0748   B7                     OR   A   
0749   20 F9                  JR   NZ,de1   
074B   C9                     RET      
074C                             ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
074C                             ; of the text if there are fewer lines (or the number is 0). Keeps BC.
074C   EB           FIND:     EX   DE,HL   
074D   21 00 0C               LD   HL,PROG   
0750   1B           FI1:      DEC   DE   
0751   7A                     LD   A,D   
0752   B3                     OR   E   
0753   C8                     RET   Z   
0754   CD 5A 07               CALL   nxl   
0757   20 F7                  JR   NZ,fi1   
0759   C9                     RET      
075A                             ; nxl: step HL over one line, to just past its LF (and return not-zero), or
075A                             ; stop at the NUL that ends the text (and return zero).
075A   7E           NXL:      LD   A,(HL)   
075B   B7                     OR   A   
075C   C8                     RET   Z   
075D   23                     INC   HL   
075E   FE 0A                  CP   10   
0760   20 F8                  JR   NZ,nxl   
0762   B7                     OR   A   
0763   C9                     RET      
0764                             ; prl: print the line at HL, to its LF; HL -> just past it.
0764   7E           PRL:      LD   A,(HL)   
0765   EF                     RST   28h   
0766   7E                     LD   A,(HL)   
0767   23                     INC   HL   
0768   FE 0A                  CP   10   
076A   20 F8                  JR   NZ,prl   
076C   C9                     RET      
076D                          ENDIF      
076D                          IF   EDGEN   
                                 ; ^R, generic: what comes in from now until ^Z is the program. A CR is
                                 ; stored as CR LF; a LF right after a line end is dropped (it is the CR's
                                 ; own, or an empty line's), and a LF anywhere else ends a line too. A last
                                 ; line with no end is given one. Nothing is echoed, and there is no check
                                 ; for running out of memory.
                    CREAD:    LD   HL,PROG-1   
                              LD   (HL),10   ; (as if a line had just ended: the byte is
                              INC   HL   ;   the line buffer's last, and spare)
                    RD1:      CALL   ekey   
                              LD   C,A   
                              CP   1Ah   
                              JR   NZ,rd2   
                              LD   A,10   ; ^Z ends the last line, as a LF would
                    RD2:      CP   10   
                              JR   NZ,rd3   
                              DEC   HL   
                              CP   (HL)   
                              INC   HL   
                              JR   Z,rd4   ; straight after a line end: dropped
                              LD   A,13   ; anywhere else it ends the line
                    RD3:      LD   (HL),A   
                              INC   HL   
                              CP   13   
                              JR   NZ,rd4   
                              LD   (HL),10   ; after a CR goes a LF
                              INC   HL   
                    RD4:      LD   A,C   
                              CP   1Ah   
                              JR   NZ,rd1   
                              LD   (HL),0   
                              JR   ged1   
                                 ; ^W, generic: the text is printed as it is, for the terminal to capture.
                    CWRITE:   LD   HL,PROG   
                    CW1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,ged1   
                              RST   28h   
                              INC   HL   
                              JR   cw1   
076D                          ENDIF      
076D                          IF   EDITOR*CPM   
076D                CFCB:     EQU   005Ch   ; the file's name is kept here, where the CCP
076D                             ;   put the one from the command line
076D                             ; ^R, CP/M: read the file. A name typed before the key is the file's name
076D                             ; from now on.
076D   CD C4 07     CREAD:    CALL   setname   
0770   CD 03 08               CALL   load   
0773   C3 56 05               JP   edit   
0776                             ; ^W, CP/M: write the file: delete the old one, make it anew, write the
0776                             ; text in records of 128 bytes, and close it. The text's NUL and the 127
0776                             ; bytes after it are set to ^Z meanwhile, which pads the last record. (A
0776                             ; full disk or directory is not noticed: the calls fail and that is all.)
0776   CD C4 07     CWRITE:   CALL   setname   
0779   0E 13                  LD   C,19   ; delete
077B   CD FD 07               CALL   fbdos   
077E   0E 16                  LD   C,22   ; make
0780   CD FD 07               CALL   fbdos   
0783   21 00 0C               LD   HL,PROG   
0786   AF                     XOR   A   
0787   BE           CW1:      CP   (HL)   
0788   23                     INC   HL   
0789   20 FC                  JR   NZ,cw1   
078B   2B                     DEC   HL   ; HL -> the NUL
078C   E5                     PUSH   HL   
078D   06 80                  LD   B,128   
078F   36 1A        CW2:      LD   (HL),1Ah   
0791   23                     INC   HL   
0792   10 FB                  DJNZ   cw2   
0794   E1                     POP   HL   
0795   11 00 0C               LD   DE,PROG   
0798   7B           CW3:      LD   A,E   ; a record that starts before the end is written
0799   95                     SUB   L   
079A   7A                     LD   A,D   
079B   9C                     SBC   A,H   
079C   30 09                  JR   NC,cw4   
079E   E5                     PUSH   HL   
079F   0E 15                  LD   C,21   ; write, from where the record lies
07A1   CD B1 07               CALL   frec   
07A4   E1                     POP   HL   
07A5   18 F1                  JR   cw3   
07A7   36 00        CW4:      LD   (HL),0   ; the NUL again
07A9   0E 10                  LD   C,16   ; close
07AB   CD FD 07               CALL   fbdos   
07AE   C3 56 05               JP   edit   
07B1                             ; frec: BDOS function C (read or write a record) with the 128 bytes at DE.
07B1                             ; Returns A = the BDOS's answer, HL = DE and DE = DE + 128.
07B1   D5           FREC:     PUSH   DE   
07B2   C5                     PUSH   BC   
07B3   0E 1A                  LD   C,26   ; set the DMA address
07B5   CD 05 00               CALL   BDOS   
07B8   C1                     POP   BC   
07B9   CD FD 07               CALL   fbdos   
07BC   E1                     POP   HL   
07BD   11 80 00               LD   DE,128   
07C0   EB                     EX   DE,HL   
07C1   19                     ADD   HL,DE   
07C2   EB                     EX   DE,HL   
07C3   C9                     RET      
07C4                             ; setname: if a name was typed (the line does not start with its CR), put it
07C4                             ; in the FCB: up to 8 characters, a dot, up to 3 more, in capitals. The drive
07C4                             ; is the current one. Then, name or no name, clear the FCB after the name,
07C4                             ; as it must be before a file is opened or made.
07C4   11 80 0B     SETNAME:   LD   DE,LINEBUF   
07C7   1A                     LD   A,(DE)   
07C8   FE 0D                  CP   13   
07CA   28 26                  JR   Z,fcbclr   
07CC   21 5C 00               LD   HL,CFCB   
07CF   36 00                  LD   (HL),0   ; the current drive
07D1   06 0B                  LD   B,11   
07D3   2C           SN1:      INC   L   
07D4   36 20                  LD   (HL)," "   
07D6   10 FB                  DJNZ   sn1   
07D8   2E 5D                  LD   L,CFCB+1   
07DA   1A           SN2:      LD   A,(DE)   
07DB   13                     INC   DE   
07DC   FE 0D                  CP   13   
07DE   28 12                  JR   Z,fcbclr   
07E0   FE 2E                  CP   "."   
07E2   20 04                  JR   NZ,sn3   
07E4   2E 65                  LD   L,CFCB+9   ; the type
07E6   18 F2                  JR   sn2   
07E8   FE 61        SN3:      CP   "a"   
07EA   38 02                  JR   C,sn4   
07EC   E6 5F                  AND   5Fh   ; a capital
07EE   77           SN4:      LD   (HL),A   
07EF   2C                     INC   L   
07F0   18 E8                  JR   sn2   
07F2   21 68 00     FCBCLR:   LD   HL,CFCB+12   
07F5   06 18                  LD   B,24   
07F7   36 00        FC1:      LD   (HL),0   
07F9   23                     INC   HL   
07FA   10 FB                  DJNZ   fc1   
07FC   C9                     RET      
07FD                             ; fbdos: BDOS function C on the file
07FD   11 5C 00     FBDOS:    LD   DE,CFCB   
0800   C3 05 00               JP   BDOS   
0803                             ; load: read the file into PROG. No such file: no program. The text ends at
0803                             ; the file"s first ^Z (1Ah), which pads a text file"s last record; one more
0803                             ; goes after the last record, so the search always stops. And every line
0803                             ; must end in LF: a last line without one is given a CR LF. (The FCB is
0803                             ; clear after its name: the CCP left it so, or setname did.)
0803   0E 0F        LOAD:     LD   C,15   ; open (no such file: the first read fails
0805   CD FD 07               CALL   fbdos   ;   too)
0808   11 00 0C               LD   DE,PROG   
080B   0E 14        LD1:      LD   C,20   ; read the next 128 bytes
080D   CD B1 07               CALL   frec   
0810   B7                     OR   A   
0811   28 F8                  JR   Z,ld1   
0813   36 1A                  LD   (HL),1Ah   ; (HL = where the record that failed would be)
0815   21 FF 0B               LD   HL,PROG-1   
0818   3E 0A                  LD   A,10   ; (a file with no text needs nothing added)
081A   23           TR1:      INC   HL   
081B   5F                     LD   E,A   ; E = the character before this one
081C   7E                     LD   A,(HL)   
081D   FE 1A                  CP   1Ah   
081F   20 F9                  JR   NZ,tr1   
0821   7B                     LD   A,E   
0822   FE 0A                  CP   10   
0824   28 06                  JR   Z,tr2   
0826   36 0D                  LD   (HL),13   
0828   23                     INC   HL   
0829   36 0A                  LD   (HL),10   
082B   23                     INC   HL   
082C   36 00        TR2:      LD   (HL),0   
082E   C9                     RET      
082F                          ENDIF      
082F                             ; =============================================================================
082F                          IF   CPM   
082F                             ; The RAM pages follow the image; the heap may grow to the BDOS.
082F                START:       
082F                          ENDIF      
082F                          IF   CPM*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
                                 ; is held back.
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
082F                          ENDIF      
082F                          IF   CPM   
082F   21 08 01               LD   HL,vecs   ; the RST routines go down into page zero
0832   11 08 00               LD   DE,0008h   
0835   01 2C 00               LD   BC,vecend-vecs   
0838   ED B0                  LDIR      
083A                          ENDIF      
083A                          IF   CPM*EDITOR   
083A   CD 03 08               CALL   load   ; the file named on the command line
083D   C3 50 05               JP   edit0   
0840                          ENDIF      
0840                          IF   CPM*(1-EDITOR)   
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:      LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
                              JP   st2   
0840                          ENDIF      
0840                          IF   CPM   
0840                             ; RAM pages, after the image
0840                RSPAGE:   EQU   (imgend + 255) / 256   
0840                DSPAGE:   EQU   RSPAGE + 1   
0840                LETPAGE:   EQU   RSPAGE + 2   
0840                PROG:     EQU   LETPAGE*256 + 256   
0840                          ENDIF      
0840                IMGEND:      


