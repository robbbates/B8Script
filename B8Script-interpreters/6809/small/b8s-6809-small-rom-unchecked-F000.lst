F21D   E6 84        CF1:      LDB   ,X   
F21F   ED C4                  STD   ,U   
F221   39                     RTS      
F222                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
F222                             ; drops it and carries on.
F222   EC C1        H_CLOSE:   LDD   ,U++   
F224   10 27 FF 45            LBEQ   rdrop   
F228   10 AE 62               LDY   2,S   ; the block start, under the return address
F22B   7E F0 A0               JMP   pollk   ; the break check, at every loop-back
F22E                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
F22E                             ; "*": three 8x8 multiplies; only the low 16 bits are kept.
F22E                             ; a = ah:al at 2,U.  b = bh:bl at ,U.
F22E                             ; (base leaves out a cross term whose high byte is 0, which most
F22E                             ; multiplications have: a count or a small constant.)
F22E                          IF   1-QK   
F22E   A6 43        H_MUL:    LDA   3,U   
F230   E6 C4                  LDB   ,U   
F232   3D                     MUL      ; al*bh
F233   E7 C4                  STB   ,U   ; (bh is no longer needed)
F235   A6 42                  LDA   2,U   
F237   E6 41                  LDB   1,U   
F239   3D                     MUL      ; ah*bl
F23A   EB C4                  ADDB   ,U   
F23C   E7 C4                  STB   ,U   ; the cross terms, low byte
F23E                          ENDIF      
F23E                          IF   QK   
                    H_MUL:    LDA   3,U   
                              LDB   ,U   
                              BEQ   mu1   ; bh = 0: no al*bh (and ,U is 0 already)
                              MUL      ; al*bh
                              STB   ,U   ; (bh is no longer needed)
                    MU1:      LDA   2,U   
                              BEQ   mu2   ; ah = 0: no ah*bl
                              LDB   1,U   
                              MUL      ; ah*bl
                              ADDB   ,U   
                              STB   ,U   ; the cross terms, low byte
                    MU2:         
F23E                          ENDIF      
F23E   A6 43                  LDA   3,U   
F240   E6 41                  LDB   1,U   
F242   3D                     MUL      ; al*bl
F243   AB C4                  ADDA   ,U   
F245   33 42                  LEAU   2,U   
F247   ED C4                  STD   ,U   
F249   39                     RTS      
F24A                             ; Signed compares: a-b, then a branch to put -1 or 0 on the stack.
F24A   8D 18        H_GT:     BSR   h_swap   ; a > b is b < a
F24C   8D 10        H_LT:     BSR   cmp   
F24E   2D 02                  BLT   true   
F250   5F           FALSE:    CLRB      
F251   8C                     FCB   8Ch   ; (CMPX #: steps over the LDB)
F252   C6 FF        TRUE:     LDB   #0FFh   
F254   1D                     SEX      ; D = 0000 or FFFF
F255   ED C4                  STD   ,U   
F257   39                     RTS      
F258   8D 04        H_EQ:     BSR   cmp   
F25A   27 F6                  BEQ   true   
F25C   20 F2                  BRA   false   
F25E   EC 42        CMP:      LDD   2,U   
F260   10 A3 C1               CMPD   ,U++   
F263   39                     RTS      
F264                             ; ---- stack, and printing ----------------------------------------------------
F264   37 16        H_SWAP:   PULU   D,X   ; "%"
F266   36 06                  PSHU   D   
F268   36 10                  PSHU   X   
F26A   39                     RTS      
F26B   EC C4        H_DUP:    LDD   ,U   ; ":"
F26D   36 06                  PSHU   D   
F26F   39                     RTS      
F270   A6 41        H_EMIT:   LDA   1,U   ; "'"
F272                          IF   1-CHECKED   
F272   8D 4C                  BSR   putc   
F274                          ENDIF      
F274                          IF   CHECKED   
                              JSR   CONOUT   ; (the checked build's report is in the way)
F274                          ENDIF      
F274   33 42        H_DROP:   LEAU   2,U   ; ";"
F276   39                     RTS      
F277                             ; ---- more arithmetic ---------------------------------------------------------
F277   EC C1        H_AND:    LDD   ,U++   
F279   A4 C4                  ANDA   ,U   
F27B   E4 41                  ANDB   1,U   
F27D   20 04                  BRA   st   
F27F   EC C1        H_ADD:    LDD   ,U++   
F281   E3 C4                  ADDD   ,U   
F283   ED C4        ST:       STD   ,U   
F285   39                     RTS      
F286                             ; "-" has two jobs: directly before a digit it starts a negative number.
F286                             ; (The checked build has it in the tail, near negnum: its report would be
F286                             ; in the way here.)
F286                          IF   1-CHECKED   
F286   BD F0 7C     H_SUB:    JSR   isdig   
F289   25 7C                  BLO   negnum   
F28B   EC 42                  LDD   2,U   
F28D   A3 C1                  SUBD   ,U++   
F28F   20 F2                  BRA   st   
F291                          ENDIF      
F291                             ; "!" ( n addr -- ) is "." with the high byte stored first. The cell in
F291                             ; memory is little-endian.
F291                             ; Checked: both bytes must be in the program's space, and they are tested
F291                             ; before either is stored (chkst stops with O, the stack untouched).
F291                          IF   1-CHECKED   
F291   37 10        H_STORE:   PULU   X   
F293   A6 C4                  LDA   ,U   
F295   A7 01                  STA   1,X   
F297                          ENDIF      
F297                          IF   CHECKED   
                    H_STORE:   LDX   ,U   
                              BSR   chkst   
                              LEAX   1,X   
                              BSR   chkst   
                              LDA   2,U   
                              STA   ,X   
                                 ; and fall into ".", which loads X again (and checks it again)
F297                          ENDIF      
F297                          IF   1-CHECKED   
F297   8C                     FCB   8Ch   ; (CMPX #: steps over the PULU)
F298   37 10        H_CSTORE:   PULU   X   ; "." ( c addr -- )
F29A                          ENDIF      
F29A                          IF   CHECKED   
                    H_CSTORE:   LDX   ,U   ; "." ( c addr -- )
                              BSR   chkst   
                              LEAU   2,U   
F29A                          ENDIF      
F29A   37 06                  PULU   D   
F29C   E7 84                  STB   ,X   
F29E   39                     RTS      
F29F                          IF   CHECKED   
                                 ; ---- reached from a handler ------------------------------------------------
                                 ; chkst: stop with O unless X is in the program's own space: from the letter
                                 ; page up to HEAPLIM, so the interpreter's stacks and whatever lies above the
                                 ; limit are safe. Memory above the heap top but below the limit is the
                                 ; program's own: Tiny BASIC keeps its lines there. Keeps every register.
                    CHKST:    CMPX   #LET   
                              BLO   cs9   
                              CMPX   #HEAPLIM*256   
                              BHS   cs9   
                              RTS      ; in range
                    CS9:      LDA   #"O"   
                              FCB   8Ch   
                    E_ZERO:   LDA   #"Z"   ; / by zero
                              FCB   8Ch   
                    E_QUOTE:   LDA   #"Q"   ; " or $ ran into the NUL
                                 ; and fall into error. (H, W and N have their own entries, near
                                 ; their handlers, at ejmp.)
                                 ; =============================================================================
                                 ;  Checked build: the error report. A = the letter, AT = the place; U is
                                 ;  as the program left it, and SSAV holds S as the failing character began
                                 ;  (see "the error entries" after `upper`).
                                 ;  It sits here, ahead of h_num, pdec and putc, so that it reaches them with
                                 ;  short calls. Prints
                                 ; 
                                 ;     CR LF
                                 ;     Err X @ line,col CR LF
                                 ;     D:n:[ ...][ v]*  CR LF     (the top 8 cells, bottom to top, signed)
                                 ;     R:n CR LF
                                 ; 
                                 ;  and goes to EXIT. Line and column count from 1: the line is one more
                                 ;  than the LFs between PROG and the place, the column the distance from the
                                 ;  last LF (or from PROG-1). A place below PROG is in the -n? line buffer:
                                 ;  line 0, column = its offset there + 1. Numbers other than the cells are
                                 ;  printed unsigned (pdec), the cells signed (h_num).
                                 ; 
                                 ;  The data stack may be one cell past its limit (S, U = 8100h): the
                                 ;  report's own cells then reach 6 bytes further down, to 80FAh, into the
                                 ;  return stack page, so the report runs on a fresh return stack at RSREP
                                 ;  (80F0h), below those bytes.
                                 ; =============================================================================
                    ERROR:    LDS   #RSREP   
                              TFR   A,B   ; the letter (pmsg and CONOUT keep B)
                              BSR   pmsg   
                              FCB   13,10,"Err"," "+80h   
                              TFR   B,A   
                              JSR   CONOUT   
                              BSR   pmsg   
                              FCB   " @"," "+80h   
                                 ; the place: Y counts the lines, X walks, the cell at ,U holds the
                                 ; address of the last LF (PROG-1 to begin with)
                              LDY   #0   
                              LDX   #LINEBUF-1   
                              PSHU   X   
                              LDX   #PROG-1   
                              CMPX   <AT   
                              BHS   lc3   ; the place is below PROG: line 0
                              STX   ,U   
                    LC1:      LEAY   1,Y   ; a line
                    LC2:      LEAX   1,X   
                              CMPX   <AT   
                              BHS   lc3   
                              LDA   ,X   
                              CMPA   #10   
                              BNE   lc2   
                              STX   ,U   
                              BRA   lc1   
                                 ; pmsg: print the text after the call, up to and including the character
                                 ; that has bit 7 set (it is printed without it), then return after it.
                                 ; (It sits here, in the middle of the report, where all its calls reach.)
                    PMSG:     PULS   X   
                    PM1:      LDA   ,X   
                              ANDA   #7Fh   
                              JSR   putc   
                              TST   ,X+   
                              BPL   pm1   
                              JMP   ,X   
                    LC3:      LDD   <AT   
                              SUBD   ,U   
                              STD   ,U   ; the column
                              PSHU   Y   
                              BSR   pdec   ; the line
                              BSR   pmsg   
                              FCB   ","+80h   
                              BSR   pdec   ; the column
                              BSR   pmsg   
                              FCB   13,10,"D",":"+80h   
                                 ; the data stack: its depth, then its top 8 cells, from Y down to
                                 ; the program's top cell, at ,U.
                              PSHS   U   ; where the walk ends
                              LDD   #DSTOP   
                              SUBD   ,S   
                              BSR   pdh   ; the depth (pdec leaves U as it was)
                              BSR   pmsg   
                              FCB   ":"+80h   
                              LEAY   16,U   ; past the 8th cell from the top ...
                              CMPY   #DSTOP   
                              BHS   sl1   
                              BSR   pmsg   ; (there are more than 8)
                              FCB   " ..","."+80h   
                              BRA   sl2   
                    SL1:      LDY   #DSTOP   ; ... or the whole stack, if no more than 8
                    SL2:      CMPY   ,S   
                              BLS   sl9   
                              LDD   ,--Y   
                              PSHU   D   
                              BSR   pmsg   
                              FCB   " "+80h   
                              BSR   h_num   
                              BRA   sl2   
                    SL9:      BSR   pmsg   
                              FCB   13,10,"R",":"+80h   
                              LDD   #RSTOP   ; the return stack's depth, (RSTOP - S) / 2,
                              SUBD   <SSAV   ;   S as it was when this character began
                              BSR   pdh   
                              JSR   pmsg   
                              FCB   13,10+80h   
                              JMP   EXIT   
                                 ; pdh: print D/2 (a depth: D is twice it), unsigned.
                    PDH:      LSRA      
                              RORB      
                              PSHU   D   
                              BRA   pdec   
F29F                          ENDIF      
F29F                             ; "#" prints TOS as a signed decimal number, with no space after it.
F29F   6D C4        H_NUM:    TST   ,U   
F2A1   2A 06                  BPL   pdec   
F2A3   86 2D                  LDA   #"-"   
F2A5   8D 19                  BSR   putc   
F2A7                          IF   CHECKED   
                              LBSR   negt   ; (long: the checked h_print is in between)
F2A7                          ENDIF      
F2A7                          IF   1-CHECKED   
F2A7   8D 61                  BSR   negt   
F2A9                          ENDIF      
F2A9                             ; pdec: print the top cell as unsigned and drop it, by recursion on /10
F2A9   CC 00 0A     PDEC:     LDD   #10   
F2AC   36 06                  PSHU   D   
F2AE                          IF   (1-CHECKED)*(1-QK)   
F2AE   8D 69                  BSR   udiv   ; NOS = quotient, TOS = digit
F2B0                          ENDIF      
F2B0                          IF   CHECKED*(1-QK)   
                              LBSR   udiv   ; (out of a BSR's reach here)
F2B0                          ENDIF      
F2B0                          IF   SBASEU   
                              BSR   ud0   ; (base: past the power-of-two test)
F2B0                          ENDIF      
F2B0                          IF   QK-SBASEU   
                              LBSR   ud0   
F2B0                          ENDIF      
F2B0   37 06                  PULU   D   ; the digit
F2B2   34 04                  PSHS   B   
F2B4   EC C1                  LDD   ,U++   ; the quotient: if it is not 0, it goes
F2B6   27 04                  BEQ   pd1   ;   back for the rest of the digits
F2B8   36 06                  PSHU   D   
F2BA   8D ED                  BSR   pdec   
F2BC   35 02        PD1:      PULS   A   
F2BE   8B 30                  ADDA   #"0"   ; and fall into putc
F2C0   7E FF 03     PUTC:     JMP   CONOUT   
F2C3                             ; ---- the tail ---------------------------------------------------------------
F2C3                             ; "$" is the last handler, so what follows its first byte may lie past the
F2C3                             ; second range: its loop, the escapes, and the routines of "/".
F2C3                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
F2C3                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
F2C3                             ; of a. Unchecked, dividing by zero returns two cells of no meaning; checked,
F2C3                             ; it stops with Z, both operands still on the stack.
F2C3                H_DIV:       
F2C3                          IF   CHECKED   
                              LDD   ,U   
                              LBEQ   e_zero   
F2C3                          ENDIF      
F2C3   A6 42                  LDA   2,U   
F2C5   34 02                  PSHS   A   ; a's sign: for r
F2C7   A8 C4                  EORA   ,U   
F2C9   34 02                  PSHS   A   ; a xor b: for q
F2CB   30 42                  LEAX   2,U   
F2CD   8D 44                  BSR   absx   ; |a|
F2CF   1F 31                  TFR   U,X   
F2D1   8D 40                  BSR   absx   ; |b|
F2D3                          IF   1-QK   
F2D3   8D 44                  BSR   udiv   ; NOS = q, TOS = r
F2D5                          ENDIF      
F2D5                          IF   QK   
                              JSR   udiv   ; (base: with the speed-ups)
F2D5                          ENDIF      
F2D5   30 42                  LEAX   2,U   
F2D7   6D E0                  TST   ,S+   
F2D9   2A 02                  BPL   dv1   
F2DB   8D 2F                  BSR   negx   ; q's sign
F2DD   6D E0        DV1:      TST   ,S+   
F2DF   2A 31                  BPL   ng9   
F2E1   20 27                  BRA   negt   ; r's sign
F2E3                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
F2E3                             ; 60h to 7Eh is one of the escapes at pesc; "/" plus any other character
F2E3                             ; clears that character"s bit 6 (/M is CR, "/" and DEL is "?"; "/", ""'
F2E3                             ; and "?" have no bit 6, so //, /" and /? give themselves). The address
F2E3                             ; comes off the stack first, and Y walks the string (the IP waits on S), so
F2E3                             ; that /~ finds its row and column on top, and an escape may use A, B, X
F2E3                             ; and the routines.
F2E3                             ; Checked: a NUL (not one escaped by "/") stops with Q, the string's
F2E3                             ; address put back on the stack (from PSAV) over what any /~ left.
F2E3   34 20        H_PRINT:   PSHS   Y   
F2E5   37 20                  PULU   Y   
F2E7                          IF   CHECKED   
                              CMPU   #DSTOP   ; "$" with nothing on the stack: s, before it
                              LBHI   e_ds   ;   prints from an address of no meaning (N
                              STY   <PSAV   ;   is clear: an underflow)
F2E7                          ENDIF      
F2E7   A6 A0        PR0:      LDA   ,Y+   
F2E9                          IF   CHECKED   
                              BEQ   prq   
F2E9                          ENDIF      
F2E9   81 22                  CMPA   #22h   
F2EB   27 18                  BEQ   pr9   
F2ED   81 2F                  CMPA   #"/"   
F2EF   26 10                  BNE   pr1   
F2F1   A6 A0                  LDA   ,Y+   
F2F3   80 60                  SUBA   #60h   ; ` 0, a-z 1-26, 00bbIDI3LCB8IDI4LCA= 29, ~ 30
F2F5   81 1F                  CMPA   #1Fh   
F2F7   24 04                  BHS   pr2   
F2F9   8D 47                  BSR   pesc   
F2FB   20 EA                  BRA   pr0   
F2FD   8B 60        PR2:      ADDA   #60h   ; any other: bit 6 goes
F2FF   84 BF                  ANDA   #0BFh   
F301   8D BD        PR1:      BSR   putc   
F303   20 E2                  BRA   pr0   
F305   35 A0        PR9:      PULS   Y,PC   
F307                          IF   CHECKED   
                    PRQ:      LDX   <PSAV   
                              PSHU   X   
                              JMP   e_quote   
F307                          ENDIF      
F307                             ; "-", checked build (see the unchecked one, before "!").
F307                          IF   CHECKED   
                    H_SUB:    JSR   isdig   
                              BLO   negnum   
                              LDD   2,U   
                              SUBD   ,U++   
                              BRA   ud3   ; (STD ,U / RTS)
F307                          ENDIF      
F307   BD F0 83     NEGNUM:   JSR   rdnum   ; a negative literal: read it, then negate
F30A   1F 31        NEGT:     TFR   U,X   
F30C   4F           NEGX:     CLRA      ; negx: negate the cell at X
F30D   5F                     CLRB      
F30E   A3 84                  SUBD   ,X   
F310   ED 84                  STD   ,X   
F312   39           NG9:      RTS      
F313   6D 84        ABSX:     TST   ,X   ; absx: negate the cell at X if negative
F315   2A FB                  BPL   ng9   
F317   20 F3                  BRA   negx   
F319                             ; udiv: unsigned divide, in place. The dividend is the NOS cell and the
F319                             ; divisor the TOS cell, both <= 8000h; the NOS cell becomes the quotient and
F319                             ; the TOS cell the remainder. The remainder is built in D (always < the
F319                             ; divisor, so 2R+1 fits in 16 bits).
F319                             ; Dividing by 2 is one shift (the spec wants that fast). (base divides
F319                             ; by any power of two with shifts: its udiv is with the speed-ups, and
F319                             ; comes to ud0 for the rest; pdec, whose divisor is 10, goes straight there.)
F319                          IF   1-QK   
F319   EC C4        UDIV:     LDD   ,U   
F31B   83 00 02               SUBD   #2   
F31E   26 07                  BNE   ud0   
F320   64 42                  LSR   2,U   
F322   66 43                  ROR   3,U   ; the quotient
F324   59                     ROLB      ; the remainder: the bit that fell out (D was 0)
F325   20 18                  BRA   ud3   
F327                          ENDIF      
F327                          IF   1-FAST   
F327   8E 00 10     UD0:      LDX   #16   
F32A   4F                     CLRA      
F32B   5F                     CLRB      
F32C   68 43        UD1:      ASL   3,U   
F32E   69 42                  ROL   2,U   ; the dividend's top bit ...
F330   59                     ROLB      
F331   49                     ROLA      ; ... into the remainder
F332   10 A3 C4               CMPD   ,U   
F335   25 04                  BLO   ud2   
F337   A3 C4                  SUBD   ,U   
F339   6C 43                  INC   3,U   ; a quotient bit
F33B   30 1F        UD2:      LEAX   -1,X   
F33D   26 ED                  BNE   ud1   
F33F                          ENDIF      ; (the fast build's is unrolled: see the end)
F33F   ED C4        UD3:      STD   ,U   
F341   39                     RTS      
F342                             ; pesc: the escapes of "$". A = the character after the "/", minus 60h
F342                             ; (0 to 30); Y points past it. Each returns to the loop with an RTS, its
F342                             ; own or that of the routine it ends by jumping to. A, B and X are free.
F342                             ;    /a-/z   print the variable, as "#" does
F342                             ;    /{      clear the screen, the cursor to the top left
F342                             ;    /}      clear from the cursor to the end of the line
F342                             ;    /|  /`  show the cursor, hide it
F342                             ;    /~      ( row col -- ) the cursor to that row and column, from 0
F342   81 1B        PESC:     CMPA   #27   
F344   24 0F                  BHS   pcon   
F346   48                     ASLA      ; (` leaves A = 0: hide)
F347   27 18                  BEQ   phide   
F349   8E 82 3E               LDX   #LET+40h-2   ; the variable's cell (little-endian)
F34C   EC 86                  LDD   A,X   
F34E   1E 89                  EXG   A,B   
F350   36 06                  PSHU   D   
F352   7E F2 9F               JMP   h_num   
F355                          IF   1-ANSI   
F355   10 27 0B B3  PCON:     LBEQ   CONCLS   ; /{
F359   81 1D                  CMPA   #29   
F35B   10 27 0B B0            LBEQ   CONEOL   ; /}
F35F   22 03                  BHI   pat   
F361   7E FF 12     PHIDE:    JMP   CONCUR   ; /|  (A = 28: show), /`  (A = 0: hide)
F364                          ENDIF      
F364                PAT:         
F364                          IF   CHECKED   
                                 ; /~ checks first that there are a row and a column (with less it
                                 ; is s, and the stack counts as empty): U is never let past the
                                 ; top of the stack, however many /~ there are.
                              CMPU   #DSTOP-4   
                              LBHI   e_ds   ; (N is clear: an underflow)
F364                          ENDIF      
F364                          IF   1-ANSI   
F364   37 16                  PULU   D,X   ; /~  D = the column, X = the row
F366   7E FF 15               JMP   CONAT   
F369                          ENDIF      
F369                          IF   ANSI   
                                 ; /~  ESC [ row+1 ; col+1 H (ANSI counts from 1)
                              PULU   D,X   ; D = the column, X = the row
                              ADDD   #1   
                              LEAX   1,X   
                              PSHU   D   
                              PSHU   X   
                              BSR   csi   
                              JSR   pdec   
                              BSR   pm   
                              FCB   ";"+80h   
                              JSR   pdec   
                              BSR   pm   
                              FCB   "H"+80h   
                              RTS      
                    PCON:     BEQ   pcls   ; /{
                              CMPA   #29   
                              BEQ   peol   ; /}
                              BHI   pat   
                              BSR   pcsi   ; /|  ESC [ ? 2 5 h
                              FCB   "?25","h"+80h   
                              RTS      
                    PHIDE:    BSR   pcsi   ; /`  ESC [ ? 2 5 l
                              FCB   "?25","l"+80h   
                              RTS      
                    PCLS:     BSR   pcsi   ; /{  ESC [ H ESC [ J
                              FCB   "H"+80h   
                              BSR   pcsi   
                              FCB   "J"+80h   
                              RTS      
                    PEOL:     BSR   pcsi   ; /}  ESC [ K
                              FCB   "K"+80h   
                              RTS      
                                 ; pcsi: ESC [ and then the text after the call, as pmsg. csi: ESC [.
                    CSI:      BSR   pm   
                              FCB   27,"["+80h   
                              RTS      
                    PCSI:     BSR   csi   
F369                          ENDIF      
F369                          IF   ANSI*(1-CHECKED)   
                                 ; pmsg: print the text after the call, up to and including the character
                                 ; that has bit 7 set (it is printed without it), then return after it.
                                 ; (The checked build has its own, with the report: pm leads to it.)
                    PM:          
                    PMSG:     PULS   X   
                    PM1:      LDA   ,X   
                              ANDA   #7Fh   
                              JSR   CONOUT   
                              TST   ,X+   
                              BPL   pm1   
                              JMP   ,X   
F369                          ENDIF      
F369                          IF   ANSI*CHECKED   
                    PM:       JMP   pmsg   
F369                          ENDIF      
F369                          IF   QK   
                                 ; =============================================================================
                                 ;  Speed-ups (base, and the fast build)
                                 ; 
                                 ;  The rest of them are with their handlers: "*" (h_mul), the unchecked
                                 ;  a-z (lower), pdec (straight to the long divide) and the startup, which
                                 ;  empties the skip cache. (A true ")" already reads the block start where
                                 ;  it is, in every build, so there is nothing to gain there.)
                                 ; =============================================================================
                                 ; skip, with the skip cache. Nearly every skip is one that has happened
                                 ; before (a loop skips the same false block on every pass), so the end of
                                 ; each scan is remembered: 64 entries of 00bbc3RhcnQsIGVuZA== (big-endian), in the
                                 ; page CPAGE, found by the start's low byte times 4. Only skips that start
                                 ; in the program text hit (the line buffer changes); the cache is emptied
                                 ; whenever a run starts. A program that changes its own text while it runs
                                 ; is not looked after. A hit returns as the scan would: Y past the closer,
                                 ; and A = 0 for ")" or 2 for "]".
                    SKIP:     TFR   Y,D   ; the start: the cache's key
                              ASLB      
                              ASLB      
                              LDX   #CPAGE*256   
                              ABX      ; X -> the entry
                              CMPY   ,X   
                              BNE   sks   
                              CMPY   #PROG   
                              BLO   sks   ; below the program text: never a hit
                              LDY   2,X   ; a hit: the IP is past the closer,
                              LDA   -1,Y   ;   ")" (29h) or "]" (5Dh): 0 or 2
                              LSRA      
                              ANDA   #2   
                              RTS      
                                 ; The scan, which fills the entry (X is kept throughout). A scan that fails
                                 ; ends the program, so an entry is never left half written for a later run
                                 ; to find. Two range tests rule most characters out: ^ and up, and * to Z.
                                 ; Only NUL " ( ) [ ] count. B counts the open levels.
                    SKS:      STY   ,X   ; the key
                              LDB   #0FFh   
                    SQ3:      INCB      ; an opener: one deeper
                    SQ1:      LDA   ,Y+   
                              CMPA   #5Eh   
                              BHS   sq1   ; ^ _ ` a-z 00bbIHwg ~ and up: nothing
                              CMPA   #5Bh   
                              BHS   sqb   ; [ \ ]
                              CMPA   #2Ah   
                              BHS   sq1   ; * to Z: nothing
                              CMPA   #28h   
                              BEQ   sq3   ; (
                              BHI   sqc   ; )
                              CMPA   #22h   
                              BEQ   sqq   ; a string
                              TSTA      
                              BNE   sq1   ; the rest below "(": nothing
F369                          ENDIF      
F369                          IF   QK*(1-CHECKED)   
                              JMP   fin   ; NUL: the end of the program
                    SQQ:      JSR   skipstr   ; step over the string
                              BRA   sq1   
F369                          ENDIF      
F369                          IF   QK*CHECKED   
                              DECA      ; NUL: A = FFh, and the caller decides
                              RTS      
                    SQQ:      JSR   skipstr   ; step over the string; A = FFh with the
                              BCC   sq1   ;   carry set if it ran into the NUL
                              RTS      
F369                          ENDIF      
F369                          IF   QK   
                    SQB:      SUBA   #5Ch   ; [ -1, \ 0, ] 1
                              BEQ   sq1   ; "\" is nothing here
                              BLO   sq3   ; [
                              LDA   #2   ; ]
                              FCB   21h   ; (BRN: steps over the CLRA)
                    SQC:      CLRA      ; )
                              DECB      
                              BPL   sq1   
                              STY   2,X   ; the closer at this level: the entry's end
                              RTS      
                                 ; base: a power of two, 2^k, is a shift: q = a >> k and r = a AND (2^k - 1).
                                 ; That is 2, and 256 for a high byte, and the 32 or 64 of fixed point.
                    UDIV:     LDD   ,U   
                              LBEQ   ud0   ; by 0: the long way (it means nothing anyway)
                              SUBD   #1   
                              TFR   D,X   ; X = d - 1
                              ANDA   ,U   
                              LBNE   ud0   
                              ANDB   1,U   
                              LBNE   ud0   ; not a power of two
                              TFR   X,D   
                              ANDA   2,U   
                              ANDB   3,U   
                              PSHS   D   ; r
                              TST   1,U   
                              BNE   uq0   ; d < 256
                              LDA   ,U   ; 256 and up: d and a move a byte down
                              STA   1,U   ;   (the low byte of d is all the loop
                              LDB   2,U   ;   looks at)
                              CLRA      
                              BRA   uq1   
                    UQ0:      LDD   2,U   
                    UQ1:      LSR   1,U   ; a moves down until d's one bit falls out
                              BCS   uq2   
                              LSRA      
                              RORB      
                              BRA   uq1   
                    UQ2:      STD   2,U   ; q
                              PULS   D   
                              STD   ,U   
                              RTS      
F369                          ENDIF      
F369                          IF   FAST   
                                 ; =============================================================================
                                 ;  The fast build (SPEED = 2)
                                 ; 
                                 ;  The inner loop is a table of 256 handler addresses, FTAB, one for every
                                 ;  byte, and the dispatcher (NEXTF, at the top) is inline at the end of each
                                 ;  of the fast build's own entries, so there is no return to a loop:
                                 ; 
                                 ;      LDB ,Y+ / LDX #FTAB / ABX / ABX / JMP [,X]
                                 ; 
                                 ;  (21 cycles; the checked build calls fchk first, which checks the stacks
                                 ;  and keeps the place, as the ordinary inner loop does.) The entries are
                                 ;  jumped to, not called, so nothing of the dispatcher's is on the return
                                 ;  stack while they run. The letters and digits have one entry each, which
                                 ;  knows its cell or its value already; the commonest punctuation has its
                                 ;  own; the rest are thunks, JSR to the ordinary handler, which returns
                                 ;  with its RTS as it would to the ordinary dispatcher.
                                 ; =============================================================================
F369                          ENDIF      
F369                          IF   FAST*CHECKED   
                                 ; fchk: the checks of the inner loop, for the checked fast build (S is 2
                                 ; lower in here than when the character starts).
                    FCHK:     LEAX   (0-DSLIM)&0FFFFh,U   
                              CMPX   #DSTOP-DSLIM   
                              LBHI   e_ds   
                              LEAX   (2-RSLIM)&0FFFFh,S   
                              CMPX   #RSTOP-RSLIM   
                              LBHI   e_rs   
                              STY   <AT   ; the place, should this character fail
                              LEAX   2,S   
                              STX   <SSAV   ; and the return stack, as it is then
                              RTS      
                    FOPF:     EQU   opf   ; (a false "(": the checked skip)
                    FSTORE:   EQU   ft_store   ; ("!" and "." are checked: the thunks)
                    FCSTORE:   EQU   ft_cstore   
                    FHIGH:    EQU   fhi   ; (80h-FFh: X)
                    FHI:      JMP   e_resv   ; 80h-FFh: reserved
F369                          ENDIF      
F369                          IF   FAST*(1-CHECKED)   
                    FOPF:     EQU   skip   
                    FSTORE:   EQU   fs_store   
                    FCSTORE:   EQU   fs_cstore   
                    FHIGH:    EQU   fign   ; (80h-FFh are ignored)
F369                          ENDIF      
F369                          IF   FAST   
                              ;*Macro unroll: fnext:  NEXTF                   ; the startup comes here
                    FNEXT:    DS   CHECKED,0BDh   ; the startup comes here
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FNUL:     JMP   EXIT   ; NUL: the end of the program
                              ;*Macro unroll: fign:   NEXTF                   ; 01h-20h and DEL (and 80h-FFh unchecked): nothing
                    FIGN:     DS   CHECKED,0BDh   ; 01h-20h and DEL (and 80h-FFh unchecked): nothing
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                                 ; The thunks: the ordinary handler, then the dispatcher.
                    FT_STORE:   JSR   h_store   ; !
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FT_STR:   JSR   h_str   ; "
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FT_NUM:   JSR   h_num   ; #
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FT_PRINT:   JSR   h_print   ; $
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FT_EMIT:   JSR   h_emit   ; '
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FT_CSTORE:   JSR   h_cstore   ; .
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FT_DIV:   JSR   h_div   ; /
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FT_KEY:   JSR   h_key   ; ?
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FT_DEF:   JSR   h_def   ; [
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FT_BREAK:   JSR   h_break   ; \
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FT_ALLOC:   JSR   h_alloc   ; _
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FT_GRAVE:   JSR   h_grave   ; `
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FT_TOR:   JSR   h_tor   ; {
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FT_FROMR:   JSR   h_fromr   ; }
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                                 ; The commonest punctuation, written for the fast build.
                    FS_ADD:   PULU   D   ; +
                              ADDD   ,U   
                              STD   ,U   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FS_SUB:   LDA   ,Y   ; -  (a digit next: a negative number)
                              SUBA   #"0"   
                              CMPA   #10   
                              BLO   fsb1   
                              LDD   2,U   
                              SUBD   ,U++   
                              STD   ,U   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FSB1:     JSR   negnum   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FS_DUP:   LDD   ,U   ; :
                              PSHU   D   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FS_DROP:   LEAU   2,U   ; ;
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FS_SWAP:   LDD   ,U   ; %
                              LDX   2,U   
                              STD   2,U   
                              STX   ,U   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FS_FET:   LDX   ,U   ; @  (the cell in memory is little-endian)
                              LDB   ,X   
                              LDA   1,X   
                              STD   ,U   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FS_CFET:   LDX   ,U   ; ,
                              LDB   ,X   
                              CLRA      
                              STD   ,U   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FS_LT:    PULU   X   ; <  (X = b: b - a)
                              CMPX   ,U   
                              BGT   flt1   
                              LDD   #0   
                              STD   ,U   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FLT1:     LDD   #0FFFFh   
                              STD   ,U   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FS_EQ:    PULU   X   ; =  (X = b: b - a)
                              CMPX   ,U   
                              BEQ   feq1   
                              LDD   #0   
                              STD   ,U   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FEQ1:     LDD   #0FFFFh   
                              STD   ,U   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FS_GT:    PULU   X   ; >  (X = b: b - a)
                              CMPX   ,U   
                              BLT   fgt1   
                              LDD   #0   
                              STD   ,U   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FGT1:     LDD   #0FFFFh   
                              STD   ,U   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FS_AND:   PULU   D   ; &
                              ANDA   ,U   
                              ANDB   1,U   
                              STD   ,U   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FS_OR:    PULU   D   ; |
                              ORA   ,U   
                              ORB   1,U   
                              STD   ,U   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FS_XOR:   PULU   D   ; ^
                              EORA   ,U   
                              EORB   1,U   
                              STD   ,U   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FS_NOT:   COM   ,U   ; ~
                              COM   1,U   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FS_MUL:   LDA   3,U   ; *  (as base's h_mul)
                              LDB   ,U   
                              BEQ   fmu1   
                              MUL      ; al*bh
                              STB   ,U   
                    FMU1:     LDA   2,U   
                              BEQ   fmu2   
                              LDB   1,U   
                              MUL      ; ah*bl
                              ADDB   ,U   
                              STB   ,U   
                    FMU2:     LDA   3,U   
                              LDB   1,U   
                              MUL      ; al*bl
                              ADDA   ,U   
                              LEAU   2,U   
                              STD   ,U   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FS_OPEN:   LDD   ,U++   ; (
                              BEQ   fop0   
                              PSHS   Y   ; true: the block starts at the IP
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FOP0:     JSR   FOPF   ; false: skip to the ")"
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FS_CLOSE:   LDD   ,U++   ; )
                              BEQ   fcl0   
                              LDY   ,S   ; true: back to the block start, read where
                              DEC   <COUNT   ;   it is; and the break check, 1 look in 256
                              BNE   fcl1   
                              JSR   pk1   
                              ;*Macro unroll: fcl1:   NEXTF
                    FCL1:     DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FCL0:     LEAS   2,S   ; false: drop the block start
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FS_RET:   PULS   Y   ; ]
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
F369                          ENDIF      
F369                          IF   FAST*(1-CHECKED)   
                    FS_STORE:   PULU   X   ; !  ( n addr -- ), little-endian
                              PULU   D   
                              STB   ,X   
                              STA   1,X   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FS_CSTORE:   PULU   X   ; .
                              PULU   D   
                              STB   ,X   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
F369                          ENDIF      
F369                          IF   FAST   
                                 ; The digits: each pushes its value, and goes on to fdm for more digits.
                    FD0:      LDD   #0   
                              PSHU   D   
                              LDA   ,Y   
                              SUBA   #"0"   
                              CMPA   #10   
                              BHS   fd0n   
                              JMP   fdm   ; another digit
                              ;*Macro unroll: fd0n:   NEXTF
                    FD0N:     DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FD1:      LDD   #1   
                              PSHU   D   
                              LDA   ,Y   
                              SUBA   #"0"   
                              CMPA   #10   
                              BHS   fd1n   
                              JMP   fdm   ; another digit
                              ;*Macro unroll: fd1n:   NEXTF
                    FD1N:     DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FD2:      LDD   #2   
                              PSHU   D   
                              LDA   ,Y   
                              SUBA   #"0"   
                              CMPA   #10   
                              BHS   fd2n   
                              JMP   fdm   ; another digit
                              ;*Macro unroll: fd2n:   NEXTF
                    FD2N:     DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FD3:      LDD   #3   
                              PSHU   D   
                              LDA   ,Y   
                              SUBA   #"0"   
                              CMPA   #10   
                              BHS   fd3n   
                              JMP   fdm   ; another digit
                              ;*Macro unroll: fd3n:   NEXTF
                    FD3N:     DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FD4:      LDD   #4   
                              PSHU   D   
                              LDA   ,Y   
                              SUBA   #"0"   
                              CMPA   #10   
                              BHS   fd4n   
                              JMP   fdm   ; another digit
                              ;*Macro unroll: fd4n:   NEXTF
                    FD4N:     DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FD5:      LDD   #5   
                              PSHU   D   
                              LDA   ,Y   
                              SUBA   #"0"   
                              CMPA   #10   
                              BHS   fd5n   
                              JMP   fdm   ; another digit
                              ;*Macro unroll: fd5n:   NEXTF
                    FD5N:     DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FD6:      LDD   #6   
                              PSHU   D   
                              LDA   ,Y   
                              SUBA   #"0"   
                              CMPA   #10   
                              BHS   fd6n   
                              JMP   fdm   ; another digit
                              ;*Macro unroll: fd6n:   NEXTF
                    FD6N:     DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FD7:      LDD   #7   
                              PSHU   D   
                              LDA   ,Y   
                              SUBA   #"0"   
                              CMPA   #10   
                              BHS   fd7n   
                              JMP   fdm   ; another digit
                              ;*Macro unroll: fd7n:   NEXTF
                    FD7N:     DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FD8:      LDD   #8   
                              PSHU   D   
                              LDA   ,Y   
                              SUBA   #"0"   
                              CMPA   #10   
                              BHS   fd8n   
                              JMP   fdm   ; another digit
                              ;*Macro unroll: fd8n:   NEXTF
                    FD8N:     DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FD9:      LDD   #9   
                              PSHU   D   
                              LDA   ,Y   
                              SUBA   #"0"   
                              CMPA   #10   
                              BHS   fd9n   
                              JMP   fdm   ; another digit
                              ;*Macro unroll: fd9n:   NEXTF
                    FD9N:     DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                                 ; fdm: another digit, at the IP: the value on top becomes value * 10 + digit
                    FDM:      LDD   ,U   
                              ASLB      
                              ROLA      
                              ASLB      
                              ROLA      
                              ADDD   ,U   ; 5V
                              ASLB      
                              ROLA      ; 10V
                              ADDB   ,Y+   ; and the digit
                              ADCA   #0   
                              SUBD   #30h   ; minus "0"
                              STD   ,U   
                              LDA   ,Y   
                              SUBA   #"0"   
                              CMPA   #10   
                              BLO   fdm   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
F369                          ENDIF      
F369                          IF   FAST*(1-CHECKED)   
                                 ; A-Z: call the word: the IP goes on the return stack, the IP becomes
                                 ; the word's body (the cell is little-endian), and the break key is
                                 ; looked at, one time in 256.
                    FUA:      PSHS   Y   ; A
                              LDB   <00h   
                              LDA   <01h   
                              TFR   D,Y   
                              DEC   <COUNT   
                              BNE   fuA1   
                              JSR   pk1   
                              ;*Macro unroll: fuA1:   NEXTF
                    FUA1:     DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
