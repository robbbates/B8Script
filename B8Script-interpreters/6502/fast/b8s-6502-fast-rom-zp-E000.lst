E7EE                             ; udiv (QK): as the macro UDIV, and any power of two is shifts: 2, and 32,
E7EE                             ; 64, 256 and the like, which fixed point and byte work use all the time.
E7EE   A9 00        UDIV:     LDA   #0   
E7F0   95 FE                  STA   0FEh,X   
E7F2   95 FF                  STA   0FFh,X   
E7F4   A4 05                  LDY   D0   
E7F6   A5 06                  LDA   D1   
E7F8   D0 12                  BNE   uq1   ; 256 and up
E7FA   98                     TYA      
E7FB   F0 38                  BEQ   ud0   ; by 0: the long way (it means nothing anyway)
E7FD   88                     DEY      
E7FE   98                     TYA      
E7FF   25 05                  AND   D0   
E801   D0 32                  BNE   ud0   ; not a power of two
E803   98                     TYA      ; by 2^k below 256: r = a & (2^k - 1),
E804   35 00                  AND   0,X   
E806   95 FE                  STA   0FEh,X   
E808   A5 05                  LDA   D0   ;   and q = a >> k
E80A   D0 1E                  BNE   uq2   ; always
E80C   98           UQ1:      TYA      
E80D   D0 26                  BNE   ud0   ; not a power of two
E80F   A4 06                  LDY   D1   
E811   88                     DEY      
E812   98                     TYA      
E813   25 06                  AND   D1   
E815   D0 1E                  BNE   ud0   ; not a power of two
E817   98                     TYA      ; by 2^k, 256 and up: r = a & (2^k - 1),
E818   35 01                  AND   1,X   
E81A   95 FF                  STA   0FFh,X   
E81C   B5 00                  LDA   0,X   
E81E   95 FE                  STA   0FEh,X   
E820   B5 01                  LDA   1,X   ;   and q = (a >> 8) >> (k - 8)
E822   95 00                  STA   0,X   
E824   A9 00                  LDA   #0   
E826   95 01                  STA   1,X   
E828   A5 06                  LDA   D1   
E82A   4A           UQ2:      LSR      ; a bit of 2^k: one shift for each 0 below
E82B   B0 07                  BCS   uq9   ;   the 1
E82D   56 01        UQ3:      LSR   1,X   
E82F   76 00                  ROR   0,X   
E831   4A                     LSR      
E832   90 F9                  BCC   uq3   
E834   60           UQ9:      RTS      
E835                          ENDIF      
