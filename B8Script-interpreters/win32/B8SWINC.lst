  1873 000008C4 ????????            <1> v_hin:  resd    1               ; the standard input handle
  1874 000008C8 ????????            <1> v_htm:  resd    1               ; the timer, or 0 (must follow v_hin)
  1875 000008CC ????????            <1> v_outh: resd    1               ; the handle putc writes to
  1876 000008D0 ????????            <1> v_dstop:resd    1               ; ESP for the empty data stack
  1877 000008D4 ??                  <1> v_iscon:resb    1               ; non-zero if the input is a console
  1878 000008D5 ??                  <1> v_pcnt: resb    1               ; the break key's countdown
  1879 000008D6 ????????            <1> v_mode: resd    1               ; the console's input mode at the start
  1880 000008DA ????????            <1> v_npend:resd    1               ; the heap's first address (checked '_')
  1881 000008DE ????????            <1> v_skat: resd    1               ; where the skip started (checked N)
  1882 000008E2 ????????            <1> v_edln: resd    1               ; the editor: the line ^E put in the input
  1883                              <1> v_end:
  1884                              <1>         times   -((v_end-next) > 128) db 0      ; (an error if out of reach)
  1885                              <1>         times   -((next-iat) > 128) db 0
