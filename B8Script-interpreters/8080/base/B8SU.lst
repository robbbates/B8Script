0149   FE 11                  CPI   11h   
014B   DA 68 01               JC   p3a   ; 3Ah-40h
014E   D6 11                  SUI   11h   ; A = c - 41h
0150   FE 1A                  CPI   1Ah   
0152   DA C7 05               JC   upper   ; 41h-5Ah: A = letter index 0-25
0155   FE 20                  CPI   20h   
0157   DA 66 01               JC   p5b   ; 5Bh-60h
015A   FE 3A                  CPI   3Ah   
015C   DA 5D 05               JC   lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
015F   FE 3E                  CPI   3Eh   
0161                          ENDIF      
0161                          IF   CHECKED*(1-FAST)   
                              JZ   next0   ; 7Fh, DEL: ignored
                              JNC   e_hi   ; 80h-FFh: reserved
0161                          ENDIF      
0161                          IF   (1-CHECKED)*(1-FAST)   
