E152   A9 00        BOOL:     LDA   #0   
E154   69 FF                  ADC   #0FFh   ; carry clear: FF, set: 00
E156   95 00                  STA   0,X   
E158   95 01                  STA   1,X   
E15A   60                     RTS      
E15B                             ; "*": the classic shift-right multiply. The multiplier is the NOS cell: it
E15B                             ; leaves from the bottom while the product comes in at the top, through
E15B                             ; A:T0 above it; after 16 rounds the cell holds the low 16 bits, which are
E15B                             ; all that is kept. Dropping TOS (the multiplicand) leaves it on top.
E15B   A0 10        H_MUL:    LDY   #16   ; the round count
E15D   A9 00                  LDA   #0   
E15F   85 04                  STA   T0   ; A:T0 = the upper half
E161   56 03                  LSR   3,X   
E163   76 02                  ROR   2,X   ; the first multiplier bit
E165   90 0D        ML1:      BCC   ml2   
E167   85 05                  STA   T1   
E169   18                     CLC      
E16A   A5 04                  LDA   T0   
E16C   75 00                  ADC   0,X   
E16E   85 04                  STA   T0   
E170   A5 05                  LDA   T1   
E172   75 01                  ADC   1,X   ; upper half += the multiplicand
E174   6A           ML2:      ROR      
E175   66 04                  ROR   T0   
E177   76 03                  ROR   3,X   
E179   76 02                  ROR   2,X   ; everything one place right; next bit out
E17B   88                     DEY      
E17C   D0 E7                  BNE   ml1   
E17E   E8                     INX      
E17F   E8                     INX      
E180   60                     RTS      
E181                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
E181                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
E181                             ; of a. Unchecked, dividing by zero returns two cells of no meaning; checked,
E181                             ; it stops with Z.
E181                             ; b's cell is dropped once D holds |b|; udiv then leaves the remainder just
E181                             ; where that cell was, so stepping X back down makes it the top cell.
E181                          IF   CHECKED   
E181   A9 5A        E_ZERO:   LDA   #"Z"   ; divide by zero, the stack as it was
E183   4C 57 E6               JMP   error   
E186                          ENDIF      
E186                H_DIV:       
E186                          IF   CHECKED   
E186   B5 00                  LDA   0,X   
E188   15 01                  ORA   1,X   
E18A   F0 F5                  BEQ   e_zero   
E18C                          ENDIF      
E18C   B5 03                  LDA   3,X   
