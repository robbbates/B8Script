E321   A9 48        E_HEAP:   LDA   #"H"   ; heap past the limit or below the program
E323   2C                     DB   2Ch   ; (BIT abs: hides the next instruction)
E324   A9 4F        E_STORE:   LDA   #"O"   ; a store outside the program's space
E326   4C 16 E5               JMP   error   
