  1300 0000052A 31C0                <1>         xor     eax,eax                 ;   stir the random seed (and the zero
  1301 0000052C C3                  <1>         ret                             ;   flag is set again)
  1302 0000052D 60                  <1> .gk2:   pushad                          ; a key came: when it came stirs the
  1303 0000052E FF55BD              <1>         call    [V(iat_GetTickCount)]   ;   seed, since that is the one thing
  1304 00000531 66010576014100      <1>         add     [ARENA+SEED],ax         ;   here that is not the same every
  1305 00000538 61                  <1>         popad                           ;   time
  1306 00000539 EB0F                <1>         jmp     short pk1               ; Ctrl-C? If not, that is the key
  1307 0000053B C3                  <1> gk9:    ret
  1308                              <1> ; pollk: the break check (see rpoll).
  1309 0000053C 31C0                <1> pollk:  xor     eax,eax
  1310 0000053E E810FFFFFF          <1>         call    waitk
  1311 00000543 74F6                <1>         jz      gk9                     ; no key
  1312 00000545 A27A014100          <1>         mov     [ARENA+HELD],al         ; held for the next '?'
