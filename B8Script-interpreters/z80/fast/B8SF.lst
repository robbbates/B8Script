0460   ED 52                  SBC   HL,DE   
0462   30 02                  JR   NC,uvr13   
0464   19                     ADD   HL,DE   
0465   0D                     DEC   C   
0466   0C           UVR13:    INC   C   
0467   CB 21                  SLA   C   
0469   17                     RLA      
046A   ED 6A                  ADC   HL,HL   
046C   ED 52                  SBC   HL,DE   
046E   30 02                  JR   NC,uvr14   
0470   19                     ADD   HL,DE   
0471   0D                     DEC   C   
0472   0C           UVR14:    INC   C   
0473   CB 21                  SLA   C   
0475   17                     RLA      
0476   ED 6A                  ADC   HL,HL   
0478   ED 52                  SBC   HL,DE   
047A   30 02                  JR   NC,uvr15   
047C   19                     ADD   HL,DE   
047D   0D                     DEC   C   
047E   0C           UVR15:    INC   C   
