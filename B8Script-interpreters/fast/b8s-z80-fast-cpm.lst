035B                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
035B                             ; Uses A; keeps BC (the IP) itself. The dividend shifts up through A:C while
035B                             ; the quotient bits arrive at the bottom of C.
035B                             ; Dividing by 2 is one shift (the spec wants that fast).
035B                          IF   1-QK   
                    UDIV:     LD   A,E   
                              XOR   2   
                              OR   D   
                              JR   NZ,udv0   
                              SRL   H   
                              RR   L   ; the quotient
                              ADC   A,A   
                              LD   E,A   ; the remainder: the bit that fell out (D is 0)
                              RET      
035B                          ENDIF      
035B                          IF   QK   
035B                             ; (The builds with room divide by any power of two with shifts: 2, and 32,
035B                             ; 64, 256 and the like, which fixed point and byte work use all the time.)
035B   7A           UDIV:     LD   A,D   
035C   B7                     OR   A   
035D   20 1A                  JR   NZ,uq1   ; 256 and up
035F   B3                     OR   E   
0360   28 33                  JR   Z,udv0   ; by 0: the long way (it means nothing anyway)
0362   3D                     DEC   A   
0363   A3                     AND   E   
