E208   7E E0 7F               JMP   pollk   ; the break check, at every loop-back
E20B                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
E20B                             ; "*": three 8x8 multiplies; only the low 16 bits are kept.
E20B                             ; a = ah:al at 2,U.  b = bh:bl at ,U.
E20B                             ; (base leaves out a cross term whose high byte is 0, which most
E20B                             ; multiplications have: a count or a small constant.)
E20B                          IF   1-QK   
                    H_MUL:    LDA   3,U   
                              LDB   ,U   
                              MUL      ; al*bh
                              STB   ,U   ; (bh is no longer needed)
                              LDA   2,U   
                              LDB   1,U   
                              MUL      ; ah*bl
                              ADDB   ,U   
                              STB   ,U   ; the cross terms, low byte
E20B                          ENDIF      
E20B                          IF   QK   
E20B   A6 43        H_MUL:    LDA   3,U   
E20D   E6 C4                  LDB   ,U   
E20F   27 03                  BEQ   mu1   ; bh = 0: no al*bh (and ,U is 0 already)
E211   3D                     MUL      ; al*bh
E212   E7 C4                  STB   ,U   ; (bh is no longer needed)
E214   A6 42        MU1:      LDA   2,U   
E216   27 07                  BEQ   mu2   ; ah = 0: no ah*bl
E218   E6 41                  LDB   1,U   
E21A   3D                     MUL      ; ah*bl
E21B   EB C4                  ADDB   ,U   
E21D   E7 C4                  STB   ,U   ; the cross terms, low byte
E21F                MU2:         
E21F                          ENDIF      
E21F   A6 43                  LDA   3,U   
E221   E6 41                  LDB   1,U   
E223   3D                     MUL      ; al*bl
E224   AB C4                  ADDA   ,U   
E226   33 42                  LEAU   2,U   
E228   ED C4                  STD   ,U   
E22A   39                     RTS      
E22B                             ; Signed compares: a-b, then a branch to put -1 or 0 on the stack.
E22B   8D 18        H_GT:     BSR   h_swap   ; a > b is b < a
E22D   8D 10        H_LT:     BSR   cmp   
E22F   2D 02                  BLT   true   
E231   5F           FALSE:    CLRB      
