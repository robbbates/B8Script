03D1                             ; psgn: print HL as a signed number. Uses BC.
03D1   7C           PSGN:     MOV   A,H   
03D2   B7                     ORA   A   
03D3   F2 DE 03               JP   pdec   
03D6   3E 2D                  MVI   A,"-"   
03D8                          ;*Macro unroll:  PUTA
03D8                          DS   1-CPM,0EFh   
03D8   CD                     DS   CPM,0CDh   
03D9   52                     DS   CPM,APUT&0FFh   
03DA   05                     DS   CPM,APUT/256   
03DB                          ;*Macro unroll:  NEGH
03DB                          DS   1-CPM,0E7h   
03DB   CD                     DS   CPM,0CDh   
03DC   27                     DS   CPM,ANEG&0FFh   
03DD   01                     DS   CPM,ANEG/256   
03DE                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
03DE                             ; Uses BC.
03DE   11 0A 00     PDEC:     LXI   D,10   
03E1   CD 9F 03               CALL   udiv   ; HL = HL / 10, C = the last digit
03E4   79                     MOV   A,C   
03E5   F5                     PUSH   PSW   
03E6   7C                     MOV   A,H   
03E7   B5                     ORA   L   
03E8   C4 DE 03               CNZ   pdec   
03EB   F1                     POP   PSW   
03EC   C6 30                  ADI   "0"   
03EE                          ;*Macro unroll:  PUTA
03EE                          DS   1-CPM,0EFh   
03EE   CD                     DS   CPM,0CDh   
03EF   52                     DS   CPM,APUT&0FFh   
03F0   05                     DS   CPM,APUT/256   
03F1   C9                     RET      
03F2                             ; (The table goes here instead in the builds where, before the routines, it
03F2                             ; would cross a page: PTLATE. If it would cross one here too, it starts on
03F2                             ; the next page: PTPAD is 0 unless it must.)
03F2                          IF   (1-FAST)*PTLATE   
                    PTPH:     EQU   $ & 0FFh   
                    PTPX:     EQU   (PTPH + 31) / 256   
                    PTPAD:    EQU   PTPX * (256 - PTPH)   
                              DS   PTPAD   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
03F2                          ENDIF      
03F2                          IF   1-CHECKED   
                                 ; "$" prints the string at TOS (see h_print).
                    PRLP:     MOV   A,M   
                              INX   H   
                              CPI   22h   
                              JZ   h_drop   
                              CPI   "/"   
                              JNZ   pr1   
                              MOV   A,M   
                              INX   H   
                              CPI   60h   
                              JC   pr0   
                              CPI   7Fh   
                              JC   pesc   
                    PR0:      ANI   0BFh   
                              ;*Macro unroll: pr1:    PUTA
                    PR1:      DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              JMP   prlp   
03F2                          ENDIF      
03F2                             ;-----------------------------------------------------------------------------
03F2                             ; pesc: the escapes of "$". A = the character after the "/", 60h to 7Eh, and
03F2                             ; HL points past it. Each goes back into the loop that prints the string
03F2                             ; (PRLOOP), but /~ has the stack to see to, and goes back by PRAGAIN.
03F2                             ;    /a-/z   print the variable, as "#" does
03F2                             ;    /{      clear the screen, the cursor to the top left
03F2                             ;    /}      clear from the cursor to the end of the line
03F2                             ;    /|  /`  show the cursor, hide it
03F2                             ;    /~      ( row col -- ) the cursor to that row and column, from 0
03F2   FE 7E        PESC:     CPI   7Eh   
03F4   CA 17 04               JZ   pat   
03F7   11 97 05               LXI   D,PRLOOP   ; the others return into the loop
03FA   D5                     PUSH   D   
03FB   D6 7B                  SUI   7Bh   ; 00bbIDAsIHwgMSwg 2, and no borrow
03FD   D2 58 04               JNC   pcon   
0400   C6 1A                  ADI   1Ah   ; a-z: 0-25, and a carry; `: FFh, and none
0402   D2 42 04               JNC   phide   
0405   87                     ADD   A   ; the variable's cell
0406   C6 40                  ADI   40h   
0408   E5                     PUSH   H   
0409   C5                     PUSH   B   
040A   6F                     MOV   L,A   
040B   26 0A                  MVI   H,LETPAGE   
040D   7E                     MOV   A,M   
040E   2C                     INR   L   
040F   66                     MOV   H,M   
0410   6F                     MOV   L,A   
0411   CD D1 03               CALL   psgn   
0414   C1                     POP   B   
0415   E1                     POP   H   
0416   C9                     RET      
0417                             ; /~ ( row col addr -- ): the two cells under the string's address go. In
0417                             ; the checked build "$" is the routine prstr: its own return address goes
0417                             ; first, and hp1 calls it again afterwards. There each /~ first looks that
0417                             ; its two cells are there, and is s if not, before it prints anything.
0417                PAT:         
0417                          IF   CHECKED   
0417   E3                     XTHL      ; the text pointer over prstr's return address
0418   21 0A F6               LXI   H,(6-DSTOP)&0FFFFh   ; a carry: the two cells aren't there
041B   39                     DAD   SP   
041C   DA F8 05               JC   e_under   
041F   E1                     POP   H   
0420                          ENDIF      
0420   D1                     POP   D   ; DE = the column
0421   E3                     XTHL      ; HL = the row; the text pointer is kept
0422                          IF   1-ANS   
                              CALL   CONAT   
                              POP   H   
                              JMP   PRAGAIN   
                                 ; With ANSI = 0 the machine's routines do the rest.
                    PCON:     JZ   CONCLS   ; /{
                              CPI   2   
                              JZ   CONEOL   ; /}
                              DB   0FEh   ; /|  (CPI steps over the XRA: A = 1, show)
                    PHIDE:    XRA   A   ; /`  (A = 0: hide)
                              JMP   CONCUR   
0422                          ENDIF      
0422                          IF   ANS   
0422   C5                     PUSH   B   ; (pdec uses BC)
0423   D5                     PUSH   D   
0424   CD 71 04               CALL   csi   ; ESC [ row+1 ; col+1 H (ANSI counts from 1)
0427   23                     INX   H   
0428   CD DE 03               CALL   pdec   
042B   3E 3B                  MVI   A,";"   
042D                          ;*Macro unroll:  PUTA
042D                          DS   1-CPM,0EFh   
042D   CD                     DS   CPM,0CDh   
042E   52                     DS   CPM,APUT&0FFh   
042F   05                     DS   CPM,APUT/256   
0430   E1                     POP   H   
0431   23                     INX   H   
0432   CD DE 03               CALL   pdec   
0435   3E 48                  MVI   A,"H"   
0437                          ;*Macro unroll:  PUTA
0437                          DS   1-CPM,0EFh   
0437   CD                     DS   CPM,0CDh   
0438   52                     DS   CPM,APUT&0FFh   
0439   05                     DS   CPM,APUT/256   
043A   C1                     POP   B   
043B   E1                     POP   H   
043C   C3 E1 02               JMP   PRAGAIN   
043F                             ; With ANSI = 1 they are sequences. The carry is clear on the way in.
043F   1E 68        PSHOW:    MVI   E,"h"   ; /|  ESC [ ? 2 5 h
0441   DA                     DB   0DAh   ; (JC nn: with no carry it steps over two bytes)
0442   1E 6C        PHIDE:    MVI   E,"l"   ; /`  ESC [ ? 2 5 l
0444   3E 3F                  MVI   A,"?"   
0446   CD 68 04               CALL   csia   
0449   3E 32                  MVI   A,"2"   
044B                          ;*Macro unroll:  PUTA
044B                          DS   1-CPM,0EFh   
044B   CD                     DS   CPM,0CDh   
044C   52                     DS   CPM,APUT&0FFh   
044D   05                     DS   CPM,APUT/256   
044E   3E 35                  MVI   A,"5"   
0450                          ;*Macro unroll:  PUTA
0450                          DS   1-CPM,0EFh   
0450   CD                     DS   CPM,0CDh   
0451   52                     DS   CPM,APUT&0FFh   
0452   05                     DS   CPM,APUT/256   
0453   7B                     MOV   A,E   
0454                          ;*Macro unroll:  PUTA
0454                          DS   1-CPM,0EFh   
0454   CD                     DS   CPM,0CDh   
0455   52                     DS   CPM,APUT&0FFh   
0456   05                     DS   CPM,APUT/256   
0457   C9                     RET      
0458                             ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into csia.
0458   3D           PCON:     DCR   A   
0459   CA 3F 04               JZ   pshow   ; /|
045C   3E 4B                  MVI   A,"K"   
045E   F2 68 04               JP   csia   ; /}  ESC [ K
0461   3E 48                  MVI   A,"H"   ; /{  ESC [ H ESC [ J
0463   CD 68 04               CALL   csia   
0466   3E 4A                  MVI   A,"J"   ; (on into csia)
0468                             ; csia: ESC [ and then A. csi: ESC [. Both keep all but A.
0468   F5           CSIA:     PUSH   PSW   
0469   CD 71 04               CALL   csi   
046C   F1                     POP   PSW   
046D                          ;*Macro unroll:  PUTA
046D                          DS   1-CPM,0EFh   
046D   CD                     DS   CPM,0CDh   
046E   52                     DS   CPM,APUT&0FFh   
046F   05                     DS   CPM,APUT/256   
0470   C9                     RET      
0471   3E 1B        CSI:      MVI   A,27   
0473                          ;*Macro unroll:  PUTA
0473                          DS   1-CPM,0EFh   
0473   CD                     DS   CPM,0CDh   
0474   52                     DS   CPM,APUT&0FFh   
0475   05                     DS   CPM,APUT/256   
0476   3E 5B                  MVI   A,"["   
0478                          ;*Macro unroll:  PUTA
0478                          DS   1-CPM,0EFh   
0478   CD                     DS   CPM,0CDh   
0479   52                     DS   CPM,APUT&0FFh   
047A   05                     DS   CPM,APUT/256   
047B   C9                     RET      
047C                          ENDIF      
047C                             ; skip: read past text to the closer at this level, and return A = 0 if it
047C                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
047C                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
047C                             ; no closer; anything else that runs into the NUL had unbalanced brackets
047C                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
047C                             ; skip sets it to 0 and falls through the INR that an opener comes back to.
047C                             ; 
047C                             ; The checked build also looks at the character the skip was started by,
047C                             ; which is always the one just before where it starts: "(" must end at ")",
047C                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
047C                             ; quote counts as running into it. "\" takes either closer. The place where
047C                             ; the skip started is kept on the stack, for the report.
047C                          IF   1-QK   
047C                             ; (Without base: no skip cache.)
047C                SKIP:        
047C                          ENDIF      
047C                          IF   CHECKED*(1-QK)   
047C   C5                     PUSH   B   
047D   0B                     DCX   B   
047E   0A                     LDAX   B   
047F   03                     INX   B   
0480   5F                     MOV   E,A   ; E = the opener: ( [ or \
0481                          ENDIF      
0481                          IF   1-QK   
0481   16 00                  MVI   D,0   
0483   14           SK3:      INR   D   ; an opener: one deeper
0484   0A           SK1:      LDAX   B   
0485                          ENDIF      
0485                          IF   (1-CHECKED)*(1-QK)   
                              INX   B   
                              ORA   A   
                              JZ   endprog   
0485                          ENDIF      
0485                          IF   CHECKED*(1-QK)   
0485   B7                     ORA   A   
0486   CA B4 04               JZ   sk6   ; (the IP stays on the NUL)
0489   03                     INX   B   
048A                          ENDIF      
048A                          IF   1-QK   
048A   FE 22                  CPI   22h   
048C   CC C0 04               CZ   skipstr   ; leaves A = 22h, which matches nothing below
048F   D6 28                  SUI   "("   ;   (or 0, and then the NUL is read next)
0491   CA 83 04               JZ   sk3   
0494   3D                     DCR   A   ; ")"
0495   CA A2 04               JZ   sk4   
0498   D6 32                  SUI   "["-")"   
049A   CA 83 04               JZ   sk3   
049D   FE 02                  CPI   "]"-"["   
049F   C2 84 04               JNZ   sk1   
04A2   15           SK4:      DCR   D   
04A3                          ENDIF      
04A3                          IF   (1-CHECKED)*(1-QK)   
                              RZ      ; the closer at this level
                              JMP   sk1   
04A3                          ENDIF      
04A3                          IF   CHECKED*(1-QK)   
04A3   C2 84 04               JNZ   sk1   
04A6   57                     MOV   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
04A7   AB                     XRA   E   ;   opener is 0 for "(" and 1 for "[", and only
04A8   E6 06                  ANI   6   ;   "\" has bit 2: so this is 2 for the wrong
04AA   FE 02                  CPI   2   ;   closer, and only then
04AC   7A                     MOV   A,D   
04AD   D1                     POP   D   ; (where the skip started)
04AE   C0                     RNZ      
04AF   42                     MOV   B,D   ; N. The place is the opener
04B0   4B                     MOV   C,E   
04B1   C3 BB 04               JMP   sk7   
04B4   7B           SK6:      MOV   A,E   ; the text ran out:
04B5   E6 04                  ANI   4   
04B7   C2 85 01               JNZ   endprog   ;   "\" with no closer ends the program
04BA   C1                     POP   B   
04BB   3E 4E        SK7:      MVI   A,"N"   
04BD   C3 29 06               JMP   errp   ; (errp drops skip's return address)
04C0                          ENDIF      
04C0                          IF   QK   
                                 ; The skip cache. Nearly every skip is one that has happened before (a loop
                                 ; skips the same false block on every pass), so the first scan from each
                                 ; place is remembered: 64 entries of 00bbc3RhcnQsIGVuZA==, in the page CPAGE, found
                                 ; by the start's low byte (times 4). Only skips that start in the program
                                 ; text are kept (the line buffer changes); the cache is emptied whenever a
                                 ; run starts (see start). A program that changes its own text while it
                                 ; runs is not looked after.
                    SKIP:     MOV   A,B   
                              CPI   PROG/256   
                              JC   sks   ; below the program text: no cache
                              MOV   A,C   
                              ADD   A   
                              ADD   A   
                              MOV   E,A   
                              MVI   D,CPAGE   ; DE -> the entry
                              LDAX   D   
                              CMP   C   
                              JNZ   sks   
                              INR   E   
                              LDAX   D   
                              CMP   B   
                              JNZ   sks   
                              INR   E   
                              LDAX   D   
                              MOV   C,A   
                              INR   E   
                              LDAX   D   
                              MOV   B,A   ; a hit: the IP is past the closer
                              DCX   B   
                              LDAX   B   
                              INX   B   
                              SUI   ")"   ; 0 for ")", not 0 for "]"
                              RET      
                    SKS:      PUSH   B   ; where it starts: the cache's key (and the
04C0                          ENDIF      ;   checked report's place)
04C0                          IF   QK*CHECKED   
                              DCX   B   
                              LDAX   B   
                              INX   B   
                              MOV   E,A   ; E = the opener: ( [ or \
04C0                          ENDIF      
04C0                          IF   QK   
                                 ; The scan. Most characters are nothing to it, and two range tests rule
                                 ; them out: * to Z, and ^ and up. Only NUL " ( ) [ ] count.
                              MVI   D,0   
                    SQ3:      INR   D   ; an opener: one deeper
                    SQ1:      LDAX   B   
                              INX   B   
                              CPI   5Eh   
                              JNC   sq1   ; ^ _ ` a-z 00bbIHwg ~ and up: nothing
                              CPI   5Bh   
                              JNC   sqb   ; [ \ ]
                              CPI   2Ah   
                              JNC   sq1   ; * to Z: nothing
                              CPI   28h   
                              JZ   sq3   ; (
                              JNC   sqc   ; )
                              CPI   22h   
                              JZ   sqq   ; a string
                              ORA   A   
                              JNZ   sq1   ; the rest below "(": nothing
04C0                          ENDIF      
04C0                          IF   QK*(1-CHECKED)   
                              JMP   endprog   ; NUL: the end of the program
04C0                          ENDIF      
04C0                          IF   QK*CHECKED   
                              DCX   B   ; NUL: the IP stays on it
                              MOV   A,E   ; the text ran out:
                              ANI   4   
                              JNZ   endprog   ;   "\" with no closer ends the program
                              POP   B   
                    SQ7:      MVI   A,"N"   ; N. The place is the opener
                              JMP   errp   ; (errp drops skip's return address)
04C0                          ENDIF      
04C0                          IF   QK   
                    SQQ:      CALL   skipstr   ; step over the string
                              JMP   sq1   
                    SQB:      SUI   5Ch   ; [ -1, \ 0, ] 1
                              JZ   sq1   ; "\" is nothing here
                              JC   sq3   ; [
                              MVI   A,2   ; ]
                              DB   0FEh   ; (CPI: steps over the XRA)
                    SQC:      XRA   A   ; )
                    SQ4:      DCR   D   
                              JNZ   sq1   
04C0                          ENDIF      
04C0                          IF   QK*CHECKED   
                              MOV   D,A   ; the closer at this level (as above): 2 here
                              XRA   E   ;   means the wrong closer
                              ANI   6   
                              CPI   2   
                              MOV   A,D   
                              POP   D   ; (where the skip started)
                              JNZ   sq8   
                              MOV   B,D   
                              MOV   C,E   
                              JMP   sq7   
                    SQ8:         
04C0                          ENDIF      
04C0                          IF   QK*(1-CHECKED)   
                              POP   D   ; where the skip started
04C0                          ENDIF      
04C0                          IF   QK   
                                 ; The closer at this level: remember the skip (if it started in the program
                                 ; text), and return A = 0 for ")" or 2 for "]". DE = the start, BC = the end.
                              PUSH   H   
                              MOV   H,A   
                              MOV   A,D   
                              CPI   PROG/256   
                              JC   sq9   
                              MOV   A,E   
                              ADD   A   
                              ADD   A   
                              MOV   L,A   
                              MOV   A,H   
                              MVI   H,CPAGE   
                              MOV   M,E   
                              INR   L   
                              MOV   M,D   
                              INR   L   
                              MOV   M,C   
                              INR   L   
                              MOV   M,B   
                              POP   H   
                              RET      
                    SQ9:      MOV   A,H   
                              POP   H   
                              RET      
04C0                          ENDIF      
04C0                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
04C0                             ; the next character, so "/"" does not end it. Leaves A = 22h.
04C0                          IF   1-CHECKED   
                    SS0:      INX   B   
                    SKIPSTR:   LDAX   B   
                              INX   B   
                              CPI   "/"   
                              JZ   ss0   
                              CPI   22h   
                              JNZ   skipstr   
                              RET      
04C0                          ENDIF      
04C0                          IF   CHECKED   
04C0                             ; The checked build never steps over a NUL: if the text runs out first it
04C0                             ; returns A = 0 with the IP on the NUL.
04C0   0A           SKIPSTR:   LDAX   B   
04C1   B7                     ORA   A   
04C2   C8                     RZ      
04C3   03                     INX   B   
04C4   FE 22                  CPI   22h   
04C6   C8                     RZ      
04C7   FE 2F                  CPI   "/"   
04C9   C2 C0 04               JNZ   skipstr   
04CC   0A                     LDAX   B   ; the escaped character
04CD   B7                     ORA   A   
04CE   C8                     RZ      
04CF   03                     INX   B   
04D0   C3 C0 04               JMP   skipstr   
04D3                          ENDIF      
04D3                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
04D3                             ; and return its value in A with the carry set; otherwise leave the IP and
04D3                             ; return with the carry clear.
04D3   0A           HEXC:     LDAX   B   
04D4   D6 30                  SUI   "0"   
04D6   FE 0A                  CPI   10   
04D8   DA E4 04               JC   hc1   
04DB   E6 DF                  ANI   0DFh   
04DD   D6 11                  SUI   11h   
04DF   FE 06                  CPI   6   
04E1   D0                     RNC      
04E2   D6 F6                  SUI   0F6h   ; + 10, and sets the carry
04E4   03           HC1:      INX   B   
04E5   C9                     RET      
04E6                             ;  ---- Speed-ups (base builds) -------------------------------------------
04E6                             ;  The skip cache and "/" by a power of two are above. These are the
04E6                             ;  handlers' tails that the builds with room take, kept here, out of the
04E6                             ;  handlers' first two pages.
04E6                          IF   QK   
                                 ; "*" with an operand below 256: that one becomes the multiplier, a byte in
                                 ; A, and the loop stops as soon as its bits are used up (most
                                 ; multiplications have one, a count or a small constant). With both at 256
                                 ; and up, the multiplier's low byte takes exactly 8 rounds (a marker bit
                                 ; shifted in above it says when), and its high byte goes on as a small one.
                                 ; DE = NOS, HL = TOS.
                    MULQ:     MOV   A,H   
                              ORA   A   
                              JZ   mq8   ; the multiplier is below 256
                              MOV   A,D   
                              ORA   A   
                              JNZ   mq16   
                              XCHG      ; the multiplicand is: it becomes the multiplier
                    MQ8:      MOV   A,L   
                              LXI   H,0   
                              ORA   A   ; (clears the carry)
                              JZ   mq9   
                    MQ1:      RAR      ; the next bit
                              JNC   mq2   
                              DAD   D   
                    MQ2:      XCHG      
                              DAD   H   ; multiplicand << 1
                              XCHG      
                              ORA   A   ; bits left? (and clears the carry)
                              JNZ   mq1   
                              ;*Macro unroll: mq9:    NEXTQ
                    MQ9:      DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM*(1-FAST),0C3h   
                              DS   CPM*(1-FAST),ANXT&0FFh   
                              DS   CPM*(1-FAST),ANXT/256   
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    MQ16:     PUSH   B   
                              MOV   B,H   ; the high byte, for later
                              MOV   A,L   
                              LXI   H,0   
                              STC      ; the marker
                              RAR      
                    MQ3:      JNC   mq4   
                              DAD   D   
                    MQ4:      XCHG      
                              DAD   H   
                              XCHG      
                              CPI   1   ; only the marker left: 8 rounds done (and
                              RAR      ;   the carry was clear for the shift)
                              JNZ   mq3   
                              MOV   A,B   
                              POP   B   
                              ORA   A   
                              JMP   mq1   ; the high byte, as a small multiplier
                                 ; A true ")" reads the block start where it is, on top of the return stack,
                                 ; instead of popping it and pushing it back; the break key is looked at as
                                 ; rpushd would.
                    CLOSEQ:   LHLD   RSP   
                              MOV   C,M   
                              INX   H   
                              MOV   B,M   
                              LXI   H,BRKCNT   
                              DCR   M   
                              POP   H   ; (keeps the flags)
                              CZ   pollk   
                              ;*Macro unroll:  NEXTQ
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM*(1-FAST),0C3h   
                              DS   CPM*(1-FAST),ANXT&0FFh   
                              DS   CPM*(1-FAST),ANXT/256   
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
04E6                          ENDIF      
04E6                          IF   SBASEU   
                                 ; a-z, in the unchecked builds: a variable followed by "@" or "!" is fetched
                                 ; or stored in the same step (x@ is the commonest pair in most programs).
                                 ; (A checked build checks the stacks between the two, so it keeps them apart.)
                    LOWER:    EQU   lowq   
                    LOWQ:     ADD   A   
                              MOV   E,A   
                              MVI   D,LETPAGE   ; DE -> the cell
                              LDAX   B   
                              CPI   "@"   
                              JZ   lwf   
                              CPI   "!"   
                              JZ   lws   
                              PUSH   H   
                              XCHG      ; TOS = the cell's address
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0C3h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
                    LWF:      INX   B   ; x@: TOS = the cell's value
                              PUSH   H   
                              XCHG      
                              MOV   E,M   
                              INX   H   
                              MOV   D,M   
                              XCHG      
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0C3h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
                    LWS:      INX   B   ; x!: the cell = TOS, and NOS comes up
                              XCHG      
                              MOV   M,E   
                              INX   H   
                              MOV   M,D   
                              POP   H   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0C3h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
04E6                          ENDIF      
04E6                             ; =============================================================================
04E6                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
04E6                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
04E6                             ;  (RST 5) prints A. Both keep BC, DE and HL. In the generic build they are
04E6                             ;  the host's KEY and CONOUT routines themselves.
04E6                             ; 
04E6                             ;  A running program reads the keyboard only through getk and pollk, which
04E6                             ;  between them give the break key its rules:
04E6                             ;    - Ctrl-C stops the program;
04E6                             ;    - any other key that the break check reads is held in KEYBUF for the
04E6                             ;      next "?", and a newer one takes its place;
04E6                             ;    - "?" (getk) takes the held key first;
04E6                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
04E6                             ;      key like any other, but two of them within about 250 ms still stop it.
04E6                             ;  Both are called straight from a handler, never from a routine under one:
04E6                             ;  the checked build's report counts on finding one return address above the
04E6                             ;  data stack, and TOS in HL.
04E6                             ; =============================================================================
04E6                          IFN   CPM   
                    RAWK:     EQU   KEY   
04E6                          ENDIF      
04E6                             ; pollk: the break check (see rpushd).
04E6   CD 50 05     POLLK:    CALL   rawk   
04E9   C8                     RZ      ; no key
04EA   32 7A 0A               STA   KEYBUF   ; held for the next "?"
04ED   FE 03        PK1:      CPI   3   ; (getk joins here)
04EF   C0                     RNZ      
04F0                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
04F0                             ; the program has turned it off, wait about 250 ms for one more key: a
04F0                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
04F0                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
04F0   3A 7B 0A     CTLC:     LDA   BRKOFF   
04F3   B7                     ORA   A   
04F4   CA 92 05               JZ   brk   
04F7   D5                     PUSH   D   
04F8   11 E8 03               LXI   D,250*MSLOOP   
04FB   CD 50 05     CT1:      CALL   rawk   
04FE   C2 07 05               JNZ   ct2   
0501   1B                     DCX   D   
0502   7A                     MOV   A,D   
0503   B3                     ORA   E   
0504   C2 FB 04               JNZ   ct1   
0507   D1           CT2:      POP   D   ; A = the second key, or 0 if none came
0508   FE 03                  CPI   3   
050A   CA 92 05               JZ   brk   
050D   B7                     ORA   A   
050E   CA 14 05               JZ   ct3   
0511   32 7A 0A               STA   KEYBUF   
0514   3E 03        CT3:      MVI   A,3   
0516   B7                     ORA   A   
0517   C9                     RET      
0518                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
0518   E5           GETK:     PUSH   H   ; a held key goes first, and is taken out of
0519   21 7A 0A               LXI   H,KEYBUF   ;   the buffer
051C   7E                     MOV   A,M   
051D   36 00                  MVI   M,0   
051F   E1                     POP   H   
0520   B7                     ORA   A   
0521   C0                     RNZ      
0522   CD 50 05               CALL   rawk   
0525   C8                     RZ      
0526   C3 ED 04               JMP   pk1   ; Ctrl-C? If not, that is the key
0529                          IF   1-CHECKED   
                    BRK:      EQU   endprog   ; the unchecked build stops without a word;
0529                          ENDIF      
0529                          IF   CHECKED   
0529                BRK:      EQU   e_break   ;   the checked build reports B
0529                          ENDIF      
0529                          IF   CPM   
0529                             ; (In a CP/M build the letters and digits are here, out of the way of the
0529                             ; handlers, which must fit in the image's first two pages. The same code as
0529                             ; in the generic build.)
0529                             ; ---- the letters and digits --------------------------------------------------
0529                             ; a-z: push the cell's address (the cell is the variable)
0529                          ENDIF      
0529                          IF   CPM*(1-SBASEU)   
0529   E5           LOWER:    PUSH   H   
052A   87                     ADD   A   
052B   6F                     MOV   L,A   
052C   26 0A                  MVI   H,LETPAGE   
052E                          ;*Macro unroll:  NEXT
052E                          DS   (1-CPM)*(1-FAST),0F7h   
052E   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
052F   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
0530   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
0531                          ENDIF      
0531                          IF   CPM   
0531                             ; A-Z: call the word. The return address (the IP after the letter) goes on
0531                             ; the return stack, and the IP becomes the address in the letter's cell.
0531   E5           UPPER:    PUSH   H   ; keep TOS: rpushd pops it back
0532   87                     ADD   A   
0533   6F                     MOV   L,A   
0534   26 0A                  MVI   H,LETPAGE   ; HL -> cell
0536   50                     MOV   D,B   
0537   59                     MOV   E,C   ; DE = the return address
0538   4E                     MOV   C,M   
0539   23                     INX   H   
053A   46                     MOV   B,M   ; IP = the word's body, and fall into rpushd
053B                             ; rpushd: push DE on the return stack, then pop TOS off the data stack and
053B                             ; go on. Every push of the return stack ends here: for a word call the cell
053B                             ; popped is the TOS that upper parked; for "(" and "{" it is the cell under
053B                             ; the one that was used up.
053B                             ; 
053B                             ; The break key is looked at here, so at every word call and loop-back (and
053B                             ; block entry and "{"), but only one time in 256: BRKCNT counts them. Reading
053B                             ; the keyboard can be slow (it is a BDOS call under CP/M).
053B   2A 34 0A     RPUSHD:   LHLD   RSP   
053E   2B                     DCX   H   
053F   72                     MOV   M,D   
0540   2B                     DCX   H   
0541   73                     MOV   M,E   
0542   22 34 0A               SHLD   RSP   
0545   21 36 0A               LXI   H,BRKCNT   
0548   35                     DCR   M   
0549   E1                     POP   H   ; (keeps the flags)
054A   CC E6 04               CZ   pollk   
054D                          ;*Macro unroll:  NEXT
054D                          DS   (1-CPM)*(1-FAST),0F7h   
054D   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
054E   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
054F   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
0550   3E FF        RAWK:     MVI   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
0552                             ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
0552                             ; printing and could swallow a key that BDOS 6 then never sees.
0552   C5           PUTC:     PUSH   B   
0553   D5                     PUSH   D   
0554   E5                     PUSH   H   
0555   5F                     MOV   E,A   
0556   0E 06                  MVI   C,6   
0558   CD 05 00               CALL   BDOS   
055B   E1                     POP   H   
055C   D1                     POP   D   
055D   C1                     POP   B   
055E   B7                     ORA   A   ; (for getk)
055F   C9                     RET      
0560                          ENDIF      
0560                             ; =============================================================================
0560                             ;  Checked build: the checks and the error report
0560                             ; =============================================================================
0560                          IF   CHECKED   
0560                             ; chkhp: HL = the new heap top, DE = the count, the carry is from adding
0560                             ; it, and the old top is on the stack under the return address. Stop if the
0560                             ; new top is not below the limit page, or is below the program's end.
0560                CHKHP:       
0560                          ENDIF      
0560                          IF   CHECKED*CPM   
0560                             ; With this much room a top that wrapped round can land back in
0560                             ; range, so the add is tested too: growing must not carry, and
0560                             ; releasing must.
0560   7A                     MOV   A,D   
0561   1F                     RAR      ; the carry comes in above the count's sign:
0562   C6 40                  ADI   40h   ;   bit 7 = carry XOR sign
0564   87                     ADD   A   
0565   DA 79 05               JC   e_heap   
0568   3A 07 00               LDA   0007h   
056B   3D                     DCR   A   
056C   BC                     CMP   H   
056D   DA 79 05               JC   e_heap   
0570                          ENDIF      
0570                          IF   CHECKED*(1-CPM)   
                                 ; (Here the program's space is under 32K, so a top that wrapped
                                 ; round always falls outside it.)
                              MOV   A,H   
                              CPI   HEAPLIM   
                              JNC   e_heap   
0570                          ENDIF      
0570                          IF   CHECKED   
0570   EB                     XCHG      
0571   E5                     PUSH   H   ; the count
0572   2A 38 0A               LHLD   NPEND   
0575   19                     DAD   D   ; carry: at or above the program's end
0576   E1                     POP   H   
0577   EB                     XCHG      
0578   D8                     RC      
0579   EB           E_HEAP:   XCHG      ; put the count back in TOS for the report,
057A   D1                     POP   D   ;   and drop the return address (errp drops
057B   3E 48                  MVI   A,"H"   ;   the old top)
057D   C3 29 06               JMP   errp   
0580                             ; chkst: stop unless HL is in the program's own space: from the letter page
0580                             ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
0580                             ; whatever lies above the limit are safe. Memory above the heap top but
0580                             ; below the limit is the program's own: Tiny BASIC keeps its lines there.
0580                             ; It is the page of HL + 1 that is tested, so that one test serves both
0580                             ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
0580                             ; Keeps HL and BC. It runs on into its own error entry.
0580   23           CHKST:    INX   H   
0581   7C                     MOV   A,H   
0582   2B                     DCX   H   
0583   FE 0A                  CPI   LETPAGE   
0585   DA 8F 05               JC   e_store   
0588                          ENDIF      
0588                          IF   CHECKED*(1-CPM)   
                              CPI   HEAPLIM   
                              RC      
0588                          ENDIF      
0588                          IF   CHECKED*CPM   
0588   5F                     MOV   E,A   
0589   3A 07 00               LDA   0007h   ; the BDOS page is the heap limit
058C   3D                     DCR   A   
058D   BB                     CMP   E   
058E   D0                     RNC      
058F                          ENDIF      
058F                          IF   CHECKED   
058F                             ; Two error entries for errors found inside a routine: the first hides the
058F                             ; second inside a 3-byte LXI D (the 11h); errp then drops the routine's
058F                             ; return address.
058F   3E 4F        E_STORE:   MVI   A,"O"   ; a store outside the program's space
0591   11                     DB   11h   
0592   3E 42        E_BREAK:   MVI   A,"B"   ; Ctrl-C (found inside pollk or getk)
0594   C3 29 06               JMP   errp   
0597                             ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
0597                             ; "$", and the error report's texts). A NUL first is an error: Q.
0597   7E           PRSTR:    MOV   A,M   
0598   23                     INX   H   
0599   FE 22                  CPI   22h   
059B   C8                     RZ      
059C   B7                     ORA   A   
059D   CA 11 06               JZ   e_dollar   
05A0   FE 2F                  CPI   "/"   
05A2   C2 B3 05               JNZ   prs1   
05A5   7E                     MOV   A,M   
05A6   23                     INX   H   
05A7   FE 60                  CPI   60h   
05A9   DA B1 05               JC   prs0   
05AC   FE 7F                  CPI   7Fh   
05AE   DA F2 03               JC   pesc   
05B1   E6 BF        PRS0:     ANI   0BFh   
05B3                          ;*Macro unroll: prs1:   PUTA
05B3                PRS1:     DS   1-CPM,0EFh   
05B3   CD                     DS   CPM,0CDh   
05B4   52                     DS   CPM,APUT&0FFh   
05B5   05                     DS   CPM,APUT/256   
05B6   C3 97 05               JMP   prstr   
05B9                PRLOOP:   EQU   prstr   ; (where the escapes go back to)
05B9                PRAGAIN:   EQU   hp1   ; (and where /~ goes back to)
05B9                             ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
05B9                             ; pnl: the same, on a new line.
05B9   3E 0D        PNL:      MVI   A,13   
05BB                          ;*Macro unroll:  PUTA
05BB                          DS   1-CPM,0EFh   
05BB   CD                     DS   CPM,0CDh   
05BC   52                     DS   CPM,APUT&0FFh   
05BD   05                     DS   CPM,APUT/256   
05BE   3E 0A                  MVI   A,10   
05C0                          ;*Macro unroll:  PUTA
05C0                          DS   1-CPM,0EFh   
05C0   CD                     DS   CPM,0CDh   
05C1   52                     DS   CPM,APUT&0FFh   
05C2   05                     DS   CPM,APUT/256   
05C3   E3           PMSG:     XTHL      
05C4   CD 97 05               CALL   prstr   
05C7   E3                     XTHL      
05C8   C9                     RET      
05C9                             ; chkstk: both stacks are checked once per character, not in every handler.
05C9                             ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
05C9                             ; the constant carries if it is above (cells were popped that were never
05C9                             ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
05C9                             ; a character late at most: the bytes above DSTOP and the guard band below
05C9                             ; the page take what happens meanwhile.
05C9   EB           CHKSTK:   XCHG      ; DE = TOS (HL is needed for the pointers)
05CA   21 05 F6               LXI   H,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
05CD   39                     DAD   SP   
05CE   DA F8 05               JC   e_under   
05D1   24                     INR   H   
05D2   C2 F2 05               JNZ   e_over   
05D5   2A 34 0A               LHLD   RSP   ; the return stack: in its page (or it has
05D8   7C                     MOV   A,H   ;   overflowed), and not above its empty
05D9   FE 08                  CPI   RSPAGE   ;   position (an underflow stays inside the
05DB   C2 EF 05               JNZ   e_rover   ;   page, in the guard band)
05DE   7D                     MOV   A,L   
05DF   FE E1                  CPI   RSTOP&0FFh+1   
05E1   D2 E6 05               JNC   e_runder   
05E4   EB                     XCHG      ; TOS back
05E5   C9                     RET      
05E6   21 E0 08     E_RUNDER:   LXI   H,RSTOP   ; return stack underflow: it counts as empty
05E9   22 34 0A               SHLD   RSP   
05EC   3E 72                  MVI   A,"r"   
05EE   21                     DB   21h   ; (LXI H hides the next entry; HL is free)
05EF   3E 52        E_ROVER:   MVI   A,"R"   ; return stack overflow
05F1   21                     DB   21h   
05F2   3E 53        E_OVER:   MVI   A,"S"   ; data stack overflow
05F4   EB                     XCHG      ; TOS back
05F5   C3 29 06               JMP   errp   
05F8   31 FC 09     E_UNDER:   LXI   SP,DSTOP   ; data stack underflow: it counts as empty
05FB   3E 73                  MVI   A,"s"   
05FD   C3 2A 06               JMP   error   
0600                             ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
0600                             ; was never defined still holds 0000h, and the byte there is a JMP, C3h, in
0600                             ; every build: if the IP is in page zero, this was a call of an undefined
0600                             ; word. The call is undone, so the place is the call itself.
0600   04           E_HI:     INR   B   
0601   05                     DCR   B   
0602   C2 20 06               JNZ   e_resv   
0605   E5                     PUSH   H   
0606                          ;*Macro unroll:  POPR
0606                          DS   1-CPM,0CFh   
0606   CD                     DS   CPM,0CDh   
0607   0C                     DS   CPM,AROP&0FFh   
0608   01                     DS   CPM,AROP/256   
0609   44                     MOV   B,H   
060A   4D                     MOV   C,L   
060B   E1                     POP   H   
060C   3E 55                  MVI   A,"U"   
060E   C3 2A 06               JMP   error   
0611                             ; e_dollar: "$" ran into a NUL (in prstr): Q, with the string's address
0611                             ; back in TOS. prstr"s return address goes first. But if "$' had no
0611                             ; address at all (the stack was empty), it is s, found now: chkstk, called
0611                             ; one cell up, sees the stack past its empty place then.
0611   D1           E_DOLLAR:   POP   D   
0612   E1                     POP   H   
0613   CD C9 05               CALL   chkstk   
0616   E5                     PUSH   H   
0617   2A 3A 0A               LHLD   PSAVE   
061A   11                     DB   11h   ; (LXI D hides e_quote's first two bytes)
061B                             ; Error entries. Each loads its letter and then hides the next entry inside
061B                             ; a 3-byte LXI D (the 11h), so they all fall through to `error`.
061B   44           E_QUOTE:   MOV   B,H   ; an unclosed string: HL is its address, one
061C   4D                     MOV   C,L   ;   past the opening quote, which is the place
061D   3E 51                  MVI   A,"Q"   
061F   11                     DB   11h   
0620   3E 58        E_RESV:   MVI   A,"X"   ; a reserved byte outside a string
0622   11                     DB   11h   
0623   3E 5A        E_ZERO:   MVI   A,"Z"   ; dividing by zero
0625   11                     DB   11h   
0626   3E 57        E_BRACK:   MVI   A,"W"   ; bad character after [
0628   FE                     DB   0FEh   ; (CPI hides the one byte of errp)
0629                             ; errp: an error found inside a routine: drop its return address first.
0629   D1           ERRP:     POP   D   
062A                             ; error: the report, then the end. A = the letter, BC = one past the place,
062A                             ; HL = TOS, and both stacks as the report is to show them:
062A                             ; 
062A                             ;   Err X @ line,col
062A                             ;   D:n: the top 8 cells at most, bottom to top
062A                             ;   R:n
062A   E5           ERROR:    PUSH   H   ; now the whole data stack is in memory
062B   5F                     MOV   E,A   
062C   CD B9 05               CALL   pnl   
062F   45 72 72 20 22         DB   "Err ",22h   
0634   7B                     MOV   A,E   
0635                          ;*Macro unroll:  PUTA
0635                          DS   1-CPM,0EFh   
0635   CD                     DS   CPM,0CDh   
0636   52                     DS   CPM,APUT&0FFh   
0637   05                     DS   CPM,APUT/256   
0638   CD C3 05               CALL   pmsg   
063B   20 40 20 22            DB   " @ ",22h   
063F   0B                     DCX   B   ; BC = the place
0640                             ; The line and column. A place below the program is in the line
0640                             ; buffer: line 0. Otherwise count the LFs from the program's start;
0640                             ; DE = the line's number, HL = where it starts.
0640   21 80 0A               LXI   H,LINEBUF   
0643   11 00 00               LXI   D,0   
0646   78                     MOV   A,B   
0647   FE 0B                  CPI   PROG/256   
0649   DA 63 06               JC   er3   
064C   24                     INR   H   
064D   6B                     MOV   L,E   ; HL = PROG
064E   13           ER1:      INX   D   ; a new line starts at HL
064F   E5                     PUSH   H   
0650   7D           ER2:      MOV   A,L   
0651   91                     SUB   C   
0652   7C                     MOV   A,H   
0653   98                     SBB   B   
0654   D2 62 06               JNC   er2x   ; reached the place
0657   7E                     MOV   A,M   
0658   23                     INX   H   
0659   FE 0A                  CPI   10   
065B   C2 50 06               JNZ   er2   
065E   F1                     POP   PSW   
065F   C3 4E 06               JMP   er1   
0662   E1           ER2X:     POP   H   
0663   C5           ER3:      PUSH   B   
0664   E5                     PUSH   H   
0665   EB                     XCHG      
0666   CD DE 03               CALL   pdec   ; the line
0669   3E 2C                  MVI   A,","   
066B                          ;*Macro unroll:  PUTA
066B                          DS   1-CPM,0EFh   
066B   CD                     DS   CPM,0CDh   
066C   52                     DS   CPM,APUT&0FFh   
066D   05                     DS   CPM,APUT/256   
066E   D1                     POP   D   
066F   E1                     POP   H   
0670   CD E1 06               CALL   sub16   
0673   23                     INX   H   
0674   CD DE 03               CALL   pdec   ; the column
0677   CD B9 05               CALL   pnl   
067A   44 3A 22               DB   "D:",22h   
067D   21 06 F6               LXI   H,(2-DSTOP)&0FFFFh   ; SP - (DSTOP-2) is minus twice the depth
0680   39                     DAD   SP   ;   (the cell at DSTOP-2 was pushed with the
0681                          ;*Macro unroll:  NEGH                    ;   first value and holds nothing)
0681                          DS   1-CPM,0E7h   ;   first value and holds nothing)
0681   CD                     DS   CPM,0CDh   
0682   27                     DS   CPM,ANEG&0FFh   
0683   01                     DS   CPM,ANEG/256   
0684   7C                     MOV   A,H   
0685   CD D5 06               CALL   phal2   ; the depth
0688   3E 3A                  MVI   A,":"   
068A                          ;*Macro unroll:  PUTA
068A                          DS   1-CPM,0EFh   
068A   CD                     DS   CPM,0CDh   
068B   52                     DS   CPM,APUT&0FFh   
068C   05                     DS   CPM,APUT/256   
068D   79                     MOV   A,C   
068E   FE 09                  CPI   9   
0690   DA 9D 06               JC   er6   
0693   CD C3 05               CALL   pmsg   
0696   20 2E 2E 2E 22         DB   " ...",22h   
069B   0E 08                  MVI   C,8   
069D   26 00        ER6:      MVI   H,0   ; C = the number of cells to show
069F   69                     MOV   L,C   
06A0   29                     DAD   H   
06A1   39                     DAD   SP   ; HL -> just above the deepest of them
06A2   0C                     INR   C   
06A3   0D           ER7:      DCR   C   
06A4   CA BB 06               JZ   er8   
06A7   2B                     DCX   H   
06A8   56                     MOV   D,M   
06A9   2B                     DCX   H   
06AA   5E                     MOV   E,M   
06AB   E5                     PUSH   H   
06AC   C5                     PUSH   B   
06AD   3E 20                  MVI   A," "   
06AF                          ;*Macro unroll:  PUTA
06AF                          DS   1-CPM,0EFh   
06AF   CD                     DS   CPM,0CDh   
06B0   52                     DS   CPM,APUT&0FFh   
06B1   05                     DS   CPM,APUT/256   
06B2   EB                     XCHG      
06B3   CD D1 03               CALL   psgn   
06B6   C1                     POP   B   
06B7   E1                     POP   H   
06B8   C3 A3 06               JMP   er7   
06BB   CD B9 05     ER8:      CALL   pnl   
06BE   52 3A 22               DB   "R:",22h   
06C1   2A 34 0A               LHLD   RSP   
06C4   EB                     XCHG      
06C5   21 E0 08               LXI   H,RSTOP   
06C8   CD D2 06               CALL   phalf   
06CB   CD B9 05               CALL   pnl   
06CE   22                     DB   22h   
06CF   C3 85 01               JMP   endprog   
06D2                             ; phalf: print half of HL - DE, and leave it in BC
06D2   CD E1 06     PHALF:    CALL   sub16   
06D5   B7           PHAL2:    ORA   A   ; (A = H; this clears the carry)
06D6   1F                     RAR      
06D7   67                     MOV   H,A   
06D8   7D                     MOV   A,L   
06D9   1F                     RAR      
06DA   6F                     MOV   L,A   
06DB   E5                     PUSH   H   
06DC   CD DE 03               CALL   pdec   
06DF   C1                     POP   B   
06E0   C9                     RET      
