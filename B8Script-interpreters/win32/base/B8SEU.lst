  2050                              <1> ; =============================================================================
  2051                              <1> ;  The fast build (SPEED = 2)
  2052                              <1> ;
  2053                              <1> ;  The inner loop is a table of 256 handlers, one per character, and the
  2054                              <1> ;  dispatcher (NEXTF: MOVZX EAX,BYTE [ESI] / INC ESI / JMP [dtab+EAX*4]) is
  2055                              <1> ;  `next` and is inline at the end of the fast build's own handlers. Those
  2056                              <1> ;  are: one per letter and digit, which knows its cell or its value, and the
  2057                              <1> ;  commonest punctuation (fs_). The rest of the table is the regular
  2058                              <1> ;  handlers, which end with JMP EBP, into `next`.
  2059                              <1> ;
  2060                              <1> ;  A digit's handler pushes its value; the character after it goes through
  2061                              <1> ;  dtabd, which is dtab but for the digits: those go on with the number
  2062                              <1> ;  (fdm). (In the checked build anything else in dtabd is fdx, which goes back
  2063                              <1> ;  through `next`, for its check of the stacks once the number is read.)
  2064                              <1> ; =============================================================================
  2065                              <1> %assign i 0
  2066                              <1> %rep 10
  2067                              <1> fd%[i]: push    ebx                     ; 0-9: a number starts
  2068                              <1>         mov     ebx,ARENA+i
  2069                              <1>         NEXTD
  2070                              <1> %assign i i+1
  2071                              <1> %endrep
  2072                              <1> fdm:    imul    bx,bx,10                ; another digit (EAX = it)
  2073                              <1>         sub     al,'0'
  2074                              <1>         add     bx,ax
  2075                              <1>         NEXTD
  2076                              <1> %if CHECKED
  2077                              <1> fdx:    dec     esi                     ; the number has ended: the character
  2078                              <1>         jmp     ebp                     ;   after it goes through next
  2079                              <1> %endif
  2080                              <1> 
  2081                              <1> ; A-Z: call the word. The return address goes on the return stack, the IP
  2082                              <1> ; becomes the word's body, and the break key is looked at as at rpush.
  2083                              <1> %assign i 0
  2084                              <1> %rep 26
  2085                              <1> fu%[i]: sub     edi,4
  2086                              <1>         mov     [edi],esi
  2087                              <1>         mov     si,[ARENA+LET+2*i]
  2088                              <1>         dec     byte [V(v_pcnt)]
  2089                              <1>         jz      fpoll
  2090                              <1>         NEXTF
  2091                              <1> %assign i i+1
  2092                              <1> %endrep
  2093                              <1> fpoll:  call    pollk                   ; (one time in 256)
  2094                              <1>         jmp     ebp
  2095                              <1> 
  2096                              <1> ; a-z: push the cell's address. In the unchecked build a variable followed
  2097                              <1> ; by '@' or '!' is fetched or stored in the same step.
  2098                              <1> %assign i 0
  2099                              <1> %rep 26
  2100                              <1> %if CHECKED
  2101                              <1> fv%[i]: push    ebx
  2102                              <1>         mov     ebx,ARENA+LET+40h+2*i
  2103                              <1>         NEXTF
  2104                              <1> %else
  2105                              <1> fv%[i]: cmp     byte [esi],'@'
  2106                              <1>         jne     .v1
  2107                              <1>         push    ebx                     ; x@
  2108                              <1>         mov     bx,[ARENA+LET+40h+2*i]
  2109                              <1>         inc     esi
  2110                              <1>         NEXTF
  2111                              <1> .v1:    cmp     byte [esi],'!'
  2112                              <1>         jne     .v2
  2113                              <1>         mov     [ARENA+LET+40h+2*i],bx  ; x!
  2114                              <1>         pop     ebx
  2115                              <1>         inc     esi
  2116                              <1>         NEXTF
  2117                              <1> .v2:    push    ebx
  2118                              <1>         mov     ebx,ARENA+LET+40h+2*i
  2119                              <1>         NEXTF
  2120                              <1> %endif
  2121                              <1> %assign i i+1
  2122                              <1> %endrep
  2123                              <1> 
  2124                              <1> ; The commonest punctuation, written for the fast build (as the regular
  2125                              <1> ; handlers, but with the dispatcher inline; and '%' without XCHG with
  2126                              <1> ; memory, which is locked, and slow).
  2127                              <1> fs_add: pop     edx                     ; +
  2128                              <1>         add     bx,dx
  2129                              <1>         NEXTF
  2130                              <1> fs_sub: mov     al,[esi]                ; -
  2131                              <1>         sub     al,'0'
  2132                              <1>         cmp     al,10
  2133                              <1>         jb      negnum                  ; (a negative number)
  2134                              <1>         pop     edx
  2135                              <1>         sub     dx,bx
  2136                              <1>         mov     bx,dx
  2137                              <1>         NEXTF
  2138                              <1> fs_mul: pop     edx                     ; *
  2139                              <1>         imul    bx,dx
  2140                              <1>         NEXTF
  2141                              <1> %undef  NEXTJ
  2142                              <1> %define NEXTJ   NEXTF
  2143                              <1> fs_div: DIVCODE                         ; /
  2144                              <1> %undef  NEXTJ
  2145                              <1> %define NEXTJ   jmp ebp
  2146                              <1> fs_and: pop     edx                     ; &
  2147                              <1>         and     bx,dx
  2148                              <1>         NEXTF
  2149                              <1> fs_or:  pop     edx                     ; |
  2150                              <1>         or      bx,dx
  2151                              <1>         NEXTF
  2152                              <1> fs_xor: pop     edx                     ; ^
  2153                              <1>         xor     bx,dx
  2154                              <1>         NEXTF
  2155                              <1> fs_not: not     bx                      ; ~
  2156                              <1>         NEXTF
  2157                              <1> fs_lt:  pop     edx                     ; <  (DX = a, BX = b: carry if a < b)
  2158                              <1>         xor     dh,80h
  2159                              <1>         xor     bh,80h
  2160                              <1>         cmp     dx,bx
  2161                              <1>         sbb     bx,bx
  2162                              <1>         NEXTF
  2163                              <1> fs_gt:  pop     edx                     ; >  (carry if b < a)
  2164                              <1>         xor     dh,80h
  2165                              <1>         xor     bh,80h
  2166                              <1>         cmp     bx,dx
  2167                              <1>         sbb     bx,bx
  2168                              <1>         NEXTF
  2169                              <1> fs_eq:  pop     edx                     ; =
  2170                              <1>         sub     bx,dx
  2171                              <1>         cmp     bx,1
  2172                              <1>         sbb     bx,bx
  2173                              <1>         NEXTF
  2174                              <1> fs_dup: push    ebx                     ; :
  2175                              <1>         NEXTF
  2176                              <1> fs_drop:pop     ebx                     ; ;
  2177                              <1>         NEXTF
  2178                              <1> fs_swap:pop     edx                     ; %
  2179                              <1>         push    ebx
  2180                              <1>         mov     ebx,edx
  2181                              <1>         NEXTF
  2182                              <1> fs_fet: mov     bx,[ebx]                ; @
  2183                              <1>         NEXTF
  2184                              <1> fs_cfet:mov     bl,[ebx]                ; ,
  2185                              <1>         mov     bh,0
  2186                              <1>         NEXTF
  2187                              <1> fs_store:                               ; !
  2188                              <1> %if CHECKED
  2189                              <1>         call    chkst2
  2190                              <1> %endif
  2191                              <1>         pop     edx
  2192                              <1>         mov     [ebx],dx
  2193                              <1>         pop     ebx
  2194                              <1>         NEXTF
  2195                              <1> fs_cstore:                              ; .
  2196                              <1> %if CHECKED
  2197                              <1>         call    chkst1
  2198                              <1> %endif
  2199                              <1>         pop     edx
  2200                              <1>         mov     [ebx],dl
  2201                              <1>         pop     ebx
  2202                              <1>         NEXTF
  2203                              <1> fs_open:test    bx,bx                   ; (
  2204                              <1>         pop     ebx
  2205                              <1>         jz      .op1
  2206                              <1>         sub     edi,4                   ; the block start
  2207                              <1>         mov     [edi],esi
  2208                              <1>         dec     byte [V(v_pcnt)]
  2209                              <1>         jz      fpoll
  2210                              <1>         NEXTF
  2211                              <1> .op1:   call    skip
  2212                              <1>         NEXTF
  2213                              <1> fs_close:test   bx,bx                   ; )
  2214                              <1>         pop     ebx
  2215                              <1>         jz      .cl1
  2216                              <1>         mov     esi,[edi]               ; the block start, read where it is
  2217                              <1>         dec     byte [V(v_pcnt)]
  2218                              <1>         jz      fpoll
  2219                              <1>         NEXTF
  2220                              <1> .cl1:   add     edi,4
  2221                              <1>         NEXTF
  2222                              <1> fs_ret: mov     esi,[edi]               ; ]
  2223                              <1>         add     edi,4
  2224                              <1>         NEXTF
  2225                              <1> fs_break:test   bx,bx                   ; backslash
  2226                              <1>         pop     ebx
  2227                              <1>         jz      .br2
  2228                              <1>         call    skip
  2229                              <1>         test    al,al                   ; ')': the block start goes; ']' returns
  2230                              <1>         jz      .br1
  2231                              <1>         mov     esi,[edi]
  2232                              <1> .br1:   add     edi,4
  2233                              <1> .br2:   NEXTF
  2234                              <1> fs_tor: sub     edi,4                   ; {
  2235                              <1>         mov     [edi],ebx
  2236                              <1>         pop     ebx
  2237                              <1>         dec     byte [V(v_pcnt)]
  2238                              <1>         jz      fpoll
  2239                              <1>         NEXTF
  2240                              <1> fs_fromr:push   ebx                     ; }
  2241                              <1>         mov     ebx,[edi]
  2242                              <1>         add     edi,4
  2243                              <1>         NEXTF
  2244                              <1> fign:   NEXTF                           ; control characters, space, DEL (and
  2245                              <1>                                         ;   80h-FFh unchecked): nothing
  2246                              <1> 
  2247                              <1> ; The tables. The punctuation's handlers, by character:
  2248                              <1> %define FP_33   fs_store                ; !
  2249                              <1> %define FP_34   h_str                   ; "
  2250                              <1> %define FP_35   h_num                   ; #
  2251                              <1> %define FP_36   h_print                 ; $
  2252                              <1> %define FP_37   fs_swap                 ; %
  2253                              <1> %define FP_38   fs_and                  ; &
  2254                              <1> %define FP_39   h_emit                  ; '
  2255                              <1> %define FP_40   fs_open                 ; (
  2256                              <1> %define FP_41   fs_close                ; )
  2257                              <1> %define FP_42   fs_mul                  ; *
  2258                              <1> %define FP_43   fs_add                  ; +
  2259                              <1> %define FP_44   fs_cfet                 ; ,
  2260                              <1> %define FP_45   fs_sub                  ; -
  2261                              <1> %define FP_46   fs_cstore               ; .
  2262                              <1> %define FP_47   fs_div                  ; /
  2263                              <1> %define FP_58   fs_dup                  ; :
  2264                              <1> %define FP_59   fs_drop                 ; ;
  2265                              <1> %define FP_60   fs_lt                   ; <
  2266                              <1> %define FP_61   fs_eq                   ; =
  2267                              <1> %define FP_62   fs_gt                   ; >
  2268                              <1> %define FP_63   h_key                   ; ?
  2269                              <1> %define FP_64   fs_fet                  ; @
  2270                              <1> %define FP_91   h_def                   ; [
  2271                              <1> %define FP_92   fs_break                ; backslash
  2272                              <1> %define FP_93   fs_ret                  ; ]
  2273                              <1> %define FP_94   fs_xor                  ; ^
  2274                              <1> %define FP_95   h_alloc                 ; _
  2275                              <1> %define FP_96   h_grave                 ; `
  2276                              <1> %define FP_123  fs_tor                  ; {
  2277                              <1> %define FP_124  fs_or                   ; |
  2278                              <1> %define FP_125  fs_fromr                ; }
  2279                              <1> %define FP_126  fs_not                  ; ~
  2280                              <1> ; DENT c, after: the entry for character c in dtab (after 0) or dtabd (1)
  2281                              <1> %macro  DENT 2
  2282                              <1>  %assign c %1
  2283                              <1>  %if c >= 30h && c <= 39h
  2284                              <1>   %if %2
  2285                              <1>         dd      fdm
  2286                              <1>   %else
  2287                              <1>    %assign d c-30h
  2288                              <1>         dd      fd%[d]
  2289                              <1>   %endif
  2290                              <1>  %elif %2 && CHECKED
  2291                              <1>         dd      fdx
  2292                              <1>  %elif c == 0
