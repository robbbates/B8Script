                    UW1:         
                    UV2:      DAD   H   
                              MOV   A,C   
                              RAL      
                              MOV   C,A   
                              MOV   A,B   
                              RAL      
                              MOV   B,A   ; BC = BC*2 + bit
                              MOV   A,C   
                              SUB   E   
                              MOV   A,B   
                              SBB   D   ; carry if BC < DE
                              JC   uw2   
                              MOV   B,A   
                              MOV   A,C   
                              SUB   E   
                              MOV   C,A   
                              INR   L   ; quotient bit
                    UW2:         
                    UV3:      DAD   H   
                              MOV   A,C   
                              RAL      
                              MOV   C,A   
                              MOV   A,B   
                              RAL      
                              MOV   B,A   ; BC = BC*2 + bit
                              MOV   A,C   
                              SUB   E   
                              MOV   A,B   
                              SBB   D   ; carry if BC < DE
                              JC   uw3   
                              MOV   B,A   
                              MOV   A,C   
                              SUB   E   
                              MOV   C,A   
                              INR   L   ; quotient bit
                    UW3:         
                    UV4:      DAD   H   
                              MOV   A,C   
                              RAL      
                              MOV   C,A   
                              MOV   A,B   
                              RAL      
                              MOV   B,A   ; BC = BC*2 + bit
                              MOV   A,C   
                              SUB   E   
                              MOV   A,B   
                              SBB   D   ; carry if BC < DE
                              JC   uw4   
                              MOV   B,A   
                              MOV   A,C   
                              SUB   E   
                              MOV   C,A   
                              INR   L   ; quotient bit
                    UW4:         
                    UV5:      DAD   H   
                              MOV   A,C   
                              RAL      
                              MOV   C,A   
                              MOV   A,B   
                              RAL      
                              MOV   B,A   ; BC = BC*2 + bit
                              MOV   A,C   
                              SUB   E   
                              MOV   A,B   
