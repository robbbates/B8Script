E313   10 AC E4     SL2:      CMPY   ,S   
E316   23 0B                  BLS   sl9   
E318   EC A3                  LDD   ,--Y   
E31A   36 06                  PSHU   D   
E31C   8D B0                  BSR   pmsg   
E31E   A0                     FCB   " "+80h   
E31F   8D 1D                  BSR   h_num   
E321   20 F0                  BRA   sl2   
