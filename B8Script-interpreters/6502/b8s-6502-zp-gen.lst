0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the 6502 (NMOS opcodes only), with the data stack
0000                             ;  in zero page
0000                             ;  Spec: docs/b8script.md (2026-11-23). -n? does no more editing than
0000                             ;        Backspace. Ctrl-C stops every build (see the console layer); the
0000                             ;        break-off cell is BRKOFF, $047B.
0000                             ; 
0000                             ;  This is the smaller of the two 6502 interpreters. b8s-6502.asm keeps the
0000                             ;  data stack in pages 2 and 3 (252 cells) and leaves zero page almost free;
0000                             ;  this one keeps it in zero page (112 cells), where the 6502's short
0000                             ;  addressing modes make nearly every handler smaller. The language is the
0000                             ;  same; the memory map and the machine-code contract differ.
0000                             ; 
0000                             ;  One switch, set in the EQU line below:
0000                             ;    CHECKED  0 = no checks: whatever the spec calls unsafe is not caught
0000                             ;             1 = a checked build, as in the spec's "Errors and checked
0000                             ;                 builds": at startup every word cell points at 0000h (see
0000                             ;                 e_undef) and the variables and the interpreter's cells are
0000                             ;                 0. It stops with S s R r (stack over/underflow), H (heap),
0000                             ;                 O (a store outside the program's space), U (undefined
0000                             ;                 word), Q (no closing quote), W (bad character after [), X
0000                             ;                 (a reserved byte), Z (divide by zero), N (brackets) or B
0000                             ;                 (Ctrl-C), printing the spec's four-line report:
0000                             ;                   Err Z @ 3,4
0000                             ;                   0/ "no"$
0000                             ;                   Stk 2: 5 0
0000                             ;                   Rtn 0
0000                             ;                 and then goes to EXIT.
0000                             ; 
0000                             ;  Assembler: asm80, C6502 mode.
0000                             ; =============================================================================
0000                CHECKED:   EQU   0   ; 1 = checked build
0000                ANSI:     EQU   1   ; 1 = the console codes send ANSI sequences;
0000                             ; 0 = they call CONAT, CONCLS, CONEOL, CONCUR
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Registers and zero page
0000                             ; 
0000                             ;    IP      zero-page pointer to the next program character (16 bits)
0000                             ;    X       the data-stack pointer. Every cell is two bytes in zero page, low
0000                             ;            byte first: the top cell (TOS) is 0,X and 1,X, the one under it
0000                             ;            (NOS) 2,X and 3,X. The stack grows down: a push is DEX DEX, a
0000                             ;            drop INX INX. A cell that holds an address is used where it is,
0000                             ;            with (0,X): nothing is copied to a pointer first.
0000                             ;    $FE,X   the two bytes under the top cell (zero-page indexing wraps, so
0000                             ;    $FF,X   this is -2,X and -1,X): free memory, used as scratch.
0000                             ;    S       the hardware stack is the RETURN stack: a word call or "(" pushes
0000                             ;            the reading position (high byte first, then low) and "]" or ")"
0000                             ;            pulls it. 100 entries (200 bytes) fit with room to spare.
0000                             ;    Y, A    scratch. Y is 0 after peek/getc.
0000                             ; 
0000                             ;  Dispatch: step is called with JSR, so a handler ends with a plain RTS and
0000                             ;  lands on "JMP next" in the loop. Handlers that use the return stack ( ( ) \
0000                             ;  ] 00bbIA== and word calls ) first pull the 2-byte JSR frame off (PLA PLA) and end
0000                             ;  with JMP next instead.
0000                             ; 
0000                             ;  PTAB holds one byte per punctuation character: the low byte of its
0000                             ;  handler's address, less 1 (the dispatcher pushes an address and "returns"
0000                             ;  to it). The high byte comes from the character: the handlers of the first
0000                             ;  N1 characters start in the image's first page, those of the characters from
0000                             ;  N1 up to N2 in its second, and the rest in its third. The layout below
0000                             ;  keeps to that, and testing/chktab6502.py checks it in every build.
0000                             ; 
0000                             ;  Every punctuation handler starts with the carry clear (the dispatcher
0000                             ;  leaves it so). Several of them count on that, where the comments say.
0000                             ; 
0000                             ;  Machine-code contract (the grave): the code at TOS is entered as a
0000                             ;  subroutine, by JMP (T0) with the loop's return address on the hardware
0000                             ;  stack, so it ends with RTS (60h, which the hex loader appends). On entry the
0000                             ;  address has been dropped and X is the data-stack pointer: TOS is 0,X (low)
0000                             ;  and 1,X (high), NOS is 2,X and 3,X. To push: DEX, DEX, then store at 0,X
0000                             ;  and 1,X. To drop: INX, INX. The code may change A and Y, and X as the
0000                             ;  stack pointer; it must keep IP ($00/$01) and leave the hardware stack
0000                             ;  balanced. Zero page $02, $03, $07 and $0A-$0D are free for its own use.
0000                             ; -----------------------------------------------------------------------------
0000                IP:       EQU   00h   ; 00-01 reading position
0000                T0:       EQU   04h   ; scratch
0000                T1:       EQU   05h   
0000                T2:       EQU   06h   
0000                D0:       EQU   08h   ; divisor (division, number printing)
0000                D1:       EQU   09h   
0000                          IF   CHECKED   
                    PLACE:    EQU   D0   ; 08-09 the address of the character being
                                 ;   run, for the error report. No handler
                                 ;   uses D0/D1 before it can stop.
                                 ; The error report runs after the program, so it may use the zero page that
                                 ; machine code has ($02, $03, $0A-$0D; but not $0A-$0D once it prints
                                 ; numbers, since a full stack and "#" reach down to them):
                    P:        EQU   02h   ; 02-03 the place, copied (D0/D1 go to "#")
                    LN:       EQU   0Ah   ; 0A-0B the line being reported
0000                          ENDIF      
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map
0000                             ; 
0000                             ;    0000-000F  the variables above, and scratch
0000                             ;    0010-00EF  the data stack: 112 cells. X = F0 when it is empty. (0E and
0000                             ;               0F are the scratch under the top cell when it is full.)
0000                             ;    0100-01FF  hardware stack = return stack, S starts at FF
0000                             ;    0400       LET  letter cells: A..Z at +00..+33, a..z at +40..+73 (a word
0000                             ;               cell is 64 bytes below its variable), heap pointer at +7C,
0000                             ;               the -n? line buffer at +80..+FF. The checked build's cells
0000                             ;               are in the gaps: RSV at +35, PEND at +38;
0000                             ;               and every build's: the countdown CDOWN at +79, KEYBUF (the
0000                             ;               held key) at +7A, BRKOFF (the break-off cell) at +7B.
0000                             ;    0500       PROG the program text, NUL-terminated; the heap follows
0000                             ;    E000       the interpreter (ROM)
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the page range LETPAGE..HEAPLIM-1.
0000                             ; -----------------------------------------------------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The Z flag must match A (it does
0000                             ;   if the routine ends with LDA / RTS).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                             ;   KEY and CONOUT must preserve X and Y.
0000                          IF   1-ANSI   
                                 ; With ANSI = 0 the console codes call these four instead of sending ANSI
                                 ; sequences. All must preserve X.
                    CONAT:    EQU   0FF0Ch   ; `@  cursor to row Y, column A, both from 0
                    CONCLS:   EQU   0FF0Fh   ; `^  clear the screen and home the cursor
                    CONEOL:   EQU   0FF12h   ; `_  clear from the cursor to the end of the line
                    CONCUR:   EQU   0FF15h   ; `?  cursor off if A = 0 (the Z flag is set
                                 ;     to match), on if not
0000                          ENDIF      
0000                DSE:      EQU   0F0h   ; X when the data stack is empty
0000                DSFULL:   EQU   10h   ; X when it is full
0000                LETPAGE:   EQU   04h   
0000                LET:      EQU   LETPAGE*256   
0000                PROG:     EQU   0500h   ; where the loader puts the program text
0000                PROG1:    EQU   PROG+1   
0000                HEAPLIM:   EQU   0E0h   ; the heap must stay below E000h (a page)
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer (the heap top)
0000                KEYBUF:   EQU   LET+7Ah   ; a key held back by the break check (0: none)
0000                BRKOFF:   EQU   LET+7Bh   ; the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                SEED:     EQU   LET+76h   ; the random seed: the cell whose address `.
0000                             ;   gives. Nothing sets it at the start but
0000                             ;   the checked build's clearing
0000                CDOWN:    EQU   LET+79h   ; the break check's countdown (see pnext)
0000                RSV:      EQU   LET+35h   ; checked: S as it was before this character
0000                PEND:     EQU   LET+38h   ; checked: the program's end, where the heap
0000                             ;   starts: it may not be released below it
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSLIM:    EQU   20h   ; lowest S allowed (checked build)
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms; tune it
0000                             ;   (each pass calls KEY once; the wait for a
0000                             ;   second Ctrl-C uses it too: 250 ms)
0000                CWAIT:    EQU   250*MSLOOP/256   ; (that wait, in 256s)
0000                BASE:     EQU   0E000h   ; where the image starts: a multiple of 512
0000                HALFPG:   EQU   BASE/512   ; (the dispatcher doubles this to get a page)
0000                N1:       EQU   8   ; ! " # $ % & ' (  start in the first page,
0000                N2:       EQU   21   ; ) * + , - . / : ; < = > ?  in the second,
0000                             ; @ [ \ ] ^ _ ` 00bbIHwg ~  in the third
0000                             ; udiv: unsigned TOS / D (D <= 8000h). TOS becomes the quotient; the
0000                             ; remainder is left in the scratch under it, at $FE,X and $FF,X.
0000                             ; Dividing by 2 is one shift (the spec wants that fast).
0000                             ; (A macro, from when the two builds needed it in different places.)
0000                .macro UDIV,
0000                             ; 
0000                udiv:   LDA     #0
0000                 STA     0FEh,X
0000                 STA     0FFh,X
0000                 LDA     D0
0000                 EOR     #2
0000                 ORA     D1
0000                 BNE     ud0
0000                 LSR     1,X
0000                 ROR     0,X             ; the quotient
0000                 ROL     0FEh,X          ; the remainder: the bit that fell out
0000                 RTS
0000                ud0:    LDY     #16
0000                ud1:    ASL     0,X
0000                 ROL     1,X
0000                 ROL     0FEh,X
0000                 ROL     0FFh,X
0000                 SEC
0000                 LDA     0FEh,X
0000                 SBC     D0
0000                 STA     T0
0000                 LDA     0FFh,X
0000                 SBC     D1
0000                 BCC     ud2
0000                 STA     0FFh,X
0000                 LDA     T0
0000                 STA     0FEh,X
0000                 INC     0,X             ; the quotient bit (bit 0 is free)
0000                ud2:    DEY
0000                 BNE     ud1
0000                 RTS
0000                .endm
0000                 
E000                          .ORG   BASE   
E000                             ; =============================================================================
E000                             ;  Page 1 of 3. Startup: find the NUL, the heap starts after it
E000                             ; =============================================================================
E000   A2 FF        START:    LDX   #0FFh   
E002   9A                     TXS      ; return stack empty
E003                          IF   CHECKED   
                                 ; The first half of the letter page is zeroed: every variable, every
                                 ; cell of the interpreter's own (no key held back), and every word
                                 ; cell, which then points at 0000h: calling an undefined word stops
                                 ; with U (see e_undef).
                              INX      
                              TXA      ; A = 0
                              LDY   #7Fh   
                    STZ:      STA   LET,Y   
                              DEY      
                              BPL   stz   
E003                          ENDIF      
E003   20 59 E5               JSR   rstip   
E006   20 48 E5     ST1:      JSR   getc   
E009   D0 FB                  BNE   st1   ; IP ends just past the NUL
E00B                          IF   1-CHECKED   
E00B   8D 7A 04               STA   KEYBUF   ; (A = 0) no key held, the break key on
E00E   8D 7B 04               STA   BRKOFF   
E011                          ENDIF      
E011   A5 00                  LDA   IP   
E013   8D 7C 04               STA   HEAP   
E016                          IF   CHECKED   
                              STA   PEND   
E016                          ENDIF      
E016   A5 01                  LDA   IP+1   
E018   8D 7D 04               STA   HEAP+1   
E01B                          IF   CHECKED   
                              STA   PEND+1   
E01B                          ENDIF      
E01B   20 59 E5               JSR   rstip   
E01E   A2 F0                  LDX   #DSE   
E020                             ; ---- the inner loop (the checked build's is further down, out of this page)
E020                          IF   1-CHECKED   
E020                             ; -----------------------------------------------------------------------------
E020                             ;  The break key. A running program reads the keyboard only through getk
E020                             ;  (for "?") and pnext (the break check), which between them give the break
E020                             ;  key its rules:
E020                             ;    - Ctrl-C (03h) stops the program: silently to EXIT in the unchecked
E020                             ;      build, with the report (B) in the checked one;
E020                             ;    - any other key that the break check reads is held in KEYBUF for the
E020                             ;      next "?", and a newer one takes its place;
E020                             ;    - "?" (getk) takes the held key first;
E020                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
E020                             ;      key like any other, but two of them within about 250 ms still stop it.
E020                             ;  KEY is the host's: a waiting key in A, or A = 0 with the zero flag set.
E020                             ; -----------------------------------------------------------------------------
E020                             ; pnext: the break check, then (falling through) next. A word call, a true
E020                             ; "(" and a true ")" end here, but the keyboard is looked at only once in 256
E020                             ; of them: CDOWN counts them down. A key found is held; a Ctrl-C goes on to ctlc. (Startup
E020                             ; falls in here too, which does no harm.)
E020   CE 79 04     PNEXT:    DEC   CDOWN   
E023   D0 0B                  BNE   next   
E025   20 06 FF               JSR   KEY   
E028   F0 06                  BEQ   next   ; no key
E02A   8D 7A 04               STA   KEYBUF   ; held for the next "?"
E02D   20 53 E4               JSR   chk3   ; (Ctrl-C: back only if the break key is off)
E030   20 7A E4     NEXT:     JSR   step   
E033   4C 30 E0               JMP   next   
E036                          ENDIF      
E036                          IF   CHECKED   
                              JMP   next   
E036                          ENDIF      
E036                             ; ---- handlers of ! " # $ % & ' ( : they must start in this page -------------
E036                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character
E036                             ; clears that character"s bit 6 (/M is CR, /` is space; "/" and ""' have no
E036                             ; bit 6, so // and /" give themselves).
E036                             ; The checked build walks a copy of TOS along the string, so that the address
E036                             ; is still there if it stops with Q on a NUL.
E036                H_PRINT:      
E036                          IF   CHECKED   
                              JSR   h_dup   ; the copy
                              JSR   pr0   
                              BNE   pdrop   ; always (X is never 0): drop the address
                    E_QPR:    INX      
                              INX      ; the copy goes: the address is TOS again
                    E_QUOTE:   LDA   #"Q"   ; $ or a string from 22h ran into the end
                              JMP   error   
                    PR0:         
E036                          ENDIF      
E036   20 8A E2               JSR   tosget   
E039   C9 22                  CMP   #22h   
E03B   F0 28                  BEQ   pdrop   
E03D                          IF   CHECKED   
                              TAY      ; (Y is free here)
                              BEQ   e_qpr   
E03D                          ENDIF      
E03D   C9 2F                  CMP   #"/"   
E03F   D0 05                  BNE   pr1   
E041   20 8A E2               JSR   tosget   
E044   29 BF                  AND   #0BFh   
E046   20 03 FF     PR1:      JSR   CONOUT   
E049                          IF   1-CHECKED   
E049   4C 36 E0               JMP   h_print   
E04C                          ENDIF      
E04C                          IF   CHECKED   
                              JMP   pr0   
E04C                          ENDIF      
E04C                             ; 22h pushes the address of the text after it and skips the string.
E04C   20 C3 E4     H_STR:    JSR   puship   
E04F                          IF   CHECKED   
                              JSR   skipstr   
                              BEQ   e_quote   ; it ran into the end: the place is the 22h
                              RTS      
E04F                          ENDIF      
E04F                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
E04F                             ; the next character, so "/"" does not end it.
E04F                             ; Unchecked, it returns with Z set and A = 22h, and it does not look for the
E04F                             ; end. Checked, it returns with Z clear and A = 11h, or with Z set if the
E04F                             ; text ended first (a NUL, also one just after "/").
E04F                          IF   1-CHECKED   
E04F   20 48 E5     SKIPSTR:   JSR   getc   
E052   C9 2F                  CMP   #"/"   
E054   F0 05                  BEQ   ss0   
E056   C9 22                  CMP   #22h   
E058   D0 F5                  BNE   skipstr   
E05A   60                     RTS      
E05B   20 4B E5     SS0:      JSR   incip   
E05E   D0 EF                  BNE   skipstr   ; A is "/" here
E060                          ENDIF      
E060                          IF   CHECKED   
                    SKIPSTR:   JSR   getc   
                              BEQ   ss9   ; the end
                              CMP   #"/"   
                              BNE   ss1   
                              JSR   getc   ; the escaped character
                              BNE   skipstr   
                    SS9:      RTS      ; the end, just after "/"
                    SS1:      CMP   #22h   
                              BNE   skipstr   
                              LSR      ; A = 11h, Z clear
                              RTS      
E060                          ENDIF      
E060   B5 00        H_EMIT:   LDA   0,X   ; "'"
E062   20 03 FF               JSR   CONOUT   
E065   E8           PDROP:    INX      ; a drop for this page's handlers
E066   E8                     INX      
E067   60                     RTS      
E068                             ; "#" prints TOS as a signed decimal number, with no space after it. The
E068                             ; digits are divided off and held on the hardware stack, ended by a 0. udiv
E068                             ; leaves each remainder in the scratch under the top cell.
E068   B5 01        H_NUM:    LDA   1,X   
E06A   10 08                  BPL   pn1   
E06C   A9 2D                  LDA   #"-"   
E06E   20 03 FF               JSR   CONOUT   
E071   20 08 E1               JSR   neg   
E074   A9 0A        PN1:      LDA   #10   
E076   85 08                  STA   D0   
E078   A9 00                  LDA   #0   
E07A   85 09                  STA   D1   
E07C   48                     PHA      ; the end marker
E07D   20 F2 E2     PN2:      JSR   udiv   
E080   B5 FE                  LDA   0FEh,X   
E082   09 30                  ORA   #"0"   
E084   48                     PHA      
E085   B5 00                  LDA   0,X   
E087   15 01                  ORA   1,X   
E089   D0 F2                  BNE   pn2   
E08B   68           PN3:      PLA      
E08C   F0 D7                  BEQ   pdrop   
E08E   20 03 FF               JSR   CONOUT   
E091   4C 8B E0               JMP   pn3   
E094                             ; "!" ( n addr -- ): the low byte, then "."s ending for the high byte.
E094   B5 02        H_STORE:   LDA   2,X   
E096                          IF   CHECKED   
                              JSR   chkst   
E096                          ENDIF      
E096   81 00                  STA   (0,X)   
E098   20 8C E2               JSR   inctos   
E09B   B5 03                  LDA   3,X   
E09D   4C 1F E1               JMP   st9   
E0A0   B5 00        H_SWAP:   LDA   0,X   ; "%"
E0A2   B4 02                  LDY   2,X   
E0A4   94 00                  STY   0,X   
E0A6   95 02                  STA   2,X   
E0A8   B5 01                  LDA   1,X   
E0AA   B4 03                  LDY   3,X   
E0AC   94 01                  STY   1,X   
E0AE   95 03                  STA   3,X   
E0B0   60                     RTS      
E0B1                             ; "&", and "|" and "^" further down: one byte of the result goes into NOS,
E0B1                             ; and X moves up one. Done twice, that is both bytes, and NOS has become TOS.
E0B1   20 B4 E0     H_AND:    JSR   an1   
E0B4   B5 00        AN1:      LDA   0,X   
E0B6   35 02                  AND   2,X   
E0B8   95 02                  STA   2,X   
E0BA   E8                     INX      
E0BB   60                     RTS      
E0BC                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
E0BC                             ; the matching ")".
E0BC   20 D3 E4     H_OPEN:   JSR   flag   ; (keeps the carry clear)
E0BF                          IF   1-CHECKED   
E0BF   F0 17                  BEQ   skip   
E0C1                          ENDIF      
E0C1                          IF   CHECKED   
                              BEQ   skpar   
E0C1                          ENDIF      
E0C1                             ; pushn: take the step frame off, push the reading position on the return
E0C1                             ; stack, and go on. With the carry set (a word call) the reading position
E0C1                             ; then becomes the address in the letter cell at LET,Y.
E0C1   68           PUSHN:    PLA      
E0C2   68                     PLA      ; drop the step frame
E0C3   A5 01                  LDA   IP+1   
E0C5   48                     PHA      
E0C6   A5 00                  LDA   IP   
E0C8   48                     PHA      
E0C9   90 0A                  BCC   nxt   
E0CB   B9 00 04               LDA   LET,Y   
E0CE   85 00                  STA   IP   
E0D0   B9 01 04               LDA   LET+1,Y   
E0D3   85 01                  STA   IP+1   
E0D5   4C 20 E0     NXT:      JMP   pnext   
E0D8                             ; ---- no handler starts between here and the next heading: these routines
E0D8                             ; ---- fill the space up to the page boundary and past it ---------------------
E0D8                             ; skip: read past text to the closer at this level, and return it in A.
E0D8                             ; Brackets of both kinds count together; strings are stepped over whole. A
E0D8                             ; NUL first ends the program. (The checked build's skip is further down.)
E0D8                          IF   1-CHECKED   
E0D8   A9 00        SKIP:     LDA   #0   
E0DA   85 06                  STA   T2   ; depth
E0DC   20 48 E5     SK1:      JSR   getc   
E0DF   F0 20                  BEQ   endprog   
E0E1   C9 22                  CMP   #22h   
E0E3   D0 03                  BNE   sk2   
E0E5   20 4F E0               JSR   skipstr   ; leaves A = 22h, which matches nothing below
E0E8   C9 28        SK2:      CMP   #"("   
E0EA   F0 11                  BEQ   sk3   
E0EC   C9 5B                  CMP   #"["   
E0EE   F0 0D                  BEQ   sk3   
E0F0   C9 29                  CMP   #")"   
E0F2   F0 04                  BEQ   sk4   
E0F4   C9 5D                  CMP   #"]"   
E0F6   D0 E4                  BNE   sk1   
E0F8   C6 06        SK4:      DEC   T2   
E0FA   10 E0                  BPL   sk1   
E0FC   60                     RTS      ; the closer at this level
E0FD   E6 06        SK3:      INC   T2   
E0FF   D0 DB                  BNE   sk1   
E101   4C 09 FF     ENDPROG:   JMP   EXIT   
E104                          ENDIF      
E104                          IF   CHECKED   
                                 ; A false ( skips: the wrong closer for it is ].
                    SKPAR:    LDA   #"]"   
                              JMP   skip   
E104                          ENDIF      
E104                             ; absv: TOS = |TOS|.  negm: TOS = -TOS if the N flag is set.
E104   B5 01        ABSV:     LDA   1,X   
E106   10 0D        NEGM:     BPL   ab9   
E108                             ; neg: TOS = -TOS
E108   38           NEG:      SEC      
E109   A9 00        NEG1:     LDA   #0   
E10B   F5 00                  SBC   0,X   
E10D   95 00                  STA   0,X   
E10F   A9 00                  LDA   #0   
E111   F5 01                  SBC   1,X   
E113   95 01                  STA   1,X   
E115   60           AB9:      RTS      
E116                             ; =============================================================================
E116                             ;  Page 2 of 3: handlers of ) * + , - . / : ; < = > ?
E116                             ; =============================================================================
E116   B5 00        H_DUP:    LDA   0,X   ; ":"
E118   B4 01                  LDY   1,X   
E11A   4C CC E4               JMP   pushay   
