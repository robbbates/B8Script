0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Spec: docs/b8script.md (2026-11-24).
0000                             ; 
0000                             ;  Four switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    EDITOR   1 = with the line editor built in (see the end of this file):
0000                             ;                 the spec's suggested standard. It goes with either setting
0000                             ;                 of the other two.
0000                             ;    CHECKED  0 = no checks (spec: the programmer is responsible)
0000                             ;             1 = starts with every variable at 0 and every word undefined,
0000                             ;                 and stops on every error in the spec's table (and Ctrl-C)
0000                             ;                 with a four-line report: the letter and the place as line
0000                             ;                 and column, the text there, and both stacks. See `error`.
0000                             ;    ANSI     what the console escapes of "$" (/00bbIC8= /| /` /~) do:
0000                             ;             1 = send ANSI (VT100) sequences through CONOUT
0000                             ;             0 = call the machine's own routines CONCLS, CONEOL, CONCUR and
0000                             ;                 CONAT (see the equates). The CP/M builds always send ANSI.
0000                             ; 
0000                             ;  In every build Ctrl-C stops a running program (an unchecked build stops
0000                             ;  without a word): see the console layer for the rules, the held key and
0000                             ;  the break-off cell.
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   1   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   1   ; 1 = checked build
0000                EDITOR:   EQU   1   ; 1 = with the line editor
0000                ANSI:     EQU   0   ; 1 = the console escapes send ANSI sequences
0000                ANS:      EQU   ANSI+CPM-ANSI*CPM   ; (CP/M: always ANSI)
0000                EDGEN:    EQU   EDITOR*(1-CPM)   ; (the generic build with the editor)
0000                             ; (IF takes any value but 0 as true, so
0000                             ;  IF CHECKED+EDITOR means "either")
0000                TABP0:    EQU   EDGEN*(1-CHECKED)   ; (the build with its table in page zero)
0000                PTLATE:   EQU   1-CPM*EDITOR*(1-CHECKED)   ; (1: the table goes after psgn and pdec,
0000                             ;   not before them: wherever it doesn't cross a
0000                             ;   page. chktab.py says if it does)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    HL'  return-stack pointer (the alternate HL). Entries are 2 bytes; the
0000                             ;         stack grows down. Only rpop and rpushn (and the checks) touch it.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  One-byte calls. The routines used most are reached with RST, one byte
0000                             ;  instead of three:
0000                             ; 
0000                             ;    RST 08h  rpop    pop the return stack into DE
0000                             ;    RST 18h  drop    drop TOS, then next character     (ends a handler)
0000                             ;    RST 20h  neg16   HL = -HL
0000                             ;    RST 28h  putc    print A
0000                             ;    RST 30h  next    next character                    (ends a handler)
0000                             ; 
0000                             ;  RST 18h and RST 30h never return: an RST is a CALL, so the first thing
0000                             ;  each of them does is POP DE to throw the return address away.
0000                             ; 
0000                             ;  The CP/M build can't own page zero, so the block from `vecs` to `vecend`
0000                             ;  (image addresses 0108h-0133h) is copied to 0008h-0033h when it starts. The
0000                             ;  code in that block is written to work at either place.
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (the top four bytes of the page are spare,
0000                             ;             so a full stack runs two bytes into the page below)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch, interpreter variables in the gaps, and the -n? line buffer
0000                             ;             at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack has a guard band: the data stack can
0000                             ;  overrun by a cell or two (and the calls made while it is full, the error
0000                             ;  report's included) into the top 32 bytes of the return-stack page, which
0000                             ;  are never used, and the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
0000                BDOS:     EQU   0005h   
0000                BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IF   CPM*(1-EDITOR)   
                    EXIT:     EQU   0000h   ; warm boot
0000                          ENDIF      
0000                          IFN   CPM   
                                 ; ---- generic machine: edit these to suit -----------------------------------
                    KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
                                 ;   waiting. The zero flag must match A
                                 ;   (end the routine with OR A / RET).
                    CONOUT:   EQU   0FF03h   ; print the character in A
                                 ;   KEY and CONOUT must preserve BC, DE, HL and HL'.
0000                          ENDIF      
0000                          IF   1-ANS   
                                 ; With ANSI = 0 the console escapes call these. All four must keep BC and
                                 ; HL', and all but CONAT also HL. They may change A, DE and the flags.
                    CONCLS:   EQU   0FF0Ch   ; /{  clear the screen, the cursor to the top left
                    CONEOL:   EQU   0FF0Fh   ; /}  clear from the cursor to the end of the line
                    CONCUR:   EQU   0FF12h   ; /| and /`  show the cursor if A is not 0, hide
                                 ;     it if A = 0
                    CONAT:    EQU   0FF15h   ; /~  the cursor to row HL, column DE, both
                                 ;     counted from 0. May change A, DE and HL
0000                          ENDIF      
0000                          IFN   CPM   
                    RSPAGE:   EQU   80h   ; 8000h return stack
                    DSPAGE:   EQU   81h   ; 8100h data stack
                    LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
                    PROG:     EQU   8300h   ; where the loader puts the program text
                    HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
                    BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)   
                    EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                          ENDIF      
0000                          IF   EDGEN   
                    LEAVE:    EQU   0FF09h   ; where the editor's ^X goes
0000                          ENDIF      
0000                          IF   EDITOR*CPM   
0000                LEAVE:    EQU   0000h   ; the editor's ^X: warm boot
0000                          ENDIF      
0000                          IF   EDITOR   
0000                EXIT:     EQU   edend   ; a program that ends goes back to the editor,
0000                SKEND:    EQU   skend   ;   also when it ends inside skip
0000                          ENDIF      
0000                          IF   1-EDITOR   
                    SKEND:    EQU   EXIT   
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine. (The wait
0000                             ; for a second Ctrl-C uses it too: 250 ms.)
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                             ;   around machine code (and in the checked
0000                             ;   build the address "$" prints from);
0000                NPEND:    EQU   LET+38h   ;   minus the address of the program's end
0000                             ;   (the heap"s first byte), for the checked "_';
0000                EDLN:     EQU   LET+3Ah   ;   the editor: the number of the line that ^E
0000                             ;   put in the input line (0: none)
0000                KEYBUF:   EQU   LET+7Ah   ; gap after z: a key read by the break check and
0000                             ;   held for the next "?" (0: none);
0000                BRKOFF:   EQU   LET+7Bh   ;   the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FCh   ; empty data stack. The four bytes above it
0000                             ; are spare: a character can pop two cells
0000                             ; too many before the checked build sees it,
0000                             ; and the next call must not land on the
0000                             ; letter cells.
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is the start of the .COM file, and 0108h-0133h is also copied to
0000                             ;  page zero (see the header).
0000                             ; =============================================================================
0100                          .ORG   BASE   
0100                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              XOR   A   ; 00  reset. (This byte, AFh, is also what an
0100                          ENDIF      ;     undefined word runs into: see e_hi.)
0100                          IF   1-EDGEN   
0100   31 FC 0A               LD   SP,DSTOP   ; 00  reset, or the start of the .COM file
0103                          ENDIF      
0103                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)   
                              LD   BC,PROG   ; 03  the IP
                              JR   st0   ; 06  (the rest of the startup is close by)
0103                          ENDIF      
0103                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              JR   init   ; 04  (the rest of the startup is close by)
                              DW   0   ; 06  spare
0103                          ENDIF      
0103                          IF   EDGEN   
                              XOR   A   ; 00  reset: no program yet. (This byte, AFh,
                              LD   (PROG),A   ;     is also what an undefined word runs
                              JP   init   ; 04  into in the checked build: see e_hi.)
                              NOP      ; 07  spare
0103                          ENDIF      
0103                          IF   CPM   
0103   C3 C4 08               JP   start   ; 03
0106   00 00                  DW   0   ; 06  spare
0108                          ENDIF      
0108                VECS:        
0108                             ; ---- RST 08h: rpop: pop the return stack into DE ---------------------------
0108   D9           RPOP:     EXX      ; 08
0109   5E                     LD   E,(HL)   
010A   23                     INC   HL   
010B   56                     LD   D,(HL)   
010C   23                     INC   HL   
010D   D5                     PUSH   DE   ; across to the main registers
010E   D9                     EXX      
010F   D1                     POP   DE   
0110   C9                     RET      ; 10  (so RST 10h is not used)
0111                             ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
0111   C6 21        CTL:      ADD   A,21h   ; 11  back to c; zero only for NUL
0113   20 1F                  JR   NZ,next0   ;     the rest are ignored
0115   C3 4C 06     ENDPROG:   JP   EXIT   ;     the program has ended
0118                             ; ---- RST 18h: drop TOS, then next ------------------------------------------
0118   D1           RST18:    POP   DE   ; 18  discard the RST's return address
0119   E1                     POP   HL   ;     new TOS = NOS
011A   18 15                  JR   nx   
011C   E5           H_FROMR:   PUSH   HL   ; 1C  "}" return stack to TOS
011D   CF                     RST   08h   
011E   EB                     EX   DE,HL   
011F   F7                     RST   30h   
0120                             ; ---- RST 20h: neg16: HL = -HL (keeps BC, DE) -------------------------------
0120   AF           NEG16:    XOR   A   ; 20
0121   95                     SUB   L   
0122   6F                     LD   L,A   
0123   9F                     SBC   A,A   
0124   94                     SUB   H   
0125   67                     LD   H,A   
0126   C9                     RET      
0127   00                     NOP      ; 27  spare
0128                             ; ---- RST 28h: putc: print A (keeps BC, DE, HL, HL') ------------------------
0128                RST28:       
0128                          IFN   CPM   
                    PUTC:     JP   CONOUT   ; 28
0128                          ENDIF      
0128                          IF   CPM   
0128   C3 B9 04               JP   putc   ; 28
012B                          ENDIF      
012B   E9           JPHL:     JP   (HL)   ; 2B  (for the machine-code call)
012C   E3           H_TOR:    EX   (SP),HL   ; 2C  "{" TOS to the return stack: the new TOS
012D   C3 BC 01               JP   rpushn   ;     comes up, the old one goes across
0130                             ; ---- RST 30h: next character -----------------------------------------------
0130   D1           RST30:    POP   DE   ; 30  discard the RST's return address
0131                NX:          
0131                          IF   CPM   
0131   C3 34 01               JP   next0   ; (this copy runs in page zero)
0134                          ENDIF      
0134                VECEND:      
0134                             ; =============================================================================
0134                             ;  The inner loop: read one character and sort it by range.
0134                             ; 
0134                             ;    00h          end of program
0134                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0134                             ;    30h-39h      digit: read a whole number
0134                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0134                             ;    61h-7Ah      a-z: push the address of that letter's cell
0134                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0134                             ; =============================================================================
0134                NEXT0:       
0134                          IF   CHECKED   
0134   CD D2 04               CALL   chkstk   ; both stacks are checked once per character
0137                          ENDIF      
0137   0A                     LD   A,(BC)   
0138   03                     INC   BC   
0139   D6 21                  SUB   21h   ; A = c - 21h
013B   38 D4                  JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
013D   FE 0F                  CP   0Fh   
013F   38 25                  JR   C,punct   ; 21h-2Fh: PTAB index 0-14
0141   D6 0F                  SUB   0Fh   ; A = c - 30h
0143   FE 0A                  CP   0Ah   
0145   38 5F                  JR   C,digit   ; 30h-39h
0147   FE 11                  CP   11h   
0149   38 19                  JR   C,p3a   ; 3Ah-40h
014B   D6 11                  SUB   11h   ; A = c - 41h
014D   FE 1A                  CP   1Ah   
014F   38 61                  JR   C,upper   ; 41h-5Ah: A = letter index 0-25
0151   FE 20                  CP   20h   
0153   38 0D                  JR   C,p5b   ; 5Bh-60h
0155   FE 3A                  CP   3Ah   
0157   38 53                  JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0159   FE 3E                  CP   3Eh   
015B                          IF   1-CHECKED   
                              JR   NC,next0   ; 7Fh-FFh: ignored
015B                          ENDIF      
015B                          IF   CHECKED   
015B   28 D7                  JR   Z,next0   ; 7Fh, DEL: ignored
015D   D2 FE 04               JP   NC,e_hi   ; 80h-FFh: reserved
0160                          ENDIF      
0160   D6 1A                  SUB   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
0162   D6 09        P5B:      SUB   9   ; 5Bh-60h: -4 in all, index 22-27
0164   C6 05        P3A:      ADD   A,5   ; 3Ah-40h: index 15-21
0166                .macro PTABLE,
0166                             ; 
0166                 DB      h_store & 0FFh  ; !
0166                 DB      h_str & 0FFh    ; "
0166                 DB      h_num & 0FFh    ; #
0166                 DB      h_print & 0FFh  ; $
0166                 DB      h_swap & 0FFh   ; %
0166                 DB      h_and & 0FFh    ; &
0166                 DB      h_emit & 0FFh   ; '
0166                 DB      h_open & 0FFh   ; (
0166                 DB      h_close & 0FFh  ; )
0166                 DB      h_mul & 0FFh    ; *
0166                 DB      h_add & 0FFh    ; +
0166                 DB      h_cfetch & 0FFh ; ,
0166                 DB      h_sub & 0FFh    ; -
0166                 DB      h_cstore & 0FFh ; .
0166                 DB      h_div & 0FFh    ; /
0166                 DB      h_dup & 0FFh    ; :
0166                 DB      h_drop & 0FFh   ; ;
0166                 DB      h_lt & 0FFh     ; <
0166                 DB      h_eq & 0FFh     ; =
0166                 DB      h_gt & 0FFh     ; >
0166                 DB      h_key & 0FFh    ; ?
0166                 DB      h_fetch & 0FFh  ; @
0166                 DB      h_def & 0FFh    ; [
0166                 DB      h_break & 0FFh  ; \
0166                 DB      h_ret & 0FFh    ; ]
0166                 DB      h_xor & 0FFh    ; ^
0166                 DB      h_alloc & 0FFh  ; _
0166                 DB      h_grave & 0FFh  ; `
0166                 DB      h_tor & 0FFh    ; {
0166                 DB      h_or & 0FFh     ; |
0166                 DB      h_fromr & 0FFh  ; }
0166                 DB      h_not & 0FFh    ; ~
0166                .endm
0166                 
0166                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
0166                             ; untouched, and A, DE free.
0166   C6 59        PUNCT:    ADD   A,PTAB & 0FFh   ; PTAB never crosses a page
0168   5F                     LD   E,A   
0169   16 04                  LD   D,PTAB / 256   ; (0 if the table is in page zero)
016B   FE 6F                  CP   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
016D   1A                     LD   A,(DE)   
016E   5F                     LD   E,A   ; the handler's low byte
016F                          IF   (1-CPM)*(1-TABP0)   
                              LD   D,0   
016F                          ENDIF      
016F                          IFN   CPM   
                              RL   D   ; its page: 0 + carry
016F                          ENDIF      
016F                          IF   CPM   
016F   16 01                  LD   D,1   
0171   30 01                  JR   NC,pu1   
0173   14                     INC   D   ; its page: 1 + carry
0174                PU1:         
0174                          ENDIF      
0174   D5                     PUSH   DE   ; jump to it; the stack is balanced again
0175   C9                     RET      ;   when the handler starts
0176                             ; The rest of the startup: here so that the generic reset code can reach it
0176                             ; with JR. st0: find the program's NUL; the heap starts after it.
0176                             ; (The editor build has its own copy of this, next to the editor.)
0176                             ; A checked build first clears the lower half of the letter page (A = 0):
0176                             ; every variable starts at 0, every word cell holds 0000h, the address an
0176                             ; undefined word is caught at (see e_hi), and no key is held back.
0176                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                    INIT:     LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
                              LD   BC,PROG   ; the IP
0176                          ENDIF      
0176                          IF   (1-CPM)*(1-EDITOR)   
                    ST0:      LD   H,B   
                              LD   L,C   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
0176                          ENDIF      
0176                          IF   1-EDITOR   
                    ST2:      LD   (HEAP),HL   
0176                          ENDIF      
0176                          IF   CHECKED*(1-EDITOR)   
                              RST   20h   ; minus the heap"s first address: "_' may not
                              LD   (NPEND),HL   ;   release below it
0176                          ENDIF      
0176                          IF   (1-CHECKED)*(1-EDITOR)*(1-CPM)   
                              LD   H,A   ; (A = 0) no key is held, and the break key
                              LD   L,A   ;   is on (the checked build has cleared
0176                          ENDIF      ;   these)
0176                          IF   (1-CHECKED)*(1-EDITOR)*CPM   
                              LD   HL,0   
0176                          ENDIF      
0176                          IF   (1-CHECKED)*(1-EDITOR)   
                              LD   (KEYBUF),HL   
0176                          ENDIF      
0176                          IF   1-EDITOR   
                              EXX      
                              LD   HL,RSTOP   ; the return stack is empty
                              EXX      
                              RST   30h   ; (its return address is thrown away)
0176                          ENDIF      
0176                             ; In the unchecked generic editor build the table is here, in the first
0176                             ; page, which saves loading D twice. (The other builds have no room for it
0176                             ; here: theirs is further down.)
0176                          IF   TABP0   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0176                          ENDIF      
0176                             ; =============================================================================
0176                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
0176                             ;  (00bbIGFuZCA= are up among the RST routines.) The machine-code call, exec,
0176                             ;  is here too: it belongs to "`" and makes the page come out right.
0176                             ; =============================================================================
0176   D1           H_XOR:    POP   DE   
0177   7C                     LD   A,H   
0178   AA                     XOR   D   
0179   67                     LD   H,A   
017A   7D                     LD   A,L   
017B   AB                     XOR   E   
017C   6F                     LD   L,A   
017D   F7                     RST   30h   
017E   D1           H_OR:     POP   DE   
017F   7C                     LD   A,H   
0180   B2                     OR   D   
0181   67                     LD   H,A   
0182   7D                     LD   A,L   
0183   B3                     OR   E   
0184   6F                     LD   L,A   
0185   F7                     RST   30h   
0186   E7           H_NOT:    RST   20h   ; ~x = -x - 1
0187   2B                     DEC   HL   
0188   F7                     RST   30h   
0189                             ; "_" ( n -- addr ): the heap pointer moves by n, a signed count (the add is
0189                             ; the same either way); TOS is the old pointer.
0189   ED 5B 7C 0B  H_ALLOC:   LD   DE,(HEAP)   
018D                          IF   CHECKED*CPM   
018D   7C                     LD   A,H   ; the count's sign, for chkhp
018E                          ENDIF      
018E   19                     ADD   HL,DE   ; the new top
018F                          IF   CHECKED   
018F   CD 08 05               CALL   chkhp   
0192                          ENDIF      
0192   22 7C 0B               LD   (HEAP),HL   
0195   EB                     EX   DE,HL   
0196   F7                     RST   30h   
0197   D9           EXEC:     EXX      
0198   22 34 0B               LD   (RSAVE),HL   ; machine code may change the alternates
019B   D9                     EXX      
019C   CD 2B 01               CALL   jphl   
019F   D9                     EXX      
01A0   2A 34 0B               LD   HL,(RSAVE)   
01A3   D9                     EXX      
01A4   E1                     POP   HL   
01A5   F7                     RST   30h   
01A6                             ; ---- the letters and digits (here, in the middle, so that the inner loop's
01A6                             ; ---- short jumps reach them, and the handlers after them reach rpushn) ------
01A6                             ; Digits: step back onto the first digit and read the whole number.
01A6   E5           DIGIT:    PUSH   HL   
01A7   0B                     DEC   BC   
01A8   CD C9 03               CALL   rdnum   
01AB   F7                     RST   30h   
01AC                             ; a-z: push the cell's address (the cell is the variable)
01AC   E5           LOWER:    PUSH   HL   
01AD   87                     ADD   A,A   
01AE   6F                     LD   L,A   
01AF   26 0B                  LD   H,LETPAGE   
01B1   F7                     RST   30h   
01B2                             ; A-Z: call the word. The return address (the IP after the letter) goes on
01B2                             ; the return stack, and the IP becomes the address in the letter's cell.
01B2   C5           UPPER:    PUSH   BC   ; the return address, for rpushn
01B3   EB                     EX   DE,HL   ; park TOS
01B4   87                     ADD   A,A   
01B5   6F                     LD   L,A   
01B6   26 0B                  LD   H,LETPAGE   ; HL -> cell
01B8   4E                     LD   C,(HL)   
01B9   2C                     INC   L   
01BA   46                     LD   B,(HL)   ; IP = the word's body
01BB   EB                     EX   DE,HL   ; TOS back, and fall into rpushn
01BC                             ; rpushn: move the top cell of the data stack (in memory) to the return
01BC                             ; stack, then next. Everything that pushes the return stack ends here.
01BC                             ; 
01BC                             ; The break key is looked at here, so at every word call and loop-back (and
01BC                             ; block entry and "{"), but only one time in 256: B', which nothing else
01BC                             ; uses, counts them. Reading the keyboard can be slow (it is a BDOS call
01BC                             ; under CP/M), and this way it costs a loop four bytes and 14 T-states.
01BC                             ; (DEC B, not DJNZ: its zero flag lasts through the EXX, so one EXX serves
01BC                             ; both ways out.)
01BC   D9           RPUSHN:   EXX      
01BD   D1                     POP   DE   
01BE   2B                     DEC   HL   
01BF   72                     LD   (HL),D   
01C0   2B                     DEC   HL   
01C1   73                     LD   (HL),E   
01C2   05                     DEC   B   
01C3   D9                     EXX      
01C4   CC 79 04               CALL   Z,pollk   
01C7   F7                     RST   30h   
01C8                             ; ---- machine code: the grave -----------------------------------------------
01C8                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
01C8                             ; are stored from addr until a non-hex character; then a RET (C9h) is
01C8                             ; written and its address is left. An odd last digit is consumed and dropped.
01C8                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
01C8                             ; code is entered by CALL with the data stack above the return address; it
01C8                             ; must keep BC, and on return the top cell becomes the new TOS.
01C8   CD 2D 04     H_GRAVE:   CALL   hexc   
01CB   30 CA                  JR   NC,exec   
01CD   77           HX1:      LD   (HL),A   ; the high digit goes in first ...
01CE   CD 2D 04               CALL   hexc   
01D1   30 08                  JR   NC,hx2   ; odd digit: consumed, and the RET below
01D3   ED 6F                  RLD      ;   overwrites it
01D5   23                     INC   HL   ; ... and RLD shifts it up under the low one
01D6   CD 2D 04               CALL   hexc   
01D9   38 F2                  JR   C,hx1   
01DB   36 C9        HX2:      LD   (HL),0C9h   ; (never range-checked: the spec says so)
01DD   F7                     RST   30h   
01DE                             ; ---- where the two pages meet ----------------------------------------------
01DE                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
01DE                             ; are in falling code order for this), and where exactly differs between the
01DE                             ; builds: NPG1 follows. Every handler below these four must start in the
01DE                             ; second page, and every one above in the first; chktab.py checks both.
01DE                             ; "]" returns: pop an address and jump to it.
01DE   CF           H_RET:    RST   08h   
01DF   42                     LD   B,D   
01E0   4B                     LD   C,E   
01E1   F7           BRK1:     RST   30h   
01E2                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
01E2                             ; drops the block start, "]" returns. No closer at all ends the program.
01E2   7C           H_BREAK:   LD   A,H   
01E3   B5                     OR   L   
01E4   E1                     POP   HL   
01E5   28 FA                  JR   Z,brk1   
01E7   CD F0 03               CALL   skip   
01EA   B7                     OR   A   ; skip returns 0 for ")"
01EB   20 F1                  JR   NZ,h_ret   
01ED   CF           RDROP:    RST   08h   
01EE   F7                     RST   30h   
01EF                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
01EF                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
01EF                             ; the body"s address instead. Either way it then skips to the matching "]'.
01EF                             ; (The unchecked build takes anything that is not a letter as the space; the
01EF                             ; checked build stops on it.)
01EF   0A           H_DEF:    LD   A,(BC)   
01F0   03                     INC   BC   
01F1   D6 41                  SUB   "A"   ; a letter gives 0-25 or 32-57: lowercase
01F3   5F                     LD   E,A   ;   lands 64 bytes up
01F4   E6 DF                  AND   0DFh   ; fold case
01F6   FE 1A                  CP   26   
01F8   30 0B                  JR   NC,def2   ; not a letter
01FA   CB 23                  SLA   E   
01FC   16 0B                  LD   D,LETPAGE   ; DE -> cell
01FE   79                     LD   A,C   
01FF   12                     LD   (DE),A   
0200   1C                     INC   E   
0201   78                     LD   A,B   
0202   12                     LD   (DE),A   
0203   18 09                  JR   skipnx   
0205                DEF2:        
0205                          IF   CHECKED   
0205   7B                     LD   A,E   
0206   FE DF                  CP   " "-"A"+256   
0208   C2 50 05               JP   NZ,e_brack   ; anything but a letter or a space
020B                          ENDIF      
020B   E5                     PUSH   HL   ; an anonymous block: push its address
020C   60                     LD   H,B   
020D   69                     LD   L,C   
020E                SKIPNX:      
020E                          IF   CHECKED   
020E   0B                     DEC   BC   ; back onto the letter, so that skip finds its
020F                          ENDIF      ;   opener, the "[", just before where it starts
020F   CD F0 03     SKIPO:    CALL   skip   
0212   F7                     RST   30h   
0213   5E           H_FETCH:   LD   E,(HL)   ; "@"
0214   23                     INC   HL   
0215   56                     LD   D,(HL)   
0216   EB                     EX   DE,HL   
0217   F7                     RST   30h   
0218                             ; =============================================================================
0218                             ;  Handlers that must start in the image's second page.
0218                             ;  "?" is the last (with "," inside it), so its long tail may run past that
0218                             ;  page.
0218                             ; =============================================================================
0218                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
0218                             ; the matching ")".
0218   7C           H_OPEN:   LD   A,H   
0219   B5                     OR   L   
021A   E1                     POP   HL   
021B   28 F2                  JR   Z,skipo   
021D   C5                     PUSH   BC   ; the block starts at the IP
021E   18 9C                  JR   rpushn   
0220                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
0220                             ; drops it and carries on.
0220   7C           H_CLOSE:   LD   A,H   
0221   B5                     OR   L   
0222   E1                     POP   HL   
0223   28 C8                  JR   Z,rdrop   
0225   CF                     RST   08h   ; pop the block start ...
0226   42                     LD   B,D   
0227   4B                     LD   C,E   
0228   C5                     PUSH   BC   
0229   18 91                  JR   rpushn   ; ... and push it back
022B                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
022B                             ; "-" has two jobs: directly before a digit it starts a negative number.
022B   0A           H_SUB:    LD   A,(BC)   
022C   D6 30                  SUB   "0"   
022E   FE 0A                  CP   10   
0230   38 04                  JR   C,negnum   
0232   E7                     RST   20h   ; a - b = a + (-b): fall into "+"
0233   D1           H_ADD:    POP   DE   
0234   19                     ADD   HL,DE   
0235   F7                     RST   30h   
0236   E5           NEGNUM:   PUSH   HL   ; a negative number: read it, negate it
0237   CD C9 03               CALL   rdnum   
023A   E7                     RST   20h   
023B   F7                     RST   30h   
023C   D1           H_AND:    POP   DE   
023D   7C                     LD   A,H   
023E   A2                     AND   D   
023F   67                     LD   H,A   
0240   7D                     LD   A,L   
0241   A3                     AND   E   
0242   6F                     LD   L,A   
0243   F7                     RST   30h   
0244                             ; Signed compares. Both are "HL < DE" for the right pair: "<" swaps the two
0244                             ; cells first. Flipping both sign bits turns a signed compare into an
0244                             ; unsigned one (and XOR clears the carry for SBC); SBC HL,HL then turns the
0244                             ; carry into -1 or 0 with no branch.
0244   E3           H_LT:     EX   (SP),HL   ; a < b: HL = a, and b is popped next
0245   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
0246   7C                     LD   A,H   
0247   EE 80                  XOR   80h   
0249   67                     LD   H,A   
024A   7A                     LD   A,D   
024B   EE 80                  XOR   80h   
024D   57                     LD   D,A   
024E   ED 52                  SBC   HL,DE   ; carry if HL < DE
0250   ED 62        TF:       SBC   HL,HL   ; carry -> -1 or 0
0252   F7                     RST   30h   
0253   D1           H_EQ:     POP   DE   
0254   B7                     OR   A   
0255   ED 52                  SBC   HL,DE   
0257   7C                     LD   A,H   
0258   B5                     OR   L   
0259   FE 01                  CP   1   ; carry only if a - b = 0
025B   18 F3                  JR   tf   
025D                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept. The
025D                             ; multiplier shifts up through A:C.
025D   D1           H_MUL:    POP   DE   ; DE = multiplicand
025E   C5                     PUSH   BC   
025F   7C                     LD   A,H   
0260   4D                     LD   C,L   ; A:C = multiplier
0261   21 00 00               LD   HL,0   
0264   06 10                  LD   B,16   
0266   29           MUL1:     ADD   HL,HL   
0267   CB 21                  SLA   C   
0269   17                     RLA      
026A   30 01                  JR   NC,mul2   
026C   19                     ADD   HL,DE   
026D   10 F7        MUL2:     DJNZ   mul1   
026F   C1                     POP   BC   
0270   F7                     RST   30h   
0271                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
0271                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
0271                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
0271                             ; stops on it.
0271                H_DIV:       
0271                          IF   CHECKED   
0271   7C                     LD   A,H   
0272   B5                     OR   L   
0273   CA 4D 05               JP   Z,e_zero   
0276                          ENDIF      
0276   D1                     POP   DE   ; DE = a, HL = b
0277   D5                     PUSH   DE   ; a, for r's sign
0278   7A                     LD   A,D   
0279   AC                     XOR   H   
027A   F5                     PUSH   AF   ; S flag = sign of q
027B   CB 7C                  BIT   7,H   
027D   C4 20 01               CALL   NZ,neg16   ; HL = |b|
0280   EB                     EX   DE,HL   
0281   CB 7C                  BIT   7,H   
0283   C4 20 01               CALL   NZ,neg16   ; HL = |a|, DE = |b|
0286   CD A1 03               CALL   udiv   ; HL = q, DE = r
0289   F1                     POP   AF   
028A   FC 20 01               CALL   M,neg16   ; q's sign
028D   EB                     EX   DE,HL   ; HL = r, DE = q
028E   F1                     POP   AF   ; A = a's high byte
028F   B7                     OR   A   
0290   FC 20 01               CALL   M,neg16   ; r's sign
0293   D5                     PUSH   DE   ; q under r
0294   F7                     RST   30h   
0295                             ; ---- stack and storage -----------------------------------------------------
0295   E5           H_DUP:    PUSH   HL   ; ":"
0296   F7                     RST   30h   
0297   E3           H_SWAP:   EX   (SP),HL   ; "%"
0298   F7                     RST   30h   
0299                             ; (The checked build tests the address before it takes the value off the
0299                             ; stack, so that an error report shows both.)
0299                H_CSTORE:      ; "." ( c addr -- )
0299                          IF   CHECKED   
0299   CD 25 05               CALL   chkst   
029C                          ENDIF      
029C   D1                     POP   DE   
029D   73                     LD   (HL),E   
029E   DF           H_DROP:   RST   18h   ; ";" is this one byte
029F                H_STORE:      ; "!" ( n addr -- )
029F                          IF   CHECKED   
029F   CD 25 05               CALL   chkst   
02A2                          ENDIF      
02A2   D1                     POP   DE   
02A3   73                     LD   (HL),E   
02A4   23                     INC   HL   
02A5   72                     LD   (HL),D   
02A6   DF                     RST   18h   
02A7                             ; ---- console ---------------------------------------------------------------
02A7                             ; 22h pushes the address of the text after it and skips the string.
02A7   E5           H_STR:    PUSH   HL   
02A8   60                     LD   H,B   
02A9   69                     LD   L,C   
02AA   CD DF 03               CALL   skipstr   
02AD                          IF   CHECKED   
02AD   B7                     OR   A   ; 0: the text ran out before the closing quote
02AE   CA 45 05               JP   Z,e_quote   
02B1                          ENDIF      
02B1   F7                     RST   30h   
02B2                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
02B2                             ; 60h to 7Eh is one of the escapes at pesc; "/" plus any other character
02B2                             ; clears that character"s bit 6 (/M is CR, and / then DEL gives "?"; "/',
02B2                             ; '"' and '?' have no bit 6, so //, /" and /? give themselves).
02B2                          IF   1-CHECKED   
                    H_PRINT:   LD   A,(HL)   
                              INC   HL   
                              CP   22h   
                              JR   Z,pr9   
                              CP   "/"   
                              JR   NZ,pr1   
                              LD   A,(HL)   
                              INC   HL   
                              CP   60h   
                              JR   C,pr0   
                              CP   7Fh   
                              JR   C,pesc   
                    PR0:      AND   0BFh   
                    PR1:      RST   28h   
                              JR   h_print   
                    PRLOOP:   EQU   h_print   ; (where the escapes go back to)
                    PRAGAIN:   EQU   h_print   ; (and where /~ goes back to)
02B2                          ENDIF      
02B2                          IF   CHECKED   
02B2                             ; (The checked build has the loop as a routine, prstr, which the error
02B2                             ; report uses too. The address is kept meanwhile, for a report: it shows
02B2                             ; the stack as it was before the "$". /~ comes back to hp1.)
02B2   22 34 0B     H_PRINT:   LD   (RSAVE),HL   
02B5   CD 0B 03     HP1:      CALL   prstr   
02B8   DF                     RST   18h   
02B9                          ENDIF      
02B9   7D           H_EMIT:   LD   A,L   ; "'"
02BA   EF                     RST   28h   
02BB   DF           PR9:      RST   18h   
02BC                             ; "#" prints TOS as a signed decimal number, with no space after it.
02BC   CD 3F 04     H_NUM:    CALL   psgn   
02BF   DF                     RST   18h   
02C0                             ; "?" ( n -- c ) or ( -n -- addr )
02C0                             ;   n > 0: wait about n ms for a key; 0 if none came
02C0                             ;   n = 0: wait for a key
02C0                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
02C0                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
02C0   CB 7C        H_KEY:    BIT   7,H   
02C2   20 19                  JR   NZ,line   
02C4   1E 28        KT1:      LD   E,MSLOOP   ; one millisecond, roughly
02C6   CD A7 04     KT2:      CALL   getk   
02C9   20 0E                  JR   NZ,kt3   
02CB   1D                     DEC   E   
02CC   20 F8                  JR   NZ,kt2   
02CE   7C                     LD   A,H   ; 0? never counts down: it waits
02CF   B5                     OR   L   
02D0   28 F2                  JR   Z,kt1   
02D2   2B                     DEC   HL   
02D3   7C                     LD   A,H   
02D4   B5                     OR   L   
02D5   20 ED                  JR   NZ,kt1   ; A = 0 if the time ran out
02D7   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
02D8   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
02D9   6F           KT3:      LD   L,A   
02DA   26 00                  LD   H,0   
02DC   F7                     RST   30h   
02DD                             ; Backspace takes the last character back (and is echoed as it
02DD                             ; is), CR ends (stored, not echoed), every other key is stored and
02DD                             ; echoed until the line is full. (CP/M too: getk reads through BDOS
02DD                             ; 6.) The line buffer starts at offset 80h of its page, so L alone
02DD                             ; is the place in the line: D holds the L of a full line.
02DD   11 7F 00     LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
02E0   19                     ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
02E1   9F                     SBC   A,A   
02E2   A5                     AND   L   ; (0 for a count that is too big)
02E3   2F                     CPL      
02E4   57                     LD   D,A   ; D = the L of a full line: 80h + count, FFh
02E5                             ;   at most
02E5   21 80 0B               LD   HL,LINEBUF   
02E8   CD A7 04     LN2:      CALL   getk   
02EB   28 FB                  JR   Z,ln2   
02ED   FE 0D                  CP   13   
02EF   28 16                  JR   Z,ln5   
02F1   FE 08                  CP   8   
02F3   28 0B                  JR   Z,ln4   
02F5   5F                     LD   E,A   
02F6   7D                     LD   A,L   
02F7   BA                     CP   D   
02F8   28 EE                  JR   Z,ln2   ; full
02FA   73                     LD   (HL),E   
02FB   2C                     INC   L   
02FC   7B                     LD   A,E   
02FD   EF           LN3:      RST   28h   
02FE   18 E8                  JR   ln2   
0300   2D           LN4:      DEC   L   ; Backspace: one back, and echo it,
0301   FA FD 02               JP   M,ln3   ;   unless the line was empty (L left the
0304   2C                     INC   L   ;   upper half of the page)
0305   18 E1                  JR   ln2   
0307   77           LN5:      LD   (HL),A   ; the CR
0308   2E 80                  LD   L,LINEBUF & 0FFh   
030A   F7                     RST   30h   
030B                             ; =============================================================================
030B                             ;  More routines (no handler starts past this point)
030B                             ; =============================================================================
030B                          IF   CHECKED   
030B                             ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
030B                             ; "$", and the texts of the report). A NUL first is an error: Q.
030B   7E           PRSTR:    LD   A,(HL)   
030C   23                     INC   HL   
030D   FE 22                  CP   22h   
030F   C8                     RET   Z   
0310   B7                     OR   A   
0311   CA 3B 05               JP   Z,e_dollar   
0314   FE 2F                  CP   "/"   
0316   20 0C                  JR   NZ,prs1   
0318   7E                     LD   A,(HL)   
0319   23                     INC   HL   
031A   FE 60                  CP   60h   
031C   38 04                  JR   C,prs0   
031E   FE 7F                  CP   7Fh   
0320   38 11                  JR   C,pesc   
0322   E6 BF        PRS0:     AND   0BFh   
0324   EF           PRS1:     RST   28h   
0325   18 E4                  JR   prstr   
0327                PRLOOP:   EQU   prstr   ; (where the escapes go back to)
0327                PRAGAIN:   EQU   hp1   ; (and where /~ goes back to)
0327                             ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
0327                             ; pnl: the same, on a new line.
0327   3E 0D        PNL:      LD   A,13   
0329   EF                     RST   28h   
032A   3E 0A                  LD   A,10   
032C   EF                     RST   28h   
032D   E3           PMSG:     EX   (SP),HL   
032E   CD 0B 03               CALL   prstr   
0331   E3                     EX   (SP),HL   
0332   C9                     RET      
0333                          ENDIF      
0333                             ; pesc: the escapes of "$". A = the character after the "/", 60h to 7Eh, and
0333                             ; HL points past it. Each goes back into the loop that prints the string
0333                             ; (PRLOOP), but /~ has the stack to see to, and goes back by PRAGAIN.
0333                             ;    /a-/z   print the variable, as "#" does
0333                             ;    /{      clear the screen, the cursor to the top left
0333                             ;    /}      clear from the cursor to the end of the line
0333                             ;    /|  /`  show the cursor, hide it
0333                             ;    /~      ( row col -- ) the cursor to that row and column, from 0
0333   FE 7E        PESC:     CP   7Eh   
0335   28 1C                  JR   Z,pat   
0337   11 0B 03               LD   DE,PRLOOP   ; the others return into the loop
033A   D5                     PUSH   DE   
033B   D6 7B                  SUB   7Bh   ; 00bbIDAsIHwgMSwg 2, and no borrow
033D   30 47                  JR   NC,pcon   
033F   C6 1A                  ADD   A,1Ah   ; a-z: 0-25, and a carry; `: FFh, and none
0341   30 35                  JR   NC,phide   
0343   87                     ADD   A,A   ; the variable's cell
0344   C6 40                  ADD   A,40h   
0346   E5                     PUSH   HL   
0347   6F                     LD   L,A   
0348   26 0B                  LD   H,LETPAGE   
034A   7E                     LD   A,(HL)   
034B   2C                     INC   L   
034C   66                     LD   H,(HL)   
034D   6F                     LD   L,A   
034E   CD 3F 04               CALL   psgn   
0351   E1                     POP   HL   
0352   C9                     RET      
0353                             ; /~ ( row col addr -- ): the two cells under the string's address go. In
0353                             ; the checked build "$" is the routine prstr: its own return address goes
0353                             ; first, and hp1 calls it again afterwards. There each /~ first looks that
0353                             ; its two cells are there, and is s if not, before it prints anything.
0353                PAT:         
0353                          IF   CHECKED   
0353   E3                     EX   (SP),HL   ; the text pointer over prstr's return address
0354   21 0A F5               LD   HL,(6-DSTOP)&0FFFFh   ; a carry: the two cells aren't there
0357   39                     ADD   HL,SP   
0358   DA F7 04               JP   C,e_under   
035B   E1                     POP   HL   
035C                          ENDIF      
035C   D1                     POP   DE   ; DE = the column
035D   E3                     EX   (SP),HL   ; HL = the row; the text pointer is kept
035E                          IF   1-ANS   
                              CALL   CONAT   
                              POP   HL   
                              JP   PRAGAIN   
                                 ; With ANSI = 0 the machine's routines do the rest.
                    PCON:     JP   Z,CONCLS   ; /{
                              CP   2   
                              JP   Z,CONEOL   ; /}
                              DB   0FEh   ; /|  (CP n steps over the XOR: A = 1, show)
                    PHIDE:    XOR   A   ; /`  (A = 0: hide)
                              JP   CONCUR   
035E                          ENDIF      
035E                          IF   ANS   
035E   D5                     PUSH   DE   
035F   CD 9A 03               CALL   csi   ; ESC [ row+1 ; col+1 H (ANSI counts from 1)
0362   23                     INC   HL   
0363   CD 47 04               CALL   pdec   
0366   3E 3B                  LD   A,";"   
0368   EF                     RST   28h   
0369   E1                     POP   HL   
036A   23                     INC   HL   
036B   CD 47 04               CALL   pdec   
036E   3E 48                  LD   A,"H"   
0370   EF                     RST   28h   
0371   E1                     POP   HL   
0372   C3 B5 02               JP   PRAGAIN   
0375                             ; With ANSI = 1 they are sequences. The carry is clear on the way in.
0375   1E 68        PSHOW:    LD   E,"h"   ; /|  ESC [ ? 2 5 h
0377   DA                     DB   0DAh   ; (JP C,nn: with no carry it steps over two bytes)
0378   1E 6C        PHIDE:    LD   E,"l"   ; /`  ESC [ ? 2 5 l
037A                          ENDIF      
037A                          IF   ANS*CHECKED   
037A                             ; (The checked build prints the fixed parts with pmsg, which it has for the
037A                             ; report: shorter than a character at a time.)
037A   CD 2D 03               CALL   pmsg   
037D   1B 5B 3F 32 35 22      DB   27,"[?25",22h   
0383   7B           PSE:      LD   A,E   ; then E
0384   EF                     RST   28h   
0385   C9                     RET      
0386                             ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into cse.
0386   3D           PCON:     DEC   A   
0387   28 EC                  JR   Z,pshow   ; /|
0389   1E 4B                  LD   E,"K"   
038B   F2 95 03               JP   P,cse   ; /}  ESC [ K
038E   1E 48                  LD   E,"H"   ; /{  ESC [ H ESC [ J
0390   CD 95 03               CALL   cse   
0393   1E 4A                  LD   E,"J"   ; (on into cse)
0395                             ; cse: ESC [ and then E. csi: ESC [. Both keep HL.
0395   CD 9A 03     CSE:      CALL   csi   
0398   18 E9                  JR   pse   
039A   CD 2D 03     CSI:      CALL   pmsg   
039D   1B 5B 22               DB   27,"[",22h   
03A0   C9                     RET      
03A1                          ENDIF      
03A1                          IF   ANS*(1-CHECKED)   
                              LD   A,"?"   
                              CALL   csia   
                              LD   A,"2"   
                              RST   28h   
                              LD   A,"5"   
                              RST   28h   
                              LD   A,E   
                              RST   28h   
                              RET      
                                 ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into csia.
                    PCON:     DEC   A   
                              JR   Z,pshow   ; /|
                              LD   A,"K"   
                              JP   P,csia   ; /}  ESC [ K
                              LD   A,"H"   ; /{  ESC [ H ESC [ J
                              CALL   csia   
                              LD   A,"J"   ; (on into csia)
                                 ; csia: ESC [ and then A. csi: ESC [, keeping A.
                    CSIA:     CALL   csi   
                              RST   28h   
                              RET      
                    CSI:      PUSH   AF   
                              LD   A,27   
                              RST   28h   
                              LD   A,"["   
                              RST   28h   
                              POP   AF   
                              RET      
03A1                          ENDIF      
03A1                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
03A1                             ; Uses A; keeps BC (the IP) itself. The dividend shifts up through A:C while
03A1                             ; the quotient bits arrive at the bottom of C.
03A1                             ; Dividing by 2 is one shift (the spec wants that fast).
03A1   7B           UDIV:     LD   A,E   
03A2   EE 02                  XOR   2   
03A4   B2                     OR   D   
03A5   20 07                  JR   NZ,udv0   
03A7   CB 3C                  SRL   H   
03A9   CB 1D                  RR   L   ; the quotient
03AB   8F                     ADC   A,A   
03AC   5F                     LD   E,A   ; the remainder: the bit that fell out (D is 0)
03AD   C9                     RET      
03AE   C5           UDV0:     PUSH   BC   
03AF   7C                     LD   A,H   
03B0   4D                     LD   C,L   
03B1   21 00 00               LD   HL,0   
03B4   06 10                  LD   B,16   
03B6   CB 21        UDV1:     SLA   C   
03B8   17                     RLA      
03B9   ED 6A                  ADC   HL,HL   
03BB   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
03BD   30 02                  JR   NC,udv2   ;   always fits in 16 bits
03BF   19                     ADD   HL,DE   ; too much: put it back, and cancel the
03C0   0D                     DEC   C   ;   INC below
03C1   0C           UDV2:     INC   C   ; a quotient bit
03C2   10 F2                  DJNZ   udv1   
03C4   EB                     EX   DE,HL   ; DE = remainder
03C5   67                     LD   H,A   
03C6   69                     LD   L,C   ; HL = quotient
03C7   C1                     POP   BC   
03C8   C9                     RET      
03C9                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
03C9                             ; non-digit. Values wrap at 16 bits, as the spec says.
03C9   21 00 00     RDNUM:    LD   HL,0   
03CC   0A           RDN1:     LD   A,(BC)   
03CD   D6 30                  SUB   "0"   
03CF   FE 0A                  CP   10   
03D1   D0                     RET   NC   
03D2   03                     INC   BC   
03D3   54                     LD   D,H   
03D4   5D                     LD   E,L   
03D5   29                     ADD   HL,HL   
03D6   29                     ADD   HL,HL   
03D7   19                     ADD   HL,DE   
03D8   29                     ADD   HL,HL   ; HL * 10
03D9   5F                     LD   E,A   
03DA   16 00                  LD   D,0   
03DC   19                     ADD   HL,DE   
03DD   18 ED                  JR   rdn1   
03DF                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
03DF                             ; the next character, so "/"" does not end it. Leaves A = 22h.
03DF                          IF   1-CHECKED   
                    SS0:      INC   BC   
                    SKIPSTR:   LD   A,(BC)   
                              INC   BC   
                              CP   "/"   
                              JR   Z,ss0   
                              CP   22h   
                              JR   NZ,skipstr   
                              RET      
03DF                          ENDIF      
03DF                          IF   CHECKED   
03DF                             ; The checked build never steps over a NUL: if the text runs out first it
03DF                             ; returns A = 0 with the IP on the NUL.
03DF   0A           SKIPSTR:   LD   A,(BC)   
03E0   B7                     OR   A   
03E1   C8                     RET   Z   
03E2   03                     INC   BC   
03E3   FE 22                  CP   22h   
03E5   C8                     RET   Z   
03E6   FE 2F                  CP   "/"   
03E8   20 F5                  JR   NZ,skipstr   
03EA   0A                     LD   A,(BC)   ; the escaped character
03EB   B7                     OR   A   
03EC   C8                     RET   Z   
03ED   03                     INC   BC   
03EE   18 EF                  JR   skipstr   
03F0                          ENDIF      
03F0                             ; skip: read past text to the closer at this level, and return A = 0 if it
03F0                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
03F0                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
03F0                             ; no closer; anything else that runs into the NUL had unbalanced brackets
03F0                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
03F0                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
03F0                             ; 
03F0                             ; The checked build also looks at the character the skip was started by,
03F0                             ; which is always the one just before where it starts: "(" must end at ")",
03F0                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
03F0                             ; quote counts as running into it. "\" takes either closer. IX keeps the
03F0                             ; place where the skip started, for the report.
03F0                SKIP:        
03F0                          IF   CHECKED   
03F0   C5                     PUSH   BC   
03F1   DD E1                  POP   IX   
03F3   0B                     DEC   BC   
03F4   0A                     LD   A,(BC)   
03F5   03                     INC   BC   
03F6   5F                     LD   E,A   ; E = the opener: ( [ or \
03F7                          ENDIF      
03F7   16 00                  LD   D,0   
03F9   14           SK3:      INC   D   ; an opener: one deeper
03FA   0A           SK1:      LD   A,(BC)   
03FB                          IF   1-CHECKED   
                              INC   BC   
                              OR   A   
                              JP   Z,SKEND   ; (the end of the program)
03FB                          ENDIF      
03FB                          IF   CHECKED   
03FB   B7                     OR   A   
03FC   28 22                  JR   Z,sk6   ; (the IP stays on the NUL)
03FE   03                     INC   BC   
03FF                          ENDIF      
03FF   FE 22                  CP   22h   
0401   CC DF 03               CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
0404   D6 28                  SUB   "("   ;   (or 0, and then the NUL is read next)
0406   28 F1                  JR   Z,sk3   
0408   3D                     DEC   A   ; ")"
0409   28 08                  JR   Z,sk4   
040B   D6 32                  SUB   "["-")"   
040D   28 EA                  JR   Z,sk3   
040F   FE 02                  CP   "]"-"["   
0411   20 E7                  JR   NZ,sk1   
0413   15           SK4:      DEC   D   
0414                          IF   1-CHECKED   
                              RET   Z   ; the closer at this level
                              JR   sk1   
0414                          ENDIF      
0414                          IF   CHECKED   
0414   20 E4                  JR   NZ,sk1   
0416   57                     LD   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
0417   AB                     XOR   E   ;   opener is 0 for "(" and 1 for "[", and only
0418   E6 06                  AND   6   ;   "\" has bit 2: so this is 2 for the wrong
041A   FE 02                  CP   2   ;   closer, and only then
041C   7A                     LD   A,D   
041D   C0                     RET   NZ   
041E   18 05                  JR   sk7   
0420   CB 53        SK6:      BIT   2,E   ; the text ran out:
0422   C2 4B 06               JP   NZ,SKEND   ;   "\" with no closer ends the program
0425   DD E5        SK7:      PUSH   IX   ; N. The place is the opener
0427   C1                     POP   BC   
0428   3E 4E                  LD   A,"N"   
042A   C3 38 05               JP   errp   ; (errp drops skip's return address)
042D                          ENDIF      
042D                             ; =============================================================================
042D                             ;  Dispatch table: the low byte of each handler's address, in code order
042D                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
042D                             ;  It must not cross a page (the dispatcher only adds to its low byte).
042D                             ; =============================================================================
042D                             ; The handlers of the first NPG1 characters start in the image's second page.
042D                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
042D                             ; differs between the builds, so the count is worked out here.
042D                             ; (One division to a line: asm80 only rounds down when it stores a value.)
042D                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
042D                PGBRK:    EQU   (h_break-BASE)/256   
042D                PGDEF:    EQU   (h_def-BASE)/256   
042D                PGFET:    EQU   (h_fetch-BASE)/256   
042D                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
042D                          IF   (1-TABP0)*(1-PTLATE)   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
042D                          ENDIF      
042D                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
042D                             ; and return its value in A with the carry set; otherwise leave the IP and
042D                             ; return with the carry clear.
042D   0A           HEXC:     LD   A,(BC)   
042E   D6 30                  SUB   "0"   
0430   FE 0A                  CP   10   
0432   38 09                  JR   C,hc1   
0434   E6 DF                  AND   0DFh   
0436   D6 11                  SUB   11h   
0438   FE 06                  CP   6   
043A   D0                     RET   NC   
043B   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
043D   03           HC1:      INC   BC   
043E   C9                     RET      
043F                             ; psgn: print HL as a signed number. Keeps BC.
043F   CB 7C        PSGN:     BIT   7,H   
0441   28 04                  JR   Z,pdec   
0443   3E 2D                  LD   A,"-"   
0445   EF                     RST   28h   
0446   E7                     RST   20h   
0447                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
0447                             ; Keeps BC.
0447   11 0A 00     PDEC:     LD   DE,10   
044A   CD A1 03               CALL   udiv   ; HL = HL / 10, E = the last digit
044D   7B                     LD   A,E   
044E   F5                     PUSH   AF   
044F   7C                     LD   A,H   
0450   B5                     OR   L   
0451   C4 47 04               CALL   NZ,pdec   
0454   F1                     POP   AF   
0455   C6 30                  ADD   A,"0"   
0457   EF                     RST   28h   
0458   C9                     RET      
0459                             ; (The table goes here instead in the builds where, before psgn, it would
0459                             ; cross a page: PTLATE.)
0459                          IF   (1-TABP0)*PTLATE   
0459                PTAB:        
0459                          ;*Macro unroll:  PTABLE
0459   9F                     DB   h_store & 0FFh   
045A   A7                     DB   h_str & 0FFh   
045B   BC                     DB   h_num & 0FFh   
045C   B2                     DB   h_print & 0FFh   
045D   97                     DB   h_swap & 0FFh   
045E   3C                     DB   h_and & 0FFh   
045F   B9                     DB   h_emit & 0FFh   
0460   18                     DB   h_open & 0FFh   
0461   20                     DB   h_close & 0FFh   
0462   5D                     DB   h_mul & 0FFh   
0463   33                     DB   h_add & 0FFh   
0464   D8                     DB   h_cfetch & 0FFh   
0465   2B                     DB   h_sub & 0FFh   
0466   99                     DB   h_cstore & 0FFh   
0467   71                     DB   h_div & 0FFh   
0468   95                     DB   h_dup & 0FFh   
0469   9E                     DB   h_drop & 0FFh   
046A   44                     DB   h_lt & 0FFh   
046B   53                     DB   h_eq & 0FFh   
046C   45                     DB   h_gt & 0FFh   
046D   C0                     DB   h_key & 0FFh   
046E   13                     DB   h_fetch & 0FFh   
046F   EF                     DB   h_def & 0FFh   
0470   E2                     DB   h_break & 0FFh   
0471   DE                     DB   h_ret & 0FFh   
0472   76                     DB   h_xor & 0FFh   
0473   89                     DB   h_alloc & 0FFh   
0474   C8                     DB   h_grave & 0FFh   
0475   2C                     DB   h_tor & 0FFh   
0476   7E                     DB   h_or & 0FFh   
0477   1C                     DB   h_fromr & 0FFh   
0478   86                     DB   h_not & 0FFh   
0479                PTABEND:      
0479                          ENDIF      
0479                             ; =============================================================================
0479                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
0479                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
0479                             ;  (RST 28h) prints A. Both keep BC, DE, HL and HL'. In the generic build
0479                             ;  they are the host's KEY and CONOUT routines themselves.
0479                             ; 
0479                             ;  A running program reads the keyboard only through getk and pollk, which
0479                             ;  between them give the break key its rules:
0479                             ;    - Ctrl-C stops the program;
0479                             ;    - any other key that the break check reads is held in KEYBUF for the
0479                             ;      next "?", and a newer one takes its place;
0479                             ;    - "?" (getk) takes the held key first;
0479                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
0479                             ;      key like any other, but two of them within about 250 ms still stop it.
0479                             ;  Both are called straight from a handler, never from a routine under one:
0479                             ;  the checked build's report counts on finding one return address above the
0479                             ;  data stack.
0479                             ; =============================================================================
0479                          IFN   CPM   
                    RAWK:     EQU   KEY   
0479                          ENDIF      
0479                             ; pollk: the break check (see rpushn).
0479   CD B7 04     POLLK:    CALL   rawk   
047C   C8                     RET   Z   ; no key
047D   32 7A 0B               LD   (KEYBUF),A   ; held for the next "?"
0480   FE 03        PK1:      CP   3   ; (getk joins here)
0482   C0                     RET   NZ   
0483                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
0483                             ; the program has turned it off, wait about 250 ms for one more key: a
0483                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
0483                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
0483   3A 7B 0B     CTLC:     LD   A,(BRKOFF)   
0486   B7                     OR   A   
0487   CA 36 05     CT0:      JP   Z,brk   
048A   D5                     PUSH   DE   
048B   11 10 27               LD   DE,250*MSLOOP   
048E   CD B7 04     CT1:      CALL   rawk   
0491   20 05                  JR   NZ,ct2   
0493   1B                     DEC   DE   
0494   7A                     LD   A,D   
0495   B3                     OR   E   
0496   20 F6                  JR   NZ,ct1   
0498   D1           CT2:      POP   DE   ; A = the second key, or 0 if none came
0499   FE 03                  CP   3   
049B   28 EA                  JR   Z,ct0   ; (the zero flag takes the JP there)
049D   B7                     OR   A   
049E   28 03                  JR   Z,ct3   
04A0   32 7A 0B               LD   (KEYBUF),A   
04A3   3E 03        CT3:      LD   A,3   
04A5   B7                     OR   A   
04A6   C9                     RET      
04A7                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
04A7   E5           GETK:     PUSH   HL   ; a held key goes first, and is taken out of
04A8   21 7A 0B               LD   HL,KEYBUF   ;   the buffer
04AB   7E                     LD   A,(HL)   
04AC   36 00                  LD   (HL),0   
04AE   E1                     POP   HL   
04AF   B7                     OR   A   
04B0   C0                     RET   NZ   
04B1   CD B7 04               CALL   rawk   
04B4   C8                     RET   Z   
04B5   18 C9                  JR   pk1   ; Ctrl-C? If not, that is the key
04B7                          IF   (1-CHECKED)*(1-EDITOR)   
                    BRK:      EQU   endprog   ; the unchecked build stops without a word
04B7                          ENDIF      ;   (with the editor, both stacks are cleared);
04B7                          IF   (1-CHECKED)*EDITOR   
                    BRK:      EQU   edit0   
04B7                          ENDIF      
04B7                          IF   CHECKED   
04B7                BRK:      EQU   e_break   ;   the checked build reports B
04B7                          ENDIF      
04B7                          IF   CPM   
04B7   3E FF        RAWK:     LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
04B9                             ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
04B9                             ; printing and could swallow a key that BDOS 6 then never sees.
04B9   D5           PUTC:     PUSH   DE   
04BA   E5                     PUSH   HL   
04BB   5F                     LD   E,A   
04BC   3E 06                  LD   A,6   
04BE   CD C5 04               CALL   bdosx   
04C1   E1                     POP   HL   
04C2   D1                     POP   DE   
04C3   B7                     OR   A   ; (for getk)
04C4   C9                     RET      
04C5                             ; bdosx: call BDOS function A with DE, keeping BC and HL'
04C5   C5           BDOSX:    PUSH   BC   
04C6   D9                     EXX      
04C7   E5                     PUSH   HL   
04C8   D9                     EXX      
04C9   4F                     LD   C,A   
04CA   CD 05 00               CALL   BDOS   
04CD   D9                     EXX      
04CE   E1                     POP   HL   
04CF   D9                     EXX      
04D0   C1                     POP   BC   
04D1   C9                     RET      
04D2                          ENDIF      
04D2                             ; =============================================================================
04D2                             ;  Checked build: the checks and the error report
04D2                             ; =============================================================================
04D2                          IF   CHECKED   
04D2                             ; chkstk: both stacks are checked once per character, not in every handler.
04D2                             ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
04D2                             ; the constant carries if it is above (cells were popped that were never
04D2                             ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
04D2                             ; a character late at most: the bytes above DSTOP and the guard band below
04D2                             ; the page take what happens meanwhile. DE is free between characters.
04D2   EB           CHKSTK:   EX   DE,HL   
04D3   21 05 F5               LD   HL,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
04D6   39                     ADD   HL,SP   
04D7   EB                     EX   DE,HL   
04D8   38 1D                  JR   C,e_under   
04DA   14                     INC   D   
04DB   20 16                  JR   NZ,e_over   
04DD   D9                     EXX      ; the return stack: in its page (or it has
04DE   7C                     LD   A,H   ;   overflowed), and not above its empty
04DF   FE 09                  CP   RSPAGE   ;   position (an underflow stays inside the
04E1   7D                     LD   A,L   ;   page, in the guard band)
04E2   D9                     EXX      
04E3   20 0B                  JR   NZ,e_rover   
04E5   FE E1                  CP   RSTOP&0FFh+1   
04E7   D8                     RET   C   
04E8   D9                     EXX      ; return stack underflow: it counts as empty
04E9   2E E0                  LD   L,RSTOP&0FFh   ;   (H is right: the pointer is in its page)
04EB   D9                     EXX      
04EC   3E 72                  LD   A,"r"   
04EE   18 48                  JR   errp   
04F0   3E 52        E_ROVER:   LD   A,"R"   ; return stack overflow
04F2   11                     DB   11h   ; (LD DE,nn hides the next entry)
04F3   3E 53        E_OVER:   LD   A,"S"   ; data stack overflow
04F5   18 41                  JR   errp   
04F7   31 FC 0A     E_UNDER:   LD   SP,DSTOP   ; data stack underflow: it counts as empty
04FA   3E 73                  LD   A,"s"   
04FC   18 54                  JR   error   
04FE                             ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
04FE                             ; was never defined still holds 0000h, and the byte there is a reserved one
04FE                             ; in every build (AFh or C3h): if the IP is in page zero, this was a call of
04FE                             ; an undefined word. The call is undone, so the place is the call itself.
04FE   04           E_HI:     INC   B   
04FF   10 49                  DJNZ   e_resv   ; (B is as it was, and is not 0)
0501   CF                     RST   08h   
0502   42                     LD   B,D   
0503   4B                     LD   C,E   
0504   3E 55                  LD   A,"U"   
0506   18 4A                  JR   error   
0508                             ; chkhp: HL = the new heap top, DE = the old one, the carry is from adding
0508                             ; the count. Stop if the top is not below the limit page, or is below the
0508                             ; program's end.
0508                CHKHP:       
0508                          ENDIF      
0508                          IF   CHECKED*CPM   
0508                             ; With this much room a top that wrapped round can land back in
0508                             ; range, so the add is tested too: growing (A, the count's high
0508                             ; byte, is positive) must not carry, and releasing must.
0508   1F                     RRA      ; the carry comes in above the sign:
0509   C6 40                  ADD   A,40h   ;   bit 7 = carry XOR sign
050B   87                     ADD   A,A   
050C   38 10                  JR   C,e_heap   
050E   3A 07 00               LD   A,(0007h)   
0511   3D                     DEC   A   
0512   BC                     CP   H   
0513   38 09                  JR   C,e_heap   
0515                          ENDIF      
0515                          IF   CHECKED*(1-CPM)   
                                 ; (Here the program's space is under 32K, so a top that wrapped
                                 ; round always falls outside it.)
                              LD   A,H   
                              CP   HEAPLIM   
                              JR   NC,e_heap   
0515                          ENDIF      
0515                          IF   CHECKED   
0515   D5                     PUSH   DE   
0516   EB                     EX   DE,HL   
0517   2A 38 0B               LD   HL,(NPEND)   
051A   19                     ADD   HL,DE   ; carry: at or above the program's end
051B   EB                     EX   DE,HL   
051C   D1                     POP   DE   
051D   D8                     RET   C   
051E   B7           E_HEAP:   OR   A   ; put the count back in TOS for the report
051F   ED 52                  SBC   HL,DE   
0521   3E 48                  LD   A,"H"   
0523   18 13                  JR   errp   
0525                             ; chkst: stop unless HL is in the program's own space: from the letter page
0525                             ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
0525                             ; whatever lies above the limit are safe. Memory above the heap top but
0525                             ; below the limit is the program's own: Tiny BASIC keeps its lines there.
0525                             ; It is the page of HL + 1 that is tested, so that one test serves both
0525                             ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
0525                             ; Keeps HL and BC. It runs on into its own error entry.
0525   23           CHKST:    INC   HL   
0526   7C                     LD   A,H   
0527   2B                     DEC   HL   
0528   FE 0B                  CP   LETPAGE   
052A   38 07                  JR   C,e_store   
052C                          ENDIF      
052C                          IF   CHECKED*(1-CPM)   
                              CP   HEAPLIM   
                              RET   C   
052C                          ENDIF      
052C                          IF   CHECKED*CPM   
052C   5F                     LD   E,A   
052D   3A 07 00               LD   A,(0007h)   ; the BDOS page is the heap limit
0530   3D                     DEC   A   
0531   BB                     CP   E   
0532   D0                     RET   NC   
0533                          ENDIF      
0533                          IF   CHECKED   
0533                             ; Error entries. Each loads its letter and then hides the next entry inside
0533                             ; a 3-byte LD DE,nn (the 11h), so they all fall through to `error`.
0533   3E 4F        E_STORE:   LD   A,"O"   ; a store outside the program's space
0535   11                     DB   11h   
0536   3E 42        E_BREAK:   LD   A,"B"   ; Ctrl-C (found inside pollk or getk)
0538                             ; errp: an error found inside a routine: drop its return address first.
0538   D1           ERRP:     POP   DE   
0539   18 17                  JR   error   
053B                             ; e_dollar: "$" ran into a NUL (in prstr): Q, with the string's address
053B                             ; back in TOS. prstr"s return address goes first. But if "$' had no
053B                             ; address at all (the stack was empty), it is s, found now: chkstk, called
053B                             ; one cell up, sees the stack past its empty place then.
053B   D1           E_DOLLAR:   POP   DE   
053C   E1                     POP   HL   
053D   CD D2 04               CALL   chkstk   
0540   E5                     PUSH   HL   
0541   2A 34 0B               LD   HL,(RSAVE)   
0544   11                     DB   11h   ; (LD DE,nn hides e_quote's first two bytes)
0545   44           E_QUOTE:   LD   B,H   ; an unclosed string: HL is its address, one
0546   4D                     LD   C,L   ;   past the opening quote, which is the place
0547   3E 51                  LD   A,"Q"   
0549   11                     DB   11h   
054A   3E 58        E_RESV:   LD   A,"X"   ; a reserved byte outside a string
054C   11                     DB   11h   
054D   3E 5A        E_ZERO:   LD   A,"Z"   ; dividing by zero
054F   11                     DB   11h   
0550   3E 57        E_BRACK:   LD   A,"W"   ; bad character after [
0552                             ; error: the report, then the end. A = the letter, BC = one past the place,
0552                             ; HL = TOS, and both stacks as the report is to show them:
0552                             ; 
0552                             ;   Err X @ line,col
0552                             ;   up to 16 characters of the text from the place
0552                             ;   Stk n: the top 8 cells at most, bottom to top
0552                             ;   Rtn n
0552   E5           ERROR:    PUSH   HL   ; now the whole data stack is in memory
0553   5F                     LD   E,A   
0554   CD 27 03               CALL   pnl   
0557   45 72 72 20 22         DB   "Err ",22h   
055C   7B                     LD   A,E   
055D   EF                     RST   28h   
055E   CD 2D 03               CALL   pmsg   
0561   20 40 20 22            DB   " @ ",22h   
0565   0B                     DEC   BC   ; BC = the place
0566                             ; The line and column. A place below the program is in the line
0566                             ; buffer: line 0. Otherwise count the LFs from the program's start;
0566                             ; DE = the line's number, HL = where it starts.
0566   21 80 0B               LD   HL,LINEBUF   
0569   11 00 00               LD   DE,0   
056C   78                     LD   A,B   
056D   FE 0C                  CP   PROG/256   
056F   38 14                  JR   C,er3   
0571   24                     INC   H   
0572   6B                     LD   L,E   ; HL = PROG
0573   13           ER1:      INC   DE   ; a new line starts at HL
0574   E5                     PUSH   HL   
0575   7D           ER2:      LD   A,L   
0576   91                     SUB   C   
0577   7C                     LD   A,H   
0578   98                     SBC   A,B   
0579   30 09                  JR   NC,er2x   ; reached the place
057B   7E                     LD   A,(HL)   
057C   23                     INC   HL   
057D   FE 0A                  CP   10   
057F   20 F4                  JR   NZ,er2   
0581   F1                     POP   AF   
0582   18 EF                  JR   er1   
0584   E1           ER2X:     POP   HL   
0585   C5           ER3:      PUSH   BC   
0586   E5                     PUSH   HL   
0587   EB                     EX   DE,HL   
0588   CD 47 04               CALL   pdec   ; the line
058B   3E 2C                  LD   A,","   
058D   EF                     RST   28h   
058E   D1                     POP   DE   
058F   E1                     POP   HL   
0590   E5                     PUSH   HL   
0591   B7                     OR   A   
0592   ED 52                  SBC   HL,DE   
0594   23                     INC   HL   
0595   CD 47 04               CALL   pdec   ; the column
0598   CD 27 03               CALL   pnl   
059B   22                     DB   22h   
059C   E1                     POP   HL   ; the text, as it is: 16 characters, or fewer
059D   06 10                  LD   B,16   ;   if the line or the program ends first
059F   7E           ER4:      LD   A,(HL)   
05A0   23                     INC   HL   
05A1   B7                     OR   A   
05A2   28 0B                  JR   Z,er5   
05A4   FE 0D                  CP   13   
05A6   28 07                  JR   Z,er5   
05A8   FE 0A                  CP   10   
05AA   28 03                  JR   Z,er5   
05AC                          ENDIF      
05AC                          IF   CHECKED*CPM*(1-EDITOR)   
                              CP   1Ah   ; (the ^Z that pads a file's last record ends
                              JR   Z,er5   ;   the text too: some terminals clear the
05AC                          ENDIF      ;   screen on it. The editor's loader ends
05AC                          IF   CHECKED   ;   the text at the first ^Z.)
05AC   EF                     RST   28h   
05AD   10 F0                  DJNZ   er4   
05AF                ER5:         ; (on into the two stack lines)
05AF                             ; The two stack lines:  Stk n: the top 8 cells at most, bottom to top
05AF                             ;                       Rtn n
05AF                             ; TOS is in memory with the rest (pushed) by now.
05AF   CD 27 03               CALL   pnl   
05B2   53 74 6B 20 22         DB   "Stk ",22h   
05B7   21 06 F5               LD   HL,(2-DSTOP)&0FFFFh   ; SP - (DSTOP-2) is minus twice the
05BA   39                     ADD   HL,SP   ;   depth (the cell at DSTOP-2 was pushed
05BB   E7                     RST   20h   ;   with the first value and holds nothing)
05BC   CD 03 06               CALL   phalf   ; the depth
05BF   3E 3A                  LD   A,":"   
05C1   EF                     RST   28h   
05C2   79                     LD   A,C   
05C3   FE 09                  CP   9   
05C5   38 0A                  JR   C,er6   
05C7   CD 2D 03               CALL   pmsg   
05CA   20 2E 2E 2E 22         DB   " ...",22h   
05CF   0E 08                  LD   C,8   
05D1   26 00        ER6:      LD   H,0   ; C = the number of cells to show
05D3   69                     LD   L,C   
05D4   29                     ADD   HL,HL   
05D5   39                     ADD   HL,SP   ; HL -> just above the deepest of them
05D6   0C                     INC   C   
05D7   0D           ER7:      DEC   C   
05D8   28 0F                  JR   Z,er8   
05DA   2B                     DEC   HL   
05DB   56                     LD   D,(HL)   
05DC   2B                     DEC   HL   
05DD   5E                     LD   E,(HL)   
05DE   E5                     PUSH   HL   
05DF   3E 20                  LD   A," "   
05E1   EF                     RST   28h   
05E2   EB                     EX   DE,HL   
05E3   CD 3F 04               CALL   psgn   
05E6   E1                     POP   HL   
05E7   18 EE                  JR   er7   
05E9   CD 27 03     ER8:      CALL   pnl   
05EC   52 74 6E 20 22         DB   "Rtn ",22h   
05F1   D9                     EXX      ; RSTOP - HL' is under 256 (the pointer is
05F2   3E E0                  LD   A,RSTOP&0FFh   ;   at most one entry below its page), so
05F4   95                     SUB   L   ;   the low bytes are enough
05F5   D9                     EXX      
05F6   6F                     LD   L,A   
05F7   26 00                  LD   H,0   
05F9   CD 03 06               CALL   phalf   
05FC   CD 27 03               CALL   pnl   
05FF   22                     DB   22h   
0600                          ENDIF      
0600                          IF   CHECKED*(1-EDITOR)   
                              JP   endprog   
0600                          ENDIF      
0600                          IF   CHECKED*EDITOR   
0600   C3 43 06               JP   edit0   ; back to the editor, with both stacks cleared
0603                          ENDIF      
0603                          IF   CHECKED   
0603                             ; phalf: print half of HL, and leave it in C.
0603   CB 3C        PHALF:    SRL   H   
0605   CB 1D                  RR   L   
0607   E5                     PUSH   HL   
0608   CD 47 04               CALL   pdec   
060B   C1                     POP   BC   
060C   C9                     RET      
060D                          ENDIF      
060D                             ; =============================================================================
060D                             ;  The line editor (EDITOR = 1)
060D                             ; 
060D                             ;  The interpreter starts here, and a program that ends comes back here.
060D                             ;  There is no prompt. It follows the spec's suggested standard for a line
060D                             ;  editor (docs/b8script.md, Environments). Type a line and press Return:
060D                             ; 
060D                             ;    n text    put the text in as line n; the lines from n on move down. A
060D                             ;              number past the end (or 0) adds the line at the end.
060D                             ;    n         take line n out
060D                             ;    anything else is run at once, as B8Script. (Start such a line with a
060D                             ;    space if it would begin with a digit.)
060D                             ; 
060D                             ;  A command key ends the line too, and takes what was typed as its argument:
060D                             ; 
060D                             ;    ^G        run the program
060D                             ;    n ^L      list from line n (no number: all of it). Any key holds the
060D                             ;              list until another key is pressed; Ctrl-C ends it.
060D                             ;    n ^E      put line n in the input line; Return puts it back, changed
060D                             ;    name ^R   read. CP/M: the file of that name (no name: the same file as
060D                             ;              last time). Generic: what is typed, or pasted, from now until
060D                             ;              ^Z replaces the program; it is not echoed.
060D                             ;    name ^W   write. CP/M: to that file (no name: the same file as last
060D                             ;              time). Generic: the text is printed, as it is.
060D                             ;    ^N ^N     new: no program (the key twice in a row)
060D                             ;    ^X        leave (to LEAVE)
060D                             ; 
060D                             ;  In the line: ^B and ^F, or the left and right arrow keys, move the cursor;
060D                             ;  a character goes in at the cursor; Backspace and DEL take out the one
060D                             ;  before it; Esc drops the line. Only CR, LF, BS and printing characters are
060D                             ;  sent to the terminal, so any terminal will do.
060D                             ; 
060D                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
060D                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
060D                             ;  125 characters; the one character after a line number separates it from
060D                             ;  the text and is not stored. The text is kept as it is typed, each line
060D                             ;  ending in CR LF, at PROG.
060D                             ; 
060D                             ;  What lasts from one line to the next: the program, the words, the
060D                             ;  variables and the data stack. An error or a break clears both stacks. The
060D                             ;  return stack starts empty for every line.
060D                             ; 
060D                             ;  Things to know:
060D                             ;    - Reset empties the program (generic builds).
060D                             ;    - A word's address points into the program, so run the program again
060D                             ;      after editing it.
060D                             ;    - Nothing is printed between a program's output and what is typed next.
060D                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
060D                             ;      a line that calls -n? and carries on afterwards runs what was typed.
060D                             ;      (The stored program never comes back to the line, so it may.)
060D                             ;    - The editor"s own keys are not the program"s: -n? is the plain line
060D                             ;      read of the other builds.
060D                             ; 
060D                             ;  The data stack is the CPU's stack, so the editor works on top of whatever
060D                             ;  the last line left there, with TOS pushed like the rest.
060D                             ; =============================================================================
060D                          IF   EDGEN   
                    INIT:        ; reset (A = 0)
060D                          ENDIF      
060D                          IF   EDGEN*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at 0, and
                                 ; every word cell holds 0000h, the address an undefined word is caught at
                                 ; (see e_hi).
                              LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
060D                          ENDIF      
060D                          IF   EDGEN   
                              JR   edit0   
060D                          ENDIF      
060D                          IF   EDITOR   
060D                             ; ^F, right arrow: one to the right, by printing the character there
060D   7D           RIGHT:    LD   A,L   
060E   BB                     CP   E   
060F   28 4E                  JR   Z,ed1   ; at the end
0611   7E                     LD   A,(HL)   
0612   2C                     INC   L   
0613   18 2B                  JR   lf1   
0615                             ; Esc: alone it drops the line. An arrow key sends Esc [ and a letter, so
0615                             ; wait about 5 ms for a second key: after a "[" read on to the letter that
0615                             ; ends the sequence, and act on C (right) and D (left).
0615   01 C8 00     ESC:      LD   BC,5*MSLOOP   
0618   CD B7 04     ES1:      CALL   rawk   
061B   20 0A                  JR   NZ,es2   
061D   0B                     DEC   BC   
061E   78                     LD   A,B   
061F   B1                     OR   C   
0620   20 F6                  JR   NZ,es1   
0622   CD 94 06               CALL   fin   ; no second key: the line is dropped
0625   18 26                  JR   edit   
0627   FE 5B        ES2:      CP   "["   
0629   20 34                  JR   NZ,ed1   ; not a sequence known here
062B   CD ED 06     ES3:      CALL   ekey   
062E   FE 40                  CP   40h   
0630   38 F9                  JR   C,es3   ; (its parameters)
0632   D6 43                  SUB   "C"   
0634   28 D7                  JR   Z,right   
0636   3D                     DEC   A   ; "D"?
0637   20 26                  JR   NZ,ed1   ; no: on into left
0639                             ; ^B, left arrow: the cursor goes one to the left
0639   7D           LEFT:     LD   A,L   
063A   87                     ADD   A,A   
063B   28 22                  JR   Z,ed1   ; (L = 80h: at the start)
063D   2D                     DEC   L   
063E   3E 08                  LD   A,8   
0640   EF           LF1:      RST   28h   
0641   18 1C                  JR   ed1   
0643                             ; edit0: reset, an error or a break: both stacks are cleared, and the cursor
0643                             ;   is shown, in case the program had hidden it and could not show it again.
0643                             ; skend: a program that ended inside skip: its return address goes.
0643                             ; edend: a program that ended: TOS joins the rest of the data stack.
0643   31 FA 0A     EDIT0:    LD   SP,DSTOP-2   ; empty (the cell that stands for TOS is pushed)
0646                          ENDIF      
0646                          IF   EDITOR*ANS   
0646   AF                     XOR   A   ; (pshow wants the carry clear)
0647   CD 75 03               CALL   pshow   ; ESC [ ? 2 5 h
064A                          ENDIF      
064A                          IF   EDITOR*(1-ANS)   
                              LD   A,1   
                              CALL   CONCUR   ; show the cursor
064A                          ENDIF      
064A                          IF   EDITOR   
064A   21                     DB   21h   ; (LD HL,nn: steps over the next two bytes)
064B   D1           SKEND:    POP   DE   
064C   E5           EDEND:    PUSH   HL   
064D                             ; edit: start a new input line.
064D   D9           EDIT:     EXX      
064E   21 E0 09               LD   HL,RSTOP   ; the return stack is empty
0651   D9                     EXX      
0652   21 00 00               LD   HL,0   
0655   22 7A 0B               LD   (KEYBUF),HL   ; no key is held, and the break key is on
0658   22 3A 0B               LD   (EDLN),HL   ; no line is being edited
065B   21 80 0B               LD   HL,LINEBUF   ; HL = the cursor,
065E   5D                     LD   E,L   ;   E = the end of the line (its low byte)
065F   CD ED 06     ED1:      CALL   ekey   
0662   FE 7F                  CP   7Fh   
0664   28 40                  JR   Z,bsp   ; DEL
0666   FE 20                  CP   " "   
0668   30 56                  JR   NC,insc   
066A   FE 09                  CP   9   
066C   28 52                  JR   Z,insc   ; Tab is text
066E   FE 08                  CP   8   
0670   28 34                  JR   Z,bsp   
0672   FE 02                  CP   2   
0674   28 C3                  JR   Z,left   ; ^B
0676   FE 06                  CP   6   
0678   28 93                  JR   Z,right   ; ^F
067A   FE 1B                  CP   1Bh   
067C   28 97                  JR   Z,esc   
067E   E5                     PUSH   HL   ; a command key? Look it up
067F   21 F3 06               LD   HL,cmds   
0682   06 08                  LD   B,NCMD   
0684   BE           ED2:      CP   (HL)   
0685   23                     INC   HL   
0686   28 07                  JR   Z,ed3   
0688   23                     INC   HL   
0689   23                     INC   HL   
068A   10 F8                  DJNZ   ed2   
068C   E1                     POP   HL   
068D   18 D0                  JR   ed1   ; no: the key is ignored
068F   7E           ED3:      LD   A,(HL)   
0690   23                     INC   HL   
0691   66                     LD   H,(HL)   
0692   6F                     LD   L,A   
0693   E3                     EX   (SP),HL   ; the command's address: fin returns to it
0694                             ; fin: end the input line: CR LF and a NUL after it, and a new line on the
0694                             ; terminal. Leaves BC -> the line and HL -> the NUL.
0694   26 0B        FIN:      LD   H,LETPAGE   
0696   6B                     LD   L,E   
0697   36 0D                  LD   (HL),13   
0699   2C                     INC   L   
069A   36 0A                  LD   (HL),10   
069C   2D                     DEC   L   
069D   CD F9 07               CALL   prl   ; (prints the CR LF)
06A0   36 00                  LD   (HL),0   
06A2   01 80 0B               LD   BC,LINEBUF   
06A5   C9                     RET      
06A6                             ; Backspace, DEL: the character before the cursor goes. The cursor moves
06A6                             ; left, the rest of the line moves down over it, and the last place (now a
06A6                             ; space) is printed over along with the rest.
06A6   7D           BSP:      LD   A,L   
06A7   87                     ADD   A,A   
06A8   28 B5                  JR   Z,ed1   ; at the start
06AA   2D                     DEC   L   
06AB   3E 08                  LD   A,8   
06AD   EF                     RST   28h   
06AE   E5                     PUSH   HL   
06AF   2C           BS1:      INC   L   
06B0   7E                     LD   A,(HL)   
06B1   2D                     DEC   L   
06B2   77                     LD   (HL),A   
06B3   2C                     INC   L   
06B4   7D                     LD   A,L   
06B5   BB                     CP   E   
06B6   20 F7                  JR   NZ,bs1   
06B8   2D                     DEC   L   
06B9   36 20                  LD   (HL)," "   
06BB   E1                     POP   HL   
06BC   53                     LD   D,E   
06BD   1D                     DEC   E   
06BE   18 15                  JR   ic2   
06C0                             ; A character goes in at the cursor: it ripples up through the rest of the
06C0                             ; line, the cursor moves on, and the rest is printed again.
06C0   47           INSC:     LD   B,A   
06C1   7B                     LD   A,E   
06C2   FE FD                  CP   0FDh   
06C4   28 99                  JR   Z,ed1   ; the line is full: 125 characters
06C6   78                     LD   A,B   
06C7   EF                     RST   28h   
06C8   E5                     PUSH   HL   
06C9   7E           IC1:      LD   A,(HL)   
06CA   70                     LD   (HL),B   
06CB   47                     LD   B,A   
06CC   7D                     LD   A,L   
06CD   2C                     INC   L   
06CE   BB                     CP   E   
06CF   20 F8                  JR   NZ,ic1   
06D1   E1                     POP   HL   
06D2   2C                     INC   L   
06D3   1C                     INC   E   
06D4   53                     LD   D,E   
06D5   CD DA 06     IC2:      CALL   tail   
06D8   18 85                  JR   ed1   
06DA                             ; tail: print the line from the cursor to D (a low byte), and bring the
06DA                             ; cursor back with backspaces. Nothing at all if the cursor is at D.
06DA   4D           TAIL:     LD   C,L   
06DB   7D           TA1:      LD   A,L   
06DC   BA                     CP   D   
06DD   28 05                  JR   Z,ta2   
06DF   7E                     LD   A,(HL)   
06E0   EF                     RST   28h   
06E1   2C                     INC   L   
06E2   18 F7                  JR   ta1   
06E4   7D           TA2:      LD   A,L   
06E5   B9                     CP   C   
06E6   C8                     RET   Z   
06E7   3E 08                  LD   A,8   
06E9   EF                     RST   28h   
06EA   2D                     DEC   L   
06EB   18 F7                  JR   ta2   
06ED                             ; ekey: wait for a key
06ED   CD B7 04     EKEY:     CALL   rawk   
06F0   28 FB                  JR   Z,ekey   
06F2   C9                     RET      
06F3                             ; The command keys, and where each goes (after fin).
06F3   0D           CMDS:     DB   13   
06F4   43 07                  DW   cret   
06F6   07                     DB   7   ; ^G
06F7   8B 07                  DW   crun   
06F9   0C                     DB   12   ; ^L
06FA   A1 07                  DW   clist   
06FC   05                     DB   5   ; ^E
06FD   19 07                  DW   cedln   
06FF   12                     DB   18   ; ^R
0700   02 08                  DW   cread   
0702   17                     DB   23   ; ^W
0703   0B 08                  DW   cwrite   
0705   0E                     DB   14   ; ^N
0706   0B 07                  DW   cnew   
0708   18                     DB   24   ; ^X
0709   00 00                  DW   LEAVE   
070B                NCMD:     EQU   8   
070B                             ; ^N ^N: no program, if the next key is ^N too
070B   CD ED 06     CNEW:     CALL   ekey   
070E   FE 0E                  CP   14   
0710   20 04                  JR   NZ,ged0   
0712   AF                     XOR   A   
0713   32 00 0C               LD   (PROG),A   
0716   C3 4D 06     GED0:     JP   edit   
0719                             ; ^E: line n goes into the input line, to be changed. EDLN remembers which
0719                             ; line it was: Return puts the text back in its place.
0719   CD C9 03     CEDLN:    CALL   rdnum   
071C   E5                     PUSH   HL   
071D   CD E1 07               CALL   find   ; HL -> the line, or the NUL if there is none
0720   D1                     POP   DE   
0721   7E                     LD   A,(HL)   
0722   B7                     OR   A   
0723   28 F1                  JR   Z,ged0   
0725   ED 53 3A 0B            LD   (EDLN),DE   
0729   11 80 0B               LD   DE,LINEBUF   
072C   7E           CE1:      LD   A,(HL)   ; copy it, and show it, up to its CR (or LF)
072D   FE 0D                  CP   13   
072F   28 0D                  JR   Z,ce2   
0731   FE 0A                  CP   10   
0733   28 09                  JR   Z,ce2   
0735   12                     LD   (DE),A   
0736   EF                     RST   28h   
0737   23                     INC   HL   
0738   1C                     INC   E   
0739   7B                     LD   A,E   
073A   FE FD                  CP   0FDh   ; (a longer line is cut at 125 characters)
073C   20 EE                  JR   NZ,ce1   
073E   EB           CE2:      EX   DE,HL   ; the cursor is at the line's end
073F   5D                     LD   E,L   
0740   C3 5F 06               JP   ed1   
0743                             ; Return. If ^E put a line here, the text goes back in its place. If not:
0743                             ; a number and text is a line to put in, a number alone a line to take out,
0743                             ; and anything else is run where it is.
0743   E5           CRET:     PUSH   HL   ; the end of what was typed
0744   2A 3A 0B               LD   HL,(EDLN)   
0747   7C                     LD   A,H   
0748   B5                     OR   L   
0749   28 07                  JR   Z,cr1   
074B   E5                     PUSH   HL   
074C   CD D1 07               CALL   delln   
074F   E1                     POP   HL   
0750   18 13                  JR   ins   
0752   CD C9 03     CR1:      CALL   rdnum   ; HL = the number it starts with, BC -> after
0755   79                     LD   A,C   ; C is still 80h if there was no number:
0756   87                     ADD   A,A   ;   only then is twice it 0
0757   28 36                  JR   Z,st0p   ; no number: run the line
0759   0A                     LD   A,(BC)   
075A   FE 0D                  CP   13   
075C   20 06                  JR   NZ,cr2   
075E   D1                     POP   DE   ; the number alone: take that line out
075F   CD D1 07               CALL   delln   
0762   18 24                  JR   gedit   
0764   03           CR2:      INC   BC   ; step over the one character after the number
0765                             ; Put the text at BC in as line n (in HL): open a gap of its length there,
0765                             ; CR and LF included, and copy it in.
0765   CD E1 07     INS:      CALL   find   ; HL -> where it goes
0768   D1                     POP   DE   ; the end of what was typed
0769   7B                     LD   A,E   
076A   91                     SUB   C   ; A = the length of the text, with its CR LF
076B   C5                     PUSH   BC   ; the text
076C   4F                     LD   C,A   
076D   06 00                  LD   B,0   
076F   C5                     PUSH   BC   ; its length
0770   54                     LD   D,H   
0771   5D                     LD   E,L   ; DE = where it goes
0772   AF                     XOR   A   
0773   4F                     LD   C,A   ; BC = 0: CPIR looks as far as it needs to
0774   ED B1                  CPIR      ; HL -> one past the program's NUL
0776   ED 52                  SBC   HL,DE   ; the number of bytes to move up, NUL included
0778   44                     LD   B,H   
0779   4D                     LD   C,L   
077A   19                     ADD   HL,DE   
077B   2B                     DEC   HL   ; HL -> the NUL
077C   EB                     EX   DE,HL   
077D   E3                     EX   (SP),HL   ; HL = the length; where it goes is kept
077E   E5                     PUSH   HL   
077F   19                     ADD   HL,DE   ; the NUL's new place
0780   EB                     EX   DE,HL   
0781   ED B8                  LDDR      ; move the rest of the program up
0783   C1                     POP   BC   ; the length
0784   D1                     POP   DE   ; where it goes
0785   E1                     POP   HL   ; the text
0786   ED B0                  LDIR      
0788   C3 4D 06     GEDIT:    JP   edit   
078B                             ; ^G: run the program. st0p: run the typed line (BC -> it).
078B   01 00 0C     CRUN:     LD   BC,PROG   
078E   3E                     DB   3Eh   ; (LD A,n: steps over the POP)
078F   E1           ST0P:     POP   HL   ; (the end of what was typed)
0790                             ; st0: start running at BC. The heap starts after the stored program's NUL.
0790   21 00 0C     ST0:      LD   HL,PROG   
0793   AF                     XOR   A   
0794   BE           ST1:      CP   (HL)   
0795   23                     INC   HL   
0796   20 FC                  JR   NZ,st1   
0798   22 7C 0B               LD   (HEAP),HL   
079B                          ENDIF      
079B                          IF   EDITOR*CHECKED   
079B   E7                     RST   20h   ; minus the heap"s first address: "_' may not
079C   22 38 0B               LD   (NPEND),HL   ;   release below it
079F                          ENDIF      
079F                          IF   EDITOR   
079F   E1                     POP   HL   ; TOS: the data stack is as the last line left it
07A0   F7                     RST   30h   ; (its return address is thrown away)
07A1                             ; ^L: list from line n. DE = the number of the line at HL.
07A1   CD C9 03     CLIST:    CALL   rdnum   ; HL = n, or 0 if there was none:
07A4   7C                     LD   A,H   
07A5   B5                     OR   L   
07A6   20 01                  JR   NZ,li0   
07A8   2C                     INC   L   ;   then from line 1
07A9   E5           LI0:      PUSH   HL   
07AA   CD E1 07               CALL   find   
07AD   D1                     POP   DE   
07AE   7E           LI1:      LD   A,(HL)   
07AF   B7                     OR   A   
07B0   28 D6                  JR   Z,gedit   ; the end of the text
07B2   CD B7 04               CALL   rawk   
07B5   28 09                  JR   Z,li3   ; no key: carry on
07B7   FE 03                  CP   3   
07B9   C4 ED 06               CALL   NZ,ekey   ; any key but Ctrl-C: wait for one more
07BC   FE 03                  CP   3   
07BE   28 C8                  JR   Z,gedit   ; Ctrl-C, first or second, ends the list
07C0   E5           LI3:      PUSH   HL   
07C1   D5                     PUSH   DE   
07C2   EB                     EX   DE,HL   
07C3   CD 47 04               CALL   pdec   ; the line's number,
07C6   3E 20                  LD   A," "   
07C8   EF                     RST   28h   ;   a space,
07C9   D1                     POP   DE   
07CA   E1                     POP   HL   
07CB   13                     INC   DE   
07CC   CD F9 07               CALL   prl   ;   and the line
07CF   18 DD                  JR   li1   
07D1                             ; delln: take line n (in HL) out: copy everything after it down over it.
07D1   CD E1 07     DELLN:    CALL   find   
07D4   54                     LD   D,H   
07D5   5D                     LD   E,L   
07D6   CD EF 07               CALL   nxl   ; HL -> the next line
07D9   7E           DE1:      LD   A,(HL)   
07DA   12                     LD   (DE),A   
07DB   23                     INC   HL   
07DC   13                     INC   DE   
07DD   B7                     OR   A   
07DE   20 F9                  JR   NZ,de1   
07E0   C9                     RET      
07E1                             ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
07E1                             ; of the text if there are fewer lines (or the number is 0). Keeps BC.
07E1   EB           FIND:     EX   DE,HL   
07E2   21 00 0C               LD   HL,PROG   
07E5   1B           FI1:      DEC   DE   
07E6   7A                     LD   A,D   
07E7   B3                     OR   E   
07E8   C8                     RET   Z   
07E9   CD EF 07               CALL   nxl   
07EC   20 F7                  JR   NZ,fi1   
07EE   C9                     RET      
07EF                             ; nxl: step HL over one line, to just past its LF (and return not-zero), or
07EF                             ; stop at the NUL that ends the text (and return zero).
07EF   7E           NXL:      LD   A,(HL)   
07F0   B7                     OR   A   
07F1   C8                     RET   Z   
07F2   23                     INC   HL   
07F3   FE 0A                  CP   10   
07F5   20 F8                  JR   NZ,nxl   
07F7   B7                     OR   A   
07F8   C9                     RET      
07F9                             ; prl: print the line at HL, to its LF; HL -> just past it.
07F9   7E           PRL:      LD   A,(HL)   
07FA   EF                     RST   28h   
07FB   7E                     LD   A,(HL)   
07FC   23                     INC   HL   
07FD   FE 0A                  CP   10   
07FF   20 F8                  JR   NZ,prl   
0801   C9                     RET      
0802                          ENDIF      
0802                          IF   EDGEN   
                    GED1:     JP   edit   
                                 ; ^R, generic: what comes in from now until ^Z is the program. A CR is
                                 ; stored as CR LF; a LF right after a line end is dropped (it is the CR's
                                 ; own, or an empty line's), and a LF anywhere else ends a line too. A last
                                 ; line with no end is given one. Nothing is echoed, and there is no check
                                 ; for running out of memory.
                    CREAD:    LD   HL,PROG-1   
                              LD   (HL),10   ; (as if a line had just ended: the byte is
                              INC   HL   ;   the line buffer's last, and spare)
                    RD1:      CALL   ekey   
                              LD   C,A   
                              CP   1Ah   
                              JR   NZ,rd2   
                              LD   A,10   ; ^Z ends the last line, as a LF would
                    RD2:      CP   10   
                              JR   NZ,rd3   
                              DEC   HL   
                              CP   (HL)   
                              INC   HL   
                              JR   Z,rd4   ; straight after a line end: dropped
                              LD   A,13   ; anywhere else it ends the line
                    RD3:      LD   (HL),A   
                              INC   HL   
                              CP   13   
                              JR   NZ,rd4   
                              LD   (HL),10   ; after a CR goes a LF
                              INC   HL   
                    RD4:      LD   A,C   
                              CP   1Ah   
                              JR   NZ,rd1   
                              LD   (HL),0   
                              JR   ged1   
                                 ; ^W, generic: the text is printed as it is, for the terminal to capture.
                    CWRITE:   LD   HL,PROG   
                    CW1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,ged1   
                              RST   28h   
                              INC   HL   
                              JR   cw1   
0802                          ENDIF      
0802                          IF   EDITOR*CPM   
0802                CFCB:     EQU   005Ch   ; the file's name is kept here, where the CCP
0802                             ;   put the one from the command line
0802                             ; ^R, CP/M: read the file. A name typed before the key is the file's name
0802                             ; from now on.
0802   CD 59 08     CREAD:    CALL   setname   
0805   CD 98 08               CALL   load   
0808   C3 4D 06               JP   edit   
080B                             ; ^W, CP/M: write the file: delete the old one, make it anew, write the
080B                             ; text in records of 128 bytes, and close it. The text's NUL and the 127
080B                             ; bytes after it are set to ^Z meanwhile, which pads the last record. (A
080B                             ; full disk or directory is not noticed: the calls fail and that is all.)
080B   CD 59 08     CWRITE:   CALL   setname   
080E   0E 13                  LD   C,19   ; delete
0810   CD 92 08               CALL   fbdos   
0813   0E 16                  LD   C,22   ; make
0815   CD 92 08               CALL   fbdos   
0818   21 00 0C               LD   HL,PROG   
081B   AF                     XOR   A   
081C   BE           CW1:      CP   (HL)   
081D   23                     INC   HL   
081E   20 FC                  JR   NZ,cw1   
0820   2B                     DEC   HL   ; HL -> the NUL
0821   E5                     PUSH   HL   
0822   06 80                  LD   B,128   
0824   36 1A        CW2:      LD   (HL),1Ah   
0826   23                     INC   HL   
0827   10 FB                  DJNZ   cw2   
0829   E1                     POP   HL   
082A   11 00 0C               LD   DE,PROG   
082D   7B           CW3:      LD   A,E   ; a record that starts before the end is written
082E   95                     SUB   L   
082F   7A                     LD   A,D   
0830   9C                     SBC   A,H   
0831   30 09                  JR   NC,cw4   
0833   E5                     PUSH   HL   
0834   0E 15                  LD   C,21   ; write, from where the record lies
0836   CD 46 08               CALL   frec   
0839   E1                     POP   HL   
083A   18 F1                  JR   cw3   
083C   36 00        CW4:      LD   (HL),0   ; the NUL again
083E   0E 10                  LD   C,16   ; close
0840   CD 92 08               CALL   fbdos   
0843   C3 4D 06               JP   edit   
0846                             ; frec: BDOS function C (read or write a record) with the 128 bytes at DE.
0846                             ; Returns A = the BDOS's answer, HL = DE and DE = DE + 128.
0846   D5           FREC:     PUSH   DE   
0847   C5                     PUSH   BC   
0848   0E 1A                  LD   C,26   ; set the DMA address
084A   CD 05 00               CALL   BDOS   
084D   C1                     POP   BC   
084E   CD 92 08               CALL   fbdos   
0851   E1                     POP   HL   
0852   11 80 00               LD   DE,128   
0855   EB                     EX   DE,HL   
0856   19                     ADD   HL,DE   
0857   EB                     EX   DE,HL   
0858   C9                     RET      
0859                             ; setname: if a name was typed (the line does not start with its CR), put it
0859                             ; in the FCB: up to 8 characters, a dot, up to 3 more, in capitals. The drive
0859                             ; is the current one. Then, name or no name, clear the FCB after the name,
0859                             ; as it must be before a file is opened or made.
0859   11 80 0B     SETNAME:   LD   DE,LINEBUF   
085C   1A                     LD   A,(DE)   
085D   FE 0D                  CP   13   
085F   28 26                  JR   Z,fcbclr   
0861   21 5C 00               LD   HL,CFCB   
0864   36 00                  LD   (HL),0   ; the current drive
0866   06 0B                  LD   B,11   
0868   2C           SN1:      INC   L   
0869   36 20                  LD   (HL)," "   
086B   10 FB                  DJNZ   sn1   
086D   2E 5D                  LD   L,CFCB+1   
086F   1A           SN2:      LD   A,(DE)   
0870   13                     INC   DE   
0871   FE 0D                  CP   13   
0873   28 12                  JR   Z,fcbclr   
0875   FE 2E                  CP   "."   
0877   20 04                  JR   NZ,sn3   
0879   2E 65                  LD   L,CFCB+9   ; the type
087B   18 F2                  JR   sn2   
087D   FE 61        SN3:      CP   "a"   
087F   38 02                  JR   C,sn4   
0881   E6 5F                  AND   5Fh   ; a capital
0883   77           SN4:      LD   (HL),A   
0884   2C                     INC   L   
0885   18 E8                  JR   sn2   
0887   21 68 00     FCBCLR:   LD   HL,CFCB+12   
088A   06 18                  LD   B,24   
088C   36 00        FC1:      LD   (HL),0   
088E   23                     INC   HL   
088F   10 FB                  DJNZ   fc1   
0891   C9                     RET      
0892                             ; fbdos: BDOS function C on the file
0892   11 5C 00     FBDOS:    LD   DE,CFCB   
0895   C3 05 00               JP   BDOS   
0898                             ; load: read the file into PROG. No such file: no program. The text ends at
0898                             ; the file"s first ^Z (1Ah), which pads a text file"s last record; one more
0898                             ; goes after the last record, so the search always stops. And every line
0898                             ; must end in LF: a last line without one is given a CR LF. (The FCB is
0898                             ; clear after its name: the CCP left it so, or setname did.)
0898   0E 0F        LOAD:     LD   C,15   ; open (no such file: the first read fails
089A   CD 92 08               CALL   fbdos   ;   too)
089D   11 00 0C               LD   DE,PROG   
08A0   0E 14        LD1:      LD   C,20   ; read the next 128 bytes
08A2   CD 46 08               CALL   frec   
08A5   B7                     OR   A   
08A6   28 F8                  JR   Z,ld1   
08A8   36 1A                  LD   (HL),1Ah   ; (HL = where the record that failed would be)
08AA   21 FF 0B               LD   HL,PROG-1   
08AD   3E 0A                  LD   A,10   ; (a file with no text needs nothing added)
08AF   23           TR1:      INC   HL   
08B0   5F                     LD   E,A   ; E = the character before this one
08B1   7E                     LD   A,(HL)   
08B2   FE 1A                  CP   1Ah   
08B4   20 F9                  JR   NZ,tr1   
08B6   7B                     LD   A,E   
08B7   FE 0A                  CP   10   
08B9   28 06                  JR   Z,tr2   
08BB   36 0D                  LD   (HL),13   
08BD   23                     INC   HL   
08BE   36 0A                  LD   (HL),10   
08C0   23                     INC   HL   
08C1   36 00        TR2:      LD   (HL),0   
08C3   C9                     RET      
08C4                          ENDIF      
08C4                             ; =============================================================================
08C4                          IF   CPM   
08C4                             ; The RAM pages follow the image; the heap may grow to the BDOS.
08C4                START:       
08C4                          ENDIF      
08C4                          IF   CPM*CHECKED   
08C4                             ; Clear the lower half of the letter page: every variable starts at
08C4                             ; 0, every word cell holds 0000h, the address an undefined word is
08C4                             ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
08C4                             ; is held back.
08C4   21 00 0B               LD   HL,LET   
08C7   AF                     XOR   A   
08C8   77           INI1:     LD   (HL),A   
08C9   2C                     INC   L   
08CA   F2 C8 08               JP   P,ini1   ; +00h to +7Fh
08CD                          ENDIF      
08CD                          IF   CPM   
08CD   21 08 01               LD   HL,vecs   ; the RST routines go down into page zero
08D0   11 08 00               LD   DE,0008h   
08D3   01 2C 00               LD   BC,vecend-vecs   
08D6   ED B0                  LDIR      
08D8                          ENDIF      
08D8                          IF   CPM*EDITOR   
08D8   CD 98 08               CALL   load   ; the file named on the command line
08DB   C3 43 06               JP   edit0   
08DE                          ENDIF      
08DE                          IF   CPM*(1-EDITOR)   
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:      LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
                              JP   st2   
08DE                          ENDIF      
08DE                          IF   CPM   
08DE                             ; RAM pages, after the image
08DE                RSPAGE:   EQU   (imgend + 255) / 256   
08DE                DSPAGE:   EQU   RSPAGE + 1   
08DE                LETPAGE:   EQU   RSPAGE + 2   
08DE                PROG:     EQU   LETPAGE*256 + 256   
08DE                          ENDIF      
08DE                IMGEND:      


