                              ROL   0FFh,X   
                              SEC      
                              LDA   0FEh,X   
                              SBC   D0   
                              TAY      
                              LDA   0FFh,X   
                              SBC   D1   
                              BCC   uv2   
                              STA   0FFh,X   
                              STY   0FEh,X   
                              INC   0,X   
                    UV2:         
                              ASL   0,X   
                              ROL   1,X   
                              ROL   0FEh,X   
                              ROL   0FFh,X   
                              SEC      
                              LDA   0FEh,X   
                              SBC   D0   
                              TAY      
                              LDA   0FFh,X   
                              SBC   D1   
                              BCC   uv3   
                              STA   0FFh,X   
                              STY   0FEh,X   
                              INC   0,X   
                    UV3:         
                              ASL   0,X   
                              ROL   1,X   
                              ROL   0FEh,X   
                              ROL   0FFh,X   
                              SEC      
                              LDA   0FEh,X   
                              SBC   D0   
                              TAY      
                              LDA   0FFh,X   
                              SBC   D1   
                              BCC   uv4   
                              STA   0FFh,X   
                              STY   0FEh,X   
                              INC   0,X   
                    UV4:         
