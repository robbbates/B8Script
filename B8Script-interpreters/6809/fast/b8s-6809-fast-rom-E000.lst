E1EB                             ;  Handlers that must start in the second range (unchecked build).
E1EB                             ; =============================================================================
E1EB                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
E1EB                             ; the matching ")".
E1EB   EC C1        H_OPEN:   LDD   ,U++   
E1ED                          IF   (1-CHECKED)*(1-QK)   
                              BEQ   skip   ; tail call: skip ends in RTS
E1ED                          ENDIF      
E1ED                          IF   QK*(1-CHECKED)   
                              LBEQ   skip   ; (base: in the tail)
E1ED                          ENDIF      
E1ED                          IF   CHECKED   
E1ED   10 27 FF 7F            LBEQ   opf   ; checked: skip, and check the closer
E1F1                          ENDIF      
E1F1   35 10                  PULS   X   
E1F3   34 20                  PSHS   Y   
E1F5   6E 84                  JMP   ,X   
E1F7                             ; 22h pushes the address of the text after it and skips the string.
E1F7                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
E1F7                             ; the next character, so "/"" does not end it. Leaves A = 22h. (The checked
E1F7                             ; build's is after skip.)
E1F7                          IF   1-CHECKED   
                    H_STR:    PSHU   Y   
                              FCB   8Ch   ; (CMPX #: steps over the LEAY)
                    SS0:      LEAY   1,Y   
                    SKIPSTR:   LDA   ,Y+   
                              CMPA   #"/"   
                              BEQ   ss0   
                              CMPA   #22h   
                              BNE   skipstr   
                              RTS      
E1F7                          ENDIF      
E1F7   AE C4        H_CFETCH:   LDX   ,U   ; ","
E1F9   4F                     CLRA      
E1FA   E6 84        CF1:      LDB   ,X   
E1FC   ED C4                  STD   ,U   
E1FE   39                     RTS      
E1FF                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
E1FF                             ; drops it and carries on.
E1FF   EC C1        H_CLOSE:   LDD   ,U++   
