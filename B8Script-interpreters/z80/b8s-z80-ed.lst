0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Spec: docs/b8script.md (2026-11-21).
0000                             ; 
0000                             ;  Three switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    EDITOR   1 = with a small line editor built in (see the end of this
0000                             ;                 file). It goes with either setting of the other two.
0000                             ;    CHECKED  0 = no checks (spec: the programmer is responsible)
0000                             ;             1 = starts with every variable at 0 and every word undefined,
0000                             ;                 and stops on every error in the spec's table (and Ctrl-C)
0000                             ;                 with a four-line report: the letter and the place as line
0000                             ;                 and column, the text there, and both stacks. See `error`.
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   0   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   0   ; 1 = checked build
0000                EDITOR:   EQU   1   ; 1 = with the line editor
0000                EDGEN:    EQU   EDITOR*(1-CPM)   ; (the generic build with the editor)
0000                TABP0:    EQU   EDGEN*(1-CHECKED)   ; (the build with its table in page zero)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    HL'  return-stack pointer (the alternate HL). Entries are 2 bytes; the
0000                             ;         stack grows down. Only rpop and rpushn (and the checks) touch it.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  One-byte calls. The routines used most are reached with RST, one byte
0000                             ;  instead of three:
0000                             ; 
0000                             ;    RST 08h  rpop    pop the return stack into DE
0000                             ;    RST 18h  drop    drop TOS, then next character     (ends a handler)
0000                             ;    RST 20h  neg16   HL = -HL
0000                             ;    RST 28h  putc    print A
0000                             ;    RST 30h  next    next character                    (ends a handler)
0000                             ; 
0000                             ;  RST 18h and RST 30h never return: an RST is a CALL, so the first thing
0000                             ;  each of them does is POP DE to throw the return address away.
0000                             ; 
0000                             ;  The CP/M build can't own page zero, so the block from `vecs` to `vecend`
0000                             ;  (image addresses 0108h-0133h) is copied to 0008h-0033h when it starts. The
0000                             ;  code in that block is written to work at either place.
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (the top four bytes of the page are spare,
0000                             ;             so a full stack runs two bytes into the page below)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch, interpreter variables in the gaps, and the -n? line buffer
0000                             ;             at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack has a guard band: the data stack can
0000                             ;  overrun by a cell or two (and the calls made while it is full, the error
0000                             ;  report's included) into the top 32 bytes of the return-stack page, which
0000                             ;  are never used, and the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
                    BDOS:     EQU   0005h   
                    BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IF   CPM*(1-EDITOR)   
                    EXIT:     EQU   0000h   ; warm boot
0000                          ENDIF      
0000                          IFN   CPM   
0000                             ; ---- generic machine: edit these to suit -----------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The zero flag must match A
0000                             ;   (end the routine with OR A / RET).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                             ;   KEY and CONOUT must preserve BC, DE, HL and HL'.
0000                RSPAGE:   EQU   80h   ; 8000h return stack
0000                DSPAGE:   EQU   81h   ; 8100h data stack
0000                LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
0000                PROG:     EQU   8300h   ; where the loader puts the program text
0000                HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
0000                BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)   
                    EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                          ENDIF      
0000                          IF   EDITOR   
0000                EXIT:     EQU   edit   ; a program that ends goes back to the editor
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                KEYBUF:   EQU   LET+36h   ;   around machine code; a held-back key;
0000                NPEND:    EQU   LET+38h   ;   minus the address of the program's end
0000                             ;   (the heap"s first byte), for the checked "_'
0000                LBHDR:    EQU   LET+7Eh   ; CP/M BDOS 10 header: max, count
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FCh   ; empty data stack. The four bytes above it
0000                             ; are spare: a character can pop two cells
0000                             ; too many before the checked build sees it,
0000                             ; and the next call must not land on the
0000                             ; letter cells.
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is the start of the .COM file, and 0108h-0133h is also copied to
0000                             ;  page zero (see the header).
0000                             ; =============================================================================
0000                          .ORG   BASE   
0000                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              XOR   A   ; 00  reset. (This byte, AFh, is also what an
0000                          ENDIF      ;     undefined word runs into: see e_hi.)
0000                          IF   1-EDGEN   
                              LD   SP,DSTOP   ; 00  reset, or the start of the .COM file
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)   
                              LD   BC,PROG   ; 03  the IP
                              JR   st0   ; 06  (the rest of the startup is close by)
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              JR   init   ; 04  (the rest of the startup is close by)
                              DW   0   ; 06  spare
0000                          ENDIF      
0000                          IF   EDGEN   
0000   AF                     XOR   A   ; 00  reset: no program yet
0001   32 00 83               LD   (PROG),A   
0004                          ENDIF      
0004                          IF   EDGEN*(1-CHECKED)   
0004   C3 E7 02               JP   edit   ; 04
0007                          ENDIF      
0007                          IF   EDGEN*CHECKED   
                              JP   init   ; 04  (and no key held back)
0007                          ENDIF      
0007                          IF   EDGEN   
0007   00                     NOP      ; 07  spare
0008                          ENDIF      
0008                          IF   CPM   
                              JP   start   ; 03
                              DW   0   ; 06  spare
0008                          ENDIF      
0008                VECS:        
0008                             ; ---- RST 08h: rpop: pop the return stack into DE ---------------------------
0008   D9           RPOP:     EXX      ; 08
0009   5E                     LD   E,(HL)   
000A   23                     INC   HL   
000B   56                     LD   D,(HL)   
000C   23                     INC   HL   
000D   D5                     PUSH   DE   ; across to the main registers
000E   D9                     EXX      
000F   D1                     POP   DE   
0010   C9                     RET      ; 10  (so RST 10h is not used)
0011                             ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
0011   C6 21        CTL:      ADD   A,21h   ; 11  back to c; zero only for NUL
0013   20 1C                  JR   NZ,next0   ;     the rest are ignored
0015   C3 E7 02     ENDPROG:   JP   EXIT   ;     the program has ended
0018                             ; ---- RST 18h: drop TOS, then next ------------------------------------------
0018   D1           RST18:    POP   DE   ; 18  discard the RST's return address
0019   E1                     POP   HL   ;     new TOS = NOS
001A   18 15                  JR   nx   
001C   E5           H_FROMR:   PUSH   HL   ; 1C  "}" return stack to TOS
001D   CF                     RST   08h   
001E   EB                     EX   DE,HL   
001F   F7                     RST   30h   
0020                             ; ---- RST 20h: neg16: HL = -HL (keeps BC, DE) -------------------------------
0020   AF           NEG16:    XOR   A   ; 20
0021   95                     SUB   L   
0022   6F                     LD   L,A   
0023   9F                     SBC   A,A   
0024   94                     SUB   H   
0025   67                     LD   H,A   
0026   C9                     RET      
0027   00                     NOP      ; 27  spare
0028                             ; ---- RST 28h: putc: print A (keeps BC, DE, HL, HL') ------------------------
0028                RST28:       
0028                          IFN   CPM   
0028   C3 03 FF     PUTC:     JP   CONOUT   ; 28
002B                          ENDIF      
002B                          IF   CPM   
                              JP   putc   ; 28
002B                          ENDIF      
002B   E9           JPHL:     JP   (HL)   ; 2B  (for the machine-code call)
002C   E3           H_TOR:    EX   (SP),HL   ; 2C  "{" TOS to the return stack: the new TOS
002D   C3 CC 00               JP   rpushn   ;     comes up, the old one goes across
0030                             ; ---- RST 30h: next character -----------------------------------------------
0030   D1           RST30:    POP   DE   ; 30  discard the RST's return address
0031                NX:          
0031                          IF   CPM   
                              JP   next0   ; (this copy runs in page zero)
0031                          ENDIF      
0031                VECEND:      
0031                             ; =============================================================================
0031                             ;  The inner loop: read one character and sort it by range.
0031                             ; 
0031                             ;    00h          end of program
0031                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0031                             ;    30h-39h      digit: read a whole number
0031                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0031                             ;    61h-7Ah      a-z: push the address of that letter's cell
0031                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0031                             ; =============================================================================
0031                NEXT0:       
0031                          IF   CHECKED   
                              CALL   chkstk   ; both stacks are checked once per character
0031                          ENDIF      
0031   0A                     LD   A,(BC)   
0032   03                     INC   BC   
0033   D6 21                  SUB   21h   ; A = c - 21h
0035   38 DA                  JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
0037   FE 0F                  CP   0Fh   
0039   38 22                  JR   C,punct   ; 21h-2Fh: PTAB index 0-14
003B   D6 0F                  SUB   0Fh   ; A = c - 30h
003D   FE 0A                  CP   0Ah   
003F   38 75                  JR   C,digit   ; 30h-39h
0041   FE 11                  CP   11h   
0043   38 16                  JR   C,p3a   ; 3Ah-40h
0045   D6 11                  SUB   11h   ; A = c - 41h
0047   FE 1A                  CP   1Ah   
0049   38 77                  JR   C,upper   ; 41h-5Ah: A = letter index 0-25
004B   FE 20                  CP   20h   
004D   38 0A                  JR   C,p5b   ; 5Bh-60h
004F   FE 3A                  CP   3Ah   
0051   38 69                  JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0053   FE 3E                  CP   3Eh   
0055                          IF   1-CHECKED   
0055   30 DA                  JR   NC,next0   ; 7Fh-FFh: ignored
0057                          ENDIF      
0057                          IF   CHECKED   
                              JR   Z,next0   ; 7Fh, DEL: ignored
                              JP   NC,e_hi   ; 80h-FFh: reserved
0057                          ENDIF      
0057   D6 1A                  SUB   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
0059   D6 09        P5B:      SUB   9   ; 5Bh-60h: -4 in all, index 22-27
005B   C6 05        P3A:      ADD   A,5   ; 3Ah-40h: index 15-21
005D                .macro PTABLE,
005D                             ; 
005D                 DB      h_store & 0FFh  ; !
005D                 DB      h_str & 0FFh    ; "
005D                 DB      h_num & 0FFh    ; #
005D                 DB      h_print & 0FFh  ; $
005D                 DB      h_swap & 0FFh   ; %
005D                 DB      h_and & 0FFh    ; &
005D                 DB      h_emit & 0FFh   ; '
005D                 DB      h_open & 0FFh   ; (
005D                 DB      h_close & 0FFh  ; )
005D                 DB      h_mul & 0FFh    ; *
005D                 DB      h_add & 0FFh    ; +
005D                 DB      h_cfetch & 0FFh ; ,
005D                 DB      h_sub & 0FFh    ; -
005D                 DB      h_cstore & 0FFh ; .
005D                 DB      h_div & 0FFh    ; /
005D                 DB      h_dup & 0FFh    ; :
005D                 DB      h_drop & 0FFh   ; ;
005D                 DB      h_lt & 0FFh     ; <
005D                 DB      h_eq & 0FFh     ; =
005D                 DB      h_gt & 0FFh     ; >
005D                 DB      h_key & 0FFh    ; ?
005D                 DB      h_fetch & 0FFh  ; @
005D                 DB      h_def & 0FFh    ; [
005D                 DB      h_break & 0FFh  ; \
005D                 DB      h_ret & 0FFh    ; ]
005D                 DB      h_xor & 0FFh    ; ^
005D                 DB      h_alloc & 0FFh  ; _
005D                 DB      h_grave & 0FFh  ; `
005D                 DB      h_tor & 0FFh    ; {
005D                 DB      h_or & 0FFh     ; |
005D                 DB      h_fromr & 0FFh  ; }
005D                 DB      h_not & 0FFh    ; ~
005D                .endm
005D                 
005D                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
005D                             ; untouched, and A, DE free.
005D   C6 6A        PUNCT:    ADD   A,PTAB & 0FFh   ; PTAB never crosses a page
005F   5F                     LD   E,A   
0060   16 00                  LD   D,PTAB / 256   ; (0 if the table is in page zero)
0062   FE 80                  CP   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
0064   1A                     LD   A,(DE)   
0065   5F                     LD   E,A   ; the handler's low byte
0066                          IF   (1-CPM)*(1-TABP0)   
                              LD   D,0   
0066                          ENDIF      
0066                          IFN   CPM   
0066   CB 12                  RL   D   ; its page: 0 + carry
0068                          ENDIF      
0068                          IF   CPM   
                              LD   D,1   
                              JR   NC,pu1   
                              INC   D   ; its page: 1 + carry
                    PU1:         
0068                          ENDIF      
0068   D5                     PUSH   DE   ; jump to it; the stack is balanced again
0069   C9                     RET      ;   when the handler starts
006A                             ; The rest of the startup: here so that the generic reset code can reach it
006A                             ; with JR. st0: find the program's NUL; the heap starts after it.
006A                             ; (The editor build has its own copy of this, next to the editor.)
006A                             ; A checked build first clears the lower half of the letter page (A = 0):
006A                             ; every variable starts at 0, every word cell holds 0000h, the address an
006A                             ; undefined word is caught at (see e_hi), and no key is held back.
006A                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                    INIT:     LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
                              LD   BC,PROG   ; the IP
006A                          ENDIF      
006A                          IF   (1-CPM)*(1-EDITOR)   
                    ST0:      LD   H,B   
                              LD   L,C   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
006A                          ENDIF      
006A                          IF   1-EDITOR   
                    ST2:      LD   (HEAP),HL   
006A                          ENDIF      
006A                          IF   CHECKED*(1-EDITOR)   
                              RST   20h   ; minus the heap"s first address: "_' may not
                              LD   (NPEND),HL   ;   release below it
006A                          ENDIF      
006A                          IF   1-EDITOR   
                              EXX      
                              LD   HL,RSTOP   ; the return stack is empty
                              EXX      
                              RST   30h   ; (its return address is thrown away)
006A                          ENDIF      
006A                             ; In the unchecked generic editor build the table is here, in the first
006A                             ; page, which saves loading D twice. (The other builds have no room for it
006A                             ; here: theirs is further down.)
006A                          IF   TABP0   
006A                PTAB:        
006A                          ;*Macro unroll:  PTABLE
006A   9E                     DB   h_store & 0FFh   
006B   A3                     DB   h_str & 0FFh   
006C   BE                     DB   h_num & 0FFh   
006D   AA                     DB   h_print & 0FFh   
006E   99                     DB   h_swap & 0FFh   
006F   41                     DB   h_and & 0FFh   
0070   BB                     DB   h_emit & 0FFh   
0071   1D                     DB   h_open & 0FFh   
0072   25                     DB   h_close & 0FFh   
0073   62                     DB   h_mul & 0FFh   
0074   38                     DB   h_add & 0FFh   
0075   DC                     DB   h_cfetch & 0FFh   
0076   30                     DB   h_sub & 0FFh   
0077   9B                     DB   h_cstore & 0FFh   
0078   76                     DB   h_div & 0FFh   
0079   97                     DB   h_dup & 0FFh   
007A   9D                     DB   h_drop & 0FFh   
007B   49                     DB   h_lt & 0FFh   
007C   58                     DB   h_eq & 0FFh   
007D   4A                     DB   h_gt & 0FFh   
007E   C4                     DB   h_key & 0FFh   
007F   18                     DB   h_fetch & 0FFh   
0080   FB                     DB   h_def & 0FFh   
0081   EE                     DB   h_break & 0FFh   
0082   EA                     DB   h_ret & 0FFh   
0083   8A                     DB   h_xor & 0FFh   
0084   9D                     DB   h_alloc & 0FFh   
0085   D4                     DB   h_grave & 0FFh   
0086   2C                     DB   h_tor & 0FFh   
0087   92                     DB   h_or & 0FFh   
0088   1C                     DB   h_fromr & 0FFh   
0089   9A                     DB   h_not & 0FFh   
008A                PTABEND:      
008A                          ENDIF      
008A                             ; =============================================================================
008A                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
008A                             ;  (00bbIGFuZCA= are up among the RST routines.) The machine-code call, exec,
008A                             ;  is here too: it belongs to "`" and makes the page come out right.
008A                             ; =============================================================================
008A   D1           H_XOR:    POP   DE   
008B   7C                     LD   A,H   
008C   AA                     XOR   D   
008D   67                     LD   H,A   
008E   7D                     LD   A,L   
008F   AB                     XOR   E   
0090   6F                     LD   L,A   
0091   F7                     RST   30h   
0092   D1           H_OR:     POP   DE   
0093   7C                     LD   A,H   
0094   B2                     OR   D   
0095   67                     LD   H,A   
0096   7D                     LD   A,L   
0097   B3                     OR   E   
0098   6F                     LD   L,A   
0099   F7                     RST   30h   
009A   E7           H_NOT:    RST   20h   ; ~x = -x - 1
009B   2B                     DEC   HL   
009C   F7                     RST   30h   
009D                             ; "_" ( n -- addr ): the heap pointer moves by n, a signed count (the add is
009D                             ; the same either way); TOS is the old pointer.
009D   ED 5B 7C 82  H_ALLOC:   LD   DE,(HEAP)   
00A1                          IF   CHECKED*CPM   
                              LD   A,H   ; the count's sign, for chkhp
00A1                          ENDIF      
00A1   19                     ADD   HL,DE   ; the new top
00A2                          IF   CHECKED   
                              CALL   chkhp   
00A2                          ENDIF      
00A2   22 7C 82               LD   (HEAP),HL   
00A5   EB                     EX   DE,HL   
00A6   F7                     RST   30h   
00A7   D9           EXEC:     EXX      
00A8   22 34 82               LD   (RSAVE),HL   ; machine code may change the alternates
00AB   D9                     EXX      
00AC   CD 2B 00               CALL   jphl   
00AF   D9                     EXX      
00B0   2A 34 82               LD   HL,(RSAVE)   
00B3   D9                     EXX      
00B4   E1                     POP   HL   
00B5   F7                     RST   30h   
00B6                             ; ---- the letters and digits (here, in the middle, so that the inner loop's
00B6                             ; ---- short jumps reach them, and the handlers after them reach rpushn) ------
00B6                             ; Digits: step back onto the first digit and read the whole number.
00B6   E5           DIGIT:    PUSH   HL   
00B7   0B                     DEC   BC   
00B8   CD 39 02               CALL   rdnum   
00BB   F7                     RST   30h   
00BC                             ; a-z: push the cell's address (the cell is the variable)
00BC   E5           LOWER:    PUSH   HL   
00BD   87                     ADD   A,A   
00BE   6F                     LD   L,A   
00BF   26 82                  LD   H,LETPAGE   
00C1   F7                     RST   30h   
00C2                             ; A-Z: call the word. The return address (the IP after the letter) goes on
00C2                             ; the return stack, and the IP becomes the address in the letter's cell.
00C2   C5           UPPER:    PUSH   BC   ; the return address, for rpushn
00C3   EB                     EX   DE,HL   ; park TOS
00C4   87                     ADD   A,A   
00C5   6F                     LD   L,A   
00C6   26 82                  LD   H,LETPAGE   ; HL -> cell
00C8   4E                     LD   C,(HL)   
00C9   2C                     INC   L   
00CA   46                     LD   B,(HL)   ; IP = the word's body
00CB   EB                     EX   DE,HL   ; TOS back, and fall into rpushn
00CC                             ; rpushn: move the top cell of the data stack (in memory) to the return
00CC                             ; stack, then next. Everything that pushes the return stack ends here.
00CC                RPUSHN:      
00CC                          IF   CHECKED   
                              CALL   chkbrk   ; Ctrl-C is checked at every word call, block
00CC                          ENDIF      ;   entry, loop-back and "{"
00CC   D9                     EXX      
00CD   D1                     POP   DE   
00CE   2B                     DEC   HL   
00CF   72                     LD   (HL),D   
00D0   2B                     DEC   HL   
00D1   73                     LD   (HL),E   
00D2   D9                     EXX      
00D3   F7                     RST   30h   
00D4                             ; ---- machine code: the grave -----------------------------------------------
00D4                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
00D4                             ; are stored from addr until a non-hex character; then a RET (C9h) is
00D4                             ; written and its address is left. An odd last digit is consumed and dropped.
00D4                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
00D4                             ; code is entered by CALL with the data stack above the return address; it
00D4                             ; must keep BC, and on return the top cell becomes the new TOS.
00D4   CD 96 02     H_GRAVE:   CALL   hexc   
00D7   30 CE                  JR   NC,exec   
00D9   77           HX1:      LD   (HL),A   ; the high digit goes in first ...
00DA   CD 96 02               CALL   hexc   
00DD   30 08                  JR   NC,hx2   ; odd digit: consumed, and the RET below
00DF   ED 6F                  RLD      ;   overwrites it
00E1   23                     INC   HL   ; ... and RLD shifts it up under the low one
00E2   CD 96 02               CALL   hexc   
00E5   38 F2                  JR   C,hx1   
00E7   36 C9        HX2:      LD   (HL),0C9h   ; (never range-checked: the spec says so)
00E9   F7                     RST   30h   
00EA                             ; ---- where the two pages meet ----------------------------------------------
00EA                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
00EA                             ; are in falling code order for this), and where exactly differs between the
00EA                             ; builds: NPG1 follows. Every handler below these four must start in the
00EA                             ; second page, and every one above in the first; chktab.py checks both.
00EA                             ; "]" returns: pop an address and jump to it.
00EA   CF           H_RET:    RST   08h   
00EB   42                     LD   B,D   
00EC   4B                     LD   C,E   
00ED   F7           BRK1:     RST   30h   
00EE                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
00EE                             ; drops the block start, "]" returns. No closer at all ends the program.
00EE   7C           H_BREAK:   LD   A,H   
00EF   B5                     OR   L   
00F0   E1                     POP   HL   
00F1   28 FA                  JR   Z,brk1   
00F3   CD 5B 02               CALL   skip   
00F6   B7                     OR   A   ; skip returns 0 for ")"
00F7   20 F1                  JR   NZ,h_ret   
00F9   CF           RDROP:    RST   08h   
00FA   F7                     RST   30h   
00FB                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
00FB                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
00FB                             ; the body"s address instead. Either way it then skips to the matching "]'.
00FB                             ; (The unchecked build takes anything that is not a letter as the space; the
00FB                             ; checked build stops on it.)
00FB   0A           H_DEF:    LD   A,(BC)   
00FC   03                     INC   BC   
00FD   D6 41                  SUB   "A"   ; a letter gives 0-25 or 32-57: lowercase
00FF   5F                     LD   E,A   ;   lands 64 bytes up
0100   E6 DF                  AND   0DFh   ; fold case
0102   FE 1A                  CP   26   
0104   30 0B                  JR   NC,def2   ; not a letter
0106   CB 23                  SLA   E   
0108   16 82                  LD   D,LETPAGE   ; DE -> cell
010A   79                     LD   A,C   
010B   12                     LD   (DE),A   
010C   1C                     INC   E   
010D   78                     LD   A,B   
010E   12                     LD   (DE),A   
010F   18 03                  JR   skipnx   
0111                DEF2:        
0111                          IF   CHECKED   
                              LD   A,E   
                              CP   " "-"A"+256   
                              JP   NZ,e_brack   ; anything but a letter or a space
0111                          ENDIF      
0111   E5                     PUSH   HL   ; an anonymous block: push its address
0112   60                     LD   H,B   
0113   69                     LD   L,C   
0114                SKIPNX:      
0114                          IF   CHECKED   
                              DEC   BC   ; back onto the letter, so that skip finds its
0114                          ENDIF      ;   opener, the "[", just before where it starts
0114   CD 5B 02     SKIPO:    CALL   skip   
0117   F7                     RST   30h   
0118   5E           H_FETCH:   LD   E,(HL)   ; "@"
0119   23                     INC   HL   
011A   56                     LD   D,(HL)   
011B   EB                     EX   DE,HL   
011C   F7                     RST   30h   
011D                             ; =============================================================================
011D                             ;  Handlers that must start in the image's second page.
011D                             ;  "?" is the last (with "," inside it), so its long tail may run past that
011D                             ;  page.
011D                             ; =============================================================================
011D                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
011D                             ; the matching ")".
011D   7C           H_OPEN:   LD   A,H   
011E   B5                     OR   L   
011F   E1                     POP   HL   
0120   28 F2                  JR   Z,skipo   
0122   C5                     PUSH   BC   ; the block starts at the IP
0123   18 A7                  JR   rpushn   
0125                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
0125                             ; drops it and carries on.
0125   7C           H_CLOSE:   LD   A,H   
0126   B5                     OR   L   
0127   E1                     POP   HL   
0128   28 CF                  JR   Z,rdrop   
012A   CF                     RST   08h   ; pop the block start ...
012B   42                     LD   B,D   
012C   4B                     LD   C,E   
012D   C5                     PUSH   BC   
012E   18 9C                  JR   rpushn   ; ... and push it back
0130                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
0130                             ; "-" has two jobs: directly before a digit it starts a negative number.
0130   0A           H_SUB:    LD   A,(BC)   
0131   D6 30                  SUB   "0"   
0133   FE 0A                  CP   10   
0135   38 04                  JR   C,negnum   
0137   E7                     RST   20h   ; a - b = a + (-b): fall into "+"
0138   D1           H_ADD:    POP   DE   
0139   19                     ADD   HL,DE   
013A   F7                     RST   30h   
013B   E5           NEGNUM:   PUSH   HL   ; a negative number: read it, negate it
013C   CD 39 02               CALL   rdnum   
013F   E7                     RST   20h   
0140   F7                     RST   30h   
0141   D1           H_AND:    POP   DE   
0142   7C                     LD   A,H   
0143   A2                     AND   D   
0144   67                     LD   H,A   
0145   7D                     LD   A,L   
0146   A3                     AND   E   
0147   6F                     LD   L,A   
0148   F7                     RST   30h   
0149                             ; Signed compares. Both are "HL < DE" for the right pair: "<" swaps the two
0149                             ; cells first. Flipping both sign bits turns a signed compare into an
0149                             ; unsigned one (and XOR clears the carry for SBC); SBC HL,HL then turns the
0149                             ; carry into -1 or 0 with no branch.
0149   E3           H_LT:     EX   (SP),HL   ; a < b: HL = a, and b is popped next
014A   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
014B   7C                     LD   A,H   
014C   EE 80                  XOR   80h   
014E   67                     LD   H,A   
014F   7A                     LD   A,D   
0150   EE 80                  XOR   80h   
0152   57                     LD   D,A   
0153   ED 52                  SBC   HL,DE   ; carry if HL < DE
0155   ED 62        TF:       SBC   HL,HL   ; carry -> -1 or 0
0157   F7                     RST   30h   
0158   D1           H_EQ:     POP   DE   
0159   B7                     OR   A   
015A   ED 52                  SBC   HL,DE   
015C   7C                     LD   A,H   
015D   B5                     OR   L   
015E   FE 01                  CP   1   ; carry only if a - b = 0
0160   18 F3                  JR   tf   
0162                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept. The
0162                             ; multiplier shifts up through A:C.
0162   D1           H_MUL:    POP   DE   ; DE = multiplicand
0163   C5                     PUSH   BC   
0164   7C                     LD   A,H   
0165   4D                     LD   C,L   ; A:C = multiplier
0166   21 00 00               LD   HL,0   
0169   06 10                  LD   B,16   
016B   29           MUL1:     ADD   HL,HL   
016C   CB 21                  SLA   C   
016E   17                     RLA      
016F   30 01                  JR   NC,mul2   
0171   19                     ADD   HL,DE   
0172   10 F7        MUL2:     DJNZ   mul1   
0174   C1                     POP   BC   
0175   F7                     RST   30h   
0176                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
0176                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
0176                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
0176                             ; stops on it.
0176                H_DIV:       
0176                          IF   CHECKED   
                              LD   A,H   
                              OR   L   
                              JP   Z,e_zero   
0176                          ENDIF      
0176   D1                     POP   DE   ; DE = a, HL = b
0177   C5                     PUSH   BC   ; free BC for udiv
0178   D5                     PUSH   DE   ; a, for r's sign
0179   7A                     LD   A,D   
017A   AC                     XOR   H   
017B   F5                     PUSH   AF   ; S flag = sign of q
017C   CB 7C                  BIT   7,H   
017E   C4 20 00               CALL   NZ,neg16   ; HL = |b|
0181   EB                     EX   DE,HL   
0182   CB 7C                  BIT   7,H   
0184   C4 20 00               CALL   NZ,neg16   ; HL = |a|, DE = |b|
0187   CD 13 02               CALL   udiv   ; HL = q, DE = r
018A   F1                     POP   AF   
018B   FC 20 00               CALL   M,neg16   ; q's sign
018E   EB                     EX   DE,HL   ; HL = r, DE = q
018F   F1                     POP   AF   ; A = a's high byte
0190   B7                     OR   A   
0191   FC 20 00               CALL   M,neg16   ; r's sign
0194   C1                     POP   BC   
0195   D5                     PUSH   DE   ; q under r
0196   F7                     RST   30h   
0197                             ; ---- stack and storage -----------------------------------------------------
0197   E5           H_DUP:    PUSH   HL   ; ":"
0198   F7                     RST   30h   
0199   E3           H_SWAP:   EX   (SP),HL   ; "%"
019A   F7                     RST   30h   
019B                             ; (The checked build tests the address before it takes the value off the
019B                             ; stack, so that an error report shows both.)
019B                H_CSTORE:      ; "." ( c addr -- )
019B                          IF   CHECKED   
                              CALL   chkst   
019B                          ENDIF      
019B   D1                     POP   DE   
019C   73                     LD   (HL),E   
019D   DF           H_DROP:   RST   18h   ; ";" is this one byte
019E                H_STORE:      ; "!" ( n addr -- )
019E                          IF   CHECKED   
                              CALL   chkst   
019E                          ENDIF      
019E   D1                     POP   DE   
019F   73                     LD   (HL),E   
01A0   23                     INC   HL   
01A1   72                     LD   (HL),D   
01A2   DF                     RST   18h   
01A3                             ; ---- console ---------------------------------------------------------------
01A3                             ; 22h pushes the address of the text after it and skips the string.
01A3   E5           H_STR:    PUSH   HL   
01A4   60                     LD   H,B   
01A5   69                     LD   L,C   
01A6   CD 50 02               CALL   skipstr   
01A9                          IF   CHECKED   
                              OR   A   ; 0: the text ran out before the closing quote
                              JP   Z,e_quote   
01A9                          ENDIF      
01A9   F7                     RST   30h   
01AA                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character
01AA                             ; clears that character"s bit 6 (/M is CR, /` is space; "/" and ""' have no
01AA                             ; bit 6, so // and /" give themselves).
01AA                          IF   1-CHECKED   
01AA   7E           H_PRINT:   LD   A,(HL)   
01AB   23                     INC   HL   
01AC   FE 22                  CP   22h   
01AE   28 0D                  JR   Z,pr9   
01B0   FE 2F                  CP   "/"   
01B2   20 04                  JR   NZ,pr1   
01B4   7E                     LD   A,(HL)   
01B5   23                     INC   HL   
01B6   E6 BF                  AND   0BFh   
01B8   EF           PR1:      RST   28h   
01B9   18 EF                  JR   h_print   
01BB                          ENDIF      
01BB                          IF   CHECKED   
                                 ; (The checked build has the loop as a routine, prstr, which the error
                                 ; report uses too. The address is kept on the stack meanwhile: a report
                                 ; shows the stack as it was before the "$".)
                    H_PRINT:   PUSH   HL   
                              CALL   prstr   
                              POP   DE   
                              RST   18h   
01BB                          ENDIF      
01BB   7D           H_EMIT:   LD   A,L   ; "'"
01BC   EF                     RST   28h   
01BD   DF           PR9:      RST   18h   
01BE                             ; "#" prints TOS as a signed decimal number, with no space after it.
01BE   C5           H_NUM:    PUSH   BC   
01BF   CD 7C 02               CALL   psgn   
01C2   C1                     POP   BC   
01C3   DF                     RST   18h   
01C4                             ; "?" ( n -- c ) or ( -n -- addr )
01C4                             ;   n > 0: wait about n ms for a key; 0 if none came
01C4                             ;   n = 0: wait for a key
01C4                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
01C4                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
01C4   CB 7C        H_KEY:    BIT   7,H   
01C6   20 19                  JR   NZ,line   
01C8   1E 28        KT1:      LD   E,MSLOOP   ; one millisecond, roughly
01CA   CD 06 FF     KT2:      CALL   getk   
01CD   20 0E                  JR   NZ,kt3   
01CF   1D                     DEC   E   
01D0   20 F8                  JR   NZ,kt2   
01D2   7C                     LD   A,H   ; 0? never counts down: it waits
01D3   B5                     OR   L   
01D4   28 F2                  JR   Z,kt1   
01D6   2B                     DEC   HL   
01D7   7C                     LD   A,H   
01D8   B5                     OR   L   
01D9   20 ED                  JR   NZ,kt1   ; A = 0 if the time ran out
01DB   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
01DC   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
01DD   6F           KT3:      LD   L,A   
01DE   26 00                  LD   H,0   
01E0   F7                     RST   30h   
01E1                          IF   CPM   
                                 ; CP/M: BDOS 10 does the editing (the spec allows the platform's
                                 ; own line editor). It doesn't store the CR, so it is added here.
                    LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
                              ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
                              SBC   A,A   
                              AND   L   ; (0 for a count that is too big)
                              XOR   127   ; A = the count, 127 at most
01E1                          ENDIF      
01E1                          IF   CPM*EDITOR   
                              CALL   rdline   ; (the editor calls rdline too)
                              LD   L,LINEBUF & 0FFh   
                              RST   30h   
                                 ; rdline: read a line of at most A characters; HL -> the CR that ends it
                    RDLINE:      
01E1                          ENDIF      
01E1                          IF   CPM   
                              LD   (LBHDR),A   
                              LD   DE,LBHDR   
                              LD   A,10   
                              CALL   bdosx   
                              LD   HL,LBHDR+1   
                              LD   A,(HL)   ; the count typed (0-127)
                              INC   L   ; HL = LINEBUF, whose low byte is 80h:
                              ADD   A,L   ;   adding the count to L can't carry
                              LD   L,A   
                              LD   (HL),13   
01E1                          ENDIF      
01E1                          IF   CPM*(1-EDITOR)   
                              LD   L,LINEBUF & 0FFh   
                              RST   30h   
01E1                          ENDIF      
01E1                          IF   CPM*EDITOR   
                              RET      
01E1                          ENDIF      
01E1                          IFN   CPM   
01E1                             ; Generic: Backspace takes the last character back (and is echoed as
01E1                             ; it is), CR ends (stored, not echoed), every other key is stored and
01E1                             ; echoed until the line is full. The line buffer starts at offset 80h
01E1                             ; of its page, so L alone is the place in the line: D holds the L of
01E1                             ; a full line.
01E1                          ENDIF      
01E1                          IFN   CPM   
01E1   11 7F 00     LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
01E4   19                     ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
01E5   9F                     SBC   A,A   
01E6   A5                     AND   L   ; (0 for a count that is too big)
01E7   2F                     CPL      
01E8   57                     LD   D,A   ; D = the L of a full line: 80h + count, FFh
01E9                          ENDIF      ;   at most
01E9                          IF   EDGEN   
01E9   CD EF 01               CALL   rdline   ; (the editor calls rdline too)
01EC   2E 80                  LD   L,LINEBUF & 0FFh   
01EE   F7                     RST   30h   
01EF                             ; rdline: read a line that is full when L reaches D; HL -> the CR that ends it
01EF                RDLINE:      
01EF                          ENDIF      
01EF                          IFN   CPM   
01EF   21 80 82               LD   HL,LINEBUF   
01F2   CD 06 FF     LN2:      CALL   getk   
01F5   28 FB                  JR   Z,ln2   
01F7   FE 0D                  CP   13   
01F9   28 16                  JR   Z,ln5   
01FB   FE 08                  CP   8   
01FD   28 0B                  JR   Z,ln4   
01FF   5F                     LD   E,A   
0200   7D                     LD   A,L   
0201   BA                     CP   D   
0202   28 EE                  JR   Z,ln2   ; full
0204   73                     LD   (HL),E   
0205   2C                     INC   L   
0206   7B                     LD   A,E   
0207   EF           LN3:      RST   28h   
0208   18 E8                  JR   ln2   
020A   2D           LN4:      DEC   L   ; Backspace: one back, and echo it,
020B   FA 07 02               JP   M,ln3   ;   unless the line was empty (L left the
020E   2C                     INC   L   ;   upper half of the page)
020F   18 E1                  JR   ln2   
0211   77           LN5:      LD   (HL),A   ; the CR
0212                          ENDIF      
0212                          IF   (1-CPM)*(1-EDITOR)   
                              LD   L,LINEBUF & 0FFh   
                              RST   30h   
0212                          ENDIF      
0212                          IF   EDGEN   
0212   C9                     RET      
0213                          ENDIF      
0213                             ; =============================================================================
0213                             ;  More routines (no handler starts past this point)
0213                             ; =============================================================================
0213                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
0213                             ; Uses A, BC; the caller saves the IP. The dividend shifts up through A:C
0213                             ; while the quotient bits arrive at the bottom of C.
0213                             ; Dividing by 2 is one shift (the spec wants that fast).
0213   7B           UDIV:     LD   A,E   
0214   EE 02                  XOR   2   
0216   B2                     OR   D   
0217   20 07                  JR   NZ,udv0   
0219   CB 3C                  SRL   H   
021B   CB 1D                  RR   L   ; the quotient
021D   8F                     ADC   A,A   
021E   5F                     LD   E,A   ; the remainder: the bit that fell out (D is 0)
021F   C9                     RET      
0220   7C           UDV0:     LD   A,H   
0221   4D                     LD   C,L   
0222   21 00 00               LD   HL,0   
0225   06 10                  LD   B,16   
0227   CB 21        UDV1:     SLA   C   
0229   17                     RLA      
022A   ED 6A                  ADC   HL,HL   
022C   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
022E   30 02                  JR   NC,udv2   ;   always fits in 16 bits
0230   19                     ADD   HL,DE   ; too much: put it back, and cancel the
0231   0D                     DEC   C   ;   INC below
0232   0C           UDV2:     INC   C   ; a quotient bit
0233   10 F2                  DJNZ   udv1   
0235   EB                     EX   DE,HL   ; DE = remainder
0236   67                     LD   H,A   
0237   69                     LD   L,C   ; HL = quotient
0238   C9                     RET      
0239                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
0239                             ; non-digit. Values wrap at 16 bits, as the spec says.
0239   21 00 00     RDNUM:    LD   HL,0   
023C   0A           RDN1:     LD   A,(BC)   
023D   D6 30                  SUB   "0"   
023F   FE 0A                  CP   10   
0241   D0                     RET   NC   
0242   03                     INC   BC   
0243   54                     LD   D,H   
0244   5D                     LD   E,L   
0245   29                     ADD   HL,HL   
0246   29                     ADD   HL,HL   
0247   19                     ADD   HL,DE   
0248   29                     ADD   HL,HL   ; HL * 10
0249   5F                     LD   E,A   
024A   16 00                  LD   D,0   
024C   19                     ADD   HL,DE   
024D   18 ED                  JR   rdn1   
024F                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
024F                             ; the next character, so "/"" does not end it. Leaves A = 22h.
024F                          IF   1-CHECKED   
024F   03           SS0:      INC   BC   
0250   0A           SKIPSTR:   LD   A,(BC)   
0251   03                     INC   BC   
0252   FE 2F                  CP   "/"   
0254   28 F9                  JR   Z,ss0   
0256   FE 22                  CP   22h   
0258   20 F6                  JR   NZ,skipstr   
025A   C9                     RET      
025B                          ENDIF      
025B                          IF   CHECKED   
                                 ; The checked build never steps over a NUL: if the text runs out first it
                                 ; returns A = 0 with the IP on the NUL.
                    SKIPSTR:   LD   A,(BC)   
                              OR   A   
                              RET   Z   
                              INC   BC   
                              CP   22h   
                              RET   Z   
                              CP   "/"   
                              JR   NZ,skipstr   
                              LD   A,(BC)   ; the escaped character
                              OR   A   
                              RET   Z   
                              INC   BC   
                              JR   skipstr   
025B                          ENDIF      
025B                             ; skip: read past text to the closer at this level, and return A = 0 if it
025B                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
025B                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
025B                             ; no closer; anything else that runs into the NUL had unbalanced brackets
025B                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
025B                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
025B                             ; 
025B                             ; The checked build also looks at the character the skip was started by,
025B                             ; which is always the one just before where it starts: "(" must end at ")",
025B                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
025B                             ; quote counts as running into it. "\" takes either closer. IX keeps the
025B                             ; place where the skip started, for the report.
025B                SKIP:        
025B                          IF   CHECKED   
                              PUSH   BC   
                              POP   IX   
                              DEC   BC   
                              LD   A,(BC)   
                              INC   BC   
                              LD   E,A   ; E = the opener: ( [ or \
025B                          ENDIF      
025B   16 00                  LD   D,0   
025D   14           SK3:      INC   D   ; an opener: one deeper
025E   0A           SK1:      LD   A,(BC)   
025F                          IF   1-CHECKED   
025F   03                     INC   BC   
0260   B7                     OR   A   
0261   CA 15 00               JP   Z,endprog   
0264                          ENDIF      
0264                          IF   CHECKED   
                              OR   A   
                              JR   Z,sk6   ; (the IP stays on the NUL)
                              INC   BC   
0264                          ENDIF      
0264   FE 22                  CP   22h   
0266   CC 50 02               CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
0269   D6 28                  SUB   "("   ;   (or 0, and then the NUL is read next)
026B   28 F0                  JR   Z,sk3   
026D   3D                     DEC   A   ; ")"
026E   28 08                  JR   Z,sk4   
0270   D6 32                  SUB   "["-")"   
0272   28 E9                  JR   Z,sk3   
0274   FE 02                  CP   "]"-"["   
0276   20 E6                  JR   NZ,sk1   
0278   15           SK4:      DEC   D   
0279                          IF   1-CHECKED   
0279   C8                     RET   Z   ; the closer at this level
027A   18 E2                  JR   sk1   
027C                          ENDIF      
027C                          IF   CHECKED   
                              JR   NZ,sk1   
                              LD   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
                              XOR   E   ;   opener is 0 for "(" and 1 for "[", and only
                              AND   6   ;   "\" has bit 2: so this is 2 for the wrong
                              CP   2   ;   closer, and only then
                              LD   A,D   
                              RET   NZ   
                              JR   sk7   
                    SK6:      BIT   2,E   ; the text ran out:
                              JP   NZ,endprog   ;   "\" with no closer ends the program
                    SK7:      PUSH   IX   ; N. The place is the opener
                              POP   BC   
                              LD   A,"N"   
                              JP   errp   ; (errp drops skip's return address)
027C                          ENDIF      
027C                             ; psgn: print HL as a signed number. Uses BC.
027C   CB 7C        PSGN:     BIT   7,H   
027E   28 04                  JR   Z,pdec   
0280   3E 2D                  LD   A,"-"   
0282   EF                     RST   28h   
0283   E7                     RST   20h   
0284                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
0284                             ; Uses BC.
0284   11 0A 00     PDEC:     LD   DE,10   
0287   CD 13 02               CALL   udiv   ; HL = HL / 10, E = the last digit
028A   7B                     LD   A,E   
028B   F5                     PUSH   AF   
028C   7C                     LD   A,H   
028D   B5                     OR   L   
028E   C4 84 02               CALL   NZ,pdec   
0291   F1                     POP   AF   
0292   C6 30                  ADD   A,"0"   
0294   EF                     RST   28h   
0295   C9                     RET      
0296                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
0296                             ; and return its value in A with the carry set; otherwise leave the IP and
0296                             ; return with the carry clear.
0296   0A           HEXC:     LD   A,(BC)   
0297   D6 30                  SUB   "0"   
0299   FE 0A                  CP   10   
029B   38 09                  JR   C,hc1   
029D   E6 DF                  AND   0DFh   
029F   D6 11                  SUB   11h   
02A1   FE 06                  CP   6   
02A3   D0                     RET   NC   
02A4   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
02A6   03           HC1:      INC   BC   
02A7   C9                     RET      
02A8                             ; =============================================================================
02A8                             ;  Dispatch table: the low byte of each handler's address, in code order
02A8                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
02A8                             ;  It must not cross a page (the dispatcher only adds to its low byte).
02A8                             ; =============================================================================
02A8                             ; The handlers of the first NPG1 characters start in the image's second page.
02A8                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
02A8                             ; differs between the builds, so the count is worked out here.
02A8                             ; (One division to a line: asm80 only rounds down when it stores a value.)
02A8                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
02A8                PGBRK:    EQU   (h_break-BASE)/256   
02A8                PGDEF:    EQU   (h_def-BASE)/256   
02A8                PGFET:    EQU   (h_fetch-BASE)/256   
02A8                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
02A8                          IF   1-TABP0   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
02A8                          ENDIF      
02A8                             ; =============================================================================
02A8                             ;  Console layer: getk returns a waiting key in A (zero flag clear), or
02A8                             ;  A = 0 with the zero flag set when none is waiting. putc (RST 28h) prints
02A8                             ;  A. Both keep BC, DE, HL and HL". In the generic build they are the host"s
02A8                             ;  KEY and CONOUT routines themselves.
02A8                             ; =============================================================================
02A8                          IF   (1-CPM)*(1-CHECKED)   
02A8                GETK:     EQU   KEY   ; the host's routine does the whole job
02A8                          ENDIF      
02A8                          IF   CHECKED   
                    GETK:     PUSH   HL   ; a key held back by the break check goes
                              LD   HL,KEYBUF   ;   first, and is taken out of the buffer
                              LD   A,(HL)   
                              LD   (HL),0   
                              POP   HL   
                              OR   A   
                              RET   NZ   
02A8                          ENDIF      
02A8                          IF   (1-CPM)*CHECKED   
                              JP   KEY   
02A8                          ENDIF      
02A8                          IF   CPM*(1-CHECKED)   
                    GETK:        
02A8                          ENDIF      
02A8                          IF   CPM   
                              LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
                                 ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
                                 ; printing and could swallow a key that BDOS 6 then never sees.
                    PUTC:     PUSH   DE   
                              PUSH   HL   
                              LD   E,A   
                              LD   A,6   
                              CALL   bdosx   
                              POP   HL   
                              POP   DE   
                              OR   A   ; (for getk)
                              RET      
                                 ; bdosx: call BDOS function A with DE, keeping BC and HL'
                    BDOSX:    PUSH   BC   
                              EXX      
                              PUSH   HL   
                              EXX      
                              LD   C,A   
                              CALL   BDOS   
                              EXX      
                              POP   HL   
                              EXX      
                              POP   BC   
                              RET      
02A8                          ENDIF      
02A8                             ; =============================================================================
02A8                             ;  Checked build: the checks and the error report
02A8                             ; =============================================================================
02A8                          IF   CHECKED   
                                 ; chkst: stop unless HL is in the program's own space: from the letter page
                                 ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
                                 ; whatever lies above the limit are safe. Memory above the heap top but
                                 ; below the limit is the program's own: Tiny BASIC keeps its lines there.
                                 ; It is the page of HL + 1 that is tested, so that one test serves both
                                 ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
                                 ; Keeps HL and BC.
                    CHKST:    INC   HL   
                              LD   A,H   
                              DEC   HL   
                              CP   LETPAGE   
                              JR   C,chs1   
02A8                          ENDIF      
02A8                          IF   CHECKED*(1-CPM)   
                              CP   HEAPLIM   
                              RET   C   
02A8                          ENDIF      
02A8                          IF   CHECKED*CPM   
                              LD   E,A   
                              LD   A,(0007h)   ; the BDOS page is the heap limit
                              DEC   A   
                              CP   E   
                              RET   NC   
02A8                          ENDIF      
02A8                          IF   CHECKED   
                    CHS1:     JP   e_store   
                                 ; chkhp: HL = the new heap top, DE = the old one, the carry is from adding
                                 ; the count. Stop if the top is not below the limit page, or is below the
                                 ; program's end.
                    CHKHP:       
02A8                          ENDIF      
02A8                          IF   CHECKED*CPM   
                                 ; With this much room a top that wrapped round can land back in
                                 ; range, so the add is tested too: growing (A, the count's high
                                 ; byte, is positive) must not carry, and releasing must.
                              RRA      ; the carry comes in above the sign:
                              ADD   A,40h   ;   bit 7 = carry XOR sign
                              ADD   A,A   
                              JR   C,e_heap   
                              LD   A,(0007h)   
                              DEC   A   
                              CP   H   
                              JR   C,e_heap   
02A8                          ENDIF      
02A8                          IF   CHECKED*(1-CPM)   
                                 ; (Here the program's space is under 32K, so a top that wrapped
                                 ; round always falls outside it.)
                              LD   A,H   
                              CP   HEAPLIM   
                              JR   NC,e_heap   
02A8                          ENDIF      
02A8                          IF   CHECKED   
                              PUSH   DE   
                              EX   DE,HL   
                              LD   HL,(NPEND)   
                              ADD   HL,DE   ; carry: at or above the program's end
                              EX   DE,HL   
                              POP   DE   
                              RET   C   
                    E_HEAP:   OR   A   ; put the count back in TOS for the report
                              SBC   HL,DE   
                              JP   e_heap1   
                                 ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
                                 ; "$", and the error report's texts). A NUL first is an error: Q.
                    PRSTR:    LD   A,(HL)   
                              INC   HL   
                              CP   22h   
                              RET   Z   
                              OR   A   
                              JR   Z,e_dollar   
                              CP   "/"   
                              JR   NZ,prs1   
                              LD   A,(HL)   
                              INC   HL   
                              AND   0BFh   
                    PRS1:     RST   28h   
                              JR   prstr   
                    E_DOLLAR:   POP   DE   ; "$" ran into a NUL: drop the return address,
                              POP   HL   ;   and put the string's address back in TOS
                              LD   A,"Q"   
                              JP   error   
                                 ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
                                 ; pnl: the same, on a new line.
                    PNL:      LD   A,13   
                              RST   28h   
                              LD   A,10   
                              RST   28h   
                    PMSG:     EX   (SP),HL   
                              CALL   prstr   
                              EX   (SP),HL   
                              RET      
                                 ; chkstk: both stacks are checked once per character, not in every handler.
                                 ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
                                 ; the constant carries if it is above (cells were popped that were never
                                 ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
                                 ; a character late at most: the bytes above DSTOP and the guard band below
                                 ; the page take what happens meanwhile. DE is free between characters.
                    CHKSTK:   EX   DE,HL   
                              LD   HL,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
                              ADD   HL,SP   
                              EX   DE,HL   
                              JR   C,e_under   
                              INC   D   
                              JR   NZ,e_over   
                              EXX      ; the return stack: in its page (or it has
                              LD   A,H   ;   overflowed), and not above its empty
                              CP   RSPAGE   ;   position (an underflow stays inside the
                              LD   A,L   ;   page, in the guard band)
                              EXX      
                              JR   NZ,e_rover   
                              CP   RSTOP&0FFh+1   
                              RET   C   
                              EXX      ; return stack underflow: it counts as empty
                              LD   HL,RSTOP   
                              EXX      
                              LD   A,"r"   
                              JR   errp   
                    E_ROVER:   LD   A,"R"   ; return stack overflow
                              DB   11h   ; (LD DE,nn hides the next entry)
                    E_OVER:   LD   A,"S"   ; data stack overflow
                              JR   errp   
                    E_UNDER:   LD   SP,DSTOP   ; data stack underflow: it counts as empty
                              LD   A,"s"   
                              JR   error   
                                 ; chkbrk: a waiting key is read now; Ctrl-C stops the program, anything
                                 ; else is held for the next "?".
                    CHKBRK:   CALL   getk   
                              RET   Z   
                              CP   3   
                              JR   Z,e_break   
                              LD   (KEYBUF),A   
                              RET      
                                 ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
                                 ; was never defined still holds 0000h, and the byte there is a reserved one
                                 ; in every build (AFh or C3h): if the IP is in page zero, this was a call of
                                 ; an undefined word. The call is undone, so the place is the call itself.
                    E_HI:     INC   B   
                              DJNZ   e_resv   ; (B is as it was, and is not 0)
                              RST   08h   
                              LD   B,D   
                              LD   C,E   
                              LD   A,"U"   
                              JR   error   
                                 ; Error entries. Each loads its letter and then hides the next entry inside
                                 ; a 3-byte LD DE,nn (the 11h), so they all fall through to `error`.
                    E_BREAK:   LD   A,"B"   ; Ctrl-C (found inside chkbrk)
                              DB   11h   
                    E_HEAP1:   LD   A,"H"   ; heap (found inside chkhp)
                              DB   11h   
                    E_STORE:   LD   A,"O"   ; a store outside the program's space (chkst)
                                 ; errp: an error found inside a routine: drop its return address first.
                    ERRP:     POP   DE   
                              JR   error   
                    E_QUOTE:   LD   B,H   ; an unclosed string: HL is its address, one
                              LD   C,L   ;   past the opening quote, which is the place
                              LD   A,"Q"   
                              DB   11h   
                    E_RESV:   LD   A,"X"   ; a reserved byte outside a string
                              DB   11h   
                    E_ZERO:   LD   A,"Z"   ; dividing by zero
                              DB   11h   
                    E_BRACK:   LD   A,"W"   ; bad character after [
                                 ; error: the report, then the end. A = the letter, BC = one past the place,
                                 ; HL = TOS, and both stacks as the report is to show them:
                                 ; 
                                 ;   Err X @ line,col
                                 ;   up to 16 characters of the text from the place
                                 ;   Stk n: the top 8 cells at most, bottom to top
                                 ;   Rtn n
                    ERROR:    PUSH   HL   ; now the whole data stack is in memory
                              LD   E,A   
                              CALL   pnl   
                              DB   "Err ",22h   
                              LD   A,E   
                              RST   28h   
                              CALL   pmsg   
                              DB   " @ ",22h   
                              DEC   BC   ; BC = the place
                                 ; The line and column. A place below the program is in the line
                                 ; buffer: line 0. Otherwise count the LFs from the program's start;
                                 ; DE = the line's number, HL = where it starts.
                              LD   HL,LINEBUF   
                              LD   DE,0   
                              LD   A,B   
                              CP   PROG/256   
                              JR   C,er3   
                              INC   H   
                              LD   L,E   ; HL = PROG
                    ER1:      INC   DE   ; a new line starts at HL
                              PUSH   HL   
                    ER2:      LD   A,L   
                              SUB   C   
                              LD   A,H   
                              SBC   A,B   
                              JR   NC,er2x   ; reached the place
                              LD   A,(HL)   
                              INC   HL   
                              CP   10   
                              JR   NZ,er2   
                              POP   AF   
                              JR   er1   
                    ER2X:     POP   HL   
                    ER3:      PUSH   BC   
                              PUSH   HL   
                              EX   DE,HL   
                              CALL   pdec   ; the line
                              LD   A,","   
                              RST   28h   
                              POP   DE   
                              POP   HL   
                              PUSH   HL   
                              OR   A   
                              SBC   HL,DE   
                              INC   HL   
                              CALL   pdec   ; the column
                              CALL   pnl   
                              DB   22h   
                              POP   HL   ; the text, as it is: 16 characters, or fewer
                              LD   B,16   ;   if the line or the program ends first
                    ER4:      LD   A,(HL)   
                              INC   HL   
                              OR   A   
                              JR   Z,er5   
                              CP   13   
                              JR   Z,er5   
                              CP   10   
                              JR   Z,er5   
02A8                          ENDIF      
02A8                          IF   CHECKED*CPM   
                              CP   1Ah   ; (the ^Z that pads a file's last record ends
                              JR   Z,er5   ;   the text too: some terminals clear the
02A8                          ENDIF      ;   screen on it)
02A8                          IF   CHECKED   
                              RST   28h   
                              DJNZ   er4   
                    ER5:      CALL   pnl   
                              DB   "Stk ",22h   
                              LD   HL,DSTOP-2   ; (the cell at DSTOP-2 was pushed with the
                              OR   A   ;   first value and holds nothing)
                              SBC   HL,SP   
                              CALL   phalf   ; the depth
                              LD   A,":"   
                              RST   28h   
                              LD   A,C   
                              CP   9   
                              JR   C,er6   
                              CALL   pmsg   
                              DB   " ...",22h   
                              LD   C,8   
                    ER6:      LD   H,0   ; C = the number of cells to show
                              LD   L,C   
                              ADD   HL,HL   
                              ADD   HL,SP   ; HL -> just above the deepest of them
                              INC   C   
                    ER7:      DEC   C   
                              JR   Z,er8   
                              DEC   HL   
                              LD   D,(HL)   
                              DEC   HL   
                              LD   E,(HL)   
                              PUSH   HL   
                              PUSH   BC   
                              LD   A," "   
                              RST   28h   
                              EX   DE,HL   
                              CALL   psgn   
                              POP   BC   
                              POP   HL   
                              JR   er7   
                    ER8:      CALL   pnl   
                              DB   "Rtn ",22h   
                              EXX      
                              PUSH   HL   
                              EXX      
                              POP   DE   
                              LD   HL,RSTOP   
                              OR   A   
                              SBC   HL,DE   
                              CALL   phalf   
                              CALL   pnl   
                              DB   22h   
                              JP   endprog   
                                 ; phalf: print half of HL, and leave it in C
                    PHALF:    SRL   H   
                              RR   L   
                              PUSH   HL   
                              CALL   pdec   
                              POP   BC   
                              RET      
02A8                          ENDIF      
02A8                             ; =============================================================================
02A8                             ;  The line editor (EDITOR = 1)
02A8                             ; 
02A8                             ;  The interpreter starts here, and a program that ends comes back here. Type
02A8                             ;  a line and press Return:
02A8                             ; 
02A8                             ;    n text    put the text in as line n; the lines from n on move down.
02A8                             ;              A number past the end, or 0, adds the line at the end.
02A8                             ;    n         take line n out
02A8                             ;    0         run the program
02A8                             ;    -n        list the program from line n on (-1 lists all of it). Any key
02A8                             ;              stops the list until another key is pressed; Ctrl-C ends it.
02A8                             ;    anything else is run at once, as B8Script. (Start such a line with a
02A8                             ;    space if it would begin with a digit or a minus sign.)
02A8                             ; 
02A8                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
02A8                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
02A8                             ;  125 characters, the line number and the one character after it included;
02A8                             ;  that character is not stored. The text is kept as it is typed, each line
02A8                             ;  ending in CR LF, at PROG. Nothing is checked.
02A8                             ; 
02A8                             ;  With CPM = 1 the file named on the command line is the program to start
02A8                             ;  with (no file, or no such file: no program). Lines are read by BDOS 10, so
02A8                             ;  its editing keys work, and Ctrl-C as the first key of a line goes back to
02A8                             ;  CP/M. Nothing is written back: there is no command to save.
02A8                             ; 
02A8                             ;  With CHECKED = 1 a program that is stopped (an error, or Ctrl-C) prints
02A8                             ;  its report and comes back here, with both stacks empty. The place is a
02A8                             ;  line and column of the program; in a line typed here it is line 0.
02A8                             ; 
02A8                             ;  Things to know:
02A8                             ;    - Reset empties the program (generic builds).
02A8                             ;    - Words and variables last from one line to the next. A word's address
02A8                             ;      points into the program, so run the program again after editing it.
02A8                             ;    - Nothing is printed between a program's output and what is typed next.
02A8                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
02A8                             ;      a line that calls -n? and carries on afterwards runs what was typed.
02A8                             ;      (The stored program never comes back to the line, so it may.)
02A8                             ; =============================================================================
02A8                          IF   EDGEN*CHECKED   
                                 ; Reset (A = 0): clear the lower half of the letter page. Every variable
                                 ; starts at 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi), and no key is held back.
                    INIT:     LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
                              JR   edit   
02A8                          ENDIF      
02A8                          IF   EDITOR   
02A8                             ; -n: list from line n. DE = the number of the line at HL.
02A8   03           LIST:     INC   BC   
02A9   CD 39 02               CALL   rdnum   ; HL = n
02AC   E5                     PUSH   HL   
02AD   CD 4C 03               CALL   find   
02B0   D1                     POP   DE   
02B1   7E           LI1:      LD   A,(HL)   
02B2   B7                     OR   A   
02B3   28 32                  JR   Z,edit   ; the end of the text
02B5   CD 06 FF               CALL   getk   
02B8   28 0D                  JR   Z,li3   ; no key: carry on
02BA   FE 03                  CP   3   
02BC   28 29                  JR   Z,edit   ; Ctrl-C
02BE   CD 06 FF     LI2:      CALL   getk   ; any other key: wait for one more
02C1   28 FB                  JR   Z,li2   
02C3   FE 03                  CP   3   
02C5   28 20                  JR   Z,edit   
02C7   E5           LI3:      PUSH   HL   
02C8   D5                     PUSH   DE   
02C9   EB                     EX   DE,HL   
02CA   CD 84 02               CALL   pdec   ; the line's number,
02CD   3E 20                  LD   A," "   
02CF   EF                     RST   28h   ;   a space,
02D0   D1                     POP   DE   
02D1   E1                     POP   HL   
02D2   13                     INC   DE   
02D3   CD 64 03               CALL   prl   ;   and the line
02D6   18 D9                  JR   li1   
02D8                             ; Take line n (in HL) out: copy everything after it down over it.
02D8   CD 4C 03     DEL:      CALL   find   
02DB   54                     LD   D,H   
02DC   5D                     LD   E,L   
02DD   CD 5A 03               CALL   nxl   ; HL -> the next line
02E0   7E           DE1:      LD   A,(HL)   
02E1   12                     LD   (DE),A   
02E2   23                     INC   HL   
02E3   13                     INC   DE   
02E4   B7                     OR   A   
02E5   20 F9                  JR   NZ,de1   ; and fall into the editor
02E7   31 FC 81     EDIT:     LD   SP,DSTOP   
02EA                          ENDIF      
02EA                          IF   EDITOR*CPM*CHECKED   
                                 ; A key that the break check held back while a program ran is let
                                 ; go: BDOS 10 would not see it, and it would turn up in the next
                                 ; program that asked for a key. (This also serves at the start.)
                              XOR   A   
                              LD   (KEYBUF),A   
02EA                          ENDIF      
02EA                          IF   EDGEN   
02EA   16 FD                  LD   D,0FDh   ; 125 characters at most
02EC                          ENDIF      
02EC                          IF   EDITOR*CPM   
                              LD   A,125   
02EC                          ENDIF      
02EC                          IF   EDITOR   
02EC   CD EF 01               CALL   rdline   ; HL -> the CR that ended the line
02EF   2C                     INC   L   
02F0   36 0A                  LD   (HL),10   ; a LF after it,
02F2   2D                     DEC   L   
02F3   CD 64 03               CALL   prl   ; (print the CR LF: a new line)
02F6   36 00                  LD   (HL),0   ;   and a NUL after that
02F8   E5                     PUSH   HL   ; the end of what was typed
02F9   01 80 82               LD   BC,LINEBUF   
02FC   0A                     LD   A,(BC)   
02FD   FE 2D                  CP   "-"   
02FF   28 A7                  JR   Z,list   
0301   CD 39 02               CALL   rdnum   ; HL = the number it starts with, BC -> after
0304   79                     LD   A,C   ; C is still 80h if there was no number:
0305   87                     ADD   A,A   ;   only then is twice it 0
0306   28 0C                  JR   Z,st0   ; no number: run the line where it is
0308   0A                     LD   A,(BC)   
0309   D6 0D                  SUB   13   
030B   20 19                  JR   NZ,ins   ; text follows the number
030D   B4                     OR   H   ; the number alone:
030E   B5                     OR   L   
030F   20 C7                  JR   NZ,del   ;   not 0: take that line out
0311   01 00 83               LD   BC,PROG   ;   0: run the program
0314                             ; st0: start running at BC. The heap starts after the stored program's NUL.
0314   E1           ST0:      POP   HL   ; (the end of what was typed: the stack is empty)
0315   21 00 83               LD   HL,PROG   
0318   AF                     XOR   A   
0319   BE           ST1:      CP   (HL)   
031A   23                     INC   HL   
031B   20 FC                  JR   NZ,st1   
031D   22 7C 82               LD   (HEAP),HL   
0320                          ENDIF      
0320                          IF   EDITOR*CHECKED   
                              RST   20h   ; minus the heap"s first address: "_' may not
                              LD   (NPEND),HL   ;   release below it
0320                          ENDIF      
0320                          IF   EDITOR   
0320   D9                     EXX      
0321   21 E0 80               LD   HL,RSTOP   ; the return stack is empty
0324   D9                     EXX      
0325   F7                     RST   30h   ; (its return address is thrown away)
0326                             ; Put the typed text in as line n (in HL): open a gap of its length there,
0326                             ; CR and LF included, and copy it in.
0326   CD 4C 03     INS:      CALL   find   ; HL -> where it goes
0329   03                     INC   BC   ; step over the one character after the number
032A   D1                     POP   DE   ; the end of what was typed
032B   7B                     LD   A,E   
032C   91                     SUB   C   ; A = the length of the text, with its CR LF
032D   C5                     PUSH   BC   ; the text
032E   4F                     LD   C,A   
032F   06 00                  LD   B,0   
0331   C5                     PUSH   BC   ; its length
0332   54                     LD   D,H   
0333   5D                     LD   E,L   ; DE = where it goes
0334   AF                     XOR   A   
0335   4F                     LD   C,A   ; BC = 0: CPIR looks as far as it needs to
0336   ED B1                  CPIR      ; HL -> one past the program's NUL
0338   ED 52                  SBC   HL,DE   ; the number of bytes to move up, NUL included
033A   44                     LD   B,H   
033B   4D                     LD   C,L   
033C   19                     ADD   HL,DE   
033D   2B                     DEC   HL   ; HL -> the NUL
033E   EB                     EX   DE,HL   
033F   E3                     EX   (SP),HL   ; HL = the length; where it goes is kept
0340   E5                     PUSH   HL   
0341   19                     ADD   HL,DE   ; the NUL's new place
0342   EB                     EX   DE,HL   
0343   ED B8                  LDDR      ; move the rest of the program up
0345   C1                     POP   BC   ; the length
0346   D1                     POP   DE   ; where it goes
0347   E1                     POP   HL   ; the text
0348   ED B0                  LDIR      
034A   18 9B                  JR   edit   
034C                             ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
034C                             ; of the text if there are fewer lines (or the number is 0). Keeps BC.
034C   EB           FIND:     EX   DE,HL   
034D   21 00 83               LD   HL,PROG   
0350   1B           FI1:      DEC   DE   
0351   7A                     LD   A,D   
0352   B3                     OR   E   
0353   C8                     RET   Z   
0354   CD 5A 03               CALL   nxl   
0357   20 F7                  JR   NZ,fi1   
0359   C9                     RET      
035A                             ; nxl: step HL over one line, to just past its LF (and return not-zero), or
035A                             ; stop at the NUL that ends the text (and return zero).
035A   7E           NXL:      LD   A,(HL)   
035B   B7                     OR   A   
035C   C8                     RET   Z   
035D   23                     INC   HL   
035E   FE 0A                  CP   10   
0360   20 F8                  JR   NZ,nxl   
0362   B7                     OR   A   
0363   C9                     RET      
0364                             ; prl: print the line at HL, to its LF; HL -> just past it.
0364   7E           PRL:      LD   A,(HL)   
0365   EF                     RST   28h   
0366   7E                     LD   A,(HL)   
0367   23                     INC   HL   
0368   FE 0A                  CP   10   
036A   20 F8                  JR   NZ,prl   
036C   C9                     RET      
036D                          ENDIF      
036D                             ; =============================================================================
036D                             ;  CP/M startup (the generic build starts at address 0: see st0)
036D                             ; =============================================================================
036D                          IF   CPM   
                                 ; The RAM pages follow the image; the heap may grow to the BDOS.
                    START:       
036D                          ENDIF      
036D                          IF   CPM*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
                                 ; is held back.
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
036D                          ENDIF      
036D                          IF   CPM   
                              LD   HL,vecs   ; the RST routines go down into page zero
                              LD   DE,0008h   
                              LD   BC,vecend-vecs   
                              LDIR      
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:         
036D                          ENDIF      
036D                          IF   CPM*(1-EDITOR)   
                              LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
                              JP   st2   
036D                          ENDIF      
036D                          IF   CPM*EDITOR   
                                 ; The editor wants the text to end where the file's text ends: at
                                 ; the first ^Z (1Ah), which pads a text file's last record. One more
                                 ; goes after the last record, so the search always stops. And every
                                 ; line must end in LF: a last line without one is given a CR LF.
                              LD   (HL),1Ah   
                              LD   HL,PROG-1   
                              LD   A,10   ; (a file with no text needs nothing added)
                    TR1:      INC   HL   
                              LD   E,A   ; E = the character before this one
                              LD   A,(HL)   
                              CP   1Ah   
                              JR   NZ,tr1   
                              LD   A,E   
                              CP   10   
                              JR   Z,tr2   
                              LD   (HL),13   
                              INC   HL   
                              LD   (HL),10   
                              INC   HL   
                    TR2:      LD   (HL),0   
                              JP   edit   
036D                          ENDIF      
036D                          IF   CPM   
                                 ; RAM pages, after the image
                    RSPAGE:   EQU   (imgend + 255) / 256   
                    DSPAGE:   EQU   RSPAGE + 1   
                    LETPAGE:   EQU   RSPAGE + 2   
                    PROG:     EQU   LETPAGE*256 + 256   
036D                          ENDIF      
036D                IMGEND:      


