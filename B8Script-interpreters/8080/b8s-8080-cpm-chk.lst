02F8   CD 13 03               CALL   chkst   
02FB                          ENDIF      
02FB   73                     MOV   M,E   
02FC   CF                     RST   1   
02FD                             ; "_" ( n -- addr ): the heap pointer moves up by n; TOS is the old pointer.
02FD   EB           H_ALLOC:   XCHG      
02FE   2A 7C 08               LHLD   HEAP   
0301   E5                     PUSH   H   
0302   19                     DAD   D   
0303                          IF   CHECKED   
0303   DA F0 04               JC   e_heap   ; a negative count wraps: too big
0306   3A 3A 08               LDA   HLIM   
0309   3D                     DCR   A   
030A   BC                     CMP   H   
030B   DA F0 04               JC   e_heap   ; the new top must stay below the limit page
030E                          ENDIF      
030E   22 7C 08               SHLD   HEAP   
0311   E1                     POP   H   
0312   D7                     RST   2   
0313                          IF   CHECKED   
0313                             ; chkst: stop unless HL is in the program's own space: from the letter page
0313                             ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
0313                             ; whatever lies above the limit are safe. Memory above the heap top but
0313                             ; below the limit is the program's own: Tiny BASIC keeps its lines there.
0313                             ; Keeps every register.
0313   F5           CHKST:    PUSH   PSW   
0314   7C                     MOV   A,H   
0315   FE 08                  CPI   LETPAGE   
0317   DA 1F 03               JC   chk1   
031A   3A 3A 08               LDA   HLIM   
031D   3D                     DCR   A   
031E   BC                     CMP   H   
031F   DA F7 04     CHK1:     JC   e_store   
0322   F1                     POP   PSW   
0323   C9                     RET      
0324                          ENDIF      
0324                             ; =============================================================================
0324                             ;  Flow control
0324                             ; =============================================================================
0324                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
0324                             ; the matching ")".
0324   7C           H_OPEN:   MOV   A,H   
0325   B5                     ORA   L   
0326   CA 2F 03               JZ   op_f   
0329   50                     MOV   D,B   
032A   59                     MOV   E,C   
032B   CD DF 01               CALL   rpush   ; (HL, the flag, is dead here)
032E   CF                     RST   1   ; = POP H, RST 2: the flag is dead, so drop it
032F   E1           OP_F:     POP   H   
0330   CD 89 03     SKIPNX:   CALL   skip   
0333   D7                     RST   2   
0334                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
0334                             ; drops it and carries on.
0334   7C           H_CLOSE:   MOV   A,H   
0335   B5                     ORA   L   
0336   CA 44 03               JZ   rdrop   
0339                          IF   CHECKED   
0339   CD C5 04               CALL   chkbrk   ; Ctrl-C is checked at every loop-back
033C                          ENDIF      
033C   2A 34 08               LHLD   RSP   ; peek the block start
033F   4E                     MOV   C,M   
0340   23                     INX   H   
0341   46                     MOV   B,M   
0342   E1                     POP   H   
0343   D7                     RST   2   
0344   CD EA 01     RDROP:    CALL   rpop   ; (HL, the flag, is dead: NOS is next)
0347   CF                     RST   1   
0348                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
0348                             ; drops the block start, "]" returns. No closer at all ends the program.
0348   7C           H_BREAK:   MOV   A,H   
0349   B5                     ORA   L   
034A   C2 4E 03               JNZ   brk1   
034D   CF                     RST   1   
034E   CD 89 03     BRK1:     CALL   skip   
0351   FE 29                  CPI   ")"   
0353   CA 44 03               JZ   rdrop   
0356   E1                     POP   H   ; and fall into "]"
0357                             ; "]" returns: pop an address and jump to it.
0357   E5           H_RET:    PUSH   H   
0358   CD EA 01               CALL   rpop   
035B   44                     MOV   B,H   
035C   4D                     MOV   C,L   
035D   E1                     POP   H   
035E                          IF   CHECKED   
035E   CD C5 04               CALL   chkbrk   ; ... and at every word return
0361                          ENDIF      
0361   D7                     RST   2   
0362                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
0362                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
0362                             ; the body"s address instead. Either way it then skips to the matching "]'.
0362   0A           H_DEF:    LDAX   B   
0363   03                     INX   B   
0364   5F                     MOV   E,A   
0365   E6 DF                  ANI   0DFh   ; fold case
0367   D6 41                  SUI   "A"   
0369   FE 1A                  CPI   26   
036B   D2 7D 03               JNC   def2   ; not a letter
036E   7B                     MOV   A,E   
036F   D6 41                  SUI   "A"   ; 0-25 or 32-57: lowercase lands 64 bytes up
0371   87                     ADD   A   
0372   5F                     MOV   E,A   
0373   16 08                  MVI   D,LETPAGE   ; DE -> cell
0375   79                     MOV   A,C   
0376   12                     STAX   D   
0377   1C                     INR   E   
0378   78                     MOV   A,B   
0379   12                     STAX   D   
037A   C3 30 03               JMP   skipnx   
037D                DEF2:        
037D                          IF   CHECKED   
037D   7B                     MOV   A,E   
037E   FE 20                  CPI   " "   
0380   C2 FF 04               JNZ   e_brack   ; anything but a letter or a space
0383                          ENDIF      
0383   E5                     PUSH   H   ; an anonymous block: push its address
0384   60                     MOV   H,B   
0385   69                     MOV   L,C   
0386   C3 30 03               JMP   skipnx   
0389                             ; skip: read past text to the closer at this level, and return it in A.
0389                             ; Brackets of both kinds count together; strings are stepped over whole. A
0389                             ; NUL first ends the program (for "\" with no closer; anything else that runs
0389                             ; into the NUL had unbalanced brackets anyway). D counts the open levels,
0389                             ; starting at 1 for the one we are in.
0389   16 01        SKIP:     MVI   D,1   
038B   0A           SK1:      LDAX   B   
038C   03                     INX   B   
038D   B7                     ORA   A   
038E   CA 00 00               JZ   endprog   
0391   FE 22                  CPI   22h   
0393   CC B5 03               CZ   skipstr   ; leaves A = 22h, which matches nothing below
0396   FE 28                  CPI   "("   
0398   CA AF 03               JZ   sk3   
039B   FE 5B                  CPI   "["   
039D   CA AF 03               JZ   sk3   
03A0   FE 29                  CPI   ")"   
03A2   CA AA 03               JZ   sk4   
03A5   FE 5D                  CPI   "]"   
03A7   C2 8B 03               JNZ   sk1   
03AA   15           SK4:      DCR   D   
03AB   C8                     RZ      ; the closer at this level
03AC   C3 8B 03               JMP   sk1   
03AF   14           SK3:      INR   D   ; an opener: one deeper (the DCR below makes
03B0   14                     INR   D   ;   it +1 net, and can't reach zero)
03B1   C3 AA 03               JMP   sk4   
03B4                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
03B4                             ; the next character, so "/"" does not end it.
03B4   03           SS0:      INX   B   
03B5   0A           SKIPSTR:   LDAX   B   
03B6   03                     INX   B   
03B7   FE 2F                  CPI   "/"   
03B9   CA B4 03               JZ   ss0   
03BC   FE 22                  CPI   22h   
03BE   C2 B5 03               JNZ   skipstr   
03C1   C9                     RET      
03C2                             ; =============================================================================
03C2                             ;  Console
03C2                             ; =============================================================================
03C2                             ; 22h pushes the address of the text after it and skips the string.
03C2   E5           H_STR:    PUSH   H   
03C3   60                     MOV   H,B   
03C4   69                     MOV   L,C   
03C5   CD B5 03               CALL   skipstr   
03C8   D7                     RST   2   
03C9                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
03C9                             ; 40h-7Fh clears its bit 6 (/M is CR, /` is space); plus anything lower gives
03C9                             ; that character itself.
03C9   7E           H_PRINT:   MOV   A,M   
03CA   23                     INX   H   
03CB   FE 22                  CPI   22h   
03CD   CA E4 03               JZ   prdone   
03D0   FE 2F                  CPI   "/"   
03D2   C2 DE 03               JNZ   pr1   
03D5   7E                     MOV   A,M   
03D6   23                     INX   H   
03D7   FE 40                  CPI   40h   
03D9   DA DE 03               JC   pr1   
03DC   E6 BF                  ANI   0BFh   
03DE   CD B7 04     PR1:      CALL   putc   
03E1   C3 C9 03               JMP   h_print   
03E4   CF           PRDONE:   RST   1   
03E5   7D           H_EMIT:   MOV   A,L   ; "'"
03E6   CD B7 04               CALL   putc   
03E9   CF                     RST   1   
03EA                             ; "#" prints TOS as a signed decimal number, with no space after it.
03EA   7C           H_NUM:    MOV   A,H   
03EB   B7                     ORA   A   
03EC   F2 F7 03               JP   num1   
03EF   3E 2D                  MVI   A,"-"   
03F1   CD B7 04               CALL   putc   
03F4   CD 0F 02               CALL   neg16   
03F7   C5           NUM1:     PUSH   B   
03F8   CD FD 03               CALL   pdec   
03FB   C1                     POP   B   
03FC   CF                     RST   1   
03FD                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits)
03FD   11 0A 00     PDEC:     LXI   D,10   
0400   CD 7D 02               CALL   udiv   ; HL = HL / 10, BC = digit
0403   79                     MOV   A,C   
0404   F5                     PUSH   PSW   
0405   7C                     MOV   A,H   
0406   B5                     ORA   L   
0407   C4 FD 03               CNZ   pdec   
040A   F1                     POP   PSW   
040B   C6 30                  ADI   "0"   
040D   C3 B7 04               JMP   putc   
0410                             ; "?" ( n -- c ) or ( -n -- addr )
0410                             ;   n > 0: wait about n ms for a key; 0 if none came
0410                             ;   n = 0: wait for a key
0410                             ;   n < 0: read a line of at most -n characters (capped at CAP) with echo
0410   7C           H_KEY:    MOV   A,H   
0411   B7                     ORA   A   
0412   FA 39 04               JM   line   
0415   B5                     ORA   L   
0416   C2 23 04               JNZ   kt1   
0419                KW:          
0419                          IF   (1-CPM)*(1-CHECKED)   
                              CALL   CONIN   ; 0?: wait (the generic console can block)
0419                          ENDIF      
0419                          IF   1-(1-CPM)*(1-CHECKED)   
0419   CD A4 04               CALL   getk   ; 0?: wait
041C   CA 19 04               JZ   kw   
041F                          ENDIF      
041F   6F           KT3:      MOV   L,A   
0420   26 00                  MVI   H,0   
0422   D7                     RST   2   
0423   11 28 00     KT1:      LXI   D,MSLOOP   ; one millisecond, roughly
0426   CD A4 04     KT2:      CALL   getk   
0429   C2 1F 04               JNZ   kt3   
042C   1B                     DCX   D   
042D   7A                     MOV   A,D   
042E   B3                     ORA   E   
042F   C2 26 04               JNZ   kt2   
0432   2B                     DCX   H   
0433   7C                     MOV   A,H   
0434   B5                     ORA   L   
0435   C2 23 04               JNZ   kt1   
0438   D7                     RST   2   ; time ran out: HL is already 0
0439   CD 0F 02     LINE:     CALL   neg16   ; HL = the count
043C   7C                     MOV   A,H   
043D   B7                     ORA   A   
043E   C2 47 04               JNZ   ln0   
0441   7D                     MOV   A,L   
0442   FE 80                  CPI   CAP+1   
0444   DA 49 04               JC   ln1   
0447   3E 7F        LN0:      MVI   A,CAP   
0449                LN1:         
0449                          IF   CPM   
0449                             ; CP/M: BDOS 10 does the editing (the spec allows the platform's
0449                             ; own line editor). It doesn't store the CR, so it is added here.
0449   32 7E 08               STA   LBHDR   
044C   C5                     PUSH   B   
044D   11 7E 08               LXI   D,LBHDR   
0450   0E 0A                  MVI   C,10   
0452   CD 05 00               CALL   BDOS   
0455   C1                     POP   B   
0456   21 7F 08               LXI   H,LBHDR+1   
0459   7E                     MOV   A,M   ; count (0-127)
045A   23                     INX   H   ; HL = LINEBUF, whose low byte is 80h:
045B   E5                     PUSH   H   
045C   85                     ADD   L   ;   adding the count to L can't carry
045D   6F                     MOV   L,A   
045E   36 0D                  MVI   M,13   
0460   E1                     POP   H   
0461   D7                     RST   2   
0462                          ENDIF      
0462                          IFN   CPM   
                                 ; Generic: Backspace and DEL erase, CR ends (stored, not echoed),
                                 ; other control keys are ignored, and a full line takes only those.
                              PUSH   B   
                              MOV   C,A   ; C = max
                              MVI   B,0   ; B = length
                              LXI   H,LINEBUF   
0462                          ENDIF      
0462                LN2:         
0462                          IF   (1-CPM)*(1-CHECKED)   
                              CALL   CONIN   ; (the generic console can block)
0462                          ENDIF      
0462                          IF   (1-CPM)*CHECKED   
                              CALL   getk   
                              JZ   ln2   
0462                          ENDIF      
0462                          IFN   CPM   
                              CPI   13   
                              JZ   ln5   
                              CPI   8   
                              JZ   ln4   
                              CPI   7Fh   
                              JZ   ln4   
                              CPI   " "   
                              JC   ln2   
                              MOV   E,A   
                              MOV   A,B   
                              CMP   C   
                              JNC   ln2   ; full
                              MOV   M,E   
                              INX   H   
                              INR   B   
                              MOV   A,E   
                    LN3:      CALL   putc   
                              JMP   ln2   
                    LN4:      MOV   A,B   
                              ORA   A   
                              JZ   ln2   
                              DCR   B   
                              DCX   H   
                              MVI   A,8   
                              CALL   putc   
                              MVI   A," "   
                              CALL   putc   
                              MVI   A,8   
                              JMP   ln3   
                    LN5:      MVI   M,13   
                              POP   B   
                              LXI   H,LINEBUF   
                              RST   2   
0462                          ENDIF      
0462                             ; =============================================================================
0462                             ;  Machine code: the grave
0462                             ; =============================================================================
0462                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
0462                             ; are stored from addr until a non-hex character; then a RET (C9h) is
0462                             ; written and its address is left. An odd last digit is consumed and dropped.
0462                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
0462                             ; code is entered by CALL with the data stack above the return address; it
0462                             ; must keep BC, and on return the top cell becomes the new TOS.
0462   0A           H_GRAVE:   LDAX   B   
0463   CD 93 04               CALL   hexval   
0466   DA 8D 04               JC   exec   
0469   0A           HX1:      LDAX   B   
046A   CD 93 04               CALL   hexval   
046D   DA 87 04               JC   hx2   
0470   03                     INX   B   
0471   87                     ADD   A   
0472   87                     ADD   A   
0473   87                     ADD   A   
0474   87                     ADD   A   
0475   57                     MOV   D,A   
0476   0A                     LDAX   B   
0477   CD 93 04               CALL   hexval   
047A   DA 87 04               JC   hx2   ; odd digit: already consumed, dropped
047D   03                     INX   B   
047E   B2                     ORA   D   
047F                          IF   CHECKED   
047F   CD 13 03               CALL   chkst   
0482                          ENDIF      
0482   77                     MOV   M,A   
0483   23                     INX   H   
0484   C3 69 04               JMP   hx1   
0487                HX2:         
0487                          IF   CHECKED   
0487   CD 13 03               CALL   chkst   
048A                          ENDIF      
048A   36 C9                  MVI   M,0C9h   
048C   D7                     RST   2   
048D   CD 92 04     EXEC:     CALL   exjmp   ; the code returns here, with its top cell on
0490   E1                     POP   H   ;   the stack: that becomes the new TOS
0491   D7                     RST   2   
0492   E9           EXJMP:    PCHL      
0493                             ; hexval: A = a character; returns its value 0-15 with carry clear, or
0493                             ; carry set if it isn't a hex digit (0-9, A-F, a-f).
0493   D6 30        HEXVAL:   SUI   "0"   
0495   FE 0A                  CPI   10   
0497   3F                     CMC      
0498   D0                     RNC      
0499   E6 DF                  ANI   0DFh   
049B   D6 11                  SUI   11h   
049D   FE 06                  CPI   6   
049F   3F                     CMC      
04A0   D8                     RC      
04A1   C6 0A                  ADI   10   
04A3   C9                     RET      
04A4                             ; =============================================================================
04A4                             ;  Console layer: getk returns a waiting key in A (zero flag clear), or
04A4                             ;  A = 0 with the zero flag set when none is waiting. putc prints A.
04A4                             ;  Both keep BC, DE and HL.
04A4                             ; =============================================================================
04A4                GETK:        
04A4                          IF   CHECKED   
04A4   3A 36 08               LDA   KEYBUF   ; a key held back by the break check
04A7   B7                     ORA   A   
04A8   CA B2 04               JZ   gk1   
04AB   F5                     PUSH   PSW   
04AC   AF                     XRA   A   
04AD   32 36 08               STA   KEYBUF   
04B0   F1                     POP   PSW   
04B1   C9                     RET      
04B2                GK1:         
04B2                          ENDIF      
04B2                          IF   CPM   
04B2   3E FF                  MVI   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
04B4   C3 B7 04               JMP   putc   ; (which ends with ORA A, for the zero flag)
04B7                             ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
04B7                             ; printing and could swallow a key that BDOS 6 then never sees.
04B7   C5           PUTC:     PUSH   B   
04B8   D5                     PUSH   D   
04B9   E5                     PUSH   H   
04BA   5F                     MOV   E,A   
04BB   0E 06                  MVI   C,6   
04BD   CD 05 00               CALL   BDOS   
04C0   E1                     POP   H   
04C1   D1                     POP   D   
04C2   C1                     POP   B   
04C3   B7                     ORA   A   
04C4   C9                     RET      
04C5                          ENDIF      
04C5                          IFN   CPM   
                              CALL   CONST   
                              ORA   A   
                              RZ      
                              CALL   CONIN   
                              ORA   A   
                              RET      
                    PUTC:     EQU   CONOUT   
04C5                          ENDIF      
04C5                             ; =============================================================================
04C5                             ;  Checked build: break key and error reports
04C5                             ; =============================================================================
04C5                          IF   CHECKED   
04C5                             ; chkbrk: a waiting key is read now; Ctrl-C stops the program, anything
04C5                             ; else is held for the next "?".
04C5   3A 36 08     CHKBRK:   LDA   KEYBUF   
04C8   B7                     ORA   A   
04C9   C0                     RNZ      ; one key is already held
04CA   CD A4 04               CALL   getk   
04CD   C8                     RZ      
04CE   FE 03                  CPI   3   
04D0   CA E8 04               JZ   e_break   
04D3   32 36 08               STA   KEYBUF   
04D6   C9                     RET      
04D7   CD 03 05     E_STACK:   CALL   error   
04DA   73 74 61 63 EB         DB   "stac","k"+80h   
04DF   CD 03 05     E_RSTACK:   CALL   error   
04E2   72 65 74 75 72 EE      DB   "retur","n"+80h   
04E8   CD 03 05     E_BREAK:   CALL   error   
04EB   62 72 65 61 EB         DB   "brea","k"+80h   
04F0   CD 03 05     E_HEAP:   CALL   error   
04F3   68 65 61 F0            DB   "hea","p"+80h   
04F7   CD 03 05     E_STORE:   CALL   error   
04FA   73 74 6F 72 E5         DB   "stor","e"+80h   
04FF   CD 03 05     E_BRACK:   CALL   error   
0502   DB                     DB   "["+80h   
0503                             ; error: print CR LF, the word after the CALL (last character has bit 7
0503                             ; set), " at " and the offset of the reading position in the program.
0503   D1           ERROR:    POP   D   ; DE -> the word
0504   31 FE 07               LXI   SP,DSTOP   ; the stacks may be wrecked: start clean
0507   21 2F 05               LXI   H,er1   
050A   CD 21 05               CALL   prs   
050D   EB                     XCHG      
050E   CD 21 05               CALL   prs   ; the word
0511   21 31 05               LXI   H,er2   
0514   CD 21 05               CALL   prs   
0517   21 FF F6               LXI   H,(0-PROG-1)&0FFFFh   
051A   09                     DAD   B   ; IP - (PROG+1): the character just read
051B   CD FD 03               CALL   pdec   
051E   C3 00 00               JMP   endprog   
0521                             ; prs: print the string at HL, whose last character has bit 7 set
0521   7E           PRS:      MOV   A,M   
0522   23                     INX   H   
0523   F5                     PUSH   PSW   
0524   E6 7F                  ANI   7Fh   
0526   CD B7 04               CALL   putc   
0529   F1                     POP   PSW   
