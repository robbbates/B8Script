                              DS   CHECKED,AFNX&0FFh   
                              DS   CHECKED,AFNX/256   
                    FS_MUL:   JSR   h_mul   ; *
                              ;*Macro unroll:  NEXTF
                              DS   1-CHECKED,0A0h   
                              DS   1-CHECKED,0   
                              DS   1-CHECKED,0B1h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0E6h   
