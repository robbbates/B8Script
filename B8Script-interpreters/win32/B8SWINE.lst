     1                                  %define CHECKED 0
     2                                  %define EDITOR 1
     3                                  [map all B8SWINE.map]
     4                                  %include "/home/user/B8Script/B8Script-interpreters/win32/b8s-win32.asm"
     1                              <1> ; =============================================================================
     2                              <1> ;  B8Script interpreter for 32-bit Windows (x86, console subsystem)
     3                              <1> ;  Spec: docs/b8script.md (2026-11-21).
     4                              <1> ;
     5                              <1> ;  Assembler: NASM 2.16, flat binary output: the PE header is laid out by
     6                              <1> ;  hand at the top of this file, so the output IS the .EXE:
     7                              <1> ;
     8                              <1> ;      nasm -f bin -o B8SWIN.EXE b8s-win32.asm
     9                              <1> ;      nasm -f bin -DCHECKED=1 -o B8SWINC.EXE b8s-win32.asm
    10                              <1> ;      nasm -f bin -DEDITOR=1 -o B8SWINE.EXE b8s-win32.asm
    11                              <1> ;      nasm -f bin -DEDITOR=1 -DCHECKED=1 -o B8SWINEC.EXE b8s-win32.asm
    12                              <1> ;
    13                              <1> ;  Two switches (the defaults below, or -D on the command line):
    14                              <1> ;    CHECKED  0 = no checks (spec: the programmer is responsible)
    15                              <1> ;             1 = starts with every variable at 0 and every word undefined,
    16                              <1> ;                 and stops on every error in the spec's table (and Ctrl-C)
    17                              <1> ;                 with the four-line report, on the standard error handle.
    18                              <1> ;    EDITOR   0 = a runner: B8SWIN PROG.B8S loads the file, runs it, exits
    19                              <1> ;             1 = the line editor of the spec's suggested standard (the same
    20                              <1> ;                 editor as the Z80's, key for key); the file named on the
    21                              <1> ;                 command line is the program to start with.
    22                              <1> ;
    23                              <1> ;  In every build Ctrl-C stops a running program (an unchecked runner stops
    24                              <1> ;  without a word): see the console layer for the rules, the held key and
    25                              <1> ;  the break-off cell.
    26                              <1> ; =============================================================================
    27                              <1> 
    28                              <1> %ifndef CHECKED
    29                              <1> %define CHECKED 0
    30                              <1> %endif
    31                              <1> %ifndef EDITOR
    32                              <1> %define EDITOR  0
    33                              <1> %endif
    34                              <1> 
    35                              <1> ; -----------------------------------------------------------------------------
    36                              <1> ;  The machine model
    37                              <1> ;
    38                              <1> ;  B8Script is defined for a 64 KB machine with 16-bit cells, and that is what
    39                              <1> ;  runs here. The 64 KB arena sits at ARENA (00410000h), a multiple of 64 KB,
    40                              <1> ;  inside the image (its last 64 KB of uninitialised space): the B8Script
    41                              <1> ;  address a is the byte at ARENA + a. Because the arena is 64 KB aligned,
    42                              <1> ;  "ARENA + a" is simply a 32-bit register whose high word is 0041h and whose
    43                              <1> ;  low word is a. Every cell the interpreter keeps in a 32-bit register or
    44                              <1> ;  stack slot is kept in that form, so it is at once the 16-bit cell (its low
    45                              <1> ;  word) and a pointer to that cell's address:
    46                              <1> ;
    47                              <1> ;    EBX  TOS. 16-bit operations work on BX; EBX's high word is always 0041h,
    48                              <1> ;         so [EBX] is the byte TOS points at.
    49                              <1> ;    ESI  IP: a pointer to the next program character (LODSB reads it).
    50                              <1> ;    ESP  the data stack: one dword per cell, low word the cell, high word
    51                              <1> ;         0041h. [ESP] is NOS. It is the thread's own stack (the API calls
    52                              <1> ;         push their arguments below it). V_DSTOP holds ESP for the empty
    53                              <1> ;         stack.
    54                              <1> ;    EDI  the return stack pointer: dword entries (IP values and cells parked
    55                              <1> ;         with '{', all in the same form), growing down from RSTOP. A pop is
    56                              <1> ;         MOV r,[EDI] / SCASD (SCASD only steps EDI on by 4).
    57                              <1> ;    EBP  the address of `next`: every handler ends with JMP EBP (2 bytes),
    58                              <1> ;         and the interpreter's own variables and the import address table
    59                              <1> ;         lie within 127 bytes of `next`, so [EBP+d8] reaches them in 3-byte
    60                              <1> ;         instructions. (V() below names them.)
    61                              <1> ;    EAX ECX EDX  scratch. (The Windows API keeps EBX, ESI, EDI and EBP.)
    62                              <1> ;
    63                              <1> ;  Memory map of the arena (B8Script addresses):
    64                              <1> ;    0000h-00FFh  page zero: unused, and left zero. An undefined word's cell
    65                              <1> ;                 holds 0000h, so calling it runs into the NUL at 0000h; the
    66                              <1> ;                 checked build sees that the IP is 0001h there and reports U.
    67                              <1> ;    0100h        the letter page: A-Z at +00h..+33h, a-z at +40h..+73h (a
    68                              <1> ;                 word's cell is 64 bytes below its variable's), the held key
    69                              <1> ;                 at +7Ah, the break-off cell at +7Bh, the heap pointer at +7Ch,
    70                              <1> ;                 and the -n? line buffer at +80h..+FFh (127 characters and CR;
    71                              <1> ;                 the editor's input line uses it too)
    72                              <1> ;    0200h        PROG: the program text, ending in NUL; the heap starts after
    73                              <1> ;                 the NUL and may grow up to the heap limit, FF00h
    74                              <1> ;    FF00h-FFFFh  above the limit: not the program's (unused)
    75                              <1> ;  The stacks are outside the arena: the return stack is 112 entries below
    76                              <1> ;  RSTOP (in the image's uninitialised space below the arena) and the data
    77                              <1> ;  stack is the thread's stack (127 cells in the checked builds, as deep as
    78                              <1> ;  the 1 MB stack reserve allows in the others).
    79                              <1> ;
    80                              <1> ;  The whole image (code, arena) is one section, readable, writable and
    81                              <1> ;  executable, so machine code can run in the arena (see h_grave).
    82                              <1> ; -----------------------------------------------------------------------------
    83                              <1> 
    84                              <1> IB      equ     400000h         ; ImageBase
    85                              <1> SECTVA  equ     1000h           ; the section's RVA
    86                              <1> ARENA   equ     410000h         ; the 64 KB B8Script memory (RVA 10000h)
    87                              <1> IMGSIZE equ     20000h          ; SizeOfImage: the arena is its last 64 KB
    88                              <1> 
    89                              <1> LET     equ     0100h           ; the letter page (a B8Script address)
    90                              <1> HELD    equ     LET+7Ah         ; a key read by the break check, held for the
    91                              <1>                                 ;   next '?' (0: none)
    92                              <1> BRKOFF  equ     LET+7Bh         ; the break-off cell: a non-zero byte here
    93                              <1>                                 ;   makes Ctrl-C a key like any other
    94                              <1> HEAP    equ     LET+7Ch         ; the heap pointer (a cell)
    95                              <1> LINEBUF equ     LET+80h         ; the -n? line buffer
    96                              <1> PROG    equ     0200h           ; the program text
    97                              <1> HEAPLIM equ     0FFh            ; the heap limit, as a page: FF00h
    98                              <1> LIMIT   equ     HEAPLIM*256
    99                              <1> MAXFILE equ     LIMIT-PROG-3    ; the most a file may bring (room for CR LF NUL)
   100                              <1> 
   101                              <1> RSTOP   equ     IB+0FF00h       ; the empty return stack (it grows down)
   102                              <1> RSMAX   equ     112             ; return stack entries (checked builds)
   103                              <1> DSMAX   equ     127             ; data stack cells (checked builds)
   104                              <1> NAMEBUF equ     IB+0F000h       ; the file's name, as typed (up to 3.5 KB)
   105                              <1> 
   106                              <1> ; -----------------------------------------------------------------------------
   107                              <1> ;  The PE header, by the documented rules: a 64-byte DOS header whose
   108                              <1> ;  e_lfanew points at the PE signature, the COFF header, the PE32 optional
   109                              <1> ;  header with its 16 data directories, and one section header. Then zeros
   110                              <1> ;  up to SizeOfHeaders (200h, one FileAlignment).
   111                              <1> ; -----------------------------------------------------------------------------
   112                              <1>         bits    32
   113                              <1>         section hdr start=0 vstart=IB
   114 00000000 4D5A                <1>         dw      'MZ'                    ; e_magic
   115 00000002 00<rep 3Ah>         <1>         times   3Ch-($-$$) db 0
   116 0000003C [4000C0FF]          <1>         dd      pe-IB                   ; e_lfanew
   117 00000040 50450000            <1> pe:     db      'PE',0,0
   118 00000044 4C01                <1>         dw      14Ch                    ; Machine: i386
   119 00000046 0100                <1>         dw      1                       ; NumberOfSections
   120 00000048 00000000            <1>         dd      0                       ; TimeDateStamp
   121 0000004C 0000000000000000    <1>         dd      0, 0                    ; no COFF symbols
   122 00000054 E000                <1>         dw      opthdr_end-opthdr       ; SizeOfOptionalHeader (224)
   123 00000056 0F01                <1>         dw      010Fh                   ; RELOCS_STRIPPED, EXECUTABLE_IMAGE,
   124                              <1>                                         ;   LINE_NUMS_STRIPPED,
   125                              <1>                                         ;   LOCAL_SYMS_STRIPPED, 32BIT_MACHINE
   126 00000058 0B01                <1> opthdr: dw      10Bh                    ; PE32
   127 0000005A 0100                <1>         db      1, 0                    ; linker version
   128 0000005C 000A0000            <1>         dd      RAWSIZE                 ; SizeOfCode
   129 00000060 000A0000            <1>         dd      RAWSIZE                 ; SizeOfInitializedData
   130 00000064 00000000            <1>         dd      0                       ; SizeOfUninitializedData
   131 00000068 [0000C0FF]          <1>         dd      start-IB                ; AddressOfEntryPoint
   132 0000006C 00100000            <1>         dd      SECTVA                  ; BaseOfCode
   133 00000070 00100000            <1>         dd      SECTVA                  ; BaseOfData
   134 00000074 00004000            <1>         dd      IB                      ; ImageBase
   135 00000078 00100000            <1>         dd      1000h                   ; SectionAlignment
   136 0000007C 00020000            <1>         dd      200h                    ; FileAlignment
   137 00000080 04000000            <1>         dw      4, 0                    ; OS version 4.0
   138 00000084 00000000            <1>         dw      0, 0                    ; image version
   139 00000088 04000000            <1>         dw      4, 0                    ; subsystem version 4.0
   140 0000008C 00000000            <1>         dd      0                       ; Win32VersionValue
   141 00000090 00000200            <1>         dd      IMGSIZE                 ; SizeOfImage
   142 00000094 00020000            <1>         dd      200h                    ; SizeOfHeaders
   143 00000098 00000000            <1>         dd      0                       ; CheckSum
   144 0000009C 0300                <1>         dw      3                       ; Subsystem: Windows console
   145 0000009E 0000                <1>         dw      0                       ; DllCharacteristics: none
   146 000000A0 0000100000100000    <1>         dd      100000h, 1000h          ; stack reserve, commit
   147 000000A8 0000100000100000    <1>         dd      100000h, 1000h          ; heap reserve, commit
   148 000000B0 00000000            <1>         dd      0                       ; LoaderFlags
   149 000000B4 10000000            <1>         dd      16                      ; NumberOfRvaAndSizes
   150 000000B8 0000000000000000    <1>         dd      0, 0                    ; 0 export
   151 000000C0 [3008C0FF]28000000  <1>         dd      idesc-IB, idesc_end-idesc ; 1 import
   152 000000C8 00000000<rep 14h>   <1>         times   10*2 dd 0               ; 2-11
   153 00000118 [4809C0FF]30000000  <1>         dd      iat-IB, iat_end-iat     ; 12 IAT
   154 00000120 00000000<rep 6h>    <1>         times   3*2 dd 0                ; 13-15
   155                              <1> opthdr_end:
   156 00000138 2E74657874000000    <1>         db      '.text',0,0,0           ; the one section
   157 00000140 00F00100            <1>         dd      IMGSIZE-SECTVA          ; VirtualSize: code, then zeros up to
   158                              <1>                                         ;   the arena's end
   159 00000144 00100000            <1>         dd      SECTVA                  ; VirtualAddress
   160 00000148 000A0000            <1>         dd      RAWSIZE                 ; SizeOfRawData
   161 0000014C 00020000            <1>         dd      200h                    ; PointerToRawData
   162 00000150 0000000000000000    <1>         dd      0, 0                    ; no relocations, no line numbers
   163 00000158 00000000            <1>         dw      0, 0
   164 0000015C 600000E0            <1>         dd      0E0000060h              ; code, initialised data, execute,
   165                              <1>                                         ;   read, write
   166 00000160 00<rep A0h>         <1>         times   200h-($-$$) db 0
   167                              <1> 
   168                              <1> ; =============================================================================
   169                              <1> ;  The code
   170                              <1> ; =============================================================================
   171                              <1>         section text start=200h vstart=IB+SECTVA
   172                              <1> tstart:
   173                              <1> %define V(x) ebp+(x)-next               ; a variable or IAT slot near `next`
   174                              <1> 
   175                              <1> ; ---- startup ----------------------------------------------------------------
   176                              <1> ; The data stack starts empty; the cell pushed here stands for TOS, as when
   177                              <1> ; the editor has the stack in memory: the run starts by popping it.
   178 00000000 BD[AF090000]        <1> start:  mov     ebp,next
   179 00000005 BE00024100          <1>         mov     esi,ARENA+PROG
   180 0000000A 89655B              <1>         mov     [V(v_dstop)],esp
   181 0000000D 56                  <1>         push    esi                     ; (the cell that stands for TOS)
   182 0000000E 6AF6                <1>         push    -10                     ; STD_INPUT_HANDLE
   183 00000010 FF5599              <1>         call    [V(iat_GetStdHandle)]
   184 00000013 894553              <1>         mov     [V(v_hin)],eax
   185 00000016 6AF5                <1>         push    -11                     ; STD_OUTPUT_HANDLE
   186 00000018 FF5599              <1>         call    [V(iat_GetStdHandle)]
   187 0000001B 894557              <1>         mov     [V(v_outh)],eax
   188                              <1>         ; Raw keys: no echo, no line editing, Ctrl-C as a key (mode 0). If
   189                              <1>         ; the input is not a console, GetConsoleMode fails, and the keys are
   190                              <1>         ; read as bytes with ReadFile (see waitk).
   191 0000001E 8D4D61              <1>         lea     ecx,[V(v_mode)]
   192 00000021 51                  <1>         push    ecx
   193 00000022 FF7553              <1>         push    dword [V(v_hin)]
   194 00000025 FF559D              <1>         call    [V(iat_GetConsoleMode)]
   195 00000028 88455F              <1>         mov     [V(v_iscon)],al
   196 0000002B 6A00                <1>         push    0
   197 0000002D FF7553              <1>         push    dword [V(v_hin)]
   198 00000030 FF55A1              <1>         call    [V(iat_SetConsoleMode)]
   199                              <1>         ; The command line: the program's own name, then the file's.
   200 00000033 FF55A5              <1>         call    [V(iat_GetCommandLineA)]
   201 00000036 96                  <1>         xchg    eax,esi
   202 00000037 E814000000          <1>         call    token
   203 0000003C E80F000000          <1>         call    token
   204 00000041 E82E000000          <1>         call    load                    ; (no file, or no such file: no text)
   205 00000046 BF00FF4000          <1>         mov     edi,RSTOP               ; the return stack is empty
   206                              <1> %if EDITOR
   207 0000004B E981040000          <1>         jmp     edit
   208                              <1> %else
   209                              <1>         mov     esi,ARENA+PROG          ; the IP
   210                              <1>         jmp     run0
   211                              <1> %endif
   212                              <1> 
   213                              <1> ; token: copy the next word of the command line at ESI to NAMEBUF, ending
   214                              <1> ; in NUL. A word is ended by a space, or is in double quotes. ESI is left
   215                              <1> ; after it (on the NUL at the end of the line, so another token is empty).
   216 00000050 BF00F04000          <1> token:  mov     edi,NAMEBUF
   217 00000055 AC                  <1> .sp:    lodsb
   218 00000056 3C20                <1>         cmp     al,' '
   219 00000058 74FB                <1>         je      .sp
   220 0000005A B420                <1>         mov     ah,' '
   221 0000005C 3C22                <1>         cmp     al,22h
   222 0000005E 7503                <1>         jne     .ch
   223 00000060 88C4                <1>         mov     ah,al                   ; a quoted word ends at the quote
   224 00000062 AC                  <1>         lodsb
   225 00000063 84C0                <1> .ch:    test    al,al
   226 00000065 7408                <1>         jz      .nul
   227 00000067 38E0                <1>         cmp     al,ah
   228 00000069 7405                <1>         je      .end
   229 0000006B AA                  <1>         stosb
   230 0000006C AC                  <1>         lodsb
   231 0000006D EBF4                <1>         jmp     .ch
   232 0000006F 4E                  <1> .nul:   dec     esi
   233 00000070 C60700              <1> .end:   mov     byte [edi],0
   234 00000073 C3                  <1>         ret
   235                              <1> 
   236                              <1> ; load: read the file named in NAMEBUF into PROG, and end the text with a
   237                              <1> ; NUL. No such file (or no name): no text, since ReadFile on the failed
   238                              <1> ; handle reads nothing (it sets the count to 0 first).
   239 00000074 31C0                <1> load:   xor     eax,eax
   240 00000076 50                  <1>         push    eax                     ; hTemplateFile
   241 00000077 50                  <1>         push    eax                     ; dwFlagsAndAttributes
   242 00000078 6A03                <1>         push    3                       ; OPEN_EXISTING
   243 0000007A 50                  <1>         push    eax                     ; lpSecurityAttributes
   244 0000007B 6A01                <1>         push    1                       ; FILE_SHARE_READ
   245 0000007D 6800000080          <1>         push    80000000h               ; GENERIC_READ
   246 00000082 6800F04000          <1>         push    NAMEBUF
   247 00000087 FF55A9              <1>         call    [V(iat_CreateFileA)]
   248 0000008A 50                  <1>         push    eax                     ; (for CloseHandle)
   249 0000008B 6A00                <1>         push    0
   250 0000008D 8D4D4F              <1>         lea     ecx,[V(v_cnt)]
   251 00000090 51                  <1>         push    ecx
   252 00000091 68FDFC0000          <1>         push    MAXFILE
   253 00000096 6800024100          <1>         push    ARENA+PROG
   254 0000009B 50                  <1>         push    eax
   255 0000009C FF55AD              <1>         call    [V(iat_ReadFile)]
   256                              <1> %if EDITOR
   257 0000009F FF55B5              <1>         call    [V(iat_CloseHandle)]
   258                              <1> %else
   259                              <1>         pop     eax                     ; (the handle stays open)
   260                              <1> %endif
   261 000000A2 8B754F              <1>         mov     esi,[V(v_cnt)]
   262 000000A5 81C600024100        <1>         add     esi,ARENA+PROG
   263 000000AB C60600              <1>         mov     byte [esi],0            ; the end of the file counts as NUL
   264                              <1> %if EDITOR
   265                              <1>         ; The editor's text ends at the file's first ^Z (as in the CP/M
   266                              <1>         ; builds) or NUL, and every line must end in LF: a last line
   267                              <1>         ; without one is given a CR LF.
   268 000000AE BE00024100          <1>         mov     esi,ARENA+PROG
   269 000000B3 B00A                <1>         mov     al,10                   ; (a file with no text needs nothing)
   270 000000B5 88C4                <1> .ld1:   mov     ah,al                   ; AH = the character before
   271 000000B7 AC                  <1>         lodsb
   272 000000B8 3C1A                <1>         cmp     al,1Ah
   273 000000BA 7404                <1>         je      .ld2
   274 000000BC 84C0                <1>         test    al,al
   275 000000BE 75F5                <1>         jnz     .ld1
   276 000000C0 4E                  <1> .ld2:   dec     esi
   277 000000C1 80FC0A              <1>         cmp     ah,10
   278 000000C4 7407                <1>         je      .ld3
   279 000000C6 66C7060D0A          <1>         mov     word [esi],0A0Dh
   280 000000CB 46                  <1>         inc     esi
   281 000000CC 46                  <1>         inc     esi
   282 000000CD C60600              <1> .ld3:   mov     byte [esi],0
   283                              <1> %endif
   284 000000D0 C3                  <1>         ret
   285                              <1> 
   286                              <1> ; exit: put the console's input mode back as it was, and leave.
   287 000000D1 FF7561              <1> exit:   push    dword [V(v_mode)]
   288 000000D4 FF7553              <1>         push    dword [V(v_hin)]
   289 000000D7 FF55A1              <1>         call    [V(iat_SetConsoleMode)]
   290 000000DA 6A00                <1>         push    0
   291 000000DC FF55C1              <1>         call    [V(iat_ExitProcess)]
   292                              <1> 
   293                              <1> ; LINECODE is the -n? routine, `line`. It goes after the bodies of the
   294                              <1> ; handlers in an unchecked build, after the checks in a checked one: where
   295                              <1> ; the short jumps reach the furthest.
   296                              <1> %macro  LINECODE 0
   297                              <1> ; -n?: Backspace takes the last character back (and is echoed as it is),
   298                              <1> ; CR ends (stored, not echoed), every other key is stored and echoed until
   299                              <1> ; the line is full. The buffer is at offset 80h of the letter page, so DL
   300                              <1> ; alone is the place in the line; BL is the DL of a full line.
   301                              <1> line:   mov     ax,bx
   302                              <1>         neg     ax                      ; the count (8000h for -32768)
   303                              <1>         cmp     ax,127
   304                              <1>         jbe     .ln1
   305                              <1>         mov     al,127
   306                              <1> .ln1:   add     al,80h
   307                              <1>         mov     bl,al
   308                              <1>         mov     edx,ARENA+LINEBUF
   309                              <1>         xor     ecx,ecx                 ; getk waits for ever
   310                              <1> .ln2:   call    getk
   311                              <1>         cmp     al,13
   312                              <1>         je      .ln5
   313                              <1>         cmp     al,8
   314                              <1>         je      .ln4
   315                              <1>         cmp     dl,bl
   316                              <1>         je      .ln2                    ; full
   317                              <1>         mov     [edx],al
   318                              <1>         inc     edx
   319                              <1> .ln3:   call    putc
   320                              <1>         jmp     .ln2
   321                              <1> .ln4:   dec     dl                      ; Backspace: one back, and echo it,
   322                              <1>         js      .ln3                    ;   unless the line was empty (DL left
   323                              <1>         inc     dl                      ;   the upper half of the page)
   324                              <1>         jmp     .ln2
   325                              <1> .ln5:   mov     [edx],al                ; the CR
   326                              <1>         mov     bx,LINEBUF
   327                              <1>         jmp     ebp
   328                              <1> %endmacro
   329                              <1> 
   330                              <1> ; =============================================================================
   331                              <1> ;  Punctuation handlers. PTAB holds one byte per character: its handler's
   332                              <1> ;  distance from hbase, so every handler starts in the 256 bytes from hbase
   333                              <1> ;  (PT checks it). Only the starts must be there: the last handler, '?',
   334                              <1> ;  runs on past the window, and '[', '_', '`' (and '/' in a checked build)
   335                              <1> ;  are stubs that jump to their bodies after it. Each handler starts with EBX = TOS and EAX, ECX, EDX
   336                              <1> ;  free, and ends with JMP EBP.
   337                              <1> ;  (Two other layouts were tried: handlers 2-aligned with the table holding
   338                              <1> ;  half the distance, which costs a NOP after every handler of odd length,
   339                              <1> ;  about 22 bytes; and the Z80's two 256-byte windows, whose dispatcher is 7
   340                              <1> ;  bytes longer and whose handlers must be in table order, which costs near
   341                              <1> ;  jumps.)
   342                              <1> ; =============================================================================
   343                              <1> hbase:
   344                              <1> ; ']' returns: pop an address and jump to it.
   345 000000DF 8B37                <1> h_ret:  mov     esi,[edi]
   346 000000E1 AF                  <1> rdrop:  scasd                           ; drop the return stack's top
   347 000000E2 FFE5                <1> nx:     jmp     ebp
   348                              <1> 
   349                              <1> ; '\' ( flag -- ): true skips to the next ')' or ']' at this level; ')'
   350                              <1> ; drops the block start, ']' returns. No closer at all ends the program.
   351 000000E4 6685DB              <1> h_break:test    bx,bx
   352 000000E7 5B                  <1>         pop     ebx
   353 000000E8 74F8                <1>         jz      nx
