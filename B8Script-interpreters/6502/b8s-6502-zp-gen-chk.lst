E434   A9 42        E_BREAK:   LDA   #"B"   ; Ctrl-C (the stacks as they stand)
E436   2C                     DB   2Ch   ; (BIT abs: hides the next instruction)
E437   A9 58        E_RESV:   LDA   #"X"   ; a reserved byte, 80h-FFh
E439   4C 43 E5     EJMP2:    JMP   error   
E43C                             ; e_undef: the word cells of undefined words hold 0000h. A call there reads
E43C                             ; the byte at 0000h, which is IP's own low byte: 00h while IP is 0000h, so
E43C                             ; the call reads a NUL with IP in page zero, where no program can be. The
E43C                             ; call is undone first: the step frame and the return address come off the
E43C                             ; hardware stack, and the place is the call letter (the return address - 1).
E43C   68           E_UNDEF:   PLA      
E43D   68                     PLA      ; the step frame
E43E   68                     PLA      
E43F   38                     SEC      
E440   E9 01                  SBC   #1   
