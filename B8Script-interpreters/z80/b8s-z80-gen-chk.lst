0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Spec: docs/b8script.md (2026-11-21).
0000                             ; 
0000                             ;  Three switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    EDITOR   1 = with the line editor built in (see the end of this file):
0000                             ;                 the spec's suggested standard. It goes with either setting
0000                             ;                 of the other two.
0000                             ;    CHECKED  0 = no checks (spec: the programmer is responsible)
0000                             ;             1 = starts with every variable at 0 and every word undefined,
0000                             ;                 and stops on every error in the spec's table (and Ctrl-C)
0000                             ;                 with a four-line report: the letter and the place as line
0000                             ;                 and column, the text there, and both stacks. See `error`.
0000                             ; 
0000                             ;  In every build Ctrl-C stops a running program (an unchecked build stops
0000                             ;  without a word): see the console layer for the rules, the held key and
0000                             ;  the break-off cell.
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   0   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   1   ; 1 = checked build
0000                EDITOR:   EQU   0   ; 1 = with the line editor
0000                EDGEN:    EQU   EDITOR*(1-CPM)   ; (the generic build with the editor)
0000                             ; (IF takes any value but 0 as true, so
0000                             ;  IF CHECKED+EDITOR means "either")
0000                TABP0:    EQU   EDGEN*(1-CHECKED)   ; (the build with its table in page zero)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    HL'  return-stack pointer (the alternate HL). Entries are 2 bytes; the
0000                             ;         stack grows down. Only rpop and rpushn (and the checks) touch it.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  One-byte calls. The routines used most are reached with RST, one byte
0000                             ;  instead of three:
0000                             ; 
0000                             ;    RST 08h  rpop    pop the return stack into DE
0000                             ;    RST 18h  drop    drop TOS, then next character     (ends a handler)
0000                             ;    RST 20h  neg16   HL = -HL
0000                             ;    RST 28h  putc    print A
0000                             ;    RST 30h  next    next character                    (ends a handler)
0000                             ; 
0000                             ;  RST 18h and RST 30h never return: an RST is a CALL, so the first thing
0000                             ;  each of them does is POP DE to throw the return address away.
0000                             ; 
0000                             ;  The CP/M build can't own page zero, so the block from `vecs` to `vecend`
0000                             ;  (image addresses 0108h-0133h) is copied to 0008h-0033h when it starts. The
0000                             ;  code in that block is written to work at either place.
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (the top four bytes of the page are spare,
0000                             ;             so a full stack runs two bytes into the page below)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch, interpreter variables in the gaps, and the -n? line buffer
0000                             ;             at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack has a guard band: the data stack can
0000                             ;  overrun by a cell or two (and the calls made while it is full, the error
0000                             ;  report's included) into the top 32 bytes of the return-stack page, which
0000                             ;  are never used, and the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
                    BDOS:     EQU   0005h   
                    BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IF   CPM*(1-EDITOR)   
                    EXIT:     EQU   0000h   ; warm boot
0000                          ENDIF      
0000                          IFN   CPM   
0000                             ; ---- generic machine: edit these to suit -----------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The zero flag must match A
0000                             ;   (end the routine with OR A / RET).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                             ;   KEY and CONOUT must preserve BC, DE, HL and HL'.
0000                RSPAGE:   EQU   80h   ; 8000h return stack
0000                DSPAGE:   EQU   81h   ; 8100h data stack
0000                LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
0000                PROG:     EQU   8300h   ; where the loader puts the program text
0000                HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
0000                BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)   
0000                EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                          ENDIF      
0000                          IF   EDGEN   
                    LEAVE:    EQU   0FF09h   ; where the editor's ^X goes
0000                          ENDIF      
0000                          IF   EDITOR*CPM   
                    LEAVE:    EQU   0000h   ; the editor's ^X: warm boot
0000                          ENDIF      
0000                          IF   EDITOR   
                    EXIT:     EQU   edend   ; a program that ends goes back to the editor,
                    SKEND:    EQU   skend   ;   also when it ends inside skip
0000                          ENDIF      
0000                          IF   1-EDITOR   
0000                SKEND:    EQU   EXIT   
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine. (The wait
0000                             ; for a second Ctrl-C uses it too: 250 ms.)
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                             ;   around machine code;
0000                NPEND:    EQU   LET+38h   ;   minus the address of the program's end
0000                             ;   (the heap"s first byte), for the checked "_';
0000                EDLN:     EQU   LET+3Ah   ;   the editor: the number of the line that ^E
0000                             ;   put in the input line (0: none)
0000                KEYBUF:   EQU   LET+7Ah   ; gap after z: a key read by the break check and
0000                             ;   held for the next "?" (0: none);
0000                BRKOFF:   EQU   LET+7Bh   ;   the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                LBHDR:    EQU   LET+7Eh   ; CP/M BDOS 10 header: max, count
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FCh   ; empty data stack. The four bytes above it
0000                             ; are spare: a character can pop two cells
0000                             ; too many before the checked build sees it,
0000                             ; and the next call must not land on the
0000                             ; letter cells.
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is the start of the .COM file, and 0108h-0133h is also copied to
0000                             ;  page zero (see the header).
0000                             ; =============================================================================
0000                          .ORG   BASE   
0000                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
0000   AF                     XOR   A   ; 00  reset. (This byte, AFh, is also what an
0001                          ENDIF      ;     undefined word runs into: see e_hi.)
0001                          IF   1-EDGEN   
0001   31 FC 81               LD   SP,DSTOP   ; 00  reset, or the start of the .COM file
0004                          ENDIF      
0004                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)   
                              LD   BC,PROG   ; 03  the IP
                              JR   st0   ; 06  (the rest of the startup is close by)
0004                          ENDIF      
0004                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
0004   18 6C                  JR   init   ; 04  (the rest of the startup is close by)
0006   00 00                  DW   0   ; 06  spare
0008                          ENDIF      
0008                          IF   EDGEN   
                              XOR   A   ; 00  reset: no program yet. (This byte, AFh,
                              LD   (PROG),A   ;     is also what an undefined word runs
                              JP   init   ; 04  into in the checked build: see e_hi.)
                              NOP      ; 07  spare
0008                          ENDIF      
0008                          IF   CPM   
                              JP   start   ; 03
                              DW   0   ; 06  spare
0008                          ENDIF      
0008                VECS:        
0008                             ; ---- RST 08h: rpop: pop the return stack into DE ---------------------------
0008   D9           RPOP:     EXX      ; 08
0009   5E                     LD   E,(HL)   
000A   23                     INC   HL   
000B   56                     LD   D,(HL)   
000C   23                     INC   HL   
000D   D5                     PUSH   DE   ; across to the main registers
000E   D9                     EXX      
000F   D1                     POP   DE   
0010   C9                     RET      ; 10  (so RST 10h is not used)
0011                             ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
0011   C6 21        CTL:      ADD   A,21h   ; 11  back to c; zero only for NUL
0013   20 1C                  JR   NZ,next0   ;     the rest are ignored
0015   C3 09 FF     ENDPROG:   JP   EXIT   ;     the program has ended
0018                             ; ---- RST 18h: drop TOS, then next ------------------------------------------
0018   D1           RST18:    POP   DE   ; 18  discard the RST's return address
0019   E1                     POP   HL   ;     new TOS = NOS
001A   18 15                  JR   nx   
001C   E5           H_FROMR:   PUSH   HL   ; 1C  "}" return stack to TOS
001D   CF                     RST   08h   
001E   EB                     EX   DE,HL   
001F   F7                     RST   30h   
0020                             ; ---- RST 20h: neg16: HL = -HL (keeps BC, DE) -------------------------------
0020   AF           NEG16:    XOR   A   ; 20
0021   95                     SUB   L   
0022   6F                     LD   L,A   
0023   9F                     SBC   A,A   
0024   94                     SUB   H   
0025   67                     LD   H,A   
0026   C9                     RET      
0027   00                     NOP      ; 27  spare
0028                             ; ---- RST 28h: putc: print A (keeps BC, DE, HL, HL') ------------------------
0028                RST28:       
0028                          IFN   CPM   
0028   C3 03 FF     PUTC:     JP   CONOUT   ; 28
002B                          ENDIF      
002B                          IF   CPM   
                              JP   putc   ; 28
002B                          ENDIF      
002B   E9           JPHL:     JP   (HL)   ; 2B  (for the machine-code call)
002C   E3           H_TOR:    EX   (SP),HL   ; 2C  "{" TOS to the return stack: the new TOS
002D   C3 D6 00               JP   rpushn   ;     comes up, the old one goes across
0030                             ; ---- RST 30h: next character -----------------------------------------------
0030   D1           RST30:    POP   DE   ; 30  discard the RST's return address
0031                NX:          
0031                          IF   CPM   
                              JP   next0   ; (this copy runs in page zero)
0031                          ENDIF      
0031                VECEND:      
0031                             ; =============================================================================
0031                             ;  The inner loop: read one character and sort it by range.
0031                             ; 
0031                             ;    00h          end of program
0031                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0031                             ;    30h-39h      digit: read a whole number
0031                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0031                             ;    61h-7Ah      a-z: push the address of that letter's cell
0031                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0031                             ; =============================================================================
0031                NEXT0:       
0031                          IF   CHECKED   
0031   CD 5D 03               CALL   chkstk   ; both stacks are checked once per character
0034                          ENDIF      
0034   0A                     LD   A,(BC)   
0035   03                     INC   BC   
0036   D6 21                  SUB   21h   ; A = c - 21h
0038   38 D7                  JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
003A   FE 0F                  CP   0Fh   
003C   38 25                  JR   C,punct   ; 21h-2Fh: PTAB index 0-14
003E   D6 0F                  SUB   0Fh   ; A = c - 30h
0040   FE 0A                  CP   0Ah   
0042   38 7C                  JR   C,digit   ; 30h-39h
0044   FE 11                  CP   11h   
0046   38 19                  JR   C,p3a   ; 3Ah-40h
0048   D6 11                  SUB   11h   ; A = c - 41h
004A   FE 1A                  CP   1Ah   
004C   38 7E                  JR   C,upper   ; 41h-5Ah: A = letter index 0-25
004E   FE 20                  CP   20h   
0050   38 0D                  JR   C,p5b   ; 5Bh-60h
0052   FE 3A                  CP   3Ah   
0054   38 70                  JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0056   FE 3E                  CP   3Eh   
0058                          IF   1-CHECKED   
                              JR   NC,next0   ; 7Fh-FFh: ignored
0058                          ENDIF      
0058                          IF   CHECKED   
0058   28 D7                  JR   Z,next0   ; 7Fh, DEL: ignored
005A   D2 8A 03               JP   NC,e_hi   ; 80h-FFh: reserved
005D                          ENDIF      
005D   D6 1A                  SUB   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
005F   D6 09        P5B:      SUB   9   ; 5Bh-60h: -4 in all, index 22-27
0061   C6 05        P3A:      ADD   A,5   ; 3Ah-40h: index 15-21
0063                .macro PTABLE,
0063                             ; 
0063                 DB      h_store & 0FFh  ; !
0063                 DB      h_str & 0FFh    ; "
0063                 DB      h_num & 0FFh    ; #
0063                 DB      h_print & 0FFh  ; $
0063                 DB      h_swap & 0FFh   ; %
0063                 DB      h_and & 0FFh    ; &
0063                 DB      h_emit & 0FFh   ; '
0063                 DB      h_open & 0FFh   ; (
0063                 DB      h_close & 0FFh  ; )
0063                 DB      h_mul & 0FFh    ; *
0063                 DB      h_add & 0FFh    ; +
0063                 DB      h_cfetch & 0FFh ; ,
0063                 DB      h_sub & 0FFh    ; -
0063                 DB      h_cstore & 0FFh ; .
0063                 DB      h_div & 0FFh    ; /
0063                 DB      h_dup & 0FFh    ; :
0063                 DB      h_drop & 0FFh   ; ;
0063                 DB      h_lt & 0FFh     ; <
0063                 DB      h_eq & 0FFh     ; =
0063                 DB      h_gt & 0FFh     ; >
0063                 DB      h_key & 0FFh    ; ?
0063                 DB      h_fetch & 0FFh  ; @
0063                 DB      h_def & 0FFh    ; [
0063                 DB      h_break & 0FFh  ; \
0063                 DB      h_ret & 0FFh    ; ]
0063                 DB      h_xor & 0FFh    ; ^
0063                 DB      h_alloc & 0FFh  ; _
0063                 DB      h_grave & 0FFh  ; `
0063                 DB      h_tor & 0FFh    ; {
0063                 DB      h_or & 0FFh     ; |
0063                 DB      h_fromr & 0FFh  ; }
0063                 DB      h_not & 0FFh    ; ~
0063                .endm
0063                 
0063                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
0063                             ; untouched, and A, DE free.
0063   C6 CC        PUNCT:    ADD   A,PTAB & 0FFh   ; PTAB never crosses a page
0065   5F                     LD   E,A   
0066   16 02                  LD   D,PTAB / 256   ; (0 if the table is in page zero)
0068   FE E3                  CP   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
006A   1A                     LD   A,(DE)   
006B   5F                     LD   E,A   ; the handler's low byte
006C                          IF   (1-CPM)*(1-TABP0)   
006C   16 00                  LD   D,0   
006E                          ENDIF      
006E                          IFN   CPM   
006E   CB 12                  RL   D   ; its page: 0 + carry
0070                          ENDIF      
0070                          IF   CPM   
                              LD   D,1   
                              JR   NC,pu1   
                              INC   D   ; its page: 1 + carry
                    PU1:         
0070                          ENDIF      
0070   D5                     PUSH   DE   ; jump to it; the stack is balanced again
0071   C9                     RET      ;   when the handler starts
0072                             ; The rest of the startup: here so that the generic reset code can reach it
0072                             ; with JR. st0: find the program's NUL; the heap starts after it.
0072                             ; (The editor build has its own copy of this, next to the editor.)
0072                             ; A checked build first clears the lower half of the letter page (A = 0):
0072                             ; every variable starts at 0, every word cell holds 0000h, the address an
0072                             ; undefined word is caught at (see e_hi), and no key is held back.
0072                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
0072   21 00 82     INIT:     LD   HL,LET   
0075   77           INI1:     LD   (HL),A   
0076   2C                     INC   L   
0077   F2 75 00               JP   P,ini1   ; +00h to +7Fh
007A   01 00 83               LD   BC,PROG   ; the IP
007D                          ENDIF      
007D                          IF   (1-CPM)*(1-EDITOR)   
007D   60           ST0:      LD   H,B   
007E   69                     LD   L,C   
007F   AF                     XOR   A   
0080   BE           ST1:      CP   (HL)   
0081   23                     INC   HL   
0082   20 FC                  JR   NZ,st1   
0084                          ENDIF      
0084                          IF   1-EDITOR   
0084   22 7C 82     ST2:      LD   (HEAP),HL   
0087                          ENDIF      
0087                          IF   CHECKED*(1-EDITOR)   
0087   E7                     RST   20h   ; minus the heap"s first address: "_' may not
0088   22 38 82               LD   (NPEND),HL   ;   release below it
008B                          ENDIF      
008B                          IF   (1-CHECKED)*(1-EDITOR)*(1-CPM)   
                              LD   H,A   ; (A = 0) no key is held, and the break key
                              LD   L,A   ;   is on (the checked build has cleared
008B                          ENDIF      ;   these)
008B                          IF   (1-CHECKED)*(1-EDITOR)*CPM   
                              LD   HL,0   
008B                          ENDIF      
008B                          IF   (1-CHECKED)*(1-EDITOR)   
                              LD   (KEYBUF),HL   
008B                          ENDIF      
008B                          IF   1-EDITOR   
008B   D9                     EXX      
008C   21 E0 80               LD   HL,RSTOP   ; the return stack is empty
008F   D9                     EXX      
0090   F7                     RST   30h   ; (its return address is thrown away)
0091                          ENDIF      
0091                             ; In the unchecked generic editor build the table is here, in the first
0091                             ; page, which saves loading D twice. (The other builds have no room for it
0091                             ; here: theirs is further down.)
0091                          IF   TABP0   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0091                          ENDIF      
0091                             ; =============================================================================
0091                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
0091                             ;  (00bbIGFuZCA= are up among the RST routines.) The machine-code call, exec,
0091                             ;  is here too: it belongs to "`" and makes the page come out right.
0091                             ; =============================================================================
0091   D1           H_XOR:    POP   DE   
0092   7C                     LD   A,H   
0093   AA                     XOR   D   
0094   67                     LD   H,A   
0095   7D                     LD   A,L   
0096   AB                     XOR   E   
0097   6F                     LD   L,A   
0098   F7                     RST   30h   
0099   D1           H_OR:     POP   DE   
009A   7C                     LD   A,H   
009B   B2                     OR   D   
009C   67                     LD   H,A   
009D   7D                     LD   A,L   
009E   B3                     OR   E   
009F   6F                     LD   L,A   
00A0   F7                     RST   30h   
00A1   E7           H_NOT:    RST   20h   ; ~x = -x - 1
00A2   2B                     DEC   HL   
00A3   F7                     RST   30h   
00A4                             ; "_" ( n -- addr ): the heap pointer moves by n, a signed count (the add is
00A4                             ; the same either way); TOS is the old pointer.
00A4   ED 5B 7C 82  H_ALLOC:   LD   DE,(HEAP)   
00A8                          IF   CHECKED*CPM   
                              LD   A,H   ; the count's sign, for chkhp
00A8                          ENDIF      
00A8   19                     ADD   HL,DE   ; the new top
00A9                          IF   CHECKED   
00A9   CD 49 03               CALL   chkhp   
00AC                          ENDIF      
00AC   22 7C 82               LD   (HEAP),HL   
00AF   EB                     EX   DE,HL   
00B0   F7                     RST   30h   
00B1   D9           EXEC:     EXX      
00B2   22 34 82               LD   (RSAVE),HL   ; machine code may change the alternates
00B5   D9                     EXX      
00B6   CD 2B 00               CALL   jphl   
00B9   D9                     EXX      
00BA   2A 34 82               LD   HL,(RSAVE)   
00BD   D9                     EXX      
00BE   E1                     POP   HL   
00BF   F7                     RST   30h   
00C0                             ; ---- the letters and digits (here, in the middle, so that the inner loop's
00C0                             ; ---- short jumps reach them, and the handlers after them reach rpushn) ------
00C0                             ; Digits: step back onto the first digit and read the whole number.
00C0   E5           DIGIT:    PUSH   HL   
00C1   0B                     DEC   BC   
00C2   CD 4E 02               CALL   rdnum   
00C5   F7                     RST   30h   
00C6                             ; a-z: push the cell's address (the cell is the variable)
00C6   E5           LOWER:    PUSH   HL   
00C7   87                     ADD   A,A   
00C8   6F                     LD   L,A   
00C9   26 82                  LD   H,LETPAGE   
00CB   F7                     RST   30h   
00CC                             ; A-Z: call the word. The return address (the IP after the letter) goes on
00CC                             ; the return stack, and the IP becomes the address in the letter's cell.
00CC   C5           UPPER:    PUSH   BC   ; the return address, for rpushn
00CD   EB                     EX   DE,HL   ; park TOS
00CE   87                     ADD   A,A   
00CF   6F                     LD   L,A   
00D0   26 82                  LD   H,LETPAGE   ; HL -> cell
00D2   4E                     LD   C,(HL)   
00D3   2C                     INC   L   
00D4   46                     LD   B,(HL)   ; IP = the word's body
00D5   EB                     EX   DE,HL   ; TOS back, and fall into rpushn
00D6                             ; rpushn: move the top cell of the data stack (in memory) to the return
00D6                             ; stack, then next. Everything that pushes the return stack ends here.
00D6                             ; 
00D6                             ; The break key is looked at here, so at every word call and loop-back (and
00D6                             ; block entry and "{"), but only one time in 256: B', which nothing else
00D6                             ; uses, counts them. Reading the keyboard can be slow (it is a BDOS call
00D6                             ; under CP/M), and this way it costs a loop four bytes and 14 T-states.
00D6                             ; (DEC B, not DJNZ: its zero flag lasts through the EXX, so one EXX serves
00D6                             ; both ways out.)
00D6   D9           RPUSHN:   EXX      
00D7   D1                     POP   DE   
00D8   2B                     DEC   HL   
00D9   72                     LD   (HL),D   
00DA   2B                     DEC   HL   
00DB   73                     LD   (HL),E   
00DC   05                     DEC   B   
00DD   D9                     EXX      
00DE   CC FE 02               CALL   Z,pollk   
00E1   F7                     RST   30h   
00E2                             ; ---- machine code: the grave -----------------------------------------------
00E2                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
00E2                             ; are stored from addr until a non-hex character; then a RET (C9h) is
00E2                             ; written and its address is left. An odd last digit is consumed and dropped.
00E2                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
00E2                             ; code is entered by CALL with the data stack above the return address; it
00E2                             ; must keep BC, and on return the top cell becomes the new TOS.
00E2   CD EC 02     H_GRAVE:   CALL   hexc   
00E5   30 CA                  JR   NC,exec   
00E7   77           HX1:      LD   (HL),A   ; the high digit goes in first ...
00E8   CD EC 02               CALL   hexc   
00EB   30 08                  JR   NC,hx2   ; odd digit: consumed, and the RET below
00ED   ED 6F                  RLD      ;   overwrites it
00EF   23                     INC   HL   ; ... and RLD shifts it up under the low one
00F0   CD EC 02               CALL   hexc   
00F3   38 F2                  JR   C,hx1   
00F5   36 C9        HX2:      LD   (HL),0C9h   ; (never range-checked: the spec says so)
00F7   F7                     RST   30h   
00F8                             ; ---- where the two pages meet ----------------------------------------------
00F8                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
00F8                             ; are in falling code order for this), and where exactly differs between the
00F8                             ; builds: NPG1 follows. Every handler below these four must start in the
00F8                             ; second page, and every one above in the first; chktab.py checks both.
00F8                             ; "]" returns: pop an address and jump to it.
00F8   CF           H_RET:    RST   08h   
00F9   42                     LD   B,D   
00FA   4B                     LD   C,E   
00FB   F7           BRK1:     RST   30h   
00FC                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
00FC                             ; drops the block start, "]" returns. No closer at all ends the program.
00FC   7C           H_BREAK:   LD   A,H   
00FD   B5                     OR   L   
00FE   E1                     POP   HL   
00FF   28 FA                  JR   Z,brk1   
0101   CD 75 02               CALL   skip   
0104   B7                     OR   A   ; skip returns 0 for ")"
0105   20 F1                  JR   NZ,h_ret   
0107   CF           RDROP:    RST   08h   
0108   F7                     RST   30h   
0109                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
0109                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
0109                             ; the body"s address instead. Either way it then skips to the matching "]'.
0109                             ; (The unchecked build takes anything that is not a letter as the space; the
0109                             ; checked build stops on it.)
0109   0A           H_DEF:    LD   A,(BC)   
010A   03                     INC   BC   
010B   D6 41                  SUB   "A"   ; a letter gives 0-25 or 32-57: lowercase
010D   5F                     LD   E,A   ;   lands 64 bytes up
010E   E6 DF                  AND   0DFh   ; fold case
0110   FE 1A                  CP   26   
0112   30 0B                  JR   NC,def2   ; not a letter
0114   CB 23                  SLA   E   
0116   16 82                  LD   D,LETPAGE   ; DE -> cell
0118   79                     LD   A,C   
0119   12                     LD   (DE),A   
011A   1C                     INC   E   
011B   78                     LD   A,B   
011C   12                     LD   (DE),A   
011D   18 09                  JR   skipnx   
011F                DEF2:        
011F                          IF   CHECKED   
011F   7B                     LD   A,E   
0120   FE DF                  CP   " "-"A"+256   
0122   C2 AA 03               JP   NZ,e_brack   ; anything but a letter or a space
0125                          ENDIF      
0125   E5                     PUSH   HL   ; an anonymous block: push its address
0126   60                     LD   H,B   
0127   69                     LD   L,C   
0128                SKIPNX:      
0128                          IF   CHECKED   
0128   0B                     DEC   BC   ; back onto the letter, so that skip finds its
0129                          ENDIF      ;   opener, the "[", just before where it starts
0129   CD 75 02     SKIPO:    CALL   skip   
012C   F7                     RST   30h   
012D   5E           H_FETCH:   LD   E,(HL)   ; "@"
012E   23                     INC   HL   
012F   56                     LD   D,(HL)   
0130   EB                     EX   DE,HL   
0131   F7                     RST   30h   
0132                             ; =============================================================================
0132                             ;  Handlers that must start in the image's second page.
0132                             ;  "?" is the last (with "," inside it), so its long tail may run past that
0132                             ;  page.
0132                             ; =============================================================================
0132                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
0132                             ; the matching ")".
0132   7C           H_OPEN:   LD   A,H   
0133   B5                     OR   L   
0134   E1                     POP   HL   
0135   28 F2                  JR   Z,skipo   
0137   C5                     PUSH   BC   ; the block starts at the IP
0138   18 9C                  JR   rpushn   
013A                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
013A                             ; drops it and carries on.
013A   7C           H_CLOSE:   LD   A,H   
013B   B5                     OR   L   
013C   E1                     POP   HL   
013D   28 C8                  JR   Z,rdrop   
013F   CF                     RST   08h   ; pop the block start ...
0140   42                     LD   B,D   
0141   4B                     LD   C,E   
0142   C5                     PUSH   BC   
0143   18 91                  JR   rpushn   ; ... and push it back
0145                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
0145                             ; "-" has two jobs: directly before a digit it starts a negative number.
0145   0A           H_SUB:    LD   A,(BC)   
0146   D6 30                  SUB   "0"   
0148   FE 0A                  CP   10   
014A   38 04                  JR   C,negnum   
014C   E7                     RST   20h   ; a - b = a + (-b): fall into "+"
014D   D1           H_ADD:    POP   DE   
014E   19                     ADD   HL,DE   
014F   F7                     RST   30h   
0150   E5           NEGNUM:   PUSH   HL   ; a negative number: read it, negate it
0151   CD 4E 02               CALL   rdnum   
0154   E7                     RST   20h   
0155   F7                     RST   30h   
0156   D1           H_AND:    POP   DE   
0157   7C                     LD   A,H   
0158   A2                     AND   D   
0159   67                     LD   H,A   
015A   7D                     LD   A,L   
015B   A3                     AND   E   
015C   6F                     LD   L,A   
015D   F7                     RST   30h   
015E                             ; Signed compares. Both are "HL < DE" for the right pair: "<" swaps the two
015E                             ; cells first. Flipping both sign bits turns a signed compare into an
015E                             ; unsigned one (and XOR clears the carry for SBC); SBC HL,HL then turns the
015E                             ; carry into -1 or 0 with no branch.
015E   E3           H_LT:     EX   (SP),HL   ; a < b: HL = a, and b is popped next
015F   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
0160   7C                     LD   A,H   
0161   EE 80                  XOR   80h   
0163   67                     LD   H,A   
0164   7A                     LD   A,D   
0165   EE 80                  XOR   80h   
0167   57                     LD   D,A   
0168   ED 52                  SBC   HL,DE   ; carry if HL < DE
016A   ED 62        TF:       SBC   HL,HL   ; carry -> -1 or 0
016C   F7                     RST   30h   
016D   D1           H_EQ:     POP   DE   
016E   B7                     OR   A   
016F   ED 52                  SBC   HL,DE   
0171   7C                     LD   A,H   
0172   B5                     OR   L   
0173   FE 01                  CP   1   ; carry only if a - b = 0
0175   18 F3                  JR   tf   
0177                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept. The
0177                             ; multiplier shifts up through A:C.
0177   D1           H_MUL:    POP   DE   ; DE = multiplicand
0178   C5                     PUSH   BC   
0179   7C                     LD   A,H   
017A   4D                     LD   C,L   ; A:C = multiplier
017B   21 00 00               LD   HL,0   
017E   06 10                  LD   B,16   
0180   29           MUL1:     ADD   HL,HL   
0181   CB 21                  SLA   C   
0183   17                     RLA      
0184   30 01                  JR   NC,mul2   
0186   19                     ADD   HL,DE   
0187   10 F7        MUL2:     DJNZ   mul1   
0189   C1                     POP   BC   
018A   F7                     RST   30h   
018B                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
018B                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
018B                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
018B                             ; stops on it.
018B                H_DIV:       
018B                          IF   CHECKED   
018B   7C                     LD   A,H   
018C   B5                     OR   L   
018D   CA A7 03               JP   Z,e_zero   
0190                          ENDIF      
0190   D1                     POP   DE   ; DE = a, HL = b
0191   C5                     PUSH   BC   ; free BC for udiv
0192   D5                     PUSH   DE   ; a, for r's sign
0193   7A                     LD   A,D   
0194   AC                     XOR   H   
0195   F5                     PUSH   AF   ; S flag = sign of q
0196   CB 7C                  BIT   7,H   
0198   C4 20 00               CALL   NZ,neg16   ; HL = |b|
019B   EB                     EX   DE,HL   
019C   CB 7C                  BIT   7,H   
019E   C4 20 00               CALL   NZ,neg16   ; HL = |a|, DE = |b|
01A1   CD 28 02               CALL   udiv   ; HL = q, DE = r
01A4   F1                     POP   AF   
01A5   FC 20 00               CALL   M,neg16   ; q's sign
01A8   EB                     EX   DE,HL   ; HL = r, DE = q
01A9   F1                     POP   AF   ; A = a's high byte
01AA   B7                     OR   A   
01AB   FC 20 00               CALL   M,neg16   ; r's sign
01AE   C1                     POP   BC   
01AF   D5                     PUSH   DE   ; q under r
01B0   F7                     RST   30h   
01B1                             ; ---- stack and storage -----------------------------------------------------
01B1   E5           H_DUP:    PUSH   HL   ; ":"
01B2   F7                     RST   30h   
01B3   E3           H_SWAP:   EX   (SP),HL   ; "%"
01B4   F7                     RST   30h   
01B5                             ; (The checked build tests the address before it takes the value off the
01B5                             ; stack, so that an error report shows both.)
01B5                H_CSTORE:      ; "." ( c addr -- )
01B5                          IF   CHECKED   
01B5   CD 3C 03               CALL   chkst   
01B8                          ENDIF      
01B8   D1                     POP   DE   
01B9   73                     LD   (HL),E   
01BA   DF           H_DROP:   RST   18h   ; ";" is this one byte
01BB                H_STORE:      ; "!" ( n addr -- )
01BB                          IF   CHECKED   
01BB   CD 3C 03               CALL   chkst   
01BE                          ENDIF      
01BE   D1                     POP   DE   
01BF   73                     LD   (HL),E   
01C0   23                     INC   HL   
01C1   72                     LD   (HL),D   
01C2   DF                     RST   18h   
01C3                             ; ---- console ---------------------------------------------------------------
01C3                             ; 22h pushes the address of the text after it and skips the string.
01C3   E5           H_STR:    PUSH   HL   
01C4   60                     LD   H,B   
01C5   69                     LD   L,C   
01C6   CD 64 02               CALL   skipstr   
01C9                          IF   CHECKED   
01C9   B7                     OR   A   ; 0: the text ran out before the closing quote
01CA   CA 9F 03               JP   Z,e_quote   
01CD                          ENDIF      
01CD   F7                     RST   30h   
01CE                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character
01CE                             ; clears that character"s bit 6 (/M is CR, /` is space; "/" and ""' have no
01CE                             ; bit 6, so // and /" give themselves).
01CE                          IF   (1-CHECKED)*(1-EDITOR)   
                    H_PRINT:   LD   A,(HL)   
                              INC   HL   
                              CP   22h   
                              JR   Z,pr9   
                              CP   "/"   
                              JR   NZ,pr1   
                              LD   A,(HL)   
                              INC   HL   
                              AND   0BFh   
                    PR1:      RST   28h   
                              JR   h_print   
01CE                          ENDIF      
01CE                          IF   CHECKED   
01CE                             ; (The checked build has the loop as a routine, prstr, which the error
01CE                             ; report uses too. The address is kept on the stack meanwhile: a report
01CE                             ; shows the stack as it was before the "$".)
01CE   E5           H_PRINT:   PUSH   HL   
01CF   CD 6C 04               CALL   prstr   
01D2   D1                     POP   DE   
01D3   DF                     RST   18h   
01D4                          ENDIF      
01D4                          IF   (1-CHECKED)*EDITOR   
                                 ; (With the editor the loop is a routine, prstr, which ^V uses too.)
                    H_PRINT:   CALL   prstr   
                              RST   18h   
01D4                          ENDIF      
01D4   7D           H_EMIT:   LD   A,L   ; "'"
01D5   EF                     RST   28h   
01D6   DF           PR9:      RST   18h   
01D7                             ; "#" prints TOS as a signed decimal number, with no space after it.
01D7   C5           H_NUM:    PUSH   BC   
01D8   CD B2 02               CALL   psgn   
01DB   C1                     POP   BC   
01DC   DF                     RST   18h   
01DD                             ; "?" ( n -- c ) or ( -n -- addr )
01DD                             ;   n > 0: wait about n ms for a key; 0 if none came
01DD                             ;   n = 0: wait for a key
01DD                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
01DD                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
01DD   CB 7C        H_KEY:    BIT   7,H   
01DF   20 19                  JR   NZ,line   
01E1   1E 28        KT1:      LD   E,MSLOOP   ; one millisecond, roughly
01E3   CD 2C 03     KT2:      CALL   getk   
01E6   20 0E                  JR   NZ,kt3   
01E8   1D                     DEC   E   
01E9   20 F8                  JR   NZ,kt2   
01EB   7C                     LD   A,H   ; 0? never counts down: it waits
01EC   B5                     OR   L   
01ED   28 F2                  JR   Z,kt1   
01EF   2B                     DEC   HL   
01F0   7C                     LD   A,H   
01F1   B5                     OR   L   
01F2   20 ED                  JR   NZ,kt1   ; A = 0 if the time ran out
01F4   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
01F5   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
01F6   6F           KT3:      LD   L,A   
01F7   26 00                  LD   H,0   
01F9   F7                     RST   30h   
01FA                          IF   CPM   
                                 ; CP/M: BDOS 10 does the editing (the spec allows the platform's
                                 ; own line editor). It doesn't store the CR, so it is added here.
                    LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
                              ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
                              SBC   A,A   
                              AND   L   ; (0 for a count that is too big)
                              XOR   127   ; A = the count, 127 at most
                              LD   (LBHDR),A   
                              LD   DE,LBHDR   
                              LD   A,10   
                              CALL   bdosx   
                              LD   HL,LBHDR+1   
                              LD   A,(HL)   ; the count typed (0-127)
                              INC   L   ; HL = LINEBUF, whose low byte is 80h:
                              ADD   A,L   ;   adding the count to L can't carry
                              LD   L,A   
                              LD   (HL),13   
01FA                          ENDIF      
01FA                          IFN   CPM   
01FA                             ; Generic: Backspace takes the last character back (and is echoed as
01FA                             ; it is), CR ends (stored, not echoed), every other key is stored and
01FA                             ; echoed until the line is full. The line buffer starts at offset 80h
01FA                             ; of its page, so L alone is the place in the line: D holds the L of
01FA                             ; a full line.
01FA   11 7F 00     LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
01FD   19                     ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
01FE   9F                     SBC   A,A   
01FF   A5                     AND   L   ; (0 for a count that is too big)
0200   2F                     CPL      
0201   57                     LD   D,A   ; D = the L of a full line: 80h + count, FFh
0202                             ;   at most
0202   21 80 82               LD   HL,LINEBUF   
0205   CD 2C 03     LN2:      CALL   getk   
0208   28 FB                  JR   Z,ln2   
020A   FE 0D                  CP   13   
020C   28 16                  JR   Z,ln5   
020E   FE 08                  CP   8   
0210   28 0B                  JR   Z,ln4   
0212   5F                     LD   E,A   
0213   7D                     LD   A,L   
0214   BA                     CP   D   
0215   28 EE                  JR   Z,ln2   ; full
0217   73                     LD   (HL),E   
0218   2C                     INC   L   
0219   7B                     LD   A,E   
021A   EF           LN3:      RST   28h   
021B   18 E8                  JR   ln2   
021D   2D           LN4:      DEC   L   ; Backspace: one back, and echo it,
021E   FA 1A 02               JP   M,ln3   ;   unless the line was empty (L left the
0221   2C                     INC   L   ;   upper half of the page)
0222   18 E1                  JR   ln2   
0224   77           LN5:      LD   (HL),A   ; the CR
0225                          ENDIF      
0225   2E 80                  LD   L,LINEBUF & 0FFh   
0227   F7                     RST   30h   
0228                             ; =============================================================================
0228                             ;  More routines (no handler starts past this point)
0228                             ; =============================================================================
0228                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
0228                             ; Uses A, BC; the caller saves the IP. The dividend shifts up through A:C
0228                             ; while the quotient bits arrive at the bottom of C.
0228                             ; Dividing by 2 is one shift (the spec wants that fast).
0228   7B           UDIV:     LD   A,E   
0229   EE 02                  XOR   2   
022B   B2                     OR   D   
022C   20 07                  JR   NZ,udv0   
022E   CB 3C                  SRL   H   
0230   CB 1D                  RR   L   ; the quotient
0232   8F                     ADC   A,A   
0233   5F                     LD   E,A   ; the remainder: the bit that fell out (D is 0)
0234   C9                     RET      
0235   7C           UDV0:     LD   A,H   
0236   4D                     LD   C,L   
0237   21 00 00               LD   HL,0   
023A   06 10                  LD   B,16   
023C   CB 21        UDV1:     SLA   C   
023E   17                     RLA      
023F   ED 6A                  ADC   HL,HL   
0241   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
0243   30 02                  JR   NC,udv2   ;   always fits in 16 bits
0245   19                     ADD   HL,DE   ; too much: put it back, and cancel the
0246   0D                     DEC   C   ;   INC below
0247   0C           UDV2:     INC   C   ; a quotient bit
0248   10 F2                  DJNZ   udv1   
024A   EB                     EX   DE,HL   ; DE = remainder
024B   67                     LD   H,A   
024C   69                     LD   L,C   ; HL = quotient
024D   C9                     RET      
024E                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
024E                             ; non-digit. Values wrap at 16 bits, as the spec says.
024E   21 00 00     RDNUM:    LD   HL,0   
0251   0A           RDN1:     LD   A,(BC)   
0252   D6 30                  SUB   "0"   
0254   FE 0A                  CP   10   
0256   D0                     RET   NC   
0257   03                     INC   BC   
0258   54                     LD   D,H   
0259   5D                     LD   E,L   
025A   29                     ADD   HL,HL   
025B   29                     ADD   HL,HL   
025C   19                     ADD   HL,DE   
025D   29                     ADD   HL,HL   ; HL * 10
025E   5F                     LD   E,A   
025F   16 00                  LD   D,0   
0261   19                     ADD   HL,DE   
0262   18 ED                  JR   rdn1   
0264                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
0264                             ; the next character, so "/"" does not end it. Leaves A = 22h.
0264                          IF   1-CHECKED   
                    SS0:      INC   BC   
                    SKIPSTR:   LD   A,(BC)   
                              INC   BC   
                              CP   "/"   
                              JR   Z,ss0   
                              CP   22h   
                              JR   NZ,skipstr   
                              RET      
0264                          ENDIF      
0264                          IF   CHECKED   
0264                             ; The checked build never steps over a NUL: if the text runs out first it
0264                             ; returns A = 0 with the IP on the NUL.
0264   0A           SKIPSTR:   LD   A,(BC)   
0265   B7                     OR   A   
0266   C8                     RET   Z   
0267   03                     INC   BC   
0268   FE 22                  CP   22h   
026A   C8                     RET   Z   
026B   FE 2F                  CP   "/"   
026D   20 F5                  JR   NZ,skipstr   
026F   0A                     LD   A,(BC)   ; the escaped character
0270   B7                     OR   A   
0271   C8                     RET   Z   
0272   03                     INC   BC   
0273   18 EF                  JR   skipstr   
0275                          ENDIF      
0275                             ; skip: read past text to the closer at this level, and return A = 0 if it
0275                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
0275                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
0275                             ; no closer; anything else that runs into the NUL had unbalanced brackets
0275                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
0275                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
0275                             ; 
0275                             ; The checked build also looks at the character the skip was started by,
0275                             ; which is always the one just before where it starts: "(" must end at ")",
0275                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
0275                             ; quote counts as running into it. "\" takes either closer. IX keeps the
0275                             ; place where the skip started, for the report.
0275                SKIP:        
0275                          IF   CHECKED   
0275   C5                     PUSH   BC   
0276   DD E1                  POP   IX   
0278   0B                     DEC   BC   
0279   0A                     LD   A,(BC)   
027A   03                     INC   BC   
027B   5F                     LD   E,A   ; E = the opener: ( [ or \
027C                          ENDIF      
027C   16 00                  LD   D,0   
027E   14           SK3:      INC   D   ; an opener: one deeper
027F   0A           SK1:      LD   A,(BC)   
0280                          IF   1-CHECKED   
                              INC   BC   
                              OR   A   
                              JP   Z,SKEND   ; (the end of the program)
0280                          ENDIF      
0280                          IF   CHECKED   
0280   B7                     OR   A   
0281   28 22                  JR   Z,sk6   ; (the IP stays on the NUL)
0283   03                     INC   BC   
0284                          ENDIF      
0284   FE 22                  CP   22h   
0286   CC 64 02               CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
0289   D6 28                  SUB   "("   ;   (or 0, and then the NUL is read next)
028B   28 F1                  JR   Z,sk3   
028D   3D                     DEC   A   ; ")"
028E   28 08                  JR   Z,sk4   
0290   D6 32                  SUB   "["-")"   
0292   28 EA                  JR   Z,sk3   
0294   FE 02                  CP   "]"-"["   
0296   20 E7                  JR   NZ,sk1   
0298   15           SK4:      DEC   D   
0299                          IF   1-CHECKED   
                              RET   Z   ; the closer at this level
                              JR   sk1   
0299                          ENDIF      
0299                          IF   CHECKED   
0299   20 E4                  JR   NZ,sk1   
029B   57                     LD   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
029C   AB                     XOR   E   ;   opener is 0 for "(" and 1 for "[", and only
029D   E6 06                  AND   6   ;   "\" has bit 2: so this is 2 for the wrong
029F   FE 02                  CP   2   ;   closer, and only then
02A1   7A                     LD   A,D   
02A2   C0                     RET   NZ   
02A3   18 05                  JR   sk7   
02A5   CB 53        SK6:      BIT   2,E   ; the text ran out:
02A7   C2 09 FF               JP   NZ,SKEND   ;   "\" with no closer ends the program
02AA   DD E5        SK7:      PUSH   IX   ; N. The place is the opener
02AC   C1                     POP   BC   
02AD   3E 4E                  LD   A,"N"   
02AF   C3 9C 03               JP   errp   ; (errp drops skip's return address)
02B2                          ENDIF      
02B2                             ; psgn: print HL as a signed number. Uses BC.
02B2   CB 7C        PSGN:     BIT   7,H   
02B4   28 04                  JR   Z,pdec   
02B6   3E 2D                  LD   A,"-"   
02B8   EF                     RST   28h   
02B9   E7                     RST   20h   
02BA                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
02BA                             ; Uses BC.
02BA   11 0A 00     PDEC:     LD   DE,10   
02BD   CD 28 02               CALL   udiv   ; HL = HL / 10, E = the last digit
02C0   7B                     LD   A,E   
02C1   F5                     PUSH   AF   
02C2   7C                     LD   A,H   
02C3   B5                     OR   L   
02C4   C4 BA 02               CALL   NZ,pdec   
02C7   F1                     POP   AF   
02C8   C6 30                  ADD   A,"0"   
02CA   EF                     RST   28h   
02CB   C9                     RET      
02CC                             ; =============================================================================
02CC                             ;  Dispatch table: the low byte of each handler's address, in code order
02CC                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
02CC                             ;  It must not cross a page (the dispatcher only adds to its low byte).
02CC                             ; =============================================================================
02CC                             ; The handlers of the first NPG1 characters start in the image's second page.
02CC                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
02CC                             ; differs between the builds, so the count is worked out here.
02CC                             ; (One division to a line: asm80 only rounds down when it stores a value.)
02CC                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
02CC                PGBRK:    EQU   (h_break-BASE)/256   
02CC                PGDEF:    EQU   (h_def-BASE)/256   
02CC                PGFET:    EQU   (h_fetch-BASE)/256   
02CC                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
02CC                          IF   1-TABP0   
02CC                PTAB:        
02CC                          ;*Macro unroll:  PTABLE
02CC   BB                     DB   h_store & 0FFh   
02CD   C3                     DB   h_str & 0FFh   
02CE   D7                     DB   h_num & 0FFh   
02CF   CE                     DB   h_print & 0FFh   
02D0   B3                     DB   h_swap & 0FFh   
02D1   56                     DB   h_and & 0FFh   
02D2   D4                     DB   h_emit & 0FFh   
02D3   32                     DB   h_open & 0FFh   
02D4   3A                     DB   h_close & 0FFh   
02D5   77                     DB   h_mul & 0FFh   
02D6   4D                     DB   h_add & 0FFh   
02D7   F5                     DB   h_cfetch & 0FFh   
02D8   45                     DB   h_sub & 0FFh   
02D9   B5                     DB   h_cstore & 0FFh   
02DA   8B                     DB   h_div & 0FFh   
02DB   B1                     DB   h_dup & 0FFh   
02DC   BA                     DB   h_drop & 0FFh   
02DD   5E                     DB   h_lt & 0FFh   
02DE   6D                     DB   h_eq & 0FFh   
02DF   5F                     DB   h_gt & 0FFh   
02E0   DD                     DB   h_key & 0FFh   
02E1   2D                     DB   h_fetch & 0FFh   
02E2   09                     DB   h_def & 0FFh   
02E3   FC                     DB   h_break & 0FFh   
02E4   F8                     DB   h_ret & 0FFh   
02E5   91                     DB   h_xor & 0FFh   
02E6   A4                     DB   h_alloc & 0FFh   
02E7   E2                     DB   h_grave & 0FFh   
02E8   2C                     DB   h_tor & 0FFh   
02E9   99                     DB   h_or & 0FFh   
02EA   1C                     DB   h_fromr & 0FFh   
02EB   A1                     DB   h_not & 0FFh   
02EC                PTABEND:      
02EC                          ENDIF      
02EC                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
02EC                             ; and return its value in A with the carry set; otherwise leave the IP and
02EC                             ; return with the carry clear.
02EC   0A           HEXC:     LD   A,(BC)   
02ED   D6 30                  SUB   "0"   
02EF   FE 0A                  CP   10   
02F1   38 09                  JR   C,hc1   
02F3   E6 DF                  AND   0DFh   
02F5   D6 11                  SUB   11h   
02F7   FE 06                  CP   6   
02F9   D0                     RET   NC   
02FA   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
02FC   03           HC1:      INC   BC   
02FD   C9                     RET      
02FE                             ; =============================================================================
02FE                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
02FE                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
02FE                             ;  (RST 28h) prints A. Both keep BC, DE, HL and HL'. In the generic build
02FE                             ;  they are the host's KEY and CONOUT routines themselves.
02FE                             ; 
02FE                             ;  A running program reads the keyboard only through getk and pollk, which
02FE                             ;  between them give the break key its rules:
02FE                             ;    - Ctrl-C stops the program;
02FE                             ;    - any other key that the break check reads is held in KEYBUF for the
02FE                             ;      next "?", and a newer one takes its place;
02FE                             ;    - "?" (getk) takes the held key first;
02FE                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
02FE                             ;      key like any other, but two of them within about 250 ms still stop it.
02FE                             ;  Both are called straight from a handler, never from a routine under one:
02FE                             ;  the checked build's report counts on finding one return address above the
02FE                             ;  data stack.
02FE                             ; =============================================================================
02FE                          IFN   CPM   
02FE                RAWK:     EQU   KEY   
02FE                          ENDIF      
02FE                             ; pollk: the break check (see rpushn).
02FE   CD 06 FF     POLLK:    CALL   rawk   
0301   C8                     RET   Z   ; no key
0302   32 7A 82               LD   (KEYBUF),A   ; held for the next "?"
0305   FE 03        PK1:      CP   3   ; (getk joins here)
0307   C0                     RET   NZ   
0308                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
0308                             ; the program has turned it off, wait about 250 ms for one more key: a
0308                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
0308                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
0308   3A 7B 82     CTLC:     LD   A,(BRKOFF)   
030B   B7                     OR   A   
030C   CA 94 03     CT0:      JP   Z,brk   
030F   D5                     PUSH   DE   
0310   11 10 27               LD   DE,250*MSLOOP   
0313   CD 06 FF     CT1:      CALL   rawk   
0316   20 05                  JR   NZ,ct2   
0318   1B                     DEC   DE   
0319   7A                     LD   A,D   
031A   B3                     OR   E   
031B   20 F6                  JR   NZ,ct1   
031D   D1           CT2:      POP   DE   ; A = the second key, or 0 if none came
031E   FE 03                  CP   3   
0320   28 EA                  JR   Z,ct0   ; (the zero flag takes the JP there)
0322   B7                     OR   A   
0323   28 03                  JR   Z,ct3   
0325   32 7A 82               LD   (KEYBUF),A   
0328   3E 03        CT3:      LD   A,3   
032A   B7                     OR   A   
032B   C9                     RET      
032C                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
032C   E5           GETK:     PUSH   HL   ; a held key goes first, and is taken out of
032D   21 7A 82               LD   HL,KEYBUF   ;   the buffer
0330   7E                     LD   A,(HL)   
0331   36 00                  LD   (HL),0   
0333   E1                     POP   HL   
0334   B7                     OR   A   
0335   C0                     RET   NZ   
0336   CD 06 FF               CALL   rawk   
0339   C8                     RET   Z   
033A   18 C9                  JR   pk1   ; Ctrl-C? If not, that is the key
033C                          IF   (1-CHECKED)*(1-EDITOR)   
                    BRK:      EQU   endprog   ; the unchecked build stops without a word
033C                          ENDIF      ;   (with the editor, both stacks are cleared);
033C                          IF   (1-CHECKED)*EDITOR   
                    BRK:      EQU   edit0   
033C                          ENDIF      
033C                          IF   CHECKED   
033C                BRK:      EQU   e_break   ;   the checked build reports B
033C                          ENDIF      
033C                          IF   CPM   
                    RAWK:     LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
                                 ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
                                 ; printing and could swallow a key that BDOS 6 then never sees.
                    PUTC:     PUSH   DE   
                              PUSH   HL   
                              LD   E,A   
                              LD   A,6   
                              CALL   bdosx   
                              POP   HL   
                              POP   DE   
                              OR   A   ; (for getk)
                              RET      
                                 ; bdosx: call BDOS function A with DE, keeping BC and HL'
                    BDOSX:    PUSH   BC   
                              EXX      
                              PUSH   HL   
                              EXX      
                              LD   C,A   
                              CALL   BDOS   
                              EXX      
                              POP   HL   
                              EXX      
                              POP   BC   
                              RET      
033C                          ENDIF      
033C                             ; =============================================================================
033C                             ;  Checked build: the checks and the error report
033C                             ; =============================================================================
033C                          IF   CHECKED   
033C                             ; chkst: stop unless HL is in the program's own space: from the letter page
033C                             ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
033C                             ; whatever lies above the limit are safe. Memory above the heap top but
033C                             ; below the limit is the program's own: Tiny BASIC keeps its lines there.
033C                             ; It is the page of HL + 1 that is tested, so that one test serves both
033C                             ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
033C                             ; Keeps HL and BC.
033C   23           CHKST:    INC   HL   
033D   7C                     LD   A,H   
033E   2B                     DEC   HL   
033F   FE 82                  CP   LETPAGE   
0341   38 03                  JR   C,chs1   
0343                          ENDIF      
0343                          IF   CHECKED*(1-CPM)   
0343   FE F0                  CP   HEAPLIM   
0345   D8                     RET   C   
0346                          ENDIF      
0346                          IF   CHECKED*CPM   
                              LD   E,A   
                              LD   A,(0007h)   ; the BDOS page is the heap limit
                              DEC   A   
                              CP   E   
                              RET   NC   
0346                          ENDIF      
0346                          IF   CHECKED   
0346   C3 9A 03     CHS1:     JP   e_store   
0349                             ; chkhp: HL = the new heap top, DE = the old one, the carry is from adding
0349                             ; the count. Stop if the top is not below the limit page, or is below the
0349                             ; program's end.
0349                CHKHP:       
0349                          ENDIF      
0349                          IF   CHECKED*CPM   
                                 ; With this much room a top that wrapped round can land back in
                                 ; range, so the add is tested too: growing (A, the count's high
                                 ; byte, is positive) must not carry, and releasing must.
                              RRA      ; the carry comes in above the sign:
                              ADD   A,40h   ;   bit 7 = carry XOR sign
                              ADD   A,A   
                              JR   C,e_heap   
                              LD   A,(0007h)   
                              DEC   A   
                              CP   H   
                              JR   C,e_heap   
0349                          ENDIF      
0349                          IF   CHECKED*(1-CPM)   
0349                             ; (Here the program's space is under 32K, so a top that wrapped
0349                             ; round always falls outside it.)
0349   7C                     LD   A,H   
034A   FE F0                  CP   HEAPLIM   
034C   30 09                  JR   NC,e_heap   
034E                          ENDIF      
034E                          IF   CHECKED   
034E   D5                     PUSH   DE   
034F   EB                     EX   DE,HL   
0350   2A 38 82               LD   HL,(NPEND)   
0353   19                     ADD   HL,DE   ; carry: at or above the program's end
0354   EB                     EX   DE,HL   
0355   D1                     POP   DE   
0356   D8                     RET   C   
0357   B7           E_HEAP:   OR   A   ; put the count back in TOS for the report
0358   ED 52                  SBC   HL,DE   
035A   C3 97 03               JP   e_heap1   
035D                             ; chkstk: both stacks are checked once per character, not in every handler.
035D                             ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
035D                             ; the constant carries if it is above (cells were popped that were never
035D                             ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
035D                             ; a character late at most: the bytes above DSTOP and the guard band below
035D                             ; the page take what happens meanwhile. DE is free between characters.
035D   EB           CHKSTK:   EX   DE,HL   
035E   21 05 7E               LD   HL,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
0361   39                     ADD   HL,SP   
0362   EB                     EX   DE,HL   
0363   38 1E                  JR   C,e_under   
0365   14                     INC   D   
0366   20 17                  JR   NZ,e_over   
0368   D9                     EXX      ; the return stack: in its page (or it has
0369   7C                     LD   A,H   ;   overflowed), and not above its empty
036A   FE 80                  CP   RSPAGE   ;   position (an underflow stays inside the
036C   7D                     LD   A,L   ;   page, in the guard band)
036D   D9                     EXX      
036E   20 0C                  JR   NZ,e_rover   
0370   FE E1                  CP   RSTOP&0FFh+1   
0372   D8                     RET   C   
0373   D9                     EXX      ; return stack underflow: it counts as empty
0374   21 E0 80               LD   HL,RSTOP   
0377   D9                     EXX      
0378   3E 72                  LD   A,"r"   
037A   18 20                  JR   errp   
037C   3E 52        E_ROVER:   LD   A,"R"   ; return stack overflow
037E   11                     DB   11h   ; (LD DE,nn hides the next entry)
037F   3E 53        E_OVER:   LD   A,"S"   ; data stack overflow
0381   18 19                  JR   errp   
0383   31 FC 81     E_UNDER:   LD   SP,DSTOP   ; data stack underflow: it counts as empty
0386   3E 73                  LD   A,"s"   
0388   18 22                  JR   error   
038A                             ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
038A                             ; was never defined still holds 0000h, and the byte there is a reserved one
038A                             ; in every build (AFh or C3h): if the IP is in page zero, this was a call of
038A                             ; an undefined word. The call is undone, so the place is the call itself.
038A   04           E_HI:     INC   B   
038B   10 17                  DJNZ   e_resv   ; (B is as it was, and is not 0)
038D   CF                     RST   08h   
038E   42                     LD   B,D   
038F   4B                     LD   C,E   
0390   3E 55                  LD   A,"U"   
0392   18 18                  JR   error   
0394                             ; Error entries. Each loads its letter and then hides the next entry inside
0394                             ; a 3-byte LD DE,nn (the 11h), so they all fall through to `error`.
0394   3E 42        E_BREAK:   LD   A,"B"   ; Ctrl-C (found inside pollk or getk)
0396   11                     DB   11h   
0397   3E 48        E_HEAP1:   LD   A,"H"   ; heap (found inside chkhp)
0399   11                     DB   11h   
039A   3E 4F        E_STORE:   LD   A,"O"   ; a store outside the program's space (chkst)
039C                             ; errp: an error found inside a routine: drop its return address first.
039C   D1           ERRP:     POP   DE   
039D   18 0D                  JR   error   
039F   44           E_QUOTE:   LD   B,H   ; an unclosed string: HL is its address, one
03A0   4D                     LD   C,L   ;   past the opening quote, which is the place
03A1   3E 51                  LD   A,"Q"   
03A3   11                     DB   11h   
03A4   3E 58        E_RESV:   LD   A,"X"   ; a reserved byte outside a string
03A6   11                     DB   11h   
03A7   3E 5A        E_ZERO:   LD   A,"Z"   ; dividing by zero
03A9   11                     DB   11h   
03AA   3E 57        E_BRACK:   LD   A,"W"   ; bad character after [
03AC                             ; error: the report, then the end. A = the letter, BC = one past the place,
03AC                             ; HL = TOS, and both stacks as the report is to show them:
03AC                             ; 
03AC                             ;   Err X @ line,col
03AC                             ;   up to 16 characters of the text from the place
03AC                             ;   Stk n: the top 8 cells at most, bottom to top
03AC                             ;   Rtn n
03AC   E5           ERROR:    PUSH   HL   ; now the whole data stack is in memory
03AD   5F                     LD   E,A   
03AE   CD 7F 04               CALL   pnl   
03B1   45 72 72 20 22         DB   "Err ",22h   
03B6   7B                     LD   A,E   
03B7   EF                     RST   28h   
03B8   CD 85 04               CALL   pmsg   
03BB   20 40 20 22            DB   " @ ",22h   
03BF   0B                     DEC   BC   ; BC = the place
03C0                             ; The line and column. A place below the program is in the line
03C0                             ; buffer: line 0. Otherwise count the LFs from the program's start;
03C0                             ; DE = the line's number, HL = where it starts.
03C0   21 80 82               LD   HL,LINEBUF   
03C3   11 00 00               LD   DE,0   
03C6   78                     LD   A,B   
03C7   FE 83                  CP   PROG/256   
03C9   38 14                  JR   C,er3   
03CB   24                     INC   H   
03CC   6B                     LD   L,E   ; HL = PROG
03CD   13           ER1:      INC   DE   ; a new line starts at HL
03CE   E5                     PUSH   HL   
03CF   7D           ER2:      LD   A,L   
03D0   91                     SUB   C   
03D1   7C                     LD   A,H   
03D2   98                     SBC   A,B   
03D3   30 09                  JR   NC,er2x   ; reached the place
03D5   7E                     LD   A,(HL)   
03D6   23                     INC   HL   
03D7   FE 0A                  CP   10   
03D9   20 F4                  JR   NZ,er2   
03DB   F1                     POP   AF   
03DC   18 EF                  JR   er1   
03DE   E1           ER2X:     POP   HL   
03DF   C5           ER3:      PUSH   BC   
03E0   E5                     PUSH   HL   
03E1   EB                     EX   DE,HL   
03E2   CD BA 02               CALL   pdec   ; the line
03E5   3E 2C                  LD   A,","   
03E7   EF                     RST   28h   
03E8   D1                     POP   DE   
03E9   E1                     POP   HL   
03EA   E5                     PUSH   HL   
03EB   B7                     OR   A   
03EC   ED 52                  SBC   HL,DE   
03EE   23                     INC   HL   
03EF   CD BA 02               CALL   pdec   ; the column
03F2   CD 7F 04               CALL   pnl   
03F5   22                     DB   22h   
03F6   E1                     POP   HL   ; the text, as it is: 16 characters, or fewer
03F7   06 10                  LD   B,16   ;   if the line or the program ends first
03F9   7E           ER4:      LD   A,(HL)   
03FA   23                     INC   HL   
03FB   B7                     OR   A   
03FC   28 0B                  JR   Z,er5   
03FE   FE 0D                  CP   13   
0400   28 07                  JR   Z,er5   
0402   FE 0A                  CP   10   
0404   28 03                  JR   Z,er5   
0406                          ENDIF      
0406                          IF   CHECKED*CPM   
                              CP   1Ah   ; (the ^Z that pads a file's last record ends
                              JR   Z,er5   ;   the text too: some terminals clear the
0406                          ENDIF      ;   screen on it)
0406                          IF   CHECKED   
0406   EF                     RST   28h   
0407   10 F0                  DJNZ   er4   
0409                ER5:         ; (without the editor: on into pstk)
0409                          ENDIF      
0409                          IF   CHECKED*EDITOR   
                              CALL   pstk   
                              CALL   pnl   
                              DB   22h   
                              JP   edit0   ; back to the editor, with both stacks cleared
0409                          ENDIF      
0409                             ; =============================================================================
0409                             ;  Routines that the checked build's report and the editor share
0409                             ; =============================================================================
0409                SPADJ:    EQU   2*EDITOR   ; (with the editor pstk is called, not fallen
0409                             ;   into: the stack is one address deeper)
0409                          IF   CHECKED+EDITOR   
0409                             ; pstk: the two stack lines:  Stk n: the top 8 cells at most, bottom to top
0409                             ;                             Rtn n
0409                             ; TOS must be in memory with the rest (pushed). In a build without the
0409                             ; editor this is the end of `error`, which runs on into it.
0409   CD 7F 04     PSTK:     CALL   pnl   
040C   53 74 6B 20 22         DB   "Stk ",22h   
0411   21 FA 81               LD   HL,DSTOP-2-SPADJ   ; (the cell at DSTOP-2 was pushed with the
0414   B7                     OR   A   ;   first value and holds nothing)
0415   ED 72                  SBC   HL,SP   
0417   CD 62 04               CALL   phalf   ; the depth
041A   3E 3A                  LD   A,":"   
041C   EF                     RST   28h   
041D   79                     LD   A,C   
041E   FE 09                  CP   9   
0420   38 0A                  JR   C,er6   
0422   CD 85 04               CALL   pmsg   
0425   20 2E 2E 2E 22         DB   " ...",22h   
042A   0E 08                  LD   C,8   
042C   26 00        ER6:      LD   H,0   ; C = the number of cells to show
042E   69                     LD   L,C   
042F   29                     ADD   HL,HL   
0430   39                     ADD   HL,SP   ; HL -> just above the deepest of them
0431                          ENDIF      
0431                          IF   EDITOR   
                              INC   HL   
                              INC   HL   
0431                          ENDIF      
0431                          IF   CHECKED+EDITOR   
0431   0C                     INC   C   
0432   0D           ER7:      DEC   C   
0433   28 11                  JR   Z,er8   
0435   2B                     DEC   HL   
0436   56                     LD   D,(HL)   
0437   2B                     DEC   HL   
0438   5E                     LD   E,(HL)   
0439   E5                     PUSH   HL   
043A   C5                     PUSH   BC   
043B   3E 20                  LD   A," "   
043D   EF                     RST   28h   
043E   EB                     EX   DE,HL   
043F   CD B2 02               CALL   psgn   
0442   C1                     POP   BC   
0443   E1                     POP   HL   
0444   18 EC                  JR   er7   
0446   CD 7F 04     ER8:      CALL   pnl   
0449   52 74 6E 20 22         DB   "Rtn ",22h   
044E   D9                     EXX      
044F   E5                     PUSH   HL   
0450   D9                     EXX      
0451   D1                     POP   DE   
0452   21 E0 80               LD   HL,RSTOP   
0455   B7                     OR   A   
0456   ED 52                  SBC   HL,DE   
0458                          ENDIF      
0458                          IF   CHECKED*(1-EDITOR)   
0458   CD 62 04               CALL   phalf   
045B   CD 7F 04               CALL   pnl   
045E   22                     DB   22h   
045F   C3 15 00               JP   endprog   
0462                          ENDIF      
0462                          IF   CHECKED+EDITOR   
0462                             ; phalf: print half of HL, and leave it in C. (With the editor, pstk ends by
0462                             ; running on into this.)
0462   CB 3C        PHALF:    SRL   H   
0464   CB 1D                  RR   L   
0466   E5                     PUSH   HL   
0467   CD BA 02               CALL   pdec   
046A   C1                     POP   BC   
046B   C9                     RET      
046C                             ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
046C                             ; "$", and the texts of the report and the editor). In the checked build a
046C                             ; NUL first is an error: Q.
046C   7E           PRSTR:    LD   A,(HL)   
046D   23                     INC   HL   
046E   FE 22                  CP   22h   
0470   C8                     RET   Z   
0471                          ENDIF      
0471                          IF   CHECKED   
0471   B7                     OR   A   
0472   28 17                  JR   Z,e_dollar   
0474                          ENDIF      
0474                          IF   CHECKED+EDITOR   
0474   FE 2F                  CP   "/"   
0476   20 04                  JR   NZ,prs1   
0478   7E                     LD   A,(HL)   
0479   23                     INC   HL   
047A   E6 BF                  AND   0BFh   
047C   EF           PRS1:     RST   28h   
047D   18 ED                  JR   prstr   
047F                             ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
047F                             ; pnl: the same, on a new line.
047F   3E 0D        PNL:      LD   A,13   
0481   EF                     RST   28h   
0482   3E 0A                  LD   A,10   
0484   EF                     RST   28h   
0485   E3           PMSG:     EX   (SP),HL   
0486   CD 6C 04               CALL   prstr   
0489   E3                     EX   (SP),HL   
048A   C9                     RET      
048B                          ENDIF      
048B                          IF   CHECKED   
048B   D1           E_DOLLAR:   POP   DE   ; "$" ran into a NUL: drop the return address,
048C   E1                     POP   HL   ;   and put the string's address back in TOS
048D   3E 51                  LD   A,"Q"   
048F   C3 AC 03               JP   error   
0492                          ENDIF      
0492                             ; =============================================================================
0492                             ;  The line editor (EDITOR = 1)
0492                             ; 
0492                             ;  The interpreter starts here, and a program that ends comes back here.
0492                             ;  There is no prompt. It follows the spec's suggested standard for a line
0492                             ;  editor (docs/b8script.md, Environments). Type a line and press Return:
0492                             ; 
0492                             ;    n text    put the text in as line n; the lines from n on move down. A
0492                             ;              number past the end (or 0) adds the line at the end.
0492                             ;    n         take line n out
0492                             ;    anything else is run at once, as B8Script. (Start such a line with a
0492                             ;    space if it would begin with a digit.)
0492                             ; 
0492                             ;  A command key ends the line too, and takes what was typed as its argument:
0492                             ; 
0492                             ;    ^G        run the program
0492                             ;    n ^L      list from line n (no number: all of it). Any key holds the
0492                             ;              list until another key is pressed; Ctrl-C ends it.
0492                             ;    n ^E      put line n in the input line; Return puts it back, changed
0492                             ;    name ^R   read. CP/M: the file of that name (no name: the same file as
0492                             ;              last time). Generic: what is typed, or pasted, from now until
0492                             ;              ^Z replaces the program; it is not echoed.
0492                             ;    name ^W   write. CP/M: to that file (no name: the same file as last
0492                             ;              time). Generic: the text is printed, as it is.
0492                             ;    ^N ^N     new: no program (the key twice in a row)
0492                             ;    ^V        view: the build, both stacks, and the program's size, lines
0492                             ;              and free memory
0492                             ;    ^X        leave (to LEAVE)
0492                             ; 
0492                             ;  In the line: ^B and ^F, or the left and right arrow keys, move the cursor;
0492                             ;  a character goes in at the cursor; Backspace and DEL take out the one
0492                             ;  before it; Esc drops the line. Only CR, LF, BS and printing characters are
0492                             ;  sent to the terminal, so any terminal will do.
0492                             ; 
0492                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
0492                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
0492                             ;  125 characters; the one character after a line number separates it from
0492                             ;  the text and is not stored. The text is kept as it is typed, each line
0492                             ;  ending in CR LF, at PROG.
0492                             ; 
0492                             ;  What lasts from one line to the next: the program, the words, the
0492                             ;  variables and the data stack. An error or a break clears both stacks. The
0492                             ;  return stack starts empty for every line.
0492                             ; 
0492                             ;  Things to know:
0492                             ;    - Reset empties the program (generic builds).
0492                             ;    - A word's address points into the program, so run the program again
0492                             ;      after editing it.
0492                             ;    - Nothing is printed between a program's output and what is typed next.
0492                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
0492                             ;      a line that calls -n? and carries on afterwards runs what was typed.
0492                             ;      (The stored program never comes back to the line, so it may.)
0492                             ;    - The editor"s own keys are not the program"s: -n? is the plain line
0492                             ;      read of the other builds (BDOS 10 under CP/M).
0492                             ; 
0492                             ;  The data stack is the CPU's stack, so the editor works on top of whatever
0492                             ;  the last line left there, with TOS pushed like the rest.
0492                             ; =============================================================================
0492                          IF   EDGEN   
                    INIT:        ; reset (A = 0)
0492                          ENDIF      
0492                          IF   EDGEN*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at 0, and
                                 ; every word cell holds 0000h, the address an undefined word is caught at
                                 ; (see e_hi).
                              LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
0492                          ENDIF      
0492                          IF   EDGEN   
                              JR   edit0   
0492                          ENDIF      
0492                          IF   EDITOR   
                                 ; ^B, left arrow: the cursor goes one to the left
                    LEFT:     LD   A,L   
                              ADD   A,A   
                              JR   Z,ed1   ; (L = 80h: at the start)
                              DEC   L   
                              LD   A,8   
                    LF1:      RST   28h   
                              JR   ed1   
                                 ; ^F, right arrow: one to the right, by printing the character there
                    RIGHT:    LD   A,L   
                              CP   E   
                              JR   Z,ed1   ; at the end
                              LD   A,(HL)   
                              INC   L   
                              JR   lf1   
                                 ; Esc: alone it drops the line. An arrow key sends Esc [ and a letter, so
                                 ; wait about 5 ms for a second key: after a "[" read on to the letter that
                                 ; ends the sequence, and act on C (right) and D (left).
                    ESC:      LD   BC,5*MSLOOP   
                    ES1:      CALL   rawk   
                              JR   NZ,es2   
                              DEC   BC   
                              LD   A,B   
                              OR   C   
                              JR   NZ,es1   
                              CALL   fin   ; no second key: the line is dropped
                              JR   edit   
                    ES2:      CP   "["   
                              JR   NZ,ed1   ; not a sequence known here
                    ES3:      CALL   ekey   
                              CP   40h   
                              JR   C,es3   ; (its parameters)
                              CP   "C"   
                              JR   Z,right   
                              CP   "D"   
                              JR   Z,left   
                              JR   ed1   
                                 ; edit0: reset, an error or a break: both stacks are cleared.
                                 ; skend: a program that ended inside skip: its return address goes.
                                 ; edend: a program that ended: TOS joins the rest of the data stack.
                    EDIT0:    LD   SP,DSTOP-2   ; empty (the cell that stands for TOS is pushed)
                              DB   21h   ; (LD HL,nn: steps over the next two bytes)
                    SKEND:    POP   DE   
                    EDEND:    PUSH   HL   
                                 ; edit: start a new input line.
                    EDIT:     EXX      
                              LD   HL,RSTOP   ; the return stack is empty
                              EXX      
                              LD   HL,0   
                              LD   (KEYBUF),HL   ; no key is held, and the break key is on
                              LD   (EDLN),HL   ; no line is being edited
                              LD   HL,LINEBUF   ; HL = the cursor,
                              LD   E,L   ;   E = the end of the line (its low byte)
                    ED1:      CALL   ekey   
                              CP   7Fh   
                              JR   Z,bsp   ; DEL
                              CP   " "   
                              JR   NC,insc   
                              CP   9   
                              JR   Z,insc   ; Tab is text
                              CP   8   
                              JR   Z,bsp   
                              CP   2   
                              JR   Z,left   ; ^B
                              CP   6   
                              JR   Z,right   ; ^F
                              CP   1Bh   
                              JR   Z,esc   
                              PUSH   HL   ; a command key? Look it up
                              LD   HL,cmds   
                              LD   B,NCMD   
                    ED2:      CP   (HL)   
                              INC   HL   
                              JR   Z,ed3   
                              INC   HL   
                              INC   HL   
                              DJNZ   ed2   
                              POP   HL   
                              JR   ed1   ; no: the key is ignored
                    ED3:      LD   A,(HL)   
                              INC   HL   
                              LD   H,(HL)   
                              LD   L,A   
                              EX   (SP),HL   ; the command's address: fin returns to it
                                 ; fin: end the input line: CR LF and a NUL after it, and a new line on the
                                 ; terminal. Leaves BC -> the line and HL -> the NUL.
                    FIN:      LD   H,LETPAGE   
                              LD   L,E   
                              LD   (HL),13   
                              INC   L   
                              LD   (HL),10   
                              DEC   L   
                              CALL   prl   ; (prints the CR LF)
                              LD   (HL),0   
                              LD   BC,LINEBUF   
                              RET      
                                 ; Backspace, DEL: the character before the cursor goes. The cursor moves
                                 ; left, the rest of the line moves down over it, and the last place (now a
                                 ; space) is printed over along with the rest.
                    BSP:      LD   A,L   
                              ADD   A,A   
                              JR   Z,ed1   ; at the start
                              DEC   L   
                              LD   A,8   
                              RST   28h   
                              PUSH   HL   
                    BS1:      INC   L   
                              LD   A,(HL)   
                              DEC   L   
                              LD   (HL),A   
                              INC   L   
                              LD   A,L   
                              CP   E   
                              JR   NZ,bs1   
                              DEC   L   
                              LD   (HL)," "   
                              POP   HL   
                              LD   D,E   
                              DEC   E   
                              JR   ic2   
                                 ; A character goes in at the cursor: it ripples up through the rest of the
                                 ; line, the cursor moves on, and the rest is printed again.
                    INSC:     LD   B,A   
                              LD   A,E   
                              CP   0FDh   
                              JR   Z,ed1   ; the line is full: 125 characters
                              LD   A,B   
                              RST   28h   
                              PUSH   HL   
                    IC1:      LD   A,(HL)   
                              LD   (HL),B   
                              LD   B,A   
                              LD   A,L   
                              INC   L   
                              CP   E   
                              JR   NZ,ic1   
                              POP   HL   
                              INC   L   
                              INC   E   
                              LD   D,E   
                    IC2:      CALL   tail   
                              JR   ed1   
                                 ; tail: print the line from the cursor to D (a low byte), and bring the
                                 ; cursor back with backspaces. Nothing at all if the cursor is at D.
                    TAIL:     LD   C,L   
                    TA1:      LD   A,L   
                              CP   D   
                              JR   Z,ta2   
                              LD   A,(HL)   
                              RST   28h   
                              INC   L   
                              JR   ta1   
                    TA2:      LD   A,L   
                              CP   C   
                              RET   Z   
                              LD   A,8   
                              RST   28h   
                              DEC   L   
                              JR   ta2   
                                 ; ekey: wait for a key
                    EKEY:     CALL   rawk   
                              JR   Z,ekey   
                              RET      
                                 ; The command keys, and where each goes (after fin).
                    CMDS:     DB   13   
                              DW   cret   
                              DB   7   ; ^G
                              DW   crun   
                              DB   12   ; ^L
                              DW   clist   
                              DB   5   ; ^E
                              DW   cedln   
                              DB   18   ; ^R
                              DW   cread   
                              DB   23   ; ^W
                              DW   cwrite   
                              DB   14   ; ^N
                              DW   cnew   
                              DB   22   ; ^V
                              DW   cview   
                              DB   24   ; ^X
                              DW   LEAVE   
                    NCMD:     EQU   9   
                                 ; ^N ^N: no program, if the next key is ^N too
                    CNEW:     CALL   ekey   
                              CP   14   
                              JR   NZ,ged0   
                              XOR   A   
                              LD   (PROG),A   
                    GED0:     JP   edit   
                                 ; ^E: line n goes into the input line, to be changed. EDLN remembers which
                                 ; line it was: Return puts the text back in its place.
                    CEDLN:    CALL   rdnum   
                              PUSH   HL   
                              CALL   find   ; HL -> the line, or the NUL if there is none
                              POP   DE   
                              LD   A,(HL)   
                              OR   A   
                              JR   Z,ged0   
                              LD   (EDLN),DE   
                              LD   DE,LINEBUF   
                    CE1:      LD   A,(HL)   
                              CP   13   
                              JR   Z,ce2   
                              CP   10   
                              JR   Z,ce2   
                              LD   (DE),A   
                              INC   HL   
                              INC   E   
                              LD   A,E   
                              CP   0FDh   ; (a longer line is cut at 125 characters)
                              JR   NZ,ce1   
                    CE2:      LD   HL,LINEBUF   ; show it; the cursor ends up at its end
                    CE3:      LD   A,L   
                              CP   E   
                              JP   Z,ed1   
                              LD   A,(HL)   
                              RST   28h   
                              INC   L   
                              JR   ce3   
                                 ; Return. If ^E put a line here, the text goes back in its place. If not:
                                 ; a number and text is a line to put in, a number alone a line to take out,
                                 ; and anything else is run where it is.
                    CRET:     PUSH   HL   ; the end of what was typed
                              LD   HL,(EDLN)   
                              LD   A,H   
                              OR   L   
                              JR   Z,cr1   
                              PUSH   HL   
                              CALL   delln   
                              POP   HL   
                              JR   ins   
                    CR1:      CALL   rdnum   ; HL = the number it starts with, BC -> after
                              LD   A,C   ; C is still 80h if there was no number:
                              ADD   A,A   ;   only then is twice it 0
                              JR   Z,st0p   ; no number: run the line
                              LD   A,(BC)   
                              CP   13   
                              JR   NZ,cr2   
                              POP   DE   ; the number alone: take that line out
                              CALL   delln   
                              JR   gedit   
                    CR2:      INC   BC   ; step over the one character after the number
                                 ; Put the text at BC in as line n (in HL): open a gap of its length there,
                                 ; CR and LF included, and copy it in.
                    INS:      CALL   find   ; HL -> where it goes
                              POP   DE   ; the end of what was typed
                              LD   A,E   
                              SUB   C   ; A = the length of the text, with its CR LF
                              PUSH   BC   ; the text
                              LD   C,A   
                              LD   B,0   
                              PUSH   BC   ; its length
                              LD   D,H   
                              LD   E,L   ; DE = where it goes
                              XOR   A   
                              LD   C,A   ; BC = 0: CPIR looks as far as it needs to
                              CPIR      ; HL -> one past the program's NUL
                              SBC   HL,DE   ; the number of bytes to move up, NUL included
                              LD   B,H   
                              LD   C,L   
                              ADD   HL,DE   
                              DEC   HL   ; HL -> the NUL
                              EX   DE,HL   
                              EX   (SP),HL   ; HL = the length; where it goes is kept
                              PUSH   HL   
                              ADD   HL,DE   ; the NUL's new place
                              EX   DE,HL   
                              LDDR      ; move the rest of the program up
                              POP   BC   ; the length
                              POP   DE   ; where it goes
                              POP   HL   ; the text
                              LDIR      
                    GEDIT:    JP   edit   
                                 ; ^G: run the program. st0p: run the typed line (BC -> it).
                    CRUN:     LD   BC,PROG   
                              DB   3Eh   ; (LD A,n: steps over the POP)
                    ST0P:     POP   HL   ; (the end of what was typed)
                                 ; st0: start running at BC. The heap starts after the stored program's NUL.
                    ST0:      LD   HL,PROG   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
                              LD   (HEAP),HL   
0492                          ENDIF      
0492                          IF   EDITOR*CHECKED   
                              RST   20h   ; minus the heap"s first address: "_' may not
                              LD   (NPEND),HL   ;   release below it
0492                          ENDIF      
0492                          IF   EDITOR   
                              POP   HL   ; TOS: the data stack is as the last line left it
                              RST   30h   ; (its return address is thrown away)
                                 ; ^L: list from line n. DE = the number of the line at HL.
                    CLIST:    CALL   rdnum   ; HL = n, or 0 if there was none:
                              LD   A,H   
                              OR   L   
                              JR   NZ,li0   
                              INC   L   ;   then from line 1
                    LI0:      PUSH   HL   
                              CALL   find   
                              POP   DE   
                    LI1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,gedit   ; the end of the text
                              CALL   rawk   
                              JR   Z,li3   ; no key: carry on
                              CP   3   
                              JR   Z,gedit   ; Ctrl-C
                              CALL   ekey   ; any other key: wait for one more
                              CP   3   
                              JR   Z,gedit   
                    LI3:      PUSH   HL   
                              PUSH   DE   
                              EX   DE,HL   
                              CALL   pdec   ; the line's number,
                              LD   A," "   
                              RST   28h   ;   a space,
                              POP   DE   
                              POP   HL   
                              INC   DE   
                              CALL   prl   ;   and the line
                              JR   li1   
                                 ; ^V: view.
                    CVIEW:    CALL   pmsg   
                              DB   "B8SZ80E"   
0492                          ENDIF      
0492                          IF   EDITOR*CHECKED   
                              DB   "C"   
0492                          ENDIF      
0492                          IF   EDITOR   
                              DB   " 2026-11-21",22h   
                              CALL   pstk   ; both stacks
                              LD   HL,PROG   
                              LD   DE,0   
                    CV1:      LD   A,(HL)   ; count the lines, and find the end
                              OR   A   
                              JR   Z,cv2   
                              INC   HL   
                              CP   10   
                              JR   NZ,cv1   
                              INC   DE   
                              JR   cv1   
                    CV2:      PUSH   HL   ; the NUL
                              PUSH   DE   ; the lines
                              LD   DE,(0-PROG)&0FFFFh   
                              ADD   HL,DE   
                              CALL   pnl   
                              DB   "Prog ",22h   
                              CALL   pdec   ; the program's size
                              POP   HL   
                              CALL   pnl   
                              DB   "Lines ",22h   
                              CALL   pdec   
                              POP   DE   
0492                          ENDIF      
0492                          IF   EDGEN   
                              LD   HL,HEAPLIM*256-1   
0492                          ENDIF      
0492                          IF   EDITOR*CPM   
                              LD   A,(0007h)   ; the BDOS page is the limit
                              LD   H,A   
                              LD   L,0   
                              DEC   HL   
0492                          ENDIF      
0492                          IF   EDITOR   
                              OR   A   
                              SBC   HL,DE   
                              CALL   pnl   
                              DB   "Free ",22h   
                              CALL   pdec   ; the room left for text and heap
                              CALL   pnl   
                              DB   22h   
                    GED1:     JP   edit   
                                 ; delln: take line n (in HL) out: copy everything after it down over it.
                    DELLN:    CALL   find   
                              LD   D,H   
                              LD   E,L   
                              CALL   nxl   ; HL -> the next line
                    DE1:      LD   A,(HL)   
                              LD   (DE),A   
                              INC   HL   
                              INC   DE   
                              OR   A   
                              JR   NZ,de1   
                              RET      
                                 ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
                                 ; of the text if there are fewer lines (or the number is 0). Keeps BC.
                    FIND:     EX   DE,HL   
                              LD   HL,PROG   
                    FI1:      DEC   DE   
                              LD   A,D   
                              OR   E   
                              RET   Z   
                              CALL   nxl   
                              JR   NZ,fi1   
                              RET      
                                 ; nxl: step HL over one line, to just past its LF (and return not-zero), or
                                 ; stop at the NUL that ends the text (and return zero).
                    NXL:      LD   A,(HL)   
                              OR   A   
                              RET   Z   
                              INC   HL   
                              CP   10   
                              JR   NZ,nxl   
                              OR   A   
                              RET      
                                 ; prl: print the line at HL, to its LF; HL -> just past it.
                    PRL:      LD   A,(HL)   
                              RST   28h   
                              LD   A,(HL)   
                              INC   HL   
                              CP   10   
                              JR   NZ,prl   
                              RET      
0492                          ENDIF      
0492                          IF   EDGEN   
                                 ; ^R, generic: what comes in from now until ^Z is the program. A CR is
                                 ; stored as CR LF; a LF right after a line end is dropped (it is the CR's
                                 ; own, or an empty line's), and a LF anywhere else ends a line too. A last
                                 ; line with no end is given one. Nothing is echoed, and there is no check
                                 ; for running out of memory.
                    CREAD:    LD   HL,PROG-1   
                              LD   A,10   
                              DB   0FEh   ; (CP n: steps over the LD A,13)
                    RD1:      LD   A,13   ; a LF alone ends a line
                    RD2:      LD   (HL),A   
                              INC   HL   
                              CP   13   
                              LD   A,10   
                              JR   Z,rd2   ; after a CR goes a LF
                    RD3:      CALL   ekey   
                              CP   1Ah   
                              JR   Z,rd4   
                              CP   10   
                              JR   NZ,rd2   
                              DEC   HL   
                              CP   (HL)   
                              INC   HL   
                              JR   Z,rd3   ; (the LF is dropped)
                              JR   rd1   
                    RD4:      DEC   HL   
                              LD   A,(HL)   
                              INC   HL   
                              CP   10   
                              JR   Z,rd5   
                              LD   (HL),13   
                              INC   HL   
                              LD   (HL),10   
                              INC   HL   
                    RD5:      LD   (HL),0   
                              JR   ged1   
                                 ; ^W, generic: the text is printed as it is, for the terminal to capture.
                    CWRITE:   LD   HL,PROG   
                    CW1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,ged1   
                              RST   28h   
                              INC   HL   
                              JR   cw1   
0492                          ENDIF      
0492                          IF   EDITOR*CPM   
                    CFCB:     EQU   005Ch   ; the file's name is kept here, where the CCP
                                 ;   put the one from the command line
                                 ; ^R, CP/M: read the file. A name typed before the key is the file's name
                                 ; from now on.
                    CREAD:    CALL   setname   
                              CALL   load   
                              JP   edit   
                                 ; ^W, CP/M: write the file: delete the old one, make it anew, write the
                                 ; text in records of 128 bytes, and close it. The text's NUL and the 127
                                 ; bytes after it are set to ^Z meanwhile, which pads the last record.
                    CWRITE:   CALL   setname   
                              CALL   fcbclr   
                              LD   C,19   ; delete
                              CALL   fbdos   
                              LD   C,22   ; make
                              CALL   fbdos   
                              INC   A   
                              JP   Z,edit   ; no room in the directory
                              LD   HL,PROG   
                              XOR   A   
                    CW1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,cw1   
                              DEC   HL   ; HL -> the NUL
                              PUSH   HL   
                              LD   B,128   
                    CW2:      LD   (HL),1Ah   
                              INC   HL   
                              DJNZ   cw2   
                              POP   HL   
                              LD   DE,PROG   
                    CW3:      LD   A,E   ; a record that starts before the end is written
                              SUB   L   
                              LD   A,D   
                              SBC   A,H   
                              JR   NC,cw4   
                              PUSH   HL   
                              PUSH   DE   
                              LD   C,26   ; set the DMA address: the record is written
                              CALL   BDOS   ;   from where it lies
                              LD   C,21   ; write
                              CALL   fbdos   
                              POP   HL   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              POP   HL   
                              JR   cw3   
                    CW4:      LD   (HL),0   ; the NUL again
                              LD   C,16   ; close
                              CALL   fbdos   
                              JP   edit   
                                 ; setname: if a name was typed (the line does not start with its CR), put it
                                 ; in the CFCB: up to 8 characters, a dot, up to 3 more, in capitals. The drive
                                 ; is the current one.
                    SETNAME:   LD   DE,LINEBUF   
                              LD   A,(DE)   
                              CP   13   
                              RET   Z   
                              LD   HL,CFCB   
                              LD   (HL),0   ; the current drive
                              LD   B,11   
                    SN1:      INC   L   
                              LD   (HL)," "   
                              DJNZ   sn1   
                              LD   L,CFCB+1   
                    SN2:      LD   A,(DE)   
                              INC   DE   
                              CP   13   
                              RET   Z   
                              CP   "."   
                              JR   NZ,sn3   
                              LD   L,CFCB+9   ; the type
                              JR   sn2   
                    SN3:      CP   "a"   
                              JR   C,sn4   
                              AND   5Fh   ; a capital
                    SN4:      LD   (HL),A   
                              INC   L   
                              JR   sn2   
                                 ; fcbclr: clear the CFCB after its name, as it must be before a file is opened
                    FCBCLR:   LD   HL,CFCB+12   
                              LD   B,24   
                    FC1:      LD   (HL),0   
                              INC   HL   
                              DJNZ   fc1   
                              RET      
                                 ; fbdos: BDOS function C on the file
                    FBDOS:    LD   DE,CFCB   
                              JP   BDOS   
                                 ; load: read the file into PROG. No such file: no program. The text ends at
                                 ; the file"s first ^Z (1Ah), which pads a text file"s last record; one more
                                 ; goes after the last record, so the search always stops. And every line
                                 ; must end in LF: a last line without one is given a CR LF.
                    LOAD:     CALL   fcbclr   
                              LD   C,15   ; open (no such file: the first read fails
                              CALL   fbdos   ;   too)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   C,20   ; read the next 128 bytes
                              CALL   fbdos   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:      LD   (HL),1Ah   
                              LD   HL,PROG-1   
                              LD   A,10   ; (a file with no text needs nothing added)
                    TR1:      INC   HL   
                              LD   E,A   ; E = the character before this one
                              LD   A,(HL)   
                              CP   1Ah   
                              JR   NZ,tr1   
                              LD   A,E   
                              CP   10   
                              JR   Z,tr2   
                              LD   (HL),13   
                              INC   HL   
                              LD   (HL),10   
                              INC   HL   
                    TR2:      LD   (HL),0   
                              RET      
0492                          ENDIF      
0492                             ; =============================================================================
0492                             ;  CP/M startup (the generic build starts at address 0: see st0)
0492                             ; =============================================================================
0492                          IF   CPM   
                                 ; The RAM pages follow the image; the heap may grow to the BDOS.
                    START:       
0492                          ENDIF      
0492                          IF   CPM*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
                                 ; is held back.
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
0492                          ENDIF      
0492                          IF   CPM   
                              LD   HL,vecs   ; the RST routines go down into page zero
                              LD   DE,0008h   
                              LD   BC,vecend-vecs   
                              LDIR      
0492                          ENDIF      
0492                          IF   CPM*EDITOR   
                              CALL   load   ; the file named on the command line
                              JP   edit0   
0492                          ENDIF      
0492                          IF   CPM*(1-EDITOR)   
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:      LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
                              JP   st2   
0492                          ENDIF      
0492                          IF   CPM   
                                 ; RAM pages, after the image
                    RSPAGE:   EQU   (imgend + 255) / 256   
                    DSPAGE:   EQU   RSPAGE + 1   
                    LETPAGE:   EQU   RSPAGE + 2   
                    PROG:     EQU   LETPAGE*256 + 256   
0492                          ENDIF      
0492                IMGEND:      


