E34D   76 00                  ROR   0,X   
E34F   36 FE                  ROL   0FEh,X   
E351   60                     RTS      
E352   A0 10        UD0:      LDY   #16   
E354   16 00        UD1:      ASL   0,X   
E356   36 01                  ROL   1,X   
E358   36 FE                  ROL   0FEh,X   
E35A   36 FF                  ROL   0FFh,X   
E35C   38                     SEC      
E35D   B5 FE                  LDA   0FEh,X   
E35F   E5 08                  SBC   D0   
E361   85 04                  STA   T0   
E363   B5 FF                  LDA   0FFh,X   
E365   E5 09                  SBC   D1   
E367   90 08                  BCC   ud2   
E369   95 FF                  STA   0FFh,X   
E36B   A5 04                  LDA   T0   
E36D   95 FE                  STA   0FEh,X   
E36F   F6 00                  INC   0,X   
E371   88           UD2:      DEY      
E372   D0 E0                  BNE   ud1   
E374   60                     RTS      
E375                             ; =============================================================================
E375                             ;  The grave's codes (h_grave, in the third page, is the dispatcher). Each
E375                             ;  starts with the carry SET and Y = three times its place in GTAB.
E375                             ; 
E375                             ;    `!  ( addr -- )        call the machine code at addr (exec)
E375                             ;    `$  ( addr -- addr' )  the hex loader: pairs of hex digits are stored
E375                             ;                           from addr until a non-hex character; then a RTS
E375                             ;                           (60h) is written and its address is left. An odd
E375                             ;                           last digit is consumed and dropped.
E375                             ;    `'  ( -- )             new line: CR LF
E375                             ;    `+  ( addr -- n )      add 1 to the cell at addr and leave its new value
E375                             ;    `,  ( n -- r )         a random number from 0 to n-1 (n is 1 to 32767)
E375                             ;    `-  ( addr -- n )      subtract 1 from the cell at addr, the same way
E375                             ;    `.  ( -- addr )        the address of the random seed
E375                             ;    `<  ( a b -- n )       the smaller of the two (signed)
E375                             ;    `>  ( a b -- n )       the larger
E375                             ;    `?  ( flag -- )        the cursor off (0) or on
E375                             ;    `@  ( row col -- )     the cursor to that row and column, both from 0
E375                             ;    `^  ( -- )             clear the screen and home the cursor
E375                             ;    `_  ( -- )             clear from the cursor to the end of the line
E375                             ; =============================================================================
E375   21           GTAB:     DB   "!"   
E376   E5 E2                  DW   exec-1   
E378   24                     DB   "$"   
E379   9B E3                  DW   g_hex-1   
E37B   27                     DB   27h   
E37C   B9 E3                  DW   g_nl-1   
E37E   2B           GPLUS:    DB   "+"   
E37F   C3 E3                  DW   g_inc-1   
E381   2C                     DB   ","   
E382   F3 E3                  DW   g_rnd-1   
E384   2D                     DB   "-"   
E385   C3 E3                  DW   g_inc-1   
E387   2E                     DB   "."   
E388   EC E3                  DW   g_seed-1   
E38A   3C                     DB   "<"   ; ("<" must have an odd place here, and ">"
E38B   36 E4                  DW   g_min-1   ;   an even one: see g_min)
E38D   3E                     DB   ">"   
E38E   36 E4                  DW   g_min-1   
E390   3F                     DB   "?"   
E391   5A E4                  DW   g_cur-1   
E393   40                     DB   "@"   
E394   78 E4                  DW   g_at-1   
E396   5E                     DB   "^"   
E397   45 E4                  DW   g_cls-1   
E399   5F                     DB   "_"   
E39A   50 E4                  DW   g_eol-1   
E39C                GTABE:       
E39C                             ; `$ (never checked: the spec says so)
E39C   20 43 E6     G_HEX:    JSR   rdhex   
E39F   B0 14                  BCS   hx2   
E3A1   0A                     ASL      
E3A2   0A                     ASL      
E3A3   0A                     ASL      
E3A4   0A                     ASL      
E3A5   85 04                  STA   T0   
E3A7   20 43 E6               JSR   rdhex   
E3AA   B0 09                  BCS   hx2   ; odd digit: already consumed, dropped
E3AC   05 04                  ORA   T0   
E3AE   81 00                  STA   (0,X)   
E3B0   20 8B E2               JSR   inctos   
E3B3   90 E7                  BCC   g_hex   ; always (rdhex left the carry clear)
E3B5   A9 60        HX2:      LDA   #60h   
E3B7   81 00                  STA   (0,X)   
E3B9   60                     RTS      
E3BA   A9 0D        G_NL:     LDA   #13   
E3BC   20 03 FF               JSR   CONOUT   
E3BF   A9 0A                  LDA   #10   
E3C1   4C 03 FF               JMP   CONOUT   
E3C4                             ; `+ and `-: one routine, which adds 1 or -1 (FFFFh): Y says which. The cell
E3C4                             ; is reached a byte at a time through the top cell, which moves on between.
E3C4                G_INC:       
E3C4                          IF   CHECKED   
E3C4   20 30 E3               JSR   chkst   ; each byte"s address is tested, as for "!'
E3C7                          ENDIF      
E3C7   C0 0C                  CPY   #GPLUS-GTAB+3   ; carry: "-"
E3C9   A9 00                  LDA   #0   
E3CB   90 02                  BCC   gi1   
E3CD   A9 FF                  LDA   #0FFh   
E3CF   85 05        GI1:      STA   T1   ; the high byte of 1 or -1,
E3D1   09 01                  ORA   #1   ;   and the low
E3D3   18                     CLC      
E3D4   61 00                  ADC   (0,X)   
E3D6   81 00                  STA   (0,X)   
E3D8   48                     PHA      
E3D9   20 8B E2               JSR   inctos   ; (keeps the carry)
E3DC                          IF   CHECKED   
E3DC   08                     PHP      
E3DD   20 30 E3               JSR   chkst   
E3E0   28                     PLP      
E3E1                          ENDIF      
E3E1   A5 05                  LDA   T1   
E3E3   61 00                  ADC   (0,X)   
E3E5   81 00                  STA   (0,X)   
E3E7   95 01                  STA   1,X   ; the new value is TOS
E3E9   68                     PLA      
E3EA   95 00                  STA   0,X   
E3EC   60                     RTS      
E3ED                             ; `. pushes the address of the random seed.
E3ED   A9 76        G_SEED:   LDA   #<SEED   
E3EF   A0 04                  LDY   #>SEED   
E3F1   4C D8 E5               JMP   pushay   
E3F4                             ; `, ( n -- r ). The seed goes one step on: seed * 261 + 1, which takes
E3F4                             ; every 16-bit value in turn. The high bits of such a seed are the good ones
E3F4                             ; and the low ones repeat soon, so the high byte is folded into the low
E3F4                             ; (EOR) before the remainder of dividing by n is taken.
E3F4                             ; n must be 1 to 32767: the checked build stops with Z on anything less
E3F4                             ; than 1.
E3F4                G_RND:       
E3F4                          IF   CHECKED   
E3F4   B5 01                  LDA   1,X   
E3F6   30 04                  BMI   gr9   
E3F8   15 00                  ORA   0,X   
E3FA   D0 03                  BNE   gr8   
E3FC   4C 81 E1     GR9:      JMP   e_zero   
E3FF                GR8:         
E3FF                          ENDIF      
E3FF   B5 00                  LDA   0,X   
E401   85 08                  STA   D0   
E403   B5 01                  LDA   1,X   
E405   85 09                  STA   D1   ; D = n
E407   AD 76 04               LDA   SEED   
E40A   95 00                  STA   0,X   
E40C   AD 77 04               LDA   SEED+1   
E40F   95 01                  STA   1,X   ; the seed in n's place,
E411   A9 05                  LDA   #05h   ;   and 261 (0105h) on top of it
E413   A0 01                  LDY   #01h   
E415   20 D8 E5               JSR   pushay   
E418   20 5B E1               JSR   h_mul   ; TOS = seed * 261
E41B   20 8B E2               JSR   inctos   
E41E   B5 00                  LDA   0,X   
E420   8D 76 04               STA   SEED   
E423   B5 01                  LDA   1,X   
E425   8D 77 04               STA   SEED+1   
E428   55 00                  EOR   0,X   
E42A   95 00                  STA   0,X   
E42C   20 3D E3               JSR   udiv   ; TOS = the quotient, the remainder under it
E42F   CA                     DEX      
E430   CA                     DEX      
E431   20 B6 E0               JSR   h_swap   
E434   4C 15 E1               JMP   drop   ; the remainder is TOS
E437                             ; `< and `>: one routine. scmp leaves the carry clear if a < b. Y is odd for
E437                             ; "<" and even for ">", so the low bit of Y plus the carry is set when a,
E437                             ; the cell below, is the one to keep.
E437   20 3D E1     G_MIN:    JSR   scmp   
E43A   98                     TYA      
E43B   69 00                  ADC   #0   
E43D   4A                     LSR      
E43E   B0 03                  BCS   gm1   
E440   20 B6 E0               JSR   h_swap   ; b is wanted: a on top, to be dropped
E443   4C 15 E1     GM1:      JMP   drop   
E446                          IF   ANSI   
E446                             ; `^: ESC [ H homes the cursor, and ESC [ J clears from there to the end of
E446                             ; the screen. `_: ESC [ K clears to the end of the line.
E446   20 95 E4     G_CLS:    JSR   csi   
E449   A9 48                  LDA   #"H"   
E44B   20 03 FF               JSR   CONOUT   
E44E   A9 4A                  LDA   #"J"   
E450   2C                     DB   2Ch   ; (BIT abs: hides the next instruction)
E451   A9 4B        G_EOL:    LDA   #"K"   
E453   48                     PHA      
E454   20 95 E4               JSR   csi   
E457   68                     PLA      
E458   4C 03 FF               JMP   CONOUT   
E45B                             ; `? ( flag -- ): ESC [ ? 2 5 l hides the cursor, ESC [ ? 2 5 h shows it.
E45B   20 95 E4     G_CUR:    JSR   csi   
E45E   A0 02                  LDY   #2   
E460   B9 76 E4     GC1:      LDA   GQ25,Y   
E463   20 03 FF               JSR   CONOUT   
E466   88                     DEY      
E467   10 F7                  BPL   gc1   
E469   20 DF E5               JSR   flag   
E46C   F0 03                  BEQ   gc2   
E46E   A9 68                  LDA   #"h"   
E470   2C                     DB   2Ch   
E471   A9 6C        GC2:      LDA   #"l"   
E473   4C 03 FF               JMP   CONOUT   
E476   35 32 3F     GQ25:     DB   "5","2","?"   ; (printed from the end)
E479                             ; `@ ( row col -- ): ESC [ row+1 ; col+1 H. (ANSI counts from 1.)
E479   20 95 E4     G_AT:     JSR   csi   
E47C   20 B6 E0               JSR   h_swap   ; the row on top
E47F   20 8F E4               JSR   pinc   
E482   A9 3B                  LDA   #";"   
E484   20 03 FF               JSR   CONOUT   
E487   20 8F E4               JSR   pinc   
E48A   A9 48                  LDA   #"H"   
E48C   4C 03 FF               JMP   CONOUT   
E48F                             ; pinc: print TOS + 1, unsigned, and drop it
E48F   20 8B E2     PINC:     JSR   inctos   
E492   4C 87 E0               JMP   pn1   
E495                             ; csi: print ESC [, which starts every ANSI sequence. Keeps X and Y.
E495   A9 1B        CSI:      LDA   #27   
E497   20 03 FF               JSR   CONOUT   
E49A   A9 5B                  LDA   #"["   
E49C   4C 03 FF               JMP   CONOUT   
E49F                          ENDIF      
E49F                          IF   1-ANSI   
                                 ; With ANSI = 0 the machine's own routines do the work (see the equates).
                                 ; CONCLS and CONEOL are jumped to straight from the table.
                    G_CLS:    EQU   CONCLS   
                    G_EOL:    EQU   CONEOL   
                    G_CUR:    JSR   flag   ; A = 0 and Z set: off
                              JMP   CONCUR   
                    G_AT:     LDY   2,X   ; Y = the row
                              LDA   0,X   ; A = the column
                              JSR   CONAT   
                              INX      
                              INX      
                              JMP   drop   
E49F                          ENDIF      
E49F                          IF   CHECKED   
E49F                             ; The checked build's inner loop, out of page 1, where it would not fit,
E49F                             ; and its break check (described with the unchecked one in page 1).
E49F                             ; pnext: the break check, then (falling through) next. A word call, a true
E49F                             ; "(" and a true ")" end here, but the keyboard is looked at only once in 256
E49F                             ; of them: CDOWN counts them down. A key found is held; a Ctrl-C goes on to ctlc. (Startup
E49F                             ; falls in here too, which does no harm.)
E49F   CE 79 04     PNEXT:    DEC   CDOWN   
E4A2   D0 0B                  BNE   next   
E4A4   20 06 FF               JSR   KEY   
E4A7   F0 06                  BEQ   next   ; no key
E4A9   8D 7A 04               STA   KEYBUF   ; held for the next "?"
E4AC   20 3A E5               JSR   chk3   ; (Ctrl-C: back only if the break key is off)
E4AF                NEXT:        
E4AF                             ; Both stacks are checked once per character, after it has run. The
E4AF                             ; return stack has overrun when S is below RSLIM: an overflow leaves
E4AF                             ; it at 1Eh or 1Fh, an underflow wraps it to 01h (no handler pulls
E4AF                             ; more than one entry). The data stack has when X is above DSE (an
E4AF                             ; underflow) or below DSFULL (an overflow). No handler moves X by
E4AF                             ; more than 4, so X is caught before it wraps; an overrun by a cell
E4AF                             ; or two writes on the scratch bytes below or above the stack.
E4AF                             ; S is kept in RSV, for the report's Rtn line (an error found inside
E4AF                             ; a handler has its own calls on the hardware stack), and the place
E4AF                             ; of the character about to run in PLACE.
E4AF   8A                     TXA      ; TSX trashes X: keep it in A
E4B0   BA                     TSX      
E4B1   8E 35 04               STX   RSV   
E4B4   E0 20                  CPX   #RSLIM   
E4B6   AA                     TAX      ; TAX leaves the carry alone
E4B7   90 16                  BCC   e_rstack   
E4B9   E0 F1                  CPX   #DSE+1   
E4BB   B0 24                  BCS   e_sund   
E4BD   E0 10                  CPX   #DSFULL   
E4BF   90 25                  BCC   e_sovr   
E4C1   A5 00                  LDA   IP   
E4C3   85 08                  STA   PLACE   
E4C5   A5 01                  LDA   IP+1   
E4C7   85 09                  STA   PLACE+1   
E4C9   20 80 E5               JSR   step   
E4CC   4C AF E4               JMP   next   
E4CF                             ; S/R are overflows, s/r underflows. After an underflow that stack counts as
E4CF                             ; empty.
E4CF   AD 35 04     E_RSTACK:   LDA   RSV   
E4D2   C9 10                  CMP   #10h   
E4D4   A9 52                  LDA   #"R"   
E4D6   B0 10                  BCS   ejmp   ; S is 1Eh-1Fh: an overflow
E4D8   A9 FF                  LDA   #0FFh   
E4DA   8D 35 04               STA   RSV   ; S wrapped to 01h: Rtn 0
E4DD   A9 72                  LDA   #"r"   
E4DF   D0 07                  BNE   ejmp   ; always
E4E1   A2 F0        E_SUND:   LDX   #DSE   ; Stk 0
E4E3   A9 73                  LDA   #"s"   
E4E5   2C                     DB   2Ch   ; (BIT abs: hides the next instruction)
E4E6   A9 53        E_SOVR:   LDA   #"S"   
E4E8   4C 6E E6     EJMP:     JMP   error   
E4EB                             ; skip, checked: as the unchecked one above, and A holds, on the way in, the wrong closer for the
E4EB                             ; opener that started the skip, kept in T0: ] for (, ) for [, and 0 for \,
E4EB                             ; which takes either. Meeting the wrong closer at this level, or the end
E4EB                             ; (a NUL, or a string that runs into it), stops with N, except for \,
E4EB                             ; which then ends the program as before.
E4EB   85 04        SKIP:     STA   T0   
E4ED   A9 00                  LDA   #0   
E4EF   85 06                  STA   T2   ; depth
E4F1   20 54 E6     SK1:      JSR   getc   
E4F4   F0 26                  BEQ   sknul   
E4F6   C9 22                  CMP   #22h   
E4F8   D0 05                  BNE   sk2   
E4FA   20 5E E0               JSR   skipstr   ; leaves A = 11h, which matches nothing below
E4FD   F0 1D                  BEQ   sknul   ; the string ran into the end
E4FF   C9 28        SK2:      CMP   #"("   
E501   F0 15                  BEQ   sk3   
E503   C9 5B                  CMP   #"["   
E505   F0 11                  BEQ   sk3   
E507   C9 29                  CMP   #")"   
E509   F0 04                  BEQ   sk4   
E50B   C9 5D                  CMP   #"]"   
E50D   D0 E2                  BNE   sk1   
E50F   C6 06        SK4:      DEC   T2   
E511   10 DE                  BPL   sk1   
E513   C5 04                  CMP   T0   
E515   F0 0C                  BEQ   e_nest   ; the wrong kind
E517   60                     RTS      ; the closer at this level
E518   E6 06        SK3:      INC   T2   
E51A   D0 D5                  BNE   sk1   
E51C   A5 04        SKNUL:    LDA   T0   
E51E   D0 03                  BNE   e_nest   ; ( and [ stop with N
E520   4C 09 FF               JMP   EXIT   ; \ ends the program
E523   A9 4E        E_NEST:   LDA   #"N"   ; a skip from ( or [ found the wrong closer
E525   4C 6E E6               JMP   error   ;   or the end: the place is the opener
E528                          ENDIF      
E528                          IF   1-CHECKED   
                    CBREAK:   EQU   endp   ; the unchecked build stops without a word
E528                          ENDIF      
E528                          IF   CHECKED   
E528                CBREAK:   EQU   e_break   ; the checked build reports B
E528                          ENDIF      
E528                             ; getk: a key for "?" in A (zero flag clear), or A = 0 with the zero flag
E528                             ; set when there is none. Keeps X and Y. The held key goes first, and is
E528                             ; taken out of KEYBUF.
E528   AD 7A 04     GETK:     LDA   KEYBUF   
E52B   F0 08                  BEQ   gk1   
E52D   48                     PHA      
E52E   A9 00                  LDA   #0   
E530   8D 7A 04               STA   KEYBUF   
E533   68                     PLA      
E534   60                     RTS      
E535   20 06 FF     GK1:      JSR   KEY   
E538   F0 04                  BEQ   gk9   
E53A                             ; chk3: a key in A (not 0). A Ctrl-C goes on to ctlc, which gives the 03h
E53A                             ; back if it comes back at all.
E53A   C9 03        CHK3:     CMP   #3   
E53C   F0 01                  BEQ   ctlc   
E53E   60           GK9:      RTS      
E53F                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
E53F                             ; the program has turned it off, wait about 250 ms (about 250 times MSLOOP
E53F                             ; looks: T1 counts the 256s, T2 runs on from whatever it holds) for one more
E53F                             ; key: a second Ctrl-C is the end too; any other key is held (the newest
E53F                             ; wins). Returns A = 03h with the zero flag clear. Keeps X and Y. (Not D0/D1:
E53F                             ; they hold the place in the checked build.)
E53F   AD 7B 04     CTLC:     LDA   BRKOFF   
E542   F0 1D                  BEQ   cbreak   
E544   A9 28                  LDA   #CWAIT+1   
E546   85 05                  STA   T1   
E548   20 06 FF     CT2:      JSR   KEY   
E54B   D0 0A                  BNE   ct3   
E54D   C6 06                  DEC   T2   
E54F   D0 F7                  BNE   ct2   
E551   C6 05                  DEC   T1   
E553   D0 F3                  BNE   ct2   
E555   F0 07                  BEQ   ct9   ; always: none came
E557   C9 03        CT3:      CMP   #3   
E559   F0 06                  BEQ   cbreak   
E55B   8D 7A 04               STA   KEYBUF   
E55E   A9 03        CT9:      LDA   #3   
E560   60                     RTS      
E561                          IF   CHECKED   
E561   A9 42        E_BREAK:   LDA   #"B"   ; Ctrl-C (the stacks as they stand)
E563   2C                     DB   2Ch   ; (BIT abs: hides the next instruction)
E564   A9 58        E_RESV:   LDA   #"X"   ; a reserved byte, 80h-FFh
E566   4C 6E E6     EJMP2:    JMP   error   
E569                             ; e_undef: the word cells of undefined words hold 0000h. A call there reads
E569                             ; the byte at 0000h, which is IP's own low byte: 00h while IP is 0000h, so
E569                             ; the call reads a NUL with IP in page zero, where no program can be. The
E569                             ; call is undone first: the step frame and the return address come off the
E569                             ; hardware stack, and the place is the call letter (the return address - 1).
E569   68           E_UNDEF:   PLA      
E56A   68                     PLA      ; the step frame
E56B   68                     PLA      
E56C   38                     SEC      
E56D   E9 01                  SBC   #1   
E56F   85 08                  STA   PLACE   
E571   68                     PLA      
E572   E9 00                  SBC   #0   
E574   85 09                  STA   PLACE+1   
E576   EE 35 04               INC   RSV   
E579   EE 35 04               INC   RSV   ; Rtn does not count the call
E57C   A9 55                  LDA   #"U"   
E57E   D0 E6                  BNE   ejmp2   ; always
E580                          ENDIF      
E580                             ; step: read one character and sort it by range.
E580                             ;    00h          end of program
E580                             ;    01h-20h, 7Fh-FFh   ignored
E580                             ;    30h-39h      digit: read a whole number
E580                             ;    41h-5Ah      A-Z: call the word in that letter's cell
E580                             ;    61h-7Ah      a-z: push the address of that letter's cell
E580                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
E580   20 54 E6     STEP:     JSR   getc   ; flags follow A
E583   F0 3D                  BEQ   endp   
E585   38                     SEC      
E586   E9 21                  SBC   #21h   ; A = c - 21h
E588   90 37                  BCC   ign   ; 01h-20h
E58A   C9 0F                  CMP   #0Fh   
E58C   90 24                  BCC   punct   ; 21h-2Fh: index 0-14
E58E   E9 0F                  SBC   #0Fh   ; (carry set) A = c - 30h
E590   C9 0A                  CMP   #10   
E592   90 72                  BCC   digit   
E594   C9 11                  CMP   #11h   
E596   90 18                  BCC   p3a   ; 3Ah-40h
E598   E9 11                  SBC   #11h   ; (carry set) A = c - 41h
E59A   C9 1A                  CMP   #1Ah   
E59C   90 2B                  BCC   upper   ; 41h-5Ah
E59E   C9 20                  CMP   #20h   
E5A0   90 0C                  BCC   p5b   ; 5Bh-60h
E5A2   C9 3A                  CMP   #3Ah   
E5A4   90 2F                  BCC   lower   ; 61h-7Ah: A = 20h-39h
E5A6   C9 3E                  CMP   #3Eh   
E5A8                          IF   1-CHECKED   
                              BCS   ign   ; 7Fh-FFh
E5A8                          ENDIF      
E5A8                          IF   CHECKED   
E5A8   F0 17                  BEQ   ign   ; 7Fh
E5AA   B0 B8                  BCS   e_resv   ; 80h-FFh: reserved
E5AC                          ENDIF      
E5AC                             ; The three adjustments below chain. Each ADC adds the carry the one
E5AC                             ; before it left, which the constants allow for.
E5AC   E9 1A                  SBC   #1Ah   ; 7Bh-7Eh: (carry clear: -1Bh) index 28-31
E5AE   69 F6        P5B:      ADC   #0F6h   ; 5Bh-60h: -10 (-9 when chained), index 22-27
E5B0   69 05        P3A:      ADC   #5   ; 3Ah-40h: +5 (+6 when chained), index 15-21
E5B2                             ; Punctuation: A = the index. The handler's page is the first, plus one if
E5B2                             ; the index is N1 or more, plus one more if it is N2 or more.
E5B2   C9 08        PUNCT:    CMP   #N1   
E5B4   A8                     TAY      
E5B5   A9 70                  LDA   #HALFPG   
E5B7   2A                     ROL      ; the first page, or the second (carry clear)
E5B8   C0 15                  CPY   #N2   
E5BA   69 00                  ADC   #0   ; ... or the third (and the carry is clear)
E5BC   48                     PHA      
E5BD   B9 E6 E5               LDA   PTAB,Y   
E5C0   48                     PHA      
E5C1   60           IGN:      RTS      ; RTS trick: goes to the handler. Reached
E5C2                             ; directly, it just ends an ignored character.
E5C2                ENDP:        ; the program has ended
E5C2                          IF   CHECKED   
E5C2   A5 01                  LDA   IP+1   ; IP in page zero: an undefined word
E5C4   F0 A3                  BEQ   e_undef   
E5C6                          ENDIF      
E5C6   4C 09 FF               JMP   EXIT   
E5C9                             ; A-Z: call the word. The return address (the IP after the letter) goes on
E5C9                             ; the return stack, and the IP becomes the address in the letter's cell.
E5C9   0A           UPPER:    ASL      
E5CA   A8                     TAY      
E5CB   38                     SEC      
E5CC   4C D7 E0               JMP   pushn   
E5CF   A5 00        PUSHIP:   LDA   IP   ; push the reading position
E5D1   A4 01                  LDY   IP+1   
E5D3   D0 03                  BNE   pushay   ; always: no program is in page zero
E5D5                             ; a-z: push the cell's address (the cell is the variable)
E5D5   0A           LOWER:    ASL      
E5D6   A0 04                  LDY   #>LET   
E5D8                             ; pushay: push a cell: A = its low byte, Y = its high byte
E5D8   CA           PUSHAY:   DEX      
E5D9   CA                     DEX      
E5DA   95 00        SETAY:    STA   0,X   ; setay: TOS = A (low), Y (high)
E5DC   94 01                  STY   1,X   
E5DE   60                     RTS      
E5DF                             ; flag: pops TOS and returns with Z set if it was 0. Keeps the carry.
E5DF   E8           FLAG:     INX      
E5E0   E8                     INX      
E5E1   B5 FE                  LDA   0FEh,X   
E5E3   15 FF                  ORA   0FFh,X   
E5E5   60                     RTS      
E5E6                             ; =============================================================================
E5E6                             ;  Dispatch table: the low byte of (handler - 1) for each punctuation
E5E6                             ;  character, in code order.
E5E6                             ; =============================================================================
E5E6   A6           PTAB:     DB   (h_store-1) & 0FFh   ; !
E5E7   54                     DB   (h_str-1) & 0FFh   ; "
E5E8   7A                     DB   (h_num-1) & 0FFh   ; #
E5E9   2C                     DB   (h_print-1) & 0FFh   ; $
E5EA   B5                     DB   (h_swap-1) & 0FFh   ; %
E5EB   C6                     DB   (h_and-1) & 0FFh   ; &
E5EC   72                     DB   (h_emit-1) & 0FFh   ; '
E5ED   D1                     DB   (h_open-1) & 0FFh   ; (
E5EE   B7                     DB   (h_close-1) & 0FFh   ; )
E5EF   5A                     DB   (h_mul-1) & 0FFh   ; *
E5F0   20                     DB   (h_add-1) & 0FFh   ; +
E5F1   AE                     DB   (h_cfetch-1) & 0FFh   ; ,
E5F2   17                     DB   (h_sub-1) & 0FFh   ; -
E5F3   0B                     DB   (h_cstore-1) & 0FFh   ; .
E5F4   85                     DB   (h_div-1) & 0FFh   ; /
E5F5   04                     DB   (h_dup-1) & 0FFh   ; :
E5F6   14                     DB   (drop-1) & 0FFh   ; ;
E5F7   35                     DB   (h_lt-1) & 0FFh   ; <
E5F8   4A                     DB   (h_eq-1) & 0FFh   ; =
E5F9   32                     DB   (h_gt-1) & 0FFh   ; >
E5FA   BE                     DB   (h_key-1) & 0FFh   ; ?
E5FB   7B                     DB   (h_fetch-1) & 0FFh   ; @
E5FC   A0                     DB   (h_def-1) & 0FFh   ; [
E5FD   23                     DB   (h_break-1) & 0FFh   ; \
E5FE   37                     DB   (h_ret-1) & 0FFh   ; ]
E5FF   65                     DB   (h_xor-1) & 0FFh   ; ^
E600   F2                     DB   (h_alloc-1) & 0FFh   ; _
E601   C4                     DB   (h_grave-1) & 0FFh   ; `
E602   49                     DB   (h_tor-1) & 0FFh   ; {
E603   70                     DB   (h_or-1) & 0FFh   ; |
E604   55                     DB   (h_fromr-1) & 0FFh   ; }
E605   62                     DB   (h_not-1) & 0FFh   ; ~
E606                             ; Digits: the first one is in A; read the rest of the number.
E606   A0 00        DIGIT:    LDY   #0   
E608   20 D8 E5               JSR   pushay   
E60B                             ; rdnum: TOS = TOS*10 + digit for each digit at IP. Wraps at 16 bits.
E60B                             ; Returns with the carry set.
E60B   20 3A E6     RDNUM:    JSR   isdig   
E60E   B0 4F                  BCS   ic9   ; (an RTS)
E610   20 57 E6               JSR   incip   ; (keeps A = the digit)
E613   16 00                  ASL   0,X   
E615   36 01                  ROL   1,X   ; x2
E617   18                     CLC      
E618   75 00                  ADC   0,X   
E61A   85 04                  STA   T0   
E61C   B5 01                  LDA   1,X   
E61E   69 00                  ADC   #0   
E620   85 05                  STA   T1   ; T = x2 + digit
E622   16 00                  ASL   0,X   
E624   36 01                  ROL   1,X   
E626   16 00                  ASL   0,X   
E628   36 01                  ROL   1,X   ; x8
E62A   18                     CLC      
E62B   B5 00                  LDA   0,X   
E62D   65 04                  ADC   T0   
E62F   95 00                  STA   0,X   
E631   B5 01                  LDA   1,X   
E633   65 05                  ADC   T1   
E635   95 01                  STA   1,X   ; x8 + x2 + digit
E637   4C 0B E6               JMP   rdnum   
E63A                             ; isdig: A = the character at IP minus "0"; the carry is clear if it is a
E63A                             ; digit. Y = 0.
E63A   20 60 E6     ISDIG:    JSR   peek   
E63D   38                     SEC      
E63E   E9 30                  SBC   #"0"   
E640   C9 0A                  CMP   #10   
E642   60                     RTS      
E643                             ; rdhex: if IP is at a hex digit (0-9, A-F, a-f), return its value in A with
E643                             ; the carry clear and IP moved on; otherwise the carry is set and IP stays.
E643   20 3A E6     RDHEX:    JSR   isdig   
E646   90 0F                  BCC   incip   
E648   29 DF                  AND   #0DFh   
E64A   E9 11                  SBC   #11h   ; (the carry is set)
E64C   C9 06                  CMP   #6   
E64E   B0 0F                  BCS   ic9   
E650   69 0A                  ADC   #10   
E652   D0 03                  BNE   incip   ; always
E654                             ; Reading the program
E654                             ;    peek: A = the character at IP, IP unchanged, Y = 0
E654                             ;    getc: the same, then IP moves on; flags follow A
E654                             ;    incip: IP moves on; keeps A, the carry and Y
E654   20 60 E6     GETC:     JSR   peek   
E657   E6 00        INCIP:    INC   IP   
E659   D0 02                  BNE   ic1   
E65B   E6 01                  INC   IP+1   
E65D   09 00        IC1:      ORA   #0   
E65F   60           IC9:      RTS      
E660   A0 00        PEEK:     LDY   #0   
E662   B1 00                  LDA   (IP),Y   
E664   60                     RTS      
E665                             ; rstip: point IP at the start of the program
E665   A9 00        RSTIP:    LDA   #<PROG   
E667   85 00                  STA   IP   
E669   A9 05                  LDA   #>PROG   
E66B   85 01                  STA   IP+1   
E66D   60                     RTS      
E66E                          IF   CHECKED   
E66E                             ; =============================================================================
E66E                             ;  Checked build: the error report
E66E                             ; =============================================================================
E66E                             ; error: the report, then EXIT. A = the letter, PLACE = the place, X = the
E66E                             ; data stack to show, RSV = S for the Rtn line. Nothing here relies on S: an
E66E                             ; overflowed or underflowed hardware stack wraps inside its page, and only
E66E                             ; its depth is shown.
E66E                             ;   CR LF
E66E                             ;   Err X @ line,col CR LF
E66E                             ;   up to 16 characters from the place, raw, up to a CR, LF or NUL  CR LF
E66E                             ;   Stk n: [...] and the top 8 cells at most, bottom to top  CR LF
E66E                             ;   Rtn n CR LF
E66E                             ; The numbers go through "#" (prnum), which pushes them over the data stack
E66E                             ; and pops them again, so the stack is shown as it was. With the stack full
E66E                             ; (X = 0Eh) that reaches down to 0Ah, so nothing the report keeps is there.
E66E   48           ERROR:    PHA      ; the letter
E66F   A5 08                  LDA   PLACE   
E671   85 02                  STA   P   
E673   A5 09                  LDA   PLACE+1   
E675   85 03                  STA   P+1   ; (the numbers need D0/D1)
E677   A0 00                  LDY   #M_ERR-MSG   
E679   20 15 E7               JSR   prs   ; CR LF "Err "
E67C   68                     PLA      
E67D   20 03 FF               JSR   CONOUT   
E680   20 15 E7               JSR   prs   ; " @ " (it follows M_ERR)
E683   20 40 E7               JSR   lcol   
E686   A5 0A                  LDA   LN   
E688   A4 0B                  LDY   LN+1   
E68A   20 0F E7               JSR   prnum   ; the line
E68D   A9 2C                  LDA   #","   
E68F   20 03 FF               JSR   CONOUT   
E692   A5 05                  LDA   T1   
E694   A4 06                  LDY   T2   
E696   20 0F E7               JSR   prnum   ; the column
E699   A0 09                  LDY   #M_NL-MSG   
E69B   20 15 E7               JSR   prs   
E69E   A0 00                  LDY   #0   ; the text at the place
E6A0   B1 02        ER1:      LDA   (P),Y   
E6A2   F0 10                  BEQ   er2   
E6A4   C9 0D                  CMP   #13   
E6A6   F0 0C                  BEQ   er2   
E6A8   C9 0A                  CMP   #10   
E6AA   F0 08                  BEQ   er2   
E6AC   20 03 FF               JSR   CONOUT   
E6AF   C8                     INY      
E6B0   C0 10                  CPY   #16   
E6B2   D0 EC                  BNE   er1   
E6B4   A0 0B        ER2:      LDY   #M_STK-MSG   
E6B6   20 15 E7               JSR   prs   ; CR LF "Stk "
E6B9   8A                     TXA      
E6BA   49 FF                  EOR   #0FFh   
E6BC   38                     SEC      
E6BD   E9 0F                  SBC   #0FFh-DSE   
E6BF   4A                     LSR      ; the depth, (DSE - X) / 2
E6C0   48                     PHA      
E6C1   20 0D E7               JSR   prnum8   
E6C4   68                     PLA      
E6C5   A0 16                  LDY   #M_C-MSG   ; ":"
E6C7   C9 09                  CMP   #9   
E6C9   90 04                  BCC   er3   
E6CB   A9 08                  LDA   #8   ; more than 8: ": ..." and the top 8
E6CD   A0 11                  LDY   #M_CD-MSG   
E6CF   85 05        ER3:      STA   T1   ; T1 = how many cells to show
E6D1   20 15 E7               JSR   prs   
E6D4   A5 05        ER4:      LDA   T1   ; cells T1-1 down to 0, the top last: cell i
E6D6   F0 1F                  BEQ   er5   ;   from the top is at X+2i
E6D8   C6 05                  DEC   T1   
E6DA   A9 20                  LDA   #" "   
E6DC   20 03 FF               JSR   CONOUT   
E6DF   A5 05                  LDA   T1   
E6E1   0A                     ASL      
E6E2   85 06                  STA   T2   
E6E4   8A                     TXA      
E6E5   65 06                  ADC   T2   ; (the carry is clear)
E6E7   A8                     TAY      
E6E8   B9 00 00               LDA   0,Y   
E6EB   48                     PHA      
E6EC   B9 01 00               LDA   1,Y   
E6EF   A8                     TAY      
E6F0   68                     PLA      
E6F1   20 0F E7               JSR   prnum   
E6F4   4C D4 E6               JMP   er4   
E6F7   A0 17        ER5:      LDY   #M_RTN-MSG   
E6F9   20 15 E7               JSR   prs   ; CR LF "Rtn "
E6FC   AD 35 04               LDA   RSV   
E6FF   49 FF                  EOR   #0FFh   
E701   4A                     LSR      ; (FFh - S) / 2 entries
E702   20 0D E7               JSR   prnum8   
E705   A0 09                  LDY   #M_NL-MSG   
E707   20 15 E7               JSR   prs   
E70A   4C 09 FF               JMP   EXIT   
E70D                             ; prnum: print the number A (low), Y (high), signed, keeping the data stack.
E70D                             ; prnum8: the same for A alone, 0-255.
E70D   A0 00        PRNUM8:   LDY   #0   
E70F   20 D8 E5     PRNUM:    JSR   pushay   
E712   4C 7B E0               JMP   h_num   
E715                             ; prs: print the message at MSG+Y; its last byte has bit 7 set. Y ends just
E715                             ; past it, at the next message.
E715   B9 23 E7     PRS:      LDA   MSG,Y   
E718   48                     PHA      
E719   29 7F                  AND   #7Fh   
E71B   20 03 FF               JSR   CONOUT   
E71E   C8                     INY      
E71F   68                     PLA      
E720   10 F3                  BPL   prs   
E722   60                     RTS      
E723                MSG:         
E723   0D 0A 45 72 72 A0 M_ERR:   DB   13,10,"Err"," "+80h   
E729   20 40 A0               DB   " @"," "+80h   
E72C   0D 8A        M_NL:     DB   13,10+80h   
E72E   0D 0A 53 74 6B A0 M_STK:   DB   13,10,"Stk"," "+80h   
E734   3A 20 2E 2E AE M_CD:   DB   ": ..","."+80h   
E739   BA           M_C:      DB   ":"+80h   
E73A   0D 0A 52 74 6E A0 M_RTN:   DB   13,10,"Rtn"," "+80h   
E740                             ; lcol: the line (LN) and the column (T1/T2) of the place at P, both from
E740                             ; 1. A place below the program is in the -n? line buffer: line 0, and the
E740                             ; column is the place in the buffer. Otherwise IP (free now: the program has
E740                             ; stopped) runs from PROG to the place, counting LFs; T1/T2 keeps where the
E740                             ; last line started, and the column is the place minus that, plus 1.
E740   A9 00        LCOL:     LDA   #0   
E742   85 0B                  STA   LN+1   
E744   85 0A                  STA   LN   
E746   A9 80                  LDA   #<LINEBUF   
E748   85 05                  STA   T1   
E74A   A9 04                  LDA   #>LINEBUF   
E74C   85 06                  STA   T2   
E74E   A5 02                  LDA   P   
E750   C9 00                  CMP   #<PROG   
E752   A5 03                  LDA   P+1   
E754   E9 05                  SBC   #>PROG   
E756   90 26                  BCC   lc9   ; below the program: line 0
E758   E6 0A                  INC   LN   
E75A   20 65 E6               JSR   rstip   
E75D   A5 00        LC3:      LDA   IP   ; a line starts here
E75F   85 05                  STA   T1   
E761   A5 01                  LDA   IP+1   
E763   85 06                  STA   T2   
E765   A5 00        LC1:      LDA   IP   
E767   C5 02                  CMP   P   
E769   A5 01                  LDA   IP+1   
E76B   E5 03                  SBC   P+1   
E76D   B0 0F                  BCS   lc9   ; at the place
E76F   20 54 E6               JSR   getc   
E772   C9 0A                  CMP   #10   
E774   D0 EF                  BNE   lc1   
E776   E6 0A                  INC   LN   ; an LF: a new line starts after it
E778   D0 E3                  BNE   lc3   
E77A   E6 0B                  INC   LN+1   
E77C   D0 DF                  BNE   lc3   ; always
E77E   A5 02        LC9:      LDA   P   
E780   38                     SEC      
E781   E5 05                  SBC   T1   
E783   85 05                  STA   T1   
E785   A5 03                  LDA   P+1   
E787   E5 06                  SBC   T2   
E789   85 06                  STA   T2   
E78B   E6 05                  INC   T1   ; + 1
E78D   D0 02                  BNE   lc8   
E78F   E6 06                  INC   T2   
E791   60           LC8:      RTS      
E792                          ENDIF      


