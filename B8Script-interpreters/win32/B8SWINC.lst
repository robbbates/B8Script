  1528                              <1>         call    pdec                    ; the program's size
  1529                              <1>         call    pmsg
  1530                              <1>         db      '/M/JLines ',22h
  1531                              <1>         pop     eax
  1532                              <1>         call    pdec
  1533                              <1>         call    pmsg
