E9DF                             ; pesc: the escapes of "$". A = the character after the "/", 60h to 7Eh, and
E9DF                             ; the carry is clear. Each returns into the loop.
E9DF                             ;    /a-/z   print the variable, as "#" does
E9DF                             ;    /{      clear the screen, the cursor to the top left
E9DF                             ;    /}      clear from the cursor to the end of the line
E9DF                             ;    /|  /`  show the cursor, hide it
E9DF                             ;    /~      ( row col addr -- addr ): the cursor to that row and column,
E9DF                             ;            from 0. The two cells under the string's address go.
E9DF                             ; A - 7Bh sorts them: 00bbIDAsIHwgMSwg 2, ~ 3 with the carry set, and ` E5h, a-z
E9DF                             ; E6h-FFh with it clear.
E9DF                          IF   1-ANSI   
E9DF                             ; With ANSI = 0 the machine's routines do the work.
E9DF   E9 7A        PESC:     SBC   #7Ah   ; (the carry is clear: - 7Bh)
E9E1   90 0D                  BCC   pe1   
E9E3   F0 08                  BEQ   pcls   ; {
E9E5   4A                     LSR      ; | 0, } 1, ~ 1; the carry set for | and ~
E9E6   F0 0C                  BEQ   pcur   ; |  show: the carry is set
E9E8   B0 26                  BCS   pat   ; ~
E9EA   4C 0F FF               JMP   CONEOL   ; }
E9ED   4C 0C FF     PCLS:     JMP   CONCLS   
E9F0   C9 E6        PE1:      CMP   #0E6h   
E9F2   B0 03                  BCS   pvar   
E9F4   4C 12 FF     PCUR:     JMP   CONCUR   ; `  hide: the carry is clear
E9F7                          ENDIF      
E9F7                             ; a-z: the carry is set. A + 3Ah is the letter - 41h, as step hands it to
E9F7                             ; lower: that pushes the variable"s address, "@" fetches it, and "#' prints
E9F7                             ; it and drops it: TOS is the string's address again.
E9F7   69 39        PVAR:     ADC   #39h   
E9F9   20 0C EB               JSR   lowp   
E9FC   20 6E E4               JSR   h_fetch   
E9FF   4C 9B E2               JMP   h_num   
EA02                          IF   ANSI   
                                 ; With ANSI = 1 they are sequences, each a message at MSG, printed by prs,
                                 ; which pesc runs on into.
                    PESC:     LDY   #M_CLS-MSG   
                              SBC   #7Ah   ; (the carry is clear: - 7Bh)
                              BCC   pe1   
                              BEQ   prs   ; {  ESC [ H ESC [ J
                              LDY   #M_SHOW-MSG   
                              LSR      ; | 0, } 1, ~ 1; the carry set for ~
                              BEQ   prs   ; |  ESC [ ? 2 5 h
                              BCS   pat   ; ~
                              LDY   #M_EOL-MSG   ; }  ESC [ K
                              BNE   prs   ; always
                    PE1:      CMP   #0E6h   
                              BCS   pvar   
                              LDY   #M_HIDE-MSG   ; `  ESC [ ? 2 5 l, and on into prs
EA02                          ENDIF      
EA02                          IF   CHECKED+ANSI   
EA02                             ; prs: print the message at MSG+Y; its last byte has bit 7 set. Y ends just
EA02                             ; past it, at the next message.
EA02   B9 2F EC     PRS:      LDA   MSG,Y   
EA05   48                     PHA      
EA06   29 7F                  AND   #7Fh   
EA08   20 03 FF               JSR   CONOUT   
EA0B   C8                     INY      
EA0C   68                     PLA      
EA0D   10 F3                  BPL   prs   
EA0F   60                     RTS      
EA10                          ENDIF      
EA10                             ; /~: the row is at 4,X, the column at 2,X, the string's address at 0,X.
EA10                PAT:         
EA10                          IF   CHECKED   
EA10   E0 EB                  CPX   #DSE-5   ; fewer than two cells under TOS: s
EA12   B0 35                  BCS   e_sund   
EA14                          ENDIF      
EA14                          IF   1-ANSI   
EA14   B5 04                  LDA   4,X   ; the row
EA16   B4 02                  LDY   2,X   ; the column
EA18   20 15 FF               JSR   CONAT   
EA1B   20 1E EA               JSR   nip   ; two nips leave the address, 4 bytes up
EA1E   20 D6 E2     NIP:      JSR   h_swap   ; nip: ( a b -- b )
EA21   4C 35 E3               JMP   drop   
EA24                          ENDIF      
EA24                          IF   ANSI   
                                 ; ESC [ row+1 ; col+1 H (ANSI counts from 1). Three swaps put the row on top
                                 ; and the address under the column: "#" prints the row and drops it, prints
                                 ; the column and drops it, and TOS is the string's address again.
                              JSR   h_swap   
                              INX      
                              INX      
                              JSR   h_swap   
                              DEX      
                              DEX      
                              JSR   h_swap   
                              LDY   #M_CSI-MSG   
                              JSR   prs   ; ESC [
                              JSR   inctos   
                              JSR   h_num   ; the row + 1
                              LDA   #";"   
                              JSR   CONOUT   
                              JSR   inctos   
                              JSR   h_num   ; the column + 1
                              LDA   #"H"   
                              JMP   CONOUT   
EA24                          ENDIF      
EA24                          IF   CHECKED   
EA24                             ; The checked build's inner loop, out of page 1, where it would not fit,
EA24                             ; and its break check (described with the unchecked one in page 1).
EA24                             ; pnext: the break check, then (falling through) next. A word call, a true
EA24                             ; "(" and a true ")" end here, but the keyboard is looked at only once in 256
EA24                             ; of them: CDOWN counts them down. A key found is held; a Ctrl-C goes on to ctlc. (Startup
EA24                             ; falls in here too, which does no harm.)
EA24   CE 79 04     PNEXT:    DEC   CDOWN   
EA27   D0 0B                  BNE   next   
EA29   20 06 FF     PKEY:     JSR   KEY   
EA2C   F0 06                  BEQ   next   ; no key
EA2E   8D 7A 04               STA   KEYBUF   ; held for the next "?"
EA31   20 71 EA               JSR   chk3   ; (Ctrl-C: back only if the break key is off)
EA34                NEXT:        
EA34                          ENDIF      
EA34                          IF   CHECKED*FAST   
EA34   4C 9A EC               JMP   fnext   ; (the fast build: see "The fast build")
EA37                          ENDIF      
EA37                          IF   CHECKED*(1-FAST)   
                                 ; Both stacks are checked once per character, after it has run. The
                                 ; return stack has overrun when S is below RSLIM: an overflow leaves
                                 ; it at 1Eh or 1Fh, an underflow wraps it to 01h (no handler pulls
                                 ; more than one entry). The data stack has when X is above DSE (an
                                 ; underflow) or below DSFULL (an overflow). No handler moves X by
                                 ; more than 4 (but "$", whose /~ escapes each look first), so X is
                                 ; caught before it wraps; an overrun by a cell or two writes on the
                                 ; scratch bytes below or above the stack.
                                 ; S is kept in RSV, for the report's R: line (an error found inside
                                 ; a handler has its own calls on the hardware stack), and the place
                                 ; of the character about to run in PLACE.
                              TXA      ; TSX trashes X: keep it in A
                              TSX      
                              STX   RSV   
                              CPX   #RSLIM   
                              TAX      ; TAX leaves the carry alone
                              BCC   e_rstack   
                              CPX   #DSE+1   
                              BCS   e_sund   
                              CPX   #DSFULL   
                              BCC   e_sovr   
                              LDA   IP   
                              STA   PLACE   
                              LDA   IP+1   
                              STA   PLACE+1   
                              JSR   step   
                              JMP   next   
EA37                          ENDIF      
EA37                          IF   CHECKED   
EA37                             ; S/R are overflows, s/r underflows. After an underflow that stack counts as
EA37                             ; empty.
EA37   AD 35 04     E_RSTACK:   LDA   RSV   
EA3A   C9 10                  CMP   #10h   
EA3C   A9 52                  LDA   #"R"   
EA3E   B0 10                  BCS   ejmp   ; S is 1Eh-1Fh: an overflow
EA40   A9 FF                  LDA   #0FFh   
EA42   8D 35 04               STA   RSV   ; S wrapped to 01h: R:0
EA45   A9 72                  LDA   #"r"   
EA47   D0 07                  BNE   ejmp   ; always
EA49   A2 F0        E_SUND:   LDX   #DSE   ; D:0
EA4B   A9 73                  LDA   #"s"   
EA4D   2C                     DB   2Ch   ; (BIT abs: hides the next instruction)
EA4E   A9 53        E_SOVR:   LDA   #"S"   
EA50   4C A3 EB     EJMP:     JMP   error   
EA53                             ; skip, checked: as the unchecked one above, and A holds, on the way in, the wrong closer for the
EA53                             ; opener that started the skip, kept in T0: ] for (, ) for [, and 0 for \,
EA53                             ; which takes either. Meeting the wrong closer at this level, or the end
EA53                             ; (a NUL, or a string that runs into it), stops with N, except for \,
EA53                             ; which then ends the program as before.
EA53                          ENDIF      
EA53                          IF   CHECKED*(1-QK)   
                    SKIP:     STA   T0   
                              LDA   #0   
                              STA   T2   ; depth
                    SK1:      JSR   getc   
                              BEQ   sknul   
                              CMP   #22h   
                              BNE   sk2   
                              JSR   skipstr   ; leaves A = 11h, which matches nothing below
                              BEQ   sknul   ; the string ran into the end
                    SK2:      CMP   #"("   
                              BEQ   sk3   
                              CMP   #"["   
                              BEQ   sk3   
                              CMP   #")"   
                              BEQ   sk4   
                              CMP   #"]"   
                              BNE   sk1   
                    SK4:      DEC   T2   
                              BPL   sk1   
                              CMP   T0   
                              BEQ   e_nest   ; the wrong kind
                              RTS      ; the closer at this level
                    SK3:      INC   T2   
                              BNE   sk1   
EA53                          ENDIF      
EA53                          IF   CHECKED   
EA53   A5 04        SKNUL:    LDA   T0   
EA55   D0 03                  BNE   e_nest   ; ( and [ stop with N
EA57   4C 09 FF               JMP   EXIT   ; \ ends the program
EA5A   A9 4E        E_NEST:   LDA   #"N"   ; a skip from ( or [ found the wrong closer
EA5C   4C A3 EB               JMP   error   ;   or the end: the place is the opener
EA5F                          ENDIF      
EA5F                          IF   1-CHECKED   
                    CBREAK:   EQU   endp   ; the unchecked build stops without a word
EA5F                          ENDIF      
EA5F                          IF   CHECKED   
EA5F                CBREAK:   EQU   e_break   ; the checked build reports B
EA5F                          ENDIF      
EA5F                             ; getk: a key for "?" in A (zero flag clear), or A = 0 with the zero flag
EA5F                             ; set when there is none. Keeps X and Y. The held key goes first, and is
EA5F                             ; taken out of KEYBUF.
EA5F   AD 7A 04     GETK:     LDA   KEYBUF   
EA62   F0 08                  BEQ   gk1   
EA64   48                     PHA      
EA65   A9 00                  LDA   #0   
EA67   8D 7A 04               STA   KEYBUF   
EA6A   68                     PLA      
EA6B   60                     RTS      
EA6C   20 06 FF     GK1:      JSR   KEY   
EA6F   F0 04                  BEQ   gk9   
EA71                             ; chk3: a key in A (not 0). A Ctrl-C goes on to ctlc, which gives the 03h
EA71                             ; back if it comes back at all.
EA71   C9 03        CHK3:     CMP   #3   
EA73   F0 01                  BEQ   ctlc   
EA75   60           GK9:      RTS      
EA76                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
EA76                             ; the program has turned it off, wait about 250 ms (about 250 times MSLOOP
EA76                             ; looks: T1 counts the 256s, T2 runs on from whatever it holds) for one more
EA76                             ; key: a second Ctrl-C is the end too; any other key is held (the newest
EA76                             ; wins). Returns A = 03h with the zero flag clear. Keeps X and Y.
EA76   AD 7B 04     CTLC:     LDA   BRKOFF   
EA79   F0 1D                  BEQ   cbreak   
EA7B   A9 28                  LDA   #CWAIT+1   
EA7D   85 05                  STA   T1   
EA7F   20 06 FF     CT2:      JSR   KEY   
EA82   D0 0A                  BNE   ct3   
EA84   C6 06                  DEC   T2   
EA86   D0 F7                  BNE   ct2   
EA88   C6 05                  DEC   T1   
EA8A   D0 F3                  BNE   ct2   
EA8C   F0 07                  BEQ   ct9   ; always: none came
EA8E   C9 03        CT3:      CMP   #3   
EA90   F0 06                  BEQ   cbreak   
EA92   8D 7A 04               STA   KEYBUF   
EA95   A9 03        CT9:      LDA   #3   
EA97   60                     RTS      
EA98                          IF   CHECKED   
EA98   A9 42        E_BREAK:   LDA   #"B"   ; Ctrl-C (the stacks as they stand)
EA9A   2C                     DB   2Ch   ; (BIT abs: hides the next instruction)
EA9B   A9 58        E_RESV:   LDA   #"X"   ; a reserved byte, 80h-FFh
EA9D   4C A3 EB     EJMP2:    JMP   error   
EAA0                             ; e_undef: the word cells of undefined words hold 0000h. A call there reads
EAA0                             ; the byte at 0000h, which is IP's own low byte: 00h while IP is 0000h, so
EAA0                             ; the call reads a NUL with IP in page zero, where no program can be. The
EAA0                             ; call is undone first: the step frame and the return address come off the
EAA0                             ; hardware stack, and the place is the call letter (the return address - 1).
EAA0   68           E_UNDEF:   PLA      
EAA1   68                     PLA      ; the step frame
EAA2   68                     PLA      
EAA3   38                     SEC      
EAA4   E9 01                  SBC   #1   
EAA6   85 08                  STA   PLACE   
EAA8   68                     PLA      
EAA9   E9 00                  SBC   #0   
EAAB   85 09                  STA   PLACE+1   
EAAD   EE 35 04               INC   RSV   
EAB0   EE 35 04               INC   RSV   ; R: does not count the call
EAB3   A9 55                  LDA   #"U"   
EAB5   D0 E6                  BNE   ejmp2   ; always
EAB7                          ENDIF      
EAB7                             ; step: read one character and sort it by range.
EAB7                             ;    00h          end of program
EAB7                             ;    01h-20h, 7Fh-FFh   ignored
EAB7                             ;    30h-39h      digit: read a whole number
EAB7                             ;    41h-5Ah      A-Z: call the word in that letter's cell
EAB7                             ;    61h-7Ah      a-z: push the address of that letter's cell
EAB7                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
EAB7   20 89 EB     STEP:     JSR   getc   ; flags follow A
EABA   F0 3D                  BEQ   endp   
EABC   38                     SEC      
EABD   E9 21                  SBC   #21h   ; A = c - 21h
EABF   90 37                  BCC   ign   ; 01h-20h
EAC1   C9 0F                  CMP   #0Fh   
EAC3   90 24                  BCC   punct   ; 21h-2Fh: index 0-14
EAC5   E9 0F                  SBC   #0Fh   ; (carry set) A = c - 30h
EAC7   C9 0A                  CMP   #10   
EAC9   90 72                  BCC   digit   
EACB   C9 11                  CMP   #11h   
EACD   90 18                  BCC   p3a   ; 3Ah-40h
EACF   E9 11                  SBC   #11h   ; (carry set) A = c - 41h
EAD1   C9 1A                  CMP   #1Ah   
EAD3   90 2B                  BCC   upper   ; 41h-5Ah
EAD5   C9 20                  CMP   #20h   
EAD7   90 0C                  BCC   p5b   ; 5Bh-60h
EAD9   C9 3A                  CMP   #3Ah   
EADB   90 2F                  BCC   lower   ; 61h-7Ah: A = 20h-39h
EADD   C9 3E                  CMP   #3Eh   
EADF                          IF   1-CHECKED   
                              BCS   ign   ; 7Fh-FFh
EADF                          ENDIF      
EADF                          IF   CHECKED   
EADF   F0 17                  BEQ   ign   ; 7Fh
EAE1   B0 B8                  BCS   e_resv   ; 80h-FFh: reserved
EAE3                          ENDIF      
EAE3                             ; The three adjustments below chain. Each ADC adds the carry the one
EAE3                             ; before it left, which the constants allow for.
EAE3   E9 1A                  SBC   #1Ah   ; 7Bh-7Eh: (carry clear: -1Bh) index 28-31
EAE5   69 F6        P5B:      ADC   #0F6h   ; 5Bh-60h: -10 (-9 when chained), index 22-27
EAE7   69 05        P3A:      ADC   #5   ; 3Ah-40h: +5 (+6 when chained), index 15-21
EAE9                             ; Punctuation: A = the index. The handler's page is the first, plus one if
EAE9                             ; the index is N1 or more, plus one more if it is N2 or more.
EAE9   C9 08        PUNCT:    CMP   #N1   
EAEB   A8                     TAY      
EAEC   A9 70                  LDA   #HALFPG   
EAEE   2A                     ROL      ; the first page, or the second (carry clear)
EAEF   C0 15                  CPY   #N2   
EAF1   69 00                  ADC   #0   ; ... or the third (and the carry is clear)
EAF3   48                     PHA      
EAF4   B9 1D EB               LDA   PTAB,Y   
EAF7   48                     PHA      
EAF8   60           IGN:      RTS      ; RTS trick: goes to the handler. Reached
EAF9                             ; directly, it just ends an ignored character.
EAF9                ENDP:        ; the program has ended
EAF9                          IF   CHECKED   
EAF9   A5 01                  LDA   IP+1   ; IP in page zero: an undefined word
EAFB   F0 A3                  BEQ   e_undef   
EAFD                          ENDIF      
EAFD   4C 09 FF               JMP   EXIT   
EB00                             ; A-Z: call the word. The return address (the IP after the letter) goes on
EB00                             ; the return stack, and the IP becomes the address in the letter's cell.
EB00   0A           UPPER:    ASL      
EB01   A8                     TAY      
EB02   38                     SEC      
EB03   4C F7 E2               JMP   pushn   
EB06   A5 00        PUSHIP:   LDA   IP   ; push the reading position
EB08   A4 01                  LDY   IP+1   
EB0A   D0 03                  BNE   pushay   ; always: no program is in page zero
EB0C                             ; a-z: push the cell's address (the cell is the variable)
EB0C                             ;  (the unchecked QK builds do x@ and x! in one step: lowq)
EB0C                          IF   SBASEU   
                    LOWER:    JMP   lowq   
                    LOWP:        
EB0C                          ENDIF      
EB0C                          IF   1-SBASEU   
EB0C                LOWER:       
EB0C                LOWP:        
EB0C                          ENDIF      
EB0C   0A                     ASL      
EB0D   A0 04                  LDY   #>LET   
EB0F                             ; pushay: push a cell: A = its low byte, Y = its high byte
EB0F   CA           PUSHAY:   DEX      
EB10   CA                     DEX      
EB11   95 00        SETAY:    STA   0,X   ; setay: TOS = A (low), Y (high)
EB13   94 01                  STY   1,X   
EB15   60                     RTS      
EB16                             ; flag: pops TOS and returns with Z set if it was 0. Keeps the carry.
EB16   E8           FLAG:     INX      
EB17   E8                     INX      
EB18   B5 FE                  LDA   0FEh,X   
EB1A   15 FF                  ORA   0FFh,X   
EB1C   60                     RTS      
EB1D                             ; =============================================================================
EB1D                             ;  Dispatch table: the low byte of (handler - 1) for each punctuation
EB1D                             ;  character, in code order.
EB1D                             ; =============================================================================
EB1D   C6           PTAB:     DB   (h_store-1) & 0FFh   ; !
EB1E   74                     DB   (h_str-1) & 0FFh   ; "
EB1F   9A                     DB   (h_num-1) & 0FFh   ; #
EB20   48                     DB   (h_print-1) & 0FFh   ; $
EB21   D5                     DB   (h_swap-1) & 0FFh   ; %
EB22   E6                     DB   (h_and-1) & 0FFh   ; &
EB23   92                     DB   (h_emit-1) & 0FFh   ; '
EB24   F1                     DB   (h_open-1) & 0FFh   ; (
EB25   B0                     DB   (h_close-1) & 0FFh   ; )
EB26   76                     DB   (h_mul-1) & 0FFh   ; *
EB27   40                     DB   (h_add-1) & 0FFh   ; +
EB28   A7                     DB   (h_cfetch-1) & 0FFh   ; ,
EB29   37                     DB   (h_sub-1) & 0FFh   ; -
EB2A   2B                     DB   (h_cstore-1) & 0FFh   ; .
EB2B   7E                     DB   (h_div-1) & 0FFh   ; /
EB2C   24                     DB   (h_dup-1) & 0FFh   ; :
EB2D   34                     DB   (drop-1) & 0FFh   ; ;
EB2E   55                     DB   (h_lt-1) & 0FFh   ; <
EB2F   66                     DB   (h_eq-1) & 0FFh   ; =
EB30   52                     DB   (h_gt-1) & 0FFh   ; >
EB31   B8                     DB   (h_key-1) & 0FFh   ; ?
EB32   6D                     DB   (h_fetch-1) & 0FFh   ; @
EB33   92                     DB   (h_def-1) & 0FFh   ; [
EB34   15                     DB   (h_break-1) & 0FFh   ; \
EB35   29                     DB   (h_ret-1) & 0FFh   ; ]
EB36   57                     DB   (h_xor-1) & 0FFh   ; ^
EB37   E4                     DB   (h_alloc-1) & 0FFh   ; _
EB38   B6                     DB   (h_grave-1) & 0FFh   ; `
EB39   3B                     DB   (h_tor-1) & 0FFh   ; {
EB3A   62                     DB   (h_or-1) & 0FFh   ; |
EB3B   47                     DB   (h_fromr-1) & 0FFh   ; }
EB3C   54                     DB   (h_not-1) & 0FFh   ; ~
EB3D                             ; Digits: the first one is in A; read the rest of the number.
EB3D   A0 00        DIGIT:    LDY   #0   
EB3F   20 0F EB               JSR   pushay   
EB42                             ; rdnum: TOS = TOS*10 + digit for each digit at IP. Wraps at 16 bits.
EB42                             ; Returns with the carry set.
EB42   20 6F EB     RDNUM:    JSR   isdig   
EB45   B0 4D                  BCS   ic9   ; (an RTS)
EB47   20 8C EB               JSR   incip   ; (keeps A = the digit)
EB4A   16 00                  ASL   0,X   
EB4C   36 01                  ROL   1,X   ; x2
EB4E   18                     CLC      
EB4F   75 00                  ADC   0,X   
EB51   85 04                  STA   T0   
EB53   B5 01                  LDA   1,X   
EB55   69 00                  ADC   #0   
EB57   A8                     TAY      ; Y:T0 = x2 + digit
EB58   16 00                  ASL   0,X   
EB5A   36 01                  ROL   1,X   
EB5C   16 00                  ASL   0,X   
EB5E   36 01                  ROL   1,X   ; x8
EB60   18                     CLC      
EB61   B5 00                  LDA   0,X   
EB63   65 04                  ADC   T0   
EB65   95 00                  STA   0,X   
EB67   98                     TYA      
EB68   75 01                  ADC   1,X   
EB6A   95 01                  STA   1,X   ; x8 + x2 + digit
EB6C   4C 42 EB               JMP   rdnum   
EB6F                             ; isdig: A = the character at IP minus "0"; the carry is clear if it is a
EB6F                             ; digit. Y = 0.
EB6F   20 95 EB     ISDIG:    JSR   peek   
EB72   38                     SEC      
EB73   E9 30                  SBC   #"0"   
EB75   C9 0A                  CMP   #10   
EB77   60                     RTS      
EB78                             ; rdhex: if IP is at a hex digit (0-9, A-F, a-f), return its value in A with
EB78                             ; the carry clear and IP moved on; otherwise the carry is set and IP stays.
EB78   20 6F EB     RDHEX:    JSR   isdig   
EB7B   90 0F                  BCC   incip   
EB7D   29 DF                  AND   #0DFh   
EB7F   E9 11                  SBC   #11h   ; (the carry is set)
EB81   C9 06                  CMP   #6   
EB83   B0 0F                  BCS   ic9   
EB85   69 0A                  ADC   #10   
EB87   D0 03                  BNE   incip   ; always
EB89                             ; Reading the program
EB89                             ;    peek: A = the character at IP, IP unchanged, Y = 0
EB89                             ;    getc: the same, then IP moves on; flags follow A
EB89                             ;    incip: IP moves on; keeps A, the carry and Y
EB89   20 95 EB     GETC:     JSR   peek   
EB8C   E6 00        INCIP:    INC   IP   
EB8E   D0 02                  BNE   ic1   
EB90   E6 01                  INC   IP+1   
EB92   09 00        IC1:      ORA   #0   
EB94   60           IC9:      RTS      
EB95   A0 00        PEEK:     LDY   #0   
EB97   B1 00                  LDA   (IP),Y   
EB99   60                     RTS      
EB9A                             ; rstip: point IP at the start of the program
EB9A   A9 00        RSTIP:    LDA   #<PROG   
EB9C   85 00                  STA   IP   
EB9E   A9 05                  LDA   #>PROG   
EBA0   85 01                  STA   IP+1   
EBA2   60                     RTS      
EBA3                          IF   CHECKED   
EBA3                             ; =============================================================================
EBA3                             ;  Checked build: the error report
EBA3                             ; =============================================================================
EBA3                             ; error: the report, then EXIT. A = the letter, PLACE = the place, X = the
EBA3                             ; data stack to show, RSV = S for the R: line. Nothing here relies on S: an
EBA3                             ; overflowed or underflowed hardware stack wraps inside its page, and only
EBA3                             ; its depth is shown.
EBA3                             ;   CR LF
EBA3                             ;   Err X @ line,col CR LF
EBA3                             ;   D:n: [...] and the top 8 cells at most, bottom to top  CR LF
EBA3                             ;   R:n CR LF
EBA3                             ; The numbers go through "#" (prnum), which pushes them over the data stack
EBA3                             ; and pops them again, so the stack is shown as it was. With the stack full
EBA3                             ; (X = 0Eh) that reaches down to 0Ah, so nothing the report keeps is there.
EBA3   48           ERROR:    PHA      ; the letter
EBA4   A5 08                  LDA   PLACE   
EBA6   85 02                  STA   P   
EBA8   A5 09                  LDA   PLACE+1   
EBAA   85 03                  STA   P+1   ; (CO is the report's scratch from here on)
EBAC   A0 00                  LDY   #M_ERR-MSG   
EBAE   20 02 EA               JSR   prs   ; CR LF "Err "
EBB1   68                     PLA      
EBB2   20 03 FF               JSR   CONOUT   
EBB5   20 02 EA               JSR   prs   ; " @ " (it follows M_ERR)
EBB8   20 48 EC               JSR   lcol   
EBBB   A5 0A                  LDA   LN   
EBBD   A4 0B                  LDY   LN+1   
EBBF   20 29 EC               JSR   prnum   ; the line
EBC2   A9 2C                  LDA   #","   
EBC4   20 03 FF               JSR   CONOUT   
EBC7   A5 08                  LDA   CO   
EBC9   A4 09                  LDY   CO+1   
EBCB   20 29 EC               JSR   prnum   ; the column
EBCE   A0 0B                  LDY   #M_STK-MSG   
EBD0   20 02 EA               JSR   prs   ; CR LF "D:"
EBD3   8A                     TXA      
EBD4   49 FF                  EOR   #0FFh   
EBD6   38                     SEC      
EBD7   E9 0F                  SBC   #0FFh-DSE   
EBD9   4A                     LSR      ; the depth, (DSE - X) / 2
EBDA   48                     PHA      
EBDB   20 27 EC               JSR   prnum8   
EBDE   68                     PLA      
EBDF   A0 14                  LDY   #M_C-MSG   ; ":"
EBE1   C9 09                  CMP   #9   
EBE3   90 04                  BCC   er3   
EBE5   A9 08                  LDA   #8   ; more than 8: ": ..." and the top 8
EBE7   A0 0F                  LDY   #M_CD-MSG   
EBE9   85 08        ER3:      STA   CO   ; CO = how many cells to show
EBEB   20 02 EA               JSR   prs   
EBEE   A5 08        ER4:      LDA   CO   ; cells CO-1 down to 0, the top last: cell i
EBF0   F0 1F                  BEQ   er5   ;   from the top is at X+2i
EBF2   C6 08                  DEC   CO   
EBF4   A9 20                  LDA   #" "   
EBF6   20 03 FF               JSR   CONOUT   
EBF9   A5 08                  LDA   CO   
EBFB   0A                     ASL      
EBFC   85 09                  STA   CO+1   
EBFE   8A                     TXA      
EBFF   65 09                  ADC   CO+1   ; (the carry is clear)
EC01   A8                     TAY      
EC02   B9 00 00               LDA   0,Y   
EC05   48                     PHA      
EC06   B9 01 00               LDA   1,Y   
EC09   A8                     TAY      
EC0A   68                     PLA      
EC0B   20 29 EC               JSR   prnum   
EC0E   4C EE EB               JMP   er4   
EC11   A0 15        ER5:      LDY   #M_RTN-MSG   
EC13   20 02 EA               JSR   prs   ; CR LF "R:"
EC16   AD 35 04               LDA   RSV   
EC19   49 FF                  EOR   #0FFh   
EC1B   4A                     LSR      ; (FFh - S) / 2 entries
EC1C   20 27 EC               JSR   prnum8   
EC1F   A0 09                  LDY   #M_NL-MSG   
EC21   20 02 EA               JSR   prs   
EC24   4C 09 FF               JMP   EXIT   
EC27                             ; prnum: print the number A (low), Y (high), signed, keeping the data stack.
EC27                             ; prnum8: the same for A alone, 0-255.
EC27   A0 00        PRNUM8:   LDY   #0   
EC29   20 0F EB     PRNUM:    JSR   pushay   
EC2C   4C 9B E2               JMP   h_num   
EC2F                          ENDIF      
EC2F                          IF   CHECKED+ANSI   
EC2F                MSG:         
EC2F                          ENDIF      
EC2F                          IF   ANSI   
                    M_CLS:    DB   27,"[","H",27,"[","J"+80h   
                    M_SHOW:   DB   27,"[","?","2","5","h"+80h   
                    M_HIDE:   DB   27,"[","?","2","5","l"+80h   
                    M_EOL:    DB   27,"[","K"+80h   
                    M_CSI:    DB   27,"["+80h   
EC2F                          ENDIF      
EC2F                          IF   CHECKED   
EC2F   0D 0A 45 72 72 A0 M_ERR:   DB   13,10,"Err"," "+80h   
EC35   20 40 A0               DB   " @"," "+80h   
EC38   0D 8A        M_NL:     DB   13,10+80h   
EC3A   0D 0A 44 BA  M_STK:    DB   13,10,"D",":"+80h   
EC3E   3A 20 2E 2E AE M_CD:   DB   ": ..","."+80h   
EC43   BA           M_C:      DB   ":"+80h   
EC44   0D 0A 52 BA  M_RTN:    DB   13,10,"R",":"+80h   
EC48                          ENDIF      
EC48                          IF   CHECKED   
EC48                             ; lcol: the line (LN) and the column (CO) of the place at P, both from
EC48                             ; 1. A place below the program is in the -n? line buffer: line 0, and the
EC48                             ; column is the place in the buffer. Otherwise IP (free now: the program has
EC48                             ; stopped) runs from PROG to the place, counting LFs; CO keeps where the
EC48                             ; last line started, and the column is the place minus that, plus 1.
EC48   A9 00        LCOL:     LDA   #0   
EC4A   85 0B                  STA   LN+1   
EC4C   85 0A                  STA   LN   
EC4E   A9 80                  LDA   #<LINEBUF   
EC50   85 08                  STA   CO   
EC52   A9 04                  LDA   #>LINEBUF   
EC54   85 09                  STA   CO+1   
EC56   A5 02                  LDA   P   
EC58   C9 00                  CMP   #<PROG   
EC5A   A5 03                  LDA   P+1   
EC5C   E9 05                  SBC   #>PROG   
EC5E   90 26                  BCC   lc9   ; below the program: line 0
EC60   E6 0A                  INC   LN   
EC62   20 9A EB               JSR   rstip   
EC65   A5 00        LC3:      LDA   IP   ; a line starts here
EC67   85 08                  STA   CO   
EC69   A5 01                  LDA   IP+1   
EC6B   85 09                  STA   CO+1   
EC6D   A5 00        LC1:      LDA   IP   
EC6F   C5 02                  CMP   P   
EC71   A5 01                  LDA   IP+1   
EC73   E5 03                  SBC   P+1   
EC75   B0 0F                  BCS   lc9   ; at the place
EC77   20 89 EB               JSR   getc   
EC7A   C9 0A                  CMP   #10   
EC7C   D0 EF                  BNE   lc1   
EC7E   E6 0A                  INC   LN   ; an LF: a new line starts after it
EC80   D0 E3                  BNE   lc3   
EC82   E6 0B                  INC   LN+1   
EC84   D0 DF                  BNE   lc3   ; always
EC86   A5 02        LC9:      LDA   P   
EC88   38                     SEC      
EC89   E5 08                  SBC   CO   
EC8B   85 08                  STA   CO   
EC8D   A5 03                  LDA   P+1   
EC8F   E5 09                  SBC   CO+1   
EC91   85 09                  STA   CO+1   
EC93   E6 08                  INC   CO   ; + 1
EC95   D0 02                  BNE   lc8   
EC97   E6 09                  INC   CO+1   
EC99   60           LC8:      RTS      
EC9A                          ENDIF      
EC9A                             ; =============================================================================
EC9A                             ;  The fast build (SPEED = 2)
EC9A                             ; 
EC9A                             ;  The inner loop is a table: 256 entries, the low bytes of the handlers'
EC9A                             ;  addresses in one page (DTL) and the high bytes in the next (DTH). The
EC9A                             ;  dispatcher, NEXTF, is inline at the end of the fast build's own entries,
EC9A                             ;  so there is no JSR and no RTS per character:
EC9A                             ;      LDY #0 / LDA (IP),Y / INC IP / BNE $+4 / INC IP+1 / TAY /
EC9A                             ;      LDA DTL,Y / STA V / LDA DTH,Y / STA V+1 / JMP (V)
EC9A                             ;  The letters and digits have one entry each, which knows its cell or its
EC9A                             ;  value already; the commonest punctuation is written for the table; the
EC9A                             ;  rest reach the ordinary handlers through a thunk (CLC / JSR handler /
EC9A                             ;  NEXTF, or JMP fnext for the rare ones), which gives them the step frame
EC9A                             ;  and the clear carry they expect.
EC9A                             ;  The ordinary handlers that end at next or pnext go to fnext, the same
EC9A                             ;  dispatcher. In the checked build NEXTF is JMP fnext, which checks the
EC9A                             ;  stacks first, as next does in the other builds.
EC9A                             ;  Everything here is read-only: the image can be ROM, as the others are.
EC9A                             ;  The table takes the image's first two pages (E000h-E1FFh); the code
EC9A                             ;  starts after it.
EC9A                             ; =============================================================================
EC9A                          IF   FAST   
EC9A                             ; fnext: the dispatcher, after the checks of the checked build
EC9A                FNEXT:       
EC9A                          ENDIF      
EC9A                          IF   FAST*CHECKED   
EC9A                             ; (the same checks as next in the other checked builds)
EC9A   8A                     TXA      ; TSX trashes X: keep it in A
EC9B   BA                     TSX      
EC9C   8E 35 04               STX   RSV   
EC9F   E0 20                  CPX   #RSLIM   
ECA1   AA                     TAX      
ECA2   B0 03                  BCS   fn1   
ECA4   4C 37 EA               JMP   e_rstack   
ECA7   E0 F1        FN1:      CPX   #DSE+1   
ECA9   B0 07                  BCS   fn2   
ECAB   E0 10                  CPX   #DSFULL   
ECAD   B0 06                  BCS   fn3   
ECAF   4C 4E EA               JMP   e_sovr   
ECB2   4C 49 EA     FN2:      JMP   e_sund   
ECB5   A5 00        FN3:      LDA   IP   
ECB7   85 08                  STA   PLACE   
ECB9   A5 01                  LDA   IP+1   
ECBB   85 09                  STA   PLACE+1   
ECBD                          ENDIF      
ECBD                          IF   FAST   
ECBD   A0 00                  LDY   #0   
ECBF   B1 00                  LDA   (IP),Y   
ECC1   E6 00                  INC   IP   
ECC3   D0 02                  BNE   fn4   
ECC5   E6 01                  INC   IP+1   
ECC7   A8           FN4:      TAY      
ECC8   B9 00 E0               LDA   DTL,Y   
ECCB   85 04                  STA   V   
ECCD   B9 00 E1               LDA   DTH,Y   
ECD0   85 05                  STA   V+1   
ECD2   6C 04 00               JMP   (V)   
ECD5                             ; fpoll: the break check of pnext, as a subroutine, for the entries that
ECD5                             ; look at the keyboard (a word call, a true ( and a true ))
ECD5   20 06 FF     FPOLL:    JSR   KEY   
ECD8   F0 06                  BEQ   fp9   ; no key
ECDA   8D 7A 04               STA   KEYBUF   ; held for the next "?"
ECDD   4C 71 EA               JMP   chk3   ; (Ctrl-C: back only if the break key is off)
ECE0   60           FP9:      RTS      
ECE1                             ; The thunks: the rest of the punctuation, through the ordinary handlers
ECE1   18           FT_STR:   CLC      ; "
ECE2   20 75 E2               JSR   h_str   
ECE5   4C 9A EC               JMP   fnext   ; (rare enough: the shared dispatcher)
ECE8   18           FT_NUM:   CLC      ; #
ECE9   20 9B E2               JSR   h_num   
ECEC   4C 9A EC               JMP   fnext   ; (rare enough: the shared dispatcher)
ECEF   18           FT_PRT:   CLC      ; $
ECF0   20 49 E2               JSR   h_print   
ECF3   4C 9A EC               JMP   fnext   ; (rare enough: the shared dispatcher)
ECF6   18           FT_EMIT:   CLC      ; '
ECF7   20 93 E2               JSR   h_emit   
ECFA   4C 9A EC               JMP   fnext   ; (rare enough: the shared dispatcher)
ECFD   18           FT_DIV:   CLC      ; /
ECFE   20 7F E3               JSR   h_div   
ED01                          ;*Macro unroll:  NEXTF
ED01                          DS   1-CHECKED,0A0h   
ED01                          DS   1-CHECKED,0   
ED01                          DS   1-CHECKED,0B1h   
ED01                          DS   1-CHECKED,IP   
ED01                          DS   1-CHECKED,0E6h   
ED01                          DS   1-CHECKED,IP   
ED01                          DS   1-CHECKED,0D0h   
ED01                          DS   1-CHECKED,2   
ED01                          DS   1-CHECKED,0E6h   
ED01                          DS   1-CHECKED,IP+1   
ED01                          DS   1-CHECKED,0A8h   
ED01                          DS   1-CHECKED,0B9h   
ED01                          DS   1-CHECKED,ADTL&0FFh   
ED01                          DS   1-CHECKED,ADTL/256   
ED01                          DS   1-CHECKED,85h   
ED01                          DS   1-CHECKED,V   
ED01                          DS   1-CHECKED,0B9h   
ED01                          DS   1-CHECKED,ADTH&0FFh   
ED01                          DS   1-CHECKED,ADTH/256   
ED01                          DS   1-CHECKED,85h   
ED01                          DS   1-CHECKED,V+1   
ED01                          DS   1-CHECKED,6Ch   
ED01                          DS   1-CHECKED,V   
ED01                          DS   1-CHECKED,0   
ED01   4C                     DS   CHECKED,4Ch   
ED02   9A                     DS   CHECKED,AFNX&0FFh   
ED03   EC                     DS   CHECKED,AFNX/256   
ED04   18           FT_KEY:   CLC      ; ?
ED05   20 B9 E3               JSR   h_key   
ED08   4C 9A EC               JMP   fnext   ; (rare enough: the shared dispatcher)
ED0B   18           FT_DEF:   CLC      ; [
ED0C   20 93 E4               JSR   h_def   
ED0F                          ;*Macro unroll:  NEXTF
ED0F                          DS   1-CHECKED,0A0h   
ED0F                          DS   1-CHECKED,0   
ED0F                          DS   1-CHECKED,0B1h   
ED0F                          DS   1-CHECKED,IP   
ED0F                          DS   1-CHECKED,0E6h   
ED0F                          DS   1-CHECKED,IP   
ED0F                          DS   1-CHECKED,0D0h   
ED0F                          DS   1-CHECKED,2   
ED0F                          DS   1-CHECKED,0E6h   
ED0F                          DS   1-CHECKED,IP+1   
ED0F                          DS   1-CHECKED,0A8h   
ED0F                          DS   1-CHECKED,0B9h   
ED0F                          DS   1-CHECKED,ADTL&0FFh   
ED0F                          DS   1-CHECKED,ADTL/256   
ED0F                          DS   1-CHECKED,85h   
ED0F                          DS   1-CHECKED,V   
ED0F                          DS   1-CHECKED,0B9h   
ED0F                          DS   1-CHECKED,ADTH&0FFh   
ED0F                          DS   1-CHECKED,ADTH/256   
ED0F                          DS   1-CHECKED,85h   
ED0F                          DS   1-CHECKED,V+1   
ED0F                          DS   1-CHECKED,6Ch   
ED0F                          DS   1-CHECKED,V   
ED0F                          DS   1-CHECKED,0   
ED0F   4C                     DS   CHECKED,4Ch   
ED10   9A                     DS   CHECKED,AFNX&0FFh   
ED11   EC                     DS   CHECKED,AFNX/256   
ED12   18           FT_BRK:   CLC      ; \
ED13   20 16 E4               JSR   h_break   
