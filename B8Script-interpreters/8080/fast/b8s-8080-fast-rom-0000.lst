05FD   CD D6 05               CALL   prstr   
0600   E3                     XTHL      
0601   C9                     RET      
0602                             ; chkstk: both stacks are checked once per character, not in every handler.
0602                             ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
0602                             ; the constant carries if it is above (cells were popped that were never
0602                             ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
0602                             ; a character late at most: the bytes above DSTOP and the guard band below
0602                             ; the page take what happens meanwhile.
0602   EB           CHKSTK:   XCHG      ; DE = TOS (HL is needed for the pointers)
0603   21 05 7E               LXI   H,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
0606   39                     DAD   SP   
0607   DA 31 06               JC   e_under   
060A   24                     INR   H   
060B   C2 2B 06               JNZ   e_over   
060E   2A 34 82               LHLD   RSP   ; the return stack: in its page (or it has
0611   7C                     MOV   A,H   ;   overflowed), and not above its empty
0612   FE 80                  CPI   RSPAGE   ;   position (an underflow stays inside the
0614   C2 28 06               JNZ   e_rover   ;   page, in the guard band)
