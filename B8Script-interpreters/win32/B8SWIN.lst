   562 00000106 E809030000          <1>         call    skip
   563 0000010B 84C0                <1>         test    al,al                   ; skip returns 0 for ')'
   564 0000010D 75EC                <1>         jnz     h_ret
   565 0000010F EBEC                <1>         jmp     rdrop
   566                              <1> 
   567                              <1> ; ')' ( flag -- ): true jumps back to the block start (and keeps it); false
   568                              <1> ; drops it and carries on. The loop-back looks at the break key.
   569 00000111 6685DB              <1> h_close:test    bx,bx
   570 00000114 5B                  <1>         pop     ebx
   571 00000115 74E6                <1>         jz      rdrop
