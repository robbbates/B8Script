0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Spec: docs/b8script.md (2026-10-09) plus the 2026-11-20 changes:
0000                             ;        [x stores in a variable, "[ " pushes an anonymous block, any other
0000                             ;        character after [ is an error, the heap pointer lives at z10+.
0000                             ;        The string escape is "/" (it was ">").
0000                             ;        Dividing by zero is not checked. -n? does no more editing than
0000                             ;        Backspace.
0000                             ; 
0000                             ;  Three switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    EDITOR   1 = with a small line editor built in (see the end of this
0000                             ;                 file). It goes with either setting of the other two.
0000                             ;    CHECKED  0 = no checks (spec: "B8Script checks nothing")
0000                             ;             1 = stops on stack overrun, Ctrl-C, heap past the limit, a store
0000                             ;                 outside the program's own space, and a bad character after [,
0000                             ;                 printing a letter and the place, like  S @ 245
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   0   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   0   ; 1 = checked build
0000                EDITOR:   EQU   0   ; 1 = with the line editor
0000                EDGEN:    EQU   EDITOR*(1-CPM)   ; (the generic build with the editor)
0000                TABP0:    EQU   EDGEN*(1-CHECKED)   ; (the build with its table in page zero)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    HL'  return-stack pointer (the alternate HL). Entries are 2 bytes; the
0000                             ;         stack grows down. Only rpop and rpushn (and the checks) touch it.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  One-byte calls. The routines used most are reached with RST, one byte
0000                             ;  instead of three:
0000                             ; 
0000                             ;    RST 08h  rpop    pop the return stack into DE
0000                             ;    RST 18h  drop    drop TOS, then next character     (ends a handler)
0000                             ;    RST 20h  neg16   HL = -HL
0000                             ;    RST 28h  putc    print A
0000                             ;    RST 30h  next    next character                    (ends a handler)
0000                             ; 
0000                             ;  RST 18h and RST 30h never return: an RST is a CALL, so the first thing
0000                             ;  each of them does is POP DE to throw the return address away.
0000                             ; 
0000                             ;  The CP/M build can't own page zero, so the block from `vecs` to `vecend`
0000                             ;  (image addresses 0108h-0133h) is copied to 0008h-0033h when it starts. The
0000                             ;  code in that block is written to work at either place.
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (SP stays inside this page)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch (= z10+), interpreter variables in the gaps, and the -n?
0000                             ;             line buffer at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack's page has a guard band: the data
0000                             ;  stack can overrun by a cell or two (and the calls made while it is full)
0000                             ;  into the top 32 bytes of the return-stack page, which are never used, and
0000                             ;  the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
                    BDOS:     EQU   0005h   
                    BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IF   CPM*(1-EDITOR)   
                    EXIT:     EQU   0000h   ; warm boot
0000                          ENDIF      
0000                          IFN   CPM   
0000                             ; ---- generic machine: edit these to suit -----------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The zero flag must match A
0000                             ;   (end the routine with OR A / RET).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                             ;   KEY and CONOUT must preserve BC, DE, HL and HL'.
0000                RSPAGE:   EQU   80h   ; 8000h return stack
0000                DSPAGE:   EQU   81h   ; 8100h data stack
0000                LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
0000                PROG:     EQU   8300h   ; where the loader puts the program text
0000                HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
0000                BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)   
0000                EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                          ENDIF      
0000                          IF   EDITOR   
                    EXIT:     EQU   edit   ; a program that ends goes back to the editor
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; z10+, the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                KEYBUF:   EQU   LET+36h   ;   around machine code; a held-back key;
0000                SPTMP:    EQU   LET+38h   ;   scratch for the SP check
0000                LBHDR:    EQU   LET+7Eh   ; CP/M BDOS 10 header: max, count
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FEh   ; empty data stack
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is the start of the .COM file, and 0108h-0133h is also copied to
0000                             ;  page zero (see the header).
0000                             ; =============================================================================
0000                          .ORG   BASE   
0000                          IF   1-EDGEN   
0000   31 FE 81               LD   SP,DSTOP   ; 00  reset, or the start of the .COM file
0003                          ENDIF      
0003                          IF   (1-CPM)*(1-EDITOR)   
0003   01 00 83               LD   BC,PROG   ; 03  the IP
0006   18 64                  JR   st0   ; 06  (the rest of the startup is close by)
0008                          ENDIF      
0008                          IF   EDGEN   
                              XOR   A   ; 00  reset: no program yet
                              LD   (PROG),A   
0008                          ENDIF      
0008                          IF   EDGEN*(1-CHECKED)   
                              JP   edit   ; 04
0008                          ENDIF      
0008                          IF   EDGEN*CHECKED   
                              JP   init   ; 04  (and no key held back)
0008                          ENDIF      
0008                          IF   EDGEN   
                              NOP      ; 07  spare
0008                          ENDIF      
0008                          IF   CPM   
                              JP   start   ; 03
                              DW   0   ; 06  spare
0008                          ENDIF      
0008                VECS:        
0008                             ; ---- RST 08h: rpop: pop the return stack into DE ---------------------------
0008   D9           RPOP:     EXX      ; 08
0009   5E                     LD   E,(HL)   
000A   23                     INC   HL   
000B   56                     LD   D,(HL)   
000C   23                     INC   HL   
000D   D5                     PUSH   DE   ; across to the main registers
000E   D9                     EXX      
000F   D1                     POP   DE   
0010   C9                     RET      ; 10  (so RST 10h is not used)
0011                             ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
0011   C6 21        CTL:      ADD   A,21h   ; 11  back to c; zero only for NUL
0013   20 1C                  JR   NZ,next0   ;     the rest are ignored
0015   C3 09 FF     ENDPROG:   JP   EXIT   ;     the program has ended
0018                             ; ---- RST 18h: drop TOS, then next ------------------------------------------
0018   D1           RST18:    POP   DE   ; 18  discard the RST's return address
0019   E1                     POP   HL   ;     new TOS = NOS
001A   18 15                  JR   nx   
001C   E5           H_FROMR:   PUSH   HL   ; 1C  "}" return stack to TOS
001D   CF                     RST   08h   
001E   EB                     EX   DE,HL   
001F   F7                     RST   30h   
0020                             ; ---- RST 20h: neg16: HL = -HL (keeps BC, DE) -------------------------------
0020   AF           NEG16:    XOR   A   ; 20
0021   95                     SUB   L   
0022   6F                     LD   L,A   
0023   9F                     SBC   A,A   
0024   94                     SUB   H   
0025   67                     LD   H,A   
0026   C9                     RET      
0027   00                     NOP      ; 27  spare
0028                             ; ---- RST 28h: putc: print A (keeps BC, DE, HL, HL') ------------------------
0028                RST28:       
0028                          IFN   CPM   
0028   C3 03 FF     PUTC:     JP   CONOUT   ; 28
002B                          ENDIF      
002B                          IF   CPM   
                              JP   putc   ; 28
002B                          ENDIF      
002B   E9           JPHL:     JP   (HL)   ; 2B  (for the machine-code call)
002C   E3           H_TOR:    EX   (SP),HL   ; 2C  "{" TOS to the return stack: the new TOS
002D   C3 BE 00               JP   rpushn   ;     comes up, the old one goes across
0030                             ; ---- RST 30h: next character -----------------------------------------------
0030   D1           RST30:    POP   DE   ; 30  discard the RST's return address
0031                NX:          
0031                          IF   CPM   
                              JP   next0   ; (this copy runs in page zero)
0031                          ENDIF      
0031                VECEND:      
0031                             ; =============================================================================
0031                             ;  The inner loop: read one character and sort it by range.
0031                             ; 
0031                             ;    00h          end of program
0031                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0031                             ;    30h-39h      digit: read a whole number
0031                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0031                             ;    61h-7Ah      a-z: push the address of that letter's cell
0031                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0031                             ; =============================================================================
0031                NEXT0:       
0031                          IF   CHECKED   
                              CALL   chkstk   ; both stacks are checked once per character
0031                          ENDIF      
0031   0A                     LD   A,(BC)   
0032   03                     INC   BC   
0033   D6 21                  SUB   21h   ; A = c - 21h
0035   38 DA                  JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
0037   FE 0F                  CP   0Fh   
0039   38 22                  JR   C,punct   ; 21h-2Fh: PTAB index 0-14
003B   D6 0F                  SUB   0Fh   ; A = c - 30h
003D   FE 0A                  CP   0Ah   
003F   38 67                  JR   C,digit   ; 30h-39h
0041   FE 11                  CP   11h   
0043   38 16                  JR   C,p3a   ; 3Ah-40h
0045   D6 11                  SUB   11h   ; A = c - 41h
0047   FE 1A                  CP   1Ah   
0049   38 69                  JR   C,upper   ; 41h-5Ah: A = letter index 0-25
004B   FE 20                  CP   20h   
004D   38 0A                  JR   C,p5b   ; 5Bh-60h
004F   FE 3A                  CP   3Ah   
0051   38 5B                  JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0053   FE 3E                  CP   3Eh   
0055   30 DA                  JR   NC,next0   ; 7Fh-FFh: ignored
0057   D6 1A                  SUB   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
0059   D6 09        P5B:      SUB   9   ; 5Bh-60h: -4 in all, index 22-27
005B   C6 05        P3A:      ADD   A,5   ; 3Ah-40h: index 15-21
005D                .macro PTABLE,
005D                             ; 
005D                 DB      h_store & 0FFh  ; !
005D                 DB      h_str & 0FFh    ; "
005D                 DB      h_num & 0FFh    ; #
005D                 DB      h_print & 0FFh  ; $
005D                 DB      h_swap & 0FFh   ; %
005D                 DB      h_and & 0FFh    ; &
005D                 DB      h_emit & 0FFh   ; '
005D                 DB      h_open & 0FFh   ; (
005D                 DB      h_close & 0FFh  ; )
005D                 DB      h_mul & 0FFh    ; *
005D                 DB      h_add & 0FFh    ; +
005D                 DB      h_cfetch & 0FFh ; ,
005D                 DB      h_sub & 0FFh    ; -
005D                 DB      h_cstore & 0FFh ; .
005D                 DB      h_div & 0FFh    ; /
005D                 DB      h_dup & 0FFh    ; :
005D                 DB      h_drop & 0FFh   ; ;
005D                 DB      h_lt & 0FFh     ; <
005D                 DB      h_eq & 0FFh     ; =
005D                 DB      h_gt & 0FFh     ; >
005D                 DB      h_key & 0FFh    ; ?
005D                 DB      h_fetch & 0FFh  ; @
005D                 DB      h_def & 0FFh    ; [
005D                 DB      h_break & 0FFh  ; \
005D                 DB      h_ret & 0FFh    ; ]
005D                 DB      h_xor & 0FFh    ; ^
005D                 DB      h_alloc & 0FFh  ; _
005D                 DB      h_grave & 0FFh  ; `
005D                 DB      h_tor & 0FFh    ; {
005D                 DB      h_or & 0FFh     ; |
005D                 DB      h_fromr & 0FFh  ; }
005D                 DB      h_not & 0FFh    ; ~
005D                .endm
005D                 
005D                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
005D                             ; untouched, and A, DE free.
005D   C6 96        PUNCT:    ADD   A,PTAB & 0FFh   ; PTAB never crosses a page
005F   5F                     LD   E,A   
0060   16 02                  LD   D,PTAB / 256   ; (0 if the table is in page zero)
0062   FE AC                  CP   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
0064   1A                     LD   A,(DE)   
0065   5F                     LD   E,A   ; the handler's low byte
0066                          IF   (1-CPM)*(1-TABP0)   
0066   16 00                  LD   D,0   
0068                          ENDIF      
0068                          IFN   CPM   
0068   CB 12                  RL   D   ; its page: 0 + carry
006A                          ENDIF      
006A                          IF   CPM   
                              LD   D,1   
                              JR   NC,pu1   
                              INC   D   ; its page: 1 + carry
                    PU1:         
006A                          ENDIF      
006A   D5                     PUSH   DE   ; jump to it; the stack is balanced again
006B   C9                     RET      ;   when the handler starts
006C                             ; The rest of the startup: here so that the generic reset code can reach it
006C                             ; with JR. st0: find the program's NUL; the heap starts after it.
006C                             ; (The editor build has its own copy of this, next to the editor.)
006C                          IF   (1-CPM)*(1-EDITOR)   
006C   60           ST0:      LD   H,B   
006D   69                     LD   L,C   
006E   AF                     XOR   A   
006F   BE           ST1:      CP   (HL)   
0070   23                     INC   HL   
0071   20 FC                  JR   NZ,st1   
0073                          ENDIF      
0073                          IF   1-EDITOR   
0073   22 7C 82     ST2:      LD   (HEAP),HL   
0076   D9                     EXX      
0077   21 E0 80               LD   HL,RSTOP   ; the return stack is empty
007A   D9                     EXX      
007B                          ENDIF      
007B                          IF   CHECKED*(1-EDITOR)   
                              XOR   A   
                              LD   (KEYBUF),A   ; no key held back
007B                          ENDIF      
007B                          IF   1-EDITOR   
007B   F7                     RST   30h   ; (its return address is thrown away)
007C                          ENDIF      
007C                             ; In the unchecked generic editor build the table is here, in the first
007C                             ; page, which saves loading D twice. (The other builds have no room for it
007C                             ; here: theirs is further down.)
007C                          IF   TABP0   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
007C                          ENDIF      
007C                             ; =============================================================================
007C                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
007C                             ;  (00bbIGFuZCA= are up among the RST routines.) The machine-code call, exec,
007C                             ;  is here too: it belongs to "`" and makes the page come out right.
007C                             ; =============================================================================
007C   D1           H_XOR:    POP   DE   
007D   7C                     LD   A,H   
007E   AA                     XOR   D   
007F   67                     LD   H,A   
0080   7D                     LD   A,L   
0081   AB                     XOR   E   
0082   6F                     LD   L,A   
0083   F7                     RST   30h   
0084   D1           H_OR:     POP   DE   
0085   7C                     LD   A,H   
0086   B2                     OR   D   
0087   67                     LD   H,A   
0088   7D                     LD   A,L   
0089   B3                     OR   E   
008A   6F                     LD   L,A   
008B   F7                     RST   30h   
008C   E7           H_NOT:    RST   20h   ; ~x = -x - 1
008D   2B                     DEC   HL   
008E   F7                     RST   30h   
008F                             ; "_" ( n -- addr ): the heap pointer moves up by n; TOS is the old pointer.
008F   ED 5B 7C 82  H_ALLOC:   LD   DE,(HEAP)   
0093   19                     ADD   HL,DE   ; the new top
0094                          IF   CHECKED   
                              CALL   chkhp   
0094                          ENDIF      
0094   22 7C 82               LD   (HEAP),HL   
0097   EB                     EX   DE,HL   
0098   F7                     RST   30h   
0099   D9           EXEC:     EXX      
009A   22 34 82               LD   (RSAVE),HL   ; machine code may change the alternates
009D   D9                     EXX      
009E   CD 2B 00               CALL   jphl   
00A1   D9                     EXX      
00A2   2A 34 82               LD   HL,(RSAVE)   
00A5   D9                     EXX      
00A6   E1                     POP   HL   
00A7   F7                     RST   30h   
00A8                             ; ---- the letters and digits (here, in the middle, so that the inner loop's
00A8                             ; ---- short jumps reach them, and the handlers after them reach rpushn) ------
00A8                             ; Digits: step back onto the first digit and read the whole number.
00A8   E5           DIGIT:    PUSH   HL   
00A9   0B                     DEC   BC   
00AA   CD 2F 02               CALL   rdnum   
00AD   F7                     RST   30h   
00AE                             ; a-z: push the cell's address (the cell is the variable)
00AE   E5           LOWER:    PUSH   HL   
00AF   87                     ADD   A,A   
00B0   6F                     LD   L,A   
00B1   26 82                  LD   H,LETPAGE   
00B3   F7                     RST   30h   
00B4                             ; A-Z: call the word. The return address (the IP after the letter) goes on
00B4                             ; the return stack, and the IP becomes the address in the letter's cell.
00B4   C5           UPPER:    PUSH   BC   ; the return address, for rpushn
00B5   EB                     EX   DE,HL   ; park TOS
00B6   87                     ADD   A,A   
00B7   6F                     LD   L,A   
00B8   26 82                  LD   H,LETPAGE   ; HL -> cell
00BA   4E                     LD   C,(HL)   
00BB   2C                     INC   L   
00BC   46                     LD   B,(HL)   ; IP = the word's body
00BD   EB                     EX   DE,HL   ; TOS back, and fall into rpushn
00BE                             ; rpushn: move the top cell of the data stack (in memory) to the return
00BE                             ; stack, then next. Everything that pushes the return stack ends here.
00BE                RPUSHN:      
00BE                          IF   CHECKED   
                              CALL   chkbrk   ; Ctrl-C is checked at every word call, block
00BE                          ENDIF      ;   entry, loop-back and "{"
00BE   D9                     EXX      
00BF   D1                     POP   DE   
00C0   2B                     DEC   HL   
00C1   72                     LD   (HL),D   
00C2   2B                     DEC   HL   
00C3   73                     LD   (HL),E   
00C4   D9                     EXX      
00C5   F7                     RST   30h   
00C6                             ; ---- machine code: the grave -----------------------------------------------
00C6                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
00C6                             ; are stored from addr until a non-hex character; then a RET (C9h) is
00C6                             ; written and its address is left. An odd last digit is consumed and dropped.
00C6                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
00C6                             ; code is entered by CALL with the data stack above the return address; it
00C6                             ; must keep BC, and on return the top cell becomes the new TOS.
00C6   CD 84 02     H_GRAVE:   CALL   hexc   
00C9   30 CE                  JR   NC,exec   
00CB                HX1:         
00CB                          IF   CHECKED   
                              CALL   chkst   
00CB                          ENDIF      
00CB   77                     LD   (HL),A   ; the high digit goes in first ...
00CC   CD 84 02               CALL   hexc   
00CF   30 08                  JR   NC,hx2   ; odd digit: consumed, and the RET below
00D1   ED 6F                  RLD      ;   overwrites it
00D3   23                     INC   HL   ; ... and RLD shifts it up under the low one
00D4   CD 84 02               CALL   hexc   
00D7   38 F2                  JR   C,hx1   
00D9                HX2:         
00D9                          IF   CHECKED   
                              CALL   chkst   
00D9                          ENDIF      
00D9   36 C9                  LD   (HL),0C9h   
00DB   F7                     RST   30h   
00DC                             ; ---- where the two pages meet ----------------------------------------------
00DC                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
00DC                             ; are in falling code order for this), and where exactly differs between the
00DC                             ; builds: NPG1 follows. Every handler below these four must start in the
00DC                             ; second page, and every one above in the first; chktab.py checks both.
00DC                             ; "]" returns: pop an address and jump to it.
00DC   CF           H_RET:    RST   08h   
00DD   42                     LD   B,D   
00DE   4B                     LD   C,E   
00DF   F7           BRK1:     RST   30h   
00E0                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
00E0                             ; drops the block start, "]" returns. No closer at all ends the program.
00E0   7C           H_BREAK:   LD   A,H   
00E1   B5                     OR   L   
00E2   E1                     POP   HL   
00E3   28 FA                  JR   Z,brk1   
00E5   CD 51 02               CALL   skip   
00E8   B7                     OR   A   ; skip returns 0 for ")"
00E9   20 F1                  JR   NZ,h_ret   
00EB   CF           RDROP:    RST   08h   
00EC   F7                     RST   30h   
00ED                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
00ED                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
00ED                             ; the body"s address instead. Either way it then skips to the matching "]'.
00ED                             ; (The unchecked build takes anything that is not a letter as the space; the
00ED                             ; checked build stops on it.)
00ED   0A           H_DEF:    LD   A,(BC)   
00EE   03                     INC   BC   
00EF   D6 41                  SUB   "A"   ; a letter gives 0-25 or 32-57: lowercase
00F1   5F                     LD   E,A   ;   lands 64 bytes up
00F2   E6 DF                  AND   0DFh   ; fold case
00F4   FE 1A                  CP   26   
00F6   30 0B                  JR   NC,def2   ; not a letter
00F8   CB 23                  SLA   E   
00FA   16 82                  LD   D,LETPAGE   ; DE -> cell
00FC   79                     LD   A,C   
00FD   12                     LD   (DE),A   
00FE   1C                     INC   E   
00FF   78                     LD   A,B   
0100   12                     LD   (DE),A   
0101   18 03                  JR   skipnx   
0103                DEF2:        
0103                          IF   CHECKED   
                              LD   A,E   
                              CP   " "-"A"+256   
                              JP   NZ,e_brack   ; anything but a letter or a space
0103                          ENDIF      
0103   E5                     PUSH   HL   ; an anonymous block: push its address
0104   60                     LD   H,B   
0105   69                     LD   L,C   
0106   CD 51 02     SKIPNX:   CALL   skip   
0109   F7                     RST   30h   
010A   5E           H_FETCH:   LD   E,(HL)   ; "@"
010B   23                     INC   HL   
010C   56                     LD   D,(HL)   
010D   EB                     EX   DE,HL   
010E   F7                     RST   30h   
010F                             ; =============================================================================
010F                             ;  Handlers that must start in the image's second page.
010F                             ;  "?" is the last (with "," inside it), so its long tail may run past that
010F                             ;  page.
010F                             ; =============================================================================
010F                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
010F                             ; the matching ")".
010F   7C           H_OPEN:   LD   A,H   
0110   B5                     OR   L   
0111   E1                     POP   HL   
0112   28 F2                  JR   Z,skipnx   
0114   C5                     PUSH   BC   ; the block starts at the IP
0115   18 A7                  JR   rpushn   
0117                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
0117                             ; drops it and carries on.
0117   7C           H_CLOSE:   LD   A,H   
0118   B5                     OR   L   
0119   E1                     POP   HL   
011A   28 CF                  JR   Z,rdrop   
011C   CF                     RST   08h   ; pop the block start ...
011D   42                     LD   B,D   
011E   4B                     LD   C,E   
011F   C5                     PUSH   BC   
0120   18 9C                  JR   rpushn   ; ... and push it back
0122                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
0122                             ; "-" has two jobs: directly before a digit it starts a negative number.
0122   0A           H_SUB:    LD   A,(BC)   
0123   D6 30                  SUB   "0"   
0125   FE 0A                  CP   10   
0127   38 04                  JR   C,negnum   
0129   E7                     RST   20h   ; a - b = a + (-b): fall into "+"
012A   D1           H_ADD:    POP   DE   
012B   19                     ADD   HL,DE   
012C   F7                     RST   30h   
012D   E5           NEGNUM:   PUSH   HL   ; a negative number: read it, negate it
012E   CD 2F 02               CALL   rdnum   
0131   E7                     RST   20h   
0132   F7                     RST   30h   
0133   D1           H_AND:    POP   DE   
0134   7C                     LD   A,H   
0135   A2                     AND   D   
0136   67                     LD   H,A   
0137   7D                     LD   A,L   
0138   A3                     AND   E   
0139   6F                     LD   L,A   
013A   F7                     RST   30h   
013B                             ; Signed compares. Both are "HL < DE" for the right pair: "<" swaps the two
013B                             ; cells first. Flipping both sign bits turns a signed compare into an
013B                             ; unsigned one (and XOR clears the carry for SBC); SBC HL,HL then turns the
013B                             ; carry into -1 or 0 with no branch.
013B   E3           H_LT:     EX   (SP),HL   ; a < b: HL = a, and b is popped next
013C   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
013D   7C                     LD   A,H   
013E   EE 80                  XOR   80h   
0140   67                     LD   H,A   
0141   7A                     LD   A,D   
0142   EE 80                  XOR   80h   
0144   57                     LD   D,A   
0145   ED 52                  SBC   HL,DE   ; carry if HL < DE
0147   ED 62        TF:       SBC   HL,HL   ; carry -> -1 or 0
0149   F7                     RST   30h   
014A   D1           H_EQ:     POP   DE   
014B   B7                     OR   A   
014C   ED 52                  SBC   HL,DE   
014E   7C                     LD   A,H   
014F   B5                     OR   L   
0150   FE 01                  CP   1   ; carry only if a - b = 0
0152   18 F3                  JR   tf   
0154                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept. The
0154                             ; multiplier shifts up through A:C.
0154   D1           H_MUL:    POP   DE   ; DE = multiplicand
0155   C5                     PUSH   BC   
0156   7C                     LD   A,H   
0157   4D                     LD   C,L   ; A:C = multiplier
0158   21 00 00               LD   HL,0   
015B   06 10                  LD   B,16   
015D   29           MUL1:     ADD   HL,HL   
015E   CB 21                  SLA   C   
0160   17                     RLA      
0161   30 01                  JR   NC,mul2   
0163   19                     ADD   HL,DE   
0164   10 F7        MUL2:     DJNZ   mul1   
0166   C1                     POP   BC   
0167   F7                     RST   30h   
0168                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
0168                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
0168                             ; of a. Dividing by zero is not checked: it returns two cells of no meaning.
0168   D1           H_DIV:    POP   DE   ; DE = a, HL = b
0169   C5                     PUSH   BC   ; free BC for udiv
016A   D5                     PUSH   DE   ; a, for r's sign
016B   7A                     LD   A,D   
016C   AC                     XOR   H   
016D   F5                     PUSH   AF   ; S flag = sign of q
016E   CB 7C                  BIT   7,H   
0170   C4 20 00               CALL   NZ,neg16   ; HL = |b|
0173   EB                     EX   DE,HL   
0174   CB 7C                  BIT   7,H   
0176   C4 20 00               CALL   NZ,neg16   ; HL = |a|, DE = |b|
0179   CD 09 02               CALL   udiv   ; HL = q, DE = r
017C   F1                     POP   AF   
017D   FC 20 00               CALL   M,neg16   ; q's sign
0180   EB                     EX   DE,HL   ; HL = r, DE = q
0181   F1                     POP   AF   ; A = a's high byte
0182   B7                     OR   A   
0183   FC 20 00               CALL   M,neg16   ; r's sign
0186   C1                     POP   BC   
0187   D5                     PUSH   DE   ; q under r
0188   F7                     RST   30h   
0189                             ; ---- stack and storage -----------------------------------------------------
0189   E5           H_DUP:    PUSH   HL   ; ":"
018A   F7                     RST   30h   
018B   E3           H_SWAP:   EX   (SP),HL   ; "%"
018C   F7                     RST   30h   
018D   D1           H_CSTORE:   POP   DE   ; "." ( c addr -- )
018E                          IF   CHECKED   
                              CALL   chkst   
018E                          ENDIF      
018E   73                     LD   (HL),E   
018F   DF           H_DROP:   RST   18h   ; ";" is this one byte
0190   D1           H_STORE:   POP   DE   ; "!" ( n addr -- )
0191                          IF   CHECKED   
                              INC   HL   ; both bytes must be in the program's space
                              CALL   chkst   
                              DEC   HL   
0191                          ENDIF      
0191   73                     LD   (HL),E   
0192   23                     INC   HL   
0193   72                     LD   (HL),D   
0194   DF                     RST   18h   
0195                             ; ---- console ---------------------------------------------------------------
0195                             ; 22h pushes the address of the text after it and skips the string.
0195   E5           H_STR:    PUSH   HL   
0196   60                     LD   H,B   
0197   69                     LD   L,C   
0198   CD 46 02               CALL   skipstr   
019B   F7                     RST   30h   
019C                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character
019C                             ; clears that character"s bit 6 (/M is CR, /` is space; "/" and ""' have no
019C                             ; bit 6, so // and /" give themselves).
019C   7E           H_PRINT:   LD   A,(HL)   
019D   23                     INC   HL   
019E   FE 22                  CP   22h   
01A0   28 0D                  JR   Z,pr9   
01A2   FE 2F                  CP   "/"   
01A4   20 04                  JR   NZ,pr1   
01A6   7E                     LD   A,(HL)   
01A7   23                     INC   HL   
01A8   E6 BF                  AND   0BFh   
01AA   EF           PR1:      RST   28h   
01AB   18 EF                  JR   h_print   
01AD   7D           H_EMIT:   LD   A,L   ; "'"
01AE   EF                     RST   28h   
01AF   DF           PR9:      RST   18h   
01B0                             ; "#" prints TOS as a signed decimal number, with no space after it.
01B0   CB 7C        H_NUM:    BIT   7,H   
01B2   28 04                  JR   Z,num1   
01B4   3E 2D                  LD   A,"-"   
01B6   EF                     RST   28h   
01B7   E7                     RST   20h   
01B8   C5           NUM1:     PUSH   BC   
01B9   CD 72 02               CALL   pdec   
01BC   C1                     POP   BC   
01BD   DF                     RST   18h   
01BE                             ; "?" ( n -- c ) or ( -n -- addr )
01BE                             ;   n > 0: wait about n ms for a key; 0 if none came
01BE                             ;   n = 0: wait for a key
01BE                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
01BE                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
01BE   CB 7C        H_KEY:    BIT   7,H   
01C0   20 19                  JR   NZ,line   
01C2   1E 28        KT1:      LD   E,MSLOOP   ; one millisecond, roughly
01C4   CD 06 FF     KT2:      CALL   getk   
01C7   20 0E                  JR   NZ,kt3   
01C9   1D                     DEC   E   
01CA   20 F8                  JR   NZ,kt2   
01CC   7C                     LD   A,H   ; 0? never counts down: it waits
01CD   B5                     OR   L   
01CE   28 F2                  JR   Z,kt1   
01D0   2B                     DEC   HL   
01D1   7C                     LD   A,H   
01D2   B5                     OR   L   
01D3   20 ED                  JR   NZ,kt1   ; A = 0 if the time ran out
01D5   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
01D6   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
01D7   6F           KT3:      LD   L,A   
01D8   26 00                  LD   H,0   
01DA   F7                     RST   30h   
01DB                          IF   CPM   
                                 ; CP/M: BDOS 10 does the editing (the spec allows the platform's
                                 ; own line editor). It doesn't store the CR, so it is added here.
                    LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
                              ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
                              SBC   A,A   
                              AND   L   ; (0 for a count that is too big)
                              XOR   127   ; A = the count, 127 at most
01DB                          ENDIF      
01DB                          IF   CPM*EDITOR   
                              CALL   rdline   ; (the editor calls rdline too)
                              LD   L,LINEBUF & 0FFh   
                              RST   30h   
                                 ; rdline: read a line of at most A characters; HL -> the CR that ends it
                    RDLINE:      
01DB                          ENDIF      
01DB                          IF   CPM   
                              LD   (LBHDR),A   
                              LD   DE,LBHDR   
                              LD   A,10   
                              CALL   bdosx   
                              LD   HL,LBHDR+1   
                              LD   A,(HL)   ; the count typed (0-127)
                              INC   L   ; HL = LINEBUF, whose low byte is 80h:
                              ADD   A,L   ;   adding the count to L can't carry
                              LD   L,A   
                              LD   (HL),13   
01DB                          ENDIF      
01DB                          IF   CPM*(1-EDITOR)   
                              LD   L,LINEBUF & 0FFh   
                              RST   30h   
01DB                          ENDIF      
01DB                          IF   CPM*EDITOR   
                              RET      
01DB                          ENDIF      
01DB                          IFN   CPM   
01DB                             ; Generic: Backspace takes the last character back (and is echoed as
01DB                             ; it is), CR ends (stored, not echoed), every other key is stored and
01DB                             ; echoed until the line is full. The line buffer starts at offset 80h
01DB                             ; of its page, so L alone is the place in the line: D holds the L of
01DB                             ; a full line.
01DB                          ENDIF      
01DB                          IFN   CPM   
01DB   11 7F 00     LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
01DE   19                     ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
01DF   9F                     SBC   A,A   
01E0   A5                     AND   L   ; (0 for a count that is too big)
01E1   2F                     CPL      
01E2   57                     LD   D,A   ; D = the L of a full line: 80h + count, FFh
01E3                          ENDIF      ;   at most
01E3                          IF   EDGEN   
                              CALL   rdline   ; (the editor calls rdline too)
                              LD   L,LINEBUF & 0FFh   
                              RST   30h   
                                 ; rdline: read a line that is full when L reaches D; HL -> the CR that ends it
                    RDLINE:      
01E3                          ENDIF      
01E3                          IFN   CPM   
01E3   21 80 82               LD   HL,LINEBUF   
01E6   CD 06 FF     LN2:      CALL   getk   
01E9   28 FB                  JR   Z,ln2   
01EB   FE 0D                  CP   13   
01ED   28 16                  JR   Z,ln5   
01EF   FE 08                  CP   8   
01F1   28 0B                  JR   Z,ln4   
01F3   5F                     LD   E,A   
01F4   7D                     LD   A,L   
01F5   BA                     CP   D   
01F6   28 EE                  JR   Z,ln2   ; full
01F8   73                     LD   (HL),E   
01F9   2C                     INC   L   
01FA   7B                     LD   A,E   
01FB   EF           LN3:      RST   28h   
01FC   18 E8                  JR   ln2   
01FE   2D           LN4:      DEC   L   ; Backspace: one back, and echo it,
01FF   FA FB 01               JP   M,ln3   ;   unless the line was empty (L left the
0202   2C                     INC   L   ;   upper half of the page)
0203   18 E1                  JR   ln2   
0205   77           LN5:      LD   (HL),A   ; the CR
0206                          ENDIF      
0206                          IF   (1-CPM)*(1-EDITOR)   
0206   2E 80                  LD   L,LINEBUF & 0FFh   
0208   F7                     RST   30h   
0209                          ENDIF      
0209                          IF   EDGEN   
                              RET      
0209                          ENDIF      
0209                             ; =============================================================================
0209                             ;  More routines (no handler starts past this point)
0209                             ; =============================================================================
0209                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
0209                             ; Uses A, BC; the caller saves the IP. The dividend shifts up through A:C
0209                             ; while the quotient bits arrive at the bottom of C.
0209                             ; Dividing by 2 is one shift (the spec wants that fast).
0209   7B           UDIV:     LD   A,E   
020A   EE 02                  XOR   2   
020C   B2                     OR   D   
020D   20 07                  JR   NZ,udv0   
020F   CB 3C                  SRL   H   
0211   CB 1D                  RR   L   ; the quotient
0213   8F                     ADC   A,A   
0214   5F                     LD   E,A   ; the remainder: the bit that fell out (D is 0)
0215   C9                     RET      
0216   7C           UDV0:     LD   A,H   
0217   4D                     LD   C,L   
0218   21 00 00               LD   HL,0   
021B   06 10                  LD   B,16   
021D   CB 21        UDV1:     SLA   C   
021F   17                     RLA      
0220   ED 6A                  ADC   HL,HL   
0222   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
0224   30 02                  JR   NC,udv2   ;   always fits in 16 bits
0226   19                     ADD   HL,DE   ; too much: put it back, and cancel the
0227   0D                     DEC   C   ;   INC below
0228   0C           UDV2:     INC   C   ; a quotient bit
0229   10 F2                  DJNZ   udv1   
022B   EB                     EX   DE,HL   ; DE = remainder
022C   67                     LD   H,A   
022D   69                     LD   L,C   ; HL = quotient
022E   C9                     RET      
022F                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
022F                             ; non-digit. Values wrap at 16 bits, as the spec says.
022F   21 00 00     RDNUM:    LD   HL,0   
0232   0A           RDN1:     LD   A,(BC)   
0233   D6 30                  SUB   "0"   
0235   FE 0A                  CP   10   
0237   D0                     RET   NC   
0238   03                     INC   BC   
0239   54                     LD   D,H   
023A   5D                     LD   E,L   
023B   29                     ADD   HL,HL   
023C   29                     ADD   HL,HL   
023D   19                     ADD   HL,DE   
023E   29                     ADD   HL,HL   ; HL * 10
023F   5F                     LD   E,A   
0240   16 00                  LD   D,0   
0242   19                     ADD   HL,DE   
0243   18 ED                  JR   rdn1   
0245                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
0245                             ; the next character, so "/"" does not end it. Leaves A = 22h.
0245   03           SS0:      INC   BC   
0246   0A           SKIPSTR:   LD   A,(BC)   
0247   03                     INC   BC   
0248   FE 2F                  CP   "/"   
024A   28 F9                  JR   Z,ss0   
024C   FE 22                  CP   22h   
024E   20 F6                  JR   NZ,skipstr   
0250   C9                     RET      
0251                             ; skip: read past text to the closer at this level, and return A = 0 if it
0251                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
0251                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
0251                             ; no closer; anything else that runs into the NUL had unbalanced brackets
0251                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
0251                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
0251   16 00        SKIP:     LD   D,0   
0253   14           SK3:      INC   D   ; an opener: one deeper
0254   0A           SK1:      LD   A,(BC)   
0255   03                     INC   BC   
0256   B7                     OR   A   
0257   CA 15 00               JP   Z,endprog   
025A   FE 22                  CP   22h   
025C   CC 46 02               CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
025F   D6 28                  SUB   "("   
0261   28 F0                  JR   Z,sk3   
0263   3D                     DEC   A   ; ")"
0264   28 08                  JR   Z,sk4   
0266   D6 32                  SUB   "["-")"   
0268   28 E9                  JR   Z,sk3   
026A   FE 02                  CP   "]"-"["   
026C   20 E6                  JR   NZ,sk1   
026E   15           SK4:      DEC   D   
026F   C8                     RET   Z   ; the closer at this level
0270   18 E2                  JR   sk1   
0272                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
0272                             ; Uses BC.
0272   11 0A 00     PDEC:     LD   DE,10   
0275   CD 09 02               CALL   udiv   ; HL = HL / 10, E = the last digit
0278   7B                     LD   A,E   
0279   F5                     PUSH   AF   
027A   7C                     LD   A,H   
027B   B5                     OR   L   
027C   C4 72 02               CALL   NZ,pdec   
027F   F1                     POP   AF   
0280   C6 30                  ADD   A,"0"   
0282   EF                     RST   28h   
0283   C9                     RET      
0284                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
0284                             ; and return its value in A with the carry set; otherwise leave the IP and
0284                             ; return with the carry clear.
0284   0A           HEXC:     LD   A,(BC)   
0285   D6 30                  SUB   "0"   
0287   FE 0A                  CP   10   
0289   38 09                  JR   C,hc1   
028B   E6 DF                  AND   0DFh   
028D   D6 11                  SUB   11h   
028F   FE 06                  CP   6   
0291   D0                     RET   NC   
0292   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
0294   03           HC1:      INC   BC   
0295   C9                     RET      
0296                             ; =============================================================================
0296                             ;  Dispatch table: the low byte of each handler's address, in code order
0296                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
0296                             ;  It must not cross a page (the dispatcher only adds to its low byte).
0296                             ; =============================================================================
0296                             ; The handlers of the first NPG1 characters start in the image's second page.
0296                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
0296                             ; differs between the builds, so the count is worked out here.
0296                             ; (One division to a line: asm80 only rounds down when it stores a value.)
0296                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
0296                PGBRK:    EQU   (h_break-BASE)/256   
0296                PGDEF:    EQU   (h_def-BASE)/256   
0296                PGFET:    EQU   (h_fetch-BASE)/256   
0296                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
0296                          IF   1-TABP0   
0296                PTAB:        
0296                          ;*Macro unroll:  PTABLE
0296   90                     DB   h_store & 0FFh   
0297   95                     DB   h_str & 0FFh   
0298   B0                     DB   h_num & 0FFh   
0299   9C                     DB   h_print & 0FFh   
029A   8B                     DB   h_swap & 0FFh   
029B   33                     DB   h_and & 0FFh   
029C   AD                     DB   h_emit & 0FFh   
029D   0F                     DB   h_open & 0FFh   
029E   17                     DB   h_close & 0FFh   
029F   54                     DB   h_mul & 0FFh   
02A0   2A                     DB   h_add & 0FFh   
02A1   D6                     DB   h_cfetch & 0FFh   
02A2   22                     DB   h_sub & 0FFh   
02A3   8D                     DB   h_cstore & 0FFh   
02A4   68                     DB   h_div & 0FFh   
02A5   89                     DB   h_dup & 0FFh   
02A6   8F                     DB   h_drop & 0FFh   
02A7   3B                     DB   h_lt & 0FFh   
02A8   4A                     DB   h_eq & 0FFh   
02A9   3C                     DB   h_gt & 0FFh   
02AA   BE                     DB   h_key & 0FFh   
02AB   0A                     DB   h_fetch & 0FFh   
02AC   ED                     DB   h_def & 0FFh   
02AD   E0                     DB   h_break & 0FFh   
02AE   DC                     DB   h_ret & 0FFh   
02AF   7C                     DB   h_xor & 0FFh   
02B0   8F                     DB   h_alloc & 0FFh   
02B1   C6                     DB   h_grave & 0FFh   
02B2   2C                     DB   h_tor & 0FFh   
02B3   84                     DB   h_or & 0FFh   
02B4   1C                     DB   h_fromr & 0FFh   
02B5   8C                     DB   h_not & 0FFh   
02B6                PTABEND:      
02B6                          ENDIF      
02B6                             ; =============================================================================
02B6                             ;  Console layer: getk returns a waiting key in A (zero flag clear), or
02B6                             ;  A = 0 with the zero flag set when none is waiting. putc (RST 28h) prints
02B6                             ;  A. Both keep BC, DE, HL and HL". In the generic build they are the host"s
02B6                             ;  KEY and CONOUT routines themselves.
02B6                             ; =============================================================================
02B6                          IF   (1-CPM)*(1-CHECKED)   
02B6                GETK:     EQU   KEY   ; the host's routine does the whole job
02B6                          ENDIF      
02B6                          IF   CHECKED   
                    GETK:     PUSH   HL   ; a key held back by the break check goes
                              LD   HL,KEYBUF   ;   first, and is taken out of the buffer
                              LD   A,(HL)   
                              LD   (HL),0   
                              POP   HL   
                              OR   A   
                              RET   NZ   
02B6                          ENDIF      
02B6                          IF   (1-CPM)*CHECKED   
                              JP   KEY   
02B6                          ENDIF      
02B6                          IF   CPM*(1-CHECKED)   
                    GETK:        
02B6                          ENDIF      
02B6                          IF   CPM   
                              LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
                                 ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
                                 ; printing and could swallow a key that BDOS 6 then never sees.
                    PUTC:     PUSH   DE   
                              PUSH   HL   
                              LD   E,A   
                              LD   A,6   
                              CALL   bdosx   
                              POP   HL   
                              POP   DE   
                              OR   A   ; (for getk)
                              RET      
                                 ; bdosx: call BDOS function A with DE, keeping BC and HL'
                    BDOSX:    PUSH   BC   
                              EXX      
                              PUSH   HL   
                              EXX      
                              LD   C,A   
                              CALL   BDOS   
                              EXX      
                              POP   HL   
                              EXX      
                              POP   BC   
                              RET      
02B6                          ENDIF      
02B6                             ; =============================================================================
02B6                             ;  Checked build: the checks and the error report
02B6                             ; =============================================================================
02B6                          IF   CHECKED   
                                 ; chkstk: both stacks are checked once per character, not in every handler.
                                 ; Each stack lives in one page, so it has overrun exactly when the pointer's
                                 ; high byte has left that page. Errors are caught one cell late at most; the
                                 ; page below each stack is a guard band. (The call itself is on the data
                                 ; stack, but in the same page whenever the stack is in range.)
                    CHKSTK:   LD   (SPTMP),SP   
                              LD   A,(SPTMP+1)   
                              CP   DSPAGE   
                              JR   NZ,e_stack   
                              EXX      ; the return stack: in its page, and not
                              LD   A,L   ;   above its empty position (an underflow
                              CP   RSTOP&0FFh+1   ;   would stay inside the page, in the
                              LD   A,H   ;   guard band)
                              EXX      
                              JR   NC,e_rstack   
                              CP   RSPAGE   
                              RET   Z   
                              JR   e_rstack   
                                 ; chkbrk: a waiting key is read now; Ctrl-C stops the program, anything
                                 ; else is held for the next "?".
                    CHKBRK:   CALL   getk   
                              RET   Z   
                              CP   3   
                              JR   Z,e_break   
                              LD   (KEYBUF),A   
                              RET      
                                 ; chkst: stop unless HL is in the program's own space: from the letter page
                                 ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
                                 ; whatever lies above the limit are safe. Memory above the heap top but
                                 ; below the limit is the program's own: Tiny BASIC keeps its lines there.
                                 ; Keeps every register.
                    CHKST:    PUSH   AF   
                              LD   A,H   
                              CP   LETPAGE   
                              JR   C,e_store   
02B6                          ENDIF      
02B6                          IF   CHECKED*(1-CPM)   
                              CP   HEAPLIM   
                              JR   NC,e_store   
02B6                          ENDIF      
02B6                          IF   CHECKED*CPM   
                              LD   A,(0007h)   ; the BDOS page is the heap limit
                              DEC   A   
                              CP   H   
                              JR   C,e_store   
02B6                          ENDIF      
02B6                          IF   CHECKED   
                              POP   AF   
                              RET      
                                 ; chkhp: stop if working out the new heap top carried (a negative count
                                 ; wraps: too big), or if the new top in HL is not below the limit page.
                    CHKHP:    JR   C,e_heap   
02B6                          ENDIF      
02B6                          IF   CHECKED*(1-CPM)   
                              LD   A,H   
                              CP   HEAPLIM   
                              RET   C   
02B6                          ENDIF      
02B6                          IF   CHECKED*CPM   
                              LD   A,(0007h)   
                              DEC   A   
                              CP   H   
                              RET   NC   
02B6                          ENDIF      
02B6                          IF   CHECKED   
                                 ; Error entries. Each loads its letter and then hides the next entry inside
                                 ; a 3-byte LD HL,nn (the 21h), so they all fall through to `error`.
                    E_HEAP:   LD   A,"H"   ; heap past the limit
                              DB   21h   
                    E_STORE:   LD   A,"W"   ; write outside the program's space
                              DB   21h   
                    E_STACK:   LD   A,"S"   ; data stack over or under
                              DB   21h   
                    E_RSTACK:   LD   A,"R"   ; return stack over or under
                              DB   21h   
                    E_BREAK:   LD   A,"B"   ; Ctrl-C
                              DB   21h   
                    E_BRACK:   LD   A,"D"   ; bad character after [
                                 ; error: print the letter in A, " @ " and the offset in the program of the
                                 ; character just read, then end. For example: S @ 245
                    ERROR:    LD   SP,DSTOP   ; the stacks may be wrecked: start clean
                              RST   28h   
                              LD   A," "   
                              RST   28h   
                              LD   A,"@"   
                              RST   28h   
                              LD   A," "   
                              RST   28h   
                              LD   HL,(0-PROG-1)&0FFFFh   ; minus the address of the character
                              ADD   HL,BC   ;   just read: HL = its offset
                              CALL   pdec   
                              JP   endprog   
02B6                          ENDIF      
02B6                             ; =============================================================================
02B6                             ;  The line editor (EDITOR = 1)
02B6                             ; 
02B6                             ;  The interpreter starts here, and a program that ends comes back here. Type
02B6                             ;  a line and press Return:
02B6                             ; 
02B6                             ;    n text    put the text in as line n; the lines from n on move down.
02B6                             ;              A number past the end, or 0, adds the line at the end.
02B6                             ;    n         take line n out
02B6                             ;    0         run the program
02B6                             ;    -n        list the program from line n on (-1 lists all of it). Any key
02B6                             ;              stops the list until another key is pressed; Ctrl-C ends it.
02B6                             ;    anything else is run at once, as B8Script. (Start such a line with a
02B6                             ;    space if it would begin with a digit or a minus sign.)
02B6                             ; 
02B6                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
02B6                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
02B6                             ;  125 characters, the line number and the one character after it included;
02B6                             ;  that character is not stored. The text is kept as it is typed, each line
02B6                             ;  ending in CR LF, at PROG. Nothing is checked.
02B6                             ; 
02B6                             ;  With CPM = 1 the file named on the command line is the program to start
02B6                             ;  with (no file, or no such file: no program). Lines are read by BDOS 10, so
02B6                             ;  its editing keys work, and Ctrl-C as the first key of a line goes back to
02B6                             ;  CP/M. Nothing is written back: there is no command to save.
02B6                             ; 
02B6                             ;  With CHECKED = 1 a program that is stopped (an error, or Ctrl-C) prints
02B6                             ;  its letter and place and comes back here. The place is counted from the
02B6                             ;  start of the program, so in a line typed here it is 65408 plus the
02B6                             ;  character's place in the line (the line buffer is 128 bytes below the
02B6                             ;  program).
02B6                             ; 
02B6                             ;  Things to know:
02B6                             ;    - Reset empties the program (generic builds).
02B6                             ;    - Words and variables last from one line to the next. A word's address
02B6                             ;      points into the program, so run the program again after editing it.
02B6                             ;    - Nothing is printed between a program's output and what is typed next.
02B6                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
02B6                             ;      a line that calls -n? and carries on afterwards runs what was typed.
02B6                             ;      (The stored program never comes back to the line, so it may.)
02B6                             ; =============================================================================
02B6                          IF   EDGEN*CHECKED   
                    INIT:     LD   (KEYBUF),A   ; (A = 0) reset: no key held back
                              JR   edit   
02B6                          ENDIF      
02B6                          IF   EDITOR   
                                 ; -n: list from line n. DE = the number of the line at HL.
                    LIST:     INC   BC   
                              CALL   rdnum   ; HL = n
                              PUSH   HL   
                              CALL   find   
                              POP   DE   
                    LI1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,edit   ; the end of the text
                              CALL   getk   
                              JR   Z,li3   ; no key: carry on
                              CP   3   
                              JR   Z,edit   ; Ctrl-C
                    LI2:      CALL   getk   ; any other key: wait for one more
                              JR   Z,li2   
                              CP   3   
                              JR   Z,edit   
                    LI3:      PUSH   HL   
                              PUSH   DE   
                              EX   DE,HL   
                              CALL   pdec   ; the line's number,
                              LD   A," "   
                              RST   28h   ;   a space,
                              POP   DE   
                              POP   HL   
                              INC   DE   
                              CALL   prl   ;   and the line
                              JR   li1   
                                 ; Take line n (in HL) out: copy everything after it down over it.
                    DEL:      CALL   find   
                              LD   D,H   
                              LD   E,L   
                              CALL   nxl   ; HL -> the next line
                    DE1:      LD   A,(HL)   
                              LD   (DE),A   
                              INC   HL   
                              INC   DE   
                              OR   A   
                              JR   NZ,de1   ; and fall into the editor
                    EDIT:     LD   SP,DSTOP   
02B6                          ENDIF      
02B6                          IF   EDITOR*CPM*CHECKED   
                                 ; A key that the break check held back while a program ran is let
                                 ; go: BDOS 10 would not see it, and it would turn up in the next
                                 ; program that asked for a key. (This also serves at the start.)
                              XOR   A   
                              LD   (KEYBUF),A   
02B6                          ENDIF      
02B6                          IF   EDGEN   
                              LD   D,0FDh   ; 125 characters at most
02B6                          ENDIF      
02B6                          IF   EDITOR*CPM   
                              LD   A,125   
02B6                          ENDIF      
02B6                          IF   EDITOR   
                              CALL   rdline   ; HL -> the CR that ended the line
                              INC   L   
                              LD   (HL),10   ; a LF after it,
                              DEC   L   
                              CALL   prl   ; (print the CR LF: a new line)
                              LD   (HL),0   ;   and a NUL after that
                              PUSH   HL   ; the end of what was typed
                              LD   BC,LINEBUF   
                              LD   A,(BC)   
                              CP   "-"   
                              JR   Z,list   
                              CALL   rdnum   ; HL = the number it starts with, BC -> after
                              LD   A,C   ; C is still 80h if there was no number:
                              ADD   A,A   ;   only then is twice it 0
                              JR   Z,st0   ; no number: run the line where it is
                              LD   A,(BC)   
                              SUB   13   
                              JR   NZ,ins   ; text follows the number
                              OR   H   ; the number alone:
                              OR   L   
                              JR   NZ,del   ;   not 0: take that line out
                              LD   BC,PROG   ;   0: run the program
                                 ; st0: start running at BC. The heap starts after the stored program's NUL.
                    ST0:      POP   HL   ; (the end of what was typed: the stack is empty)
                              LD   HL,PROG   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
                              LD   (HEAP),HL   
                              EXX      
                              LD   HL,RSTOP   ; the return stack is empty
                              EXX      
                              RST   30h   ; (its return address is thrown away)
                                 ; Put the typed text in as line n (in HL): open a gap of its length there,
                                 ; CR and LF included, and copy it in.
                    INS:      CALL   find   ; HL -> where it goes
                              INC   BC   ; step over the one character after the number
                              POP   DE   ; the end of what was typed
                              LD   A,E   
                              SUB   C   ; A = the length of the text, with its CR LF
                              PUSH   BC   ; the text
                              LD   C,A   
                              LD   B,0   
                              PUSH   BC   ; its length
                              LD   D,H   
                              LD   E,L   ; DE = where it goes
                              XOR   A   
                              LD   C,A   ; BC = 0: CPIR looks as far as it needs to
                              CPIR      ; HL -> one past the program's NUL
                              SBC   HL,DE   ; the number of bytes to move up, NUL included
                              LD   B,H   
                              LD   C,L   
                              ADD   HL,DE   
                              DEC   HL   ; HL -> the NUL
                              EX   DE,HL   
                              EX   (SP),HL   ; HL = the length; where it goes is kept
                              PUSH   HL   
                              ADD   HL,DE   ; the NUL's new place
                              EX   DE,HL   
                              LDDR      ; move the rest of the program up
                              POP   BC   ; the length
                              POP   DE   ; where it goes
                              POP   HL   ; the text
                              LDIR      
                              JR   edit   
                                 ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
                                 ; of the text if there are fewer lines (or the number is 0). Keeps BC.
                    FIND:     EX   DE,HL   
                              LD   HL,PROG   
                    FI1:      DEC   DE   
                              LD   A,D   
                              OR   E   
                              RET   Z   
                              CALL   nxl   
                              JR   NZ,fi1   
                              RET      
                                 ; nxl: step HL over one line, to just past its LF (and return not-zero), or
                                 ; stop at the NUL that ends the text (and return zero).
                    NXL:      LD   A,(HL)   
                              OR   A   
                              RET   Z   
                              INC   HL   
                              CP   10   
                              JR   NZ,nxl   
                              OR   A   
                              RET      
                                 ; prl: print the line at HL, to its LF; HL -> just past it.
                    PRL:      LD   A,(HL)   
                              RST   28h   
                              LD   A,(HL)   
                              INC   HL   
                              CP   10   
                              JR   NZ,prl   
                              RET      
02B6                          ENDIF      
02B6                             ; =============================================================================
02B6                             ;  CP/M startup (the generic build starts at address 0: see st0)
02B6                             ; =============================================================================
02B6                          IF   CPM   
                                 ; The RAM pages follow the image; the heap may grow to the BDOS.
                    START:    LD   HL,vecs   ; the RST routines go down into page zero
                              LD   DE,0008h   
                              LD   BC,vecend-vecs   
                              LDIR      
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:         
02B6                          ENDIF      
02B6                          IF   CPM*(1-EDITOR)   
                              LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
                              JP   st2   
02B6                          ENDIF      
02B6                          IF   CPM*EDITOR   
                                 ; The editor wants the text to end where the file's text ends: at
                                 ; the first ^Z (1Ah), which pads a text file's last record. One more
                                 ; goes after the last record, so the search always stops. And every
                                 ; line must end in LF: a last line without one is given a CR LF.
                              LD   (HL),1Ah   
                              LD   HL,PROG-1   
                              LD   A,10   ; (a file with no text needs nothing added)
                    TR1:      INC   HL   
                              LD   E,A   ; E = the character before this one
                              LD   A,(HL)   
                              CP   1Ah   
                              JR   NZ,tr1   
                              LD   A,E   
                              CP   10   
                              JR   Z,tr2   
                              LD   (HL),13   
                              INC   HL   
                              LD   (HL),10   
                              INC   HL   
                    TR2:      LD   (HL),0   
                              JP   edit   
02B6                          ENDIF      
02B6                          IF   CPM   
                                 ; RAM pages, after the image
                    RSPAGE:   EQU   (imgend + 255) / 256   
                    DSPAGE:   EQU   RSPAGE + 1   
                    LETPAGE:   EQU   RSPAGE + 2   
                    PROG:     EQU   LETPAGE*256 + 256   
02B6                          ENDIF      
02B6                IMGEND:      


