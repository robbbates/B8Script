                    UW14:        
                    UV15:     DAD   H   
                              MOV   A,C   
                              RAL      
                              MOV   C,A   
                              MOV   A,B   
                              RAL      
                              MOV   B,A   ; BC = BC*2 + bit
                              MOV   A,C   
                              SUB   E   
                              MOV   A,B   
                              SBB   D   ; carry if BC < DE
                              JC   uw15   
