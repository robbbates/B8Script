0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Intel 8080
0000                             ;  Spec: docs/b8script.md (2026-11-24).
0000                             ;  Design follows the Z80 interpreter (z80/b8s-z80.asm), with 8080 opcodes
0000                             ;  only.
0000                             ; 
0000                             ;  Three switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    CHECKED  0 = no checks (spec: the programmer is responsible)
0000                             ;             1 = starts with every variable at 0 and every word undefined,
0000                             ;                 and stops on every error in the spec's table (and Ctrl-C)
0000                             ;                 with a four-line report: the letter and the place as line
0000                             ;                 and column, the text there, and both stacks. See `error`.
0000                             ;    ANSI     what the console escapes of "$" (/00bbIC8= /| /` /~) do:
0000                             ;             1 = send ANSI (VT100) sequences through CONOUT
0000                             ;             0 = call the machine's own routines CONCLS, CONEOL, CONCUR and
0000                             ;                 CONAT (see the equates). The CP/M builds always send ANSI.
0000                             ; 
0000                             ;  In every build Ctrl-C stops a running program (an unchecked build stops
0000                             ;  without a word): see the console layer for the rules, the held key and
0000                             ;  the break-off cell.
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), I8080 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   1   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   0   ; 1 = checked build
0000                ANSI:     EQU   0   ; 1 = the console escapes send ANSI sequences
0000                ANS:      EQU   ANSI+CPM-ANSI*CPM   ; (CP/M: always ANSI)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the 8080"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  The return stack pointer has no register (the 8080 has no spare pair): it
0000                             ;  is the RAM word RSP. Only rpop, rpushd and ")" (and the checks) touch it.
0000                             ; 
0000                             ;  One-byte calls. The routines used most are reached with RST, one byte
0000                             ;  instead of three. (asm80 wants the vector number: RST 1 = RST 08h.)
0000                             ; 
0000                             ;    RST 1  08h  rpop    pop the return stack into HL
0000                             ;    RST 3  18h  drop    drop TOS, then next character     (ends a handler)
0000                             ;    RST 4  20h  neg16   HL = -HL
0000                             ;    RST 5  28h  putc    print A
0000                             ;    RST 6  30h  next    next character                    (ends a handler)
0000                             ; 
0000                             ;  RST 3 and RST 6 never return: an RST is a CALL, so the first thing each
0000                             ;  of them does is POP D to throw the return address away.
0000                             ; 
0000                             ;  The CP/M build can't own page zero, so the block from `vecs` to `vecend`
0000                             ;  (image addresses 0108h-0133h) is copied to 0008h-0033h when it starts. The
0000                             ;  code in that block has no jumps inside itself, so it works at either place.
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; 
0000                             ;  What the 8080 lacks, and what replaces it: no JR (JMP/Jcc), no DJNZ, no
0000                             ;  SBC HL (byte-wise SUB/SBB, or negate and DAD), no shifts on register pairs
0000                             ;  (DAD H doubles; RAL/RAR through A), no LDIR/CPIR (small loops).
0000                             ; -----------------------------------------------------------------------------
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (the top four bytes of the page are spare,
0000                             ;             so a full stack runs two bytes into the page below)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch, interpreter variables in the gaps, and the -n? line buffer
0000                             ;             at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack has a guard band: the data stack can
0000                             ;  overrun by a cell or two (and the calls made while it is full, the error
0000                             ;  report's included) into the top 32 bytes of the return-stack page, which
0000                             ;  are never used, and the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
0000                BDOS:     EQU   0005h   
0000                EXIT:     EQU   0000h   ; warm boot
0000                BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IFN   CPM   
                                 ; ---- generic machine: edit these to suit -----------------------------------
                    KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
                                 ;   waiting. The zero flag must match A
                                 ;   (end the routine with ORA A / RET).
                    CONOUT:   EQU   0FF03h   ; print the character in A
                    EXIT:     EQU   0FF09h   ; where to go when the program ends
                                 ;   KEY and CONOUT must preserve BC, DE and HL.
0000                          ENDIF      
0000                          IF   1-ANS   
                                 ; With ANSI = 0 the console escapes call these. All four must keep BC;
                                 ; CONCLS, CONEOL and CONCUR also DE and HL.
                    CONCLS:   EQU   0FF0Ch   ; /{  clear the screen, the cursor to the top left
                    CONEOL:   EQU   0FF0Fh   ; /}  clear from the cursor to the end of the line
                    CONCUR:   EQU   0FF12h   ; /| and /`  show the cursor if A is not 0, hide
                                 ;     it if A = 0
                    CONAT:    EQU   0FF15h   ; /~  the cursor to row HL, column DE, both
                                 ;     counted from 0. May change A, DE and HL
0000                          ENDIF      
0000                          IFN   CPM   
                    RSPAGE:   EQU   80h   ; 8000h return stack
                    DSPAGE:   EQU   81h   ; 8100h data stack
                    LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
                    PROG:     EQU   8300h   ; where the loader puts the program text
                    HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
                    BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms (1-255;
0000                             ; the wait for a second Ctrl-C uses it too):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer
0000                RSP:      EQU   LET+34h   ; gap after Z: the return stack pointer;
0000                BRKCNT:   EQU   LET+36h   ;   the break check's countdown;
0000                NPEND:    EQU   LET+38h   ;   minus the address of the program's end
0000                             ;   (the heap"s first byte), for the checked "_';
0000                PSAVE:    EQU   LET+3Ah   ;   the checked build: the address "$" prints
0000                             ;   from, for a report
0000                KEYBUF:   EQU   LET+7Ah   ; gap after z: a key read by the break check and
0000                             ;   held for the next "?" (0: none);
0000                BRKOFF:   EQU   LET+7Bh   ;   the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FCh   ; empty data stack. The four bytes above it
0000                             ; are spare: a character can pop two cells
0000                             ; too many before the checked build sees it,
0000                             ; and the next call must not land on the
0000                             ; letter cells.
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is the start of the .COM file, and 0108h-0133h is also copied to
0000                             ;  page zero (see the header).
0000                             ; =============================================================================
0100                          .ORG   BASE   
0100                          IF   1-(1-CPM)*CHECKED   
0100   31 FC 07               LXI   SP,DSTOP   ; 00  reset, or the start of the .COM file
0103                          ENDIF      
0103   C3 CA 04               JMP   start   ; In the checked generic build this is at 0000h
0106                             ;   (and `start` sets SP): its first byte, C3h,
0106                             ;   is what an undefined word runs into, as
0106                             ;   CP/M's own JMP at 0000h is in a .COM: e_hi.
0106                          IF   (1-CPM)*CHECKED   
                              DB   0,0,0   ; 03  spare
0106                          ENDIF      
0106   CF           RDROP:    RST   1   ; 06  drop the top of the return stack, then
0107   DF                     RST   3   ;     drop TOS (a spent flag) and go on
0108                VECS:        
0108                             ; ---- RST 1: rpop: pop the return stack into HL (DE is lost) -----------------
0108   2A 34 08     RPOP:     LHLD   RSP   ; 08
010B   5E                     MOV   E,M   
010C   23                     INX   H   
010D   56                     MOV   D,M   
010E   23                     INX   H   
010F   22 34 08               SHLD   RSP   
0112   EB                     XCHG      
0113   C9                     RET      ; 13  (so RST 2 is not used)
0114   EB           H_TOR:    XCHG      ; 14  "{" TOS to the return stack; rpushd
0115   C3 AE 01               JMP   rpushd   ;     brings up the new TOS
0118                             ; ---- RST 3: drop TOS, then next ---------------------------------------------
0118   D1           RST18:    POP   D   ; 18  discard the RST's return address
0119   E1                     POP   H   ;     new TOS = NOS
011A   C3 34 01               JMP   next0   
011D   E5           H_FROMR:   PUSH   H   ; 1D  "}" return stack to TOS
011E   CF                     RST   1   
011F   F7                     RST   6   
0120                             ; ---- RST 4: neg16: HL = -HL (keeps BC, DE) ----------------------------------
0120   AF           NEG16:    XRA   A   ; 20
0121   95                     SUB   L   
0122   6F                     MOV   L,A   
0123   9F                     SBB   A   
0124   94                     SUB   H   
0125   67                     MOV   H,A   
0126   C9                     RET      
0127   E9           JPHL:     PCHL      ; 27  (for the machine-code call)
0128                             ; ---- RST 5: putc: print A (keeps BC, DE, HL) --------------------------------
0128                RST28:       
0128                          IFN   CPM   
                    PUTC:     JMP   CONOUT   ; 28
0128                          ENDIF      
0128                          IF   CPM   
0128   C3 BC 04               JMP   putc   ; 28
012B                          ENDIF      
012B                             ; exec: "`" with no hex digit after it: call the machine code at TOS. It
012B                             ; returns here, with its top cell on the stack: that becomes the new TOS.
012B   CD 27 01     EXEC:     CALL   jphl   ; 2B
012E   E1                     POP   H   
012F   F7                     RST   6   
0130                             ; ---- RST 6: next character --------------------------------------------------
0130   D1           RST30:    POP   D   ; 30  discard the RST's return address
0131                          IF   CPM   
0131   C3 34 01               JMP   next0   ; (this copy runs in page zero)
0134                          ENDIF      
0134                VECEND:      
0134                             ; =============================================================================
0134                             ;  The inner loop: read one character and sort it by range.
0134                             ; 
0134                             ;    00h          end of program
0134                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0134                             ;    30h-39h      digit: read a whole number
0134                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0134                             ;    61h-7Ah      a-z: push the address of that letter's cell
0134                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0134                             ; =============================================================================
0134                NEXT0:       
0134                          IF   CHECKED   
                              CALL   chkstk   ; both stacks are checked once per character
0134                          ENDIF      
0134   0A                     LDAX   B   
0135   03                     INX   B   
0136   D6 21                  SUI   21h   ; A = c - 21h
0138   DA 78 01               JC   ctl   ; c < 21h: NUL ends, the rest are ignored
013B   FE 0F                  CPI   0Fh   
013D   DA 68 01               JC   punct   ; 21h-2Fh: PTAB index 0-14
0140   D6 0F                  SUI   0Fh   ; A = c - 30h
0142   FE 0A                  CPI   0Ah   
0144   DA 4F 03               JC   digit   ; 30h-39h
0147   FE 11                  CPI   11h   
0149   DA 66 01               JC   p3a   ; 3Ah-40h
014C   D6 11                  SUI   11h   ; A = c - 41h
014E   FE 1A                  CPI   1Ah   
0150   DA A4 01               JC   upper   ; 41h-5Ah: A = letter index 0-25
0153   FE 20                  CPI   20h   
0155   DA 64 01               JC   p5b   ; 5Bh-60h
0158   FE 3A                  CPI   3Ah   
015A   DA 9E 01               JC   lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
015D   FE 3E                  CPI   3Eh   
015F                          IF   CHECKED   
                              JZ   next0   ; 7Fh, DEL: ignored
                              JNC   e_hi   ; 80h-FFh: reserved
015F                          ENDIF      
015F                          IF   1-CHECKED   
015F   D2 34 01               JNC   next0   ; 7Fh-FFh: ignored
0162                          ENDIF      
0162   D6 1A                  SUI   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
0164   D6 09        P5B:      SUI   9   ; 5Bh-60h: -4 in all, index 22-27
0166   C6 05        P3A:      ADI   5   ; 3Ah-40h: index 15-21
0168                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
0168                             ; untouched, and A, DE free.
0168   C6 2F        PUNCT:    ADI   PTAB & 0FFh   ; PTAB never crosses a page
016A   5F                     MOV   E,A   
016B   16 03                  MVI   D,PTAB / 256   
016D   FE 45                  CPI   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
016F   1A                     LDAX   D   
0170   5F                     MOV   E,A   ; the handler's low byte
0171                          IFN   CPM   
                              MVI   A,0   
                              RAL      ; its page: 0 + carry
0171                          ENDIF      
0171                          IF   CPM   
0171   3E 01                  MVI   A,1   
0173   CE 00                  ACI   0   ; its page: 1 + carry
0175                          ENDIF      
0175   57                     MOV   D,A   
0176   D5                     PUSH   D   ; jump to it; the stack is balanced again
0177   C9                     RET      ;   when the handler starts
0178                             ; ctl: characters below 21h. A = c - 21h.
0178   C6 21        CTL:      ADI   21h   ; back to c; zero only for NUL
017A   C2 34 01               JNZ   next0   ; the rest are ignored
017D   C3 00 00     ENDPROG:   JMP   EXIT   ; the program has ended
0180                             ; =============================================================================
0180                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
0180                             ;  (00bbIGFuZCA= are up among the RST routines.)
0180                             ; =============================================================================
0180   D1           H_XOR:    POP   D   
0181   7C                     MOV   A,H   
0182   AA                     XRA   D   
0183   67                     MOV   H,A   
0184   7D                     MOV   A,L   
0185   AB                     XRA   E   
0186   6F                     MOV   L,A   
0187   F7                     RST   6   
0188   D1           H_OR:     POP   D   
0189   7C                     MOV   A,H   
018A   B2                     ORA   D   
018B   67                     MOV   H,A   
018C   7D                     MOV   A,L   
018D   B3                     ORA   E   
018E   6F                     MOV   L,A   
018F   F7                     RST   6   
0190   E7           H_NOT:    RST   4   ; ~x = -x - 1
0191   2B                     DCX   H   
0192   F7                     RST   6   
0193                             ; "_" ( n -- addr ): the heap pointer moves by n, a signed count (the add is
0193                             ; the same either way); TOS is the old pointer.
0193   EB           H_ALLOC:   XCHG      
0194   2A 7C 08               LHLD   HEAP   
0197   E5                     PUSH   H   
0198   19                     DAD   D   ; the new top
0199                          IF   CHECKED   
                              CALL   chkhp   
0199                          ENDIF      
0199   22 7C 08               SHLD   HEAP   
019C   E1                     POP   H   
019D   F7                     RST   6   
019E                             ; ---- the letters and digits --------------------------------------------------
019E                             ; a-z: push the cell's address (the cell is the variable)
019E   E5           LOWER:    PUSH   H   
019F   87                     ADD   A   
01A0   6F                     MOV   L,A   
01A1   26 08                  MVI   H,LETPAGE   
01A3   F7                     RST   6   
01A4                             ; A-Z: call the word. The return address (the IP after the letter) goes on
01A4                             ; the return stack, and the IP becomes the address in the letter's cell.
01A4   E5           UPPER:    PUSH   H   ; keep TOS: rpushd pops it back
01A5   87                     ADD   A   
01A6   6F                     MOV   L,A   
01A7   26 08                  MVI   H,LETPAGE   ; HL -> cell
01A9   50                     MOV   D,B   
01AA   59                     MOV   E,C   ; DE = the return address
01AB   4E                     MOV   C,M   
01AC   23                     INX   H   
01AD   46                     MOV   B,M   ; IP = the word's body, and fall into rpushd
01AE                             ; rpushd: push DE on the return stack, then pop TOS off the data stack and
01AE                             ; go on. Every push of the return stack ends here: for a word call the cell
01AE                             ; popped is the TOS that upper parked; for "(" and "{" it is the cell under
01AE                             ; the one that was used up.
01AE                             ; 
01AE                             ; The break key is looked at here, so at every word call and loop-back (and
01AE                             ; block entry and "{"), but only one time in 256: BRKCNT counts them. Reading
01AE                             ; the keyboard can be slow (it is a BDOS call under CP/M).
01AE   2A 34 08     RPUSHD:   LHLD   RSP   
01B1   2B                     DCX   H   
01B2   72                     MOV   M,D   
01B3   2B                     DCX   H   
01B4   73                     MOV   M,E   
01B5   22 34 08               SHLD   RSP   
01B8   21 36 08               LXI   H,BRKCNT   
01BB   35                     DCR   M   
01BC   E1                     POP   H   ; (keeps the flags)
01BD   CC 77 04               CZ   pollk   
01C0   F7                     RST   6   
01C1                             ; ---- machine code: the grave -----------------------------------------------
01C1                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
01C1                             ; are stored from addr until a non-hex character; then a RET (C9h) is
01C1                             ; written and its address is left. An odd last digit is consumed and dropped.
01C1                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
01C1                             ; code is entered by CALL with the data stack above the return address; it
01C1                             ; must keep BC, and on return the top cell becomes the new TOS.
01C1   CD 64 04     H_GRAVE:   CALL   hexc   
01C4   D2 2B 01               JNC   exec   
01C7   87           HX1:      ADD   A   
01C8   87                     ADD   A   
01C9   87                     ADD   A   
01CA   87                     ADD   A   
01CB   57                     MOV   D,A   ; the high digit
01CC   CD 64 04               CALL   hexc   
01CF   D2 DB 01               JNC   hx2   ; odd digit: consumed and dropped
01D2   B2                     ORA   D   
01D3   77                     MOV   M,A   
01D4   23                     INX   H   
01D5   CD 64 04               CALL   hexc   
01D8   DA C7 01               JC   hx1   
01DB   36 C9        HX2:      MVI   M,0C9h   ; (never range-checked: the spec says so)
01DD   F7                     RST   6   
01DE                             ; ---- where the two pages meet ----------------------------------------------
01DE                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
01DE                             ; are in falling code order for this), and where exactly differs between the
01DE                             ; builds: NPG1 follows. Every handler below these four must start in the
01DE                             ; second page, and every one above in the first; chktab.py checks both.
01DE                             ; "]" returns: pop an address and jump to it. TOS is parked on the stack
01DE                             ; while rpop uses HL, and the drop at the end brings it back.
01DE   E5           H_RET:    PUSH   H   
01DF   CF           RET2:     RST   1   
01E0   44                     MOV   B,H   
01E1   4D                     MOV   C,L   
01E2   DF                     RST   3   
01E3                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
01E3                             ; drops the block start, "]" returns. No closer at all ends the program.
01E3                             ; The flag stays in HL as the spent cell that rdrop and ret2 drop.
01E3   7C           H_BREAK:   MOV   A,H   
01E4   B5                     ORA   L   
01E5   CA D2 02               JZ   h_drop   ; false: just drop the flag
01E8   CD 30 04               CALL   skip   
01EB   B7                     ORA   A   ; skip returns 0 for ")"
01EC   C2 DF 01               JNZ   ret2   
01EF   C3 06 01               JMP   rdrop   
01F2                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
01F2                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
01F2                             ; the body"s address instead. Either way it then skips to the matching "]'.
01F2                             ; (The unchecked build takes anything that is not a letter as the space; the
01F2                             ; checked build stops on it.)
01F2   0A           H_DEF:    LDAX   B   
01F3   03                     INX   B   
01F4   D6 41                  SUI   "A"   ; a letter gives 0-25 or 32-57: lowercase
01F6   5F                     MOV   E,A   ;   lands 64 bytes up
01F7   E6 DF                  ANI   0DFh   ; fold case
01F9   FE 1A                  CPI   26   
01FB   D2 0B 02               JNC   def2   ; not a letter
01FE   7B                     MOV   A,E   
01FF   87                     ADD   A   
0200   5F                     MOV   E,A   
0201   16 08                  MVI   D,LETPAGE   ; DE -> cell
0203   79                     MOV   A,C   
0204   12                     STAX   D   
0205   1C                     INR   E   
0206   78                     MOV   A,B   
0207   12                     STAX   D   
0208   C3 0E 02               JMP   skipnx   
020B                DEF2:        
020B                          IF   CHECKED   
                              MOV   A,E   
                              CPI   " "-"A"+256   
                              JNZ   e_brack   ; anything but a letter or a space
020B                          ENDIF      
020B   E5                     PUSH   H   ; an anonymous block: push its address
020C   60                     MOV   H,B   
020D   69                     MOV   L,C   
020E                SKIPNX:      
020E                          IF   CHECKED   
                              DCX   B   ; back onto the letter, so that skip finds its
020E                          ENDIF      ;   opener, the "[", just before where it starts
020E   CD 30 04     SKIPO:    CALL   skip   
0211   F7                     RST   6   
0212   5E           H_FETCH:   MOV   E,M   ; "@"
0213   23                     INX   H   
0214   56                     MOV   D,M   
0215   EB                     XCHG      
0216   F7                     RST   6   
0217                             ; =============================================================================
0217                             ;  Handlers that must start in the image's second page.
0217                             ;  "?" is the last (with "," inside it in the unchecked build), so its long
0217                             ;  tail may run past that page.
0217                             ; =============================================================================
0217                             ; ---- flow control ----------------------------------------------------------
0217                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
0217                             ; the matching ")".
0217   7C           H_OPEN:   MOV   A,H   
0218   B5                     ORA   L   
0219   E1                     POP   H   
021A   CA 0E 02               JZ   skipo   
021D   E5                     PUSH   H   ; (rpushd pops it again)
021E   50                     MOV   D,B   
021F   59                     MOV   E,C   ; the block starts at the IP
0220   C3 AE 01               JMP   rpushd   
0223                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
0223                             ; drops it and carries on.
0223   7C           H_CLOSE:   MOV   A,H   
0224   B5                     ORA   L   
0225   CA 06 01               JZ   rdrop   
0228   CF                     RST   1   ; pop the block start ...
0229   44                     MOV   B,H   
022A   4D                     MOV   C,L   ; ... jump to it ...
022B   EB                     XCHG      
022C   C3 AE 01               JMP   rpushd   ; ... and push it back (which drops the flag)
022F                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
022F                             ; "-" has two jobs: directly before a digit it starts a negative number.
022F   0A           H_SUB:    LDAX   B   
0230   D6 30                  SUI   "0"   
0232   FE 0A                  CPI   10   
0234   DA 55 03               JC   negnum   
0237   E7                     RST   4   ; a - b = a + (-b): fall into "+"
0238   D1           H_ADD:    POP   D   
0239   19                     DAD   D   
023A   F7                     RST   6   
023B   D1           H_AND:    POP   D   
023C   7C                     MOV   A,H   
023D   A2                     ANA   D   
023E   67                     MOV   H,A   
023F   7D                     MOV   A,L   
0240   A3                     ANA   E   
0241   6F                     MOV   L,A   
0242   F7                     RST   6   
0243                             ; Signed compares. Both are "DE < HL" for the right pair: > swaps the two
0243                             ; cells first (XTHL), < doesn't. There is no overflow flag, so the signed
0243                             ; answer is the unsigned borrow of DE - HL, flipped when the signs differ.
0243                             ; SBB A turns a carry into -1 or 0 with no branch.
0243   E3           H_GT:     XTHL      ; a > b  is  b < a
0244   D1           H_LT:     POP   D   ; a < b: DE = a, HL = b
0245   7B                     MOV   A,E   
0246   95                     SUB   L   
0247   7A                     MOV   A,D   
0248   9C                     SBB   H   
0249   9F                     SBB   A   ; A = -1 if DE < HL unsigned
024A   6F                     MOV   L,A   
024B   7C                     MOV   A,H   
024C   AA                     XRA   D   
024D   17                     RAL      ; carry = the signs differ
024E   9F                     SBB   A   
024F   AD                     XRA   L   ; flip when they do
0250   67                     MOV   H,A   
0251   6F                     MOV   L,A   
0252   F7                     RST   6   
0253   D1           H_EQ:     POP   D   
0254   7D                     MOV   A,L   
0255   AB                     XRA   E   
0256   6F                     MOV   L,A   
0257   7C                     MOV   A,H   
0258   AA                     XRA   D   
0259   B5                     ORA   L   ; zero if equal
025A   D6 01                  SUI   1   ; carry only for zero
025C   9F                     SBB   A   
025D   67                     MOV   H,A   
025E   6F                     MOV   L,A   
025F   F7                     RST   6   
0260                             ; "*": shift-and-add on the multiplier's low bit, so it stops as soon as the
0260                             ; multiplier is used up; only the low 16 bits are kept.
0260   D1           H_MUL:    POP   D   ; DE = multiplicand
0261   C5                     PUSH   B   
0262   44                     MOV   B,H   
0263   4D                     MOV   C,L   ; BC = multiplier
0264   21 00 00               LXI   H,0   
0267   78           MUL1:     MOV   A,B   
0268   B7                     ORA   A   ; clear carry
0269   1F                     RAR      
026A   47                     MOV   B,A   
026B   79                     MOV   A,C   
026C   1F                     RAR      
026D   4F                     MOV   C,A   ; BC >> 1, carry = the bit shifted out
026E   D2 72 02               JNC   mul2   
0271   19                     DAD   D   
0272   EB           MUL2:     XCHG      
0273   29                     DAD   H   ; multiplicand << 1
0274   EB                     XCHG      
0275   78                     MOV   A,B   
0276   B1                     ORA   C   
0277   C2 67 02               JNZ   mul1   
027A   C1                     POP   B   
027B   F7                     RST   6   
027C                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
027C                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
027C                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
027C                             ; stops on it.
027C                H_DIV:       
027C                          IF   CHECKED   
                              MOV   A,H   
                              ORA   L   
                              JZ   e_zero   
027C                          ENDIF      
027C   D1                     POP   D   ; DE = a, HL = b
027D   C5                     PUSH   B   
027E   7A                     MOV   A,D   
027F   B7                     ORA   A   
0280   F5                     PUSH   PSW   ; S flag = sign of a (for r)
0281   AC                     XRA   H   
0282   F5                     PUSH   PSW   ; S flag = sign of q
0283   7C                     MOV   A,H   
0284   B7                     ORA   A   
0285   FC 20 01               CM   neg16   ; HL = |b|
0288   EB                     XCHG      
0289   7C                     MOV   A,H   
028A   B7                     ORA   A   
028B   FC 20 01               CM   neg16   ; HL = |a|, DE = |b|
028E   CD 72 03               CALL   udiv   ; HL = q, BC = r
0291   F1                     POP   PSW   
0292   FC 20 01               CM   neg16   ; q's sign
0295   EB                     XCHG      ; DE = q
0296   60                     MOV   H,B   
0297   69                     MOV   L,C   ; HL = r
0298   F1                     POP   PSW   
0299   FC 20 01               CM   neg16   ; r's sign
029C   C1                     POP   B   
029D   D5                     PUSH   D   ; q under r
029E   F7                     RST   6   
029F                             ; ---- stack and storage -----------------------------------------------------
029F   E5           H_DUP:    PUSH   H   ; ":"
02A0   F7                     RST   6   
02A1   E3           H_SWAP:   XTHL      ; "%"
02A2   F7                     RST   6   
02A3                             ; (The checked build tests the address before it takes the value off the
02A3                             ; stack, so that an error report shows both.)
02A3                H_STORE:      ; "!" ( n addr -- )
02A3                          IF   CHECKED   
                              CALL   chkst   
02A3                          ENDIF      
02A3   D1                     POP   D   
02A4   73                     MOV   M,E   
02A5   23                     INX   H   
02A6   72                     MOV   M,D   
02A7   DF                     RST   3   
02A8                H_CSTORE:      ; "." ( c addr -- )
02A8                          IF   CHECKED   
                              CALL   chkst   
02A8                          ENDIF      
02A8   D1                     POP   D   
02A9   73                     MOV   M,E   
02AA   DF                     RST   3   
02AB                             ; ---- console ---------------------------------------------------------------
02AB                             ; 22h pushes the address of the text after it and skips the string.
02AB   E5           H_STR:    PUSH   H   
02AC   60                     MOV   H,B   
02AD   69                     MOV   L,C   
02AE   CD 57 04               CALL   skipstr   
02B1                          IF   CHECKED   
                              ORA   A   ; 0: the text ran out before the closing quote
                              JZ   e_quote   
02B1                          ENDIF      
02B1   F7                     RST   6   
02B2                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
02B2                             ; 60h to 7Eh is one of the escapes at pesc; "/" plus any other character
02B2                             ; clears that character"s bit 6 (/M is CR, and / then DEL gives "?"; "/',
02B2                             ; '"' and '?' have no bit 6, so //, /" and /? give themselves).
02B2                          IF   1-CHECKED   
02B2   7E           H_PRINT:   MOV   A,M   
02B3   23                     INX   H   
02B4   FE 22                  CPI   22h   
02B6   CA D2 02               JZ   h_drop   
02B9   FE 2F                  CPI   "/"   
02BB   C2 CC 02               JNZ   pr1   
02BE   7E                     MOV   A,M   
02BF   23                     INX   H   
02C0   FE 60                  CPI   60h   
02C2   DA CA 02               JC   pr0   
02C5   FE 7F                  CPI   7Fh   
02C7   DA BF 03               JC   pesc   
02CA   E6 BF        PR0:      ANI   0BFh   
02CC   EF           PR1:      RST   5   
02CD   C3 B2 02               JMP   h_print   
02D0                PRLOOP:   EQU   h_print   ; (where the escapes go back to)
02D0                PRAGAIN:   EQU   h_print   ; (and where /~ goes back to)
02D0                          ENDIF      
02D0                          IF   CHECKED   
                                 ; (The checked build has the loop as a routine, prstr, which the error
                                 ; report uses too. The address is kept meanwhile, for a report: it shows
                                 ; the stack as it was before the "$". /~ comes back to hp1.)
                    H_PRINT:   SHLD   PSAVE   
                    HP1:      CALL   prstr   
                              RST   3   
02D0                          ENDIF      
02D0   7D           H_EMIT:   MOV   A,L   ; "'"
02D1   EF                     RST   5   
02D2   DF           H_DROP:   RST   3   ; ";" is this one byte
02D3                             ; "#" prints TOS as a signed decimal number, with no space after it.
02D3   C5           H_NUM:    PUSH   B   
02D4   CD A4 03               CALL   psgn   
02D7   C1                     POP   B   
02D8   DF                     RST   3   
02D9                          IF   CHECKED   ; (the checked build has no room to start ","
                    H_CFETCH:   MOV   L,M   ;   as late as the unchecked one does: see
                              MVI   H,0   ;   the end of "?")
                              RST   6   
02D9                          ENDIF      
02D9                             ; "?" ( n -- c ) or ( -n -- addr )
02D9                             ;   n > 0: wait about n ms for a key; 0 if none came
02D9                             ;   n = 0: wait for a key
02D9                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
02D9                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
02D9   7C           H_KEY:    MOV   A,H   
02DA   B7                     ORA   A   
02DB   FA FB 02               JM   line   
02DE   1E 28        KT1:      MVI   E,MSLOOP   ; one millisecond, roughly
02E0   CD A9 04     KT2:      CALL   getk   
02E3   C2 F7 02               JNZ   kt3   
02E6   1D                     DCR   E   
02E7   C2 E0 02               JNZ   kt2   
02EA   7C                     MOV   A,H   ; 0? never counts down: it waits
02EB   B5                     ORA   L   
02EC   CA DE 02               JZ   kt1   
02EF   2B                     DCX   H   
02F0   7C                     MOV   A,H   
02F1   B5                     ORA   L   
02F2   C2 DE 02               JNZ   kt1   ; A = 0 if the time ran out
02F5                          IF   1-CHECKED   
02F5   FE                     DB   0FEh   ; (CPI: steps over the one byte of ",")
02F6   7E           H_CFETCH:   MOV   A,M   ; "," shares "?"s ending: A becomes TOS
02F7                          ENDIF      
02F7   6F           KT3:      MOV   L,A   
02F8   26 00                  MVI   H,0   
02FA   F7                     RST   6   
02FB                             ; Backspace takes the last character back (and is echoed as
02FB                             ; it is), CR ends (stored, not echoed), every other key is stored and
02FB                             ; echoed until the line is full. The line buffer starts at offset 80h
02FB                             ; of its page, so L alone is the place in the line: D holds the L of
02FB                             ; a full line.
02FB   11 7F 00     LINE:     LXI   D,127   ; TOS is minus the count: adding 127 carries
02FE   19                     DAD   D   ;   only for 1 to 127, and leaves 127 - count
02FF   9F                     SBB   A   
0300   A5                     ANA   L   ; (0 for a count that is too big)
0301   2F                     CMA      
0302   57                     MOV   D,A   ; D = the L of a full line: 80h + count, FFh
0303                             ;   at most
0303   21 80 08               LXI   H,LINEBUF   
0306   CD A9 04     LN2:      CALL   getk   
0309   CA 06 03               JZ   ln2   
030C   FE 0D                  CPI   13   
030E   CA 2B 03               JZ   ln5   
0311   FE 08                  CPI   8   
0313   CA 23 03               JZ   ln4   
0316   5F                     MOV   E,A   
0317   7D                     MOV   A,L   
0318   BA                     CMP   D   
0319   CA 06 03               JZ   ln2   ; full
031C   73                     MOV   M,E   
031D   2C                     INR   L   
031E   7B                     MOV   A,E   
031F   EF           LN3:      RST   5   
0320   C3 06 03               JMP   ln2   
0323   2D           LN4:      DCR   L   ; Backspace: one back, and echo it,
0324   FA 1F 03               JM   ln3   ;   unless the line was empty (L left the
0327   2C                     INR   L   ;   upper half of the page)
0328   C3 06 03               JMP   ln2   
032B   77           LN5:      MOV   M,A   ; the CR
032C   2E 80                  MVI   L,LINEBUF & 0FFh   
032E   F7                     RST   6   
032F                             ; =============================================================================
032F                             ;  Dispatch table: the low byte of each handler's address, in code order.
032F                             ;  It must not cross a page (the dispatcher only adds to its low byte).
032F                             ; =============================================================================
032F                             ; The handlers of the first NPG1 characters start in the image's second page.
032F                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
032F                             ; differs between the builds, so the count is worked out here.
032F                             ; (One division to a line: asm80 only rounds down when it stores a value.)
032F                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
032F                PGBRK:    EQU   (h_break-BASE)/256   
032F                PGDEF:    EQU   (h_def-BASE)/256   
032F                PGFET:    EQU   (h_fetch-BASE)/256   
032F                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
032F   A3           PTAB:     DB   h_store & 0FFh   ; !
0330   AB                     DB   h_str & 0FFh   ; "
0331   D3                     DB   h_num & 0FFh   ; #
0332   B2                     DB   h_print & 0FFh   ; $
0333   A1                     DB   h_swap & 0FFh   ; %
0334   3B                     DB   h_and & 0FFh   ; &
0335   D0                     DB   h_emit & 0FFh   ; '
0336   17                     DB   h_open & 0FFh   ; (
0337   23                     DB   h_close & 0FFh   ; )
0338   60                     DB   h_mul & 0FFh   ; *
0339   38                     DB   h_add & 0FFh   ; +
033A   F6                     DB   h_cfetch & 0FFh   ; ,
033B   2F                     DB   h_sub & 0FFh   ; -
033C   A8                     DB   h_cstore & 0FFh   ; .
033D   7C                     DB   h_div & 0FFh   ; /
033E   9F                     DB   h_dup & 0FFh   ; :
033F   D2                     DB   h_drop & 0FFh   ; ;
0340   44                     DB   h_lt & 0FFh   ; <
0341   53                     DB   h_eq & 0FFh   ; =
0342   43                     DB   h_gt & 0FFh   ; >
0343   D9                     DB   h_key & 0FFh   ; ?
0344   12                     DB   h_fetch & 0FFh   ; @
0345   F2                     DB   h_def & 0FFh   ; [
0346   E3                     DB   h_break & 0FFh   ; \
0347   DE                     DB   h_ret & 0FFh   ; ]
0348   80                     DB   h_xor & 0FFh   ; ^
0349   93                     DB   h_alloc & 0FFh   ; _
034A   C1                     DB   h_grave & 0FFh   ; `
034B   14                     DB   h_tor & 0FFh   ; {
034C   88                     DB   h_or & 0FFh   ; |
034D   1D                     DB   h_fromr & 0FFh   ; }
034E   90                     DB   h_not & 0FFh   ; ~
034F                PTABEND:      
034F                             ; =============================================================================
034F                             ;  Routines (no handler starts past this point)
034F                             ; =============================================================================
034F                             ; Digits: step back onto the first digit and read the whole number.
034F   E5           DIGIT:    PUSH   H   
0350   0B                     DCX   B   
0351   CD 5B 03               CALL   rdnum   
0354   F7                     RST   6   
0355                             ; negnum: "-" directly before a digit: read the number, negate it.
0355   E5           NEGNUM:   PUSH   H   
0356   CD 5B 03               CALL   rdnum   
0359   E7                     RST   4   
035A   F7                     RST   6   
035B                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
035B                             ; non-digit. Values wrap at 16 bits, as the spec says.
035B   21 00 00     RDNUM:    LXI   H,0   
035E   0A           RDN1:     LDAX   B   
035F   D6 30                  SUI   "0"   
0361   FE 0A                  CPI   10   
0363   D0                     RNC      
0364   03                     INX   B   
0365   54                     MOV   D,H   
0366   5D                     MOV   E,L   
0367   29                     DAD   H   
0368   29                     DAD   H   
0369   19                     DAD   D   
036A   29                     DAD   H   ; HL * 10
036B   5F                     MOV   E,A   
036C   16 00                  MVI   D,0   
036E   19                     DAD   D   
036F   C3 5E 03               JMP   rdn1   
0372                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, BC = remainder.
0372                             ; Uses A, BC; the caller saves the IP. HL holds the dividend and, as its bits
0372                             ; leave at the top, the quotient bits arrive at the bottom. The loop counter
0372                             ; lives on the stack, since A is busy with the shifts.
0372                             ; Dividing by 2 is one shift (the spec wants that fast).
0372   01 00 00     UDIV:     LXI   B,0   
0375   7B                     MOV   A,E   
0376   EE 02                  XRI   2   
0378   B2                     ORA   D   
0379   C2 86 03               JNZ   udv0   
037C   B4                     ORA   H   ; A was 0, and the carry is clear
037D   1F                     RAR      
037E   67                     MOV   H,A   
037F   7D                     MOV   A,L   
0380   1F                     RAR      
0381   6F                     MOV   L,A   ; the quotient
0382   78                     MOV   A,B   
0383   17                     RAL      
0384   4F                     MOV   C,A   ; the remainder: the bit that fell out
0385   C9                     RET      
0386   3E 10        UDV0:     MVI   A,16   
0388   F5                     PUSH   PSW   
0389   29           UDV1:     DAD   H   ; next dividend bit into the carry
038A   79                     MOV   A,C   
038B   17                     RAL      
038C   4F                     MOV   C,A   
038D   78                     MOV   A,B   
038E   17                     RAL      
038F   47                     MOV   B,A   ; BC = BC*2 + bit
0390   79                     MOV   A,C   
0391   93                     SUB   E   
0392   78                     MOV   A,B   
0393   9A                     SBB   D   ; carry if BC < DE
0394   DA 9C 03               JC   udv2   
0397   47                     MOV   B,A   ; BC - DE (high byte; A holds it)
0398   79                     MOV   A,C   
0399   93                     SUB   E   
039A   4F                     MOV   C,A   
039B   2C                     INR   L   ; quotient bit
039C   F1           UDV2:     POP   PSW   
039D   3D                     DCR   A   
039E   F5                     PUSH   PSW   
039F   C2 89 03               JNZ   udv1   
03A2   F1                     POP   PSW   
03A3   C9                     RET      
03A4                             ; psgn: print HL as a signed number. Uses BC.
03A4   7C           PSGN:     MOV   A,H   
03A5   B7                     ORA   A   
03A6   F2 AD 03               JP   pdec   
03A9   3E 2D                  MVI   A,"-"   
03AB   EF                     RST   5   
03AC   E7                     RST   4   
03AD                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
03AD                             ; Uses BC.
03AD   11 0A 00     PDEC:     LXI   D,10   
03B0   CD 72 03               CALL   udiv   ; HL = HL / 10, C = the last digit
03B3   79                     MOV   A,C   
03B4   F5                     PUSH   PSW   
03B5   7C                     MOV   A,H   
03B6   B5                     ORA   L   
03B7   C4 AD 03               CNZ   pdec   
03BA   F1                     POP   PSW   
03BB   C6 30                  ADI   "0"   
03BD   EF                     RST   5   
03BE   C9                     RET      
03BF                             ;-----------------------------------------------------------------------------
03BF                             ; pesc: the escapes of "$". A = the character after the "/", 60h to 7Eh, and
03BF                             ; HL points past it. Each goes back into the loop that prints the string
03BF                             ; (PRLOOP), but /~ has the stack to see to, and goes back by PRAGAIN.
03BF                             ;    /a-/z   print the variable, as "#" does
03BF                             ;    /{      clear the screen, the cursor to the top left
03BF                             ;    /}      clear from the cursor to the end of the line
03BF                             ;    /|  /`  show the cursor, hide it
03BF                             ;    /~      ( row col -- ) the cursor to that row and column, from 0
03BF   FE 7E        PESC:     CPI   7Eh   
03C1   CA E4 03               JZ   pat   
03C4   11 B2 02               LXI   D,PRLOOP   ; the others return into the loop
03C7   D5                     PUSH   D   
03C8   D6 7B                  SUI   7Bh   ; 00bbIDAsIHwgMSwg 2, and no borrow
03CA   D2 12 04               JNC   pcon   
03CD   C6 1A                  ADI   1Ah   ; a-z: 0-25, and a carry; `: FFh, and none
03CF   D2 02 04               JNC   phide   
03D2   87                     ADD   A   ; the variable's cell
03D3   C6 40                  ADI   40h   
03D5   E5                     PUSH   H   
03D6   C5                     PUSH   B   
03D7   6F                     MOV   L,A   
03D8   26 08                  MVI   H,LETPAGE   
03DA   7E                     MOV   A,M   
03DB   2C                     INR   L   
03DC   66                     MOV   H,M   
03DD   6F                     MOV   L,A   
03DE   CD A4 03               CALL   psgn   
03E1   C1                     POP   B   
03E2   E1                     POP   H   
03E3   C9                     RET      
03E4                             ; /~ ( row col addr -- ): the two cells under the string's address go. In
03E4                             ; the checked build "$" is the routine prstr: its own return address goes
03E4                             ; first, and hp1 calls it again afterwards. There a /~ that takes cells
03E4                             ; that aren"t there is s after the "$' (or at its NUL: see e_dollar), as for
03E4                             ; any other character. chkstk stops a /~ only when the stack is already
03E4                             ; past its empty place, so that, however many there are, what they write
03E4                             ; stays in the spare bytes above the stack.
03E4                PAT:         
03E4                          IF   CHECKED   
                              POP   D   
                              CALL   chkstk   
03E4                          ENDIF      
03E4   D1                     POP   D   ; DE = the column
03E5   E3                     XTHL      ; HL = the row; the text pointer is kept
03E6                          IF   1-ANS   
                              CALL   CONAT   
                              POP   H   
                              JMP   PRAGAIN   
                                 ; With ANSI = 0 the machine's routines do the rest.
                    PCON:     JZ   CONCLS   ; /{
                              CPI   2   
                              JZ   CONEOL   ; /}
                              DB   0FEh   ; /|  (CPI steps over the XRA: A = 1, show)
                    PHIDE:    XRA   A   ; /`  (A = 0: hide)
                              JMP   CONCUR   
03E6                          ENDIF      
03E6                          IF   ANS   
03E6   C5                     PUSH   B   ; (pdec uses BC)
03E7   D5                     PUSH   D   
03E8   CD 29 04               CALL   csi   ; ESC [ row+1 ; col+1 H (ANSI counts from 1)
03EB   23                     INX   H   
03EC   CD AD 03               CALL   pdec   
03EF   3E 3B                  MVI   A,";"   
03F1   EF                     RST   5   
03F2   E1                     POP   H   
03F3   23                     INX   H   
03F4   CD AD 03               CALL   pdec   
03F7   3E 48                  MVI   A,"H"   
03F9   EF                     RST   5   
03FA   C1                     POP   B   
03FB   E1                     POP   H   
03FC   C3 B2 02               JMP   PRAGAIN   
03FF                             ; With ANSI = 1 they are sequences. The carry is clear on the way in.
03FF   1E 68        PSHOW:    MVI   E,"h"   ; /|  ESC [ ? 2 5 h
0401   DA                     DB   0DAh   ; (JC nn: with no carry it steps over two bytes)
0402   1E 6C        PHIDE:    MVI   E,"l"   ; /`  ESC [ ? 2 5 l
0404   3E 3F                  MVI   A,"?"   
0406   CD 22 04               CALL   csia   
0409   3E 32                  MVI   A,"2"   
040B   EF                     RST   5   
040C   3E 35                  MVI   A,"5"   
040E   EF                     RST   5   
040F   7B                     MOV   A,E   
0410   EF                     RST   5   
0411   C9                     RET      
0412                             ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into csia.
0412   3D           PCON:     DCR   A   
0413   CA FF 03               JZ   pshow   ; /|
0416   3E 4B                  MVI   A,"K"   
0418   F2 22 04               JP   csia   ; /}  ESC [ K
041B   3E 48                  MVI   A,"H"   ; /{  ESC [ H ESC [ J
041D   CD 22 04               CALL   csia   
0420   3E 4A                  MVI   A,"J"   ; (on into csia)
0422                             ; csia: ESC [ and then A. csi: ESC [. Both keep all but A.
0422   F5           CSIA:     PUSH   PSW   
0423   CD 29 04               CALL   csi   
0426   F1                     POP   PSW   
0427   EF                     RST   5   
0428   C9                     RET      
0429   3E 1B        CSI:      MVI   A,27   
042B   EF                     RST   5   
042C   3E 5B                  MVI   A,"["   
042E   EF                     RST   5   
042F   C9                     RET      
0430                          ENDIF      
0430                             ; skip: read past text to the closer at this level, and return A = 0 if it
0430                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
0430                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
0430                             ; no closer; anything else that runs into the NUL had unbalanced brackets
0430                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
0430                             ; skip sets it to 0 and falls through the INR that an opener comes back to.
0430                             ; 
0430                             ; The checked build also looks at the character the skip was started by,
0430                             ; which is always the one just before where it starts: "(" must end at ")",
0430                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
0430                             ; quote counts as running into it. "\" takes either closer. The place where
0430                             ; the skip started is kept on the stack, for the report.
0430                SKIP:        
0430                          IF   CHECKED   
                              PUSH   B   
                              DCX   B   
                              LDAX   B   
                              INX   B   
                              MOV   E,A   ; E = the opener: ( [ or \
0430                          ENDIF      
0430   16 00                  MVI   D,0   
0432   14           SK3:      INR   D   ; an opener: one deeper
0433   0A           SK1:      LDAX   B   
0434                          IF   1-CHECKED   
0434   03                     INX   B   
0435   B7                     ORA   A   
0436   CA 7D 01               JZ   endprog   
0439                          ENDIF      
0439                          IF   CHECKED   
                              ORA   A   
                              JZ   sk6   ; (the IP stays on the NUL)
                              INX   B   
0439                          ENDIF      
0439   FE 22                  CPI   22h   
043B   CC 57 04               CZ   skipstr   ; leaves A = 22h, which matches nothing below
043E   D6 28                  SUI   "("   ;   (or 0, and then the NUL is read next)
0440   CA 32 04               JZ   sk3   
0443   3D                     DCR   A   ; ")"
0444   CA 51 04               JZ   sk4   
0447   D6 32                  SUI   "["-")"   
0449   CA 32 04               JZ   sk3   
044C   FE 02                  CPI   "]"-"["   
044E   C2 33 04               JNZ   sk1   
0451   15           SK4:      DCR   D   
0452                          IF   1-CHECKED   
0452   C8                     RZ      ; the closer at this level
0453   C3 33 04               JMP   sk1   
0456                          ENDIF      
0456                          IF   CHECKED   
                              JNZ   sk1   
                              MOV   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
                              XRA   E   ;   opener is 0 for "(" and 1 for "[", and only
                              ANI   6   ;   "\" has bit 2: so this is 2 for the wrong
                              CPI   2   ;   closer, and only then
                              MOV   A,D   
                              POP   D   ; (where the skip started)
                              RNZ      
                              MOV   B,D   ; N. The place is the opener
                              MOV   C,E   
                              JMP   sk7   
                    SK6:      MOV   A,E   ; the text ran out:
                              ANI   4   
                              JNZ   endprog   ;   "\" with no closer ends the program
                              POP   B   
                    SK7:      MVI   A,"N"   
                              JMP   errp   ; (errp drops skip's return address)
0456                          ENDIF      
0456                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
0456                             ; the next character, so "/"" does not end it. Leaves A = 22h.
0456                          IF   1-CHECKED   
0456   03           SS0:      INX   B   
0457   0A           SKIPSTR:   LDAX   B   
0458   03                     INX   B   
0459   FE 2F                  CPI   "/"   
045B   CA 56 04               JZ   ss0   
045E   FE 22                  CPI   22h   
0460   C2 57 04               JNZ   skipstr   
0463   C9                     RET      
0464                          ENDIF      
0464                          IF   CHECKED   
                                 ; The checked build never steps over a NUL: if the text runs out first it
                                 ; returns A = 0 with the IP on the NUL.
                    SKIPSTR:   LDAX   B   
                              ORA   A   
                              RZ      
                              INX   B   
                              CPI   22h   
                              RZ      
                              CPI   "/"   
                              JNZ   skipstr   
                              LDAX   B   ; the escaped character
                              ORA   A   
                              RZ      
                              INX   B   
                              JMP   skipstr   
0464                          ENDIF      
0464                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
0464                             ; and return its value in A with the carry set; otherwise leave the IP and
0464                             ; return with the carry clear.
0464   0A           HEXC:     LDAX   B   
0465   D6 30                  SUI   "0"   
0467   FE 0A                  CPI   10   
0469   DA 75 04               JC   hc1   
046C   E6 DF                  ANI   0DFh   
046E   D6 11                  SUI   11h   
0470   FE 06                  CPI   6   
0472   D0                     RNC      
0473   D6 F6                  SUI   0F6h   ; + 10, and sets the carry
0475   03           HC1:      INX   B   
0476   C9                     RET      
0477                             ; =============================================================================
0477                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
0477                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
0477                             ;  (RST 5) prints A. Both keep BC, DE and HL. In the generic build they are
0477                             ;  the host's KEY and CONOUT routines themselves.
0477                             ; 
0477                             ;  A running program reads the keyboard only through getk and pollk, which
0477                             ;  between them give the break key its rules:
0477                             ;    - Ctrl-C stops the program;
0477                             ;    - any other key that the break check reads is held in KEYBUF for the
0477                             ;      next "?", and a newer one takes its place;
0477                             ;    - "?" (getk) takes the held key first;
0477                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
0477                             ;      key like any other, but two of them within about 250 ms still stop it.
0477                             ;  Both are called straight from a handler, never from a routine under one:
0477                             ;  the checked build's report counts on finding one return address above the
0477                             ;  data stack, and TOS in HL.
0477                             ; =============================================================================
0477                          IFN   CPM   
                    RAWK:     EQU   KEY   
0477                          ENDIF      
0477                             ; pollk: the break check (see rpushd).
0477   CD BA 04     POLLK:    CALL   rawk   
047A   C8                     RZ      ; no key
047B   32 7A 08               STA   KEYBUF   ; held for the next "?"
047E   FE 03        PK1:      CPI   3   ; (getk joins here)
0480   C0                     RNZ      
0481                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
0481                             ; the program has turned it off, wait about 250 ms for one more key: a
0481                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
0481                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
0481   3A 7B 08     CTLC:     LDA   BRKOFF   
0484   B7                     ORA   A   
0485   CA 7D 01               JZ   brk   
0488   D5                     PUSH   D   
0489   11 10 27               LXI   D,250*MSLOOP   
048C   CD BA 04     CT1:      CALL   rawk   
048F   C2 98 04               JNZ   ct2   
0492   1B                     DCX   D   
0493   7A                     MOV   A,D   
0494   B3                     ORA   E   
0495   C2 8C 04               JNZ   ct1   
0498   D1           CT2:      POP   D   ; A = the second key, or 0 if none came
0499   FE 03                  CPI   3   
049B   CA 7D 01               JZ   brk   
049E   B7                     ORA   A   
049F   CA A5 04               JZ   ct3   
04A2   32 7A 08               STA   KEYBUF   
04A5   3E 03        CT3:      MVI   A,3   
04A7   B7                     ORA   A   
04A8   C9                     RET      
04A9                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
04A9   E5           GETK:     PUSH   H   ; a held key goes first, and is taken out of
04AA   21 7A 08               LXI   H,KEYBUF   ;   the buffer
04AD   7E                     MOV   A,M   
04AE   36 00                  MVI   M,0   
04B0   E1                     POP   H   
04B1   B7                     ORA   A   
04B2   C0                     RNZ      
04B3   CD BA 04               CALL   rawk   
04B6   C8                     RZ      
04B7   C3 7E 04               JMP   pk1   ; Ctrl-C? If not, that is the key
04BA                          IF   1-CHECKED   
04BA                BRK:      EQU   endprog   ; the unchecked build stops without a word;
04BA                          ENDIF      
04BA                          IF   CHECKED   
                    BRK:      EQU   e_break   ;   the checked build reports B
04BA                          ENDIF      
04BA                          IF   CPM   
04BA   3E FF        RAWK:     MVI   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
04BC                             ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
04BC                             ; printing and could swallow a key that BDOS 6 then never sees.
04BC   C5           PUTC:     PUSH   B   
04BD   D5                     PUSH   D   
04BE   E5                     PUSH   H   
04BF   5F                     MOV   E,A   
04C0   0E 06                  MVI   C,6   
04C2   CD 05 00               CALL   BDOS   
04C5   E1                     POP   H   
04C6   D1                     POP   D   
04C7   C1                     POP   B   
04C8   B7                     ORA   A   ; (for getk)
04C9   C9                     RET      
04CA                          ENDIF      
04CA                             ; =============================================================================
04CA                             ;  Checked build: the checks and the error report
04CA                             ; =============================================================================
04CA                          IF   CHECKED   
                                 ; chkhp: HL = the new heap top, DE = the count, the carry is from adding
                                 ; it, and the old top is on the stack under the return address. Stop if the
                                 ; new top is not below the limit page, or is below the program's end.
                    CHKHP:       
04CA                          ENDIF      
04CA                          IF   CHECKED*CPM   
                                 ; With this much room a top that wrapped round can land back in
                                 ; range, so the add is tested too: growing must not carry, and
                                 ; releasing must.
                              MOV   A,D   
                              RAR      ; the carry comes in above the count's sign:
                              ADI   40h   ;   bit 7 = carry XOR sign
                              ADD   A   
                              JC   e_heap   
                              LDA   0007h   
                              DCR   A   
                              CMP   H   
                              JC   e_heap   
04CA                          ENDIF      
04CA                          IF   CHECKED*(1-CPM)   
                                 ; (Here the program's space is under 32K, so a top that wrapped
                                 ; round always falls outside it.)
                              MOV   A,H   
                              CPI   HEAPLIM   
                              JNC   e_heap   
04CA                          ENDIF      
04CA                          IF   CHECKED   
                              XCHG      
                              PUSH   H   ; the count
                              LHLD   NPEND   
                              DAD   D   ; carry: at or above the program's end
                              POP   H   
                              XCHG      
                              RC      
                    E_HEAP:   XCHG      ; put the count back in TOS for the report,
                              POP   D   ;   and drop the return address (errp drops
                              MVI   A,"H"   ;   the old top)
                              JMP   errp   
                                 ; chkst: stop unless HL is in the program's own space: from the letter page
                                 ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
                                 ; whatever lies above the limit are safe. Memory above the heap top but
                                 ; below the limit is the program's own: Tiny BASIC keeps its lines there.
                                 ; It is the page of HL + 1 that is tested, so that one test serves both
                                 ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
                                 ; Keeps HL and BC. It runs on into its own error entry.
                    CHKST:    INX   H   
                              MOV   A,H   
                              DCX   H   
                              CPI   LETPAGE   
                              JC   e_store   
04CA                          ENDIF      
04CA                          IF   CHECKED*(1-CPM)   
                              CPI   HEAPLIM   
                              RC      
04CA                          ENDIF      
04CA                          IF   CHECKED*CPM   
                              MOV   E,A   
                              LDA   0007h   ; the BDOS page is the heap limit
                              DCR   A   
                              CMP   E   
                              RNC      
04CA                          ENDIF      
04CA                          IF   CHECKED   
                                 ; Two error entries for errors found inside a routine: the first hides the
                                 ; second inside a 3-byte LXI D (the 11h); errp then drops the routine's
                                 ; return address.
                    E_STORE:   MVI   A,"O"   ; a store outside the program's space
                              DB   11h   
                    E_BREAK:   MVI   A,"B"   ; Ctrl-C (found inside pollk or getk)
                              JMP   errp   
                                 ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
                                 ; "$", and the error report's texts). A NUL first is an error: Q.
                    PRSTR:    MOV   A,M   
                              INX   H   
                              CPI   22h   
                              RZ      
                              ORA   A   
                              JZ   e_dollar   
                              CPI   "/"   
                              JNZ   prs1   
                              MOV   A,M   
                              INX   H   
                              CPI   60h   
                              JC   prs0   
                              CPI   7Fh   
                              JC   pesc   
                    PRS0:     ANI   0BFh   
                    PRS1:     RST   5   
                              JMP   prstr   
                    PRLOOP:   EQU   prstr   ; (where the escapes go back to)
                    PRAGAIN:   EQU   hp1   ; (and where /~ goes back to)
                                 ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
                                 ; pnl: the same, on a new line.
                    PNL:      MVI   A,13   
                              RST   5   
                              MVI   A,10   
                              RST   5   
                    PMSG:     XTHL      
                              CALL   prstr   
                              XTHL      
                              RET      
                                 ; chkstk: both stacks are checked once per character, not in every handler.
                                 ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
                                 ; the constant carries if it is above (cells were popped that were never
                                 ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
                                 ; a character late at most: the bytes above DSTOP and the guard band below
                                 ; the page take what happens meanwhile.
                    CHKSTK:   XCHG      ; DE = TOS (HL is needed for the pointers)
                              LXI   H,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
                              DAD   SP   
                              JC   e_under   
                              INR   H   
                              JNZ   e_over   
                              LHLD   RSP   ; the return stack: in its page (or it has
                              MOV   A,H   ;   overflowed), and not above its empty
                              CPI   RSPAGE   ;   position (an underflow stays inside the
                              JNZ   e_rover   ;   page, in the guard band)
                              MOV   A,L   
                              CPI   RSTOP&0FFh+1   
                              JNC   e_runder   
                              XCHG      ; TOS back
                              RET      
                    E_RUNDER:   LXI   H,RSTOP   ; return stack underflow: it counts as empty
                              SHLD   RSP   
                              MVI   A,"r"   
                              DB   21h   ; (LXI H hides the next entry; HL is free)
                    E_ROVER:   MVI   A,"R"   ; return stack overflow
                              DB   21h   
                    E_OVER:   MVI   A,"S"   ; data stack overflow
                              XCHG      ; TOS back
                              JMP   errp   
                    E_UNDER:   LXI   SP,DSTOP   ; data stack underflow: it counts as empty
                              MVI   A,"s"   
                              JMP   error   
                                 ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
                                 ; was never defined still holds 0000h, and the byte there is a JMP, C3h, in
                                 ; every build: if the IP is in page zero, this was a call of an undefined
                                 ; word. The call is undone, so the place is the call itself.
                    E_HI:     INR   B   
                              DCR   B   
                              JNZ   e_resv   
                              PUSH   H   
                              RST   1   
                              MOV   B,H   
                              MOV   C,L   
                              POP   H   
                              MVI   A,"U"   
                              JMP   error   
                                 ; e_dollar: "$" ran into a NUL (in prstr): Q, with the string's address
                                 ; back in TOS. prstr's return address goes first. But if a /~ took cells
                                 ; that weren't there, it is s, found now: chkstk, called one cell up, sees
                                 ; the stack past its empty place then.
                    E_DOLLAR:   POP   D   
                              POP   H   
                              CALL   chkstk   
                              PUSH   H   
                              LHLD   PSAVE   
                              DB   11h   ; (LXI D hides e_quote's first two bytes)
                                 ; Error entries. Each loads its letter and then hides the next entry inside
                                 ; a 3-byte LXI D (the 11h), so they all fall through to `error`.
                    E_QUOTE:   MOV   B,H   ; an unclosed string: HL is its address, one
                              MOV   C,L   ;   past the opening quote, which is the place
                              MVI   A,"Q"   
                              DB   11h   
                    E_RESV:   MVI   A,"X"   ; a reserved byte outside a string
                              DB   11h   
                    E_ZERO:   MVI   A,"Z"   ; dividing by zero
                              DB   11h   
                    E_BRACK:   MVI   A,"W"   ; bad character after [
                              DB   0FEh   ; (CPI hides the one byte of errp)
                                 ; errp: an error found inside a routine: drop its return address first.
                    ERRP:     POP   D   
                                 ; error: the report, then the end. A = the letter, BC = one past the place,
                                 ; HL = TOS, and both stacks as the report is to show them:
                                 ; 
                                 ;   Err X @ line,col
                                 ;   up to 16 characters of the text from the place
                                 ;   Stk n: the top 8 cells at most, bottom to top
                                 ;   Rtn n
                    ERROR:    PUSH   H   ; now the whole data stack is in memory
                              MOV   E,A   
                              CALL   pnl   
                              DB   "Err ",22h   
                              MOV   A,E   
                              RST   5   
                              CALL   pmsg   
                              DB   " @ ",22h   
                              DCX   B   ; BC = the place
                                 ; The line and column. A place below the program is in the line
                                 ; buffer: line 0. Otherwise count the LFs from the program's start;
                                 ; DE = the line's number, HL = where it starts.
                              LXI   H,LINEBUF   
                              LXI   D,0   
                              MOV   A,B   
                              CPI   PROG/256   
                              JC   er3   
                              INR   H   
                              MOV   L,E   ; HL = PROG
                    ER1:      INX   D   ; a new line starts at HL
                              PUSH   H   
                    ER2:      MOV   A,L   
                              SUB   C   
                              MOV   A,H   
                              SBB   B   
                              JNC   er2x   ; reached the place
                              MOV   A,M   
                              INX   H   
                              CPI   10   
                              JNZ   er2   
                              POP   PSW   
                              JMP   er1   
                    ER2X:     POP   H   
                    ER3:      PUSH   B   
                              PUSH   H   
                              XCHG      
                              CALL   pdec   ; the line
                              MVI   A,","   
                              RST   5   
                              POP   D   
                              POP   H   
                              PUSH   H   
                              CALL   sub16   
                              INX   H   
                              CALL   pdec   ; the column
                              CALL   pnl   
                              DB   22h   
                              POP   H   ; the text, as it is: 16 characters, or fewer
                              MVI   B,16   ;   if the line or the program ends first
                    ER4:      MOV   A,M   
                              INX   H   
                              ORA   A   
                              JZ   er5   
                              CPI   13   
                              JZ   er5   
                              CPI   10   
                              JZ   er5   
04CA                          ENDIF      
04CA                          IF   CHECKED*CPM   
                              CPI   1Ah   ; (the ^Z that pads a file's last record ends
                              JZ   er5   ;   the text too: some terminals clear the
04CA                          ENDIF      ;   screen on it)
04CA                          IF   CHECKED   
                              RST   5   
                              DCR   B   
                              JNZ   er4   
                    ER5:      CALL   pnl   
                              DB   "Stk ",22h   
                              LXI   H,(2-DSTOP)&0FFFFh   ; SP - (DSTOP-2) is minus twice the depth
                              DAD   SP   ;   (the cell at DSTOP-2 was pushed with the
                              RST   4   ;   first value and holds nothing)
                              MOV   A,H   
                              CALL   phal2   ; the depth
                              MVI   A,":"   
                              RST   5   
                              MOV   A,C   
                              CPI   9   
                              JC   er6   
                              CALL   pmsg   
                              DB   " ...",22h   
                              MVI   C,8   
                    ER6:      MVI   H,0   ; C = the number of cells to show
                              MOV   L,C   
                              DAD   H   
                              DAD   SP   ; HL -> just above the deepest of them
                              INR   C   
                    ER7:      DCR   C   
                              JZ   er8   
                              DCX   H   
                              MOV   D,M   
                              DCX   H   
                              MOV   E,M   
                              PUSH   H   
                              PUSH   B   
                              MVI   A," "   
                              RST   5   
                              XCHG      
                              CALL   psgn   
                              POP   B   
                              POP   H   
                              JMP   er7   
                    ER8:      CALL   pnl   
                              DB   "Rtn ",22h   
                              LHLD   RSP   
                              XCHG      
                              LXI   H,RSTOP   
                              CALL   phalf   
                              CALL   pnl   
                              DB   22h   
                              JMP   endprog   
                                 ; phalf: print half of HL - DE, and leave it in BC
                    PHALF:    CALL   sub16   
                    PHAL2:    ORA   A   ; (A = H; this clears the carry)
                              RAR      
                              MOV   H,A   
                              MOV   A,L   
                              RAR      
                              MOV   L,A   
                              PUSH   H   
                              CALL   pdec   
                              POP   B   
                              RET      
                                 ; sub16: HL = HL - DE. Leaves A = H.
                    SUB16:    MOV   A,L   
                              SUB   E   
                              MOV   L,A   
                              MOV   A,H   
                              SBB   D   
                              MOV   H,A   
                              RET      
04CA                          ENDIF      
04CA                             ; =============================================================================
04CA                             ;  Startup
04CA                             ; =============================================================================
04CA                START:       
04CA                          IF   (1-CPM)*CHECKED   
                              LXI   SP,DSTOP   
04CA                          ENDIF      
04CA                          IF   CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi), and no key is held back.
                              LXI   H,LET   
                              XRA   A   
                    INI1:     MOV   M,A   
                              INR   L   
                              JP   ini1   ; +00h to +7Fh
04CA                          ENDIF      
04CA                          IF   CPM   
04CA                             ; CP/M: the RAM pages follow the image; the heap may grow to the BDOS
04CA   21 08 01               LXI   H,vecs   ; the RST routines go down into page zero
04CD   11 08 00               LXI   D,0008h   
04D0   06 2C                  MVI   B,vecend-vecs   
04D2   7E           CPY:      MOV   A,M   
04D3   12                     STAX   D   
04D4   23                     INX   H   
04D5   13                     INX   D   
04D6   05                     DCR   B   
04D7   C2 D2 04               JNZ   cpy   
04DA   11 5C 00               LXI   D,005Ch   ; open the file named on the command line
04DD   0E 0F                  MVI   C,15   ; (no such file: the first read fails too,
04DF   CD 05 00               CALL   BDOS   ;   and the program is empty)
04E2   11 00 09               LXI   D,PROG   
04E5   D5           LD1:      PUSH   D   
04E6   0E 1A                  MVI   C,26   ; set the DMA address
04E8   CD 05 00               CALL   BDOS   
04EB   11 5C 00               LXI   D,005Ch   
04EE   0E 14                  MVI   C,20   ; read the next 128 bytes
04F0   CD 05 00               CALL   BDOS   
04F3   E1                     POP   H   ; HL = the address this record went to
04F4   B7                     ORA   A   
04F5   C2 00 05               JNZ   ld2   
04F8   11 80 00               LXI   D,128   
04FB   19                     DAD   D   
04FC   EB                     XCHG      
04FD   C3 E5 04               JMP   ld1   
0500   36 00        LD2:      MVI   M,0   ; the end of the file counts as NUL
0502   23                     INX   H   ; the heap starts after it
0503                          ENDIF      
0503                          IFN   CPM   
                              LXI   H,PROG   ; the heap starts after the program's NUL
                    FNUL:     MOV   A,M   
                              INX   H   
                              ORA   A   
                              JNZ   fnul   
0503                          ENDIF      
0503   22 7C 08               SHLD   HEAP   
0506                          IF   CHECKED   
                              RST   4   ; minus the heap"s first address: "_' may not
                              SHLD   NPEND   ;   release below it
0506                          ENDIF      
0506   21 E0 06               LXI   H,RSTOP   ; the return stack is empty
0509   22 34 08               SHLD   RSP   
050C                          IF   (1-CHECKED)*(1-CPM)   
                              MOV   H,A   ; (A = 0, from the search for the NUL) no key
                              MOV   L,A   ;   is held, and the break key is on (the
050C                          ENDIF      ;   checked build has cleared these)
050C                          IF   (1-CHECKED)*CPM   
050C   21 00 00               LXI   H,0   
050F                          ENDIF      
050F                          IF   1-CHECKED   
050F   22 7A 08               SHLD   KEYBUF   
0512                          ENDIF      
0512   01 00 09               LXI   B,PROG   ; the IP
0515   F7                     RST   6   ; (its return address is thrown away)
0516                          IF   CPM   
0516                             ; RAM pages, after the image
0516                RSPAGE:   EQU   (imgend + 255) / 256   
0516                DSPAGE:   EQU   RSPAGE + 1   
0516                LETPAGE:   EQU   RSPAGE + 2   
0516                PROG:     EQU   LETPAGE*256 + 256   
0516                          ENDIF      
0516                IMGEND:      


