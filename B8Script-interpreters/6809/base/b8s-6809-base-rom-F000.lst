F244                             ; "?" ( n -- c ) or ( -n -- addr )
F244                             ;   n > 0: wait about n ms for a key; 0 if none came
F244                             ;   n = 0: wait for a key
F244                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
F244                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
F244   AE C4        H_KEY:    LDX   ,U   
F246   2B 17                  BMI   line   
F248   C6 14        KT1:      LDB   #MSLOOP   ; one millisecond, roughly
F24A   BD F0 F3     KT2:      JSR   getk   
F24D   26 0B                  BNE   kt3   
F24F   5A                     DECB      
F250   26 F8                  BNE   kt2   
F252   30 1F                  LEAX   -1,X   
F254   26 F2                  BNE   kt1   ; A = 0 if the time ran out
F256   AE C4                  LDX   ,U   ; 0?: the countdown from 0 took 65536 ms;
F258   27 EE                  BEQ   kt1   ;   run it again, until a key comes
F25A   6F C4        KT3:      CLR   ,U   
F25C   A7 41                  STA   1,U   
F25E   39                     RTS      
F25F                             ; Backspace takes the last character back (and is echoed as it is), CR ends
F25F                             ; (stored, not echoed), every other key is stored and echoed until the line
F25F                             ; is full. B = the length so far; the low byte of the top cell becomes the
F25F                             ; most allowed (it holds minus the count on entry).
F25F   8C FF 81     LINE:     CMPX   #-127   ; (X = TOS, minus the count)
