   193 0000024A FF55E2              <2>  call [V(p_%1)]
   194                              <2>  %else
   195                              <2>  call %1
   196                              <2>  %endif
   781 0000024D 7317                <1>         jnc     .ex
   782 0000024F 8803                <1> .hx1:   mov     [ebx],al                ; the high digit goes in first ...
   783                              <1>         CALLP   hexc
   192                              <2>  %if P_%1
   193 00000251 FF55E2              <2>  call [V(p_%1)]
   194                              <2>  %else
