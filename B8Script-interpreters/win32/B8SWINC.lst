   737 000001FD 89C2                <1>         mov     edx,eax                 ;   lowercase lands 64 bytes up
   738 000001FF 24DF                <1>         and     al,0DFh                 ; (fold case)
   739 00000201 3C1A                <1>         cmp     al,26
