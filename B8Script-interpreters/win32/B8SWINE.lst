   704                              <1> ; '?' ( n -- c ) or ( -n -- addr )
   705                              <1> ;   n > 0: wait about n ms for a key; 0 if none came
   706                              <1> ;   n = 0: wait for a key
   707                              <1> ;   n < 0: read a line of at most -n characters (127 at most), with echo
