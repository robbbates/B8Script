                              RTS      
E46D                          ENDIF      
E46D                             ; pesc: the escapes of "$". A = the character after the "/", 60h to 7Eh, and
E46D                             ; the carry is clear. Each returns into the loop.
E46D                             ;    /a-/z   print the variable, as "#" does
E46D                             ;    /{      clear the screen, the cursor to the top left
E46D                             ;    /}      clear from the cursor to the end of the line
E46D                             ;    /|  /`  show the cursor, hide it
E46D                             ;    /~      ( row col addr -- addr ): the cursor to that row and column,
E46D                             ;            from 0. The two cells under the string's address go.
E46D                             ; A - 7Bh sorts them: 00bbIDAsIHwgMSwg 2, ~ 3 with the carry set, and ` E5h, a-z
E46D                             ; E6h-FFh with it clear.
E46D                          IF   1-ANSI   
E46D                             ; With ANSI = 0 the machine's routines do the work.
E46D   E9 7A        PESC:     SBC   #7Ah   ; (the carry is clear: - 7Bh)
E46F   90 0D                  BCC   pe1   
E471   F0 08                  BEQ   pcls   ; {
E473   4A                     LSR      ; | 0, } 1, ~ 1; the carry set for | and ~
E474   F0 0C                  BEQ   pcur   ; |  show: the carry is set
E476   B0 18                  BCS   pat   ; ~
E478   4C 0F FF               JMP   CONEOL   ; }
E47B   4C 0C FF     PCLS:     JMP   CONCLS   
E47E   C9 E6        PE1:      CMP   #0E6h   
E480   B0 03                  BCS   pvar   
E482   4C 12 FF     PCUR:     JMP   CONCUR   ; `  hide: the carry is clear
E485                          ENDIF      
E485                             ; a-z: the carry is set. A + 3Ah is the letter - 41h, as step hands it to
E485                             ; lower: that pushes the variable"s address, "@" fetches it, and "#' prints
E485                             ; it and drops it: TOS is the string's address again.
E485   69 39        PVAR:     ADC   #39h   
E487   20 2B E5               JSR   lowp   
E48A   20 91 E2               JSR   h_fetch   
E48D   4C 7C E0               JMP   h_num   
E490                          IF   ANSI   
                                 ; With ANSI = 1 they are sequences, each a message at MSG, printed by prs,
                                 ; which pesc runs on into.
                    PESC:     LDY   #M_CLS-MSG   
                              SBC   #7Ah   ; (the carry is clear: - 7Bh)
                              BCC   pe1   
                              BEQ   prs   ; {  ESC [ H ESC [ J
                              LDY   #M_SHOW-MSG   
                              LSR      ; | 0, } 1, ~ 1; the carry set for ~
                              BEQ   prs   ; |  ESC [ ? 2 5 h
                              BCS   pat   ; ~
                              LDY   #M_EOL-MSG   ; }  ESC [ K
                              BNE   prs   ; always
                    PE1:      CMP   #0E6h   
                              BCS   pvar   
                              LDY   #M_HIDE-MSG   ; `  ESC [ ? 2 5 l, and on into prs
E490                          ENDIF      
E490                          IF   CHECKED+ANSI   
                                 ; prs: print the message at MSG+Y; its last byte has bit 7 set. Y ends just
                                 ; past it, at the next message.
                    PRS:      LDA   MSG,Y   
                              PHA      
                              AND   #7Fh   
                              JSR   CONOUT   
                              INY      
                              PLA      
                              BPL   prs   
                              RTS      
E490                          ENDIF      
E490                             ; /~: the row is at 4,X, the column at 2,X, the string's address at 0,X.
E490                PAT:         
E490                          IF   CHECKED   
                              CPX   #DSE-5   ; fewer than two cells under TOS: s
                              BCS   e_sund   
E490                          ENDIF      
E490                          IF   1-ANSI   
E490   B5 04                  LDA   4,X   ; the row
E492   B4 02                  LDY   2,X   ; the column
E494   20 15 FF               JSR   CONAT   
E497   20 9A E4               JSR   nip   ; two nips leave the address, 4 bytes up
E49A   20 B4 E0     NIP:      JSR   h_swap   ; nip: ( a b -- b )
E49D   4C 65 E1               JMP   drop   
E4A0                          ENDIF      
E4A0                          IF   ANSI   
                                 ; ESC [ row+1 ; col+1 H (ANSI counts from 1). Three swaps put the row on top
                                 ; and the address under the column: "#" prints the row and drops it, prints
                                 ; the column and drops it, and TOS is the string's address again.
                              JSR   h_swap   
                              INX      
                              INX      
                              JSR   h_swap   
                              DEX      
                              DEX      
                              JSR   h_swap   
                              LDY   #M_CSI-MSG   
                              JSR   prs   ; ESC [
                              JSR   inctos   
                              JSR   h_num   ; the row + 1
                              LDA   #";"   
                              JSR   CONOUT   
                              JSR   inctos   
                              JSR   h_num   ; the column + 1
                              LDA   #"H"   
                              JMP   CONOUT   
E4A0                          ENDIF      
E4A0                          IF   CHECKED   
                                 ; The checked build's inner loop, out of page 1, where it would not fit,
                                 ; and its break check (described with the unchecked one in page 1).
                                 ; pnext: the break check, then (falling through) next. A word call, a true
                                 ; "(" and a true ")" end here, but the keyboard is looked at only once in 256
                                 ; of them: CDOWN counts them down. A key found is held; a Ctrl-C goes on to ctlc. (Startup
                                 ; falls in here too, which does no harm.)
                    PNEXT:    DEC   CDOWN   
                              BNE   next   
                    PKEY:     JSR   KEY   
                              BEQ   next   ; no key
                              STA   KEYBUF   ; held for the next "?"
                              JSR   chk3   ; (Ctrl-C: back only if the break key is off)
                    NEXT:        
E4A0                          ENDIF      
E4A0                          IF   CHECKED*FAST   
                              JMP   fnext   ; (the fast build: see "The fast build")
E4A0                          ENDIF      
E4A0                          IF   CHECKED*(1-FAST)   
                                 ; Both stacks are checked once per character, after it has run. The
                                 ; return stack has overrun when S is below RSLIM: an overflow leaves
                                 ; it at 1Eh or 1Fh, an underflow wraps it to 01h (no handler pulls
                                 ; more than one entry). The data stack has when X is above DSE (an
                                 ; underflow) or below DSFULL (an overflow). No handler moves X by
                                 ; more than 4 (but "$", whose /~ escapes each look first), so X is
                                 ; caught before it wraps; an overrun by a cell or two writes on the
                                 ; scratch bytes below or above the stack.
                                 ; S is kept in RSV, for the report's R: line (an error found inside
                                 ; a handler has its own calls on the hardware stack), and the place
                                 ; of the character about to run in PLACE.
                              TXA      ; TSX trashes X: keep it in A
                              TSX      
                              STX   RSV   
                              CPX   #RSLIM   
                              TAX      ; TAX leaves the carry alone
                              BCC   e_rstack   
                              CPX   #DSE+1   
                              BCS   e_sund   
                              CPX   #DSFULL   
                              BCC   e_sovr   
                              LDA   IP   
                              STA   PLACE   
                              LDA   IP+1   
                              STA   PLACE+1   
                              JSR   step   
                              JMP   next   
E4A0                          ENDIF      
E4A0                          IF   CHECKED   
                                 ; S/R are overflows, s/r underflows. After an underflow that stack counts as
                                 ; empty.
                    E_RSTACK:   LDA   RSV   
                              CMP   #10h   
                              LDA   #"R"   
                              BCS   ejmp   ; S is 1Eh-1Fh: an overflow
                              LDA   #0FFh   
                              STA   RSV   ; S wrapped to 01h: R:0
                              LDA   #"r"   
                              BNE   ejmp   ; always
                    E_SUND:   LDX   #DSE   ; D:0
                              LDA   #"s"   
                              DB   2Ch   ; (BIT abs: hides the next instruction)
                    E_SOVR:   LDA   #"S"   
                    EJMP:     JMP   error   
                                 ; skip, checked: as the unchecked one above, and A holds, on the way in, the wrong closer for the
                                 ; opener that started the skip, kept in T0: ] for (, ) for [, and 0 for \,
                                 ; which takes either. Meeting the wrong closer at this level, or the end
                                 ; (a NUL, or a string that runs into it), stops with N, except for \,
                                 ; which then ends the program as before.
E4A0                          ENDIF      
E4A0                          IF   CHECKED*(1-QK)   
                    SKIP:     STA   T0   
                              LDA   #0   
                              STA   T2   ; depth
                    SK1:      JSR   getc   
                              BEQ   sknul   
                              CMP   #22h   
                              BNE   sk2   
                              JSR   skipstr   ; leaves A = 11h, which matches nothing below
                              BEQ   sknul   ; the string ran into the end
                    SK2:      CMP   #"("   
                              BEQ   sk3   
                              CMP   #"["   
                              BEQ   sk3   
                              CMP   #")"   
                              BEQ   sk4   
                              CMP   #"]"   
                              BNE   sk1   
                    SK4:      DEC   T2   
                              BPL   sk1   
                              CMP   T0   
                              BEQ   e_nest   ; the wrong kind
                              RTS      ; the closer at this level
                    SK3:      INC   T2   
                              BNE   sk1   
E4A0                          ENDIF      
E4A0                          IF   CHECKED   
                    SKNUL:    LDA   T0   
                              BNE   e_nest   ; ( and [ stop with N
                              JMP   EXIT   ; \ ends the program
                    E_NEST:   LDA   #"N"   ; a skip from ( or [ found the wrong closer
                              JMP   error   ;   or the end: the place is the opener
E4A0                          ENDIF      
E4A0                          IF   1-CHECKED   
E4A0                CBREAK:   EQU   endp   ; the unchecked build stops without a word
E4A0                          ENDIF      
E4A0                          IF   CHECKED   
                    CBREAK:   EQU   e_break   ; the checked build reports B
E4A0                          ENDIF      
E4A0                             ; getk: a key for "?" in A (zero flag clear), or A = 0 with the zero flag
E4A0                             ; set when there is none. Keeps X and Y. The held key goes first, and is
E4A0                             ; taken out of KEYBUF.
E4A0   AD 7A 04     GETK:     LDA   KEYBUF   
E4A3   F0 08                  BEQ   gk1   
E4A5   48                     PHA      
E4A6   A9 00                  LDA   #0   
E4A8   8D 7A 04               STA   KEYBUF   
E4AB   68                     PLA      
E4AC   60                     RTS      
E4AD   20 06 FF     GK1:      JSR   KEY   
E4B0   F0 04                  BEQ   gk9   
E4B2                             ; chk3: a key in A (not 0). A Ctrl-C goes on to ctlc, which gives the 03h
E4B2                             ; back if it comes back at all.
E4B2   C9 03        CHK3:     CMP   #3   
E4B4   F0 01                  BEQ   ctlc   
E4B6   60           GK9:      RTS      
E4B7                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
E4B7                             ; the program has turned it off, wait about 250 ms (about 250 times MSLOOP
E4B7                             ; looks: T1 counts the 256s, T2 runs on from whatever it holds) for one more
E4B7                             ; key: a second Ctrl-C is the end too; any other key is held (the newest
E4B7                             ; wins). Returns A = 03h with the zero flag clear. Keeps X and Y.
E4B7   AD 7B 04     CTLC:     LDA   BRKOFF   
E4BA   F0 5D                  BEQ   cbreak   
E4BC   A9 28                  LDA   #CWAIT+1   
E4BE   85 05                  STA   T1   
E4C0   20 06 FF     CT2:      JSR   KEY   
E4C3   D0 0A                  BNE   ct3   
E4C5   C6 06                  DEC   T2   
E4C7   D0 F7                  BNE   ct2   
E4C9   C6 05                  DEC   T1   
E4CB   D0 F3                  BNE   ct2   
E4CD   F0 07                  BEQ   ct9   ; always: none came
E4CF   C9 03        CT3:      CMP   #3   
E4D1   F0 46                  BEQ   cbreak   
E4D3   8D 7A 04               STA   KEYBUF   
E4D6   A9 03        CT9:      LDA   #3   
E4D8   60                     RTS      
E4D9                          IF   CHECKED   
                    E_BREAK:   LDA   #"B"   ; Ctrl-C (the stacks as they stand)
                              DB   2Ch   ; (BIT abs: hides the next instruction)
                    E_RESV:   LDA   #"X"   ; a reserved byte, 80h-FFh
                    EJMP2:    JMP   error   
                                 ; e_undef: the word cells of undefined words hold 0000h. A call there reads
                                 ; the byte at 0000h, which is IP's own low byte: 00h while IP is 0000h, so
                                 ; the call reads a NUL with IP in page zero, where no program can be. The
                                 ; call is undone first: the step frame and the return address come off the
                                 ; hardware stack, and the place is the call letter (the return address - 1).
                    E_UNDEF:   PLA      
                              PLA      ; the step frame
                              PLA      
                              SEC      
                              SBC   #1   
                              STA   PLACE   
                              PLA      
                              SBC   #0   
                              STA   PLACE+1   
                              INC   RSV   
                              INC   RSV   ; R: does not count the call
                              LDA   #"U"   
                              BNE   ejmp2   ; always
E4D9                          ENDIF      
E4D9                             ; step: read one character and sort it by range.
E4D9                             ;    00h          end of program
E4D9                             ;    01h-20h, 7Fh-FFh   ignored
E4D9                             ;    30h-39h      digit: read a whole number
E4D9                             ;    41h-5Ah      A-Z: call the word in that letter's cell
E4D9                             ;    61h-7Ah      a-z: push the address of that letter's cell
E4D9                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
E4D9   20 A8 E5     STEP:     JSR   getc   ; flags follow A
E4DC   F0 3B                  BEQ   endp   
E4DE   38                     SEC      
E4DF   E9 21                  SBC   #21h   ; A = c - 21h
E4E1   90 35                  BCC   ign   ; 01h-20h
E4E3   C9 0F                  CMP   #0Fh   
E4E5   90 22                  BCC   punct   ; 21h-2Fh: index 0-14
E4E7   E9 0F                  SBC   #0Fh   ; (carry set) A = c - 30h
E4E9   C9 0A                  CMP   #10   
E4EB   90 6F                  BCC   digit   
E4ED   C9 11                  CMP   #11h   
E4EF   90 16                  BCC   p3a   ; 3Ah-40h
E4F1   E9 11                  SBC   #11h   ; (carry set) A = c - 41h
E4F3   C9 1A                  CMP   #1Ah   
E4F5   90 25                  BCC   upper   ; 41h-5Ah
E4F7   C9 20                  CMP   #20h   
E4F9   90 0A                  BCC   p5b   ; 5Bh-60h
E4FB   C9 3A                  CMP   #3Ah   
E4FD   90 29                  BCC   lower   ; 61h-7Ah: A = 20h-39h
E4FF   C9 3E                  CMP   #3Eh   
E501                          IF   1-CHECKED   
E501   B0 15                  BCS   ign   ; 7Fh-FFh
E503                          ENDIF      
E503                          IF   CHECKED   
                              BEQ   ign   ; 7Fh
                              BCS   e_resv   ; 80h-FFh: reserved
E503                          ENDIF      
E503                             ; The three adjustments below chain. Each ADC adds the carry the one
E503                             ; before it left, which the constants allow for.
E503   E9 1A                  SBC   #1Ah   ; 7Bh-7Eh: (carry clear: -1Bh) index 28-31
E505   69 F6        P5B:      ADC   #0F6h   ; 5Bh-60h: -10 (-9 when chained), index 22-27
E507   69 05        P3A:      ADC   #5   ; 3Ah-40h: +5 (+6 when chained), index 15-21
E509                             ; Punctuation: A = the index. The handler's page is the first, plus one if
E509                             ; the index is N1 or more, plus one more if it is N2 or more.
E509   C9 08        PUNCT:    CMP   #N1   
E50B   A8                     TAY      
E50C   A9 70                  LDA   #HALFPG   
E50E   2A                     ROL      ; the first page, or the second (carry clear)
E50F   C0 15                  CPY   #N2   
E511   69 00                  ADC   #0   ; ... or the third (and the carry is clear)
E513   48                     PHA      
E514   B9 3C E5               LDA   PTAB,Y   
E517   48                     PHA      
E518   60           IGN:      RTS      ; RTS trick: goes to the handler. Reached
E519                             ; directly, it just ends an ignored character.
E519                ENDP:        ; the program has ended
E519                          IF   CHECKED   
                              LDA   IP+1   ; IP in page zero: an undefined word
                              BEQ   e_undef   
E519                          ENDIF      
E519   4C 09 FF               JMP   EXIT   
E51C                             ; A-Z: call the word. The return address (the IP after the letter) goes on
E51C                             ; the return stack, and the IP becomes the address in the letter's cell.
E51C   0A           UPPER:    ASL      
E51D   A8                     TAY      
E51E   38                     SEC      
E51F   4C D5 E0               JMP   pushn   
E522   A5 00        PUSHIP:   LDA   IP   ; push the reading position
E524   A4 01                  LDY   IP+1   
E526   D0 06                  BNE   pushay   ; always: no program is in page zero
E528                             ; a-z: push the cell's address (the cell is the variable)
E528                             ;  (the unchecked QK builds do x@ and x! in one step: lowq)
E528                          IF   SBASEU   
E528   4C 26 E3     LOWER:    JMP   lowq   
E52B                LOWP:        
E52B                          ENDIF      
E52B                          IF   1-SBASEU   
                    LOWER:       
                    LOWP:        
E52B                          ENDIF      
E52B   0A                     ASL      
E52C   A0 04                  LDY   #>LET   
E52E                             ; pushay: push a cell: A = its low byte, Y = its high byte
E52E   CA           PUSHAY:   DEX      
E52F   CA                     DEX      
E530   95 00        SETAY:    STA   0,X   ; setay: TOS = A (low), Y (high)
E532   94 01                  STY   1,X   
E534   60                     RTS      
E535                             ; flag: pops TOS and returns with Z set if it was 0. Keeps the carry.
E535   E8           FLAG:     INX      
E536   E8                     INX      
E537   B5 FE                  LDA   0FEh,X   
E539   15 FF                  ORA   0FFh,X   
E53B   60                     RTS      
E53C                             ; =============================================================================
E53C                             ;  Dispatch table: the low byte of (handler - 1) for each punctuation
E53C                             ;  character, in code order.
E53C                             ; =============================================================================
E53C   A7           PTAB:     DB   (h_store-1) & 0FFh   ; !
E53D   5F                     DB   (h_str-1) & 0FFh   ; "
E53E   7B                     DB   (h_num-1) & 0FFh   ; #
E53F   41                     DB   (h_print-1) & 0FFh   ; $
E540   B3                     DB   (h_swap-1) & 0FFh   ; %
E541   C4                     DB   (h_and-1) & 0FFh   ; &
E542   73                     DB   (h_emit-1) & 0FFh   ; '
E543   CF                     DB   (h_open-1) & 0FFh   ; (
E544   D5                     DB   (h_close-1) & 0FFh   ; )
E545   A6                     DB   (h_mul-1) & 0FFh   ; *
E546   70                     DB   (h_add-1) & 0FFh   ; +
E547   CC                     DB   (h_cfetch-1) & 0FFh   ; ,
E548   67                     DB   (h_sub-1) & 0FFh   ; -
E549   5E                     DB   (h_cstore-1) & 0FFh   ; .
E54A   A9                     DB   (h_div-1) & 0FFh   ; /
E54B   57                     DB   (h_dup-1) & 0FFh   ; :
E54C   64                     DB   (drop-1) & 0FFh   ; ;
E54D   85                     DB   (h_lt-1) & 0FFh   ; <
E54E   96                     DB   (h_eq-1) & 0FFh   ; =
E54F   82                     DB   (h_gt-1) & 0FFh   ; >
E550   DD                     DB   (h_key-1) & 0FFh   ; ?
E551   90                     DB   (h_fetch-1) & 0FFh   ; @
E552   A6                     DB   (h_def-1) & 0FFh   ; [
E553   3A                     DB   (h_break-1) & 0FFh   ; \
E554   4C                     DB   (h_ret-1) & 0FFh   ; ]
E555   7A                     DB   (h_xor-1) & 0FFh   ; ^
E556   F6                     DB   (h_alloc-1) & 0FFh   ; _
E557   C8                     DB   (h_grave-1) & 0FFh   ; `
E558   5E                     DB   (h_tor-1) & 0FFh   ; {
E559   85                     DB   (h_or-1) & 0FFh   ; |
E55A   6A                     DB   (h_fromr-1) & 0FFh   ; }
E55B   77                     DB   (h_not-1) & 0FFh   ; ~
E55C                             ; Digits: the first one is in A; read the rest of the number.
E55C   A0 00        DIGIT:    LDY   #0   
E55E   20 2E E5               JSR   pushay   
E561                             ; rdnum: TOS = TOS*10 + digit for each digit at IP. Wraps at 16 bits.
E561                             ; Returns with the carry set.
E561   20 8E E5     RDNUM:    JSR   isdig   
E564   B0 4D                  BCS   ic9   ; (an RTS)
E566   20 AB E5               JSR   incip   ; (keeps A = the digit)
E569   16 00                  ASL   0,X   
E56B   36 01                  ROL   1,X   ; x2
E56D   18                     CLC      
E56E   75 00                  ADC   0,X   
E570   85 04                  STA   T0   
E572   B5 01                  LDA   1,X   
E574   69 00                  ADC   #0   
E576   A8                     TAY      ; Y:T0 = x2 + digit
E577   16 00                  ASL   0,X   
E579   36 01                  ROL   1,X   
E57B   16 00                  ASL   0,X   
E57D   36 01                  ROL   1,X   ; x8
E57F   18                     CLC      
E580   B5 00                  LDA   0,X   
E582   65 04                  ADC   T0   
E584   95 00                  STA   0,X   
E586   98                     TYA      
E587   75 01                  ADC   1,X   
E589   95 01                  STA   1,X   ; x8 + x2 + digit
E58B   4C 61 E5               JMP   rdnum   
E58E                             ; isdig: A = the character at IP minus "0"; the carry is clear if it is a
E58E                             ; digit. Y = 0.
E58E   20 B4 E5     ISDIG:    JSR   peek   
E591   38                     SEC      
E592   E9 30                  SBC   #"0"   
E594   C9 0A                  CMP   #10   
E596   60                     RTS      
E597                             ; rdhex: if IP is at a hex digit (0-9, A-F, a-f), return its value in A with
E597                             ; the carry clear and IP moved on; otherwise the carry is set and IP stays.
E597   20 8E E5     RDHEX:    JSR   isdig   
E59A   90 0F                  BCC   incip   
E59C   29 DF                  AND   #0DFh   
E59E   E9 11                  SBC   #11h   ; (the carry is set)
E5A0   C9 06                  CMP   #6   
E5A2   B0 0F                  BCS   ic9   
E5A4   69 0A                  ADC   #10   
E5A6   D0 03                  BNE   incip   ; always
E5A8                             ; Reading the program
E5A8                             ;    peek: A = the character at IP, IP unchanged, Y = 0
E5A8                             ;    getc: the same, then IP moves on; flags follow A
E5A8                             ;    incip: IP moves on; keeps A, the carry and Y
E5A8   20 B4 E5     GETC:     JSR   peek   
E5AB   E6 00        INCIP:    INC   IP   
E5AD   D0 02                  BNE   ic1   
E5AF   E6 01                  INC   IP+1   
E5B1   09 00        IC1:      ORA   #0   
E5B3   60           IC9:      RTS      
E5B4   A0 00        PEEK:     LDY   #0   
E5B6   B1 00                  LDA   (IP),Y   
E5B8   60                     RTS      
E5B9                             ; rstip: point IP at the start of the program
E5B9   A9 00        RSTIP:    LDA   #<PROG   
E5BB   85 00                  STA   IP   
E5BD   A9 05                  LDA   #>PROG   
E5BF   85 01                  STA   IP+1   
E5C1   60                     RTS      
E5C2                          IF   CHECKED   
                                 ; =============================================================================
                                 ;  Checked build: the error report
                                 ; =============================================================================
                                 ; error: the report, then EXIT. A = the letter, PLACE = the place, X = the
                                 ; data stack to show, RSV = S for the R: line. Nothing here relies on S: an
                                 ; overflowed or underflowed hardware stack wraps inside its page, and only
                                 ; its depth is shown.
                                 ;   CR LF
                                 ;   Err X @ line,col CR LF
                                 ;   D:n: [...] and the top 8 cells at most, bottom to top  CR LF
                                 ;   R:n CR LF
                                 ; The numbers go through "#" (prnum), which pushes them over the data stack
                                 ; and pops them again, so the stack is shown as it was. With the stack full
                                 ; (X = 0Eh) that reaches down to 0Ah, so nothing the report keeps is there.
                    ERROR:    PHA      ; the letter
                              LDA   PLACE   
                              STA   P   
                              LDA   PLACE+1   
                              STA   P+1   ; (CO is the report's scratch from here on)
                              LDY   #M_ERR-MSG   
                              JSR   prs   ; CR LF "Err "
                              PLA      
                              JSR   CONOUT   
                              JSR   prs   ; " @ " (it follows M_ERR)
                              JSR   lcol   
                              LDA   LN   
                              LDY   LN+1   
                              JSR   prnum   ; the line
                              LDA   #","   
                              JSR   CONOUT   
                              LDA   CO   
                              LDY   CO+1   
                              JSR   prnum   ; the column
                              LDY   #M_STK-MSG   
                              JSR   prs   ; CR LF "D:"
                              TXA      
                              EOR   #0FFh   
                              SEC      
                              SBC   #0FFh-DSE   
                              LSR      ; the depth, (DSE - X) / 2
                              PHA      
                              JSR   prnum8   
                              PLA      
                              LDY   #M_C-MSG   ; ":"
                              CMP   #9   
                              BCC   er3   
                              LDA   #8   ; more than 8: ": ..." and the top 8
                              LDY   #M_CD-MSG   
                    ER3:      STA   CO   ; CO = how many cells to show
                              JSR   prs   
                    ER4:      LDA   CO   ; cells CO-1 down to 0, the top last: cell i
                              BEQ   er5   ;   from the top is at X+2i
                              DEC   CO   
                              LDA   #" "   
                              JSR   CONOUT   
                              LDA   CO   
                              ASL      
                              STA   CO+1   
                              TXA      
                              ADC   CO+1   ; (the carry is clear)
                              TAY      
                              LDA   0,Y   
                              PHA      
                              LDA   1,Y   
                              TAY      
                              PLA      
                              JSR   prnum   
                              JMP   er4   
                    ER5:      LDY   #M_RTN-MSG   
                              JSR   prs   ; CR LF "R:"
                              LDA   RSV   
                              EOR   #0FFh   
                              LSR      ; (FFh - S) / 2 entries
                              JSR   prnum8   
                              LDY   #M_NL-MSG   
                              JSR   prs   
                              JMP   EXIT   
                                 ; prnum: print the number A (low), Y (high), signed, keeping the data stack.
                                 ; prnum8: the same for A alone, 0-255.
                    PRNUM8:   LDY   #0   
                    PRNUM:    JSR   pushay   
                              JMP   h_num   
E5C2                          ENDIF      
E5C2                          IF   CHECKED+ANSI   
                    MSG:         
E5C2                          ENDIF      
E5C2                          IF   ANSI   
                    M_CLS:    DB   27,"[","H",27,"[","J"+80h   
                    M_SHOW:   DB   27,"[","?","2","5","h"+80h   
                    M_HIDE:   DB   27,"[","?","2","5","l"+80h   
                    M_EOL:    DB   27,"[","K"+80h   
                    M_CSI:    DB   27,"["+80h   
E5C2                          ENDIF      
E5C2                          IF   CHECKED   
                    M_ERR:    DB   13,10,"Err"," "+80h   
                              DB   " @"," "+80h   
                    M_NL:     DB   13,10+80h   
                    M_STK:    DB   13,10,"D",":"+80h   
                    M_CD:     DB   ": ..","."+80h   
                    M_C:      DB   ":"+80h   
                    M_RTN:    DB   13,10,"R",":"+80h   
E5C2                          ENDIF      
E5C2                          IF   CHECKED   
                                 ; lcol: the line (LN) and the column (CO) of the place at P, both from
                                 ; 1. A place below the program is in the -n? line buffer: line 0, and the
                                 ; column is the place in the buffer. Otherwise IP (free now: the program has
                                 ; stopped) runs from PROG to the place, counting LFs; CO keeps where the
                                 ; last line started, and the column is the place minus that, plus 1.
                    LCOL:     LDA   #0   
                              STA   LN+1   
                              STA   LN   
                              LDA   #<LINEBUF   
                              STA   CO   
                              LDA   #>LINEBUF   
                              STA   CO+1   
                              LDA   P   
                              CMP   #<PROG   
                              LDA   P+1   
                              SBC   #>PROG   
                              BCC   lc9   ; below the program: line 0
                              INC   LN   
                              JSR   rstip   
                    LC3:      LDA   IP   ; a line starts here
                              STA   CO   
                              LDA   IP+1   
                              STA   CO+1   
                    LC1:      LDA   IP   
                              CMP   P   
                              LDA   IP+1   
                              SBC   P+1   
                              BCS   lc9   ; at the place
                              JSR   getc   
                              CMP   #10   
                              BNE   lc1   
                              INC   LN   ; an LF: a new line starts after it
                              BNE   lc3   
                              INC   LN+1   
                              BNE   lc3   ; always
                    LC9:      LDA   P   
                              SEC      
                              SBC   CO   
                              STA   CO   
                              LDA   P+1   
                              SBC   CO+1   
                              STA   CO+1   
                              INC   CO   ; + 1
                              BNE   lc8   
                              INC   CO+1   
                    LC8:      RTS      
E5C2                          ENDIF      
E5C2                             ; =============================================================================
E5C2                             ;  The fast build (SPEED = 2)
E5C2                             ; 
E5C2                             ;  The inner loop is a table: 256 entries, the low bytes of the handlers'
E5C2                             ;  addresses in one page (DTL) and the high bytes in the next (DTH). The
E5C2                             ;  dispatcher, NEXTF, is inline at the end of the fast build's own entries,
E5C2                             ;  so there is no JSR and no RTS per character:
E5C2                             ;      LDY #0 / LDA (IP),Y / INC IP / BNE $+4 / INC IP+1 / TAY /
E5C2                             ;      LDA DTL,Y / STA V / LDA DTH,Y / STA V+1 / JMP (V)
E5C2                             ;  The letters and digits have one entry each, which knows its cell or its
E5C2                             ;  value already; the commonest punctuation is written for the table; the
E5C2                             ;  rest reach the ordinary handlers through a thunk (CLC / JSR handler /
E5C2                             ;  NEXTF, or JMP fnext for the rare ones), which gives them the step frame
E5C2                             ;  and the clear carry they expect.
E5C2                             ;  The ordinary handlers that end at next or pnext go to fnext, the same
E5C2                             ;  dispatcher. In the checked build NEXTF is JMP fnext, which checks the
E5C2                             ;  stacks first, as next does in the other builds.
E5C2                             ;  Everything here is read-only: the image can be ROM, as the others are.
E5C2                             ;  The table takes the image's first two pages (E000h-E1FFh); the code
E5C2                             ;  starts after it.
E5C2                             ; =============================================================================
E5C2                          IF   FAST   
                                 ; fnext: the dispatcher, after the checks of the checked build
                    FNEXT:       
E5C2                          ENDIF      
E5C2                          IF   FAST*CHECKED   
                                 ; (the same checks as next in the other checked builds)
                              TXA      ; TSX trashes X: keep it in A
                              TSX      
                              STX   RSV   
                              CPX   #RSLIM   
                              TAX      
                              BCS   fn1   
                              JMP   e_rstack   
                    FN1:      CPX   #DSE+1   
                              BCS   fn2   
                              CPX   #DSFULL   
                              BCS   fn3   
                              JMP   e_sovr   
                    FN2:      JMP   e_sund   
                    FN3:      LDA   IP   
                              STA   PLACE   
                              LDA   IP+1   
                              STA   PLACE+1   
E5C2                          ENDIF      
E5C2                          IF   FAST   
                              LDY   #0   
                              LDA   (IP),Y   
                              INC   IP   
                              BNE   fn4   
                              INC   IP+1   
                    FN4:      TAY      
                              LDA   DTL,Y   
                              STA   V   
                              LDA   DTH,Y   
                              STA   V+1   
                              JMP   (V)   
                                 ; fpoll: the break check of pnext, as a subroutine, for the entries that
                                 ; look at the keyboard (a word call, a true ( and a true ))
                    FPOLL:    JSR   KEY   
                              BEQ   fp9   ; no key
                              STA   KEYBUF   ; held for the next "?"
                              JMP   chk3   ; (Ctrl-C: back only if the break key is off)
                    FP9:      RTS      
                                 ; The thunks: the rest of the punctuation, through the ordinary handlers
                    FT_STR:   CLC      ; "
                              JSR   h_str   
                              JMP   fnext   ; (rare enough: the shared dispatcher)
                    FT_NUM:   CLC      ; #
                              JSR   h_num   
                              JMP   fnext   ; (rare enough: the shared dispatcher)
                    FT_PRT:   CLC      ; $
                              JSR   h_print   
                              JMP   fnext   ; (rare enough: the shared dispatcher)
                    FT_EMIT:   CLC      ; '
                              JSR   h_emit   
                              JMP   fnext   ; (rare enough: the shared dispatcher)
                    FT_DIV:   CLC      ; /
                              JSR   h_div   
                              ;*Macro unroll:  NEXTF
                              DS   1-CHECKED,0A0h   
                              DS   1-CHECKED,0   
                              DS   1-CHECKED,0B1h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0D0h   
                              DS   1-CHECKED,2   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP+1   
                              DS   1-CHECKED,0A8h   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTL&0FFh   
                              DS   1-CHECKED,ADTL/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTH&0FFh   
                              DS   1-CHECKED,ADTH/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V+1   
                              DS   1-CHECKED,6Ch   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0   
                              DS   CHECKED,4Ch   
                              DS   CHECKED,AFNX&0FFh   
                              DS   CHECKED,AFNX/256   
                    FT_KEY:   CLC      ; ?
                              JSR   h_key   
                              JMP   fnext   ; (rare enough: the shared dispatcher)
                    FT_DEF:   CLC      ; [
                              JSR   h_def   
                              ;*Macro unroll:  NEXTF
                              DS   1-CHECKED,0A0h   
                              DS   1-CHECKED,0   
                              DS   1-CHECKED,0B1h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0D0h   
                              DS   1-CHECKED,2   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP+1   
                              DS   1-CHECKED,0A8h   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTL&0FFh   
                              DS   1-CHECKED,ADTL/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTH&0FFh   
                              DS   1-CHECKED,ADTH/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V+1   
                              DS   1-CHECKED,6Ch   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0   
                              DS   CHECKED,4Ch   
                              DS   CHECKED,AFNX&0FFh   
                              DS   CHECKED,AFNX/256   
                    FT_BRK:   CLC      ; \
                              JSR   h_break   
                              ;*Macro unroll:  NEXTF
                              DS   1-CHECKED,0A0h   
                              DS   1-CHECKED,0   
                              DS   1-CHECKED,0B1h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0D0h   
                              DS   1-CHECKED,2   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP+1   
                              DS   1-CHECKED,0A8h   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTL&0FFh   
                              DS   1-CHECKED,ADTL/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTH&0FFh   
                              DS   1-CHECKED,ADTH/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V+1   
                              DS   1-CHECKED,6Ch   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0   
                              DS   CHECKED,4Ch   
                              DS   CHECKED,AFNX&0FFh   
                              DS   CHECKED,AFNX/256   
                    FT_ALC:   CLC      ; _
                              JSR   h_alloc   
                              JMP   fnext   ; (rare enough: the shared dispatcher)
                    FT_GRV:   CLC      ; `
                              JSR   h_grave   
                              JMP   fnext   ; (rare enough: the shared dispatcher)
                    FT_TOR:   CLC      ; {
                              JSR   h_tor   
                              JMP   fnext   ; (rare enough: the shared dispatcher)
                    FT_FRR:   CLC      ; }
                              JSR   h_fromr   
                              JMP   fnext   ; (rare enough: the shared dispatcher)
E5C2                          ENDIF      
E5C2                          IF   FAST*CHECKED   
                    FT_STO:   CLC      ; ! (checked: it checks the address)
                              JSR   h_store   
                              JMP   fnext   
                    FT_CST:   CLC      ; . (the same)
                              JSR   h_cstore   
                              JMP   fnext   
E5C2                          ENDIF      
E5C2                          IF   FAST   
                                 ; The commonest punctuation, written for the table
                    FS_ADD:   CLC      ; +
                              LDA   0,X   
                              ADC   2,X   
                              STA   2,X   
                              LDA   1,X   
                              ADC   3,X   
                              STA   3,X   
                              INX      
                              INX      
                              ;*Macro unroll:  NEXTF
                              DS   1-CHECKED,0A0h   
                              DS   1-CHECKED,0   
                              DS   1-CHECKED,0B1h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0D0h   
                              DS   1-CHECKED,2   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP+1   
                              DS   1-CHECKED,0A8h   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTL&0FFh   
                              DS   1-CHECKED,ADTL/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTH&0FFh   
                              DS   1-CHECKED,ADTH/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V+1   
                              DS   1-CHECKED,6Ch   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0   
                              DS   CHECKED,4Ch   
                              DS   CHECKED,AFNX&0FFh   
                              DS   CHECKED,AFNX/256   
                    FS_SUB:   LDY   #0   ; -
                              LDA   (IP),Y   
                              CMP   #3Ah   
                              BCS   fsb1   
                              CMP   #30h   
                              BCS   fsb2   ; a digit next: a negative number
                    FSB1:     SEC      
                              LDA   2,X   
                              SBC   0,X   
                              STA   2,X   
                              LDA   3,X   
                              SBC   1,X   
                              STA   3,X   
                              INX      
                              INX      
                              ;*Macro unroll:  NEXTF
                              DS   1-CHECKED,0A0h   
                              DS   1-CHECKED,0   
                              DS   1-CHECKED,0B1h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0D0h   
                              DS   1-CHECKED,2   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP+1   
                              DS   1-CHECKED,0A8h   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTL&0FFh   
                              DS   1-CHECKED,ADTL/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTH&0FFh   
                              DS   1-CHECKED,ADTH/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V+1   
                              DS   1-CHECKED,6Ch   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0   
                              DS   CHECKED,4Ch   
                              DS   CHECKED,AFNX&0FFh   
                              DS   CHECKED,AFNX/256   
                    FSB2:     JSR   negnum   
                              ;*Macro unroll:  NEXTF
                              DS   1-CHECKED,0A0h   
                              DS   1-CHECKED,0   
                              DS   1-CHECKED,0B1h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0D0h   
                              DS   1-CHECKED,2   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP+1   
                              DS   1-CHECKED,0A8h   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTL&0FFh   
                              DS   1-CHECKED,ADTL/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTH&0FFh   
                              DS   1-CHECKED,ADTH/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V+1   
                              DS   1-CHECKED,6Ch   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0   
                              DS   CHECKED,4Ch   
                              DS   CHECKED,AFNX&0FFh   
                              DS   CHECKED,AFNX/256   
                    FS_DUP:   LDA   0,X   ; :
                              LDY   1,X   
                              DEX      
                              DEX      
                              STA   0,X   
                              STY   1,X   
                              ;*Macro unroll:  NEXTF
                              DS   1-CHECKED,0A0h   
                              DS   1-CHECKED,0   
                              DS   1-CHECKED,0B1h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0D0h   
                              DS   1-CHECKED,2   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP+1   
                              DS   1-CHECKED,0A8h   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTL&0FFh   
                              DS   1-CHECKED,ADTL/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTH&0FFh   
                              DS   1-CHECKED,ADTH/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V+1   
                              DS   1-CHECKED,6Ch   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0   
                              DS   CHECKED,4Ch   
                              DS   CHECKED,AFNX&0FFh   
                              DS   CHECKED,AFNX/256   
                    FS_DRP:   INX      ; ;
                              INX      
                              ;*Macro unroll:  NEXTF
                              DS   1-CHECKED,0A0h   
                              DS   1-CHECKED,0   
                              DS   1-CHECKED,0B1h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0D0h   
                              DS   1-CHECKED,2   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP+1   
                              DS   1-CHECKED,0A8h   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTL&0FFh   
                              DS   1-CHECKED,ADTL/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTH&0FFh   
                              DS   1-CHECKED,ADTH/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V+1   
                              DS   1-CHECKED,6Ch   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0   
                              DS   CHECKED,4Ch   
                              DS   CHECKED,AFNX&0FFh   
                              DS   CHECKED,AFNX/256   
                    FS_SWP:   LDA   0,X   ; %
                              LDY   2,X   
                              STY   0,X   
                              STA   2,X   
                              LDA   1,X   
                              LDY   3,X   
                              STY   1,X   
                              STA   3,X   
                              ;*Macro unroll:  NEXTF
                              DS   1-CHECKED,0A0h   
                              DS   1-CHECKED,0   
                              DS   1-CHECKED,0B1h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0D0h   
                              DS   1-CHECKED,2   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP+1   
                              DS   1-CHECKED,0A8h   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTL&0FFh   
                              DS   1-CHECKED,ADTL/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTH&0FFh   
                              DS   1-CHECKED,ADTH/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V+1   
                              DS   1-CHECKED,6Ch   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0   
                              DS   CHECKED,4Ch   
                              DS   CHECKED,AFNX&0FFh   
                              DS   CHECKED,AFNX/256   
                    FS_FET:   LDA   (0,X)   ; @
                              TAY      
                              INC   0,X   
                              BNE   fft1   
                              INC   1,X   
                    FFT1:     LDA   (0,X)   
                              STA   1,X   
                              STY   0,X   
                              ;*Macro unroll:  NEXTF
                              DS   1-CHECKED,0A0h   
                              DS   1-CHECKED,0   
                              DS   1-CHECKED,0B1h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0D0h   
                              DS   1-CHECKED,2   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP+1   
                              DS   1-CHECKED,0A8h   
                              DS   1-CHECKED,0B9h   
