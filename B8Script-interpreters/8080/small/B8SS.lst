0241                          DS   (1-CPM)*(1-FAST),0F7h   
0241   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
0242   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
0243   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
0244   D1           H_AND:    POP   D   
0245   7C                     MOV   A,H   
0246   A2                     ANA   D   
0247   67                     MOV   H,A   
0248   7D                     MOV   A,L   
0249   A3                     ANA   E   
024A   6F                     MOV   L,A   
