E3E1                             ; Returns with the carry set.
E3E1   20 10 E4     RDNUM:    JSR   isdig   
E3E4   B0 4F                  BCS   ic9   ; (an RTS)
E3E6   20 2D E4               JSR   incip   ; (keeps A = the digit)
E3E9   16 00                  ASL   0,X   
E3EB   36 01                  ROL   1,X   ; x2
E3ED   18                     CLC      
E3EE   75 00                  ADC   0,X   
E3F0   85 04                  STA   T0   
E3F2   B5 01                  LDA   1,X   
E3F4   69 00                  ADC   #0   
E3F6   85 05                  STA   T1   ; T = x2 + digit
E3F8   16 00                  ASL   0,X   
E3FA   36 01                  ROL   1,X   
E3FC   16 00                  ASL   0,X   
E3FE   36 01                  ROL   1,X   ; x8
E400   18                     CLC      
E401   B5 00                  LDA   0,X   
E403   65 04                  ADC   T0   
E405   95 00                  STA   0,X   
