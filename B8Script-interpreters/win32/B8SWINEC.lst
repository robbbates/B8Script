   668                              <1> ; '"' pushes the address of the text after it and skips the string.
   669 000001BC 53                  <1> h_str:  push    ebx
   670 000001BD 89F3                <1>         mov     ebx,esi
   671 000001BF E821040000          <1>         call    skipstr
   672                              <1> %if CHECKED
   673 000001C4 84C0                <1>         test    al,al                   ; 0: the text ran out first
   674 000001C6 0F8448010000        <1>         jz      e_quote
   675                              <1> %endif
