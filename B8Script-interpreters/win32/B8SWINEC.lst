   547                              <1> ; ---- machine code: the grave -----------------------------------------------
   548                              <1> ; '`' plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
   549                              <1> ; are stored from addr until a non-hex character; then a RET (C3h) is
   550                              <1> ; written and its address is left. An odd last digit is consumed and its
   551                              <1> ; byte is overwritten by the RET. (Never range-checked: the spec says so.)
   552                              <1> ; '`' plus anything else calls the machine code at TOS: ( addr -- ).
   553                              <1> ;
   554                              <1> ; The machine-code contract: the code is entered by CALL, with the return
   555                              <1> ; address at [ESP] and the data stack above it: [ESP+4] is the top cell
   556                              <1> ; (the one under the address, which was consumed), [ESP+8] the next, one
   557                              <1> ; dword per cell, the cell in the low word. EBX holds the code's own
   558                              <1> ; address (ARENA + addr), and its high word is the arena's (0041h): a
   559                              <1> ; B8Script address a is the byte at ARENA + a. The code may push and pop
   560                              <1> ; dwords, and may change EAX, EBX, ECX, EDX and the flags; it must keep
   561                              <1> ; ESI, EDI and EBP, leave the direction flag clear, and return with RET
   562                              <1> ; (C3h, which the loader writes). On return the dword on top of the stack
   563                              <1> ; becomes TOS. Only the low word of each cell counts: the interpreter puts
   564                              <1> ; the arena's high word back into every cell on the stack.
   565 000001FD E8F8010000          <1> grave1: call    hexc
   566 00000202 731B                <1>         jnc     .ex
   567 00000204 8803                <1> .hx1:   mov     [ebx],al                ; the high digit goes in first ...
   568 00000206 E8EF010000          <1>         call    hexc
   569 0000020B 730D                <1>         jnc     .hx2                    ; odd digit: consumed, and the RET
   570 0000020D C02304              <1>         shl     byte [ebx],4            ;   overwrites it
   571 00000210 0803                <1>         or      [ebx],al                ; ... and the low one joins it
   572 00000212 43                  <1>         inc     ebx
   573 00000213 E8E2010000          <1>         call    hexc
   574 00000218 72EA                <1>         jc      .hx1
   575 0000021A C603C3              <1> .hx2:   mov     byte [ebx],0C3h
   576 0000021D FFE5                <1>         jmp     ebp
   577 0000021F FFD3                <1> .ex:    call    ebx
   578 00000221 89E0                <1>         mov     eax,esp                 ; (the stack holds one cell at least,
   579 00000223 66C740024100        <1> .ex1:   mov     word [eax+2],ARENA>>16  ;   the one that stands for TOS)
   580 00000229 83C004              <1>         add     eax,4
   581 0000022C 3B4566              <1>         cmp     eax,[V(v_dstop)]
   582 0000022F 72F2                <1>         jb      .ex1
   583 00000231 5B                  <1>         pop     ebx
   584 00000232 FFE5                <1>         jmp     ebp
   585                              <1> 
