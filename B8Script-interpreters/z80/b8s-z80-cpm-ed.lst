0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Spec: docs/b8script.md (2026-11-21).
0000                             ; 
0000                             ;  Three switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    EDITOR   1 = with a small line editor built in (see the end of this
0000                             ;                 file). It goes with either setting of the other two.
0000                             ;    CHECKED  0 = no checks (spec: the programmer is responsible)
0000                             ;             1 = starts with every variable at 0 and every word undefined,
0000                             ;                 and stops on every error in the spec's table (and Ctrl-C)
0000                             ;                 with a four-line report: the letter and the place as line
0000                             ;                 and column, the text there, and both stacks. See `error`.
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   1   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   0   ; 1 = checked build
0000                EDITOR:   EQU   1   ; 1 = with the line editor
0000                EDGEN:    EQU   EDITOR*(1-CPM)   ; (the generic build with the editor)
0000                TABP0:    EQU   EDGEN*(1-CHECKED)   ; (the build with its table in page zero)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    HL'  return-stack pointer (the alternate HL). Entries are 2 bytes; the
0000                             ;         stack grows down. Only rpop and rpushn (and the checks) touch it.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  One-byte calls. The routines used most are reached with RST, one byte
0000                             ;  instead of three:
0000                             ; 
0000                             ;    RST 08h  rpop    pop the return stack into DE
0000                             ;    RST 18h  drop    drop TOS, then next character     (ends a handler)
0000                             ;    RST 20h  neg16   HL = -HL
0000                             ;    RST 28h  putc    print A
0000                             ;    RST 30h  next    next character                    (ends a handler)
0000                             ; 
0000                             ;  RST 18h and RST 30h never return: an RST is a CALL, so the first thing
0000                             ;  each of them does is POP DE to throw the return address away.
0000                             ; 
0000                             ;  The CP/M build can't own page zero, so the block from `vecs` to `vecend`
0000                             ;  (image addresses 0108h-0133h) is copied to 0008h-0033h when it starts. The
0000                             ;  code in that block is written to work at either place.
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (the top four bytes of the page are spare,
0000                             ;             so a full stack runs two bytes into the page below)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch, interpreter variables in the gaps, and the -n? line buffer
0000                             ;             at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack has a guard band: the data stack can
0000                             ;  overrun by a cell or two (and the calls made while it is full, the error
0000                             ;  report's included) into the top 32 bytes of the return-stack page, which
0000                             ;  are never used, and the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
0000                BDOS:     EQU   0005h   
0000                BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IF   CPM*(1-EDITOR)   
                    EXIT:     EQU   0000h   ; warm boot
0000                          ENDIF      
0000                          IFN   CPM   
                                 ; ---- generic machine: edit these to suit -----------------------------------
                    KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
                                 ;   waiting. The zero flag must match A
                                 ;   (end the routine with OR A / RET).
                    CONOUT:   EQU   0FF03h   ; print the character in A
                                 ;   KEY and CONOUT must preserve BC, DE, HL and HL'.
                    RSPAGE:   EQU   80h   ; 8000h return stack
                    DSPAGE:   EQU   81h   ; 8100h data stack
                    LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
                    PROG:     EQU   8300h   ; where the loader puts the program text
                    HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
                    BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)   
                    EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                          ENDIF      
0000                          IF   EDITOR   
0000                EXIT:     EQU   edit   ; a program that ends goes back to the editor
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                KEYBUF:   EQU   LET+36h   ;   around machine code; a held-back key;
0000                NPEND:    EQU   LET+38h   ;   minus the address of the program's end
0000                             ;   (the heap"s first byte), for the checked "_'
0000                LBHDR:    EQU   LET+7Eh   ; CP/M BDOS 10 header: max, count
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FCh   ; empty data stack. The four bytes above it
0000                             ; are spare: a character can pop two cells
0000                             ; too many before the checked build sees it,
0000                             ; and the next call must not land on the
0000                             ; letter cells.
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is the start of the .COM file, and 0108h-0133h is also copied to
0000                             ;  page zero (see the header).
0000                             ; =============================================================================
0100                          .ORG   BASE   
0100                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              XOR   A   ; 00  reset. (This byte, AFh, is also what an
0100                          ENDIF      ;     undefined word runs into: see e_hi.)
0100                          IF   1-EDGEN   
0100   31 FC 06               LD   SP,DSTOP   ; 00  reset, or the start of the .COM file
0103                          ENDIF      
0103                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)   
                              LD   BC,PROG   ; 03  the IP
                              JR   st0   ; 06  (the rest of the startup is close by)
0103                          ENDIF      
0103                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              JR   init   ; 04  (the rest of the startup is close by)
                              DW   0   ; 06  spare
0103                          ENDIF      
0103                          IF   EDGEN   
                              XOR   A   ; 00  reset: no program yet
                              LD   (PROG),A   
0103                          ENDIF      
0103                          IF   EDGEN*(1-CHECKED)   
                              JP   edit   ; 04
0103                          ENDIF      
0103                          IF   EDGEN*CHECKED   
                              JP   init   ; 04  (and no key held back)
0103                          ENDIF      
0103                          IF   EDGEN   
                              NOP      ; 07  spare
0103                          ENDIF      
0103                          IF   CPM   
0103   C3 7F 04               JP   start   ; 03
0106   00 00                  DW   0   ; 06  spare
0108                          ENDIF      
0108                VECS:        
0108                             ; ---- RST 08h: rpop: pop the return stack into DE ---------------------------
0108   D9           RPOP:     EXX      ; 08
0109   5E                     LD   E,(HL)   
010A   23                     INC   HL   
010B   56                     LD   D,(HL)   
010C   23                     INC   HL   
010D   D5                     PUSH   DE   ; across to the main registers
010E   D9                     EXX      
010F   D1                     POP   DE   
0110   C9                     RET      ; 10  (so RST 10h is not used)
0111                             ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
0111   C6 21        CTL:      ADD   A,21h   ; 11  back to c; zero only for NUL
0113   20 1F                  JR   NZ,next0   ;     the rest are ignored
0115   C3 F9 03     ENDPROG:   JP   EXIT   ;     the program has ended
0118                             ; ---- RST 18h: drop TOS, then next ------------------------------------------
0118   D1           RST18:    POP   DE   ; 18  discard the RST's return address
0119   E1                     POP   HL   ;     new TOS = NOS
011A   18 15                  JR   nx   
011C   E5           H_FROMR:   PUSH   HL   ; 1C  "}" return stack to TOS
011D   CF                     RST   08h   
011E   EB                     EX   DE,HL   
011F   F7                     RST   30h   
0120                             ; ---- RST 20h: neg16: HL = -HL (keeps BC, DE) -------------------------------
0120   AF           NEG16:    XOR   A   ; 20
0121   95                     SUB   L   
0122   6F                     LD   L,A   
0123   9F                     SBC   A,A   
0124   94                     SUB   H   
0125   67                     LD   H,A   
0126   C9                     RET      
0127   00                     NOP      ; 27  spare
0128                             ; ---- RST 28h: putc: print A (keeps BC, DE, HL, HL') ------------------------
0128                RST28:       
0128                          IFN   CPM   
                    PUTC:     JP   CONOUT   ; 28
0128                          ENDIF      
0128                          IF   CPM   
0128   C3 A1 03               JP   putc   ; 28
012B                          ENDIF      
012B   E9           JPHL:     JP   (HL)   ; 2B  (for the machine-code call)
012C   E3           H_TOR:    EX   (SP),HL   ; 2C  "{" TOS to the return stack: the new TOS
012D   C3 B2 01               JP   rpushn   ;     comes up, the old one goes across
0130                             ; ---- RST 30h: next character -----------------------------------------------
0130   D1           RST30:    POP   DE   ; 30  discard the RST's return address
0131                NX:          
0131                          IF   CPM   
0131   C3 34 01               JP   next0   ; (this copy runs in page zero)
0134                          ENDIF      
0134                VECEND:      
0134                             ; =============================================================================
0134                             ;  The inner loop: read one character and sort it by range.
0134                             ; 
0134                             ;    00h          end of program
0134                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0134                             ;    30h-39h      digit: read a whole number
0134                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0134                             ;    61h-7Ah      a-z: push the address of that letter's cell
0134                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0134                             ; =============================================================================
0134                NEXT0:       
0134                          IF   CHECKED   
                              CALL   chkstk   ; both stacks are checked once per character
0134                          ENDIF      
0134   0A                     LD   A,(BC)   
0135   03                     INC   BC   
0136   D6 21                  SUB   21h   ; A = c - 21h
0138   38 D7                  JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
013A   FE 0F                  CP   0Fh   
013C   38 22                  JR   C,punct   ; 21h-2Fh: PTAB index 0-14
013E   D6 0F                  SUB   0Fh   ; A = c - 30h
0140   FE 0A                  CP   0Ah   
0142   38 58                  JR   C,digit   ; 30h-39h
0144   FE 11                  CP   11h   
0146   38 16                  JR   C,p3a   ; 3Ah-40h
0148   D6 11                  SUB   11h   ; A = c - 41h
014A   FE 1A                  CP   1Ah   
014C   38 5A                  JR   C,upper   ; 41h-5Ah: A = letter index 0-25
014E   FE 20                  CP   20h   
0150   38 0A                  JR   C,p5b   ; 5Bh-60h
0152   FE 3A                  CP   3Ah   
0154   38 4C                  JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0156   FE 3E                  CP   3Eh   
0158                          IF   1-CHECKED   
0158   30 DA                  JR   NC,next0   ; 7Fh-FFh: ignored
015A                          ENDIF      
015A                          IF   CHECKED   
                              JR   Z,next0   ; 7Fh, DEL: ignored
                              JP   NC,e_hi   ; 80h-FFh: reserved
015A                          ENDIF      
015A   D6 1A                  SUB   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
015C   D6 09        P5B:      SUB   9   ; 5Bh-60h: -4 in all, index 22-27
015E   C6 05        P3A:      ADD   A,5   ; 3Ah-40h: index 15-21
0160                .macro PTABLE,
0160                             ; 
0160                 DB      h_store & 0FFh  ; !
0160                 DB      h_str & 0FFh    ; "
0160                 DB      h_num & 0FFh    ; #
0160                 DB      h_print & 0FFh  ; $
0160                 DB      h_swap & 0FFh   ; %
0160                 DB      h_and & 0FFh    ; &
0160                 DB      h_emit & 0FFh   ; '
0160                 DB      h_open & 0FFh   ; (
0160                 DB      h_close & 0FFh  ; )
0160                 DB      h_mul & 0FFh    ; *
0160                 DB      h_add & 0FFh    ; +
0160                 DB      h_cfetch & 0FFh ; ,
0160                 DB      h_sub & 0FFh    ; -
0160                 DB      h_cstore & 0FFh ; .
0160                 DB      h_div & 0FFh    ; /
0160                 DB      h_dup & 0FFh    ; :
0160                 DB      h_drop & 0FFh   ; ;
0160                 DB      h_lt & 0FFh     ; <
0160                 DB      h_eq & 0FFh     ; =
0160                 DB      h_gt & 0FFh     ; >
0160                 DB      h_key & 0FFh    ; ?
0160                 DB      h_fetch & 0FFh  ; @
0160                 DB      h_def & 0FFh    ; [
0160                 DB      h_break & 0FFh  ; \
0160                 DB      h_ret & 0FFh    ; ]
0160                 DB      h_xor & 0FFh    ; ^
0160                 DB      h_alloc & 0FFh  ; _
0160                 DB      h_grave & 0FFh  ; `
0160                 DB      h_tor & 0FFh    ; {
0160                 DB      h_or & 0FFh     ; |
0160                 DB      h_fromr & 0FFh  ; }
0160                 DB      h_not & 0FFh    ; ~
0160                .endm
0160                 
0160                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
0160                             ; untouched, and A, DE free.
0160   C6 7F        PUNCT:    ADD   A,PTAB & 0FFh   ; PTAB never crosses a page
0162   5F                     LD   E,A   
0163   16 03                  LD   D,PTAB / 256   ; (0 if the table is in page zero)
0165   FE 94                  CP   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
0167   1A                     LD   A,(DE)   
0168   5F                     LD   E,A   ; the handler's low byte
0169                          IF   (1-CPM)*(1-TABP0)   
                              LD   D,0   
0169                          ENDIF      
0169                          IFN   CPM   
                              RL   D   ; its page: 0 + carry
0169                          ENDIF      
0169                          IF   CPM   
0169   16 01                  LD   D,1   
016B   30 01                  JR   NC,pu1   
016D   14                     INC   D   ; its page: 1 + carry
016E                PU1:         
016E                          ENDIF      
016E   D5                     PUSH   DE   ; jump to it; the stack is balanced again
016F   C9                     RET      ;   when the handler starts
0170                             ; The rest of the startup: here so that the generic reset code can reach it
0170                             ; with JR. st0: find the program's NUL; the heap starts after it.
0170                             ; (The editor build has its own copy of this, next to the editor.)
0170                             ; A checked build first clears the lower half of the letter page (A = 0):
0170                             ; every variable starts at 0, every word cell holds 0000h, the address an
0170                             ; undefined word is caught at (see e_hi), and no key is held back.
0170                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                    INIT:     LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
                              LD   BC,PROG   ; the IP
0170                          ENDIF      
0170                          IF   (1-CPM)*(1-EDITOR)   
                    ST0:      LD   H,B   
                              LD   L,C   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
0170                          ENDIF      
0170                          IF   1-EDITOR   
                    ST2:      LD   (HEAP),HL   
0170                          ENDIF      
0170                          IF   CHECKED*(1-EDITOR)   
                              RST   20h   ; minus the heap"s first address: "_' may not
                              LD   (NPEND),HL   ;   release below it
0170                          ENDIF      
0170                          IF   1-EDITOR   
                              EXX      
                              LD   HL,RSTOP   ; the return stack is empty
                              EXX      
                              RST   30h   ; (its return address is thrown away)
0170                          ENDIF      
0170                             ; In the unchecked generic editor build the table is here, in the first
0170                             ; page, which saves loading D twice. (The other builds have no room for it
0170                             ; here: theirs is further down.)
0170                          IF   TABP0   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0170                          ENDIF      
0170                             ; =============================================================================
0170                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
0170                             ;  (00bbIGFuZCA= are up among the RST routines.) The machine-code call, exec,
0170                             ;  is here too: it belongs to "`" and makes the page come out right.
0170                             ; =============================================================================
0170   D1           H_XOR:    POP   DE   
0171   7C                     LD   A,H   
0172   AA                     XOR   D   
0173   67                     LD   H,A   
0174   7D                     LD   A,L   
0175   AB                     XOR   E   
0176   6F                     LD   L,A   
0177   F7                     RST   30h   
0178   D1           H_OR:     POP   DE   
0179   7C                     LD   A,H   
017A   B2                     OR   D   
017B   67                     LD   H,A   
017C   7D                     LD   A,L   
017D   B3                     OR   E   
017E   6F                     LD   L,A   
017F   F7                     RST   30h   
0180   E7           H_NOT:    RST   20h   ; ~x = -x - 1
0181   2B                     DEC   HL   
0182   F7                     RST   30h   
0183                             ; "_" ( n -- addr ): the heap pointer moves by n, a signed count (the add is
0183                             ; the same either way); TOS is the old pointer.
0183   ED 5B 7C 07  H_ALLOC:   LD   DE,(HEAP)   
0187                          IF   CHECKED*CPM   
                              LD   A,H   ; the count's sign, for chkhp
0187                          ENDIF      
0187   19                     ADD   HL,DE   ; the new top
0188                          IF   CHECKED   
                              CALL   chkhp   
0188                          ENDIF      
0188   22 7C 07               LD   (HEAP),HL   
018B   EB                     EX   DE,HL   
018C   F7                     RST   30h   
018D   D9           EXEC:     EXX      
018E   22 34 07               LD   (RSAVE),HL   ; machine code may change the alternates
0191   D9                     EXX      
0192   CD 2B 01               CALL   jphl   
0195   D9                     EXX      
0196   2A 34 07               LD   HL,(RSAVE)   
0199   D9                     EXX      
019A   E1                     POP   HL   
019B   F7                     RST   30h   
019C                             ; ---- the letters and digits (here, in the middle, so that the inner loop's
019C                             ; ---- short jumps reach them, and the handlers after them reach rpushn) ------
019C                             ; Digits: step back onto the first digit and read the whole number.
019C   E5           DIGIT:    PUSH   HL   
019D   0B                     DEC   BC   
019E   CD 10 03               CALL   rdnum   
01A1   F7                     RST   30h   
01A2                             ; a-z: push the cell's address (the cell is the variable)
01A2   E5           LOWER:    PUSH   HL   
01A3   87                     ADD   A,A   
01A4   6F                     LD   L,A   
01A5   26 07                  LD   H,LETPAGE   
01A7   F7                     RST   30h   
01A8                             ; A-Z: call the word. The return address (the IP after the letter) goes on
01A8                             ; the return stack, and the IP becomes the address in the letter's cell.
01A8   C5           UPPER:    PUSH   BC   ; the return address, for rpushn
01A9   EB                     EX   DE,HL   ; park TOS
01AA   87                     ADD   A,A   
01AB   6F                     LD   L,A   
01AC   26 07                  LD   H,LETPAGE   ; HL -> cell
01AE   4E                     LD   C,(HL)   
01AF   2C                     INC   L   
01B0   46                     LD   B,(HL)   ; IP = the word's body
01B1   EB                     EX   DE,HL   ; TOS back, and fall into rpushn
01B2                             ; rpushn: move the top cell of the data stack (in memory) to the return
01B2                             ; stack, then next. Everything that pushes the return stack ends here.
01B2                RPUSHN:      
01B2                          IF   CHECKED   
                              CALL   chkbrk   ; Ctrl-C is checked at every word call, block
01B2                          ENDIF      ;   entry, loop-back and "{"
01B2   D9                     EXX      
01B3   D1                     POP   DE   
01B4   2B                     DEC   HL   
01B5   72                     LD   (HL),D   
01B6   2B                     DEC   HL   
01B7   73                     LD   (HL),E   
01B8   D9                     EXX      
01B9   F7                     RST   30h   
01BA                             ; ---- machine code: the grave -----------------------------------------------
01BA                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
01BA                             ; are stored from addr until a non-hex character; then a RET (C9h) is
01BA                             ; written and its address is left. An odd last digit is consumed and dropped.
01BA                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
01BA                             ; code is entered by CALL with the data stack above the return address; it
01BA                             ; must keep BC, and on return the top cell becomes the new TOS.
01BA   CD 6D 03     H_GRAVE:   CALL   hexc   
01BD   30 CE                  JR   NC,exec   
01BF   77           HX1:      LD   (HL),A   ; the high digit goes in first ...
01C0   CD 6D 03               CALL   hexc   
01C3   30 08                  JR   NC,hx2   ; odd digit: consumed, and the RET below
01C5   ED 6F                  RLD      ;   overwrites it
01C7   23                     INC   HL   ; ... and RLD shifts it up under the low one
01C8   CD 6D 03               CALL   hexc   
01CB   38 F2                  JR   C,hx1   
01CD   36 C9        HX2:      LD   (HL),0C9h   ; (never range-checked: the spec says so)
01CF   F7                     RST   30h   
01D0                             ; ---- where the two pages meet ----------------------------------------------
01D0                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
01D0                             ; are in falling code order for this), and where exactly differs between the
01D0                             ; builds: NPG1 follows. Every handler below these four must start in the
01D0                             ; second page, and every one above in the first; chktab.py checks both.
01D0                             ; "]" returns: pop an address and jump to it.
01D0   CF           H_RET:    RST   08h   
01D1   42                     LD   B,D   
01D2   4B                     LD   C,E   
01D3   F7           BRK1:     RST   30h   
01D4                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
01D4                             ; drops the block start, "]" returns. No closer at all ends the program.
01D4   7C           H_BREAK:   LD   A,H   
01D5   B5                     OR   L   
01D6   E1                     POP   HL   
01D7   28 FA                  JR   Z,brk1   
01D9   CD 32 03               CALL   skip   
01DC   B7                     OR   A   ; skip returns 0 for ")"
01DD   20 F1                  JR   NZ,h_ret   
01DF   CF           RDROP:    RST   08h   
01E0   F7                     RST   30h   
01E1                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
01E1                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
01E1                             ; the body"s address instead. Either way it then skips to the matching "]'.
01E1                             ; (The unchecked build takes anything that is not a letter as the space; the
01E1                             ; checked build stops on it.)
01E1   0A           H_DEF:    LD   A,(BC)   
01E2   03                     INC   BC   
01E3   D6 41                  SUB   "A"   ; a letter gives 0-25 or 32-57: lowercase
01E5   5F                     LD   E,A   ;   lands 64 bytes up
01E6   E6 DF                  AND   0DFh   ; fold case
01E8   FE 1A                  CP   26   
01EA   30 0B                  JR   NC,def2   ; not a letter
01EC   CB 23                  SLA   E   
01EE   16 07                  LD   D,LETPAGE   ; DE -> cell
01F0   79                     LD   A,C   
01F1   12                     LD   (DE),A   
01F2   1C                     INC   E   
01F3   78                     LD   A,B   
01F4   12                     LD   (DE),A   
01F5   18 03                  JR   skipnx   
01F7                DEF2:        
01F7                          IF   CHECKED   
                              LD   A,E   
                              CP   " "-"A"+256   
                              JP   NZ,e_brack   ; anything but a letter or a space
01F7                          ENDIF      
01F7   E5                     PUSH   HL   ; an anonymous block: push its address
01F8   60                     LD   H,B   
01F9   69                     LD   L,C   
01FA                SKIPNX:      
01FA                          IF   CHECKED   
                              DEC   BC   ; back onto the letter, so that skip finds its
01FA                          ENDIF      ;   opener, the "[", just before where it starts
01FA   CD 32 03     SKIPO:    CALL   skip   
01FD   F7                     RST   30h   
01FE   5E           H_FETCH:   LD   E,(HL)   ; "@"
01FF   23                     INC   HL   
0200   56                     LD   D,(HL)   
0201   EB                     EX   DE,HL   
0202   F7                     RST   30h   
0203                             ; =============================================================================
0203                             ;  Handlers that must start in the image's second page.
0203                             ;  "?" is the last (with "," inside it), so its long tail may run past that
0203                             ;  page.
0203                             ; =============================================================================
0203                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
0203                             ; the matching ")".
0203   7C           H_OPEN:   LD   A,H   
0204   B5                     OR   L   
0205   E1                     POP   HL   
0206   28 F2                  JR   Z,skipo   
0208   C5                     PUSH   BC   ; the block starts at the IP
0209   18 A7                  JR   rpushn   
020B                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
020B                             ; drops it and carries on.
020B   7C           H_CLOSE:   LD   A,H   
020C   B5                     OR   L   
020D   E1                     POP   HL   
020E   28 CF                  JR   Z,rdrop   
0210   CF                     RST   08h   ; pop the block start ...
0211   42                     LD   B,D   
0212   4B                     LD   C,E   
0213   C5                     PUSH   BC   
0214   18 9C                  JR   rpushn   ; ... and push it back
0216                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
0216                             ; "-" has two jobs: directly before a digit it starts a negative number.
0216   0A           H_SUB:    LD   A,(BC)   
0217   D6 30                  SUB   "0"   
0219   FE 0A                  CP   10   
021B   38 04                  JR   C,negnum   
021D   E7                     RST   20h   ; a - b = a + (-b): fall into "+"
021E   D1           H_ADD:    POP   DE   
021F   19                     ADD   HL,DE   
0220   F7                     RST   30h   
0221   E5           NEGNUM:   PUSH   HL   ; a negative number: read it, negate it
0222   CD 10 03               CALL   rdnum   
0225   E7                     RST   20h   
0226   F7                     RST   30h   
0227   D1           H_AND:    POP   DE   
0228   7C                     LD   A,H   
0229   A2                     AND   D   
022A   67                     LD   H,A   
022B   7D                     LD   A,L   
022C   A3                     AND   E   
022D   6F                     LD   L,A   
022E   F7                     RST   30h   
022F                             ; Signed compares. Both are "HL < DE" for the right pair: "<" swaps the two
022F                             ; cells first. Flipping both sign bits turns a signed compare into an
022F                             ; unsigned one (and XOR clears the carry for SBC); SBC HL,HL then turns the
022F                             ; carry into -1 or 0 with no branch.
022F   E3           H_LT:     EX   (SP),HL   ; a < b: HL = a, and b is popped next
0230   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
0231   7C                     LD   A,H   
0232   EE 80                  XOR   80h   
0234   67                     LD   H,A   
0235   7A                     LD   A,D   
0236   EE 80                  XOR   80h   
0238   57                     LD   D,A   
0239   ED 52                  SBC   HL,DE   ; carry if HL < DE
023B   ED 62        TF:       SBC   HL,HL   ; carry -> -1 or 0
023D   F7                     RST   30h   
023E   D1           H_EQ:     POP   DE   
023F   B7                     OR   A   
0240   ED 52                  SBC   HL,DE   
0242   7C                     LD   A,H   
0243   B5                     OR   L   
0244   FE 01                  CP   1   ; carry only if a - b = 0
0246   18 F3                  JR   tf   
0248                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept. The
0248                             ; multiplier shifts up through A:C.
0248   D1           H_MUL:    POP   DE   ; DE = multiplicand
0249   C5                     PUSH   BC   
024A   7C                     LD   A,H   
024B   4D                     LD   C,L   ; A:C = multiplier
024C   21 00 00               LD   HL,0   
024F   06 10                  LD   B,16   
0251   29           MUL1:     ADD   HL,HL   
0252   CB 21                  SLA   C   
0254   17                     RLA      
0255   30 01                  JR   NC,mul2   
0257   19                     ADD   HL,DE   
0258   10 F7        MUL2:     DJNZ   mul1   
025A   C1                     POP   BC   
025B   F7                     RST   30h   
025C                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
025C                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
025C                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
025C                             ; stops on it.
025C                H_DIV:       
025C                          IF   CHECKED   
                              LD   A,H   
                              OR   L   
                              JP   Z,e_zero   
025C                          ENDIF      
025C   D1                     POP   DE   ; DE = a, HL = b
025D   C5                     PUSH   BC   ; free BC for udiv
025E   D5                     PUSH   DE   ; a, for r's sign
025F   7A                     LD   A,D   
0260   AC                     XOR   H   
0261   F5                     PUSH   AF   ; S flag = sign of q
0262   CB 7C                  BIT   7,H   
0264   C4 20 01               CALL   NZ,neg16   ; HL = |b|
0267   EB                     EX   DE,HL   
0268   CB 7C                  BIT   7,H   
026A   C4 20 01               CALL   NZ,neg16   ; HL = |a|, DE = |b|
026D   CD EA 02               CALL   udiv   ; HL = q, DE = r
0270   F1                     POP   AF   
0271   FC 20 01               CALL   M,neg16   ; q's sign
0274   EB                     EX   DE,HL   ; HL = r, DE = q
0275   F1                     POP   AF   ; A = a's high byte
0276   B7                     OR   A   
0277   FC 20 01               CALL   M,neg16   ; r's sign
027A   C1                     POP   BC   
027B   D5                     PUSH   DE   ; q under r
027C   F7                     RST   30h   
027D                             ; ---- stack and storage -----------------------------------------------------
027D   E5           H_DUP:    PUSH   HL   ; ":"
027E   F7                     RST   30h   
027F   E3           H_SWAP:   EX   (SP),HL   ; "%"
0280   F7                     RST   30h   
0281                             ; (The checked build tests the address before it takes the value off the
0281                             ; stack, so that an error report shows both.)
0281                H_CSTORE:      ; "." ( c addr -- )
0281                          IF   CHECKED   
                              CALL   chkst   
0281                          ENDIF      
0281   D1                     POP   DE   
0282   73                     LD   (HL),E   
0283   DF           H_DROP:   RST   18h   ; ";" is this one byte
0284                H_STORE:      ; "!" ( n addr -- )
0284                          IF   CHECKED   
                              CALL   chkst   
0284                          ENDIF      
0284   D1                     POP   DE   
0285   73                     LD   (HL),E   
0286   23                     INC   HL   
0287   72                     LD   (HL),D   
0288   DF                     RST   18h   
0289                             ; ---- console ---------------------------------------------------------------
0289                             ; 22h pushes the address of the text after it and skips the string.
0289   E5           H_STR:    PUSH   HL   
028A   60                     LD   H,B   
028B   69                     LD   L,C   
028C   CD 27 03               CALL   skipstr   
028F                          IF   CHECKED   
                              OR   A   ; 0: the text ran out before the closing quote
                              JP   Z,e_quote   
028F                          ENDIF      
028F   F7                     RST   30h   
0290                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character
0290                             ; clears that character"s bit 6 (/M is CR, /` is space; "/" and ""' have no
0290                             ; bit 6, so // and /" give themselves).
0290                          IF   1-CHECKED   
0290   7E           H_PRINT:   LD   A,(HL)   
0291   23                     INC   HL   
0292   FE 22                  CP   22h   
0294   28 0D                  JR   Z,pr9   
0296   FE 2F                  CP   "/"   
0298   20 04                  JR   NZ,pr1   
029A   7E                     LD   A,(HL)   
029B   23                     INC   HL   
029C   E6 BF                  AND   0BFh   
029E   EF           PR1:      RST   28h   
029F   18 EF                  JR   h_print   
02A1                          ENDIF      
02A1                          IF   CHECKED   
                                 ; (The checked build has the loop as a routine, prstr, which the error
                                 ; report uses too. The address is kept on the stack meanwhile: a report
                                 ; shows the stack as it was before the "$".)
                    H_PRINT:   PUSH   HL   
                              CALL   prstr   
                              POP   DE   
                              RST   18h   
02A1                          ENDIF      
02A1   7D           H_EMIT:   LD   A,L   ; "'"
02A2   EF                     RST   28h   
02A3   DF           PR9:      RST   18h   
02A4                             ; "#" prints TOS as a signed decimal number, with no space after it.
02A4   C5           H_NUM:    PUSH   BC   
02A5   CD 53 03               CALL   psgn   
02A8   C1                     POP   BC   
02A9   DF                     RST   18h   
02AA                             ; "?" ( n -- c ) or ( -n -- addr )
02AA                             ;   n > 0: wait about n ms for a key; 0 if none came
02AA                             ;   n = 0: wait for a key
02AA                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
02AA                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
02AA   CB 7C        H_KEY:    BIT   7,H   
02AC   20 19                  JR   NZ,line   
02AE   1E 28        KT1:      LD   E,MSLOOP   ; one millisecond, roughly
02B0   CD 9F 03     KT2:      CALL   getk   
02B3   20 0E                  JR   NZ,kt3   
02B5   1D                     DEC   E   
02B6   20 F8                  JR   NZ,kt2   
02B8   7C                     LD   A,H   ; 0? never counts down: it waits
02B9   B5                     OR   L   
02BA   28 F2                  JR   Z,kt1   
02BC   2B                     DEC   HL   
02BD   7C                     LD   A,H   
02BE   B5                     OR   L   
02BF   20 ED                  JR   NZ,kt1   ; A = 0 if the time ran out
02C1   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
02C2   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
02C3   6F           KT3:      LD   L,A   
02C4   26 00                  LD   H,0   
02C6   F7                     RST   30h   
02C7                          IF   CPM   
02C7                             ; CP/M: BDOS 10 does the editing (the spec allows the platform's
02C7                             ; own line editor). It doesn't store the CR, so it is added here.
02C7   11 7F 00     LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
02CA   19                     ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
02CB   9F                     SBC   A,A   
02CC   A5                     AND   L   ; (0 for a count that is too big)
02CD   EE 7F                  XOR   127   ; A = the count, 127 at most
02CF                          ENDIF      
02CF                          IF   CPM*EDITOR   
02CF   CD D5 02               CALL   rdline   ; (the editor calls rdline too)
02D2   2E 80                  LD   L,LINEBUF & 0FFh   
02D4   F7                     RST   30h   
02D5                             ; rdline: read a line of at most A characters; HL -> the CR that ends it
02D5                RDLINE:      
02D5                          ENDIF      
02D5                          IF   CPM   
02D5   32 7E 07               LD   (LBHDR),A   
02D8   11 7E 07               LD   DE,LBHDR   
02DB   3E 0A                  LD   A,10   
02DD   CD AD 03               CALL   bdosx   
02E0   21 7F 07               LD   HL,LBHDR+1   
02E3   7E                     LD   A,(HL)   ; the count typed (0-127)
02E4   2C                     INC   L   ; HL = LINEBUF, whose low byte is 80h:
02E5   85                     ADD   A,L   ;   adding the count to L can't carry
02E6   6F                     LD   L,A   
02E7   36 0D                  LD   (HL),13   
02E9                          ENDIF      
02E9                          IF   CPM*(1-EDITOR)   
                              LD   L,LINEBUF & 0FFh   
                              RST   30h   
02E9                          ENDIF      
02E9                          IF   CPM*EDITOR   
02E9   C9                     RET      
02EA                          ENDIF      
02EA                          IFN   CPM   
                                 ; Generic: Backspace takes the last character back (and is echoed as
                                 ; it is), CR ends (stored, not echoed), every other key is stored and
                                 ; echoed until the line is full. The line buffer starts at offset 80h
                                 ; of its page, so L alone is the place in the line: D holds the L of
                                 ; a full line.
02EA                          ENDIF      
02EA                          IFN   CPM   
                    LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
                              ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
                              SBC   A,A   
                              AND   L   ; (0 for a count that is too big)
                              CPL      
                              LD   D,A   ; D = the L of a full line: 80h + count, FFh
02EA                          ENDIF      ;   at most
02EA                          IF   EDGEN   
                              CALL   rdline   ; (the editor calls rdline too)
                              LD   L,LINEBUF & 0FFh   
                              RST   30h   
                                 ; rdline: read a line that is full when L reaches D; HL -> the CR that ends it
                    RDLINE:      
02EA                          ENDIF      
02EA                          IFN   CPM   
                              LD   HL,LINEBUF   
                    LN2:      CALL   getk   
                              JR   Z,ln2   
                              CP   13   
                              JR   Z,ln5   
                              CP   8   
                              JR   Z,ln4   
                              LD   E,A   
                              LD   A,L   
                              CP   D   
                              JR   Z,ln2   ; full
                              LD   (HL),E   
                              INC   L   
                              LD   A,E   
                    LN3:      RST   28h   
                              JR   ln2   
                    LN4:      DEC   L   ; Backspace: one back, and echo it,
                              JP   M,ln3   ;   unless the line was empty (L left the
                              INC   L   ;   upper half of the page)
                              JR   ln2   
                    LN5:      LD   (HL),A   ; the CR
02EA                          ENDIF      
02EA                          IF   (1-CPM)*(1-EDITOR)   
                              LD   L,LINEBUF & 0FFh   
                              RST   30h   
02EA                          ENDIF      
02EA                          IF   EDGEN   
                              RET      
02EA                          ENDIF      
02EA                             ; =============================================================================
02EA                             ;  More routines (no handler starts past this point)
02EA                             ; =============================================================================
02EA                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
02EA                             ; Uses A, BC; the caller saves the IP. The dividend shifts up through A:C
02EA                             ; while the quotient bits arrive at the bottom of C.
02EA                             ; Dividing by 2 is one shift (the spec wants that fast).
02EA   7B           UDIV:     LD   A,E   
02EB   EE 02                  XOR   2   
02ED   B2                     OR   D   
02EE   20 07                  JR   NZ,udv0   
02F0   CB 3C                  SRL   H   
02F2   CB 1D                  RR   L   ; the quotient
02F4   8F                     ADC   A,A   
02F5   5F                     LD   E,A   ; the remainder: the bit that fell out (D is 0)
02F6   C9                     RET      
02F7   7C           UDV0:     LD   A,H   
02F8   4D                     LD   C,L   
02F9   21 00 00               LD   HL,0   
02FC   06 10                  LD   B,16   
02FE   CB 21        UDV1:     SLA   C   
0300   17                     RLA      
0301   ED 6A                  ADC   HL,HL   
0303   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
0305   30 02                  JR   NC,udv2   ;   always fits in 16 bits
0307   19                     ADD   HL,DE   ; too much: put it back, and cancel the
0308   0D                     DEC   C   ;   INC below
0309   0C           UDV2:     INC   C   ; a quotient bit
030A   10 F2                  DJNZ   udv1   
030C   EB                     EX   DE,HL   ; DE = remainder
030D   67                     LD   H,A   
030E   69                     LD   L,C   ; HL = quotient
030F   C9                     RET      
0310                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
0310                             ; non-digit. Values wrap at 16 bits, as the spec says.
0310   21 00 00     RDNUM:    LD   HL,0   
0313   0A           RDN1:     LD   A,(BC)   
0314   D6 30                  SUB   "0"   
0316   FE 0A                  CP   10   
0318   D0                     RET   NC   
0319   03                     INC   BC   
031A   54                     LD   D,H   
031B   5D                     LD   E,L   
031C   29                     ADD   HL,HL   
031D   29                     ADD   HL,HL   
031E   19                     ADD   HL,DE   
031F   29                     ADD   HL,HL   ; HL * 10
0320   5F                     LD   E,A   
0321   16 00                  LD   D,0   
0323   19                     ADD   HL,DE   
0324   18 ED                  JR   rdn1   
0326                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
0326                             ; the next character, so "/"" does not end it. Leaves A = 22h.
0326                          IF   1-CHECKED   
0326   03           SS0:      INC   BC   
0327   0A           SKIPSTR:   LD   A,(BC)   
0328   03                     INC   BC   
0329   FE 2F                  CP   "/"   
032B   28 F9                  JR   Z,ss0   
032D   FE 22                  CP   22h   
032F   20 F6                  JR   NZ,skipstr   
0331   C9                     RET      
0332                          ENDIF      
0332                          IF   CHECKED   
                                 ; The checked build never steps over a NUL: if the text runs out first it
                                 ; returns A = 0 with the IP on the NUL.
                    SKIPSTR:   LD   A,(BC)   
                              OR   A   
                              RET   Z   
                              INC   BC   
                              CP   22h   
                              RET   Z   
                              CP   "/"   
                              JR   NZ,skipstr   
                              LD   A,(BC)   ; the escaped character
                              OR   A   
                              RET   Z   
                              INC   BC   
                              JR   skipstr   
0332                          ENDIF      
0332                             ; skip: read past text to the closer at this level, and return A = 0 if it
0332                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
0332                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
0332                             ; no closer; anything else that runs into the NUL had unbalanced brackets
0332                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
0332                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
0332                             ; 
0332                             ; The checked build also looks at the character the skip was started by,
0332                             ; which is always the one just before where it starts: "(" must end at ")",
0332                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
0332                             ; quote counts as running into it. "\" takes either closer. IX keeps the
0332                             ; place where the skip started, for the report.
0332                SKIP:        
0332                          IF   CHECKED   
                              PUSH   BC   
                              POP   IX   
                              DEC   BC   
                              LD   A,(BC)   
                              INC   BC   
                              LD   E,A   ; E = the opener: ( [ or \
0332                          ENDIF      
0332   16 00                  LD   D,0   
0334   14           SK3:      INC   D   ; an opener: one deeper
0335   0A           SK1:      LD   A,(BC)   
0336                          IF   1-CHECKED   
0336   03                     INC   BC   
0337   B7                     OR   A   
0338   CA 15 01               JP   Z,endprog   
033B                          ENDIF      
033B                          IF   CHECKED   
                              OR   A   
                              JR   Z,sk6   ; (the IP stays on the NUL)
                              INC   BC   
033B                          ENDIF      
033B   FE 22                  CP   22h   
033D   CC 27 03               CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
0340   D6 28                  SUB   "("   ;   (or 0, and then the NUL is read next)
0342   28 F0                  JR   Z,sk3   
0344   3D                     DEC   A   ; ")"
0345   28 08                  JR   Z,sk4   
0347   D6 32                  SUB   "["-")"   
0349   28 E9                  JR   Z,sk3   
034B   FE 02                  CP   "]"-"["   
034D   20 E6                  JR   NZ,sk1   
034F   15           SK4:      DEC   D   
0350                          IF   1-CHECKED   
0350   C8                     RET   Z   ; the closer at this level
0351   18 E2                  JR   sk1   
0353                          ENDIF      
0353                          IF   CHECKED   
                              JR   NZ,sk1   
                              LD   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
                              XOR   E   ;   opener is 0 for "(" and 1 for "[", and only
                              AND   6   ;   "\" has bit 2: so this is 2 for the wrong
                              CP   2   ;   closer, and only then
                              LD   A,D   
                              RET   NZ   
                              JR   sk7   
                    SK6:      BIT   2,E   ; the text ran out:
                              JP   NZ,endprog   ;   "\" with no closer ends the program
                    SK7:      PUSH   IX   ; N. The place is the opener
                              POP   BC   
                              LD   A,"N"   
                              JP   errp   ; (errp drops skip's return address)
0353                          ENDIF      
0353                             ; psgn: print HL as a signed number. Uses BC.
0353   CB 7C        PSGN:     BIT   7,H   
0355   28 04                  JR   Z,pdec   
0357   3E 2D                  LD   A,"-"   
0359   EF                     RST   28h   
035A   E7                     RST   20h   
035B                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
035B                             ; Uses BC.
035B   11 0A 00     PDEC:     LD   DE,10   
035E   CD EA 02               CALL   udiv   ; HL = HL / 10, E = the last digit
0361   7B                     LD   A,E   
0362   F5                     PUSH   AF   
0363   7C                     LD   A,H   
0364   B5                     OR   L   
0365   C4 5B 03               CALL   NZ,pdec   
0368   F1                     POP   AF   
0369   C6 30                  ADD   A,"0"   
036B   EF                     RST   28h   
036C   C9                     RET      
036D                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
036D                             ; and return its value in A with the carry set; otherwise leave the IP and
036D                             ; return with the carry clear.
036D   0A           HEXC:     LD   A,(BC)   
036E   D6 30                  SUB   "0"   
0370   FE 0A                  CP   10   
0372   38 09                  JR   C,hc1   
0374   E6 DF                  AND   0DFh   
0376   D6 11                  SUB   11h   
0378   FE 06                  CP   6   
037A   D0                     RET   NC   
037B   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
037D   03           HC1:      INC   BC   
037E   C9                     RET      
037F                             ; =============================================================================
037F                             ;  Dispatch table: the low byte of each handler's address, in code order
037F                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
037F                             ;  It must not cross a page (the dispatcher only adds to its low byte).
037F                             ; =============================================================================
037F                             ; The handlers of the first NPG1 characters start in the image's second page.
037F                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
037F                             ; differs between the builds, so the count is worked out here.
037F                             ; (One division to a line: asm80 only rounds down when it stores a value.)
037F                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
037F                PGBRK:    EQU   (h_break-BASE)/256   
037F                PGDEF:    EQU   (h_def-BASE)/256   
037F                PGFET:    EQU   (h_fetch-BASE)/256   
037F                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
037F                          IF   1-TABP0   
037F                PTAB:        
037F                          ;*Macro unroll:  PTABLE
037F   84                     DB   h_store & 0FFh   
0380   89                     DB   h_str & 0FFh   
0381   A4                     DB   h_num & 0FFh   
0382   90                     DB   h_print & 0FFh   
0383   7F                     DB   h_swap & 0FFh   
0384   27                     DB   h_and & 0FFh   
0385   A1                     DB   h_emit & 0FFh   
0386   03                     DB   h_open & 0FFh   
0387   0B                     DB   h_close & 0FFh   
0388   48                     DB   h_mul & 0FFh   
0389   1E                     DB   h_add & 0FFh   
038A   C2                     DB   h_cfetch & 0FFh   
038B   16                     DB   h_sub & 0FFh   
038C   81                     DB   h_cstore & 0FFh   
038D   5C                     DB   h_div & 0FFh   
038E   7D                     DB   h_dup & 0FFh   
038F   83                     DB   h_drop & 0FFh   
0390   2F                     DB   h_lt & 0FFh   
0391   3E                     DB   h_eq & 0FFh   
0392   30                     DB   h_gt & 0FFh   
0393   AA                     DB   h_key & 0FFh   
0394   FE                     DB   h_fetch & 0FFh   
0395   E1                     DB   h_def & 0FFh   
0396   D4                     DB   h_break & 0FFh   
0397   D0                     DB   h_ret & 0FFh   
0398   70                     DB   h_xor & 0FFh   
0399   83                     DB   h_alloc & 0FFh   
039A   BA                     DB   h_grave & 0FFh   
039B   2C                     DB   h_tor & 0FFh   
039C   78                     DB   h_or & 0FFh   
039D   1C                     DB   h_fromr & 0FFh   
039E   80                     DB   h_not & 0FFh   
039F                PTABEND:      
039F                          ENDIF      
039F                             ; =============================================================================
039F                             ;  Console layer: getk returns a waiting key in A (zero flag clear), or
039F                             ;  A = 0 with the zero flag set when none is waiting. putc (RST 28h) prints
039F                             ;  A. Both keep BC, DE, HL and HL". In the generic build they are the host"s
039F                             ;  KEY and CONOUT routines themselves.
039F                             ; =============================================================================
039F                          IF   (1-CPM)*(1-CHECKED)   
                    GETK:     EQU   KEY   ; the host's routine does the whole job
039F                          ENDIF      
039F                          IF   CHECKED   
                    GETK:     PUSH   HL   ; a key held back by the break check goes
                              LD   HL,KEYBUF   ;   first, and is taken out of the buffer
                              LD   A,(HL)   
                              LD   (HL),0   
                              POP   HL   
                              OR   A   
                              RET   NZ   
039F                          ENDIF      
039F                          IF   (1-CPM)*CHECKED   
                              JP   KEY   
039F                          ENDIF      
039F                          IF   CPM*(1-CHECKED)   
039F                GETK:        
039F                          ENDIF      
039F                          IF   CPM   
039F   3E FF                  LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
03A1                             ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
03A1                             ; printing and could swallow a key that BDOS 6 then never sees.
03A1   D5           PUTC:     PUSH   DE   
03A2   E5                     PUSH   HL   
03A3   5F                     LD   E,A   
03A4   3E 06                  LD   A,6   
03A6   CD AD 03               CALL   bdosx   
03A9   E1                     POP   HL   
03AA   D1                     POP   DE   
03AB   B7                     OR   A   ; (for getk)
03AC   C9                     RET      
03AD                             ; bdosx: call BDOS function A with DE, keeping BC and HL'
03AD   C5           BDOSX:    PUSH   BC   
03AE   D9                     EXX      
03AF   E5                     PUSH   HL   
03B0   D9                     EXX      
03B1   4F                     LD   C,A   
03B2   CD 05 00               CALL   BDOS   
03B5   D9                     EXX      
03B6   E1                     POP   HL   
03B7   D9                     EXX      
03B8   C1                     POP   BC   
03B9   C9                     RET      
03BA                          ENDIF      
03BA                             ; =============================================================================
03BA                             ;  Checked build: the checks and the error report
03BA                             ; =============================================================================
03BA                          IF   CHECKED   
                                 ; chkst: stop unless HL is in the program's own space: from the letter page
                                 ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
                                 ; whatever lies above the limit are safe. Memory above the heap top but
                                 ; below the limit is the program's own: Tiny BASIC keeps its lines there.
                                 ; It is the page of HL + 1 that is tested, so that one test serves both
                                 ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
                                 ; Keeps HL and BC.
                    CHKST:    INC   HL   
                              LD   A,H   
                              DEC   HL   
                              CP   LETPAGE   
                              JR   C,chs1   
03BA                          ENDIF      
03BA                          IF   CHECKED*(1-CPM)   
                              CP   HEAPLIM   
                              RET   C   
03BA                          ENDIF      
03BA                          IF   CHECKED*CPM   
                              LD   E,A   
                              LD   A,(0007h)   ; the BDOS page is the heap limit
                              DEC   A   
                              CP   E   
                              RET   NC   
03BA                          ENDIF      
03BA                          IF   CHECKED   
                    CHS1:     JP   e_store   
                                 ; chkhp: HL = the new heap top, DE = the old one, the carry is from adding
                                 ; the count. Stop if the top is not below the limit page, or is below the
                                 ; program's end.
                    CHKHP:       
03BA                          ENDIF      
03BA                          IF   CHECKED*CPM   
                                 ; With this much room a top that wrapped round can land back in
                                 ; range, so the add is tested too: growing (A, the count's high
                                 ; byte, is positive) must not carry, and releasing must.
                              RRA      ; the carry comes in above the sign:
                              ADD   A,40h   ;   bit 7 = carry XOR sign
                              ADD   A,A   
                              JR   C,e_heap   
                              LD   A,(0007h)   
                              DEC   A   
                              CP   H   
                              JR   C,e_heap   
03BA                          ENDIF      
03BA                          IF   CHECKED*(1-CPM)   
                                 ; (Here the program's space is under 32K, so a top that wrapped
                                 ; round always falls outside it.)
                              LD   A,H   
                              CP   HEAPLIM   
                              JR   NC,e_heap   
03BA                          ENDIF      
03BA                          IF   CHECKED   
                              PUSH   DE   
                              EX   DE,HL   
                              LD   HL,(NPEND)   
                              ADD   HL,DE   ; carry: at or above the program's end
                              EX   DE,HL   
                              POP   DE   
                              RET   C   
                    E_HEAP:   OR   A   ; put the count back in TOS for the report
                              SBC   HL,DE   
                              JP   e_heap1   
                                 ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
                                 ; "$", and the error report's texts). A NUL first is an error: Q.
                    PRSTR:    LD   A,(HL)   
                              INC   HL   
                              CP   22h   
                              RET   Z   
                              OR   A   
                              JR   Z,e_dollar   
                              CP   "/"   
                              JR   NZ,prs1   
                              LD   A,(HL)   
                              INC   HL   
                              AND   0BFh   
                    PRS1:     RST   28h   
                              JR   prstr   
                    E_DOLLAR:   POP   DE   ; "$" ran into a NUL: drop the return address,
                              POP   HL   ;   and put the string's address back in TOS
                              LD   A,"Q"   
                              JP   error   
                                 ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
                                 ; pnl: the same, on a new line.
                    PNL:      LD   A,13   
                              RST   28h   
                              LD   A,10   
                              RST   28h   
                    PMSG:     EX   (SP),HL   
                              CALL   prstr   
                              EX   (SP),HL   
                              RET      
                                 ; chkstk: both stacks are checked once per character, not in every handler.
                                 ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
                                 ; the constant carries if it is above (cells were popped that were never
                                 ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
                                 ; a character late at most: the bytes above DSTOP and the guard band below
                                 ; the page take what happens meanwhile. DE is free between characters.
                    CHKSTK:   EX   DE,HL   
                              LD   HL,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
                              ADD   HL,SP   
                              EX   DE,HL   
                              JR   C,e_under   
                              INC   D   
                              JR   NZ,e_over   
                              EXX      ; the return stack: in its page (or it has
                              LD   A,H   ;   overflowed), and not above its empty
                              CP   RSPAGE   ;   position (an underflow stays inside the
                              LD   A,L   ;   page, in the guard band)
                              EXX      
                              JR   NZ,e_rover   
                              CP   RSTOP&0FFh+1   
                              RET   C   
                              EXX      ; return stack underflow: it counts as empty
                              LD   HL,RSTOP   
                              EXX      
                              LD   A,"r"   
                              JR   errp   
                    E_ROVER:   LD   A,"R"   ; return stack overflow
                              DB   11h   ; (LD DE,nn hides the next entry)
                    E_OVER:   LD   A,"S"   ; data stack overflow
                              JR   errp   
                    E_UNDER:   LD   SP,DSTOP   ; data stack underflow: it counts as empty
                              LD   A,"s"   
                              JR   error   
                                 ; chkbrk: a waiting key is read now; Ctrl-C stops the program, anything
                                 ; else is held for the next "?".
                    CHKBRK:   CALL   getk   
                              RET   Z   
                              CP   3   
                              JR   Z,e_break   
                              LD   (KEYBUF),A   
                              RET      
                                 ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
                                 ; was never defined still holds 0000h, and the byte there is a reserved one
                                 ; in every build (AFh or C3h): if the IP is in page zero, this was a call of
                                 ; an undefined word. The call is undone, so the place is the call itself.
                    E_HI:     INC   B   
                              DJNZ   e_resv   ; (B is as it was, and is not 0)
                              RST   08h   
                              LD   B,D   
                              LD   C,E   
                              LD   A,"U"   
                              JR   error   
                                 ; Error entries. Each loads its letter and then hides the next entry inside
                                 ; a 3-byte LD DE,nn (the 11h), so they all fall through to `error`.
                    E_BREAK:   LD   A,"B"   ; Ctrl-C (found inside chkbrk)
                              DB   11h   
                    E_HEAP1:   LD   A,"H"   ; heap (found inside chkhp)
                              DB   11h   
                    E_STORE:   LD   A,"O"   ; a store outside the program's space (chkst)
                                 ; errp: an error found inside a routine: drop its return address first.
                    ERRP:     POP   DE   
                              JR   error   
                    E_QUOTE:   LD   B,H   ; an unclosed string: HL is its address, one
                              LD   C,L   ;   past the opening quote, which is the place
                              LD   A,"Q"   
                              DB   11h   
                    E_RESV:   LD   A,"X"   ; a reserved byte outside a string
                              DB   11h   
                    E_ZERO:   LD   A,"Z"   ; dividing by zero
                              DB   11h   
                    E_BRACK:   LD   A,"W"   ; bad character after [
                                 ; error: the report, then the end. A = the letter, BC = one past the place,
                                 ; HL = TOS, and both stacks as the report is to show them:
                                 ; 
                                 ;   Err X @ line,col
                                 ;   up to 16 characters of the text from the place
                                 ;   Stk n: the top 8 cells at most, bottom to top
                                 ;   Rtn n
                    ERROR:    PUSH   HL   ; now the whole data stack is in memory
                              LD   E,A   
                              CALL   pnl   
                              DB   "Err ",22h   
                              LD   A,E   
                              RST   28h   
                              CALL   pmsg   
                              DB   " @ ",22h   
                              DEC   BC   ; BC = the place
                                 ; The line and column. A place below the program is in the line
                                 ; buffer: line 0. Otherwise count the LFs from the program's start;
                                 ; DE = the line's number, HL = where it starts.
                              LD   HL,LINEBUF   
                              LD   DE,0   
                              LD   A,B   
                              CP   PROG/256   
                              JR   C,er3   
                              INC   H   
                              LD   L,E   ; HL = PROG
                    ER1:      INC   DE   ; a new line starts at HL
                              PUSH   HL   
                    ER2:      LD   A,L   
                              SUB   C   
                              LD   A,H   
                              SBC   A,B   
                              JR   NC,er2x   ; reached the place
                              LD   A,(HL)   
                              INC   HL   
                              CP   10   
                              JR   NZ,er2   
                              POP   AF   
                              JR   er1   
                    ER2X:     POP   HL   
                    ER3:      PUSH   BC   
                              PUSH   HL   
                              EX   DE,HL   
                              CALL   pdec   ; the line
                              LD   A,","   
                              RST   28h   
                              POP   DE   
                              POP   HL   
                              PUSH   HL   
                              OR   A   
                              SBC   HL,DE   
                              INC   HL   
                              CALL   pdec   ; the column
                              CALL   pnl   
                              DB   22h   
                              POP   HL   ; the text, as it is: 16 characters, or fewer
                              LD   B,16   ;   if the line or the program ends first
                    ER4:      LD   A,(HL)   
                              INC   HL   
                              OR   A   
                              JR   Z,er5   
                              CP   13   
                              JR   Z,er5   
                              CP   10   
                              JR   Z,er5   
03BA                          ENDIF      
03BA                          IF   CHECKED*CPM   
                              CP   1Ah   ; (the ^Z that pads a file's last record ends
                              JR   Z,er5   ;   the text too: some terminals clear the
03BA                          ENDIF      ;   screen on it)
03BA                          IF   CHECKED   
                              RST   28h   
                              DJNZ   er4   
                    ER5:      CALL   pnl   
                              DB   "Stk ",22h   
                              LD   HL,DSTOP-2   ; (the cell at DSTOP-2 was pushed with the
                              OR   A   ;   first value and holds nothing)
                              SBC   HL,SP   
                              CALL   phalf   ; the depth
                              LD   A,":"   
                              RST   28h   
                              LD   A,C   
                              CP   9   
                              JR   C,er6   
                              CALL   pmsg   
                              DB   " ...",22h   
                              LD   C,8   
                    ER6:      LD   H,0   ; C = the number of cells to show
                              LD   L,C   
                              ADD   HL,HL   
                              ADD   HL,SP   ; HL -> just above the deepest of them
                              INC   C   
                    ER7:      DEC   C   
                              JR   Z,er8   
                              DEC   HL   
                              LD   D,(HL)   
                              DEC   HL   
                              LD   E,(HL)   
                              PUSH   HL   
                              PUSH   BC   
                              LD   A," "   
                              RST   28h   
                              EX   DE,HL   
                              CALL   psgn   
                              POP   BC   
                              POP   HL   
                              JR   er7   
                    ER8:      CALL   pnl   
                              DB   "Rtn ",22h   
                              EXX      
                              PUSH   HL   
                              EXX      
                              POP   DE   
                              LD   HL,RSTOP   
                              OR   A   
                              SBC   HL,DE   
                              CALL   phalf   
                              CALL   pnl   
                              DB   22h   
                              JP   endprog   
                                 ; phalf: print half of HL, and leave it in C
                    PHALF:    SRL   H   
                              RR   L   
                              PUSH   HL   
                              CALL   pdec   
                              POP   BC   
                              RET      
03BA                          ENDIF      
03BA                             ; =============================================================================
03BA                             ;  The line editor (EDITOR = 1)
03BA                             ; 
03BA                             ;  The interpreter starts here, and a program that ends comes back here. Type
03BA                             ;  a line and press Return:
03BA                             ; 
03BA                             ;    n text    put the text in as line n; the lines from n on move down.
03BA                             ;              A number past the end, or 0, adds the line at the end.
03BA                             ;    n         take line n out
03BA                             ;    0         run the program
03BA                             ;    -n        list the program from line n on (-1 lists all of it). Any key
03BA                             ;              stops the list until another key is pressed; Ctrl-C ends it.
03BA                             ;    anything else is run at once, as B8Script. (Start such a line with a
03BA                             ;    space if it would begin with a digit or a minus sign.)
03BA                             ; 
03BA                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
03BA                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
03BA                             ;  125 characters, the line number and the one character after it included;
03BA                             ;  that character is not stored. The text is kept as it is typed, each line
03BA                             ;  ending in CR LF, at PROG. Nothing is checked.
03BA                             ; 
03BA                             ;  With CPM = 1 the file named on the command line is the program to start
03BA                             ;  with (no file, or no such file: no program). Lines are read by BDOS 10, so
03BA                             ;  its editing keys work, and Ctrl-C as the first key of a line goes back to
03BA                             ;  CP/M. Nothing is written back: there is no command to save.
03BA                             ; 
03BA                             ;  With CHECKED = 1 a program that is stopped (an error, or Ctrl-C) prints
03BA                             ;  its report and comes back here, with both stacks empty. The place is a
03BA                             ;  line and column of the program; in a line typed here it is line 0.
03BA                             ; 
03BA                             ;  Things to know:
03BA                             ;    - Reset empties the program (generic builds).
03BA                             ;    - Words and variables last from one line to the next. A word's address
03BA                             ;      points into the program, so run the program again after editing it.
03BA                             ;    - Nothing is printed between a program's output and what is typed next.
03BA                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
03BA                             ;      a line that calls -n? and carries on afterwards runs what was typed.
03BA                             ;      (The stored program never comes back to the line, so it may.)
03BA                             ; =============================================================================
03BA                          IF   EDGEN*CHECKED   
                                 ; Reset (A = 0): clear the lower half of the letter page. Every variable
                                 ; starts at 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi), and no key is held back.
                    INIT:     LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
                              JR   edit   
03BA                          ENDIF      
03BA                          IF   EDITOR   
03BA                             ; -n: list from line n. DE = the number of the line at HL.
03BA   03           LIST:     INC   BC   
03BB   CD 10 03               CALL   rdnum   ; HL = n
03BE   E5                     PUSH   HL   
03BF   CD 5E 04               CALL   find   
03C2   D1                     POP   DE   
03C3   7E           LI1:      LD   A,(HL)   
03C4   B7                     OR   A   
03C5   28 32                  JR   Z,edit   ; the end of the text
03C7   CD 9F 03               CALL   getk   
03CA   28 0D                  JR   Z,li3   ; no key: carry on
03CC   FE 03                  CP   3   
03CE   28 29                  JR   Z,edit   ; Ctrl-C
03D0   CD 9F 03     LI2:      CALL   getk   ; any other key: wait for one more
03D3   28 FB                  JR   Z,li2   
03D5   FE 03                  CP   3   
03D7   28 20                  JR   Z,edit   
03D9   E5           LI3:      PUSH   HL   
03DA   D5                     PUSH   DE   
03DB   EB                     EX   DE,HL   
03DC   CD 5B 03               CALL   pdec   ; the line's number,
03DF   3E 20                  LD   A," "   
03E1   EF                     RST   28h   ;   a space,
03E2   D1                     POP   DE   
03E3   E1                     POP   HL   
03E4   13                     INC   DE   
03E5   CD 76 04               CALL   prl   ;   and the line
03E8   18 D9                  JR   li1   
03EA                             ; Take line n (in HL) out: copy everything after it down over it.
03EA   CD 5E 04     DEL:      CALL   find   
03ED   54                     LD   D,H   
03EE   5D                     LD   E,L   
03EF   CD 6C 04               CALL   nxl   ; HL -> the next line
03F2   7E           DE1:      LD   A,(HL)   
03F3   12                     LD   (DE),A   
03F4   23                     INC   HL   
03F5   13                     INC   DE   
03F6   B7                     OR   A   
03F7   20 F9                  JR   NZ,de1   ; and fall into the editor
03F9   31 FC 06     EDIT:     LD   SP,DSTOP   
03FC                          ENDIF      
03FC                          IF   EDITOR*CPM*CHECKED   
                                 ; A key that the break check held back while a program ran is let
                                 ; go: BDOS 10 would not see it, and it would turn up in the next
                                 ; program that asked for a key. (This also serves at the start.)
                              XOR   A   
                              LD   (KEYBUF),A   
03FC                          ENDIF      
03FC                          IF   EDGEN   
                              LD   D,0FDh   ; 125 characters at most
03FC                          ENDIF      
03FC                          IF   EDITOR*CPM   
03FC   3E 7D                  LD   A,125   
03FE                          ENDIF      
03FE                          IF   EDITOR   
03FE   CD D5 02               CALL   rdline   ; HL -> the CR that ended the line
0401   2C                     INC   L   
0402   36 0A                  LD   (HL),10   ; a LF after it,
0404   2D                     DEC   L   
0405   CD 76 04               CALL   prl   ; (print the CR LF: a new line)
0408   36 00                  LD   (HL),0   ;   and a NUL after that
040A   E5                     PUSH   HL   ; the end of what was typed
040B   01 80 07               LD   BC,LINEBUF   
040E   0A                     LD   A,(BC)   
040F   FE 2D                  CP   "-"   
0411   28 A7                  JR   Z,list   
0413   CD 10 03               CALL   rdnum   ; HL = the number it starts with, BC -> after
0416   79                     LD   A,C   ; C is still 80h if there was no number:
0417   87                     ADD   A,A   ;   only then is twice it 0
0418   28 0C                  JR   Z,st0   ; no number: run the line where it is
041A   0A                     LD   A,(BC)   
041B   D6 0D                  SUB   13   
041D   20 19                  JR   NZ,ins   ; text follows the number
041F   B4                     OR   H   ; the number alone:
0420   B5                     OR   L   
0421   20 C7                  JR   NZ,del   ;   not 0: take that line out
0423   01 00 08               LD   BC,PROG   ;   0: run the program
0426                             ; st0: start running at BC. The heap starts after the stored program's NUL.
0426   E1           ST0:      POP   HL   ; (the end of what was typed: the stack is empty)
0427   21 00 08               LD   HL,PROG   
042A   AF                     XOR   A   
042B   BE           ST1:      CP   (HL)   
042C   23                     INC   HL   
042D   20 FC                  JR   NZ,st1   
042F   22 7C 07               LD   (HEAP),HL   
0432                          ENDIF      
0432                          IF   EDITOR*CHECKED   
                              RST   20h   ; minus the heap"s first address: "_' may not
                              LD   (NPEND),HL   ;   release below it
0432                          ENDIF      
0432                          IF   EDITOR   
0432   D9                     EXX      
0433   21 E0 05               LD   HL,RSTOP   ; the return stack is empty
0436   D9                     EXX      
0437   F7                     RST   30h   ; (its return address is thrown away)
0438                             ; Put the typed text in as line n (in HL): open a gap of its length there,
0438                             ; CR and LF included, and copy it in.
0438   CD 5E 04     INS:      CALL   find   ; HL -> where it goes
043B   03                     INC   BC   ; step over the one character after the number
043C   D1                     POP   DE   ; the end of what was typed
043D   7B                     LD   A,E   
043E   91                     SUB   C   ; A = the length of the text, with its CR LF
043F   C5                     PUSH   BC   ; the text
0440   4F                     LD   C,A   
0441   06 00                  LD   B,0   
0443   C5                     PUSH   BC   ; its length
0444   54                     LD   D,H   
0445   5D                     LD   E,L   ; DE = where it goes
0446   AF                     XOR   A   
0447   4F                     LD   C,A   ; BC = 0: CPIR looks as far as it needs to
0448   ED B1                  CPIR      ; HL -> one past the program's NUL
044A   ED 52                  SBC   HL,DE   ; the number of bytes to move up, NUL included
044C   44                     LD   B,H   
044D   4D                     LD   C,L   
044E   19                     ADD   HL,DE   
044F   2B                     DEC   HL   ; HL -> the NUL
0450   EB                     EX   DE,HL   
0451   E3                     EX   (SP),HL   ; HL = the length; where it goes is kept
0452   E5                     PUSH   HL   
0453   19                     ADD   HL,DE   ; the NUL's new place
0454   EB                     EX   DE,HL   
0455   ED B8                  LDDR      ; move the rest of the program up
0457   C1                     POP   BC   ; the length
0458   D1                     POP   DE   ; where it goes
0459   E1                     POP   HL   ; the text
045A   ED B0                  LDIR      
045C   18 9B                  JR   edit   
045E                             ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
045E                             ; of the text if there are fewer lines (or the number is 0). Keeps BC.
045E   EB           FIND:     EX   DE,HL   
045F   21 00 08               LD   HL,PROG   
0462   1B           FI1:      DEC   DE   
0463   7A                     LD   A,D   
0464   B3                     OR   E   
0465   C8                     RET   Z   
0466   CD 6C 04               CALL   nxl   
0469   20 F7                  JR   NZ,fi1   
046B   C9                     RET      
046C                             ; nxl: step HL over one line, to just past its LF (and return not-zero), or
046C                             ; stop at the NUL that ends the text (and return zero).
046C   7E           NXL:      LD   A,(HL)   
046D   B7                     OR   A   
046E   C8                     RET   Z   
046F   23                     INC   HL   
0470   FE 0A                  CP   10   
0472   20 F8                  JR   NZ,nxl   
0474   B7                     OR   A   
0475   C9                     RET      
0476                             ; prl: print the line at HL, to its LF; HL -> just past it.
0476   7E           PRL:      LD   A,(HL)   
0477   EF                     RST   28h   
0478   7E                     LD   A,(HL)   
0479   23                     INC   HL   
047A   FE 0A                  CP   10   
047C   20 F8                  JR   NZ,prl   
047E   C9                     RET      
047F                          ENDIF      
047F                             ; =============================================================================
047F                             ;  CP/M startup (the generic build starts at address 0: see st0)
047F                             ; =============================================================================
047F                          IF   CPM   
047F                             ; The RAM pages follow the image; the heap may grow to the BDOS.
047F                START:       
047F                          ENDIF      
047F                          IF   CPM*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
                                 ; is held back.
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
047F                          ENDIF      
047F                          IF   CPM   
047F   21 08 01               LD   HL,vecs   ; the RST routines go down into page zero
0482   11 08 00               LD   DE,0008h   
0485   01 2C 00               LD   BC,vecend-vecs   
0488   ED B0                  LDIR      
048A   11 5C 00               LD   DE,005Ch   ; open the file named on the command line
048D   0E 0F                  LD   C,15   ; (no such file: the first read fails too,
048F   CD 05 00               CALL   BDOS   ;   and the program is empty)
0492   11 00 08               LD   DE,PROG   
0495   D5           LD1:      PUSH   DE   
0496   0E 1A                  LD   C,26   ; set the DMA address
0498   CD 05 00               CALL   BDOS   
049B   11 5C 00               LD   DE,005Ch   
049E   0E 14                  LD   C,20   ; read the next 128 bytes
04A0   CD 05 00               CALL   BDOS   
04A3   E1                     POP   HL   ; HL = the address this record went to
04A4   B7                     OR   A   
04A5   20 07                  JR   NZ,ld2   
04A7   11 80 00               LD   DE,128   
04AA   19                     ADD   HL,DE   
04AB   EB                     EX   DE,HL   
04AC   18 E7                  JR   ld1   
04AE                LD2:         
04AE                          ENDIF      
04AE                          IF   CPM*(1-EDITOR)   
                              LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
                              JP   st2   
04AE                          ENDIF      
04AE                          IF   CPM*EDITOR   
04AE                             ; The editor wants the text to end where the file's text ends: at
04AE                             ; the first ^Z (1Ah), which pads a text file's last record. One more
04AE                             ; goes after the last record, so the search always stops. And every
04AE                             ; line must end in LF: a last line without one is given a CR LF.
04AE   36 1A                  LD   (HL),1Ah   
04B0   21 FF 07               LD   HL,PROG-1   
04B3   3E 0A                  LD   A,10   ; (a file with no text needs nothing added)
04B5   23           TR1:      INC   HL   
04B6   5F                     LD   E,A   ; E = the character before this one
04B7   7E                     LD   A,(HL)   
04B8   FE 1A                  CP   1Ah   
04BA   20 F9                  JR   NZ,tr1   
04BC   7B                     LD   A,E   
04BD   FE 0A                  CP   10   
04BF   28 06                  JR   Z,tr2   
04C1   36 0D                  LD   (HL),13   
04C3   23                     INC   HL   
04C4   36 0A                  LD   (HL),10   
04C6   23                     INC   HL   
04C7   36 00        TR2:      LD   (HL),0   
04C9   C3 F9 03               JP   edit   
04CC                          ENDIF      
04CC                          IF   CPM   
04CC                             ; RAM pages, after the image
04CC                RSPAGE:   EQU   (imgend + 255) / 256   
04CC                DSPAGE:   EQU   RSPAGE + 1   
04CC                LETPAGE:   EQU   RSPAGE + 2   
04CC                PROG:     EQU   LETPAGE*256 + 256   
04CC                          ENDIF      
04CC                IMGEND:      


