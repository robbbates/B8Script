  1820 00000804 ????????            <1> v_cnt:  resd    1               ; a count for ReadFile and the like
  1821 00000808 ????????            <1> v_hin:  resd    1               ; the standard input handle
  1822 0000080C ????????            <1> v_outh: resd    1               ; the handle putc writes to
  1823 00000810 ????????            <1> v_dstop:resd    1               ; ESP for the empty data stack
  1824 00000814 ??                  <1> v_iscon:resb    1               ; non-zero if the input is a console
  1825 00000815 ??                  <1> v_pcnt: resb    1               ; the break key's countdown
  1826 00000816 ????????            <1> v_mode: resd    1               ; the console's input mode at the start
  1827 0000081A ????????            <1> v_npend:resd    1               ; the heap's first address (checked '_')
  1828 0000081E ????????            <1> v_skat: resd    1               ; where the skip started (checked N)
  1829 00000822 ????????            <1> v_edln: resd    1               ; the editor: the line ^E put in the input
  1830                              <1> v_end:
  1831                              <1>         times   -((v_end-next) > 128) db 0      ; (an error if out of reach)
  1832                              <1>         times   -((next-iat) > 128) db 0
