E28E   D0 02                  BNE   tg1   
E290   F6 01                  INC   1,X   
E292   60           TG1:      RTS      
E293                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
E293                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
E293                             ; the body"s address instead. Either way it then skips to the matching "]'.
E293                             ; (The unchecked build takes anything that is not a letter as the space; the
E293                             ; checked build stops on it.)
E293                          IF   CHECKED   
                    DEF1:     CPY   #" "-"A"+256   
                              BEQ   def2   
                                 ; W: anything but a letter or a space after [. The place is that character,
                                 ; one past the [.
                              INC   PLACE   
                              BNE   eb1   
                              INC   PLACE+1   
                    EB1:      LDA   #"W"   
                              JMP   error   
E293                          ENDIF      
E293   20 48 E5     H_DEF:    JSR   getc   
E296   38                     SEC      
E297   E9 41                  SBC   #"A"   ; a letter gives 0-25 or 32-57: lowercase
E299   A8                     TAY      ;   lands 64 bytes up
E29A   29 DF                  AND   #0DFh   ; fold case: 0-25 only for a letter
E29C   C9 1A                  CMP   #26   
E29E                          IF   1-CHECKED   
E29E   B0 0F                  BCS   def2   ; not a letter
E2A0                          ENDIF      
E2A0                          IF   CHECKED   
                              BCS   def1   
E2A0                          ENDIF      
E2A0   98                     TYA      
E2A1   0A                     ASL      
E2A2   A8                     TAY      ; Y -> the cell
E2A3   A5 00                  LDA   IP   
E2A5   99 00 04               STA   LET,Y   
E2A8   A5 01                  LDA   IP+1   
E2AA   99 01 04               STA   LET+1,Y   
E2AD   D0 03                  BNE   dsk   ; always: no program is in page zero
E2AF   20 C3 E4     DEF2:     JSR   puship   ; an anonymous block: push its address
E2B2                DSK:         
E2B2                          IF   CHECKED   
                              LDA   #")"   ; the wrong closer for [
E2B2                          ENDIF      
E2B2   4C D8 E0               JMP   skip   
E2B5                             ; ---- the grave
E2B5                             ; The grave is a prefix: with the character after it, it is one command.
E2B5                             ; GTAB (after the three pages, with the handlers) holds each character with
E2B5                             ; its handler's address, less 1 for the RTS trick. A handler starts with the
E2B5                             ; carry SET and Y = three times its place in the table, and ends in RTS. A
E2B5                             ; character that is not in the table is unsafe: the unchecked build does
E2B5                             ; nothing, the checked build stops with W.
E2B5                H_GRAVE:      
E2B5                          IF   CHECKED   
                              INC   PLACE   ; the place of anything that goes wrong in
                              BNE   gr0   ;   one of these is the character after the
                              INC   PLACE+1   ;   grave
                    GR0:         
E2B5                          ENDIF      
E2B5   20 48 E5               JSR   getc   
E2B8   A0 24                  LDY   #GTABE-GTAB-3   
E2BA   D9 2A E3     GR1:      CMP   GTAB,Y   
E2BD   F0 06                  BEQ   gr2   
E2BF   88                     DEY      
E2C0   88                     DEY      
E2C1   88                     DEY      
E2C2   10 F6                  BPL   gr1   
E2C4                          IF   1-CHECKED   
E2C4   60                     RTS      ; no such code
E2C5                          ENDIF      
E2C5                          IF   CHECKED   
                              JMP   eb1   ; no such code: W
E2C5                          ENDIF      
E2C5   B9 2C E3     GR2:      LDA   GTAB+2,Y   
E2C8   48                     PHA      
E2C9   B9 2B E3               LDA   GTAB+1,Y   
E2CC   48                     PHA      
E2CD   60                     RTS      ; to the handler
E2CE                             ; `! ( addr -- ): call the machine code at addr; see the contract in the
E2CE                             ; header.
E2CE   B5 00        EXEC:     LDA   0,X   
E2D0   85 04                  STA   T0   
E2D2   B5 01                  LDA   1,X   
E2D4   85 05                  STA   T1   
E2D6   E8                     INX      ; the address is consumed
E2D7   E8                     INX      
E2D8   6C 04 00               JMP   (T0)   
E2DB                             ; ---- "_" is the last handler: its body may leave the page
E2DB                             ; "_" ( n -- addr ): the heap top moves by n, which is signed: a negative
E2DB                             ; count releases. TOS becomes the old top. (The carry is clear on the way in.)
E2DB                          IF   1-CHECKED   
E2DB   AD 7C 04     H_ALLOC:   LDA   HEAP   
E2DE   A8                     TAY      
E2DF   75 00                  ADC   0,X   
E2E1   8D 7C 04               STA   HEAP   
E2E4   94 00                  STY   0,X   
E2E6   AD 7D 04               LDA   HEAP+1   
E2E9   A8                     TAY      
E2EA   75 01                  ADC   1,X   
E2EC   8D 7D 04               STA   HEAP+1   
E2EF   94 01                  STY   1,X   
E2F1   60                     RTS      
E2F2                          ENDIF      
E2F2                             ; The checked build works the new top out first, in T0 and Y, and stops with
E2F2                             ; H, the count still on the stack, if it is at or past the limit, below the
E2F2                             ; program's end, or if the 16-bit add wrapped. A wrap is the V flag of the
E2F2                             ; high bytes" add with the old top"s sign bit flipped: that makes the old top
E2F2                             ; a signed number from -8000h, so the add overflows exactly when the true
E2F2                             ; sum leaves 0000h-FFFFh.
E2F2                          IF   CHECKED   
                    H_ALLOC:   LDA   HEAP   
                              ADC   0,X   
                              STA   T0   
                              LDA   HEAP+1   
                              EOR   #80h   
                              ADC   1,X   
                              BVS   e_heap   ; wrapped
                              EOR   #80h   ; the new top's high byte
                              CMP   #HEAPLIM   
                              BCS   e_heap   ; at or past the limit
                              TAY      
                              LDA   T0   
                              CMP   PEND   
                              TYA      
                              SBC   PEND+1   
                              BCC   e_heap   ; below the program's end
                              LDA   HEAP   
                              STA   0,X   
                              LDA   T0   
                              STA   HEAP   
                              LDA   HEAP+1   
                              STA   1,X   
                              STY   HEAP+1   
                              RTS      
                                 ; Errors found by handlers. The stacks are as they were before the handler.
                    E_HEAP:   LDA   #"H"   ; heap past the limit or below the program
                              DB   2Ch   ; (BIT abs: hides the next instruction)
                    E_STORE:   LDA   #"O"   ; a store outside the program's space
                              JMP   error   
                                 ; chkst: stop unless the address in the top cell is in the program's own
                                 ; space, from the letter page up to the heap limit. Keeps A and Y.
                    CHKST:    PHA      
                              LDA   1,X   
                              CMP   #LETPAGE   
                              BCC   e_store   
                              CMP   #HEAPLIM   
                              BCS   e_store   
                              PLA      
                              RTS      
E2F2                          ENDIF      
E2F2                             ; =============================================================================
E2F2                             ;  The rest: no handler starts past this point
E2F2                             ; =============================================================================
E2F2                          ;*Macro unroll:  UDIV
E2F2   A9 00        UDIV:     LDA   #0   
E2F4   95 FE                  STA   0FEh,X   
E2F6   95 FF                  STA   0FFh,X   
E2F8   A5 08                  LDA   D0   
E2FA   49 02                  EOR   #2   
E2FC   05 09                  ORA   D1   
E2FE   D0 07                  BNE   ud0   
E300   56 01                  LSR   1,X   
E302   76 00                  ROR   0,X   
E304   36 FE                  ROL   0FEh,X   
E306   60                     RTS      
E307   A0 10        UD0:      LDY   #16   
E309   16 00        UD1:      ASL   0,X   
E30B   36 01                  ROL   1,X   
E30D   36 FE                  ROL   0FEh,X   
E30F   36 FF                  ROL   0FFh,X   
E311   38                     SEC      
E312   B5 FE                  LDA   0FEh,X   
E314   E5 08                  SBC   D0   
E316   85 04                  STA   T0   
E318   B5 FF                  LDA   0FFh,X   
E31A   E5 09                  SBC   D1   
E31C   90 08                  BCC   ud2   
E31E   95 FF                  STA   0FFh,X   
E320   A5 04                  LDA   T0   
E322   95 FE                  STA   0FEh,X   
E324   F6 00                  INC   0,X   
E326   88           UD2:      DEY      
E327   D0 E0                  BNE   ud1   
E329   60                     RTS      
E32A                             ; =============================================================================
E32A                             ;  The grave's codes (h_grave, in the third page, is the dispatcher). Each
E32A                             ;  starts with the carry SET and Y = three times its place in GTAB.
E32A                             ; 
E32A                             ;    `!  ( addr -- )        call the machine code at addr (exec)
E32A                             ;    `$  ( addr -- addr' )  the hex loader: pairs of hex digits are stored
E32A                             ;                           from addr until a non-hex character; then a RTS
E32A                             ;                           (60h) is written and its address is left. An odd
E32A                             ;                           last digit is consumed and dropped.
E32A                             ;    `'  ( -- )             new line: CR LF
E32A                             ;    `+  ( addr -- n )      add 1 to the cell at addr and leave its new value
E32A                             ;    `,  ( n -- r )         a random number from 0 to n-1 (n is 1 to 32767)
E32A                             ;    `-  ( addr -- n )      subtract 1 from the cell at addr, the same way
E32A                             ;    `.  ( -- addr )        the address of the random seed
E32A                             ;    `<  ( a b -- n )       the smaller of the two (signed)
E32A                             ;    `>  ( a b -- n )       the larger
E32A                             ;    `?  ( flag -- )        the cursor off (0) or on
E32A                             ;    `@  ( row col -- )     the cursor to that row and column, both from 0
E32A                             ;    `^  ( -- )             clear the screen and home the cursor
E32A                             ;    `_  ( -- )             clear from the cursor to the end of the line
E32A                             ; =============================================================================
E32A   21           GTAB:     DB   "!"   
E32B   CD E2                  DW   exec-1   
E32D   24                     DB   "$"   
