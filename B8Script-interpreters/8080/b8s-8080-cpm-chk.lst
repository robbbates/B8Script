057A   DA 84 05               JC   e_store   
057D                          ENDIF      
057D                          IF   CHECKED*(1-CPM)   
                              CPI   HEAPLIM   
                              RC      
057D                          ENDIF      
057D                          IF   CHECKED*CPM   
057D   5F                     MOV   E,A   
057E   3A 07 00               LDA   0007h   ; the BDOS page is the heap limit
0581   3D                     DCR   A   
0582   BB                     CMP   E   
0583   D0                     RNC      
0584                          ENDIF      
0584                          IF   CHECKED   
