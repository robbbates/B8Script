0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Spec: docs/b8script.md (2026-11-24).
0000                             ; 
0000                             ;  The switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    EDITOR   1 = with the line editor built in (see the end of this file):
0000                             ;                 the spec's suggested standard. It goes with either setting
0000                             ;                 of the other two.
0000                             ;    CHECKED  0 = no checks (spec: the programmer is responsible)
0000                             ;             1 = starts with every variable at 0 and every word undefined,
0000                             ;                 and stops on every error in the spec's table (and Ctrl-C)
0000                             ;                 with a four-line report: the letter and the place as line
0000                             ;                 and column, the text there, and both stacks. See `error`.
0000                             ;    SPEED    0 = small: the smallest build
0000                             ;             1 = base, the default: the speed-ups that cost bytes: a skip
0000                             ;                 cache, a faster skip, "*" and "/" quicker for small and
0000                             ;                 power-of-two operands, and more (see "Speed-ups")
0000                             ;             2 = fast: base and a dispatch table besides, with no size
0000                             ;                 limit (see "The fast build"). Not with EDITOR.
0000                             ;    ANSI     what the console escapes of "$" (/00bbIC8= /| /` /~) do:
0000                             ;             1 = send ANSI (VT100) sequences through CONOUT
0000                             ;             0 = call the machine's own routines CONCLS, CONEOL, CONCUR and
0000                             ;                 CONAT (see the equates). The CP/M builds always send ANSI.
0000                             ; 
0000                             ;  In every build Ctrl-C stops a running program (an unchecked build stops
0000                             ;  without a word): see the console layer for the rules, the held key and
0000                             ;  the break-off cell.
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   0   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   0   ; 1 = checked build
0000                EDITOR:   EQU   0   ; 1 = with the line editor
0000                ANSI:     EQU   0   ; 1 = the console escapes send ANSI sequences
0000                SPEED:    EQU   2   ; 0 = small, 1 = base, 2 = fast (not with EDITOR) (see "Speed-ups")
0000                FAST:     EQU   SPEED/2   ; (1: the fast build)
0000                SBASE:    EQU   SPEED-FAST*2   ; (1: the base build)
0000                ANS:      EQU   ANSI+CPM-ANSI*CPM   ; (CP/M: always ANSI)
0000                EDGEN:    EQU   EDITOR*(1-CPM)   ; (the generic build with the editor)
0000                             ; (IF takes any value but 0 as true, so
0000                             ;  IF CHECKED+EDITOR means "either")
0000                TABP0:    EQU   EDGEN*(1-CHECKED)   ; (the build with its table in page zero)
0000                PTLATE:   EQU   1-(1-CPM)*(1-EDITOR)*(1-CHECKED)*(1-ANS)   ; (1: the table goes after psgn and pdec,
0000                             ;   not before them: wherever it doesn't cross a
0000                             ;   page. chktab.py says if it does)
0000                QK:       EQU   SBASE+FAST-SBASE*FAST   ; (the speed-ups: base, or the fast build)
0000                SBASEU:   EQU   QK*(1-CHECKED)*(1-FAST)   ; (and those that only the unchecked
0000                             ;  builds take; the fast build has its own)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    IY   return-stack pointer. Entries are 2 bytes; the stack grows down.
0000                             ;         Only rpop and rpushn (and the checks) touch it. The alternate
0000                             ;         registers are not used at all: an interrupt routine may use them.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  One-byte calls. In a generic build the routines used most are reached
0000                             ;  with RST, one byte instead of three. The source writes them as macros:
0000                             ; 
0000                             ;    POPR   RST 08h  rpop    pop the return stack into DE
0000                             ;    DROP   RST 18h  drp     drop TOS, then next character  (ends a handler)
0000                             ;    NEGH   RST 20h  neg16   HL = -HL
0000                             ;    PUTA   RST 28h  putc    print A
0000                             ;    NEXT   RST 30h  next0   next character                 (ends a handler)
0000                             ; 
0000                             ;  RST 18h and RST 30h never return: an RST is a CALL, so the first thing
0000                             ;  each of them does is POP DE to throw the return address away.
0000                             ; 
0000                             ;  A CP/M build leaves page zero alone: there the macros are CALLs, and
0000                             ;  DROP and NEXT are jumps (DROPR and NEXTR: JR, where it reaches).
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (the top four bytes of the page are spare,
0000                             ;             so a full stack runs two bytes into the page below)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch, interpreter variables in the gaps, and the -n? line buffer
0000                             ;             at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack has a guard band: the data stack can
0000                             ;  overrun by a cell or two (and the calls made while it is full, the error
0000                             ;  report's included) into the top 32 bytes of the return-stack page, which
0000                             ;  are never used, and the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
                    BDOS:     EQU   0005h   
                    BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IF   CPM*(1-EDITOR)   
                    EXIT:     EQU   0000h   ; warm boot
0000                          ENDIF      
0000                          IFN   CPM   
0000                             ; ---- generic machine: edit these to suit -----------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The zero flag must match A
0000                             ;   (end the routine with OR A / RET).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                             ;   KEY and CONOUT must preserve BC, DE, HL and IY.
0000                          ENDIF      
0000                          IF   1-ANS   
0000                             ; With ANSI = 0 the console escapes call these. All four must keep BC and
0000                             ; IY, and all but CONAT also HL. They may change A, DE and the flags.
0000                CONCLS:   EQU   0FF0Ch   ; /{  clear the screen, the cursor to the top left
0000                CONEOL:   EQU   0FF0Fh   ; /}  clear from the cursor to the end of the line
0000                CONCUR:   EQU   0FF12h   ; /| and /`  show the cursor if A is not 0, hide
0000                             ;     it if A = 0
0000                CONAT:    EQU   0FF15h   ; /~  the cursor to row HL, column DE, both
0000                             ;     counted from 0. May change A, DE and HL
0000                          ENDIF      
0000                          IFN   CPM   
0000                RSPAGE:   EQU   80h   ; 8000h return stack
0000                DSPAGE:   EQU   81h   ; 8100h data stack
0000                LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
0000                PROG:     EQU   8300h   ; where the loader puts the program text
0000                HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
0000                CPAGE:    EQU   HEAPLIM   ; the skip cache's page (QK builds): the page
0000                             ;   at the heap limit, which the heap never reaches
0000                BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)   
0000                EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                          ENDIF      
0000                          IF   EDGEN   
                    LEAVE:    EQU   0FF09h   ; where the editor's ^X goes
0000                          ENDIF      
0000                          IF   EDITOR*CPM   
                    LEAVE:    EQU   0000h   ; the editor's ^X: warm boot
0000                          ENDIF      
0000                          IF   EDITOR   
                    EXIT:     EQU   edend   ; a program that ends goes back to the editor,
                    SKEND:    EQU   skend   ;   also when it ends inside skip
0000                          ENDIF      
0000                          IF   1-EDITOR   
0000                SKEND:    EQU   EXIT   
0000                          ENDIF      
0000                MSLOOP:   EQU   40-36*CPM   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine. (The wait
0000                             ; for a second Ctrl-C uses it too: 250 ms.)
0000                             ; CP/M: 4, for a BDOS 6 call of about 280 us
0000                             ; (an RC2014 with RomWBW and ZPM3). A .COM can
0000                             ; be patched: see TIMING.B8S.
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                             ;   around machine code (and in the checked
0000                             ;   build the address "$" prints from);
0000                PCNT:     EQU   LET+36h   ;   the break-key poll count (see rpushn);
0000                SKPL:     EQU   LET+3Ch   ;   the checked skip's starting place;
0000                NPEND:    EQU   LET+38h   ;   minus the address of the program's end
0000                             ;   (the heap"s first byte), for the checked "_';
0000                EDLN:     EQU   LET+3Ah   ;   the editor: the number of the line that ^E
0000                             ;   put in the input line (0: none)
0000                KEYBUF:   EQU   LET+7Ah   ; gap after z: a key read by the break check and
0000                             ;   held for the next "?" (0: none);
0000                BRKOFF:   EQU   LET+7Bh   ;   the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FCh   ; empty data stack. The four bytes above it
0000                             ; are spare: a character can pop two cells
0000                             ; too many before the checked build sees it,
0000                             ; and the next call must not land on the
0000                             ; letter cells.
0000                             ; The five one-byte calls. A generic build owns page zero and reaches them
0000                             ; with RST. A CP/M build must leave page zero alone (CP/M keeps it for
0000                             ; interrupts, and RomWBW's BIOS calls itself through RST 08h), so there each
0000                             ; is a CALL, or a jump for the two that never return: DROP is a JP, and
0000                             ; NEXT is JP (IX), two bytes, with IX holding next0's address throughout.
0000                             ; (asm80 can't nest IF, so these are written with DS: a count of 0 writes
0000                             ; nothing. DS can't take a label that comes later, but EQU can, and DS can
0000                             ; take that.)
0000                AROP:     EQU   rpop   
0000                ANEG:     EQU   neg16   
0000                APUT:     EQU   putc   
0000                APTK:     EQU   putk   
0000                          IF   1-CPM   
0000                PUTK:     EQU   putc   ; (CP/M only: here it is never used)
0000                          ENDIF      
0000                ANXT:     EQU   next0   
0000                          IF   CHECKED   
                    ACHK:     EQU   chkstk   ; (for the fast build's dispatcher)
0000                          ENDIF      
0000                          IF   1-CHECKED   
0000                ACHK:     EQU   0   
0000                          ENDIF      
0000                          IF   FAST   
0000                DTPG:     EQU   DTAB/256   ; (the fast build"s table"s first page)
0000                          ENDIF      
0000                          IF   1-FAST   
                    DTPG:     EQU   0   
0000                          ENDIF      
0000                .macro POPR,
0000                             ; 
0000                 DS      1-CPM,0CFh      ;   RST 08h
0000                 DS      CPM,0CDh        ;   CALL rpop
0000                 DS      CPM,AROP&0FFh
0000                 DS      CPM,AROP/256
0000                .endm
0000                 
0000                .macro DROP,
0000                             ; 
0000                 DS      (1-CPM)*(1-FAST),0DFh ; RST 18h
0000                 DS      CPM+FAST-CPM*FAST,0E1h ; POP HL
0000                 DS      CPM+FAST-CPM*FAST,0DDh ; JP (IX)
0000                 DS      CPM+FAST-CPM*FAST,0E9h
0000                .endm
0000                 
0000                .macro NEGH,
0000                             ; 
0000                 DS      1-CPM,0E7h      ;   RST 20h
0000                 DS      CPM,0CDh        ;   CALL neg16
0000                 DS      CPM,ANEG&0FFh
0000                 DS      CPM,ANEG/256
0000                .endm
0000                 
0000                .macro PUTA,
0000                             ; 
0000                 DS      1-CPM,0EFh      ;   RST 28h
0000                 DS      CPM,0CDh        ;   CALL putc
0000                 DS      CPM,APUT&0FFh
0000                 DS      CPM,APUT/256
0000                .endm
0000                 
0000                .macro PUTK,
0000                             ; 
0000                 DS      1-CPM,3Eh       ;   LD A,%%1 / RST 28h
0000                 DS      1-CPM,%%1
0000                 DS      1-CPM,0EFh
0000                 DS      CPM,0CDh        ;   CALL putk / DB %%1
0000                 DS      CPM,APTK&0FFh
0000                 DS      CPM,APTK/256
0000                 DS      CPM,%%1
0000                .endm
0000                 
0000                .macro PUTAR,
0000                             ; 
0000                 DS      1-CPM,0EFh      ;   RST 28h
0000                 DS      1-CPM,0C9h      ;   RET
0000                 DS      CPM,0C3h        ;   JP putc
0000                 DS      CPM,APUT&0FFh
0000                 DS      CPM,APUT/256
0000                .endm
0000                 
0000                .macro NEXT,
0000                             ; 
0000                 DS      (1-CPM)*(1-FAST),0F7h ; RST 30h
0000                 DS      CPM+FAST-CPM*FAST,0DDh ; JP (IX): IX holds next0
0000                 DS      CPM+FAST-CPM*FAST,0E9h
0000                .endm
0000                 
0000                .macro NEXTF,
0000                             ; 
0000                 DS      FAST*CHECKED,0CDh ;   (fast build: CALL chkstk, checked)
0000                 DS      FAST*CHECKED,ACHK&0FFh
0000                 DS      FAST*CHECKED,ACHK/256
0000                 DS      FAST,0Ah        ;   (fast build: the dispatcher: LD A,(BC)
0000                 DS      FAST,03h        ;   INC BC
0000                 DS      FAST,0EBh       ;   EX DE,HL
0000                 DS      FAST,6Fh        ;   LD L,A
0000                 DS      FAST,26h        ;   LD H,DTAB/256
0000                 DS      FAST,DTPG
0000                 DS      FAST,7Eh        ;   LD A,(HL)
0000                 DS      FAST,24h        ;   INC H
0000                 DS      FAST,66h        ;   LD H,(HL)
0000                 DS      FAST,6Fh        ;   LD L,A
0000                 DS      FAST,0E9h       ;   JP (HL))
0000                .endm
0000                 
0000                .macro NEXTZ,
0000                             ; 
0000                 DS      1-CPM,0F7h      ;   byte there in every build (RST 30h)
0000                 DS      CPM,0DDh        ; JP (IX)
0000                 DS      CPM,0E9h
0000                .endm
0000                 
0000                .macro SETIX,
0000                             ; 
0000                 DS      CPM+FAST-CPM*FAST,0DDh ; a generic build): LD IX,next0
0000                 DS      CPM+FAST-CPM*FAST,21h
0000                 DS      CPM+FAST-CPM*FAST,ANXT&0FFh
0000                 DS      CPM+FAST-CPM*FAST,ANXT/256
0000                .endm
0000                 
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is just the start of the .COM file.
0000                             ; =============================================================================
0000                          .ORG   BASE   
0000                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              XOR   A   ; 00  reset. (This byte, AFh, is also what an
0000                          ENDIF      ;     undefined word runs into: see e_hi.)
0000                          IF   1-EDGEN   
0000   31 FC 81               LD   SP,DSTOP   ; 00  reset, or the start of the .COM file
0003                          ENDIF      
0003                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)*(1-QK)   
                              LD   BC,PROG   ; 03  the IP
                              JR   st0   ; 06  (the rest of the startup is close by)
0003                          ENDIF      
0003                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)*QK   
0003   C3 9C 04               JP   qstart   ; 03  (the skip cache is emptied first)
0006   00 00                  DW   0   ; 06  spare
0008                          ENDIF      
0008                          IF   (1-CPM)*(1-EDITOR)*CHECKED*(1-QK)   
                              JR   init   ; 04  (the rest of the startup is close by)
                              DW   0   ; 06  spare
0008                          ENDIF      
0008                          IF   (1-CPM)*(1-EDITOR)*CHECKED*QK   
                              JP   qinit   ; 04  (the skip cache is emptied first)
                              DB   0   ; 07  spare
0008                          ENDIF      
0008                          IF   EDGEN   
                              XOR   A   ; 00  reset: no program yet. (This byte, AFh,
                              LD   (PROG),A   ;     is also what an undefined word runs
                              JP   init   ; 04  into in the checked build: see e_hi.)
                              NOP      ; 07  spare
0008                          ENDIF      
0008                          IF   CPM*(1-EDITOR)   
                              JP   start   ; 03
0008                          ENDIF      
0008                          IF   CPM*EDITOR*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
                                 ; is held back.
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
0008                          ENDIF      
0008                          IF   CPM*EDITOR   
                              CALL   load   ; the file named on the command line
                              JP   edit0   
0008                          ENDIF      
0008                          IF   1-CPM   
0008                             ; ---- RST 08h: rpop: pop the return stack into DE ---------------------------
0008   FD 5E 00     RPOP:     LD   E,(IY+0)   ; 08
000B   FD 56 01               LD   D,(IY+1)   
000E   18 1B                  JR   rp2   ; (the rest is at 2Bh)
0010                             ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
0010   C6 21        CTL:      ADD   A,21h   ; 10  back to c; zero only for NUL
0012   20 1D                  JR   NZ,next0   ;     the rest are ignored
0014   C3 09 FF     ENDPROG:   JP   EXIT   ;     the program has ended
0017   00                     NOP      ; 17  spare
0018                             ; ---- RST 18h: drop TOS, then next ------------------------------------------
0018   D1           RST18:    POP   DE   ; 18  discard the RST's return address
0019   E1           DRP:      POP   HL   ;     new TOS = NOS
001A   18 15                  JR   next0   
001C                          ENDIF      
001C   E5           H_FROMR:   PUSH   HL   ; 1C  "}" return stack to TOS
001D                          ;*Macro unroll:  POPR
001D   CF                     DS   1-CPM,0CFh   
001E                          DS   CPM,0CDh   
001E                          DS   CPM,AROP&0FFh   
001E                          DS   CPM,AROP/256   
001E   EB                     EX   DE,HL   
001F                          ;*Macro unroll:  NEXTZ
001F   F7                     DS   1-CPM,0F7h   
0020                          DS   CPM,0DDh   
0020                          DS   CPM,0E9h   
0020                          IF   1-CPM   
0020                             ; ---- RST 20h: neg16: HL = -HL (keeps BC, DE) -------------------------------
0020   AF           NEG16:    XOR   A   ; 20
0021   95                     SUB   L   
0022   6F                     LD   L,A   
0023   9F                     SBC   A,A   
0024   94                     SUB   H   
0025   67                     LD   H,A   
0026   C9                     RET      
0027   00                     NOP      ; 27  spare
0028                             ; ---- RST 28h: putc: print A (keeps BC, DE, HL, IY) -------------------------
0028                RST28:       
0028   C3 03 FF     PUTC:     JP   CONOUT   ; 28
002B   FD 23        RP2:      INC   IY   ; 2B  the rest of rpop
002D   FD 23                  INC   IY   
002F   C9                     RET      
0030                             ; ---- RST 30h: next character -----------------------------------------------
0030   D1           RST30:    POP   DE   ; 30  discard the RST's return address
0031                          ENDIF      
0031                          IF   CPM   
                                 ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
                    CTL:      ADD   A,21h   ; back to c; zero only for NUL
                              JR   NZ,next0   ; the rest are ignored
                    ENDPROG:   JP   EXIT   ; the program has ended
0031                          ENDIF      
0031                             ; =============================================================================
0031                             ;  The inner loop: read one character and sort it by range.
0031                             ; 
0031                             ;    00h          end of program
0031                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0031                             ;    30h-39h      digit: read a whole number
0031                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0031                             ;    61h-7Ah      a-z: push the address of that letter's cell
0031                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0031                             ; =============================================================================
0031                          IF   FAST   
0031                          ;*Macro unroll: next0:  NEXTF                   ; (the fast build: the table dispatcher)
0031                NEXT0:    DS   FAST*CHECKED,0CDh   ; (the fast build: the table dispatcher)
0031                          DS   FAST*CHECKED,ACHK&0FFh   
0031                          DS   FAST*CHECKED,ACHK/256   
0031   0A                     DS   FAST,0Ah   
0032   03                     DS   FAST,03h   
0033   EB                     DS   FAST,0EBh   
0034   6F                     DS   FAST,6Fh   
0035   26                     DS   FAST,26h   
0036   0F                     DS   FAST,DTPG   
0037   7E                     DS   FAST,7Eh   
0038   24                     DS   FAST,24h   
0039   66                     DS   FAST,66h   
003A   6F                     DS   FAST,6Fh   
003B   E9                     DS   FAST,0E9h   
003C                          ENDIF      
003C                          IF   1-FAST   
                    NEXT0:       
003C                          ENDIF      
003C                          IF   CHECKED*(1-FAST)   
                              CALL   chkstk   ; both stacks are checked once per character
003C                          ENDIF      
003C                          IF   1-FAST   
                              LD   A,(BC)   
                              INC   BC   
                              SUB   21h   ; A = c - 21h
                              JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
                              CP   0Fh   
                              JR   C,punct   ; 21h-2Fh: PTAB index 0-14
                              SUB   0Fh   ; A = c - 30h
                              CP   0Ah   
                              JR   C,digit   ; 30h-39h
                              CP   11h   
                              JR   C,p3a   ; 3Ah-40h
                              SUB   11h   ; A = c - 41h
                              CP   1Ah   
                              JR   C,upper   ; 41h-5Ah: A = letter index 0-25
                              CP   20h   
                              JR   C,p5b   ; 5Bh-60h
                              CP   3Ah   
                              JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
                              CP   3Eh   
003C                          ENDIF      
003C                          IF   (1-CHECKED)*(1-FAST)   
                              JR   NC,next0   ; 7Fh-FFh: ignored
003C                          ENDIF      
003C                          IF   CHECKED*(1-FAST)   
                              JR   Z,next0   ; 7Fh, DEL: ignored
                              JP   NC,e_hi   ; 80h-FFh: reserved
003C                          ENDIF      
003C                          IF   1-FAST   
                              SUB   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
                    P5B:      SUB   9   ; 5Bh-60h: -4 in all, index 22-27
                    P3A:      ADD   A,5   ; 3Ah-40h: index 15-21
003C                          ENDIF      
003C                .macro PTABLE,
003C                             ; 
003C                 DB      h_store & 0FFh  ; !
003C                 DB      h_str & 0FFh    ; "
003C                 DB      h_num & 0FFh    ; #
003C                 DB      h_print & 0FFh  ; $
003C                 DB      h_swap & 0FFh   ; %
003C                 DB      h_and & 0FFh    ; &
003C                 DB      h_emit & 0FFh   ; '
003C                 DB      h_open & 0FFh   ; (
003C                 DB      h_close & 0FFh  ; )
003C                 DB      h_mul & 0FFh    ; *
003C                 DB      h_add & 0FFh    ; +
003C                 DB      h_cfetch & 0FFh ; ,
003C                 DB      h_sub & 0FFh    ; -
003C                 DB      h_cstore & 0FFh ; .
003C                 DB      h_div & 0FFh    ; /
003C                 DB      h_dup & 0FFh    ; :
003C                 DB      h_drop & 0FFh   ; ;
003C                 DB      h_lt & 0FFh     ; <
003C                 DB      h_eq & 0FFh     ; =
003C                 DB      h_gt & 0FFh     ; >
003C                 DB      h_key & 0FFh    ; ?
003C                 DB      h_fetch & 0FFh  ; @
003C                 DB      h_def & 0FFh    ; [
003C                 DB      h_break & 0FFh  ; \
003C                 DB      h_ret & 0FFh    ; ]
003C                 DB      h_xor & 0FFh    ; ^
003C                 DB      h_alloc & 0FFh  ; _
003C                 DB      h_grave & 0FFh  ; `
003C                 DB      h_tor & 0FFh    ; {
003C                 DB      h_or & 0FFh     ; |
003C                 DB      h_fromr & 0FFh  ; }
003C                 DB      h_not & 0FFh    ; ~
003C                .endm
003C                 
003C                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
003C                             ; untouched, and A, DE free.
003C                          IF   1-FAST   
                    PUNCT:    ADD   A,PTAB & 0FFh   ; PTAB never crosses a page
                              LD   E,A   
                              LD   D,PTAB / 256   ; (0 if the table is in page zero)
                              CP   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
                              LD   A,(DE)   
                              LD   E,A   ; the handler's low byte
003C                          ENDIF      
003C                          IF   (1-CPM)*(1-TABP0)*(1-FAST)   
                              LD   D,0   
003C                          ENDIF      
003C                          IF   (1-CPM)*(1-FAST)   
                              RL   D   ; its page: 0 + carry
003C                          ENDIF      
003C                          IF   CPM*(1-FAST)   
                              LD   D,1   
                              JR   NC,pu1   
                              INC   D   ; its page: 1 + carry
                    PU1:         
003C                          ENDIF      
003C                          IF   1-FAST   
                              PUSH   DE   ; jump to it; the stack is balanced again
                              RET      ;   when the handler starts
003C                          ENDIF      
003C                             ; The rest of the startup: here so that the generic reset code can reach it
003C                             ; with JR. st0: find the program's NUL; the heap starts after it.
003C                             ; (The editor build has its own copy of this, next to the editor.)
003C                             ; A checked build first clears the lower half of the letter page (A = 0):
003C                             ; every variable starts at 0, every word cell holds 0000h, the address an
003C                             ; undefined word is caught at (see e_hi), and no key is held back.
003C                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                    INIT:     LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
                              LD   BC,PROG   ; the IP
003C                          ENDIF      
003C                          IF   (1-CPM)*(1-EDITOR)   
003C   60           ST0:      LD   H,B   
003D   69                     LD   L,C   
003E   AF                     XOR   A   
003F   BE           ST1:      CP   (HL)   
0040   23                     INC   HL   
0041   20 FC                  JR   NZ,st1   
0043                          ENDIF      
0043                          IF   1-EDITOR   
0043   22 7C 82     ST2:      LD   (HEAP),HL   
0046                          ENDIF      
0046                          IF   CHECKED*(1-EDITOR)   
                              ;*Macro unroll:  NEGH                    ; minus the heap's first address: '_' may not
                              DS   1-CPM,0E7h   ; minus the heap"s first address: "_' may not
                              DS   CPM,0CDh   
                              DS   CPM,ANEG&0FFh   
                              DS   CPM,ANEG/256   
                              LD   (NPEND),HL   ;   release below it
0046                          ENDIF      
0046                          IF   (1-CHECKED)*(1-EDITOR)*(1-CPM)   
0046   67                     LD   H,A   ; (A = 0) no key is held, and the break key
0047   6F                     LD   L,A   ;   is on (the checked build has cleared
0048                          ENDIF      ;   these)
0048                          IF   (1-CHECKED)*(1-EDITOR)*CPM   
                              LD   HL,0   
0048                          ENDIF      
0048                          IF   (1-CHECKED)*(1-EDITOR)   
0048   22 7A 82               LD   (KEYBUF),HL   
004B                          ENDIF      
004B                          IF   1-EDITOR   
004B                          ;*Macro unroll:  SETIX
004B   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
004C   21                     DS   CPM+FAST-CPM*FAST,21h   
004D   31                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
004E   00                     DS   CPM+FAST-CPM*FAST,ANXT/256   
004F   FD 21 E0 80            LD   IY,RSTOP   ; the return stack is empty
0053                          ;*Macro unroll:  NEXT                    ; (its return address is thrown away)
0053                          DS   (1-CPM)*(1-FAST),0F7h   ; (its return address is thrown away)
0053   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0054   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0055                          ENDIF      
0055                             ; In the unchecked generic editor build the table is here, in the first
0055                             ; page, which saves loading D twice. (The other builds have no room for it
0055                             ; here: theirs is further down.)
0055                          IF   TABP0   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0055                          ENDIF      
0055                             ; =============================================================================
0055                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
0055                             ;  (00bbIGFuZCA= are up among the RST routines.) The machine-code call, exec,
0055                             ;  is here too: it belongs to "`" and makes the page come out right.
0055                             ; =============================================================================
0055   D1           H_XOR:    POP   DE   
0056   7C                     LD   A,H   
0057   AA                     XOR   D   
0058   67                     LD   H,A   
0059   7D                     LD   A,L   
005A   AB                     XOR   E   
005B   6F                     LD   L,A   
005C                          ;*Macro unroll:  NEXT
005C                          DS   (1-CPM)*(1-FAST),0F7h   
005C   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
005D   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
005E   D1           H_OR:     POP   DE   
005F   7C                     LD   A,H   
0060   B2                     OR   D   
0061   67                     LD   H,A   
0062   7D                     LD   A,L   
0063   B3                     OR   E   
0064   6F                     LD   L,A   
0065                          ;*Macro unroll:  NEXT
0065                          DS   (1-CPM)*(1-FAST),0F7h   
0065   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0066   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0067                          ;*Macro unroll: h_not:  NEGH                    ; ~x = -x - 1
0067   E7           H_NOT:    DS   1-CPM,0E7h   ; ~x = -x - 1
0068                          DS   CPM,0CDh   
0068                          DS   CPM,ANEG&0FFh   
0068                          DS   CPM,ANEG/256   
0068   2B                     DEC   HL   
0069                          ;*Macro unroll:  NEXT
0069                          DS   (1-CPM)*(1-FAST),0F7h   
0069   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
006A   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
006B                             ; "_" ( n -- addr ): the heap pointer moves by n, a signed count (the add is
006B                             ; the same either way); TOS is the old pointer.
006B   ED 5B 7C 82  H_ALLOC:   LD   DE,(HEAP)   
006F                          IF   CHECKED*CPM   
                              LD   A,H   ; the count's sign, for chkhp
006F                          ENDIF      
006F   19                     ADD   HL,DE   ; the new top
0070                          IF   CHECKED   
                              CALL   chkhp   
0070                          ENDIF      
0070   22 7C 82               LD   (HEAP),HL   
0073   EB                     EX   DE,HL   
0074                          ;*Macro unroll:  NEXT
0074                          DS   (1-CPM)*(1-FAST),0F7h   
0074   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0075   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0076                          IF   1-CPM*CHECKED   
0076   FD 22 34 82  EXEC:     LD   (RSAVE),IY   ; machine code may change IX and IY
007A   CD B9 00               CALL   jphl   
007D   FD 2A 34 82            LD   IY,(RSAVE)   
0081                          ;*Macro unroll:  SETIX
0081   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0082   21                     DS   CPM+FAST-CPM*FAST,21h   
0083   31                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
0084   00                     DS   CPM+FAST-CPM*FAST,ANXT/256   
0085   E1                     POP   HL   
0086                          ;*Macro unroll:  NEXT
0086                          DS   (1-CPM)*(1-FAST),0F7h   
0086   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0087   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0088                          ENDIF      
0088                             ; ---- the letters and digits (here, in the middle, so that the inner loop's
0088                             ; ---- short jumps reach them, and the handlers after them reach rpushn) ------
0088                             ; Digits: step back onto the first digit and read the whole number.
0088   E5           DIGIT:    PUSH   HL   
0089   0B                     DEC   BC   
008A   CD 38 03               CALL   rdnum   
008D                          ;*Macro unroll:  NEXT
008D                          DS   (1-CPM)*(1-FAST),0F7h   
008D   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
008E   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
008F                             ; a-z: push the cell's address (the cell is the variable)
008F                             ;  (the unchecked builds with room do x@ and x! in one step: lowq)
008F                          IF   1-SBASEU   
008F   E5           LOWER:    PUSH   HL   
0090   87                     ADD   A,A   
0091   6F                     LD   L,A   
0092   26 82                  LD   H,LETPAGE   
0094                          ;*Macro unroll:  NEXT
0094                          DS   (1-CPM)*(1-FAST),0F7h   
0094   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0095   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0096                          ENDIF      
0096                          IF   SBASEU   
                    LOWER:    JP   lowq   
0096                          ENDIF      
0096                             ; A-Z: call the word. The return address (the IP after the letter) goes on
0096                             ; the return stack, and the IP becomes the address in the letter's cell.
0096   C5           UPPER:    PUSH   BC   ; the return address, for rpushn
0097   EB                     EX   DE,HL   ; park TOS
0098   87                     ADD   A,A   
0099   6F                     LD   L,A   
009A   26 82                  LD   H,LETPAGE   ; HL -> cell
009C   4E                     LD   C,(HL)   
009D   2C                     INC   L   
009E   46                     LD   B,(HL)   ; IP = the word's body
009F   EB                     EX   DE,HL   ; TOS back, and fall into rpushn
00A0                             ; rpushn: move the top cell of the data stack (in memory) to the return
00A0                             ; stack, then next. Everything that pushes the return stack ends here.
00A0                             ; 
00A0                             ; The break key is looked at here, so at every word call and loop-back (and
00A0                             ; block entry and "{"), but only one time in 256: PCNT counts them.
00A0                             ; Reading the keyboard can be slow (it is a BDOS call under CP/M).
00A0   D1           RPUSHN:   POP   DE   
00A1   FD 72 FF               LD   (IY-1),D   
00A4   FD 73 FE               LD   (IY-2),E   
00A7   FD 2B                  DEC   IY   
00A9   FD 2B                  DEC   IY   
00AB   E5                     PUSH   HL   
00AC   21 36 82               LD   HL,PCNT   
00AF   35                     DEC   (HL)   
00B0   E1                     POP   HL   ; (the zero flag lasts)
00B1   CC F1 04               CALL   Z,pollk   
00B4                          ;*Macro unroll:  NEXT
00B4                          DS   (1-CPM)*(1-FAST),0F7h   
00B4   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
00B5   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
00B6                             ; "{" TOS to the return stack: the new TOS comes up, the old one goes across.
00B6   E3           H_TOR:    EX   (SP),HL   
00B7   18 E7                  JR   rpushn   
00B9   E9           JPHL:     JP   (HL)   ; (for the machine-code call)
00BA                             ; ---- machine code: the grave -----------------------------------------------
00BA                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
00BA                             ; are stored from addr until a non-hex character; then a RET (C9h) is
00BA                             ; written and its address is left. An odd last digit is consumed and dropped.
00BA                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
00BA                             ; code is entered by CALL with the data stack above the return address; it
00BA                             ; must keep BC, and on return the top cell becomes the new TOS.
00BA   CD C5 04     H_GRAVE:   CALL   hexc   
00BD                          IF   1-CPM*CHECKED   
00BD   30 B7                  JR   NC,exec   
00BF                          ENDIF      
00BF                          IF   CPM*CHECKED   
                              JP   NC,exec   ; (out of the way: see rpop)
00BF                          ENDIF      
00BF   77           HX1:      LD   (HL),A   ; the high digit goes in first ...
00C0   CD C5 04               CALL   hexc   
00C3   30 08                  JR   NC,hx2   ; odd digit: consumed, and the RET below
00C5   ED 6F                  RLD      ;   overwrites it
00C7   23                     INC   HL   ; ... and RLD shifts it up under the low one
00C8   CD C5 04               CALL   hexc   
00CB   38 F2                  JR   C,hx1   
00CD   36 C9        HX2:      LD   (HL),0C9h   ; (never range-checked: the spec says so)
00CF                          ;*Macro unroll:  NEXT
00CF                          DS   (1-CPM)*(1-FAST),0F7h   
00CF   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
00D0   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
00D1                             ; ---- where the two pages meet ----------------------------------------------
00D1                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
00D1                             ; are in falling code order for this), and where exactly differs between the
00D1                             ; builds: NPG1 follows. Every handler below these four must start in the
00D1                             ; second page, and every one above in the first; chktab.py checks both.
00D1                             ; "]" returns: pop an address and jump to it.
00D1                          ;*Macro unroll: h_ret:  POPR
00D1   CF           H_RET:    DS   1-CPM,0CFh   
00D2                          DS   CPM,0CDh   
00D2                          DS   CPM,AROP&0FFh   
00D2                          DS   CPM,AROP/256   
00D2   42                     LD   B,D   
00D3   4B                     LD   C,E   
00D4                          ;*Macro unroll: brk1:   NEXT
00D4                BRK1:     DS   (1-CPM)*(1-FAST),0F7h   
00D4   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
00D5   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
00D6                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
00D6                             ; drops the block start, "]" returns. No closer at all ends the program.
00D6   7C           H_BREAK:   LD   A,H   
00D7   B5                     OR   L   
00D8   E1                     POP   HL   
00D9   28 F9                  JR   Z,brk1   
00DB   CD 5A 03               CALL   skip   
00DE   B7                     OR   A   ; skip returns 0 for ")"
00DF   20 F0                  JR   NZ,h_ret   
00E1                          ;*Macro unroll: rdrop:  POPR
00E1   CF           RDROP:    DS   1-CPM,0CFh   
00E2                          DS   CPM,0CDh   
00E2                          DS   CPM,AROP&0FFh   
00E2                          DS   CPM,AROP/256   
00E2                          ;*Macro unroll:  NEXT
00E2                          DS   (1-CPM)*(1-FAST),0F7h   
00E2   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
00E3   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
00E4                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
00E4                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
00E4                             ; the body"s address instead. Either way it then skips to the matching "]'.
00E4                             ; (The unchecked build takes anything that is not a letter as the space; the
00E4                             ; checked build stops on it.)
00E4   0A           H_DEF:    LD   A,(BC)   
00E5   03                     INC   BC   
00E6   D6 41                  SUB   "A"   ; a letter gives 0-25 or 32-57: lowercase
00E8   5F                     LD   E,A   ;   lands 64 bytes up
00E9   E6 DF                  AND   0DFh   ; fold case
00EB   FE 1A                  CP   26   
00ED   30 0B                  JR   NC,def2   ; not a letter
00EF   CB 23                  SLA   E   
00F1   16 82                  LD   D,LETPAGE   ; DE -> cell
00F3   79                     LD   A,C   
00F4   12                     LD   (DE),A   
00F5   1C                     INC   E   
00F6   78                     LD   A,B   
00F7   12                     LD   (DE),A   
00F8   18 03                  JR   skipnx   
00FA                DEF2:        
00FA                          IF   CHECKED   
                              LD   A,E   
                              CP   " "-"A"+256   
                              JP   NZ,e_brack   ; anything but a letter or a space
00FA                          ENDIF      
00FA   E5                     PUSH   HL   ; an anonymous block: push its address
00FB   60                     LD   H,B   
00FC   69                     LD   L,C   
00FD                SKIPNX:      
00FD                          IF   CHECKED   
                              DEC   BC   ; back onto the letter, so that skip finds its
00FD                          ENDIF      ;   opener, the "[", just before where it starts
00FD   CD 5A 03     SKIPO:    CALL   skip   
0100                          ;*Macro unroll:  NEXT
0100                          DS   (1-CPM)*(1-FAST),0F7h   
0100   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0101   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0102   5E           H_FETCH:   LD   E,(HL)   ; "@"
0103   23                     INC   HL   
0104   56                     LD   D,(HL)   
0105   EB                     EX   DE,HL   
0106                          ;*Macro unroll:  NEXT
0106                          DS   (1-CPM)*(1-FAST),0F7h   
0106   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0107   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0108                             ; =============================================================================
0108                             ;  Handlers that must start in the image's second page.
0108                             ;  "?" is the last (with "," inside it), so its long tail may run past that
0108                             ;  page.
0108                             ; =============================================================================
0108                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
0108                             ; the matching ")".
0108   7C           H_OPEN:   LD   A,H   
0109   B5                     OR   L   
010A   E1                     POP   HL   
010B   28 F0                  JR   Z,skipo   
010D   C5                     PUSH   BC   ; the block starts at the IP
010E   18 90                  JR   rpushn   
0110                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
0110                             ; drops it and carries on.
0110   7C           H_CLOSE:   LD   A,H   
0111   B5                     OR   L   
0112   E1                     POP   HL   
0113   28 CC                  JR   Z,rdrop   
0115                          IF   QK   
0115   C3 8B 04               JP   closeq   ; (out of the handlers' pages: see Speed-ups)
0118                          ENDIF      
0118                          IF   1-QK   
                              ;*Macro unroll:  POPR                    ; pop the block start ...
                              DS   1-CPM,0CFh   ; pop the block start ...
                              DS   CPM,0CDh   
                              DS   CPM,AROP&0FFh   
                              DS   CPM,AROP/256   
                              LD   B,D   
                              LD   C,E   
                              PUSH   BC   
0118                          ENDIF      
0118                          IF   (1-QK)*(1-CPM)   
                              JR   rpushn   ; ... and push it back
0118                          ENDIF      
0118                          IF   (1-QK)*CPM   
                              JP   rpushn   
0118                          ENDIF      
0118                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
0118                             ; "-" has two jobs: directly before a digit it starts a negative number.
0118   0A           H_SUB:    LD   A,(BC)   
0119   D6 30                  SUB   "0"   
011B   FE 0A                  CP   10   
011D   38 05                  JR   C,negnum   
011F                          ;*Macro unroll:  NEGH                    ; a - b = a + (-b): fall into '+'
011F   E7                     DS   1-CPM,0E7h   ; a - b = a + (-b): fall into "+"
0120                          DS   CPM,0CDh   
0120                          DS   CPM,ANEG&0FFh   
0120                          DS   CPM,ANEG/256   
0120   D1           H_ADD:    POP   DE   
0121   19                     ADD   HL,DE   
0122                          ;*Macro unroll:  NEXT
0122                          DS   (1-CPM)*(1-FAST),0F7h   
0122   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0123   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0124   E5           NEGNUM:   PUSH   HL   ; a negative number: read it, negate it
0125   CD 38 03               CALL   rdnum   
0128                          ;*Macro unroll:  NEGH
0128   E7                     DS   1-CPM,0E7h   
0129                          DS   CPM,0CDh   
0129                          DS   CPM,ANEG&0FFh   
0129                          DS   CPM,ANEG/256   
0129                          ;*Macro unroll:  NEXT
0129                          DS   (1-CPM)*(1-FAST),0F7h   
0129   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
012A   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
012B   D1           H_AND:    POP   DE   
012C   7C                     LD   A,H   
012D   A2                     AND   D   
012E   67                     LD   H,A   
012F   7D                     LD   A,L   
0130   A3                     AND   E   
0131   6F                     LD   L,A   
0132                          ;*Macro unroll:  NEXT
0132                          DS   (1-CPM)*(1-FAST),0F7h   
0132   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0133   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0134                             ; Signed compares. Both are "HL < DE" for the right pair: "<" swaps the two
0134                             ; cells first. Flipping both sign bits turns a signed compare into an
0134                             ; unsigned one (and XOR clears the carry for SBC); SBC HL,HL then turns the
0134                             ; carry into -1 or 0 with no branch.
0134   E3           H_LT:     EX   (SP),HL   ; a < b: HL = a, and b is popped next
0135   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
0136   7C                     LD   A,H   
0137   EE 80                  XOR   80h   
0139   67                     LD   H,A   
013A   7A                     LD   A,D   
013B   EE 80                  XOR   80h   
013D   57                     LD   D,A   
013E   ED 52                  SBC   HL,DE   ; carry if HL < DE
0140   ED 62        TF:       SBC   HL,HL   ; carry -> -1 or 0
0142                          ;*Macro unroll:  NEXT
0142                          DS   (1-CPM)*(1-FAST),0F7h   
0142   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0143   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0144   D1           H_EQ:     POP   DE   
0145   B7                     OR   A   
0146   ED 52                  SBC   HL,DE   
0148   7C                     LD   A,H   
0149   B5                     OR   L   
014A   FE 01                  CP   1   ; carry only if a - b = 0
014C   18 F2                  JR   tf   
014E                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept. The
014E                             ; multiplier shifts up through A:C.
014E                          IF   1-QK   
                    H_MUL:    POP   DE   ; DE = multiplicand
                              PUSH   BC   
                              LD   A,H   
                              LD   C,L   ; A:C = multiplier
                              LD   HL,0   
                              LD   B,16   
                    MUL1:     ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mul2   
                              ADD   HL,DE   
                    MUL2:     DJNZ   mul1   
                              POP   BC   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
014E                          ENDIF      
014E                          IF   QK   
014E   D1           H_MUL:    POP   DE   ; DE = multiplicand
014F   C3 DB 03               JP   mulq   ; (out of the handlers' pages: see Speed-ups)
0152                          ENDIF      
0152                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
0152                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
0152                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
0152                             ; stops on it.
0152                H_DIV:       
0152                          IF   CHECKED   
                              LD   A,H   
                              OR   L   
                              JP   Z,e_zero   
0152                          ENDIF      
0152   D1                     POP   DE   ; DE = a, HL = b
0153   D5                     PUSH   DE   ; a, for r's sign
0154   7A                     LD   A,D   
0155   AC                     XOR   H   
0156   F5                     PUSH   AF   ; S flag = sign of q
0157   CB 7C                  BIT   7,H   
0159   C4 20 00               CALL   NZ,neg16   ; HL = |b|
015C   EB                     EX   DE,HL   
015D   CB 7C                  BIT   7,H   
015F   C4 20 00               CALL   NZ,neg16   ; HL = |a|, DE = |b|
0162   CD 33 02               CALL   udiv   ; HL = q, DE = r
0165   F1                     POP   AF   
0166   FC 20 00               CALL   M,neg16   ; q's sign
0169   EB                     EX   DE,HL   ; HL = r, DE = q
016A   F1                     POP   AF   ; A = a's high byte
016B   B7                     OR   A   
016C   FC 20 00               CALL   M,neg16   ; r's sign
016F   D5                     PUSH   DE   ; q under r
0170                          ;*Macro unroll:  NEXT
0170                          DS   (1-CPM)*(1-FAST),0F7h   
0170   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0171   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0172                             ; ---- stack and storage -----------------------------------------------------
0172   E5           H_DUP:    PUSH   HL   ; ":"
0173                          ;*Macro unroll:  NEXT
0173                          DS   (1-CPM)*(1-FAST),0F7h   
0173   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0174   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0175   E3           H_SWAP:   EX   (SP),HL   ; "%"
0176                          ;*Macro unroll:  NEXT
0176                          DS   (1-CPM)*(1-FAST),0F7h   
0176   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0177   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0178                             ; (The checked build tests the address before it takes the value off the
0178                             ; stack, so that an error report shows both.)
0178                H_CSTORE:      ; "." ( c addr -- )
0178                          IF   CHECKED   
                              CALL   chkst   
0178                          ENDIF      
0178   D1                     POP   DE   
0179   73                     LD   (HL),E   
017A                          ;*Macro unroll: h_drop: DROP                    ; ';' is this one byte
017A                H_DROP:   DS   (1-CPM)*(1-FAST),0DFh   ; ";" is this one byte
017A   E1                     DS   CPM+FAST-CPM*FAST,0E1h   
017B   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
017C   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
017D                H_STORE:      ; "!" ( n addr -- )
017D                          IF   CHECKED   
                              CALL   chkst   
017D                          ENDIF      
017D   D1                     POP   DE   
017E   73                     LD   (HL),E   
017F   23                     INC   HL   
0180   72                     LD   (HL),D   
0181                          ;*Macro unroll:  DROP
0181                          DS   (1-CPM)*(1-FAST),0DFh   
0181   E1                     DS   CPM+FAST-CPM*FAST,0E1h   
0182   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0183   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0184                             ; ---- console ---------------------------------------------------------------
0184                             ; 22h pushes the address of the text after it and skips the string.
0184   E5           H_STR:    PUSH   HL   
0185   60                     LD   H,B   
0186   69                     LD   L,C   
0187   CD 4F 03               CALL   skipstr   
018A                          IF   CHECKED   
                              OR   A   ; 0: the text ran out before the closing quote
                              JP   Z,e_quote   
018A                          ENDIF      
018A                          ;*Macro unroll:  NEXT
018A                          DS   (1-CPM)*(1-FAST),0F7h   
018A   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
018B   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
018C                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
018C                             ; 60h to 7Eh is one of the escapes at pesc; "/" plus any other character
018C                             ; clears that character"s bit 6 (/M is CR, and / then DEL gives "?"; "/',
018C                             ; '"' and '?' have no bit 6, so //, /" and /? give themselves).
018C                          IF   1-CHECKED   
018C   7E           H_PRINT:   LD   A,(HL)   
018D   23                     INC   HL   
018E   FE 22                  CP   22h   
0190   28 15                  JR   Z,pr9   
0192   FE 2F                  CP   "/"   
0194   20 0C                  JR   NZ,pr1   
0196   7E                     LD   A,(HL)   
0197   23                     INC   HL   
0198   FE 60                  CP   60h   
019A   38 04                  JR   C,pr0   
019C   FE 7F                  CP   7Fh   
019E   38 5D                  JR   C,pesc   
01A0   E6 BF        PR0:      AND   0BFh   
01A2                          ;*Macro unroll: pr1:    PUTA
01A2   EF           PR1:      DS   1-CPM,0EFh   
01A3                          DS   CPM,0CDh   
01A3                          DS   CPM,APUT&0FFh   
01A3                          DS   CPM,APUT/256   
01A3   18 E7                  JR   h_print   
01A5                PRLOOP:   EQU   h_print   ; (where the escapes go back to)
01A5                PRAGAIN:   EQU   h_print   ; (and where /~ goes back to)
01A5                          ENDIF      
01A5                          IF   CHECKED   
                                 ; (The checked build has the loop as a routine, prstr, which the error
                                 ; report uses too. The address is kept meanwhile, for a report: it shows
                                 ; the stack as it was before the "$". /~ comes back to hp1.)
                    H_PRINT:   LD   (RSAVE),HL   
                    HP1:      CALL   prstr   
                              ;*Macro unroll:  DROP
                              DS   (1-CPM)*(1-FAST),0DFh   
                              DS   CPM+FAST-CPM*FAST,0E1h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
01A5                          ENDIF      
01A5   7D           H_EMIT:   LD   A,L   ; "'"
01A6                          ;*Macro unroll:  PUTA
01A6   EF                     DS   1-CPM,0EFh   
01A7                          DS   CPM,0CDh   
01A7                          DS   CPM,APUT&0FFh   
01A7                          DS   CPM,APUT/256   
01A7                          ;*Macro unroll: pr9:    DROP
01A7                PR9:      DS   (1-CPM)*(1-FAST),0DFh   
01A7   E1                     DS   CPM+FAST-CPM*FAST,0E1h   
01A8   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
01A9   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
01AA                             ; "#" prints TOS as a signed decimal number, with no space after it.
01AA   CD D7 04     H_NUM:    CALL   psgn   
01AD                          ;*Macro unroll:  DROP
01AD                          DS   (1-CPM)*(1-FAST),0DFh   
01AD   E1                     DS   CPM+FAST-CPM*FAST,0E1h   
01AE   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
01AF   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
01B0                             ; "?" ( n -- c ) or ( -n -- addr )
01B0                             ;   n > 0: wait about n ms for a key; 0 if none came
01B0                             ;   n = 0: wait for a key
01B0                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
01B0                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
01B0   CB 7C        H_KEY:    BIT   7,H   
01B2   20 1A                  JR   NZ,line   
01B4   1E 28        KT1:      LD   E,MSLOOP   ; one millisecond, roughly
01B6   CD 1F 05     KT2:      CALL   getk   
01B9   20 0E                  JR   NZ,kt3   
01BB   1D                     DEC   E   
01BC   20 F8                  JR   NZ,kt2   
01BE   7C                     LD   A,H   ; 0? never counts down: it waits
01BF   B5                     OR   L   
01C0   28 F2                  JR   Z,kt1   
01C2   2B                     DEC   HL   
01C3   7C                     LD   A,H   
01C4   B5                     OR   L   
01C5   20 ED                  JR   NZ,kt1   ; A = 0 if the time ran out
01C7   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
01C8   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
01C9   6F           KT3:      LD   L,A   
01CA   26 00                  LD   H,0   
01CC                          ;*Macro unroll:  NEXT
01CC                          DS   (1-CPM)*(1-FAST),0F7h   
01CC   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
01CD   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
01CE                             ; Backspace takes the last character back (and is echoed as it
01CE                             ; is), CR ends (stored, not echoed), every other key is stored and
01CE                             ; echoed until the line is full. (CP/M too: getk reads through BDOS
01CE                             ; 6.) The line buffer starts at offset 80h of its page, so L alone
01CE                             ; is the place in the line: D holds the L of a full line.
01CE   11 7F 00     LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
01D1   19                     ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
01D2   9F                     SBC   A,A   
01D3   A5                     AND   L   ; (0 for a count that is too big)
01D4   2F                     CPL      
01D5   57                     LD   D,A   ; D = the L of a full line: 80h + count, FFh
01D6                             ;   at most
01D6   21 80 82               LD   HL,LINEBUF   
01D9   CD 1F 05     LN2:      CALL   getk   
01DC   28 FB                  JR   Z,ln2   
01DE   FE 0D                  CP   13   
01E0   28 16                  JR   Z,ln5   
01E2   FE 08                  CP   8   
01E4   28 0B                  JR   Z,ln4   
01E6   5F                     LD   E,A   
01E7   7D                     LD   A,L   
01E8   BA                     CP   D   
01E9   28 EE                  JR   Z,ln2   ; full
01EB   73                     LD   (HL),E   
01EC   2C                     INC   L   
01ED   7B                     LD   A,E   
01EE                          ;*Macro unroll: ln3:    PUTA
01EE   EF           LN3:      DS   1-CPM,0EFh   
01EF                          DS   CPM,0CDh   
01EF                          DS   CPM,APUT&0FFh   
01EF                          DS   CPM,APUT/256   
01EF   18 E8                  JR   ln2   
01F1   2D           LN4:      DEC   L   ; Backspace: one back, and echo it,
01F2   FA EE 01               JP   M,ln3   ;   unless the line was empty (L left the
01F5   2C                     INC   L   ;   upper half of the page)
01F6   18 E1                  JR   ln2   
01F8   77           LN5:      LD   (HL),A   ; the CR
01F9   2E 80                  LD   L,LINEBUF & 0FFh   
01FB                          ;*Macro unroll:  NEXT
01FB                          DS   (1-CPM)*(1-FAST),0F7h   
01FB   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
01FC   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
01FD                             ; =============================================================================
01FD                             ;  More routines (no handler starts past this point)
01FD                             ; =============================================================================
01FD                          IF   CHECKED   
                                 ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
                                 ; "$", and the texts of the report). A NUL first is an error: Q.
                    PRSTR:    LD   A,(HL)   
                              INC   HL   
                              CP   22h   
                              RET   Z   
                              OR   A   
                              JP   Z,e_dollar   
                              CP   "/"   
                              JR   NZ,prs1   
                              LD   A,(HL)   
                              INC   HL   
                              CP   60h   
                              JR   C,prs0   
                              CP   7Fh   
                              JR   C,pesc   
                    PRS0:     AND   0BFh   
                              ;*Macro unroll: prs1:   PUTA
                    PRS1:     DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              JR   prstr   
                    PRLOOP:   EQU   prstr   ; (where the escapes go back to)
                    PRAGAIN:   EQU   hp1   ; (and where /~ goes back to)
                                 ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
                                 ; pnl: the same, on a new line.
                    PNL:      CALL   pmsg   ; (pmsg's own CR LF, then on into pmsg for
                              DB   13,10,22h   ;   the caller's text)
                    PMSG:     EX   (SP),HL   
                              CALL   prstr   
                              EX   (SP),HL   
                              RET      
01FD                          ENDIF      
01FD                             ; pesc: the escapes of "$". A = the character after the "/", 60h to 7Eh, and
01FD                             ; HL points past it. Each goes back into the loop that prints the string
01FD                             ; (PRLOOP), but /~ has the stack to see to, and goes back by PRAGAIN.
01FD                             ;    /a-/z   print the variable, as "#" does
01FD                             ;    /{      clear the screen, the cursor to the top left
01FD                             ;    /}      clear from the cursor to the end of the line
01FD                             ;    /|  /`  show the cursor, hide it
01FD                             ;    /~      ( row col -- ) the cursor to that row and column, from 0
01FD   FE 7E        PESC:     CP   7Eh   
01FF   28 1C                  JR   Z,pat   
0201   11 8C 01               LD   DE,PRLOOP   ; the others return into the loop
0204   D5                     PUSH   DE   
0205   D6 7B                  SUB   7Bh   ; 00bbIDAsIHwgMSwg 2, and no borrow
0207   30 1D                  JR   NC,pcon   
0209   C6 1A                  ADD   A,1Ah   ; a-z: 0-25, and a carry; `: FFh, and none
020B   30 22                  JR   NC,phide   
020D   87                     ADD   A,A   ; the variable's cell
020E   C6 40                  ADD   A,40h   
0210   E5                     PUSH   HL   
0211   6F                     LD   L,A   
0212   26 82                  LD   H,LETPAGE   
0214   7E                     LD   A,(HL)   
0215   2C                     INC   L   
0216   66                     LD   H,(HL)   
0217   6F                     LD   L,A   
0218   CD D7 04               CALL   psgn   
021B   E1                     POP   HL   
021C   C9                     RET      
021D                             ; /~ ( row col addr -- ): the two cells under the string's address go. In
021D                             ; the checked build "$" is the routine prstr: its own return address goes
021D                             ; first, and hp1 calls it again afterwards. There each /~ first looks that
021D                             ; its two cells are there, and is s if not, before it prints anything.
021D                PAT:         
021D                          IF   CHECKED   
                              EX   (SP),HL   ; the text pointer over prstr's return address
                              LD   HL,(6-DSTOP)&0FFFFh   ; a carry: the two cells aren't there
                              ADD   HL,SP   
                              JP   C,e_under   
                              POP   HL   
021D                          ENDIF      
021D   D1                     POP   DE   ; DE = the column
021E   E3                     EX   (SP),HL   ; HL = the row; the text pointer is kept
021F                          IF   1-ANS   
021F   CD 15 FF               CALL   CONAT   
0222   E1                     POP   HL   
0223   C3 8C 01               JP   PRAGAIN   
0226                             ; With ANSI = 0 the machine's routines do the rest.
0226   CA 0C FF     PCON:     JP   Z,CONCLS   ; /{
0229   FE 02                  CP   2   
022B   CA 0F FF               JP   Z,CONEOL   ; /}
022E   FE                     DB   0FEh   ; /|  (CP n steps over the XOR: A = 1, show)
022F   AF           PHIDE:    XOR   A   ; /`  (A = 0: hide)
0230   C3 12 FF               JP   CONCUR   
0233                          ENDIF      
0233                          IF   ANS   
                              PUSH   DE   
                              CALL   csi   ; ESC [ row+1 ; col+1 H (ANSI counts from 1)
                              INC   HL   
                              CALL   pdec   
                              ;*Macro unroll:  PUTK    3Bh             ; ';'
                              DS   1-CPM,3Eh   ; ";"
                              DS   1-CPM,3Bh   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,3Bh   
                              POP   HL   
                              INC   HL   
                              CALL   pdec   
                              ;*Macro unroll:  PUTK    48h             ; 'H'
                              DS   1-CPM,3Eh   ; "H"
                              DS   1-CPM,48h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,48h   
                              POP   HL   
                              JP   PRAGAIN   
                                 ; With ANSI = 1 they are sequences. The carry is clear on the way in.
                    PSHOW:    LD   E,"h"   ; /|  ESC [ ? 2 5 h
                              DB   0DAh   ; (JP C,nn: with no carry it steps over two bytes)
                    PHIDE:    LD   E,"l"   ; /`  ESC [ ? 2 5 l
0233                          ENDIF      
0233                          IF   ANS*CHECKED   
                                 ; (The checked build prints the fixed parts with pmsg, which it has for the
                                 ; report: shorter than a character at a time.)
                              CALL   pmsg   
                              DB   27,"[?25",22h   
                    PSE:      LD   A,E   ; then E
                              ;*Macro unroll:  PUTAR
                              DS   1-CPM,0EFh   
                              DS   1-CPM,0C9h   
                              DS   CPM,0C3h   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                                 ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into cse.
                    PCON:     DEC   A   
                              JR   Z,pshow   ; /|
                              LD   E,"K"   
                              JP   P,cse   ; /}  ESC [ K
                              LD   E,"H"   ; /{  ESC [ H ESC [ J
                              CALL   cse   
                              LD   E,"J"   ; (on into cse)
                                 ; cse: ESC [ and then E. csi: ESC [. Both keep HL.
                    CSE:      CALL   csi   
                              JR   pse   
                    CSI:      CALL   pmsg   
                              DB   27,"[",22h   
                              RET      
0233                          ENDIF      
0233                          IF   ANS*(1-CHECKED)   
                              LD   A,"?"   
                              CALL   csia   
                              ;*Macro unroll:  PUTK    32h             ; '2'
                              DS   1-CPM,3Eh   ; "2"
                              DS   1-CPM,32h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,32h   
                              ;*Macro unroll:  PUTK    35h             ; '5'
                              DS   1-CPM,3Eh   ; "5"
                              DS   1-CPM,35h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,35h   
                              LD   A,E   
                              ;*Macro unroll:  PUTAR
                              DS   1-CPM,0EFh   
                              DS   1-CPM,0C9h   
                              DS   CPM,0C3h   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                                 ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into csia.
                    PCON:     DEC   A   
                              JR   Z,pshow   ; /|
                              LD   A,"K"   
                              JP   P,csia   ; /}  ESC [ K
                              LD   A,"H"   ; /{  ESC [ H ESC [ J
                              CALL   csia   
                              LD   A,"J"   ; (on into csia)
                                 ; csia: ESC [ and then A. csi: ESC [, keeping A.
                    CSIA:     CALL   csi   
                              ;*Macro unroll:  PUTAR
                              DS   1-CPM,0EFh   
                              DS   1-CPM,0C9h   
                              DS   CPM,0C3h   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                    CSI:      PUSH   AF   
                              ;*Macro unroll:  PUTK    1Bh             ; ESC
                              DS   1-CPM,3Eh   ; ESC
                              DS   1-CPM,1Bh   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,1Bh   
                              ;*Macro unroll:  PUTK    5Bh             ; '['
                              DS   1-CPM,3Eh   ; "["
                              DS   1-CPM,5Bh   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,5Bh   
                              POP   AF   
                              RET      
0233                          ENDIF      
0233                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
0233                             ; Uses A; keeps BC (the IP) itself. The dividend shifts up through A:C while
0233                             ; the quotient bits arrive at the bottom of C.
0233                             ; Dividing by 2 is one shift (the spec wants that fast).
0233                          IF   1-QK   
                    UDIV:     LD   A,E   
                              XOR   2   
                              OR   D   
                              JR   NZ,udv0   
                              SRL   H   
                              RR   L   ; the quotient
                              ADC   A,A   
                              LD   E,A   ; the remainder: the bit that fell out (D is 0)
                              RET      
0233                          ENDIF      
0233                          IF   QK   
0233                             ; (The builds with room divide by any power of two with shifts: 2, and 32,
0233                             ; 64, 256 and the like, which fixed point and byte work use all the time.)
0233   7A           UDIV:     LD   A,D   
0234   B7                     OR   A   
0235   20 1A                  JR   NZ,uq1   ; 256 and up
0237   B3                     OR   E   
0238   28 33                  JR   Z,udv0   ; by 0: the long way (it means nothing anyway)
023A   3D                     DEC   A   
023B   A3                     AND   E   
023C   20 2F                  JR   NZ,udv0   ; not a power of two
023E   7B                     LD   A,E   ; by 2^k below 256: q = HL >> k, and
023F   3D                     DEC   A   ;   r = L & (2^k - 1)
0240   A5                     AND   L   
0241   F5                     PUSH   AF   
0242   CB 3B        UQ2:      SRL   E   
0244   38 06                  JR   C,uq3   
0246   CB 3C                  SRL   H   
0248   CB 1D                  RR   L   
024A   18 F6                  JR   uq2   
024C   F1           UQ3:      POP   AF   
024D   5F                     LD   E,A   
024E   16 00                  LD   D,0   
0250   C9                     RET      
0251   7B           UQ1:      LD   A,E   
0252   B7                     OR   A   
0253   20 18                  JR   NZ,udv0   
0255   7A                     LD   A,D   
0256   3D                     DEC   A   
0257   A2                     AND   D   
0258   20 13                  JR   NZ,udv0   ; not a power of two
025A   7A                     LD   A,D   ; by 2^k, 256 and up: q = H >> (k - 8), and
025B   3D                     DEC   A   ;   r = HL & (2^k - 1)
025C   A4                     AND   H   
025D   5F                     LD   E,A   ; (the remainder's high byte,
025E   7D                     LD   A,L   ;   and its low byte)
025F   6C                     LD   L,H   
0260   26 00                  LD   H,0   
0262   CB 3A        UQ4:      SRL   D   
0264   38 04                  JR   C,uq5   
0266   CB 3D                  SRL   L   
0268   18 F8                  JR   uq4   
026A   53           UQ5:      LD   D,E   
026B   5F                     LD   E,A   
026C   C9                     RET      
026D                          ENDIF      
026D                          IF   1-FAST   
                    UDV0:     PUSH   BC   
                              LD   A,H   
                              LD   C,L   
                              LD   HL,0   
                              LD   B,16   
                    UDV1:     SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   ; carry is clear here: the remainder
                              JR   NC,udv2   ;   always fits in 16 bits
                              ADD   HL,DE   ; too much: put it back, and cancel the
                              DEC   C   ;   INC below
                    UDV2:     INC   C   ; a quotient bit
                              DJNZ   udv1   
                              EX   DE,HL   ; DE = remainder
                              LD   H,A   
                              LD   L,C   ; HL = quotient
                              POP   BC   
                              RET      
026D                          ENDIF      
026D                          IF   FAST   
026D                             ; (the fast build: the same 16 rounds, unrolled)
026D   C5           UDV0:     PUSH   BC   
026E   7C                     LD   A,H   
026F   4D                     LD   C,L   
0270   21 00 00               LD   HL,0   
0273   CB 21                  SLA   C   
0275   17                     RLA      
0276   ED 6A                  ADC   HL,HL   
0278   ED 52                  SBC   HL,DE   
027A   30 02                  JR   NC,uvr0   
027C   19                     ADD   HL,DE   
027D   0D                     DEC   C   
027E   0C           UVR0:     INC   C   
027F   CB 21                  SLA   C   
0281   17                     RLA      
0282   ED 6A                  ADC   HL,HL   
0284   ED 52                  SBC   HL,DE   
0286   30 02                  JR   NC,uvr1   
0288   19                     ADD   HL,DE   
0289   0D                     DEC   C   
028A   0C           UVR1:     INC   C   
028B   CB 21                  SLA   C   
028D   17                     RLA      
028E   ED 6A                  ADC   HL,HL   
0290   ED 52                  SBC   HL,DE   
0292   30 02                  JR   NC,uvr2   
0294   19                     ADD   HL,DE   
0295   0D                     DEC   C   
0296   0C           UVR2:     INC   C   
0297   CB 21                  SLA   C   
0299   17                     RLA      
029A   ED 6A                  ADC   HL,HL   
029C   ED 52                  SBC   HL,DE   
029E   30 02                  JR   NC,uvr3   
02A0   19                     ADD   HL,DE   
02A1   0D                     DEC   C   
02A2   0C           UVR3:     INC   C   
02A3   CB 21                  SLA   C   
02A5   17                     RLA      
02A6   ED 6A                  ADC   HL,HL   
02A8   ED 52                  SBC   HL,DE   
02AA   30 02                  JR   NC,uvr4   
02AC   19                     ADD   HL,DE   
02AD   0D                     DEC   C   
02AE   0C           UVR4:     INC   C   
02AF   CB 21                  SLA   C   
02B1   17                     RLA      
02B2   ED 6A                  ADC   HL,HL   
02B4   ED 52                  SBC   HL,DE   
02B6   30 02                  JR   NC,uvr5   
02B8   19                     ADD   HL,DE   
02B9   0D                     DEC   C   
02BA   0C           UVR5:     INC   C   
02BB   CB 21                  SLA   C   
02BD   17                     RLA      
02BE   ED 6A                  ADC   HL,HL   
02C0   ED 52                  SBC   HL,DE   
02C2   30 02                  JR   NC,uvr6   
02C4   19                     ADD   HL,DE   
02C5   0D                     DEC   C   
02C6   0C           UVR6:     INC   C   
02C7   CB 21                  SLA   C   
02C9   17                     RLA      
02CA   ED 6A                  ADC   HL,HL   
02CC   ED 52                  SBC   HL,DE   
02CE   30 02                  JR   NC,uvr7   
02D0   19                     ADD   HL,DE   
02D1   0D                     DEC   C   
02D2   0C           UVR7:     INC   C   
02D3   CB 21                  SLA   C   
02D5   17                     RLA      
02D6   ED 6A                  ADC   HL,HL   
02D8   ED 52                  SBC   HL,DE   
02DA   30 02                  JR   NC,uvr8   
02DC   19                     ADD   HL,DE   
02DD   0D                     DEC   C   
02DE   0C           UVR8:     INC   C   
02DF   CB 21                  SLA   C   
02E1   17                     RLA      
02E2   ED 6A                  ADC   HL,HL   
02E4   ED 52                  SBC   HL,DE   
02E6   30 02                  JR   NC,uvr9   
02E8   19                     ADD   HL,DE   
02E9   0D                     DEC   C   
02EA   0C           UVR9:     INC   C   
02EB   CB 21                  SLA   C   
02ED   17                     RLA      
02EE   ED 6A                  ADC   HL,HL   
02F0   ED 52                  SBC   HL,DE   
02F2   30 02                  JR   NC,uvr10   
02F4   19                     ADD   HL,DE   
02F5   0D                     DEC   C   
02F6   0C           UVR10:    INC   C   
02F7   CB 21                  SLA   C   
02F9   17                     RLA      
02FA   ED 6A                  ADC   HL,HL   
02FC   ED 52                  SBC   HL,DE   
02FE   30 02                  JR   NC,uvr11   
0300   19                     ADD   HL,DE   
0301   0D                     DEC   C   
0302   0C           UVR11:    INC   C   
0303   CB 21                  SLA   C   
0305   17                     RLA      
0306   ED 6A                  ADC   HL,HL   
0308   ED 52                  SBC   HL,DE   
030A   30 02                  JR   NC,uvr12   
030C   19                     ADD   HL,DE   
030D   0D                     DEC   C   
030E   0C           UVR12:    INC   C   
030F   CB 21                  SLA   C   
0311   17                     RLA      
0312   ED 6A                  ADC   HL,HL   
0314   ED 52                  SBC   HL,DE   
0316   30 02                  JR   NC,uvr13   
0318   19                     ADD   HL,DE   
0319   0D                     DEC   C   
031A   0C           UVR13:    INC   C   
031B   CB 21                  SLA   C   
031D   17                     RLA      
031E   ED 6A                  ADC   HL,HL   
0320   ED 52                  SBC   HL,DE   
0322   30 02                  JR   NC,uvr14   
0324   19                     ADD   HL,DE   
0325   0D                     DEC   C   
0326   0C           UVR14:    INC   C   
0327   CB 21                  SLA   C   
0329   17                     RLA      
032A   ED 6A                  ADC   HL,HL   
032C   ED 52                  SBC   HL,DE   
032E   30 02                  JR   NC,uvr15   
0330   19                     ADD   HL,DE   
0331   0D                     DEC   C   
0332   0C           UVR15:    INC   C   
0333   EB                     EX   DE,HL   ; DE = remainder
0334   67                     LD   H,A   
0335   69                     LD   L,C   ; HL = quotient
0336   C1                     POP   BC   
0337   C9                     RET      
0338                          ENDIF      
0338                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
0338                             ; non-digit. Values wrap at 16 bits, as the spec says.
0338   21 00 00     RDNUM:    LD   HL,0   
033B   0A           RDN1:     LD   A,(BC)   
033C   D6 30                  SUB   "0"   
033E   FE 0A                  CP   10   
0340   D0                     RET   NC   
0341   03                     INC   BC   
0342   54                     LD   D,H   
0343   5D                     LD   E,L   
0344   29                     ADD   HL,HL   
0345   29                     ADD   HL,HL   
0346   19                     ADD   HL,DE   
0347   29                     ADD   HL,HL   ; HL * 10
0348   5F                     LD   E,A   
0349   16 00                  LD   D,0   
034B   19                     ADD   HL,DE   
034C   18 ED                  JR   rdn1   
034E                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
034E                             ; the next character, so "/"" does not end it. Leaves A = 22h.
034E                          IF   1-CHECKED   
034E   03           SS0:      INC   BC   
034F   0A           SKIPSTR:   LD   A,(BC)   
0350   03                     INC   BC   
0351   FE 2F                  CP   "/"   
0353   28 F9                  JR   Z,ss0   
0355   FE 22                  CP   22h   
0357   20 F6                  JR   NZ,skipstr   
0359   C9                     RET      
035A                          ENDIF      
035A                          IF   CHECKED   
                                 ; The checked build never steps over a NUL: if the text runs out first it
                                 ; returns A = 0 with the IP on the NUL.
                    SKIPSTR:   LD   A,(BC)   
                              OR   A   
                              RET   Z   
                              INC   BC   
                              CP   22h   
                              RET   Z   
                              CP   "/"   
                              JR   NZ,skipstr   
                              LD   A,(BC)   ; the escaped character
                              OR   A   
                              RET   Z   
                              INC   BC   
                              JR   skipstr   
035A                          ENDIF      
035A                             ; skip: read past text to the closer at this level, and return A = 0 if it
035A                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
035A                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
035A                             ; no closer; anything else that runs into the NUL had unbalanced brackets
035A                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
035A                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
035A                             ; 
035A                             ; The checked build also looks at the character the skip was started by,
035A                             ; which is always the one just before where it starts: "(" must end at ")",
035A                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
035A                             ; quote counts as running into it. "\" takes either closer. SKPL keeps the
035A                             ; place where the skip started, for the report.
035A                          IF   1-QK   
                                 ; (Without base: no skip cache.)
                    SKIP:        
035A                          ENDIF      
035A                          IF   CHECKED*(1-QK)   
                              LD   (SKPL),BC   
                              DEC   BC   
                              LD   A,(BC)   
                              INC   BC   
                              LD   E,A   ; E = the opener: ( [ or \
035A                          ENDIF      
035A                          IF   1-QK   
                              LD   D,0   
                    SK3:      INC   D   ; an opener: one deeper
                    SK1:      LD   A,(BC)   
035A                          ENDIF      
035A                          IF   (1-CHECKED)*(1-QK)   
                              INC   BC   
                              OR   A   
                              JP   Z,SKEND   ; (the end of the program)
035A                          ENDIF      
035A                          IF   CHECKED*(1-QK)   
                              OR   A   
                              JR   Z,sk6   ; (the IP stays on the NUL)
                              INC   BC   
035A                          ENDIF      
035A                          IF   1-QK   
                              CP   22h   
                              CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
                              SUB   "("   ;   (or 0, and then the NUL is read next)
                              JR   Z,sk3   
                              DEC   A   ; ")"
                              JR   Z,sk4   
                              SUB   "["-")"   
                              JR   Z,sk3   
                              CP   "]"-"["   
                              JR   NZ,sk1   
                    SK4:      DEC   D   
035A                          ENDIF      
035A                          IF   (1-CHECKED)*(1-QK)   
                              RET   Z   ; the closer at this level
                              JR   sk1   
035A                          ENDIF      
035A                          IF   CHECKED*(1-QK)   
                              JR   NZ,sk1   
                              LD   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
                              XOR   E   ;   opener is 0 for "(" and 1 for "[", and only
                              AND   6   ;   "\" has bit 2: so this is 2 for the wrong
                              CP   2   ;   closer, and only then
                              LD   A,D   
                              RET   NZ   
                              JR   sk7   
                    SK6:      BIT   2,E   ; the text ran out:
                              JP   NZ,SKEND   ;   "\" with no closer ends the program
                    SK7:      LD   BC,(SKPL)   ; N. The place is the opener
                              LD   A,"N"   
                              JP   errp   ; (errp drops skip's return address)
035A                          ENDIF      
035A                          IF   QK   
035A                             ; The skip cache. Nearly every skip is one that has happened before (a loop
035A                             ; skips the same false block on every pass), so the first scan from each
035A                             ; place is remembered: 64 entries of 00bbc3RhcnQsIGVuZA==, at CPAGE, found by the
035A                             ; start's low byte. Only skips that start in the program text are kept (the
035A                             ; line buffer changes); the cache is emptied whenever a run starts (skclr).
035A                             ; A program that changes its own text while it runs is not looked after.
035A   ED 43 3C 82  SKIP:     LD   (SKPL),BC   ; where it starts: the cache's key (and the
035E   78                     LD   A,B   ;   checked report's place)
035F   FE 83                  CP   PROG/256   
0361   38 1B                  JR   C,sks   ; below the program text: no cache
0363   79                     LD   A,C   
0364   87                     ADD   A,A   
0365   87                     ADD   A,A   
0366   5F                     LD   E,A   
0367   16 F0                  LD   D,CPAGE   ; DE -> the entry
0369   1A                     LD   A,(DE)   
036A   B9                     CP   C   
036B   20 11                  JR   NZ,sks   
036D   1C                     INC   E   
036E   1A                     LD   A,(DE)   
036F   B8                     CP   B   
0370   20 0C                  JR   NZ,sks   
0372   1C                     INC   E   
0373   1A                     LD   A,(DE)   
0374   4F                     LD   C,A   
0375   1C                     INC   E   
0376   1A                     LD   A,(DE)   
0377   47                     LD   B,A   ; a hit: the IP is past the closer
0378   0B                     DEC   BC   
0379   0A                     LD   A,(BC)   
037A   03                     INC   BC   
037B   D6 29                  SUB   ")"   ; 0 for ")", not 0 for "]"
037D   C9                     RET      
037E                SKS:         
037E                          ENDIF      
037E                          IF   QK*CHECKED   
                              DEC   BC   
                              LD   A,(BC)   
                              INC   BC   
                              LD   E,A   ; E = the opener: ( [ or \
037E                          ENDIF      
037E                          IF   QK   
037E                             ; The scan. Most characters are nothing to it, and two range tests rule
037E                             ; them out: * to Z, and ^ and up. Only NUL " ( ) [ ] count.
037E   16 00                  LD   D,0   
0380   14           SQ3:      INC   D   ; an opener: one deeper
0381   0A           SQ1:      LD   A,(BC)   
0382   03                     INC   BC   
0383   FE 5E                  CP   5Eh   
0385   30 FA                  JR   NC,sq1   ; ^ _ ` a-z 00bbIHwg ~ and up: nothing
0387   FE 5B                  CP   5Bh   
0389   30 19                  JR   NC,sqb   ; [ \ ]
038B   FE 2A                  CP   2Ah   
038D   30 F2                  JR   NC,sq1   ; * to Z: nothing
038F   FE 28                  CP   28h   
0391   28 ED                  JR   Z,sq3   ; (
0393   30 19                  JR   NC,sqc   ; )
0395   FE 22                  CP   22h   
0397   28 06                  JR   Z,sqq   ; a string
0399   B7                     OR   A   
039A   20 E5                  JR   NZ,sq1   ; the rest below "(": nothing
039C                          ENDIF      
039C                          IF   QK*(1-CHECKED)   
039C   C3 09 FF               JP   SKEND   ; NUL: the end of the program
039F                          ENDIF      
039F                          IF   QK*CHECKED   
                              DEC   BC   ; NUL: the IP stays on it
                              BIT   2,E   ; the text ran out:
                              JP   NZ,SKEND   ;   "\" with no closer ends the program
                    SQ7:      LD   BC,(SKPL)   ; N. The place is the opener
                              LD   A,"N"   
                              JP   errp   ; (errp drops skip's return address)
039F                          ENDIF      
039F                          IF   QK   
039F   CD 4F 03     SQQ:      CALL   skipstr   ; step over the string
03A2   18 DD                  JR   sq1   
03A4   D6 5C        SQB:      SUB   5Ch   ; [ -1, \ 0, ] 1
03A6   28 D9                  JR   Z,sq1   ; "\" is nothing here
03A8   38 D6                  JR   C,sq3   ; [
03AA   3E 02                  LD   A,2   ; ]
03AC   18 01                  JR   sq4   
03AE   AF           SQC:      XOR   A   ; )
03AF   15           SQ4:      DEC   D   
03B0   20 CF                  JR   NZ,sq1   
03B2                          ENDIF      
03B2                          IF   QK*CHECKED   
                              LD   D,A   ; the closer at this level (as above): 2 here
                              XOR   E   ;   means the wrong closer
                              AND   6   
                              CP   2   
                              LD   A,D   
                              JR   Z,sq7   
03B2                          ENDIF      
03B2                          IF   QK   
03B2                             ; The closer at this level: remember the skip (if it started in the program
03B2                             ; text), and return A = 0 for ")" or 2 for "]".
03B2   F5                     PUSH   AF   
03B3   E5                     PUSH   HL   
03B4   2A 3C 82               LD   HL,(SKPL)   
03B7   7C                     LD   A,H   
03B8   FE 83                  CP   PROG/256   
03BA   38 11                  JR   C,sq9   
03BC   7D                     LD   A,L   
03BD   87                     ADD   A,A   
03BE   87                     ADD   A,A   
03BF   5F                     LD   E,A   
03C0   16 F0                  LD   D,CPAGE   
03C2   7D                     LD   A,L   
03C3   12                     LD   (DE),A   
03C4   1C                     INC   E   
03C5   7C                     LD   A,H   
03C6   12                     LD   (DE),A   
03C7   1C                     INC   E   
03C8   79                     LD   A,C   
03C9   12                     LD   (DE),A   
03CA   1C                     INC   E   
03CB   78                     LD   A,B   
03CC   12                     LD   (DE),A   
03CD   E1           SQ9:      POP   HL   
03CE   F1                     POP   AF   
03CF   C9                     RET      
03D0                             ; skclr: empty the skip cache (a start of 0000h matches no skip). Keeps HL.
03D0   E5           SKCLR:    PUSH   HL   
03D1   21 00 F0               LD   HL,CPAGE*256   
03D4   36 00        SKC1:     LD   (HL),0   
03D6   2C                     INC   L   
03D7   20 FB                  JR   NZ,skc1   
03D9   E1                     POP   HL   
03DA   C9                     RET      
03DB                          ENDIF      
03DB                             ;  ---- Speed-ups (base builds) -------------------------------------------
03DB                             ;  The skip cache is above. These are the handlers' tails that the builds with
03DB                             ;  room take, kept here, out of the handlers' first two pages.
03DB                          IF   QK   
03DB                             ; "*" with an operand below 256 takes 8 rounds, not 16: that one becomes the
03DB                             ; multiplier (most multiplications have one, a count or a small constant).
03DB   7C           MULQ:     LD   A,H   
03DC   B7                     OR   A   
03DD   28 05                  JR   Z,mq8   ; the multiplier is below 256
03DF   7A                     LD   A,D   
03E0   B7                     OR   A   
03E1   20 2F                  JR   NZ,mq16   
03E3   EB                     EX   DE,HL   ; the multiplicand is: it becomes the multiplier
03E4                          ENDIF      
03E4                          IF   QK*(1-FAST)   
                    MQ8:      LD   A,L   
                              LD   HL,0   
                              PUSH   BC   
                              LD   B,8   
                    MQ1:      ADD   HL,HL   
                              RLA      
                              JR   NC,mq2   
                              ADD   HL,DE   
                    MQ2:      DJNZ   mq1   
                              POP   BC   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
                    MQ16:     PUSH   BC   ; 16 rounds; the multiplier shifts up through A:C
                              LD   A,H   
                              LD   C,L   
                              LD   HL,0   
                              LD   B,16   
                    MQ3:      ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mq4   
                              ADD   HL,DE   
                    MQ4:      DJNZ   mq3   
                              POP   BC   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
03E4                          ENDIF      
03E4                          IF   FAST   
03E4                             ; (the fast build: the same rounds, unrolled)
03E4   7D           MQ8:      LD   A,L   
03E5   21 00 00               LD   HL,0   
03E8   29                     ADD   HL,HL   
03E9   17                     RLA      
03EA   30 01                  JR   NC,mur0   
03EC   19                     ADD   HL,DE   
03ED                MUR0:        
03ED   29                     ADD   HL,HL   
03EE   17                     RLA      
03EF   30 01                  JR   NC,mur1   
03F1   19                     ADD   HL,DE   
03F2                MUR1:        
03F2   29                     ADD   HL,HL   
03F3   17                     RLA      
03F4   30 01                  JR   NC,mur2   
03F6   19                     ADD   HL,DE   
03F7                MUR2:        
03F7   29                     ADD   HL,HL   
03F8   17                     RLA      
03F9   30 01                  JR   NC,mur3   
03FB   19                     ADD   HL,DE   
03FC                MUR3:        
03FC   29                     ADD   HL,HL   
03FD   17                     RLA      
03FE   30 01                  JR   NC,mur4   
0400   19                     ADD   HL,DE   
0401                MUR4:        
0401   29                     ADD   HL,HL   
0402   17                     RLA      
0403   30 01                  JR   NC,mur5   
0405   19                     ADD   HL,DE   
0406                MUR5:        
0406   29                     ADD   HL,HL   
0407   17                     RLA      
0408   30 01                  JR   NC,mur6   
040A   19                     ADD   HL,DE   
040B                MUR6:        
040B   29                     ADD   HL,HL   
040C   17                     RLA      
040D   30 01                  JR   NC,mur7   
040F   19                     ADD   HL,DE   
0410                MUR7:        
0410                          ;*Macro unroll:  NEXT
0410                          DS   (1-CPM)*(1-FAST),0F7h   
0410   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0411   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0412   C5           MQ16:     PUSH   BC   
0413   7C                     LD   A,H   
0414   4D                     LD   C,L   
0415   21 00 00               LD   HL,0   
0418   29                     ADD   HL,HL   
0419   CB 21                  SLA   C   
041B   17                     RLA      
041C   30 01                  JR   NC,mus0   
041E   19                     ADD   HL,DE   
041F                MUS0:        
041F   29                     ADD   HL,HL   
0420   CB 21                  SLA   C   
0422   17                     RLA      
0423   30 01                  JR   NC,mus1   
0425   19                     ADD   HL,DE   
0426                MUS1:        
0426   29                     ADD   HL,HL   
0427   CB 21                  SLA   C   
0429   17                     RLA      
042A   30 01                  JR   NC,mus2   
042C   19                     ADD   HL,DE   
042D                MUS2:        
042D   29                     ADD   HL,HL   
042E   CB 21                  SLA   C   
0430   17                     RLA      
0431   30 01                  JR   NC,mus3   
0433   19                     ADD   HL,DE   
0434                MUS3:        
0434   29                     ADD   HL,HL   
0435   CB 21                  SLA   C   
0437   17                     RLA      
0438   30 01                  JR   NC,mus4   
043A   19                     ADD   HL,DE   
043B                MUS4:        
043B   29                     ADD   HL,HL   
043C   CB 21                  SLA   C   
043E   17                     RLA      
043F   30 01                  JR   NC,mus5   
0441   19                     ADD   HL,DE   
0442                MUS5:        
0442   29                     ADD   HL,HL   
0443   CB 21                  SLA   C   
0445   17                     RLA      
0446   30 01                  JR   NC,mus6   
0448   19                     ADD   HL,DE   
0449                MUS6:        
0449   29                     ADD   HL,HL   
044A   CB 21                  SLA   C   
044C   17                     RLA      
044D   30 01                  JR   NC,mus7   
044F   19                     ADD   HL,DE   
0450                MUS7:        
0450   29                     ADD   HL,HL   
0451   CB 21                  SLA   C   
0453   17                     RLA      
0454   30 01                  JR   NC,mus8   
0456   19                     ADD   HL,DE   
0457                MUS8:        
0457   29                     ADD   HL,HL   
0458   CB 21                  SLA   C   
045A   17                     RLA      
045B   30 01                  JR   NC,mus9   
045D   19                     ADD   HL,DE   
045E                MUS9:        
045E   29                     ADD   HL,HL   
045F   CB 21                  SLA   C   
0461   17                     RLA      
0462   30 01                  JR   NC,mus10   
0464   19                     ADD   HL,DE   
0465                MUS10:       
0465   29                     ADD   HL,HL   
0466   CB 21                  SLA   C   
0468   17                     RLA      
0469   30 01                  JR   NC,mus11   
046B   19                     ADD   HL,DE   
046C                MUS11:       
046C   29                     ADD   HL,HL   
046D   CB 21                  SLA   C   
046F   17                     RLA      
0470   30 01                  JR   NC,mus12   
0472   19                     ADD   HL,DE   
0473                MUS12:       
0473   29                     ADD   HL,HL   
0474   CB 21                  SLA   C   
0476   17                     RLA      
0477   30 01                  JR   NC,mus13   
0479   19                     ADD   HL,DE   
047A                MUS13:       
047A   29                     ADD   HL,HL   
047B   CB 21                  SLA   C   
047D   17                     RLA      
047E   30 01                  JR   NC,mus14   
0480   19                     ADD   HL,DE   
0481                MUS14:       
0481   29                     ADD   HL,HL   
0482   CB 21                  SLA   C   
0484   17                     RLA      
0485   30 01                  JR   NC,mus15   
0487   19                     ADD   HL,DE   
0488                MUS15:       
0488   C1                     POP   BC   
0489                          ;*Macro unroll:  NEXT
0489                          DS   (1-CPM)*(1-FAST),0F7h   
0489   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
048A   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
048B                          ENDIF      
048B                          IF   QK   
048B                             ; A true ")" reads the block start where it is, on top of the return stack,
048B                             ; instead of popping it and pushing it back; the break key is looked at as
048B                             ; rpushn would.
048B   FD 4E 00     CLOSEQ:   LD   C,(IY+0)   
048E   FD 46 01               LD   B,(IY+1)   
0491   E5                     PUSH   HL   
0492   21 36 82               LD   HL,PCNT   
0495   35                     DEC   (HL)   
0496   E1                     POP   HL   
0497   CC F1 04               CALL   Z,pollk   
049A                          ;*Macro unroll:  NEXT
049A                          DS   (1-CPM)*(1-FAST),0F7h   
049A   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
049B   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
049C                          ENDIF      
049C                          IF   SBASEU   
                                 ; a-z, in the unchecked builds: a variable followed by "@" or "!" is fetched
                                 ; or stored in the same step (x@ is the commonest pair in most programs).
                                 ; (A checked build checks the stacks between the two, so it keeps them apart.)
                    LOWQ:     ADD   A,A   
                              LD   E,A   
                              LD   D,LETPAGE   ; DE -> the cell
                              LD   A,(BC)   
                              CP   "@"   
                              JR   Z,lwf   
                              CP   "!"   
                              JR   Z,lws   
                              PUSH   HL   
                              EX   DE,HL   ; TOS = the cell's address
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
                    LWF:      INC   BC   ; x@: TOS = the cell's value
                              PUSH   HL   
                              EX   DE,HL   
                              LD   E,(HL)   
                              INC   L   
                              LD   D,(HL)   
                              EX   DE,HL   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
                    LWS:      INC   BC   ; x!: the cell = TOS, and NOS comes up
                              EX   DE,HL   
                              LD   (HL),E   
                              INC   L   
                              LD   (HL),D   
                              POP   HL   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
049C                          ENDIF      
049C                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)*QK   
049C   01 00 83     QSTART:   LD   BC,PROG   ; the generic reset goes on here: the IP,
049F   CD D0 03               CALL   skclr   ;   an empty skip cache, and the rest of the
04A2   C3 3C 00               JP   st0   ;   startup
04A5                          ENDIF      
04A5                          IF   (1-CPM)*(1-EDITOR)*CHECKED*QK   
                    QINIT:    CALL   skclr   ; (keeps A, which init wants 0)
                              JP   init   
04A5                          ENDIF      
04A5                             ; =============================================================================
04A5                             ;  Dispatch table: the low byte of each handler's address, in code order
04A5                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
04A5                             ;  It must not cross a page (the dispatcher only adds to its low byte).
04A5                             ; =============================================================================
04A5                             ; The handlers of the first NPG1 characters start in the image's second page.
04A5                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
04A5                             ; differs between the builds, so the count is worked out here.
04A5                             ; (One division to a line: asm80 only rounds down when it stores a value.)
04A5                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
04A5                PGBRK:    EQU   (h_break-BASE)/256   
04A5                PGDEF:    EQU   (h_def-BASE)/256   
04A5                PGFET:    EQU   (h_fetch-BASE)/256   
04A5                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
04A5                          IF   (1-TABP0)*(1-PTLATE)   
04A5                PTAB:        
04A5                          ;*Macro unroll:  PTABLE
04A5   7D                     DB   h_store & 0FFh   
04A6   84                     DB   h_str & 0FFh   
04A7   AA                     DB   h_num & 0FFh   
04A8   8C                     DB   h_print & 0FFh   
04A9   75                     DB   h_swap & 0FFh   
04AA   2B                     DB   h_and & 0FFh   
04AB   A5                     DB   h_emit & 0FFh   
04AC   08                     DB   h_open & 0FFh   
04AD   10                     DB   h_close & 0FFh   
04AE   4E                     DB   h_mul & 0FFh   
04AF   20                     DB   h_add & 0FFh   
04B0   C8                     DB   h_cfetch & 0FFh   
04B1   18                     DB   h_sub & 0FFh   
04B2   78                     DB   h_cstore & 0FFh   
04B3   52                     DB   h_div & 0FFh   
04B4   72                     DB   h_dup & 0FFh   
04B5   7A                     DB   h_drop & 0FFh   
04B6   34                     DB   h_lt & 0FFh   
04B7   44                     DB   h_eq & 0FFh   
04B8   35                     DB   h_gt & 0FFh   
04B9   B0                     DB   h_key & 0FFh   
04BA   02                     DB   h_fetch & 0FFh   
04BB   E4                     DB   h_def & 0FFh   
04BC   D6                     DB   h_break & 0FFh   
04BD   D1                     DB   h_ret & 0FFh   
04BE   55                     DB   h_xor & 0FFh   
04BF   6B                     DB   h_alloc & 0FFh   
04C0   BA                     DB   h_grave & 0FFh   
04C1   B6                     DB   h_tor & 0FFh   
04C2   5E                     DB   h_or & 0FFh   
04C3   1C                     DB   h_fromr & 0FFh   
04C4   67                     DB   h_not & 0FFh   
04C5                PTABEND:      
04C5                          ENDIF      
04C5                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
04C5                             ; and return its value in A with the carry set; otherwise leave the IP and
04C5                             ; return with the carry clear.
04C5   0A           HEXC:     LD   A,(BC)   
04C6   D6 30                  SUB   "0"   
04C8   FE 0A                  CP   10   
04CA   38 09                  JR   C,hc1   
04CC   E6 DF                  AND   0DFh   
04CE   D6 11                  SUB   11h   
04D0   FE 06                  CP   6   
04D2   D0                     RET   NC   
04D3   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
04D5   03           HC1:      INC   BC   
04D6   C9                     RET      
04D7                             ; psgn: print HL as a signed number. Keeps BC.
04D7   CB 7C        PSGN:     BIT   7,H   
04D9   28 04                  JR   Z,pdec   
04DB                          ;*Macro unroll:  PUTK    2Dh             ; '-'
04DB   3E                     DS   1-CPM,3Eh   ; "-"
04DC   2D                     DS   1-CPM,2Dh   
04DD   EF                     DS   1-CPM,0EFh   
04DE                          DS   CPM,0CDh   
04DE                          DS   CPM,APTK&0FFh   
04DE                          DS   CPM,APTK/256   
04DE                          DS   CPM,2Dh   
04DE                          ;*Macro unroll:  NEGH
04DE   E7                     DS   1-CPM,0E7h   
04DF                          DS   CPM,0CDh   
04DF                          DS   CPM,ANEG&0FFh   
04DF                          DS   CPM,ANEG/256   
04DF                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
04DF                             ; Keeps BC.
04DF   11 0A 00     PDEC:     LD   DE,10   
04E2   CD 33 02               CALL   udiv   ; HL = HL / 10, E = the last digit
04E5   7B                     LD   A,E   
04E6   F5                     PUSH   AF   
04E7   7C                     LD   A,H   
04E8   B5                     OR   L   
04E9   C4 DF 04               CALL   NZ,pdec   
04EC   F1                     POP   AF   
04ED   C6 30                  ADD   A,"0"   
04EF                          ;*Macro unroll:  PUTAR
04EF   EF                     DS   1-CPM,0EFh   
04F0   C9                     DS   1-CPM,0C9h   
04F1                          DS   CPM,0C3h   
04F1                          DS   CPM,APUT&0FFh   
04F1                          DS   CPM,APUT/256   
04F1                             ; (The table goes here instead in the builds where, before psgn, it would
04F1                             ; cross a page: PTLATE. If it would cross one here too, it starts on the next
04F1                             ; page: PTPAD is 0 unless it must.)
04F1                          IF   (1-TABP0)*PTLATE   
                    PTPH:     EQU   $ & 0FFh   
                    PTPX:     EQU   (PTPH + 31) / 256   
                    PTPAD:    EQU   PTPX * (256 - PTPH)   
                              DS   PTPAD   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
04F1                          ENDIF      
04F1                             ; =============================================================================
04F1                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
04F1                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
04F1                             ;  (RST 28h) prints A. Both keep BC, DE, HL and IY. In the generic build
04F1                             ;  they are the host's KEY and CONOUT routines themselves.
04F1                             ; 
04F1                             ;  A running program reads the keyboard only through getk and pollk, which
04F1                             ;  between them give the break key its rules:
04F1                             ;    - Ctrl-C stops the program;
04F1                             ;    - any other key that the break check reads is held in KEYBUF for the
04F1                             ;      next "?", and a newer one takes its place;
04F1                             ;    - "?" (getk) takes the held key first;
04F1                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
04F1                             ;      key like any other, but two of them within about 250 ms still stop it.
04F1                             ;  Both are called straight from a handler, never from a routine under one:
04F1                             ;  the checked build's report counts on finding one return address above the
04F1                             ;  data stack.
04F1                             ; =============================================================================
04F1                          IFN   CPM   
04F1                RAWK:     EQU   KEY   
04F1                          ENDIF      
04F1                             ; pollk: the break check (see rpushn).
04F1   CD 06 FF     POLLK:    CALL   rawk   
04F4   C8                     RET   Z   ; no key
04F5   32 7A 82               LD   (KEYBUF),A   ; held for the next "?"
04F8   FE 03        PK1:      CP   3   ; (getk joins here)
04FA   C0                     RET   NZ   
04FB                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
04FB                             ; the program has turned it off, wait about 250 ms for one more key: a
04FB                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
04FB                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
04FB   3A 7B 82     CTLC:     LD   A,(BRKOFF)   
04FE   B7                     OR   A   
04FF   CA 14 00     CT0:      JP   Z,brk   
0502   D5                     PUSH   DE   
0503   11 10 27               LD   DE,250*MSLOOP   
0506   CD 06 FF     CT1:      CALL   rawk   
0509   20 05                  JR   NZ,ct2   
050B   1B                     DEC   DE   
050C   7A                     LD   A,D   
050D   B3                     OR   E   
050E   20 F6                  JR   NZ,ct1   
0510   D1           CT2:      POP   DE   ; A = the second key, or 0 if none came
0511   FE 03                  CP   3   
0513   28 EA                  JR   Z,ct0   ; (the zero flag takes the JP there)
0515   B7                     OR   A   
0516   28 03                  JR   Z,ct3   
0518   32 7A 82               LD   (KEYBUF),A   
051B   3E 03        CT3:      LD   A,3   
051D   B7                     OR   A   
051E   C9                     RET      
051F                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
051F   E5           GETK:     PUSH   HL   ; a held key goes first, and is taken out of
0520   21 7A 82               LD   HL,KEYBUF   ;   the buffer
0523   7E                     LD   A,(HL)   
0524   36 00                  LD   (HL),0   
0526   E1                     POP   HL   
0527   B7                     OR   A   
0528   C0                     RET   NZ   
0529   CD 06 FF               CALL   rawk   
052C   C8                     RET   Z   
052D   18 C9                  JR   pk1   ; Ctrl-C? If not, that is the key
052F                          IF   (1-CHECKED)*(1-EDITOR)   
052F                BRK:      EQU   endprog   ; the unchecked build stops without a word
052F                          ENDIF      ;   (with the editor, both stacks are cleared);
052F                          IF   (1-CHECKED)*EDITOR   
                    BRK:      EQU   edit0   
052F                          ENDIF      
052F                          IF   CHECKED   
                    BRK:      EQU   e_break   ;   the checked build reports B
052F                          ENDIF      
052F                          IF   CPM   
                                 ; The routines a generic build keeps in page zero (see there). Here they are
                                 ; out of the way of the handlers, which must fit in the image's first two
                                 ; pages.
                    RPOP:     LD   E,(IY+0)   ; pop the return stack into DE
                              LD   D,(IY+1)   
                              INC   IY   
                              INC   IY   
                              RET      
                    NEG16:    XOR   A   ; HL = -HL (keeps BC, DE)
                              SUB   L   
                              LD   L,A   
                              SBC   A,A   
                              SUB   H   
                              LD   H,A   
                              RET      
052F                          ENDIF      
052F                          IF   CPM*CHECKED   ; (the checked builds need the room)
                    EXEC:     LD   (RSAVE),IY   ; machine code may change IX and IY
                              CALL   jphl   
                              LD   IY,(RSAVE)   
                              ;*Macro unroll:  SETIX
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,21h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
                              POP   HL   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
052F                          ENDIF      
052F                          IF   CPM   
                    RAWK:     LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
                              JR   putc   
                    PUTK:     EX   (SP),HL   ; print the byte after the CALL
                              LD   A,(HL)   
                              INC   HL   
                              EX   (SP),HL   
                                 ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
                                 ; printing and could swallow a key that BDOS 6 then never sees.
                                 ; It keeps every register but A and the flags: BDOS may change any of them
                                 ; (IX and IY too, in a Z80 BDOS or BIOS).
                    PUTC:     PUSH   BC   
                              PUSH   DE   
                              PUSH   HL   
                              PUSH   IX   
                              PUSH   IY   
                              LD   E,A   
                              LD   C,6   
                              CALL   BDOS   
                              POP   IY   
                              POP   IX   
                              POP   HL   
                              POP   DE   
                              POP   BC   
                              OR   A   ; (for getk)
                              RET      
052F                          ENDIF      
052F                             ; =============================================================================
052F                             ;  Checked build: the checks and the error report
052F                             ; =============================================================================
052F                          IF   CHECKED   
                                 ; chkstk: both stacks are checked once per character, not in every handler.
                                 ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
                                 ; the constant carries if it is above (cells were popped that were never
                                 ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
                                 ; a character late at most: the bytes above DSTOP and the guard band below
                                 ; the page take what happens meanwhile. DE is free between characters.
                    CHKSTK:   EX   DE,HL   
                              LD   HL,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
                              ADD   HL,SP   
                              EX   DE,HL   
                              JR   C,e_under   
                              INC   D   
                              JR   NZ,e_over   
                              PUSH   IY   ; the return stack: in its page (or it has
                              POP   DE   ;   overflowed), and not above its empty
                              LD   A,D   ;   position (an underflow stays inside the
                              CP   RSPAGE   ;   page, in the guard band)
                              LD   A,E   
                              JR   NZ,e_rover   
                              CP   RSTOP&0FFh+1   
                              RET   C   
                              LD   IY,RSTOP   ; return stack underflow: it counts as empty
                              LD   A,"r"   
                              JR   errp   
                    E_ROVER:   LD   A,"R"   ; return stack overflow
                              DB   11h   ; (LD DE,nn hides the next entry)
                    E_OVER:   LD   A,"S"   ; data stack overflow
                              JR   errp   
                    E_UNDER:   LD   SP,DSTOP   ; data stack underflow: it counts as empty
                              LD   A,"s"   
                              JR   error   
                                 ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
                                 ; was never defined still holds 0000h, and the byte there is a reserved one
                                 ; in every build (AFh or C3h): if the IP is in page zero, this was a call of
                                 ; an undefined word. The call is undone, so the place is the call itself.
                    E_HI:     INC   B   
                              DJNZ   e_resv   ; (B is as it was, and is not 0)
                              ;*Macro unroll:  POPR
                              DS   1-CPM,0CFh   
                              DS   CPM,0CDh   
                              DS   CPM,AROP&0FFh   
                              DS   CPM,AROP/256   
                              LD   B,D   
                              LD   C,E   
                              LD   A,"U"   
                              JR   error   
                                 ; chkhp: HL = the new heap top, DE = the old one, the carry is from adding
                                 ; the count. Stop if the top is not below the limit page, or is below the
                                 ; program's end.
                    CHKHP:       
052F                          ENDIF      
052F                          IF   CHECKED*CPM   
                                 ; With this much room a top that wrapped round can land back in
                                 ; range, so the add is tested too: growing (A, the count's high
                                 ; byte, is positive) must not carry, and releasing must.
                              RRA      ; the carry comes in above the sign:
                              ADD   A,40h   ;   bit 7 = carry XOR sign
                              ADD   A,A   
                              JR   C,e_heap   
                              LD   A,(0007h)   
                              DEC   A   
                              CP   H   
                              JR   C,e_heap   
052F                          ENDIF      
052F                          IF   CHECKED*(1-CPM)   
                                 ; (Here the program's space is under 32K, so a top that wrapped
                                 ; round always falls outside it.)
                              LD   A,H   
                              CP   HEAPLIM   
                              JR   NC,e_heap   
052F                          ENDIF      
052F                          IF   CHECKED   
                              PUSH   DE   
                              EX   DE,HL   
                              LD   HL,(NPEND)   
                              ADD   HL,DE   ; carry: at or above the program's end
                              EX   DE,HL   
                              POP   DE   
                              RET   C   
                    E_HEAP:   OR   A   ; put the count back in TOS for the report
                              SBC   HL,DE   
                              LD   A,"H"   
                              JR   errp   
                                 ; chkst: stop unless HL is in the program's own space: from the letter page
                                 ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
                                 ; whatever lies above the limit are safe. Memory above the heap top but
                                 ; below the limit is the program's own: Tiny BASIC keeps its lines there.
                                 ; It is the page of HL + 1 that is tested, so that one test serves both
                                 ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
                                 ; Keeps HL and BC. It runs on into its own error entry.
                    CHKST:    INC   HL   
                              LD   A,H   
                              DEC   HL   
                              CP   LETPAGE   
                              JR   C,e_store   
052F                          ENDIF      
052F                          IF   CHECKED*(1-CPM)   
                              CP   HEAPLIM   
                              RET   C   
052F                          ENDIF      
052F                          IF   CHECKED*CPM   
                              LD   E,A   
                              LD   A,(0007h)   ; the BDOS page is the heap limit
                              DEC   A   
                              CP   E   
                              RET   NC   
052F                          ENDIF      
052F                          IF   CHECKED   
                                 ; Error entries. Each loads its letter and then hides the next entry inside
                                 ; a 3-byte LD DE,nn (the 11h), so they all fall through to `error`.
                    E_STORE:   LD   A,"O"   ; a store outside the program's space
                              DB   11h   
                    E_BREAK:   LD   A,"B"   ; Ctrl-C (found inside pollk or getk)
                                 ; errp: an error found inside a routine: drop its return address first.
                    ERRP:     POP   DE   
                              JR   error   
                                 ; e_dollar: "$" ran into a NUL (in prstr): Q, with the string's address
                                 ; back in TOS. prstr"s return address goes first. But if "$' had no
                                 ; address at all (the stack was empty), it is s, found now: chkstk, called
                                 ; one cell up, sees the stack past its empty place then.
                    E_DOLLAR:   POP   DE   
                              POP   HL   
                              CALL   chkstk   
                              PUSH   HL   
                              LD   HL,(RSAVE)   
                              DB   11h   ; (LD DE,nn hides e_quote's first two bytes)
                    E_QUOTE:   LD   B,H   ; an unclosed string: HL is its address, one
                              LD   C,L   ;   past the opening quote, which is the place
                              LD   A,"Q"   
                              DB   11h   
                    E_RESV:   LD   A,"X"   ; a reserved byte outside a string
                              DB   11h   
                    E_ZERO:   LD   A,"Z"   ; dividing by zero
                              DB   11h   
                    E_BRACK:   LD   A,"W"   ; bad character after [
                                 ; error: the report, then the end. A = the letter, BC = one past the place,
                                 ; HL = TOS, and both stacks as the report is to show them:
                                 ; 
                                 ;   Err X @ line,col
                                 ;   D:n: the top 8 cells at most, bottom to top
                                 ;   R:n
                    ERROR:    PUSH   HL   ; now the whole data stack is in memory
                              LD   E,A   
                              CALL   pnl   
                              DB   "Err ",22h   
                              LD   A,E   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              CALL   pmsg   
                              DB   " @ ",22h   
                              DEC   BC   ; BC = the place
                                 ; The line and column. A place below the program is in the line
                                 ; buffer: line 0. Otherwise count the LFs from the program's start;
                                 ; DE = the line's number, HL = where it starts.
                              LD   HL,LINEBUF   
                              LD   DE,0   
                              LD   A,B   
                              CP   PROG/256   
                              JR   C,er3   
                              INC   H   
                              LD   L,E   ; HL = PROG
                    ER1:      INC   DE   ; a new line starts at HL
                              PUSH   HL   
                    ER2:      LD   A,L   
                              SUB   C   
                              LD   A,H   
                              SBC   A,B   
                              JR   NC,er2x   ; reached the place
                              LD   A,(HL)   
                              INC   HL   
                              CP   10   
                              JR   NZ,er2   
                              POP   AF   
                              JR   er1   
                    ER2X:     POP   HL   
                    ER3:      PUSH   BC   
                              PUSH   HL   
                              EX   DE,HL   
                              CALL   pdec   ; the line
                              ;*Macro unroll:  PUTK    2Ch             ; ','
                              DS   1-CPM,3Eh   ; ","
                              DS   1-CPM,2Ch   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,2Ch   
                              POP   DE   
                              POP   HL   
                              OR   A   
                              SBC   HL,DE   
                              INC   HL   
                              CALL   pdec   ; the column
                                 ; The two stack lines:  D:n: the top 8 cells at most, bottom to top
                                 ;                       R:n
                                 ; TOS is in memory with the rest (pushed) by now.
                              CALL   pnl   
                              DB   "D:",22h   
                              LD   HL,DSTOP-2   ; (DSTOP-2) - SP is twice the depth (the cell
                              SBC   HL,SP   ;   at DSTOP-2 was pushed with the first value
                                 ;   and holds nothing; pnl left the carry clear)
                              CALL   phalf   ; the depth
                              ;*Macro unroll:  PUTK    3Ah             ; ':'
                              DS   1-CPM,3Eh   ; ":"
                              DS   1-CPM,3Ah   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,3Ah   
                              LD   A,C   
                              CP   9   
                              JR   C,er6   
                              CALL   pmsg   
                              DB   " ...",22h   
                              LD   C,8   
                    ER6:      LD   H,0   ; C = the number of cells to show
                              LD   L,C   
                              ADD   HL,HL   
                              ADD   HL,SP   ; HL -> just above the deepest of them
                              INC   C   
                    ER7:      DEC   C   
                              JR   Z,er8   
                              DEC   HL   
                              LD   D,(HL)   
                              DEC   HL   
                              LD   E,(HL)   
                              PUSH   HL   
                              ;*Macro unroll:  PUTK    20h             ; ' '
                              DS   1-CPM,3Eh   ; " "
                              DS   1-CPM,20h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,20h   
                              EX   DE,HL   
                              CALL   psgn   
                              POP   HL   
                              JR   er7   
                    ER8:      CALL   pnl   
                              DB   "R:",22h   
                              PUSH   IY   ; RSTOP - IY is under 256 (the pointer is
                              POP   HL   ;   at most one entry below its page), so
                              LD   A,RSTOP&0FFh   ;   the low bytes are enough
                              SUB   L   
                              LD   L,A   
                              LD   H,0   
                              CALL   phalf   
                              CALL   pnl   
                              DB   22h   
052F                          ENDIF      
052F                          IF   CHECKED*(1-EDITOR)   
                              JP   endprog   
052F                          ENDIF      
052F                          IF   CHECKED*EDITOR   
                              JR   edit0   ; back to the editor, with both stacks cleared
052F                          ENDIF      
052F                          IF   CHECKED   
                                 ; phalf: print half of HL, and leave it in C.
                    PHALF:    SRL   H   
                              RR   L   
                              PUSH   HL   
                              CALL   pdec   
                              POP   BC   
                              RET      
052F                          ENDIF      
052F                             ; =============================================================================
052F                             ;  The line editor (EDITOR = 1)
052F                             ; 
052F                             ;  The interpreter starts here, and a program that ends comes back here.
052F                             ;  There is no prompt. It follows the spec's suggested standard for a line
052F                             ;  editor (docs/b8script.md, Environments). Type a line and press Return:
052F                             ; 
052F                             ;    n text    put the text in as line n; the lines from n on move down. A
052F                             ;              number past the end (or 0) adds the line at the end.
052F                             ;    n         take line n out
052F                             ;    anything else is run at once, as B8Script. (Start such a line with a
052F                             ;    space if it would begin with a digit.)
052F                             ; 
052F                             ;  A command key ends the line too, and takes what was typed as its argument:
052F                             ; 
052F                             ;    ^G        run the program
052F                             ;    n ^L      list from line n (no number: all of it). Any key holds the
052F                             ;              list until another key is pressed; Ctrl-C ends it.
052F                             ;    n ^E      put line n in the input line; Return puts it back, changed
052F                             ;    name ^R   read. CP/M: the file of that name (no name: the same file as
052F                             ;              last time). Generic: what is typed, or pasted, from now until
052F                             ;              ^Z replaces the program; it is not echoed.
052F                             ;    name ^W   write. CP/M: to that file (no name: the same file as last
052F                             ;              time). Generic: the text is printed, as it is.
052F                             ;    ^N        new: no program
052F                             ;    ^X        leave (to LEAVE)
052F                             ; 
052F                             ;  In the line: the left and right arrow keys move the cursor;
052F                             ;  a character goes in at the cursor; Backspace and DEL take out the one
052F                             ;  before it; Esc drops the line. Only CR, LF, BS and printing characters are
052F                             ;  sent to the terminal, so any terminal will do.
052F                             ; 
052F                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
052F                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
052F                             ;  125 characters; the one character after a line number separates it from
052F                             ;  the text and is not stored. The text is kept as it is typed, each line
052F                             ;  ending in CR LF, at PROG.
052F                             ; 
052F                             ;  What lasts from one line to the next: the program, the words, the
052F                             ;  variables and the data stack. An error or a break clears both stacks. The
052F                             ;  return stack starts empty for every line.
052F                             ; 
052F                             ;  Things to know:
052F                             ;    - Reset empties the program (generic builds).
052F                             ;    - A word's address points into the program, so run the program again
052F                             ;      after editing it.
052F                             ;    - Nothing is printed between a program's output and what is typed next.
052F                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
052F                             ;      a line that calls -n? and carries on afterwards runs what was typed.
052F                             ;      (The stored program never comes back to the line, so it may.)
052F                             ;    - The editor"s own keys are not the program"s: -n? is the plain line
052F                             ;      read of the other builds.
052F                             ; 
052F                             ;  The data stack is the CPU's stack, so the editor works on top of whatever
052F                             ;  the last line left there, with TOS pushed like the rest.
052F                             ; =============================================================================
052F                          IF   EDGEN   
                    INIT:        ; reset (A = 0)
052F                          ENDIF      
052F                          IF   EDGEN*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at 0, and
                                 ; every word cell holds 0000h, the address an undefined word is caught at
                                 ; (see e_hi).
                              LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
052F                          ENDIF      
052F                          IF   EDGEN   
                              JR   edit0   
052F                          ENDIF      
052F                          IF   EDITOR   
                                 ; Right arrow: one to the right, by printing the character there
                    RIGHT:    LD   A,L   
                              CP   E   
                              JR   Z,ed1   ; at the end
                              LD   A,(HL)   
                              INC   L   
                              JR   lf1   
                                 ; Esc: alone it drops the line. An arrow key sends Esc [ and a letter, so
                                 ; wait about 5 ms for a second key: after a "[" read on to the letter that
                                 ; ends the sequence, and act on C (right) and D (left).
                    ESC:      LD   BC,5*MSLOOP   
                    ES1:      CALL   rawk   
                              JR   NZ,es2   
                              DEC   BC   
                              LD   A,B   
                              OR   C   
                              JR   NZ,es1   
                              CALL   fin   ; no second key: the line is dropped
                              JR   edit   
                    ES2:      CP   "["   
                              JR   NZ,ed1   ; not a sequence known here
                    ES3:      CALL   ekey   
                              CP   40h   
                              JR   C,es3   ; (its parameters)
                              SUB   "C"   
                              JR   Z,right   
                              DEC   A   ; "D"?
                              JR   NZ,ed1   ; no: on into left
                                 ; Left arrow: the cursor goes one to the left
                    LEFT:     LD   A,L   
                              ADD   A,A   
                              JR   Z,ed1   ; (L = 80h: at the start)
                              DEC   L   
                              LD   A,8   
                              ;*Macro unroll: lf1:    PUTA
                    LF1:      DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              JR   ed1   
                                 ; edit0: reset, an error or a break: both stacks are cleared, and the cursor
                                 ;   is shown, in case the program had hidden it and could not show it again.
                                 ; skend: a program that ended inside skip: its return address goes.
                                 ; edend: a program that ended: TOS joins the rest of the data stack.
                    EDIT0:    LD   SP,DSTOP-2   ; empty (the cell that stands for TOS is pushed)
052F                          ENDIF      
052F                          IF   EDITOR*ANS   
                              XOR   A   ; (pshow wants the carry clear)
                              CALL   pshow   ; ESC [ ? 2 5 h
052F                          ENDIF      
052F                          IF   EDITOR*(1-ANS)   
                              LD   A,1   
                              CALL   CONCUR   ; show the cursor
052F                          ENDIF      
052F                          IF   EDITOR   
                              DB   21h   ; (LD HL,nn: steps over the next two bytes)
                    SKEND:    POP   DE   
                    EDEND:    PUSH   HL   
                                 ; edit: start a new input line.
                    EDIT:     LD   IY,RSTOP   ; the return stack is empty
                              ;*Macro unroll:  SETIX                   ; (a file read or written may have changed IX)
                              DS   CPM+FAST-CPM*FAST,0DDh   ; (a file read or written may have changed IX)
                              DS   CPM+FAST-CPM*FAST,21h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
                              LD   HL,0   
                              LD   (KEYBUF),HL   ; no key is held, and the break key is on
                              LD   (EDLN),HL   ; no line is being edited
                              LD   HL,LINEBUF   ; HL = the cursor,
                              LD   E,L   ;   E = the end of the line (its low byte)
                    ED1:      CALL   ekey   
                              CP   7Fh   
                              JR   Z,bsp   ; DEL
                              CP   " "   
                              JR   NC,insc   
                              CP   9   
                              JR   Z,insc   ; Tab is text
                              CP   8   
                              JR   Z,bsp   
                              CP   1Bh   
                              JR   Z,esc   
                              PUSH   HL   ; a command key? Look it up
                              LD   HL,cmds   
                              LD   B,NCMD   
                    ED2:      CP   (HL)   
                              INC   HL   
                              JR   Z,ed3   
                              INC   HL   
                              INC   HL   
                              DJNZ   ed2   
                              POP   HL   
                              JR   ed1   ; no: the key is ignored
                    ED3:      LD   A,(HL)   
                              INC   HL   
                              LD   H,(HL)   
                              LD   L,A   
                              EX   (SP),HL   ; the command's address: fin returns to it
                                 ; fin: end the input line: CR LF and a NUL after it, and a new line on the
                                 ; terminal. Leaves BC -> the line and HL -> the NUL.
                    FIN:      LD   H,LETPAGE   
                              LD   L,E   
                              LD   (HL),13   
                              INC   L   
                              LD   (HL),10   
                              DEC   L   
                              CALL   prl   ; (prints the CR LF)
                              LD   (HL),0   
                              LD   BC,LINEBUF   
                              RET      
                                 ; Backspace, DEL: the character before the cursor goes. The cursor moves
                                 ; left, the rest of the line moves down over it, and the last place (now a
                                 ; space) is printed over along with the rest.
                    BSP:      LD   A,L   
                              ADD   A,A   
                              JR   Z,ed1   ; at the start
                              DEC   L   
                              ;*Macro unroll:  PUTK    08h             ; backspace
                              DS   1-CPM,3Eh   ; backspace
                              DS   1-CPM,08h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,08h   
                              PUSH   HL   
                    BS1:      INC   L   
                              LD   A,(HL)   
                              DEC   L   
                              LD   (HL),A   
                              INC   L   
                              LD   A,L   
                              CP   E   
                              JR   NZ,bs1   
                              DEC   L   
                              LD   (HL)," "   
                              POP   HL   
                              LD   D,E   
                              DEC   E   
                              JR   ic2   
                                 ; A character goes in at the cursor: it ripples up through the rest of the
                                 ; line, the cursor moves on, and the rest is printed again.
                    INSC:     LD   B,A   
                              LD   A,E   
                              CP   0FDh   
                              JR   Z,ed1   ; the line is full: 125 characters
                              LD   A,B   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              PUSH   HL   
                    IC1:      LD   A,(HL)   
                              LD   (HL),B   
                              LD   B,A   
                              LD   A,L   
                              INC   L   
                              CP   E   
                              JR   NZ,ic1   
                              POP   HL   
                              INC   L   
                              INC   E   
                              LD   D,E   
                    IC2:      CALL   tail   
                              JR   ed1   
                                 ; tail: print the line from the cursor to D (a low byte), and bring the
                                 ; cursor back with backspaces. Nothing at all if the cursor is at D.
                    TAIL:     LD   C,L   
                    TA1:      LD   A,L   
                              CP   D   
                              JR   Z,ta2   
                              LD   A,(HL)   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              INC   L   
                              JR   ta1   
                    TA2:      LD   A,L   
                              CP   C   
                              RET   Z   
                              ;*Macro unroll:  PUTK    08h             ; backspace
                              DS   1-CPM,3Eh   ; backspace
                              DS   1-CPM,08h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,08h   
                              DEC   L   
                              JR   ta2   
                                 ; ekey: wait for a key
                    EKEY:     CALL   rawk   
                              JR   Z,ekey   
                              RET      
                                 ; The command keys, and where each goes (after fin).
                    CMDS:     DB   13   
                              DW   cret   
                              DB   7   ; ^G
                              DW   crun   
                              DB   12   ; ^L
                              DW   clist   
                              DB   5   ; ^E
                              DW   cedln   
                              DB   18   ; ^R
                              DW   cread   
                              DB   23   ; ^W
                              DW   cwrite   
                              DB   14   ; ^N
                              DW   cnew   
                              DB   24   ; ^X
                              DW   LEAVE   
                    NCMD:     EQU   8   
                                 ; ^N: no program
                    CNEW:     XOR   A   
                              LD   (PROG),A   
                    GED0:     JR   gedit   
                                 ; ^E: line n goes into the input line, to be changed. EDLN remembers which
                                 ; line it was: Return puts the text back in its place.
                    CEDLN:    CALL   rdnum   
                              PUSH   HL   
                              CALL   find   ; HL -> the line, or the NUL if there is none
                              POP   DE   
                              LD   A,(HL)   
                              OR   A   
                              JR   Z,ged0   
                              LD   (EDLN),DE   
                              LD   DE,LINEBUF   
                    CE1:      LD   A,(HL)   ; copy it, and show it, up to its CR (or LF)
                              CP   13   
                              JR   Z,ce2   
                              CP   10   
                              JR   Z,ce2   
                              LD   (DE),A   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              INC   HL   
                              INC   E   
                              LD   A,E   
                              CP   0FDh   ; (a longer line is cut at 125 characters)
                              JR   NZ,ce1   
                    CE2:      EX   DE,HL   ; the cursor is at the line's end
                              LD   E,L   
                              JP   ed1   
                                 ; Return. If ^E put a line here, the text goes back in its place. If not:
                                 ; a number and text is a line to put in, a number alone a line to take out,
                                 ; and anything else is run where it is.
                    CRET:     PUSH   HL   ; the end of what was typed
                              LD   HL,(EDLN)   
                              LD   A,H   
                              OR   L   
                              JR   Z,cr1   
                              PUSH   HL   
                              CALL   delln   
                              POP   HL   
                              JR   ins   
                    CR1:      CALL   rdnum   ; HL = the number it starts with, BC -> after
                              LD   A,C   ; C is still 80h if there was no number:
                              ADD   A,A   ;   only then is twice it 0
                              JR   Z,st0p   ; no number: run the line
                              LD   A,(BC)   
                              CP   13   
                              JR   NZ,cr2   
                              POP   DE   ; the number alone: take that line out
                              CALL   delln   
                              JR   gedit   
                    CR2:      INC   BC   ; step over the one character after the number
                                 ; Put the text at BC in as line n (in HL): open a gap of its length there,
                                 ; CR and LF included, and copy it in.
                    INS:      CALL   find   ; HL -> where it goes
                              POP   DE   ; the end of what was typed
                              LD   A,E   
                              SUB   C   ; A = the length of the text, with its CR LF
                              PUSH   BC   ; the text
                              LD   C,A   
                              LD   B,0   
                              PUSH   BC   ; its length
                              LD   D,H   
                              LD   E,L   ; DE = where it goes
                              XOR   A   
                              LD   C,A   ; BC = 0: CPIR looks as far as it needs to
                              CPIR      ; HL -> one past the program's NUL
                              SBC   HL,DE   ; the number of bytes to move up, NUL included
                              LD   B,H   
                              LD   C,L   
                              ADD   HL,DE   
                              DEC   HL   ; HL -> the NUL
                              EX   DE,HL   
                              EX   (SP),HL   ; HL = the length; where it goes is kept
                              PUSH   HL   
                              ADD   HL,DE   ; the NUL's new place
                              EX   DE,HL   
                              LDDR      ; move the rest of the program up
                              POP   BC   ; the length
                              POP   DE   ; where it goes
                              POP   HL   ; the text
                              LDIR      
                    GEDIT:    JP   edit   
                                 ; ^G: run the program. st0p: run the typed line (BC -> it).
                    CRUN:     LD   BC,PROG   
                              DB   3Eh   ; (LD A,n: steps over the POP)
                    ST0P:     POP   HL   ; (the end of what was typed)
                                 ; st0: start running at BC. The heap starts after the stored program's NUL.
                    ST0:      LD   HL,PROG   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
                              LD   (HEAP),HL   
052F                          ENDIF      
052F                          IF   EDITOR*QK   
                              CALL   skclr   ; every run starts with an empty skip cache
052F                          ENDIF      
052F                          IF   EDITOR*CHECKED   
                              ;*Macro unroll:  NEGH                    ; minus the heap's first address: '_' may not
                              DS   1-CPM,0E7h   ; minus the heap"s first address: "_' may not
                              DS   CPM,0CDh   
                              DS   CPM,ANEG&0FFh   
                              DS   CPM,ANEG/256   
                              LD   (NPEND),HL   ;   release below it
052F                          ENDIF      
052F                          IF   EDITOR   
                              POP   HL   ; TOS: the data stack is as the last line left it
                              ;*Macro unroll:  NEXT                    ; (its return address is thrown away)
                              DS   (1-CPM)*(1-FAST),0F7h   ; (its return address is thrown away)
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
                                 ; ^L: list from line n. DE = the number of the line at HL.
                    CLIST:    CALL   rdnum   ; HL = n, or 0 if there was none:
                              LD   A,H   
                              OR   L   
                              JR   NZ,li0   
                              INC   L   ;   then from line 1
                    LI0:      PUSH   HL   
                              CALL   find   
                              POP   DE   
                    LI1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,gedit   ; the end of the text
                              CALL   rawk   
                              JR   Z,li3   ; no key: carry on
                              CP   3   
                              CALL   NZ,ekey   ; any key but Ctrl-C: wait for one more
                              CP   3   
                              JR   Z,gedit   ; Ctrl-C, first or second, ends the list
                    LI3:      PUSH   HL   
                              PUSH   DE   
                              EX   DE,HL   
                              CALL   pdec   ; the line's number,
                              LD   A," "   
                              ;*Macro unroll:  PUTA                    ;   a space,
                              DS   1-CPM,0EFh   ;   a space,
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              POP   DE   
                              POP   HL   
                              INC   DE   
                              CALL   prl   ;   and the line
                              JR   li1   
                                 ; delln: take line n (in HL) out: copy everything after it down over it.
                    DELLN:    CALL   find   
                              LD   D,H   
                              LD   E,L   
                              CALL   nxl   ; HL -> the next line
                    DE1:      LD   A,(HL)   
                              LD   (DE),A   
                              INC   HL   
                              INC   DE   
                              OR   A   
                              JR   NZ,de1   
                              RET      
                                 ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
                                 ; of the text if there are fewer lines (or the number is 0). Keeps BC.
                    FIND:     EX   DE,HL   
                              LD   HL,PROG   
                    FI1:      DEC   DE   
                              LD   A,D   
                              OR   E   
                              RET   Z   
                              CALL   nxl   
                              JR   NZ,fi1   
                              RET      
                                 ; nxl: step HL over one line, to just past its LF (and return not-zero), or
                                 ; stop at the NUL that ends the text (and return zero).
                    NXL:      LD   A,(HL)   
                              OR   A   
                              RET   Z   
                              INC   HL   
                              CP   10   
                              JR   NZ,nxl   
                              OR   A   
                              RET      
                                 ; prl: print the line at HL, to its LF; HL -> just past it.
                    PRL:      LD   A,(HL)   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              LD   A,(HL)   
                              INC   HL   
                              CP   10   
                              JR   NZ,prl   
                              RET      
052F                          ENDIF      
052F                          IF   EDGEN   
                    GED1:     JP   edit   
                                 ; ^R, generic: what comes in from now until ^Z is the program. A CR is
                                 ; stored as CR LF; a LF right after a line end is dropped (it is the CR's
                                 ; own, or an empty line's), and a LF anywhere else ends a line too. A last
                                 ; line with no end is given one. Nothing is echoed, and there is no check
                                 ; for running out of memory.
                    CREAD:    LD   HL,PROG-1   
                              LD   (HL),10   ; (as if a line had just ended: the byte is
                              INC   HL   ;   the line buffer's last, and spare)
                    RD1:      CALL   ekey   
                              LD   C,A   
                              CP   1Ah   
                              JR   NZ,rd2   
                              LD   A,10   ; ^Z ends the last line, as a LF would
                    RD2:      CP   10   
                              JR   NZ,rd3   
                              DEC   HL   
                              CP   (HL)   
                              INC   HL   
                              JR   Z,rd4   ; straight after a line end: dropped
                              LD   A,13   ; anywhere else it ends the line
                    RD3:      LD   (HL),A   
                              INC   HL   
                              CP   13   
                              JR   NZ,rd4   
                              LD   (HL),10   ; after a CR goes a LF
                              INC   HL   
                    RD4:      LD   A,C   
                              CP   1Ah   
                              JR   NZ,rd1   
                              LD   (HL),0   
                              JR   ged1   
                                 ; ^W, generic: the text is printed as it is, for the terminal to capture.
                    CWRITE:   LD   HL,PROG   
                    CW1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,ged1   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              INC   HL   
                              JR   cw1   
052F                          ENDIF      
052F                          IF   EDITOR*CPM   
                    CFCB:     EQU   005Ch   ; the file's name is kept here, where the CCP
                                 ;   put the one from the command line
                                 ; ^W, CP/M: write the file: delete the old one, make it anew, write the
                                 ; text in records of 128 bytes, and close it. The text's NUL and the 127
                                 ; bytes after it are set to ^Z meanwhile, which pads the last record. (A
                                 ; full disk or directory is not noticed: the calls fail and that is all.)
                    CWRITE:   CALL   setname   
                              LD   C,19   ; delete
                              CALL   fbdos   
                              LD   C,22   ; make
                              CALL   fbdos   
                              LD   HL,PROG   
                              XOR   A   
                    CW1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,cw1   
                              DEC   HL   ; HL -> the NUL
                              PUSH   HL   
                              LD   B,128   
                    CW2:      LD   (HL),1Ah   
                              INC   HL   
                              DJNZ   cw2   
                              POP   HL   
                              LD   DE,PROG   
                    CW3:      LD   A,E   ; a record that starts before the end is written
                              SUB   L   
                              LD   A,D   
                              SBC   A,H   
                              JR   NC,cw4   
                              PUSH   HL   
                              LD   C,21   ; write, from where the record lies
                              CALL   frec   
                              POP   HL   
                              JR   cw3   
                    CW4:      LD   (HL),0   ; the NUL again
                              LD   C,16   ; close
                              CALL   fbdos   
                              JP   edit   
                                 ; frec: BDOS function C (read or write a record) with the 128 bytes at DE.
                                 ; Returns A = the BDOS's answer, HL = DE and DE = DE + 128.
                    FREC:     PUSH   DE   
                              PUSH   BC   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              POP   BC   
                              CALL   fbdos   
                              POP   DE   
                              LD   HL,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              RET      
                                 ; setname: if a name was typed (the line does not start with its CR), put it
                                 ; in the FCB: up to 8 characters, a dot, up to 3 more, in capitals. The drive
                                 ; is the current one. Then, name or no name, clear the FCB after the name,
                                 ; as it must be before a file is opened or made.
                    SETNAME:   LD   DE,LINEBUF   
                              LD   A,(DE)   
                              CP   13   
                              JR   Z,fcbclr   
                              LD   HL,CFCB   
                              LD   (HL),0   ; the current drive
                              LD   B,11   
                    SN1:      INC   L   
                              LD   (HL)," "   
                              DJNZ   sn1   
                              LD   L,CFCB+1   
                    SN2:      LD   A,(DE)   
                              INC   DE   
                              CP   13   
                              JR   Z,fcbclr   
                              CP   "."   
                              JR   NZ,sn3   
                              LD   L,CFCB+9   ; the type
                              JR   sn2   
                    SN3:      CP   "a"   
                              JR   C,sn4   
                              AND   5Fh   ; a capital
                    SN4:      LD   (HL),A   
                              INC   L   
                              JR   sn2   
                    FCBCLR:   LD   HL,CFCB+12   
                              LD   B,24   
                    FC1:      LD   (HL),0   
                              INC   HL   
                              DJNZ   fc1   
                              RET      
                                 ; fbdos: BDOS function C on the file
                    FBDOS:    LD   DE,CFCB   
                              JP   BDOS   
                                 ; ^R, CP/M: read the file. A name typed before the key is the file's name
                                 ; from now on. (On into load, which returns to edit.)
                    CREAD:    CALL   setname   
                              LD   HL,edit   
                              PUSH   HL   
                                 ; load: read the file into PROG. No such file: no program. The text ends at
                                 ; the file"s first ^Z (1Ah), which pads a text file"s last record; one more
                                 ; goes after the last record, so the search always stops. And every line
                                 ; must end in LF: a last line without one is given a CR LF. (The FCB is
                                 ; clear after its name: the CCP left it so, or setname did.)
                    LOAD:     LD   C,15   ; open (no such file: the first read fails
                              CALL   fbdos   ;   too)
                              LD   DE,PROG   
                    LD1:      LD   C,20   ; read the next 128 bytes
                              CALL   frec   
                              OR   A   
                              JR   Z,ld1   
                              LD   (HL),1Ah   ; (HL = where the record that failed would be)
                              LD   HL,PROG-1   
                              LD   A,10   ; (a file with no text needs nothing added)
                    TR1:      INC   HL   
                              LD   E,A   ; E = the character before this one
                              LD   A,(HL)   
                              CP   1Ah   
                              JR   NZ,tr1   
                              LD   A,E   
                              CP   10   
                              JR   Z,tr2   
                              LD   (HL),13   
                              INC   HL   
                              LD   (HL),10   
                              INC   HL   
                    TR2:      LD   (HL),0   
                              RET      
052F                          ENDIF      
052F                             ; =============================================================================
052F                          IF   CPM   
                                 ; The RAM pages follow the image; the heap may grow to the BDOS.
                    START:       
052F                          ENDIF      
052F                          IF   CPM*CHECKED*(1-EDITOR)   
                                 ; Clear the lower half of the letter page (as the editor build does
                                 ; at its start).
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
052F                          ENDIF      
052F                          IF   CPM*(1-EDITOR)   
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:      LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
052F                          ENDIF      
052F                          IF   CPM*(1-EDITOR)*QK   
                              CALL   skclr   ; an empty skip cache
052F                          ENDIF      
052F                          IF   CPM*(1-EDITOR)   
                              JP   st2   
052F                          ENDIF      
052F                          IF   FAST   
052F                             ; =============================================================================
052F                             ;  The fast build (SPEED = 2)
052F                             ; 
052F                             ;  The inner loop is a table: 256 entries, the low bytes of the handlers'
052F                             ;  addresses in one page and the high bytes in the next. The dispatcher (at
052F                             ;  next0, and inline, as NEXTF, at the end of the fast build's own entries,
052F                             ;  so there is no jump back to it; the ordinary handlers end in JP (IX), with
052F                             ;  IX = next0, as in the CP/M builds):
052F                             ; 
052F                             ;      LD A,(BC) / INC BC / EX DE,HL / LD L,A / LD H,DTAB/256 /
052F                             ;      LD A,(HL) / INC H / LD H,(HL) / LD L,A / JP (HL)
052F                             ; 
052F                             ;  So every entry starts with TOS in DE, not HL. The punctuation entries are
052F                             ;  thunks into the ordinary handlers (EX DE,HL / JP handler); the letters and
052F                             ;  digits have one entry each, which knows its cell or its value already.
052F                             ; =============================================================================
052F   EB           FTSTORE:   EX   DE,HL   ; !
0530   C3 7D 01               JP   h_store   
0533   EB           FTSTR:    EX   DE,HL   ; "
0534   C3 84 01               JP   h_str   
0537   EB           FTNUM:    EX   DE,HL   ; #
0538   C3 AA 01               JP   h_num   
053B   EB           FTPRINT:   EX   DE,HL   ; $
053C   C3 8C 01               JP   h_print   
053F   EB           FTSWAP:   EX   DE,HL   ; %
0540   C3 75 01               JP   h_swap   
0543   EB           FTAND:    EX   DE,HL   ; &
0544   C3 2B 01               JP   h_and   
0547   EB           FTEMIT:   EX   DE,HL   ; '
0548   C3 A5 01               JP   h_emit   
054B   EB           FTOPEN:   EX   DE,HL   ; (
054C   C3 08 01               JP   h_open   
054F   EB           FTCLOSE:   EX   DE,HL   ; )
0550   C3 10 01               JP   h_close   
0553   EB           FTMUL:    EX   DE,HL   ; *
0554   C3 4E 01               JP   h_mul   
0557   EB           FTADD:    EX   DE,HL   ; +
0558   C3 20 01               JP   h_add   
055B   EB           FTCFETCH:   EX   DE,HL   ; ,
055C   C3 C8 01               JP   h_cfetch   
055F   EB           FTSUB:    EX   DE,HL   ; -
0560   C3 18 01               JP   h_sub   
0563   EB           FTCSTORE:   EX   DE,HL   ; .
0564   C3 78 01               JP   h_cstore   
0567   EB           FTDIV:    EX   DE,HL   ; /
0568   C3 52 01               JP   h_div   
056B   EB           FTDUP:    EX   DE,HL   ; :
056C   C3 72 01               JP   h_dup   
056F   EB           FTDROP:   EX   DE,HL   ; ;
0570   C3 7A 01               JP   h_drop   
0573   EB           FTLT:     EX   DE,HL   ; <
0574   C3 34 01               JP   h_lt   
0577   EB           FTEQ:     EX   DE,HL   ; =
0578   C3 44 01               JP   h_eq   
057B   EB           FTGT:     EX   DE,HL   ; >
057C   C3 35 01               JP   h_gt   
057F   EB           FTKEY:    EX   DE,HL   ; ?
0580   C3 B0 01               JP   h_key   
0583   EB           FTFETCH:   EX   DE,HL   ; @
0584   C3 02 01               JP   h_fetch   
0587   EB           FTDEF:    EX   DE,HL   ; [
0588   C3 E4 00               JP   h_def   
058B   EB           FTBREAK:   EX   DE,HL   ; \
058C   C3 D6 00               JP   h_break   
058F   EB           FTRET:    EX   DE,HL   ; ]
0590   C3 D1 00               JP   h_ret   
0593   EB           FTXOR:    EX   DE,HL   ; ^
0594   C3 55 00               JP   h_xor   
0597   EB           FTALLOC:   EX   DE,HL   ; _
0598   C3 6B 00               JP   h_alloc   
059B   EB           FTGRAVE:   EX   DE,HL   ; `
059C   C3 BA 00               JP   h_grave   
059F   EB           FTTOR:    EX   DE,HL   ; {
05A0   C3 B6 00               JP   h_tor   
05A3   EB           FTOR:     EX   DE,HL   ; |
05A4   C3 5E 00               JP   h_or   
05A7   EB           FTFROMR:   EX   DE,HL   ; }
05A8   C3 1C 00               JP   h_fromr   
05AB   EB           FTNOT:    EX   DE,HL   ; ~
05AC   C3 67 00               JP   h_not   
05AF                             ; The commonest punctuation, written for the fast build: TOS in DE on the
05AF                             ; way in, and the dispatcher inline on the way out.
05AF                FS_ADD:      ; +
05AF   E1                     POP   HL   
05B0   19                     ADD   HL,DE   
05B1                          ;*Macro unroll:  NEXTF
05B1                          DS   FAST*CHECKED,0CDh   
05B1                          DS   FAST*CHECKED,ACHK&0FFh   
05B1                          DS   FAST*CHECKED,ACHK/256   
05B1   0A                     DS   FAST,0Ah   
05B2   03                     DS   FAST,03h   
05B3   EB                     DS   FAST,0EBh   
05B4   6F                     DS   FAST,6Fh   
05B5   26                     DS   FAST,26h   
05B6   0F                     DS   FAST,DTPG   
05B7   7E                     DS   FAST,7Eh   
05B8   24                     DS   FAST,24h   
05B9   66                     DS   FAST,66h   
05BA   6F                     DS   FAST,6Fh   
05BB   E9                     DS   FAST,0E9h   
05BC                FS_SUB:      ; -
05BC   0A                     LD   A,(BC)   ; a digit next: a negative number
05BD   D6 30                  SUB   "0"   
05BF   FE 0A                  CP   10   
05C1   38 0F                  JR   C,fs_neg   
05C3   E1                     POP   HL   
05C4   B7                     OR   A   
05C5   ED 52                  SBC   HL,DE   
05C7                          ;*Macro unroll:  NEXTF
05C7                          DS   FAST*CHECKED,0CDh   
05C7                          DS   FAST*CHECKED,ACHK&0FFh   
05C7                          DS   FAST*CHECKED,ACHK/256   
05C7   0A                     DS   FAST,0Ah   
05C8   03                     DS   FAST,03h   
05C9   EB                     DS   FAST,0EBh   
05CA   6F                     DS   FAST,6Fh   
05CB   26                     DS   FAST,26h   
05CC   0F                     DS   FAST,DTPG   
05CD   7E                     DS   FAST,7Eh   
05CE   24                     DS   FAST,24h   
05CF   66                     DS   FAST,66h   
05D0   6F                     DS   FAST,6Fh   
05D1   E9                     DS   FAST,0E9h   
05D2   EB           FS_NEG:   EX   DE,HL   
05D3   C3 18 01               JP   h_sub   
05D6                FS_DUP:      ; :
05D6   D5                     PUSH   DE   
05D7   EB                     EX   DE,HL   
05D8                          ;*Macro unroll:  NEXTF
05D8                          DS   FAST*CHECKED,0CDh   
05D8                          DS   FAST*CHECKED,ACHK&0FFh   
05D8                          DS   FAST*CHECKED,ACHK/256   
05D8   0A                     DS   FAST,0Ah   
05D9   03                     DS   FAST,03h   
05DA   EB                     DS   FAST,0EBh   
05DB   6F                     DS   FAST,6Fh   
05DC   26                     DS   FAST,26h   
05DD   0F                     DS   FAST,DTPG   
05DE   7E                     DS   FAST,7Eh   
05DF   24                     DS   FAST,24h   
05E0   66                     DS   FAST,66h   
05E1   6F                     DS   FAST,6Fh   
05E2   E9                     DS   FAST,0E9h   
05E3                FS_DROP:      ; ;
05E3   E1                     POP   HL   
05E4                          ;*Macro unroll:  NEXTF
05E4                          DS   FAST*CHECKED,0CDh   
05E4                          DS   FAST*CHECKED,ACHK&0FFh   
05E4                          DS   FAST*CHECKED,ACHK/256   
05E4   0A                     DS   FAST,0Ah   
05E5   03                     DS   FAST,03h   
05E6   EB                     DS   FAST,0EBh   
05E7   6F                     DS   FAST,6Fh   
05E8   26                     DS   FAST,26h   
05E9   0F                     DS   FAST,DTPG   
05EA   7E                     DS   FAST,7Eh   
05EB   24                     DS   FAST,24h   
05EC   66                     DS   FAST,66h   
05ED   6F                     DS   FAST,6Fh   
05EE   E9                     DS   FAST,0E9h   
05EF                FS_SWAP:      ; %
05EF   E1                     POP   HL   
05F0   D5                     PUSH   DE   
05F1                          ;*Macro unroll:  NEXTF
05F1                          DS   FAST*CHECKED,0CDh   
05F1                          DS   FAST*CHECKED,ACHK&0FFh   
05F1                          DS   FAST*CHECKED,ACHK/256   
05F1   0A                     DS   FAST,0Ah   
05F2   03                     DS   FAST,03h   
05F3   EB                     DS   FAST,0EBh   
05F4   6F                     DS   FAST,6Fh   
05F5   26                     DS   FAST,26h   
05F6   0F                     DS   FAST,DTPG   
05F7   7E                     DS   FAST,7Eh   
05F8   24                     DS   FAST,24h   
05F9   66                     DS   FAST,66h   
05FA   6F                     DS   FAST,6Fh   
05FB   E9                     DS   FAST,0E9h   
05FC                FS_FET:      ; @
05FC   EB                     EX   DE,HL   
05FD   5E                     LD   E,(HL)   
05FE   23                     INC   HL   
05FF   56                     LD   D,(HL)   
0600   EB                     EX   DE,HL   
0601                          ;*Macro unroll:  NEXTF
0601                          DS   FAST*CHECKED,0CDh   
0601                          DS   FAST*CHECKED,ACHK&0FFh   
0601                          DS   FAST*CHECKED,ACHK/256   
0601   0A                     DS   FAST,0Ah   
0602   03                     DS   FAST,03h   
