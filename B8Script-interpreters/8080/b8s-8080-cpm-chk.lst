06E4                             ;  Startup
06E4                             ; =============================================================================
06E4                START:       
06E4                          IF   (1-CPM)*CHECKED   
                              LXI   SP,DSTOP   
06E4                          ENDIF      
06E4                          IF   CHECKED   
06E4                             ; Clear the lower half of the letter page: every variable starts at
06E4                             ; 0, every word cell holds 0000h, the address an undefined word is
06E4                             ; caught at (see e_hi), and no key is held back.
06E4   21 00 0A               LXI   H,LET   
06E7   AF                     XRA   A   
06E8   77           INI1:     MOV   M,A   
06E9   2C                     INR   L   
06EA   F2 E8 06               JP   ini1   ; +00h to +7Fh
06ED                          ENDIF      
06ED                          IF   CPM   
06ED                             ; CP/M: the RAM pages follow the image; the heap may grow to the BDOS
06ED   21 08 01               LXI   H,vecs   ; the RST routines go down into page zero
06F0   11 08 00               LXI   D,0008h   
06F3   06 2C                  MVI   B,vecend-vecs   
06F5   7E           CPY:      MOV   A,M   
06F6   12                     STAX   D   
06F7   23                     INX   H   
06F8   13                     INX   D   
06F9   05                     DCR   B   
