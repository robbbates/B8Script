E4A6   A4 01                  LDY   IP+1   
E4A8   D0 03                  BNE   pushay   ; always: no program is in page zero
E4AA                             ; a-z: push the cell's address (the cell is the variable)
E4AA   0A           LOWER:    ASL      
E4AB   A0 04                  LDY   #>LET   
E4AD                             ; pushay: push a cell: A = its low byte, Y = its high byte
E4AD   CA           PUSHAY:   DEX      
E4AE   CA                     DEX      
E4AF   95 00        SETAY:    STA   0,X   ; setay: TOS = A (low), Y (high)
E4B1   94 01                  STY   1,X   
