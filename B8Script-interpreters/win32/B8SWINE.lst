   785 00000256 C02304              <1>         shl     byte [ebx],4            ;   overwrites it
   786 00000259 0803                <1>         or      [ebx],al                ; ... and the low one joins it
   787 0000025B 43                  <1>         inc     ebx
   788                              <1>         CALLP   hexc
