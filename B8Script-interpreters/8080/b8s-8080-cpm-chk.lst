02E4                             ; =============================================================================
02E4   5E           H_FETCH:   MOV   E,M   ; "@"
02E5   23                     INX   H   
02E6   56                     MOV   D,M   
02E7   EB                     XCHG      
02E8   D7                     RST   2   
02E9   D1           H_STORE:   POP   D   ; "!" ( n addr -- )
02EA                          IF   CHECKED   
02EA   23                     INX   H   ; both bytes must be in the program's space
02EB   CD 13 03               CALL   chkst   
02EE   2B                     DCX   H   
02EF                          ENDIF      
02EF   73                     MOV   M,E   
02F0   23                     INX   H   
02F1   72                     MOV   M,D   
02F2   CF                     RST   1   
02F3   6E           H_CFETCH:   MOV   L,M   ; ","
02F4   26 00                  MVI   H,0   
02F6   D7                     RST   2   
02F7   D1           H_CSTORE:   POP   D   ; "." ( c addr -- )
