0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Spec: docs/b8script.md (2026-11-21).
0000                             ; 
0000                             ;  Three switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    EDITOR   1 = with a small line editor built in (see the end of this
0000                             ;                 file). It goes with either setting of the other two.
0000                             ;    CHECKED  0 = no checks (spec: the programmer is responsible)
0000                             ;             1 = starts with every variable at 0 and every word undefined,
0000                             ;                 and stops on every error in the spec's table (and Ctrl-C)
0000                             ;                 with a four-line report: the letter and the place as line
0000                             ;                 and column, the text there, and both stacks. See `error`.
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   1   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   1   ; 1 = checked build
0000                EDITOR:   EQU   0   ; 1 = with the line editor
0000                EDGEN:    EQU   EDITOR*(1-CPM)   ; (the generic build with the editor)
0000                TABP0:    EQU   EDGEN*(1-CHECKED)   ; (the build with its table in page zero)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    HL'  return-stack pointer (the alternate HL). Entries are 2 bytes; the
0000                             ;         stack grows down. Only rpop and rpushn (and the checks) touch it.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  One-byte calls. The routines used most are reached with RST, one byte
0000                             ;  instead of three:
0000                             ; 
0000                             ;    RST 08h  rpop    pop the return stack into DE
0000                             ;    RST 18h  drop    drop TOS, then next character     (ends a handler)
0000                             ;    RST 20h  neg16   HL = -HL
0000                             ;    RST 28h  putc    print A
0000                             ;    RST 30h  next    next character                    (ends a handler)
0000                             ; 
0000                             ;  RST 18h and RST 30h never return: an RST is a CALL, so the first thing
0000                             ;  each of them does is POP DE to throw the return address away.
0000                             ; 
0000                             ;  The CP/M build can't own page zero, so the block from `vecs` to `vecend`
0000                             ;  (image addresses 0108h-0133h) is copied to 0008h-0033h when it starts. The
0000                             ;  code in that block is written to work at either place.
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (the top four bytes of the page are spare,
0000                             ;             so a full stack runs two bytes into the page below)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch, interpreter variables in the gaps, and the -n? line buffer
0000                             ;             at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack has a guard band: the data stack can
0000                             ;  overrun by a cell or two (and the calls made while it is full, the error
0000                             ;  report's included) into the top 32 bytes of the return-stack page, which
0000                             ;  are never used, and the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
0000                BDOS:     EQU   0005h   
0000                BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IF   CPM*(1-EDITOR)   
0000                EXIT:     EQU   0000h   ; warm boot
0000                          ENDIF      
0000                          IFN   CPM   
                                 ; ---- generic machine: edit these to suit -----------------------------------
                    KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
                                 ;   waiting. The zero flag must match A
                                 ;   (end the routine with OR A / RET).
                    CONOUT:   EQU   0FF03h   ; print the character in A
                                 ;   KEY and CONOUT must preserve BC, DE, HL and HL'.
                    RSPAGE:   EQU   80h   ; 8000h return stack
                    DSPAGE:   EQU   81h   ; 8100h data stack
                    LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
                    PROG:     EQU   8300h   ; where the loader puts the program text
                    HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
                    BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)   
                    EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                          ENDIF      
0000                          IF   EDITOR   
                    EXIT:     EQU   edit   ; a program that ends goes back to the editor
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                KEYBUF:   EQU   LET+36h   ;   around machine code; a held-back key;
0000                NPEND:    EQU   LET+38h   ;   minus the address of the program's end
0000                             ;   (the heap"s first byte), for the checked "_'
0000                LBHDR:    EQU   LET+7Eh   ; CP/M BDOS 10 header: max, count
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FCh   ; empty data stack. The four bytes above it
0000                             ; are spare: a character can pop two cells
0000                             ; too many before the checked build sees it,
0000                             ; and the next call must not land on the
0000                             ; letter cells.
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is the start of the .COM file, and 0108h-0133h is also copied to
0000                             ;  page zero (see the header).
0000                             ; =============================================================================
0100                          .ORG   BASE   
0100                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              XOR   A   ; 00  reset. (This byte, AFh, is also what an
0100                          ENDIF      ;     undefined word runs into: see e_hi.)
0100                          IF   1-EDGEN   
0100   31 FC 07               LD   SP,DSTOP   ; 00  reset, or the start of the .COM file
0103                          ENDIF      
0103                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)   
                              LD   BC,PROG   ; 03  the IP
                              JR   st0   ; 06  (the rest of the startup is close by)
0103                          ENDIF      
0103                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              JR   init   ; 04  (the rest of the startup is close by)
                              DW   0   ; 06  spare
0103                          ENDIF      
0103                          IF   EDGEN   
                              XOR   A   ; 00  reset: no program yet
                              LD   (PROG),A   
0103                          ENDIF      
0103                          IF   EDGEN*(1-CHECKED)   
                              JP   edit   ; 04
0103                          ENDIF      
0103                          IF   EDGEN*CHECKED   
                              JP   init   ; 04  (and no key held back)
0103                          ENDIF      
0103                          IF   EDGEN   
                              NOP      ; 07  spare
0103                          ENDIF      
0103                          IF   CPM   
0103   C3 78 05               JP   start   ; 03
0106   00 00                  DW   0   ; 06  spare
0108                          ENDIF      
0108                VECS:        
0108                             ; ---- RST 08h: rpop: pop the return stack into DE ---------------------------
0108   D9           RPOP:     EXX      ; 08
0109   5E                     LD   E,(HL)   
010A   23                     INC   HL   
010B   56                     LD   D,(HL)   
010C   23                     INC   HL   
010D   D5                     PUSH   DE   ; across to the main registers
010E   D9                     EXX      
010F   D1                     POP   DE   
0110   C9                     RET      ; 10  (so RST 10h is not used)
0111                             ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
0111   C6 21        CTL:      ADD   A,21h   ; 11  back to c; zero only for NUL
0113   20 1F                  JR   NZ,next0   ;     the rest are ignored
0115   C3 00 00     ENDPROG:   JP   EXIT   ;     the program has ended
0118                             ; ---- RST 18h: drop TOS, then next ------------------------------------------
0118   D1           RST18:    POP   DE   ; 18  discard the RST's return address
0119   E1                     POP   HL   ;     new TOS = NOS
011A   18 15                  JR   nx   
011C   E5           H_FROMR:   PUSH   HL   ; 1C  "}" return stack to TOS
011D   CF                     RST   08h   
011E   EB                     EX   DE,HL   
011F   F7                     RST   30h   
0120                             ; ---- RST 20h: neg16: HL = -HL (keeps BC, DE) -------------------------------
0120   AF           NEG16:    XOR   A   ; 20
0121   95                     SUB   L   
0122   6F                     LD   L,A   
0123   9F                     SBC   A,A   
0124   94                     SUB   H   
0125   67                     LD   H,A   
0126   C9                     RET      
0127   00                     NOP      ; 27  spare
0128                             ; ---- RST 28h: putc: print A (keeps BC, DE, HL, HL') ------------------------
0128                RST28:       
0128                          IFN   CPM   
                    PUTC:     JP   CONOUT   ; 28
0128                          ENDIF      
0128                          IF   CPM   
0128   C3 ED 03               JP   putc   ; 28
012B                          ENDIF      
012B   E9           JPHL:     JP   (HL)   ; 2B  (for the machine-code call)
012C   E3           H_TOR:    EX   (SP),HL   ; 2C  "{" TOS to the return stack: the new TOS
012D   C3 C9 01               JP   rpushn   ;     comes up, the old one goes across
0130                             ; ---- RST 30h: next character -----------------------------------------------
0130   D1           RST30:    POP   DE   ; 30  discard the RST's return address
0131                NX:          
0131                          IF   CPM   
0131   C3 34 01               JP   next0   ; (this copy runs in page zero)
0134                          ENDIF      
0134                VECEND:      
0134                             ; =============================================================================
0134                             ;  The inner loop: read one character and sort it by range.
0134                             ; 
0134                             ;    00h          end of program
0134                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0134                             ;    30h-39h      digit: read a whole number
0134                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0134                             ;    61h-7Ah      a-z: push the address of that letter's cell
0134                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0134                             ; =============================================================================
0134                NEXT0:       
0134                          IF   CHECKED   
0134   CD 59 04               CALL   chkstk   ; both stacks are checked once per character
0137                          ENDIF      
0137   0A                     LD   A,(BC)   
0138   03                     INC   BC   
0139   D6 21                  SUB   21h   ; A = c - 21h
013B   38 D4                  JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
013D   FE 0F                  CP   0Fh   
013F   38 25                  JR   C,punct   ; 21h-2Fh: PTAB index 0-14
0141   D6 0F                  SUB   0Fh   ; A = c - 30h
0143   FE 0A                  CP   0Ah   
0145   38 6C                  JR   C,digit   ; 30h-39h
0147   FE 11                  CP   11h   
0149   38 19                  JR   C,p3a   ; 3Ah-40h
014B   D6 11                  SUB   11h   ; A = c - 41h
014D   FE 1A                  CP   1Ah   
014F   38 6E                  JR   C,upper   ; 41h-5Ah: A = letter index 0-25
0151   FE 20                  CP   20h   
0153   38 0D                  JR   C,p5b   ; 5Bh-60h
0155   FE 3A                  CP   3Ah   
0157   38 60                  JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0159   FE 3E                  CP   3Eh   
015B                          IF   1-CHECKED   
                              JR   NC,next0   ; 7Fh-FFh: ignored
015B                          ENDIF      
015B                          IF   CHECKED   
015B   28 D7                  JR   Z,next0   ; 7Fh, DEL: ignored
015D   D2 92 04               JP   NC,e_hi   ; 80h-FFh: reserved
0160                          ENDIF      
0160   D6 1A                  SUB   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
0162   D6 09        P5B:      SUB   9   ; 5Bh-60h: -4 in all, index 22-27
0164   C6 05        P3A:      ADD   A,5   ; 3Ah-40h: index 15-21
0166                .macro PTABLE,
0166                             ; 
0166                 DB      h_store & 0FFh  ; !
0166                 DB      h_str & 0FFh    ; "
0166                 DB      h_num & 0FFh    ; #
0166                 DB      h_print & 0FFh  ; $
0166                 DB      h_swap & 0FFh   ; %
0166                 DB      h_and & 0FFh    ; &
0166                 DB      h_emit & 0FFh   ; '
0166                 DB      h_open & 0FFh   ; (
0166                 DB      h_close & 0FFh  ; )
0166                 DB      h_mul & 0FFh    ; *
0166                 DB      h_add & 0FFh    ; +
0166                 DB      h_cfetch & 0FFh ; ,
0166                 DB      h_sub & 0FFh    ; -
0166                 DB      h_cstore & 0FFh ; .
0166                 DB      h_div & 0FFh    ; /
0166                 DB      h_dup & 0FFh    ; :
0166                 DB      h_drop & 0FFh   ; ;
0166                 DB      h_lt & 0FFh     ; <
0166                 DB      h_eq & 0FFh     ; =
0166                 DB      h_gt & 0FFh     ; >
0166                 DB      h_key & 0FFh    ; ?
0166                 DB      h_fetch & 0FFh  ; @
0166                 DB      h_def & 0FFh    ; [
0166                 DB      h_break & 0FFh  ; \
0166                 DB      h_ret & 0FFh    ; ]
0166                 DB      h_xor & 0FFh    ; ^
0166                 DB      h_alloc & 0FFh  ; _
0166                 DB      h_grave & 0FFh  ; `
0166                 DB      h_tor & 0FFh    ; {
0166                 DB      h_or & 0FFh     ; |
0166                 DB      h_fromr & 0FFh  ; }
0166                 DB      h_not & 0FFh    ; ~
0166                .endm
0166                 
0166                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
0166                             ; untouched, and A, DE free.
0166   C6 C1        PUNCT:    ADD   A,PTAB & 0FFh   ; PTAB never crosses a page
0168   5F                     LD   E,A   
0169   16 03                  LD   D,PTAB / 256   ; (0 if the table is in page zero)
016B   FE D7                  CP   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
016D   1A                     LD   A,(DE)   
016E   5F                     LD   E,A   ; the handler's low byte
016F                          IF   (1-CPM)*(1-TABP0)   
                              LD   D,0   
016F                          ENDIF      
016F                          IFN   CPM   
                              RL   D   ; its page: 0 + carry
016F                          ENDIF      
016F                          IF   CPM   
016F   16 01                  LD   D,1   
0171   30 01                  JR   NC,pu1   
0173   14                     INC   D   ; its page: 1 + carry
0174                PU1:         
0174                          ENDIF      
0174   D5                     PUSH   DE   ; jump to it; the stack is balanced again
0175   C9                     RET      ;   when the handler starts
0176                             ; The rest of the startup: here so that the generic reset code can reach it
0176                             ; with JR. st0: find the program's NUL; the heap starts after it.
0176                             ; (The editor build has its own copy of this, next to the editor.)
0176                             ; A checked build first clears the lower half of the letter page (A = 0):
0176                             ; every variable starts at 0, every word cell holds 0000h, the address an
0176                             ; undefined word is caught at (see e_hi), and no key is held back.
0176                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                    INIT:     LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
                              LD   BC,PROG   ; the IP
0176                          ENDIF      
0176                          IF   (1-CPM)*(1-EDITOR)   
                    ST0:      LD   H,B   
                              LD   L,C   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
0176                          ENDIF      
0176                          IF   1-EDITOR   
0176   22 7C 08     ST2:      LD   (HEAP),HL   
0179                          ENDIF      
0179                          IF   CHECKED*(1-EDITOR)   
0179   E7                     RST   20h   ; minus the heap"s first address: "_' may not
017A   22 38 08               LD   (NPEND),HL   ;   release below it
017D                          ENDIF      
017D                          IF   1-EDITOR   
017D   D9                     EXX      
017E   21 E0 06               LD   HL,RSTOP   ; the return stack is empty
0181   D9                     EXX      
0182   F7                     RST   30h   ; (its return address is thrown away)
0183                          ENDIF      
0183                             ; In the unchecked generic editor build the table is here, in the first
0183                             ; page, which saves loading D twice. (The other builds have no room for it
0183                             ; here: theirs is further down.)
0183                          IF   TABP0   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0183                          ENDIF      
0183                             ; =============================================================================
0183                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
0183                             ;  (00bbIGFuZCA= are up among the RST routines.) The machine-code call, exec,
0183                             ;  is here too: it belongs to "`" and makes the page come out right.
0183                             ; =============================================================================
0183   D1           H_XOR:    POP   DE   
0184   7C                     LD   A,H   
0185   AA                     XOR   D   
0186   67                     LD   H,A   
0187   7D                     LD   A,L   
0188   AB                     XOR   E   
0189   6F                     LD   L,A   
018A   F7                     RST   30h   
018B   D1           H_OR:     POP   DE   
018C   7C                     LD   A,H   
018D   B2                     OR   D   
018E   67                     LD   H,A   
018F   7D                     LD   A,L   
0190   B3                     OR   E   
0191   6F                     LD   L,A   
0192   F7                     RST   30h   
0193   E7           H_NOT:    RST   20h   ; ~x = -x - 1
0194   2B                     DEC   HL   
0195   F7                     RST   30h   
0196                             ; "_" ( n -- addr ): the heap pointer moves by n, a signed count (the add is
0196                             ; the same either way); TOS is the old pointer.
0196   ED 5B 7C 08  H_ALLOC:   LD   DE,(HEAP)   
019A                          IF   CHECKED*CPM   
019A   7C                     LD   A,H   ; the count's sign, for chkhp
019B                          ENDIF      
019B   19                     ADD   HL,DE   ; the new top
019C                          IF   CHECKED   
019C   CD 17 04               CALL   chkhp   
019F                          ENDIF      
019F   22 7C 08               LD   (HEAP),HL   
01A2   EB                     EX   DE,HL   
01A3   F7                     RST   30h   
01A4   D9           EXEC:     EXX      
01A5   22 34 08               LD   (RSAVE),HL   ; machine code may change the alternates
01A8   D9                     EXX      
01A9   CD 2B 01               CALL   jphl   
01AC   D9                     EXX      
01AD   2A 34 08               LD   HL,(RSAVE)   
01B0   D9                     EXX      
01B1   E1                     POP   HL   
01B2   F7                     RST   30h   
01B3                             ; ---- the letters and digits (here, in the middle, so that the inner loop's
01B3                             ; ---- short jumps reach them, and the handlers after them reach rpushn) ------
01B3                             ; Digits: step back onto the first digit and read the whole number.
01B3   E5           DIGIT:    PUSH   HL   
01B4   0B                     DEC   BC   
01B5   CD 31 03               CALL   rdnum   
01B8   F7                     RST   30h   
01B9                             ; a-z: push the cell's address (the cell is the variable)
01B9   E5           LOWER:    PUSH   HL   
01BA   87                     ADD   A,A   
01BB   6F                     LD   L,A   
01BC   26 08                  LD   H,LETPAGE   
01BE   F7                     RST   30h   
01BF                             ; A-Z: call the word. The return address (the IP after the letter) goes on
01BF                             ; the return stack, and the IP becomes the address in the letter's cell.
01BF   C5           UPPER:    PUSH   BC   ; the return address, for rpushn
01C0   EB                     EX   DE,HL   ; park TOS
01C1   87                     ADD   A,A   
01C2   6F                     LD   L,A   
01C3   26 08                  LD   H,LETPAGE   ; HL -> cell
01C5   4E                     LD   C,(HL)   
01C6   2C                     INC   L   
01C7   46                     LD   B,(HL)   ; IP = the word's body
01C8   EB                     EX   DE,HL   ; TOS back, and fall into rpushn
01C9                             ; rpushn: move the top cell of the data stack (in memory) to the return
01C9                             ; stack, then next. Everything that pushes the return stack ends here.
01C9                RPUSHN:      
01C9                          IF   CHECKED   
01C9   CD 86 04               CALL   chkbrk   ; Ctrl-C is checked at every word call, block
01CC                          ENDIF      ;   entry, loop-back and "{"
01CC   D9                     EXX      
01CD   D1                     POP   DE   
01CE   2B                     DEC   HL   
01CF   72                     LD   (HL),D   
01D0   2B                     DEC   HL   
01D1   73                     LD   (HL),E   
01D2   D9                     EXX      
01D3   F7                     RST   30h   
01D4                             ; ---- machine code: the grave -----------------------------------------------
01D4                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
01D4                             ; are stored from addr until a non-hex character; then a RET (C9h) is
01D4                             ; written and its address is left. An odd last digit is consumed and dropped.
01D4                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
01D4                             ; code is entered by CALL with the data stack above the return address; it
01D4                             ; must keep BC, and on return the top cell becomes the new TOS.
01D4   CD AF 03     H_GRAVE:   CALL   hexc   
01D7   30 CB                  JR   NC,exec   
01D9   77           HX1:      LD   (HL),A   ; the high digit goes in first ...
01DA   CD AF 03               CALL   hexc   
01DD   30 08                  JR   NC,hx2   ; odd digit: consumed, and the RET below
01DF   ED 6F                  RLD      ;   overwrites it
01E1   23                     INC   HL   ; ... and RLD shifts it up under the low one
01E2   CD AF 03               CALL   hexc   
01E5   38 F2                  JR   C,hx1   
01E7   36 C9        HX2:      LD   (HL),0C9h   ; (never range-checked: the spec says so)
01E9   F7                     RST   30h   
01EA                             ; ---- where the two pages meet ----------------------------------------------
01EA                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
01EA                             ; are in falling code order for this), and where exactly differs between the
01EA                             ; builds: NPG1 follows. Every handler below these four must start in the
01EA                             ; second page, and every one above in the first; chktab.py checks both.
01EA                             ; "]" returns: pop an address and jump to it.
01EA   CF           H_RET:    RST   08h   
01EB   42                     LD   B,D   
01EC   4B                     LD   C,E   
01ED   F7           BRK1:     RST   30h   
01EE                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
01EE                             ; drops the block start, "]" returns. No closer at all ends the program.
01EE   7C           H_BREAK:   LD   A,H   
01EF   B5                     OR   L   
01F0   E1                     POP   HL   
01F1   28 FA                  JR   Z,brk1   
01F3   CD 58 03               CALL   skip   
01F6   B7                     OR   A   ; skip returns 0 for ")"
01F7   20 F1                  JR   NZ,h_ret   
01F9   CF           RDROP:    RST   08h   
01FA   F7                     RST   30h   
01FB                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
01FB                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
01FB                             ; the body"s address instead. Either way it then skips to the matching "]'.
01FB                             ; (The unchecked build takes anything that is not a letter as the space; the
01FB                             ; checked build stops on it.)
01FB   0A           H_DEF:    LD   A,(BC)   
01FC   03                     INC   BC   
01FD   D6 41                  SUB   "A"   ; a letter gives 0-25 or 32-57: lowercase
01FF   5F                     LD   E,A   ;   lands 64 bytes up
0200   E6 DF                  AND   0DFh   ; fold case
0202   FE 1A                  CP   26   
0204   30 0B                  JR   NC,def2   ; not a letter
0206   CB 23                  SLA   E   
0208   16 08                  LD   D,LETPAGE   ; DE -> cell
020A   79                     LD   A,C   
020B   12                     LD   (DE),A   
020C   1C                     INC   E   
020D   78                     LD   A,B   
020E   12                     LD   (DE),A   
020F   18 09                  JR   skipnx   
0211                DEF2:        
0211                          IF   CHECKED   
0211   7B                     LD   A,E   
0212   FE DF                  CP   " "-"A"+256   
0214   C2 B2 04               JP   NZ,e_brack   ; anything but a letter or a space
0217                          ENDIF      
0217   E5                     PUSH   HL   ; an anonymous block: push its address
0218   60                     LD   H,B   
0219   69                     LD   L,C   
021A                SKIPNX:      
021A                          IF   CHECKED   
021A   0B                     DEC   BC   ; back onto the letter, so that skip finds its
021B                          ENDIF      ;   opener, the "[", just before where it starts
021B   CD 58 03     SKIPO:    CALL   skip   
021E   F7                     RST   30h   
021F   5E           H_FETCH:   LD   E,(HL)   ; "@"
0220   23                     INC   HL   
0221   56                     LD   D,(HL)   
0222   EB                     EX   DE,HL   
0223   F7                     RST   30h   
0224                             ; =============================================================================
0224                             ;  Handlers that must start in the image's second page.
0224                             ;  "?" is the last (with "," inside it), so its long tail may run past that
0224                             ;  page.
0224                             ; =============================================================================
0224                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
0224                             ; the matching ")".
0224   7C           H_OPEN:   LD   A,H   
0225   B5                     OR   L   
0226   E1                     POP   HL   
0227   28 F2                  JR   Z,skipo   
0229   C5                     PUSH   BC   ; the block starts at the IP
022A   18 9D                  JR   rpushn   
022C                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
022C                             ; drops it and carries on.
022C   7C           H_CLOSE:   LD   A,H   
022D   B5                     OR   L   
022E   E1                     POP   HL   
022F   28 C8                  JR   Z,rdrop   
0231   CF                     RST   08h   ; pop the block start ...
0232   42                     LD   B,D   
0233   4B                     LD   C,E   
0234   C5                     PUSH   BC   
0235   18 92                  JR   rpushn   ; ... and push it back
0237                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
0237                             ; "-" has two jobs: directly before a digit it starts a negative number.
0237   0A           H_SUB:    LD   A,(BC)   
0238   D6 30                  SUB   "0"   
023A   FE 0A                  CP   10   
023C   38 04                  JR   C,negnum   
023E   E7                     RST   20h   ; a - b = a + (-b): fall into "+"
023F   D1           H_ADD:    POP   DE   
0240   19                     ADD   HL,DE   
0241   F7                     RST   30h   
0242   E5           NEGNUM:   PUSH   HL   ; a negative number: read it, negate it
0243   CD 31 03               CALL   rdnum   
0246   E7                     RST   20h   
0247   F7                     RST   30h   
0248   D1           H_AND:    POP   DE   
0249   7C                     LD   A,H   
024A   A2                     AND   D   
024B   67                     LD   H,A   
024C   7D                     LD   A,L   
024D   A3                     AND   E   
024E   6F                     LD   L,A   
024F   F7                     RST   30h   
0250                             ; Signed compares. Both are "HL < DE" for the right pair: "<" swaps the two
0250                             ; cells first. Flipping both sign bits turns a signed compare into an
0250                             ; unsigned one (and XOR clears the carry for SBC); SBC HL,HL then turns the
0250                             ; carry into -1 or 0 with no branch.
0250   E3           H_LT:     EX   (SP),HL   ; a < b: HL = a, and b is popped next
0251   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
0252   7C                     LD   A,H   
0253   EE 80                  XOR   80h   
0255   67                     LD   H,A   
0256   7A                     LD   A,D   
0257   EE 80                  XOR   80h   
0259   57                     LD   D,A   
025A   ED 52                  SBC   HL,DE   ; carry if HL < DE
025C   ED 62        TF:       SBC   HL,HL   ; carry -> -1 or 0
025E   F7                     RST   30h   
025F   D1           H_EQ:     POP   DE   
0260   B7                     OR   A   
0261   ED 52                  SBC   HL,DE   
0263   7C                     LD   A,H   
0264   B5                     OR   L   
0265   FE 01                  CP   1   ; carry only if a - b = 0
0267   18 F3                  JR   tf   
0269                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept. The
0269                             ; multiplier shifts up through A:C.
0269   D1           H_MUL:    POP   DE   ; DE = multiplicand
026A   C5                     PUSH   BC   
026B   7C                     LD   A,H   
026C   4D                     LD   C,L   ; A:C = multiplier
026D   21 00 00               LD   HL,0   
0270   06 10                  LD   B,16   
0272   29           MUL1:     ADD   HL,HL   
0273   CB 21                  SLA   C   
0275   17                     RLA      
0276   30 01                  JR   NC,mul2   
0278   19                     ADD   HL,DE   
0279   10 F7        MUL2:     DJNZ   mul1   
027B   C1                     POP   BC   
027C   F7                     RST   30h   
027D                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
027D                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
027D                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
027D                             ; stops on it.
027D                H_DIV:       
027D                          IF   CHECKED   
027D   7C                     LD   A,H   
027E   B5                     OR   L   
027F   CA AF 04               JP   Z,e_zero   
0282                          ENDIF      
0282   D1                     POP   DE   ; DE = a, HL = b
0283   C5                     PUSH   BC   ; free BC for udiv
0284   D5                     PUSH   DE   ; a, for r's sign
0285   7A                     LD   A,D   
0286   AC                     XOR   H   
0287   F5                     PUSH   AF   ; S flag = sign of q
0288   CB 7C                  BIT   7,H   
028A   C4 20 01               CALL   NZ,neg16   ; HL = |b|
028D   EB                     EX   DE,HL   
028E   CB 7C                  BIT   7,H   
0290   C4 20 01               CALL   NZ,neg16   ; HL = |a|, DE = |b|
0293   CD 0B 03               CALL   udiv   ; HL = q, DE = r
0296   F1                     POP   AF   
0297   FC 20 01               CALL   M,neg16   ; q's sign
029A   EB                     EX   DE,HL   ; HL = r, DE = q
029B   F1                     POP   AF   ; A = a's high byte
029C   B7                     OR   A   
029D   FC 20 01               CALL   M,neg16   ; r's sign
02A0   C1                     POP   BC   
02A1   D5                     PUSH   DE   ; q under r
02A2   F7                     RST   30h   
02A3                             ; ---- stack and storage -----------------------------------------------------
02A3   E5           H_DUP:    PUSH   HL   ; ":"
02A4   F7                     RST   30h   
02A5   E3           H_SWAP:   EX   (SP),HL   ; "%"
02A6   F7                     RST   30h   
02A7                             ; (The checked build tests the address before it takes the value off the
02A7                             ; stack, so that an error report shows both.)
02A7                H_CSTORE:      ; "." ( c addr -- )
02A7                          IF   CHECKED   
02A7   CD 06 04               CALL   chkst   
02AA                          ENDIF      
02AA   D1                     POP   DE   
02AB   73                     LD   (HL),E   
02AC   DF           H_DROP:   RST   18h   ; ";" is this one byte
02AD                H_STORE:      ; "!" ( n addr -- )
02AD                          IF   CHECKED   
02AD   CD 06 04               CALL   chkst   
02B0                          ENDIF      
02B0   D1                     POP   DE   
02B1   73                     LD   (HL),E   
02B2   23                     INC   HL   
02B3   72                     LD   (HL),D   
02B4   DF                     RST   18h   
02B5                             ; ---- console ---------------------------------------------------------------
02B5                             ; 22h pushes the address of the text after it and skips the string.
02B5   E5           H_STR:    PUSH   HL   
02B6   60                     LD   H,B   
02B7   69                     LD   L,C   
02B8   CD 47 03               CALL   skipstr   
02BB                          IF   CHECKED   
02BB   B7                     OR   A   ; 0: the text ran out before the closing quote
02BC   CA A7 04               JP   Z,e_quote   
02BF                          ENDIF      
02BF   F7                     RST   30h   
02C0                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character
02C0                             ; clears that character"s bit 6 (/M is CR, /` is space; "/" and ""' have no
02C0                             ; bit 6, so // and /" give themselves).
02C0                          IF   1-CHECKED   
                    H_PRINT:   LD   A,(HL)   
                              INC   HL   
                              CP   22h   
                              JR   Z,pr9   
                              CP   "/"   
                              JR   NZ,pr1   
                              LD   A,(HL)   
                              INC   HL   
                              AND   0BFh   
                    PR1:      RST   28h   
                              JR   h_print   
02C0                          ENDIF      
02C0                          IF   CHECKED   
02C0                             ; (The checked build has the loop as a routine, prstr, which the error
02C0                             ; report uses too. The address is kept on the stack meanwhile: a report
02C0                             ; shows the stack as it was before the "$".)
02C0   E5           H_PRINT:   PUSH   HL   
02C1   CD 33 04               CALL   prstr   
02C4   D1                     POP   DE   
02C5   DF                     RST   18h   
02C6                          ENDIF      
02C6   7D           H_EMIT:   LD   A,L   ; "'"
02C7   EF                     RST   28h   
02C8   DF           PR9:      RST   18h   
02C9                             ; "#" prints TOS as a signed decimal number, with no space after it.
02C9   C5           H_NUM:    PUSH   BC   
02CA   CD 95 03               CALL   psgn   
02CD   C1                     POP   BC   
02CE   DF                     RST   18h   
02CF                             ; "?" ( n -- c ) or ( -n -- addr )
02CF                             ;   n > 0: wait about n ms for a key; 0 if none came
02CF                             ;   n = 0: wait for a key
02CF                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
02CF                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
02CF   CB 7C        H_KEY:    BIT   7,H   
02D1   20 19                  JR   NZ,line   
02D3   1E 28        KT1:      LD   E,MSLOOP   ; one millisecond, roughly
02D5   CD E1 03     KT2:      CALL   getk   
02D8   20 0E                  JR   NZ,kt3   
02DA   1D                     DEC   E   
02DB   20 F8                  JR   NZ,kt2   
02DD   7C                     LD   A,H   ; 0? never counts down: it waits
02DE   B5                     OR   L   
02DF   28 F2                  JR   Z,kt1   
02E1   2B                     DEC   HL   
02E2   7C                     LD   A,H   
02E3   B5                     OR   L   
02E4   20 ED                  JR   NZ,kt1   ; A = 0 if the time ran out
02E6   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
02E7   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
02E8   6F           KT3:      LD   L,A   
02E9   26 00                  LD   H,0   
02EB   F7                     RST   30h   
02EC                          IF   CPM   
02EC                             ; CP/M: BDOS 10 does the editing (the spec allows the platform's
02EC                             ; own line editor). It doesn't store the CR, so it is added here.
02EC   11 7F 00     LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
02EF   19                     ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
02F0   9F                     SBC   A,A   
02F1   A5                     AND   L   ; (0 for a count that is too big)
02F2   EE 7F                  XOR   127   ; A = the count, 127 at most
02F4                          ENDIF      
02F4                          IF   CPM*EDITOR   
                              CALL   rdline   ; (the editor calls rdline too)
                              LD   L,LINEBUF & 0FFh   
                              RST   30h   
                                 ; rdline: read a line of at most A characters; HL -> the CR that ends it
                    RDLINE:      
02F4                          ENDIF      
02F4                          IF   CPM   
02F4   32 7E 08               LD   (LBHDR),A   
02F7   11 7E 08               LD   DE,LBHDR   
02FA   3E 0A                  LD   A,10   
02FC   CD F9 03               CALL   bdosx   
02FF   21 7F 08               LD   HL,LBHDR+1   
0302   7E                     LD   A,(HL)   ; the count typed (0-127)
0303   2C                     INC   L   ; HL = LINEBUF, whose low byte is 80h:
0304   85                     ADD   A,L   ;   adding the count to L can't carry
0305   6F                     LD   L,A   
0306   36 0D                  LD   (HL),13   
0308                          ENDIF      
0308                          IF   CPM*(1-EDITOR)   
0308   2E 80                  LD   L,LINEBUF & 0FFh   
030A   F7                     RST   30h   
030B                          ENDIF      
030B                          IF   CPM*EDITOR   
                              RET      
030B                          ENDIF      
030B                          IFN   CPM   
                                 ; Generic: Backspace takes the last character back (and is echoed as
                                 ; it is), CR ends (stored, not echoed), every other key is stored and
                                 ; echoed until the line is full. The line buffer starts at offset 80h
                                 ; of its page, so L alone is the place in the line: D holds the L of
                                 ; a full line.
030B                          ENDIF      
030B                          IFN   CPM   
                    LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
                              ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
                              SBC   A,A   
                              AND   L   ; (0 for a count that is too big)
                              CPL      
                              LD   D,A   ; D = the L of a full line: 80h + count, FFh
030B                          ENDIF      ;   at most
030B                          IF   EDGEN   
                              CALL   rdline   ; (the editor calls rdline too)
                              LD   L,LINEBUF & 0FFh   
                              RST   30h   
                                 ; rdline: read a line that is full when L reaches D; HL -> the CR that ends it
                    RDLINE:      
030B                          ENDIF      
030B                          IFN   CPM   
                              LD   HL,LINEBUF   
                    LN2:      CALL   getk   
                              JR   Z,ln2   
                              CP   13   
                              JR   Z,ln5   
                              CP   8   
                              JR   Z,ln4   
                              LD   E,A   
                              LD   A,L   
                              CP   D   
                              JR   Z,ln2   ; full
                              LD   (HL),E   
                              INC   L   
                              LD   A,E   
                    LN3:      RST   28h   
                              JR   ln2   
                    LN4:      DEC   L   ; Backspace: one back, and echo it,
                              JP   M,ln3   ;   unless the line was empty (L left the
                              INC   L   ;   upper half of the page)
                              JR   ln2   
                    LN5:      LD   (HL),A   ; the CR
030B                          ENDIF      
030B                          IF   (1-CPM)*(1-EDITOR)   
                              LD   L,LINEBUF & 0FFh   
                              RST   30h   
030B                          ENDIF      
030B                          IF   EDGEN   
                              RET      
030B                          ENDIF      
030B                             ; =============================================================================
030B                             ;  More routines (no handler starts past this point)
030B                             ; =============================================================================
030B                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
030B                             ; Uses A, BC; the caller saves the IP. The dividend shifts up through A:C
030B                             ; while the quotient bits arrive at the bottom of C.
030B                             ; Dividing by 2 is one shift (the spec wants that fast).
030B   7B           UDIV:     LD   A,E   
030C   EE 02                  XOR   2   
030E   B2                     OR   D   
030F   20 07                  JR   NZ,udv0   
0311   CB 3C                  SRL   H   
0313   CB 1D                  RR   L   ; the quotient
0315   8F                     ADC   A,A   
0316   5F                     LD   E,A   ; the remainder: the bit that fell out (D is 0)
0317   C9                     RET      
0318   7C           UDV0:     LD   A,H   
0319   4D                     LD   C,L   
031A   21 00 00               LD   HL,0   
031D   06 10                  LD   B,16   
031F   CB 21        UDV1:     SLA   C   
0321   17                     RLA      
0322   ED 6A                  ADC   HL,HL   
0324   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
0326   30 02                  JR   NC,udv2   ;   always fits in 16 bits
0328   19                     ADD   HL,DE   ; too much: put it back, and cancel the
0329   0D                     DEC   C   ;   INC below
032A   0C           UDV2:     INC   C   ; a quotient bit
032B   10 F2                  DJNZ   udv1   
032D   EB                     EX   DE,HL   ; DE = remainder
032E   67                     LD   H,A   
032F   69                     LD   L,C   ; HL = quotient
0330   C9                     RET      
0331                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
0331                             ; non-digit. Values wrap at 16 bits, as the spec says.
0331   21 00 00     RDNUM:    LD   HL,0   
0334   0A           RDN1:     LD   A,(BC)   
0335   D6 30                  SUB   "0"   
0337   FE 0A                  CP   10   
0339   D0                     RET   NC   
033A   03                     INC   BC   
033B   54                     LD   D,H   
033C   5D                     LD   E,L   
033D   29                     ADD   HL,HL   
033E   29                     ADD   HL,HL   
033F   19                     ADD   HL,DE   
0340   29                     ADD   HL,HL   ; HL * 10
0341   5F                     LD   E,A   
0342   16 00                  LD   D,0   
0344   19                     ADD   HL,DE   
0345   18 ED                  JR   rdn1   
0347                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
0347                             ; the next character, so "/"" does not end it. Leaves A = 22h.
0347                          IF   1-CHECKED   
                    SS0:      INC   BC   
                    SKIPSTR:   LD   A,(BC)   
                              INC   BC   
                              CP   "/"   
                              JR   Z,ss0   
                              CP   22h   
                              JR   NZ,skipstr   
                              RET      
0347                          ENDIF      
0347                          IF   CHECKED   
0347                             ; The checked build never steps over a NUL: if the text runs out first it
0347                             ; returns A = 0 with the IP on the NUL.
0347   0A           SKIPSTR:   LD   A,(BC)   
0348   B7                     OR   A   
0349   C8                     RET   Z   
034A   03                     INC   BC   
034B   FE 22                  CP   22h   
034D   C8                     RET   Z   
034E   FE 2F                  CP   "/"   
0350   20 F5                  JR   NZ,skipstr   
0352   0A                     LD   A,(BC)   ; the escaped character
0353   B7                     OR   A   
0354   C8                     RET   Z   
0355   03                     INC   BC   
0356   18 EF                  JR   skipstr   
0358                          ENDIF      
0358                             ; skip: read past text to the closer at this level, and return A = 0 if it
0358                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
0358                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
0358                             ; no closer; anything else that runs into the NUL had unbalanced brackets
0358                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
0358                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
0358                             ; 
0358                             ; The checked build also looks at the character the skip was started by,
0358                             ; which is always the one just before where it starts: "(" must end at ")",
0358                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
0358                             ; quote counts as running into it. "\" takes either closer. IX keeps the
0358                             ; place where the skip started, for the report.
0358                SKIP:        
0358                          IF   CHECKED   
0358   C5                     PUSH   BC   
0359   DD E1                  POP   IX   
035B   0B                     DEC   BC   
035C   0A                     LD   A,(BC)   
035D   03                     INC   BC   
035E   5F                     LD   E,A   ; E = the opener: ( [ or \
035F                          ENDIF      
035F   16 00                  LD   D,0   
0361   14           SK3:      INC   D   ; an opener: one deeper
0362   0A           SK1:      LD   A,(BC)   
0363                          IF   1-CHECKED   
                              INC   BC   
                              OR   A   
                              JP   Z,endprog   
0363                          ENDIF      
0363                          IF   CHECKED   
0363   B7                     OR   A   
0364   28 22                  JR   Z,sk6   ; (the IP stays on the NUL)
0366   03                     INC   BC   
0367                          ENDIF      
0367   FE 22                  CP   22h   
0369   CC 47 03               CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
036C   D6 28                  SUB   "("   ;   (or 0, and then the NUL is read next)
036E   28 F1                  JR   Z,sk3   
0370   3D                     DEC   A   ; ")"
0371   28 08                  JR   Z,sk4   
0373   D6 32                  SUB   "["-")"   
0375   28 EA                  JR   Z,sk3   
0377   FE 02                  CP   "]"-"["   
0379   20 E7                  JR   NZ,sk1   
037B   15           SK4:      DEC   D   
037C                          IF   1-CHECKED   
                              RET   Z   ; the closer at this level
                              JR   sk1   
037C                          ENDIF      
037C                          IF   CHECKED   
037C   20 E4                  JR   NZ,sk1   
037E   57                     LD   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
037F   AB                     XOR   E   ;   opener is 0 for "(" and 1 for "[", and only
0380   E6 06                  AND   6   ;   "\" has bit 2: so this is 2 for the wrong
0382   FE 02                  CP   2   ;   closer, and only then
0384   7A                     LD   A,D   
0385   C0                     RET   NZ   
0386   18 05                  JR   sk7   
0388   CB 53        SK6:      BIT   2,E   ; the text ran out:
038A   C2 15 01               JP   NZ,endprog   ;   "\" with no closer ends the program
038D   DD E5        SK7:      PUSH   IX   ; N. The place is the opener
038F   C1                     POP   BC   
0390   3E 4E                  LD   A,"N"   
0392   C3 A4 04               JP   errp   ; (errp drops skip's return address)
0395                          ENDIF      
0395                             ; psgn: print HL as a signed number. Uses BC.
0395   CB 7C        PSGN:     BIT   7,H   
0397   28 04                  JR   Z,pdec   
0399   3E 2D                  LD   A,"-"   
039B   EF                     RST   28h   
039C   E7                     RST   20h   
039D                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
039D                             ; Uses BC.
039D   11 0A 00     PDEC:     LD   DE,10   
03A0   CD 0B 03               CALL   udiv   ; HL = HL / 10, E = the last digit
03A3   7B                     LD   A,E   
03A4   F5                     PUSH   AF   
03A5   7C                     LD   A,H   
03A6   B5                     OR   L   
03A7   C4 9D 03               CALL   NZ,pdec   
03AA   F1                     POP   AF   
03AB   C6 30                  ADD   A,"0"   
03AD   EF                     RST   28h   
03AE   C9                     RET      
03AF                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
03AF                             ; and return its value in A with the carry set; otherwise leave the IP and
03AF                             ; return with the carry clear.
03AF   0A           HEXC:     LD   A,(BC)   
03B0   D6 30                  SUB   "0"   
03B2   FE 0A                  CP   10   
03B4   38 09                  JR   C,hc1   
03B6   E6 DF                  AND   0DFh   
03B8   D6 11                  SUB   11h   
03BA   FE 06                  CP   6   
03BC   D0                     RET   NC   
03BD   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
03BF   03           HC1:      INC   BC   
03C0   C9                     RET      
03C1                             ; =============================================================================
03C1                             ;  Dispatch table: the low byte of each handler's address, in code order
03C1                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
03C1                             ;  It must not cross a page (the dispatcher only adds to its low byte).
03C1                             ; =============================================================================
03C1                             ; The handlers of the first NPG1 characters start in the image's second page.
03C1                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
03C1                             ; differs between the builds, so the count is worked out here.
03C1                             ; (One division to a line: asm80 only rounds down when it stores a value.)
03C1                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
03C1                PGBRK:    EQU   (h_break-BASE)/256   
03C1                PGDEF:    EQU   (h_def-BASE)/256   
03C1                PGFET:    EQU   (h_fetch-BASE)/256   
03C1                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
03C1                          IF   1-TABP0   
03C1                PTAB:        
03C1                          ;*Macro unroll:  PTABLE
03C1   AD                     DB   h_store & 0FFh   
03C2   B5                     DB   h_str & 0FFh   
03C3   C9                     DB   h_num & 0FFh   
03C4   C0                     DB   h_print & 0FFh   
03C5   A5                     DB   h_swap & 0FFh   
03C6   48                     DB   h_and & 0FFh   
03C7   C6                     DB   h_emit & 0FFh   
03C8   24                     DB   h_open & 0FFh   
03C9   2C                     DB   h_close & 0FFh   
03CA   69                     DB   h_mul & 0FFh   
03CB   3F                     DB   h_add & 0FFh   
03CC   E7                     DB   h_cfetch & 0FFh   
03CD   37                     DB   h_sub & 0FFh   
03CE   A7                     DB   h_cstore & 0FFh   
03CF   7D                     DB   h_div & 0FFh   
03D0   A3                     DB   h_dup & 0FFh   
03D1   AC                     DB   h_drop & 0FFh   
03D2   50                     DB   h_lt & 0FFh   
03D3   5F                     DB   h_eq & 0FFh   
03D4   51                     DB   h_gt & 0FFh   
03D5   CF                     DB   h_key & 0FFh   
03D6   1F                     DB   h_fetch & 0FFh   
03D7   FB                     DB   h_def & 0FFh   
03D8   EE                     DB   h_break & 0FFh   
03D9   EA                     DB   h_ret & 0FFh   
03DA   83                     DB   h_xor & 0FFh   
03DB   96                     DB   h_alloc & 0FFh   
03DC   D4                     DB   h_grave & 0FFh   
03DD   2C                     DB   h_tor & 0FFh   
03DE   8B                     DB   h_or & 0FFh   
03DF   1C                     DB   h_fromr & 0FFh   
03E0   93                     DB   h_not & 0FFh   
03E1                PTABEND:      
03E1                          ENDIF      
03E1                             ; =============================================================================
03E1                             ;  Console layer: getk returns a waiting key in A (zero flag clear), or
03E1                             ;  A = 0 with the zero flag set when none is waiting. putc (RST 28h) prints
03E1                             ;  A. Both keep BC, DE, HL and HL". In the generic build they are the host"s
03E1                             ;  KEY and CONOUT routines themselves.
03E1                             ; =============================================================================
03E1                          IF   (1-CPM)*(1-CHECKED)   
                    GETK:     EQU   KEY   ; the host's routine does the whole job
03E1                          ENDIF      
03E1                          IF   CHECKED   
03E1   E5           GETK:     PUSH   HL   ; a key held back by the break check goes
03E2   21 36 08               LD   HL,KEYBUF   ;   first, and is taken out of the buffer
03E5   7E                     LD   A,(HL)   
03E6   36 00                  LD   (HL),0   
03E8   E1                     POP   HL   
03E9   B7                     OR   A   
03EA   C0                     RET   NZ   
03EB                          ENDIF      
03EB                          IF   (1-CPM)*CHECKED   
                              JP   KEY   
03EB                          ENDIF      
03EB                          IF   CPM*(1-CHECKED)   
                    GETK:        
03EB                          ENDIF      
03EB                          IF   CPM   
03EB   3E FF                  LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
03ED                             ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
03ED                             ; printing and could swallow a key that BDOS 6 then never sees.
03ED   D5           PUTC:     PUSH   DE   
03EE   E5                     PUSH   HL   
03EF   5F                     LD   E,A   
03F0   3E 06                  LD   A,6   
03F2   CD F9 03               CALL   bdosx   
03F5   E1                     POP   HL   
03F6   D1                     POP   DE   
03F7   B7                     OR   A   ; (for getk)
03F8   C9                     RET      
03F9                             ; bdosx: call BDOS function A with DE, keeping BC and HL'
03F9   C5           BDOSX:    PUSH   BC   
03FA   D9                     EXX      
03FB   E5                     PUSH   HL   
03FC   D9                     EXX      
03FD   4F                     LD   C,A   
03FE   CD 05 00               CALL   BDOS   
0401   D9                     EXX      
0402   E1                     POP   HL   
0403   D9                     EXX      
0404   C1                     POP   BC   
0405   C9                     RET      
0406                          ENDIF      
0406                             ; =============================================================================
0406                             ;  Checked build: the checks and the error report
0406                             ; =============================================================================
0406                          IF   CHECKED   
0406                             ; chkst: stop unless HL is in the program's own space: from the letter page
0406                             ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
0406                             ; whatever lies above the limit are safe. Memory above the heap top but
0406                             ; below the limit is the program's own: Tiny BASIC keeps its lines there.
0406                             ; It is the page of HL + 1 that is tested, so that one test serves both
0406                             ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
0406                             ; Keeps HL and BC.
0406   23           CHKST:    INC   HL   
0407   7C                     LD   A,H   
0408   2B                     DEC   HL   
0409   FE 08                  CP   LETPAGE   
040B   38 07                  JR   C,chs1   
040D                          ENDIF      
040D                          IF   CHECKED*(1-CPM)   
                              CP   HEAPLIM   
                              RET   C   
040D                          ENDIF      
040D                          IF   CHECKED*CPM   
040D   5F                     LD   E,A   
040E   3A 07 00               LD   A,(0007h)   ; the BDOS page is the heap limit
0411   3D                     DEC   A   
0412   BB                     CP   E   
0413   D0                     RET   NC   
0414                          ENDIF      
0414                          IF   CHECKED   
0414   C3 A2 04     CHS1:     JP   e_store   
0417                             ; chkhp: HL = the new heap top, DE = the old one, the carry is from adding
0417                             ; the count. Stop if the top is not below the limit page, or is below the
0417                             ; program's end.
0417                CHKHP:       
0417                          ENDIF      
0417                          IF   CHECKED*CPM   
0417                             ; With this much room a top that wrapped round can land back in
0417                             ; range, so the add is tested too: growing (A, the count's high
0417                             ; byte, is positive) must not carry, and releasing must.
0417   1F                     RRA      ; the carry comes in above the sign:
0418   C6 40                  ADD   A,40h   ;   bit 7 = carry XOR sign
041A   87                     ADD   A,A   
041B   38 10                  JR   C,e_heap   
041D   3A 07 00               LD   A,(0007h)   
0420   3D                     DEC   A   
0421   BC                     CP   H   
0422   38 09                  JR   C,e_heap   
0424                          ENDIF      
0424                          IF   CHECKED*(1-CPM)   
                                 ; (Here the program's space is under 32K, so a top that wrapped
                                 ; round always falls outside it.)
                              LD   A,H   
                              CP   HEAPLIM   
                              JR   NC,e_heap   
0424                          ENDIF      
0424                          IF   CHECKED   
0424   D5                     PUSH   DE   
0425   EB                     EX   DE,HL   
0426   2A 38 08               LD   HL,(NPEND)   
0429   19                     ADD   HL,DE   ; carry: at or above the program's end
042A   EB                     EX   DE,HL   
042B   D1                     POP   DE   
042C   D8                     RET   C   
042D   B7           E_HEAP:   OR   A   ; put the count back in TOS for the report
042E   ED 52                  SBC   HL,DE   
0430   C3 9F 04               JP   e_heap1   
0433                             ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
0433                             ; "$", and the error report's texts). A NUL first is an error: Q.
0433   7E           PRSTR:    LD   A,(HL)   
0434   23                     INC   HL   
0435   FE 22                  CP   22h   
0437   C8                     RET   Z   
0438   B7                     OR   A   
0439   28 0B                  JR   Z,e_dollar   
043B   FE 2F                  CP   "/"   
043D   20 04                  JR   NZ,prs1   
043F   7E                     LD   A,(HL)   
0440   23                     INC   HL   
0441   E6 BF                  AND   0BFh   
0443   EF           PRS1:     RST   28h   
0444   18 ED                  JR   prstr   
0446   D1           E_DOLLAR:   POP   DE   ; "$" ran into a NUL: drop the return address,
0447   E1                     POP   HL   ;   and put the string's address back in TOS
0448   3E 51                  LD   A,"Q"   
044A   C3 B4 04               JP   error   
044D                             ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
044D                             ; pnl: the same, on a new line.
044D   3E 0D        PNL:      LD   A,13   
044F   EF                     RST   28h   
0450   3E 0A                  LD   A,10   
0452   EF                     RST   28h   
0453   E3           PMSG:     EX   (SP),HL   
0454   CD 33 04               CALL   prstr   
0457   E3                     EX   (SP),HL   
0458   C9                     RET      
0459                             ; chkstk: both stacks are checked once per character, not in every handler.
0459                             ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
0459                             ; the constant carries if it is above (cells were popped that were never
0459                             ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
0459                             ; a character late at most: the bytes above DSTOP and the guard band below
0459                             ; the page take what happens meanwhile. DE is free between characters.
0459   EB           CHKSTK:   EX   DE,HL   
045A   21 05 F8               LD   HL,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
045D   39                     ADD   HL,SP   
045E   EB                     EX   DE,HL   
045F   38 1E                  JR   C,e_under   
0461   14                     INC   D   
0462   20 17                  JR   NZ,e_over   
0464   D9                     EXX      ; the return stack: in its page (or it has
0465   7C                     LD   A,H   ;   overflowed), and not above its empty
0466   FE 06                  CP   RSPAGE   ;   position (an underflow stays inside the
0468   7D                     LD   A,L   ;   page, in the guard band)
0469   D9                     EXX      
046A   20 0C                  JR   NZ,e_rover   
046C   FE E1                  CP   RSTOP&0FFh+1   
046E   D8                     RET   C   
046F   D9                     EXX      ; return stack underflow: it counts as empty
0470   21 E0 06               LD   HL,RSTOP   
0473   D9                     EXX      
0474   3E 72                  LD   A,"r"   
0476   18 2C                  JR   errp   
0478   3E 52        E_ROVER:   LD   A,"R"   ; return stack overflow
047A   11                     DB   11h   ; (LD DE,nn hides the next entry)
047B   3E 53        E_OVER:   LD   A,"S"   ; data stack overflow
047D   18 25                  JR   errp   
047F   31 FC 07     E_UNDER:   LD   SP,DSTOP   ; data stack underflow: it counts as empty
0482   3E 73                  LD   A,"s"   
0484   18 2E                  JR   error   
0486                             ; chkbrk: a waiting key is read now; Ctrl-C stops the program, anything
0486                             ; else is held for the next "?".
0486   CD E1 03     CHKBRK:   CALL   getk   
0489   C8                     RET   Z   
048A   FE 03                  CP   3   
048C   28 0E                  JR   Z,e_break   
048E   32 36 08               LD   (KEYBUF),A   
0491   C9                     RET      
0492                             ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
0492                             ; was never defined still holds 0000h, and the byte there is a reserved one
0492                             ; in every build (AFh or C3h): if the IP is in page zero, this was a call of
0492                             ; an undefined word. The call is undone, so the place is the call itself.
0492   04           E_HI:     INC   B   
0493   10 17                  DJNZ   e_resv   ; (B is as it was, and is not 0)
0495   CF                     RST   08h   
0496   42                     LD   B,D   
0497   4B                     LD   C,E   
0498   3E 55                  LD   A,"U"   
049A   18 18                  JR   error   
049C                             ; Error entries. Each loads its letter and then hides the next entry inside
049C                             ; a 3-byte LD DE,nn (the 11h), so they all fall through to `error`.
049C   3E 42        E_BREAK:   LD   A,"B"   ; Ctrl-C (found inside chkbrk)
049E   11                     DB   11h   
049F   3E 48        E_HEAP1:   LD   A,"H"   ; heap (found inside chkhp)
04A1   11                     DB   11h   
04A2   3E 4F        E_STORE:   LD   A,"O"   ; a store outside the program's space (chkst)
04A4                             ; errp: an error found inside a routine: drop its return address first.
04A4   D1           ERRP:     POP   DE   
04A5   18 0D                  JR   error   
04A7   44           E_QUOTE:   LD   B,H   ; an unclosed string: HL is its address, one
04A8   4D                     LD   C,L   ;   past the opening quote, which is the place
04A9   3E 51                  LD   A,"Q"   
04AB   11                     DB   11h   
04AC   3E 58        E_RESV:   LD   A,"X"   ; a reserved byte outside a string
04AE   11                     DB   11h   
04AF   3E 5A        E_ZERO:   LD   A,"Z"   ; dividing by zero
04B1   11                     DB   11h   
04B2   3E 57        E_BRACK:   LD   A,"W"   ; bad character after [
04B4                             ; error: the report, then the end. A = the letter, BC = one past the place,
04B4                             ; HL = TOS, and both stacks as the report is to show them:
04B4                             ; 
04B4                             ;   Err X @ line,col
04B4                             ;   up to 16 characters of the text from the place
04B4                             ;   Stk n: the top 8 cells at most, bottom to top
04B4                             ;   Rtn n
04B4   E5           ERROR:    PUSH   HL   ; now the whole data stack is in memory
04B5   5F                     LD   E,A   
04B6   CD 4D 04               CALL   pnl   
04B9   45 72 72 20 22         DB   "Err ",22h   
04BE   7B                     LD   A,E   
04BF   EF                     RST   28h   
04C0   CD 53 04               CALL   pmsg   
04C3   20 40 20 22            DB   " @ ",22h   
04C7   0B                     DEC   BC   ; BC = the place
04C8                             ; The line and column. A place below the program is in the line
04C8                             ; buffer: line 0. Otherwise count the LFs from the program's start;
04C8                             ; DE = the line's number, HL = where it starts.
04C8   21 80 08               LD   HL,LINEBUF   
04CB   11 00 00               LD   DE,0   
04CE   78                     LD   A,B   
04CF   FE 09                  CP   PROG/256   
04D1   38 14                  JR   C,er3   
04D3   24                     INC   H   
04D4   6B                     LD   L,E   ; HL = PROG
04D5   13           ER1:      INC   DE   ; a new line starts at HL
04D6   E5                     PUSH   HL   
04D7   7D           ER2:      LD   A,L   
04D8   91                     SUB   C   
04D9   7C                     LD   A,H   
04DA   98                     SBC   A,B   
04DB   30 09                  JR   NC,er2x   ; reached the place
04DD   7E                     LD   A,(HL)   
04DE   23                     INC   HL   
04DF   FE 0A                  CP   10   
04E1   20 F4                  JR   NZ,er2   
04E3   F1                     POP   AF   
04E4   18 EF                  JR   er1   
04E6   E1           ER2X:     POP   HL   
04E7   C5           ER3:      PUSH   BC   
04E8   E5                     PUSH   HL   
04E9   EB                     EX   DE,HL   
04EA   CD 9D 03               CALL   pdec   ; the line
04ED   3E 2C                  LD   A,","   
04EF   EF                     RST   28h   
04F0   D1                     POP   DE   
04F1   E1                     POP   HL   
04F2   E5                     PUSH   HL   
04F3   B7                     OR   A   
04F4   ED 52                  SBC   HL,DE   
04F6   23                     INC   HL   
04F7   CD 9D 03               CALL   pdec   ; the column
04FA   CD 4D 04               CALL   pnl   
04FD   22                     DB   22h   
04FE   E1                     POP   HL   ; the text, as it is: 16 characters, or fewer
04FF   06 10                  LD   B,16   ;   if the line or the program ends first
0501   7E           ER4:      LD   A,(HL)   
0502   23                     INC   HL   
0503   B7                     OR   A   
0504   28 0F                  JR   Z,er5   
0506   FE 0D                  CP   13   
0508   28 0B                  JR   Z,er5   
050A   FE 0A                  CP   10   
050C   28 07                  JR   Z,er5   
050E                          ENDIF      
050E                          IF   CHECKED*CPM   
050E   FE 1A                  CP   1Ah   ; (the ^Z that pads a file's last record ends
0510   28 03                  JR   Z,er5   ;   the text too: some terminals clear the
0512                          ENDIF      ;   screen on it)
0512                          IF   CHECKED   
0512   EF                     RST   28h   
0513   10 EC                  DJNZ   er4   
0515   CD 4D 04     ER5:      CALL   pnl   
0518   53 74 6B 20 22         DB   "Stk ",22h   
051D   21 FA 07               LD   HL,DSTOP-2   ; (the cell at DSTOP-2 was pushed with the
0520   B7                     OR   A   ;   first value and holds nothing)
0521   ED 72                  SBC   HL,SP   
0523   CD 6E 05               CALL   phalf   ; the depth
0526   3E 3A                  LD   A,":"   
0528   EF                     RST   28h   
0529   79                     LD   A,C   
052A   FE 09                  CP   9   
052C   38 0A                  JR   C,er6   
052E   CD 53 04               CALL   pmsg   
0531   20 2E 2E 2E 22         DB   " ...",22h   
0536   0E 08                  LD   C,8   
0538   26 00        ER6:      LD   H,0   ; C = the number of cells to show
053A   69                     LD   L,C   
053B   29                     ADD   HL,HL   
053C   39                     ADD   HL,SP   ; HL -> just above the deepest of them
053D   0C                     INC   C   
053E   0D           ER7:      DEC   C   
053F   28 11                  JR   Z,er8   
0541   2B                     DEC   HL   
0542   56                     LD   D,(HL)   
0543   2B                     DEC   HL   
0544   5E                     LD   E,(HL)   
0545   E5                     PUSH   HL   
0546   C5                     PUSH   BC   
0547   3E 20                  LD   A," "   
0549   EF                     RST   28h   
054A   EB                     EX   DE,HL   
054B   CD 95 03               CALL   psgn   
054E   C1                     POP   BC   
054F   E1                     POP   HL   
0550   18 EC                  JR   er7   
0552   CD 4D 04     ER8:      CALL   pnl   
0555   52 74 6E 20 22         DB   "Rtn ",22h   
055A   D9                     EXX      
055B   E5                     PUSH   HL   
055C   D9                     EXX      
055D   D1                     POP   DE   
055E   21 E0 06               LD   HL,RSTOP   
0561   B7                     OR   A   
0562   ED 52                  SBC   HL,DE   
0564   CD 6E 05               CALL   phalf   
0567   CD 4D 04               CALL   pnl   
056A   22                     DB   22h   
056B   C3 15 01               JP   endprog   
056E                             ; phalf: print half of HL, and leave it in C
056E   CB 3C        PHALF:    SRL   H   
0570   CB 1D                  RR   L   
0572   E5                     PUSH   HL   
0573   CD 9D 03               CALL   pdec   
0576   C1                     POP   BC   
0577   C9                     RET      
0578                          ENDIF      
0578                             ; =============================================================================
0578                             ;  The line editor (EDITOR = 1)
0578                             ; 
0578                             ;  The interpreter starts here, and a program that ends comes back here. Type
0578                             ;  a line and press Return:
0578                             ; 
0578                             ;    n text    put the text in as line n; the lines from n on move down.
0578                             ;              A number past the end, or 0, adds the line at the end.
0578                             ;    n         take line n out
0578                             ;    0         run the program
0578                             ;    -n        list the program from line n on (-1 lists all of it). Any key
0578                             ;              stops the list until another key is pressed; Ctrl-C ends it.
0578                             ;    anything else is run at once, as B8Script. (Start such a line with a
0578                             ;    space if it would begin with a digit or a minus sign.)
0578                             ; 
0578                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
0578                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
0578                             ;  125 characters, the line number and the one character after it included;
0578                             ;  that character is not stored. The text is kept as it is typed, each line
0578                             ;  ending in CR LF, at PROG. Nothing is checked.
0578                             ; 
0578                             ;  With CPM = 1 the file named on the command line is the program to start
0578                             ;  with (no file, or no such file: no program). Lines are read by BDOS 10, so
0578                             ;  its editing keys work, and Ctrl-C as the first key of a line goes back to
0578                             ;  CP/M. Nothing is written back: there is no command to save.
0578                             ; 
0578                             ;  With CHECKED = 1 a program that is stopped (an error, or Ctrl-C) prints
0578                             ;  its report and comes back here, with both stacks empty. The place is a
0578                             ;  line and column of the program; in a line typed here it is line 0.
0578                             ; 
0578                             ;  Things to know:
0578                             ;    - Reset empties the program (generic builds).
0578                             ;    - Words and variables last from one line to the next. A word's address
0578                             ;      points into the program, so run the program again after editing it.
0578                             ;    - Nothing is printed between a program's output and what is typed next.
0578                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
0578                             ;      a line that calls -n? and carries on afterwards runs what was typed.
0578                             ;      (The stored program never comes back to the line, so it may.)
0578                             ; =============================================================================
0578                          IF   EDGEN*CHECKED   
                                 ; Reset (A = 0): clear the lower half of the letter page. Every variable
                                 ; starts at 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi), and no key is held back.
                    INIT:     LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
                              JR   edit   
0578                          ENDIF      
0578                          IF   EDITOR   
                                 ; -n: list from line n. DE = the number of the line at HL.
                    LIST:     INC   BC   
                              CALL   rdnum   ; HL = n
                              PUSH   HL   
                              CALL   find   
                              POP   DE   
                    LI1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,edit   ; the end of the text
                              CALL   getk   
                              JR   Z,li3   ; no key: carry on
                              CP   3   
                              JR   Z,edit   ; Ctrl-C
                    LI2:      CALL   getk   ; any other key: wait for one more
                              JR   Z,li2   
                              CP   3   
                              JR   Z,edit   
                    LI3:      PUSH   HL   
                              PUSH   DE   
                              EX   DE,HL   
                              CALL   pdec   ; the line's number,
                              LD   A," "   
                              RST   28h   ;   a space,
                              POP   DE   
                              POP   HL   
                              INC   DE   
                              CALL   prl   ;   and the line
                              JR   li1   
                                 ; Take line n (in HL) out: copy everything after it down over it.
                    DEL:      CALL   find   
                              LD   D,H   
                              LD   E,L   
                              CALL   nxl   ; HL -> the next line
                    DE1:      LD   A,(HL)   
                              LD   (DE),A   
                              INC   HL   
                              INC   DE   
                              OR   A   
                              JR   NZ,de1   ; and fall into the editor
                    EDIT:     LD   SP,DSTOP   
0578                          ENDIF      
0578                          IF   EDITOR*CPM*CHECKED   
                                 ; A key that the break check held back while a program ran is let
                                 ; go: BDOS 10 would not see it, and it would turn up in the next
                                 ; program that asked for a key. (This also serves at the start.)
                              XOR   A   
                              LD   (KEYBUF),A   
0578                          ENDIF      
0578                          IF   EDGEN   
                              LD   D,0FDh   ; 125 characters at most
0578                          ENDIF      
0578                          IF   EDITOR*CPM   
                              LD   A,125   
0578                          ENDIF      
0578                          IF   EDITOR   
                              CALL   rdline   ; HL -> the CR that ended the line
                              INC   L   
                              LD   (HL),10   ; a LF after it,
                              DEC   L   
                              CALL   prl   ; (print the CR LF: a new line)
                              LD   (HL),0   ;   and a NUL after that
                              PUSH   HL   ; the end of what was typed
                              LD   BC,LINEBUF   
                              LD   A,(BC)   
                              CP   "-"   
                              JR   Z,list   
                              CALL   rdnum   ; HL = the number it starts with, BC -> after
                              LD   A,C   ; C is still 80h if there was no number:
                              ADD   A,A   ;   only then is twice it 0
                              JR   Z,st0   ; no number: run the line where it is
                              LD   A,(BC)   
                              SUB   13   
                              JR   NZ,ins   ; text follows the number
                              OR   H   ; the number alone:
                              OR   L   
                              JR   NZ,del   ;   not 0: take that line out
                              LD   BC,PROG   ;   0: run the program
                                 ; st0: start running at BC. The heap starts after the stored program's NUL.
                    ST0:      POP   HL   ; (the end of what was typed: the stack is empty)
                              LD   HL,PROG   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
                              LD   (HEAP),HL   
0578                          ENDIF      
0578                          IF   EDITOR*CHECKED   
                              RST   20h   ; minus the heap"s first address: "_' may not
                              LD   (NPEND),HL   ;   release below it
0578                          ENDIF      
0578                          IF   EDITOR   
                              EXX      
                              LD   HL,RSTOP   ; the return stack is empty
                              EXX      
                              RST   30h   ; (its return address is thrown away)
                                 ; Put the typed text in as line n (in HL): open a gap of its length there,
                                 ; CR and LF included, and copy it in.
                    INS:      CALL   find   ; HL -> where it goes
                              INC   BC   ; step over the one character after the number
                              POP   DE   ; the end of what was typed
                              LD   A,E   
                              SUB   C   ; A = the length of the text, with its CR LF
                              PUSH   BC   ; the text
                              LD   C,A   
                              LD   B,0   
                              PUSH   BC   ; its length
                              LD   D,H   
                              LD   E,L   ; DE = where it goes
                              XOR   A   
                              LD   C,A   ; BC = 0: CPIR looks as far as it needs to
                              CPIR      ; HL -> one past the program's NUL
                              SBC   HL,DE   ; the number of bytes to move up, NUL included
                              LD   B,H   
                              LD   C,L   
                              ADD   HL,DE   
                              DEC   HL   ; HL -> the NUL
                              EX   DE,HL   
                              EX   (SP),HL   ; HL = the length; where it goes is kept
                              PUSH   HL   
                              ADD   HL,DE   ; the NUL's new place
                              EX   DE,HL   
                              LDDR      ; move the rest of the program up
                              POP   BC   ; the length
                              POP   DE   ; where it goes
                              POP   HL   ; the text
                              LDIR      
                              JR   edit   
                                 ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
                                 ; of the text if there are fewer lines (or the number is 0). Keeps BC.
                    FIND:     EX   DE,HL   
                              LD   HL,PROG   
                    FI1:      DEC   DE   
                              LD   A,D   
                              OR   E   
                              RET   Z   
                              CALL   nxl   
                              JR   NZ,fi1   
                              RET      
                                 ; nxl: step HL over one line, to just past its LF (and return not-zero), or
                                 ; stop at the NUL that ends the text (and return zero).
                    NXL:      LD   A,(HL)   
                              OR   A   
                              RET   Z   
                              INC   HL   
                              CP   10   
                              JR   NZ,nxl   
                              OR   A   
                              RET      
                                 ; prl: print the line at HL, to its LF; HL -> just past it.
                    PRL:      LD   A,(HL)   
                              RST   28h   
                              LD   A,(HL)   
                              INC   HL   
                              CP   10   
                              JR   NZ,prl   
                              RET      
0578                          ENDIF      
0578                             ; =============================================================================
0578                             ;  CP/M startup (the generic build starts at address 0: see st0)
0578                             ; =============================================================================
0578                          IF   CPM   
0578                             ; The RAM pages follow the image; the heap may grow to the BDOS.
0578                START:       
0578                          ENDIF      
0578                          IF   CPM*CHECKED   
0578                             ; Clear the lower half of the letter page: every variable starts at
0578                             ; 0, every word cell holds 0000h, the address an undefined word is
0578                             ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
0578                             ; is held back.
0578   21 00 08               LD   HL,LET   
057B   AF                     XOR   A   
057C   77           INI1:     LD   (HL),A   
057D   2C                     INC   L   
057E   F2 7C 05               JP   P,ini1   ; +00h to +7Fh
0581                          ENDIF      
0581                          IF   CPM   
0581   21 08 01               LD   HL,vecs   ; the RST routines go down into page zero
0584   11 08 00               LD   DE,0008h   
0587   01 2C 00               LD   BC,vecend-vecs   
058A   ED B0                  LDIR      
058C   11 5C 00               LD   DE,005Ch   ; open the file named on the command line
058F   0E 0F                  LD   C,15   ; (no such file: the first read fails too,
0591   CD 05 00               CALL   BDOS   ;   and the program is empty)
0594   11 00 09               LD   DE,PROG   
0597   D5           LD1:      PUSH   DE   
0598   0E 1A                  LD   C,26   ; set the DMA address
059A   CD 05 00               CALL   BDOS   
059D   11 5C 00               LD   DE,005Ch   
05A0   0E 14                  LD   C,20   ; read the next 128 bytes
05A2   CD 05 00               CALL   BDOS   
05A5   E1                     POP   HL   ; HL = the address this record went to
05A6   B7                     OR   A   
05A7   20 07                  JR   NZ,ld2   
05A9   11 80 00               LD   DE,128   
05AC   19                     ADD   HL,DE   
05AD   EB                     EX   DE,HL   
05AE   18 E7                  JR   ld1   
05B0                LD2:         
05B0                          ENDIF      
05B0                          IF   CPM*(1-EDITOR)   
05B0   36 00                  LD   (HL),0   ; the end of the file counts as NUL
05B2   23                     INC   HL   ; the heap starts after it
05B3   01 00 09               LD   BC,PROG   ; the IP
05B6   C3 76 01               JP   st2   
05B9                          ENDIF      
05B9                          IF   CPM*EDITOR   
                                 ; The editor wants the text to end where the file's text ends: at
                                 ; the first ^Z (1Ah), which pads a text file's last record. One more
                                 ; goes after the last record, so the search always stops. And every
                                 ; line must end in LF: a last line without one is given a CR LF.
                              LD   (HL),1Ah   
                              LD   HL,PROG-1   
                              LD   A,10   ; (a file with no text needs nothing added)
                    TR1:      INC   HL   
                              LD   E,A   ; E = the character before this one
                              LD   A,(HL)   
                              CP   1Ah   
                              JR   NZ,tr1   
                              LD   A,E   
                              CP   10   
                              JR   Z,tr2   
                              LD   (HL),13   
                              INC   HL   
                              LD   (HL),10   
                              INC   HL   
                    TR2:      LD   (HL),0   
                              JP   edit   
05B9                          ENDIF      
05B9                          IF   CPM   
05B9                             ; RAM pages, after the image
05B9                RSPAGE:   EQU   (imgend + 255) / 256   
05B9                DSPAGE:   EQU   RSPAGE + 1   
05B9                LETPAGE:   EQU   RSPAGE + 2   
05B9                PROG:     EQU   LETPAGE*256 + 256   
05B9                          ENDIF      
05B9                IMGEND:      


