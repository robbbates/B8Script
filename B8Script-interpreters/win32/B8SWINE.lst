  1730                              <1> 
  1731                              <1> ; =============================================================================
  1732                              <1> ;  The letters and digits, the return stack's push, and the inner loop
  1733                              <1> ; =============================================================================
  1734                              <1> 
  1735                              <1> ; A-Z: call the word. The return address (the IP after the letter) goes on
  1736                              <1> ; the return stack, and the IP becomes the address in the letter's cell.
  1737 00000980 89F2                <1> upper:  mov     edx,esi
  1738 00000982 668BB40000014100    <1>         mov     si,[ARENA+LET+eax*2]
  1739                              <1> 
  1740                              <1> ; rpush: push EDX on the return stack, then next. Everything that pushes the
  1741                              <1> ; return stack ends here, and the true ')' comes to rpoll.
  1742                              <1> ;
  1743                              <1> ; The break key is looked at here, so at every word call and loop-back (and
  1744                              <1> ; block entry and '{'), but only one time in 256: V_PCNT counts them.
  1745 0000098A 83EF04              <1> rpush:  sub     edi,4
  1746 0000098D 8917                <1>         mov     [edi],edx
  1747 0000098F FE4D60              <1> rpoll:  dec     byte [V(v_pcnt)]
  1748 00000992 7505                <1>         jnz     .rp1
  1749 00000994 E852FAFFFF          <1>         call    pollk
  1750 00000999 FFE5                <1> .rp1:   jmp     ebp
  1751                              <1> 
  1752                              <1> ; =============================================================================
  1753                              <1> ;  The inner loop: read one character and sort it by range.
  1754                              <1> ;
  1755                              <1> ;    00h          end of program
  1756                              <1> ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes; the checked
  1757                              <1> ;                 build stops on 80h-FFh: X)
  1758                              <1> ;    30h-39h      digit: read a whole number
  1759                              <1> ;    41h-5Ah      A-Z: call the word in that letter's cell
  1760                              <1> ;    61h-7Ah      a-z: push the address of that letter's cell
  1761                              <1> ;    the rest     punctuation: jump through PTAB, 32 entries
  1762                              <1> ; =============================================================================
  1763                              <1> ; Digits: step back onto the first digit and read the whole number.
  1764 0000099B 53                  <1> digit:  push    ebx
  1765 0000099C 4E                  <1>         dec     esi
  1766 0000099D E810F9FFFF          <1>         call    rdnum
  1767 000009A2 FFE5                <1>         jmp     ebp
  1768                              <1> 
  1769                              <1> ; a-z: push the cell's address (the cell is the variable).
  1770 000009A4 53                  <1> lower:  push    ebx
  1771 000009A5 8D9C0000014100      <1>         lea     ebx,[ARENA+LET+eax*2]
  1772 000009AC FFE5                <1>         jmp     ebp
  1773                              <1> ; (digit, lower and ctl are here, before next, to keep the variables after
  1774                              <1> ; next in reach)
  1775 000009AE 0421                <1> ctl:    add     al,21h                  ; back to c; zero only for NUL
  1776 000009B0 7505                <1>         jnz     next                    ; the rest are ignored
  1777 000009B2 E96FFAFFFF          <1>         jmp     endprog
  1778                              <1> %if CHECKED
  1779                              <1> e_hi:   mov     al,'X'                  ; a reserved byte outside a string
  1780                              <1>         jmp     error
  1781                              <1> %endif
  1782                              <1> next:
  1783                              <1> %if CHECKED
  1784                              <1>         call    chkstk                  ; both stacks, once per character
  1785                              <1> %endif
  1786 000009B7 31C0                <1>         xor     eax,eax
  1787 000009B9 AC                  <1>         lodsb
  1788 000009BA 2C21                <1>         sub     al,21h                  ; AL = c - 21h
  1789 000009BC 72F0                <1>         jb      ctl                     ; c < 21h: NUL ends, the rest are ignored
  1790 000009BE 3C0F                <1>         cmp     al,0Fh
  1791 000009C0 7222                <1>         jb      punct                   ; 21h-2Fh: PTAB index 0-14
  1792 000009C2 2C0F                <1>         sub     al,0Fh                  ; AL = c - 30h
  1793 000009C4 3C0A                <1>         cmp     al,0Ah
  1794 000009C6 72D3                <1>         jb      digit                   ; 30h-39h
  1795 000009C8 3C11                <1>         cmp     al,11h
  1796 000009CA 7216                <1>         jb      p3a                     ; 3Ah-40h
  1797 000009CC 2C11                <1>         sub     al,11h                  ; AL = c - 41h
  1798 000009CE 3C1A                <1>         cmp     al,1Ah
  1799 000009D0 72AE                <1>         jb      upper                   ; 41h-5Ah: AL = letter index 0-25
  1800 000009D2 3C20                <1>         cmp     al,20h
  1801 000009D4 720A                <1>         jb      p5b                     ; 5Bh-60h
  1802 000009D6 3C3A                <1>         cmp     al,3Ah
  1803 000009D8 72CA                <1>         jb      lower                   ; 61h-7Ah: AL = 20h-39h (cell +64 bytes)
  1804 000009DA 3C3E                <1>         cmp     al,3Eh
  1805                              <1> %if CHECKED
  1806                              <1>         je      next                    ; 7Fh, DEL: ignored
  1807                              <1>         jae     e_hi                    ; 80h-FFh: reserved
  1808                              <1> %else
  1809 000009DC 73D9                <1>         jae     next                    ; 7Fh-FFh: ignored
  1810                              <1> %endif
  1811 000009DE 2C1A                <1>         sub     al,1Ah                  ; 7Bh-7Eh: -1Eh in all, index 28-31
  1812 000009E0 2C09                <1> p5b:    sub     al,9                    ; 5Bh-60h: -4 in all, index 22-27
  1813 000009E2 0405                <1> p3a:    add     al,5                    ; 3Ah-40h: index 15-21
  1814 000009E4 8A80[16080000]      <1> punct:  mov     al,[ptab+eax]
  1815 000009EA 8D80[E7000000]      <1>         lea     eax,[hbase+eax]
  1816 000009F0 FFE0                <1>         jmp     eax
