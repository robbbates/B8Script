   449                              <1> 
   450                              <1> ; '_' ( n -- addr ): the heap pointer moves by n, a signed count; TOS is
   451                              <1> ; the old pointer. The checked build stops with H if the new top is not
   452                              <1> ; below the limit or is below the program's end (done in 32 bits, so a top
   453                              <1> ; that wraps round is caught too).
   454                              <1> %macro  ALLOCCODE 0
   455                              <1> alloc1: movzx   edx,word [ARENA+HEAP]
   456                              <1> %if CHECKED
   457                              <1>         movsx   eax,bx
   458                              <1>         add     eax,edx
   459                              <1>         cmp     eax,LIMIT
   460                              <1>         jae     e_heap
   461                              <1>         cmp     eax,[V(v_npend)]
   462                              <1>         jb      e_heap
   463                              <1> %endif
   464                              <1>         add     [ARENA+HEAP],bx
   465                              <1>         mov     bx,dx
   466                              <1>         jmp     ebp
   467                              <1> %endmacro
   468                              <1> 
   469                              <1> ; '/' ( a b -- q r ): truncates toward zero, and r takes a's sign: x86's
   470                              <1> ; IDIV does exactly that. It is done in 32 bits, so that -32768 / -1 (whose
   471                              <1> ; quotient, 32768, does not fit in 16) wraps as the spec says instead of
   472                              <1> ; faulting. Dividing by 0 skips the IDIV in an unchecked build (two cells of
   473                              <1> ; no meaning: a and its sign); the checked build stops with Z. (The handler
   474                              <1> ; itself in an unchecked build; in a checked or base one its body, div1;
   475                              <1> ; the fast build's fs_div is another copy.)
   476                              <1> %macro  DIVCODE 0
   477                              <1> %if CHECKED
   478                              <1>         test    bx,bx
   479                              <1>         jz      e_zero
   480                              <1> %endif
   481                              <1>         pop     eax
   482                              <1>         movsx   ecx,bx
   483                              <1> %if QK
   484                              <1>         lea     edx,[ecx-1]             ; (base: b a power of two? See DIVQ)
   485                              <1>         test    edx,ecx
   486                              <1>         jz      %%p
   487                              <1> %%o:
   488                              <1> %endif
   489                              <1>         cwde
   490                              <1>         cdq
   491                              <1> %if CHECKED=0
   492                              <1>         jecxz   %%z
   493                              <1> %endif
   494                              <1>         idiv    ecx
   495                              <1> %%z:    mov     bx,ax
   496                              <1>         push    ebx                     ; q
   497                              <1>         mov     bx,dx                   ; r on top
   498                              <1>         NEXTJ
   499                              <1> %if QK
   500                              <1> %%p:    DIVQ    %%o, %%z
   501                              <1> %endif
   502                              <1> %endmacro
   503                              <1> 
   504                              <1> ; DIVQ (base): '/' by a power of two, 2^k with k from 0 to 14, is shifts,
   505                              <1> ; with IDIV's results: |a| >> k and |a| & (b - 1), both negated if a < 0
   506                              <1> ; (-32768 is its own |a|, as an unsigned 16 bits). EAX = a (its low word),
   507                              <1> ; ECX = b, EDX = b - 1. (A power of two or 0: an unchecked build divides by
   508                              <1> ; 0 the regular way, at %1.) On to %2 with AX = q and DX = r. Shifts cost
   509                              <1> ; more instructions than one IDIV, but far fewer cycles: IDIV takes 20 to
   510                              <1> ; 40 (12 on the newest), the shifts a handful.
   511                              <1> %macro  DIVQ 2
   512                              <1> %if CHECKED=0
   513                              <1>         jecxz   %1
   514                              <1> %endif
   515                              <1>         bsf     ecx,ecx                 ; k
   516                              <1>         test    ax,ax
   517                              <1>         js      %%n
   518                              <1>         and     dx,ax                   ; r
   519                              <1>         shr     ax,cl                   ; q
   520                              <1>         jmp     %2
   521                              <1> %%n:    neg     ax                      ; |a|
   522                              <1>         and     dx,ax
   523                              <1>         shr     ax,cl
   524                              <1>         neg     ax                      ; q
   525                              <1>         neg     dx                      ; r
   526                              <1>         jmp     %2
   527                              <1> %endmacro
   528                              <1> 
   529                              <1> ; PRLOOPCODE: the loop of '$' (h_print; in a checked build the routine
   530                              <1> ; prstr). It prints from EBX to the closing quote.
   531                              <1> %macro  PRLOOPCODE 0
   532                              <1> %%pr:   mov     al,[ebx]
   533                              <1>         inc     ebx
   534                              <1>         cmp     al,22h
   535                              <1> %if CHECKED
   536                              <1>         je      %%pr9
   537                              <1>         test    al,al
   538                              <1>         jz      e_dollar                ; a NUL first: Q
   539                              <1> %else
   540                              <1>         je      h_drop
   541                              <1> %endif
   542                              <1>         cmp     al,'/'
   543                              <1>         jne     prput
   544                              <1>         movzx   eax,byte [ebx]
   545                              <1>         inc     ebx
   546                              <1>         cmp     al,60h
   547                              <1>         jb      %%pr0
   548                              <1>         cmp     al,7Fh
   549                              <1>         jb      pesc
   550                              <1> %%pr0:  and     al,0BFh
   551                              <1> prput:  CALLP   putc                    ; (/~ comes here with its 'H')
   552                              <1>         jmp     %%pr
   553                              <1> %if CHECKED
   554                              <1> %%pr9:  ret
   555                              <1> %endif
   556                              <1> %endmacro
   557                              <1> 
   558                              <1> ; PESCCODE: prstr (checked builds) and the escapes of '$'. (After the
   559                              <1> ; bodies of '[' and '`' in an unchecked build, so that h_print's loop
   560                              <1> ; reaches pesc; after the report in a checked one.)
   561                              <1> %macro  PESCCODE 0
   562                              <1> %if CHECKED
   563                              <1> ; prstr: print the string at EBX, to its closing quote, decoding '/' (this
   564                              <1> ; is '$', and the texts of the report). EBX is left past the quote. A NUL
   565                              <1> ; first is an error: Q.
   566                              <1> prstr:  PRLOOPCODE
   567                              <1> PRLOOP  equ     prstr                   ; (where the escapes go back to)
   568                              <1> %else
   569                              <1> PRLOOP  equ     h_print
   570                              <1> %endif
   571                              <1> 
   572                              <1> ; /~ ( row col addr -- ): the two cells under the string's address go.
   573                              <1> ; It comes before pesc: from there the short jumps reach h_print's loop.
   574                              <1> ; In a checked build the loop is the routine prstr: its return address
   575                              <1> ; goes, and hp1 calls it again afterwards. There each /~ first looks that
   576                              <1> ; its two cells are there, and is s if not, before it prints anything.
   577                              <1> pat:
   578                              <1> %if CHECKED
   579                              <1>         pop     eax
   580                              <1>         lea     eax,[esp+8]             ; ESP + 8 at the empty mark or above:
   581                              <1>         cmp     eax,[V(v_dstop)]        ;   the row or the column isn't there
   582                              <1>         jae     e_under
   583                              <1> %endif
   584                              <1>         call    pcsi
   585                              <1>         pop     eax                     ; the column
   586                              <1>         xchg    eax,[esp]               ; the row (the column waits)
   587                              <1>         call    psgn1
   588                              <1>         mov     al,';'
   589                              <1>         CALLP   putc
   590                              <1>         pop     eax
   591                              <1>         call    psgn1
   592                              <1>         mov     al,'H'
   593                              <1> %if CHECKED
   594                              <1>         CALLP   putc
   595                              <1>         jmp     hp1
   596                              <1> %else
   597                              <1>         jmp     prput
   598                              <1> %endif
   599                              <1> 
   600                              <1> ; pesc: the escapes of '$'. EAX = the character after the '/', 60h to 7Eh,
   601                              <1> ; and EBX points past it. Each goes back into the loop (PRLOOP), but /~ has
   602                              <1> ; the stack to see to.
   603                              <1> ;    /a-/z   print the variable, as '#' does
   604                              <1> ;    /{      clear the screen, the cursor to the top left: ESC [ H ESC [ J
   605                              <1> ;    /}      clear from the cursor to the end of the line: ESC [ K
   606                              <1> ;    /|  /`  show the cursor, hide it: ESC [ ? 2 5 h, ESC [ ? 2 5 l
   607                              <1> ;    /~      ( row col -- ) the cursor to that row and column, from 0:
   608                              <1> ;            ESC [ row+1 ; col+1 H
   609                              <1> pesc:   cmp     al,7Eh
   610                              <1>         je      pat
   611                              <1>         push    PRLOOP                  ; (the others return into the loop)
   612                              <1>         cmp     al,7Bh
   613                              <1>         jae     pcon
   614                              <1>         cmp     al,60h
   615                              <1>         je      phide
   616                              <1>         mov     ax,[ARENA+LET-2*41h+eax*2]  ; a-z: the variable's cell (as in
   617                              <1>         jmp     psgn                    ;   `lower`)
   618                              <1> pcon:   mov     eax,[ptails-4*7Bh+eax*4] ; { | }
   619                              <1> pseq:   push    eax                     ; ESC [ and then the bytes of EAX
   620                              <1>         call    pcsi
   621                              <1>         pop     eax
   622                              <1>         jmp     pch
   623                              <1> phide:  mov     eax,6C35323Fh           ; ? 2 5 l
   624                              <1>         jmp     pseq
   625                              <1> ptails: dd      4A5B1B48h               ; {  H ESC [ J
   626                              <1>         dd      6835323Fh               ; |  ? 2 5 h
   627                              <1>         dd      4Bh                     ; }  K
   628                              <1> ; pcsi: print ESC [. pch: print the bytes of EAX, from the low one up to the
   629                              <1> ; last that is not 0 (at least one). Both use EAX.
   630                              <1> pcsi:   mov     eax,5B1Bh
   631                              <1> pch:    CALLP   putc
   632                              <1>         shr     eax,8
   633                              <1>         jnz     pch
   634                              <1>         ret
   635                              <1> %endmacro
   636                              <1> 
   637                              <1> ; =============================================================================
   638                              <1> ;  Punctuation handlers. PTAB holds one byte per character: its handler's
   639                              <1> ;  distance from hbase, so every handler starts in the 256 bytes from hbase
   640                              <1> ;  (PT checks it). Only the starts must be there: the last handler, '$',
   641                              <1> ;  runs on past the window, and '[', '`' (and '_' in a checked build, and
   642                              <1> ;  '/' in a checked or base one) are stubs that jump to their bodies after
   643                              <1> ;  it. Each handler starts
   644                              <1> ;  with EBX = TOS and EAX, ECX, EDX free, and ends with JMP EBP.
   645                              <1> ;  (Two other layouts were tried: handlers 2-aligned with the table holding
   646                              <1> ;  half the distance, which costs a NOP after every handler of odd length,
   647                              <1> ;  about 22 bytes; and the Z80's two 256-byte windows, whose dispatcher is 7
   648                              <1> ;  bytes longer and whose handlers must be in table order, which costs near
   649                              <1> ;  jumps.)
   650                              <1> ; =============================================================================
   651                              <1> hbase:
   652                              <1> ; ']' returns: pop an address and jump to it.
   653 0000011C 8B37                <1> h_ret:  mov     esi,[edi]
   654 0000011E AF                  <1> rdrop:  scasd                           ; drop the return stack's top
   655 0000011F FFE5                <1> nx:     jmp     ebp
   656                              <1> 
   657                              <1> ; '\' ( flag -- ): true skips to the next ')' or ']' at this level; ')'
   658                              <1> ; drops the block start, ']' returns. No closer at all ends the program.
   659 00000121 6685DB              <1> h_break:test    bx,bx
   660 00000124 5B                  <1>         pop     ebx
   661 00000125 74F8                <1>         jz      nx
   662 00000127 E8E9040000          <1>         call    skip
   663 0000012C 84C0                <1>         test    al,al                   ; skip returns 0 for ')'
   664 0000012E 75EC                <1>         jnz     h_ret
   665 00000130 EBEC                <1>         jmp     rdrop
   666                              <1> 
   667                              <1> ; ')' ( flag -- ): true jumps back to the block start (and keeps it); false
   668                              <1> ; drops it and carries on. The loop-back looks at the break key.
   669 00000132 6685DB              <1> h_close:test    bx,bx
   670 00000135 5B                  <1>         pop     ebx
   671 00000136 74E6                <1>         jz      rdrop
   672 00000138 8B37                <1>         mov     esi,[edi]
   673 0000013A EBC9                <1>         jmp     rpoll
   674                              <1> 
   675                              <1> ; '(' ( flag -- ): true pushes the block start and enters; false skips to
   676                              <1> ; the matching ')'.
   677 0000013C 6685DB              <1> h_open: test    bx,bx
   678 0000013F 5B                  <1>         pop     ebx
   679 00000140 0F84F1000000        <1>         jz      skipo
   680 00000146 89F2                <1>         mov     edx,esi
   681 00000148 EBB6                <1>         jmp     rpush
   682                              <1> 
   683                              <1> ; '{' TOS to the return stack, '}' back.
   684 0000014A 89DA                <1> h_tor:  mov     edx,ebx
   685 0000014C 5B                  <1>         pop     ebx
   686 0000014D EBB1                <1>         jmp     rpush
   687 0000014F 53                  <1> h_fromr:push    ebx
   688 00000150 8B1F                <1>         mov     ebx,[edi]
   689 00000152 EBCA                <1>         jmp     rdrop
   690                              <1> 
   691                              <1> ; '@' fetches a cell.
   692 00000154 668B1B              <1> h_fetch:mov     bx,[ebx]
   693 00000157 FFE5                <1>         jmp     ebp
   694                              <1> 
   695                              <1> ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
   696                              <1> ; '-' has two jobs: directly before a digit it starts a negative number.
   697 00000159 8A06                <1> h_sub:  mov     al,[esi]
   698 0000015B 2C30                <1>         sub     al,'0'
   699 0000015D 3C0A                <1>         cmp     al,10
   700 0000015F 72B0                <1>         jb      negnum
   701 00000161 66F7DB              <1>         neg     bx                      ; a - b = a + (-b): on into '+'
   702 00000164 5A                  <1> h_add:  pop     edx
   703 00000165 6601D3              <1>         add     bx,dx
   704 00000168 FFE5                <1>         jmp     ebp
   705                              <1> 
   706 0000016A 5A                  <1> h_and:  pop     edx
   707 0000016B 6621D3              <1>         and     bx,dx
   708 0000016E FFE5                <1>         jmp     ebp
   709 00000170 5A                  <1> h_or:   pop     edx
   710 00000171 6609D3              <1>         or      bx,dx
   711 00000174 FFE5                <1>         jmp     ebp
   712 00000176 5A                  <1> h_xor:  pop     edx
   713 00000177 6631D3              <1>         xor     bx,dx
   714 0000017A FFE5                <1>         jmp     ebp
   715 0000017C 66F7D3              <1> h_not:  not     bx
   716 0000017F FFE5                <1>         jmp     ebp
   717 00000181 5A                  <1> h_mul:  pop     edx
   718 00000182 660FAFDA            <1>         imul    bx,dx                   ; the low 16 bits, signed or not
   719 00000186 FFE5                <1>         jmp     ebp
   720                              <1> 
   721                              <1> ; Signed compares. '<' swaps the two cells and is then '>': a > b is b < a.
   722                              <1> ; Flipping both sign bits turns the signed compare into an unsigned one, and
   723                              <1> ; SBB turns the carry into -1 or 0 with no branch.
   724 00000188 871C24              <1> h_lt:   xchg    ebx,[esp]
   725 0000018B 5A                  <1> h_gt:   pop     edx                     ; DX = a, BX = b
   726 0000018C 80F780              <1>         xor     bh,80h
   727 0000018F 80F680              <1>         xor     dh,80h
   728 00000192 6639D3              <1>         cmp     bx,dx                   ; carry if b < a
   729 00000195 6619DB              <1> tf:     sbb     bx,bx
   730 00000198 FFE5                <1>         jmp     ebp
