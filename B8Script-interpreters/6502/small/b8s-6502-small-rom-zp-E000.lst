E21D   D0 E6                  BNE   ln3   ; always: echo it
E21F   88           LN4:      DEY      ; Backspace: one back, and echo it,
E220   10 E3                  BPL   ln3   
E222   C8                     INY      ;   unless the line was empty
E223   F0 E3                  BEQ   ln2   ; always
E225   99 80 04     LN5:      STA   LINEBUF,Y   ; A = CR
E228   A9 80                  LDA   #<LINEBUF   
E22A   A0 04                  LDY   #>LINEBUF   
E22C   4C 00 E5               JMP   setay   ; TOS = the line's address
