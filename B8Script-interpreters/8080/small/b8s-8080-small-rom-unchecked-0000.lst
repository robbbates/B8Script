0193   69                     MOV   L,C   ; HL = r
0194   F1                     POP   PSW   
0195   FC 20 00               CM   neg16   ; r's sign
0198   C1                     POP   B   
0199   D5                     PUSH   D   ; q under r
019A                          ;*Macro unroll:  NEXT
019A   F7                     DS   (1-CPM)*(1-FAST),0F7h   
019B                          DS   CPM+FAST-CPM*FAST,0C3h   
019B                          DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
019B                          DS   CPM+FAST-CPM*FAST,ANXT/256   
019B                             ; ---- stack and storage -----------------------------------------------------
019B   E5           H_DUP:    PUSH   H   ; ":"
019C                          ;*Macro unroll:  NEXT
019C   F7                     DS   (1-CPM)*(1-FAST),0F7h   
019D                          DS   CPM+FAST-CPM*FAST,0C3h   
019D                          DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
019D                          DS   CPM+FAST-CPM*FAST,ANXT/256   
019D   E3           H_SWAP:   XTHL      ; "%"
019E                          ;*Macro unroll:  NEXT
019E   F7                     DS   (1-CPM)*(1-FAST),0F7h   
019F                          DS   CPM+FAST-CPM*FAST,0C3h   
019F                          DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
019F                          DS   CPM+FAST-CPM*FAST,ANXT/256   
019F                             ; (The checked build tests the address before it takes the value off the
019F                             ; stack, so that an error report shows both.)
019F                H_STORE:      ; "!" ( n addr -- )
019F                          IF   CHECKED   
                              CALL   chkst   
019F                          ENDIF      
019F   D1                     POP   D   
01A0   73                     MOV   M,E   
01A1   23                     INX   H   
01A2   72                     MOV   M,D   
01A3                          ;*Macro unroll:  DROP
01A3   DF                     DS   (1-CPM)*(1-FAST),0DFh   
01A4                          DS   CPM*(1-FAST),0C3h   
01A4                          DS   CPM*(1-FAST),ADRP&0FFh   
01A4                          DS   CPM*(1-FAST),ADRP/256   
01A4                          DS   FAST,0E1h   
01A4                          DS   FAST,0C3h   
01A4                          DS   FAST,ANXT&0FFh   
01A4                          DS   FAST,ANXT/256   
01A4                H_CSTORE:      ; "." ( c addr -- )
01A4                          IF   CHECKED   
                              CALL   chkst   
01A4                          ENDIF      
01A4   D1                     POP   D   
01A5   73                     MOV   M,E   
01A6                          ;*Macro unroll:  DROP
01A6   DF                     DS   (1-CPM)*(1-FAST),0DFh   
01A7                          DS   CPM*(1-FAST),0C3h   
01A7                          DS   CPM*(1-FAST),ADRP&0FFh   
01A7                          DS   CPM*(1-FAST),ADRP/256   
01A7                          DS   FAST,0E1h   
01A7                          DS   FAST,0C3h   
01A7                          DS   FAST,ANXT&0FFh   
01A7                          DS   FAST,ANXT/256   
01A7                             ; ---- console ---------------------------------------------------------------
01A7                             ; 22h pushes the address of the text after it and skips the string.
01A7   E5           H_STR:    PUSH   H   
01A8   60                     MOV   H,B   
01A9   69                     MOV   L,C   
01AA   CD 20 03               CALL   skipstr   
01AD                          IF   CHECKED   
                              ORA   A   ; 0: the text ran out before the closing quote
                              JZ   e_quote   
01AD                          ENDIF      
01AD                          ;*Macro unroll:  NEXT
01AD   F7                     DS   (1-CPM)*(1-FAST),0F7h   
01AE                          DS   CPM+FAST-CPM*FAST,0C3h   
01AE                          DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
01AE                          DS   CPM+FAST-CPM*FAST,ANXT/256   
01AE                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
01AE                             ; 60h to 7Eh is one of the escapes at pesc; "/" plus any other character
01AE                             ; clears that character"s bit 6 (/M is CR, and / then DEL gives "?"; "/',
01AE                             ; '"' and '?' have no bit 6, so //, /" and /? give themselves).
01AE                          IF   1-CHECKED   
01AE   C3 A0 02     H_PRINT:   JMP   prlp   ; (the loop is with the escapes, out of the
01B1                PRLOOP:   EQU   prlp   ;   way of the handlers, which must fit in
01B1                PRAGAIN:   EQU   prlp   ;   the image's first two pages)
01B1                          ENDIF      
01B1                          IF   CHECKED   
                                 ; (The checked build has the loop as a routine, prstr, which the error
                                 ; report uses too. The address is kept meanwhile, for a report: it shows
                                 ; the stack as it was before the "$". /~ comes back to hp1.)
                    H_PRINT:   SHLD   PSAVE   
                    HP1:      CALL   prstr   
                              ;*Macro unroll:  DROP
                              DS   (1-CPM)*(1-FAST),0DFh   
                              DS   CPM*(1-FAST),0C3h   
                              DS   CPM*(1-FAST),ADRP&0FFh   
                              DS   CPM*(1-FAST),ADRP/256   
                              DS   FAST,0E1h   
                              DS   FAST,0C3h   
                              DS   FAST,ANXT&0FFh   
                              DS   FAST,ANXT/256   
01B1                          ENDIF      
01B1   7D           H_EMIT:   MOV   A,L   ; "'"
01B2                          ;*Macro unroll:  PUTA
01B2   EF                     DS   1-CPM,0EFh   
01B3                          DS   CPM,0CDh   
01B3                          DS   CPM,APUT&0FFh   
01B3                          DS   CPM,APUT/256   
01B3                          ;*Macro unroll: h_drop: DROP                    ; ';' is this one byte
01B3   DF           H_DROP:   DS   (1-CPM)*(1-FAST),0DFh   ; ";" is this one byte
01B4                          DS   CPM*(1-FAST),0C3h   
01B4                          DS   CPM*(1-FAST),ADRP&0FFh   
01B4                          DS   CPM*(1-FAST),ADRP/256   
01B4                          DS   FAST,0E1h   
01B4                          DS   FAST,0C3h   
01B4                          DS   FAST,ANXT&0FFh   
01B4                          DS   FAST,ANXT/256   
01B4                             ; "#" prints TOS as a signed decimal number, with no space after it.
01B4   C5           H_NUM:    PUSH   B   
01B5   CD 85 02               CALL   psgn   
01B8   C1                     POP   B   
01B9                          ;*Macro unroll:  DROP
01B9   DF                     DS   (1-CPM)*(1-FAST),0DFh   
01BA                          DS   CPM*(1-FAST),0C3h   
01BA                          DS   CPM*(1-FAST),ADRP&0FFh   
01BA                          DS   CPM*(1-FAST),ADRP/256   
01BA                          DS   FAST,0E1h   
01BA                          DS   FAST,0C3h   
01BA                          DS   FAST,ANXT&0FFh   
01BA                          DS   FAST,ANXT/256   
01BA                          IF   CHECKED   ; (the checked build has no room to start ","
                    H_CFETCH:   MOV   L,M   ;   as late as the unchecked one does: see
                              MVI   H,0   ;   the end of "?")
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0C3h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
01BA                          ENDIF      
01BA                             ; "?" ( n -- c ) or ( -n -- addr )
01BA                             ;   n > 0: wait about n ms for a key; 0 if none came
01BA                             ;   n = 0: wait for a key
01BA                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
01BA                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
01BA   7C           H_KEY:    MOV   A,H   
01BB   B7                     ORA   A   
01BC   FA DC 01               JM   line   
01BF   1E 28        KT1:      MVI   E,MSLOOP   ; one millisecond, roughly
01C1   CD 72 03     KT2:      CALL   getk   
01C4   C2 D8 01               JNZ   kt3   
01C7   1D                     DCR   E   
01C8   C2 C1 01               JNZ   kt2   
01CB   7C                     MOV   A,H   ; 0? never counts down: it waits
01CC   B5                     ORA   L   
01CD   CA BF 01               JZ   kt1   
01D0   2B                     DCX   H   
01D1   7C                     MOV   A,H   
01D2   B5                     ORA   L   
01D3   C2 BF 01               JNZ   kt1   ; A = 0 if the time ran out
01D6                          IF   1-CHECKED   
01D6   FE                     DB   0FEh   ; (CPI: steps over the one byte of ",")
01D7   7E           H_CFETCH:   MOV   A,M   ; "," shares "?"s ending: A becomes TOS
01D8                          ENDIF      
01D8   6F           KT3:      MOV   L,A   
01D9   26 00                  MVI   H,0   
01DB                          ;*Macro unroll:  NEXT
01DB   F7                     DS   (1-CPM)*(1-FAST),0F7h   
01DC                          DS   CPM+FAST-CPM*FAST,0C3h   
01DC                          DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
01DC                          DS   CPM+FAST-CPM*FAST,ANXT/256   
01DC                             ; Backspace takes the last character back (and is echoed as
01DC                             ; it is), CR ends (stored, not echoed), every other key is stored and
01DC                             ; echoed until the line is full. The line buffer starts at offset 80h
01DC                             ; of its page, so L alone is the place in the line: D holds the L of
01DC                             ; a full line.
01DC   11 7F 00     LINE:     LXI   D,127   ; TOS is minus the count: adding 127 carries
01DF   19                     DAD   D   ;   only for 1 to 127, and leaves 127 - count
01E0   9F                     SBB   A   
01E1   A5                     ANA   L   ; (0 for a count that is too big)
01E2   2F                     CMA      
01E3   57                     MOV   D,A   ; D = the L of a full line: 80h + count, FFh
01E4                             ;   at most
01E4   21 80 82               LXI   H,LINEBUF   
01E7   CD 72 03     LN2:      CALL   getk   
01EA   CA E7 01               JZ   ln2   
01ED   FE 0D                  CPI   13   
01EF   CA 0C 02               JZ   ln5   
01F2   FE 08                  CPI   8   
01F4   CA 04 02               JZ   ln4   
01F7   5F                     MOV   E,A   
01F8   7D                     MOV   A,L   
01F9   BA                     CMP   D   
01FA   CA E7 01               JZ   ln2   ; full
01FD   73                     MOV   M,E   
01FE   2C                     INR   L   
01FF   7B                     MOV   A,E   
0200                          ;*Macro unroll: ln3:    PUTA
0200   EF           LN3:      DS   1-CPM,0EFh   
0201                          DS   CPM,0CDh   
0201                          DS   CPM,APUT&0FFh   
0201                          DS   CPM,APUT/256   
0201   C3 E7 01               JMP   ln2   
0204   2D           LN4:      DCR   L   ; Backspace: one back, and echo it,
0205   FA 00 02               JM   ln3   ;   unless the line was empty (L left the
0208   2C                     INR   L   ;   upper half of the page)
0209   C3 E7 01               JMP   ln2   
020C   77           LN5:      MOV   M,A   ; the CR
020D   2E 80                  MVI   L,LINEBUF & 0FFh   
020F                          ;*Macro unroll:  NEXT
020F   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0210                          DS   CPM+FAST-CPM*FAST,0C3h   
0210                          DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
0210                          DS   CPM+FAST-CPM*FAST,ANXT/256   
0210                             ; =============================================================================
0210                             ;  Dispatch table: the low byte of each handler's address, in code order.
0210                             ;  It must not cross a page (the dispatcher only adds to its low byte).
0210                             ; =============================================================================
0210                             ; The handlers of the first NPG1 characters start in the image's second page.
0210                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
0210                             ; differs between the builds, so the count is worked out here.
0210                             ; (One division to a line: asm80 only rounds down when it stores a value.)
0210                          IF   1-FAST   
0210                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
0210                PGBRK:    EQU   (h_break-BASE)/256   
0210                PGDEF:    EQU   (h_def-BASE)/256   
0210                PGFET:    EQU   (h_fetch-BASE)/256   
0210                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
0210                          ENDIF      
0210                          IF   (1-FAST)*(1-PTLATE)   
0210                PTAB:        
0210                          ;*Macro unroll:  PTABLE
0210   9F                     DB   h_store & 0FFh   
0211   A7                     DB   h_str & 0FFh   
0212   B4                     DB   h_num & 0FFh   
0213   AE                     DB   h_print & 0FFh   
0214   9D                     DB   h_swap & 0FFh   
0215   37                     DB   h_and & 0FFh   
0216   B1                     DB   h_emit & 0FFh   
0217   13                     DB   h_open & 0FFh   
0218   1F                     DB   h_close & 0FFh   
0219   5C                     DB   h_mul & 0FFh   
021A   34                     DB   h_add & 0FFh   
021B   D7                     DB   h_cfetch & 0FFh   
021C   2B                     DB   h_sub & 0FFh   
021D   A4                     DB   h_cstore & 0FFh   
021E   78                     DB   h_div & 0FFh   
021F   9B                     DB   h_dup & 0FFh   
0220   B3                     DB   h_drop & 0FFh   
0221   40                     DB   h_lt & 0FFh   
0222   4F                     DB   h_eq & 0FFh   
0223   3F                     DB   h_gt & 0FFh   
0224   BA                     DB   h_key & 0FFh   
0225   0E                     DB   h_fetch & 0FFh   
0226   EE                     DB   h_def & 0FFh   
0227   DF                     DB   h_break & 0FFh   
0228   DA                     DB   h_ret & 0FFh   
0229   7C                     DB   h_xor & 0FFh   
022A   8F                     DB   h_alloc & 0FFh   
022B   BD                     DB   h_grave & 0FFh   
022C   14                     DB   h_tor & 0FFh   
022D   84                     DB   h_or & 0FFh   
022E   1D                     DB   h_fromr & 0FFh   
022F   8C                     DB   h_not & 0FFh   
0230                PTABEND:      
0230                          ENDIF      
0230                             ; =============================================================================
0230                             ;  Routines (no handler starts past this point)
0230                             ; =============================================================================
0230                             ; Digits: step back onto the first digit and read the whole number.
0230   E5           DIGIT:    PUSH   H   
0231   0B                     DCX   B   
0232   CD 3C 02               CALL   rdnum   
0235                          ;*Macro unroll:  NEXT
0235   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0236                          DS   CPM+FAST-CPM*FAST,0C3h   
0236                          DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
0236                          DS   CPM+FAST-CPM*FAST,ANXT/256   
0236                             ; negnum: "-" directly before a digit: read the number, negate it.
0236   E5           NEGNUM:   PUSH   H   
0237   CD 3C 02               CALL   rdnum   
023A                          ;*Macro unroll:  NEGH
023A   E7                     DS   1-CPM,0E7h   
023B                          DS   CPM,0CDh   
023B                          DS   CPM,ANEG&0FFh   
023B                          DS   CPM,ANEG/256   
023B                          ;*Macro unroll:  NEXT
023B   F7                     DS   (1-CPM)*(1-FAST),0F7h   
023C                          DS   CPM+FAST-CPM*FAST,0C3h   
023C                          DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
023C                          DS   CPM+FAST-CPM*FAST,ANXT/256   
023C                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
023C                             ; non-digit. Values wrap at 16 bits, as the spec says.
023C   21 00 00     RDNUM:    LXI   H,0   
023F   0A           RDN1:     LDAX   B   
0240   D6 30                  SUI   "0"   
0242   FE 0A                  CPI   10   
0244   D0                     RNC      
0245   03                     INX   B   
0246   54                     MOV   D,H   
0247   5D                     MOV   E,L   
0248   29                     DAD   H   
0249   29                     DAD   H   
024A   19                     DAD   D   
024B   29                     DAD   H   ; HL * 10
024C   5F                     MOV   E,A   
024D   16 00                  MVI   D,0   
024F   19                     DAD   D   
0250   C3 3F 02               JMP   rdn1   
0253                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, BC = remainder.
0253                             ; Uses A, BC; the caller saves the IP. HL holds the dividend and, as its bits
0253                             ; leave at the top, the quotient bits arrive at the bottom. The loop counter
0253                             ; lives on the stack, since A is busy with the shifts.
0253                             ; Dividing by 2 is one shift (the spec wants that fast).
0253   01 00 00     UDIV:     LXI   B,0   
0256                          IF   1-QK   
0256   7B                     MOV   A,E   
0257   EE 02                  XRI   2   
0259   B2                     ORA   D   
025A   C2 67 02               JNZ   udv0   
025D   B4                     ORA   H   ; A was 0, and the carry is clear
025E   1F                     RAR      
025F   67                     MOV   H,A   
0260   7D                     MOV   A,L   
0261   1F                     RAR      
0262   6F                     MOV   L,A   ; the quotient
0263   78                     MOV   A,B   
0264   17                     RAL      
0265   4F                     MOV   C,A   ; the remainder: the bit that fell out
0266   C9                     RET      
0267                          ENDIF      
0267                          IF   QK   
                                 ; (The builds with room divide by any power of two with shifts: 2, and 32,
                                 ; 64, 256 and the like, which fixed point and byte work use all the time.)
                              MOV   A,D   
                              ORA   A   
                              JNZ   uq1   ; 256 and up
                              ORA   E   
                              JZ   udv0   ; by 0: the long way (it means nothing anyway)
                              DCR   A   
                              ANA   E   
                              JNZ   udv0   ; not a power of two
                              MOV   A,E   ; by 2^k below 256: q = HL >> k, and
                              DCR   A   ;   r = L & (2^k - 1)
                              ANA   L   
                              MOV   C,A   
0267                          ENDIF      
0267                          IF   QK*(1-FAST)   
                    UQ2:      MOV   A,E   ; one shift for each halving of E down to 1
                              ORA   A   
                              RAR      
                              RC      
                              MOV   E,A   
                              MOV   A,H   ; (the carry is clear: E's bit 0 was 0)
                              RAR      
                              MOV   H,A   
                              MOV   A,L   
                              RAR      
                              MOV   L,A   
                              JMP   uq2   
0267                          ENDIF      
0267                          IF   FAST   
                                 ; (the fast build: the shifts unrolled. By 16 to 128 it is fewer shifts to
                                 ; go the other way: A:HL up by 8 - k, and A:H is the quotient)
                    UQ2:      MOV   A,E   
                              CPI   16   
                              JNC   uqh   
                              CPI   2   
                              RC      ; by 1
                              JZ   ur1   
                              CPI   4   
                              JZ   ur2   
                    UR3:         
                              MOV   A,H   
                              ORA   A   
                              RAR      
                              MOV   H,A   
                              MOV   A,L   
                              RAR      
                              MOV   L,A   
                    UR2:         
                              MOV   A,H   
                              ORA   A   
                              RAR      
                              MOV   H,A   
                              MOV   A,L   
                              RAR      
                              MOV   L,A   
                    UR1:         
                              MOV   A,H   
                              ORA   A   
                              RAR      
                              MOV   H,A   
                              MOV   A,L   
                              RAR      
                              MOV   L,A   
                              RET      
                    UQH:      CPI   64   
                              MVI   A,0   
                              JZ   ul2   
                              JNC   ul1   
                              MOV   A,E   
                              CPI   32   
                              MVI   A,0   
                              JZ   ul3   
                              DAD   H   ; by 16
                              ADC   A   
                    UL3:      DAD   H   
                              ADC   A   
                    UL2:      DAD   H   
                              ADC   A   
                    UL1:      DAD   H   
                              ADC   A   
                              MOV   L,H   
                              MOV   H,A   
                              RET      
0267                          ENDIF      
0267                          IF   QK   
                    UQ1:      MOV   A,E   
                              ORA   A   
                              JNZ   udv0   
                              MOV   A,D   
                              DCR   A   
                              ANA   D   
                              JNZ   udv0   ; not a power of two
                              MOV   A,D   ; by 2^k, 256 and up: r = HL & (2^k - 1), and
                              DCR   A   ;   q = H >> (k - 8)
                              ANA   H   
                              MOV   B,A   
                              MOV   C,L   
                              MOV   L,H   
                              MVI   H,0   
                              MOV   E,D   
                              JMP   uq2   
0267                          ENDIF      
0267                          IF   1-FAST   
0267   3E 10        UDV0:     MVI   A,16   
0269   F5                     PUSH   PSW   
026A   29           UDV1:     DAD   H   ; next dividend bit into the carry
026B   79                     MOV   A,C   
026C   17                     RAL      
026D   4F                     MOV   C,A   
026E   78                     MOV   A,B   
026F   17                     RAL      
0270   47                     MOV   B,A   ; BC = BC*2 + bit
0271   79                     MOV   A,C   
0272   93                     SUB   E   
0273   78                     MOV   A,B   
0274   9A                     SBB   D   ; carry if BC < DE
0275   DA 7D 02               JC   udv2   
0278   47                     MOV   B,A   ; BC - DE (high byte; A holds it)
0279   79                     MOV   A,C   
027A   93                     SUB   E   
027B   4F                     MOV   C,A   
027C   2C                     INR   L   ; quotient bit
027D   F1           UDV2:     POP   PSW   
027E   3D                     DCR   A   
027F   F5                     PUSH   PSW   
0280   C2 6A 02               JNZ   udv1   
0283   F1                     POP   PSW   
0284   C9                     RET      
0285                          ENDIF      
0285                          IF   FAST   
                                 ; (the fast build: the same 16 rounds, unrolled; and a dividend below 256
                                 ; starts 8 bits up and takes only the last 8, since its first 8 would only
                                 ; shift zeros)
                    UDV0:     MOV   A,H   
                              ORA   A   
                              JZ   uvs   
                    UV0:      DAD   H   
                              MOV   A,C   
                              RAL      
                              MOV   C,A   
                              MOV   A,B   
                              RAL      
                              MOV   B,A   ; BC = BC*2 + bit
                              MOV   A,C   
                              SUB   E   
                              MOV   A,B   
                              SBB   D   ; carry if BC < DE
                              JC   uw0   
                              MOV   B,A   
                              MOV   A,C   
                              SUB   E   
                              MOV   C,A   
                              INR   L   ; quotient bit
                    UW0:         
                    UV1:      DAD   H   
                              MOV   A,C   
                              RAL      
                              MOV   C,A   
                              MOV   A,B   
                              RAL      
                              MOV   B,A   ; BC = BC*2 + bit
                              MOV   A,C   
                              SUB   E   
                              MOV   A,B   
                              SBB   D   ; carry if BC < DE
                              JC   uw1   
                              MOV   B,A   
                              MOV   A,C   
                              SUB   E   
                              MOV   C,A   
                              INR   L   ; quotient bit
                    UW1:         
                    UV2:      DAD   H   
                              MOV   A,C   
                              RAL      
                              MOV   C,A   
                              MOV   A,B   
                              RAL      
                              MOV   B,A   ; BC = BC*2 + bit
                              MOV   A,C   
                              SUB   E   
                              MOV   A,B   
                              SBB   D   ; carry if BC < DE
                              JC   uw2   
                              MOV   B,A   
                              MOV   A,C   
                              SUB   E   
                              MOV   C,A   
                              INR   L   ; quotient bit
                    UW2:         
                    UV3:      DAD   H   
                              MOV   A,C   
                              RAL      
                              MOV   C,A   
                              MOV   A,B   
                              RAL      
                              MOV   B,A   ; BC = BC*2 + bit
                              MOV   A,C   
                              SUB   E   
                              MOV   A,B   
                              SBB   D   ; carry if BC < DE
                              JC   uw3   
                              MOV   B,A   
                              MOV   A,C   
                              SUB   E   
                              MOV   C,A   
                              INR   L   ; quotient bit
                    UW3:         
                    UV4:      DAD   H   
                              MOV   A,C   
                              RAL      
                              MOV   C,A   
                              MOV   A,B   
                              RAL      
                              MOV   B,A   ; BC = BC*2 + bit
                              MOV   A,C   
                              SUB   E   
                              MOV   A,B   
                              SBB   D   ; carry if BC < DE
                              JC   uw4   
                              MOV   B,A   
                              MOV   A,C   
                              SUB   E   
                              MOV   C,A   
                              INR   L   ; quotient bit
                    UW4:         
                    UV5:      DAD   H   
                              MOV   A,C   
                              RAL      
                              MOV   C,A   
                              MOV   A,B   
                              RAL      
                              MOV   B,A   ; BC = BC*2 + bit
                              MOV   A,C   
                              SUB   E   
                              MOV   A,B   
                              SBB   D   ; carry if BC < DE
                              JC   uw5   
                              MOV   B,A   
                              MOV   A,C   
                              SUB   E   
                              MOV   C,A   
                              INR   L   ; quotient bit
                    UW5:         
                    UV6:      DAD   H   
                              MOV   A,C   
                              RAL      
                              MOV   C,A   
                              MOV   A,B   
                              RAL      
                              MOV   B,A   ; BC = BC*2 + bit
                              MOV   A,C   
                              SUB   E   
                              MOV   A,B   
                              SBB   D   ; carry if BC < DE
                              JC   uw6   
                              MOV   B,A   
                              MOV   A,C   
                              SUB   E   
                              MOV   C,A   
                              INR   L   ; quotient bit
                    UW6:         
                    UV7:      DAD   H   
                              MOV   A,C   
                              RAL      
                              MOV   C,A   
                              MOV   A,B   
                              RAL      
                              MOV   B,A   ; BC = BC*2 + bit
                              MOV   A,C   
                              SUB   E   
                              MOV   A,B   
                              SBB   D   ; carry if BC < DE
                              JC   uw7   
                              MOV   B,A   
                              MOV   A,C   
                              SUB   E   
                              MOV   C,A   
                              INR   L   ; quotient bit
                    UW7:         
                    UV8:      DAD   H   
                              MOV   A,C   
                              RAL      
                              MOV   C,A   
                              MOV   A,B   
                              RAL      
                              MOV   B,A   ; BC = BC*2 + bit
                              MOV   A,C   
                              SUB   E   
                              MOV   A,B   
                              SBB   D   ; carry if BC < DE
                              JC   uw8   
                              MOV   B,A   
                              MOV   A,C   
                              SUB   E   
                              MOV   C,A   
                              INR   L   ; quotient bit
                    UW8:         
                    UV9:      DAD   H   
                              MOV   A,C   
                              RAL      
                              MOV   C,A   
                              MOV   A,B   
                              RAL      
                              MOV   B,A   ; BC = BC*2 + bit
                              MOV   A,C   
                              SUB   E   
                              MOV   A,B   
                              SBB   D   ; carry if BC < DE
                              JC   uw9   
                              MOV   B,A   
                              MOV   A,C   
                              SUB   E   
                              MOV   C,A   
                              INR   L   ; quotient bit
                    UW9:         
                    UV10:     DAD   H   
                              MOV   A,C   
                              RAL      
                              MOV   C,A   
                              MOV   A,B   
                              RAL      
                              MOV   B,A   ; BC = BC*2 + bit
                              MOV   A,C   
                              SUB   E   
                              MOV   A,B   
                              SBB   D   ; carry if BC < DE
                              JC   uw10   
                              MOV   B,A   
                              MOV   A,C   
                              SUB   E   
                              MOV   C,A   
                              INR   L   ; quotient bit
                    UW10:        
                    UV11:     DAD   H   
                              MOV   A,C   
                              RAL      
                              MOV   C,A   
                              MOV   A,B   
                              RAL      
                              MOV   B,A   ; BC = BC*2 + bit
                              MOV   A,C   
                              SUB   E   
                              MOV   A,B   
                              SBB   D   ; carry if BC < DE
                              JC   uw11   
                              MOV   B,A   
                              MOV   A,C   
                              SUB   E   
                              MOV   C,A   
                              INR   L   ; quotient bit
                    UW11:        
                    UV12:     DAD   H   
                              MOV   A,C   
                              RAL      
                              MOV   C,A   
                              MOV   A,B   
                              RAL      
                              MOV   B,A   ; BC = BC*2 + bit
                              MOV   A,C   
                              SUB   E   
                              MOV   A,B   
                              SBB   D   ; carry if BC < DE
                              JC   uw12   
                              MOV   B,A   
                              MOV   A,C   
                              SUB   E   
                              MOV   C,A   
                              INR   L   ; quotient bit
                    UW12:        
                    UV13:     DAD   H   
                              MOV   A,C   
                              RAL      
                              MOV   C,A   
                              MOV   A,B   
                              RAL      
                              MOV   B,A   ; BC = BC*2 + bit
                              MOV   A,C   
                              SUB   E   
                              MOV   A,B   
                              SBB   D   ; carry if BC < DE
                              JC   uw13   
                              MOV   B,A   
                              MOV   A,C   
                              SUB   E   
                              MOV   C,A   
                              INR   L   ; quotient bit
                    UW13:        
                    UV14:     DAD   H   
                              MOV   A,C   
                              RAL      
                              MOV   C,A   
                              MOV   A,B   
                              RAL      
                              MOV   B,A   ; BC = BC*2 + bit
                              MOV   A,C   
                              SUB   E   
                              MOV   A,B   
                              SBB   D   ; carry if BC < DE
                              JC   uw14   
                              MOV   B,A   
                              MOV   A,C   
                              SUB   E   
                              MOV   C,A   
                              INR   L   ; quotient bit
                    UW14:        
                    UV15:     DAD   H   
                              MOV   A,C   
                              RAL      
                              MOV   C,A   
                              MOV   A,B   
                              RAL      
                              MOV   B,A   ; BC = BC*2 + bit
                              MOV   A,C   
                              SUB   E   
                              MOV   A,B   
                              SBB   D   ; carry if BC < DE
                              JC   uw15   
                              MOV   B,A   
                              MOV   A,C   
                              SUB   E   
                              MOV   C,A   
