  1841                              <1> ; =============================================================================
  1842                              <1> ;  The imports: kernel32.dll only. An import directory entry, the import
  1843                              <1> ;  lookup table, the hint/name entries and the DLL's name; then the import
  1844                              <1> ;  address table, which the loader fills in, right below `next` (with the
  1845                              <1> ;  routine pointers after it), so that CALL [EBP+d8] reaches it.
  1846                              <1> ; =============================================================================
  1847                              <1> %macro  IMPORTS 1
  1848                              <1>         IMP     GetStdHandle
  1849                              <1>         IMP     GetConsoleMode
  1850                              <1>         IMP     SetConsoleMode
  1851                              <1>         IMP     GetCommandLineA
  1852                              <1>         IMP     CreateFileA
  1853                              <1>         IMP     ReadFile
  1854                              <1>         IMP     WriteFile
  1855                              <1> %if EDITOR
  1856                              <1>         IMP     CloseHandle             ; (a runner leaves its file open)
  1857                              <1> %endif
  1858                              <1>         IMP     WaitForMultipleObjects
  1859                              <1>         IMP     CreateWaitableTimerExW
  1860                              <1>         IMP     SetWaitableTimer
  1861                              <1>         IMP     ReadConsoleInputA
  1862                              <1>         IMP     ExitProcess
  1863                              <1> %endmacro
  1864 000006C2 00<rep 2h>          <1>         align   4, db 0
  1865 000006C4 [EC06C0FF]          <1> idesc:  dd      ilt-IB                  ; OriginalFirstThunk: the lookup table
  1866 000006C8 00000000            <1>         dd      0                       ; TimeDateStamp
  1867 000006CC 00000000            <1>         dd      0                       ; ForwarderChain
  1868 000006D0 [F607C0FF]          <1>         dd      dllname-IB              ; Name
  1869 000006D4 [0408C0FF]          <1>         dd      iat-IB                  ; FirstThunk: the IAT
  1870 000006D8 00<rep 14h>         <1>         times   20 db 0                 ; the null entry that ends the list
  1871                              <1> idesc_end:
  1872                              <1> %macro  IMP 1
  1873                              <1>         dd      hn_%1-IB
  1874                              <1> %endmacro
