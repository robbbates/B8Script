  2502 00000987 ????????            <1> v_mode: resd    1               ; the console's input mode at the start
  2503                              <1> %if CHECKED
  2504                              <1> v_npend:resd    1               ; the heap's first address (checked '_')
  2505                              <1> v_skat: resd    1               ; where the skip started (checked N)
  2506                              <1> v_str:  resd    1               ; the address '$' prints from (checked Q)
  2507                              <1> %endif
