E375   95 00        SETA:     STA   0,X   ; TOS = A
E377   A9 00                  LDA   #0   
E379   95 01                  STA   1,X   
E37B   60                     RTS      
E37C                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
E37C                             ; drops it and carries on. It uses "]"s code, entered past its SEC: with the
E37C                             ; carry clear, as it is here, the address popped is pushed back.
E37C   20 12 EA     H_CLOSE:   JSR   flag   
E37F   F0 6C                  BEQ   rdrop   
E381                          IF   1-QK   
                              BNE   ret1   ; always
E381                          ENDIF      
E381                          IF   QK   
E381   4C AA E6               JMP   closeq   ; (QK: see Speed-ups)
E384                          ENDIF      
E384                             ; "?" ( n -- c ) or ( -n -- addr )
E384                             ;   n > 0: wait about n ms for a key; 0 if none came
E384                             ;   n = 0: wait for a key
E384                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
E384                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
E384   B5 01        H_KEY:    LDA   1,X   
E386   30 1E                  BMI   line   
E388   A0 28        KT1:      LDY   #MSLOOP   ; one millisecond, roughly
E38A   20 80 E9     KT2:      JSR   getk   
E38D   D0 E6                  BNE   seta   
E38F   88                     DEY      
E390   D0 F8                  BNE   kt2   
E392   B5 00                  LDA   0,X   ; count the millisecond off:
E394   D0 06                  BNE   kt4   
E396   B5 01                  LDA   1,X   
E398   F0 EE                  BEQ   kt1   ; 0? never counts down: it waits
E39A   D6 01                  DEC   1,X   
E39C   D6 00        KT4:      DEC   0,X   
E39E   D0 E8                  BNE   kt1   
E3A0   B5 01                  LDA   1,X   
E3A2   D0 E4                  BNE   kt1   
E3A4   F0 CF                  BEQ   seta   ; always: the time ran out, A = 0
E3A6                             ; ---- no handler starts between here and the next heading --------------------
E3A6                             ; Backspace takes the last character back (and is echoed as it is), CR ends
E3A6                             ; (stored, not echoed), every other key is stored and echoed until the line
E3A6                             ; is full. Y = the length so far; T0 = the most allowed.
E3A6   20 F0 E2     LINE:     JSR   neg   ; TOS = the count, and A = its high byte
E3A9   D0 04                  BNE   ln0   
E3AB   B5 00                  LDA   0,X   
E3AD   10 02                  BPL   ln1   
E3AF   A9 7F        LN0:      LDA   #127   ; more than 127 is taken as 127
E3B1   85 04        LN1:      STA   T0   
E3B3   A0 00                  LDY   #0   
E3B5   F0 03                  BEQ   ln2   ; always
E3B7   20 03 FF     LN3:      JSR   CONOUT   
E3BA   20 80 E9     LN2:      JSR   getk   
E3BD   F0 FB                  BEQ   ln2   
E3BF   C9 0D                  CMP   #13   
E3C1   F0 14                  BEQ   ln5   
E3C3   C9 08                  CMP   #8   
E3C5   F0 0A                  BEQ   ln4   
E3C7   C4 04                  CPY   T0   
E3C9   B0 EF                  BCS   ln2   ; full
E3CB   99 80 04               STA   LINEBUF,Y   
E3CE   C8                     INY      
E3CF   D0 E6                  BNE   ln3   ; always: echo it
E3D1   88           LN4:      DEY      ; Backspace: one back, and echo it,
E3D2   10 E3                  BPL   ln3   
E3D4   C8                     INY      ;   unless the line was empty
E3D5   F0 E3                  BEQ   ln2   ; always
E3D7   99 80 04     LN5:      STA   LINEBUF,Y   ; A = CR
E3DA   A9 80                  LDA   #<LINEBUF   
E3DC   A0 04                  LDY   #>LINEBUF   
E3DE   4C 0D EA               JMP   setay   ; TOS = the line's address
E3E1                             ; =============================================================================
E3E1                             ;  Page 3 of 3: handlers of @ [ \ ] ^ _ ` 00bbIHwg ~
E3E1                             ; =============================================================================
E3E1                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
E3E1                             ; drops the block start, "]" returns.
E3E1   20 12 EA     H_BREAK:   JSR   flag   
E3E4   F0 66                  BEQ   tg1   ; (an RTS)
E3E6                          IF   CHECKED   
                              LDA   #0   ; \ takes either closer
E3E6                          ENDIF      
E3E6   20 C2 E6               JSR   skip   
E3E9   C9 29                  CMP   #")"   
E3EB   D0 06                  BNE   h_ret   
E3ED   68           RDROP:    PLA      
E3EE   68                     PLA      
E3EF   68                     PLA      
E3F0   68                     PLA      ; (the block start's high byte: never 0)
E3F1   D0 28                  BNE   nxt2   ; always
E3F3                             ; "]" returns: pull an address and jump to it. ")" comes in at ret1 with the
E3F3                             ; carry clear, and then the address is pushed back.
E3F3   38           H_RET:    SEC      
E3F4                RET1:        
E3F4   68                     PLA      
E3F5   68                     PLA      ; drop the step frame
E3F6   68                     PLA      
E3F7   85 00                  STA   IP   
E3F9   68                     PLA      
E3FA   85 01                  STA   IP+1   
E3FC   B0 1D                  BCS   nxt2   
E3FE   48                     PHA      ; ")": keep the block start
E3FF   A5 00                  LDA   IP   
E401   48                     PHA      
E402   4C 29 E2               JMP   pnext   ; a loop-back: the break check
E405                             ; "{" TOS to the return stack, "}" return stack to TOS
E405   68           H_TOR:    PLA      
E406   68                     PLA      
E407   B5 01                  LDA   1,X   
