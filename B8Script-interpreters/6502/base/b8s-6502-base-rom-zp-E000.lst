                              ROL   1,X   
                              ROL   0FEh,X   
                              ROL   0FFh,X   
                              SEC      
                              LDA   0FEh,X   
                              SBC   D0   
                              TAY      
                              LDA   0FFh,X   
                              SBC   D1   
                              BCC   uv15   
                              STA   0FFh,X   
                              STY   0FEh,X   
                              INC   0,X   
                    UV15:        
                              RTS      
E4C2                          ENDIF      
E4C2                             ; pesc: the escapes of "$". A = the character after the "/", 60h to 7Eh, and
E4C2                             ; the carry is clear. Each returns into the loop.
E4C2                             ;    /a-/z   print the variable, as "#" does
E4C2                             ;    /{      clear the screen, the cursor to the top left
E4C2                             ;    /}      clear from the cursor to the end of the line
E4C2                             ;    /|  /`  show the cursor, hide it
E4C2                             ;    /~      ( row col addr -- addr ): the cursor to that row and column,
E4C2                             ;            from 0. The two cells under the string's address go.
E4C2                             ; A - 7Bh sorts them: 00bbIDAsIHwgMSwg 2, ~ 3 with the carry set, and ` E5h, a-z
E4C2                             ; E6h-FFh with it clear.
E4C2                          IF   1-ANSI   
E4C2                             ; With ANSI = 0 the machine's routines do the work.
E4C2   E9 7A        PESC:     SBC   #7Ah   ; (the carry is clear: - 7Bh)
E4C4   90 0D                  BCC   pe1   
E4C6   F0 08                  BEQ   pcls   ; {
E4C8   4A                     LSR      ; | 0, } 1, ~ 1; the carry set for | and ~
E4C9   F0 0C                  BEQ   pcur   ; |  show: the carry is set
E4CB   B0 26                  BCS   pat   ; ~
E4CD   4C 0F FF               JMP   CONEOL   ; }
E4D0   4C 0C FF     PCLS:     JMP   CONCLS   
E4D3   C9 E6        PE1:      CMP   #0E6h   
E4D5   B0 03                  BCS   pvar   
E4D7   4C 12 FF     PCUR:     JMP   CONCUR   ; `  hide: the carry is clear
E4DA                          ENDIF      
E4DA                             ; a-z: the carry is set. A + 3Ah is the letter - 41h, as step hands it to
E4DA                             ; lower: that pushes the variable"s address, "@" fetches it, and "#' prints
E4DA                             ; it and drops it: TOS is the string's address again.
E4DA   69 39        PVAR:     ADC   #39h   
E4DC   20 0C E6               JSR   lowp   
E4DF   20 6E E2               JSR   h_fetch   
E4E2   4C 9B E0               JMP   h_num   
E4E5                          IF   ANSI   
                                 ; With ANSI = 1 they are sequences, each a message at MSG, printed by prs,
                                 ; which pesc runs on into.
                    PESC:     LDY   #M_CLS-MSG   
                              SBC   #7Ah   ; (the carry is clear: - 7Bh)
                              BCC   pe1   
                              BEQ   prs   ; {  ESC [ H ESC [ J
                              LDY   #M_SHOW-MSG   
                              LSR      ; | 0, } 1, ~ 1; the carry set for ~
                              BEQ   prs   ; |  ESC [ ? 2 5 h
                              BCS   pat   ; ~
                              LDY   #M_EOL-MSG   ; }  ESC [ K
                              BNE   prs   ; always
                    PE1:      CMP   #0E6h   
                              BCS   pvar   
                              LDY   #M_HIDE-MSG   ; `  ESC [ ? 2 5 l, and on into prs
E4E5                          ENDIF      
E4E5                          IF   CHECKED+ANSI   
E4E5                             ; prs: print the message at MSG+Y; its last byte has bit 7 set. Y ends just
E4E5                             ; past it, at the next message.
E4E5   B9 2F E7     PRS:      LDA   MSG,Y   
E4E8   48                     PHA      
E4E9   29 7F                  AND   #7Fh   
E4EB   20 03 FF               JSR   CONOUT   
E4EE   C8                     INY      
E4EF   68                     PLA      
E4F0   10 F3                  BPL   prs   
E4F2   60                     RTS      
E4F3                          ENDIF      
E4F3                             ; /~: the row is at 4,X, the column at 2,X, the string's address at 0,X.
E4F3                PAT:         
E4F3                          IF   CHECKED   
E4F3   E0 EB                  CPX   #DSE-5   ; fewer than two cells under TOS: s
E4F5   B0 52                  BCS   e_sund   
E4F7                          ENDIF      
E4F7                          IF   1-ANSI   
E4F7   B5 04                  LDA   4,X   ; the row
E4F9   B4 02                  LDY   2,X   ; the column
E4FB   20 15 FF               JSR   CONAT   
E4FE   20 01 E5               JSR   nip   ; two nips leave the address, 4 bytes up
E501   20 D6 E0     NIP:      JSR   h_swap   ; nip: ( a b -- b )
E504   4C 35 E1               JMP   drop   
E507                          ENDIF      
E507                          IF   ANSI   
                                 ; ESC [ row+1 ; col+1 H (ANSI counts from 1). Three swaps put the row on top
                                 ; and the address under the column: "#" prints the row and drops it, prints
                                 ; the column and drops it, and TOS is the string's address again.
                              JSR   h_swap   
                              INX      
                              INX      
                              JSR   h_swap   
                              DEX      
                              DEX      
                              JSR   h_swap   
                              LDY   #M_CSI-MSG   
                              JSR   prs   ; ESC [
                              JSR   inctos   
                              JSR   h_num   ; the row + 1
                              LDA   #";"   
                              JSR   CONOUT   
                              JSR   inctos   
                              JSR   h_num   ; the column + 1
                              LDA   #"H"   
                              JMP   CONOUT   
E507                          ENDIF      
E507                          IF   CHECKED   
E507                             ; The checked build's inner loop, out of page 1, where it would not fit,
E507                             ; and its break check (described with the unchecked one in page 1).
E507                             ; pnext: the break check, then (falling through) next. A word call, a true
E507                             ; "(" and a true ")" end here, but the keyboard is looked at only once in 256
E507                             ; of them: CDOWN counts them down. A key found is held; a Ctrl-C goes on to ctlc. (Startup
E507                             ; falls in here too, which does no harm.)
E507   CE 79 04     PNEXT:    DEC   CDOWN   
E50A   D0 0B                  BNE   next   
E50C   20 06 FF     PKEY:     JSR   KEY   
E50F   F0 06                  BEQ   next   ; no key
E511   8D 7A 04               STA   KEYBUF   ; held for the next "?"
E514   20 71 E5               JSR   chk3   ; (Ctrl-C: back only if the break key is off)
E517                NEXT:        
E517                          ENDIF      
E517                          IF   CHECKED*FAST   
                              JMP   fnext   ; (the fast build: see "The fast build")
E517                          ENDIF      
E517                          IF   CHECKED*(1-FAST)   
E517                             ; Both stacks are checked once per character, after it has run. The
E517                             ; return stack has overrun when S is below RSLIM: an overflow leaves
E517                             ; it at 1Eh or 1Fh, an underflow wraps it to 01h (no handler pulls
E517                             ; more than one entry). The data stack has when X is above DSE (an
E517                             ; underflow) or below DSFULL (an overflow). No handler moves X by
E517                             ; more than 4 (but "$", whose /~ escapes each look first), so X is
E517                             ; caught before it wraps; an overrun by a cell or two writes on the
E517                             ; scratch bytes below or above the stack.
E517                             ; S is kept in RSV, for the report's R: line (an error found inside
E517                             ; a handler has its own calls on the hardware stack), and the place
E517                             ; of the character about to run in PLACE.
E517   8A                     TXA      ; TSX trashes X: keep it in A
E518   BA                     TSX      
E519   8E 35 04               STX   RSV   
E51C   E0 20                  CPX   #RSLIM   
E51E   AA                     TAX      ; TAX leaves the carry alone
E51F   90 16                  BCC   e_rstack   
E521   E0 F1                  CPX   #DSE+1   
E523   B0 24                  BCS   e_sund   
E525   E0 10                  CPX   #DSFULL   
E527   90 25                  BCC   e_sovr   
E529   A5 00                  LDA   IP   
E52B   85 08                  STA   PLACE   
E52D   A5 01                  LDA   IP+1   
E52F   85 09                  STA   PLACE+1   
E531   20 B7 E5               JSR   step   
E534   4C 17 E5               JMP   next   
E537                          ENDIF      
E537                          IF   CHECKED   
E537                             ; S/R are overflows, s/r underflows. After an underflow that stack counts as
E537                             ; empty.
E537   AD 35 04     E_RSTACK:   LDA   RSV   
E53A   C9 10                  CMP   #10h   
E53C   A9 52                  LDA   #"R"   
E53E   B0 10                  BCS   ejmp   ; S is 1Eh-1Fh: an overflow
E540   A9 FF                  LDA   #0FFh   
E542   8D 35 04               STA   RSV   ; S wrapped to 01h: R:0
E545   A9 72                  LDA   #"r"   
E547   D0 07                  BNE   ejmp   ; always
E549   A2 F0        E_SUND:   LDX   #DSE   ; D:0
E54B   A9 73                  LDA   #"s"   
E54D   2C                     DB   2Ch   ; (BIT abs: hides the next instruction)
E54E   A9 53        E_SOVR:   LDA   #"S"   
E550   4C A3 E6     EJMP:     JMP   error   
E553                             ; skip, checked: as the unchecked one above, and A holds, on the way in, the wrong closer for the
E553                             ; opener that started the skip, kept in T0: ] for (, ) for [, and 0 for \,
E553                             ; which takes either. Meeting the wrong closer at this level, or the end
E553                             ; (a NUL, or a string that runs into it), stops with N, except for \,
E553                             ; which then ends the program as before.
E553                          ENDIF      
E553                          IF   CHECKED*(1-QK)   
                    SKIP:     STA   T0   
                              LDA   #0   
                              STA   T2   ; depth
                    SK1:      JSR   getc   
                              BEQ   sknul   
                              CMP   #22h   
                              BNE   sk2   
                              JSR   skipstr   ; leaves A = 11h, which matches nothing below
                              BEQ   sknul   ; the string ran into the end
                    SK2:      CMP   #"("   
                              BEQ   sk3   
                              CMP   #"["   
                              BEQ   sk3   
                              CMP   #")"   
                              BEQ   sk4   
                              CMP   #"]"   
                              BNE   sk1   
                    SK4:      DEC   T2   
                              BPL   sk1   
                              CMP   T0   
                              BEQ   e_nest   ; the wrong kind
                              RTS      ; the closer at this level
                    SK3:      INC   T2   
                              BNE   sk1   
E553                          ENDIF      
E553                          IF   CHECKED   
E553   A5 04        SKNUL:    LDA   T0   
E555   D0 03                  BNE   e_nest   ; ( and [ stop with N
E557   4C 09 FF               JMP   EXIT   ; \ ends the program
E55A   A9 4E        E_NEST:   LDA   #"N"   ; a skip from ( or [ found the wrong closer
E55C   4C A3 E6               JMP   error   ;   or the end: the place is the opener
E55F                          ENDIF      
E55F                          IF   1-CHECKED   
                    CBREAK:   EQU   endp   ; the unchecked build stops without a word
E55F                          ENDIF      
E55F                          IF   CHECKED   
E55F                CBREAK:   EQU   e_break   ; the checked build reports B
E55F                          ENDIF      
E55F                             ; getk: a key for "?" in A (zero flag clear), or A = 0 with the zero flag
E55F                             ; set when there is none. Keeps X and Y. The held key goes first, and is
E55F                             ; taken out of KEYBUF.
E55F   AD 7A 04     GETK:     LDA   KEYBUF   
E562   F0 08                  BEQ   gk1   
E564   48                     PHA      
E565   A9 00                  LDA   #0   
E567   8D 7A 04               STA   KEYBUF   
E56A   68                     PLA      
E56B   60                     RTS      
E56C   20 06 FF     GK1:      JSR   KEY   
E56F   F0 04                  BEQ   gk9   
E571                             ; chk3: a key in A (not 0). A Ctrl-C goes on to ctlc, which gives the 03h
E571                             ; back if it comes back at all.
E571   C9 03        CHK3:     CMP   #3   
E573   F0 01                  BEQ   ctlc   
E575   60           GK9:      RTS      
E576                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
E576                             ; the program has turned it off, wait about 250 ms (about 250 times MSLOOP
E576                             ; looks: T1 counts the 256s, T2 runs on from whatever it holds) for one more
E576                             ; key: a second Ctrl-C is the end too; any other key is held (the newest
E576                             ; wins). Returns A = 03h with the zero flag clear. Keeps X and Y.
E576   AD 7B 04     CTLC:     LDA   BRKOFF   
E579   F0 1D                  BEQ   cbreak   
E57B   A9 28                  LDA   #CWAIT+1   
E57D   85 05                  STA   T1   
E57F   20 06 FF     CT2:      JSR   KEY   
E582   D0 0A                  BNE   ct3   
E584   C6 06                  DEC   T2   
E586   D0 F7                  BNE   ct2   
E588   C6 05                  DEC   T1   
E58A   D0 F3                  BNE   ct2   
E58C   F0 07                  BEQ   ct9   ; always: none came
E58E   C9 03        CT3:      CMP   #3   
E590   F0 06                  BEQ   cbreak   
E592   8D 7A 04               STA   KEYBUF   
E595   A9 03        CT9:      LDA   #3   
E597   60                     RTS      
E598                          IF   CHECKED   
E598   A9 42        E_BREAK:   LDA   #"B"   ; Ctrl-C (the stacks as they stand)
E59A   2C                     DB   2Ch   ; (BIT abs: hides the next instruction)
E59B   A9 58        E_RESV:   LDA   #"X"   ; a reserved byte, 80h-FFh
E59D   4C A3 E6     EJMP2:    JMP   error   
E5A0                             ; e_undef: the word cells of undefined words hold 0000h. A call there reads
E5A0                             ; the byte at 0000h, which is IP's own low byte: 00h while IP is 0000h, so
E5A0                             ; the call reads a NUL with IP in page zero, where no program can be. The
E5A0                             ; call is undone first: the step frame and the return address come off the
E5A0                             ; hardware stack, and the place is the call letter (the return address - 1).
E5A0   68           E_UNDEF:   PLA      
E5A1   68                     PLA      ; the step frame
E5A2   68                     PLA      
E5A3   38                     SEC      
E5A4   E9 01                  SBC   #1   
E5A6   85 08                  STA   PLACE   
E5A8   68                     PLA      
E5A9   E9 00                  SBC   #0   
E5AB   85 09                  STA   PLACE+1   
E5AD   EE 35 04               INC   RSV   
E5B0   EE 35 04               INC   RSV   ; R: does not count the call
E5B3   A9 55                  LDA   #"U"   
E5B5   D0 E6                  BNE   ejmp2   ; always
E5B7                          ENDIF      
E5B7                             ; step: read one character and sort it by range.
E5B7                             ;    00h          end of program
E5B7                             ;    01h-20h, 7Fh-FFh   ignored
E5B7                             ;    30h-39h      digit: read a whole number
E5B7                             ;    41h-5Ah      A-Z: call the word in that letter's cell
E5B7                             ;    61h-7Ah      a-z: push the address of that letter's cell
E5B7                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
E5B7   20 89 E6     STEP:     JSR   getc   ; flags follow A
E5BA   F0 3D                  BEQ   endp   
E5BC   38                     SEC      
E5BD   E9 21                  SBC   #21h   ; A = c - 21h
E5BF   90 37                  BCC   ign   ; 01h-20h
E5C1   C9 0F                  CMP   #0Fh   
E5C3   90 24                  BCC   punct   ; 21h-2Fh: index 0-14
E5C5   E9 0F                  SBC   #0Fh   ; (carry set) A = c - 30h
E5C7   C9 0A                  CMP   #10   
E5C9   90 72                  BCC   digit   
E5CB   C9 11                  CMP   #11h   
E5CD   90 18                  BCC   p3a   ; 3Ah-40h
E5CF   E9 11                  SBC   #11h   ; (carry set) A = c - 41h
E5D1   C9 1A                  CMP   #1Ah   
E5D3   90 2B                  BCC   upper   ; 41h-5Ah
E5D5   C9 20                  CMP   #20h   
E5D7   90 0C                  BCC   p5b   ; 5Bh-60h
E5D9   C9 3A                  CMP   #3Ah   
E5DB   90 2F                  BCC   lower   ; 61h-7Ah: A = 20h-39h
E5DD   C9 3E                  CMP   #3Eh   
E5DF                          IF   1-CHECKED   
                              BCS   ign   ; 7Fh-FFh
E5DF                          ENDIF      
E5DF                          IF   CHECKED   
E5DF   F0 17                  BEQ   ign   ; 7Fh
E5E1   B0 B8                  BCS   e_resv   ; 80h-FFh: reserved
E5E3                          ENDIF      
E5E3                             ; The three adjustments below chain. Each ADC adds the carry the one
E5E3                             ; before it left, which the constants allow for.
E5E3   E9 1A                  SBC   #1Ah   ; 7Bh-7Eh: (carry clear: -1Bh) index 28-31
E5E5   69 F6        P5B:      ADC   #0F6h   ; 5Bh-60h: -10 (-9 when chained), index 22-27
E5E7   69 05        P3A:      ADC   #5   ; 3Ah-40h: +5 (+6 when chained), index 15-21
E5E9                             ; Punctuation: A = the index. The handler's page is the first, plus one if
E5E9                             ; the index is N1 or more, plus one more if it is N2 or more.
E5E9   C9 08        PUNCT:    CMP   #N1   
E5EB   A8                     TAY      
E5EC   A9 70                  LDA   #HALFPG   
E5EE   2A                     ROL      ; the first page, or the second (carry clear)
E5EF   C0 15                  CPY   #N2   
E5F1   69 00                  ADC   #0   ; ... or the third (and the carry is clear)
E5F3   48                     PHA      
E5F4   B9 1D E6               LDA   PTAB,Y   
E5F7   48                     PHA      
E5F8   60           IGN:      RTS      ; RTS trick: goes to the handler. Reached
E5F9                             ; directly, it just ends an ignored character.
E5F9                ENDP:        ; the program has ended
E5F9                          IF   CHECKED   
E5F9   A5 01                  LDA   IP+1   ; IP in page zero: an undefined word
E5FB   F0 A3                  BEQ   e_undef   
E5FD                          ENDIF      
E5FD   4C 09 FF               JMP   EXIT   
E600                             ; A-Z: call the word. The return address (the IP after the letter) goes on
E600                             ; the return stack, and the IP becomes the address in the letter's cell.
E600   0A           UPPER:    ASL      
E601   A8                     TAY      
E602   38                     SEC      
E603   4C F7 E0               JMP   pushn   
E606   A5 00        PUSHIP:   LDA   IP   ; push the reading position
E608   A4 01                  LDY   IP+1   
E60A   D0 03                  BNE   pushay   ; always: no program is in page zero
E60C                             ; a-z: push the cell's address (the cell is the variable)
E60C                             ;  (the unchecked QK builds do x@ and x! in one step: lowq)
E60C                          IF   SBASEU   
                    LOWER:    JMP   lowq   
                    LOWP:        
E60C                          ENDIF      
E60C                          IF   1-SBASEU   
E60C                LOWER:       
E60C                LOWP:        
E60C                          ENDIF      
E60C   0A                     ASL      
E60D   A0 04                  LDY   #>LET   
E60F                             ; pushay: push a cell: A = its low byte, Y = its high byte
E60F   CA           PUSHAY:   DEX      
E610   CA                     DEX      
E611   95 00        SETAY:    STA   0,X   ; setay: TOS = A (low), Y (high)
E613   94 01                  STY   1,X   
E615   60                     RTS      
E616                             ; flag: pops TOS and returns with Z set if it was 0. Keeps the carry.
E616   E8           FLAG:     INX      
E617   E8                     INX      
E618   B5 FE                  LDA   0FEh,X   
E61A   15 FF                  ORA   0FFh,X   
E61C   60                     RTS      
E61D                             ; =============================================================================
E61D                             ;  Dispatch table: the low byte of (handler - 1) for each punctuation
E61D                             ;  character, in code order.
E61D                             ; =============================================================================
E61D   C6           PTAB:     DB   (h_store-1) & 0FFh   ; !
E61E   74                     DB   (h_str-1) & 0FFh   ; "
E61F   9A                     DB   (h_num-1) & 0FFh   ; #
E620   48                     DB   (h_print-1) & 0FFh   ; $
E621   D5                     DB   (h_swap-1) & 0FFh   ; %
E622   E6                     DB   (h_and-1) & 0FFh   ; &
E623   92                     DB   (h_emit-1) & 0FFh   ; '
E624   F1                     DB   (h_open-1) & 0FFh   ; (
E625   B0                     DB   (h_close-1) & 0FFh   ; )
E626   76                     DB   (h_mul-1) & 0FFh   ; *
E627   40                     DB   (h_add-1) & 0FFh   ; +
E628   A7                     DB   (h_cfetch-1) & 0FFh   ; ,
E629   37                     DB   (h_sub-1) & 0FFh   ; -
E62A   2B                     DB   (h_cstore-1) & 0FFh   ; .
E62B   7E                     DB   (h_div-1) & 0FFh   ; /
E62C   24                     DB   (h_dup-1) & 0FFh   ; :
E62D   34                     DB   (drop-1) & 0FFh   ; ;
E62E   55                     DB   (h_lt-1) & 0FFh   ; <
E62F   66                     DB   (h_eq-1) & 0FFh   ; =
E630   52                     DB   (h_gt-1) & 0FFh   ; >
E631   B8                     DB   (h_key-1) & 0FFh   ; ?
E632   6D                     DB   (h_fetch-1) & 0FFh   ; @
E633   92                     DB   (h_def-1) & 0FFh   ; [
E634   15                     DB   (h_break-1) & 0FFh   ; \
E635   29                     DB   (h_ret-1) & 0FFh   ; ]
E636   57                     DB   (h_xor-1) & 0FFh   ; ^
E637   E4                     DB   (h_alloc-1) & 0FFh   ; _
E638   B6                     DB   (h_grave-1) & 0FFh   ; `
E639   3B                     DB   (h_tor-1) & 0FFh   ; {
E63A   62                     DB   (h_or-1) & 0FFh   ; |
E63B   47                     DB   (h_fromr-1) & 0FFh   ; }
E63C   54                     DB   (h_not-1) & 0FFh   ; ~
E63D                             ; Digits: the first one is in A; read the rest of the number.
E63D   A0 00        DIGIT:    LDY   #0   
E63F   20 0F E6               JSR   pushay   
E642                             ; rdnum: TOS = TOS*10 + digit for each digit at IP. Wraps at 16 bits.
E642                             ; Returns with the carry set.
E642   20 6F E6     RDNUM:    JSR   isdig   
E645   B0 4D                  BCS   ic9   ; (an RTS)
E647   20 8C E6               JSR   incip   ; (keeps A = the digit)
E64A   16 00                  ASL   0,X   
E64C   36 01                  ROL   1,X   ; x2
E64E   18                     CLC      
E64F   75 00                  ADC   0,X   
E651   85 04                  STA   T0   
E653   B5 01                  LDA   1,X   
E655   69 00                  ADC   #0   
E657   A8                     TAY      ; Y:T0 = x2 + digit
E658   16 00                  ASL   0,X   
E65A   36 01                  ROL   1,X   
E65C   16 00                  ASL   0,X   
E65E   36 01                  ROL   1,X   ; x8
E660   18                     CLC      
E661   B5 00                  LDA   0,X   
E663   65 04                  ADC   T0   
E665   95 00                  STA   0,X   
E667   98                     TYA      
E668   75 01                  ADC   1,X   
E66A   95 01                  STA   1,X   ; x8 + x2 + digit
E66C   4C 42 E6               JMP   rdnum   
E66F                             ; isdig: A = the character at IP minus "0"; the carry is clear if it is a
E66F                             ; digit. Y = 0.
E66F   20 95 E6     ISDIG:    JSR   peek   
E672   38                     SEC      
E673   E9 30                  SBC   #"0"   
E675   C9 0A                  CMP   #10   
E677   60                     RTS      
E678                             ; rdhex: if IP is at a hex digit (0-9, A-F, a-f), return its value in A with
E678                             ; the carry clear and IP moved on; otherwise the carry is set and IP stays.
E678   20 6F E6     RDHEX:    JSR   isdig   
E67B   90 0F                  BCC   incip   
E67D   29 DF                  AND   #0DFh   
E67F   E9 11                  SBC   #11h   ; (the carry is set)
E681   C9 06                  CMP   #6   
E683   B0 0F                  BCS   ic9   
E685   69 0A                  ADC   #10   
E687   D0 03                  BNE   incip   ; always
E689                             ; Reading the program
E689                             ;    peek: A = the character at IP, IP unchanged, Y = 0
E689                             ;    getc: the same, then IP moves on; flags follow A
E689                             ;    incip: IP moves on; keeps A, the carry and Y
E689   20 95 E6     GETC:     JSR   peek   
E68C   E6 00        INCIP:    INC   IP   
E68E   D0 02                  BNE   ic1   
E690   E6 01                  INC   IP+1   
E692   09 00        IC1:      ORA   #0   
E694   60           IC9:      RTS      
E695   A0 00        PEEK:     LDY   #0   
E697   B1 00                  LDA   (IP),Y   
E699   60                     RTS      
E69A                             ; rstip: point IP at the start of the program
E69A   A9 00        RSTIP:    LDA   #<PROG   
E69C   85 00                  STA   IP   
E69E   A9 05                  LDA   #>PROG   
E6A0   85 01                  STA   IP+1   
E6A2   60                     RTS      
E6A3                          IF   CHECKED   
E6A3                             ; =============================================================================
E6A3                             ;  Checked build: the error report
E6A3                             ; =============================================================================
E6A3                             ; error: the report, then EXIT. A = the letter, PLACE = the place, X = the
E6A3                             ; data stack to show, RSV = S for the R: line. Nothing here relies on S: an
E6A3                             ; overflowed or underflowed hardware stack wraps inside its page, and only
E6A3                             ; its depth is shown.
E6A3                             ;   CR LF
E6A3                             ;   Err X @ line,col CR LF
E6A3                             ;   D:n: [...] and the top 8 cells at most, bottom to top  CR LF
E6A3                             ;   R:n CR LF
E6A3                             ; The numbers go through "#" (prnum), which pushes them over the data stack
E6A3                             ; and pops them again, so the stack is shown as it was. With the stack full
E6A3                             ; (X = 0Eh) that reaches down to 0Ah, so nothing the report keeps is there.
E6A3   48           ERROR:    PHA      ; the letter
E6A4   A5 08                  LDA   PLACE   
E6A6   85 02                  STA   P   
E6A8   A5 09                  LDA   PLACE+1   
E6AA   85 03                  STA   P+1   ; (CO is the report's scratch from here on)
E6AC   A0 00                  LDY   #M_ERR-MSG   
E6AE   20 E5 E4               JSR   prs   ; CR LF "Err "
E6B1   68                     PLA      
E6B2   20 03 FF               JSR   CONOUT   
E6B5   20 E5 E4               JSR   prs   ; " @ " (it follows M_ERR)
E6B8   20 48 E7               JSR   lcol   
E6BB   A5 0A                  LDA   LN   
E6BD   A4 0B                  LDY   LN+1   
E6BF   20 29 E7               JSR   prnum   ; the line
E6C2   A9 2C                  LDA   #","   
E6C4   20 03 FF               JSR   CONOUT   
E6C7   A5 08                  LDA   CO   
E6C9   A4 09                  LDY   CO+1   
E6CB   20 29 E7               JSR   prnum   ; the column
E6CE   A0 0B                  LDY   #M_STK-MSG   
E6D0   20 E5 E4               JSR   prs   ; CR LF "D:"
E6D3   8A                     TXA      
E6D4   49 FF                  EOR   #0FFh   
E6D6   38                     SEC      
E6D7   E9 0F                  SBC   #0FFh-DSE   
E6D9   4A                     LSR      ; the depth, (DSE - X) / 2
E6DA   48                     PHA      
E6DB   20 27 E7               JSR   prnum8   
E6DE   68                     PLA      
E6DF   A0 14                  LDY   #M_C-MSG   ; ":"
E6E1   C9 09                  CMP   #9   
E6E3   90 04                  BCC   er3   
E6E5   A9 08                  LDA   #8   ; more than 8: ": ..." and the top 8
E6E7   A0 0F                  LDY   #M_CD-MSG   
E6E9   85 08        ER3:      STA   CO   ; CO = how many cells to show
E6EB   20 E5 E4               JSR   prs   
E6EE   A5 08        ER4:      LDA   CO   ; cells CO-1 down to 0, the top last: cell i
E6F0   F0 1F                  BEQ   er5   ;   from the top is at X+2i
E6F2   C6 08                  DEC   CO   
E6F4   A9 20                  LDA   #" "   
E6F6   20 03 FF               JSR   CONOUT   
E6F9   A5 08                  LDA   CO   
E6FB   0A                     ASL      
E6FC   85 09                  STA   CO+1   
E6FE   8A                     TXA      
E6FF   65 09                  ADC   CO+1   ; (the carry is clear)
E701   A8                     TAY      
E702   B9 00 00               LDA   0,Y   
E705   48                     PHA      
E706   B9 01 00               LDA   1,Y   
E709   A8                     TAY      
E70A   68                     PLA      
E70B   20 29 E7               JSR   prnum   
E70E   4C EE E6               JMP   er4   
E711   A0 15        ER5:      LDY   #M_RTN-MSG   
E713   20 E5 E4               JSR   prs   ; CR LF "R:"
E716   AD 35 04               LDA   RSV   
E719   49 FF                  EOR   #0FFh   
E71B   4A                     LSR      ; (FFh - S) / 2 entries
E71C   20 27 E7               JSR   prnum8   
E71F   A0 09                  LDY   #M_NL-MSG   
E721   20 E5 E4               JSR   prs   
E724   4C 09 FF               JMP   EXIT   
E727                             ; prnum: print the number A (low), Y (high), signed, keeping the data stack.
E727                             ; prnum8: the same for A alone, 0-255.
E727   A0 00        PRNUM8:   LDY   #0   
E729   20 0F E6     PRNUM:    JSR   pushay   
E72C   4C 9B E0               JMP   h_num   
E72F                          ENDIF      
E72F                          IF   CHECKED+ANSI   
E72F                MSG:         
E72F                          ENDIF      
E72F                          IF   ANSI   
                    M_CLS:    DB   27,"[","H",27,"[","J"+80h   
                    M_SHOW:   DB   27,"[","?","2","5","h"+80h   
                    M_HIDE:   DB   27,"[","?","2","5","l"+80h   
                    M_EOL:    DB   27,"[","K"+80h   
                    M_CSI:    DB   27,"["+80h   
E72F                          ENDIF      
E72F                          IF   CHECKED   
E72F   0D 0A 45 72 72 A0 M_ERR:   DB   13,10,"Err"," "+80h   
E735   20 40 A0               DB   " @"," "+80h   
E738   0D 8A        M_NL:     DB   13,10+80h   
E73A   0D 0A 44 BA  M_STK:    DB   13,10,"D",":"+80h   
E73E   3A 20 2E 2E AE M_CD:   DB   ": ..","."+80h   
E743   BA           M_C:      DB   ":"+80h   
E744   0D 0A 52 BA  M_RTN:    DB   13,10,"R",":"+80h   
E748                          ENDIF      
E748                          IF   CHECKED   
E748                             ; lcol: the line (LN) and the column (CO) of the place at P, both from
E748                             ; 1. A place below the program is in the -n? line buffer: line 0, and the
E748                             ; column is the place in the buffer. Otherwise IP (free now: the program has
E748                             ; stopped) runs from PROG to the place, counting LFs; CO keeps where the
E748                             ; last line started, and the column is the place minus that, plus 1.
E748   A9 00        LCOL:     LDA   #0   
E74A   85 0B                  STA   LN+1   
E74C   85 0A                  STA   LN   
E74E   A9 80                  LDA   #<LINEBUF   
E750   85 08                  STA   CO   
E752   A9 04                  LDA   #>LINEBUF   
E754   85 09                  STA   CO+1   
E756   A5 02                  LDA   P   
E758   C9 00                  CMP   #<PROG   
E75A   A5 03                  LDA   P+1   
E75C   E9 05                  SBC   #>PROG   
E75E   90 26                  BCC   lc9   ; below the program: line 0
E760   E6 0A                  INC   LN   
E762   20 9A E6               JSR   rstip   
E765   A5 00        LC3:      LDA   IP   ; a line starts here
E767   85 08                  STA   CO   
E769   A5 01                  LDA   IP+1   
E76B   85 09                  STA   CO+1   
E76D   A5 00        LC1:      LDA   IP   
E76F   C5 02                  CMP   P   
E771   A5 01                  LDA   IP+1   
E773   E5 03                  SBC   P+1   
E775   B0 0F                  BCS   lc9   ; at the place
E777   20 89 E6               JSR   getc   
E77A   C9 0A                  CMP   #10   
E77C   D0 EF                  BNE   lc1   
E77E   E6 0A                  INC   LN   ; an LF: a new line starts after it
E780   D0 E3                  BNE   lc3   
E782   E6 0B                  INC   LN+1   
E784   D0 DF                  BNE   lc3   ; always
E786   A5 02        LC9:      LDA   P   
E788   38                     SEC      
E789   E5 08                  SBC   CO   
E78B   85 08                  STA   CO   
E78D   A5 03                  LDA   P+1   
E78F   E5 09                  SBC   CO+1   
E791   85 09                  STA   CO+1   
E793   E6 08                  INC   CO   ; + 1
E795   D0 02                  BNE   lc8   
E797   E6 09                  INC   CO+1   
E799   60           LC8:      RTS      
E79A                          ENDIF      
E79A                             ; =============================================================================
E79A                             ;  The fast build (SPEED = 2)
E79A                             ; 
E79A                             ;  The inner loop is a table: 256 entries, the low bytes of the handlers'
E79A                             ;  addresses in one page (DTL) and the high bytes in the next (DTH). The
E79A                             ;  dispatcher, NEXTF, is inline at the end of the fast build's own entries,
E79A                             ;  so there is no JSR and no RTS per character:
E79A                             ;      LDY #0 / LDA (IP),Y / INC IP / BNE $+4 / INC IP+1 / TAY /
E79A                             ;      LDA DTL,Y / STA V / LDA DTH,Y / STA V+1 / JMP (V)
E79A                             ;  The letters and digits have one entry each, which knows its cell or its
E79A                             ;  value already; the commonest punctuation is written for the table; the
E79A                             ;  rest reach the ordinary handlers through a thunk (CLC / JSR handler /
E79A                             ;  NEXTF, or JMP fnext for the rare ones), which gives them the step frame
E79A                             ;  and the clear carry they expect.
E79A                             ;  The ordinary handlers that end at next or pnext go to fnext, the same
E79A                             ;  dispatcher. In the checked build NEXTF is JMP fnext, which checks the
E79A                             ;  stacks first, as next does in the other builds.
E79A                             ;  Everything here is read-only: the image can be ROM, as the others are.
E79A                             ;  The table takes the image's first two pages (E000h-E1FFh); the code
E79A                             ;  starts after it.
E79A                             ; =============================================================================
E79A                          IF   FAST   
                                 ; fnext: the dispatcher, after the checks of the checked build
                    FNEXT:       
E79A                          ENDIF      
E79A                          IF   FAST*CHECKED   
                                 ; (the same checks as next in the other checked builds)
                              TXA      ; TSX trashes X: keep it in A
                              TSX      
                              STX   RSV   
                              CPX   #RSLIM   
                              TAX      
                              BCS   fn1   
                              JMP   e_rstack   
                    FN1:      CPX   #DSE+1   
                              BCS   fn2   
                              CPX   #DSFULL   
                              BCS   fn3   
                              JMP   e_sovr   
                    FN2:      JMP   e_sund   
                    FN3:      LDA   IP   
                              STA   PLACE   
                              LDA   IP+1   
                              STA   PLACE+1   
E79A                          ENDIF      
E79A                          IF   FAST   
                              LDY   #0   
                              LDA   (IP),Y   
                              INC   IP   
                              BNE   fn4   
                              INC   IP+1   
                    FN4:      TAY      
                              LDA   DTL,Y   
                              STA   V   
                              LDA   DTH,Y   
                              STA   V+1   
                              JMP   (V)   
                                 ; fpoll: the break check of pnext, as a subroutine, for the entries that
                                 ; look at the keyboard (a word call, a true ( and a true ))
                    FPOLL:    JSR   KEY   
                              BEQ   fp9   ; no key
                              STA   KEYBUF   ; held for the next "?"
                              JMP   chk3   ; (Ctrl-C: back only if the break key is off)
                    FP9:      RTS      
                                 ; The thunks: the rest of the punctuation, through the ordinary handlers
                    FT_STR:   CLC      ; "
                              JSR   h_str   
                              JMP   fnext   ; (rare enough: the shared dispatcher)
                    FT_NUM:   CLC      ; #
                              JSR   h_num   
                              JMP   fnext   ; (rare enough: the shared dispatcher)
                    FT_PRT:   CLC      ; $
                              JSR   h_print   
                              JMP   fnext   ; (rare enough: the shared dispatcher)
                    FT_EMIT:   CLC      ; '
                              JSR   h_emit   
                              JMP   fnext   ; (rare enough: the shared dispatcher)
                    FT_DIV:   CLC      ; /
                              JSR   h_div   
                              ;*Macro unroll:  NEXTF
                              DS   1-CHECKED,0A0h   
                              DS   1-CHECKED,0   
                              DS   1-CHECKED,0B1h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0D0h   
                              DS   1-CHECKED,2   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP+1   
                              DS   1-CHECKED,0A8h   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTL&0FFh   
                              DS   1-CHECKED,ADTL/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTH&0FFh   
                              DS   1-CHECKED,ADTH/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V+1   
                              DS   1-CHECKED,6Ch   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0   
                              DS   CHECKED,4Ch   
                              DS   CHECKED,AFNX&0FFh   
                              DS   CHECKED,AFNX/256   
                    FT_KEY:   CLC      ; ?
                              JSR   h_key   
                              JMP   fnext   ; (rare enough: the shared dispatcher)
                    FT_DEF:   CLC      ; [
                              JSR   h_def   
                              ;*Macro unroll:  NEXTF
                              DS   1-CHECKED,0A0h   
                              DS   1-CHECKED,0   
                              DS   1-CHECKED,0B1h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0D0h   
                              DS   1-CHECKED,2   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP+1   
                              DS   1-CHECKED,0A8h   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTL&0FFh   
                              DS   1-CHECKED,ADTL/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTH&0FFh   
                              DS   1-CHECKED,ADTH/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V+1   
                              DS   1-CHECKED,6Ch   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0   
                              DS   CHECKED,4Ch   
                              DS   CHECKED,AFNX&0FFh   
                              DS   CHECKED,AFNX/256   
                    FT_BRK:   CLC      ; \
                              JSR   h_break   
                              ;*Macro unroll:  NEXTF
                              DS   1-CHECKED,0A0h   
                              DS   1-CHECKED,0   
                              DS   1-CHECKED,0B1h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0D0h   
                              DS   1-CHECKED,2   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP+1   
                              DS   1-CHECKED,0A8h   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTL&0FFh   
                              DS   1-CHECKED,ADTL/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTH&0FFh   
                              DS   1-CHECKED,ADTH/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V+1   
                              DS   1-CHECKED,6Ch   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0   
                              DS   CHECKED,4Ch   
                              DS   CHECKED,AFNX&0FFh   
                              DS   CHECKED,AFNX/256   
                    FT_ALC:   CLC      ; _
                              JSR   h_alloc   
                              JMP   fnext   ; (rare enough: the shared dispatcher)
                    FT_GRV:   CLC      ; `
                              JSR   h_grave   
                              JMP   fnext   ; (rare enough: the shared dispatcher)
                    FT_TOR:   CLC      ; {
                              JSR   h_tor   
                              JMP   fnext   ; (rare enough: the shared dispatcher)
                    FT_FRR:   CLC      ; }
                              JSR   h_fromr   
                              JMP   fnext   ; (rare enough: the shared dispatcher)
E79A                          ENDIF      
E79A                          IF   FAST*CHECKED   
                    FT_STO:   CLC      ; ! (checked: it checks the address)
                              JSR   h_store   
                              JMP   fnext   
                    FT_CST:   CLC      ; . (the same)
                              JSR   h_cstore   
                              JMP   fnext   
E79A                          ENDIF      
E79A                          IF   FAST   
                                 ; The commonest punctuation, written for the table
                    FS_ADD:   CLC      ; +
                              LDA   0,X   
                              ADC   2,X   
                              STA   2,X   
                              LDA   1,X   
                              ADC   3,X   
                              STA   3,X   
                              INX      
                              INX      
                              ;*Macro unroll:  NEXTF
                              DS   1-CHECKED,0A0h   
                              DS   1-CHECKED,0   
                              DS   1-CHECKED,0B1h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0D0h   
                              DS   1-CHECKED,2   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP+1   
                              DS   1-CHECKED,0A8h   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTL&0FFh   
                              DS   1-CHECKED,ADTL/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTH&0FFh   
                              DS   1-CHECKED,ADTH/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V+1   
                              DS   1-CHECKED,6Ch   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0   
                              DS   CHECKED,4Ch   
                              DS   CHECKED,AFNX&0FFh   
                              DS   CHECKED,AFNX/256   
                    FS_SUB:   LDY   #0   ; -
                              LDA   (IP),Y   
                              CMP   #3Ah   
                              BCS   fsb1   
                              CMP   #30h   
                              BCS   fsb2   ; a digit next: a negative number
                    FSB1:     SEC      
                              LDA   2,X   
                              SBC   0,X   
                              STA   2,X   
                              LDA   3,X   
                              SBC   1,X   
                              STA   3,X   
                              INX      
                              INX      
                              ;*Macro unroll:  NEXTF
                              DS   1-CHECKED,0A0h   
                              DS   1-CHECKED,0   
                              DS   1-CHECKED,0B1h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0D0h   
                              DS   1-CHECKED,2   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP+1   
                              DS   1-CHECKED,0A8h   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTL&0FFh   
                              DS   1-CHECKED,ADTL/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTH&0FFh   
                              DS   1-CHECKED,ADTH/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V+1   
                              DS   1-CHECKED,6Ch   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0   
                              DS   CHECKED,4Ch   
                              DS   CHECKED,AFNX&0FFh   
                              DS   CHECKED,AFNX/256   
                    FSB2:     JSR   negnum   
                              ;*Macro unroll:  NEXTF
                              DS   1-CHECKED,0A0h   
                              DS   1-CHECKED,0   
                              DS   1-CHECKED,0B1h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0D0h   
                              DS   1-CHECKED,2   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP+1   
                              DS   1-CHECKED,0A8h   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTL&0FFh   
                              DS   1-CHECKED,ADTL/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTH&0FFh   
                              DS   1-CHECKED,ADTH/256   
                              DS   1-CHECKED,85h   
                              DS   1-CHECKED,V+1   
                              DS   1-CHECKED,6Ch   
                              DS   1-CHECKED,V   
                              DS   1-CHECKED,0   
                              DS   CHECKED,4Ch   
                              DS   CHECKED,AFNX&0FFh   
                              DS   CHECKED,AFNX/256   
                    FS_DUP:   LDA   0,X   ; :
                              LDY   1,X   
                              DEX      
                              DEX      
                              STA   0,X   
                              STY   1,X   
                              ;*Macro unroll:  NEXTF
                              DS   1-CHECKED,0A0h   
                              DS   1-CHECKED,0   
                              DS   1-CHECKED,0B1h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0D0h   
                              DS   1-CHECKED,2   
                              DS   1-CHECKED,0E6h   
                              DS   1-CHECKED,IP+1   
                              DS   1-CHECKED,0A8h   
                              DS   1-CHECKED,0B9h   
                              DS   1-CHECKED,ADTL&0FFh   
                              DS   1-CHECKED,ADTL/256   
