                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0C3h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
01AA                          ENDIF      
01AA                             ; ---- machine code: the grave -----------------------------------------------
01AA                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
01AA                             ; are stored from addr until a non-hex character; then a RET (C9h) is
01AA                             ; written and its address is left. An odd last digit is consumed and dropped.
01AA                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
01AA                             ; code is entered by CALL with the data stack above the return address; it
01AA                             ; must keep BC, and on return the top cell becomes the new TOS.
01AA   CD 9E 04     H_GRAVE:   CALL   hexc   
01AD   D2 2F 01               JNC   exec   
01B0   87           HX1:      ADD   A   
01B1   87                     ADD   A   
01B2   87                     ADD   A   
01B3   87                     ADD   A   
01B4   57                     MOV   D,A   ; the high digit
01B5   CD 9E 04               CALL   hexc   
01B8   D2 C4 01               JNC   hx2   ; odd digit: consumed and dropped
01BB   B2                     ORA   D   
01BC   77                     MOV   M,A   
01BD   23                     INX   H   
01BE   CD 9E 04               CALL   hexc   
01C1   DA B0 01               JC   hx1   
01C4   36 C9        HX2:      MVI   M,0C9h   ; (never range-checked: the spec says so)
01C6                          ;*Macro unroll:  NEXT
01C6                          DS   (1-CPM)*(1-FAST),0F7h   
01C6   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
01C7   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
01C8   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
