  1907                              <1> ; =============================================================================
  1908                              <1> ;  The inner loop: read one character and sort it by range.
  1909                              <1> ;
  1910                              <1> ;    00h          end of program
  1911                              <1> ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes; the checked
  1912                              <1> ;                 build stops on 80h-FFh: X)
  1913                              <1> ;    30h-39h      digit: read a whole number
  1914                              <1> ;    41h-5Ah      A-Z: call the word in that letter's cell
  1915                              <1> ;    61h-7Ah      a-z: push the address of that letter's cell
  1916                              <1> ;    the rest     punctuation: jump through PTAB, 32 entries
  1917                              <1> ; =============================================================================
  1918                              <1> ; Digits: step back onto the first digit and read the whole number.
  1919 00000920 53                  <1> digit:  push    ebx
  1920 00000921 4E                  <1>         dec     esi
  1921                              <1>         CALLP   rdnum
   192                              <2>  %if P_%1
   193 00000922 FF55DA              <2>  call [V(p_%1)]
   194                              <2>  %else
   195                              <2>  call %1
   196                              <2>  %endif
  1922 00000925 FFE5                <1>         jmp     ebp
  1923                              <1> 
  1924                              <1> ; a-z: push the cell's address (the cell is the variable).
  1925 00000927 53                  <1> lower:  push    ebx
  1926 00000928 8D9C0000014100      <1>         lea     ebx,[ARENA+LET+eax*2]
  1927 0000092F FFE5                <1>         jmp     ebp
  1928                              <1> ; (digit, lower and ctl are here, before next, to keep the variables after
  1929                              <1> ; next in reach)
  1930 00000931 0421                <1> ctl:    add     al,21h                  ; back to c; zero only for NUL
  1931 00000933 7505                <1>         jnz     next                    ; the rest are ignored
  1932 00000935 E9FBFBFFFF          <1>         jmp     endprog
  1933                              <1> %if CHECKED
  1934                              <1> e_hi:   mov     al,'X'                  ; a reserved byte outside a string
  1935                              <1>         jmp     error
  1936                              <1> %endif
  1937                              <1> next:
  1938                              <1> %if CHECKED
  1939                              <1>         call    chkstk                  ; both stacks, once per character
  1940                              <1> %endif
  1941 0000093A 31C0                <1>         xor     eax,eax
  1942 0000093C AC                  <1>         lodsb
  1943 0000093D 2C21                <1>         sub     al,21h                  ; AL = c - 21h
  1944 0000093F 72F0                <1>         jb      ctl                     ; c < 21h: NUL ends, the rest are ignored
  1945 00000941 3C0F                <1>         cmp     al,0Fh
  1946 00000943 7226                <1>         jb      punct                   ; 21h-2Fh: PTAB index 0-14
  1947 00000945 2C0F                <1>         sub     al,0Fh                  ; AL = c - 30h
  1948 00000947 3C0A                <1>         cmp     al,0Ah
  1949 00000949 72D5                <1>         jb      digit                   ; 30h-39h
  1950 0000094B 3C11                <1>         cmp     al,11h
  1951 0000094D 721A                <1>         jb      p3a                     ; 3Ah-40h
  1952 0000094F 2C11                <1>         sub     al,11h                  ; AL = c - 41h
  1953 00000951 3C1A                <1>         cmp     al,1Ah
  1954 00000953 0F8294F7FFFF        <1>         jb      upper                   ; 41h-5Ah: AL = letter index 0-25
  1955 00000959 3C20                <1>         cmp     al,20h
  1956 0000095B 720A                <1>         jb      p5b                     ; 5Bh-60h
  1957 0000095D 3C3A                <1>         cmp     al,3Ah
  1958 0000095F 72C6                <1>         jb      lower                   ; 61h-7Ah: AL = 20h-39h (cell +64 bytes)
  1959 00000961 3C3E                <1>         cmp     al,3Eh
  1960                              <1> %if CHECKED
  1961                              <1>         je      next                    ; 7Fh, DEL: ignored
  1962                              <1>         jae     e_hi                    ; 80h-FFh: reserved
  1963                              <1> %else
  1964 00000963 73D5                <1>         jae     next                    ; 7Fh-FFh: ignored
  1965                              <1> %endif
  1966 00000965 2C1A                <1>         sub     al,1Ah                  ; 7Bh-7Eh: -1Eh in all, index 28-31
  1967 00000967 2C09                <1> p5b:    sub     al,9                    ; 5Bh-60h: -4 in all, index 22-27
  1968 00000969 0405                <1> p3a:    add     al,5                    ; 3Ah-40h: index 15-21
  1969 0000096B 8A80[5A070000]      <1> punct:  mov     al,[ptab+eax]
  1970 00000971 8D80[11010000]      <1>         lea     eax,[hbase+eax]
