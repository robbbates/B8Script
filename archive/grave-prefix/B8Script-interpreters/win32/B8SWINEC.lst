  1898                              <1> ;  The letters and digits, the return stack's push, and the inner loop
  1899                              <1> ; =============================================================================
  1900                              <1> 
  1901                              <1> ; A-Z: call the word. The return address (the IP after the letter) goes on
  1902                              <1> ; the return stack, and the IP becomes the address in the letter's cell.
  1903 00000C54 89F2                <1> upper:  mov     edx,esi
  1904 00000C56 668BB40000014100    <1>         mov     si,[ARENA+LET+eax*2]
  1905                              <1> 
  1906                              <1> ; rpush: push EDX on the return stack, then next. Everything that pushes the
  1907                              <1> ; return stack ends here, and the true ')' comes to rpoll.
  1908                              <1> ;
  1909                              <1> ; The break key is looked at here, so at every word call and loop-back (and
  1910                              <1> ; block entry and '{'), but only one time in 256: V_PCNT counts them.
  1911 00000C5E 83EF04              <1> rpush:  sub     edi,4
  1912 00000C61 8917                <1>         mov     [edi],edx
  1913 00000C63 FE4D6B              <1> rpoll:  dec     byte [V(v_pcnt)]
  1914 00000C66 7505                <1>         jnz     .rp1
  1915 00000C68 E848FAFFFF          <1>         call    pollk
  1916 00000C6D FFE5                <1> .rp1:   jmp     ebp
  1917                              <1> 
  1918                              <1> ; =============================================================================
  1919                              <1> ;  The inner loop: read one character and sort it by range.
  1920                              <1> ;
  1921                              <1> ;    00h          end of program
  1922                              <1> ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes; the checked
  1923                              <1> ;                 build stops on 80h-FFh: X)
  1924                              <1> ;    30h-39h      digit: read a whole number
  1925                              <1> ;    41h-5Ah      A-Z: call the word in that letter's cell
  1926                              <1> ;    61h-7Ah      a-z: push the address of that letter's cell
  1927                              <1> ;    the rest     punctuation: jump through PTAB, 32 entries
  1928                              <1> ; =============================================================================
  1929                              <1> ; Digits: step back onto the first digit and read the whole number.
  1930 00000C6F 53                  <1> digit:  push    ebx
  1931 00000C70 4E                  <1>         dec     esi
  1932 00000C71 E866F7FFFF          <1>         call    rdnum
  1933 00000C76 FFE5                <1>         jmp     ebp
  1934                              <1> 
  1935                              <1> ; a-z: push the cell's address (the cell is the variable).
  1936 00000C78 53                  <1> lower:  push    ebx
  1937 00000C79 8D9C0000014100      <1>         lea     ebx,[ARENA+LET+eax*2]
  1938 00000C80 FFE5                <1>         jmp     ebp
  1939                              <1> ; (digit, lower and ctl are here, before next, to keep the variables after
  1940                              <1> ; next in reach)
  1941 00000C82 0421                <1> ctl:    add     al,21h                  ; back to c; zero only for NUL
  1942 00000C84 750C                <1>         jnz     next                    ; the rest are ignored
  1943 00000C86 E965FAFFFF          <1>         jmp     endprog
  1944                              <1> %if CHECKED
  1945 00000C8B B058                <1> e_hi:   mov     al,'X'                  ; a reserved byte outside a string
  1946 00000C8D E969F6FFFF          <1>         jmp     error
  1947                              <1> %endif
  1948                              <1> next:
  1949                              <1> %if CHECKED
  1950 00000C92 E812F6FFFF          <1>         call    chkstk                  ; both stacks, once per character
  1951                              <1> %endif
  1952 00000C97 31C0                <1>         xor     eax,eax
  1953 00000C99 AC                  <1>         lodsb
  1954 00000C9A 2C21                <1>         sub     al,21h                  ; AL = c - 21h
  1955 00000C9C 72E4                <1>         jb      ctl                     ; c < 21h: NUL ends, the rest are ignored
  1956 00000C9E 3C0F                <1>         cmp     al,0Fh
  1957 00000CA0 7224                <1>         jb      punct                   ; 21h-2Fh: PTAB index 0-14
  1958 00000CA2 2C0F                <1>         sub     al,0Fh                  ; AL = c - 30h
  1959 00000CA4 3C0A                <1>         cmp     al,0Ah
  1960 00000CA6 72C7                <1>         jb      digit                   ; 30h-39h
  1961 00000CA8 3C11                <1>         cmp     al,11h
  1962 00000CAA 7218                <1>         jb      p3a                     ; 3Ah-40h
  1963 00000CAC 2C11                <1>         sub     al,11h                  ; AL = c - 41h
  1964 00000CAE 3C1A                <1>         cmp     al,1Ah
  1965 00000CB0 72A2                <1>         jb      upper                   ; 41h-5Ah: AL = letter index 0-25
  1966 00000CB2 3C20                <1>         cmp     al,20h
  1967 00000CB4 720C                <1>         jb      p5b                     ; 5Bh-60h
  1968 00000CB6 3C3A                <1>         cmp     al,3Ah
  1969 00000CB8 72BE                <1>         jb      lower                   ; 61h-7Ah: AL = 20h-39h (cell +64 bytes)
  1970 00000CBA 3C3E                <1>         cmp     al,3Eh
  1971                              <1> %if CHECKED
  1972 00000CBC 74D4                <1>         je      next                    ; 7Fh, DEL: ignored
  1973 00000CBE 73CB                <1>         jae     e_hi                    ; 80h-FFh: reserved
  1974                              <1> %else
  1975                              <1>         jae     next                    ; 7Fh-FFh: ignored
  1976                              <1> %endif
  1977 00000CC0 2C1A                <1>         sub     al,1Ah                  ; 7Bh-7Eh: -1Eh in all, index 28-31
  1978 00000CC2 2C09                <1> p5b:    sub     al,9                    ; 5Bh-60h: -4 in all, index 22-27
  1979 00000CC4 0405                <1> p3a:    add     al,5                    ; 3Ah-40h: index 15-21
  1980 00000CC6 8A80[730A0000]      <1> punct:  mov     al,[ptab+eax]
  1981 00000CCC 8D80[01010000]      <1>         lea     eax,[hbase+eax]
  1982 00000CD2 FFE0                <1>         jmp     eax
