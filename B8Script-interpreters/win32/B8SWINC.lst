  1722                              <1> ; =============================================================================
  1723                              <1> ;  The imports: kernel32.dll only. An import directory entry, the import
  1724                              <1> ;  lookup table, the hint/name entries and the DLL's name; then the import
  1725                              <1> ;  address table, which the loader fills in, right below `next`, so that
  1726                              <1> ;  CALL [EBP+d8] reaches it.
  1727                              <1> ; =============================================================================
  1728                              <1> %macro  IMPORTS 1
  1729                              <1>         IMP     GetStdHandle
  1730                              <1>         IMP     GetConsoleMode
  1731                              <1>         IMP     SetConsoleMode
  1732                              <1>         IMP     GetCommandLineA
  1733                              <1>         IMP     CreateFileA
  1734                              <1>         IMP     ReadFile
  1735                              <1>         IMP     WriteFile
  1736                              <1> %if EDITOR
  1737                              <1>         IMP     CloseHandle             ; (a runner leaves its file open)
  1738                              <1> %endif
  1739                              <1>         IMP     WaitForSingleObject
  1740                              <1>         IMP     WaitForMultipleObjects
  1741                              <1>         IMP     CreateWaitableTimerExW
  1742                              <1>         IMP     SetWaitableTimer
  1743                              <1>         IMP     ReadConsoleInputA
  1744                              <1>         IMP     ExitProcess
  1745                              <1> %endmacro
  1746 00000695 00<rep 3h>          <1>         align   4, db 0
