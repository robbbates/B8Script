0119   E1                     POP   HL   
011A   28 CF                  JR   Z,rdrop   
011C   CF                     RST   08h   ; pop the block start ...
011D   42                     LD   B,D   
011E   4B                     LD   C,E   
011F   C5                     PUSH   BC   
0120   18 9C                  JR   rpushn   ; ... and push it back
0122                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
0122                             ; "-" has two jobs: directly before a digit it starts a negative number.
0122   0A           H_SUB:    LD   A,(BC)   
0123   D6 30                  SUB   "0"   
0125   FE 0A                  CP   10   
0127   38 04                  JR   C,negnum   
0129   E7                     RST   20h   ; a - b = a + (-b): fall into "+"
012A   D1           H_ADD:    POP   DE   
012B   19                     ADD   HL,DE   
012C   F7                     RST   30h   
012D   E5           NEGNUM:   PUSH   HL   ; a negative number: read it, negate it
012E   CD 27 02               CALL   rdnum   
0131   E7                     RST   20h   
0132   F7                     RST   30h   
0133   D1           H_AND:    POP   DE   
0134   7C                     LD   A,H   
0135   A2                     AND   D   
0136   67                     LD   H,A   
0137   7D                     LD   A,L   
0138   A3                     AND   E   
0139   6F                     LD   L,A   
013A   F7                     RST   30h   
013B                             ; Signed compares. Both are "HL < DE" for the right pair: "<" swaps the two
013B                             ; cells first. Flipping both sign bits turns a signed compare into an
013B                             ; unsigned one (and XOR clears the carry for SBC); SBC HL,HL then turns the
013B                             ; carry into -1 or 0 with no branch.
013B   E3           H_LT:     EX   (SP),HL   ; a < b: HL = a, and b is popped next
013C   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
013D   7C                     LD   A,H   
013E   EE 80                  XOR   80h   
0140   67                     LD   H,A   
0141   7A                     LD   A,D   
0142   EE 80                  XOR   80h   
0144   57                     LD   D,A   
0145   ED 52                  SBC   HL,DE   ; carry if HL < DE
0147   ED 62        TF:       SBC   HL,HL   ; carry -> -1 or 0
0149   F7                     RST   30h   
014A   D1           H_EQ:     POP   DE   
014B   B7                     OR   A   
014C   ED 52                  SBC   HL,DE   
014E   7C                     LD   A,H   
014F   B5                     OR   L   
0150   FE 01                  CP   1   ; carry only if a - b = 0
0152   18 F3                  JR   tf   
0154                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept. The
0154                             ; multiplier shifts up through A:C.
0154   D1           H_MUL:    POP   DE   ; DE = multiplicand
0155   C5                     PUSH   BC   
0156   7C                     LD   A,H   
0157   4D                     LD   C,L   ; A:C = multiplier
0158   21 00 00               LD   HL,0   
015B   06 10                  LD   B,16   
015D   29           MUL1:     ADD   HL,HL   
015E   CB 21                  SLA   C   
0160   17                     RLA      
0161   30 01                  JR   NC,mul2   
0163   19                     ADD   HL,DE   
0164   10 F7        MUL2:     DJNZ   mul1   
0166   C1                     POP   BC   
0167   F7                     RST   30h   
0168                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
0168                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
0168                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
0168                             ; stops on it.
0168                H_DIV:       
0168                          IF   CHECKED   
                              LD   A,H   
                              OR   L   
                              JP   Z,e_zero   
0168                          ENDIF      
0168   D1                     POP   DE   ; DE = a, HL = b
0169   C5                     PUSH   BC   ; free BC for udiv
016A   D5                     PUSH   DE   ; a, for r's sign
016B   7A                     LD   A,D   
016C   AC                     XOR   H   
016D   F5                     PUSH   AF   ; S flag = sign of q
016E   CB 7C                  BIT   7,H   
0170   C4 20 00               CALL   NZ,neg16   ; HL = |b|
0173   EB                     EX   DE,HL   
0174   CB 7C                  BIT   7,H   
0176   C4 20 00               CALL   NZ,neg16   ; HL = |a|, DE = |b|
0179   CD 01 02               CALL   udiv   ; HL = q, DE = r
017C   F1                     POP   AF   
017D   FC 20 00               CALL   M,neg16   ; q's sign
0180   EB                     EX   DE,HL   ; HL = r, DE = q
0181   F1                     POP   AF   ; A = a's high byte
0182   B7                     OR   A   
0183   FC 20 00               CALL   M,neg16   ; r's sign
0186   C1                     POP   BC   
0187   D5                     PUSH   DE   ; q under r
0188   F7                     RST   30h   
0189                             ; ---- stack and storage -----------------------------------------------------
0189   E5           H_DUP:    PUSH   HL   ; ":"
018A   F7                     RST   30h   
018B   E3           H_SWAP:   EX   (SP),HL   ; "%"
018C   F7                     RST   30h   
018D                             ; (The checked build tests the address before it takes the value off the
018D                             ; stack, so that an error report shows both.)
018D                H_CSTORE:      ; "." ( c addr -- )
018D                          IF   CHECKED   
                              CALL   chkst   
018D                          ENDIF      
018D   D1                     POP   DE   
018E   73                     LD   (HL),E   
018F   DF           H_DROP:   RST   18h   ; ";" is this one byte
0190                H_STORE:      ; "!" ( n addr -- )
0190                          IF   CHECKED   
                              CALL   chkst   
0190                          ENDIF      
0190   D1                     POP   DE   
0191   73                     LD   (HL),E   
0192   23                     INC   HL   
0193   72                     LD   (HL),D   
0194   DF                     RST   18h   
0195                             ; ---- console ---------------------------------------------------------------
0195                             ; 22h pushes the address of the text after it and skips the string.
0195   E5           H_STR:    PUSH   HL   
0196   60                     LD   H,B   
0197   69                     LD   L,C   
0198   CD 3E 02               CALL   skipstr   
019B                          IF   CHECKED   
                              OR   A   ; 0: the text ran out before the closing quote
                              JP   Z,e_quote   
019B                          ENDIF      
019B   F7                     RST   30h   
019C                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character
019C                             ; clears that character"s bit 6 (/M is CR, /` is space; "/" and ""' have no
019C                             ; bit 6, so // and /" give themselves).
019C                          IF   1-CHECKED   
019C   7E           H_PRINT:   LD   A,(HL)   
019D   23                     INC   HL   
019E   FE 22                  CP   22h   
01A0   28 0D                  JR   Z,pr9   
01A2   FE 2F                  CP   "/"   
01A4   20 04                  JR   NZ,pr1   
01A6   7E                     LD   A,(HL)   
01A7   23                     INC   HL   
01A8   E6 BF                  AND   0BFh   
01AA   EF           PR1:      RST   28h   
01AB   18 EF                  JR   h_print   
01AD                          ENDIF      
01AD                          IF   CHECKED   
                                 ; (The checked build has the loop as a routine, prstr, which the error
                                 ; report uses too. The address is kept on the stack meanwhile: a report
                                 ; shows the stack as it was before the "$".)
                    H_PRINT:   PUSH   HL   
                              CALL   prstr   
                              POP   DE   
                              RST   18h   
01AD                          ENDIF      
01AD   7D           H_EMIT:   LD   A,L   ; "'"
01AE   EF                     RST   28h   
01AF   DF           PR9:      RST   18h   
01B0                             ; "#" prints TOS as a signed decimal number, with no space after it.
01B0   C5           H_NUM:    PUSH   BC   
01B1   CD 6A 02               CALL   psgn   
01B4   C1                     POP   BC   
01B5   DF                     RST   18h   
01B6                             ; "?" ( n -- c ) or ( -n -- addr )
01B6                             ;   n > 0: wait about n ms for a key; 0 if none came
01B6                             ;   n = 0: wait for a key
01B6                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
01B6                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
01B6   CB 7C        H_KEY:    BIT   7,H   
