   384                              <1> 
   385                              <1> 
   386                              <1> ; '_' ( n -- addr ): the heap pointer moves by n, a signed count; TOS is
   387                              <1> ; the old pointer. The checked build stops with H if the new top is not
   388                              <1> ; below the limit or is below the program's end (done in 32 bits, so a top
   389                              <1> ; that wraps round is caught too).
   390                              <1> %macro  ALLOCCODE 0
   391                              <1> alloc1: movzx   edx,word [ARENA+HEAP]
   392                              <1> %if CHECKED
   393                              <1>         movsx   eax,bx
   394                              <1>         add     eax,edx
   395                              <1>         cmp     eax,LIMIT
   396                              <1>         jae     e_heap
   397                              <1>         cmp     eax,[V(v_npend)]
   398                              <1>         jb      e_heap
   399                              <1> %endif
   400                              <1>         add     [ARENA+HEAP],bx
   401                              <1>         mov     bx,dx
   402                              <1>         jmp     ebp
   403                              <1> %endmacro
   404                              <1> 
   405                              <1> ; '/' ( a b -- q r ): truncates toward zero, and r takes a's sign: x86's
   406                              <1> ; IDIV does exactly that. It is done in 32 bits, so that -32768 / -1 (whose
   407                              <1> ; quotient, 32768, does not fit in 16) wraps as the spec says instead of
   408                              <1> ; faulting. Dividing by 0 skips the IDIV in an unchecked build (two cells of
   409                              <1> ; no meaning: a and its sign); the checked build stops with Z. (The handler
   410                              <1> ; itself in an unchecked build; in a checked one its body, div1.)
   411                              <1> %macro  DIVCODE 0
   412                              <1> %if CHECKED
   413                              <1>         test    bx,bx
   414                              <1>         jz      e_zero
   415                              <1> %endif
   416                              <1>         pop     eax
   417                              <1>         movsx   ecx,bx
   418                              <1>         cwde
   419                              <1>         cdq
   420                              <1> %if CHECKED=0
   421                              <1>         jecxz   %%z
   422                              <1> %endif
   423                              <1>         idiv    ecx
   424                              <1> %%z:    mov     bx,ax
   425                              <1>         push    ebx                     ; q
   426                              <1>         mov     bx,dx                   ; r on top
   427                              <1>         jmp     ebp
   428                              <1> %endmacro
   429                              <1> 
   430                              <1> ; PRLOOPCODE: the loop of '$' (h_print; in a checked build the routine
   431                              <1> ; prstr). It prints from EBX to the closing quote.
   432                              <1> %macro  PRLOOPCODE 0
   433                              <1> %%pr:   mov     al,[ebx]
   434                              <1>         inc     ebx
   435                              <1>         cmp     al,22h
   436                              <1> %if CHECKED
   437                              <1>         je      %%pr9
   438                              <1>         test    al,al
   439                              <1>         jz      e_dollar                ; a NUL first: Q
   440                              <1> %else
   441                              <1>         je      h_drop
   442                              <1> %endif
   443                              <1>         cmp     al,'/'
   444                              <1>         jne     prput
   445                              <1>         movzx   eax,byte [ebx]
   446                              <1>         inc     ebx
   447                              <1>         cmp     al,60h
   448                              <1>         jb      %%pr0
   449                              <1>         cmp     al,7Fh
   450                              <1>         jb      pesc
   451                              <1> %%pr0:  and     al,0BFh
   452                              <1> prput:  CALLP   putc                    ; (/~ comes here with its 'H')
   453                              <1>         jmp     %%pr
   454                              <1> %if CHECKED
   455                              <1> %%pr9:  ret
   456                              <1> %endif
   457                              <1> %endmacro
   458                              <1> 
   459                              <1> ; PESCCODE: prstr (checked builds) and the escapes of '$'. (After the
   460                              <1> ; bodies of '[' and '`' in an unchecked build, so that h_print's loop
   461                              <1> ; reaches pesc; after the report in a checked one.)
   462                              <1> %macro  PESCCODE 0
   463                              <1> %if CHECKED
   464                              <1> ; prstr: print the string at EBX, to its closing quote, decoding '/' (this
   465                              <1> ; is '$', and the texts of the report). EBX is left past the quote. A NUL
   466                              <1> ; first is an error: Q.
   467                              <1> prstr:  PRLOOPCODE
   468                              <1> PRLOOP  equ     prstr                   ; (where the escapes go back to)
   469                              <1> %else
   470                              <1> PRLOOP  equ     h_print
   471                              <1> %endif
   472                              <1> 
   473                              <1> ; /~ ( row col addr -- ): the two cells under the string's address go.
   474                              <1> ; It comes before pesc: from there the short jumps reach h_print's loop.
   475                              <1> ; In a checked build the loop is the routine prstr: its return address
   476                              <1> ; goes, and hp1 calls it again afterwards. Before each /~ chkstk looks at
   477                              <1> ; the stack, as `next` does before each character: a /~ that finds it run
   478                              <1> ; out already is s at once. One that takes its row or column from past the
   479                              <1> ; bottom (at most two cells past, from the frame above the stack, which is
   480                              <1> ; never returned to) is s after the '$', as for any other character.
   481                              <1> pat:
   482                              <1> %if CHECKED
   483                              <1>         pop     eax
   484                              <1>         call    chkstk
   485                              <1> %endif
   486                              <1>         call    pcsi
   487                              <1>         pop     eax                     ; the column
   488                              <1>         xchg    eax,[esp]               ; the row (the column waits)
   489                              <1>         call    psgn1
   490                              <1>         mov     al,';'
   491                              <1>         CALLP   putc
   492                              <1>         pop     eax
   493                              <1>         call    psgn1
   494                              <1>         mov     al,'H'
   495                              <1> %if CHECKED
   496                              <1>         CALLP   putc
   497                              <1>         jmp     hp1
   498                              <1> %else
   499                              <1>         jmp     prput
   500                              <1> %endif
   501                              <1> 
   502                              <1> ; pesc: the escapes of '$'. EAX = the character after the '/', 60h to 7Eh,
   503                              <1> ; and EBX points past it. Each goes back into the loop (PRLOOP), but /~ has
   504                              <1> ; the stack to see to.
   505                              <1> ;    /a-/z   print the variable, as '#' does
   506                              <1> ;    /{      clear the screen, the cursor to the top left: ESC [ H ESC [ J
   507                              <1> ;    /}      clear from the cursor to the end of the line: ESC [ K
   508                              <1> ;    /|  /`  show the cursor, hide it: ESC [ ? 2 5 h, ESC [ ? 2 5 l
   509                              <1> ;    /~      ( row col -- ) the cursor to that row and column, from 0:
   510                              <1> ;            ESC [ row+1 ; col+1 H
   511                              <1> pesc:   cmp     al,7Eh
   512                              <1>         je      pat
   513                              <1>         push    PRLOOP                  ; (the others return into the loop)
   514                              <1>         cmp     al,7Bh
   515                              <1>         jae     pcon
   516                              <1>         cmp     al,60h
   517                              <1>         je      phide
   518                              <1>         mov     ax,[ARENA+LET-2*41h+eax*2]  ; a-z: the variable's cell (as in
   519                              <1>         jmp     psgn                    ;   `lower`)
   520                              <1> pcon:   mov     eax,[ptails-4*7Bh+eax*4] ; { | }
   521                              <1> pseq:   push    eax                     ; ESC [ and then the bytes of EAX
   522                              <1>         call    pcsi
   523                              <1>         pop     eax
   524                              <1>         jmp     pch
   525                              <1> phide:  mov     eax,6C35323Fh           ; ? 2 5 l
   526                              <1>         jmp     pseq
   527                              <1> ptails: dd      4A5B1B48h               ; {  H ESC [ J
   528                              <1>         dd      6835323Fh               ; |  ? 2 5 h
   529                              <1>         dd      4Bh                     ; }  K
   530                              <1> ; pcsi: print ESC [. pch: print the bytes of EAX, from the low one up to the
   531                              <1> ; last that is not 0 (at least one). Both use EAX.
   532                              <1> pcsi:   mov     eax,5B1Bh
   533                              <1> pch:    CALLP   putc
   534                              <1>         shr     eax,8
   535                              <1>         jnz     pch
   536                              <1>         ret
   537                              <1> %endmacro
   538                              <1> 
   539                              <1> ; =============================================================================
   540                              <1> ;  Punctuation handlers. PTAB holds one byte per character: its handler's
   541                              <1> ;  distance from hbase, so every handler starts in the 256 bytes from hbase
   542                              <1> ;  (PT checks it). Only the starts must be there: the last handler, '$',
   543                              <1> ;  runs on past the window, and '[', '`' (and '_' and '/' in a checked
   544                              <1> ;  build) are stubs that jump to their bodies after it. Each handler starts
   545                              <1> ;  with EBX = TOS and EAX, ECX, EDX free, and ends with JMP EBP.
   546                              <1> ;  (Two other layouts were tried: handlers 2-aligned with the table holding
   547                              <1> ;  half the distance, which costs a NOP after every handler of odd length,
   548                              <1> ;  about 22 bytes; and the Z80's two 256-byte windows, whose dispatcher is 7
   549                              <1> ;  bytes longer and whose handlers must be in table order, which costs near
   550                              <1> ;  jumps.)
   551                              <1> ; =============================================================================
   552                              <1> hbase:
   553                              <1> ; ']' returns: pop an address and jump to it.
   554 00000101 8B37                <1> h_ret:  mov     esi,[edi]
   555 00000103 AF                  <1> rdrop:  scasd                           ; drop the return stack's top
   556 00000104 FFE5                <1> nx:     jmp     ebp
   557                              <1> 
   558                              <1> ; '\' ( flag -- ): true skips to the next ')' or ']' at this level; ')'
   559                              <1> ; drops the block start, ']' returns. No closer at all ends the program.
   560 00000106 6685DB              <1> h_break:test    bx,bx
   561 00000109 5B                  <1>         pop     ebx
   562 0000010A 74F8                <1>         jz      nx
   563 0000010C E8D6040000          <1>         call    skip
   564 00000111 84C0                <1>         test    al,al                   ; skip returns 0 for ')'
   565 00000113 75EC                <1>         jnz     h_ret
   566 00000115 EBEC                <1>         jmp     rdrop
   567                              <1> 
   568                              <1> ; ')' ( flag -- ): true jumps back to the block start (and keeps it); false
   569                              <1> ; drops it and carries on. The loop-back looks at the break key.
   570 00000117 6685DB              <1> h_close:test    bx,bx
   571 0000011A 5B                  <1>         pop     ebx
   572 0000011B 74E6                <1>         jz      rdrop
   573 0000011D 8B37                <1>         mov     esi,[edi]
   574 0000011F EBC9                <1>         jmp     rpoll
   575                              <1> 
   576                              <1> ; '(' ( flag -- ): true pushes the block start and enters; false skips to
   577                              <1> ; the matching ')'.
   578 00000121 6685DB              <1> h_open: test    bx,bx
   579 00000124 5B                  <1>         pop     ebx
   580 00000125 0F84F1000000        <1>         jz      skipo
   581 0000012B 89F2                <1>         mov     edx,esi
   582 0000012D EBB6                <1>         jmp     rpush
   583                              <1> 
   584                              <1> ; '{' TOS to the return stack, '}' back.
   585 0000012F 89DA                <1> h_tor:  mov     edx,ebx
   586 00000131 5B                  <1>         pop     ebx
   587 00000132 EBB1                <1>         jmp     rpush
   588 00000134 53                  <1> h_fromr:push    ebx
   589 00000135 8B1F                <1>         mov     ebx,[edi]
