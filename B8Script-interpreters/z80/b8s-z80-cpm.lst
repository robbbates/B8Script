04F9                          IF   CPM   
04F9                             ; RAM pages, after the image
04F9                CPAGE:    EQU   (imgend + 255) / 256   ; the skip cache (QK builds), first, so
04F9                RSPAGE:   EQU   CPAGE + QK   ;   that the letter page is still the one
04F9                DSPAGE:   EQU   RSPAGE + 1   ;   just below the program text
04F9                LETPAGE:   EQU   RSPAGE + 2   
04F9                PROG:     EQU   LETPAGE*256 + 256   
04F9                          ENDIF      
04F9                IMGEND:      


