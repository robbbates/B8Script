                              LDA   T0   
                              ADC   0,X   
                              STA   T0   
                              LDA   T1   
                              ADC   1,X   
                    MQ2:      ROR      
                              ROR   T0   
                              ROR   2,X   
                              DEY      
                              BNE   mq1   
                              LDA   T0   
                              STA   3,X   
                              INX      
                              INX      
                              RTS      
                    MQ16:     LDY   #16   
                              LDA   #0   
                              STA   T0   
                              LSR   3,X   
                              ROR   2,X   
