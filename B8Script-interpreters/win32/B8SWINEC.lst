   729                              <1> 
   730                              <1> ; '[' followed by a letter stores the body's address in that letter's cell:
   731                              <1> ; uppercase is a word, lowercase a variable. Followed by a space it pushes
   732                              <1> ; the body's address instead. Either way it then skips to the matching ']'.
   733                              <1> ; (The unchecked build takes anything that is not a letter as the space; the
   734                              <1> ; checked build stops on it with W.)
   735 00000208 31C0                <1> def1:   xor     eax,eax
   736 0000020A AC                  <1>         lodsb
   737 0000020B 2C41                <1>         sub     al,'A'                  ; a letter gives 0-25 or 32-57:
   738 0000020D 89C2                <1>         mov     edx,eax                 ;   lowercase lands 64 bytes up
   739 0000020F 24DF                <1>         and     al,0DFh                 ; (fold case)
   740 00000211 3C1A                <1>         cmp     al,26
   741 00000213 730A                <1>         jae     .nl
   742 00000215 6689B41200014100    <1>         mov     [ARENA+LET+edx*2],si
   743 0000021D EB0C                <1>         jmp     short .sk
   744                              <1> .nl:
   745                              <1> %if CHECKED
   746 0000021F 80FADF              <1>         cmp     dl,' '-'A'
