                              ROL   0FFh,X   
                              SEC      
                              LDA   0FEh,X   
                              SBC   D0   
                              STA   T0   
                              LDA   0FFh,X   
                              SBC   D1   
                              BCC   ud2   
                              STA   0FFh,X   
                              LDA   T0   
                              STA   0FEh,X   
                              INC   0,X   ; the quotient bit (bit 0 is free)
                    UD2:      DEY      
                              BNE   ud1   
                              RTS      
