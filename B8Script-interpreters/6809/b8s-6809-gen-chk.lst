F41E                             ; ---- the tail ---------------------------------------------------------------
F41E                             ; "/" is the last handler, so what follows its first byte may lie past the
F41E                             ; second range: the divide itself and the routines after it.
F41E                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
F41E                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
F41E                             ; of a. Unchecked, dividing by zero returns two cells of no meaning; checked,
F41E                             ; it stops with Z, both operands still on the stack.
F41E                H_DIV:       
F41E                          IF   CHECKED   
F41E   EC C4                  LDD   ,U   
F420   10 27 FE EC            LBEQ   e_zero   
F424                          ENDIF      
F424   A6 42                  LDA   2,U   
F426   34 02                  PSHS   A   ; a's sign: for r
F428   A8 C4                  EORA   ,U   
F42A   34 02                  PSHS   A   ; a xor b: for q
F42C   30 42                  LEAX   2,U   
F42E   8D 22                  BSR   absx   ; |a|
F430   1F 31                  TFR   U,X   
F432   8D 1E                  BSR   absx   ; |b|
F434   8D 22                  BSR   udiv   ; NOS = q, TOS = r
F436   30 42                  LEAX   2,U   
F438   6D E0                  TST   ,S+   
F43A   2A 02                  BPL   dv1   
F43C   8D 0B                  BSR   negx   ; q's sign
F43E   6D E0        DV1:      TST   ,S+   
F440   2A 0F                  BPL   ng9   
F442   20 03                  BRA   negt   ; r's sign
F444   BD F0 C2     NEGNUM:   JSR   rdnum   ; a negative literal: read it, then negate
F447   1F 31        NEGT:     TFR   U,X   
F449   EC 84        NEGX:     LDD   ,X   ; negx: negate the cell at X
F44B   40                     NEGA      
F44C   50                     NEGB      
F44D   82 00                  SBCA   #0   
F44F   ED 84                  STD   ,X   
F451   39           NG9:      RTS      
F452   6D 84        ABSX:     TST   ,X   ; absx: negate the cell at X if negative
F454   2A FB                  BPL   ng9   
F456   20 F1                  BRA   negx   
F458                             ; udiv: unsigned divide, in place. The dividend is the NOS cell and the
F458                             ; divisor the TOS cell, both <= 8000h; the NOS cell becomes the quotient and
F458                             ; the TOS cell the remainder. The remainder is built in D (always < the
F458                             ; divisor, so 2R+1 fits in 16 bits).
F458                             ; Dividing by 2 is one shift (the spec wants that fast).
F458   EC C4        UDIV:     LDD   ,U   
F45A   83 00 02               SUBD   #2   
F45D   26 07                  BNE   ud0   
F45F   64 42                  LSR   2,U   
F461   66 43                  ROR   3,U   ; the quotient
F463   59                     ROLB      ; the remainder: the bit that fell out (D was 0)
F464   20 18                  BRA   ud3   
F466   8E 00 10     UD0:      LDX   #16   
F469   4F                     CLRA      
F46A   5F                     CLRB      
F46B   68 43        UD1:      ASL   3,U   
F46D   69 42                  ROL   2,U   ; the dividend's top bit ...
F46F   59                     ROLB      
F470   49                     ROLA      ; ... into the remainder
F471   10 A3 C4               CMPD   ,U   
F474   25 04                  BLO   ud2   
F476   A3 C4                  SUBD   ,U   
F478   6C 43                  INC   3,U   ; a quotient bit
F47A   30 1F        UD2:      LEAX   -1,X   
F47C   26 ED                  BNE   ud1   
F47E   ED C4        UD3:      STD   ,U   
F480   39                     RTS      
F481                             ; =============================================================================
F481                             ;  The grave's codes (h_grave is the dispatcher). Each is entered with
F481                             ;  A = the character, and ends in RTS.
F481                             ; 
F481                             ;    `!  ( addr -- )        call the machine code at addr. The code is
F481                             ;                           entered with the address already popped: U
F481                             ;                           points at the top data cell (big-endian) and the
F481                             ;                           dispatcher's return address is on top of S. It
F481                             ;                           may pop and push data cells by changing U; on
F481                             ;                           return the cell at ,U is the new TOS. It must
F481                             ;                           keep Y, DP and S (balanced) and return with RTS;
F481                             ;                           A, B, X and CC may change.
F481                             ;    `$  ( addr -- addr' )  the hex loader: pairs of hex digits are stored
F481                             ;                           from addr until a non-hex character; then a RTS
F481                             ;                           (39h) is written and its address is left. An odd
F481                             ;                           last digit is consumed and dropped.
F481                             ;    `'  ( -- )             new line: CR LF
F481                             ;    `+  ( addr -- n )      add 1 to the cell at addr and leave its new value
F481                             ;    `,  ( n -- r )         a random number from 0 to n-1 (n is 1 to 32767)
F481                             ;    `-  ( addr -- n )      subtract 1 from the cell at addr, the same way
F481                             ;    `.  ( -- addr )        the address of the random seed
F481                             ;    `<  ( a b -- n )       the smaller of the two (signed)
F481                             ;    `>  ( a b -- n )       the larger
F481                             ;    `?  ( flag -- )        the cursor off (0) or on
F481                             ;    `@  ( row col -- )     the cursor to that row and column, both from 0
F481                             ;    `^  ( -- )             clear the screen and home the cursor
F481                             ;    `_  ( -- )             clear from the cursor to the end of the line
F481                             ; 
F481                             ;  Neither the loader's stores nor the machine code are checked.
F481                             ; =============================================================================
F481                             ; The table: a character, then its handler's distance from the address
F481                             ; after that byte.
F481   21           GTAB:     FCB   "!"   
F482   B0                     FCB   g_exec-$-1   
F483   24                     FCB   "$"   
F484   80                     FCB   g_hex-$-1   
F485   27                     FCB   27h   
F486   76                     FCB   g_nl-$-1   
F487   2B                     FCB   "+"   
F488   3E                     FCB   g_inc-$-1   
F489   2C                     FCB   ","   
F48A   11                     FCB   g_rnd-$-1   
F48B   2D                     FCB   "-"   
F48C   3A                     FCB   g_inc-$-1   
F48D   2E                     FCB   "."   
F48E   55                     FCB   g_seed-$-1   
F48F   3C                     FCB   "<"   
F490   5F                     FCB   g_min-$-1   
F491   3E                     FCB   ">"   
F492   57                     FCB   g_max-$-1   
F493   3F                     FCB   "?"   
F494   B1                     FCB   g_cur-$-1   
F495   40                     FCB   "@"   
F496   D1                     FCB   g_at-$-1   
F497   5E                     FCB   "^"   
F498   9C                     FCB   g_cls-$-1   
F499   5F                     FCB   "_"   
F49A   A3                     FCB   g_eol-$-1   
F49B                          IF   CHECKED   
F49B   00                     FCB   0   ; the end
F49C                          ENDIF      
F49C                             ; `, The seed goes one step on: seed * 261 + 1, which takes every 16-bit
F49C                             ; value in turn. The high bits of such a seed are the good ones and the low
F49C                             ; ones repeat soon, so the high byte is folded into the low (EOR) before the
F49C                             ; remainder of dividing by n is taken.
F49C                             ; n must be 1 to 32767: the checked build stops with Z on anything less
F49C                             ; than 1.
F49C                G_RND:       
F49C                          IF   CHECKED   
F49C   EC C4                  LDD   ,U   
F49E   83 00 01               SUBD   #1   ; n - 1 negative: n is 0 or less
F4A1   10 2B FE 6B            LBMI   e_zero   
F4A5                          ENDIF      
F4A5   D6 76                  LDB   <SEED   ; (the cell is little-endian)
F4A7   96 77                  LDA   <SEED+1   
F4A9   58                     ASLB      
F4AA   49                     ROLA      
F4AB   58                     ASLB      
F4AC   49                     ROLA      
F4AD   1A 01                  ORCC   #1   ; (the carry is the + 1)
F4AF   D9 76                  ADCB   <SEED   
F4B1   99 77                  ADCA   <SEED+1   ; * 5 + 1
F4B3   9B 76                  ADDA   <SEED   ; + * 256: * 261 + 1
F4B5   D7 76                  STB   <SEED   
F4B7   97 77                  STA   <SEED+1   
F4B9   D8 77                  EORB   <SEED+1   
F4BB   36 06                  PSHU   D   
F4BD   BD F2 BE               JSR   h_swap   ; the dividend under n
F4C0   8D 96                  BSR   udiv   ; NOS = the quotient, TOS = the remainder
F4C2   37 06                  PULU   D   
F4C4   ED C4                  STD   ,U   
F4C6   39                     RTS      
F4C7                             ; `+ and `-: one routine. "," minus the character is 1 or -1.
F4C7   AE C4        G_INC:    LDX   ,U   
F4C9                          IF   CHECKED   
F4C9   BD F3 02               JSR   chkst   ; both bytes are tested first, as "!" does
F4CC   30 01                  LEAX   1,X   
F4CE   BD F3 02               JSR   chkst   
F4D1   30 1F                  LEAX   -1,X   
F4D3                          ENDIF      
F4D3   40                     NEGA      
F4D4   8B 2C                  ADDA   #","   
F4D6   1F 89                  TFR   A,B   
F4D8   1D                     SEX      
F4D9   EB 84                  ADDB   ,X   ; (the cell is little-endian)
F4DB   A9 01                  ADCA   1,X   
F4DD   E7 84                  STB   ,X   
F4DF   A7 01                  STA   1,X   
F4E1   ED C4                  STD   ,U   ; the new value is TOS
F4E3   39                     RTS      
F4E4                             ; `. pushes the address of the random seed.
F4E4   8E 82 76     G_SEED:   LDX   #LET+SEED   
F4E7   36 10                  PSHU   X   
F4E9   39                     RTS      
F4EA                             ; `< and `>: b is taken off and compared with a; it goes in a's place if it
F4EA                             ; is the one wanted.
F4EA   8D 0B        G_MAX:    BSR   gcmp   
F4EC   2F 08                  BLE   gm9   
F4EE   20 04                  BRA   gm8   
F4F0   8D 05        G_MIN:    BSR   gcmp   
F4F2   2C 02                  BGE   gm9   
F4F4   ED C4        GM8:      STD   ,U   
F4F6   39           GM9:      RTS      
F4F7   EC C1        GCMP:     LDD   ,U++   
F4F9   10 A3 C4               CMPD   ,U   ; b - a
F4FC   39                     RTS      
F4FD   86 0D        G_NL:     LDA   #13   
F4FF   8D 64                  BSR   gputc   
F501   86 0A                  LDA   #10   
F503   20 60                  BRA   gputc   
F505   AE C4        G_HEX:    LDX   ,U   
F507   8D 18        HX1:      BSR   hexc   
F509   24 0F                  BCC   hx2   
F50B   C6 10                  LDB   #16   
F50D   3D                     MUL      ; B = the digit, moved up to the high half
F50E   E7 84                  STB   ,X   ; (an odd digit is overwritten by the RTS)
F510   8D 0F                  BSR   hexc   
F512   24 06                  BCC   hx2   ; odd digit: already consumed, dropped
F514   AA 84                  ORA   ,X   
F516   A7 80                  STA   ,X+   
F518   20 ED                  BRA   hx1   
F51A   86 39        HX2:      LDA   #39h   ; RTS
F51C   A7 84                  STA   ,X   
F51E   AF C4                  STX   ,U   
F520   39                     RTS      
F521                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
F521                             ; and return its value in A with the carry set; otherwise leave the IP and
F521                             ; return with the carry clear.
F521   BD F0 BB     HEXC:     JSR   isdig   
F524   25 0A                  BLO   hv1   ; C = 1
F526   84 DF                  ANDA   #0DFh   
F528   80 11                  SUBA   #11h   
F52A   81 06                  CMPA   #6   
F52C   24 04                  BHS   hv9   ; C = 0
F52E   80 F6                  SUBA   #0F6h   ; + 10, and sets the carry
F530   31 21        HV1:      LEAY   1,Y   ; (LEAY leaves the carry alone)
F532   39           HV9:      RTS      
F533   37 80        G_EXEC:   PULU   PC   ; jump to it: the code's RTS returns to the
F535                             ;   dispatcher
F535                          IF   ANSI   
F535                             ; `^: ESC [ H homes the cursor, and ESC [ J clears from there to the end of
F535                             ; the screen. `_: ESC [ K clears to the end of the line. (CONOUT keeps B.)
F535   8D 28        G_CLS:    BSR   csi   
F537   86 48                  LDA   #"H"   
F539   8D 2A                  BSR   gputc   
F53B   C6 4A                  LDB   #"J"   
F53D   8C                     FCB   8Ch   ; (CMPX #: steps over the LDB)
F53E   C6 4B        G_EOL:    LDB   #"K"   
F540   8D 1D                  BSR   csi   
F542   1F 98                  TFR   B,A   
F544   20 1F                  BRA   gputc   
F546                             ; `? ( flag -- ): ESC [ ? 2 5 l hides the cursor, ESC [ ? 2 5 h shows it.
F546   8D 17        G_CUR:    BSR   csi   
F548   86 3F                  LDA   #"?"   
F54A   8D 19                  BSR   gputc   
F54C   86 32                  LDA   #"2"   
F54E   8D 15                  BSR   gputc   
F550   86 35                  LDA   #"5"   
F552   8D 11                  BSR   gputc   
F554   AE C1                  LDX   ,U++   ; the flag
F556   27 03                  BEQ   gc1   
F558   86 68                  LDA   #"h"   
F55A   8C                     FCB   8Ch   ; (CMPX #: steps over the LDA)
F55B   86 6C        GC1:      LDA   #"l"   
F55D   20 06                  BRA   gputc   
F55F                             ; csi: print ESC [, which starts every ANSI sequence.
F55F   86 1B        CSI:      LDA   #27   
F561   8D 02                  BSR   gputc   
F563   86 5B                  LDA   #"["   
F565                          ENDIF      
F565   7E FF 03     GPUTC:    JMP   CONOUT   
F568                          IF   ANSI   
F568                             ; `@ ( row col -- ): ESC [ row+1 ; col+1 H. (ANSI counts from 1.)
F568   8D F5        G_AT:     BSR   csi   
F56A   BD F2 BE               JSR   h_swap   ; the row on top
F56D   8D 0A                  BSR   pinc   
F56F   86 3B                  LDA   #";"   
F571   8D F2                  BSR   gputc   
F573   8D 04                  BSR   pinc   
F575   86 48                  LDA   #"H"   
F577   20 EC                  BRA   gputc   
F579                             ; pinc: print the top cell plus 1, unsigned, and drop it
F579   6C 41        PINC:     INC   1,U   
F57B   26 02                  BNE   pi1   
F57D   6C C4                  INC   ,U   
F57F   7E F3 E9     PI1:      JMP   pdec   
F582                          ENDIF      
F582                          IF   1-ANSI   
                                 ; With ANSI = 0 the machine's own routines do the work (see the equates).
                    G_CLS:    JMP   CONCLS   
                    G_EOL:    JMP   CONEOL   
                    G_CUR:    LDD   ,U++   ; D = the flag, and the Z flag says the same
                              JMP   CONCUR   
                    G_AT:     LDD   ,U++   ; D = the column
                              LDX   ,U++   ; X = the row
                              JMP   CONAT   
F582                          ENDIF      
F582                          IF   CHECKED   
F582                          ;*Macro unroll:  LINERD                  ; the line reader of -n?
F582   8C FF 81     LINE:     CMPX   #-127   ; the line reader of -n?
F585   24 04                  BHS   ln1   
F587   86 81                  LDA   #-127   
F589   A7 41                  STA   1,U   
F58B   60 41        LN1:      NEG   1,U   
F58D   8E 82 80               LDX   #LINEBUF   
F590   5F                     CLRB      
F591   BD F0 ED     LN2:      JSR   getk   
F594   27 FB                  BEQ   ln2   
F596   81 0D                  CMPA   #13   
F598   27 16                  BEQ   ln5   
F59A   81 08                  CMPA   #8   
F59C   27 0C                  BEQ   ln4   
F59E   E1 41                  CMPB   1,U   
F5A0   24 EF                  BHS   ln2   
F5A2   A7 85                  STA   B,X   
F5A4   5C                     INCB      
F5A5   BD FF 03     LN3:      JSR   CONOUT   
F5A8   20 E7                  BRA   ln2   
F5AA   5D           LN4:      TSTB      
F5AB   27 E4                  BEQ   ln2   
F5AD   5A                     DECB      
F5AE   20 F5                  BRA   ln3   
F5B0   A7 85        LN5:      STA   B,X   
F5B2   AF C4                  STX   ,U   
F5B4   39                     RTS      
F5B5                          ENDIF      
F5B5                IMGEND:      


