04E3   CF                     RST   1   
04E4   44                     MOV   B,H   
04E5   4D                     MOV   C,L   
04E6   E1                     POP   H   
04E7   3E 55                  MVI   A,"U"   
04E9   C3 FB 04               JMP   error   
04EC                             ; Error entries. Each loads its letter and then hides the next entry inside
04EC                             ; a 3-byte LXI D (the 11h), so they all fall through to `error`.
04EC   44           E_QUOTE:   MOV   B,H   ; an unclosed string: HL is its address, one
04ED   4D                     MOV   C,L   ;   past the opening quote, which is the place
04EE   3E 51                  MVI   A,"Q"   
04F0   11                     DB   11h   
04F1   3E 58        E_RESV:   MVI   A,"X"   ; a reserved byte outside a string
04F3   11                     DB   11h   
04F4   3E 5A        E_ZERO:   MVI   A,"Z"   ; dividing by zero
04F6   11                     DB   11h   
04F7   3E 57        E_BRACK:   MVI   A,"W"   ; bad character after [
04F9   FE                     DB   0FEh   ; (CPI hides the one byte of errp)
04FA                             ; errp: an error found inside a routine: drop its return address first.
04FA   D1           ERRP:     POP   D   
04FB                             ; error: the report, then the end. A = the letter, BC = one past the place,
04FB                             ; HL = TOS, and both stacks as the report is to show them:
04FB                             ; 
04FB                             ;   Err X @ line,col
04FB                             ;   up to 16 characters of the text from the place
04FB                             ;   Stk n: the top 8 cells at most, bottom to top
04FB                             ;   Rtn n
04FB   E5           ERROR:    PUSH   H   ; now the whole data stack is in memory
04FC   5F                     MOV   E,A   
04FD   CD 9A 04               CALL   pnl   
0500   45 72 72 20 22         DB   "Err ",22h   
0505   7B                     MOV   A,E   
0506   EF                     RST   5   
0507   CD A0 04               CALL   pmsg   
050A   20 40 20 22            DB   " @ ",22h   
050E   0B                     DCX   B   ; BC = the place
050F                             ; The line and column. A place below the program is in the line
050F                             ; buffer: line 0. Otherwise count the LFs from the program's start;
050F                             ; DE = the line's number, HL = where it starts.
050F   21 80 82               LXI   H,LINEBUF   
0512   11 00 00               LXI   D,0   
0515   78                     MOV   A,B   
0516   FE 83                  CPI   PROG/256   
0518   DA 32 05               JC   er3   
051B   24                     INR   H   
051C   6B                     MOV   L,E   ; HL = PROG
051D   13           ER1:      INX   D   ; a new line starts at HL
051E   E5                     PUSH   H   
051F   7D           ER2:      MOV   A,L   
0520   91                     SUB   C   
0521   7C                     MOV   A,H   
0522   98                     SBB   B   
0523   D2 31 05               JNC   er2x   ; reached the place
0526   7E                     MOV   A,M   
0527   23                     INX   H   
0528   FE 0A                  CPI   10   
052A   C2 1F 05               JNZ   er2   
052D   F1                     POP   PSW   
052E   C3 1D 05               JMP   er1   
0531   E1           ER2X:     POP   H   
0532   C5           ER3:      PUSH   B   
0533   E5                     PUSH   H   
0534   EB                     XCHG      
0535   CD 95 03               CALL   pdec   ; the line
0538   3E 2C                  MVI   A,","   
053A   EF                     RST   5   
053B   D1                     POP   D   
053C   E1                     POP   H   
053D   E5                     PUSH   H   
053E   CD C9 05               CALL   sub16   
0541   23                     INX   H   
0542   CD 95 03               CALL   pdec   ; the column
0545   CD 9A 04               CALL   pnl   
0548   22                     DB   22h   
0549   E1                     POP   H   ; the text, as it is: 16 characters, or fewer
054A   06 10                  MVI   B,16   ;   if the line or the program ends first
054C   7E           ER4:      MOV   A,M   
054D   23                     INX   H   
054E   B7                     ORA   A   
054F   CA 61 05               JZ   er5   
0552   FE 0D                  CPI   13   
0554   CA 61 05               JZ   er5   
0557   FE 0A                  CPI   10   
0559   CA 61 05               JZ   er5   
055C                          ENDIF      
055C                          IF   CHECKED*CPM   
                              CPI   1Ah   ; (the ^Z that pads a file's last record ends
                              JZ   er5   ;   the text too: some terminals clear the
055C                          ENDIF      ;   screen on it)
