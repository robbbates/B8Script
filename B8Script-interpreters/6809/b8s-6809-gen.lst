F132   4D                     TSTA      ; skip returns 0 for ")"
F133   26 F3                  BNE   h_ret   
F135   35 16        RDROP:    PULS   D,X   ; the return address and the block start
F137   1F 05                  TFR   D,PC   ; back to the dispatcher
F139                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
F139                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
F139                             ; the body"s address instead. Either way it then skips to the matching "]'.
F139                             ; (The unchecked build takes anything below "A" as the space, and anything
F139                             ; from "A" up as a letter.)
F139   A6 A0        H_DEF:    LDA   ,Y+   
F13B                          IF   CHECKED   
                              CMPA   #" "   
                              BEQ   def2   
                              TFR   A,B   
                              ANDB   #0DFh   ; fold case
                              SUBB   #"A"   
                              CMPB   #26   
                              LBHS   e_brack   ; anything but a letter or a space
F13B                          ENDIF      
F13B   80 41                  SUBA   #"A"   ; 0-25 or 32-57: lowercase lands 64 bytes up
F13D                          IF   1-CHECKED   
F13D   25 0A                  BLO   def2   
F13F                          ENDIF      
F13F   BD F0 73               JSR   cellx   
F142   1F 20                  TFR   Y,D   
F144   E7 84                  STB   ,X   ; little-endian
F146   A7 01                  STA   1,X   
F148   8C                     FCB   8Ch   ; (CMPX #: steps over the PSHU)
F149   36 20        DEF2:     PSHU   Y   ; an anonymous block: push its address
F14B                             ; fall into skip
F14B                             ; skip: read past text to the closer at this level, and return A = 0 if it
F14B                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
F14B                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
F14B                             ; no closer; anything else that runs into the NUL had unbalanced brackets
F14B                             ; anyway). B counts the open levels.
F14B   5F           SKIP:     CLRB      
F14C   A6 A0        SK1:      LDA   ,Y+   
F14E   10 27 FE AE            LBEQ   fin   
F152   81 22                  CMPA   #22h   
F154   26 02                  BNE   sk2   
F156   8D 70                  BSR   skipstr   ; leaves A = 22h, which matches nothing below
F158   80 28        SK2:      SUBA   #"("   
F15A   27 0F                  BEQ   sk3   
F15C   4A                     DECA      ; ")"
F15D   27 08                  BEQ   sk4   
F15F   80 32                  SUBA   #"["-")"   
F161   27 08                  BEQ   sk3   
F163   81 02                  CMPA   #"]"-"["   
F165   26 E5                  BNE   sk1   
F167   5A           SK4:      DECB      
F168   2A E2                  BPL   sk1   
F16A   39           SK9:      RTS      ; the closer at this level
F16B   5C           SK3:      INCB      
F16C   20 DE                  BRA   sk1   
F16E   AE C4        H_FETCH:   LDX   ,U   ; "@" (the cell in memory is little-endian)
F170   A6 01                  LDA   1,X   
F172   20 62                  BRA   cf1   
F174                             ; "?" ( n -- c ) or ( -n -- addr )
F174                             ;   n > 0: wait about n ms for a key; 0 if none came
F174                             ;   n = 0: wait for a key
F174                             ;   n < 0: read a line of at most -n characters, with echo. n is not
F174                             ;          checked: the buffer holds 127 characters and the CR, so a
F174                             ;          program must ask for 127 or fewer.
F174   AE C4        H_KEY:    LDX   ,U   
F176   2B 17                  BMI   line   
F178   C6 14        KT1:      LDB   #MSLOOP   ; one millisecond, roughly
F17A   BD FF 06     KT2:      JSR   getk   
F17D   26 0B                  BNE   kt3   
F17F   5A                     DECB      
F180   26 F8                  BNE   kt2   
F182   30 1F                  LEAX   -1,X   
F184   26 F2                  BNE   kt1   ; A = 0 if the time ran out
F186   AE C4                  LDX   ,U   ; 0?: the countdown from 0 took 65536 ms;
F188   27 EE                  BEQ   kt1   ;   run it again, until a key comes
F18A   6F C4        KT3:      CLR   ,U   
F18C   A7 41                  STA   1,U   
F18E   39                     RTS      
F18F                             ; Backspace takes the last character back (and is echoed as it is), CR ends
F18F                             ; (stored, not echoed), every other key is stored and echoed until the line
F18F                             ; is full. B = the length so far; the low byte of the top cell becomes the
F18F                             ; most allowed (it holds minus the count on entry).
F18F   60 41        LINE:     NEG   1,U   
F191   8E 82 80               LDX   #LINEBUF   
F194   5F                     CLRB      
F195   BD FF 06     LN2:      JSR   getk   
F198   27 FB                  BEQ   ln2   
F19A   81 0D                  CMPA   #13   
F19C   27 16                  BEQ   ln5   
F19E   81 08                  CMPA   #8   
F1A0   27 0C                  BEQ   ln4   
F1A2   E1 41                  CMPB   1,U   
F1A4   24 EF                  BHS   ln2   ; full
F1A6   A7 85                  STA   B,X   
F1A8   5C                     INCB      
F1A9   BD FF 03     LN3:      JSR   CONOUT   
F1AC   20 E7                  BRA   ln2   
F1AE   5D           LN4:      TSTB      ; Backspace: nothing to take back?
F1AF   27 E4                  BEQ   ln2   
F1B1   5A                     DECB      
F1B2   20 F5                  BRA   ln3   ; echo it
F1B4   A7 85        LN5:      STA   B,X   ; A = 13
F1B6   AF C4                  STX   ,U   
F1B8   39                     RTS      
F1B9                             ; =============================================================================
F1B9                             ;  Handlers that must start in the second range (unchecked build).
F1B9                             ; =============================================================================
F1B9                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
F1B9                             ; the matching ")".
F1B9   EC C1        H_OPEN:   LDD   ,U++   
F1BB   27 8E                  BEQ   skip   ; tail call: skip ends in RTS
F1BD   35 10                  PULS   X   
F1BF   34 20                  PSHS   Y   
F1C1   6E 84                  JMP   ,X   
F1C3                             ; 22h pushes the address of the text after it and skips the string.
F1C3   36 20        H_STR:    PSHU   Y   
F1C5   8C                     FCB   8Ch   ; (CMPX #: steps over the LEAY)
F1C6                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
F1C6                             ; the next character, so "/"" does not end it. Leaves A = 22h.
F1C6   31 21        SS0:      LEAY   1,Y   
F1C8   A6 A0        SKIPSTR:   LDA   ,Y+   
F1CA   81 2F                  CMPA   #"/"   
F1CC   27 F8                  BEQ   ss0   
F1CE   81 22                  CMPA   #22h   
F1D0   26 F6                  BNE   skipstr   
F1D2   39                     RTS      
F1D3   AE C4        H_CFETCH:   LDX   ,U   ; ","
F1D5   4F                     CLRA      
F1D6   E6 84        CF1:      LDB   ,X   
F1D8   ED C4                  STD   ,U   
F1DA   39                     RTS      
F1DB                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
F1DB                             ; drops it and carries on.
F1DB   EC C1        H_CLOSE:   LDD   ,U++   
F1DD   10 27 FF 54            LBEQ   rdrop   
F1E1                          IF   CHECKED   
                              JSR   chkbrk   ; Ctrl-C is checked at every loop-back
F1E1                          ENDIF      
F1E1   10 AE 62               LDY   2,S   ; the block start, under the return address
F1E4   39                     RTS      
F1E5                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
F1E5                             ; "*": three 8x8 multiplies; only the low 16 bits are kept.
F1E5                             ; a = ah:al at 2,U.  b = bh:bl at ,U.
F1E5   A6 43        H_MUL:    LDA   3,U   
F1E7   E6 C4                  LDB   ,U   
F1E9   3D                     MUL      ; al*bh
F1EA   E7 C4                  STB   ,U   ; (bh is no longer needed)
F1EC   A6 42                  LDA   2,U   
F1EE   E6 41                  LDB   1,U   
F1F0   3D                     MUL      ; ah*bl
F1F1   EB C4                  ADDB   ,U   
F1F3   E7 C4                  STB   ,U   ; the cross terms, low byte
F1F5   A6 43                  LDA   3,U   
F1F7   E6 41                  LDB   1,U   
F1F9   3D                     MUL      ; al*bl
F1FA   AB C4                  ADDA   ,U   
F1FC   33 42                  LEAU   2,U   
F1FE   ED C4                  STD   ,U   
F200   39                     RTS      
F201                             ; Signed compares: a-b, then a branch to put -1 or 0 on the stack.
F201   8D 69        H_GT:     BSR   h_swap   ; a > b is b < a
F203   8D 10        H_LT:     BSR   cmp   
F205   2D 02                  BLT   true   
F207   5F           FALSE:    CLRB      
F208   8C                     FCB   8Ch   ; (CMPX #: steps over the LDB)
F209   C6 FF        TRUE:     LDB   #0FFh   
F20B   1D                     SEX      ; D = 0000 or FFFF
F20C   ED C4                  STD   ,U   
F20E   39                     RTS      
F20F   8D 04        H_EQ:     BSR   cmp   
