0254                             ;  Routines (no handler starts past this point)
0254                             ; =============================================================================
0254                             ; Digits: step back onto the first digit and read the whole number.
0254   E5           DIGIT:    PUSH   H   
0255   0B                     DCX   B   
0256   CD 60 02               CALL   rdnum   
0259   F7                     RST   6   
025A                             ; negnum: "-" directly before a digit: read the number, negate it.
025A   E5           NEGNUM:   PUSH   H   
025B   CD 60 02               CALL   rdnum   
025E   E7                     RST   4   
025F   F7                     RST   6   
0260                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
0260                             ; non-digit. Values wrap at 16 bits, as the spec says.
0260   21 00 00     RDNUM:    LXI   H,0   
0263   0A           RDN1:     LDAX   B   
0264   D6 30                  SUI   "0"   
0266   FE 0A                  CPI   10   
0268   D0                     RNC      
0269   03                     INX   B   
026A   54                     MOV   D,H   
026B   5D                     MOV   E,L   
026C   29                     DAD   H   
026D   29                     DAD   H   
026E   19                     DAD   D   
026F   29                     DAD   H   ; HL * 10
0270   5F                     MOV   E,A   
0271   16 00                  MVI   D,0   
0273   19                     DAD   D   
0274   C3 63 02               JMP   rdn1   
0277                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, BC = remainder.
0277                             ; Uses A, BC; the caller saves the IP. HL holds the dividend and, as its bits
0277                             ; leave at the top, the quotient bits arrive at the bottom. The loop counter
0277                             ; lives on the stack, since A is busy with the shifts.
0277                             ; Dividing by 2 is one shift (the spec wants that fast).
0277   01 00 00     UDIV:     LXI   B,0   
027A   7B                     MOV   A,E   
027B   EE 02                  XRI   2   
027D   B2                     ORA   D   
027E   C2 8B 02               JNZ   udv0   
0281   B4                     ORA   H   ; A was 0, and the carry is clear
0282   1F                     RAR      
0283   67                     MOV   H,A   
0284   7D                     MOV   A,L   
0285   1F                     RAR      
0286   6F                     MOV   L,A   ; the quotient
0287   78                     MOV   A,B   
0288   17                     RAL      
0289   4F                     MOV   C,A   ; the remainder: the bit that fell out
028A   C9                     RET      
028B   3E 10        UDV0:     MVI   A,16   
028D   F5                     PUSH   PSW   
028E   29           UDV1:     DAD   H   ; next dividend bit into the carry
028F   79                     MOV   A,C   
0290   17                     RAL      
0291   4F                     MOV   C,A   
0292   78                     MOV   A,B   
0293   17                     RAL      
0294   47                     MOV   B,A   ; BC = BC*2 + bit
0295   79                     MOV   A,C   
0296   93                     SUB   E   
0297   78                     MOV   A,B   
0298   9A                     SBB   D   ; carry if BC < DE
0299   DA A1 02               JC   udv2   
029C   47                     MOV   B,A   ; BC - DE (high byte; A holds it)
029D   79                     MOV   A,C   
029E   93                     SUB   E   
029F   4F                     MOV   C,A   
02A0   2C                     INR   L   ; quotient bit
02A1   F1           UDV2:     POP   PSW   
02A2   3D                     DCR   A   
02A3   F5                     PUSH   PSW   
02A4   C2 8E 02               JNZ   udv1   
02A7   F1                     POP   PSW   
02A8   C9                     RET      
02A9                             ; psgn: print HL as a signed number. Uses BC.
02A9   7C           PSGN:     MOV   A,H   
02AA   B7                     ORA   A   
02AB   F2 B2 02               JP   pdec   
02AE   3E 2D                  MVI   A,"-"   
02B0   EF                     RST   5   
02B1   E7                     RST   4   
02B2                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
02B2                             ; Uses BC.
02B2   11 0A 00     PDEC:     LXI   D,10   
02B5   CD 77 02               CALL   udiv   ; HL = HL / 10, C = the last digit
02B8   79                     MOV   A,C   
02B9   F5                     PUSH   PSW   
02BA   7C                     MOV   A,H   
02BB   B5                     ORA   L   
02BC   C4 B2 02               CNZ   pdec   
02BF   F1                     POP   PSW   
02C0   C6 30                  ADI   "0"   
02C2   EF                     RST   5   
02C3   C9                     RET      
02C4                             ; skip: read past text to the closer at this level, and return A = 0 if it
02C4                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
02C4                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
02C4                             ; no closer; anything else that runs into the NUL had unbalanced brackets
02C4                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
02C4                             ; skip sets it to 0 and falls through the INR that an opener comes back to.
02C4                             ; 
02C4                             ; The checked build also looks at the character the skip was started by,
02C4                             ; which is always the one just before where it starts: "(" must end at ")",
02C4                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
02C4                             ; quote counts as running into it. "\" takes either closer. The place where
02C4                             ; the skip started is kept on the stack, for the report.
02C4                SKIP:        
02C4                          IF   CHECKED   
02C4   C5                     PUSH   B   
02C5   0B                     DCX   B   
02C6   0A                     LDAX   B   
02C7   03                     INX   B   
02C8   5F                     MOV   E,A   ; E = the opener: ( [ or \
02C9                          ENDIF      
02C9   16 00                  MVI   D,0   
02CB   14           SK3:      INR   D   ; an opener: one deeper
02CC   0A           SK1:      LDAX   B   
02CD                          IF   1-CHECKED   
                              INX   B   
                              ORA   A   
                              JZ   endprog   
02CD                          ENDIF      
02CD                          IF   CHECKED   
02CD   B7                     ORA   A   
02CE   CA FC 02               JZ   sk6   ; (the IP stays on the NUL)
02D1   03                     INX   B   
02D2                          ENDIF      
02D2   FE 22                  CPI   22h   
02D4   CC 08 03               CZ   skipstr   ; leaves A = 22h, which matches nothing below
02D7   D6 28                  SUI   "("   ;   (or 0, and then the NUL is read next)
02D9   CA CB 02               JZ   sk3   
02DC   3D                     DCR   A   ; ")"
02DD   CA EA 02               JZ   sk4   
02E0   D6 32                  SUI   "["-")"   
02E2   CA CB 02               JZ   sk3   
02E5   FE 02                  CPI   "]"-"["   
02E7   C2 CC 02               JNZ   sk1   
02EA   15           SK4:      DCR   D   
02EB                          IF   1-CHECKED   
                              RZ      ; the closer at this level
                              JMP   sk1   
02EB                          ENDIF      
02EB                          IF   CHECKED   
02EB   C2 CC 02               JNZ   sk1   
02EE   57                     MOV   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
02EF   AB                     XRA   E   ;   opener is 0 for "(" and 1 for "[", and only
02F0   E6 06                  ANI   6   ;   "\" has bit 2: so this is 2 for the wrong
02F2   FE 02                  CPI   2   ;   closer, and only then
02F4   7A                     MOV   A,D   
02F5   D1                     POP   D   ; (where the skip started)
02F6   C0                     RNZ      
02F7   42                     MOV   B,D   ; N. The place is the opener
02F8   4B                     MOV   C,E   
02F9   C3 03 03               JMP   sk7   
02FC   7B           SK6:      MOV   A,E   ; the text ran out:
02FD   E6 04                  ANI   4   
02FF   C2 7F 00               JNZ   endprog   ;   "\" with no closer ends the program
0302   C1                     POP   B   
0303   3E 4E        SK7:      MVI   A,"N"   
0305   C3 19 04               JMP   errp   ; (errp drops skip's return address)
0308                          ENDIF      
0308                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
0308                             ; the next character, so "/"" does not end it. Leaves A = 22h.
0308                          IF   1-CHECKED   
                    SS0:      INX   B   
                    SKIPSTR:   LDAX   B   
                              INX   B   
                              CPI   "/"   
                              JZ   ss0   
                              CPI   22h   
                              JNZ   skipstr   
                              RET      
0308                          ENDIF      
0308                          IF   CHECKED   
0308                             ; The checked build never steps over a NUL: if the text runs out first it
0308                             ; returns A = 0 with the IP on the NUL.
0308   0A           SKIPSTR:   LDAX   B   
0309   B7                     ORA   A   
030A   C8                     RZ      
030B   03                     INX   B   
030C   FE 22                  CPI   22h   
030E   C8                     RZ      
030F   FE 2F                  CPI   "/"   
0311   C2 08 03               JNZ   skipstr   
0314   0A                     LDAX   B   ; the escaped character
0315   B7                     ORA   A   
0316   C8                     RZ      
0317   03                     INX   B   
0318   C3 08 03               JMP   skipstr   
031B                          ENDIF      
031B                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
031B                             ; and return its value in A with the carry set; otherwise leave the IP and
031B                             ; return with the carry clear.
031B   0A           HEXC:     LDAX   B   
031C   D6 30                  SUI   "0"   
031E   FE 0A                  CPI   10   
0320   DA 2C 03               JC   hc1   
0323   E6 DF                  ANI   0DFh   
0325   D6 11                  SUI   11h   
0327   FE 06                  CPI   6   
0329   D0                     RNC      
032A   D6 F6                  SUI   0F6h   ; + 10, and sets the carry
032C   03           HC1:      INX   B   
032D   C9                     RET      
032E                             ; =============================================================================
032E                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
032E                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
032E                             ;  (RST 5) prints A. Both keep BC, DE and HL. In the generic build they are
032E                             ;  the host's KEY and CONOUT routines themselves.
032E                             ; 
032E                             ;  A running program reads the keyboard only through getk and pollk, which
032E                             ;  between them give the break key its rules:
032E                             ;    - Ctrl-C stops the program;
032E                             ;    - any other key that the break check reads is held in KEYBUF for the
032E                             ;      next "?", and a newer one takes its place;
032E                             ;    - "?" (getk) takes the held key first;
032E                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
032E                             ;      key like any other, but two of them within about 250 ms still stop it.
032E                             ;  Both are called straight from a handler, never from a routine under one:
032E                             ;  the checked build's report counts on finding one return address above the
032E                             ;  data stack, and TOS in HL.
032E                             ; =============================================================================
032E                          IFN   CPM   
032E                RAWK:     EQU   KEY   
032E                          ENDIF      
032E                             ; pollk: the break check (see rpushd).
032E   CD 06 FF     POLLK:    CALL   rawk   
0331   C8                     RZ      ; no key
0332   32 7A 82               STA   KEYBUF   ; held for the next "?"
0335   FE 03        PK1:      CPI   3   ; (getk joins here)
0337   C0                     RNZ      
0338                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
0338                             ; the program has turned it off, wait about 250 ms for one more key: a
0338                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
0338                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
0338   3A 7B 82     CTLC:     LDA   BRKOFF   
033B   B7                     ORA   A   
033C   CA F7 03               JZ   brk   
033F   D5                     PUSH   D   
0340   11 10 27               LXI   D,250*MSLOOP   
0343   CD 06 FF     CT1:      CALL   rawk   
0346   C2 4F 03               JNZ   ct2   
0349   1B                     DCX   D   
034A   7A                     MOV   A,D   
034B   B3                     ORA   E   
034C   C2 43 03               JNZ   ct1   
034F   D1           CT2:      POP   D   ; A = the second key, or 0 if none came
0350   FE 03                  CPI   3   
0352   CA F7 03               JZ   brk   
0355   B7                     ORA   A   
0356   CA 5C 03               JZ   ct3   
0359   32 7A 82               STA   KEYBUF   
035C   3E 03        CT3:      MVI   A,3   
035E   B7                     ORA   A   
035F   C9                     RET      
0360                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
0360   E5           GETK:     PUSH   H   ; a held key goes first, and is taken out of
0361   21 7A 82               LXI   H,KEYBUF   ;   the buffer
0364   7E                     MOV   A,M   
0365   36 00                  MVI   M,0   
0367   E1                     POP   H   
0368   B7                     ORA   A   
0369   C0                     RNZ      
036A   CD 06 FF               CALL   rawk   
036D   C8                     RZ      
036E   C3 35 03               JMP   pk1   ; Ctrl-C? If not, that is the key
0371                          IF   1-CHECKED   
                    BRK:      EQU   endprog   ; the unchecked build stops without a word;
0371                          ENDIF      
0371                          IF   CHECKED   
0371                BRK:      EQU   e_break   ;   the checked build reports B
0371                          ENDIF      
0371                          IF   CPM   
                    RAWK:     MVI   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
                                 ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
                                 ; printing and could swallow a key that BDOS 6 then never sees.
                    PUTC:     PUSH   B   
                              PUSH   D   
                              PUSH   H   
                              MOV   E,A   
                              MVI   C,6   
                              CALL   BDOS   
                              POP   H   
                              POP   D   
                              POP   B   
                              ORA   A   ; (for getk)
                              RET      
0371                          ENDIF      
0371                             ; =============================================================================
0371                             ;  Checked build: the checks and the error report
0371                             ; =============================================================================
0371                          IF   CHECKED   
0371                             ; chkst: stop unless HL is in the program's own space: from the letter page
0371                             ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
0371                             ; whatever lies above the limit are safe. Memory above the heap top but
0371                             ; below the limit is the program's own: Tiny BASIC keeps its lines there.
0371                             ; It is the page of HL + 1 that is tested, so that one test serves both
0371                             ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
0371                             ; Keeps HL and BC.
0371   23           CHKST:    INX   H   
0372   7C                     MOV   A,H   
0373   2B                     DCX   H   
0374   FE 82                  CPI   LETPAGE   
0376   DA 7C 03               JC   e_store   
0379                          ENDIF      
0379                          IF   CHECKED*(1-CPM)   
0379   FE F0                  CPI   HEAPLIM   
037B   D8                     RC      
037C                          ENDIF      
037C                          IF   CHECKED*CPM   
                              MOV   E,A   
                              LDA   0007h   ; the BDOS page is the heap limit
                              DCR   A   
                              CMP   E   
                              RNC      
037C                          ENDIF      
037C                          IF   CHECKED   
037C   3E 4F        E_STORE:   MVI   A,"O"   ; a store outside the program's space
037E   C3 19 04               JMP   errp   
0381                             ; chkhp: HL = the new heap top, DE = the count, the carry is from adding
0381                             ; it, and the old top is on the stack under the return address. Stop if the
0381                             ; new top is not below the limit page, or is below the program's end.
0381                CHKHP:       
0381                          ENDIF      
0381                          IF   CHECKED*CPM   
                                 ; With this much room a top that wrapped round can land back in
                                 ; range, so the add is tested too: growing must not carry, and
                                 ; releasing must.
                              MOV   A,D   
                              RAR      ; the carry comes in above the count's sign:
                              ADI   40h   ;   bit 7 = carry XOR sign
                              ADD   A   
                              JC   e_heap   
                              LDA   0007h   
                              DCR   A   
                              CMP   H   
                              JC   e_heap   
0381                          ENDIF      
0381                          IF   CHECKED*(1-CPM)   
0381                             ; (Here the program's space is under 32K, so a top that wrapped
0381                             ; round always falls outside it.)
0381   7C                     MOV   A,H   
0382   FE F0                  CPI   HEAPLIM   
0384   D2 90 03               JNC   e_heap   
0387                          ENDIF      
0387                          IF   CHECKED   
0387   EB                     XCHG      
0388   E5                     PUSH   H   ; the count
0389   2A 38 82               LHLD   NPEND   
038C   19                     DAD   D   ; carry: at or above the program's end
038D   E1                     POP   H   
038E   EB                     XCHG      
038F   D8                     RC      
0390   EB           E_HEAP:   XCHG      ; put the count back in TOS for the report,
0391   D1                     POP   D   ;   and drop the return address and the old
0392   3E 48                  MVI   A,"H"   ;   top
0394   C3 19 04               JMP   errp   
0397                             ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
0397                             ; "$", and the error report's texts). A NUL first is an error: Q.
0397   7E           PRSTR:    MOV   A,M   
0398   23                     INX   H   
0399   FE 22                  CPI   22h   
039B   C8                     RZ      
039C   B7                     ORA   A   
039D   CA AD 03               JZ   e_dollar   
03A0   FE 2F                  CPI   "/"   
03A2   C2 A9 03               JNZ   prs1   
03A5   7E                     MOV   A,M   
03A6   23                     INX   H   
03A7   E6 BF                  ANI   0BFh   
03A9   EF           PRS1:     RST   5   
03AA   C3 97 03               JMP   prstr   
03AD   D1           E_DOLLAR:   POP   D   ; "$" ran into a NUL: drop the return address,
03AE   E1                     POP   H   ;   and put the string's address back in TOS
03AF   3E 51                  MVI   A,"Q"   
03B1   C3 1A 04               JMP   error   
03B4                             ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
03B4                             ; pnl: the same, on a new line.
03B4   3E 0D        PNL:      MVI   A,13   
03B6   EF                     RST   5   
03B7   3E 0A                  MVI   A,10   
03B9   EF                     RST   5   
03BA   E3           PMSG:     XTHL      
03BB   CD 97 03               CALL   prstr   
03BE   E3                     XTHL      
03BF   C9                     RET      
03C0                             ; chkstk: both stacks are checked once per character, not in every handler.
03C0                             ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
03C0                             ; the constant carries if it is above (cells were popped that were never
03C0                             ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
03C0                             ; a character late at most: the bytes above DSTOP and the guard band below
03C0                             ; the page take what happens meanwhile.
03C0   EB           CHKSTK:   XCHG      ; DE = TOS (HL is needed for the pointers)
03C1   21 05 7E               LXI   H,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
03C4   39                     DAD   SP   
03C5   DA EF 03               JC   e_under   
03C8   24                     INR   H   
03C9   C2 E9 03               JNZ   e_over   
03CC   2A 34 82               LHLD   RSP   ; the return stack: in its page (or it has
03CF   7C                     MOV   A,H   ;   overflowed), and not above its empty
03D0   FE 80                  CPI   RSPAGE   ;   position (an underflow stays inside the
03D2   C2 E6 03               JNZ   e_rover   ;   page, in the guard band)
03D5   7D                     MOV   A,L   
03D6   FE E1                  CPI   RSTOP&0FFh+1   
03D8   D2 DD 03               JNC   e_runder   
03DB   EB                     XCHG      ; TOS back
03DC   C9                     RET      
03DD   21 E0 80     E_RUNDER:   LXI   H,RSTOP   ; return stack underflow: it counts as empty
03E0   22 34 82               SHLD   RSP   
03E3   3E 72                  MVI   A,"r"   
03E5   21                     DB   21h   ; (LXI H hides the next entry; HL is free)
03E6   3E 52        E_ROVER:   MVI   A,"R"   ; return stack overflow
03E8   21                     DB   21h   
03E9   3E 53        E_OVER:   MVI   A,"S"   ; data stack overflow
03EB   EB                     XCHG      ; TOS back
03EC   C3 19 04               JMP   errp   
03EF   31 FC 81     E_UNDER:   LXI   SP,DSTOP   ; data stack underflow: it counts as empty
03F2   3E 73                  MVI   A,"s"   
03F4   C3 1A 04               JMP   error   
03F7   3E 42        E_BREAK:   MVI   A,"B"   ; Ctrl-C (found inside pollk or getk)
03F9   C3 19 04               JMP   errp   
03FC                             ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
03FC                             ; was never defined still holds 0000h, and the byte there is a JMP, C3h, in
03FC                             ; every build: if the IP is in page zero, this was a call of an undefined
03FC                             ; word. The call is undone, so the place is the call itself.
03FC   04           E_HI:     INR   B   
03FD   05                     DCR   B   
03FE   C2 10 04               JNZ   e_resv   
0401   E5                     PUSH   H   
0402   CF                     RST   1   
0403   44                     MOV   B,H   
0404   4D                     MOV   C,L   
0405   E1                     POP   H   
0406   3E 55                  MVI   A,"U"   
0408   C3 1A 04               JMP   error   
040B                             ; Error entries. Each loads its letter and then hides the next entry inside
040B                             ; a 3-byte LXI D (the 11h), so they all fall through to `error`.
040B   44           E_QUOTE:   MOV   B,H   ; an unclosed string: HL is its address, one
040C   4D                     MOV   C,L   ;   past the opening quote, which is the place
040D   3E 51                  MVI   A,"Q"   
040F   11                     DB   11h   
0410   3E 58        E_RESV:   MVI   A,"X"   ; a reserved byte outside a string
0412   11                     DB   11h   
0413   3E 5A        E_ZERO:   MVI   A,"Z"   ; dividing by zero
0415   11                     DB   11h   
0416   3E 57        E_BRACK:   MVI   A,"W"   ; bad character after [
0418   FE                     DB   0FEh   ; (CPI hides the one byte of errp)
0419                             ; errp: an error found inside a routine: drop its return address first.
0419   D1           ERRP:     POP   D   
041A                             ; error: the report, then the end. A = the letter, BC = one past the place,
041A                             ; HL = TOS, and both stacks as the report is to show them:
041A                             ; 
041A                             ;   Err X @ line,col
041A                             ;   up to 16 characters of the text from the place
041A                             ;   Stk n: the top 8 cells at most, bottom to top
041A                             ;   Rtn n
041A   E5           ERROR:    PUSH   H   ; now the whole data stack is in memory
041B   5F                     MOV   E,A   
041C   CD B4 03               CALL   pnl   
041F   45 72 72 20 22         DB   "Err ",22h   
0424   7B                     MOV   A,E   
0425   EF                     RST   5   
0426   CD BA 03               CALL   pmsg   
0429   20 40 20 22            DB   " @ ",22h   
042D   0B                     DCX   B   ; BC = the place
042E                             ; The line and column. A place below the program is in the line
042E                             ; buffer: line 0. Otherwise count the LFs from the program's start;
042E                             ; DE = the line's number, HL = where it starts.
042E   21 80 82               LXI   H,LINEBUF   
0431   11 00 00               LXI   D,0   
0434   78                     MOV   A,B   
0435   FE 83                  CPI   PROG/256   
0437   DA 51 04               JC   er3   
043A   24                     INR   H   
043B   6B                     MOV   L,E   ; HL = PROG
043C   13           ER1:      INX   D   ; a new line starts at HL
043D   E5                     PUSH   H   
043E   7D           ER2:      MOV   A,L   
043F   91                     SUB   C   
0440   7C                     MOV   A,H   
0441   98                     SBB   B   
0442   D2 50 04               JNC   er2x   ; reached the place
0445   7E                     MOV   A,M   
0446   23                     INX   H   
0447   FE 0A                  CPI   10   
0449   C2 3E 04               JNZ   er2   
044C   F1                     POP   PSW   
044D   C3 3C 04               JMP   er1   
0450   E1           ER2X:     POP   H   
0451   C5           ER3:      PUSH   B   
0452   E5                     PUSH   H   
0453   EB                     XCHG      
0454   CD B2 02               CALL   pdec   ; the line
0457   3E 2C                  MVI   A,","   
0459   EF                     RST   5   
045A   D1                     POP   D   
045B   E1                     POP   H   
045C   E5                     PUSH   H   
045D   CD EA 04               CALL   sub16   
0460   23                     INX   H   
0461   CD B2 02               CALL   pdec   ; the column
0464   CD B4 03               CALL   pnl   
0467   22                     DB   22h   
0468   E1                     POP   H   ; the text, as it is: 16 characters, or fewer
0469   06 10                  MVI   B,16   ;   if the line or the program ends first
046B   7E           ER4:      MOV   A,M   
046C   23                     INX   H   
046D   B7                     ORA   A   
046E   CA 80 04               JZ   er5   
0471   FE 0D                  CPI   13   
0473   CA 80 04               JZ   er5   
0476   FE 0A                  CPI   10   
0478   CA 80 04               JZ   er5   
047B                          ENDIF      
047B                          IF   CHECKED*CPM   
                              CPI   1Ah   ; (the ^Z that pads a file's last record ends
                              JZ   er5   ;   the text too: some terminals clear the
047B                          ENDIF      ;   screen on it)
047B                          IF   CHECKED   
047B   EF                     RST   5   
047C   05                     DCR   B   
047D   C2 6B 04               JNZ   er4   
0480   CD B4 03     ER5:      CALL   pnl   
0483   53 74 6B 20 22         DB   "Stk ",22h   
0488   21 00 00               LXI   H,0   
048B   39                     DAD   SP   
048C   EB                     XCHG      
048D   21 FA 81               LXI   H,DSTOP-2   ; (the cell at DSTOP-2 was pushed with the
0490   CD DB 04               CALL   phalf   ;   first value and holds nothing): the depth
0493   3E 3A                  MVI   A,":"   
0495   EF                     RST   5   
0496   79                     MOV   A,C   
0497   FE 09                  CPI   9   
0499   DA A6 04               JC   er6   
049C   CD BA 03               CALL   pmsg   
049F   20 2E 2E 2E 22         DB   " ...",22h   
04A4   0E 08                  MVI   C,8   
04A6   26 00        ER6:      MVI   H,0   ; C = the number of cells to show
04A8   69                     MOV   L,C   
04A9   29                     DAD   H   
04AA   39                     DAD   SP   ; HL -> just above the deepest of them
04AB   0C                     INR   C   
04AC   0D           ER7:      DCR   C   
04AD   CA C2 04               JZ   er8   
04B0   2B                     DCX   H   
04B1   56                     MOV   D,M   
04B2   2B                     DCX   H   
04B3   5E                     MOV   E,M   
04B4   E5                     PUSH   H   
04B5   C5                     PUSH   B   
04B6   3E 20                  MVI   A," "   
04B8   EF                     RST   5   
04B9   EB                     XCHG      
04BA   CD A9 02               CALL   psgn   
04BD   C1                     POP   B   
04BE   E1                     POP   H   
04BF   C3 AC 04               JMP   er7   
04C2   CD B4 03     ER8:      CALL   pnl   
04C5   52 74 6E 20 22         DB   "Rtn ",22h   
04CA   2A 34 82               LHLD   RSP   
04CD   EB                     XCHG      
04CE   21 E0 80               LXI   H,RSTOP   
04D1   CD DB 04               CALL   phalf   
04D4   CD B4 03               CALL   pnl   
04D7   22                     DB   22h   
04D8   C3 7F 00               JMP   endprog   
04DB                             ; phalf: print half of HL - DE, and leave it in BC
04DB   CD EA 04     PHALF:    CALL   sub16   
04DE   B7                     ORA   A   ; (A = H; this clears the carry)
04DF   1F                     RAR      
04E0   67                     MOV   H,A   
04E1   7D                     MOV   A,L   
04E2   1F                     RAR      
04E3   6F                     MOV   L,A   
04E4   E5                     PUSH   H   
04E5   CD B2 02               CALL   pdec   
04E8   C1                     POP   B   
04E9   C9                     RET      
