0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Spec: docs/b8script.md (2026-11-21).
0000                             ; 
0000                             ;  Three switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    EDITOR   1 = with a small line editor built in (see the end of this
0000                             ;                 file). It goes with either setting of the other two.
0000                             ;    CHECKED  0 = no checks (spec: the programmer is responsible)
0000                             ;             1 = starts with every variable at 0 and every word undefined,
0000                             ;                 and stops on every error in the spec's table (and Ctrl-C)
0000                             ;                 with a four-line report: the letter and the place as line
0000                             ;                 and column, the text there, and both stacks. See `error`.
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   1   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   1   ; 1 = checked build
0000                EDITOR:   EQU   1   ; 1 = with the line editor
0000                EDGEN:    EQU   EDITOR*(1-CPM)   ; (the generic build with the editor)
0000                TABP0:    EQU   EDGEN*(1-CHECKED)   ; (the build with its table in page zero)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    HL'  return-stack pointer (the alternate HL). Entries are 2 bytes; the
0000                             ;         stack grows down. Only rpop and rpushn (and the checks) touch it.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  One-byte calls. The routines used most are reached with RST, one byte
0000                             ;  instead of three:
0000                             ; 
0000                             ;    RST 08h  rpop    pop the return stack into DE
0000                             ;    RST 18h  drop    drop TOS, then next character     (ends a handler)
0000                             ;    RST 20h  neg16   HL = -HL
0000                             ;    RST 28h  putc    print A
0000                             ;    RST 30h  next    next character                    (ends a handler)
0000                             ; 
0000                             ;  RST 18h and RST 30h never return: an RST is a CALL, so the first thing
0000                             ;  each of them does is POP DE to throw the return address away.
0000                             ; 
0000                             ;  The CP/M build can't own page zero, so the block from `vecs` to `vecend`
0000                             ;  (image addresses 0108h-0133h) is copied to 0008h-0033h when it starts. The
0000                             ;  code in that block is written to work at either place.
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (the top four bytes of the page are spare,
0000                             ;             so a full stack runs two bytes into the page below)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch, interpreter variables in the gaps, and the -n? line buffer
0000                             ;             at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack has a guard band: the data stack can
0000                             ;  overrun by a cell or two (and the calls made while it is full, the error
0000                             ;  report's included) into the top 32 bytes of the return-stack page, which
0000                             ;  are never used, and the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
0000                BDOS:     EQU   0005h   
0000                BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IF   CPM*(1-EDITOR)   
                    EXIT:     EQU   0000h   ; warm boot
0000                          ENDIF      
0000                          IFN   CPM   
                                 ; ---- generic machine: edit these to suit -----------------------------------
                    KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
                                 ;   waiting. The zero flag must match A
                                 ;   (end the routine with OR A / RET).
                    CONOUT:   EQU   0FF03h   ; print the character in A
                                 ;   KEY and CONOUT must preserve BC, DE, HL and HL'.
                    RSPAGE:   EQU   80h   ; 8000h return stack
                    DSPAGE:   EQU   81h   ; 8100h data stack
                    LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
                    PROG:     EQU   8300h   ; where the loader puts the program text
                    HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
                    BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)   
                    EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                          ENDIF      
0000                          IF   EDITOR   
0000                EXIT:     EQU   edit   ; a program that ends goes back to the editor
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine. (The wait
0000                             ; for a second Ctrl-C uses it too: 250 ms.)
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                             ;   around machine code;
0000                NPEND:    EQU   LET+38h   ;   minus the address of the program's end
0000                             ;   (the heap"s first byte), for the checked "_'
0000                KEYBUF:   EQU   LET+7Ah   ; gap after z: a key read by the break check and
0000                             ;   held for the next "?" (0: none);
0000                BRKOFF:   EQU   LET+7Bh   ;   the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                LBHDR:    EQU   LET+7Eh   ; CP/M BDOS 10 header: max, count
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FCh   ; empty data stack. The four bytes above it
0000                             ; are spare: a character can pop two cells
0000                             ; too many before the checked build sees it,
0000                             ; and the next call must not land on the
0000                             ; letter cells.
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is the start of the .COM file, and 0108h-0133h is also copied to
0000                             ;  page zero (see the header).
0000                             ; =============================================================================
0100                          .ORG   BASE   
0100                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              XOR   A   ; 00  reset. (This byte, AFh, is also what an
0100                          ENDIF      ;     undefined word runs into: see e_hi.)
0100                          IF   1-EDGEN   
0100   31 FC 08               LD   SP,DSTOP   ; 00  reset, or the start of the .COM file
0103                          ENDIF      
0103                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)   
                              LD   BC,PROG   ; 03  the IP
                              JR   st0   ; 06  (the rest of the startup is close by)
0103                          ENDIF      
0103                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              JR   init   ; 04  (the rest of the startup is close by)
                              DW   0   ; 06  spare
0103                          ENDIF      
0103                          IF   EDGEN   
                              XOR   A   ; 00  reset: no program yet
                              LD   (PROG),A   
0103                          ENDIF      
0103                          IF   EDGEN*(1-CHECKED)   
                              JP   edit   ; 04
0103                          ENDIF      
0103                          IF   EDGEN*CHECKED   
                              JP   init   ; 04  (and no key held back)
0103                          ENDIF      
0103                          IF   EDGEN   
                              NOP      ; 07  spare
0103                          ENDIF      
0103                          IF   CPM   
0103   C3 71 06               JP   start   ; 03
0106   00 00                  DW   0   ; 06  spare
0108                          ENDIF      
0108                VECS:        
0108                             ; ---- RST 08h: rpop: pop the return stack into DE ---------------------------
0108   D9           RPOP:     EXX      ; 08
0109   5E                     LD   E,(HL)   
010A   23                     INC   HL   
010B   56                     LD   D,(HL)   
010C   23                     INC   HL   
010D   D5                     PUSH   DE   ; across to the main registers
010E   D9                     EXX      
010F   D1                     POP   DE   
0110   C9                     RET      ; 10  (so RST 10h is not used)
0111                             ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
0111   C6 21        CTL:      ADD   A,21h   ; 11  back to c; zero only for NUL
0113   20 1F                  JR   NZ,next0   ;     the rest are ignored
0115   C3 DE 05     ENDPROG:   JP   EXIT   ;     the program has ended
0118                             ; ---- RST 18h: drop TOS, then next ------------------------------------------
0118   D1           RST18:    POP   DE   ; 18  discard the RST's return address
0119   E1                     POP   HL   ;     new TOS = NOS
011A   18 15                  JR   nx   
011C   E5           H_FROMR:   PUSH   HL   ; 1C  "}" return stack to TOS
011D   CF                     RST   08h   
011E   EB                     EX   DE,HL   
011F   F7                     RST   30h   
0120                             ; ---- RST 20h: neg16: HL = -HL (keeps BC, DE) -------------------------------
0120   AF           NEG16:    XOR   A   ; 20
0121   95                     SUB   L   
0122   6F                     LD   L,A   
0123   9F                     SBC   A,A   
0124   94                     SUB   H   
0125   67                     LD   H,A   
0126   C9                     RET      
0127   00                     NOP      ; 27  spare
0128                             ; ---- RST 28h: putc: print A (keeps BC, DE, HL, HL') ------------------------
0128                RST28:       
0128                          IFN   CPM   
                    PUTC:     JP   CONOUT   ; 28
0128                          ENDIF      
0128                          IF   CPM   
0128   C3 20 04               JP   putc   ; 28
012B                          ENDIF      
012B   E9           JPHL:     JP   (HL)   ; 2B  (for the machine-code call)
012C   E3           H_TOR:    EX   (SP),HL   ; 2C  "{" TOS to the return stack: the new TOS
012D   C3 BC 01               JP   rpushn   ;     comes up, the old one goes across
0130                             ; ---- RST 30h: next character -----------------------------------------------
0130   D1           RST30:    POP   DE   ; 30  discard the RST's return address
0131                NX:          
0131                          IF   CPM   
0131   C3 34 01               JP   next0   ; (this copy runs in page zero)
0134                          ENDIF      
0134                VECEND:      
0134                             ; =============================================================================
0134                             ;  The inner loop: read one character and sort it by range.
0134                             ; 
0134                             ;    00h          end of program
0134                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0134                             ;    30h-39h      digit: read a whole number
0134                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0134                             ;    61h-7Ah      a-z: push the address of that letter's cell
0134                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0134                             ; =============================================================================
0134                NEXT0:       
0134                          IF   CHECKED   
0134   CD 8C 04               CALL   chkstk   ; both stacks are checked once per character
0137                          ENDIF      
0137   0A                     LD   A,(BC)   
0138   03                     INC   BC   
0139   D6 21                  SUB   21h   ; A = c - 21h
013B   38 D4                  JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
013D   FE 0F                  CP   0Fh   
013F   38 25                  JR   C,punct   ; 21h-2Fh: PTAB index 0-14
0141   D6 0F                  SUB   0Fh   ; A = c - 30h
0143   FE 0A                  CP   0Ah   
0145   38 5F                  JR   C,digit   ; 30h-39h
0147   FE 11                  CP   11h   
0149   38 19                  JR   C,p3a   ; 3Ah-40h
014B   D6 11                  SUB   11h   ; A = c - 41h
014D   FE 1A                  CP   1Ah   
014F   38 61                  JR   C,upper   ; 41h-5Ah: A = letter index 0-25
0151   FE 20                  CP   20h   
0153   38 0D                  JR   C,p5b   ; 5Bh-60h
0155   FE 3A                  CP   3Ah   
0157   38 53                  JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0159   FE 3E                  CP   3Eh   
015B                          IF   1-CHECKED   
                              JR   NC,next0   ; 7Fh-FFh: ignored
015B                          ENDIF      
015B                          IF   CHECKED   
015B   28 D7                  JR   Z,next0   ; 7Fh, DEL: ignored
015D   D2 B9 04               JP   NC,e_hi   ; 80h-FFh: reserved
0160                          ENDIF      
0160   D6 1A                  SUB   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
0162   D6 09        P5B:      SUB   9   ; 5Bh-60h: -4 in all, index 22-27
0164   C6 05        P3A:      ADD   A,5   ; 3Ah-40h: index 15-21
0166                .macro PTABLE,
0166                             ; 
0166                 DB      h_store & 0FFh  ; !
0166                 DB      h_str & 0FFh    ; "
0166                 DB      h_num & 0FFh    ; #
0166                 DB      h_print & 0FFh  ; $
0166                 DB      h_swap & 0FFh   ; %
0166                 DB      h_and & 0FFh    ; &
0166                 DB      h_emit & 0FFh   ; '
0166                 DB      h_open & 0FFh   ; (
0166                 DB      h_close & 0FFh  ; )
0166                 DB      h_mul & 0FFh    ; *
0166                 DB      h_add & 0FFh    ; +
0166                 DB      h_cfetch & 0FFh ; ,
0166                 DB      h_sub & 0FFh    ; -
0166                 DB      h_cstore & 0FFh ; .
0166                 DB      h_div & 0FFh    ; /
0166                 DB      h_dup & 0FFh    ; :
0166                 DB      h_drop & 0FFh   ; ;
0166                 DB      h_lt & 0FFh     ; <
0166                 DB      h_eq & 0FFh     ; =
0166                 DB      h_gt & 0FFh     ; >
0166                 DB      h_key & 0FFh    ; ?
0166                 DB      h_fetch & 0FFh  ; @
0166                 DB      h_def & 0FFh    ; [
0166                 DB      h_break & 0FFh  ; \
0166                 DB      h_ret & 0FFh    ; ]
0166                 DB      h_xor & 0FFh    ; ^
0166                 DB      h_alloc & 0FFh  ; _
0166                 DB      h_grave & 0FFh  ; `
0166                 DB      h_tor & 0FFh    ; {
0166                 DB      h_or & 0FFh     ; |
0166                 DB      h_fromr & 0FFh  ; }
0166                 DB      h_not & 0FFh    ; ~
0166                .endm
0166                 
0166                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
0166                             ; untouched, and A, DE free.
0166   C6 AA        PUNCT:    ADD   A,PTAB & 0FFh   ; PTAB never crosses a page
0168   5F                     LD   E,A   
0169   16 03                  LD   D,PTAB / 256   ; (0 if the table is in page zero)
016B   FE C0                  CP   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
016D   1A                     LD   A,(DE)   
016E   5F                     LD   E,A   ; the handler's low byte
016F                          IF   (1-CPM)*(1-TABP0)   
                              LD   D,0   
016F                          ENDIF      
016F                          IFN   CPM   
                              RL   D   ; its page: 0 + carry
016F                          ENDIF      
016F                          IF   CPM   
016F   16 01                  LD   D,1   
0171   30 01                  JR   NC,pu1   
0173   14                     INC   D   ; its page: 1 + carry
0174                PU1:         
0174                          ENDIF      
0174   D5                     PUSH   DE   ; jump to it; the stack is balanced again
0175   C9                     RET      ;   when the handler starts
0176                             ; The rest of the startup: here so that the generic reset code can reach it
0176                             ; with JR. st0: find the program's NUL; the heap starts after it.
0176                             ; (The editor build has its own copy of this, next to the editor.)
0176                             ; A checked build first clears the lower half of the letter page (A = 0):
0176                             ; every variable starts at 0, every word cell holds 0000h, the address an
0176                             ; undefined word is caught at (see e_hi), and no key is held back.
0176                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                    INIT:     LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
                              LD   BC,PROG   ; the IP
0176                          ENDIF      
0176                          IF   (1-CPM)*(1-EDITOR)   
                    ST0:      LD   H,B   
                              LD   L,C   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
0176                          ENDIF      
0176                          IF   1-EDITOR   
                    ST2:      LD   (HEAP),HL   
0176                          ENDIF      
0176                          IF   CHECKED*(1-EDITOR)   
                              RST   20h   ; minus the heap"s first address: "_' may not
                              LD   (NPEND),HL   ;   release below it
0176                          ENDIF      
0176                          IF   (1-CHECKED)*(1-EDITOR)   
                              LD   HL,0   ; no key is held, and the break key is on
                              LD   (KEYBUF),HL   ;   (the checked build has cleared these)
0176                          ENDIF      
0176                          IF   1-EDITOR   
                              EXX      
                              LD   HL,RSTOP   ; the return stack is empty
                              EXX      
                              RST   30h   ; (its return address is thrown away)
0176                          ENDIF      
0176                             ; In the unchecked generic editor build the table is here, in the first
0176                             ; page, which saves loading D twice. (The other builds have no room for it
0176                             ; here: theirs is further down.)
0176                          IF   TABP0   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0176                          ENDIF      
0176                             ; =============================================================================
0176                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
0176                             ;  (00bbIGFuZCA= are up among the RST routines.) The machine-code call, exec,
0176                             ;  is here too: it belongs to "`" and makes the page come out right.
0176                             ; =============================================================================
0176   D1           H_XOR:    POP   DE   
0177   7C                     LD   A,H   
0178   AA                     XOR   D   
0179   67                     LD   H,A   
017A   7D                     LD   A,L   
017B   AB                     XOR   E   
017C   6F                     LD   L,A   
017D   F7                     RST   30h   
017E   D1           H_OR:     POP   DE   
017F   7C                     LD   A,H   
0180   B2                     OR   D   
0181   67                     LD   H,A   
0182   7D                     LD   A,L   
0183   B3                     OR   E   
0184   6F                     LD   L,A   
0185   F7                     RST   30h   
0186   E7           H_NOT:    RST   20h   ; ~x = -x - 1
0187   2B                     DEC   HL   
0188   F7                     RST   30h   
0189                             ; "_" ( n -- addr ): the heap pointer moves by n, a signed count (the add is
0189                             ; the same either way); TOS is the old pointer.
0189   ED 5B 7C 09  H_ALLOC:   LD   DE,(HEAP)   
018D                          IF   CHECKED*CPM   
018D   7C                     LD   A,H   ; the count's sign, for chkhp
018E                          ENDIF      
018E   19                     ADD   HL,DE   ; the new top
018F                          IF   CHECKED   
018F   CD 4A 04               CALL   chkhp   
0192                          ENDIF      
0192   22 7C 09               LD   (HEAP),HL   
0195   EB                     EX   DE,HL   
0196   F7                     RST   30h   
0197   D9           EXEC:     EXX      
0198   22 34 09               LD   (RSAVE),HL   ; machine code may change the alternates
019B   D9                     EXX      
019C   CD 2B 01               CALL   jphl   
019F   D9                     EXX      
01A0   2A 34 09               LD   HL,(RSAVE)   
01A3   D9                     EXX      
01A4   E1                     POP   HL   
01A5   F7                     RST   30h   
01A6                             ; ---- the letters and digits (here, in the middle, so that the inner loop's
01A6                             ; ---- short jumps reach them, and the handlers after them reach rpushn) ------
01A6                             ; Digits: step back onto the first digit and read the whole number.
01A6   E5           DIGIT:    PUSH   HL   
01A7   0B                     DEC   BC   
01A8   CD 2C 03               CALL   rdnum   
01AB   F7                     RST   30h   
01AC                             ; a-z: push the cell's address (the cell is the variable)
01AC   E5           LOWER:    PUSH   HL   
01AD   87                     ADD   A,A   
01AE   6F                     LD   L,A   
01AF   26 09                  LD   H,LETPAGE   
01B1   F7                     RST   30h   
01B2                             ; A-Z: call the word. The return address (the IP after the letter) goes on
01B2                             ; the return stack, and the IP becomes the address in the letter's cell.
01B2   C5           UPPER:    PUSH   BC   ; the return address, for rpushn
01B3   EB                     EX   DE,HL   ; park TOS
01B4   87                     ADD   A,A   
01B5   6F                     LD   L,A   
01B6   26 09                  LD   H,LETPAGE   ; HL -> cell
01B8   4E                     LD   C,(HL)   
01B9   2C                     INC   L   
01BA   46                     LD   B,(HL)   ; IP = the word's body
01BB   EB                     EX   DE,HL   ; TOS back, and fall into rpushn
01BC                             ; rpushn: move the top cell of the data stack (in memory) to the return
01BC                             ; stack, then next. Everything that pushes the return stack ends here.
01BC                             ; 
01BC                             ; The break key is looked at here, so at every word call and loop-back (and
01BC                             ; block entry and "{"), but only one time in 256: B', which nothing else
01BC                             ; uses, counts them. Reading the keyboard can be slow (it is a BDOS call
01BC                             ; under CP/M), and this way it costs a loop two bytes and 13 T-states.
01BC   D9           RPUSHN:   EXX      
01BD   D1                     POP   DE   
01BE   2B                     DEC   HL   
01BF   72                     LD   (HL),D   
01C0   2B                     DEC   HL   
01C1   73                     LD   (HL),E   
01C2   10 05                  DJNZ   rp1   
01C4   D9                     EXX      
01C5   CD DC 03               CALL   pollk   
01C8   F7                     RST   30h   
01C9   D9           RP1:      EXX      
01CA   F7                     RST   30h   
01CB                             ; ---- machine code: the grave -----------------------------------------------
01CB                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
01CB                             ; are stored from addr until a non-hex character; then a RET (C9h) is
01CB                             ; written and its address is left. An odd last digit is consumed and dropped.
01CB                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
01CB                             ; code is entered by CALL with the data stack above the return address; it
01CB                             ; must keep BC, and on return the top cell becomes the new TOS.
01CB   CD CA 03     H_GRAVE:   CALL   hexc   
01CE   30 C7                  JR   NC,exec   
01D0   77           HX1:      LD   (HL),A   ; the high digit goes in first ...
01D1   CD CA 03               CALL   hexc   
01D4   30 08                  JR   NC,hx2   ; odd digit: consumed, and the RET below
01D6   ED 6F                  RLD      ;   overwrites it
01D8   23                     INC   HL   ; ... and RLD shifts it up under the low one
01D9   CD CA 03               CALL   hexc   
01DC   38 F2                  JR   C,hx1   
01DE   36 C9        HX2:      LD   (HL),0C9h   ; (never range-checked: the spec says so)
01E0   F7                     RST   30h   
01E1                             ; ---- where the two pages meet ----------------------------------------------
01E1                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
01E1                             ; are in falling code order for this), and where exactly differs between the
01E1                             ; builds: NPG1 follows. Every handler below these four must start in the
01E1                             ; second page, and every one above in the first; chktab.py checks both.
01E1                             ; "]" returns: pop an address and jump to it.
01E1   CF           H_RET:    RST   08h   
01E2   42                     LD   B,D   
01E3   4B                     LD   C,E   
01E4   F7           BRK1:     RST   30h   
01E5                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
01E5                             ; drops the block start, "]" returns. No closer at all ends the program.
01E5   7C           H_BREAK:   LD   A,H   
01E6   B5                     OR   L   
01E7   E1                     POP   HL   
01E8   28 FA                  JR   Z,brk1   
01EA   CD 53 03               CALL   skip   
01ED   B7                     OR   A   ; skip returns 0 for ")"
01EE   20 F1                  JR   NZ,h_ret   
01F0   CF           RDROP:    RST   08h   
01F1   F7                     RST   30h   
01F2                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
01F2                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
01F2                             ; the body"s address instead. Either way it then skips to the matching "]'.
01F2                             ; (The unchecked build takes anything that is not a letter as the space; the
01F2                             ; checked build stops on it.)
01F2   0A           H_DEF:    LD   A,(BC)   
01F3   03                     INC   BC   
01F4   D6 41                  SUB   "A"   ; a letter gives 0-25 or 32-57: lowercase
01F6   5F                     LD   E,A   ;   lands 64 bytes up
01F7   E6 DF                  AND   0DFh   ; fold case
01F9   FE 1A                  CP   26   
01FB   30 0B                  JR   NC,def2   ; not a letter
01FD   CB 23                  SLA   E   
01FF   16 09                  LD   D,LETPAGE   ; DE -> cell
0201   79                     LD   A,C   
0202   12                     LD   (DE),A   
0203   1C                     INC   E   
0204   78                     LD   A,B   
0205   12                     LD   (DE),A   
0206   18 09                  JR   skipnx   
0208                DEF2:        
0208                          IF   CHECKED   
0208   7B                     LD   A,E   
0209   FE DF                  CP   " "-"A"+256   
020B   C2 D9 04               JP   NZ,e_brack   ; anything but a letter or a space
020E                          ENDIF      
020E   E5                     PUSH   HL   ; an anonymous block: push its address
020F   60                     LD   H,B   
0210   69                     LD   L,C   
0211                SKIPNX:      
0211                          IF   CHECKED   
0211   0B                     DEC   BC   ; back onto the letter, so that skip finds its
0212                          ENDIF      ;   opener, the "[", just before where it starts
0212   CD 53 03     SKIPO:    CALL   skip   
0215   F7                     RST   30h   
0216   5E           H_FETCH:   LD   E,(HL)   ; "@"
0217   23                     INC   HL   
0218   56                     LD   D,(HL)   
0219   EB                     EX   DE,HL   
021A   F7                     RST   30h   
021B                             ; =============================================================================
021B                             ;  Handlers that must start in the image's second page.
021B                             ;  "?" is the last (with "," inside it), so its long tail may run past that
021B                             ;  page.
021B                             ; =============================================================================
021B                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
021B                             ; the matching ")".
021B   7C           H_OPEN:   LD   A,H   
021C   B5                     OR   L   
021D   E1                     POP   HL   
021E   28 F2                  JR   Z,skipo   
0220   C5                     PUSH   BC   ; the block starts at the IP
0221   18 99                  JR   rpushn   
0223                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
0223                             ; drops it and carries on.
0223   7C           H_CLOSE:   LD   A,H   
0224   B5                     OR   L   
0225   E1                     POP   HL   
0226   28 C8                  JR   Z,rdrop   
0228   CF                     RST   08h   ; pop the block start ...
0229   42                     LD   B,D   
022A   4B                     LD   C,E   
022B   C5                     PUSH   BC   
022C   18 8E                  JR   rpushn   ; ... and push it back
022E                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
022E                             ; "-" has two jobs: directly before a digit it starts a negative number.
022E   0A           H_SUB:    LD   A,(BC)   
022F   D6 30                  SUB   "0"   
0231   FE 0A                  CP   10   
0233   38 04                  JR   C,negnum   
0235   E7                     RST   20h   ; a - b = a + (-b): fall into "+"
0236   D1           H_ADD:    POP   DE   
0237   19                     ADD   HL,DE   
0238   F7                     RST   30h   
0239   E5           NEGNUM:   PUSH   HL   ; a negative number: read it, negate it
023A   CD 2C 03               CALL   rdnum   
023D   E7                     RST   20h   
023E   F7                     RST   30h   
023F   D1           H_AND:    POP   DE   
0240   7C                     LD   A,H   
0241   A2                     AND   D   
0242   67                     LD   H,A   
0243   7D                     LD   A,L   
0244   A3                     AND   E   
0245   6F                     LD   L,A   
0246   F7                     RST   30h   
0247                             ; Signed compares. Both are "HL < DE" for the right pair: "<" swaps the two
0247                             ; cells first. Flipping both sign bits turns a signed compare into an
0247                             ; unsigned one (and XOR clears the carry for SBC); SBC HL,HL then turns the
0247                             ; carry into -1 or 0 with no branch.
0247   E3           H_LT:     EX   (SP),HL   ; a < b: HL = a, and b is popped next
0248   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
0249   7C                     LD   A,H   
024A   EE 80                  XOR   80h   
024C   67                     LD   H,A   
024D   7A                     LD   A,D   
024E   EE 80                  XOR   80h   
0250   57                     LD   D,A   
0251   ED 52                  SBC   HL,DE   ; carry if HL < DE
0253   ED 62        TF:       SBC   HL,HL   ; carry -> -1 or 0
0255   F7                     RST   30h   
0256   D1           H_EQ:     POP   DE   
0257   B7                     OR   A   
0258   ED 52                  SBC   HL,DE   
025A   7C                     LD   A,H   
025B   B5                     OR   L   
025C   FE 01                  CP   1   ; carry only if a - b = 0
025E   18 F3                  JR   tf   
0260                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept. The
0260                             ; multiplier shifts up through A:C.
0260   D1           H_MUL:    POP   DE   ; DE = multiplicand
0261   C5                     PUSH   BC   
0262   7C                     LD   A,H   
0263   4D                     LD   C,L   ; A:C = multiplier
0264   21 00 00               LD   HL,0   
0267   06 10                  LD   B,16   
0269   29           MUL1:     ADD   HL,HL   
026A   CB 21                  SLA   C   
026C   17                     RLA      
026D   30 01                  JR   NC,mul2   
026F   19                     ADD   HL,DE   
0270   10 F7        MUL2:     DJNZ   mul1   
0272   C1                     POP   BC   
0273   F7                     RST   30h   
0274                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
0274                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
0274                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
0274                             ; stops on it.
0274                H_DIV:       
0274                          IF   CHECKED   
0274   7C                     LD   A,H   
0275   B5                     OR   L   
0276   CA D6 04               JP   Z,e_zero   
0279                          ENDIF      
0279   D1                     POP   DE   ; DE = a, HL = b
027A   C5                     PUSH   BC   ; free BC for udiv
027B   D5                     PUSH   DE   ; a, for r's sign
027C   7A                     LD   A,D   
027D   AC                     XOR   H   
027E   F5                     PUSH   AF   ; S flag = sign of q
027F   CB 7C                  BIT   7,H   
0281   C4 20 01               CALL   NZ,neg16   ; HL = |b|
0284   EB                     EX   DE,HL   
0285   CB 7C                  BIT   7,H   
0287   C4 20 01               CALL   NZ,neg16   ; HL = |a|, DE = |b|
028A   CD 06 03               CALL   udiv   ; HL = q, DE = r
028D   F1                     POP   AF   
028E   FC 20 01               CALL   M,neg16   ; q's sign
0291   EB                     EX   DE,HL   ; HL = r, DE = q
0292   F1                     POP   AF   ; A = a's high byte
0293   B7                     OR   A   
0294   FC 20 01               CALL   M,neg16   ; r's sign
0297   C1                     POP   BC   
0298   D5                     PUSH   DE   ; q under r
0299   F7                     RST   30h   
029A                             ; ---- stack and storage -----------------------------------------------------
029A   E5           H_DUP:    PUSH   HL   ; ":"
029B   F7                     RST   30h   
029C   E3           H_SWAP:   EX   (SP),HL   ; "%"
029D   F7                     RST   30h   
029E                             ; (The checked build tests the address before it takes the value off the
029E                             ; stack, so that an error report shows both.)
029E                H_CSTORE:      ; "." ( c addr -- )
029E                          IF   CHECKED   
029E   CD 39 04               CALL   chkst   
02A1                          ENDIF      
02A1   D1                     POP   DE   
02A2   73                     LD   (HL),E   
02A3   DF           H_DROP:   RST   18h   ; ";" is this one byte
02A4                H_STORE:      ; "!" ( n addr -- )
02A4                          IF   CHECKED   
02A4   CD 39 04               CALL   chkst   
02A7                          ENDIF      
02A7   D1                     POP   DE   
02A8   73                     LD   (HL),E   
02A9   23                     INC   HL   
02AA   72                     LD   (HL),D   
02AB   DF                     RST   18h   
02AC                             ; ---- console ---------------------------------------------------------------
02AC                             ; 22h pushes the address of the text after it and skips the string.
02AC   E5           H_STR:    PUSH   HL   
02AD   60                     LD   H,B   
02AE   69                     LD   L,C   
02AF   CD 42 03               CALL   skipstr   
02B2                          IF   CHECKED   
02B2   B7                     OR   A   ; 0: the text ran out before the closing quote
02B3   CA CE 04               JP   Z,e_quote   
02B6                          ENDIF      
02B6   F7                     RST   30h   
02B7                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character
02B7                             ; clears that character"s bit 6 (/M is CR, /` is space; "/" and ""' have no
02B7                             ; bit 6, so // and /" give themselves).
02B7                          IF   1-CHECKED   
                    H_PRINT:   LD   A,(HL)   
                              INC   HL   
                              CP   22h   
                              JR   Z,pr9   
                              CP   "/"   
                              JR   NZ,pr1   
                              LD   A,(HL)   
                              INC   HL   
                              AND   0BFh   
                    PR1:      RST   28h   
                              JR   h_print   
02B7                          ENDIF      
02B7                          IF   CHECKED   
02B7                             ; (The checked build has the loop as a routine, prstr, which the error
02B7                             ; report uses too. The address is kept on the stack meanwhile: a report
02B7                             ; shows the stack as it was before the "$".)
02B7   E5           H_PRINT:   PUSH   HL   
02B8   CD 66 04               CALL   prstr   
02BB   D1                     POP   DE   
02BC   DF                     RST   18h   
02BD                          ENDIF      
02BD   7D           H_EMIT:   LD   A,L   ; "'"
02BE   EF                     RST   28h   
02BF   DF           PR9:      RST   18h   
02C0                             ; "#" prints TOS as a signed decimal number, with no space after it.
02C0   C5           H_NUM:    PUSH   BC   
02C1   CD 90 03               CALL   psgn   
02C4   C1                     POP   BC   
02C5   DF                     RST   18h   
02C6                             ; "?" ( n -- c ) or ( -n -- addr )
02C6                             ;   n > 0: wait about n ms for a key; 0 if none came
02C6                             ;   n = 0: wait for a key
02C6                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
02C6                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
02C6   CB 7C        H_KEY:    BIT   7,H   
02C8   20 19                  JR   NZ,line   
02CA   1E 28        KT1:      LD   E,MSLOOP   ; one millisecond, roughly
02CC   CD E8 03     KT2:      CALL   getk   
02CF   20 0E                  JR   NZ,kt3   
02D1   1D                     DEC   E   
02D2   20 F8                  JR   NZ,kt2   
02D4   7C                     LD   A,H   ; 0? never counts down: it waits
02D5   B5                     OR   L   
02D6   28 F2                  JR   Z,kt1   
02D8   2B                     DEC   HL   
02D9   7C                     LD   A,H   
02DA   B5                     OR   L   
02DB   20 ED                  JR   NZ,kt1   ; A = 0 if the time ran out
02DD   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
02DE   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
02DF   6F           KT3:      LD   L,A   
02E0   26 00                  LD   H,0   
02E2   F7                     RST   30h   
02E3                          IF   CPM   
02E3                             ; CP/M: BDOS 10 does the editing (the spec allows the platform's
02E3                             ; own line editor). It doesn't store the CR, so it is added here.
02E3   11 7F 00     LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
02E6   19                     ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
02E7   9F                     SBC   A,A   
02E8   A5                     AND   L   ; (0 for a count that is too big)
02E9   EE 7F                  XOR   127   ; A = the count, 127 at most
02EB                          ENDIF      
02EB                          IF   CPM*EDITOR   
02EB   CD F1 02               CALL   rdline   ; (the editor calls rdline too)
02EE   2E 80                  LD   L,LINEBUF & 0FFh   
02F0   F7                     RST   30h   
02F1                             ; rdline: read a line of at most A characters; HL -> the CR that ends it
02F1                RDLINE:      
02F1                          ENDIF      
02F1                          IF   CPM   
02F1   32 7E 09               LD   (LBHDR),A   
02F4   11 7E 09               LD   DE,LBHDR   
02F7   3E 0A                  LD   A,10   
02F9   CD 2C 04               CALL   bdosx   
02FC   21 7F 09               LD   HL,LBHDR+1   
02FF   7E                     LD   A,(HL)   ; the count typed (0-127)
0300   2C                     INC   L   ; HL = LINEBUF, whose low byte is 80h:
0301   85                     ADD   A,L   ;   adding the count to L can't carry
0302   6F                     LD   L,A   
0303   36 0D                  LD   (HL),13   
0305                          ENDIF      
0305                          IF   CPM*(1-EDITOR)   
                              LD   L,LINEBUF & 0FFh   
                              RST   30h   
0305                          ENDIF      
0305                          IF   CPM*EDITOR   
0305   C9                     RET      
0306                          ENDIF      
0306                          IFN   CPM   
                                 ; Generic: Backspace takes the last character back (and is echoed as
                                 ; it is), CR ends (stored, not echoed), every other key is stored and
                                 ; echoed until the line is full. The line buffer starts at offset 80h
                                 ; of its page, so L alone is the place in the line: D holds the L of
                                 ; a full line.
0306                          ENDIF      
0306                          IFN   CPM   
                    LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
                              ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
                              SBC   A,A   
                              AND   L   ; (0 for a count that is too big)
                              CPL      
                              LD   D,A   ; D = the L of a full line: 80h + count, FFh
0306                          ENDIF      ;   at most
0306                          IF   EDGEN   
                              CALL   rdline   ; (the editor calls rdline too)
                              LD   L,LINEBUF & 0FFh   
                              RST   30h   
                                 ; rdline: read a line that is full when L reaches D; HL -> the CR that ends it
                    RDLINE:      
0306                          ENDIF      
0306                          IFN   CPM   
                              LD   HL,LINEBUF   
                    LN2:      CALL   getk   
                              JR   Z,ln2   
                              CP   13   
                              JR   Z,ln5   
                              CP   8   
                              JR   Z,ln4   
                              LD   E,A   
                              LD   A,L   
                              CP   D   
                              JR   Z,ln2   ; full
                              LD   (HL),E   
                              INC   L   
                              LD   A,E   
                    LN3:      RST   28h   
                              JR   ln2   
                    LN4:      DEC   L   ; Backspace: one back, and echo it,
                              JP   M,ln3   ;   unless the line was empty (L left the
                              INC   L   ;   upper half of the page)
                              JR   ln2   
                    LN5:      LD   (HL),A   ; the CR
0306                          ENDIF      
0306                          IF   (1-CPM)*(1-EDITOR)   
                              LD   L,LINEBUF & 0FFh   
                              RST   30h   
0306                          ENDIF      
0306                          IF   EDGEN   
                              RET      
0306                          ENDIF      
0306                             ; =============================================================================
0306                             ;  More routines (no handler starts past this point)
0306                             ; =============================================================================
0306                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
0306                             ; Uses A, BC; the caller saves the IP. The dividend shifts up through A:C
0306                             ; while the quotient bits arrive at the bottom of C.
0306                             ; Dividing by 2 is one shift (the spec wants that fast).
0306   7B           UDIV:     LD   A,E   
0307   EE 02                  XOR   2   
0309   B2                     OR   D   
030A   20 07                  JR   NZ,udv0   
030C   CB 3C                  SRL   H   
030E   CB 1D                  RR   L   ; the quotient
0310   8F                     ADC   A,A   
0311   5F                     LD   E,A   ; the remainder: the bit that fell out (D is 0)
0312   C9                     RET      
0313   7C           UDV0:     LD   A,H   
0314   4D                     LD   C,L   
0315   21 00 00               LD   HL,0   
0318   06 10                  LD   B,16   
031A   CB 21        UDV1:     SLA   C   
031C   17                     RLA      
031D   ED 6A                  ADC   HL,HL   
031F   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
0321   30 02                  JR   NC,udv2   ;   always fits in 16 bits
0323   19                     ADD   HL,DE   ; too much: put it back, and cancel the
0324   0D                     DEC   C   ;   INC below
0325   0C           UDV2:     INC   C   ; a quotient bit
0326   10 F2                  DJNZ   udv1   
0328   EB                     EX   DE,HL   ; DE = remainder
0329   67                     LD   H,A   
032A   69                     LD   L,C   ; HL = quotient
032B   C9                     RET      
032C                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
032C                             ; non-digit. Values wrap at 16 bits, as the spec says.
032C   21 00 00     RDNUM:    LD   HL,0   
032F   0A           RDN1:     LD   A,(BC)   
0330   D6 30                  SUB   "0"   
0332   FE 0A                  CP   10   
0334   D0                     RET   NC   
0335   03                     INC   BC   
0336   54                     LD   D,H   
0337   5D                     LD   E,L   
0338   29                     ADD   HL,HL   
0339   29                     ADD   HL,HL   
033A   19                     ADD   HL,DE   
033B   29                     ADD   HL,HL   ; HL * 10
033C   5F                     LD   E,A   
033D   16 00                  LD   D,0   
033F   19                     ADD   HL,DE   
0340   18 ED                  JR   rdn1   
0342                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
0342                             ; the next character, so "/"" does not end it. Leaves A = 22h.
0342                          IF   1-CHECKED   
                    SS0:      INC   BC   
                    SKIPSTR:   LD   A,(BC)   
                              INC   BC   
                              CP   "/"   
                              JR   Z,ss0   
                              CP   22h   
                              JR   NZ,skipstr   
                              RET      
0342                          ENDIF      
0342                          IF   CHECKED   
0342                             ; The checked build never steps over a NUL: if the text runs out first it
0342                             ; returns A = 0 with the IP on the NUL.
0342   0A           SKIPSTR:   LD   A,(BC)   
0343   B7                     OR   A   
0344   C8                     RET   Z   
0345   03                     INC   BC   
0346   FE 22                  CP   22h   
0348   C8                     RET   Z   
0349   FE 2F                  CP   "/"   
034B   20 F5                  JR   NZ,skipstr   
034D   0A                     LD   A,(BC)   ; the escaped character
034E   B7                     OR   A   
034F   C8                     RET   Z   
0350   03                     INC   BC   
0351   18 EF                  JR   skipstr   
0353                          ENDIF      
0353                             ; skip: read past text to the closer at this level, and return A = 0 if it
0353                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
0353                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
0353                             ; no closer; anything else that runs into the NUL had unbalanced brackets
0353                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
0353                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
0353                             ; 
0353                             ; The checked build also looks at the character the skip was started by,
0353                             ; which is always the one just before where it starts: "(" must end at ")",
0353                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
0353                             ; quote counts as running into it. "\" takes either closer. IX keeps the
0353                             ; place where the skip started, for the report.
0353                SKIP:        
0353                          IF   CHECKED   
0353   C5                     PUSH   BC   
0354   DD E1                  POP   IX   
0356   0B                     DEC   BC   
0357   0A                     LD   A,(BC)   
0358   03                     INC   BC   
0359   5F                     LD   E,A   ; E = the opener: ( [ or \
035A                          ENDIF      
035A   16 00                  LD   D,0   
035C   14           SK3:      INC   D   ; an opener: one deeper
035D   0A           SK1:      LD   A,(BC)   
035E                          IF   1-CHECKED   
                              INC   BC   
                              OR   A   
                              JP   Z,endprog   
035E                          ENDIF      
035E                          IF   CHECKED   
035E   B7                     OR   A   
035F   28 22                  JR   Z,sk6   ; (the IP stays on the NUL)
0361   03                     INC   BC   
0362                          ENDIF      
0362   FE 22                  CP   22h   
0364   CC 42 03               CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
0367   D6 28                  SUB   "("   ;   (or 0, and then the NUL is read next)
0369   28 F1                  JR   Z,sk3   
036B   3D                     DEC   A   ; ")"
036C   28 08                  JR   Z,sk4   
036E   D6 32                  SUB   "["-")"   
0370   28 EA                  JR   Z,sk3   
0372   FE 02                  CP   "]"-"["   
0374   20 E7                  JR   NZ,sk1   
0376   15           SK4:      DEC   D   
0377                          IF   1-CHECKED   
                              RET   Z   ; the closer at this level
                              JR   sk1   
0377                          ENDIF      
0377                          IF   CHECKED   
0377   20 E4                  JR   NZ,sk1   
0379   57                     LD   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
037A   AB                     XOR   E   ;   opener is 0 for "(" and 1 for "[", and only
037B   E6 06                  AND   6   ;   "\" has bit 2: so this is 2 for the wrong
037D   FE 02                  CP   2   ;   closer, and only then
037F   7A                     LD   A,D   
0380   C0                     RET   NZ   
0381   18 05                  JR   sk7   
0383   CB 53        SK6:      BIT   2,E   ; the text ran out:
0385   C2 15 01               JP   NZ,endprog   ;   "\" with no closer ends the program
0388   DD E5        SK7:      PUSH   IX   ; N. The place is the opener
038A   C1                     POP   BC   
038B   3E 4E                  LD   A,"N"   
038D   C3 CB 04               JP   errp   ; (errp drops skip's return address)
0390                          ENDIF      
0390                             ; psgn: print HL as a signed number. Uses BC.
0390   CB 7C        PSGN:     BIT   7,H   
0392   28 04                  JR   Z,pdec   
0394   3E 2D                  LD   A,"-"   
0396   EF                     RST   28h   
0397   E7                     RST   20h   
0398                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
0398                             ; Uses BC.
0398   11 0A 00     PDEC:     LD   DE,10   
039B   CD 06 03               CALL   udiv   ; HL = HL / 10, E = the last digit
039E   7B                     LD   A,E   
039F   F5                     PUSH   AF   
03A0   7C                     LD   A,H   
03A1   B5                     OR   L   
03A2   C4 98 03               CALL   NZ,pdec   
03A5   F1                     POP   AF   
03A6   C6 30                  ADD   A,"0"   
03A8   EF                     RST   28h   
03A9   C9                     RET      
03AA                             ; =============================================================================
03AA                             ;  Dispatch table: the low byte of each handler's address, in code order
03AA                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
03AA                             ;  It must not cross a page (the dispatcher only adds to its low byte).
03AA                             ; =============================================================================
03AA                             ; The handlers of the first NPG1 characters start in the image's second page.
03AA                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
03AA                             ; differs between the builds, so the count is worked out here.
03AA                             ; (One division to a line: asm80 only rounds down when it stores a value.)
03AA                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
03AA                PGBRK:    EQU   (h_break-BASE)/256   
03AA                PGDEF:    EQU   (h_def-BASE)/256   
03AA                PGFET:    EQU   (h_fetch-BASE)/256   
03AA                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
03AA                          IF   1-TABP0   
03AA                PTAB:        
03AA                          ;*Macro unroll:  PTABLE
03AA   A4                     DB   h_store & 0FFh   
03AB   AC                     DB   h_str & 0FFh   
03AC   C0                     DB   h_num & 0FFh   
03AD   B7                     DB   h_print & 0FFh   
03AE   9C                     DB   h_swap & 0FFh   
03AF   3F                     DB   h_and & 0FFh   
03B0   BD                     DB   h_emit & 0FFh   
03B1   1B                     DB   h_open & 0FFh   
03B2   23                     DB   h_close & 0FFh   
03B3   60                     DB   h_mul & 0FFh   
03B4   36                     DB   h_add & 0FFh   
03B5   DE                     DB   h_cfetch & 0FFh   
03B6   2E                     DB   h_sub & 0FFh   
03B7   9E                     DB   h_cstore & 0FFh   
03B8   74                     DB   h_div & 0FFh   
03B9   9A                     DB   h_dup & 0FFh   
03BA   A3                     DB   h_drop & 0FFh   
03BB   47                     DB   h_lt & 0FFh   
03BC   56                     DB   h_eq & 0FFh   
03BD   48                     DB   h_gt & 0FFh   
03BE   C6                     DB   h_key & 0FFh   
03BF   16                     DB   h_fetch & 0FFh   
03C0   F2                     DB   h_def & 0FFh   
03C1   E5                     DB   h_break & 0FFh   
03C2   E1                     DB   h_ret & 0FFh   
03C3   76                     DB   h_xor & 0FFh   
03C4   89                     DB   h_alloc & 0FFh   
03C5   CB                     DB   h_grave & 0FFh   
03C6   2C                     DB   h_tor & 0FFh   
03C7   7E                     DB   h_or & 0FFh   
03C8   1C                     DB   h_fromr & 0FFh   
03C9   86                     DB   h_not & 0FFh   
03CA                PTABEND:      
03CA                          ENDIF      
03CA                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
03CA                             ; and return its value in A with the carry set; otherwise leave the IP and
03CA                             ; return with the carry clear.
03CA   0A           HEXC:     LD   A,(BC)   
03CB   D6 30                  SUB   "0"   
03CD   FE 0A                  CP   10   
03CF   38 09                  JR   C,hc1   
03D1   E6 DF                  AND   0DFh   
03D3   D6 11                  SUB   11h   
03D5   FE 06                  CP   6   
03D7   D0                     RET   NC   
03D8   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
03DA   03           HC1:      INC   BC   
03DB   C9                     RET      
03DC                             ; =============================================================================
03DC                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
03DC                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
03DC                             ;  (RST 28h) prints A. Both keep BC, DE, HL and HL'. In the generic build
03DC                             ;  they are the host's KEY and CONOUT routines themselves.
03DC                             ; 
03DC                             ;  A running program reads the keyboard only through getk and pollk, which
03DC                             ;  between them give the break key its rules:
03DC                             ;    - Ctrl-C stops the program;
03DC                             ;    - any other key that the break check reads is held in KEYBUF for the
03DC                             ;      next "?", and a newer one takes its place;
03DC                             ;    - "?" (getk) takes the held key first;
03DC                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
03DC                             ;      key like any other, but two of them within about 250 ms still stop it.
03DC                             ;  Both are called straight from a handler, never from a routine under one:
03DC                             ;  the checked build's report counts on finding one return address above the
03DC                             ;  data stack.
03DC                             ; =============================================================================
03DC                          IFN   CPM   
                    RAWK:     EQU   KEY   
03DC                          ENDIF      
03DC                             ; pollk: the break check (see rpushn).
03DC   CD 1E 04     POLLK:    CALL   rawk   
03DF   C8                     RET   Z   ; no key
03E0   32 7A 09               LD   (KEYBUF),A   ; held for the next "?"
03E3   FE 03                  CP   3   
03E5   C0                     RET   NZ   
03E6   18 11                  JR   ctlc   
03E8                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
03E8   E5           GETK:     PUSH   HL   ; a held key goes first, and is taken out of
03E9   21 7A 09               LD   HL,KEYBUF   ;   the buffer
03EC   7E                     LD   A,(HL)   
03ED   36 00                  LD   (HL),0   
03EF   E1                     POP   HL   
03F0   B7                     OR   A   
03F1   C0                     RET   NZ   
03F2   CD 1E 04               CALL   rawk   
03F5   C8                     RET   Z   
03F6   FE 03                  CP   3   
03F8   C0                     RET   NZ   
03F9                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
03F9                             ; the program has turned it off, wait about 250 ms for one more key: a
03F9                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
03F9                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
03F9   3A 7B 09     CTLC:     LD   A,(BRKOFF)   
03FC   B7                     OR   A   
03FD   CA C3 04               JP   Z,brk   
0400   D5                     PUSH   DE   
0401   11 10 27               LD   DE,250*MSLOOP   
0404   CD 1E 04     CT1:      CALL   rawk   
0407   20 05                  JR   NZ,ct2   
0409   1B                     DEC   DE   
040A   7A                     LD   A,D   
040B   B3                     OR   E   
040C   20 F6                  JR   NZ,ct1   
040E   D1           CT2:      POP   DE   ; A = the second key, or 0 if none came
040F   FE 03                  CP   3   
0411   CA C3 04               JP   Z,brk   
0414   B7                     OR   A   
0415   28 03                  JR   Z,ct3   
0417   32 7A 09               LD   (KEYBUF),A   
041A   3E 03        CT3:      LD   A,3   
041C   B7                     OR   A   
041D   C9                     RET      
041E                          IF   1-CHECKED   
                    BRK:      EQU   endprog   ; the unchecked build stops without a word;
041E                          ENDIF      
041E                          IF   CHECKED   
041E                BRK:      EQU   e_break   ;   the checked build reports B
041E                          ENDIF      
041E                          IF   CPM   
041E   3E FF        RAWK:     LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
0420                             ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
0420                             ; printing and could swallow a key that BDOS 6 then never sees.
0420   D5           PUTC:     PUSH   DE   
0421   E5                     PUSH   HL   
0422   5F                     LD   E,A   
0423   3E 06                  LD   A,6   
0425   CD 2C 04               CALL   bdosx   
0428   E1                     POP   HL   
0429   D1                     POP   DE   
042A   B7                     OR   A   ; (for getk)
042B   C9                     RET      
042C                             ; bdosx: call BDOS function A with DE, keeping BC and HL'
042C   C5           BDOSX:    PUSH   BC   
042D   D9                     EXX      
042E   E5                     PUSH   HL   
042F   D9                     EXX      
0430   4F                     LD   C,A   
0431   CD 05 00               CALL   BDOS   
0434   D9                     EXX      
0435   E1                     POP   HL   
0436   D9                     EXX      
0437   C1                     POP   BC   
0438   C9                     RET      
0439                          ENDIF      
0439                             ; =============================================================================
0439                             ;  Checked build: the checks and the error report
0439                             ; =============================================================================
0439                          IF   CHECKED   
0439                             ; chkst: stop unless HL is in the program's own space: from the letter page
0439                             ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
0439                             ; whatever lies above the limit are safe. Memory above the heap top but
0439                             ; below the limit is the program's own: Tiny BASIC keeps its lines there.
0439                             ; It is the page of HL + 1 that is tested, so that one test serves both
0439                             ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
0439                             ; Keeps HL and BC.
0439   23           CHKST:    INC   HL   
043A   7C                     LD   A,H   
043B   2B                     DEC   HL   
043C   FE 09                  CP   LETPAGE   
043E   38 07                  JR   C,chs1   
0440                          ENDIF      
0440                          IF   CHECKED*(1-CPM)   
                              CP   HEAPLIM   
                              RET   C   
0440                          ENDIF      
0440                          IF   CHECKED*CPM   
0440   5F                     LD   E,A   
0441   3A 07 00               LD   A,(0007h)   ; the BDOS page is the heap limit
0444   3D                     DEC   A   
0445   BB                     CP   E   
0446   D0                     RET   NC   
0447                          ENDIF      
0447                          IF   CHECKED   
0447   C3 C9 04     CHS1:     JP   e_store   
044A                             ; chkhp: HL = the new heap top, DE = the old one, the carry is from adding
044A                             ; the count. Stop if the top is not below the limit page, or is below the
044A                             ; program's end.
044A                CHKHP:       
044A                          ENDIF      
044A                          IF   CHECKED*CPM   
044A                             ; With this much room a top that wrapped round can land back in
044A                             ; range, so the add is tested too: growing (A, the count's high
044A                             ; byte, is positive) must not carry, and releasing must.
044A   1F                     RRA      ; the carry comes in above the sign:
044B   C6 40                  ADD   A,40h   ;   bit 7 = carry XOR sign
044D   87                     ADD   A,A   
044E   38 10                  JR   C,e_heap   
0450   3A 07 00               LD   A,(0007h)   
0453   3D                     DEC   A   
0454   BC                     CP   H   
0455   38 09                  JR   C,e_heap   
0457                          ENDIF      
0457                          IF   CHECKED*(1-CPM)   
                                 ; (Here the program's space is under 32K, so a top that wrapped
                                 ; round always falls outside it.)
                              LD   A,H   
                              CP   HEAPLIM   
                              JR   NC,e_heap   
0457                          ENDIF      
0457                          IF   CHECKED   
0457   D5                     PUSH   DE   
0458   EB                     EX   DE,HL   
0459   2A 38 09               LD   HL,(NPEND)   
045C   19                     ADD   HL,DE   ; carry: at or above the program's end
045D   EB                     EX   DE,HL   
045E   D1                     POP   DE   
045F   D8                     RET   C   
0460   B7           E_HEAP:   OR   A   ; put the count back in TOS for the report
0461   ED 52                  SBC   HL,DE   
0463   C3 C6 04               JP   e_heap1   
0466                             ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
0466                             ; "$", and the error report's texts). A NUL first is an error: Q.
0466   7E           PRSTR:    LD   A,(HL)   
0467   23                     INC   HL   
0468   FE 22                  CP   22h   
046A   C8                     RET   Z   
046B   B7                     OR   A   
046C   28 0B                  JR   Z,e_dollar   
046E   FE 2F                  CP   "/"   
0470   20 04                  JR   NZ,prs1   
0472   7E                     LD   A,(HL)   
0473   23                     INC   HL   
0474   E6 BF                  AND   0BFh   
0476   EF           PRS1:     RST   28h   
0477   18 ED                  JR   prstr   
0479   D1           E_DOLLAR:   POP   DE   ; "$" ran into a NUL: drop the return address,
047A   E1                     POP   HL   ;   and put the string's address back in TOS
047B   3E 51                  LD   A,"Q"   
047D   C3 DB 04               JP   error   
0480                             ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
0480                             ; pnl: the same, on a new line.
0480   3E 0D        PNL:      LD   A,13   
0482   EF                     RST   28h   
0483   3E 0A                  LD   A,10   
0485   EF                     RST   28h   
0486   E3           PMSG:     EX   (SP),HL   
0487   CD 66 04               CALL   prstr   
048A   E3                     EX   (SP),HL   
048B   C9                     RET      
048C                             ; chkstk: both stacks are checked once per character, not in every handler.
048C                             ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
048C                             ; the constant carries if it is above (cells were popped that were never
048C                             ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
048C                             ; a character late at most: the bytes above DSTOP and the guard band below
048C                             ; the page take what happens meanwhile. DE is free between characters.
048C   EB           CHKSTK:   EX   DE,HL   
048D   21 05 F7               LD   HL,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
0490   39                     ADD   HL,SP   
0491   EB                     EX   DE,HL   
0492   38 1E                  JR   C,e_under   
0494   14                     INC   D   
0495   20 17                  JR   NZ,e_over   
0497   D9                     EXX      ; the return stack: in its page (or it has
0498   7C                     LD   A,H   ;   overflowed), and not above its empty
0499   FE 07                  CP   RSPAGE   ;   position (an underflow stays inside the
049B   7D                     LD   A,L   ;   page, in the guard band)
049C   D9                     EXX      
049D   20 0C                  JR   NZ,e_rover   
049F   FE E1                  CP   RSTOP&0FFh+1   
04A1   D8                     RET   C   
04A2   D9                     EXX      ; return stack underflow: it counts as empty
04A3   21 E0 07               LD   HL,RSTOP   
04A6   D9                     EXX      
04A7   3E 72                  LD   A,"r"   
04A9   18 20                  JR   errp   
04AB   3E 52        E_ROVER:   LD   A,"R"   ; return stack overflow
04AD   11                     DB   11h   ; (LD DE,nn hides the next entry)
04AE   3E 53        E_OVER:   LD   A,"S"   ; data stack overflow
04B0   18 19                  JR   errp   
04B2   31 FC 08     E_UNDER:   LD   SP,DSTOP   ; data stack underflow: it counts as empty
04B5   3E 73                  LD   A,"s"   
04B7   18 22                  JR   error   
04B9                             ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
04B9                             ; was never defined still holds 0000h, and the byte there is a reserved one
04B9                             ; in every build (AFh or C3h): if the IP is in page zero, this was a call of
04B9                             ; an undefined word. The call is undone, so the place is the call itself.
04B9   04           E_HI:     INC   B   
04BA   10 17                  DJNZ   e_resv   ; (B is as it was, and is not 0)
04BC   CF                     RST   08h   
04BD   42                     LD   B,D   
04BE   4B                     LD   C,E   
04BF   3E 55                  LD   A,"U"   
04C1   18 18                  JR   error   
04C3                             ; Error entries. Each loads its letter and then hides the next entry inside
04C3                             ; a 3-byte LD DE,nn (the 11h), so they all fall through to `error`.
04C3   3E 42        E_BREAK:   LD   A,"B"   ; Ctrl-C (found inside pollk or getk)
04C5   11                     DB   11h   
04C6   3E 48        E_HEAP1:   LD   A,"H"   ; heap (found inside chkhp)
04C8   11                     DB   11h   
04C9   3E 4F        E_STORE:   LD   A,"O"   ; a store outside the program's space (chkst)
04CB                             ; errp: an error found inside a routine: drop its return address first.
04CB   D1           ERRP:     POP   DE   
04CC   18 0D                  JR   error   
04CE   44           E_QUOTE:   LD   B,H   ; an unclosed string: HL is its address, one
04CF   4D                     LD   C,L   ;   past the opening quote, which is the place
04D0   3E 51                  LD   A,"Q"   
04D2   11                     DB   11h   
04D3   3E 58        E_RESV:   LD   A,"X"   ; a reserved byte outside a string
04D5   11                     DB   11h   
04D6   3E 5A        E_ZERO:   LD   A,"Z"   ; dividing by zero
04D8   11                     DB   11h   
04D9   3E 57        E_BRACK:   LD   A,"W"   ; bad character after [
04DB                             ; error: the report, then the end. A = the letter, BC = one past the place,
04DB                             ; HL = TOS, and both stacks as the report is to show them:
04DB                             ; 
04DB                             ;   Err X @ line,col
04DB                             ;   up to 16 characters of the text from the place
04DB                             ;   Stk n: the top 8 cells at most, bottom to top
04DB                             ;   Rtn n
04DB   E5           ERROR:    PUSH   HL   ; now the whole data stack is in memory
04DC   5F                     LD   E,A   
04DD   CD 80 04               CALL   pnl   
04E0   45 72 72 20 22         DB   "Err ",22h   
04E5   7B                     LD   A,E   
04E6   EF                     RST   28h   
04E7   CD 86 04               CALL   pmsg   
04EA   20 40 20 22            DB   " @ ",22h   
04EE   0B                     DEC   BC   ; BC = the place
04EF                             ; The line and column. A place below the program is in the line
04EF                             ; buffer: line 0. Otherwise count the LFs from the program's start;
04EF                             ; DE = the line's number, HL = where it starts.
04EF   21 80 09               LD   HL,LINEBUF   
04F2   11 00 00               LD   DE,0   
04F5   78                     LD   A,B   
04F6   FE 0A                  CP   PROG/256   
04F8   38 14                  JR   C,er3   
04FA   24                     INC   H   
04FB   6B                     LD   L,E   ; HL = PROG
04FC   13           ER1:      INC   DE   ; a new line starts at HL
04FD   E5                     PUSH   HL   
04FE   7D           ER2:      LD   A,L   
04FF   91                     SUB   C   
0500   7C                     LD   A,H   
0501   98                     SBC   A,B   
0502   30 09                  JR   NC,er2x   ; reached the place
0504   7E                     LD   A,(HL)   
0505   23                     INC   HL   
0506   FE 0A                  CP   10   
0508   20 F4                  JR   NZ,er2   
050A   F1                     POP   AF   
050B   18 EF                  JR   er1   
050D   E1           ER2X:     POP   HL   
050E   C5           ER3:      PUSH   BC   
050F   E5                     PUSH   HL   
0510   EB                     EX   DE,HL   
0511   CD 98 03               CALL   pdec   ; the line
0514   3E 2C                  LD   A,","   
0516   EF                     RST   28h   
0517   D1                     POP   DE   
0518   E1                     POP   HL   
0519   E5                     PUSH   HL   
051A   B7                     OR   A   
051B   ED 52                  SBC   HL,DE   
051D   23                     INC   HL   
051E   CD 98 03               CALL   pdec   ; the column
0521   CD 80 04               CALL   pnl   
0524   22                     DB   22h   
0525   E1                     POP   HL   ; the text, as it is: 16 characters, or fewer
0526   06 10                  LD   B,16   ;   if the line or the program ends first
0528   7E           ER4:      LD   A,(HL)   
0529   23                     INC   HL   
052A   B7                     OR   A   
052B   28 0F                  JR   Z,er5   
052D   FE 0D                  CP   13   
052F   28 0B                  JR   Z,er5   
0531   FE 0A                  CP   10   
0533   28 07                  JR   Z,er5   
0535                          ENDIF      
0535                          IF   CHECKED*CPM   
0535   FE 1A                  CP   1Ah   ; (the ^Z that pads a file's last record ends
0537   28 03                  JR   Z,er5   ;   the text too: some terminals clear the
0539                          ENDIF      ;   screen on it)
0539                          IF   CHECKED   
0539   EF                     RST   28h   
053A   10 EC                  DJNZ   er4   
053C   CD 80 04     ER5:      CALL   pnl   
053F   53 74 6B 20 22         DB   "Stk ",22h   
0544   21 FA 08               LD   HL,DSTOP-2   ; (the cell at DSTOP-2 was pushed with the
0547   B7                     OR   A   ;   first value and holds nothing)
0548   ED 72                  SBC   HL,SP   
054A   CD 95 05               CALL   phalf   ; the depth
054D   3E 3A                  LD   A,":"   
054F   EF                     RST   28h   
0550   79                     LD   A,C   
0551   FE 09                  CP   9   
0553   38 0A                  JR   C,er6   
0555   CD 86 04               CALL   pmsg   
0558   20 2E 2E 2E 22         DB   " ...",22h   
055D   0E 08                  LD   C,8   
055F   26 00        ER6:      LD   H,0   ; C = the number of cells to show
0561   69                     LD   L,C   
0562   29                     ADD   HL,HL   
0563   39                     ADD   HL,SP   ; HL -> just above the deepest of them
0564   0C                     INC   C   
0565   0D           ER7:      DEC   C   
0566   28 11                  JR   Z,er8   
0568   2B                     DEC   HL   
0569   56                     LD   D,(HL)   
056A   2B                     DEC   HL   
056B   5E                     LD   E,(HL)   
056C   E5                     PUSH   HL   
056D   C5                     PUSH   BC   
056E   3E 20                  LD   A," "   
0570   EF                     RST   28h   
0571   EB                     EX   DE,HL   
0572   CD 90 03               CALL   psgn   
0575   C1                     POP   BC   
0576   E1                     POP   HL   
0577   18 EC                  JR   er7   
0579   CD 80 04     ER8:      CALL   pnl   
057C   52 74 6E 20 22         DB   "Rtn ",22h   
0581   D9                     EXX      
0582   E5                     PUSH   HL   
0583   D9                     EXX      
0584   D1                     POP   DE   
0585   21 E0 07               LD   HL,RSTOP   
0588   B7                     OR   A   
0589   ED 52                  SBC   HL,DE   
058B   CD 95 05               CALL   phalf   
058E   CD 80 04               CALL   pnl   
0591   22                     DB   22h   
0592   C3 15 01               JP   endprog   
0595                             ; phalf: print half of HL, and leave it in C
0595   CB 3C        PHALF:    SRL   H   
0597   CB 1D                  RR   L   
0599   E5                     PUSH   HL   
059A   CD 98 03               CALL   pdec   
059D   C1                     POP   BC   
059E   C9                     RET      
059F                          ENDIF      
059F                             ; =============================================================================
059F                             ;  The line editor (EDITOR = 1)
059F                             ; 
059F                             ;  The interpreter starts here, and a program that ends comes back here. Type
059F                             ;  a line and press Return:
059F                             ; 
059F                             ;    n text    put the text in as line n; the lines from n on move down.
059F                             ;              A number past the end, or 0, adds the line at the end.
059F                             ;    n         take line n out
059F                             ;    0         run the program
059F                             ;    -n        list the program from line n on (-1 lists all of it). Any key
059F                             ;              stops the list until another key is pressed; Ctrl-C ends it.
059F                             ;    anything else is run at once, as B8Script. (Start such a line with a
059F                             ;    space if it would begin with a digit or a minus sign.)
059F                             ; 
059F                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
059F                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
059F                             ;  125 characters, the line number and the one character after it included;
059F                             ;  that character is not stored. The text is kept as it is typed, each line
059F                             ;  ending in CR LF, at PROG. Nothing is checked.
059F                             ; 
059F                             ;  With CPM = 1 the file named on the command line is the program to start
059F                             ;  with (no file, or no such file: no program). Lines are read by BDOS 10, so
059F                             ;  its editing keys work, and Ctrl-C as the first key of a line goes back to
059F                             ;  CP/M. Nothing is written back: there is no command to save.
059F                             ; 
059F                             ;  With CHECKED = 1 a program that is stopped (an error, or Ctrl-C) prints
059F                             ;  its report and comes back here, with both stacks empty. The place is a
059F                             ;  line and column of the program; in a line typed here it is line 0.
059F                             ; 
059F                             ;  Things to know:
059F                             ;    - Reset empties the program (generic builds).
059F                             ;    - Words and variables last from one line to the next. A word's address
059F                             ;      points into the program, so run the program again after editing it.
059F                             ;    - Nothing is printed between a program's output and what is typed next.
059F                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
059F                             ;      a line that calls -n? and carries on afterwards runs what was typed.
059F                             ;      (The stored program never comes back to the line, so it may.)
059F                             ; =============================================================================
059F                          IF   EDGEN*CHECKED   
                                 ; Reset (A = 0): clear the lower half of the letter page. Every variable
                                 ; starts at 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi), and no key is held back.
                    INIT:     LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
                              JR   edit   
059F                          ENDIF      
059F                          IF   EDITOR   
059F                             ; -n: list from line n. DE = the number of the line at HL.
059F   03           LIST:     INC   BC   
05A0   CD 2C 03               CALL   rdnum   ; HL = n
05A3   E5                     PUSH   HL   
05A4   CD 50 06               CALL   find   
05A7   D1                     POP   DE   
05A8   7E           LI1:      LD   A,(HL)   
05A9   B7                     OR   A   
05AA   28 32                  JR   Z,edit   ; the end of the text
05AC   CD 1E 04               CALL   rawk   
05AF   28 0D                  JR   Z,li3   ; no key: carry on
05B1   FE 03                  CP   3   
05B3   28 29                  JR   Z,edit   ; Ctrl-C
05B5   CD 1E 04     LI2:      CALL   rawk   ; any other key: wait for one more
05B8   28 FB                  JR   Z,li2   
05BA   FE 03                  CP   3   
05BC   28 20                  JR   Z,edit   
05BE   E5           LI3:      PUSH   HL   
05BF   D5                     PUSH   DE   
05C0   EB                     EX   DE,HL   
05C1   CD 98 03               CALL   pdec   ; the line's number,
05C4   3E 20                  LD   A," "   
05C6   EF                     RST   28h   ;   a space,
05C7   D1                     POP   DE   
05C8   E1                     POP   HL   
05C9   13                     INC   DE   
05CA   CD 68 06               CALL   prl   ;   and the line
05CD   18 D9                  JR   li1   
05CF                             ; Take line n (in HL) out: copy everything after it down over it.
05CF   CD 50 06     DEL:      CALL   find   
05D2   54                     LD   D,H   
05D3   5D                     LD   E,L   
05D4   CD 5E 06               CALL   nxl   ; HL -> the next line
05D7   7E           DE1:      LD   A,(HL)   
05D8   12                     LD   (DE),A   
05D9   23                     INC   HL   
05DA   13                     INC   DE   
05DB   B7                     OR   A   
05DC   20 F9                  JR   NZ,de1   ; and fall into the editor
05DE   31 FC 08     EDIT:     LD   SP,DSTOP   
05E1   AF                     XOR   A   ; a key that the break check held while the
05E2   32 7A 09               LD   (KEYBUF),A   ;   program ran is let go (the Ctrl-C that
05E5                          ENDIF      ;   stopped it, for one)
05E5                          IF   EDGEN   
                              LD   D,0FDh   ; 125 characters at most
05E5                          ENDIF      
05E5                          IF   EDITOR*CPM   
05E5   3E 7D                  LD   A,125   
05E7                          ENDIF      
05E7                          IF   EDITOR   
05E7   CD F1 02               CALL   rdline   ; HL -> the CR that ended the line
05EA   2C                     INC   L   
05EB   36 0A                  LD   (HL),10   ; a LF after it,
05ED   2D                     DEC   L   
05EE   CD 68 06               CALL   prl   ; (print the CR LF: a new line)
05F1   36 00                  LD   (HL),0   ;   and a NUL after that
05F3   E5                     PUSH   HL   ; the end of what was typed
05F4   01 80 09               LD   BC,LINEBUF   
05F7   0A                     LD   A,(BC)   
05F8   FE 2D                  CP   "-"   
05FA   28 A3                  JR   Z,list   
05FC   CD 2C 03               CALL   rdnum   ; HL = the number it starts with, BC -> after
05FF   79                     LD   A,C   ; C is still 80h if there was no number:
0600   87                     ADD   A,A   ;   only then is twice it 0
0601   28 0C                  JR   Z,st0   ; no number: run the line where it is
0603   0A                     LD   A,(BC)   
0604   D6 0D                  SUB   13   
0606   20 22                  JR   NZ,ins   ; text follows the number
0608   B4                     OR   H   ; the number alone:
0609   B5                     OR   L   
060A   20 C3                  JR   NZ,del   ;   not 0: take that line out
060C   01 00 0A               LD   BC,PROG   ;   0: run the program
060F                             ; st0: start running at BC. The heap starts after the stored program's NUL.
060F   E1           ST0:      POP   HL   ; (the end of what was typed: the stack is empty)
0610   AF                     XOR   A   
0611   67                     LD   H,A   ; no key is held, and the break key is on: a
0612   6F                     LD   L,A   ;   key left over from the last run is let go
0613   22 7A 09               LD   (KEYBUF),HL   
0616   21 00 0A               LD   HL,PROG   
0619   BE           ST1:      CP   (HL)   
061A   23                     INC   HL   
061B   20 FC                  JR   NZ,st1   
061D   22 7C 09               LD   (HEAP),HL   
0620                          ENDIF      
0620                          IF   EDITOR*CHECKED   
0620   E7                     RST   20h   ; minus the heap"s first address: "_' may not
0621   22 38 09               LD   (NPEND),HL   ;   release below it
0624                          ENDIF      
0624                          IF   EDITOR   
0624   D9                     EXX      
0625   21 E0 07               LD   HL,RSTOP   ; the return stack is empty
0628   D9                     EXX      
0629   F7                     RST   30h   ; (its return address is thrown away)
062A                             ; Put the typed text in as line n (in HL): open a gap of its length there,
062A                             ; CR and LF included, and copy it in.
062A   CD 50 06     INS:      CALL   find   ; HL -> where it goes
062D   03                     INC   BC   ; step over the one character after the number
062E   D1                     POP   DE   ; the end of what was typed
062F   7B                     LD   A,E   
0630   91                     SUB   C   ; A = the length of the text, with its CR LF
0631   C5                     PUSH   BC   ; the text
0632   4F                     LD   C,A   
0633   06 00                  LD   B,0   
0635   C5                     PUSH   BC   ; its length
0636   54                     LD   D,H   
0637   5D                     LD   E,L   ; DE = where it goes
0638   AF                     XOR   A   
0639   4F                     LD   C,A   ; BC = 0: CPIR looks as far as it needs to
063A   ED B1                  CPIR      ; HL -> one past the program's NUL
063C   ED 52                  SBC   HL,DE   ; the number of bytes to move up, NUL included
063E   44                     LD   B,H   
063F   4D                     LD   C,L   
0640   19                     ADD   HL,DE   
0641   2B                     DEC   HL   ; HL -> the NUL
0642   EB                     EX   DE,HL   
0643   E3                     EX   (SP),HL   ; HL = the length; where it goes is kept
0644   E5                     PUSH   HL   
0645   19                     ADD   HL,DE   ; the NUL's new place
0646   EB                     EX   DE,HL   
0647   ED B8                  LDDR      ; move the rest of the program up
0649   C1                     POP   BC   ; the length
064A   D1                     POP   DE   ; where it goes
064B   E1                     POP   HL   ; the text
064C   ED B0                  LDIR      
064E   18 8E                  JR   edit   
0650                             ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
0650                             ; of the text if there are fewer lines (or the number is 0). Keeps BC.
0650   EB           FIND:     EX   DE,HL   
0651   21 00 0A               LD   HL,PROG   
0654   1B           FI1:      DEC   DE   
0655   7A                     LD   A,D   
0656   B3                     OR   E   
0657   C8                     RET   Z   
0658   CD 5E 06               CALL   nxl   
065B   20 F7                  JR   NZ,fi1   
065D   C9                     RET      
065E                             ; nxl: step HL over one line, to just past its LF (and return not-zero), or
065E                             ; stop at the NUL that ends the text (and return zero).
065E   7E           NXL:      LD   A,(HL)   
065F   B7                     OR   A   
0660   C8                     RET   Z   
0661   23                     INC   HL   
0662   FE 0A                  CP   10   
0664   20 F8                  JR   NZ,nxl   
0666   B7                     OR   A   
0667   C9                     RET      
0668                             ; prl: print the line at HL, to its LF; HL -> just past it.
0668   7E           PRL:      LD   A,(HL)   
0669   EF                     RST   28h   
066A   7E                     LD   A,(HL)   
066B   23                     INC   HL   
066C   FE 0A                  CP   10   
066E   20 F8                  JR   NZ,prl   
0670   C9                     RET      
0671                          ENDIF      
0671                             ; =============================================================================
0671                             ;  CP/M startup (the generic build starts at address 0: see st0)
0671                             ; =============================================================================
0671                          IF   CPM   
0671                             ; The RAM pages follow the image; the heap may grow to the BDOS.
0671                START:       
0671                          ENDIF      
0671                          IF   CPM*CHECKED   
0671                             ; Clear the lower half of the letter page: every variable starts at
0671                             ; 0, every word cell holds 0000h, the address an undefined word is
0671                             ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
0671                             ; is held back.
0671   21 00 09               LD   HL,LET   
0674   AF                     XOR   A   
0675   77           INI1:     LD   (HL),A   
0676   2C                     INC   L   
0677   F2 75 06               JP   P,ini1   ; +00h to +7Fh
067A                          ENDIF      
067A                          IF   CPM   
067A   21 08 01               LD   HL,vecs   ; the RST routines go down into page zero
067D   11 08 00               LD   DE,0008h   
0680   01 2C 00               LD   BC,vecend-vecs   
0683   ED B0                  LDIR      
0685   11 5C 00               LD   DE,005Ch   ; open the file named on the command line
0688   0E 0F                  LD   C,15   ; (no such file: the first read fails too,
068A   CD 05 00               CALL   BDOS   ;   and the program is empty)
068D   11 00 0A               LD   DE,PROG   
0690   D5           LD1:      PUSH   DE   
0691   0E 1A                  LD   C,26   ; set the DMA address
0693   CD 05 00               CALL   BDOS   
0696   11 5C 00               LD   DE,005Ch   
0699   0E 14                  LD   C,20   ; read the next 128 bytes
069B   CD 05 00               CALL   BDOS   
069E   E1                     POP   HL   ; HL = the address this record went to
069F   B7                     OR   A   
06A0   20 07                  JR   NZ,ld2   
06A2   11 80 00               LD   DE,128   
06A5   19                     ADD   HL,DE   
06A6   EB                     EX   DE,HL   
06A7   18 E7                  JR   ld1   
06A9                LD2:         
06A9                          ENDIF      
06A9                          IF   CPM*(1-EDITOR)   
                              LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
                              JP   st2   
06A9                          ENDIF      
06A9                          IF   CPM*EDITOR   
06A9                             ; The editor wants the text to end where the file's text ends: at
06A9                             ; the first ^Z (1Ah), which pads a text file's last record. One more
06A9                             ; goes after the last record, so the search always stops. And every
06A9                             ; line must end in LF: a last line without one is given a CR LF.
06A9   36 1A                  LD   (HL),1Ah   
06AB   21 FF 09               LD   HL,PROG-1   
06AE   3E 0A                  LD   A,10   ; (a file with no text needs nothing added)
06B0   23           TR1:      INC   HL   
06B1   5F                     LD   E,A   ; E = the character before this one
06B2   7E                     LD   A,(HL)   
06B3   FE 1A                  CP   1Ah   
06B5   20 F9                  JR   NZ,tr1   
06B7   7B                     LD   A,E   
06B8   FE 0A                  CP   10   
06BA   28 06                  JR   Z,tr2   
06BC   36 0D                  LD   (HL),13   
06BE   23                     INC   HL   
06BF   36 0A                  LD   (HL),10   
06C1   23                     INC   HL   
06C2   36 00        TR2:      LD   (HL),0   
06C4   C3 DE 05               JP   edit   
06C7                          ENDIF      
06C7                          IF   CPM   
06C7                             ; RAM pages, after the image
06C7                RSPAGE:   EQU   (imgend + 255) / 256   
06C7                DSPAGE:   EQU   RSPAGE + 1   
06C7                LETPAGE:   EQU   RSPAGE + 2   
06C7                PROG:     EQU   LETPAGE*256 + 256   
06C7                          ENDIF      
06C7                IMGEND:      


