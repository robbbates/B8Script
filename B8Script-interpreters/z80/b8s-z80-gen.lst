                    RDLINE:      
01D3                          ENDIF      
01D3                          IF   CPM   
                              LD   (LBHDR),A   
                              LD   DE,LBHDR   
                              LD   A,10   
                              CALL   bdosx   
                              LD   HL,LBHDR+1   
                              LD   A,(HL)   ; the count typed (0-127)
                              INC   L   ; HL = LINEBUF, whose low byte is 80h:
                              ADD   A,L   ;   adding the count to L can't carry
                              LD   L,A   
                              LD   (HL),13   
01D3                          ENDIF      
01D3                          IF   CPM*(1-EDITOR)   
                              LD   L,LINEBUF & 0FFh   
                              RST   30h   
01D3                          ENDIF      
01D3                          IF   CPM*EDITOR   
                              RET      
01D3                          ENDIF      
01D3                          IFN   CPM   
01D3                             ; Generic: Backspace takes the last character back (and is echoed as
01D3                             ; it is), CR ends (stored, not echoed), every other key is stored and
01D3                             ; echoed until the line is full. The line buffer starts at offset 80h
01D3                             ; of its page, so L alone is the place in the line: D holds the L of
01D3                             ; a full line.
01D3                          ENDIF      
01D3                          IFN   CPM   
01D3   11 7F 00     LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
01D6   19                     ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
01D7   9F                     SBC   A,A   
01D8   A5                     AND   L   ; (0 for a count that is too big)
01D9   2F                     CPL      
01DA   57                     LD   D,A   ; D = the L of a full line: 80h + count, FFh
01DB                          ENDIF      ;   at most
01DB                          IF   EDGEN   
                              CALL   rdline   ; (the editor calls rdline too)
                              LD   L,LINEBUF & 0FFh   
                              RST   30h   
                                 ; rdline: read a line that is full when L reaches D; HL -> the CR that ends it
                    RDLINE:      
01DB                          ENDIF      
01DB                          IFN   CPM   
01DB   21 80 82               LD   HL,LINEBUF   
01DE   CD 06 FF     LN2:      CALL   getk   
01E1   28 FB                  JR   Z,ln2   
01E3   FE 0D                  CP   13   
01E5   28 16                  JR   Z,ln5   
01E7   FE 08                  CP   8   
01E9   28 0B                  JR   Z,ln4   
01EB   5F                     LD   E,A   
01EC   7D                     LD   A,L   
01ED   BA                     CP   D   
01EE   28 EE                  JR   Z,ln2   ; full
01F0   73                     LD   (HL),E   
01F1   2C                     INC   L   
01F2   7B                     LD   A,E   
01F3   EF           LN3:      RST   28h   
01F4   18 E8                  JR   ln2   
01F6   2D           LN4:      DEC   L   ; Backspace: one back, and echo it,
01F7   FA F3 01               JP   M,ln3   ;   unless the line was empty (L left the
01FA   2C                     INC   L   ;   upper half of the page)
01FB   18 E1                  JR   ln2   
01FD   77           LN5:      LD   (HL),A   ; the CR
01FE                          ENDIF      
01FE                          IF   (1-CPM)*(1-EDITOR)   
