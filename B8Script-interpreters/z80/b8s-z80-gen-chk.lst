0225                             ;  More routines (no handler starts past this point)
0225                             ; =============================================================================
0225                          IF   CHECKED   
0225                             ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
0225                             ; "$", and the texts of the report). A NUL first is an error: Q.
0225   7E           PRSTR:    LD   A,(HL)   
0226   23                     INC   HL   
0227   FE 22                  CP   22h   
0229   C8                     RET   Z   
022A   B7                     OR   A   
022B   28 1F                  JR   Z,e_dollar   
022D   FE 2F                  CP   "/"   
022F   20 0C                  JR   NZ,prs1   
0231   7E                     LD   A,(HL)   
0232   23                     INC   HL   
0233   FE 60                  CP   60h   
0235   38 04                  JR   C,prs0   
0237   FE 7F                  CP   7Fh   
0239   38 1A                  JR   C,pesc   
023B   E6 BF        PRS0:     AND   0BFh   
023D   EF           PRS1:     RST   28h   
023E   18 E5                  JR   prstr   
0240                PRLOOP:   EQU   prstr   ; (where the escapes go back to)
0240                PRAGAIN:   EQU   hp1   ; (and where /~ goes back to)
0240                             ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
0240                             ; pnl: the same, on a new line.
0240   3E 0D        PNL:      LD   A,13   
0242   EF                     RST   28h   
0243   3E 0A                  LD   A,10   
0245   EF                     RST   28h   
