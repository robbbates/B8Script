E326                          IF   SBASEU   
E326                             ; a-z, in the unchecked QK builds: a variable followed by "@" or "!" is
E326                             ; fetched or stored in the same step (x@ is the commonest pair in most
E326                             ; programs). A checked build checks the stacks between the two, so it keeps
E326                             ; them apart. (pvar calls lowp, which only pushes.)
E326   0A           LOWQ:     ASL      
E327   85 04                  STA   T0   ; the cell's offset in the letter page
E329   A0 00                  LDY   #0   
E32B   B1 00                  LDA   (IP),Y   
E32D   C9 40                  CMP   #"@"   
E32F   F0 0B                  BEQ   lwf   
E331   C9 21                  CMP   #"!"   
E333   F0 19                  BEQ   lws   
E335   A5 04                  LDA   T0   
E337   A0 04                  LDY   #>LET   
E339   4C 2E E5               JMP   pushay   ; the address
E33C   20 AB E5     LWF:      JSR   incip   ; x@: TOS = the cell's value
E33F   A4 04                  LDY   T0   
E341   CA                     DEX      
E342   CA                     DEX      
E343   B9 00 04               LDA   LET,Y   
E346   95 00                  STA   0,X   
E348   B9 01 04               LDA   LET+1,Y   
E34B   95 01                  STA   1,X   
E34D   60                     RTS      
E34E   20 AB E5     LWS:      JSR   incip   ; x!: the cell = TOS, and it is dropped
E351   A4 04                  LDY   T0   
E353   B5 00                  LDA   0,X   
E355   99 00 04               STA   LET,Y   
E358   B5 01                  LDA   1,X   
E35A   99 01 04               STA   LET+1,Y   
E35D   E8                     INX      
E35E   E8                     INX      
E35F   60                     RTS      
E360                          ENDIF      
E360                          IF   QK   
E360                             ; The skip cache. Nearly every skip is one that has happened before (a loop
E360                             ; skips the same false block on every pass), so the first scan from each
E360                             ; place is remembered: 64 entries of 00bbc3RhcnQsIHRoZSBjbG9zZXIncyBhZGRyZXNz, in CPAGE,
E360                             ; found by the start's low byte times 4. Only skips that start in the
E360                             ; program text are kept (the line buffer changes); the cache is emptied when
E360                             ; the program starts. A program that changes its own text while it runs is
E360                             ; not looked after. A miss writes the start into its entry at once, and
E360                             ; keeps the entry's place in the scratch under the top cell, $FE,X (1, which
E360                             ; no entry has, for a skip that is not kept), so that the end can go in when
E360                             ; the scan finds it. A scan that fails ends the program, and the next run
E360                             ; empties the cache, so a half-written entry is never found. (The checked
E360                             ; build: A holds the wrong closer on the way in, as at the checked skip above.)
E360                SKIP:        
E360                          ENDIF      
E360                          IF   CHECKED*QK   
                              STA   T0   
E360                          ENDIF      
E360                          IF   QK   
E360   A0 01                  LDY   #1   ; (no entry)
E362   A5 01                  LDA   IP+1   
E364   C9 05                  CMP   #>PROG   
E366   90 2E                  BCC   sks   ; below the program text: no cache
E368   A5 00                  LDA   IP   
E36A   0A                     ASL      
E36B   0A                     ASL      
E36C   A8                     TAY      ; Y -> the entry
E36D   A5 00                  LDA   IP   
E36F   D9 00 02               CMP   CPAGE*256,Y   
E372   D0 18                  BNE   skm   
E374   A5 01                  LDA   IP+1   
E376   D9 01 02               CMP   CPAGE*256+1,Y   
E379   D0 11                  BNE   skm   
E37B   B9 02 02               LDA   CPAGE*256+2,Y   ; a hit: the IP goes to the closer, which is
E37E   85 00                  STA   IP   ;   read
E380   B9 03 02               LDA   CPAGE*256+3,Y   
E383   85 01                  STA   IP+1   
E385   A0 00                  LDY   #0   
E387   B1 00                  LDA   (IP),Y   
E389   4C AB E5               JMP   incip   
E38C   A5 00        SKM:      LDA   IP   ; a miss: the entry's start now, its end when
E38E   99 00 02               STA   CPAGE*256,Y   ;   the scan has found it
E391   A5 01                  LDA   IP+1   
E393   99 01 02               STA   CPAGE*256+1,Y   
E396   94 FE        SKS:      STY   0FEh,X   ; the entry, or 1 for none
E398   A0 00                  LDY   #0   
E39A   84 06                  STY   T2   ; depth
E39C                             ; The scan reads at IP+Y. Most characters are nothing to it, and two range
E39C                             ; tests rule them out: * to Z, and ^ and up. Only NUL " ( ) [ ] count.
E39C   B1 00        SQ1:      LDA   (IP),Y   
E39E   C8                     INY      
E39F   F0 1D                  BEQ   sqw   
E3A1   C9 5E        SQ2:      CMP   #5Eh   
E3A3   B0 F7                  BCS   sq1   ; ^ _ ` a-z 00bbIHwg ~ and up: nothing
E3A5   C9 5B                  CMP   #5Bh   
E3A7   B0 28                  BCS   sqb   ; [ \ ]
E3A9   C9 2A                  CMP   #2Ah   
E3AB   B0 EF                  BCS   sq1   ; * to Z: nothing
E3AD   C9 28                  CMP   #28h   
E3AF   F0 1B                  BEQ   sqo   ; (
E3B1   B0 24                  BCS   sqc   ; )
E3B3   C9 22                  CMP   #22h   
E3B5   F0 0B                  BEQ   sqq   ; a string
E3B7   C9 01                  CMP   #1   
E3B9   B0 E1                  BCS   sq1   ; the rest below "(": nothing
E3BB                          ENDIF      
E3BB                          IF   QK*(1-CHECKED)   
E3BB   4C 09 FF               JMP   EXIT   ; NUL: the end of the program
E3BE                          ENDIF      
