                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_CLOSE:      ; )
                              LD   A,D   
                              OR   E   
                              POP   HL   
                              JR   Z,fs_cl0   
                              LD   C,(IY+0)   ; the block start, read where it is
                              LD   B,(IY+1)   
                              PUSH   HL   
                              LD   HL,PCNT   
                              DEC   (HL)   
                              POP   HL   
                              CALL   Z,pollk   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
