                              DB   "C"   
052E                          ENDIF      
052E                          IF   EDITOR   
052E   20 32 30 32 36 2D 31 31 2D 32 31 22 DB   " 2026-11-21",22h   
053A   CD E0 02               CALL   pstk   ; both stacks
053D   21 00 83               LD   HL,PROG   
0540   11 00 00               LD   DE,0   
0543   7E           CV1:      LD   A,(HL)   ; count the lines, and find the end
0544   B7                     OR   A   
0545   28 08                  JR   Z,cv2   
0547   23                     INC   HL   
0548   FE 0A                  CP   10   
054A   20 F7                  JR   NZ,cv1   
054C   13                     INC   DE   
054D   18 F4                  JR   cv1   
054F   E5           CV2:      PUSH   HL   ; the NUL
0550   D5                     PUSH   DE   ; the lines
0551   11 00 7D               LD   DE,(0-PROG)&0FFFFh   
0554   19                     ADD   HL,DE   
0555   CD 4B 03               CALL   pnl   
0558   50 72 6F 67 20 22      DB   "Prog ",22h   
