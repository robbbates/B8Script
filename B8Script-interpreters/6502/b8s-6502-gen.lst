0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the 6502 (NMOS opcodes only)
0000                             ;  Spec: docs/b8script.md (2026-10-09) plus the 2026-11-20 changes:
0000                             ;        [x stores in a variable, "[ " pushes an anonymous block, any other
0000                             ;        character after [ is an error, the heap pointer lives at z10+.
0000                             ;        The string escape is "/" (it was ">").
0000                             ;  Design follows the Z80 interpreter; see b8s-z80.asm for the common ideas.
0000                             ; 
0000                             ;  Two builds, set in the two EQU lines below:
0000                             ;    CPM      always 0 (there is no CP/M here; the line exists for build.sh)
0000                             ;    CHECKED  0 = no checks (spec: "B8Script checks nothing")
0000                             ;             1 = stops on stack overrun, Ctrl-C, heap past the limit, a store
0000                             ;                 outside the program's own space, and a bad character after [,
0000                             ;                 printing a letter and the place, like  S @ 245
0000                             ; 
0000                             ;  Assembler: asm80, C6502 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   0   ; always 0: no CP/M build
0000                CHECKED:   EQU   0   ; 1 = checked build
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Registers and zero page
0000                             ; 
0000                             ;    IP      zero-page pointer to the next program character (16 bits)
0000                             ;    TL/TH   the top data-stack cell (TOS) lives in zero page, not in memory
0000                             ;    X       data-stack index. The stack is two byte-planes, grows down, and
0000                             ;            holds everything under TOS: NOS is DSL,X (low) and DSH,X (high).
0000                             ;            The stack never leaves its two pages because X is 8 bits.
0000                             ;    S       the hardware stack is the RETURN stack: a word call or "(" pushes
0000                             ;            the reading position (high byte first, then low) and "]" or ")"
0000                             ;            pulls it. 100 entries (200 bytes) fit with room to spare.
0000                             ;    Y, A    scratch. Y is 0 after peek/getc, and the zero-page indirect reads
0000                             ;            (IP),Y rely on that.
0000                             ; 
0000                             ;  Dispatch: step is called with JSR, so a handler ends with a plain RTS and
0000                             ;  lands on "JMP next" in the loop. Punctuation goes through PTAB with the
0000                             ;  RTS trick (push handler-1, RTS). Handlers that use the return stack ( ( ) \
0000                             ;  ] 00bbIA== and word calls ) first pull the 2-byte JSR frame off (PLA PLA) and end
0000                             ;  with JMP next instead.
0000                             ; 
0000                             ;  Machine-code contract (the grave): the code at TOS is entered as a
0000                             ;  subroutine, by JMP (T0) with the loop's return address on the hardware
0000                             ;  stack, so it ends with RTS (60h, which the hex loader appends). On entry
0000                             ;  TL/TH ($02/$03) hold the new TOS (the address is already consumed) and X is
0000                             ;  the data-stack index: NOS is $0200,X (low) and $0300,X (high). To push:
0000                             ;  DEX, store TL/TH at DSL,X/DSH,X, then set TL/TH. To drop: load TL/TH from
0000                             ;  DSL,X/DSH,X and INX. The code may change A, Y, X (it is the stack index, so
0000                             ;  it must stay consistent on return) and zero page $04-$06 and $08-$0B; it
0000                             ;  must keep IP ($00/$01) and the hardware stack balanced. On return TL/TH are
0000                             ;  the TOS. Zero page $0C-$0F is free for the code's own use.
0000                             ; -----------------------------------------------------------------------------
0000                IP:       EQU   00h   ; 00-01 reading position
0000                TL:       EQU   02h   ; TOS low
0000                TH:       EQU   03h   ; TOS high
0000                T0:       EQU   04h   ; scratch
0000                T1:       EQU   05h   
0000                T2:       EQU   06h   
0000                D0:       EQU   08h   ; divisor (division, number printing)
0000                D1:       EQU   09h   
0000                R0:       EQU   0Ah   ; remainder
0000                R1:       EQU   0Bh   
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map
0000                             ; 
0000                             ;    0000-00FF  zero page (above)
0000                             ;    0100-01FF  hardware stack = return stack, S starts at FF
0000                             ;    0200       DSL  data stack, low bytes   (X = FC when empty: 252 cells)
0000                             ;    0300       DSH  data stack, high bytes
0000                             ;    0400       LET  letter cells: A..Z at +00..+33, a..z at +40..+73 (a word
0000                             ;               cell is 64 bytes below its variable), heap pointer at +7C
0000                             ;               (= z10+), KEYBUF at +34, the -n? line buffer at +80..+FF
0000                             ;    0500       PROG the program text, NUL-terminated; the heap follows
0000                             ;    E000       the interpreter (ROM)
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the page range LETPAGE..HEAPLIM-1.
0000                             ; -----------------------------------------------------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The Z flag must match A (it does
0000                             ;   if the routine ends with LDA / RTS).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                             ;   KEY and CONOUT must preserve X and Y.
0000                DSL:      EQU   0200h   
0000                DSH:      EQU   0300h   
0000                LETPAGE:   EQU   04h   
0000                LET:      EQU   LETPAGE*256   
0000                PROG:     EQU   0500h   ; where the loader puts the program text
0000                PROG1:    EQU   PROG+1   
0000                HEAPLIM:   EQU   0E0h   ; the heap must stay below E000h (a page)
0000                HEAP:     EQU   LET+7Ch   ; z10+, the heap pointer
0000                KEYBUF:   EQU   LET+34h   ; a key held back by the break check
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                DSE:      EQU   0FCh   ; X when the data stack is empty
0000                RSLIM:    EQU   20h   ; lowest S allowed (checked build)
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms; tune it
E000                          .ORG   0E000h   
E000                             ; =============================================================================
E000                             ;  Startup: find the NUL, the heap starts after it
E000                             ; =============================================================================
E000   A2 FF        START:    LDX   #0FFh   
E002   9A                     TXS      ; return stack empty
E003   A9 00                  LDA   #<PROG   
E005   85 00                  STA   IP   
E007   A9 05                  LDA   #>PROG   
E009   85 01                  STA   IP+1   
E00B   20 4D E1     ST1:      JSR   getc   
E00E   D0 FB                  BNE   st1   ; IP ends just past the NUL
E010   A5 00                  LDA   IP   
E012   8D 7C 04               STA   HEAP   
E015   A5 01                  LDA   IP+1   
E017   8D 7D 04               STA   HEAP+1   
E01A                          IF   CHECKED   
                              LDA   #0   
                              STA   KEYBUF   
E01A                          ENDIF      
E01A   A9 00                  LDA   #<PROG   
E01C   85 00                  STA   IP   
E01E   A9 05                  LDA   #>PROG   
E020   85 01                  STA   IP+1   
E022   A2 FC                  LDX   #DSE   
E024                             ; =============================================================================
E024                             ;  The inner loop
E024                             ; =============================================================================
E024                NEXT:        
E024                          IF   CHECKED   
                                 ; Both stacks are checked once per character. The data stack has
                                 ; overrun when X is above DSE (an overflow wraps X to FF, an underflow
                                 ; moves it up; no handler moves X by more than 2). The return stack
                                 ; has when S is below RSLIM (an underflow wraps S to 00-03).
                              CPX   #DSE+1   
                              BCS   e_stack   
                              TXA      ; TSX trashes X: keep it in A
                              TSX      
                              CPX   #RSLIM   
                              TAX      ; TAX leaves the carry alone
                              BCC   e_rstack   
E024                          ENDIF      
E024   20 2A E0               JSR   step   
E027   4C 24 E0               JMP   next   
E02A                             ; step: read one character and sort it by range.
E02A                             ;    00h          end of program
E02A                             ;    01h-20h, 7Fh-FFh   ignored
E02A                             ;    30h-39h      digit: read a whole number
E02A                             ;    41h-5Ah      A-Z: call the word in that letter's cell
E02A                             ;    61h-7Ah      a-z: push the address of that letter's cell
E02A                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
E02A   20 4D E1     STEP:     JSR   getc   ; flags follow A
E02D   F0 3A                  BEQ   endprog   
E02F   38                     SEC      
E030   E9 21                  SBC   #21h   ; A = c - 21h
E032   90 34                  BCC   ign   ; 01h-20h
E034   C9 0F                  CMP   #0Fh   
E036   90 26                  BCC   punct   ; 21h-2Fh: index 0-14
E038   E9 0F                  SBC   #0Fh   ; (carry set) A = c - 30h
E03A   C9 0A                  CMP   #10   
E03C   90 2E                  BCC   digit   
E03E   C9 11                  CMP   #11h   
E040   B0 04                  BCS   ab40   
E042   69 05                  ADC   #5   ; (carry clear) 3Ah-40h: index 15-21
E044   90 18                  BCC   punct   ; always
E046   E9 11        AB40:     SBC   #11h   ; A = c - 41h
E048   C9 1A                  CMP   #1Ah   
E04A   90 6A                  BCC   upper   ; 41h-5Ah
E04C   C9 20                  CMP   #20h   
E04E   B0 04                  BCS   ab60   
E050   E9 03                  SBC   #3   ; (carry clear: subtracts 4) 5Bh-60h: 22-27
E052   B0 0A                  BCS   punct   ; always
E054   C9 3A        AB60:     CMP   #3Ah   
E056   90 52                  BCC   lower   ; 61h-7Ah: A = 20h-39h
E058   C9 3E                  CMP   #3Eh   
E05A   B0 0C                  BCS   ign   ; 7Fh-FFh
E05C   E9 1D                  SBC   #1Dh   ; (carry clear: subtracts 1Eh) 7Bh-7Eh: 28-31
E05E   0A           PUNCT:    ASL      
E05F   A8                     TAY      
E060   B9 09 E1               LDA   PTAB+1,Y   
E063   48                     PHA      
E064   B9 08 E1               LDA   PTAB,Y   
E067   48                     PHA      
E068   60           IGN:      RTS      ; RTS trick: goes to the handler. Reached
E069                             ; directly, it just ends an ignored character.
E069   4C 09 FF     ENDPROG:   JMP   EXIT   
E06C                          IF   CHECKED   
                    E_STACK:   LDA   #"S"   ; data stack over or under
                              DB   2Ch   ; (BIT abs: hides the next instruction)
                    E_RSTACK:   LDA   #"R"   ; return stack over or under
                              JMP   error   
E06C                          ENDIF      
E06C                             ; Digits: the first one is in A; read the rest of the number.
E06C   A8           DIGIT:    TAY      
E06D   20 65 E1               JSR   push   
E070   84 02                  STY   TL   
E072   A9 00                  LDA   #0   
E074   85 03                  STA   TH   
E076   F0 27                  BEQ   rdnum   ; always: A = 0
E078                             ; rdnum: TOS = TOS*10 + digit for each digit at IP. Wraps at 16 bits. The
E078                             ; test is at the bottom so the loop closes with a branch.
E078   20 50 E1     RD1:      JSR   incip   ; (keeps A = the digit)
E07B   06 02                  ASL   TL   
E07D   26 03                  ROL   TH   ; x2
E07F   18                     CLC      
E080   65 02                  ADC   TL   
E082   85 04                  STA   T0   
E084   A5 03                  LDA   TH   
E086   69 00                  ADC   #0   
E088   85 05                  STA   T1   ; T = x2 + digit
E08A   06 02                  ASL   TL   
E08C   26 03                  ROL   TH   
E08E   06 02                  ASL   TL   
E090   26 03                  ROL   TH   ; x8
E092   18                     CLC      
E093   A5 02                  LDA   TL   
E095   65 04                  ADC   T0   
E097   85 02                  STA   TL   
E099   A5 03                  LDA   TH   
E09B   65 05                  ADC   T1   
E09D   85 03                  STA   TH   ; x8 + x2 + digit
E09F   20 48 E1     RDNUM:    JSR   peek   
E0A2   38                     SEC      
E0A3   E9 30                  SBC   #"0"   
E0A5   C9 0A                  CMP   #10   
E0A7   90 CF                  BCC   rd1   
E0A9   60                     RTS      
E0AA                             ; a-z: push the cell's address (the cell is the variable)
E0AA   0A           LOWER:    ASL      
E0AB   A8                     TAY      
E0AC   20 65 E1               JSR   push   
E0AF   84 02                  STY   TL   
E0B1   A9 04                  LDA   #>LET   
E0B3   85 03                  STA   TH   
E0B5   60                     RTS      
E0B6                             ; A-Z: call the word. The return address (the IP after the letter) goes on
E0B6                             ; the return stack, and the IP becomes the address in the letter's cell.
E0B6   0A           UPPER:    ASL      
E0B7   A8                     TAY      
E0B8   68                     PLA      
E0B9   68                     PLA      ; drop the step frame
E0BA   A5 01                  LDA   IP+1   
E0BC   48                     PHA      
E0BD   A5 00                  LDA   IP   
E0BF   48                     PHA      
E0C0   B9 00 04               LDA   LET,Y   
E0C3   85 00                  STA   IP   
E0C5   B9 01 04               LDA   LET+1,Y   
E0C8   85 01                  STA   IP+1   
E0CA   4C 24 E0               JMP   next   
E0CD                             ; skip: read past text to the closer at this level, and return it in A.
E0CD                             ; Brackets of both kinds count together; strings are stepped over whole. A
E0CD                             ; NUL first ends the program.
E0CD   A9 00        SKIP:     LDA   #0   
E0CF   85 06                  STA   T2   ; depth
E0D1   20 4D E1     SK1:      JSR   getc   
E0D4   F0 93                  BEQ   endprog   
E0D6   C9 22                  CMP   #22h   
E0D8   D0 05                  BNE   sk2   
E0DA   20 86 E3               JSR   skipstr   
E0DD   F0 F2                  BEQ   sk1   ; skipstr ends with the zero flag set
E0DF   C9 28        SK2:      CMP   #"("   
E0E1   F0 11                  BEQ   sk3   
E0E3   C9 5B                  CMP   #"["   
E0E5   F0 0D                  BEQ   sk3   
E0E7   C9 29                  CMP   #")"   
E0E9   F0 04                  BEQ   sk4   
E0EB   C9 5D                  CMP   #"]"   
E0ED   D0 E2                  BNE   sk1   
E0EF   C6 06        SK4:      DEC   T2   
E0F1   10 DE                  BPL   sk1   
E0F3   60                     RTS      ; the closer at this level
E0F4   E6 06        SK3:      INC   T2   
E0F6   D0 D9                  BNE   sk1   
E0F8                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
E0F8                             ; the matching ")".
E0F8   20 23 E3     H_OPEN:   JSR   flag   
E0FB   F0 D0                  BEQ   skip   
E0FD   68                     PLA      
E0FE   68                     PLA      
E0FF   A5 01                  LDA   IP+1   
E101   48                     PHA      
E102   A5 00                  LDA   IP   
E104   48                     PHA      
E105   4C 24 E0               JMP   next   
E108                             ; =============================================================================
E108                             ;  Dispatch table: one handler per punctuation character, in code order.
E108                             ;  Entries are handler-1 for the RTS trick.
E108                             ; =============================================================================
E108   70 E1        PTAB:     DW   h_store-1   ; !
E10A   82 E3                  DW   h_str-1   ; "
E10C   C6 E3                  DW   h_num-1   ; #
E10E   A1 E3                  DW   h_print-1   ; $
E110   10 E2                  DW   h_swap-1   ; %
E112   A7 E1                  DW   h_and-1   ; &
E114   BE E3                  DW   h_emit-1   ; '
E116   F7 E0                  DW   h_open-1   ; (
E118   2C E3                  DW   h_close-1   ; )
E11A   E1 E1                  DW   h_mul-1   ; *
E11C   BA E2                  DW   h_add-1   ; +
E11E   01 E3                  DW   h_cfetch-1   ; ,
E120   A5 E2                  DW   h_sub-1   ; -
E122   77 E1                  DW   h_cstore-1   ; .
E124   25 E2                  DW   h_div-1   ; /
E126   64 E1                  DW   push-1   ; :
E128   7F E1                  DW   drop-1   ; ;
E12A   CE E2                  DW   h_lt-1   ; <
E12C   E1 E2                  DW   h_eq-1   ; =
E12E   CB E2                  DW   h_gt-1   ; >
E130   F2 E3                  DW   h_key-1   ; ?
E132   F3 E2                  DW   h_fetch-1   ; @
E134   5F E3                  DW   h_def-1   ; [
E136   40 E3                  DW   h_break-1   ; \
E138   54 E3                  DW   h_ret-1   ; ]
E13A   C5 E1                  DW   h_xor-1   ; ^
E13C   0A E3                  DW   h_alloc-1   ; _
E13E   53 E4                  DW   h_grave-1   ; `
E140   8B E1                  DW   h_tor-1   ; {
E142   B6 E1                  DW   h_or-1   ; |
E144   99 E1                  DW   h_fromr-1   ; }
E146   D4 E1                  DW   h_not-1   ; ~
E148                             ; =============================================================================
E148                             ;  Reading the program
E148                             ;    peek: A = the character at IP, IP unchanged, Y = 0
E148                             ;    getc: the same, then IP moves on; flags follow A
E148                             ;    incip: IP moves on; keeps A, the carry and Y
E148                             ; =============================================================================
E148   A0 00        PEEK:     LDY   #0   
E14A   B1 00                  LDA   (IP),Y   
E14C   60                     RTS      
E14D   20 48 E1     GETC:     JSR   peek   
E150   E6 00        INCIP:    INC   IP   
E152   D0 02                  BNE   ic1   
E154   E6 01                  INC   IP+1   
E156   09 00        IC1:      ORA   #0   
E158   60                     RTS      
E159                             ; =============================================================================
E159                             ;  Stack
E159                             ; =============================================================================
E159   20 65 E1     PUSHIP:   JSR   push   ; push the reading position
E15C   A5 00                  LDA   IP   
E15E   85 02                  STA   TL   
E160   A5 01                  LDA   IP+1   
E162   85 03                  STA   TH   
E164   60                     RTS      
E165   CA           PUSH:     DEX      ; ":" and every push
E166   A5 02                  LDA   TL   
E168   9D 00 02               STA   DSL,X   
E16B   A5 03                  LDA   TH   
E16D   9D 00 03               STA   DSH,X   
E170   60                     RTS      
E171                             ; "!" ( n addr -- ) is "." plus the high byte. Both end in drop.
E171                H_STORE:      
E171                          IF   CHECKED   
                              LDA   TL   ; both bytes must be in the program's space:
                              CLC      ; check the page of addr+1
                              ADC   #1   
                              LDA   TH   
                              ADC   #0   
                              JSR   chkst   
E171                          ENDIF      
E171   BD 00 03               LDA   DSH,X   
E174   A0 01                  LDY   #1   
E176   91 02                  STA   (TL),Y   
E178                H_CSTORE:      ; "." ( c addr -- )
E178                          IF   CHECKED   
                              LDA   TH   
                              JSR   chkst   
E178                          ENDIF      
E178   BD 00 02               LDA   DSL,X   
E17B   A0 00                  LDY   #0   
E17D   91 02                  STA   (TL),Y   
E17F   E8                     INX      ; falls into drop
E180   BD 00 02     DROP:     LDA   DSL,X   ; ";" and every drop
E183   85 02                  STA   TL   
E185   BD 00 03               LDA   DSH,X   
E188   85 03                  STA   TH   
E18A   E8                     INX      
E18B   60                     RTS      
E18C                             ; "{" TOS to the return stack, "}" return stack to TOS
E18C   68           H_TOR:    PLA      
E18D   68                     PLA      
E18E   A5 03                  LDA   TH   
E190   48                     PHA      
E191   A5 02                  LDA   TL   
E193   48                     PHA      
E194   20 80 E1               JSR   drop   
E197   4C 24 E0               JMP   next   
E19A   68           H_FROMR:   PLA      
E19B   68                     PLA      
E19C   20 65 E1               JSR   push   
E19F   68                     PLA      
E1A0   85 02                  STA   TL   
E1A2   68                     PLA      
E1A3   85 03                  STA   TH   
E1A5   4C 24 E0               JMP   next   
E1A8                             ; =============================================================================
E1A8                             ;  Arithmetic and logic. Effects are ( NOS TOS -- result ).
E1A8                             ; =============================================================================
E1A8   BD 00 02     H_AND:    LDA   DSL,X   
E1AB   25 02                  AND   TL   
E1AD   85 02                  STA   TL   
E1AF   BD 00 03               LDA   DSH,X   
E1B2   25 03                  AND   TH   
E1B4   4C C8 E2               JMP   fin   
E1B7   BD 00 02     H_OR:     LDA   DSL,X   
E1BA   05 02                  ORA   TL   
E1BC   85 02                  STA   TL   
E1BE   BD 00 03               LDA   DSH,X   
E1C1   05 03                  ORA   TH   
E1C3   4C C8 E2               JMP   fin   
E1C6   BD 00 02     H_XOR:    LDA   DSL,X   
E1C9   45 02                  EOR   TL   
E1CB   85 02                  STA   TL   
E1CD   BD 00 03               LDA   DSH,X   
E1D0   45 03                  EOR   TH   
E1D2   4C C8 E2               JMP   fin   
E1D5   A5 02        H_NOT:    LDA   TL   
E1D7   49 FF                  EOR   #0FFh   
E1D9   85 02                  STA   TL   
E1DB   A5 03                  LDA   TH   
E1DD   49 FF                  EOR   #0FFh   
E1DF   85 03                  STA   TH   
E1E1   60                     RTS      
E1E2                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept.
E1E2   A9 00        H_MUL:    LDA   #0   
E1E4   85 04                  STA   T0   
E1E6   85 05                  STA   T1   ; product
E1E8   A0 10                  LDY   #16   
E1EA   46 03        ML1:      LSR   TH   
E1EC   66 02                  ROR   TL   ; next multiplier bit
E1EE   90 0F                  BCC   ml2   
E1F0   18                     CLC      
E1F1   A5 04                  LDA   T0   
E1F3   7D 00 02               ADC   DSL,X   
E1F6   85 04                  STA   T0   
E1F8   A5 05                  LDA   T1   
E1FA   7D 00 03               ADC   DSH,X   
E1FD   85 05                  STA   T1   
E1FF   1E 00 02     ML2:      ASL   DSL,X   
E202   3E 00 03               ROL   DSH,X   ; multiplicand * 2
E205   88                     DEY      
E206   D0 E2                  BNE   ml1   
E208   A5 04                  LDA   T0   
E20A   85 02                  STA   TL   
E20C   A5 05                  LDA   T1   
E20E   4C C8 E2               JMP   fin   
E211   BC 00 02     H_SWAP:   LDY   DSL,X   ; "%"
E214   A5 02                  LDA   TL   
E216   9D 00 02               STA   DSL,X   
E219   84 02                  STY   TL   
E21B   BC 00 03               LDY   DSH,X   
E21E   A5 03                  LDA   TH   
E220   9D 00 03               STA   DSH,X   
E223   84 03                  STY   TH   
E225   60                     RTS      
E226                             ; "/" ( a b -- r q ): the quotient is on top. Truncates toward zero; r takes
E226                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
E226                             ; of a. Dividing by zero is not checked: it returns two cells of no meaning.
E226   BD 00 03     H_DIV:    LDA   DSH,X   
E229   48                     PHA      ; r's sign
E22A   45 03                  EOR   TH   
E22C   48                     PHA      ; q's sign
E22D   A5 03                  LDA   TH   
E22F   10 03                  BPL   dv1   
E231   20 6F E2               JSR   neg   
E234   A5 02        DV1:      LDA   TL   
E236   85 08                  STA   D0   
E238   A5 03                  LDA   TH   
E23A   85 09                  STA   D1   ; D = |b|
