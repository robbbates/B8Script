0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Spec: docs/b8script.md (2026-11-21).
0000                             ; 
0000                             ;  Three switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    EDITOR   1 = with the line editor built in (see the end of this file):
0000                             ;                 the spec's suggested standard. It goes with either setting
0000                             ;                 of the other two.
0000                             ;    CHECKED  0 = no checks (spec: the programmer is responsible)
0000                             ;             1 = starts with every variable at 0 and every word undefined,
0000                             ;                 and stops on every error in the spec's table (and Ctrl-C)
0000                             ;                 with a four-line report: the letter and the place as line
0000                             ;                 and column, the text there, and both stacks. See `error`.
0000                             ; 
0000                             ;  In every build Ctrl-C stops a running program (an unchecked build stops
0000                             ;  without a word): see the console layer for the rules, the held key and
0000                             ;  the break-off cell.
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   1   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   1   ; 1 = checked build
0000                EDITOR:   EQU   1   ; 1 = with the line editor
0000                EDGEN:    EQU   EDITOR*(1-CPM)   ; (the generic build with the editor)
0000                             ; (IF takes any value but 0 as true, so
0000                             ;  IF CHECKED+EDITOR means "either")
0000                TABP0:    EQU   EDGEN*(1-CHECKED)   ; (the build with its table in page zero)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    HL'  return-stack pointer (the alternate HL). Entries are 2 bytes; the
0000                             ;         stack grows down. Only rpop and rpushn (and the checks) touch it.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  One-byte calls. The routines used most are reached with RST, one byte
0000                             ;  instead of three:
0000                             ; 
0000                             ;    RST 08h  rpop    pop the return stack into DE
0000                             ;    RST 18h  drop    drop TOS, then next character     (ends a handler)
0000                             ;    RST 20h  neg16   HL = -HL
0000                             ;    RST 28h  putc    print A
0000                             ;    RST 30h  next    next character                    (ends a handler)
0000                             ; 
0000                             ;  RST 18h and RST 30h never return: an RST is a CALL, so the first thing
0000                             ;  each of them does is POP DE to throw the return address away.
0000                             ; 
0000                             ;  The CP/M build can't own page zero, so the block from `vecs` to `vecend`
0000                             ;  (image addresses 0108h-0133h) is copied to 0008h-0033h when it starts. The
0000                             ;  code in that block is written to work at either place.
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (the top four bytes of the page are spare,
0000                             ;             so a full stack runs two bytes into the page below)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch, interpreter variables in the gaps, and the -n? line buffer
0000                             ;             at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack has a guard band: the data stack can
0000                             ;  overrun by a cell or two (and the calls made while it is full, the error
0000                             ;  report's included) into the top 32 bytes of the return-stack page, which
0000                             ;  are never used, and the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
0000                BDOS:     EQU   0005h   
0000                BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IF   CPM*(1-EDITOR)   
                    EXIT:     EQU   0000h   ; warm boot
0000                          ENDIF      
0000                          IFN   CPM   
                                 ; ---- generic machine: edit these to suit -----------------------------------
                    KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
                                 ;   waiting. The zero flag must match A
                                 ;   (end the routine with OR A / RET).
                    CONOUT:   EQU   0FF03h   ; print the character in A
                                 ;   KEY and CONOUT must preserve BC, DE, HL and HL'.
                    RSPAGE:   EQU   80h   ; 8000h return stack
                    DSPAGE:   EQU   81h   ; 8100h data stack
                    LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
                    PROG:     EQU   8300h   ; where the loader puts the program text
                    HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
                    BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)   
                    EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                          ENDIF      
0000                          IF   EDGEN   
                    LEAVE:    EQU   0FF09h   ; where the editor's ^X goes
0000                          ENDIF      
0000                          IF   EDITOR*CPM   
0000                LEAVE:    EQU   0000h   ; the editor's ^X: warm boot
0000                          ENDIF      
0000                          IF   EDITOR   
0000                EXIT:     EQU   edend   ; a program that ends goes back to the editor,
0000                SKEND:    EQU   skend   ;   also when it ends inside skip
0000                          ENDIF      
0000                          IF   1-EDITOR   
                    SKEND:    EQU   EXIT   
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine. (The wait
0000                             ; for a second Ctrl-C uses it too: 250 ms.)
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                             ;   around machine code;
0000                NPEND:    EQU   LET+38h   ;   minus the address of the program's end
0000                             ;   (the heap"s first byte), for the checked "_';
0000                EDLN:     EQU   LET+3Ah   ;   the editor: the number of the line that ^E
0000                             ;   put in the input line (0: none)
0000                KEYBUF:   EQU   LET+7Ah   ; gap after z: a key read by the break check and
0000                             ;   held for the next "?" (0: none);
0000                BRKOFF:   EQU   LET+7Bh   ;   the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                LBHDR:    EQU   LET+7Eh   ; CP/M BDOS 10 header: max, count
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FCh   ; empty data stack. The four bytes above it
0000                             ; are spare: a character can pop two cells
0000                             ; too many before the checked build sees it,
0000                             ; and the next call must not land on the
0000                             ; letter cells.
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is the start of the .COM file, and 0108h-0133h is also copied to
0000                             ;  page zero (see the header).
0000                             ; =============================================================================
0100                          .ORG   BASE   
0100                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              XOR   A   ; 00  reset. (This byte, AFh, is also what an
0100                          ENDIF      ;     undefined word runs into: see e_hi.)
0100                          IF   1-EDGEN   
0100   31 FC 0A               LD   SP,DSTOP   ; 00  reset, or the start of the .COM file
0103                          ENDIF      
0103                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)   
                              LD   BC,PROG   ; 03  the IP
                              JR   st0   ; 06  (the rest of the startup is close by)
0103                          ENDIF      
0103                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              JR   init   ; 04  (the rest of the startup is close by)
                              DW   0   ; 06  spare
0103                          ENDIF      
0103                          IF   EDGEN   
                              XOR   A   ; 00  reset: no program yet. (This byte, AFh,
                              LD   (PROG),A   ;     is also what an undefined word runs
                              JP   init   ; 04  into in the checked build: see e_hi.)
                              NOP      ; 07  spare
0103                          ENDIF      
0103                          IF   CPM   
0103   C3 D8 08               JP   start   ; 03
0106   00 00                  DW   0   ; 06  spare
0108                          ENDIF      
0108                VECS:        
0108                             ; ---- RST 08h: rpop: pop the return stack into DE ---------------------------
0108   D9           RPOP:     EXX      ; 08
0109   5E                     LD   E,(HL)   
010A   23                     INC   HL   
010B   56                     LD   D,(HL)   
010C   23                     INC   HL   
010D   D5                     PUSH   DE   ; across to the main registers
010E   D9                     EXX      
010F   D1                     POP   DE   
0110   C9                     RET      ; 10  (so RST 10h is not used)
0111                             ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
0111   C6 21        CTL:      ADD   A,21h   ; 11  back to c; zero only for NUL
0113   20 1F                  JR   NZ,next0   ;     the rest are ignored
0115   C3 DB 05     ENDPROG:   JP   EXIT   ;     the program has ended
0118                             ; ---- RST 18h: drop TOS, then next ------------------------------------------
0118   D1           RST18:    POP   DE   ; 18  discard the RST's return address
0119   E1                     POP   HL   ;     new TOS = NOS
011A   18 15                  JR   nx   
011C   E5           H_FROMR:   PUSH   HL   ; 1C  "}" return stack to TOS
011D   CF                     RST   08h   
011E   EB                     EX   DE,HL   
011F   F7                     RST   30h   
0120                             ; ---- RST 20h: neg16: HL = -HL (keeps BC, DE) -------------------------------
0120   AF           NEG16:    XOR   A   ; 20
0121   95                     SUB   L   
0122   6F                     LD   L,A   
0123   9F                     SBC   A,A   
0124   94                     SUB   H   
0125   67                     LD   H,A   
0126   C9                     RET      
0127   00                     NOP      ; 27  spare
0128                             ; ---- RST 28h: putc: print A (keeps BC, DE, HL, HL') ------------------------
0128                RST28:       
0128                          IFN   CPM   
                    PUTC:     JP   CONOUT   ; 28
0128                          ENDIF      
0128                          IF   CPM   
0128   C3 1C 04               JP   putc   ; 28
012B                          ENDIF      
012B   E9           JPHL:     JP   (HL)   ; 2B  (for the machine-code call)
012C   E3           H_TOR:    EX   (SP),HL   ; 2C  "{" TOS to the return stack: the new TOS
012D   C3 BC 01               JP   rpushn   ;     comes up, the old one goes across
0130                             ; ---- RST 30h: next character -----------------------------------------------
0130   D1           RST30:    POP   DE   ; 30  discard the RST's return address
0131                NX:          
0131                          IF   CPM   
0131   C3 34 01               JP   next0   ; (this copy runs in page zero)
0134                          ENDIF      
0134                VECEND:      
0134                             ; =============================================================================
0134                             ;  The inner loop: read one character and sort it by range.
0134                             ; 
0134                             ;    00h          end of program
0134                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0134                             ;    30h-39h      digit: read a whole number
0134                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0134                             ;    61h-7Ah      a-z: push the address of that letter's cell
0134                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0134                             ; =============================================================================
0134                NEXT0:       
0134                          IF   CHECKED   
0134   CD 62 04               CALL   chkstk   ; both stacks are checked once per character
0137                          ENDIF      
0137   0A                     LD   A,(BC)   
0138   03                     INC   BC   
0139   D6 21                  SUB   21h   ; A = c - 21h
013B   38 D4                  JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
013D   FE 0F                  CP   0Fh   
013F   38 25                  JR   C,punct   ; 21h-2Fh: PTAB index 0-14
0141   D6 0F                  SUB   0Fh   ; A = c - 30h
0143   FE 0A                  CP   0Ah   
0145   38 5F                  JR   C,digit   ; 30h-39h
0147   FE 11                  CP   11h   
0149   38 19                  JR   C,p3a   ; 3Ah-40h
014B   D6 11                  SUB   11h   ; A = c - 41h
014D   FE 1A                  CP   1Ah   
014F   38 61                  JR   C,upper   ; 41h-5Ah: A = letter index 0-25
0151   FE 20                  CP   20h   
0153   38 0D                  JR   C,p5b   ; 5Bh-60h
0155   FE 3A                  CP   3Ah   
0157   38 53                  JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0159   FE 3E                  CP   3Eh   
015B                          IF   1-CHECKED   
                              JR   NC,next0   ; 7Fh-FFh: ignored
015B                          ENDIF      
015B                          IF   CHECKED   
015B   28 D7                  JR   Z,next0   ; 7Fh, DEL: ignored
015D   D2 8F 04               JP   NC,e_hi   ; 80h-FFh: reserved
0160                          ENDIF      
0160   D6 1A                  SUB   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
0162   D6 09        P5B:      SUB   9   ; 5Bh-60h: -4 in all, index 22-27
0164   C6 05        P3A:      ADD   A,5   ; 3Ah-40h: index 15-21
0166                .macro PTABLE,
0166                             ; 
0166                 DB      h_store & 0FFh  ; !
0166                 DB      h_str & 0FFh    ; "
0166                 DB      h_num & 0FFh    ; #
0166                 DB      h_print & 0FFh  ; $
0166                 DB      h_swap & 0FFh   ; %
0166                 DB      h_and & 0FFh    ; &
0166                 DB      h_emit & 0FFh   ; '
0166                 DB      h_open & 0FFh   ; (
0166                 DB      h_close & 0FFh  ; )
0166                 DB      h_mul & 0FFh    ; *
0166                 DB      h_add & 0FFh    ; +
0166                 DB      h_cfetch & 0FFh ; ,
0166                 DB      h_sub & 0FFh    ; -
0166                 DB      h_cstore & 0FFh ; .
0166                 DB      h_div & 0FFh    ; /
0166                 DB      h_dup & 0FFh    ; :
0166                 DB      h_drop & 0FFh   ; ;
0166                 DB      h_lt & 0FFh     ; <
0166                 DB      h_eq & 0FFh     ; =
0166                 DB      h_gt & 0FFh     ; >
0166                 DB      h_key & 0FFh    ; ?
0166                 DB      h_fetch & 0FFh  ; @
0166                 DB      h_def & 0FFh    ; [
0166                 DB      h_break & 0FFh  ; \
0166                 DB      h_ret & 0FFh    ; ]
0166                 DB      h_xor & 0FFh    ; ^
0166                 DB      h_alloc & 0FFh  ; _
0166                 DB      h_grave & 0FFh  ; `
0166                 DB      h_tor & 0FFh    ; {
0166                 DB      h_or & 0FFh     ; |
0166                 DB      h_fromr & 0FFh  ; }
0166                 DB      h_not & 0FFh    ; ~
0166                .endm
0166                 
0166                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
0166                             ; untouched, and A, DE free.
0166   C6 A6        PUNCT:    ADD   A,PTAB & 0FFh   ; PTAB never crosses a page
0168   5F                     LD   E,A   
0169   16 03                  LD   D,PTAB / 256   ; (0 if the table is in page zero)
016B   FE BC                  CP   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
016D   1A                     LD   A,(DE)   
016E   5F                     LD   E,A   ; the handler's low byte
016F                          IF   (1-CPM)*(1-TABP0)   
                              LD   D,0   
016F                          ENDIF      
016F                          IFN   CPM   
                              RL   D   ; its page: 0 + carry
016F                          ENDIF      
016F                          IF   CPM   
016F   16 01                  LD   D,1   
0171   30 01                  JR   NC,pu1   
0173   14                     INC   D   ; its page: 1 + carry
0174                PU1:         
0174                          ENDIF      
0174   D5                     PUSH   DE   ; jump to it; the stack is balanced again
0175   C9                     RET      ;   when the handler starts
0176                             ; The rest of the startup: here so that the generic reset code can reach it
0176                             ; with JR. st0: find the program's NUL; the heap starts after it.
0176                             ; (The editor build has its own copy of this, next to the editor.)
0176                             ; A checked build first clears the lower half of the letter page (A = 0):
0176                             ; every variable starts at 0, every word cell holds 0000h, the address an
0176                             ; undefined word is caught at (see e_hi), and no key is held back.
0176                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                    INIT:     LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
                              LD   BC,PROG   ; the IP
0176                          ENDIF      
0176                          IF   (1-CPM)*(1-EDITOR)   
                    ST0:      LD   H,B   
                              LD   L,C   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
0176                          ENDIF      
0176                          IF   1-EDITOR   
                    ST2:      LD   (HEAP),HL   
0176                          ENDIF      
0176                          IF   CHECKED*(1-EDITOR)   
                              RST   20h   ; minus the heap"s first address: "_' may not
                              LD   (NPEND),HL   ;   release below it
0176                          ENDIF      
0176                          IF   (1-CHECKED)*(1-EDITOR)   
                              LD   HL,0   ; no key is held, and the break key is on
                              LD   (KEYBUF),HL   ;   (the checked build has cleared these)
0176                          ENDIF      
0176                          IF   1-EDITOR   
                              EXX      
                              LD   HL,RSTOP   ; the return stack is empty
                              EXX      
                              RST   30h   ; (its return address is thrown away)
0176                          ENDIF      
0176                             ; In the unchecked generic editor build the table is here, in the first
0176                             ; page, which saves loading D twice. (The other builds have no room for it
0176                             ; here: theirs is further down.)
0176                          IF   TABP0   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0176                          ENDIF      
0176                             ; =============================================================================
0176                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
0176                             ;  (00bbIGFuZCA= are up among the RST routines.) The machine-code call, exec,
0176                             ;  is here too: it belongs to "`" and makes the page come out right.
0176                             ; =============================================================================
0176   D1           H_XOR:    POP   DE   
0177   7C                     LD   A,H   
0178   AA                     XOR   D   
0179   67                     LD   H,A   
017A   7D                     LD   A,L   
017B   AB                     XOR   E   
017C   6F                     LD   L,A   
017D   F7                     RST   30h   
017E   D1           H_OR:     POP   DE   
017F   7C                     LD   A,H   
0180   B2                     OR   D   
0181   67                     LD   H,A   
0182   7D                     LD   A,L   
0183   B3                     OR   E   
0184   6F                     LD   L,A   
0185   F7                     RST   30h   
0186   E7           H_NOT:    RST   20h   ; ~x = -x - 1
0187   2B                     DEC   HL   
0188   F7                     RST   30h   
0189                             ; "_" ( n -- addr ): the heap pointer moves by n, a signed count (the add is
0189                             ; the same either way); TOS is the old pointer.
0189   ED 5B 7C 0B  H_ALLOC:   LD   DE,(HEAP)   
018D                          IF   CHECKED*CPM   
018D   7C                     LD   A,H   ; the count's sign, for chkhp
018E                          ENDIF      
018E   19                     ADD   HL,DE   ; the new top
018F                          IF   CHECKED   
018F   CD 46 04               CALL   chkhp   
0192                          ENDIF      
0192   22 7C 0B               LD   (HEAP),HL   
0195   EB                     EX   DE,HL   
0196   F7                     RST   30h   
0197   D9           EXEC:     EXX      
0198   22 34 0B               LD   (RSAVE),HL   ; machine code may change the alternates
019B   D9                     EXX      
019C   CD 2B 01               CALL   jphl   
019F   D9                     EXX      
01A0   2A 34 0B               LD   HL,(RSAVE)   
01A3   D9                     EXX      
01A4   E1                     POP   HL   
01A5   F7                     RST   30h   
01A6                             ; ---- the letters and digits (here, in the middle, so that the inner loop's
01A6                             ; ---- short jumps reach them, and the handlers after them reach rpushn) ------
01A6                             ; Digits: step back onto the first digit and read the whole number.
01A6   E5           DIGIT:    PUSH   HL   
01A7   0B                     DEC   BC   
01A8   CD 28 03               CALL   rdnum   
01AB   F7                     RST   30h   
01AC                             ; a-z: push the cell's address (the cell is the variable)
01AC   E5           LOWER:    PUSH   HL   
01AD   87                     ADD   A,A   
01AE   6F                     LD   L,A   
01AF   26 0B                  LD   H,LETPAGE   
01B1   F7                     RST   30h   
01B2                             ; A-Z: call the word. The return address (the IP after the letter) goes on
01B2                             ; the return stack, and the IP becomes the address in the letter's cell.
01B2   C5           UPPER:    PUSH   BC   ; the return address, for rpushn
01B3   EB                     EX   DE,HL   ; park TOS
01B4   87                     ADD   A,A   
01B5   6F                     LD   L,A   
01B6   26 0B                  LD   H,LETPAGE   ; HL -> cell
01B8   4E                     LD   C,(HL)   
01B9   2C                     INC   L   
01BA   46                     LD   B,(HL)   ; IP = the word's body
01BB   EB                     EX   DE,HL   ; TOS back, and fall into rpushn
01BC                             ; rpushn: move the top cell of the data stack (in memory) to the return
01BC                             ; stack, then next. Everything that pushes the return stack ends here.
01BC                             ; 
01BC                             ; The break key is looked at here, so at every word call and loop-back (and
01BC                             ; block entry and "{"), but only one time in 256: B', which nothing else
01BC                             ; uses, counts them. Reading the keyboard can be slow (it is a BDOS call
01BC                             ; under CP/M), and this way it costs a loop two bytes and 13 T-states.
01BC   D9           RPUSHN:   EXX      
01BD   D1                     POP   DE   
01BE   2B                     DEC   HL   
01BF   72                     LD   (HL),D   
01C0   2B                     DEC   HL   
01C1   73                     LD   (HL),E   
01C2   10 05                  DJNZ   rp1   
01C4   D9                     EXX      
01C5   CD D8 03               CALL   pollk   
01C8   F7                     RST   30h   
01C9   D9           RP1:      EXX      
01CA   F7                     RST   30h   
01CB                             ; ---- machine code: the grave -----------------------------------------------
01CB                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
01CB                             ; are stored from addr until a non-hex character; then a RET (C9h) is
01CB                             ; written and its address is left. An odd last digit is consumed and dropped.
01CB                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
01CB                             ; code is entered by CALL with the data stack above the return address; it
01CB                             ; must keep BC, and on return the top cell becomes the new TOS.
01CB   CD C6 03     H_GRAVE:   CALL   hexc   
01CE   30 C7                  JR   NC,exec   
01D0   77           HX1:      LD   (HL),A   ; the high digit goes in first ...
01D1   CD C6 03               CALL   hexc   
01D4   30 08                  JR   NC,hx2   ; odd digit: consumed, and the RET below
01D6   ED 6F                  RLD      ;   overwrites it
01D8   23                     INC   HL   ; ... and RLD shifts it up under the low one
01D9   CD C6 03               CALL   hexc   
01DC   38 F2                  JR   C,hx1   
01DE   36 C9        HX2:      LD   (HL),0C9h   ; (never range-checked: the spec says so)
01E0   F7                     RST   30h   
01E1                             ; ---- where the two pages meet ----------------------------------------------
01E1                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
01E1                             ; are in falling code order for this), and where exactly differs between the
01E1                             ; builds: NPG1 follows. Every handler below these four must start in the
01E1                             ; second page, and every one above in the first; chktab.py checks both.
01E1                             ; "]" returns: pop an address and jump to it.
01E1   CF           H_RET:    RST   08h   
01E2   42                     LD   B,D   
01E3   4B                     LD   C,E   
01E4   F7           BRK1:     RST   30h   
01E5                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
01E5                             ; drops the block start, "]" returns. No closer at all ends the program.
01E5   7C           H_BREAK:   LD   A,H   
01E6   B5                     OR   L   
01E7   E1                     POP   HL   
01E8   28 FA                  JR   Z,brk1   
01EA   CD 4F 03               CALL   skip   
01ED   B7                     OR   A   ; skip returns 0 for ")"
01EE   20 F1                  JR   NZ,h_ret   
01F0   CF           RDROP:    RST   08h   
01F1   F7                     RST   30h   
01F2                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
01F2                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
01F2                             ; the body"s address instead. Either way it then skips to the matching "]'.
01F2                             ; (The unchecked build takes anything that is not a letter as the space; the
01F2                             ; checked build stops on it.)
01F2   0A           H_DEF:    LD   A,(BC)   
01F3   03                     INC   BC   
01F4   D6 41                  SUB   "A"   ; a letter gives 0-25 or 32-57: lowercase
01F6   5F                     LD   E,A   ;   lands 64 bytes up
01F7   E6 DF                  AND   0DFh   ; fold case
01F9   FE 1A                  CP   26   
01FB   30 0B                  JR   NC,def2   ; not a letter
01FD   CB 23                  SLA   E   
01FF   16 0B                  LD   D,LETPAGE   ; DE -> cell
0201   79                     LD   A,C   
0202   12                     LD   (DE),A   
0203   1C                     INC   E   
0204   78                     LD   A,B   
0205   12                     LD   (DE),A   
0206   18 09                  JR   skipnx   
0208                DEF2:        
0208                          IF   CHECKED   
0208   7B                     LD   A,E   
0209   FE DF                  CP   " "-"A"+256   
020B   C2 AF 04               JP   NZ,e_brack   ; anything but a letter or a space
020E                          ENDIF      
020E   E5                     PUSH   HL   ; an anonymous block: push its address
020F   60                     LD   H,B   
0210   69                     LD   L,C   
0211                SKIPNX:      
0211                          IF   CHECKED   
0211   0B                     DEC   BC   ; back onto the letter, so that skip finds its
0212                          ENDIF      ;   opener, the "[", just before where it starts
0212   CD 4F 03     SKIPO:    CALL   skip   
0215   F7                     RST   30h   
0216   5E           H_FETCH:   LD   E,(HL)   ; "@"
0217   23                     INC   HL   
0218   56                     LD   D,(HL)   
0219   EB                     EX   DE,HL   
021A   F7                     RST   30h   
021B                             ; =============================================================================
021B                             ;  Handlers that must start in the image's second page.
021B                             ;  "?" is the last (with "," inside it), so its long tail may run past that
021B                             ;  page.
021B                             ; =============================================================================
021B                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
021B                             ; the matching ")".
021B   7C           H_OPEN:   LD   A,H   
021C   B5                     OR   L   
021D   E1                     POP   HL   
021E   28 F2                  JR   Z,skipo   
0220   C5                     PUSH   BC   ; the block starts at the IP
0221   18 99                  JR   rpushn   
0223                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
0223                             ; drops it and carries on.
0223   7C           H_CLOSE:   LD   A,H   
0224   B5                     OR   L   
0225   E1                     POP   HL   
0226   28 C8                  JR   Z,rdrop   
0228   CF                     RST   08h   ; pop the block start ...
0229   42                     LD   B,D   
022A   4B                     LD   C,E   
022B   C5                     PUSH   BC   
022C   18 8E                  JR   rpushn   ; ... and push it back
022E                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
022E                             ; "-" has two jobs: directly before a digit it starts a negative number.
022E   0A           H_SUB:    LD   A,(BC)   
022F   D6 30                  SUB   "0"   
0231   FE 0A                  CP   10   
0233   38 04                  JR   C,negnum   
0235   E7                     RST   20h   ; a - b = a + (-b): fall into "+"
0236   D1           H_ADD:    POP   DE   
0237   19                     ADD   HL,DE   
0238   F7                     RST   30h   
0239   E5           NEGNUM:   PUSH   HL   ; a negative number: read it, negate it
023A   CD 28 03               CALL   rdnum   
023D   E7                     RST   20h   
023E   F7                     RST   30h   
023F   D1           H_AND:    POP   DE   
0240   7C                     LD   A,H   
0241   A2                     AND   D   
0242   67                     LD   H,A   
0243   7D                     LD   A,L   
0244   A3                     AND   E   
0245   6F                     LD   L,A   
0246   F7                     RST   30h   
0247                             ; Signed compares. Both are "HL < DE" for the right pair: "<" swaps the two
0247                             ; cells first. Flipping both sign bits turns a signed compare into an
0247                             ; unsigned one (and XOR clears the carry for SBC); SBC HL,HL then turns the
0247                             ; carry into -1 or 0 with no branch.
0247   E3           H_LT:     EX   (SP),HL   ; a < b: HL = a, and b is popped next
0248   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
0249   7C                     LD   A,H   
024A   EE 80                  XOR   80h   
024C   67                     LD   H,A   
024D   7A                     LD   A,D   
024E   EE 80                  XOR   80h   
0250   57                     LD   D,A   
0251   ED 52                  SBC   HL,DE   ; carry if HL < DE
0253   ED 62        TF:       SBC   HL,HL   ; carry -> -1 or 0
0255   F7                     RST   30h   
0256   D1           H_EQ:     POP   DE   
0257   B7                     OR   A   
0258   ED 52                  SBC   HL,DE   
025A   7C                     LD   A,H   
025B   B5                     OR   L   
025C   FE 01                  CP   1   ; carry only if a - b = 0
025E   18 F3                  JR   tf   
0260                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept. The
0260                             ; multiplier shifts up through A:C.
0260   D1           H_MUL:    POP   DE   ; DE = multiplicand
0261   C5                     PUSH   BC   
0262   7C                     LD   A,H   
0263   4D                     LD   C,L   ; A:C = multiplier
0264   21 00 00               LD   HL,0   
0267   06 10                  LD   B,16   
0269   29           MUL1:     ADD   HL,HL   
026A   CB 21                  SLA   C   
026C   17                     RLA      
026D   30 01                  JR   NC,mul2   
026F   19                     ADD   HL,DE   
0270   10 F7        MUL2:     DJNZ   mul1   
0272   C1                     POP   BC   
0273   F7                     RST   30h   
0274                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
0274                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
0274                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
0274                             ; stops on it.
0274                H_DIV:       
0274                          IF   CHECKED   
0274   7C                     LD   A,H   
0275   B5                     OR   L   
0276   CA AC 04               JP   Z,e_zero   
0279                          ENDIF      
0279   D1                     POP   DE   ; DE = a, HL = b
027A   C5                     PUSH   BC   ; free BC for udiv
027B   D5                     PUSH   DE   ; a, for r's sign
027C   7A                     LD   A,D   
027D   AC                     XOR   H   
027E   F5                     PUSH   AF   ; S flag = sign of q
027F   CB 7C                  BIT   7,H   
0281   C4 20 01               CALL   NZ,neg16   ; HL = |b|
0284   EB                     EX   DE,HL   
0285   CB 7C                  BIT   7,H   
0287   C4 20 01               CALL   NZ,neg16   ; HL = |a|, DE = |b|
028A   CD 02 03               CALL   udiv   ; HL = q, DE = r
028D   F1                     POP   AF   
028E   FC 20 01               CALL   M,neg16   ; q's sign
0291   EB                     EX   DE,HL   ; HL = r, DE = q
0292   F1                     POP   AF   ; A = a's high byte
0293   B7                     OR   A   
0294   FC 20 01               CALL   M,neg16   ; r's sign
0297   C1                     POP   BC   
0298   D5                     PUSH   DE   ; q under r
0299   F7                     RST   30h   
029A                             ; ---- stack and storage -----------------------------------------------------
029A   E5           H_DUP:    PUSH   HL   ; ":"
029B   F7                     RST   30h   
029C   E3           H_SWAP:   EX   (SP),HL   ; "%"
029D   F7                     RST   30h   
029E                             ; (The checked build tests the address before it takes the value off the
029E                             ; stack, so that an error report shows both.)
029E                H_CSTORE:      ; "." ( c addr -- )
029E                          IF   CHECKED   
029E   CD 35 04               CALL   chkst   
02A1                          ENDIF      
02A1   D1                     POP   DE   
02A2   73                     LD   (HL),E   
02A3   DF           H_DROP:   RST   18h   ; ";" is this one byte
02A4                H_STORE:      ; "!" ( n addr -- )
02A4                          IF   CHECKED   
02A4   CD 35 04               CALL   chkst   
02A7                          ENDIF      
02A7   D1                     POP   DE   
02A8   73                     LD   (HL),E   
02A9   23                     INC   HL   
02AA   72                     LD   (HL),D   
02AB   DF                     RST   18h   
02AC                             ; ---- console ---------------------------------------------------------------
02AC                             ; 22h pushes the address of the text after it and skips the string.
02AC   E5           H_STR:    PUSH   HL   
02AD   60                     LD   H,B   
02AE   69                     LD   L,C   
02AF   CD 3E 03               CALL   skipstr   
02B2                          IF   CHECKED   
02B2   B7                     OR   A   ; 0: the text ran out before the closing quote
02B3   CA A4 04               JP   Z,e_quote   
02B6                          ENDIF      
02B6   F7                     RST   30h   
02B7                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character
02B7                             ; clears that character"s bit 6 (/M is CR, /` is space; "/" and ""' have no
02B7                             ; bit 6, so // and /" give themselves).
02B7                          IF   (1-CHECKED)*(1-EDITOR)   
                    H_PRINT:   LD   A,(HL)   
                              INC   HL   
                              CP   22h   
                              JR   Z,pr9   
                              CP   "/"   
                              JR   NZ,pr1   
                              LD   A,(HL)   
                              INC   HL   
                              AND   0BFh   
                    PR1:      RST   28h   
                              JR   h_print   
02B7                          ENDIF      
02B7                          IF   CHECKED   
02B7                             ; (The checked build has the loop as a routine, prstr, which the error
02B7                             ; report uses too. The address is kept on the stack meanwhile: a report
02B7                             ; shows the stack as it was before the "$".)
02B7   E5           H_PRINT:   PUSH   HL   
02B8   CD 77 05               CALL   prstr   
02BB   D1                     POP   DE   
02BC   DF                     RST   18h   
02BD                          ENDIF      
02BD                          IF   (1-CHECKED)*EDITOR   
                                 ; (With the editor the loop is a routine, prstr, which ^V uses too.)
                    H_PRINT:   CALL   prstr   
                              RST   18h   
02BD                          ENDIF      
02BD   7D           H_EMIT:   LD   A,L   ; "'"
02BE   EF                     RST   28h   
02BF   DF           PR9:      RST   18h   
02C0                             ; "#" prints TOS as a signed decimal number, with no space after it.
02C0   C5           H_NUM:    PUSH   BC   
02C1   CD 8C 03               CALL   psgn   
02C4   C1                     POP   BC   
02C5   DF                     RST   18h   
02C6                             ; "?" ( n -- c ) or ( -n -- addr )
02C6                             ;   n > 0: wait about n ms for a key; 0 if none came
02C6                             ;   n = 0: wait for a key
02C6                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
02C6                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
02C6   CB 7C        H_KEY:    BIT   7,H   
02C8   20 19                  JR   NZ,line   
02CA   1E 28        KT1:      LD   E,MSLOOP   ; one millisecond, roughly
02CC   CD E4 03     KT2:      CALL   getk   
02CF   20 0E                  JR   NZ,kt3   
02D1   1D                     DEC   E   
02D2   20 F8                  JR   NZ,kt2   
02D4   7C                     LD   A,H   ; 0? never counts down: it waits
02D5   B5                     OR   L   
02D6   28 F2                  JR   Z,kt1   
02D8   2B                     DEC   HL   
02D9   7C                     LD   A,H   
02DA   B5                     OR   L   
02DB   20 ED                  JR   NZ,kt1   ; A = 0 if the time ran out
02DD   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
02DE   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
02DF   6F           KT3:      LD   L,A   
02E0   26 00                  LD   H,0   
02E2   F7                     RST   30h   
02E3                          IF   CPM   
02E3                             ; CP/M: BDOS 10 does the editing (the spec allows the platform's
02E3                             ; own line editor). It doesn't store the CR, so it is added here.
02E3   11 7F 00     LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
02E6   19                     ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
02E7   9F                     SBC   A,A   
02E8   A5                     AND   L   ; (0 for a count that is too big)
02E9   EE 7F                  XOR   127   ; A = the count, 127 at most
02EB   32 7E 0B               LD   (LBHDR),A   
02EE   11 7E 0B               LD   DE,LBHDR   
02F1   3E 0A                  LD   A,10   
02F3   CD 28 04               CALL   bdosx   
02F6   21 7F 0B               LD   HL,LBHDR+1   
02F9   7E                     LD   A,(HL)   ; the count typed (0-127)
02FA   2C                     INC   L   ; HL = LINEBUF, whose low byte is 80h:
02FB   85                     ADD   A,L   ;   adding the count to L can't carry
02FC   6F                     LD   L,A   
02FD   36 0D                  LD   (HL),13   
02FF                          ENDIF      
02FF                          IFN   CPM   
                                 ; Generic: Backspace takes the last character back (and is echoed as
                                 ; it is), CR ends (stored, not echoed), every other key is stored and
                                 ; echoed until the line is full. The line buffer starts at offset 80h
                                 ; of its page, so L alone is the place in the line: D holds the L of
                                 ; a full line.
                    LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
                              ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
                              SBC   A,A   
                              AND   L   ; (0 for a count that is too big)
                              CPL      
                              LD   D,A   ; D = the L of a full line: 80h + count, FFh
                                 ;   at most
                              LD   HL,LINEBUF   
                    LN2:      CALL   getk   
                              JR   Z,ln2   
                              CP   13   
                              JR   Z,ln5   
                              CP   8   
                              JR   Z,ln4   
                              LD   E,A   
                              LD   A,L   
                              CP   D   
                              JR   Z,ln2   ; full
                              LD   (HL),E   
                              INC   L   
                              LD   A,E   
                    LN3:      RST   28h   
                              JR   ln2   
                    LN4:      DEC   L   ; Backspace: one back, and echo it,
                              JP   M,ln3   ;   unless the line was empty (L left the
                              INC   L   ;   upper half of the page)
                              JR   ln2   
                    LN5:      LD   (HL),A   ; the CR
02FF                          ENDIF      
02FF   2E 80                  LD   L,LINEBUF & 0FFh   
0301   F7                     RST   30h   
0302                             ; =============================================================================
0302                             ;  More routines (no handler starts past this point)
0302                             ; =============================================================================
0302                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
0302                             ; Uses A, BC; the caller saves the IP. The dividend shifts up through A:C
0302                             ; while the quotient bits arrive at the bottom of C.
0302                             ; Dividing by 2 is one shift (the spec wants that fast).
0302   7B           UDIV:     LD   A,E   
0303   EE 02                  XOR   2   
0305   B2                     OR   D   
0306   20 07                  JR   NZ,udv0   
0308   CB 3C                  SRL   H   
030A   CB 1D                  RR   L   ; the quotient
030C   8F                     ADC   A,A   
030D   5F                     LD   E,A   ; the remainder: the bit that fell out (D is 0)
030E   C9                     RET      
030F   7C           UDV0:     LD   A,H   
0310   4D                     LD   C,L   
0311   21 00 00               LD   HL,0   
0314   06 10                  LD   B,16   
0316   CB 21        UDV1:     SLA   C   
0318   17                     RLA      
0319   ED 6A                  ADC   HL,HL   
031B   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
031D   30 02                  JR   NC,udv2   ;   always fits in 16 bits
031F   19                     ADD   HL,DE   ; too much: put it back, and cancel the
0320   0D                     DEC   C   ;   INC below
0321   0C           UDV2:     INC   C   ; a quotient bit
0322   10 F2                  DJNZ   udv1   
0324   EB                     EX   DE,HL   ; DE = remainder
0325   67                     LD   H,A   
0326   69                     LD   L,C   ; HL = quotient
0327   C9                     RET      
0328                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
0328                             ; non-digit. Values wrap at 16 bits, as the spec says.
0328   21 00 00     RDNUM:    LD   HL,0   
032B   0A           RDN1:     LD   A,(BC)   
032C   D6 30                  SUB   "0"   
032E   FE 0A                  CP   10   
0330   D0                     RET   NC   
0331   03                     INC   BC   
0332   54                     LD   D,H   
0333   5D                     LD   E,L   
0334   29                     ADD   HL,HL   
0335   29                     ADD   HL,HL   
0336   19                     ADD   HL,DE   
0337   29                     ADD   HL,HL   ; HL * 10
0338   5F                     LD   E,A   
0339   16 00                  LD   D,0   
033B   19                     ADD   HL,DE   
033C   18 ED                  JR   rdn1   
033E                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
033E                             ; the next character, so "/"" does not end it. Leaves A = 22h.
033E                          IF   1-CHECKED   
                    SS0:      INC   BC   
                    SKIPSTR:   LD   A,(BC)   
                              INC   BC   
                              CP   "/"   
                              JR   Z,ss0   
                              CP   22h   
                              JR   NZ,skipstr   
                              RET      
033E                          ENDIF      
033E                          IF   CHECKED   
033E                             ; The checked build never steps over a NUL: if the text runs out first it
033E                             ; returns A = 0 with the IP on the NUL.
033E   0A           SKIPSTR:   LD   A,(BC)   
033F   B7                     OR   A   
0340   C8                     RET   Z   
0341   03                     INC   BC   
0342   FE 22                  CP   22h   
0344   C8                     RET   Z   
0345   FE 2F                  CP   "/"   
0347   20 F5                  JR   NZ,skipstr   
0349   0A                     LD   A,(BC)   ; the escaped character
034A   B7                     OR   A   
034B   C8                     RET   Z   
034C   03                     INC   BC   
034D   18 EF                  JR   skipstr   
034F                          ENDIF      
034F                             ; skip: read past text to the closer at this level, and return A = 0 if it
034F                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
034F                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
034F                             ; no closer; anything else that runs into the NUL had unbalanced brackets
034F                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
034F                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
034F                             ; 
034F                             ; The checked build also looks at the character the skip was started by,
034F                             ; which is always the one just before where it starts: "(" must end at ")",
034F                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
034F                             ; quote counts as running into it. "\" takes either closer. IX keeps the
034F                             ; place where the skip started, for the report.
034F                SKIP:        
034F                          IF   CHECKED   
034F   C5                     PUSH   BC   
0350   DD E1                  POP   IX   
0352   0B                     DEC   BC   
0353   0A                     LD   A,(BC)   
0354   03                     INC   BC   
0355   5F                     LD   E,A   ; E = the opener: ( [ or \
0356                          ENDIF      
0356   16 00                  LD   D,0   
0358   14           SK3:      INC   D   ; an opener: one deeper
0359   0A           SK1:      LD   A,(BC)   
035A                          IF   1-CHECKED   
                              INC   BC   
                              OR   A   
                              JP   Z,SKEND   ; (the end of the program)
035A                          ENDIF      
035A                          IF   CHECKED   
035A   B7                     OR   A   
035B   28 22                  JR   Z,sk6   ; (the IP stays on the NUL)
035D   03                     INC   BC   
035E                          ENDIF      
035E   FE 22                  CP   22h   
0360   CC 3E 03               CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
0363   D6 28                  SUB   "("   ;   (or 0, and then the NUL is read next)
0365   28 F1                  JR   Z,sk3   
0367   3D                     DEC   A   ; ")"
0368   28 08                  JR   Z,sk4   
036A   D6 32                  SUB   "["-")"   
036C   28 EA                  JR   Z,sk3   
036E   FE 02                  CP   "]"-"["   
0370   20 E7                  JR   NZ,sk1   
0372   15           SK4:      DEC   D   
0373                          IF   1-CHECKED   
                              RET   Z   ; the closer at this level
                              JR   sk1   
0373                          ENDIF      
0373                          IF   CHECKED   
0373   20 E4                  JR   NZ,sk1   
0375   57                     LD   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
0376   AB                     XOR   E   ;   opener is 0 for "(" and 1 for "[", and only
0377   E6 06                  AND   6   ;   "\" has bit 2: so this is 2 for the wrong
0379   FE 02                  CP   2   ;   closer, and only then
037B   7A                     LD   A,D   
037C   C0                     RET   NZ   
037D   18 05                  JR   sk7   
037F   CB 53        SK6:      BIT   2,E   ; the text ran out:
0381   C2 DA 05               JP   NZ,SKEND   ;   "\" with no closer ends the program
0384   DD E5        SK7:      PUSH   IX   ; N. The place is the opener
0386   C1                     POP   BC   
0387   3E 4E                  LD   A,"N"   
0389   C3 A1 04               JP   errp   ; (errp drops skip's return address)
038C                          ENDIF      
038C                             ; psgn: print HL as a signed number. Uses BC.
038C   CB 7C        PSGN:     BIT   7,H   
038E   28 04                  JR   Z,pdec   
0390   3E 2D                  LD   A,"-"   
0392   EF                     RST   28h   
0393   E7                     RST   20h   
0394                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
0394                             ; Uses BC.
0394   11 0A 00     PDEC:     LD   DE,10   
0397   CD 02 03               CALL   udiv   ; HL = HL / 10, E = the last digit
039A   7B                     LD   A,E   
039B   F5                     PUSH   AF   
039C   7C                     LD   A,H   
039D   B5                     OR   L   
039E   C4 94 03               CALL   NZ,pdec   
03A1   F1                     POP   AF   
03A2   C6 30                  ADD   A,"0"   
03A4   EF                     RST   28h   
03A5   C9                     RET      
03A6                             ; =============================================================================
03A6                             ;  Dispatch table: the low byte of each handler's address, in code order
03A6                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
03A6                             ;  It must not cross a page (the dispatcher only adds to its low byte).
03A6                             ; =============================================================================
03A6                             ; The handlers of the first NPG1 characters start in the image's second page.
03A6                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
03A6                             ; differs between the builds, so the count is worked out here.
03A6                             ; (One division to a line: asm80 only rounds down when it stores a value.)
03A6                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
03A6                PGBRK:    EQU   (h_break-BASE)/256   
03A6                PGDEF:    EQU   (h_def-BASE)/256   
03A6                PGFET:    EQU   (h_fetch-BASE)/256   
03A6                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
03A6                          IF   1-TABP0   
03A6                PTAB:        
03A6                          ;*Macro unroll:  PTABLE
03A6   A4                     DB   h_store & 0FFh   
03A7   AC                     DB   h_str & 0FFh   
03A8   C0                     DB   h_num & 0FFh   
03A9   B7                     DB   h_print & 0FFh   
03AA   9C                     DB   h_swap & 0FFh   
03AB   3F                     DB   h_and & 0FFh   
03AC   BD                     DB   h_emit & 0FFh   
03AD   1B                     DB   h_open & 0FFh   
03AE   23                     DB   h_close & 0FFh   
03AF   60                     DB   h_mul & 0FFh   
03B0   36                     DB   h_add & 0FFh   
03B1   DE                     DB   h_cfetch & 0FFh   
03B2   2E                     DB   h_sub & 0FFh   
03B3   9E                     DB   h_cstore & 0FFh   
03B4   74                     DB   h_div & 0FFh   
03B5   9A                     DB   h_dup & 0FFh   
03B6   A3                     DB   h_drop & 0FFh   
03B7   47                     DB   h_lt & 0FFh   
03B8   56                     DB   h_eq & 0FFh   
03B9   48                     DB   h_gt & 0FFh   
03BA   C6                     DB   h_key & 0FFh   
03BB   16                     DB   h_fetch & 0FFh   
03BC   F2                     DB   h_def & 0FFh   
03BD   E5                     DB   h_break & 0FFh   
03BE   E1                     DB   h_ret & 0FFh   
03BF   76                     DB   h_xor & 0FFh   
03C0   89                     DB   h_alloc & 0FFh   
03C1   CB                     DB   h_grave & 0FFh   
03C2   2C                     DB   h_tor & 0FFh   
03C3   7E                     DB   h_or & 0FFh   
03C4   1C                     DB   h_fromr & 0FFh   
03C5   86                     DB   h_not & 0FFh   
03C6                PTABEND:      
03C6                          ENDIF      
03C6                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
03C6                             ; and return its value in A with the carry set; otherwise leave the IP and
03C6                             ; return with the carry clear.
03C6   0A           HEXC:     LD   A,(BC)   
03C7   D6 30                  SUB   "0"   
03C9   FE 0A                  CP   10   
03CB   38 09                  JR   C,hc1   
03CD   E6 DF                  AND   0DFh   
03CF   D6 11                  SUB   11h   
03D1   FE 06                  CP   6   
03D3   D0                     RET   NC   
03D4   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
03D6   03           HC1:      INC   BC   
03D7   C9                     RET      
03D8                             ; =============================================================================
03D8                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
03D8                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
03D8                             ;  (RST 28h) prints A. Both keep BC, DE, HL and HL'. In the generic build
03D8                             ;  they are the host's KEY and CONOUT routines themselves.
03D8                             ; 
03D8                             ;  A running program reads the keyboard only through getk and pollk, which
03D8                             ;  between them give the break key its rules:
03D8                             ;    - Ctrl-C stops the program;
03D8                             ;    - any other key that the break check reads is held in KEYBUF for the
03D8                             ;      next "?", and a newer one takes its place;
03D8                             ;    - "?" (getk) takes the held key first;
03D8                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
03D8                             ;      key like any other, but two of them within about 250 ms still stop it.
03D8                             ;  Both are called straight from a handler, never from a routine under one:
03D8                             ;  the checked build's report counts on finding one return address above the
03D8                             ;  data stack.
03D8                             ; =============================================================================
03D8                          IFN   CPM   
                    RAWK:     EQU   KEY   
03D8                          ENDIF      
03D8                             ; pollk: the break check (see rpushn).
03D8   CD 1A 04     POLLK:    CALL   rawk   
03DB   C8                     RET   Z   ; no key
03DC   32 7A 0B               LD   (KEYBUF),A   ; held for the next "?"
03DF   FE 03                  CP   3   
03E1   C0                     RET   NZ   
03E2   18 11                  JR   ctlc   
03E4                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
03E4   E5           GETK:     PUSH   HL   ; a held key goes first, and is taken out of
03E5   21 7A 0B               LD   HL,KEYBUF   ;   the buffer
03E8   7E                     LD   A,(HL)   
03E9   36 00                  LD   (HL),0   
03EB   E1                     POP   HL   
03EC   B7                     OR   A   
03ED   C0                     RET   NZ   
03EE   CD 1A 04               CALL   rawk   
03F1   C8                     RET   Z   
03F2   FE 03                  CP   3   
03F4   C0                     RET   NZ   
03F5                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
03F5                             ; the program has turned it off, wait about 250 ms for one more key: a
03F5                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
03F5                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
03F5   3A 7B 0B     CTLC:     LD   A,(BRKOFF)   
03F8   B7                     OR   A   
03F9   CA 99 04               JP   Z,brk   
03FC   D5                     PUSH   DE   
03FD   11 10 27               LD   DE,250*MSLOOP   
0400   CD 1A 04     CT1:      CALL   rawk   
0403   20 05                  JR   NZ,ct2   
0405   1B                     DEC   DE   
0406   7A                     LD   A,D   
0407   B3                     OR   E   
0408   20 F6                  JR   NZ,ct1   
040A   D1           CT2:      POP   DE   ; A = the second key, or 0 if none came
040B   FE 03                  CP   3   
040D   CA 99 04               JP   Z,brk   
0410   B7                     OR   A   
0411   28 03                  JR   Z,ct3   
0413   32 7A 0B               LD   (KEYBUF),A   
0416   3E 03        CT3:      LD   A,3   
0418   B7                     OR   A   
0419   C9                     RET      
041A                          IF   (1-CHECKED)*(1-EDITOR)   
                    BRK:      EQU   endprog   ; the unchecked build stops without a word
041A                          ENDIF      ;   (with the editor, both stacks are cleared);
041A                          IF   (1-CHECKED)*EDITOR   
                    BRK:      EQU   edit0   
041A                          ENDIF      
041A                          IF   CHECKED   
041A                BRK:      EQU   e_break   ;   the checked build reports B
041A                          ENDIF      
041A                          IF   CPM   
041A   3E FF        RAWK:     LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
041C                             ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
041C                             ; printing and could swallow a key that BDOS 6 then never sees.
041C   D5           PUTC:     PUSH   DE   
041D   E5                     PUSH   HL   
041E   5F                     LD   E,A   
041F   3E 06                  LD   A,6   
0421   CD 28 04               CALL   bdosx   
0424   E1                     POP   HL   
0425   D1                     POP   DE   
0426   B7                     OR   A   ; (for getk)
0427   C9                     RET      
0428                             ; bdosx: call BDOS function A with DE, keeping BC and HL'
0428   C5           BDOSX:    PUSH   BC   
0429   D9                     EXX      
042A   E5                     PUSH   HL   
042B   D9                     EXX      
042C   4F                     LD   C,A   
042D   CD 05 00               CALL   BDOS   
0430   D9                     EXX      
0431   E1                     POP   HL   
0432   D9                     EXX      
0433   C1                     POP   BC   
0434   C9                     RET      
0435                          ENDIF      
0435                             ; =============================================================================
0435                             ;  Checked build: the checks and the error report
0435                             ; =============================================================================
0435                          IF   CHECKED   
0435                             ; chkst: stop unless HL is in the program's own space: from the letter page
0435                             ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
0435                             ; whatever lies above the limit are safe. Memory above the heap top but
0435                             ; below the limit is the program's own: Tiny BASIC keeps its lines there.
0435                             ; It is the page of HL + 1 that is tested, so that one test serves both
0435                             ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
0435                             ; Keeps HL and BC.
0435   23           CHKST:    INC   HL   
0436   7C                     LD   A,H   
0437   2B                     DEC   HL   
0438   FE 0B                  CP   LETPAGE   
043A   38 07                  JR   C,chs1   
043C                          ENDIF      
043C                          IF   CHECKED*(1-CPM)   
                              CP   HEAPLIM   
                              RET   C   
043C                          ENDIF      
043C                          IF   CHECKED*CPM   
043C   5F                     LD   E,A   
043D   3A 07 00               LD   A,(0007h)   ; the BDOS page is the heap limit
0440   3D                     DEC   A   
0441   BB                     CP   E   
0442   D0                     RET   NC   
0443                          ENDIF      
0443                          IF   CHECKED   
0443   C3 9F 04     CHS1:     JP   e_store   
0446                             ; chkhp: HL = the new heap top, DE = the old one, the carry is from adding
0446                             ; the count. Stop if the top is not below the limit page, or is below the
0446                             ; program's end.
0446                CHKHP:       
0446                          ENDIF      
0446                          IF   CHECKED*CPM   
0446                             ; With this much room a top that wrapped round can land back in
0446                             ; range, so the add is tested too: growing (A, the count's high
0446                             ; byte, is positive) must not carry, and releasing must.
0446   1F                     RRA      ; the carry comes in above the sign:
0447   C6 40                  ADD   A,40h   ;   bit 7 = carry XOR sign
0449   87                     ADD   A,A   
044A   38 10                  JR   C,e_heap   
044C   3A 07 00               LD   A,(0007h)   
044F   3D                     DEC   A   
0450   BC                     CP   H   
0451   38 09                  JR   C,e_heap   
0453                          ENDIF      
0453                          IF   CHECKED*(1-CPM)   
                                 ; (Here the program's space is under 32K, so a top that wrapped
                                 ; round always falls outside it.)
                              LD   A,H   
                              CP   HEAPLIM   
                              JR   NC,e_heap   
0453                          ENDIF      
0453                          IF   CHECKED   
0453   D5                     PUSH   DE   
0454   EB                     EX   DE,HL   
0455   2A 38 0B               LD   HL,(NPEND)   
0458   19                     ADD   HL,DE   ; carry: at or above the program's end
0459   EB                     EX   DE,HL   
045A   D1                     POP   DE   
045B   D8                     RET   C   
045C   B7           E_HEAP:   OR   A   ; put the count back in TOS for the report
045D   ED 52                  SBC   HL,DE   
045F   C3 9C 04               JP   e_heap1   
0462                             ; chkstk: both stacks are checked once per character, not in every handler.
0462                             ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
0462                             ; the constant carries if it is above (cells were popped that were never
0462                             ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
0462                             ; a character late at most: the bytes above DSTOP and the guard band below
0462                             ; the page take what happens meanwhile. DE is free between characters.
0462   EB           CHKSTK:   EX   DE,HL   
0463   21 05 F5               LD   HL,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
0466   39                     ADD   HL,SP   
0467   EB                     EX   DE,HL   
0468   38 1E                  JR   C,e_under   
046A   14                     INC   D   
046B   20 17                  JR   NZ,e_over   
046D   D9                     EXX      ; the return stack: in its page (or it has
046E   7C                     LD   A,H   ;   overflowed), and not above its empty
046F   FE 09                  CP   RSPAGE   ;   position (an underflow stays inside the
0471   7D                     LD   A,L   ;   page, in the guard band)
0472   D9                     EXX      
0473   20 0C                  JR   NZ,e_rover   
0475   FE E1                  CP   RSTOP&0FFh+1   
0477   D8                     RET   C   
0478   D9                     EXX      ; return stack underflow: it counts as empty
0479   21 E0 09               LD   HL,RSTOP   
047C   D9                     EXX      
047D   3E 72                  LD   A,"r"   
047F   18 20                  JR   errp   
0481   3E 52        E_ROVER:   LD   A,"R"   ; return stack overflow
0483   11                     DB   11h   ; (LD DE,nn hides the next entry)
0484   3E 53        E_OVER:   LD   A,"S"   ; data stack overflow
0486   18 19                  JR   errp   
0488   31 FC 0A     E_UNDER:   LD   SP,DSTOP   ; data stack underflow: it counts as empty
048B   3E 73                  LD   A,"s"   
048D   18 22                  JR   error   
048F                             ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
048F                             ; was never defined still holds 0000h, and the byte there is a reserved one
048F                             ; in every build (AFh or C3h): if the IP is in page zero, this was a call of
048F                             ; an undefined word. The call is undone, so the place is the call itself.
048F   04           E_HI:     INC   B   
0490   10 17                  DJNZ   e_resv   ; (B is as it was, and is not 0)
0492   CF                     RST   08h   
0493   42                     LD   B,D   
0494   4B                     LD   C,E   
0495   3E 55                  LD   A,"U"   
0497   18 18                  JR   error   
0499                             ; Error entries. Each loads its letter and then hides the next entry inside
0499                             ; a 3-byte LD DE,nn (the 11h), so they all fall through to `error`.
0499   3E 42        E_BREAK:   LD   A,"B"   ; Ctrl-C (found inside pollk or getk)
049B   11                     DB   11h   
049C   3E 48        E_HEAP1:   LD   A,"H"   ; heap (found inside chkhp)
049E   11                     DB   11h   
049F   3E 4F        E_STORE:   LD   A,"O"   ; a store outside the program's space (chkst)
04A1                             ; errp: an error found inside a routine: drop its return address first.
04A1   D1           ERRP:     POP   DE   
04A2   18 0D                  JR   error   
04A4   44           E_QUOTE:   LD   B,H   ; an unclosed string: HL is its address, one
04A5   4D                     LD   C,L   ;   past the opening quote, which is the place
04A6   3E 51                  LD   A,"Q"   
04A8   11                     DB   11h   
04A9   3E 58        E_RESV:   LD   A,"X"   ; a reserved byte outside a string
04AB   11                     DB   11h   
04AC   3E 5A        E_ZERO:   LD   A,"Z"   ; dividing by zero
04AE   11                     DB   11h   
04AF   3E 57        E_BRACK:   LD   A,"W"   ; bad character after [
04B1                             ; error: the report, then the end. A = the letter, BC = one past the place,
04B1                             ; HL = TOS, and both stacks as the report is to show them:
04B1                             ; 
04B1                             ;   Err X @ line,col
04B1                             ;   up to 16 characters of the text from the place
04B1                             ;   Stk n: the top 8 cells at most, bottom to top
04B1                             ;   Rtn n
04B1   E5           ERROR:    PUSH   HL   ; now the whole data stack is in memory
04B2   5F                     LD   E,A   
04B3   CD 8A 05               CALL   pnl   
04B6   45 72 72 20 22         DB   "Err ",22h   
04BB   7B                     LD   A,E   
04BC   EF                     RST   28h   
04BD   CD 90 05               CALL   pmsg   
04C0   20 40 20 22            DB   " @ ",22h   
04C4   0B                     DEC   BC   ; BC = the place
04C5                             ; The line and column. A place below the program is in the line
04C5                             ; buffer: line 0. Otherwise count the LFs from the program's start;
04C5                             ; DE = the line's number, HL = where it starts.
04C5   21 80 0B               LD   HL,LINEBUF   
04C8   11 00 00               LD   DE,0   
04CB   78                     LD   A,B   
04CC   FE 0C                  CP   PROG/256   
04CE   38 14                  JR   C,er3   
04D0   24                     INC   H   
04D1   6B                     LD   L,E   ; HL = PROG
04D2   13           ER1:      INC   DE   ; a new line starts at HL
04D3   E5                     PUSH   HL   
04D4   7D           ER2:      LD   A,L   
04D5   91                     SUB   C   
04D6   7C                     LD   A,H   
04D7   98                     SBC   A,B   
04D8   30 09                  JR   NC,er2x   ; reached the place
04DA   7E                     LD   A,(HL)   
04DB   23                     INC   HL   
04DC   FE 0A                  CP   10   
04DE   20 F4                  JR   NZ,er2   
04E0   F1                     POP   AF   
04E1   18 EF                  JR   er1   
04E3   E1           ER2X:     POP   HL   
04E4   C5           ER3:      PUSH   BC   
04E5   E5                     PUSH   HL   
04E6   EB                     EX   DE,HL   
04E7   CD 94 03               CALL   pdec   ; the line
04EA   3E 2C                  LD   A,","   
04EC   EF                     RST   28h   
04ED   D1                     POP   DE   
04EE   E1                     POP   HL   
04EF   E5                     PUSH   HL   
04F0   B7                     OR   A   
04F1   ED 52                  SBC   HL,DE   
04F3   23                     INC   HL   
04F4   CD 94 03               CALL   pdec   ; the column
04F7   CD 8A 05               CALL   pnl   
04FA   22                     DB   22h   
04FB   E1                     POP   HL   ; the text, as it is: 16 characters, or fewer
04FC   06 10                  LD   B,16   ;   if the line or the program ends first
04FE   7E           ER4:      LD   A,(HL)   
04FF   23                     INC   HL   
0500   B7                     OR   A   
0501   28 0F                  JR   Z,er5   
0503   FE 0D                  CP   13   
0505   28 0B                  JR   Z,er5   
0507   FE 0A                  CP   10   
0509   28 07                  JR   Z,er5   
050B                          ENDIF      
050B                          IF   CHECKED*CPM   
050B   FE 1A                  CP   1Ah   ; (the ^Z that pads a file's last record ends
050D   28 03                  JR   Z,er5   ;   the text too: some terminals clear the
050F                          ENDIF      ;   screen on it)
050F                          IF   CHECKED   
050F   EF                     RST   28h   
0510   10 EC                  DJNZ   er4   
0512                ER5:         ; (without the editor: on into pstk)
0512                          ENDIF      
0512                          IF   CHECKED*EDITOR   
0512   CD 1C 05               CALL   pstk   
0515   CD 8A 05               CALL   pnl   
0518   22                     DB   22h   
0519   C3 D6 05               JP   edit0   ; back to the editor, with both stacks cleared
051C                          ENDIF      
051C                             ; =============================================================================
051C                             ;  Routines that the checked build's report and the editor share
051C                             ; =============================================================================
051C                SPADJ:    EQU   2*EDITOR   ; (with the editor pstk is called, not fallen
051C                             ;   into: the stack is one address deeper)
051C                          IF   CHECKED+EDITOR   
051C                             ; pstk: the two stack lines:  Stk n: the top 8 cells at most, bottom to top
051C                             ;                             Rtn n
051C                             ; TOS must be in memory with the rest (pushed). In a build without the
051C                             ; editor this is the end of `error`, which runs on into it.
051C   CD 8A 05     PSTK:     CALL   pnl   
051F   53 74 6B 20 22         DB   "Stk ",22h   
0524   21 F8 0A               LD   HL,DSTOP-2-SPADJ   ; (the cell at DSTOP-2 was pushed with the
0527   B7                     OR   A   ;   first value and holds nothing)
0528   ED 72                  SBC   HL,SP   
052A   CD 6D 05               CALL   phalf   ; the depth
052D   3E 3A                  LD   A,":"   
052F   EF                     RST   28h   
0530   79                     LD   A,C   
0531   FE 09                  CP   9   
0533   38 0A                  JR   C,er6   
0535   CD 90 05               CALL   pmsg   
0538   20 2E 2E 2E 22         DB   " ...",22h   
053D   0E 08                  LD   C,8   
053F   26 00        ER6:      LD   H,0   ; C = the number of cells to show
0541   69                     LD   L,C   
0542   29                     ADD   HL,HL   
0543   39                     ADD   HL,SP   ; HL -> just above the deepest of them
0544                          ENDIF      
0544                          IF   EDITOR   
0544   23                     INC   HL   
0545   23                     INC   HL   
0546                          ENDIF      
0546                          IF   CHECKED+EDITOR   
0546   0C                     INC   C   
0547   0D           ER7:      DEC   C   
0548   28 11                  JR   Z,er8   
054A   2B                     DEC   HL   
054B   56                     LD   D,(HL)   
054C   2B                     DEC   HL   
054D   5E                     LD   E,(HL)   
054E   E5                     PUSH   HL   
054F   C5                     PUSH   BC   
0550   3E 20                  LD   A," "   
0552   EF                     RST   28h   
0553   EB                     EX   DE,HL   
0554   CD 8C 03               CALL   psgn   
0557   C1                     POP   BC   
0558   E1                     POP   HL   
0559   18 EC                  JR   er7   
055B   CD 8A 05     ER8:      CALL   pnl   
055E   52 74 6E 20 22         DB   "Rtn ",22h   
0563   D9                     EXX      
0564   E5                     PUSH   HL   
0565   D9                     EXX      
0566   D1                     POP   DE   
0567   21 E0 09               LD   HL,RSTOP   
056A   B7                     OR   A   
056B   ED 52                  SBC   HL,DE   
056D                          ENDIF      
056D                          IF   CHECKED*(1-EDITOR)   
                              CALL   phalf   
                              CALL   pnl   
                              DB   22h   
                              JP   endprog   
056D                          ENDIF      
056D                          IF   CHECKED+EDITOR   
056D                             ; phalf: print half of HL, and leave it in C. (With the editor, pstk ends by
056D                             ; running on into this.)
056D   CB 3C        PHALF:    SRL   H   
056F   CB 1D                  RR   L   
0571   E5                     PUSH   HL   
0572   CD 94 03               CALL   pdec   
0575   C1                     POP   BC   
0576   C9                     RET      
0577                             ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
0577                             ; "$", and the texts of the report and the editor). In the checked build a
0577                             ; NUL first is an error: Q.
0577   7E           PRSTR:    LD   A,(HL)   
0578   23                     INC   HL   
0579   FE 22                  CP   22h   
057B   C8                     RET   Z   
057C                          ENDIF      
057C                          IF   CHECKED   
057C   B7                     OR   A   
057D   28 17                  JR   Z,e_dollar   
057F                          ENDIF      
057F                          IF   CHECKED+EDITOR   
057F   FE 2F                  CP   "/"   
0581   20 04                  JR   NZ,prs1   
0583   7E                     LD   A,(HL)   
0584   23                     INC   HL   
0585   E6 BF                  AND   0BFh   
0587   EF           PRS1:     RST   28h   
0588   18 ED                  JR   prstr   
058A                             ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
058A                             ; pnl: the same, on a new line.
058A   3E 0D        PNL:      LD   A,13   
058C   EF                     RST   28h   
058D   3E 0A                  LD   A,10   
058F   EF                     RST   28h   
0590   E3           PMSG:     EX   (SP),HL   
0591   CD 77 05               CALL   prstr   
0594   E3                     EX   (SP),HL   
0595   C9                     RET      
0596                          ENDIF      
0596                          IF   CHECKED   
0596   D1           E_DOLLAR:   POP   DE   ; "$" ran into a NUL: drop the return address,
0597   E1                     POP   HL   ;   and put the string's address back in TOS
0598   3E 51                  LD   A,"Q"   
059A   C3 B1 04               JP   error   
059D                          ENDIF      
059D                             ; =============================================================================
059D                             ;  The line editor (EDITOR = 1)
059D                             ; 
059D                             ;  The interpreter starts here, and a program that ends comes back here.
059D                             ;  There is no prompt. It follows the spec's suggested standard for a line
059D                             ;  editor (docs/b8script.md, Environments). Type a line and press Return:
059D                             ; 
059D                             ;    n text    put the text in as line n; the lines from n on move down. A
059D                             ;              number past the end (or 0) adds the line at the end.
059D                             ;    n         take line n out
059D                             ;    anything else is run at once, as B8Script. (Start such a line with a
059D                             ;    space if it would begin with a digit.)
059D                             ; 
059D                             ;  A command key ends the line too, and takes what was typed as its argument:
059D                             ; 
059D                             ;    ^G        run the program
059D                             ;    n ^L      list from line n (no number: all of it). Any key holds the
059D                             ;              list until another key is pressed; Ctrl-C ends it.
059D                             ;    n ^E      put line n in the input line; Return puts it back, changed
059D                             ;    name ^R   read. CP/M: the file of that name (no name: the same file as
059D                             ;              last time). Generic: what is typed, or pasted, from now until
059D                             ;              ^Z replaces the program; it is not echoed.
059D                             ;    name ^W   write. CP/M: to that file (no name: the same file as last
059D                             ;              time). Generic: the text is printed, as it is.
059D                             ;    ^N ^N     new: no program (the key twice in a row)
059D                             ;    ^V        view: the build, both stacks, and the program's size, lines
059D                             ;              and free memory
059D                             ;    ^X        leave (to LEAVE)
059D                             ; 
059D                             ;  In the line: ^B and ^F, or the left and right arrow keys, move the cursor;
059D                             ;  a character goes in at the cursor; Backspace and DEL take out the one
059D                             ;  before it; Esc drops the line. Only CR, LF, BS and printing characters are
059D                             ;  sent to the terminal, so any terminal will do.
059D                             ; 
059D                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
059D                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
059D                             ;  125 characters; the one character after a line number separates it from
059D                             ;  the text and is not stored. The text is kept as it is typed, each line
059D                             ;  ending in CR LF, at PROG.
059D                             ; 
059D                             ;  What lasts from one line to the next: the program, the words, the
059D                             ;  variables and the data stack. An error or a break clears both stacks. The
059D                             ;  return stack starts empty for every line.
059D                             ; 
059D                             ;  Things to know:
059D                             ;    - Reset empties the program (generic builds).
059D                             ;    - A word's address points into the program, so run the program again
059D                             ;      after editing it.
059D                             ;    - Nothing is printed between a program's output and what is typed next.
059D                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
059D                             ;      a line that calls -n? and carries on afterwards runs what was typed.
059D                             ;      (The stored program never comes back to the line, so it may.)
059D                             ;    - The editor"s own keys are not the program"s: -n? is the plain line
059D                             ;      read of the other builds (BDOS 10 under CP/M).
059D                             ; 
059D                             ;  The data stack is the CPU's stack, so the editor works on top of whatever
059D                             ;  the last line left there, with TOS pushed like the rest.
059D                             ; =============================================================================
059D                          IF   EDGEN   
                    INIT:        ; reset (A = 0)
059D                          ENDIF      
059D                          IF   EDGEN*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at 0, and
                                 ; every word cell holds 0000h, the address an undefined word is caught at
                                 ; (see e_hi).
                              LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
059D                          ENDIF      
059D                          IF   EDGEN   
                              JR   edit0   
059D                          ENDIF      
059D                          IF   EDITOR   
059D                             ; ^B, left arrow: the cursor goes one to the left
059D   7D           LEFT:     LD   A,L   
059E   87                     ADD   A,A   
059F   28 4D                  JR   Z,ed1   ; (L = 80h: at the start)
05A1   2D                     DEC   L   
05A2   3E 08                  LD   A,8   
05A4   EF           LF1:      RST   28h   
05A5   18 47                  JR   ed1   
05A7                             ; ^F, right arrow: one to the right, by printing the character there
05A7   7D           RIGHT:    LD   A,L   
05A8   BB                     CP   E   
05A9   28 43                  JR   Z,ed1   ; at the end
05AB   7E                     LD   A,(HL)   
05AC   2C                     INC   L   
05AD   18 F5                  JR   lf1   
05AF                             ; Esc: alone it drops the line. An arrow key sends Esc [ and a letter, so
05AF                             ; wait about 5 ms for a second key: after a "[" read on to the letter that
05AF                             ; ends the sequence, and act on C (right) and D (left).
05AF   01 C8 00     ESC:      LD   BC,5*MSLOOP   
05B2   CD 1A 04     ES1:      CALL   rawk   
05B5   20 0A                  JR   NZ,es2   
05B7   0B                     DEC   BC   
05B8   78                     LD   A,B   
05B9   B1                     OR   C   
05BA   20 F6                  JR   NZ,es1   
05BC   CD 23 06               CALL   fin   ; no second key: the line is dropped
05BF   18 1B                  JR   edit   
05C1   FE 5B        ES2:      CP   "["   
05C3   20 29                  JR   NZ,ed1   ; not a sequence known here
05C5   CD 7C 06     ES3:      CALL   ekey   
05C8   FE 40                  CP   40h   
05CA   38 F9                  JR   C,es3   ; (its parameters)
05CC   FE 43                  CP   "C"   
05CE   28 D7                  JR   Z,right   
05D0   FE 44                  CP   "D"   
05D2   28 C9                  JR   Z,left   
05D4   18 18                  JR   ed1   
05D6                             ; edit0: reset, an error or a break: both stacks are cleared.
05D6                             ; skend: a program that ended inside skip: its return address goes.
05D6                             ; edend: a program that ended: TOS joins the rest of the data stack.
05D6   31 FA 0A     EDIT0:    LD   SP,DSTOP-2   ; empty (the cell that stands for TOS is pushed)
05D9   21                     DB   21h   ; (LD HL,nn: steps over the next two bytes)
05DA   D1           SKEND:    POP   DE   
05DB   E5           EDEND:    PUSH   HL   
05DC                             ; edit: start a new input line.
05DC   D9           EDIT:     EXX      
05DD   21 E0 09               LD   HL,RSTOP   ; the return stack is empty
05E0   D9                     EXX      
05E1   21 00 00               LD   HL,0   
05E4   22 7A 0B               LD   (KEYBUF),HL   ; no key is held, and the break key is on
05E7   22 3A 0B               LD   (EDLN),HL   ; no line is being edited
05EA   21 80 0B               LD   HL,LINEBUF   ; HL = the cursor,
05ED   5D                     LD   E,L   ;   E = the end of the line (its low byte)
05EE   CD 7C 06     ED1:      CALL   ekey   
05F1   FE 7F                  CP   7Fh   
05F3   28 40                  JR   Z,bsp   ; DEL
05F5   FE 20                  CP   " "   
05F7   30 56                  JR   NC,insc   
05F9   FE 09                  CP   9   
05FB   28 52                  JR   Z,insc   ; Tab is text
05FD   FE 08                  CP   8   
05FF   28 34                  JR   Z,bsp   
0601   FE 02                  CP   2   
0603   28 98                  JR   Z,left   ; ^B
0605   FE 06                  CP   6   
0607   28 9E                  JR   Z,right   ; ^F
0609   FE 1B                  CP   1Bh   
060B   28 A2                  JR   Z,esc   
060D   E5                     PUSH   HL   ; a command key? Look it up
060E   21 82 06               LD   HL,cmds   
0611   06 09                  LD   B,NCMD   
0613   BE           ED2:      CP   (HL)   
0614   23                     INC   HL   
0615   28 07                  JR   Z,ed3   
0617   23                     INC   HL   
0618   23                     INC   HL   
0619   10 F8                  DJNZ   ed2   
061B   E1                     POP   HL   
061C   18 D0                  JR   ed1   ; no: the key is ignored
061E   7E           ED3:      LD   A,(HL)   
061F   23                     INC   HL   
0620   66                     LD   H,(HL)   
0621   6F                     LD   L,A   
0622   E3                     EX   (SP),HL   ; the command's address: fin returns to it
0623                             ; fin: end the input line: CR LF and a NUL after it, and a new line on the
0623                             ; terminal. Leaves BC -> the line and HL -> the NUL.
0623   26 0B        FIN:      LD   H,LETPAGE   
0625   6B                     LD   L,E   
0626   36 0D                  LD   (HL),13   
0628   2C                     INC   L   
0629   36 0A                  LD   (HL),10   
062B   2D                     DEC   L   
062C   CD FE 07               CALL   prl   ; (prints the CR LF)
062F   36 00                  LD   (HL),0   
0631   01 80 0B               LD   BC,LINEBUF   
0634   C9                     RET      
0635                             ; Backspace, DEL: the character before the cursor goes. The cursor moves
0635                             ; left, the rest of the line moves down over it, and the last place (now a
0635                             ; space) is printed over along with the rest.
0635   7D           BSP:      LD   A,L   
0636   87                     ADD   A,A   
0637   28 B5                  JR   Z,ed1   ; at the start
0639   2D                     DEC   L   
063A   3E 08                  LD   A,8   
063C   EF                     RST   28h   
063D   E5                     PUSH   HL   
063E   2C           BS1:      INC   L   
063F   7E                     LD   A,(HL)   
0640   2D                     DEC   L   
0641   77                     LD   (HL),A   
0642   2C                     INC   L   
0643   7D                     LD   A,L   
0644   BB                     CP   E   
0645   20 F7                  JR   NZ,bs1   
0647   2D                     DEC   L   
0648   36 20                  LD   (HL)," "   
064A   E1                     POP   HL   
064B   53                     LD   D,E   
064C   1D                     DEC   E   
064D   18 15                  JR   ic2   
064F                             ; A character goes in at the cursor: it ripples up through the rest of the
064F                             ; line, the cursor moves on, and the rest is printed again.
064F   47           INSC:     LD   B,A   
0650   7B                     LD   A,E   
0651   FE FD                  CP   0FDh   
0653   28 99                  JR   Z,ed1   ; the line is full: 125 characters
0655   78                     LD   A,B   
0656   EF                     RST   28h   
0657   E5                     PUSH   HL   
0658   7E           IC1:      LD   A,(HL)   
0659   70                     LD   (HL),B   
065A   47                     LD   B,A   
065B   7D                     LD   A,L   
065C   2C                     INC   L   
065D   BB                     CP   E   
065E   20 F8                  JR   NZ,ic1   
0660   E1                     POP   HL   
0661   2C                     INC   L   
0662   1C                     INC   E   
0663   53                     LD   D,E   
0664   CD 69 06     IC2:      CALL   tail   
0667   18 85                  JR   ed1   
0669                             ; tail: print the line from the cursor to D (a low byte), and bring the
0669                             ; cursor back with backspaces. Nothing at all if the cursor is at D.
0669   4D           TAIL:     LD   C,L   
066A   7D           TA1:      LD   A,L   
066B   BA                     CP   D   
066C   28 05                  JR   Z,ta2   
066E   7E                     LD   A,(HL)   
066F   EF                     RST   28h   
0670   2C                     INC   L   
0671   18 F7                  JR   ta1   
0673   7D           TA2:      LD   A,L   
0674   B9                     CP   C   
0675   C8                     RET   Z   
0676   3E 08                  LD   A,8   
0678   EF                     RST   28h   
0679   2D                     DEC   L   
067A   18 F7                  JR   ta2   
067C                             ; ekey: wait for a key
067C   CD 1A 04     EKEY:     CALL   rawk   
067F   28 FB                  JR   Z,ekey   
0681   C9                     RET      
0682                             ; The command keys, and where each goes (after fin).
0682   0D           CMDS:     DB   13   
0683   DC 06                  DW   cret   
0685   07                     DB   7   ; ^G
0686   24 07                  DW   crun   
0688   0C                     DB   12   ; ^L
0689   3A 07                  DW   clist   
068B   05                     DB   5   ; ^E
068C   AB 06                  DW   cedln   
068E   12                     DB   18   ; ^R
068F   07 08                  DW   cread   
0691   17                     DB   23   ; ^W
0692   10 08                  DW   cwrite   
0694   0E                     DB   14   ; ^N
0695   9D 06                  DW   cnew   
0697   16                     DB   22   ; ^V
0698   6C 07                  DW   cview   
069A   18                     DB   24   ; ^X
069B   00 00                  DW   LEAVE   
069D                NCMD:     EQU   9   
069D                             ; ^N ^N: no program, if the next key is ^N too
069D   CD 7C 06     CNEW:     CALL   ekey   
06A0   FE 0E                  CP   14   
06A2   20 04                  JR   NZ,ged0   
06A4   AF                     XOR   A   
06A5   32 00 0C               LD   (PROG),A   
06A8   C3 DC 05     GED0:     JP   edit   
06AB                             ; ^E: line n goes into the input line, to be changed. EDLN remembers which
06AB                             ; line it was: Return puts the text back in its place.
06AB   CD 28 03     CEDLN:    CALL   rdnum   
06AE   E5                     PUSH   HL   
06AF   CD E6 07               CALL   find   ; HL -> the line, or the NUL if there is none
06B2   D1                     POP   DE   
06B3   7E                     LD   A,(HL)   
06B4   B7                     OR   A   
06B5   28 F1                  JR   Z,ged0   
06B7   ED 53 3A 0B            LD   (EDLN),DE   
06BB   11 80 0B               LD   DE,LINEBUF   
06BE   7E           CE1:      LD   A,(HL)   
06BF   FE 0D                  CP   13   
06C1   28 0C                  JR   Z,ce2   
06C3   FE 0A                  CP   10   
06C5   28 08                  JR   Z,ce2   
06C7   12                     LD   (DE),A   
06C8   23                     INC   HL   
06C9   1C                     INC   E   
06CA   7B                     LD   A,E   
06CB   FE FD                  CP   0FDh   ; (a longer line is cut at 125 characters)
06CD   20 EF                  JR   NZ,ce1   
06CF   21 80 0B     CE2:      LD   HL,LINEBUF   ; show it; the cursor ends up at its end
06D2   7D           CE3:      LD   A,L   
06D3   BB                     CP   E   
06D4   CA EE 05               JP   Z,ed1   
06D7   7E                     LD   A,(HL)   
06D8   EF                     RST   28h   
06D9   2C                     INC   L   
06DA   18 F6                  JR   ce3   
06DC                             ; Return. If ^E put a line here, the text goes back in its place. If not:
06DC                             ; a number and text is a line to put in, a number alone a line to take out,
06DC                             ; and anything else is run where it is.
06DC   E5           CRET:     PUSH   HL   ; the end of what was typed
06DD   2A 3A 0B               LD   HL,(EDLN)   
06E0   7C                     LD   A,H   
06E1   B5                     OR   L   
06E2   28 07                  JR   Z,cr1   
06E4   E5                     PUSH   HL   
06E5   CD D6 07               CALL   delln   
06E8   E1                     POP   HL   
06E9   18 13                  JR   ins   
06EB   CD 28 03     CR1:      CALL   rdnum   ; HL = the number it starts with, BC -> after
06EE   79                     LD   A,C   ; C is still 80h if there was no number:
06EF   87                     ADD   A,A   ;   only then is twice it 0
06F0   28 36                  JR   Z,st0p   ; no number: run the line
06F2   0A                     LD   A,(BC)   
06F3   FE 0D                  CP   13   
06F5   20 06                  JR   NZ,cr2   
06F7   D1                     POP   DE   ; the number alone: take that line out
06F8   CD D6 07               CALL   delln   
06FB   18 24                  JR   gedit   
06FD   03           CR2:      INC   BC   ; step over the one character after the number
06FE                             ; Put the text at BC in as line n (in HL): open a gap of its length there,
06FE                             ; CR and LF included, and copy it in.
06FE   CD E6 07     INS:      CALL   find   ; HL -> where it goes
0701   D1                     POP   DE   ; the end of what was typed
0702   7B                     LD   A,E   
0703   91                     SUB   C   ; A = the length of the text, with its CR LF
0704   C5                     PUSH   BC   ; the text
0705   4F                     LD   C,A   
0706   06 00                  LD   B,0   
0708   C5                     PUSH   BC   ; its length
0709   54                     LD   D,H   
070A   5D                     LD   E,L   ; DE = where it goes
070B   AF                     XOR   A   
070C   4F                     LD   C,A   ; BC = 0: CPIR looks as far as it needs to
070D   ED B1                  CPIR      ; HL -> one past the program's NUL
070F   ED 52                  SBC   HL,DE   ; the number of bytes to move up, NUL included
0711   44                     LD   B,H   
0712   4D                     LD   C,L   
0713   19                     ADD   HL,DE   
0714   2B                     DEC   HL   ; HL -> the NUL
0715   EB                     EX   DE,HL   
0716   E3                     EX   (SP),HL   ; HL = the length; where it goes is kept
0717   E5                     PUSH   HL   
0718   19                     ADD   HL,DE   ; the NUL's new place
0719   EB                     EX   DE,HL   
071A   ED B8                  LDDR      ; move the rest of the program up
071C   C1                     POP   BC   ; the length
071D   D1                     POP   DE   ; where it goes
071E   E1                     POP   HL   ; the text
071F   ED B0                  LDIR      
0721   C3 DC 05     GEDIT:    JP   edit   
0724                             ; ^G: run the program. st0p: run the typed line (BC -> it).
0724   01 00 0C     CRUN:     LD   BC,PROG   
0727   3E                     DB   3Eh   ; (LD A,n: steps over the POP)
0728   E1           ST0P:     POP   HL   ; (the end of what was typed)
0729                             ; st0: start running at BC. The heap starts after the stored program's NUL.
0729   21 00 0C     ST0:      LD   HL,PROG   
072C   AF                     XOR   A   
072D   BE           ST1:      CP   (HL)   
072E   23                     INC   HL   
072F   20 FC                  JR   NZ,st1   
0731   22 7C 0B               LD   (HEAP),HL   
0734                          ENDIF      
0734                          IF   EDITOR*CHECKED   
0734   E7                     RST   20h   ; minus the heap"s first address: "_' may not
0735   22 38 0B               LD   (NPEND),HL   ;   release below it
0738                          ENDIF      
0738                          IF   EDITOR   
0738   E1                     POP   HL   ; TOS: the data stack is as the last line left it
0739   F7                     RST   30h   ; (its return address is thrown away)
073A                             ; ^L: list from line n. DE = the number of the line at HL.
073A   CD 28 03     CLIST:    CALL   rdnum   ; HL = n, or 0 if there was none:
073D   7C                     LD   A,H   
073E   B5                     OR   L   
073F   20 01                  JR   NZ,li0   
0741   2C                     INC   L   ;   then from line 1
0742   E5           LI0:      PUSH   HL   
0743   CD E6 07               CALL   find   
0746   D1                     POP   DE   
0747   7E           LI1:      LD   A,(HL)   
0748   B7                     OR   A   
0749   28 D6                  JR   Z,gedit   ; the end of the text
074B   CD 1A 04               CALL   rawk   
074E   28 0B                  JR   Z,li3   ; no key: carry on
0750   FE 03                  CP   3   
0752   28 CD                  JR   Z,gedit   ; Ctrl-C
0754   CD 7C 06               CALL   ekey   ; any other key: wait for one more
0757   FE 03                  CP   3   
0759   28 C6                  JR   Z,gedit   
075B   E5           LI3:      PUSH   HL   
075C   D5                     PUSH   DE   
075D   EB                     EX   DE,HL   
075E   CD 94 03               CALL   pdec   ; the line's number,
0761   3E 20                  LD   A," "   
0763   EF                     RST   28h   ;   a space,
0764   D1                     POP   DE   
0765   E1                     POP   HL   
0766   13                     INC   DE   
0767   CD FE 07               CALL   prl   ;   and the line
076A   18 DB                  JR   li1   
076C                             ; ^V: view.
076C   CD 90 05     CVIEW:    CALL   pmsg   
076F   42 38 53 5A 38 30 45   DB   "B8SZ80E"   
0776                          ENDIF      
0776                          IF   EDITOR*CHECKED   
0776   43                     DB   "C"   
0777                          ENDIF      
0777                          IF   EDITOR   
0777   20 32 30 32 36 2D 31 31 2D 32 31 22 DB   " 2026-11-21",22h   
0783   CD 1C 05               CALL   pstk   ; both stacks
0786   21 00 0C               LD   HL,PROG   
0789   11 00 00               LD   DE,0   
078C   7E           CV1:      LD   A,(HL)   ; count the lines, and find the end
078D   B7                     OR   A   
078E   28 08                  JR   Z,cv2   
0790   23                     INC   HL   
0791   FE 0A                  CP   10   
0793   20 F7                  JR   NZ,cv1   
0795   13                     INC   DE   
0796   18 F4                  JR   cv1   
0798   E5           CV2:      PUSH   HL   ; the NUL
0799   D5                     PUSH   DE   ; the lines
079A   11 00 F4               LD   DE,(0-PROG)&0FFFFh   
079D   19                     ADD   HL,DE   
079E   CD 8A 05               CALL   pnl   
07A1   50 72 6F 67 20 22      DB   "Prog ",22h   
07A7   CD 94 03               CALL   pdec   ; the program's size
07AA   E1                     POP   HL   
07AB   CD 8A 05               CALL   pnl   
07AE   4C 69 6E 65 73 20 22   DB   "Lines ",22h   
07B5   CD 94 03               CALL   pdec   
07B8   D1                     POP   DE   
07B9                          ENDIF      
07B9                          IF   EDGEN   
                              LD   HL,HEAPLIM*256-1   
07B9                          ENDIF      
07B9                          IF   EDITOR*CPM   
07B9   3A 07 00               LD   A,(0007h)   ; the BDOS page is the limit
07BC   67                     LD   H,A   
07BD   2E 00                  LD   L,0   
07BF   2B                     DEC   HL   
07C0                          ENDIF      
07C0                          IF   EDITOR   
07C0   B7                     OR   A   
07C1   ED 52                  SBC   HL,DE   
07C3   CD 8A 05               CALL   pnl   
07C6   46 72 65 65 20 22      DB   "Free ",22h   
07CC   CD 94 03               CALL   pdec   ; the room left for text and heap
07CF   CD 8A 05               CALL   pnl   
07D2   22                     DB   22h   
07D3   C3 DC 05     GED1:     JP   edit   
07D6                             ; delln: take line n (in HL) out: copy everything after it down over it.
07D6   CD E6 07     DELLN:    CALL   find   
07D9   54                     LD   D,H   
07DA   5D                     LD   E,L   
07DB   CD F4 07               CALL   nxl   ; HL -> the next line
07DE   7E           DE1:      LD   A,(HL)   
07DF   12                     LD   (DE),A   
07E0   23                     INC   HL   
07E1   13                     INC   DE   
07E2   B7                     OR   A   
07E3   20 F9                  JR   NZ,de1   
07E5   C9                     RET      
07E6                             ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
07E6                             ; of the text if there are fewer lines (or the number is 0). Keeps BC.
07E6   EB           FIND:     EX   DE,HL   
07E7   21 00 0C               LD   HL,PROG   
07EA   1B           FI1:      DEC   DE   
07EB   7A                     LD   A,D   
07EC   B3                     OR   E   
07ED   C8                     RET   Z   
07EE   CD F4 07               CALL   nxl   
07F1   20 F7                  JR   NZ,fi1   
07F3   C9                     RET      
07F4                             ; nxl: step HL over one line, to just past its LF (and return not-zero), or
07F4                             ; stop at the NUL that ends the text (and return zero).
07F4   7E           NXL:      LD   A,(HL)   
07F5   B7                     OR   A   
07F6   C8                     RET   Z   
07F7   23                     INC   HL   
07F8   FE 0A                  CP   10   
07FA   20 F8                  JR   NZ,nxl   
07FC   B7                     OR   A   
07FD   C9                     RET      
07FE                             ; prl: print the line at HL, to its LF; HL -> just past it.
07FE   7E           PRL:      LD   A,(HL)   
07FF   EF                     RST   28h   
0800   7E                     LD   A,(HL)   
0801   23                     INC   HL   
0802   FE 0A                  CP   10   
0804   20 F8                  JR   NZ,prl   
0806   C9                     RET      
0807                          ENDIF      
0807                          IF   EDGEN   
                                 ; ^R, generic: what comes in from now until ^Z is the program. A CR is
                                 ; stored as CR LF; a LF right after a line end is dropped (it is the CR's
                                 ; own, or an empty line's), and a LF anywhere else ends a line too. A last
                                 ; line with no end is given one. Nothing is echoed, and there is no check
                                 ; for running out of memory.
                    CREAD:    LD   HL,PROG-1   
                              LD   A,10   
                              DB   0FEh   ; (CP n: steps over the LD A,13)
                    RD1:      LD   A,13   ; a LF alone ends a line
                    RD2:      LD   (HL),A   
                              INC   HL   
                              CP   13   
                              LD   A,10   
                              JR   Z,rd2   ; after a CR goes a LF
                    RD3:      CALL   ekey   
                              CP   1Ah   
                              JR   Z,rd4   
                              CP   10   
                              JR   NZ,rd2   
                              DEC   HL   
                              CP   (HL)   
                              INC   HL   
                              JR   Z,rd3   ; (the LF is dropped)
                              JR   rd1   
                    RD4:      DEC   HL   
                              LD   A,(HL)   
                              INC   HL   
                              CP   10   
                              JR   Z,rd5   
                              LD   (HL),13   
                              INC   HL   
                              LD   (HL),10   
                              INC   HL   
                    RD5:      LD   (HL),0   
                              JR   ged1   
                                 ; ^W, generic: the text is printed as it is, for the terminal to capture.
                    CWRITE:   LD   HL,PROG   
                    CW1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,ged1   
                              RST   28h   
                              INC   HL   
                              JR   cw1   
0807                          ENDIF      
0807                          IF   EDITOR*CPM   
0807                CFCB:     EQU   005Ch   ; the file's name is kept here, where the CCP
0807                             ;   put the one from the command line
0807                             ; ^R, CP/M: read the file. A name typed before the key is the file's name
0807                             ; from now on.
0807   CD 5E 08     CREAD:    CALL   setname   
080A   CD 9B 08               CALL   load   
080D   C3 DC 05               JP   edit   
0810                             ; ^W, CP/M: write the file: delete the old one, make it anew, write the
0810                             ; text in records of 128 bytes, and close it. The text's NUL and the 127
0810                             ; bytes after it are set to ^Z meanwhile, which pads the last record.
0810   CD 5E 08     CWRITE:   CALL   setname   
0813   CD 8A 08               CALL   fcbclr   
0816   0E 13                  LD   C,19   ; delete
0818   CD 95 08               CALL   fbdos   
081B   0E 16                  LD   C,22   ; make
081D   CD 95 08               CALL   fbdos   
0820   3C                     INC   A   
0821   CA DC 05               JP   Z,edit   ; no room in the directory
0824   21 00 0C               LD   HL,PROG   
0827   AF                     XOR   A   
0828   BE           CW1:      CP   (HL)   
0829   23                     INC   HL   
082A   20 FC                  JR   NZ,cw1   
082C   2B                     DEC   HL   ; HL -> the NUL
082D   E5                     PUSH   HL   
082E   06 80                  LD   B,128   
0830   36 1A        CW2:      LD   (HL),1Ah   
0832   23                     INC   HL   
0833   10 FB                  DJNZ   cw2   
0835   E1                     POP   HL   
0836   11 00 0C               LD   DE,PROG   
0839   7B           CW3:      LD   A,E   ; a record that starts before the end is written
083A   95                     SUB   L   
083B   7A                     LD   A,D   
083C   9C                     SBC   A,H   
083D   30 15                  JR   NC,cw4   
083F   E5                     PUSH   HL   
0840   D5                     PUSH   DE   
0841   0E 1A                  LD   C,26   ; set the DMA address: the record is written
0843   CD 05 00               CALL   BDOS   ;   from where it lies
0846   0E 15                  LD   C,21   ; write
0848   CD 95 08               CALL   fbdos   
084B   E1                     POP   HL   
084C   11 80 00               LD   DE,128   
084F   19                     ADD   HL,DE   
0850   EB                     EX   DE,HL   
0851   E1                     POP   HL   
0852   18 E5                  JR   cw3   
0854   36 00        CW4:      LD   (HL),0   ; the NUL again
0856   0E 10                  LD   C,16   ; close
0858   CD 95 08               CALL   fbdos   
085B   C3 DC 05               JP   edit   
085E                             ; setname: if a name was typed (the line does not start with its CR), put it
085E                             ; in the CFCB: up to 8 characters, a dot, up to 3 more, in capitals. The drive
085E                             ; is the current one.
085E   11 80 0B     SETNAME:   LD   DE,LINEBUF   
0861   1A                     LD   A,(DE)   
0862   FE 0D                  CP   13   
0864   C8                     RET   Z   
0865   21 5C 00               LD   HL,CFCB   
0868   36 00                  LD   (HL),0   ; the current drive
086A   06 0B                  LD   B,11   
086C   2C           SN1:      INC   L   
086D   36 20                  LD   (HL)," "   
086F   10 FB                  DJNZ   sn1   
0871   2E 5D                  LD   L,CFCB+1   
0873   1A           SN2:      LD   A,(DE)   
0874   13                     INC   DE   
0875   FE 0D                  CP   13   
0877   C8                     RET   Z   
0878   FE 2E                  CP   "."   
087A   20 04                  JR   NZ,sn3   
087C   2E 65                  LD   L,CFCB+9   ; the type
087E   18 F3                  JR   sn2   
0880   FE 61        SN3:      CP   "a"   
0882   38 02                  JR   C,sn4   
0884   E6 5F                  AND   5Fh   ; a capital
0886   77           SN4:      LD   (HL),A   
0887   2C                     INC   L   
0888   18 E9                  JR   sn2   
088A                             ; fcbclr: clear the CFCB after its name, as it must be before a file is opened
088A   21 68 00     FCBCLR:   LD   HL,CFCB+12   
088D   06 18                  LD   B,24   
088F   36 00        FC1:      LD   (HL),0   
0891   23                     INC   HL   
0892   10 FB                  DJNZ   fc1   
0894   C9                     RET      
0895                             ; fbdos: BDOS function C on the file
0895   11 5C 00     FBDOS:    LD   DE,CFCB   
0898   C3 05 00               JP   BDOS   
089B                             ; load: read the file into PROG. No such file: no program. The text ends at
089B                             ; the file"s first ^Z (1Ah), which pads a text file"s last record; one more
089B                             ; goes after the last record, so the search always stops. And every line
089B                             ; must end in LF: a last line without one is given a CR LF.
089B   CD 8A 08     LOAD:     CALL   fcbclr   
089E   0E 0F                  LD   C,15   ; open (no such file: the first read fails
08A0   CD 95 08               CALL   fbdos   ;   too)
08A3   11 00 0C               LD   DE,PROG   
08A6   D5           LD1:      PUSH   DE   
08A7   0E 1A                  LD   C,26   ; set the DMA address
08A9   CD 05 00               CALL   BDOS   
08AC   0E 14                  LD   C,20   ; read the next 128 bytes
08AE   CD 95 08               CALL   fbdos   
08B1   E1                     POP   HL   ; HL = the address this record went to
08B2   B7                     OR   A   
08B3   20 07                  JR   NZ,ld2   
08B5   11 80 00               LD   DE,128   
08B8   19                     ADD   HL,DE   
08B9   EB                     EX   DE,HL   
08BA   18 EA                  JR   ld1   
08BC   36 1A        LD2:      LD   (HL),1Ah   
08BE   21 FF 0B               LD   HL,PROG-1   
08C1   3E 0A                  LD   A,10   ; (a file with no text needs nothing added)
08C3   23           TR1:      INC   HL   
08C4   5F                     LD   E,A   ; E = the character before this one
08C5   7E                     LD   A,(HL)   
08C6   FE 1A                  CP   1Ah   
08C8   20 F9                  JR   NZ,tr1   
08CA   7B                     LD   A,E   
08CB   FE 0A                  CP   10   
08CD   28 06                  JR   Z,tr2   
08CF   36 0D                  LD   (HL),13   
08D1   23                     INC   HL   
08D2   36 0A                  LD   (HL),10   
08D4   23                     INC   HL   
08D5   36 00        TR2:      LD   (HL),0   
08D7   C9                     RET      
08D8                          ENDIF      
08D8                             ; =============================================================================
08D8                             ;  CP/M startup (the generic build starts at address 0: see st0)
08D8                             ; =============================================================================
08D8                          IF   CPM   
08D8                             ; The RAM pages follow the image; the heap may grow to the BDOS.
08D8                START:       
08D8                          ENDIF      
08D8                          IF   CPM*CHECKED   
08D8                             ; Clear the lower half of the letter page: every variable starts at
08D8                             ; 0, every word cell holds 0000h, the address an undefined word is
08D8                             ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
08D8                             ; is held back.
08D8   21 00 0B               LD   HL,LET   
08DB   AF                     XOR   A   
08DC   77           INI1:     LD   (HL),A   
08DD   2C                     INC   L   
08DE   F2 DC 08               JP   P,ini1   ; +00h to +7Fh
08E1                          ENDIF      
08E1                          IF   CPM   
08E1   21 08 01               LD   HL,vecs   ; the RST routines go down into page zero
08E4   11 08 00               LD   DE,0008h   
08E7   01 2C 00               LD   BC,vecend-vecs   
08EA   ED B0                  LDIR      
08EC                          ENDIF      
08EC                          IF   CPM*EDITOR   
08EC   CD 9B 08               CALL   load   ; the file named on the command line
08EF   C3 D6 05               JP   edit0   
08F2                          ENDIF      
08F2                          IF   CPM*(1-EDITOR)   
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:      LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
                              JP   st2   
08F2                          ENDIF      
08F2                          IF   CPM   
08F2                             ; RAM pages, after the image
08F2                RSPAGE:   EQU   (imgend + 255) / 256   
08F2                DSPAGE:   EQU   RSPAGE + 1   
08F2                LETPAGE:   EQU   RSPAGE + 2   
08F2                PROG:     EQU   LETPAGE*256 + 256   
08F2                          ENDIF      
08F2                IMGEND:      


