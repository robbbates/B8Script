0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Motorola 6809
0000                             ;  Spec: docs/b8script.md (2026-11-23).
0000                             ;  Follows the design of the Z80 interpreter (z80/b8s-z80.asm).
0000                             ; 
0000                             ;  Two builds, selected by the CHECKED line below (CPM is always 0: the 6809
0000                             ;  has no CP/M; the line is kept only so that build.sh works):
0000                             ;    CHECKED  0 = no checks (spec: an unchecked build checks nothing)
0000                             ;             1 = a checked build: variables start at 0, words start
0000                             ;                 undefined, and every error in the spec's table stops the
0000                             ;                 program with the three-line report, then goes to EXIT:
0000                             ;                   Err X @ line,col
0000                             ;                   Stk n: ... v v v      (n = depth, then the top 8 values)
0000                             ;                   Rtn n
0000                             ;                 S/s data stack over/underflow, R/r return stack over/
0000                             ;                 underflow, H heap, O store outside the program's space,
0000                             ;                 W bad character after [, U undefined word, Q no closing
0000                             ;                 quote, X reserved byte, Z divide by zero, N unbalanced or
0000                             ;                 mismatched brackets, B Ctrl-C.
0000                             ; 
0000                             ;  A third line, ANSI, says how the four console codes (`@ `^ `_ `?) work:
0000                             ;    ANSI     1 = they send ANSI escape sequences through CONOUT
0000                             ;             0 = they call four routines of the machine's own instead:
0000                             ;                 CONAT, CONCLS, CONEOL and CONCUR (see the equates)
0000                             ; 
0000                             ;  In both builds Ctrl-C stops a running program (the unchecked build goes
0000                             ;  to EXIT without a word): see the console layer below for the rules, the
0000                             ;  held key and the break-off cell at 827Bh.
0000                             ; 
0000                             ;  Assembler: asm80, M6809 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   0   ; always 0 (no CP/M on the 6809)
0000                CHECKED:   EQU   0   ; 1 = checked build
0000                ANSI:     EQU   1   ; 1 = the console codes send ANSI sequences
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    Y    IP: the address of the next program character to read
0000                             ;    U    the data stack pointer. The stack grows down and U points at the
0000                             ;         top cell (TOS); nothing is cached in a register, because every
0000                             ;         dispatch needs A, B and X as scratch. Cells are big-endian here.
0000                             ;         (Only the stacks are big-endian: cells in RAM that the program can
0000                             ;         see - variables, the heap pointer, anything @ and ! reach - are
0000                             ;         little-endian, as the spec says, so @ and ! swap the bytes.)
0000                             ;    S    the return stack. A word call is a plain push of Y. Entries are
0000                             ;         2 bytes, big-endian. Handlers are called with JSR, so the return
0000                             ;         address of the dispatcher is on top of S while a handler runs.
0000                             ;    DP   the letter page, so the letter-page variables below cost 2-byte
0000                             ;         direct addressing. Nothing else may change DP.
0000                             ;    A B X are scratch. Every handler is entered by JSR and ends in RTS (one
0000                             ;    byte). A handler that pushes or pops the return stack first pulls the
0000                             ;    dispatcher's return address into X (PULS X) and ends with JMP ,X.
0000                             ; 
0000                             ;  Dispatch (unchecked build). PTAB holds one byte per punctuation character:
0000                             ;  the low byte of the handler's distance from PTAB. The handlers of the last
0000                             ;  characters (in code order) start within 256 bytes after PTAB, the handlers
0000                             ;  of the first NPG1 characters in the 256 bytes after that. The assembler
0000                             ;  works NPG1 out from where five handlers landed, and testing/chktab09.py
0000                             ;  checks the layout. The checked build is bigger than that reach, so its
0000                             ;  table holds whole addresses instead.
0000                             ; -----------------------------------------------------------------------------
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM areas:
0000                             ; 
0000                             ;    8000h-80FFh  return stack (S); empty = 8100h. Unchecked: 127 entries.
0000                             ;                 Checked: 112 entries (S down to 8020h); the 32 bytes below
0000                             ;                 are a guard band for what a handler and an interrupt push
0000                             ;                 on top of a full stack before the check runs.
0000                             ;    8100h-81FFh  data stack (U). Unchecked: 127 cells, empty = 8200h.
0000                             ;                 Checked: 126 cells (U from 81FCh, empty, down to 8100h):
0000                             ;                 the 4 bytes above are a guard band, so a handler that runs
0000                             ;                 on an empty stack writes there and not on the letter
0000                             ;                 cells. A push past the last cell lands on the return
0000                             ;                 stack's bottom entry (80FEh), and the program stops with S
0000                             ;                 before anything reads it.
0000                             ;    8200h-82FFh  letter page (LET): A..Z at +00h..+33h, a..z at +40h..+73h
0000                             ;                 (a word cell is always 64 bytes below its variable), the
0000                             ;                 heap pointer at +7Ch (= z10+), interpreter variables in the
0000                             ;                 gaps, and the -n? line buffer at +80h..+FFh. The break-off
0000                             ;                 cell is at +7Bh (827Bh); +7Ah is free.
0000                             ;    8300h-       PROG, the program text, NUL-terminated; the heap starts
0000                             ;                 after the NUL and grows to HEAPLIM*256 (F000h)
0000                             ;    F000h-       this image (ROM). The reset vector (FFFEh) must point to
0000                             ;                 `start` (see the listing); the image does not contain it.
0000                             ;    FF03h-FF0Bh  the console routines (CONOUT, KEY) and EXIT are supplied
0000                             ;                 by the system and need no space here.
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range LET..HEAPLIM*256.
0000                             ; -----------------------------------------------------------------------------
0000                             ; ---- generic machine: edit these to suit -----------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The Z flag must match A (end the
0000                             ;   routine with TSTA / RTS, or a plain LDA).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                             ;   Both are called with JSR. They may change A and CC and must preserve
0000                             ;   B, X, Y, U and DP.
0000                          IF   1-ANSI   
                                 ; ---- with ANSI = 0 the console codes call these (JMP or JSR) ----------------
                    CONAT:    EQU   0FF0Ch   ; `@  cursor to the row in X and the column in
                                 ;     D, both from 0
                    CONCLS:   EQU   0FF0Fh   ; `^  clear the screen and home the cursor
                    CONEOL:   EQU   0FF12h   ; `_  clear from the cursor to the end of the line
                    CONCUR:   EQU   0FF15h   ; `?  cursor off if D = 0 (the Z flag is set to
                                 ;     match), on if not
                                 ;   All four may change A, B, X and CC and must preserve Y, U and DP.
0000                          ENDIF      
0000                RSPAGE:   EQU   80h   
0000                DSPAGE:   EQU   81h   
0000                LETPAGE:   EQU   82h   
0000                PROG:     EQU   8300h   ; where the loader puts the program text
0000                             ; (the checked startup counts on it being
0000                             ; the page after LETPAGE)
0000                HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
0000                MSLOOP:   EQU   20   ; n? inner loop count for about 1 ms; tune it
0000                             ; for your clock and your KEY routine
0000                             ; letter-page layout (direct-page offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   7Ch   ; z10+, the heap pointer (little-endian)
0000                KEYBUF:   EQU   34h   ; gap after Z: a key held back by the break check
0000                COUNT:    EQU   35h   ; the break check's countdown (1 look in 256)
0000                AT:       EQU   36h   ; checked: the address of the character being
0000                             ;   run (big-endian), the place an error reports
0000                PEND:     EQU   38h   ; checked: the program's end, the first byte
0000                             ;   after its NUL (big-endian): the heap's floor
0000                SSAV:     EQU   3Ah   ; checked: S as each character starts (big-
0000                             ;   endian): the return stack an error reports
0000                SEED:     EQU   76h   ; the random seed (8276h, little-endian): the
0000                             ;   cell whose address `. gives. Nothing sets
0000                             ;   it at the start but the checked build's
0000                             ;   clearing of the page
0000                BRKOFF:   EQU   7Bh   ; the break-off cell (827Bh, z9+): 0 = the
0000                             ;   break key is on
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+100h   ; empty return stack
0000                RSLIM:    EQU   RSPAGE*256+20h   ; checked: S may go no lower between characters
0000                RSREP:    EQU   RSTOP-16   ; checked: S while the error report runs
0000                DSTOP:    EQU   DSPAGE*256+100h-4*CHECKED   ; empty data stack (a guard if checked)
0000                DSLIM:    EQU   DSPAGE*256   ; checked: U may go no lower between characters
F000                          .ORG   0F000h   
F000                             ; =============================================================================
F000                             ;  Startup
F000                             ; =============================================================================
F000   10 CE 81 00  START:    LDS   #RSTOP   
F004   CE 82 00               LDU   #DSTOP   
F007   86 82                  LDA   #LETPAGE   
F009   1F 8B                  TFR   A,DP   
F00B                          IF   CHECKED   
                                 ; Zero the whole letter page: every variable starts at 0, every word
                                 ; cell at 0 (undefined: a call stops with U), and so do the
                                 ; interpreter's own cells in the gaps (KEYBUF and the rest). A is
                                 ; still LETPAGE; 256 rounds leave X at the next page, PROG.
                              CLRB      
                              TFR   D,X   
                    SZ:       CLR   ,X+   
                              DECB      
                              BNE   sz   
F00B                          ENDIF      
F00B   10 8E 83 00            LDY   #PROG   ; the reading position
F00F                          IF   1-CHECKED   
F00F   0F 34                  CLR   <KEYBUF   ; no key held
F011   0F 7B                  CLR   <BRKOFF   ; the break key is on
F013   1F 21                  TFR   Y,X   ; the heap starts after the program's NUL
F015                          ENDIF      
F015   A6 80        SC:       LDA   ,X+   
F017   26 FC                  BNE   sc   
F019   1F 10                  TFR   X,D   
F01B   D7 7C                  STB   <HEAP   ; (little-endian)
F01D   97 7D                  STA   <HEAP+1   
F01F                          IF   CHECKED   
                              STX   <PEND   ; the heap may never go below this
F01F                          ENDIF      
F01F                             ; =============================================================================
F01F                             ;  The inner loop: read one character and sort it by range.
F01F                             ; 
F01F                             ;    00h          end of program
F01F                             ;    01h-20h, 7Fh       ignored (control, space, DEL)
F01F                             ;    80h-FFh      reserved: ignored, or X in the checked build
F01F                             ;    30h-39h      digit: read a whole number
F01F                             ;    41h-5Ah      A-Z: call the word in that letter's cell
F01F                             ;    61h-7Ah      a-z: push the address of that letter's cell
F01F                             ;    the rest     punctuation: JSR through PTAB, 32 entries, in code order
F01F                             ; =============================================================================
F01F                NEXT:        
F01F                          IF   CHECKED   
                                 ; Both stacks are checked once per character, not in every handler:
                                 ; the pointer minus its limit, taken as unsigned, must be no more
                                 ; than the stack's size. Below the limit (an overflow) it wraps to
                                 ; FFxxh, and the compare leaves N set; above the empty point (an
                                 ; underflow) it is just over the size, and N is clear.
                              LEAX   (0-DSLIM)&0FFFFh,U   
                              CMPX   #DSTOP-DSLIM   
                              BHI   e_ds   
                              LEAX   (0-RSLIM)&0FFFFh,S   
                              CMPX   #RSTOP-RSLIM   
                              BHI   e_rs   
                              STY   <AT   ; the place, should this character fail
                              STS   <SSAV   ; and the return stack, as it is now
F01F                          ENDIF      
F01F   A6 A0                  LDA   ,Y+   
F021   27 50                  BEQ   fin   ; NUL ends the program
F023   80 21                  SUBA   #21h   ; A = c - 21h
F025   25 F8                  BLO   next   ; 01h-20h ignored
F027   81 0F                  CMPA   #0Fh   
F029   25 20                  BLO   punct   ; 21h-2Fh: PTAB index 0-14
F02B   81 19                  CMPA   #19h   
F02D   25 2A                  BLO   digit   ; 30h-39h
F02F   81 20                  CMPA   #20h   
F031   25 16                  BLO   p3a   ; 3Ah-40h: A = 19h-1Fh
F033   80 20                  SUBA   #20h   ; A = c - 41h
F035   81 1A                  CMPA   #1Ah   
F037   25 2C                  BLO   upper   ; 41h-5Ah: A = letter index 0-25
F039   81 20                  CMPA   #20h   
F03B   25 0A                  BLO   p5b   ; 5Bh-60h
F03D   81 3A                  CMPA   #3Ah   
F03F   25 1E                  BLO   lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
F041   81 3E                  CMPA   #3Eh   
F043                          IF   1-CHECKED   
F043   24 DA                  BHS   next   ; 7Fh-FFh: ignored
F045                          ENDIF      
F045                          IF   CHECKED   
                              BEQ   next   ; 7Fh (DEL): ignored
                              BHI   e_resv   ; 80h-FFh: reserved
F045                          ENDIF      
F045   80 1A                  SUBA   #1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
F047   8B 06        P5B:      ADDA   #6   ; 5Bh-60h: -4 in all, index 22-27
F049   80 0A        P3A:      SUBA   #0Ah   ; 3Ah-40h: index 15-21
F04B                             ; Punctuation: A = the PTAB index.
F04B   8E F0 DE     PUNCT:    LDX   #PTAB   
F04E                          IF   1-CHECKED   
F04E                             ; The handler is at PTAB + D, where B is the table byte and A is 1
F04E                             ; for the first NPG1 characters, 0 for the rest.
F04E   E6 86                  LDB   A,X   
F050   81 14                  CMPA   #NPG1   ; carry: one of the first NPG1
F052   86 00                  LDA   #0   ; (leaves the carry alone)
F054   49                     ROLA      
F055   AD 8B                  JSR   D,X   ; the handler ends in RTS
F057                          ENDIF      
F057                          IF   CHECKED   
                              ASLA      ; the table holds whole addresses
                              JSR   [A,X]   
F057                          ENDIF      
F057   20 C6                  BRA   next   
F059                             ; Digits: step back onto the first digit and read the whole number.
F059   31 3F        DIGIT:    LEAY   -1,Y   
F05B   8D 27                  BSR   rdnum   
F05D   20 C0                  BRA   next   
F05F                             ; a-z: push the cell's address (the cell is the variable)
F05F   8D 15        LOWER:    BSR   cellx   
F061   36 10                  PSHU   X   
F063   20 BA                  BRA   next   
F065                             ; A-Z: call the word. The IP (the address after the letter) goes on the
F065                             ; return stack, and the IP becomes the address in the letter's cell.
F065                             ; Checked: a cell still 0 (high byte 0) was never defined, since every
F065                             ; address in the program's space is 8200h or more. The call has not been
F065                             ; made yet, so the report shows the stacks as they were.
F065   8D 0F        UPPER:    BSR   cellx   
F067   E6 84                  LDB   ,X   
F069   A6 01                  LDA   1,X   
F06B                          IF   CHECKED   
                              BEQ   e_undef   
F06B                          ENDIF      
F06B   34 20                  PSHS   Y   
F06D   1F 02                  TFR   D,Y   
F06F   8D 31                  BSR   pollk   ; the break check, at every word call
F071   20 AC                  BRA   next   
F073                             ; =============================================================================
F073                             ;  Checked build: the error entries.
F073                             ; 
F073                             ;  Each entry loads its letter and then hides the next entry inside a 3-byte
F073                             ;  CMPX # (the 8Ch), so that a run of them falls through to one place. The
F073                             ;  place an error reports is the address in AT, which the inner loop sets to
F073                             ;  each character before it runs it; the one error that reports another
F073                             ;  place (W, at the character after the [) changes AT before it comes.
F073                             ; 
F073                             ;  The report counts the return stack from SSAV, which the inner loop sets
F073                             ;  to S before each character, so an error may come from any depth of
F073                             ;  calls: a handler, chkst under one, or ctlc under "?" or the break check.
F073                             ;  (An r sets SSAV to the empty stack.) The inner loop's own entries are
F073                             ;  here, where its short branches reach them; those reached from a handler
F073                             ;  are after h_cstore, just ahead of the report.
F073                             ; =============================================================================
F073                          IF   CHECKED   
                                 ; ---- reached from the inner loop -------------------------------------------
                                 ; The stack checks branch here with N set for an overflow (the pointer is
                                 ; below its limit) and clear for an underflow. After an underflow that stack
                                 ; counts as empty.
                    E_DS:     BMI   e_S   
                              LDU   #DSTOP   ; s
                              LDA   #"s"   
                              BRA   eall   
                    E_RS:     BMI   e_R   
                              LDX   #RSTOP   ; r
                              STX   <SSAV   
                              LDA   #"r"   
                              FCB   8Ch   
                    E_S:      LDA   #"S"   
                              FCB   8Ch   
                    E_R:      LDA   #"R"   
                              FCB   8Ch   
                    E_RESV:   LDA   #"X"   ; a reserved byte (80h-FFh) outside a string
                              FCB   8Ch   
                    E_BREAK:   LDA   #"B"   ; Ctrl-C (from ctlc, at any depth)
                              FCB   8Ch   
                    E_UNDEF:   LDA   #"U"   ; a word never defined (its cell is still 0)
                    EALL:     JMP   error   
F073                          ENDIF      
F073   7E FF 09     FIN:      JMP   EXIT   ; the program has ended
F076                             ; cellx: A = letter index (0-25, or 32-57 for lowercase) -> X = cell address
F076   48           CELLX:    ASLA      
F077   8E 82 00               LDX   #LET   
F07A   30 86                  LEAX   A,X   
F07C   39                     RTS      
F07D                             ; isdig: A = the character at IP minus "0"; the carry is set if it is a digit
F07D   A6 A4        ISDIG:    LDA   ,Y   
F07F   80 30                  SUBA   #"0"   
F081   81 0A                  CMPA   #10   
F083   39           AB9:      RTS      
F084                             ; rdnum: read decimal digits at IP and push the value; IP is left on the
F084                             ; first non-digit. Values wrap at 16 bits, as the spec says. The running
F084                             ; value lives in the new top cell: V = V*10 + digit.
F084   4F           RDNUM:    CLRA      
F085   5F                     CLRB      
F086   36 06                  PSHU   D   
F088   8D F3        RD1:      BSR   isdig   
F08A   24 F7                  BHS   ab9   
F08C   31 21                  LEAY   1,Y   
F08E   34 02                  PSHS   A   
F090   EC C4                  LDD   ,U   
F092   58                     ASLB      
F093   49                     ROLA      
F094   58                     ASLB      
F095   49                     ROLA      
F096   E3 C4                  ADDD   ,U   ; 5V
F098   58                     ASLB      
F099   49                     ROLA      ; 10V
F09A   EB E0                  ADDB   ,S+   
F09C   89 00                  ADCA   #0   
F09E   ED C4                  STD   ,U   
F0A0   20 E6                  BRA   rd1   
F0A2                             ; =============================================================================
F0A2                             ;  Console layer: the break key. A running program reads the keyboard only
F0A2                             ;  through pollk and getk, which between them give the break key its rules:
F0A2                             ;    - Ctrl-C (03h) stops the program;
F0A2                             ;    - any other key that the break check reads is held in KEYBUF for the
F0A2                             ;      next "?", and a newer one takes its place;
F0A2                             ;    - "?" (getk) takes the held key first;
F0A2                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
F0A2                             ;      key like any other, but two of them within about 250 ms still stop it.
F0A2                             ;  On a break the unchecked build ends without a word (EXIT); the checked
F0A2                             ;  one reports B. All three keep B, X, Y and U.
F0A2                             ; =============================================================================
F0A2                             ; pollk: the break check, at every word call and every true ")" loop-back.
F0A2                             ; It looks at the keyboard only once in 256 calls.
F0A2   0A 35        POLLK:    DEC   <COUNT   
F0A4   26 37                  BNE   cc9   
F0A6   BD FF 06               JSR   KEY   
F0A9   27 32                  BEQ   cc9   ; no key
F0AB   97 34                  STA   <KEYBUF   ; held for the next "?"
F0AD   20 0C                  BRA   ctlc   
F0AF                             ; getk: a key for "?", or A = 0 with the zero flag set if there is none.
F0AF   96 34        GETK:     LDA   <KEYBUF   ; a held key goes first, and is taken out of
F0B1   0F 34                  CLR   <KEYBUF   ;   the buffer (it has been through ctlc)
F0B3   4D                     TSTA      
F0B4   26 27                  BNE   cc9   
F0B6   BD FF 06               JSR   KEY   
F0B9   27 22                  BEQ   cc9   
F0BB                             ; ctlc: a key has been read. If it is Ctrl-C and the break key is on, that
F0BB                             ; is the end. If the program has turned it off, wait about 250 ms for one
F0BB                             ; more key: a second Ctrl-C is the end too; any other key is held (the
F0BB                             ; newest wins), and the Ctrl-C goes on: A = 3, zero flag clear.
F0BB   81 03        CTLC:     CMPA   #3   
F0BD   26 1E                  BNE   cc9   
F0BF   0D 7B                  TST   <BRKOFF   
F0C1   27 B0                  BEQ   brk   
F0C3   34 10                  PSHS   X   
F0C5   8E 13 88               LDX   #250*MSLOOP   
F0C8   BD FF 06     CC1:      JSR   KEY   
F0CB   26 06                  BNE   cc2   
F0CD   30 1F                  LEAX   -1,X   
F0CF   26 F7                  BNE   cc1   
F0D1   20 06                  BRA   cc3   
F0D3   81 03        CC2:      CMPA   #3   
F0D5   27 9C                  BEQ   brk   
F0D7   97 34                  STA   <KEYBUF   
F0D9   86 03        CC3:      LDA   #3   
F0DB   35 10                  PULS   X   
F0DD   39           CC9:      RTS      
F0DE                          IF   1-CHECKED   
F0DE                BRK:      EQU   fin   ; the unchecked build stops without a word;
F0DE                          ENDIF      
F0DE                          IF   CHECKED   
                    BRK:      EQU   e_break   ;   the checked build reports B (the report
F0DE                          ENDIF      ;   takes S from SSAV, so the depth of the
F0DE                             ;   calls here doesn't matter)
F0DE                             ; =============================================================================
F0DE                             ;  Dispatch table, in code order.
F0DE                             ; 
F0DE                             ;  Unchecked build: one byte per character, the low byte of the handler's
F0DE                             ;  distance from PTAB. NPG1 is how many characters, from the start, have
F0DE                             ;  handlers more than 255 bytes past PTAB. ] \ [ @ ? sit where the two ranges
F0DE                             ;  meet (in falling code order for this), and which side each lands on is
F0DE                             ;  worked out here. (One division to a line: asm80 only rounds down when it
F0DE                             ;  stores a value.)
F0DE                             ; 
F0DE                             ;  Checked build: it has more code than the two ranges hold, so its table
F0DE                             ;  holds whole addresses and there are no rules about where handlers go.
F0DE                             ; =============================================================================
F0DE                          IF   1-CHECKED   
F0DE                PGRET:    EQU   (h_ret-PTAB)/256   ; 0 = first range, 1 = second
F0DE                PGBRK:    EQU   (h_break-PTAB)/256   
F0DE                PGDEF:    EQU   (h_def-PTAB)/256   
F0DE                PGFET:    EQU   (h_fetch-PTAB)/256   
F0DE                PGKEY:    EQU   (h_key-PTAB)/256   
F0DE                NPG1:     EQU   20 + PGKEY + PGFET + PGDEF + PGBRK + PGRET   
F0DE                          ENDIF      
F0DE                PTAB:        
F0DE                          IF   1-CHECKED   
F0DE   94                     FCB   (h_store-PTAB) & 0FFh   ; !
F0DF   13                     FCB   (h_str-PTAB) & 0FFh   ; "
F0E0   A4                     FCB   (h_num-PTAB) & 0FFh   ; #
F0E1   80                     FCB   (h_print-PTAB) & 0FFh   ; $
F0E2   6D                     FCB   (h_swap-PTAB) & 0FFh   ; %
F0E3   C9                     FCB   (h_and-PTAB) & 0FFh   ; &
F0E4   79                     FCB   (h_emit-PTAB) & 0FFh   ; '
F0E5   09                     FCB   (h_open-PTAB) & 0FFh   ; (
F0E6   2B                     FCB   (h_close-PTAB) & 0FFh   ; )
F0E7   37                     FCB   (h_mul-PTAB) & 0FFh   ; *
F0E8   D1                     FCB   (h_add-PTAB) & 0FFh   ; +
F0E9   23                     FCB   (h_cfetch-PTAB) & 0FFh   ; ,
F0EA   D8                     FCB   (h_sub-PTAB) & 0FFh   ; -
F0EB   9B                     FCB   (h_cstore-PTAB) & 0FFh   ; .
F0EC   E3                     FCB   (h_div-PTAB) & 0FFh   ; /
F0ED   74                     FCB   (h_dup-PTAB) & 0FFh   ; :
F0EE   7D                     FCB   (h_drop-PTAB) & 0FFh   ; ;
F0EF   55                     FCB   (h_lt-PTAB) & 0FFh   ; <
F0F0   61                     FCB   (h_eq-PTAB) & 0FFh   ; =
F0F1   53                     FCB   (h_gt-PTAB) & 0FFh   ; >
F0F2   E6                     FCB   (h_key-PTAB) & 0FFh   ; ?
F0F3   E0                     FCB   (h_fetch-PTAB) & 0FFh   ; @
F0F4   A5                     FCB   (h_def-PTAB) & 0FFh   ; [
F0F5   98                     FCB   (h_break-PTAB) & 0FFh   ; \
F0F6   94                     FCB   (h_ret-PTAB) & 0FFh   ; ]
F0F7   28                     FCB   (h_xor-PTAB) & 0FFh   ; ^
F0F8   44                     FCB   (h_alloc-PTAB) & 0FFh   ; _
F0F9   53                     FCB   (h_grave-PTAB) & 0FFh   ; `
F0FA   36                     FCB   (h_tor-PTAB) & 0FFh   ; {
F0FB   20                     FCB   (h_or-PTAB) & 0FFh   ; |
F0FC   3E                     FCB   (h_fromr-PTAB) & 0FFh   ; }
F0FD   31                     FCB   (h_not-PTAB) & 0FFh   ; ~
F0FE                          ENDIF      
F0FE                          IF   CHECKED   
                              FDB   h_store   ; !
                              FDB   h_str   ; "
                              FDB   h_num   ; #
                              FDB   h_print   ; $
                              FDB   h_swap   ; %
                              FDB   h_and   ; &
                              FDB   h_emit   ; '
                              FDB   h_open   ; (
                              FDB   h_close   ; )
                              FDB   h_mul   ; *
                              FDB   h_add   ; +
                              FDB   h_cfetch   ; ,
                              FDB   h_sub   ; -
                              FDB   h_cstore   ; .
                              FDB   h_div   ; /
                              FDB   h_dup   ; :
                              FDB   h_drop   ; ;
                              FDB   h_lt   ; <
                              FDB   h_eq   ; =
                              FDB   h_gt   ; >
                              FDB   h_key   ; ?
                              FDB   h_fetch   ; @
                              FDB   h_def   ; [
                              FDB   h_break   ; \
                              FDB   h_ret   ; ]
                              FDB   h_xor   ; ^
                              FDB   h_alloc   ; _
                              FDB   h_grave   ; `
                              FDB   h_tor   ; {
                              FDB   h_or   ; |
                              FDB   h_fromr   ; }
                              FDB   h_not   ; ~
F0FE                          ENDIF      
F0FE                PTABEND:      
F0FE                             ; =============================================================================
F0FE                             ;  Handlers that must start in the first range (within 255 bytes of PTAB)
F0FE                             ;  in the unchecked build: ^ _ ` 00bbIHwg ~
F0FE                             ; =============================================================================
F0FE   EC C1        H_OR:     LDD   ,U++   
F100   AA C4                  ORA   ,U   
F102   EA 41                  ORB   1,U   
F104   20 06                  BRA   st0   
F106   EC C1        H_XOR:    LDD   ,U++   
F108   A8 C4                  EORA   ,U   
F10A   E8 41                  EORB   1,U   
F10C   ED C4        ST0:      STD   ,U   
F10E   39                     RTS      
F10F   63 C4        H_NOT:    COM   ,U   
F111   63 41                  COM   1,U   
F113   39                     RTS      
F114                             ; "{" ( n -- ) R: ( -- n )     The dispatcher's return address comes off the
F114                             ; return stack first (PULS X) and is jumped to at the end.
F114   35 10        H_TOR:    PULS   X   
F116   37 06                  PULU   D   
F118   34 06                  PSHS   D   
F11A   6E 84                  JMP   ,X   
F11C                             ; "}" ( -- n ) R: ( n -- )    The dispatcher's return address comes off
F11C                             ; into D and the entry under it into X; D is then jumped to.
F11C   35 16        H_FROMR:   PULS   D,X   
F11E   36 10                  PSHU   X   
F120   1F 05                  TFR   D,PC   
F122                             ; "_" ( n -- addr ): the heap pointer moves by n (signed: a 16-bit add);
F122                             ; TOS is the old pointer.
F122                             ; Checked: the new top must be at least the program's end (PEND) and below
F122                             ; the limit page. That also catches an add that wraps: the top is always
F122                             ; 8301h-EFFFh and n is -32768..32767, so a sum that carries past FFFFh
F122                             ; lands below 7000h, and one that borrows can't happen.
F122   D6 7C        H_ALLOC:   LDB   <HEAP   
F124   96 7D                  LDA   <HEAP+1   
F126   1F 01                  TFR   D,X   ; the old pointer
F128   E3 C4                  ADDD   ,U   
F12A                          IF   CHECKED   
                              CMPD   <PEND   
                              BLO   ah9   ; below the program's end
                              CMPA   #HEAPLIM   
                              BLO   ah1   ; the new top must stay below the limit page
                    AH9:      LDA   #"H"   
                              BRA   ejmp   ; (with [ below)
                    AH1:         
F12A                          ENDIF      
F12A   D7 7C                  STB   <HEAP   
F12C   97 7D                  STA   <HEAP+1   
F12E   AF C4                  STX   ,U   
F130   39                     RTS      
F131                             ; ---- the grave -------------------------------------------------------------
F131                             ; The grave is a prefix: with the character after it, it is one command.
F131                             ; GTAB (at the end of the image, just ahead of the handlers) holds each
F131                             ; character with the place of its handler, as a byte to add to the address
F131                             ; after that byte. A handler starts with A = the character, is entered by
F131                             ; the dispatcher's own JSR and ends in RTS.
F131                             ; A character that is not in the table is unsafe: the unchecked build
F131                             ; searches on through memory, the checked build stops with W.
F131                H_GRAVE:      
F131                          IF   CHECKED   
                              STY   <AT   ; the place of anything that goes wrong in
F131                          ENDIF      ;   one of these is the character after the grave
F131   A6 A0                  LDA   ,Y+   
F133   8E F3 1E               LDX   #GTAB   
F136   A1 81        GR1:      CMPA   ,X++   
F138                          IF   1-CHECKED   
F138   26 FC                  BNE   gr1   
F13A                          ENDIF      
F13A                          IF   CHECKED   
                              BEQ   gr2   
                              TST   ,X   ; 0 ends the table
                              BNE   gr1   
                              LDA   #"W"   
                              JMP   error   
                    GR2:         
F13A                          ENDIF      
F13A   E6 1F                  LDB   -1,X   
F13C   3A                     ABX      ; the handler: the next entry's address plus it
F13D   6E 84                  JMP   ,X   
F13F                             ; ---- the line reader of -n? (see h_key) --------------------------------------
F13F                             ; Backspace takes the last character back (and is echoed as it is), CR ends
F13F                             ; (stored, not echoed), every other key is stored and echoed until the line
F13F                             ; is full. B = the length so far; the low byte of the top cell becomes the
F13F                             ; most allowed (it holds minus the count on entry).
F13F                             ; (A macro, because the two builds need it in different places: the
F13F                             ; unchecked build here, in the first range, where the layout needs these
F13F                             ; bytes ahead of the handlers that follow; the checked build at the end of
F13F                             ; the image, out of the way of its short branches.)
F13F                .macro LINERD,
F13F                             ; 
F13F                line:   CMPX    #-127           ; (X = TOS, minus the count)
F13F                 BHS     ln1
F13F                 LDA     #-127           ; more than 127 is taken as 127
F13F                 STA     1,U
F13F                ln1:    NEG     1,U
F13F                 LDX     #LINEBUF
F13F                 CLRB
F13F                ln2:    JSR     getk
F13F                 BEQ     ln2
F13F                 CMPA    #13
F13F                 BEQ     ln5
F13F                 CMPA    #8
F13F                 BEQ     ln4
F13F                 CMPB    1,U
F13F                 BHS     ln2             ; full
F13F                 STA     B,X
F13F                 INCB
F13F                ln3:    JSR     CONOUT
F13F                 BRA     ln2
F13F                ln4:    TSTB                    ; Backspace: nothing to take back?
F13F                 BEQ     ln2
F13F                 DECB
F13F                 BRA     ln3             ; echo it
F13F                ln5:    STA     B,X             ; A = 13
F13F                 STX     ,U
F13F                 RTS
F13F                .endm
F13F                 
F13F                          IF   1-CHECKED   
F13F                          ;*Macro unroll:  LINERD
F13F   8C FF 81     LINE:     CMPX   #-127   
F142   24 04                  BHS   ln1   
F144   86 81                  LDA   #-127   
F146   A7 41                  STA   1,U   
F148   60 41        LN1:      NEG   1,U   
F14A   8E 82 80               LDX   #LINEBUF   
F14D   5F                     CLRB      
F14E   BD F0 AF     LN2:      JSR   getk   
F151   27 FB                  BEQ   ln2   
F153   81 0D                  CMPA   #13   
F155   27 16                  BEQ   ln5   
F157   81 08                  CMPA   #8   
F159   27 0C                  BEQ   ln4   
F15B   E1 41                  CMPB   1,U   
F15D   24 EF                  BHS   ln2   
F15F   A7 85                  STA   B,X   
F161   5C                     INCB      
F162   BD FF 03     LN3:      JSR   CONOUT   
F165   20 E7                  BRA   ln2   
F167   5D           LN4:      TSTB      
F168   27 E4                  BEQ   ln2   
F16A   5A                     DECB      
F16B   20 F5                  BRA   ln3   
F16D   A7 85        LN5:      STA   B,X   
F16F   AF C4                  STX   ,U   
F171   39                     RTS      
F172                          ENDIF      
F172                             ; ---- where the two ranges meet ---------------------------------------------
F172                             ; The first range ends somewhere among the next five handlers, ] \ [ @ ?
F172                             ; (they are in falling code order for this): NPG1 follows. Every handler
F172                             ; below them must start in the second range, and every one above in the
F172                             ; first.
F172                             ; "]" returns: pop an address and jump to it. (PULS X,Y: the dispatcher's
F172                             ; return address into X, then the saved IP into Y.)
F172   35 30        H_RET:    PULS   X,Y   
F174   6E 84                  JMP   ,X   
F176                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
F176                             ; drops the block start, "]" returns. No closer at all ends the program.
F176   EC C1        H_BREAK:   LDD   ,U++   
F178   27 40                  BEQ   sk9   ; false: nothing to do
F17A   8D 1F                  BSR   skip   
F17C   4D                     TSTA      ; skip returns 0 for ")"
F17D                          IF   CHECKED   
                              LBMI   fin   ; (and FFh for the NUL: the program ends)
F17D                          ENDIF      
F17D   26 F3                  BNE   h_ret   
F17F   35 16        RDROP:    PULS   D,X   ; the return address and the block start
F181   1F 05                  TFR   D,PC   ; back to the dispatcher
F183                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
F183                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
F183                             ; the body"s address instead. Either way it then skips to the matching "]'.
F183                             ; (The unchecked build takes anything that is not a letter as the space; the
F183                             ; checked build stops on it.)
F183                          IF   CHECKED   
                    DEF1:     CMPA   #" "-"A"+256   
                              BEQ   def2   
                              LEAY   -1,Y   ; anything but a letter or a space: W. The
                              STY   <AT   ;   place is that character, just read
                              LDA   #"W"   
                    EJMP:     JMP   error   ; (H and N come here too)
F183                          ENDIF      
F183   A6 A0        H_DEF:    LDA   ,Y+   
F185   80 41                  SUBA   #"A"   ; a letter gives 0-25 or 32-57: lowercase
F187   1F 89                  TFR   A,B   ;   lands 64 bytes up
F189   C4 DF                  ANDB   #0DFh   ; fold case
F18B   C1 1A                  CMPB   #26   
F18D                          IF   1-CHECKED   
F18D   24 0A                  BHS   def2   ; not a letter
F18F                          ENDIF      
F18F                          IF   CHECKED   
                              BHS   def1   
F18F                          ENDIF      
F18F   BD F0 76               JSR   cellx   
F192   1F 20                  TFR   Y,D   
F194   E7 84                  STB   ,X   ; little-endian
F196   A7 01                  STA   1,X   
F198   8C                     FCB   8Ch   ; (CMPX #: steps over the PSHU)
F199   36 20        DEF2:     PSHU   Y   ; an anonymous block: push its address
F19B                          IF   1-CHECKED   
F19B                             ; fall into skip
F19B                          ENDIF      
F19B                          IF   CHECKED   
                                 ; Checked: the skip must end at a "]" (A = 2), or for a false "(",
                                 ; which comes to opf, at a ")" (A = 0). Anything else stops with N.
                              BSR   skip   
                              SUBA   #2   
                              FCB   8Ch   ; (CMPX #: steps over the BSR)
                    OPF:      BSR   skip   
                              TSTA      
                              BEQ   sk9   ; (an RTS)
                              LDA   #"N"   
                              BRA   ejmp   
F19B                          ENDIF      
F19B                             ; skip: read past text to the closer at this level, and return A = 0 if it
F19B                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
F19B                             ; strings are stepped over whole. B counts the open levels.
F19B                             ; Unchecked: a NUL first ends the program (for "\" with no closer; anything
F19B                             ; else that runs into the NUL had unbalanced brackets anyway).
F19B                             ; Checked: a NUL, or a string that runs into it, returns A = FFh, and the
F19B                             ; caller decides: "\" ends the program, "(" and "[" stop with N, as they do
F19B                             ; for a closer of the other kind. The place is the opener, still in AT.
F19B   5F           SKIP:     CLRB      
F19C   A6 A0        SK1:      LDA   ,Y+   
F19E                          IF   1-CHECKED   
F19E   10 27 FE D1            LBEQ   fin   
F1A2                          ENDIF      
F1A2                          IF   CHECKED   
                              BEQ   ssn   ; A = FFh
F1A2                          ENDIF      
F1A2   81 22                  CMPA   #22h   
F1A4   26 02                  BNE   sk2   
F1A6   8D 4E                  BSR   skipstr   ; leaves A = 22h, which matches nothing below
F1A8                          IF   CHECKED   
                              BCS   sk9   ; (or FFh, with the carry set: unclosed)
F1A8                          ENDIF      
F1A8   80 28        SK2:      SUBA   #"("   
F1AA   27 0F                  BEQ   sk3   
F1AC   4A                     DECA      ; ")"
F1AD   27 08                  BEQ   sk4   
F1AF   80 32                  SUBA   #"["-")"   
F1B1   27 08                  BEQ   sk3   
F1B3   81 02                  CMPA   #"]"-"["   
F1B5   26 E5                  BNE   sk1   
F1B7   5A           SK4:      DECB      
F1B8   2A E2                  BPL   sk1   
F1BA   39           SK9:      RTS      ; the closer at this level
F1BB   5C           SK3:      INCB      
F1BC   20 DE                  BRA   sk1   
F1BE                             ; 22h, checked build (the unchecked one is with the handlers below).
F1BE                             ; Checked: a NUL ends the string too, even right after a "/"; skipstr then
F1BE                             ; returns A = FFh with the carry set (the carry is clear at the quote), and
F1BE                             ; """ stops with Q, the string's address already pushed. (skip comes here
F1BE                             ; for its own NUL as well.)
F1BE                          IF   CHECKED   
                    H_STR:    PSHU   Y   
                              BSR   skipstr   
                              LBCS   e_quote   
                              RTS      
                    SS0:      LDA   ,Y+   ; the character after the "/"
                              BEQ   ssn   
                    SKIPSTR:   LDA   ,Y+   
                              BEQ   ssn   
                              CMPA   #"/"   
                              BEQ   ss0   
                              CMPA   #22h   
                              BNE   skipstr   
                              RTS      ; the quote: C = 0
                    SSN:      SUBA   #1   ; the NUL: A = FFh, C = 1
                              RTS      
F1BE                          ENDIF      
F1BE   AE C4        H_FETCH:   LDX   ,U   ; "@" (the cell in memory is little-endian)
F1C0   A6 01                  LDA   1,X   
F1C2   20 40                  BRA   cf1   
F1C4                             ; "?" ( n -- c ) or ( -n -- addr )
F1C4                             ;   n > 0: wait about n ms for a key; 0 if none came
F1C4                             ;   n = 0: wait for a key
F1C4                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
F1C4                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
F1C4   AE C4        H_KEY:    LDX   ,U   
F1C6   10 2B FF 75            LBMI   line   
F1CA   C6 14        KT1:      LDB   #MSLOOP   ; one millisecond, roughly
F1CC   BD F0 AF     KT2:      JSR   getk   
F1CF   26 11                  BNE   kt3   
F1D1   5A                     DECB      
F1D2   26 F8                  BNE   kt2   
F1D4   0C 76                  INC   <SEED   ; a millisecond with no key stirs the random
F1D6   26 02                  BNE   kt4   ;   seed by one: how long a key takes to come
F1D8   0C 77                  INC   <SEED+1   ;   is the one thing here that is not the
F1DA                KT4:         ;   same every time
F1DA   30 1F                  LEAX   -1,X   
F1DC   26 EC                  BNE   kt1   ; A = 0 if the time ran out
F1DE   AE C4                  LDX   ,U   ; 0?: the countdown from 0 took 65536 ms;
F1E0   27 E8                  BEQ   kt1   ;   run it again, until a key comes
F1E2   6F C4        KT3:      CLR   ,U   
F1E4   A7 41                  STA   1,U   
F1E6   39                     RTS      
F1E7                             ; (The line reader, `line`, is the macro LINERD, above: there is no
F1E7                             ; room for it here, between the short branches.)
F1E7                             ; =============================================================================
F1E7                             ;  Handlers that must start in the second range (unchecked build).
F1E7                             ; =============================================================================
F1E7                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
F1E7                             ; the matching ")".
F1E7   EC C1        H_OPEN:   LDD   ,U++   
F1E9                          IF   1-CHECKED   
F1E9   27 B0                  BEQ   skip   ; tail call: skip ends in RTS
F1EB                          ENDIF      
F1EB                          IF   CHECKED   
                              LBEQ   opf   ; checked: skip, and check the closer
F1EB                          ENDIF      
F1EB   35 10                  PULS   X   
F1ED   34 20                  PSHS   Y   
F1EF   6E 84                  JMP   ,X   
F1F1                             ; 22h pushes the address of the text after it and skips the string.
F1F1                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
F1F1                             ; the next character, so "/"" does not end it. Leaves A = 22h. (The checked
F1F1                             ; build's is after skip.)
F1F1                          IF   1-CHECKED   
F1F1   36 20        H_STR:    PSHU   Y   
F1F3   8C                     FCB   8Ch   ; (CMPX #: steps over the LEAY)
F1F4   31 21        SS0:      LEAY   1,Y   
F1F6   A6 A0        SKIPSTR:   LDA   ,Y+   
F1F8   81 2F                  CMPA   #"/"   
F1FA   27 F8                  BEQ   ss0   
F1FC   81 22                  CMPA   #22h   
F1FE   26 F6                  BNE   skipstr   
F200   39                     RTS      
F201                          ENDIF      
F201   AE C4        H_CFETCH:   LDX   ,U   ; ","
F203   4F                     CLRA      
F204   E6 84        CF1:      LDB   ,X   
F206   ED C4                  STD   ,U   
F208   39                     RTS      
F209                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
F209                             ; drops it and carries on.
F209   EC C1        H_CLOSE:   LDD   ,U++   
F20B   10 27 FF 70            LBEQ   rdrop   
F20F   10 AE 62               LDY   2,S   ; the block start, under the return address
F212   7E F0 A2               JMP   pollk   ; the break check, at every loop-back
F215                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
F215                             ; "*": three 8x8 multiplies; only the low 16 bits are kept.
F215                             ; a = ah:al at 2,U.  b = bh:bl at ,U.
F215   A6 43        H_MUL:    LDA   3,U   
F217   E6 C4                  LDB   ,U   
F219   3D                     MUL      ; al*bh
F21A   E7 C4                  STB   ,U   ; (bh is no longer needed)
F21C   A6 42                  LDA   2,U   
F21E   E6 41                  LDB   1,U   
F220   3D                     MUL      ; ah*bl
F221   EB C4                  ADDB   ,U   
F223   E7 C4                  STB   ,U   ; the cross terms, low byte
F225   A6 43                  LDA   3,U   
F227   E6 41                  LDB   1,U   
F229   3D                     MUL      ; al*bl
F22A   AB C4                  ADDA   ,U   
F22C   33 42                  LEAU   2,U   
F22E   ED C4                  STD   ,U   
F230   39                     RTS      
F231                             ; Signed compares: a-b, then a branch to put -1 or 0 on the stack.
F231   8D 18        H_GT:     BSR   h_swap   ; a > b is b < a
F233   8D 10        H_LT:     BSR   cmp   
F235   2D 02                  BLT   true   
F237   5F           FALSE:    CLRB      
F238   8C                     FCB   8Ch   ; (CMPX #: steps over the LDB)
F239   C6 FF        TRUE:     LDB   #0FFh   
F23B   1D                     SEX      ; D = 0000 or FFFF
F23C   ED C4                  STD   ,U   
F23E   39                     RTS      
F23F   8D 04        H_EQ:     BSR   cmp   
F241   27 F6                  BEQ   true   
F243   20 F2                  BRA   false   
F245   EC 42        CMP:      LDD   2,U   
F247   10 A3 C1               CMPD   ,U++   
F24A   39                     RTS      
F24B                             ; ---- stack, and printing ----------------------------------------------------
F24B   37 16        H_SWAP:   PULU   D,X   ; "%"
F24D   36 06                  PSHU   D   
F24F   36 10                  PSHU   X   
F251   39                     RTS      
F252   EC C4        H_DUP:    LDD   ,U   ; ":"
F254   36 06                  PSHU   D   
F256   39                     RTS      
F257   A6 41        H_EMIT:   LDA   1,U   ; "'"
F259                          IF   1-CHECKED   
F259   8D 49                  BSR   putc   
F25B                          ENDIF      
F25B                          IF   CHECKED   
                              JSR   CONOUT   ; (the checked build's report is in the way)
F25B                          ENDIF      
F25B   33 42        H_DROP:   LEAU   2,U   ; ";"
F25D   39                     RTS      
F25E                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character
F25E                             ; clears that character"s bit 6 (/M is CR, /` is space; "/" and ""' have no
F25E                             ; bit 6, so // and /" give themselves).
F25E                             ; Checked: a NUL (not one escaped by "/") stops with Q, the string's address
F25E                             ; still on the stack.
F25E   AE C4        H_PRINT:   LDX   ,U   
F260   A6 80        PR0:      LDA   ,X+   
F262                          IF   CHECKED   
                              LBEQ   e_quote   
F262                          ENDIF      
F262   81 22                  CMPA   #22h   
F264   27 F5                  BEQ   h_drop   
F266   81 2F                  CMPA   #"/"   
F268   26 04                  BNE   pr1   
F26A   A6 80                  LDA   ,X+   
F26C   84 BF                  ANDA   #0BFh   
F26E                PR1:         
F26E                          IF   1-CHECKED   
F26E   8D 34                  BSR   putc   
F270                          ENDIF      
F270                          IF   CHECKED   
                              JSR   CONOUT   
F270                          ENDIF      
F270   20 EE                  BRA   pr0   
F272                             ; "!" ( n addr -- ) is "." with the high byte stored first. The cell in
F272                             ; memory is little-endian.
F272                             ; Checked: both bytes must be in the program's space, and they are tested
F272                             ; before either is stored (chkst stops with O, the stack untouched).
F272   AE C4        H_STORE:   LDX   ,U   
F274                          IF   1-CHECKED   
F274   A6 42                  LDA   2,U   
F276   A7 01                  STA   1,X   
F278                          ENDIF      
F278                          IF   CHECKED   
                              BSR   chkst   
                              LEAX   1,X   
                              BSR   chkst   
                              LDA   2,U   
                              STA   ,X   
                                 ; and fall into ".", which loads X again (and checks it again)
F278                          ENDIF      
F278                          IF   1-CHECKED   
F278   8C                     FCB   8Ch   ; (CMPX #: steps over the LDX)
F279                          ENDIF      
F279   AE C4        H_CSTORE:   LDX   ,U   ; "." ( c addr -- )
F27B                          IF   CHECKED   
                              BSR   chkst   
F27B                          ENDIF      
F27B   33 42                  LEAU   2,U   
F27D   37 06                  PULU   D   
F27F   E7 84                  STB   ,X   
F281   39                     RTS      
F282                          IF   CHECKED   
                                 ; ---- reached from a handler ------------------------------------------------
                                 ; chkst: stop with O unless X is in the program's own space: from the letter
                                 ; page up to HEAPLIM, so the interpreter's stacks and whatever lies above the
                                 ; limit are safe. Memory above the heap top but below the limit is the
                                 ; program's own: Tiny BASIC keeps its lines there. Keeps every register.
                    CHKST:    CMPX   #LET   
                              BLO   cs9   
                              CMPX   #HEAPLIM*256   
                              BHS   cs9   
                              RTS      ; in range
                    CS9:      LDA   #"O"   
                              FCB   8Ch   
                    E_ZERO:   LDA   #"Z"   ; / by zero
                              FCB   8Ch   
                    E_QUOTE:   LDA   #"Q"   ; " or $ ran into the NUL
                                 ; and fall into error. (H, W and N have their own entries, near
                                 ; their handlers, at ejmp.)
                                 ; =============================================================================
                                 ;  Checked build: the error report. A = the letter, AT = the place; U is
                                 ;  as the program left it, and SSAV holds S as the failing character began
                                 ;  (see "the error entries" after `upper`).
                                 ;  It sits here, ahead of h_num, pdec and putc, so that it reaches them with
                                 ;  short calls. Prints
                                 ; 
                                 ;     CR LF
                                 ;     Err X @ line,col CR LF
                                 ;     Stk n:[ ...][ v]*  CR LF     (the top 8 cells, bottom to top, signed)
                                 ;     Rtn n CR LF
                                 ; 
                                 ;  and goes to EXIT. Line and column count from 1: the line is one more
                                 ;  than the LFs between PROG and the place, the column the distance from the
                                 ;  last LF (or from PROG-1). A place below PROG is in the -n? line buffer:
                                 ;  line 0, column = its offset there + 1. Numbers other than the cells are
                                 ;  printed unsigned (pdec), the cells signed (h_num).
                                 ; 
                                 ;  The data stack may be one cell past its limit (S, U = 80FEh): the
                                 ;  report's own cells then reach 8 bytes further down, to 80F6h, into the
                                 ;  return stack page, so the report runs on a fresh return stack at RSREP
                                 ;  (80F0h), below those bytes.
                                 ; =============================================================================
                    ERROR:    LDS   #RSREP   
                              TFR   A,B   ; the letter (pmsg and CONOUT keep B)
                              BSR   pmsg   
                              FCB   13,10,"Err"," "+80h   
                              TFR   B,A   
                              JSR   CONOUT   
                              BSR   pmsg   
                              FCB   " @"," "+80h   
                                 ; the place: Y counts the lines, X walks, the cell at ,U holds the
                                 ; address of the last LF (PROG-1 to begin with)
                              LDY   #0   
                              LDX   #LINEBUF-1   
                              PSHU   X   
                              LDX   #PROG-1   
                              CMPX   <AT   
                              BHS   lc3   ; the place is below PROG: line 0
                              STX   ,U   
                    LC1:      LEAY   1,Y   ; a line
                    LC2:      LEAX   1,X   
                              CMPX   <AT   
                              BHS   lc3   
                              LDA   ,X   
                              CMPA   #10   
                              BNE   lc2   
                              STX   ,U   
                              BRA   lc1   
                                 ; pmsg: print the text after the call, up to and including the character
                                 ; that has bit 7 set (it is printed without it), then return after it.
                                 ; (It sits here, in the middle of the report, where all its calls reach.)
                    PMSG:     PULS   X   
                    PM1:      LDA   ,X   
                              ANDA   #7Fh   
                              JSR   putc   
                              TST   ,X+   
                              BPL   pm1   
                              JMP   ,X   
                    LC3:      LDD   <AT   
                              SUBD   ,U   
                              STD   ,U   ; the column
                              PSHU   Y   
                              JSR   pdec   ; the line
                              BSR   pmsg   
                              FCB   ","+80h   
                              BSR   pdec   ; the column
                              BSR   pmsg   
                              FCB   13,10,"Stk"," "+80h   
                                 ; the data stack: its depth, then its top 8 cells, from Y down to
                                 ; the program's top cell, at ,U.
                              PSHS   U   ; where the walk ends
                              LDD   #DSTOP   
                              SUBD   ,S   
                              BSR   pdh   ; the depth (pdec leaves U as it was)
                              BSR   pmsg   
                              FCB   ":"+80h   
                              LEAY   16,U   ; past the 8th cell from the top ...
                              CMPY   #DSTOP   
                              BHS   sl1   
                              BSR   pmsg   ; (there are more than 8)
                              FCB   " ..","."+80h   
                              BRA   sl2   
                    SL1:      LDY   #DSTOP   ; ... or the whole stack, if no more than 8
                    SL2:      CMPY   ,S   
                              BLS   sl9   
                              LDD   ,--Y   
                              PSHU   D   
                              BSR   pmsg   
                              FCB   " "+80h   
                              BSR   h_num   
                              BRA   sl2   
                    SL9:      BSR   pmsg   
                              FCB   13,10,"Rtn"," "+80h   
                              LDD   #RSTOP   ; the return stack's depth, (RSTOP - S) / 2,
                              SUBD   <SSAV   ;   S as it was when this character began
                              BSR   pdh   
                              JSR   pmsg   
                              FCB   13,10+80h   
                              JMP   EXIT   
                                 ; pdh: print D/2 (a depth: D is twice it), unsigned.
                    PDH:      LSRA      
                              RORB      
                              PSHU   D   
                              BRA   pdec   
F282                          ENDIF      
F282                             ; "#" prints TOS as a signed decimal number, with no space after it.
F282   6D C4        H_NUM:    TST   ,U   
F284   2A 06                  BPL   pdec   
F286   86 2D                  LDA   #"-"   
F288   8D 1A                  BSR   putc   
F28A   8D 58                  BSR   negt   
F28C                             ; pdec: print the top cell as unsigned and drop it, by recursion on /10
F28C   CC 00 0A     PDEC:     LDD   #10   
F28F   36 06                  PSHU   D   
F291   8D 62                  BSR   udiv   ; NOS = quotient, TOS = digit
F293   37 06                  PULU   D   ; the digit
F295   34 04                  PSHS   B   
F297   EC C4                  LDD   ,U   
F299   27 03                  BEQ   pd1   
F29B   8D EF                  BSR   pdec   ; (it drops the quotient)
F29D   8C                     FCB   8Ch   ; (CMPX #: steps over the LEAU)
F29E   33 42        PD1:      LEAU   2,U   ; drop the zero quotient
F2A0   35 02                  PULS   A   
F2A2   8B 30                  ADDA   #"0"   ; and fall into putc
F2A4   7E FF 03     PUTC:     JMP   CONOUT   
F2A7                             ; ---- more arithmetic ---------------------------------------------------------
F2A7   EC C1        H_AND:    LDD   ,U++   
F2A9   A4 C4                  ANDA   ,U   
F2AB   E4 41                  ANDB   1,U   
F2AD   20 04                  BRA   st   
F2AF   EC C1        H_ADD:    LDD   ,U++   
F2B1   E3 C4                  ADDD   ,U   
F2B3   ED C4        ST:       STD   ,U   
F2B5   39                     RTS      
F2B6                             ; "-" has two jobs: directly before a digit it starts a negative number.
F2B6   BD F0 7D     H_SUB:    JSR   isdig   
F2B9   25 26                  BLO   negnum   
F2BB   EC 42                  LDD   2,U   
F2BD   A3 C1                  SUBD   ,U++   
F2BF   20 F2                  BRA   st   
F2C1                             ; ---- the tail ---------------------------------------------------------------
F2C1                             ; "/" is the last handler, so what follows its first byte may lie past the
F2C1                             ; second range: the divide itself and the routines after it.
F2C1                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
F2C1                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
F2C1                             ; of a. Unchecked, dividing by zero returns two cells of no meaning; checked,
F2C1                             ; it stops with Z, both operands still on the stack.
F2C1                H_DIV:       
F2C1                          IF   CHECKED   
                              LDD   ,U   
                              LBEQ   e_zero   
F2C1                          ENDIF      
F2C1   A6 42                  LDA   2,U   
F2C3   34 02                  PSHS   A   ; a's sign: for r
F2C5   A8 C4                  EORA   ,U   
F2C7   34 02                  PSHS   A   ; a xor b: for q
F2C9   30 42                  LEAX   2,U   
F2CB   8D 22                  BSR   absx   ; |a|
F2CD   1F 31                  TFR   U,X   
F2CF   8D 1E                  BSR   absx   ; |b|
F2D1   8D 22                  BSR   udiv   ; NOS = q, TOS = r
F2D3   30 42                  LEAX   2,U   
F2D5   6D E0                  TST   ,S+   
F2D7   2A 02                  BPL   dv1   
F2D9   8D 0B                  BSR   negx   ; q's sign
F2DB   6D E0        DV1:      TST   ,S+   
F2DD   2A 0F                  BPL   ng9   
F2DF   20 03                  BRA   negt   ; r's sign
F2E1   BD F0 84     NEGNUM:   JSR   rdnum   ; a negative literal: read it, then negate
F2E4   1F 31        NEGT:     TFR   U,X   
F2E6   EC 84        NEGX:     LDD   ,X   ; negx: negate the cell at X
F2E8   40                     NEGA      
F2E9   50                     NEGB      
F2EA   82 00                  SBCA   #0   
F2EC   ED 84                  STD   ,X   
F2EE   39           NG9:      RTS      
F2EF   6D 84        ABSX:     TST   ,X   ; absx: negate the cell at X if negative
F2F1   2A FB                  BPL   ng9   
F2F3   20 F1                  BRA   negx   
F2F5                             ; udiv: unsigned divide, in place. The dividend is the NOS cell and the
F2F5                             ; divisor the TOS cell, both <= 8000h; the NOS cell becomes the quotient and
F2F5                             ; the TOS cell the remainder. The remainder is built in D (always < the
F2F5                             ; divisor, so 2R+1 fits in 16 bits).
F2F5                             ; Dividing by 2 is one shift (the spec wants that fast).
F2F5   EC C4        UDIV:     LDD   ,U   
F2F7   83 00 02               SUBD   #2   
F2FA   26 07                  BNE   ud0   
F2FC   64 42                  LSR   2,U   
F2FE   66 43                  ROR   3,U   ; the quotient
F300   59                     ROLB      ; the remainder: the bit that fell out (D was 0)
F301   20 18                  BRA   ud3   
F303   8E 00 10     UD0:      LDX   #16   
F306   4F                     CLRA      
F307   5F                     CLRB      
F308   68 43        UD1:      ASL   3,U   
F30A   69 42                  ROL   2,U   ; the dividend's top bit ...
F30C   59                     ROLB      
F30D   49                     ROLA      ; ... into the remainder
F30E   10 A3 C4               CMPD   ,U   
F311   25 04                  BLO   ud2   
F313   A3 C4                  SUBD   ,U   
F315   6C 43                  INC   3,U   ; a quotient bit
F317   30 1F        UD2:      LEAX   -1,X   
F319   26 ED                  BNE   ud1   
F31B   ED C4        UD3:      STD   ,U   
F31D   39                     RTS      
F31E                             ; =============================================================================
F31E                             ;  The grave's codes (h_grave is the dispatcher). Each is entered with
F31E                             ;  A = the character, and ends in RTS.
F31E                             ; 
F31E                             ;    `!  ( addr -- )        call the machine code at addr. The code is
F31E                             ;                           entered with the address already popped: U
F31E                             ;                           points at the top data cell (big-endian) and the
F31E                             ;                           dispatcher's return address is on top of S. It
F31E                             ;                           may pop and push data cells by changing U; on
F31E                             ;                           return the cell at ,U is the new TOS. It must
F31E                             ;                           keep Y, DP and S (balanced) and return with RTS;
F31E                             ;                           A, B, X and CC may change.
F31E                             ;    `$  ( addr -- addr' )  the hex loader: pairs of hex digits are stored
F31E                             ;                           from addr until a non-hex character; then a RTS
F31E                             ;                           (39h) is written and its address is left. An odd
F31E                             ;                           last digit is consumed and dropped.
F31E                             ;    `'  ( -- )             new line: CR LF
F31E                             ;    `+  ( addr -- n )      add 1 to the cell at addr and leave its new value
F31E                             ;    `,  ( n -- r )         a random number from 0 to n-1 (n is 1 to 32767)
F31E                             ;    `-  ( addr -- n )      subtract 1 from the cell at addr, the same way
F31E                             ;    `.  ( -- addr )        the address of the random seed
F31E                             ;    `<  ( a b -- n )       the smaller of the two (signed)
F31E                             ;    `>  ( a b -- n )       the larger
F31E                             ;    `?  ( flag -- )        the cursor off (0) or on
F31E                             ;    `@  ( row col -- )     the cursor to that row and column, both from 0
F31E                             ;    `^  ( -- )             clear the screen and home the cursor
F31E                             ;    `_  ( -- )             clear from the cursor to the end of the line
F31E                             ; 
F31E                             ;  Neither the loader's stores nor the machine code are checked.
F31E                             ; =============================================================================
F31E                             ; The table: a character, then its handler's distance from the address
F31E                             ; after that byte.
F31E   21           GTAB:     FCB   "!"   
F31F   9C                     FCB   g_exec-$-1   
F320   24                     FCB   "$"   
F321   6C                     FCB   g_hex-$-1   
F322   27                     FCB   27h   
F323   62                     FCB   g_nl-$-1   
F324   2B                     FCB   "+"   
F325   34                     FCB   g_inc-$-1   
F326   2C                     FCB   ","   
F327   10                     FCB   g_rnd-$-1   
F328   2D                     FCB   "-"   
F329   30                     FCB   g_inc-$-1   
F32A   2E                     FCB   "."   
F32B   41                     FCB   g_seed-$-1   
F32C   3C                     FCB   "<"   
F32D   4B                     FCB   g_min-$-1   
F32E   3E                     FCB   ">"   
F32F   43                     FCB   g_max-$-1   
F330   3F                     FCB   "?"   
F331   9D                     FCB   g_cur-$-1   
F332   40                     FCB   "@"   
F333   BD                     FCB   g_at-$-1   
F334   5E                     FCB   "^"   
F335   88                     FCB   g_cls-$-1   
F336   5F                     FCB   "_"   
F337   8F                     FCB   g_eol-$-1   
F338                          IF   CHECKED   
                              FCB   0   ; the end
F338                          ENDIF      
F338                             ; `, The seed goes one step on: seed * 261 + 1, which takes every 16-bit
F338                             ; value in turn. The high bits of such a seed are the good ones and the low
F338                             ; ones repeat soon, so the high byte is folded into the low (EOR) before the
F338                             ; remainder of dividing by n is taken.
F338                             ; n must be 1 to 32767: the checked build stops with Z on anything less
F338                             ; than 1.
F338                G_RND:       
F338                          IF   CHECKED   
                              LDD   ,U   
                              SUBD   #1   ; n - 1 negative: n is 0 or less
                              LBMI   e_zero   
F338                          ENDIF      
F338   D6 76                  LDB   <SEED   ; (the cell is little-endian)
F33A   96 77                  LDA   <SEED+1   
F33C   58                     ASLB      
F33D   49                     ROLA      
F33E   58                     ASLB      
F33F   49                     ROLA      
F340   1A 01                  ORCC   #1   ; (the carry is the + 1)
F342   D9 76                  ADCB   <SEED   
F344   99 77                  ADCA   <SEED+1   ; * 5 + 1
F346   9B 76                  ADDA   <SEED   ; + * 256: * 261 + 1
F348   D7 76                  STB   <SEED   
F34A   97 77                  STA   <SEED+1   
F34C   D8 77                  EORB   <SEED+1   
F34E   36 06                  PSHU   D   
F350   BD F2 4B               JSR   h_swap   ; the dividend under n
F353   8D A0                  BSR   udiv   ; NOS = the quotient, TOS = the remainder
F355   37 06                  PULU   D   
F357   ED C4                  STD   ,U   
F359   39                     RTS      
F35A                             ; `+ and `-: one routine. "," minus the character is 1 or -1.
F35A   AE C4        G_INC:    LDX   ,U   
F35C                          IF   CHECKED   
                              JSR   chkst   ; both bytes are tested first, as "!" does
                              LEAX   1,X   
                              JSR   chkst   
                              LEAX   -1,X   
F35C                          ENDIF      
F35C   40                     NEGA      
F35D   8B 2C                  ADDA   #","   
F35F   1F 89                  TFR   A,B   
F361   1D                     SEX      
F362   EB 84                  ADDB   ,X   ; (the cell is little-endian)
F364   A9 01                  ADCA   1,X   
F366   E7 84                  STB   ,X   
F368   A7 01                  STA   1,X   
F36A   ED C4                  STD   ,U   ; the new value is TOS
F36C   39                     RTS      
F36D                             ; `. pushes the address of the random seed.
F36D   8E 82 76     G_SEED:   LDX   #LET+SEED   
F370   36 10                  PSHU   X   
F372   39                     RTS      
F373                             ; `< and `>: b is taken off and compared with a; it goes in a's place if it
F373                             ; is the one wanted.
F373   8D 0B        G_MAX:    BSR   gcmp   
F375   2F 08                  BLE   gm9   
F377   20 04                  BRA   gm8   
F379   8D 05        G_MIN:    BSR   gcmp   
F37B   2C 02                  BGE   gm9   
F37D   ED C4        GM8:      STD   ,U   
F37F   39           GM9:      RTS      
F380   EC C1        GCMP:     LDD   ,U++   
F382   10 A3 C4               CMPD   ,U   ; b - a
F385   39                     RTS      
F386   86 0D        G_NL:     LDA   #13   
F388   8D 64                  BSR   gputc   
F38A   86 0A                  LDA   #10   
F38C   20 60                  BRA   gputc   
F38E   AE C4        G_HEX:    LDX   ,U   
F390   8D 18        HX1:      BSR   hexc   
F392   24 0F                  BCC   hx2   
F394   C6 10                  LDB   #16   
F396   3D                     MUL      ; B = the digit, moved up to the high half
F397   E7 84                  STB   ,X   ; (an odd digit is overwritten by the RTS)
F399   8D 0F                  BSR   hexc   
F39B   24 06                  BCC   hx2   ; odd digit: already consumed, dropped
F39D   AA 84                  ORA   ,X   
F39F   A7 80                  STA   ,X+   
F3A1   20 ED                  BRA   hx1   
F3A3   86 39        HX2:      LDA   #39h   ; RTS
F3A5   A7 84                  STA   ,X   
F3A7   AF C4                  STX   ,U   
F3A9   39                     RTS      
F3AA                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
F3AA                             ; and return its value in A with the carry set; otherwise leave the IP and
F3AA                             ; return with the carry clear.
F3AA   BD F0 7D     HEXC:     JSR   isdig   
F3AD   25 0A                  BLO   hv1   ; C = 1
F3AF   84 DF                  ANDA   #0DFh   
F3B1   80 11                  SUBA   #11h   
F3B3   81 06                  CMPA   #6   
F3B5   24 04                  BHS   hv9   ; C = 0
F3B7   80 F6                  SUBA   #0F6h   ; + 10, and sets the carry
F3B9   31 21        HV1:      LEAY   1,Y   ; (LEAY leaves the carry alone)
F3BB   39           HV9:      RTS      
F3BC   37 80        G_EXEC:   PULU   PC   ; jump to it: the code's RTS returns to the
F3BE                             ;   dispatcher
F3BE                          IF   ANSI   
F3BE                             ; `^: ESC [ H homes the cursor, and ESC [ J clears from there to the end of
F3BE                             ; the screen. `_: ESC [ K clears to the end of the line. (CONOUT keeps B.)
F3BE   8D 28        G_CLS:    BSR   csi   
F3C0   86 48                  LDA   #"H"   
F3C2   8D 2A                  BSR   gputc   
F3C4   C6 4A                  LDB   #"J"   
F3C6   8C                     FCB   8Ch   ; (CMPX #: steps over the LDB)
F3C7   C6 4B        G_EOL:    LDB   #"K"   
F3C9   8D 1D                  BSR   csi   
F3CB   1F 98                  TFR   B,A   
F3CD   20 1F                  BRA   gputc   
F3CF                             ; `? ( flag -- ): ESC [ ? 2 5 l hides the cursor, ESC [ ? 2 5 h shows it.
F3CF   8D 17        G_CUR:    BSR   csi   
F3D1   86 3F                  LDA   #"?"   
F3D3   8D 19                  BSR   gputc   
F3D5   86 32                  LDA   #"2"   
F3D7   8D 15                  BSR   gputc   
F3D9   86 35                  LDA   #"5"   
F3DB   8D 11                  BSR   gputc   
F3DD   AE C1                  LDX   ,U++   ; the flag
F3DF   27 03                  BEQ   gc1   
F3E1   86 68                  LDA   #"h"   
F3E3   8C                     FCB   8Ch   ; (CMPX #: steps over the LDA)
F3E4   86 6C        GC1:      LDA   #"l"   
F3E6   20 06                  BRA   gputc   
F3E8                             ; csi: print ESC [, which starts every ANSI sequence.
F3E8   86 1B        CSI:      LDA   #27   
F3EA   8D 02                  BSR   gputc   
F3EC   86 5B                  LDA   #"["   
F3EE                          ENDIF      
F3EE   7E FF 03     GPUTC:    JMP   CONOUT   
F3F1                          IF   ANSI   
F3F1                             ; `@ ( row col -- ): ESC [ row+1 ; col+1 H. (ANSI counts from 1.)
F3F1   8D F5        G_AT:     BSR   csi   
F3F3   BD F2 4B               JSR   h_swap   ; the row on top
F3F6   8D 0A                  BSR   pinc   
F3F8   86 3B                  LDA   #";"   
F3FA   8D F2                  BSR   gputc   
F3FC   8D 04                  BSR   pinc   
F3FE   86 48                  LDA   #"H"   
F400   20 EC                  BRA   gputc   
F402                             ; pinc: print the top cell plus 1, unsigned, and drop it
F402   6C 41        PINC:     INC   1,U   
F404   26 02                  BNE   pi1   
F406   6C C4                  INC   ,U   
F408   7E F2 8C     PI1:      JMP   pdec   
F40B                          ENDIF      
F40B                          IF   1-ANSI   
                                 ; With ANSI = 0 the machine's own routines do the work (see the equates).
                    G_CLS:    JMP   CONCLS   
                    G_EOL:    JMP   CONEOL   
                    G_CUR:    LDD   ,U++   ; D = the flag, and the Z flag says the same
                              JMP   CONCUR   
                    G_AT:     LDD   ,U++   ; D = the column
                              LDX   ,U++   ; X = the row
                              JMP   CONAT   
F40B                          ENDIF      
F40B                          IF   CHECKED   
                              ;*Macro unroll:  LINERD                  ; the line reader of -n?
                    LINE:     CMPX   #-127   ; the line reader of -n?
                              BHS   ln1   
                              LDA   #-127   
                              STA   1,U   
                    LN1:      NEG   1,U   
                              LDX   #LINEBUF   
                              CLRB      
                    LN2:      JSR   getk   
                              BEQ   ln2   
                              CMPA   #13   
                              BEQ   ln5   
                              CMPA   #8   
                              BEQ   ln4   
                              CMPB   1,U   
                              BHS   ln2   
                              STA   B,X   
                              INCB      
                    LN3:      JSR   CONOUT   
                              BRA   ln2   
                    LN4:      TSTB      
                              BEQ   ln2   
                              DECB      
                              BRA   ln3   
                    LN5:      STA   B,X   
                              STX   ,U   
                              RTS      
F40B                          ENDIF      
F40B                IMGEND:      


