1300                             ; RAM pages, after the image
1300                CPAGE:    EQU   (imgend + 255) / 256   ; the skip cache (QK builds), first, so
1300                RSPAGE:   EQU   CPAGE + QK   ;   that the letter page is still the one
1300                DSPAGE:   EQU   RSPAGE + 1   ;   just below the program text
1300                LETPAGE:   EQU   RSPAGE + 2   
1300                PROG:     EQU   LETPAGE*256 + 256   
