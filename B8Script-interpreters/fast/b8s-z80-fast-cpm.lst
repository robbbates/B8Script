05B1                          ;*Macro unroll:  NEXT
05B1                          DS   (1-CPM)*(1-FAST),0F7h   
05B1   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
05B2   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
05B3                          ENDIF      
05B3                          IF   QK   
05B3                             ; A true ")" reads the block start where it is, on top of the return stack,
05B3                             ; instead of popping it and pushing it back; the break key is looked at as
05B3                             ; rpushn would.
05B3   FD 4E 00     CLOSEQ:   LD   C,(IY+0)   
05B6   FD 46 01               LD   B,(IY+1)   
05B9   E5                     PUSH   HL   
05BA   21 36 16               LD   HL,PCNT   
05BD   35                     DEC   (HL)   
05BE   E1                     POP   HL   
05BF   CC 20 06               CALL   Z,pollk   
05C2                          ;*Macro unroll:  NEXT
05C2                          DS   (1-CPM)*(1-FAST),0F7h   
05C2   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
05C3   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
05C4                          ENDIF      
05C4                          IF   QUICKU   
                                 ; a-z, in the unchecked builds: a variable followed by "@" or "!" is fetched
                                 ; or stored in the same step (x@ is the commonest pair in most programs).
                                 ; (A checked build checks the stacks between the two, so it keeps them apart.)
                    LOWQ:     ADD   A,A   
                              LD   E,A   
                              LD   D,LETPAGE   ; DE -> the cell
                              LD   A,(BC)   
                              CP   "@"   
                              JR   Z,lwf   
                              CP   "!"   
                              JR   Z,lws   
                              PUSH   HL   
                              EX   DE,HL   ; TOS = the cell's address
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
                    LWF:      INC   BC   ; x@: TOS = the cell's value
                              PUSH   HL   
                              EX   DE,HL   
                              LD   E,(HL)   
                              INC   L   
                              LD   D,(HL)   
                              EX   DE,HL   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
                    LWS:      INC   BC   ; x!: the cell = TOS, and NOS comes up
                              EX   DE,HL   
                              LD   (HL),E   
                              INC   L   
                              LD   (HL),D   
                              POP   HL   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
05C4                          ENDIF      
05C4                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)*QK   
                    QSTART:   LD   BC,PROG   ; the generic reset goes on here: the IP,
                              CALL   skclr   ;   an empty skip cache, and the rest of the
                              JP   st0   ;   startup
05C4                          ENDIF      
05C4                          IF   (1-CPM)*(1-EDITOR)*CHECKED*QK   
                    QINIT:    CALL   skclr   ; (keeps A, which init wants 0)
                              JP   init   
05C4                          ENDIF      
05C4                             ; =============================================================================
05C4                             ;  Dispatch table: the low byte of each handler's address, in code order
05C4                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
05C4                             ;  It must not cross a page (the dispatcher only adds to its low byte).
05C4                             ; =============================================================================
05C4                             ; The handlers of the first NPG1 characters start in the image's second page.
05C4                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
05C4                             ; differs between the builds, so the count is worked out here.
05C4                             ; (One division to a line: asm80 only rounds down when it stores a value.)
05C4                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
05C4                PGBRK:    EQU   (h_break-BASE)/256   
05C4                PGDEF:    EQU   (h_def-BASE)/256   
05C4                PGFET:    EQU   (h_fetch-BASE)/256   
05C4                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
05C4                          IF   (1-TABP0)*(1-PTLATE)   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
05C4                          ENDIF      
05C4                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
05C4                             ; and return its value in A with the carry set; otherwise leave the IP and
05C4                             ; return with the carry clear.
05C4   0A           HEXC:     LD   A,(BC)   
05C5   D6 30                  SUB   "0"   
05C7   FE 0A                  CP   10   
05C9   38 09                  JR   C,hc1   
05CB   E6 DF                  AND   0DFh   
05CD   D6 11                  SUB   11h   
05CF   FE 06                  CP   6   
05D1   D0                     RET   NC   
05D2   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
05D4   03           HC1:      INC   BC   
05D5   C9                     RET      
05D6                             ; psgn: print HL as a signed number. Keeps BC.
05D6   CB 7C        PSGN:     BIT   7,H   
05D8   28 07                  JR   Z,pdec   
05DA                          ;*Macro unroll:  PUTK    2Dh             ; '-'
05DA                          DS   1-CPM,3Eh   ; "-"
05DA                          DS   1-CPM,2Dh   
05DA                          DS   1-CPM,0EFh   
05DA   CD                     DS   CPM,0CDh   
05DB   74                     DS   CPM,APTK&0FFh   
05DC   06                     DS   CPM,APTK/256   
05DD   2D                     DS   CPM,2Dh   
05DE                          ;*Macro unroll:  NEGH
05DE                          DS   1-CPM,0E7h   
05DE   CD                     DS   CPM,0CDh   
05DF   69                     DS   CPM,ANEG&0FFh   
05E0   06                     DS   CPM,ANEG/256   
05E1                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
05E1                             ; Keeps BC.
05E1   11 0A 00     PDEC:     LD   DE,10   
05E4   CD 5B 03               CALL   udiv   ; HL = HL / 10, E = the last digit
05E7   7B                     LD   A,E   
05E8   F5                     PUSH   AF   
05E9   7C                     LD   A,H   
05EA   B5                     OR   L   
05EB   C4 E1 05               CALL   NZ,pdec   
05EE   F1                     POP   AF   
05EF   C6 30                  ADD   A,"0"   
05F1                          ;*Macro unroll:  PUTAR
05F1                          DS   1-CPM,0EFh   
05F1                          DS   1-CPM,0C9h   
05F1   C3                     DS   CPM,0C3h   
05F2   78                     DS   CPM,APUT&0FFh   
05F3   06                     DS   CPM,APUT/256   
05F4                             ; (The table goes here instead in the builds where, before psgn, it would
05F4                             ; cross a page: PTLATE. If it would cross one here too, it starts on the next
05F4                             ; page: PTPAD is 0 unless it must.)
05F4                          IF   (1-TABP0)*PTLATE   
05F4                PTPH:     EQU   $ & 0FFh   
05F4                PTPX:     EQU   (PTPH + 31) / 256   
05F4                PTPAD:    EQU   PTPX * (256 - PTPH)   
05F4                          DS   PTPAD   
0600                PTAB:        
0600                          ;*Macro unroll:  PTABLE
0600   64                     DB   h_store & 0FFh   
0601   6B                     DB   h_str & 0FFh   
0602   95                     DB   h_num & 0FFh   
0603   73                     DB   h_print & 0FFh   
0604   5C                     DB   h_swap & 0FFh   
0605   12                     DB   h_and & 0FFh   
0606   8E                     DB   h_emit & 0FFh   
0607   EB                     DB   h_open & 0FFh   
0608   F3                     DB   h_close & 0FFh   
0609   35                     DB   h_mul & 0FFh   
060A   05                     DB   h_add & 0FFh   
060B   B3                     DB   h_cfetch & 0FFh   
060C   FB                     DB   h_sub & 0FFh   
060D   5F                     DB   h_cstore & 0FFh   
060E   39                     DB   h_div & 0FFh   
060F   59                     DB   h_dup & 0FFh   
0610   61                     DB   h_drop & 0FFh   
0611   1B                     DB   h_lt & 0FFh   
0612   2B                     DB   h_eq & 0FFh   
0613   1C                     DB   h_gt & 0FFh   
0614   9B                     DB   h_key & 0FFh   
0615   E5                     DB   h_fetch & 0FFh   
0616   C7                     DB   h_def & 0FFh   
0617   B7                     DB   h_break & 0FFh   
0618   B0                     DB   h_ret & 0FFh   
0619   32                     DB   h_xor & 0FFh   
061A   4A                     DB   h_alloc & 0FFh   
061B   99                     DB   h_grave & 0FFh   
061C   95                     DB   h_tor & 0FFh   
061D   3B                     DB   h_or & 0FFh   
061E   06                     DB   h_fromr & 0FFh   
061F   44                     DB   h_not & 0FFh   
0620                PTABEND:      
0620                          ENDIF      
0620                             ; =============================================================================
0620                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
0620                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
0620                             ;  (RST 28h) prints A. Both keep BC, DE, HL and IY. In the generic build
0620                             ;  they are the host's KEY and CONOUT routines themselves.
0620                             ; 
0620                             ;  A running program reads the keyboard only through getk and pollk, which
0620                             ;  between them give the break key its rules:
0620                             ;    - Ctrl-C stops the program;
0620                             ;    - any other key that the break check reads is held in KEYBUF for the
0620                             ;      next "?", and a newer one takes its place;
0620                             ;    - "?" (getk) takes the held key first;
0620                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
0620                             ;      key like any other, but two of them within about 250 ms still stop it.
0620                             ;  Both are called straight from a handler, never from a routine under one:
0620                             ;  the checked build's report counts on finding one return address above the
0620                             ;  data stack.
0620                             ; =============================================================================
0620                          IFN   CPM   
                    RAWK:     EQU   KEY   
0620                          ENDIF      
0620                             ; pollk: the break check (see rpushn).
0620   CD 70 06     POLLK:    CALL   rawk   
0623   C8                     RET   Z   ; no key
0624   32 7A 16               LD   (KEYBUF),A   ; held for the next "?"
0627   FE 03        PK1:      CP   3   ; (getk joins here)
0629   C0                     RET   NZ   
062A                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
062A                             ; the program has turned it off, wait about 250 ms for one more key: a
062A                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
062A                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
062A   3A 7B 16     CTLC:     LD   A,(BRKOFF)   
062D   B7                     OR   A   
062E   CA 11 01     CT0:      JP   Z,brk   
0631   D5                     PUSH   DE   
0632   11 E8 03               LD   DE,250*MSLOOP   
0635   CD 70 06     CT1:      CALL   rawk   
0638   20 05                  JR   NZ,ct2   
063A   1B                     DEC   DE   
063B   7A                     LD   A,D   
063C   B3                     OR   E   
063D   20 F6                  JR   NZ,ct1   
063F   D1           CT2:      POP   DE   ; A = the second key, or 0 if none came
0640   FE 03                  CP   3   
0642   28 EA                  JR   Z,ct0   ; (the zero flag takes the JP there)
0644   B7                     OR   A   
0645   28 03                  JR   Z,ct3   
0647   32 7A 16               LD   (KEYBUF),A   
064A   3E 03        CT3:      LD   A,3   
064C   B7                     OR   A   
064D   C9                     RET      
064E                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
064E   E5           GETK:     PUSH   HL   ; a held key goes first, and is taken out of
064F   21 7A 16               LD   HL,KEYBUF   ;   the buffer
0652   7E                     LD   A,(HL)   
0653   36 00                  LD   (HL),0   
0655   E1                     POP   HL   
0656   B7                     OR   A   
0657   C0                     RET   NZ   
0658   CD 70 06               CALL   rawk   
065B   C8                     RET   Z   
065C   18 C9                  JR   pk1   ; Ctrl-C? If not, that is the key
065E                          IF   (1-CHECKED)*(1-EDITOR)   
065E                BRK:      EQU   endprog   ; the unchecked build stops without a word
065E                          ENDIF      ;   (with the editor, both stacks are cleared);
065E                          IF   (1-CHECKED)*EDITOR   
                    BRK:      EQU   edit0   
065E                          ENDIF      
065E                          IF   CHECKED   
                    BRK:      EQU   e_break   ;   the checked build reports B
065E                          ENDIF      
065E                          IF   CPM   
065E                             ; The routines a generic build keeps in page zero (see there). Here they are
065E                             ; out of the way of the handlers, which must fit in the image's first two
065E                             ; pages.
065E   FD 5E 00     RPOP:     LD   E,(IY+0)   ; pop the return stack into DE
0661   FD 56 01               LD   D,(IY+1)   
0664   FD 23                  INC   IY   
0666   FD 23                  INC   IY   
0668   C9                     RET      
0669   AF           NEG16:    XOR   A   ; HL = -HL (keeps BC, DE)
066A   95                     SUB   L   
066B   6F                     LD   L,A   
066C   9F                     SBC   A,A   
066D   94                     SUB   H   
066E   67                     LD   H,A   
066F   C9                     RET      
0670                          ENDIF      
0670                          IF   CPM*CHECKED   ; (the checked builds need the room)
                    EXEC:     LD   (RSAVE),IY   ; machine code may change IX and IY
                              CALL   jphl   
                              LD   IY,(RSAVE)   
                              ;*Macro unroll:  SETIX
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,21h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
                              POP   HL   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
0670                          ENDIF      
0670                          IF   CPM   
0670   3E FF        RAWK:     LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
0672   18 04                  JR   putc   
0674   E3           PUTK:     EX   (SP),HL   ; print the byte after the CALL
0675   7E                     LD   A,(HL)   
0676   23                     INC   HL   
0677   E3                     EX   (SP),HL   
0678                             ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
0678                             ; printing and could swallow a key that BDOS 6 then never sees.
0678                             ; It keeps every register but A and the flags: BDOS may change any of them
0678                             ; (IX and IY too, in a Z80 BDOS or BIOS).
0678   C5           PUTC:     PUSH   BC   
0679   D5                     PUSH   DE   
067A   E5                     PUSH   HL   
067B   DD E5                  PUSH   IX   
067D   FD E5                  PUSH   IY   
067F   5F                     LD   E,A   
0680   0E 06                  LD   C,6   
0682   CD 05 00               CALL   BDOS   
0685   FD E1                  POP   IY   
0687   DD E1                  POP   IX   
0689   E1                     POP   HL   
068A   D1                     POP   DE   
068B   C1                     POP   BC   
068C   B7                     OR   A   ; (for getk)
068D   C9                     RET      
068E                          ENDIF      
068E                             ; =============================================================================
068E                             ;  Checked build: the checks and the error report
068E                             ; =============================================================================
068E                          IF   CHECKED   
                                 ; chkstk: both stacks are checked once per character, not in every handler.
                                 ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
                                 ; the constant carries if it is above (cells were popped that were never
                                 ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
                                 ; a character late at most: the bytes above DSTOP and the guard band below
                                 ; the page take what happens meanwhile. DE is free between characters.
                    CHKSTK:   EX   DE,HL   
                              LD   HL,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
                              ADD   HL,SP   
                              EX   DE,HL   
                              JR   C,e_under   
                              INC   D   
                              JR   NZ,e_over   
                              PUSH   IY   ; the return stack: in its page (or it has
                              POP   DE   ;   overflowed), and not above its empty
                              LD   A,D   ;   position (an underflow stays inside the
                              CP   RSPAGE   ;   page, in the guard band)
                              LD   A,E   
                              JR   NZ,e_rover   
                              CP   RSTOP&0FFh+1   
                              RET   C   
                              LD   IY,RSTOP   ; return stack underflow: it counts as empty
                              LD   A,"r"   
                              JR   errp   
                    E_ROVER:   LD   A,"R"   ; return stack overflow
                              DB   11h   ; (LD DE,nn hides the next entry)
                    E_OVER:   LD   A,"S"   ; data stack overflow
                              JR   errp   
                    E_UNDER:   LD   SP,DSTOP   ; data stack underflow: it counts as empty
                              LD   A,"s"   
                              JR   error   
                                 ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
                                 ; was never defined still holds 0000h, and the byte there is a reserved one
                                 ; in every build (AFh or C3h): if the IP is in page zero, this was a call of
                                 ; an undefined word. The call is undone, so the place is the call itself.
                    E_HI:     INC   B   
                              DJNZ   e_resv   ; (B is as it was, and is not 0)
                              ;*Macro unroll:  POPR
                              DS   1-CPM,0CFh   
                              DS   CPM,0CDh   
                              DS   CPM,AROP&0FFh   
                              DS   CPM,AROP/256   
                              LD   B,D   
                              LD   C,E   
                              LD   A,"U"   
                              JR   error   
                                 ; chkhp: HL = the new heap top, DE = the old one, the carry is from adding
                                 ; the count. Stop if the top is not below the limit page, or is below the
                                 ; program's end.
                    CHKHP:       
068E                          ENDIF      
068E                          IF   CHECKED*CPM   
                                 ; With this much room a top that wrapped round can land back in
                                 ; range, so the add is tested too: growing (A, the count's high
                                 ; byte, is positive) must not carry, and releasing must.
                              RRA      ; the carry comes in above the sign:
                              ADD   A,40h   ;   bit 7 = carry XOR sign
                              ADD   A,A   
                              JR   C,e_heap   
                              LD   A,(0007h)   
                              DEC   A   
                              CP   H   
                              JR   C,e_heap   
068E                          ENDIF      
068E                          IF   CHECKED*(1-CPM)   
                                 ; (Here the program's space is under 32K, so a top that wrapped
                                 ; round always falls outside it.)
                              LD   A,H   
                              CP   HEAPLIM   
                              JR   NC,e_heap   
068E                          ENDIF      
068E                          IF   CHECKED   
                              PUSH   DE   
                              EX   DE,HL   
                              LD   HL,(NPEND)   
                              ADD   HL,DE   ; carry: at or above the program's end
                              EX   DE,HL   
                              POP   DE   
                              RET   C   
                    E_HEAP:   OR   A   ; put the count back in TOS for the report
                              SBC   HL,DE   
                              LD   A,"H"   
                              JR   errp   
                                 ; chkst: stop unless HL is in the program's own space: from the letter page
                                 ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
                                 ; whatever lies above the limit are safe. Memory above the heap top but
                                 ; below the limit is the program's own: Tiny BASIC keeps its lines there.
                                 ; It is the page of HL + 1 that is tested, so that one test serves both
                                 ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
                                 ; Keeps HL and BC. It runs on into its own error entry.
                    CHKST:    INC   HL   
                              LD   A,H   
                              DEC   HL   
                              CP   LETPAGE   
                              JR   C,e_store   
068E                          ENDIF      
068E                          IF   CHECKED*(1-CPM)   
                              CP   HEAPLIM   
                              RET   C   
068E                          ENDIF      
068E                          IF   CHECKED*CPM   
                              LD   E,A   
                              LD   A,(0007h)   ; the BDOS page is the heap limit
                              DEC   A   
                              CP   E   
                              RET   NC   
068E                          ENDIF      
068E                          IF   CHECKED   
                                 ; Error entries. Each loads its letter and then hides the next entry inside
                                 ; a 3-byte LD DE,nn (the 11h), so they all fall through to `error`.
                    E_STORE:   LD   A,"O"   ; a store outside the program's space
                              DB   11h   
                    E_BREAK:   LD   A,"B"   ; Ctrl-C (found inside pollk or getk)
                                 ; errp: an error found inside a routine: drop its return address first.
                    ERRP:     POP   DE   
                              JR   error   
                                 ; e_dollar: "$" ran into a NUL (in prstr): Q, with the string's address
                                 ; back in TOS. prstr"s return address goes first. But if "$' had no
                                 ; address at all (the stack was empty), it is s, found now: chkstk, called
                                 ; one cell up, sees the stack past its empty place then.
                    E_DOLLAR:   POP   DE   
                              POP   HL   
                              CALL   chkstk   
                              PUSH   HL   
                              LD   HL,(RSAVE)   
                              DB   11h   ; (LD DE,nn hides e_quote's first two bytes)
                    E_QUOTE:   LD   B,H   ; an unclosed string: HL is its address, one
                              LD   C,L   ;   past the opening quote, which is the place
                              LD   A,"Q"   
                              DB   11h   
                    E_RESV:   LD   A,"X"   ; a reserved byte outside a string
                              DB   11h   
                    E_ZERO:   LD   A,"Z"   ; dividing by zero
                              DB   11h   
                    E_BRACK:   LD   A,"W"   ; bad character after [
                                 ; error: the report, then the end. A = the letter, BC = one past the place,
                                 ; HL = TOS, and both stacks as the report is to show them:
                                 ; 
                                 ;   Err X @ line,col
                                 ;   D:n: the top 8 cells at most, bottom to top
                                 ;   R:n
                    ERROR:    PUSH   HL   ; now the whole data stack is in memory
                              LD   E,A   
                              CALL   pnl   
                              DB   "Err ",22h   
                              LD   A,E   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              CALL   pmsg   
                              DB   " @ ",22h   
                              DEC   BC   ; BC = the place
                                 ; The line and column. A place below the program is in the line
                                 ; buffer: line 0. Otherwise count the LFs from the program's start;
                                 ; DE = the line's number, HL = where it starts.
                              LD   HL,LINEBUF   
                              LD   DE,0   
                              LD   A,B   
                              CP   PROG/256   
                              JR   C,er3   
                              INC   H   
                              LD   L,E   ; HL = PROG
                    ER1:      INC   DE   ; a new line starts at HL
                              PUSH   HL   
                    ER2:      LD   A,L   
                              SUB   C   
                              LD   A,H   
                              SBC   A,B   
                              JR   NC,er2x   ; reached the place
                              LD   A,(HL)   
                              INC   HL   
                              CP   10   
                              JR   NZ,er2   
                              POP   AF   
                              JR   er1   
                    ER2X:     POP   HL   
                    ER3:      PUSH   BC   
                              PUSH   HL   
                              EX   DE,HL   
                              CALL   pdec   ; the line
                              ;*Macro unroll:  PUTK    2Ch             ; ','
                              DS   1-CPM,3Eh   ; ","
                              DS   1-CPM,2Ch   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,2Ch   
                              POP   DE   
                              POP   HL   
                              OR   A   
                              SBC   HL,DE   
                              INC   HL   
                              CALL   pdec   ; the column
                                 ; The two stack lines:  D:n: the top 8 cells at most, bottom to top
                                 ;                       R:n
                                 ; TOS is in memory with the rest (pushed) by now.
                              CALL   pnl   
                              DB   "D:",22h   
                              LD   HL,DSTOP-2   ; (DSTOP-2) - SP is twice the depth (the cell
                              SBC   HL,SP   ;   at DSTOP-2 was pushed with the first value
                                 ;   and holds nothing; pnl left the carry clear)
                              CALL   phalf   ; the depth
                              ;*Macro unroll:  PUTK    3Ah             ; ':'
                              DS   1-CPM,3Eh   ; ":"
                              DS   1-CPM,3Ah   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,3Ah   
                              LD   A,C   
                              CP   9   
                              JR   C,er6   
                              CALL   pmsg   
                              DB   " ...",22h   
                              LD   C,8   
                    ER6:      LD   H,0   ; C = the number of cells to show
                              LD   L,C   
                              ADD   HL,HL   
                              ADD   HL,SP   ; HL -> just above the deepest of them
                              INC   C   
                    ER7:      DEC   C   
                              JR   Z,er8   
                              DEC   HL   
                              LD   D,(HL)   
                              DEC   HL   
                              LD   E,(HL)   
                              PUSH   HL   
                              ;*Macro unroll:  PUTK    20h             ; ' '
                              DS   1-CPM,3Eh   ; " "
                              DS   1-CPM,20h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,20h   
                              EX   DE,HL   
                              CALL   psgn   
                              POP   HL   
                              JR   er7   
                    ER8:      CALL   pnl   
                              DB   "R:",22h   
                              PUSH   IY   ; RSTOP - IY is under 256 (the pointer is
                              POP   HL   ;   at most one entry below its page), so
                              LD   A,RSTOP&0FFh   ;   the low bytes are enough
                              SUB   L   
                              LD   L,A   
                              LD   H,0   
                              CALL   phalf   
                              CALL   pnl   
                              DB   22h   
068E                          ENDIF      
068E                          IF   CHECKED*(1-EDITOR)   
                              JP   endprog   
068E                          ENDIF      
068E                          IF   CHECKED*EDITOR   
                              JR   edit0   ; back to the editor, with both stacks cleared
068E                          ENDIF      
068E                          IF   CHECKED   
                                 ; phalf: print half of HL, and leave it in C.
                    PHALF:    SRL   H   
                              RR   L   
                              PUSH   HL   
                              CALL   pdec   
                              POP   BC   
                              RET      
068E                          ENDIF      
068E                             ; =============================================================================
068E                             ;  The line editor (EDITOR = 1)
068E                             ; 
068E                             ;  The interpreter starts here, and a program that ends comes back here.
068E                             ;  There is no prompt. It follows the spec's suggested standard for a line
068E                             ;  editor (docs/b8script.md, Environments). Type a line and press Return:
068E                             ; 
068E                             ;    n text    put the text in as line n; the lines from n on move down. A
068E                             ;              number past the end (or 0) adds the line at the end.
068E                             ;    n         take line n out
068E                             ;    anything else is run at once, as B8Script. (Start such a line with a
068E                             ;    space if it would begin with a digit.)
068E                             ; 
068E                             ;  A command key ends the line too, and takes what was typed as its argument:
068E                             ; 
068E                             ;    ^G        run the program
068E                             ;    n ^L      list from line n (no number: all of it). Any key holds the
068E                             ;              list until another key is pressed; Ctrl-C ends it.
068E                             ;    n ^E      put line n in the input line; Return puts it back, changed
068E                             ;    name ^R   read. CP/M: the file of that name (no name: the same file as
068E                             ;              last time). Generic: what is typed, or pasted, from now until
068E                             ;              ^Z replaces the program; it is not echoed.
068E                             ;    name ^W   write. CP/M: to that file (no name: the same file as last
068E                             ;              time). Generic: the text is printed, as it is.
068E                             ;    ^N        new: no program
068E                             ;    ^X        leave (to LEAVE)
068E                             ; 
068E                             ;  In the line: the left and right arrow keys move the cursor;
068E                             ;  a character goes in at the cursor; Backspace and DEL take out the one
068E                             ;  before it; Esc drops the line. Only CR, LF, BS and printing characters are
068E                             ;  sent to the terminal, so any terminal will do.
068E                             ; 
068E                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
068E                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
068E                             ;  125 characters; the one character after a line number separates it from
068E                             ;  the text and is not stored. The text is kept as it is typed, each line
068E                             ;  ending in CR LF, at PROG.
068E                             ; 
068E                             ;  What lasts from one line to the next: the program, the words, the
068E                             ;  variables and the data stack. An error or a break clears both stacks. The
068E                             ;  return stack starts empty for every line.
068E                             ; 
068E                             ;  Things to know:
068E                             ;    - Reset empties the program (generic builds).
068E                             ;    - A word's address points into the program, so run the program again
068E                             ;      after editing it.
068E                             ;    - Nothing is printed between a program's output and what is typed next.
068E                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
068E                             ;      a line that calls -n? and carries on afterwards runs what was typed.
068E                             ;      (The stored program never comes back to the line, so it may.)
068E                             ;    - The editor"s own keys are not the program"s: -n? is the plain line
068E                             ;      read of the other builds.
068E                             ; 
068E                             ;  The data stack is the CPU's stack, so the editor works on top of whatever
068E                             ;  the last line left there, with TOS pushed like the rest.
068E                             ; =============================================================================
068E                          IF   EDGEN   
                    INIT:        ; reset (A = 0)
068E                          ENDIF      
068E                          IF   EDGEN*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at 0, and
                                 ; every word cell holds 0000h, the address an undefined word is caught at
                                 ; (see e_hi).
                              LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
068E                          ENDIF      
068E                          IF   EDGEN   
                              JR   edit0   
068E                          ENDIF      
068E                          IF   EDITOR   
                                 ; Right arrow: one to the right, by printing the character there
                    RIGHT:    LD   A,L   
                              CP   E   
                              JR   Z,ed1   ; at the end
                              LD   A,(HL)   
                              INC   L   
                              JR   lf1   
                                 ; Esc: alone it drops the line. An arrow key sends Esc [ and a letter, so
                                 ; wait about 5 ms for a second key: after a "[" read on to the letter that
                                 ; ends the sequence, and act on C (right) and D (left).
                    ESC:      LD   BC,5*MSLOOP   
                    ES1:      CALL   rawk   
                              JR   NZ,es2   
                              DEC   BC   
                              LD   A,B   
                              OR   C   
                              JR   NZ,es1   
                              CALL   fin   ; no second key: the line is dropped
                              JR   edit   
                    ES2:      CP   "["   
                              JR   NZ,ed1   ; not a sequence known here
                    ES3:      CALL   ekey   
                              CP   40h   
                              JR   C,es3   ; (its parameters)
                              SUB   "C"   
                              JR   Z,right   
                              DEC   A   ; "D"?
                              JR   NZ,ed1   ; no: on into left
                                 ; Left arrow: the cursor goes one to the left
                    LEFT:     LD   A,L   
                              ADD   A,A   
                              JR   Z,ed1   ; (L = 80h: at the start)
                              DEC   L   
                              LD   A,8   
                              ;*Macro unroll: lf1:    PUTA
                    LF1:      DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              JR   ed1   
                                 ; edit0: reset, an error or a break: both stacks are cleared, and the cursor
                                 ;   is shown, in case the program had hidden it and could not show it again.
                                 ; skend: a program that ended inside skip: its return address goes.
                                 ; edend: a program that ended: TOS joins the rest of the data stack.
                    EDIT0:    LD   SP,DSTOP-2   ; empty (the cell that stands for TOS is pushed)
068E                          ENDIF      
068E                          IF   EDITOR*ANS   
                              XOR   A   ; (pshow wants the carry clear)
                              CALL   pshow   ; ESC [ ? 2 5 h
068E                          ENDIF      
068E                          IF   EDITOR*(1-ANS)   
                              LD   A,1   
                              CALL   CONCUR   ; show the cursor
068E                          ENDIF      
068E                          IF   EDITOR   
                              DB   21h   ; (LD HL,nn: steps over the next two bytes)
                    SKEND:    POP   DE   
                    EDEND:    PUSH   HL   
                                 ; edit: start a new input line.
                    EDIT:     LD   IY,RSTOP   ; the return stack is empty
                              ;*Macro unroll:  SETIX                   ; (a file read or written may have changed IX)
                              DS   CPM+FAST-CPM*FAST,0DDh   ; (a file read or written may have changed IX)
                              DS   CPM+FAST-CPM*FAST,21h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
                              LD   HL,0   
                              LD   (KEYBUF),HL   ; no key is held, and the break key is on
                              LD   (EDLN),HL   ; no line is being edited
                              LD   HL,LINEBUF   ; HL = the cursor,
                              LD   E,L   ;   E = the end of the line (its low byte)
                    ED1:      CALL   ekey   
                              CP   7Fh   
                              JR   Z,bsp   ; DEL
                              CP   " "   
                              JR   NC,insc   
                              CP   9   
                              JR   Z,insc   ; Tab is text
                              CP   8   
                              JR   Z,bsp   
                              CP   1Bh   
                              JR   Z,esc   
                              PUSH   HL   ; a command key? Look it up
                              LD   HL,cmds   
                              LD   B,NCMD   
                    ED2:      CP   (HL)   
                              INC   HL   
                              JR   Z,ed3   
                              INC   HL   
                              INC   HL   
                              DJNZ   ed2   
                              POP   HL   
                              JR   ed1   ; no: the key is ignored
                    ED3:      LD   A,(HL)   
                              INC   HL   
                              LD   H,(HL)   
                              LD   L,A   
                              EX   (SP),HL   ; the command's address: fin returns to it
                                 ; fin: end the input line: CR LF and a NUL after it, and a new line on the
                                 ; terminal. Leaves BC -> the line and HL -> the NUL.
                    FIN:      LD   H,LETPAGE   
                              LD   L,E   
                              LD   (HL),13   
                              INC   L   
                              LD   (HL),10   
                              DEC   L   
                              CALL   prl   ; (prints the CR LF)
                              LD   (HL),0   
                              LD   BC,LINEBUF   
                              RET      
                                 ; Backspace, DEL: the character before the cursor goes. The cursor moves
                                 ; left, the rest of the line moves down over it, and the last place (now a
                                 ; space) is printed over along with the rest.
                    BSP:      LD   A,L   
                              ADD   A,A   
                              JR   Z,ed1   ; at the start
                              DEC   L   
                              ;*Macro unroll:  PUTK    08h             ; backspace
                              DS   1-CPM,3Eh   ; backspace
                              DS   1-CPM,08h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,08h   
                              PUSH   HL   
                    BS1:      INC   L   
                              LD   A,(HL)   
                              DEC   L   
                              LD   (HL),A   
                              INC   L   
                              LD   A,L   
                              CP   E   
                              JR   NZ,bs1   
                              DEC   L   
                              LD   (HL)," "   
                              POP   HL   
                              LD   D,E   
                              DEC   E   
                              JR   ic2   
                                 ; A character goes in at the cursor: it ripples up through the rest of the
                                 ; line, the cursor moves on, and the rest is printed again.
                    INSC:     LD   B,A   
                              LD   A,E   
                              CP   0FDh   
                              JR   Z,ed1   ; the line is full: 125 characters
                              LD   A,B   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              PUSH   HL   
                    IC1:      LD   A,(HL)   
                              LD   (HL),B   
                              LD   B,A   
                              LD   A,L   
                              INC   L   
                              CP   E   
                              JR   NZ,ic1   
                              POP   HL   
                              INC   L   
                              INC   E   
                              LD   D,E   
                    IC2:      CALL   tail   
                              JR   ed1   
                                 ; tail: print the line from the cursor to D (a low byte), and bring the
                                 ; cursor back with backspaces. Nothing at all if the cursor is at D.
                    TAIL:     LD   C,L   
                    TA1:      LD   A,L   
                              CP   D   
                              JR   Z,ta2   
                              LD   A,(HL)   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              INC   L   
                              JR   ta1   
                    TA2:      LD   A,L   
                              CP   C   
                              RET   Z   
                              ;*Macro unroll:  PUTK    08h             ; backspace
                              DS   1-CPM,3Eh   ; backspace
                              DS   1-CPM,08h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,08h   
                              DEC   L   
                              JR   ta2   
                                 ; ekey: wait for a key
                    EKEY:     CALL   rawk   
                              JR   Z,ekey   
                              RET      
                                 ; The command keys, and where each goes (after fin).
                    CMDS:     DB   13   
                              DW   cret   
                              DB   7   ; ^G
                              DW   crun   
                              DB   12   ; ^L
                              DW   clist   
                              DB   5   ; ^E
                              DW   cedln   
                              DB   18   ; ^R
                              DW   cread   
                              DB   23   ; ^W
                              DW   cwrite   
                              DB   14   ; ^N
                              DW   cnew   
                              DB   24   ; ^X
                              DW   LEAVE   
                    NCMD:     EQU   8   
                                 ; ^N: no program
                    CNEW:     XOR   A   
                              LD   (PROG),A   
                    GED0:     JR   gedit   
                                 ; ^E: line n goes into the input line, to be changed. EDLN remembers which
                                 ; line it was: Return puts the text back in its place.
                    CEDLN:    CALL   rdnum   
                              PUSH   HL   
                              CALL   find   ; HL -> the line, or the NUL if there is none
                              POP   DE   
                              LD   A,(HL)   
                              OR   A   
                              JR   Z,ged0   
                              LD   (EDLN),DE   
                              LD   DE,LINEBUF   
                    CE1:      LD   A,(HL)   ; copy it, and show it, up to its CR (or LF)
                              CP   13   
                              JR   Z,ce2   
                              CP   10   
                              JR   Z,ce2   
                              LD   (DE),A   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              INC   HL   
                              INC   E   
                              LD   A,E   
                              CP   0FDh   ; (a longer line is cut at 125 characters)
                              JR   NZ,ce1   
                    CE2:      EX   DE,HL   ; the cursor is at the line's end
                              LD   E,L   
                              JP   ed1   
                                 ; Return. If ^E put a line here, the text goes back in its place. If not:
                                 ; a number and text is a line to put in, a number alone a line to take out,
                                 ; and anything else is run where it is.
                    CRET:     PUSH   HL   ; the end of what was typed
                              LD   HL,(EDLN)   
                              LD   A,H   
                              OR   L   
                              JR   Z,cr1   
                              PUSH   HL   
                              CALL   delln   
                              POP   HL   
                              JR   ins   
                    CR1:      CALL   rdnum   ; HL = the number it starts with, BC -> after
                              LD   A,C   ; C is still 80h if there was no number:
                              ADD   A,A   ;   only then is twice it 0
                              JR   Z,st0p   ; no number: run the line
                              LD   A,(BC)   
                              CP   13   
                              JR   NZ,cr2   
                              POP   DE   ; the number alone: take that line out
                              CALL   delln   
                              JR   gedit   
                    CR2:      INC   BC   ; step over the one character after the number
                                 ; Put the text at BC in as line n (in HL): open a gap of its length there,
                                 ; CR and LF included, and copy it in.
                    INS:      CALL   find   ; HL -> where it goes
                              POP   DE   ; the end of what was typed
                              LD   A,E   
                              SUB   C   ; A = the length of the text, with its CR LF
                              PUSH   BC   ; the text
                              LD   C,A   
                              LD   B,0   
                              PUSH   BC   ; its length
                              LD   D,H   
                              LD   E,L   ; DE = where it goes
                              XOR   A   
                              LD   C,A   ; BC = 0: CPIR looks as far as it needs to
                              CPIR      ; HL -> one past the program's NUL
                              SBC   HL,DE   ; the number of bytes to move up, NUL included
                              LD   B,H   
                              LD   C,L   
                              ADD   HL,DE   
                              DEC   HL   ; HL -> the NUL
                              EX   DE,HL   
                              EX   (SP),HL   ; HL = the length; where it goes is kept
                              PUSH   HL   
                              ADD   HL,DE   ; the NUL's new place
                              EX   DE,HL   
                              LDDR      ; move the rest of the program up
                              POP   BC   ; the length
                              POP   DE   ; where it goes
                              POP   HL   ; the text
                              LDIR      
                    GEDIT:    JP   edit   
                                 ; ^G: run the program. st0p: run the typed line (BC -> it).
                    CRUN:     LD   BC,PROG   
                              DB   3Eh   ; (LD A,n: steps over the POP)
                    ST0P:     POP   HL   ; (the end of what was typed)
                                 ; st0: start running at BC. The heap starts after the stored program's NUL.
                    ST0:      LD   HL,PROG   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
                              LD   (HEAP),HL   
068E                          ENDIF      
068E                          IF   EDITOR*QK   
                              CALL   skclr   ; every run starts with an empty skip cache
068E                          ENDIF      
068E                          IF   EDITOR*CHECKED   
                              ;*Macro unroll:  NEGH                    ; minus the heap's first address: '_' may not
                              DS   1-CPM,0E7h   ; minus the heap"s first address: "_' may not
                              DS   CPM,0CDh   
                              DS   CPM,ANEG&0FFh   
                              DS   CPM,ANEG/256   
                              LD   (NPEND),HL   ;   release below it
068E                          ENDIF      
068E                          IF   EDITOR   
                              POP   HL   ; TOS: the data stack is as the last line left it
                              ;*Macro unroll:  NEXT                    ; (its return address is thrown away)
                              DS   (1-CPM)*(1-FAST),0F7h   ; (its return address is thrown away)
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
                                 ; ^L: list from line n. DE = the number of the line at HL.
                    CLIST:    CALL   rdnum   ; HL = n, or 0 if there was none:
                              LD   A,H   
                              OR   L   
                              JR   NZ,li0   
                              INC   L   ;   then from line 1
                    LI0:      PUSH   HL   
                              CALL   find   
                              POP   DE   
                    LI1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,gedit   ; the end of the text
                              CALL   rawk   
                              JR   Z,li3   ; no key: carry on
                              CP   3   
                              CALL   NZ,ekey   ; any key but Ctrl-C: wait for one more
                              CP   3   
                              JR   Z,gedit   ; Ctrl-C, first or second, ends the list
                    LI3:      PUSH   HL   
                              PUSH   DE   
                              EX   DE,HL   
                              CALL   pdec   ; the line's number,
                              LD   A," "   
                              ;*Macro unroll:  PUTA                    ;   a space,
                              DS   1-CPM,0EFh   ;   a space,
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              POP   DE   
                              POP   HL   
                              INC   DE   
                              CALL   prl   ;   and the line
                              JR   li1   
                                 ; delln: take line n (in HL) out: copy everything after it down over it.
                    DELLN:    CALL   find   
                              LD   D,H   
                              LD   E,L   
                              CALL   nxl   ; HL -> the next line
                    DE1:      LD   A,(HL)   
                              LD   (DE),A   
                              INC   HL   
                              INC   DE   
                              OR   A   
                              JR   NZ,de1   
                              RET      
                                 ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
                                 ; of the text if there are fewer lines (or the number is 0). Keeps BC.
                    FIND:     EX   DE,HL   
                              LD   HL,PROG   
                    FI1:      DEC   DE   
                              LD   A,D   
                              OR   E   
                              RET   Z   
                              CALL   nxl   
                              JR   NZ,fi1   
                              RET      
                                 ; nxl: step HL over one line, to just past its LF (and return not-zero), or
                                 ; stop at the NUL that ends the text (and return zero).
                    NXL:      LD   A,(HL)   
                              OR   A   
                              RET   Z   
                              INC   HL   
                              CP   10   
                              JR   NZ,nxl   
                              OR   A   
                              RET      
                                 ; prl: print the line at HL, to its LF; HL -> just past it.
                    PRL:      LD   A,(HL)   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              LD   A,(HL)   
                              INC   HL   
                              CP   10   
                              JR   NZ,prl   
                              RET      
068E                          ENDIF      
068E                          IF   EDGEN   
                    GED1:     JP   edit   
                                 ; ^R, generic: what comes in from now until ^Z is the program. A CR is
                                 ; stored as CR LF; a LF right after a line end is dropped (it is the CR's
                                 ; own, or an empty line's), and a LF anywhere else ends a line too. A last
                                 ; line with no end is given one. Nothing is echoed, and there is no check
                                 ; for running out of memory.
                    CREAD:    LD   HL,PROG-1   
                              LD   (HL),10   ; (as if a line had just ended: the byte is
                              INC   HL   ;   the line buffer's last, and spare)
                    RD1:      CALL   ekey   
                              LD   C,A   
                              CP   1Ah   
                              JR   NZ,rd2   
                              LD   A,10   ; ^Z ends the last line, as a LF would
                    RD2:      CP   10   
                              JR   NZ,rd3   
                              DEC   HL   
                              CP   (HL)   
                              INC   HL   
                              JR   Z,rd4   ; straight after a line end: dropped
                              LD   A,13   ; anywhere else it ends the line
                    RD3:      LD   (HL),A   
                              INC   HL   
                              CP   13   
                              JR   NZ,rd4   
                              LD   (HL),10   ; after a CR goes a LF
                              INC   HL   
                    RD4:      LD   A,C   
                              CP   1Ah   
                              JR   NZ,rd1   
                              LD   (HL),0   
                              JR   ged1   
                                 ; ^W, generic: the text is printed as it is, for the terminal to capture.
                    CWRITE:   LD   HL,PROG   
                    CW1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,ged1   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              INC   HL   
                              JR   cw1   
068E                          ENDIF      
068E                          IF   EDITOR*CPM   
                    CFCB:     EQU   005Ch   ; the file's name is kept here, where the CCP
                                 ;   put the one from the command line
                                 ; ^W, CP/M: write the file: delete the old one, make it anew, write the
                                 ; text in records of 128 bytes, and close it. The text's NUL and the 127
                                 ; bytes after it are set to ^Z meanwhile, which pads the last record. (A
                                 ; full disk or directory is not noticed: the calls fail and that is all.)
                    CWRITE:   CALL   setname   
                              LD   C,19   ; delete
                              CALL   fbdos   
                              LD   C,22   ; make
                              CALL   fbdos   
                              LD   HL,PROG   
                              XOR   A   
                    CW1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,cw1   
                              DEC   HL   ; HL -> the NUL
                              PUSH   HL   
                              LD   B,128   
                    CW2:      LD   (HL),1Ah   
                              INC   HL   
                              DJNZ   cw2   
                              POP   HL   
                              LD   DE,PROG   
                    CW3:      LD   A,E   ; a record that starts before the end is written
                              SUB   L   
                              LD   A,D   
                              SBC   A,H   
                              JR   NC,cw4   
                              PUSH   HL   
                              LD   C,21   ; write, from where the record lies
                              CALL   frec   
                              POP   HL   
                              JR   cw3   
                    CW4:      LD   (HL),0   ; the NUL again
                              LD   C,16   ; close
                              CALL   fbdos   
                              JP   edit   
                                 ; frec: BDOS function C (read or write a record) with the 128 bytes at DE.
                                 ; Returns A = the BDOS's answer, HL = DE and DE = DE + 128.
                    FREC:     PUSH   DE   
                              PUSH   BC   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              POP   BC   
                              CALL   fbdos   
                              POP   DE   
                              LD   HL,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              RET      
                                 ; setname: if a name was typed (the line does not start with its CR), put it
                                 ; in the FCB: up to 8 characters, a dot, up to 3 more, in capitals. The drive
                                 ; is the current one. Then, name or no name, clear the FCB after the name,
                                 ; as it must be before a file is opened or made.
                    SETNAME:   LD   DE,LINEBUF   
                              LD   A,(DE)   
                              CP   13   
                              JR   Z,fcbclr   
                              LD   HL,CFCB   
                              LD   (HL),0   ; the current drive
                              LD   B,11   
                    SN1:      INC   L   
                              LD   (HL)," "   
                              DJNZ   sn1   
                              LD   L,CFCB+1   
                    SN2:      LD   A,(DE)   
                              INC   DE   
                              CP   13   
                              JR   Z,fcbclr   
                              CP   "."   
                              JR   NZ,sn3   
                              LD   L,CFCB+9   ; the type
                              JR   sn2   
                    SN3:      CP   "a"   
                              JR   C,sn4   
                              AND   5Fh   ; a capital
                    SN4:      LD   (HL),A   
                              INC   L   
                              JR   sn2   
                    FCBCLR:   LD   HL,CFCB+12   
                              LD   B,24   
                    FC1:      LD   (HL),0   
                              INC   HL   
                              DJNZ   fc1   
                              RET      
                                 ; fbdos: BDOS function C on the file
                    FBDOS:    LD   DE,CFCB   
                              JP   BDOS   
                                 ; ^R, CP/M: read the file. A name typed before the key is the file's name
                                 ; from now on. (On into load, which returns to edit.)
                    CREAD:    CALL   setname   
                              LD   HL,edit   
                              PUSH   HL   
                                 ; load: read the file into PROG. No such file: no program. The text ends at
                                 ; the file"s first ^Z (1Ah), which pads a text file"s last record; one more
                                 ; goes after the last record, so the search always stops. And every line
                                 ; must end in LF: a last line without one is given a CR LF. (The FCB is
                                 ; clear after its name: the CCP left it so, or setname did.)
                    LOAD:     LD   C,15   ; open (no such file: the first read fails
                              CALL   fbdos   ;   too)
                              LD   DE,PROG   
                    LD1:      LD   C,20   ; read the next 128 bytes
                              CALL   frec   
                              OR   A   
                              JR   Z,ld1   
                              LD   (HL),1Ah   ; (HL = where the record that failed would be)
                              LD   HL,PROG-1   
                              LD   A,10   ; (a file with no text needs nothing added)
                    TR1:      INC   HL   
                              LD   E,A   ; E = the character before this one
                              LD   A,(HL)   
                              CP   1Ah   
                              JR   NZ,tr1   
                              LD   A,E   
                              CP   10   
                              JR   Z,tr2   
                              LD   (HL),13   
                              INC   HL   
                              LD   (HL),10   
                              INC   HL   
                    TR2:      LD   (HL),0   
                              RET      
068E                          ENDIF      
068E                             ; =============================================================================
068E                          IF   CPM   
068E                             ; The RAM pages follow the image; the heap may grow to the BDOS.
068E                START:       
068E                          ENDIF      
068E                          IF   CPM*CHECKED*(1-EDITOR)   
                                 ; Clear the lower half of the letter page (as the editor build does
                                 ; at its start).
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
068E                          ENDIF      
068E                          IF   CPM*(1-EDITOR)   
068E   11 5C 00               LD   DE,005Ch   ; open the file named on the command line
0691   0E 0F                  LD   C,15   ; (no such file: the first read fails too,
0693   CD 05 00               CALL   BDOS   ;   and the program is empty)
0696   11 00 17               LD   DE,PROG   
0699   D5           LD1:      PUSH   DE   
069A   0E 1A                  LD   C,26   ; set the DMA address
069C   CD 05 00               CALL   BDOS   
069F   11 5C 00               LD   DE,005Ch   
06A2   0E 14                  LD   C,20   ; read the next 128 bytes
06A4   CD 05 00               CALL   BDOS   
06A7   E1                     POP   HL   ; HL = the address this record went to
06A8   B7                     OR   A   
06A9   20 07                  JR   NZ,ld2   
06AB   11 80 00               LD   DE,128   
06AE   19                     ADD   HL,DE   
06AF   EB                     EX   DE,HL   
06B0   18 E7                  JR   ld1   
06B2   36 00        LD2:      LD   (HL),0   ; the end of the file counts as NUL
06B4   23                     INC   HL   ; the heap starts after it
06B5   01 00 17               LD   BC,PROG   ; the IP
06B8                          ENDIF      
06B8                          IF   CPM*(1-EDITOR)*QK   
06B8   CD F8 04               CALL   skclr   ; an empty skip cache
06BB                          ENDIF      
06BB                          IF   CPM*(1-EDITOR)   
06BB   C3 1F 01               JP   st2   
06BE                          ENDIF      
06BE                          IF   FAST   
06BE                             ; =============================================================================
06BE                             ;  The speed build (FAST = 1)
06BE                             ; 
06BE                             ;  The inner loop is a table: 256 entries, the low bytes of the handlers'
06BE                             ;  addresses in one page and the high bytes in the next. The dispatcher (at
06BE                             ;  next0, and inline, as NEXTF, at the end of the speed build's own entries,
06BE                             ;  so there is no jump back to it; the ordinary handlers end in JP (IX), with
06BE                             ;  IX = next0, as in the CP/M builds):
06BE                             ; 
06BE                             ;      LD A,(BC) / INC BC / EX DE,HL / LD L,A / LD H,DTAB/256 /
06BE                             ;      LD A,(HL) / INC H / LD H,(HL) / LD L,A / JP (HL)
06BE                             ; 
06BE                             ;  So every entry starts with TOS in DE, not HL. The punctuation entries are
06BE                             ;  thunks into the ordinary handlers (EX DE,HL / JP handler); the letters and
06BE                             ;  digits have one entry each, which knows its cell or its value already.
06BE                             ; =============================================================================
06BE   EB           FTSTORE:   EX   DE,HL   ; !
06BF   C3 64 02               JP   h_store   
06C2   EB           FTSTR:    EX   DE,HL   ; "
06C3   C3 6B 02               JP   h_str   
06C6   EB           FTNUM:    EX   DE,HL   ; #
06C7   C3 95 02               JP   h_num   
06CA   EB           FTPRINT:   EX   DE,HL   ; $
06CB   C3 73 02               JP   h_print   
06CE   EB           FTSWAP:   EX   DE,HL   ; %
06CF   C3 5C 02               JP   h_swap   
06D2   EB           FTAND:    EX   DE,HL   ; &
06D3   C3 12 02               JP   h_and   
06D6   EB           FTEMIT:   EX   DE,HL   ; '
06D7   C3 8E 02               JP   h_emit   
06DA   EB           FTOPEN:   EX   DE,HL   ; (
06DB   C3 EB 01               JP   h_open   
06DE   EB           FTCLOSE:   EX   DE,HL   ; )
06DF   C3 F3 01               JP   h_close   
06E2   EB           FTMUL:    EX   DE,HL   ; *
06E3   C3 35 02               JP   h_mul   
06E6   EB           FTADD:    EX   DE,HL   ; +
06E7   C3 05 02               JP   h_add   
06EA   EB           FTCFETCH:   EX   DE,HL   ; ,
06EB   C3 B3 02               JP   h_cfetch   
06EE   EB           FTSUB:    EX   DE,HL   ; -
06EF   C3 FB 01               JP   h_sub   
06F2   EB           FTCSTORE:   EX   DE,HL   ; .
06F3   C3 5F 02               JP   h_cstore   
06F6   EB           FTDIV:    EX   DE,HL   ; /
06F7   C3 39 02               JP   h_div   
06FA   EB           FTDUP:    EX   DE,HL   ; :
06FB   C3 59 02               JP   h_dup   
06FE   EB           FTDROP:   EX   DE,HL   ; ;
06FF   C3 61 02               JP   h_drop   
0702   EB           FTLT:     EX   DE,HL   ; <
0703   C3 1B 02               JP   h_lt   
0706   EB           FTEQ:     EX   DE,HL   ; =
0707   C3 2B 02               JP   h_eq   
070A   EB           FTGT:     EX   DE,HL   ; >
070B   C3 1C 02               JP   h_gt   
070E   EB           FTKEY:    EX   DE,HL   ; ?
070F   C3 9B 02               JP   h_key   
0712   EB           FTFETCH:   EX   DE,HL   ; @
0713   C3 E5 01               JP   h_fetch   
0716   EB           FTDEF:    EX   DE,HL   ; [
0717   C3 C7 01               JP   h_def   
071A   EB           FTBREAK:   EX   DE,HL   ; \
071B   C3 B7 01               JP   h_break   
071E   EB           FTRET:    EX   DE,HL   ; ]
071F   C3 B0 01               JP   h_ret   
0722   EB           FTXOR:    EX   DE,HL   ; ^
0723   C3 32 01               JP   h_xor   
0726   EB           FTALLOC:   EX   DE,HL   ; _
0727   C3 4A 01               JP   h_alloc   
072A   EB           FTGRAVE:   EX   DE,HL   ; `
072B   C3 99 01               JP   h_grave   
072E   EB           FTTOR:    EX   DE,HL   ; {
072F   C3 95 01               JP   h_tor   
0732   EB           FTOR:     EX   DE,HL   ; |
0733   C3 3B 01               JP   h_or   
0736   EB           FTFROMR:   EX   DE,HL   ; }
0737   C3 06 01               JP   h_fromr   
073A   EB           FTNOT:    EX   DE,HL   ; ~
073B   C3 44 01               JP   h_not   
073E                             ; The commonest punctuation, written for the speed build: TOS in DE on the
073E                             ; way in, and the dispatcher inline on the way out.
073E                FS_ADD:      ; +
073E   E1                     POP   HL   
073F   19                     ADD   HL,DE   
0740                          ;*Macro unroll:  NEXTF
0740                          DS   FAST*CHECKED,0CDh   
0740                          DS   FAST*CHECKED,ACHK&0FFh   
0740                          DS   FAST*CHECKED,ACHK/256   
0740   0A                     DS   FAST,0Ah   
0741   03                     DS   FAST,03h   
0742   EB                     DS   FAST,0EBh   
0743   6F                     DS   FAST,6Fh   
0744   26                     DS   FAST,26h   
0745   11                     DS   FAST,DTPG   
0746   7E                     DS   FAST,7Eh   
0747   24                     DS   FAST,24h   
0748   66                     DS   FAST,66h   
0749   6F                     DS   FAST,6Fh   
074A   E9                     DS   FAST,0E9h   
074B                FS_SUB:      ; -
074B   0A                     LD   A,(BC)   ; a digit next: a negative number
074C   D6 30                  SUB   "0"   
074E   FE 0A                  CP   10   
0750   38 0F                  JR   C,fs_neg   
0752   E1                     POP   HL   
0753   B7                     OR   A   
0754   ED 52                  SBC   HL,DE   
0756                          ;*Macro unroll:  NEXTF
0756                          DS   FAST*CHECKED,0CDh   
0756                          DS   FAST*CHECKED,ACHK&0FFh   
0756                          DS   FAST*CHECKED,ACHK/256   
0756   0A                     DS   FAST,0Ah   
0757   03                     DS   FAST,03h   
0758   EB                     DS   FAST,0EBh   
0759   6F                     DS   FAST,6Fh   
075A   26                     DS   FAST,26h   
075B   11                     DS   FAST,DTPG   
075C   7E                     DS   FAST,7Eh   
075D   24                     DS   FAST,24h   
075E   66                     DS   FAST,66h   
075F   6F                     DS   FAST,6Fh   
0760   E9                     DS   FAST,0E9h   
0761   EB           FS_NEG:   EX   DE,HL   
0762   C3 FB 01               JP   h_sub   
0765                FS_DUP:      ; :
0765   D5                     PUSH   DE   
0766   EB                     EX   DE,HL   
0767                          ;*Macro unroll:  NEXTF
0767                          DS   FAST*CHECKED,0CDh   
0767                          DS   FAST*CHECKED,ACHK&0FFh   
0767                          DS   FAST*CHECKED,ACHK/256   
0767   0A                     DS   FAST,0Ah   
0768   03                     DS   FAST,03h   
0769   EB                     DS   FAST,0EBh   
076A   6F                     DS   FAST,6Fh   
076B   26                     DS   FAST,26h   
076C   11                     DS   FAST,DTPG   
076D   7E                     DS   FAST,7Eh   
076E   24                     DS   FAST,24h   
076F   66                     DS   FAST,66h   
0770   6F                     DS   FAST,6Fh   
0771   E9                     DS   FAST,0E9h   
0772                FS_DROP:      ; ;
0772   E1                     POP   HL   
0773                          ;*Macro unroll:  NEXTF
0773                          DS   FAST*CHECKED,0CDh   
0773                          DS   FAST*CHECKED,ACHK&0FFh   
0773                          DS   FAST*CHECKED,ACHK/256   
0773   0A                     DS   FAST,0Ah   
0774   03                     DS   FAST,03h   
0775   EB                     DS   FAST,0EBh   
0776   6F                     DS   FAST,6Fh   
0777   26                     DS   FAST,26h   
0778   11                     DS   FAST,DTPG   
0779   7E                     DS   FAST,7Eh   
077A   24                     DS   FAST,24h   
077B   66                     DS   FAST,66h   
077C   6F                     DS   FAST,6Fh   
077D   E9                     DS   FAST,0E9h   
077E                FS_SWAP:      ; %
077E   E1                     POP   HL   
077F   D5                     PUSH   DE   
0780                          ;*Macro unroll:  NEXTF
0780                          DS   FAST*CHECKED,0CDh   
0780                          DS   FAST*CHECKED,ACHK&0FFh   
