E2A1                             ; one past the [.
E2A1   E6 08                  INC   PLACE   
E2A3   D0 02                  BNE   eb1   
E2A5   E6 09                  INC   PLACE+1   
E2A7   A9 57        EB1:      LDA   #"W"   
E2A9   4C 92 E5               JMP   error   
E2AC                          ENDIF      
E2AC   20 78 E5     H_DEF:    JSR   getc   
E2AF   38                     SEC      
E2B0   E9 41                  SBC   #"A"   ; a letter gives 0-25 or 32-57: lowercase
E2B2   A8                     TAY      ;   lands 64 bytes up
E2B3   29 DF                  AND   #0DFh   ; fold case: 0-25 only for a letter
E2B5   C9 1A                  CMP   #26   
E2B7                          IF   1-CHECKED   
                              BCS   def2   ; not a letter
E2B7                          ENDIF      
E2B7                          IF   CHECKED   
E2B7   B0 E4                  BCS   def1   
E2B9                          ENDIF      
E2B9   98                     TYA      
E2BA   0A                     ASL      
E2BB   A8                     TAY      ; Y -> the cell
E2BC   A5 00                  LDA   IP   
E2BE   99 00 04               STA   LET,Y   
E2C1   A5 01                  LDA   IP+1   
E2C3   99 01 04               STA   LET+1,Y   
E2C6   D0 03                  BNE   dsk   ; always: no program is in page zero
E2C8   20 F5 E4     DEF2:     JSR   puship   ; an anonymous block: push its address
E2CB                DSK:         
E2CB                          IF   CHECKED   
E2CB   A9 29                  LDA   #")"   ; the wrong closer for [
E2CD                          ENDIF      
E2CD   4C 11 E4               JMP   skip   
E2D0                             ; ---- machine code: the grave
E2D0                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
E2D0                             ; are stored from addr until a non-hex character; then a RET (60h) is
E2D0                             ; written and its address is left. An odd last digit is consumed and dropped.
E2D0                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ); see the
E2D0                             ; contract in the header.
E2D0   20 67 E5     H_GRAVE:   JSR   rdhex   
E2D3   B0 1C                  BCS   exec   
E2D5   0A           HX1:      ASL      
E2D6   0A                     ASL      
E2D7   0A                     ASL      
E2D8   0A                     ASL      
E2D9   85 04                  STA   T0   
E2DB   20 67 E5               JSR   rdhex   
E2DE   B0 0C                  BCS   hx2   ; odd digit: already consumed, dropped
E2E0   05 04                  ORA   T0   
E2E2   81 00                  STA   (0,X)   ; (never checked)
E2E4   20 96 E2               JSR   inctos   
E2E7   20 67 E5               JSR   rdhex   
E2EA   90 E9                  BCC   hx1   
