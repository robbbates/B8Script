026E   F7                     RST   30h   
026F                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
026F                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
026F                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
026F                             ; stops on it.
026F                H_DIV:       
026F                          IF   CHECKED   
                              LD   A,H   
                              OR   L   
                              JP   Z,e_zero   
026F                          ENDIF      
