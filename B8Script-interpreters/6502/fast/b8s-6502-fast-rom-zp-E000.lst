                              JMP   EXIT   ; NUL: the end of the program
E794                          ENDIF      
E794                          IF   QK*CHECKED   
E794   4C 53 EA               JMP   sknul   
E797                          ENDIF      
E797                          IF   QK   
E797   E6 01        SQW:      INC   IP+1   ; Y went round: on into the next page
E799   D0 DF                  BNE   sq2   ; always
E79B   20 EA E7     SQQ:      JSR   sqip   ; a string: step over it
E79E   20 7E E2               JSR   skipstr   
E7A1                          ENDIF      
E7A1                          IF   QK*CHECKED   
E7A1   D0 03                  BNE   sqq1   
E7A3   4C 53 EA               JMP   sknul   ; the string ran into the end
E7A6                SQQ1:        
E7A6                          ENDIF      
