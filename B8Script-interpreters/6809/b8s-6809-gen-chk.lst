F196                             ; drops the block start, "]" returns. No closer at all ends the program.
F196   EC C1        H_BREAK:   LDD   ,U++   
F198   27 5D                  BEQ   sk9   ; false: nothing to do
F19A   8D 3C                  BSR   skip   
F19C   4D                     TSTA      ; skip returns 0 for ")"
F19D                          IF   CHECKED   
F19D   10 2B FE 5F            LBMI   fin   ; (and FFh for the NUL: the program ends)
F1A1                          ENDIF      
