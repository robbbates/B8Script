0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the 6502 (NMOS opcodes only)
0000                             ;  Spec: docs/b8script.md (2026-11-21). -n? does no more editing than
0000                             ;        Backspace. The break key is checked in the checked build only (at
0000                             ;        every ")" loop-back and every return).
0000                             ;  Design follows the Z80 interpreter; see b8s-z80.asm for the common ideas.
0000                             ; 
0000                             ;  This interpreter keeps the data stack in pages 2 and 3 (252 cells) and
0000                             ;  uses 10 bytes of zero page. b8s-6502-zp.asm is a smaller interpreter that
0000                             ;  keeps the stack in zero page instead (112 cells); its memory map and
0000                             ;  machine-code contract differ.
0000                             ; 
0000                             ;  One switch, set in the EQU line below:
0000                             ;    CHECKED  0 = no checks: whatever the spec calls unsafe is not caught
0000                             ;             1 = a checked build, as in the spec's "Errors and checked
0000                             ;                 builds": at startup every word cell points at 0000h (see
0000                             ;                 e_undef) and the variables and the interpreter's cells are
0000                             ;                 0. It stops with S s R r (stack over/underflow), H (heap),
0000                             ;                 O (a store outside the program's space), U (undefined
0000                             ;                 word), Q (no closing quote), W (bad character after [), X
0000                             ;                 (a reserved byte), Z (divide by zero), N (brackets) or B
0000                             ;                 (Ctrl-C), printing the spec's four-line report:
0000                             ;                   Err Z @ 3,4
0000                             ;                   0/ "no"$
0000                             ;                   Stk 2: 5 0
0000                             ;                   Rtn 0
0000                             ;                 and then goes to EXIT.
0000                             ; 
0000                             ;  Assembler: asm80, C6502 mode.
0000                             ; =============================================================================
0000                CHECKED:   EQU   0   ; 1 = checked build
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Registers and zero page
0000                             ; 
0000                             ;    IP      zero-page pointer to the next program character (16 bits)
0000                             ;    TL/TH   the top data-stack cell (TOS) lives in zero page, not in memory
0000                             ;    X       data-stack index. The stack is two byte-planes, grows down, and
0000                             ;            holds everything under TOS: NOS is DSL,X (low) and DSH,X (high).
0000                             ;            The stack never leaves its planes because X is 8 bits.
0000                             ;    S       the hardware stack is the RETURN stack: a word call or "(" pushes
0000                             ;            the reading position (high byte first, then low) and "]" or ")"
0000                             ;            pulls it. 100 entries (200 bytes) fit with room to spare.
0000                             ;    Y, A    scratch. Y is 0 after peek/getc, and the zero-page indirect reads
0000                             ;            (IP),Y rely on that.
0000                             ; 
0000                             ;  Dispatch: step is called with JSR, so a handler ends with a plain RTS and
0000                             ;  lands on "JMP next" in the loop. Punctuation goes through PTAB with the
0000                             ;  RTS trick (push handler-1, RTS). Handlers that use the return stack ( ( ) \
0000                             ;  ] 00bbIA== and word calls ) first pull the 2-byte JSR frame off (PLA PLA) and end
0000                             ;  with JMP next instead.
0000                             ; 
0000                             ;  Every punctuation handler starts with the carry clear (the range sort in
0000                             ;  step leaves it so). Several of them count on that, where the comments say.
0000                             ; 
0000                             ;  Machine-code contract (the grave): the code at TOS is entered as a
0000                             ;  subroutine, by JMP (T0) with the loop's return address on the hardware
0000                             ;  stack, so it ends with RTS (60h, which the hex loader appends). On entry
0000                             ;  TL/TH ($02/$03) hold the new TOS (the address is already consumed) and X is
0000                             ;  the data-stack index: NOS is DSL,X (low) and DSH,X (high), which is
0000                             ;  $0200,X and $0300,X.
0000                             ;  To push: DEX, store TL/TH at DSL,X/DSH,X, then set TL/TH. To drop: load
0000                             ;  TL/TH from DSL,X/DSH,X and INX. The code may change A, Y, X (it is the
0000                             ;  stack index, so it must stay consistent on return) and zero page $04-$06
0000                             ;  and $08-$09; it must keep IP ($00/$01) and the hardware stack balanced. On
0000                             ;  return TL/TH are the TOS. Zero page $0A-$0F is free for the code's own use.
0000                             ; -----------------------------------------------------------------------------
0000                IP:       EQU   00h   ; 00-01 reading position
0000                TL:       EQU   02h   ; TOS low
0000                TH:       EQU   03h   ; TOS high
0000                T0:       EQU   04h   ; scratch
0000                T1:       EQU   05h   
0000                T2:       EQU   06h   
0000                D0:       EQU   08h   ; divisor (division, number printing)
0000                D1:       EQU   09h   
0000                RSV:      EQU   07h   ; checked: S as it was before this character
0000                             ; The error report (checked) runs after the program, so it may use the zero
0000                             ; page that machine code has ($0A-$0F):
0000                P:        EQU   0Ah   ; 0A-0B the place being reported
0000                Q:        EQU   0Ch   ; 0C-0D a pointer for counting lines
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map
0000                             ; 
0000                             ;    0000-00FF  zero page: the variables above
0000                             ;    0100-01FF  hardware stack = return stack, S starts at FF
0000                             ;    0200       DSL, data stack, low bytes (X = FC when empty: 252 cells)
0000                             ;    0300       DSH, data stack, high bytes
0000                             ;    0400       LET  letter cells: A..Z at +00..+33, a..z at +40..+73 (a word
0000                             ;               cell is 64 bytes below its variable), heap pointer at +7C,
0000                             ;               the -n? line buffer at +80..+FF. The checked build's cells
0000                             ;               are in the gaps: KEYBUF at +34, PLACE at +36, PEND at +38.
0000                             ;               (+7A and +7B are kept free.)
0000                             ;    0500       PROG the program text, NUL-terminated; the heap follows
0000                             ;    E000       the interpreter (ROM)
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the page range LETPAGE..HEAPLIM-1.
0000                             ; -----------------------------------------------------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The Z flag must match A (it does
0000                             ;   if the routine ends with LDA / RTS).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                             ;   KEY and CONOUT must preserve X and Y.
0000                DSL:      EQU   0200h   ; data stack, low bytes
0000                DSH:      EQU   0300h   ; data stack, high bytes
0000                DSE:      EQU   0FCh   ; X when the data stack is empty
0000                LETPAGE:   EQU   04h   
0000                LET:      EQU   LETPAGE*256   
0000                PROG:     EQU   0500h   ; where the loader puts the program text
0000                PROG1:    EQU   PROG+1   
0000                HEAPLIM:   EQU   0E0h   ; the heap must stay below E000h (a page)
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer (the heap top)
0000                KEYBUF:   EQU   LET+34h   ; a key held back by the break check
0000                PLACE:    EQU   LET+36h   ; checked: the address of this character
0000                PEND:     EQU   LET+38h   ; checked: the program's end, where the heap
0000                             ;   starts: it may not be released below it
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                LBM1:     EQU   LINEBUF-1   ; (for the error report)
0000                PROGM1:   EQU   PROG-1   
0000                RSLIM:    EQU   20h   ; lowest S allowed (checked build)
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms; tune it
E000                          .ORG   0E000h   
E000                             ; =============================================================================
E000                             ;  Startup: find the NUL, the heap starts after it
E000                             ; =============================================================================
E000   A2 FF        START:    LDX   #0FFh   
E002   9A                     TXS      ; return stack empty
E003                          IF   CHECKED   
                                 ; The first half of the letter page is zeroed: every variable, every
                                 ; cell of the interpreter's own (no key held back), and every word
                                 ; cell, which then points at 0000h: calling an undefined word stops
                                 ; with U (see e_undef).
                              INX      
                              TXA      ; A = 0
                              LDY   #7Fh   
                    STZ:      STA   LET,Y   
                              DEY      
                              BPL   stz   
E003                          ENDIF      
E003   20 89 E1               JSR   rstip   
E006   20 7D E1     ST1:      JSR   getc   
E009   D0 FB                  BNE   st1   ; IP ends just past the NUL
E00B   A5 00                  LDA   IP   
E00D   8D 7C 04               STA   HEAP   
E010                          IF   CHECKED   
                              STA   PEND   
E010                          ENDIF      
E010   A5 01                  LDA   IP+1   
E012   8D 7D 04               STA   HEAP+1   
E015                          IF   CHECKED   
                              STA   PEND+1   
E015                          ENDIF      
E015   20 89 E1               JSR   rstip   
E018   A2 FC                  LDX   #DSE   
E01A                             ; =============================================================================
E01A                             ;  The inner loop
E01A                             ; =============================================================================
E01A                NEXT:        
E01A                          IF   CHECKED   
                                 ; Both stacks are checked once per character, after it has run. The
                                 ; return stack has overrun when S is below RSLIM: an overflow leaves
                                 ; it at 1Eh or 1Fh, an underflow wraps it to 01h (no handler pulls
                                 ; more than one entry). The data stack has when X is above DSE: an
                                 ; underflow moves X up to FDh or FEh (no handler moves X by more
                                 ; than 2), and an overflow wraps it from 00h to FFh.
                                 ; S is kept in RSV, for the report's Rtn line (an error found inside
                                 ; a handler has its own calls on the hardware stack), and the place
                                 ; of the character about to run in PLACE.
                              TXA      ; TSX trashes X: keep it in A
                              TSX      
                              STX   RSV   
                              CPX   #RSLIM   
                              TAX      ; TAX leaves the carry alone
                              BCC   e_rstack   
                              CPX   #DSE+1   
                              BCS   e_stack   
                              LDA   IP   
                              STA   PLACE   
                              LDA   IP+1   
                              STA   PLACE+1   
E01A                          ENDIF      
E01A   20 20 E0               JSR   step   
E01D   4C 1A E0               JMP   next   
E020                             ; step: read one character and sort it by range.
E020                             ;    00h          end of program
E020                             ;    01h-20h, 7Fh-FFh   ignored
E020                             ;    30h-39h      digit: read a whole number
E020                             ;    41h-5Ah      A-Z: call the word in that letter's cell
E020                             ;    61h-7Ah      a-z: push the address of that letter's cell
E020                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
E020                             ; Every way out of the sort has the carry clear, except "ignored". A checked
E020                             ; build stops on 80h-FFh (X) and still ignores DEL.
E020   20 7D E1     STEP:     JSR   getc   ; flags follow A
E023   F0 36                  BEQ   endprog   
E025   38                     SEC      
E026   E9 21                  SBC   #21h   ; A = c - 21h
E028   90 30                  BCC   ign   ; 01h-20h
E02A   C9 0F                  CMP   #0Fh   
E02C   90 22                  BCC   punct   ; 21h-2Fh: index 0-14
E02E   E9 0F                  SBC   #0Fh   ; (carry set) A = c - 30h
E030   C9 0A                  CMP   #10   
E032   90 2F                  BCC   digit   
E034   C9 11                  CMP   #11h   
E036   90 16                  BCC   p3a   ; 3Ah-40h
E038   E9 11                  SBC   #11h   ; (carry set) A = c - 41h
E03A   C9 1A                  CMP   #1Ah   
E03C   90 20                  BCC   upper   ; 41h-5Ah
E03E   C9 20                  CMP   #20h   
E040   90 0A                  BCC   p5b   ; 5Bh-60h
E042   C9 3A                  CMP   #3Ah   
E044   90 25                  BCC   lower   ; 61h-7Ah: A = 20h-39h
E046   C9 3E                  CMP   #3Eh   
E048                          IF   1-CHECKED   
E048   B0 10                  BCS   ign   ; 7Fh-FFh
E04A                          ENDIF      
E04A                          IF   CHECKED   
                              BEQ   ign   ; 7Fh
                              BCS   e_resv   ; 80h-FFh: reserved
E04A                          ENDIF      
E04A                             ; The three adjustments below chain. Each ADC adds the carry the one
E04A                             ; before it left, which the constants allow for.
E04A   E9 1A                  SBC   #1Ah   ; 7Bh-7Eh: (carry clear: -1Bh) index 28-31
E04C   69 F6        P5B:      ADC   #0F6h   ; 5Bh-60h: -10 (-9 when chained), index 22-27
E04E   69 05        P3A:      ADC   #5   ; 3Ah-40h: +5 (+6 when chained), index 15-21
E050   0A           PUNCT:    ASL      ; (the index is small: the carry stays clear)
E051   A8                     TAY      
E052   B9 03 E1               LDA   PTAB+1,Y   
E055   48                     PHA      
E056   B9 02 E1               LDA   PTAB,Y   
E059   48                     PHA      
E05A   60           IGN:      RTS      ; RTS trick: goes to the handler. Reached
E05B                             ; directly, it just ends an ignored character.
E05B                ENDPROG:      
E05B                          IF   CHECKED   
                              LDA   IP+1   ; IP in page zero: an undefined word
                              BEQ   e_undef   
E05B                          ENDIF      
E05B   4C 09 FF               JMP   EXIT   
E05E                          IF   CHECKED   
                                 ; e_undef: the word cells of undefined words hold 0000h. A call there reads
                                 ; the byte at 0000h, which is IP's own low byte: 00h while IP is 0000h, so
                                 ; the call reads a NUL with IP in page zero, where no program can be. The
                                 ; call is undone first: the step frame and the return address come off the
                                 ; hardware stack, and the place is the call letter (the return address - 1).
                    E_UNDEF:   PLA      
                              PLA      ; the step frame
                              PLA      
                              SEC      
                              SBC   #1   
                              STA   PLACE   
                              PLA      
                              SBC   #0   
                              STA   PLACE+1   
                              INC   RSV   
                              INC   RSV   ; Rtn does not count the call
                              LDA   #"U"   
                              BNE   ejmp   ; always
                                 ; S/R are overflows, s/r underflows. After an underflow that stack counts as
                                 ; empty.
                    E_RSTACK:   LDA   RSV   
                              CMP   #10h   
                              LDA   #"R"   
                              BCS   ejmp   ; S is 1Eh-1Fh: an overflow
                              LDA   #0FFh   
                              STA   RSV   ; S wrapped to 01h: Rtn 0
                              LDA   #"r"   
                              BNE   ejmp   ; always
                    E_STACK:   CPX   #0FFh   
                              LDA   #"S"   
                              BCS   ejmp   ; X wrapped from 00h to FFh: an overflow
                              LDX   #DSE   ; an underflow: Stk 0
                              LDA   #"s"   
                              DB   2Ch   ; (BIT abs: hides the next instruction)
                    E_RESV:   LDA   #"X"   ; a reserved byte, 80h-FFh
                    EJMP:     JMP   error   
E05E                          ENDIF      
E05E                             ; A-Z: call the word. The return address (the IP after the letter) goes on
E05E                             ; the return stack, and the IP becomes the address in the letter's cell.
E05E   0A           UPPER:    ASL      
E05F   A8                     TAY      
E060   38                     SEC      
E061   B0 2C                  BCS   pushn   ; always
E063                             ; Digits: the first one is in A; read the rest of the number.
E063   A0 00        DIGIT:    LDY   #0   
E065   20 74 E0               JSR   pushay   
E068   4C 69 E1               JMP   rdnum   
E06B                             ; a-z: push the cell's address (the cell is the variable)
E06B   0A           LOWER:    ASL      
E06C   A0 04                  LDY   #>LET   
E06E   D0 04                  BNE   pushay   ; always
E070   A5 00        PUSHIP:   LDA   IP   ; push the reading position
E072   A4 01                  LDY   IP+1   
E074                             ; pushay: push a cell: A = its low byte, Y = its high byte
E074   48           PUSHAY:   PHA      
E075   20 7E E0               JSR   push   
E078   68                     PLA      
E079   85 02                  STA   TL   
E07B   84 03                  STY   TH   
E07D   60                     RTS      
E07E   CA           PUSH:     DEX      ; ":" and every push (keeps Y)
E07F   A5 02                  LDA   TL   
E081   9D 00 02               STA   DSL,X   
E084   A5 03                  LDA   TH   
E086   9D 00 03               STA   DSH,X   
E089   60                     RTS      
E08A                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
E08A                             ; the matching ")".
E08A   20 92 E1     H_OPEN:   JSR   flag   ; (keeps the carry clear)
E08D                          IF   1-CHECKED   
E08D   F0 36                  BEQ   skip   
E08F                          ENDIF      
E08F                          IF   CHECKED   
                              BEQ   skpar   
E08F                          ENDIF      
E08F                             ; pushn: take the step frame off, push the reading position on the return
E08F                             ; stack, and go on. With the carry set (a word call) the reading position
E08F                             ; then becomes the address in the letter cell at LET,Y.
E08F   68           PUSHN:    PLA      
E090   68                     PLA      ; drop the step frame
E091   A5 01                  LDA   IP+1   
E093   48                     PHA      
E094   A5 00                  LDA   IP   
E096   48                     PHA      
E097   90 0A                  BCC   nxt   
E099   B9 00 04               LDA   LET,Y   
E09C   85 00                  STA   IP   
E09E   B9 01 04               LDA   LET+1,Y   
E0A1   85 01                  STA   IP+1   
E0A3   4C 1A E0     NXT:      JMP   next   
E0A6                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
E0A6                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
E0A6                             ; the body"s address instead. Either way it then skips to the matching "]'.
E0A6                             ; (The unchecked build takes anything that is not a letter as the space; the
E0A6                             ; checked build stops on it.)
E0A6                          IF   CHECKED   
                    DEF1:     CPY   #" "-"A"+256   
                              BEQ   def2   
                                 ; W: anything but a letter or a space after [. The place is that character,
                                 ; one past the [.
                              INC   PLACE   
                              BNE   eb1   
                              INC   PLACE+1   
                    EB1:      LDA   #"W"   
                              BNE   ejmp   ; always
                                 ; A false ( skips: the wrong closer for it is ].
                    SKPAR:    LDA   #"]"   
                              BNE   skip   ; always
E0A6                          ENDIF      
E0A6   20 7D E1     H_DEF:    JSR   getc   
E0A9   38                     SEC      
E0AA   E9 41                  SBC   #"A"   ; a letter gives 0-25 or 32-57: lowercase
E0AC   A8                     TAY      ;   lands 64 bytes up
E0AD   29 DF                  AND   #0DFh   ; fold case: 0-25 only for a letter
E0AF   C9 1A                  CMP   #26   
E0B1                          IF   1-CHECKED   
E0B1   B0 0F                  BCS   def2   ; not a letter
E0B3                          ENDIF      
E0B3                          IF   CHECKED   
                              BCS   def1   
E0B3                          ENDIF      
E0B3   98                     TYA      
E0B4   0A                     ASL      
E0B5   A8                     TAY      ; Y -> the cell
E0B6   A5 00                  LDA   IP   
E0B8   99 00 04               STA   LET,Y   
E0BB   A5 01                  LDA   IP+1   
E0BD   99 01 04               STA   LET+1,Y   
E0C0   D0 03                  BNE   skdef   ; always: no program is in page zero
E0C2   20 70 E0     DEF2:     JSR   puship   ; an anonymous block: push its address
E0C5                SKDEF:       
E0C5                          IF   CHECKED   
                              LDA   #")"   ; the wrong closer for [
E0C5                          ENDIF      
E0C5                             ; skip: read past text to the closer at this level, and return it in A.
E0C5                             ; Brackets of both kinds count together; strings are stepped over whole. A
E0C5                             ; NUL first ends the program.
E0C5                             ; In the checked build A holds, on the way in, the wrong closer for the
E0C5                             ; opener that started the skip, kept in T0: ] for (, ) for [, and 0 for \,
E0C5                             ; which takes either. Meeting the wrong closer at this level, or the end
E0C5                             ; (a NUL, or a string that runs into it), stops with N, except for \,
E0C5                             ; which then ends the program as before.
E0C5                SKIP:        
E0C5                          IF   CHECKED   
                              STA   T0   
E0C5                          ENDIF      
E0C5   A9 00                  LDA   #0   
E0C7   85 06                  STA   T2   ; depth
E0C9   20 7D E1     SK1:      JSR   getc   
E0CC                          IF   1-CHECKED   
E0CC   F0 8D                  BEQ   endprog   
E0CE                          ENDIF      
E0CE                          IF   CHECKED   
                              BEQ   sknul   
E0CE                          ENDIF      
E0CE   C9 22                  CMP   #22h   
E0D0   D0 03                  BNE   sk2   
E0D2   20 F1 E0               JSR   skipstr   ; leaves A = 22h (11h when checked), which
E0D5                             ;   matches nothing below
E0D5                          IF   CHECKED   
                              BEQ   sknul   ; the string ran into the end
E0D5                          ENDIF      
E0D5   C9 28        SK2:      CMP   #"("   
E0D7   F0 11                  BEQ   sk3   
E0D9   C9 5B                  CMP   #"["   
E0DB   F0 0D                  BEQ   sk3   
E0DD   C9 29                  CMP   #")"   
E0DF   F0 04                  BEQ   sk4   
E0E1   C9 5D                  CMP   #"]"   
E0E3   D0 E4                  BNE   sk1   
E0E5   C6 06        SK4:      DEC   T2   
E0E7   10 E0                  BPL   sk1   
E0E9                          IF   CHECKED   
                              CMP   T0   
                              BEQ   e_nest   ; the wrong kind
E0E9                          ENDIF      
E0E9   60                     RTS      ; the closer at this level
E0EA   E6 06        SK3:      INC   T2   
E0EC   D0 DB                  BNE   sk1   
E0EE                          IF   CHECKED   
                    SKNUL:    LDA   T0   
                              BNE   e_nest   ; ( and [ stop with N
                              JMP   EXIT   ; \ ends the program
                    E_NEST:   LDA   #"N"   ; a skip from ( or [ found the wrong closer
                              DB   2Ch   ;   or the end: the place is the opener
                    E_QUOTE:   LDA   #"Q"   ; a string from 22h runs into the end
                              JMP   error   
E0EE                          ENDIF      
E0EE                             ; 22h pushes the address of the text after it and skips the string.
E0EE   20 70 E0     H_STR:    JSR   puship   
E0F1                          IF   CHECKED   
                              JSR   skipstr   
                              BEQ   e_quote   ; it ran into the end: the place is the 22h
                              RTS      
E0F1                          ENDIF      
E0F1                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
E0F1                             ; the next character, so "/"" does not end it.
E0F1                             ; Unchecked, it returns with Z set and A = 22h, and it does not look for the
E0F1                             ; end. Checked, it returns with Z clear and A = 11h, or with Z set if the
E0F1                             ; text ended first (a NUL, also one just after "/").
E0F1                          IF   1-CHECKED   
E0F1   20 7D E1     SKIPSTR:   JSR   getc   
E0F4   C9 2F                  CMP   #"/"   
E0F6   F0 05                  BEQ   ss0   
E0F8   C9 22                  CMP   #22h   
E0FA   D0 F5                  BNE   skipstr   
E0FC   60                     RTS      
E0FD   20 80 E1     SS0:      JSR   incip   
E100   D0 EF                  BNE   skipstr   ; A is "/" here
E102                          ENDIF      
E102                          IF   CHECKED   
                    SKIPSTR:   JSR   getc   
                              BEQ   ss9   ; the end
                              CMP   #"/"   
                              BNE   ss1   
                              JSR   getc   ; the escaped character
                              BNE   skipstr   
                    SS9:      RTS      ; the end, just after "/"
                    SS1:      CMP   #22h   
                              BNE   skipstr   
                              LSR      ; A = 11h, Z clear
                              RTS      
E102                          ENDIF      
E102                             ; =============================================================================
E102                             ;  Dispatch table: one handler per punctuation character, in code order.
E102                             ;  Entries are handler-1 for the RTS trick.
E102                             ; =============================================================================
E102   9A E1        PTAB:     DW   h_store-1   ; !
E104   ED E0                  DW   h_str-1   ; "
E106   68 E3                  DW   h_num-1   ; #
E108   4A E3                  DW   h_print-1   ; $
E10A   A5 E2                  DW   h_swap-1   ; %
E10C   FA E1                  DW   h_and-1   ; &
E10E   60 E3                  DW   h_emit-1   ; '
E110   89 E0                  DW   h_open-1   ; (
E112   D0 E1                  DW   h_close-1   ; )
E114   7D E2                  DW   h_mul-1   ; *
E116   2C E2                  DW   h_add-1   ; +
E118   A3 E3                  DW   h_cfetch-1   ; ,
E11A   24 E2                  DW   h_sub-1   ; -
E11C   A1 E1                  DW   h_cstore-1   ; .
E11E   BA E2                  DW   h_div-1   ; /
E120   7D E0                  DW   push-1   ; :
E122   A9 E1                  DW   drop-1   ; ;
E124   5B E2                  DW   h_lt-1   ; <
E126   6D E2                  DW   h_eq-1   ; =
E128   58 E2                  DW   h_gt-1   ; >
E12A   AC E3                  DW   h_key-1   ; ?
E12C   97 E3                  DW   h_fetch-1   ; @
E12E   A5 E0                  DW   h_def-1   ; [
E130   E7 E1                  DW   h_break-1   ; \
E132   D6 E1                  DW   h_ret-1   ; ]
E134   16 E2                  DW   h_xor-1   ; ^
E136   28 E3                  DW   h_alloc-1   ; _
E138   0D E4                  DW   h_grave-1   ; `
E13A   B5 E1                  DW   h_tor-1   ; {
E13C   08 E2                  DW   h_or-1   ; |
E13E   C2 E1                  DW   h_fromr-1   ; }
E140   44 E2                  DW   h_not-1   ; ~
E142                             ; rdnum: TOS = TOS*10 + digit for each digit at IP. Wraps at 16 bits. The
E142                             ; test is at the bottom so the loop closes with a branch. Returns with the
E142                             ; carry set.
E142   20 80 E1     RD1:      JSR   incip   ; (keeps A = the digit)
E145   06 02                  ASL   TL   
E147   26 03                  ROL   TH   ; x2
E149   18                     CLC      
E14A   65 02                  ADC   TL   
E14C   85 04                  STA   T0   
E14E   A5 03                  LDA   TH   
E150   69 00                  ADC   #0   
E152   85 05                  STA   T1   ; T = x2 + digit
E154   06 02                  ASL   TL   
E156   26 03                  ROL   TH   
E158   06 02                  ASL   TL   
E15A   26 03                  ROL   TH   ; x8
E15C   18                     CLC      
E15D   A5 02                  LDA   TL   
E15F   65 04                  ADC   T0   
E161   85 02                  STA   TL   
E163   A5 03                  LDA   TH   
E165   65 05                  ADC   T1   
E167   85 03                  STA   TH   ; x8 + x2 + digit
E169   20 6F E1     RDNUM:    JSR   isdig   
E16C   90 D4                  BCC   rd1   
E16E   60                     RTS      
E16F                             ; isdig: A = the character at IP minus "0"; the carry is clear if it is a
E16F                             ; digit. Y = 0.
E16F   20 78 E1     ISDIG:    JSR   peek   
E172   38                     SEC      
E173   E9 30                  SBC   #"0"   
E175   C9 0A                  CMP   #10   
E177   60                     RTS      
E178                             ; =============================================================================
E178                             ;  Reading the program
E178                             ;    peek: A = the character at IP, IP unchanged, Y = 0
E178                             ;    getc: the same, then IP moves on; flags follow A
E178                             ;    incip: IP moves on; keeps A, the carry and Y
E178                             ; =============================================================================
E178   A0 00        PEEK:     LDY   #0   
E17A   B1 00                  LDA   (IP),Y   
E17C   60                     RTS      
E17D   20 78 E1     GETC:     JSR   peek   
E180   E6 00        INCIP:    INC   IP   
E182   D0 02                  BNE   ic1   
E184   E6 01                  INC   IP+1   
E186   09 00        IC1:      ORA   #0   
E188   60                     RTS      
E189                             ; rstip: point IP at the start of the program
E189   A9 00        RSTIP:    LDA   #<PROG   
E18B   85 00                  STA   IP   
E18D   A9 05                  LDA   #>PROG   
E18F   85 01                  STA   IP+1   
E191   60                     RTS      
E192                             ; =============================================================================
E192                             ;  Stack
E192                             ; =============================================================================
E192                             ; flag: pops TOS and returns with Z set if it was 0. Keeps the carry.
E192   A5 02        FLAG:     LDA   TL   
E194   05 03                  ORA   TH   
E196   20 AA E1               JSR   drop   
E199   A8                     TAY      ; (drop's INX changed the flags)
E19A   60                     RTS      
E19B                             ; "!" ( n addr -- ) is "." plus the high byte. Both end in drop.
E19B                H_STORE:      
E19B                          IF   CHECKED   
                              LDA   TL   ; both bytes must be in the program's space:
                              ADC   #1   ; check the page of addr+1 (the carry is
                              LDA   TH   ; clear on the way in)
                              ADC   #0   
                              JSR   chkst   
E19B                          ENDIF      
E19B   BD 00 03               LDA   DSH,X   
E19E   A0 01                  LDY   #1   
E1A0   91 02                  STA   (TL),Y   
E1A2                H_CSTORE:      ; "." ( c addr -- )
E1A2                          IF   CHECKED   
                              LDA   TH   
                              JSR   chkst   
E1A2                          ENDIF      
E1A2   BD 00 02               LDA   DSL,X   
E1A5   A0 00                  LDY   #0   
E1A7   91 02                  STA   (TL),Y   
E1A9   E8                     INX      ; falls into drop
E1AA                             ; drop: ";" and every drop. It works through Y, so A and the carry are kept;
E1AA                             ; it returns with Z clear.
E1AA   BC 00 02     DROP:     LDY   DSL,X   
E1AD   84 02                  STY   TL   
E1AF   BC 00 03               LDY   DSH,X   
E1B2   84 03                  STY   TH   
E1B4   E8                     INX      
E1B5   60                     RTS      
E1B6                             ; "{" TOS to the return stack, "}" return stack to TOS
E1B6   68           H_TOR:    PLA      
E1B7   68                     PLA      
E1B8   A5 03                  LDA   TH   
E1BA   48                     PHA      
E1BB   A5 02                  LDA   TL   
E1BD   48                     PHA      
E1BE   20 AA E1               JSR   drop   
E1C1   D0 0B                  BNE   nxt2   ; always
E1C3   68           H_FROMR:   PLA      
E1C4   68                     PLA      
E1C5   20 7E E0               JSR   push   
E1C8   68                     PLA      
E1C9   85 02                  STA   TL   
E1CB   68                     PLA      
E1CC   85 03                  STA   TH   
E1CE   4C 1A E0     NXT2:     JMP   next   
E1D1                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
E1D1                             ; drops it and carries on. It shares "]"s code: with the carry clear, as
E1D1                             ; it is here, the address popped is pushed back.
E1D1   20 92 E1     H_CLOSE:   JSR   flag   
E1D4   F0 1E                  BEQ   rdrop   
E1D6   24                     DB   24h   ; (BIT zp: steps over the SEC)
E1D7                             ; "]" returns: pull an address and jump to it.
E1D7   38           H_RET:    SEC      
E1D8                          IF   CHECKED   
                              JSR   chkbrk   ; Ctrl-C is checked at every loop-back and
E1D8                          ENDIF      ;   every word return (it keeps the carry)
E1D8   68                     PLA      
E1D9   68                     PLA      ; drop the step frame
E1DA   68                     PLA      
E1DB   85 00                  STA   IP   
E1DD   68                     PLA      
E1DE   85 01                  STA   IP+1   
E1E0   B0 EC                  BCS   nxt2   
E1E2   48                     PHA      ; ")": keep the block start
E1E3   A5 00                  LDA   IP   
E1E5   48                     PHA      
E1E6   90 E6                  BCC   nxt2   ; always
E1E8                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
E1E8                             ; drops the block start, "]" returns.
E1E8   20 92 E1     H_BREAK:   JSR   flag   
E1EB   F0 6B                  BEQ   ab9   
E1ED                          IF   CHECKED   
                              LDA   #0   ; \ takes either closer
E1ED                          ENDIF      
E1ED   20 C5 E0               JSR   skip   
E1F0   C9 29                  CMP   #")"   
E1F2   D0 E3                  BNE   h_ret   
E1F4   68           RDROP:    PLA      
E1F5   68                     PLA      
E1F6   68                     PLA      
E1F7   68                     PLA      
E1F8   4C 1A E0               JMP   next   
E1FB                             ; =============================================================================
E1FB                             ;  Arithmetic and logic. Effects are ( NOS TOS -- result ).
E1FB                             ; =============================================================================
E1FB                             ; The logic operators leave the carry as they found it, clear, so they can
E1FB                             ; branch to fin.
E1FB   BD 00 02     H_AND:    LDA   DSL,X   
E1FE   25 02                  AND   TL   
E200   85 02                  STA   TL   
E202   BD 00 03               LDA   DSH,X   
E205   25 03                  AND   TH   
E207   90 31                  BCC   fin   ; always
E209   BD 00 02     H_OR:     LDA   DSL,X   
E20C   05 02                  ORA   TL   
E20E   85 02                  STA   TL   
E210   BD 00 03               LDA   DSH,X   
E213   05 03                  ORA   TH   
E215   90 23                  BCC   fin   ; always
E217   BD 00 02     H_XOR:    LDA   DSL,X   
E21A   45 02                  EOR   TL   
E21C   85 02                  STA   TL   
E21E   BD 00 03               LDA   DSH,X   
E221   45 03                  EOR   TH   
E223   90 15                  BCC   fin   ; always
E225                             ; "-" has two jobs: directly before a digit it starts a negative number.
E225   20 6F E1     H_SUB:    JSR   isdig   
E228   90 14                  BCC   negnum   
E22A   20 4B E2     SUB1:     JSR   neg   ; a - b = a + (-b)
E22D   18           H_ADD:    CLC      
E22E   BD 00 02               LDA   DSL,X   
E231   65 02                  ADC   TL   
E233   85 02                  STA   TL   
E235   BD 00 03               LDA   DSH,X   
E238   65 03                  ADC   TH   ; falls into fin
E23A                             ; fin: finish a two-operand op: A = the high byte of the result
E23A   85 03        FIN:      STA   TH   
E23C   E8                     INX      
E23D   60                     RTS      
E23E   A9 00        NEGNUM:   LDA   #0   ; a number from 0 (the digit routine's start)
E240   20 63 E0               JSR   digit   ; (comes back with the carry set)
E243   B0 06                  BCS   neg   ; always: the number, negated
E245                             ; "~": -x - 1, which is neg with the carry clear, as it is here
E245   90 05        H_NOT:    BCC   neg1   ; always
E247                             ; absv: TOS = |TOS|.  negm: TOS = -TOS if the N flag is set.
E247   A5 03        ABSV:     LDA   TH   
E249   10 0D        NEGM:     BPL   ab9   
E24B                             ; neg: TOS = -TOS
E24B   38           NEG:      SEC      
E24C   A9 00        NEG1:     LDA   #0   
E24E   E5 02                  SBC   TL   
E250   85 02                  STA   TL   
E252   A9 00                  LDA   #0   
E254   E5 03                  SBC   TH   
E256   85 03                  STA   TH   
E258   60           AB9:      RTS      
E259                             ; Signed compares: a - b sets N and V; N xor V is "a < b". The carry ends up
E259                             ; clear for true, and bool turns it into -1 (true) or 0 (both pop NOS first).
E259   20 A6 E2     H_GT:     JSR   h_swap   ; a > b is b < a
E25C   BD 00 02     H_LT:     LDA   DSL,X   
E25F   C5 02                  CMP   TL   
E261   BD 00 03               LDA   DSH,X   
E264   E5 03                  SBC   TH   
E266   70 02                  BVS   lt1   
E268   49 80                  EOR   #80h   
E26A   0A           LT1:      ASL      
E26B   E8                     INX      ; (keeps the carry; never leaves X at 0)
E26C   D0 07                  BNE   bool   ; always
E26E   20 2A E2     H_EQ:     JSR   sub1   ; a - b: zero if equal; A = its high byte
E271   05 02                  ORA   TL   
E273   C9 01                  CMP   #1   ; carry clear if A = 0
E275   A9 00        BOOL:     LDA   #0   
E277   69 FF                  ADC   #0FFh   ; carry clear: FF, set: 00
E279   85 02                  STA   TL   
E27B   85 03                  STA   TH   
E27D   60                     RTS      
E27E                             ; "*": the classic shift-right multiply. The multiplier leaves TH:TL from the
E27E                             ; bottom while the product comes in at the top, through A:T0 above it; after
E27E                             ; 16 rounds TH:TL hold the low 16 bits, which are all that is kept.
E27E   A0 10        H_MUL:    LDY   #16   
E280   84 05                  STY   T1   ; the round count
E282   A9 00                  LDA   #0   
E284   85 04                  STA   T0   ; A:T0 = the upper half
E286   46 03                  LSR   TH   
E288   66 02                  ROR   TL   ; the first multiplier bit
E28A   90 0D        ML1:      BCC   ml2   
E28C   A8                     TAY      
E28D   18                     CLC      
E28E   A5 04                  LDA   T0   
E290   7D 00 02               ADC   DSL,X   
E293   85 04                  STA   T0   
E295   98                     TYA      
E296   7D 00 03               ADC   DSH,X   ; upper half += the multiplicand
E299   6A           ML2:      ROR      
E29A   66 04                  ROR   T0   
E29C   66 03                  ROR   TH   
E29E   66 02                  ROR   TL   ; everything one place right; next bit out
E2A0   C6 05                  DEC   T1   
E2A2   D0 E6                  BNE   ml1   
E2A4   E8                     INX      ; drop the multiplicand
E2A5   60                     RTS      
E2A6   BC 00 02     H_SWAP:   LDY   DSL,X   ; "%"
E2A9   A5 02                  LDA   TL   
E2AB   9D 00 02               STA   DSL,X   
E2AE   84 02                  STY   TL   
E2B0   BC 00 03               LDY   DSH,X   
E2B3   A5 03                  LDA   TH   
E2B5   9D 00 03               STA   DSH,X   
E2B8   84 03                  STY   TH   
E2BA   60                     RTS      
E2BB                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
E2BB                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
E2BB                             ; of a. Unchecked, dividing by zero returns two cells of no meaning; checked,
E2BB                             ; it stops with Z.
E2BB                          IF   CHECKED   
                    E_ZERO:   LDA   #"Z"   ; divide by zero, the stack as it was
                              JMP   error   
E2BB                          ENDIF      
E2BB                H_DIV:       
E2BB                          IF   CHECKED   
                              LDA   TL   
                              ORA   TH   
                              BEQ   e_zero   
E2BB                          ENDIF      
E2BB   BD 00 03               LDA   DSH,X   
E2BE   48                     PHA      ; a's sign: for r
E2BF   45 03                  EOR   TH   
E2C1   48                     PHA      ; a xor b: for q
E2C2   20 47 E2               JSR   absv   
E2C5   A5 02                  LDA   TL   
E2C7   85 08                  STA   D0   
E2C9   A5 03                  LDA   TH   
E2CB   85 09                  STA   D1   ; D = |b|
E2CD   BD 00 02               LDA   DSL,X   
E2D0   85 02                  STA   TL   
E2D2   BD 00 03               LDA   DSH,X   
E2D5   85 03                  STA   TH   
E2D7   20 47 E2               JSR   absv   ; TOS = |a|
E2DA   20 E8 E2               JSR   udiv   ; TOS = q, NOS = r
E2DD   68                     PLA      
E2DE   20 49 E2               JSR   negm   ; q's sign
E2E1   20 A6 E2               JSR   h_swap   ; r on top
E2E4   68                     PLA      
E2E5   4C 49 E2               JMP   negm   ; r's sign
E2E8                             ; udiv: unsigned TOS / D (D <= 8000h). TOS becomes the quotient and the NOS
E2E8                             ; cell the remainder (whatever was there is lost).
E2E8                             ; Dividing by 2 is one shift (the spec wants that fast).
E2E8   A9 00        UDIV:     LDA   #0   
E2EA   9D 00 02               STA   DSL,X   
E2ED   9D 00 03               STA   DSH,X   
E2F0   A5 08                  LDA   D0   
E2F2   49 02                  EOR   #2   
E2F4   05 09                  ORA   D1   
E2F6   D0 08                  BNE   ud0   
E2F8   46 03                  LSR   TH   
E2FA   66 02                  ROR   TL   ; the quotient
E2FC   3E 00 02               ROL   DSL,X   ; the remainder: the bit that fell out
E2FF   60                     RTS      
E300   A0 10        UD0:      LDY   #16   
E302   06 02        UD1:      ASL   TL   
E304   26 03                  ROL   TH   
E306   3E 00 02               ROL   DSL,X   
E309   3E 00 03               ROL   DSH,X   
E30C   38                     SEC      
E30D   BD 00 02               LDA   DSL,X   
E310   E5 08                  SBC   D0   
E312   85 04                  STA   T0   
E314   BD 00 03               LDA   DSH,X   
E317   E5 09                  SBC   D1   
E319   90 0A                  BCC   ud2   
E31B   9D 00 03               STA   DSH,X   
E31E   A5 04                  LDA   T0   
E320   9D 00 02               STA   DSL,X   
E323   E6 02                  INC   TL   ; the quotient bit (TL's bit 0 is free)
E325   88           UD2:      DEY      
E326   D0 DA                  BNE   ud1   
E328   60           UD9:      RTS      
E329                             ; =============================================================================
E329                             ;  Storage
E329                             ; =============================================================================
E329                             ; "_" ( n -- addr ): the heap top moves by n, which is signed: a negative
E329                             ; count releases. TOS becomes the old top. (The carry is clear on the way in.)
E329                          IF   1-CHECKED   
E329   AD 7C 04     H_ALLOC:   LDA   HEAP   
E32C   A8                     TAY      
E32D   65 02                  ADC   TL   
E32F   8D 7C 04               STA   HEAP   
E332   84 02                  STY   TL   
E334   AD 7D 04               LDA   HEAP+1   
E337   A8                     TAY      
E338   65 03                  ADC   TH   
E33A   8D 7D 04               STA   HEAP+1   
E33D   84 03                  STY   TH   
E33F   60                     RTS      
E340                          ENDIF      
E340                             ; The checked build works the new top out first, in T0 and Y, and stops with
E340                             ; H, the count still on the stack, if it is at or past the limit, below the
E340                             ; program's end, or if the 16-bit add wrapped. A wrap is the V flag of the
E340                             ; high bytes" add with the old top"s sign bit flipped: that makes the old top
E340                             ; a signed number from -8000h, so the add overflows exactly when the true
E340                             ; sum leaves 0000h-FFFFh.
E340                          IF   CHECKED   
                    H_ALLOC:   LDA   HEAP   
                              ADC   TL   
                              STA   T0   
                              LDA   HEAP+1   
                              EOR   #80h   
                              ADC   TH   
                              BVS   e_heap   ; wrapped
                              EOR   #80h   ; the new top's high byte
                              CMP   #HEAPLIM   
                              BCS   e_heap   ; at or past the limit
                              TAY      
                              LDA   T0   
                              CMP   PEND   
                              TYA      
                              SBC   PEND+1   
                              BCC   e_heap   ; below the program's end
                              LDA   HEAP   
                              STA   TL   
                              LDA   T0   
                              STA   HEAP   
                              LDA   HEAP+1   
                              STA   TH   
                              STY   HEAP+1   
                              RTS      
                                 ; Errors found by handlers. The stacks are as they were before the handler.
                    E_HEAP:   LDA   #"H"   ; heap past the limit or below the program
                              DB   2Ch   ; (BIT abs: hides the next instruction)
                    E_STORE:   LDA   #"O"   ; a store outside the program's space
                              JMP   error   
                                 ; chkst: stop unless the page in A is in the program's own space, from the
                                 ; letter page up to the heap limit. Keeps Y.
                    CHKST:    CMP   #LETPAGE   
                              BCC   e_store   
                              CMP   #HEAPLIM   
                              BCS   e_store   
                              RTS      
E340                          ENDIF      
E340                             ; =============================================================================
E340                             ;  Console
E340                             ; =============================================================================
E340                             ; tosget: A = the byte at TOS, and TOS moves on.  inctos: TOS moves on.
E340   A0 00        TOSGET:   LDY   #0   
E342   B1 02                  LDA   (TL),Y   
E344   E6 02        INCTOS:   INC   TL   
E346   D0 02                  BNE   tg1   
E348   E6 03                  INC   TH   
E34A   60           TG1:      RTS      
E34B                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character
E34B                             ; clears that character"s bit 6 (/M is CR, /` is space; "/" and ""' have no
E34B                             ; bit 6, so // and /" give themselves).
E34B                             ; The checked build walks a copy of TOS along the string, so that the address
E34B                             ; is still there if it stops with Q on a NUL.
E34B                H_PRINT:      
E34B                          IF   CHECKED   
                              JSR   push   ; the copy
                              JSR   pr0   
                              JMP   drop   
                    PR0:         
E34B                          ENDIF      
E34B   20 40 E3               JSR   tosget   
E34E   C9 22                  CMP   #22h   
E350   F0 14                  BEQ   pdrop   
E352                          IF   CHECKED   
                              CMP   #0   
                              BEQ   e_qpr   
E352                          ENDIF      
E352   C9 2F                  CMP   #"/"   
E354   D0 05                  BNE   pr1   
E356   20 40 E3               JSR   tosget   
E359   29 BF                  AND   #0BFh   
E35B   20 03 FF     PR1:      JSR   CONOUT   
E35E                          IF   1-CHECKED   
E35E   4C 4B E3               JMP   h_print   
E361                          ENDIF      
E361                          IF   CHECKED   
                              JMP   pr0   
                    E_QPR:    JSR   drop   ; the copy goes: the address is TOS again
                              LDA   #"Q"   ; $ ran into the end
                              JMP   error   
E361                          ENDIF      
E361   A5 02        H_EMIT:   LDA   TL   ; "'"
E363   20 03 FF               JSR   CONOUT   
E366   4C AA E1     PDROP:    JMP   drop   
E369                             ; "#" prints TOS as a signed decimal number, with no space after it. The
E369                             ; digits are divided off and held on the hardware stack, ended by a 0. udiv
E369                             ; leaves each remainder in the NOS cell, so a spare cell is opened for it.
E369   A5 03        H_NUM:    LDA   TH   
E36B   10 08                  BPL   pn1   
E36D   A9 2D                  LDA   #"-"   
E36F   20 03 FF               JSR   CONOUT   
E372   20 4B E2               JSR   neg   
E375   CA           PN1:      DEX      ; the spare cell
E376   A9 0A                  LDA   #10   
E378   85 08                  STA   D0   
E37A   A9 00                  LDA   #0   
E37C   85 09                  STA   D1   
E37E   48                     PHA      ; the end marker
E37F   20 E8 E2     PN2:      JSR   udiv   
E382   BD 00 02               LDA   DSL,X   
E385   09 30                  ORA   #"0"   
E387   48                     PHA      
E388   A5 02                  LDA   TL   
E38A   05 03                  ORA   TH   
E38C   D0 F1                  BNE   pn2   
E38E   E8                     INX      
E38F   68           PN3:      PLA      
E390   F0 D4                  BEQ   pdrop   
E392   20 03 FF               JSR   CONOUT   
E395   4C 8F E3               JMP   pn3   
E398   A0 01        H_FETCH:   LDY   #1   ; "@"
E39A   B1 02                  LDA   (TL),Y   
E39C   48                     PHA      ; the high byte, while "," gets the low one
E39D   20 A4 E3               JSR   h_cfetch   
E3A0   68                     PLA      
E3A1   85 03                  STA   TH   
E3A3   60                     RTS      
E3A4                H_CFETCH:      ; ","
E3A4   A0 00                  LDY   #0   
E3A6   B1 02                  LDA   (TL),Y   
E3A8   85 02        CF2:      STA   TL   ; TOS = A (Y = 0)
E3AA   84 03                  STY   TH   
E3AC   60                     RTS      
E3AD                             ; "?" ( n -- c ) or ( -n -- addr )
E3AD                             ;   n > 0: wait about n ms for a key; 0 if none came
E3AD                             ;   n = 0: wait for a key
E3AD                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
E3AD                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
E3AD   A5 03        H_KEY:    LDA   TH   
E3AF   30 20                  BMI   line   
E3B1   A0 28        KT1:      LDY   #MSLOOP   ; one millisecond, roughly
E3B3   20 06 FF     KT2:      JSR   getk   
E3B6   D0 15                  BNE   kt3   
E3B8   88                     DEY      
E3B9   D0 F8                  BNE   kt2   
E3BB   A5 02                  LDA   TL   ; count the millisecond off:
E3BD   D0 06                  BNE   kt4   
E3BF   A5 03                  LDA   TH   
E3C1   F0 EE                  BEQ   kt1   ; 0? never counts down: it waits
E3C3   C6 03                  DEC   TH   
E3C5   C6 02        KT4:      DEC   TL   
E3C7   D0 E8                  BNE   kt1   
E3C9   A5 03                  LDA   TH   
E3CB   D0 E4                  BNE   kt1   ; A = 0 if the time ran out
E3CD   A0 00        KT3:      LDY   #0   
E3CF   F0 D7                  BEQ   cf2   ; always: TOS = A
E3D1                             ; Backspace takes the last character back (and is echoed as it is), CR ends
E3D1                             ; (stored, not echoed), every other key is stored and echoed until the line
E3D1                             ; is full. Y = the length so far; TL = the most allowed.
E3D1   20 4B E2     LINE:     JSR   neg   ; TOS = the count, and A = its high byte
E3D4   D0 04                  BNE   ln0   
E3D6   A5 02                  LDA   TL   
E3D8   10 04                  BPL   ln1   
E3DA   A9 7F        LN0:      LDA   #127   ; more than 127 is taken as 127
E3DC   85 02                  STA   TL   
E3DE   A0 00        LN1:      LDY   #0   
E3E0   F0 03                  BEQ   ln2   ; always
E3E2   20 03 FF     LN3:      JSR   CONOUT   
E3E5   20 06 FF     LN2:      JSR   getk   
E3E8   F0 FB                  BEQ   ln2   
E3EA   C9 0D                  CMP   #13   
E3EC   F0 14                  BEQ   ln5   
E3EE   C9 08                  CMP   #8   
E3F0   F0 0A                  BEQ   ln4   
E3F2   C4 02                  CPY   TL   
E3F4   B0 EF                  BCS   ln2   ; full
E3F6   99 80 04               STA   LINEBUF,Y   
E3F9   C8                     INY      
E3FA   D0 E6                  BNE   ln3   ; always: echo it
E3FC   88           LN4:      DEY      ; Backspace: one back, and echo it,
E3FD   10 E3                  BPL   ln3   
E3FF   C8                     INY      ;   unless the line was empty
E400   F0 E3                  BEQ   ln2   ; always
E402   99 80 04     LN5:      STA   LINEBUF,Y   ; A = CR
E405   A9 80                  LDA   #<LINEBUF   
E407   85 02                  STA   TL   
E409   A9 04                  LDA   #>LINEBUF   
E40B   85 03                  STA   TH   
E40D   60                     RTS      
E40E                             ; =============================================================================
E40E                             ;  Machine code: the grave
E40E                             ; =============================================================================
E40E                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
E40E                             ; are stored from addr until a non-hex character; then a RET (60h) is
E40E                             ; written and its address is left. An odd last digit is consumed and dropped.
E40E                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ); see the
E40E                             ; contract in the header.
E40E   20 3D E4     H_GRAVE:   JSR   rdhex   
E411   B0 1C                  BCS   exec   
E413   0A           HX1:      ASL      
E414   0A                     ASL      
E415   0A                     ASL      
E416   0A                     ASL      
E417   85 04                  STA   T0   
E419   20 3D E4               JSR   rdhex   
E41C   B0 0C                  BCS   hx2   ; odd digit: already consumed, dropped
E41E   05 04                  ORA   T0   
E420   91 02                  STA   (TL),Y   ; Y is 0 after rdhex (never checked)
E422   20 44 E3               JSR   inctos   
E425   20 3D E4               JSR   rdhex   
E428   90 E9                  BCC   hx1   
E42A   A9 60        HX2:      LDA   #60h   
E42C   91 02                  STA   (TL),Y   
E42E   60                     RTS      
E42F   A5 02        EXEC:     LDA   TL   
E431   85 04                  STA   T0   
E433   A5 03                  LDA   TH   
E435   85 05                  STA   T1   
E437   20 AA E1               JSR   drop   ; the address is consumed
E43A   6C 04 00               JMP   (T0)   
E43D                             ; rdhex: if IP is at a hex digit (0-9, A-F, a-f), return its value in A with
E43D                             ; the carry clear and IP moved on; otherwise the carry is set and IP stays.
E43D                             ; Y = 0.
E43D   20 6F E1     RDHEX:    JSR   isdig   
E440   90 0A                  BCC   rh1   
E442   29 DF                  AND   #0DFh   
E444   E9 11                  SBC   #11h   ; (the carry is set)
E446   C9 06                  CMP   #6   
E448   B0 05                  BCS   rh9   
E44A   69 0A                  ADC   #10   
E44C   4C 80 E1     RH1:      JMP   incip   
E44F   60           RH9:      RTS      
E450                             ; =============================================================================
E450                             ;  Console layer: getk returns a waiting key in A (zero flag clear), or
E450                             ;  A = 0 with the zero flag set when none is waiting. CONOUT prints A.
E450                             ;  Both keep X and Y. In the unchecked build getk is the host's KEY itself.
E450                             ; =============================================================================
E450                          IF   1-CHECKED   
E450                GETK:     EQU   KEY   ; the host's routine does the whole job
E450                          ENDIF      
E450                          IF   CHECKED   
                    GETK:     LDA   KEYBUF   ; a key held back by the break check
                              BEQ   gk1   
                              PHA      
                              LDA   #0   
                              STA   KEYBUF   
                              PLA      
                              RTS      
                    GK1:      JMP   KEY   
E450                          ENDIF      
E450                             ; =============================================================================
E450                             ;  Checked build: break key and error reports
E450                             ; =============================================================================
E450                          IF   CHECKED   
                                 ; chkbrk: a waiting key is read now; Ctrl-C stops the program, anything
                                 ; else is held for the next "?". Keeps the flags.
                    CHKBRK:   PHP      
                              JSR   getk   
                              BEQ   cb9   
                              CMP   #3   
                              BEQ   e_break   
                              STA   KEYBUF   
                    CB9:      PLP      
                              RTS      
                    E_BREAK:   LDA   #"B"   ; Ctrl-C
                                 ; error: the report, then EXIT. A = the letter, PLACE = the place, X = the
                                 ; data stack to show, RSV = S for the Rtn line. Nothing here relies on S: an
                                 ; overflowed or underflowed hardware stack wraps inside its page, and only
                                 ; its depth is shown.
                                 ;   CR LF
                                 ;   Err X @ line,col CR LF
                                 ;   up to 16 characters from the place, raw, up to a CR, LF or NUL  CR LF
                                 ;   Stk n: [...] and the top 8 cells at most, bottom to top  CR LF
                                 ;   Rtn n CR LF
                                 ; The numbers go through "#" (prnum), which pushes them over the data stack
                                 ; and pops them again, so the stack is shown as it was.
                    ERROR:    PHA      ; the letter
                              LDA   PLACE   
                              STA   P   
                              LDA   PLACE+1   
                              STA   P+1   
                              LDY   #M_ERR-MSG   
                              JSR   prs   ; CR LF "Err "
                              PLA      
                              JSR   CONOUT   
                              JSR   prs   ; " @ " (it follows M_ERR)
                              JSR   lcol   
                              LDA   D0   
                              LDY   D1   
                              JSR   prnum   ; the line
                              LDA   #","   
                              JSR   CONOUT   
                              LDA   T1   
                              LDY   T2   
                              JSR   prnum   ; the column
                              LDY   #M_NL-MSG   
                              JSR   prs   
                              LDY   #0   ; the text at the place
                    ER1:      LDA   (P),Y   
                              BEQ   er2   
                              CMP   #13   
                              BEQ   er2   
                              CMP   #10   
                              BEQ   er2   
                              JSR   CONOUT   
                              INY      
                              CPY   #16   
                              BNE   er1   
                    ER2:      LDY   #M_STK-MSG   
                              JSR   prs   ; CR LF "Stk "
                              TXA      
                              EOR   #0FFh   
                              SEC      
                              SBC   #0FFh-DSE   ; the depth, DSE - X (FFh, an overflow: 253)
                              PHA      
                              LDY   #0   
                              JSR   prnum   
                              PLA      
                              LDY   #M_C-MSG   ; ":"
                              CMP   #9   
                              BCC   er3   
                              LDA   #8   ; more than 8: ": ..." and the top 8
                              LDY   #M_CD-MSG   
                    ER3:      STA   T1   ; T1 = how many cells to show
                              JSR   prs   
                              JSR   push   ; TOS into memory with the rest: cell i from
                                 ;   the top is at DSL+X+i now
                    ER4:      LDA   T1   ; cells T1-1 down to 0, the top last
                              BEQ   er5   
                              DEC   T1   
                              LDA   #" "   
                              JSR   CONOUT   
                              TXA      
                              CLC      
                              ADC   T1   
                              TAY      
                              LDA   DSL,Y   
                              PHA      
                              LDA   DSH,Y   
                              TAY      
                              PLA      
                              JSR   prnum   
                              JMP   er4   
                    ER5:      LDY   #M_RTN-MSG   
                              JSR   prs   ; CR LF "Rtn "
                              LDA   RSV   
                              EOR   #0FFh   
                              LSR      ; (FFh - S) / 2 entries
                              LDY   #0   
                              JSR   prnum   
                              LDY   #M_NL-MSG   
                              JSR   prs   
                              JMP   EXIT   
                                 ; prnum: print the number A (low), Y (high), signed, keeping the data stack
                    PRNUM:    JSR   pushay   
                              JMP   h_num   
                                 ; prs: print the message at MSG+Y; its last byte has bit 7 set. Y ends just
                                 ; past it, at the next message.
                    PRS:      LDA   MSG,Y   
                              PHA      
                              AND   #7Fh   
                              JSR   CONOUT   
                              INY      
                              PLA      
                              BPL   prs   
                              RTS      
                    MSG:         
                    M_ERR:    DB   13,10,"Err"," "+80h   
                              DB   " @"," "+80h   
                    M_NL:     DB   13,10+80h   
                    M_STK:    DB   13,10,"Stk"," "+80h   
                    M_CD:     DB   ": ..","."+80h   
                    M_C:      DB   ":"+80h   
                    M_RTN:    DB   13,10,"Rtn"," "+80h   
                                 ; lcol: the line (D0/D1) and the column (T1/T2) of the place at P, both from
                                 ; 1. A place below the program is in the -n? line buffer: line 0, and the
                                 ; column is the place in the buffer. Otherwise the LFs before the place are
                                 ; counted from PROG; T1/T2 holds the address before the line's first
                                 ; character (the last LF, or PROG - 1), and the column is P minus that.
                    LCOL:     LDY   #0   
                              STY   D1   
                              STY   D0   
                              LDA   #<LBM1   
                              STA   T1   
                              LDA   #>LBM1   
                              STA   T2   
                              LDA   P   
                              CMP   #<PROG   
                              LDA   P+1   
                              SBC   #>PROG   
                              BCC   lc9   ; below the program: line 0
                              INC   D0   
                              LDA   #<PROGM1   
                              STA   Q   
                              STA   T1   
                              LDA   #>PROGM1   
                              STA   Q+1   
                              STA   T2   
                    LC1:      INC   Q   ; the next character
                              BNE   lc2   
                              INC   Q+1   
                    LC2:      LDA   Q   
                              CMP   P   
                              LDA   Q+1   
                              SBC   P+1   
                              BCS   lc9   ; at the place
                              LDA   (Q),Y   
                              CMP   #10   
                              BNE   lc1   
                              INC   D0   ; an LF: a new line starts after it
                              BNE   lc3   
                              INC   D1   
                    LC3:      LDA   Q   
                              STA   T1   
                              LDA   Q+1   
                              STA   T2   
                              BNE   lc1   ; always: no program is in page zero
                    LC9:      LDA   P   
                              SEC      
                              SBC   T1   
                              STA   T1   
                              LDA   P+1   
                              SBC   T2   
                              STA   T2   
                              RTS      
E450                          ENDIF      


