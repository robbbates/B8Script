                    FS_FET:   LDA   (0,X)   ; @
                              TAY      
                              INC   0,X   
                              BNE   fft1   
                              INC   1,X   
                    FFT1:     LDA   (0,X)   
                              STA   1,X   
                              STY   0,X   
                              ;*Macro unroll:  NEXTF
                              DS   1-CHECKED,0A0h   
                              DS   1-CHECKED,0   
                              DS   1-CHECKED,0B1h   
                              DS   1-CHECKED,IP   
                              DS   1-CHECKED,0E6h   
