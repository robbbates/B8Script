F44B   26 10                  BNE   pr1   
F44D   A6 A0                  LDA   ,Y+   
F44F   80 60                  SUBA   #60h   ; ` 0, a-z 1-26, 00bbIDI3LCB8IDI4LCA= 29, ~ 30
F451   81 1F                  CMPA   #1Fh   
F453   24 04                  BHS   pr2   
F455   8D 4B                  BSR   pesc   
F457   20 E8                  BRA   pr0   
F459   8B 60        PR2:      ADDA   #60h   ; any other: bit 6 goes
F45B   84 BF                  ANDA   #0BFh   
F45D   8D A9        PR1:      BSR   putc   
F45F   20 E0                  BRA   pr0   
F461   35 A0        PR9:      PULS   Y,PC   
F463                          IF   CHECKED   
F463   9E 3C        PRQ:      LDX   <PSAV   
F465   36 10                  PSHU   X   
F467   7E F3 37               JMP   e_quote   
F46A                          ENDIF      
F46A                             ; "-", checked build (see the unchecked one, before "!").
F46A                          IF   CHECKED   
F46A   BD F0 C2     H_SUB:    JSR   isdig   
F46D   25 06                  BLO   negnum   
F46F   EC 42                  LDD   2,U   
F471   A3 C1                  SUBD   ,U++   
F473   20 2A                  BRA   ud3   ; (STD ,U / RTS)
F475                          ENDIF      
F475   BD F0 C9     NEGNUM:   JSR   rdnum   ; a negative literal: read it, then negate
F478   1F 31        NEGT:     TFR   U,X   
F47A   4F           NEGX:     CLRA      ; negx: negate the cell at X
F47B   5F                     CLRB      
F47C   A3 84                  SUBD   ,X   
F47E   ED 84                  STD   ,X   
F480   39           NG9:      RTS      
F481   6D 84        ABSX:     TST   ,X   ; absx: negate the cell at X if negative
F483   2A FB                  BPL   ng9   
F485   20 F3                  BRA   negx   
F487                             ; udiv: unsigned divide, in place. The dividend is the NOS cell and the
F487                             ; divisor the TOS cell, both <= 8000h; the NOS cell becomes the quotient and
F487                             ; the TOS cell the remainder. The remainder is built in D (always < the
F487                             ; divisor, so 2R+1 fits in 16 bits).
F487                             ; Dividing by 2 is one shift (the spec wants that fast). (base divides
F487                             ; by any power of two with shifts: its udiv is with the speed-ups, and
F487                             ; comes to ud0 for the rest; pdec, whose divisor is 10, goes straight there.)
F487                          IF   1-QK   
                    UDIV:     LDD   ,U   
                              SUBD   #2   
                              BNE   ud0   
                              LSR   2,U   
                              ROR   3,U   ; the quotient
                              ROLB      ; the remainder: the bit that fell out (D was 0)
                              BRA   ud3   
F487                          ENDIF      
F487                          IF   1-FAST   
F487   8E 00 10     UD0:      LDX   #16   
F48A   4F                     CLRA      
F48B   5F                     CLRB      
F48C   68 43        UD1:      ASL   3,U   
F48E   69 42                  ROL   2,U   ; the dividend's top bit ...
F490   59                     ROLB      
F491   49                     ROLA      ; ... into the remainder
F492   10 A3 C4               CMPD   ,U   
F495   25 04                  BLO   ud2   
F497   A3 C4                  SUBD   ,U   
F499   6C 43                  INC   3,U   ; a quotient bit
F49B   30 1F        UD2:      LEAX   -1,X   
F49D   26 ED                  BNE   ud1   
F49F                          ENDIF      ; (the fast build's is unrolled: see the end)
F49F   ED C4        UD3:      STD   ,U   
F4A1   39                     RTS      
F4A2                             ; pesc: the escapes of "$". A = the character after the "/", minus 60h
F4A2                             ; (0 to 30); Y points past it. Each returns to the loop with an RTS, its
F4A2                             ; own or that of the routine it ends by jumping to. A, B and X are free.
F4A2                             ;    /a-/z   print the variable, as "#" does
F4A2                             ;    /{      clear the screen, the cursor to the top left
F4A2                             ;    /}      clear from the cursor to the end of the line
F4A2                             ;    /|  /`  show the cursor, hide it
F4A2                             ;    /~      ( row col -- ) the cursor to that row and column, from 0
F4A2   81 1B        PESC:     CMPA   #27   
F4A4   24 0F                  BHS   pcon   
F4A6   48                     ASLA      ; (` leaves A = 0: hide)
F4A7   27 18                  BEQ   phide   
F4A9   8E 82 3E               LDX   #LET+40h-2   ; the variable's cell (little-endian)
F4AC   EC 86                  LDD   A,X   
F4AE   1E 89                  EXG   A,B   
F4B0   36 06                  PSHU   D   
F4B2   7E F3 E5               JMP   h_num   
F4B5                          IF   1-ANSI   
F4B5   10 27 0A 53  PCON:     LBEQ   CONCLS   ; /{
F4B9   81 1D                  CMPA   #29   
F4BB   10 27 0A 50            LBEQ   CONEOL   ; /}
F4BF   22 03                  BHI   pat   
F4C1   7E FF 12     PHIDE:    JMP   CONCUR   ; /|  (A = 28: show), /`  (A = 0: hide)
F4C4                          ENDIF      
F4C4                PAT:         
F4C4                          IF   CHECKED   
F4C4                             ; /~ checks first that there are a row and a column (with less it
F4C4                             ; is s, and the stack counts as empty): U is never let past the
F4C4                             ; top of the stack, however many /~ there are.
F4C4   11 83 81 F8            CMPU   #DSTOP-4   
F4C8   10 22 FB C8            LBHI   e_ds   ; (N is clear: an underflow)
F4CC                          ENDIF      
F4CC                          IF   1-ANSI   
F4CC   37 16                  PULU   D,X   ; /~  D = the column, X = the row
F4CE   7E FF 15               JMP   CONAT   
F4D1                          ENDIF      
F4D1                          IF   ANSI   
                                 ; /~  ESC [ row+1 ; col+1 H (ANSI counts from 1)
                              PULU   D,X   ; D = the column, X = the row
                              ADDD   #1   
                              LEAX   1,X   
                              PSHU   D   
                              PSHU   X   
                              BSR   csi   
                              JSR   pdec   
                              BSR   pm   
                              FCB   ";"+80h   
                              JSR   pdec   
                              BSR   pm   
                              FCB   "H"+80h   
                              RTS      
                    PCON:     BEQ   pcls   ; /{
                              CMPA   #29   
                              BEQ   peol   ; /}
                              BHI   pat   
                              BSR   pcsi   ; /|  ESC [ ? 2 5 h
                              FCB   "?25","h"+80h   
                              RTS      
                    PHIDE:    BSR   pcsi   ; /`  ESC [ ? 2 5 l
                              FCB   "?25","l"+80h   
                              RTS      
                    PCLS:     BSR   pcsi   ; /{  ESC [ H ESC [ J
                              FCB   "H"+80h   
                              BSR   pcsi   
                              FCB   "J"+80h   
                              RTS      
                    PEOL:     BSR   pcsi   ; /}  ESC [ K
                              FCB   "K"+80h   
                              RTS      
                                 ; pcsi: ESC [ and then the text after the call, as pmsg. csi: ESC [.
                    CSI:      BSR   pm   
                              FCB   27,"["+80h   
                              RTS      
                    PCSI:     BSR   csi   
F4D1                          ENDIF      
F4D1                          IF   ANSI*(1-CHECKED)   
                                 ; pmsg: print the text after the call, up to and including the character
                                 ; that has bit 7 set (it is printed without it), then return after it.
                                 ; (The checked build has its own, with the report: pm leads to it.)
                    PM:          
                    PMSG:     PULS   X   
                    PM1:      LDA   ,X   
                              ANDA   #7Fh   
                              JSR   CONOUT   
                              TST   ,X+   
                              BPL   pm1   
                              JMP   ,X   
F4D1                          ENDIF      
F4D1                          IF   ANSI*CHECKED   
                    PM:       JMP   pmsg   
F4D1                          ENDIF      
F4D1                          IF   QK   
F4D1                             ; =============================================================================
F4D1                             ;  Speed-ups (base, and the fast build)
F4D1                             ; 
F4D1                             ;  The rest of them are with their handlers: "*" (h_mul), the unchecked
F4D1                             ;  a-z (lower), pdec (straight to the long divide) and the startup, which
F4D1                             ;  empties the skip cache. (A true ")" already reads the block start where
F4D1                             ;  it is, in every build, so there is nothing to gain there.)
F4D1                             ; =============================================================================
F4D1                             ; skip, with the skip cache. Nearly every skip is one that has happened
F4D1                             ; before (a loop skips the same false block on every pass), so the end of
F4D1                             ; each scan is remembered: 64 entries of 00bbc3RhcnQsIGVuZA== (big-endian), in the
F4D1                             ; page CPAGE, found by the start's low byte times 4. Only skips that start
F4D1                             ; in the program text hit (the line buffer changes); the cache is emptied
F4D1                             ; whenever a run starts. A program that changes its own text while it runs
F4D1                             ; is not looked after. A hit returns as the scan would: Y past the closer,
F4D1                             ; and A = 0 for ")" or 2 for "]".
F4D1   1F 20        SKIP:     TFR   Y,D   ; the start: the cache's key
F4D3   58                     ASLB      
F4D4   58                     ASLB      
F4D5   8E EF 00               LDX   #CPAGE*256   
F4D8   3A                     ABX      ; X -> the entry
F4D9   10 AC 84               CMPY   ,X   
F4DC   26 0F                  BNE   sks   
F4DE   10 8C 83 00            CMPY   #PROG   
F4E2   25 09                  BLO   sks   ; below the program text: never a hit
F4E4   10 AE 02               LDY   2,X   ; a hit: the IP is past the closer,
F4E7   A6 3F                  LDA   -1,Y   ;   ")" (29h) or "]" (5Dh): 0 or 2
F4E9   44                     LSRA      
F4EA   84 02                  ANDA   #2   
F4EC   39                     RTS      
F4ED                             ; The scan, which fills the entry (X is kept throughout). A scan that fails
F4ED                             ; ends the program, so an entry is never left half written for a later run
F4ED                             ; to find. Two range tests rule most characters out: ^ and up, and * to Z.
F4ED                             ; Only NUL " ( ) [ ] count. B counts the open levels.
F4ED   10 AF 84     SKS:      STY   ,X   ; the key
F4F0   C6 FF                  LDB   #0FFh   
F4F2   5C           SQ3:      INCB      ; an opener: one deeper
F4F3   A6 A0        SQ1:      LDA   ,Y+   
F4F5   81 5E                  CMPA   #5Eh   
F4F7   24 FA                  BHS   sq1   ; ^ _ ` a-z 00bbIHwg ~ and up: nothing
F4F9   81 5B                  CMPA   #5Bh   
F4FB   24 19                  BHS   sqb   ; [ \ ]
F4FD   81 2A                  CMPA   #2Ah   
F4FF   24 F2                  BHS   sq1   ; * to Z: nothing
F501   81 28                  CMPA   #28h   
F503   27 ED                  BEQ   sq3   ; (
F505   22 18                  BHI   sqc   ; )
F507   81 22                  CMPA   #22h   
F509   27 05                  BEQ   sqq   ; a string
F50B   4D                     TSTA      
F50C   26 E5                  BNE   sq1   ; the rest below "(": nothing
F50E                          ENDIF      
F50E                          IF   QK*(1-CHECKED)   
                              JMP   fin   ; NUL: the end of the program
                    SQQ:      JSR   skipstr   ; step over the string
                              BRA   sq1   
F50E                          ENDIF      
F50E                          IF   QK*CHECKED   
F50E   4A                     DECA      ; NUL: A = FFh, and the caller decides
F50F   39                     RTS      
F510   BD F2 2E     SQQ:      JSR   skipstr   ; step over the string; A = FFh with the
F513   24 DE                  BCC   sq1   ;   carry set if it ran into the NUL
F515   39                     RTS      
F516                          ENDIF      
F516                          IF   QK   
F516   80 5C        SQB:      SUBA   #5Ch   ; [ -1, \ 0, ] 1
F518   27 D9                  BEQ   sq1   ; "\" is nothing here
F51A   25 D6                  BLO   sq3   ; [
F51C   86 02                  LDA   #2   ; ]
F51E   21                     FCB   21h   ; (BRN: steps over the CLRA)
F51F   4F           SQC:      CLRA      ; )
F520   5A                     DECB      
F521   2A D0                  BPL   sq1   
F523   10 AF 02               STY   2,X   ; the closer at this level: the entry's end
F526   39                     RTS      
F527                             ; base: a power of two, 2^k, is a shift: q = a >> k and r = a AND (2^k - 1).
F527                             ; That is 2, and 256 for a high byte, and the 32 or 64 of fixed point.
F527   EC C4        UDIV:     LDD   ,U   
F529   10 27 FF 5A            LBEQ   ud0   ; by 0: the long way (it means nothing anyway)
F52D   83 00 01               SUBD   #1   
F530   1F 01                  TFR   D,X   ; X = d - 1
F532   A4 C4                  ANDA   ,U   
F534   10 26 FF 4F            LBNE   ud0   
F538   E4 41                  ANDB   1,U   
F53A   10 26 FF 49            LBNE   ud0   ; not a power of two
F53E   1F 10                  TFR   X,D   
F540   A4 42                  ANDA   2,U   
F542   E4 43                  ANDB   3,U   
F544   34 06                  PSHS   D   ; r
F546   6D 41                  TST   1,U   
F548   26 09                  BNE   uq0   ; d < 256
F54A   A6 C4                  LDA   ,U   ; 256 and up: d and a move a byte down
F54C   A7 41                  STA   1,U   ;   (the low byte of d is all the loop
F54E   E6 42                  LDB   2,U   ;   looks at)
F550   4F                     CLRA      
F551   20 02                  BRA   uq1   
F553   EC 42        UQ0:      LDD   2,U   
F555   64 41        UQ1:      LSR   1,U   ; a moves down until d's one bit falls out
F557   25 04                  BCS   uq2   
F559   44                     LSRA      
F55A   56                     RORB      
F55B   20 F8                  BRA   uq1   
F55D   ED 42        UQ2:      STD   2,U   ; q
F55F   35 06                  PULS   D   
F561   ED C4                  STD   ,U   
F563   39                     RTS      
F564                          ENDIF      
F564                          IF   FAST   
                                 ; =============================================================================
                                 ;  The fast build (SPEED = 2)
                                 ; 
                                 ;  The inner loop is a table of 256 handler addresses, FTAB, one for every
                                 ;  byte, and the dispatcher (NEXTF, at the top) is inline at the end of each
                                 ;  of the fast build's own entries, so there is no return to a loop:
                                 ; 
                                 ;      LDB ,Y+ / LDX #FTAB / ABX / ABX / JMP [,X]
                                 ; 
                                 ;  (21 cycles; the checked build calls fchk first, which checks the stacks
                                 ;  and keeps the place, as the ordinary inner loop does.) The entries are
                                 ;  jumped to, not called, so nothing of the dispatcher's is on the return
                                 ;  stack while they run. The letters and digits have one entry each, which
                                 ;  knows its cell or its value already; the commonest punctuation has its
                                 ;  own; the rest are thunks, JSR to the ordinary handler, which returns
                                 ;  with its RTS as it would to the ordinary dispatcher.
                                 ; =============================================================================
F564                          ENDIF      
F564                          IF   FAST*CHECKED   
                                 ; fchk: the checks of the inner loop, for the checked fast build (S is 2
                                 ; lower in here than when the character starts).
                    FCHK:     LEAX   (0-DSLIM)&0FFFFh,U   
                              CMPX   #DSTOP-DSLIM   
                              LBHI   e_ds   
                              LEAX   (2-RSLIM)&0FFFFh,S   
                              CMPX   #RSTOP-RSLIM   
                              LBHI   e_rs   
                              STY   <AT   ; the place, should this character fail
                              LEAX   2,S   
                              STX   <SSAV   ; and the return stack, as it is then
                              RTS      
                    FOPF:     EQU   opf   ; (a false "(": the checked skip)
                    FSTORE:   EQU   ft_store   ; ("!" and "." are checked: the thunks)
                    FCSTORE:   EQU   ft_cstore   
                    FHIGH:    EQU   fhi   ; (80h-FFh: X)
                    FHI:      JMP   e_resv   ; 80h-FFh: reserved
F564                          ENDIF      
F564                          IF   FAST*(1-CHECKED)   
                    FOPF:     EQU   skip   
                    FSTORE:   EQU   fs_store   
                    FCSTORE:   EQU   fs_cstore   
                    FHIGH:    EQU   fign   ; (80h-FFh are ignored)
F564                          ENDIF      
F564                          IF   FAST   
                              ;*Macro unroll: fnext:  NEXTF                   ; the startup comes here
                    FNEXT:    DS   CHECKED,0BDh   ; the startup comes here
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FNUL:     JMP   EXIT   ; NUL: the end of the program
                              ;*Macro unroll: fign:   NEXTF                   ; 01h-20h and DEL (and 80h-FFh unchecked): nothing
                    FIGN:     DS   CHECKED,0BDh   ; 01h-20h and DEL (and 80h-FFh unchecked): nothing
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                                 ; The thunks: the ordinary handler, then the dispatcher.
                    FT_STORE:   JSR   h_store   ; !
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FT_STR:   JSR   h_str   ; "
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FT_NUM:   JSR   h_num   ; #
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FT_PRINT:   JSR   h_print   ; $
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FT_EMIT:   JSR   h_emit   ; '
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FT_CSTORE:   JSR   h_cstore   ; .
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FT_DIV:   JSR   h_div   ; /
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FT_KEY:   JSR   h_key   ; ?
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FT_DEF:   JSR   h_def   ; [
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FT_BREAK:   JSR   h_break   ; \
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FT_ALLOC:   JSR   h_alloc   ; _
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FT_GRAVE:   JSR   h_grave   ; `
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FT_TOR:   JSR   h_tor   ; {
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FT_FROMR:   JSR   h_fromr   ; }
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                                 ; The commonest punctuation, written for the fast build.
                    FS_ADD:   PULU   D   ; +
                              ADDD   ,U   
                              STD   ,U   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FS_SUB:   LDA   ,Y   ; -  (a digit next: a negative number)
                              SUBA   #"0"   
                              CMPA   #10   
                              BLO   fsb1   
                              LDD   2,U   
                              SUBD   ,U++   
                              STD   ,U   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FSB1:     JSR   negnum   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FS_DUP:   LDD   ,U   ; :
                              PSHU   D   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FS_DROP:   LEAU   2,U   ; ;
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FS_SWAP:   LDD   ,U   ; %
                              LDX   2,U   
                              STD   2,U   
                              STX   ,U   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FS_FET:   LDX   ,U   ; @  (the cell in memory is little-endian)
                              LDB   ,X   
                              LDA   1,X   
                              STD   ,U   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FS_CFET:   LDX   ,U   ; ,
                              LDB   ,X   
                              CLRA      
                              STD   ,U   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FS_LT:    PULU   X   ; <  (X = b: b - a)
                              CMPX   ,U   
                              BGT   flt1   
                              LDD   #0   
                              STD   ,U   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FLT1:     LDD   #0FFFFh   
                              STD   ,U   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FS_EQ:    PULU   X   ; =  (X = b: b - a)
                              CMPX   ,U   
                              BEQ   feq1   
                              LDD   #0   
                              STD   ,U   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FEQ1:     LDD   #0FFFFh   
                              STD   ,U   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FS_GT:    PULU   X   ; >  (X = b: b - a)
                              CMPX   ,U   
                              BLT   fgt1   
                              LDD   #0   
                              STD   ,U   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FGT1:     LDD   #0FFFFh   
                              STD   ,U   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FS_AND:   PULU   D   ; &
                              ANDA   ,U   
                              ANDB   1,U   
                              STD   ,U   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FS_OR:    PULU   D   ; |
                              ORA   ,U   
                              ORB   1,U   
                              STD   ,U   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FS_XOR:   PULU   D   ; ^
                              EORA   ,U   
                              EORB   1,U   
                              STD   ,U   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FS_NOT:   COM   ,U   ; ~
                              COM   1,U   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FS_MUL:   LDA   3,U   ; *  (as base's h_mul)
                              LDB   ,U   
                              BEQ   fmu1   
                              MUL      ; al*bh
                              STB   ,U   
                    FMU1:     LDA   2,U   
                              BEQ   fmu2   
                              LDB   1,U   
                              MUL      ; ah*bl
                              ADDB   ,U   
                              STB   ,U   
                    FMU2:     LDA   3,U   
                              LDB   1,U   
                              MUL      ; al*bl
                              ADDA   ,U   
                              LEAU   2,U   
                              STD   ,U   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FS_OPEN:   LDD   ,U++   ; (
                              BEQ   fop0   
                              PSHS   Y   ; true: the block starts at the IP
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FOP0:     JSR   FOPF   ; false: skip to the ")"
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FS_CLOSE:   LDD   ,U++   ; )
                              BEQ   fcl0   
                              LDY   ,S   ; true: back to the block start, read where
                              DEC   <COUNT   ;   it is; and the break check, 1 look in 256
                              BNE   fcl1   
                              JSR   pk1   
                              ;*Macro unroll: fcl1:   NEXTF
                    FCL1:     DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FCL0:     LEAS   2,S   ; false: drop the block start
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FS_RET:   PULS   Y   ; ]
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
F564                          ENDIF      
F564                          IF   FAST*(1-CHECKED)   
                    FS_STORE:   PULU   X   ; !  ( n addr -- ), little-endian
                              PULU   D   
                              STB   ,X   
                              STA   1,X   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FS_CSTORE:   PULU   X   ; .
                              PULU   D   
                              STB   ,X   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
F564                          ENDIF      
F564                          IF   FAST   
                                 ; The digits: each pushes its value, and goes on to fdm for more digits.
                    FD0:      LDD   #0   
                              PSHU   D   
                              LDA   ,Y   
                              SUBA   #"0"   
                              CMPA   #10   
                              BHS   fd0n   
                              JMP   fdm   ; another digit
                              ;*Macro unroll: fd0n:   NEXTF
                    FD0N:     DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FD1:      LDD   #1   
                              PSHU   D   
                              LDA   ,Y   
                              SUBA   #"0"   
                              CMPA   #10   
                              BHS   fd1n   
                              JMP   fdm   ; another digit
                              ;*Macro unroll: fd1n:   NEXTF
                    FD1N:     DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FD2:      LDD   #2   
                              PSHU   D   
                              LDA   ,Y   
                              SUBA   #"0"   
                              CMPA   #10   
                              BHS   fd2n   
                              JMP   fdm   ; another digit
                              ;*Macro unroll: fd2n:   NEXTF
                    FD2N:     DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FD3:      LDD   #3   
                              PSHU   D   
                              LDA   ,Y   
                              SUBA   #"0"   
                              CMPA   #10   
                              BHS   fd3n   
                              JMP   fdm   ; another digit
                              ;*Macro unroll: fd3n:   NEXTF
                    FD3N:     DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FD4:      LDD   #4   
                              PSHU   D   
                              LDA   ,Y   
                              SUBA   #"0"   
                              CMPA   #10   
                              BHS   fd4n   
                              JMP   fdm   ; another digit
                              ;*Macro unroll: fd4n:   NEXTF
                    FD4N:     DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FD5:      LDD   #5   
                              PSHU   D   
                              LDA   ,Y   
                              SUBA   #"0"   
                              CMPA   #10   
                              BHS   fd5n   
                              JMP   fdm   ; another digit
                              ;*Macro unroll: fd5n:   NEXTF
                    FD5N:     DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FD6:      LDD   #6   
                              PSHU   D   
                              LDA   ,Y   
                              SUBA   #"0"   
                              CMPA   #10   
                              BHS   fd6n   
                              JMP   fdm   ; another digit
                              ;*Macro unroll: fd6n:   NEXTF
                    FD6N:     DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FD7:      LDD   #7   
                              PSHU   D   
                              LDA   ,Y   
                              SUBA   #"0"   
                              CMPA   #10   
                              BHS   fd7n   
                              JMP   fdm   ; another digit
                              ;*Macro unroll: fd7n:   NEXTF
                    FD7N:     DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FD8:      LDD   #8   
                              PSHU   D   
                              LDA   ,Y   
                              SUBA   #"0"   
                              CMPA   #10   
                              BHS   fd8n   
                              JMP   fdm   ; another digit
                              ;*Macro unroll: fd8n:   NEXTF
                    FD8N:     DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FD9:      LDD   #9   
                              PSHU   D   
                              LDA   ,Y   
                              SUBA   #"0"   
                              CMPA   #10   
                              BHS   fd9n   
                              JMP   fdm   ; another digit
                              ;*Macro unroll: fd9n:   NEXTF
                    FD9N:     DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                                 ; fdm: another digit, at the IP: the value on top becomes value * 10 + digit
                    FDM:      LDD   ,U   
                              ASLB      
                              ROLA      
                              ASLB      
                              ROLA      
                              ADDD   ,U   ; 5V
                              ASLB      
                              ROLA      ; 10V
                              ADDB   ,Y+   ; and the digit
                              ADCA   #0   
                              SUBD   #30h   ; minus "0"
                              STD   ,U   
                              LDA   ,Y   
                              SUBA   #"0"   
                              CMPA   #10   
                              BLO   fdm   
                              ;*Macro unroll:  NEXTF
                              DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
F564                          ENDIF      
F564                          IF   FAST*(1-CHECKED)   
                                 ; A-Z: call the word: the IP goes on the return stack, the IP becomes
                                 ; the word's body (the cell is little-endian), and the break key is
                                 ; looked at, one time in 256.
                    FUA:      PSHS   Y   ; A
                              LDB   <00h   
                              LDA   <01h   
                              TFR   D,Y   
                              DEC   <COUNT   
                              BNE   fuA1   
                              JSR   pk1   
                              ;*Macro unroll: fuA1:   NEXTF
                    FUA1:     DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FUB:      PSHS   Y   ; B
                              LDB   <02h   
                              LDA   <03h   
                              TFR   D,Y   
                              DEC   <COUNT   
                              BNE   fuB1   
                              JSR   pk1   
                              ;*Macro unroll: fuB1:   NEXTF
                    FUB1:     DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FUC:      PSHS   Y   ; C
                              LDB   <04h   
                              LDA   <05h   
                              TFR   D,Y   
                              DEC   <COUNT   
                              BNE   fuC1   
                              JSR   pk1   
                              ;*Macro unroll: fuC1:   NEXTF
                    FUC1:     DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FUD:      PSHS   Y   ; D
                              LDB   <06h   
                              LDA   <07h   
                              TFR   D,Y   
                              DEC   <COUNT   
                              BNE   fuD1   
                              JSR   pk1   
                              ;*Macro unroll: fuD1:   NEXTF
                    FUD1:     DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FUE:      PSHS   Y   ; E
                              LDB   <08h   
                              LDA   <09h   
                              TFR   D,Y   
                              DEC   <COUNT   
                              BNE   fuE1   
                              JSR   pk1   
                              ;*Macro unroll: fuE1:   NEXTF
                    FUE1:     DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FUF:      PSHS   Y   ; F
                              LDB   <0Ah   
                              LDA   <0Bh   
                              TFR   D,Y   
                              DEC   <COUNT   
                              BNE   fuF1   
                              JSR   pk1   
                              ;*Macro unroll: fuF1:   NEXTF
                    FUF1:     DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FUG:      PSHS   Y   ; G
                              LDB   <0Ch   
                              LDA   <0Dh   
                              TFR   D,Y   
                              DEC   <COUNT   
                              BNE   fuG1   
                              JSR   pk1   
                              ;*Macro unroll: fuG1:   NEXTF
                    FUG1:     DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FUH:      PSHS   Y   ; H
                              LDB   <0Eh   
                              LDA   <0Fh   
                              TFR   D,Y   
                              DEC   <COUNT   
                              BNE   fuH1   
                              JSR   pk1   
                              ;*Macro unroll: fuH1:   NEXTF
                    FUH1:     DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FUI:      PSHS   Y   ; I
                              LDB   <10h   
                              LDA   <11h   
                              TFR   D,Y   
                              DEC   <COUNT   
                              BNE   fuI1   
                              JSR   pk1   
                              ;*Macro unroll: fuI1:   NEXTF
                    FUI1:     DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FUJ:      PSHS   Y   ; J
                              LDB   <12h   
                              LDA   <13h   
                              TFR   D,Y   
                              DEC   <COUNT   
                              BNE   fuJ1   
                              JSR   pk1   
                              ;*Macro unroll: fuJ1:   NEXTF
                    FUJ1:     DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FUK:      PSHS   Y   ; K
                              LDB   <14h   
                              LDA   <15h   
                              TFR   D,Y   
                              DEC   <COUNT   
                              BNE   fuK1   
                              JSR   pk1   
                              ;*Macro unroll: fuK1:   NEXTF
                    FUK1:     DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FUL:      PSHS   Y   ; L
                              LDB   <16h   
                              LDA   <17h   
                              TFR   D,Y   
                              DEC   <COUNT   
                              BNE   fuL1   
                              JSR   pk1   
                              ;*Macro unroll: fuL1:   NEXTF
                    FUL1:     DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FUM:      PSHS   Y   ; M
                              LDB   <18h   
                              LDA   <19h   
                              TFR   D,Y   
                              DEC   <COUNT   
                              BNE   fuM1   
                              JSR   pk1   
                              ;*Macro unroll: fuM1:   NEXTF
                    FUM1:     DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
                              ABX      
                              JMP   [,X]   
                    FUN:      PSHS   Y   ; N
                              LDB   <1Ah   
                              LDA   <1Bh   
                              TFR   D,Y   
                              DEC   <COUNT   
                              BNE   fuN1   
                              JSR   pk1   
                              ;*Macro unroll: fuN1:   NEXTF
                    FUN1:     DS   CHECKED,0BDh   
                              DS   CHECKED,ACHK/256   
                              DS   CHECKED,ACHK&0FFh   
                              LDB   ,Y+   
                              LDX   #FTAB   
                              ABX      
