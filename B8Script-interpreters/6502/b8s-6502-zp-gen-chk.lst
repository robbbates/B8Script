E4C4   57                     DB   (h_mul-1) & 0FFh   ; *
E4C5   21                     DB   (h_add-1) & 0FFh   ; +
E4C6   AB                     DB   (h_cfetch-1) & 0FFh   ; ,
E4C7   18                     DB   (h_sub-1) & 0FFh   ; -
E4C8   0C                     DB   (h_cstore-1) & 0FFh   ; .
E4C9   82                     DB   (h_div-1) & 0FFh   ; /
E4CA   05                     DB   (h_dup-1) & 0FFh   ; :
