  1943                              <1> iat_end:
  1944                              <1> 
  1945                              <1> ; =============================================================================
  1946                              <1> ;  The letters and digits, the return stack's push, and the inner loop
  1947                              <1> ; =============================================================================
  1948                              <1> 
  1949                              <1> ; A-Z: call the word. The return address (the IP after the letter) goes on
  1950                              <1> ; the return stack, and the IP becomes the address in the letter's cell.
  1951 0000095C 89F2                <1> upper:  mov     edx,esi
  1952 0000095E 668BB40000014100    <1>         mov     si,[ARENA+LET+eax*2]
  1953                              <1> 
  1954                              <1> ; rpush: push EDX on the return stack, then next. Everything that pushes the
  1955                              <1> ; return stack ends here, and the true ')' comes to rpoll.
  1956                              <1> ;
  1957                              <1> ; The break key is looked at here, so at every word call and loop-back (and
  1958                              <1> ; block entry and '{'), but only one time in 256: V_PCNT counts them.
  1959 00000966 83EF04              <1> rpush:  sub     edi,4
  1960 00000969 8917                <1>         mov     [edi],edx
  1961 0000096B FE4D6B              <1> rpoll:  dec     byte [V(v_pcnt)]
  1962 0000096E 7505                <1>         jnz     .rp1
  1963 00000970 E842FDFFFF          <1>         call    pollk
  1964 00000975 FFE5                <1> .rp1:   jmp     ebp
  1965                              <1> 
  1966                              <1> ; =============================================================================
  1967                              <1> ;  The inner loop: read one character and sort it by range.
  1968                              <1> ;
  1969                              <1> ;    00h          end of program
  1970                              <1> ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes; the checked
  1971                              <1> ;                 build stops on 80h-FFh: X)
  1972                              <1> ;    30h-39h      digit: read a whole number
  1973                              <1> ;    41h-5Ah      A-Z: call the word in that letter's cell
  1974                              <1> ;    61h-7Ah      a-z: push the address of that letter's cell
  1975                              <1> ;    the rest     punctuation: jump through PTAB, 32 entries
  1976                              <1> ; =============================================================================
  1977                              <1> ; Digits: step back onto the first digit and read the whole number.
  1978 00000977 53                  <1> digit:  push    ebx
  1979 00000978 4E                  <1>         dec     esi
  1980 00000979 E860FAFFFF          <1>         call    rdnum
  1981 0000097E FFE5                <1>         jmp     ebp
  1982                              <1> 
  1983                              <1> ; a-z: push the cell's address (the cell is the variable).
  1984 00000980 53                  <1> lower:  push    ebx
  1985 00000981 8D9C0000014100      <1>         lea     ebx,[ARENA+LET+eax*2]
  1986 00000988 FFE5                <1>         jmp     ebp
  1987                              <1> ; (digit, lower and ctl are here, before next, to keep the variables after
  1988                              <1> ; next in reach)
  1989 0000098A 0421                <1> ctl:    add     al,21h                  ; back to c; zero only for NUL
