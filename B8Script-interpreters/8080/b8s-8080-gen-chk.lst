04F1                             ; =============================================================================
04F1                             ;  Startup
04F1                             ; =============================================================================
04F1                START:       
04F1                          IF   (1-CPM)*CHECKED   
04F1   31 FC 81               LXI   SP,DSTOP   
04F4                          ENDIF      
04F4                          IF   CHECKED   
04F4                             ; Clear the lower half of the letter page: every variable starts at
04F4                             ; 0, every word cell holds 0000h, the address an undefined word is
04F4                             ; caught at (see e_hi), and no key is held back.
04F4   21 00 82               LXI   H,LET   
04F7   AF                     XRA   A   
04F8   77           INI1:     MOV   M,A   
04F9   2C                     INR   L   
04FA   F2 F8 04               JP   ini1   ; +00h to +7Fh
04FD                          ENDIF      
04FD                          IF   CPM   
                                 ; CP/M: the RAM pages follow the image; the heap may grow to the BDOS
                              LXI   H,vecs   ; the RST routines go down into page zero
                              LXI   D,0008h   
                              MVI   B,vecend-vecs   
                    CPY:      MOV   A,M   
                              STAX   D   
                              INX   H   
                              INX   D   
                              DCR   B   
                              JNZ   cpy   
                              LXI   D,005Ch   ; open the file named on the command line
                              MVI   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LXI   D,PROG   
                    LD1:      PUSH   D   
                              MVI   C,26   ; set the DMA address
                              CALL   BDOS   
                              LXI   D,005Ch   
                              MVI   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   H   ; HL = the address this record went to
                              ORA   A   
                              JNZ   ld2   
                              LXI   D,128   
                              DAD   D   
                              XCHG      
                              JMP   ld1   
                    LD2:      MVI   M,0   ; the end of the file counts as NUL
                              INX   H   ; the heap starts after it
04FD                          ENDIF      
04FD                          IFN   CPM   
04FD   21 00 83               LXI   H,PROG   ; the heap starts after the program's NUL
0500   7E           FNUL:     MOV   A,M   
0501   23                     INX   H   
0502   B7                     ORA   A   
0503   C2 00 05               JNZ   fnul   
0506                          ENDIF      
0506   22 7C 82               SHLD   HEAP   
0509                          IF   CHECKED   
0509   E7                     RST   4   ; minus the heap"s first address: "_' may not
050A   22 38 82               SHLD   NPEND   ;   release below it
050D                          ENDIF      
050D   21 E0 80               LXI   H,RSTOP   ; the return stack is empty
0510   22 34 82               SHLD   RSP   
0513                          IF   (1-CHECKED)*(1-CPM)   
                              MOV   H,A   ; (A = 0, from the search for the NUL) no key
                              MOV   L,A   ;   is held, and the break key is on (the
0513                          ENDIF      ;   checked build has cleared these)
0513                          IF   (1-CHECKED)*CPM   
                              LXI   H,0   
0513                          ENDIF      
0513                          IF   1-CHECKED   
                              SHLD   KEYBUF   
0513                          ENDIF      
0513   01 00 83               LXI   B,PROG   ; the IP
0516   F7                     RST   6   ; (its return address is thrown away)
0517                          IF   CPM   
                                 ; RAM pages, after the image
                    RSPAGE:   EQU   (imgend + 255) / 256   
                    DSPAGE:   EQU   RSPAGE + 1   
