EA68                          IF   1-FAST   
                    UD0:      LDY   #16   
                    UD1:      ASL   TL   
                              ROL   TH   
                              ROL   T0   
                              ROL   T1   
                              SEC      
                              LDA   T0   
                              SBC   D0   
                              PHA      
                              LDA   T1   
                              SBC   D1   
                              BCC   ud2   
                              STA   T1   
                              PLA      
                              STA   T0   
                              INC   TL   ; the quotient bit (TL's bit 0 is free)
                              DB   24h   ; (BIT zp: steps over the PLA)
                    UD2:      PLA      
                              DEY      
                              BNE   ud1   
                              RTS      
EA68                          ENDIF      
EA68                             ; =============================================================================
EA68                             ;  Fetches, and the keyboard
EA68                             ; =============================================================================
EA68   A0 01        H_FETCH:   LDY   #1   ; "@"
EA6A   B1 02                  LDA   (TL),Y   
EA6C   48                     PHA      ; the high byte, while "," gets the low one
EA6D   20 74 EA               JSR   h_cfetch   
EA70   68                     PLA      
EA71   85 03                  STA   TH   
EA73   60                     RTS      
EA74                H_CFETCH:      ; ","
EA74   A0 00                  LDY   #0   
EA76   B1 02                  LDA   (TL),Y   
EA78   85 02        CF2:      STA   TL   ; TOS = A (low), Y (high)
EA7A   84 03                  STY   TH   
EA7C   60                     RTS      
EA7D                             ; "?" ( n -- c ) or ( -n -- addr )
EA7D                             ;   n > 0: wait about n ms for a key; 0 if none came
EA7D                             ;   n = 0: wait for a key
EA7D                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
EA7D                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
EA7D   A5 03        H_KEY:    LDA   TH   
EA7F   30 20                  BMI   line   
EA81   A0 28        KT1:      LDY   #MSLOOP   ; one millisecond, roughly
EA83   20 80 E2     KT2:      JSR   getk   
EA86   D0 15                  BNE   kt3   
EA88   88                     DEY      
EA89   D0 F8                  BNE   kt2   
EA8B   A5 02                  LDA   TL   ; count the millisecond off:
EA8D   D0 06                  BNE   kt4   
EA8F   A5 03                  LDA   TH   
EA91   F0 EE                  BEQ   kt1   ; 0? never counts down: it waits
EA93   C6 03                  DEC   TH   
EA95   C6 02        KT4:      DEC   TL   
EA97   D0 E8                  BNE   kt1   
EA99   A5 03                  LDA   TH   
EA9B   D0 E4                  BNE   kt1   ; A = 0 if the time ran out
EA9D   A0 00        KT3:      LDY   #0   
EA9F   F0 D7                  BEQ   cf2   ; always: TOS = A
EAA1                             ; Backspace takes the last character back (and is echoed as it is), CR ends
EAA1                             ; (stored, not echoed), every other key is stored and echoed until the line
EAA1                             ; is full. Y = the length so far; TL = the most allowed.
EAA1   20 D2 E5     LINE:     JSR   neg   ; TOS = the count, and A = its high byte
EAA4   D0 04                  BNE   ln0   
EAA6   A5 02                  LDA   TL   
EAA8   10 04                  BPL   ln1   
EAAA   A9 7F        LN0:      LDA   #127   ; more than 127 is taken as 127
EAAC   85 02                  STA   TL   
EAAE   A0 00        LN1:      LDY   #0   
EAB0   F0 03                  BEQ   ln2   ; always
EAB2   20 03 FF     LN3:      JSR   CONOUT   
EAB5   20 80 E2     LN2:      JSR   getk   
EAB8   F0 FB                  BEQ   ln2   
EABA   C9 0D                  CMP   #13   
EABC   F0 14                  BEQ   ln5   
EABE   C9 08                  CMP   #8   
EAC0   F0 0A                  BEQ   ln4   
EAC2   C4 02                  CPY   TL   
EAC4   B0 EF                  BCS   ln2   ; full
EAC6   99 80 04               STA   LINEBUF,Y   
EAC9   C8                     INY      
EACA   D0 E6                  BNE   ln3   ; always: echo it
EACC   88           LN4:      DEY      ; Backspace: one back, and echo it,
EACD   10 E3                  BPL   ln3   
EACF   C8                     INY      ;   unless the line was empty
EAD0   F0 E3                  BEQ   ln2   ; always
EAD2   99 80 04     LN5:      STA   LINEBUF,Y   ; A = CR
EAD5   A9 80                  LDA   #<LINEBUF   
EAD7   A0 04                  LDY   #>LINEBUF   
EAD9   D0 9D                  BNE   cf2   ; always: TOS = the line's address
EADB                             ; =============================================================================
EADB                             ;  Machine code: the grave
EADB                             ; =============================================================================
EADB                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
EADB                             ; are stored from addr until a non-hex character; then a RET (60h) is
EADB                             ; written and its address is left. An odd last digit is consumed and dropped.
EADB                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ); see the
EADB                             ; contract in the header.
EADB   20 32 E5     H_GRAVE:   JSR   rdhex   
EADE   B0 1C                  BCS   exec   
EAE0   0A           HX1:      ASL      
EAE1   0A                     ASL      
EAE2   0A                     ASL      
EAE3   0A                     ASL      
EAE4   85 04                  STA   T0   
EAE6   20 32 E5               JSR   rdhex   
EAE9   B0 0C                  BCS   hx2   ; odd digit: already consumed, dropped
EAEB   05 04                  ORA   T0   
EAED   91 02                  STA   (TL),Y   ; Y is 0 after rdhex (never checked)
EAEF   20 60 E4               JSR   inctos   
EAF2   20 32 E5               JSR   rdhex   
EAF5   90 E9                  BCC   hx1   
EAF7   A9 60        HX2:      LDA   #60h   
EAF9   91 02                  STA   (TL),Y   
EAFB   60                     RTS      
EAFC   A5 02        EXEC:     LDA   TL   
EAFE   85 04                  STA   T0   
EB00   A5 03                  LDA   TH   
EB02   85 05                  STA   T1   
EB04   20 76 E5               JSR   drop   ; the address is consumed
EB07   6C 04 00               JMP   (T0)   
EB0A                          IF   CHECKED   
                                 ; =============================================================================
                                 ;  Checked build: the error report
                                 ; =============================================================================
                                 ; error: the report, then EXIT. A = the letter, PLACE = the place, X = the
                                 ; data stack to show, RSV = S for the R: line. Nothing here relies on S: an
                                 ; overflowed or underflowed hardware stack wraps inside its page, and only
                                 ; its depth is shown.
                                 ;   CR LF
                                 ;   Err X @ line,col CR LF
                                 ;   D:n: [...] and the top 8 cells at most, bottom to top  CR LF
                                 ;   R:n CR LF
                                 ; The numbers go through "#" (h_num), each pushed over the data stack first
                                 ; and popped again by "#", so the stack is shown as it was.
                    ERROR:    PHA      ; the letter
                              LDY   #M_ERR-MSG   
                              JSR   prs   ; CR LF "Err "
                              PLA      
                              JSR   CONOUT   
                              JSR   prs   ; " @ " (it follows M_ERR)
                                 ; The line and the column of the place, both from 1. The line is counted in
                                 ; a cell pushed over the data stack (TOS). A place below the program is in
                                 ; the -n? line buffer: line 0, and the column is the place in the buffer.
                                 ; Otherwise IP (free now: the program has stopped) runs from PROG to the
                                 ; place, counting LFs; CL keeps where the last line started, and the column
                                 ; is the place minus that, plus 1.
                              LDA   #<LINEBUF   
                              STA   CL   
                              LDA   #>LINEBUF   
                              STA   CL+1   
                              LDA   #0   
                              TAY      
                              JSR   pushay   ; TOS = the line, 0 so far
                              LDA   PLACE   
                              CMP   #<PROG   
                              LDA   PLACE+1   
                              SBC   #>PROG   
                              BCC   lc9   ; below the program: line 0
                              INC   TL   
                              JSR   rstip   
                    LC3:      LDA   IP   ; a line starts here
                              STA   CL   
                              LDA   IP+1   
                              STA   CL+1   
                    LC1:      LDA   IP   
                              CMP   PLACE   
                              LDA   IP+1   
                              SBC   PLACE+1   
                              BCS   lc9   ; at the place
                              JSR   getc   
                              CMP   #10   
                              BNE   lc1   
                              JSR   inctos   ; an LF: a new line starts after it
                              BNE   lc3   ; always (Z clear: fewer than 65536 lines)
                    LC9:      JSR   h_num   ; the line (and it is dropped)
                              LDA   #","   
                              JSR   CONOUT   
                              SEC      
                              LDA   PLACE   
                              SBC   CL   
                              PHA      
                              LDA   PLACE+1   
                              SBC   CL+1   
                              TAY      
                              PLA      
                              JSR   pushay   
                              JSR   inctos   ; + 1
                              JSR   h_num   ; the column
                              LDY   #M_STK-MSG   
                              JSR   prs   ; CR LF "D:"
                              TXA      
                              EOR   #0FFh   
                              SEC      
                              SBC   #0FFh-DSE   ; the depth, DSE - X (FFh, an overflow: 253)
                              PHA      
                              JSR   prnum8   
                              PLA      
                              LDY   #M_C-MSG   ; ":"
                              CMP   #9   
                              BCC   er3   
                              LDA   #8   ; more than 8: ": ..." and the top 8
                              LDY   #M_CD-MSG   
                    ER3:      STA   T2   ; T2 = how many cells to show (the place
                                 ;   is no longer needed)
                              JSR   prs   
                              JSR   push   ; TOS into memory with the rest: cell i from
                                 ;   the top is at DSL+X+i now
                    ER4:      LDA   T2   ; cells T2-1 down to 0, the top last
                              BEQ   er5   
                              DEC   T2   
                              LDA   #" "   
                              JSR   CONOUT   
                              TXA      
                              CLC      
                              ADC   T2   
                              TAY      
                              LDA   DSL,Y   
                              PHA      
                              LDA   DSH,Y   
                              TAY      
                              PLA      
                              JSR   prnum   
                              JMP   er4   
                    ER5:      LDY   #M_RTN-MSG   
                              JSR   prs   ; CR LF "R:"
                              LDA   RSV   
                              EOR   #0FFh   
                              LSR      ; (FFh - S) / 2 entries
                              JSR   prnum8   
                              LDY   #M_NL-MSG   
                              JSR   prs   
                              JMP   EXIT   
                                 ; prnum: print the number A (low), Y (high), signed, keeping the data stack.
                                 ; prnum8: the same for A alone, 0-255.
                    PRNUM8:   LDY   #0   
                    PRNUM:    JSR   pushay   
                              JMP   h_num   
EB0A                          ENDIF      
EB0A                             ; =============================================================================
EB0A                             ;  The fast build (SPEED = 2)
EB0A                             ; 
EB0A                             ;  The inner loop is a table: 256 entries, the low bytes of the handlers'
EB0A                             ;  addresses in one page (DTL) and the high bytes in the next (DTH). The
EB0A                             ;  dispatcher, NEXTF, is inline at the end of the fast build's own entries,
EB0A                             ;  so there is no JSR and no RTS per character:
EB0A                             ;      LDY #0 / LDA (IP),Y / INC IP / BNE $+4 / INC IP+1 / TAY /
EB0A                             ;      LDA DTL,Y / STA V / LDA DTH,Y / STA V+1 / JMP (V)
EB0A                             ;  The letters and digits have one entry each, which knows its cell or its
EB0A                             ;  value already; the commonest punctuation is written for the table; the
EB0A                             ;  rest reach the ordinary handlers through a thunk (CLC / JSR handler /
EB0A                             ;  NEXTF, or JMP fnext for the rare ones), which gives them the step frame
EB0A                             ;  and the clear carry they expect.
EB0A                             ;  The ordinary handlers that end at next or pnext go to fnext, the same
EB0A                             ;  dispatcher. In the checked build NEXTF is JMP fnext, which checks the
EB0A                             ;  stacks first, as next does in the other builds.
EB0A                             ;  Everything here is read-only: the image can be ROM, as the others are.
EB0A                             ;  The table takes the image's first two pages (E000h-E1FFh); the code
EB0A                             ;  starts after it.
EB0A                             ; =============================================================================
EB0A                          IF   FAST   
EB0A                             ; fnext: the dispatcher, after the checks of the checked build
EB0A                FNEXT:       
EB0A                          ENDIF      
EB0A                          IF   FAST*CHECKED   
                                 ; (the same checks as next in the other checked builds)
                              TXA      ; TSX trashes X: keep it in A
                              TSX      
                              STX   RSV   
                              CPX   #RSLIM   
                              TAX      
                              BCS   fn1   
                              JMP   e_rstack   
                    FN1:      CPX   #DSE+1   
                              BCC   fn3   
                              JMP   e_stack   
                    FN3:      LDA   IP   
                              STA   PLACE   
                              LDA   IP+1   
                              STA   PLACE+1   
EB0A                          ENDIF      
EB0A                          IF   FAST   
EB0A   A0 00                  LDY   #0   
EB0C   B1 00                  LDA   (IP),Y   
EB0E   E6 00                  INC   IP   
EB10   D0 02                  BNE   fn4   
EB12   E6 01                  INC   IP+1   
EB14   A8           FN4:      TAY      
EB15   B9 00 E0               LDA   DTL,Y   
EB18   85 04                  STA   V   
EB1A   B9 00 E1               LDA   DTH,Y   
EB1D   85 05                  STA   V+1   
EB1F   6C 04 00               JMP   (V)   
EB22                             ; fpoll: the break check of pnext, as a subroutine, for the entries that
EB22                             ; look at the keyboard (a word call, a true ( and a true ))
EB22   20 06 FF     FPOLL:    JSR   KEY   
EB25   F0 05                  BEQ   fp9   ; no key
EB27   85 07                  STA   KEYBUF   ; held for the next "?"
EB29   4C 90 E2               JMP   chk3   ; (Ctrl-C: back only if the break key is off)
EB2C   60           FP9:      RTS      
EB2D                             ; The thunks: the rest of the punctuation, through the ordinary handlers
EB2D   18           FT_STR:   CLC      ; "
EB2E   20 1F E4               JSR   h_str   
EB31   4C 0A EB               JMP   fnext   ; (rare enough: the shared dispatcher)
EB34   18           FT_NUM:   CLC      ; #
EB35   20 92 E4               JSR   h_num   
EB38   4C 0A EB               JMP   fnext   ; (rare enough: the shared dispatcher)
EB3B   18           FT_PRT:   CLC      ; $
EB3C   20 36 E4               JSR   h_print   
EB3F   4C 0A EB               JMP   fnext   ; (rare enough: the shared dispatcher)
EB42   18           FT_EMIT:   CLC      ; '
EB43   20 54 E4               JSR   h_emit   
EB46   4C 0A EB               JMP   fnext   ; (rare enough: the shared dispatcher)
EB49   18           FT_DIV:   CLC      ; /
EB4A   20 3F E8               JSR   h_div   
EB4D                          ;*Macro unroll:  NEXTF
EB4D   A0                     DS   1-CHECKED,0A0h   
EB4E   00                     DS   1-CHECKED,0   
EB4F   B1                     DS   1-CHECKED,0B1h   
EB50   00                     DS   1-CHECKED,IP   
EB51   E6                     DS   1-CHECKED,0E6h   
EB52   00                     DS   1-CHECKED,IP   
EB53   D0                     DS   1-CHECKED,0D0h   
EB54   02                     DS   1-CHECKED,2   
EB55   E6                     DS   1-CHECKED,0E6h   
EB56   01                     DS   1-CHECKED,IP+1   
EB57   A8                     DS   1-CHECKED,0A8h   
EB58   B9                     DS   1-CHECKED,0B9h   
EB59   00                     DS   1-CHECKED,ADTL&0FFh   
EB5A   E0                     DS   1-CHECKED,ADTL/256   
EB5B   85                     DS   1-CHECKED,85h   
EB5C   04                     DS   1-CHECKED,V   
EB5D   B9                     DS   1-CHECKED,0B9h   
EB5E   00                     DS   1-CHECKED,ADTH&0FFh   
EB5F   E1                     DS   1-CHECKED,ADTH/256   
EB60   85                     DS   1-CHECKED,85h   
EB61   05                     DS   1-CHECKED,V+1   
EB62   6C                     DS   1-CHECKED,6Ch   
EB63   04                     DS   1-CHECKED,V   
EB64   00                     DS   1-CHECKED,0   
EB65                          DS   CHECKED,4Ch   
EB65                          DS   CHECKED,AFNX&0FFh   
EB65                          DS   CHECKED,AFNX/256   
EB65   18           FT_KEY:   CLC      ; ?
EB66   20 7D EA               JSR   h_key   
EB69   4C 0A EB               JMP   fnext   ; (rare enough: the shared dispatcher)
EB6C   18           FT_DEF:   CLC      ; [
EB6D   20 54 E3               JSR   h_def   
EB70                          ;*Macro unroll:  NEXTF
EB70   A0                     DS   1-CHECKED,0A0h   
EB71   00                     DS   1-CHECKED,0   
EB72   B1                     DS   1-CHECKED,0B1h   
EB73   00                     DS   1-CHECKED,IP   
EB74   E6                     DS   1-CHECKED,0E6h   
EB75   00                     DS   1-CHECKED,IP   
EB76   D0                     DS   1-CHECKED,0D0h   
EB77   02                     DS   1-CHECKED,2   
EB78   E6                     DS   1-CHECKED,0E6h   
EB79   01                     DS   1-CHECKED,IP+1   
EB7A   A8                     DS   1-CHECKED,0A8h   
EB7B   B9                     DS   1-CHECKED,0B9h   
EB7C   00                     DS   1-CHECKED,ADTL&0FFh   
EB7D   E0                     DS   1-CHECKED,ADTL/256   
