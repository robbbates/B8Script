E454                             ; =============================================================================
E454                             ;  Machine code: the grave
E454                             ; =============================================================================
E454                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
E454                             ; are stored from addr until a non-hex character; then a RET (60h) is
E454                             ; written and its address is left. An odd last digit is consumed and dropped.
E454                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ); see the
E454                             ; contract in the header.
E454   20 86 E4     H_GRAVE:   JSR   rdhex   
E457   B0 1F                  BCS   exec   
E459   0A           HX1:      ASL      
E45A   0A                     ASL      
E45B   0A                     ASL      
E45C   0A                     ASL      
E45D   85 04                  STA   T0   
E45F   20 86 E4               JSR   rdhex   
E462   B0 0F                  BCS   hx2   ; odd digit: already consumed, dropped
E464   05 04                  ORA   T0   
E466                          IF   CHECKED   
                              STA   T0   
                              LDA   TH   
                              JSR   chkst   
                              LDA   T0   
E466                          ENDIF      
E466   91 02                  STA   (TL),Y   ; Y is 0 after rdhex
E468   E6 02                  INC   TL   
E46A   D0 02                  BNE   hx3   
E46C   E6 03                  INC   TH   
E46E   20 86 E4     HX3:      JSR   rdhex   
E471   90 E6                  BCC   hx1   
E473                HX2:         
E473                          IF   CHECKED   
                              LDA   TH   
                              JSR   chkst   
E473                          ENDIF      
E473   A9 60                  LDA   #60h   
E475   91 02                  STA   (TL),Y   
E477   60                     RTS      
E478   A5 02        EXEC:     LDA   TL   
E47A   85 04                  STA   T0   
E47C   A5 03                  LDA   TH   
E47E   85 05                  STA   T1   
E480   20 80 E1               JSR   drop   ; the address is consumed
E483   6C 04 00               JMP   (T0)   
E486                             ; rdhex: if IP is at a hex digit (0-9, A-F, a-f), return its value in A with
E486                             ; the carry clear and IP moved on; otherwise the carry is set and IP stays.
E486   20 48 E1     RDHEX:    JSR   peek   
E489   38                     SEC      
E48A   E9 30                  SBC   #"0"   
E48C   C9 0A                  CMP   #10   
E48E   90 0A                  BCC   rh1   
E490   29 DF                  AND   #0DFh   
E492   E9 11                  SBC   #11h   
