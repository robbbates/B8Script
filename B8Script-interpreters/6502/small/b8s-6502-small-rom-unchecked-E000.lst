0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the 6502 (NMOS opcodes only)
0000                             ;  Required Notice: Copyright 2026 Robb Bates (https://github.com/robbbates)
0000                             ;  Licence: PolyForm Noncommercial License 1.0.0 (LICENSE.md at the top of
0000                             ;  the repository, or https://polyformproject.org/licenses/noncommercial/1.0.0)
0000                             ;  Spec: docs/b8script.md (2026-11-24). -n? does no more editing than
0000                             ;        Backspace. Ctrl-C stops every build (see the console layer); the
0000                             ;        break-off cell is BRKOFF, $047B.
0000                             ;  Design follows the Z80 interpreter; see b8s-z80.asm for the common ideas.
0000                             ; 
0000                             ;  This interpreter keeps the data stack in pages 2 and 3 (252 cells) and
0000                             ;  uses 10 bytes of zero page ($00-$09). b8s-6502-zp.asm is a smaller interpreter that
0000                             ;  keeps the stack in zero page instead (112 cells); its memory map and
0000                             ;  machine-code contract differ.
0000                             ; 
0000                             ;  The switches, set in the EQU lines below:
0000                             ;    CHECKED  0 = no checks: whatever the spec calls unsafe is not caught
0000                             ;             1 = a checked build, as in the spec's "Errors and checked
0000                             ;                 builds": at startup every word cell points at 0000h (see
0000                             ;                 e_undef) and the variables and the interpreter's cells are
0000                             ;                 0. It stops with S s R r (stack over/underflow), H (heap),
0000                             ;                 O (a store outside the program's space), U (undefined
0000                             ;                 word), Q (no closing quote), W (bad character after [), X
0000                             ;                 (a reserved byte), Z (divide by zero), N (brackets) or B
0000                             ;                 (Ctrl-C), printing the spec's three-line report:
0000                             ;                   Err Z @ 3,4
0000                             ;                   D:2: 5 0
0000                             ;                   R:0
0000                             ;                 and then goes to EXIT.
0000                             ;    ANSI     what the console escapes of "$" (/00bbIC8= /| /` /~) do:
0000                             ;             1 = send ANSI (VT100) sequences through CONOUT
0000                             ;             0 = call the machine's own routines CONCLS, CONEOL, CONCUR and
0000                             ;                 CONAT (see the equates)
0000                             ;    SPEED    0 = small: the smallest build
0000                             ;             1 = base, the default: the speed-ups that cost bytes: a skip
0000                             ;                 cache, a faster skip, "*" and "/" quicker for small and
0000                             ;                 power-of-two operands, and more (see "Speed-ups")
0000                             ;             2 = fast: base and a dispatch table besides, with no size
0000                             ;                 limit (see "The fast build").
0000                             ;  The base and fast builds use one more RAM page, for the skip cache: the page
0000                             ;  at the heap limit, which is DF00h in them (E000h in the others).
0000                             ; 
0000                             ;  Assembler: asm80, C6502 mode.
0000                             ; =============================================================================
0000                CHECKED:   EQU   0   ; 1 = checked build
0000                ANSI:     EQU   0   ; 1 = the console escapes send ANSI sequences
0000                SPEED:    EQU   0   ; 0 = small, 1 = base, 2 = fast (see "Speed-ups")
0000                FAST:     EQU   SPEED/2   ; (1: the fast build)
0000                SBASE:    EQU   SPEED-FAST*2   ; (1: the base build)
0000                QK:       EQU   SBASE+FAST-SBASE*FAST   ; (the speed-ups: base, or the fast build)
0000                SBASEU:   EQU   QK*(1-CHECKED)*(1-FAST)   ; (and those that only the unchecked
0000                             ;  builds take; the fast build has its own)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Registers and zero page
0000                             ; 
0000                             ;    IP      zero-page pointer to the next program character (16 bits)
0000                             ;    TL/TH   the top data-stack cell (TOS) lives in zero page, not in memory
0000                             ;    X       data-stack index. The stack is two byte-planes, grows down, and
0000                             ;            holds everything under TOS: NOS is DSL,X (low) and DSH,X (high).
0000                             ;            The stack never leaves its planes because X is 8 bits.
0000                             ;    S       the hardware stack is the RETURN stack: a word call or "(" pushes
0000                             ;            the reading position (high byte first, then low) and "]" or ")"
0000                             ;            pulls it. 100 entries (200 bytes) fit with room to spare.
0000                             ;    Y, A    scratch. Y is 0 after peek/getc, and the zero-page indirect reads
0000                             ;            (IP),Y rely on that.
0000                             ; 
0000                             ;  Dispatch: step is called with JSR, so a handler ends with a plain RTS and
0000                             ;  lands on "JMP next" in the loop. Punctuation goes through PTAB with the
0000                             ;  RTS trick (push handler-1, RTS). Handlers that use the return stack ( ( ) \
0000                             ;  ] 00bbIA== and word calls ) first pull the 2-byte JSR frame off (PLA PLA) and end
0000                             ;  with JMP next instead.
0000                             ;  The fast build (SPEED = 2) dispatches through a full table instead: see
0000                             ;  "The fast build" at the end.
0000                             ; 
0000                             ;  Every punctuation handler starts with the carry clear (the range sort in
0000                             ;  step leaves it so). Several of them count on that, where the comments say.
0000                             ; 
0000                             ;  Machine-code contract (the grave): the code at TOS is entered as a
0000                             ;  subroutine, by JMP (T0) with the loop's return address on the hardware
0000                             ;  stack, so it ends with RTS (60h, which the hex loader appends). On entry
0000                             ;  TL/TH ($02/$03) hold the new TOS (the address is already consumed) and X is
0000                             ;  the data-stack index: NOS is DSL,X (low) and DSH,X (high), which is
0000                             ;  $0200,X and $0300,X.
0000                             ;  To push: DEX, store TL/TH at DSL,X/DSH,X, then set TL/TH. To drop: load
0000                             ;  TL/TH from DSL,X/DSH,X and INX. The code may change A, Y, X (it is the
0000                             ;  stack index, so it must stay consistent on return) and zero page $04-$06
0000                             ;  and $08-$09; it must keep IP ($00/$01) and the hardware stack balanced. On
0000                             ;  return TL/TH are the TOS. Zero page $0A-$0F is free for the code's own use.
0000                             ; -----------------------------------------------------------------------------
0000                IP:       EQU   00h   ; 00-01 reading position
0000                TL:       EQU   02h   ; TOS low
0000                TH:       EQU   03h   ; TOS high
0000                T0:       EQU   04h   ; scratch
0000                T1:       EQU   05h   
0000                T2:       EQU   06h   
0000                D0:       EQU   08h   ; divisor (division, number printing)
0000                D1:       EQU   09h   
0000                SKL:      EQU   T1   ; (QK) 05 and 08: where a skip started, for
0000                SKH:      EQU   D0   ;   the skip cache
0000                V:        EQU   T0   ; (FAST) 04-05 the dispatcher's jump vector
0000                          IF   1-CHECKED   
0000                KEYBUF:   EQU   07h   ; a key held back by the break check (0: none)
0000                          ENDIF      
0000                          IF   CHECKED   
                    PLACE:    EQU   06h   ; 06-07 (T2 and $07) the address of the
                                 ;   character being run, for the error report:
                                 ;   no handler of the checked build uses T2.
                                 ;   (Machine code may change T2: that matters
                                 ;   only if it also leaves a stack overrun,
                                 ;   whose report then shows a wrong place.)
                    RSV:      EQU   LET+35h   ; S as it was before this character
                    KEYBUF:   EQU   LET+7Ah   ; a key held back by the break check (0: none)
                                 ; The error report runs after the program, so it may use the zero page that
                                 ; machine code has ($0A-$0F):
                    CL:       EQU   0Ah   ; 0A-0B where the reported line starts
0000                          ENDIF      
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map
0000                             ; 
0000                             ;    0000-00FF  zero page: the variables above
0000                             ;    0100-01FF  hardware stack = return stack, S starts at FF
0000                             ;    0200       DSL, data stack, low bytes (X = FC when empty: 252 cells)
0000                             ;    0300       DSH, data stack, high bytes
0000                             ;    0400       LET  letter cells: A..Z at +00..+33, a..z at +40..+73 (a word
0000                             ;               cell is 64 bytes below its variable), heap pointer at +7C,
0000                             ;               the -n? line buffer at +80..+FF. The checked build's cells
0000                             ;               are in the gaps: RSV at +35, PEND at +38, KEYBUF (the held
0000                             ;               key; $07 in the unchecked build) at +7A; and every build's:
0000                             ;               CDOWN at +79, BRKOFF (the break-off cell) at +7B.
0000                             ;    0500       PROG the program text, NUL-terminated; the heap follows
0000                             ;    DF00       CPAGE (QK builds only): the skip cache, at the heap limit
0000                             ;    E000       the interpreter (ROM). In the fast build its first two
0000                             ;               pages are the dispatch table, and start is at E200
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the page range LETPAGE..HEAPLIM-1.
0000                             ; -----------------------------------------------------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The Z flag must match A (it does
0000                             ;   if the routine ends with LDA / RTS).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                             ;   KEY and CONOUT must preserve X and Y.
0000                          IF   1-ANSI   
0000                             ; With ANSI = 0 the console escapes of "$" call these. All four must keep X;
0000                             ; they may change A, Y and the flags.
0000                CONCLS:   EQU   0FF0Ch   ; /{  clear the screen, the cursor to the top left
0000                CONEOL:   EQU   0FF0Fh   ; /}  clear from the cursor to the end of the line
0000                CONCUR:   EQU   0FF12h   ; /| and /`  show the cursor if the carry is set,
0000                             ;     hide it if the carry is clear
0000                CONAT:    EQU   0FF15h   ; /~  the cursor to row A, column Y, both
0000                             ;     counted from 0
0000                          ENDIF      
0000                DSL:      EQU   0200h   ; data stack, low bytes
0000                DSH:      EQU   0300h   ; data stack, high bytes
0000                DSE:      EQU   0FCh   ; X when the data stack is empty
0000                LETPAGE:   EQU   04h   
0000                LET:      EQU   LETPAGE*256   
0000                PROG:     EQU   0500h   ; where the loader puts the program text
0000                PROG1:    EQU   PROG+1   
0000                HEAPLIM:   EQU   0E0h-QK   ; the heap must stay below E000h (a page);
0000                             ;   below DF00h in the QK builds, where
0000                CPAGE:    EQU   HEAPLIM   ;   DF00h is the skip cache's page: the page
0000                             ;   at the heap limit, which the heap never reaches
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer (the heap top)
0000                CDOWN:    EQU   LET+79h   ; the break check's countdown (see pnext)
0000                BRKOFF:   EQU   LET+7Bh   ; the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                PEND:     EQU   LET+38h   ; checked: the program's end, where the heap
0000                             ;   starts: it may not be released below it
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSLIM:    EQU   20h   ; lowest S allowed (checked build)
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms; tune it
0000                             ;   (each pass calls KEY once; the wait for a
0000                             ;   second Ctrl-C uses it too: 250 ms)
0000                CWAIT:    EQU   250*MSLOOP/256   ; (that wait, in 256s)
0000                             ; The fast build's dispatcher (SPEED = 2; see "The fast build"), inline at
0000                             ; the end of its own entries. NEXTF reads the next character and jumps
0000                             ; through the table:
0000                             ;     LDY #0 / LDA (IP),Y / INC IP / BNE $+4 / INC IP+1 / TAY /
0000                             ;     LDA DTL,Y / STA V / LDA DTH,Y / STA V+1 / JMP (V)
0000                             ; NEXTA is the same from INC IP on: the character is already in A, and IP is
0000                             ; still at it (it skips the LDY and the LDA); NEXTY is the same with the
0000                             ; character in Y (it skips the TAY too). In the checked build all three are
0000                             ; JMP fnext, which checks the stacks first. (The bytes are written out with
0000                             ; DS, because asm80 does not nest an IF in a macro inside another IF; and
0000                             ; DS takes the addresses as these equates.)
0000                          IF   FAST   
                    ADTL:     EQU   DTL   
                    ADTH:     EQU   DTH   
                    AFNX:     EQU   fnext   
0000                          ENDIF      
0000                          IF   1-FAST   
0000                ADTL:     EQU   0   
0000                ADTH:     EQU   0   
0000                AFNX:     EQU   0   
0000                          ENDIF      
0000                .macro NEXTF,
0000                             ; 
0000                 DS      1-CHECKED,0A0h  ; LDY #0
0000                 DS      1-CHECKED,0
0000                 DS      1-CHECKED,0B1h  ; LDA (IP),Y
0000                 DS      1-CHECKED,IP
0000                 DS      1-CHECKED,0E6h  ; INC IP
0000                 DS      1-CHECKED,IP
0000                 DS      1-CHECKED,0D0h  ; BNE $+4
0000                 DS      1-CHECKED,2
0000                 DS      1-CHECKED,0E6h  ; INC IP+1
0000                 DS      1-CHECKED,IP+1
0000                 DS      1-CHECKED,0A8h  ; TAY
0000                 DS      1-CHECKED,0B9h  ; LDA DTL,Y
0000                 DS      1-CHECKED,ADTL&0FFh
0000                 DS      1-CHECKED,ADTL/256
0000                 DS      1-CHECKED,85h   ; STA V
0000                 DS      1-CHECKED,V
0000                 DS      1-CHECKED,0B9h  ; LDA DTH,Y
0000                 DS      1-CHECKED,ADTH&0FFh
0000                 DS      1-CHECKED,ADTH/256
0000                 DS      1-CHECKED,85h   ; STA V+1
0000                 DS      1-CHECKED,V+1
0000                 DS      1-CHECKED,6Ch   ; JMP (V)
0000                 DS      1-CHECKED,V
0000                 DS      1-CHECKED,0
0000                 DS      CHECKED,4Ch     ; JMP fnext (checked)
0000                 DS      CHECKED,AFNX&0FFh
0000                 DS      CHECKED,AFNX/256
0000                .endm
0000                 
0000                .macro NEXTA,
0000                             ; 
0000                 DS      1-CHECKED,0E6h  ; INC IP
0000                 DS      1-CHECKED,IP
0000                 DS      1-CHECKED,0D0h  ; BNE $+4
0000                 DS      1-CHECKED,2
0000                 DS      1-CHECKED,0E6h  ; INC IP+1
0000                 DS      1-CHECKED,IP+1
0000                 DS      1-CHECKED,0A8h  ; TAY
0000                 DS      1-CHECKED,0B9h  ; LDA DTL,Y
0000                 DS      1-CHECKED,ADTL&0FFh
0000                 DS      1-CHECKED,ADTL/256
0000                 DS      1-CHECKED,85h   ; STA V
0000                 DS      1-CHECKED,V
0000                 DS      1-CHECKED,0B9h  ; LDA DTH,Y
0000                 DS      1-CHECKED,ADTH&0FFh
0000                 DS      1-CHECKED,ADTH/256
0000                 DS      1-CHECKED,85h   ; STA V+1
0000                 DS      1-CHECKED,V+1
0000                 DS      1-CHECKED,6Ch   ; JMP (V)
0000                 DS      1-CHECKED,V
0000                 DS      1-CHECKED,0
0000                 DS      CHECKED,4Ch     ; JMP fnext (checked)
0000                 DS      CHECKED,AFNX&0FFh
0000                 DS      CHECKED,AFNX/256
0000                .endm
0000                 
0000                .macro NEXTY,
0000                             ; 
0000                 DS      1-CHECKED,0E6h  ; INC IP
0000                 DS      1-CHECKED,IP
0000                 DS      1-CHECKED,0D0h  ; BNE $+4
0000                 DS      1-CHECKED,2
0000                 DS      1-CHECKED,0E6h  ; INC IP+1
0000                 DS      1-CHECKED,IP+1
0000                 DS      1-CHECKED,0B9h  ; LDA DTL,Y
0000                 DS      1-CHECKED,ADTL&0FFh
0000                 DS      1-CHECKED,ADTL/256
0000                 DS      1-CHECKED,85h   ; STA V
0000                 DS      1-CHECKED,V
0000                 DS      1-CHECKED,0B9h  ; LDA DTH,Y
0000                 DS      1-CHECKED,ADTH&0FFh
0000                 DS      1-CHECKED,ADTH/256
0000                 DS      1-CHECKED,85h   ; STA V+1
0000                 DS      1-CHECKED,V+1
0000                 DS      1-CHECKED,6Ch   ; JMP (V)
0000                 DS      1-CHECKED,V
0000                 DS      1-CHECKED,0
0000                 DS      CHECKED,4Ch     ; JMP fnext (checked)
0000                 DS      CHECKED,AFNX&0FFh
0000                 DS      CHECKED,AFNX/256
0000                .endm
0000                 
0000                FTAB:     EQU   0E000h   ; (FAST: the fast build's table, two pages,
E000                          .ORG   FTAB+FAST*512   ;   comes first, and the code after it)
E000                             ; =============================================================================
E000                             ;  Startup: find the NUL, the heap starts after it
E000                             ; =============================================================================
E000   A2 FF        START:    LDX   #0FFh   
E002   9A                     TXS      ; return stack empty
E003                          IF   CHECKED   
                                 ; The first half of the letter page is zeroed: every variable, every
                                 ; cell of the interpreter's own (no key held back), and every word
                                 ; cell, which then points at 0000h: calling an undefined word stops
                                 ; with U (see e_undef).
                              INX      
                              TXA      ; A = 0
                              LDY   #7Fh   
                    STZ:      STA   LET,Y   
                              DEY      
                              BPL   stz   
E003                          ENDIF      
E003                          IF   QK   
                              LDA   #0   ; an empty skip cache (a start of 0000h
                              TAY      ;   matches no skip)
                    SKC:      STA   CPAGE*256,Y   
                              INY      
                              BNE   skc   
E003                          ENDIF      
E003   20 B1 E2               JSR   rstip   
E006   20 A5 E2     ST1:      JSR   getc   
E009   D0 FB                  BNE   st1   ; IP ends just past the NUL
E00B                          IF   1-CHECKED   
E00B   85 07                  STA   KEYBUF   ; (A = 0) no key held, the break key on
E00D   8D 7B 04               STA   BRKOFF   
E010                          ENDIF      
E010   A5 00                  LDA   IP   
E012   8D 7C 04               STA   HEAP   
E015                          IF   CHECKED   
                              STA   PEND   
E015                          ENDIF      
E015   A5 01                  LDA   IP+1   
E017   8D 7D 04               STA   HEAP+1   
E01A                          IF   CHECKED   
                              STA   PEND+1   
E01A                          ENDIF      
E01A   20 B1 E2               JSR   rstip   
E01D   A2 FC                  LDX   #DSE   
E01F                             ; =============================================================================
E01F                             ;  The inner loop
E01F                             ; =============================================================================
E01F                             ; -----------------------------------------------------------------------------
E01F                             ;  The break key. A running program reads the keyboard only through getk
E01F                             ;  (for "?") and pnext (the break check), which between them give the break
E01F                             ;  key its rules:
E01F                             ;    - Ctrl-C (03h) stops the program: silently to EXIT in the unchecked
E01F                             ;      build, with the report (B) in the checked one;
E01F                             ;    - any other key that the break check reads is held in KEYBUF for the
E01F                             ;      next "?", and a newer one takes its place;
E01F                             ;    - "?" (getk) takes the held key first;
E01F                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
E01F                             ;      key like any other, but two of them within about 250 ms still stop it.
E01F                             ;  KEY is the host's: a waiting key in A, or A = 0 with the zero flag set.
E01F                             ; -----------------------------------------------------------------------------
E01F                             ; pnext: the break check, then (falling through) next. A word call, a true
E01F                             ; "(" and a true ")" end here, but the keyboard is looked at only once in 256
E01F                             ; of them: CDOWN counts them down. A key found is held; a Ctrl-C goes on to ctlc. (Startup
E01F                             ; falls in here too, which does no harm.)
E01F   CE 79 04     PNEXT:    DEC   CDOWN   
E022   D0 0A                  BNE   next   
E024   20 06 FF     PKEY:     JSR   KEY   
E027   F0 05                  BEQ   next   ; no key
E029   85 07                  STA   KEYBUF   ; held for the next "?"
E02B   20 87 E0               JSR   chk3   ; (Ctrl-C: back only if the break key is off)
E02E                NEXT:        
E02E                          IF   FAST   
                              JMP   fnext   ; (the fast build: see "The fast build")
E02E                          ENDIF      
E02E                          IF   CHECKED*(1-FAST)   
                                 ; Both stacks are checked once per character, after it has run. The
                                 ; return stack has overrun when S is below RSLIM: an overflow leaves
                                 ; it at 1Eh or 1Fh, an underflow wraps it to 01h (no handler pulls
                                 ; more than one entry). The data stack has when X is above DSE: an
                                 ; underflow moves X up to FDh or FEh (no handler moves X by more
                                 ; than 2, but "$", whose /~ escapes each look first), and an
                                 ; overflow wraps it from 00h to FFh.
                                 ; S is kept in RSV, for the report's R: line (an error found inside
                                 ; a handler has its own calls on the hardware stack), and the place
                                 ; of the character about to run in PLACE.
                              TXA      ; TSX trashes X: keep it in A
                              TSX      
                              STX   RSV   
                              CPX   #RSLIM   
                              TAX      ; TAX leaves the carry alone
                              BCC   e_rstack   
                              CPX   #DSE+1   
                              BCS   e_stack   
                              LDA   IP   
                              STA   PLACE   
                              LDA   IP+1   
                              STA   PLACE+1   
E02E                          ENDIF      
E02E                          IF   1-FAST   
E02E   20 AD E0               JSR   step   
E031   4C 2E E0               JMP   next   
E034                          ENDIF      
E034                          IF   CHECKED   
                                 ; S/R are overflows, s/r underflows. After an underflow that stack counts as
                                 ; empty.
                    E_RSTACK:   LDA   RSV   
                              CMP   #10h   
                              LDA   #"R"   
                              BCS   ejmp   ; S is 1Eh-1Fh: an overflow
                              LDA   #0FFh   
                              STA   RSV   ; S wrapped to 01h: R:0
                              LDA   #"r"   
                              BNE   ejmp   ; always
                    E_STACK:   CPX   #0FFh   
                              LDA   #"S"   
                              BCS   ejmp   ; X wrapped from 00h to FFh: an overflow
                              LDX   #DSE   ; an underflow: D:0
                              LDA   #"s"   
                    EJMP:     JMP   error   
E034                          ENDIF      
E034                             ; The handlers that work on the return stack sit here, where short branches
E034                             ; reach next and pnext.
E034                             ; "{" TOS to the return stack, "}" return stack to TOS
E034   68           H_TOR:    PLA      
E035   68                     PLA      
E036   A5 03                  LDA   TH   
E038   48                     PHA      
E039   A5 02                  LDA   TL   
E03B   48                     PHA      
E03C   20 D2 E2               JSR   drop   
E03F   D0 ED                  BNE   next   ; always
E041   68           H_FROMR:   PLA      
E042   68                     PLA      
E043   20 0B E1               JSR   push   
E046   68                     PLA      
E047   85 02                  STA   TL   
E049   68                     PLA      
E04A   85 03                  STA   TH   
E04C   90 E0                  BCC   next   ; always: the carry is clear on the way in
E04E                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
E04E                             ; drops it and carries on. It shares "]"s code: with the carry clear, as
E04E                             ; it is here, the address popped is pushed back.
E04E   20 BA E2     H_CLOSE:   JSR   flag   
E051   F0 1E                  BEQ   rdrop   
E053                          IF   1-QK   
E053   24                     DB   24h   ; (BIT zp: steps over the SEC)
E054                          ENDIF      
E054                          IF   QK   
                              JMP   closeq   ; (QK: see Speed-ups)
E054                          ENDIF      
E054                             ; "]" returns: pull an address and jump to it.
E054   38           H_RET:    SEC      
E055   68                     PLA      
E056   68                     PLA      ; drop the step frame
E057   68                     PLA      
E058   85 00                  STA   IP   
E05A   68                     PLA      
E05B   85 01                  STA   IP+1   
E05D   B0 CF                  BCS   next   
E05F   48                     PHA      ; ")": keep the block start
E060   A5 00                  LDA   IP   
E062   48                     PHA      
E063   90 BA                  BCC   pnext   ; always: a loop-back, with the break check
E065                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
E065                             ; drops the block start, "]" returns.
E065   20 BA E2     H_BREAK:   JSR   flag   
E068   F0 21                  BEQ   gk9   ; (an RTS)
E06A                          IF   CHECKED   
                              LDA   #0   ; \ takes either closer
E06A                          ENDIF      
E06A   20 52 E1               JSR   skip   
E06D   C9 29                  CMP   #")"   
E06F   D0 E3                  BNE   h_ret   
E071   68           RDROP:    PLA      
E072   68                     PLA      
E073   68                     PLA      
E074   68                     PLA      ; (the block start's high byte: never 0)
E075                          IF   1-QK   
E075   D0 B7                  BNE   next   ; always
E077                          ENDIF      
E077                          IF   QK   
                              JMP   next   ; (closeq moved next out of reach)
E077                          ENDIF      
E077                             ; getk: a key for "?" in A (zero flag clear), or A = 0 with the zero flag
E077                             ; set when there is none. Keeps X and Y. The held key goes first, and is
E077                             ; taken out of KEYBUF.
E077   A5 07        GETK:     LDA   KEYBUF   
E079   F0 07                  BEQ   gk1   
E07B   48                     PHA      
E07C   A9 00                  LDA   #0   
E07E   85 07                  STA   KEYBUF   
E080   68                     PLA      
E081   60                     RTS      
E082   20 06 FF     GK1:      JSR   KEY   
E085   F0 04                  BEQ   gk9   
E087                             ; chk3: a key in A (not 0). A Ctrl-C goes on to ctlc, which gives the 03h
E087                             ; back if it comes back at all.
E087   C9 03        CHK3:     CMP   #3   
E089   F0 01                  BEQ   ctlc   
E08B   60           GK9:      RTS      
E08C                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
E08C                             ; the program has turned it off, wait about 250 ms (about 250 times MSLOOP
E08C                             ; looks: D0 counts the 256s, D1 runs on from whatever it holds) for one more
E08C                             ; key: a second Ctrl-C is the end too; any other key is held (the newest
E08C                             ; wins). Returns A = 03h with the zero flag clear. Keeps X and Y.
E08C   AD 7B 04     CTLC:     LDA   BRKOFF   
E08F   F0 57                  BEQ   cbreak   
E091   A9 28                  LDA   #CWAIT+1   
E093   85 08                  STA   D0   
E095   20 06 FF     CT2:      JSR   KEY   
E098   D0 0A                  BNE   ct3   
E09A   C6 09                  DEC   D1   
E09C   D0 F7                  BNE   ct2   
E09E   C6 08                  DEC   D0   
E0A0   D0 F3                  BNE   ct2   
E0A2   F0 06                  BEQ   ct9   ; always: none came
E0A4   C9 03        CT3:      CMP   #3   
E0A6   F0 40                  BEQ   cbreak   
E0A8   85 07                  STA   KEYBUF   
E0AA   A9 03        CT9:      LDA   #3   
E0AC   60                     RTS      
E0AD                          IF   1-CHECKED   
E0AD                CBREAK:   EQU   endprog   ; the unchecked build stops without a word
E0AD                          ENDIF      
E0AD                          IF   CHECKED   
                    CBREAK:   EQU   e_break   ; the checked build reports B
E0AD                          ENDIF      
E0AD                          IF   CHECKED   
                    E_BREAK:   LDA   #"B"   ; Ctrl-C (the stacks as they stand)
                              DB   2Ch   
                    E_RESV:   LDA   #"X"   ; a reserved byte, 80h-FFh
                    EJMP3:    JMP   error   
E0AD                          ENDIF      
E0AD                          IF   CHECKED   
                                 ; e_undef: the word cells of undefined words hold 0000h. A call there reads
                                 ; the byte at 0000h, which is IP's own low byte: 00h while IP is 0000h, so
                                 ; the call reads a NUL with IP in page zero, where no program can be. The
                                 ; call is undone first: the step frame and the return address come off the
                                 ; hardware stack, and the place is the call letter (the return address - 1).
                    E_UNDEF:   PLA      
                              PLA      ; the step frame
                              PLA      
                              SEC      
                              SBC   #1   
                              STA   PLACE   
                              PLA      
                              SBC   #0   
                              STA   PLACE+1   
                              INC   RSV   
                              INC   RSV   ; R: does not count the call
                              LDA   #"U"   
                              BNE   ejmp3   ; always
E0AD                          ENDIF      
E0AD                             ; step: read one character and sort it by range.
E0AD                             ;    00h          end of program
E0AD                             ;    01h-20h, 7Fh-FFh   ignored
E0AD                             ;    30h-39h      digit: read a whole number
E0AD                             ;    41h-5Ah      A-Z: call the word in that letter's cell
E0AD                             ;    61h-7Ah      a-z: push the address of that letter's cell
E0AD                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
E0AD                             ; Every way out of the sort has the carry clear, except "ignored". A checked
E0AD                             ; build stops on 80h-FFh (X) and still ignores DEL.
E0AD   20 A5 E2     STEP:     JSR   getc   ; flags follow A
E0B0   F0 36                  BEQ   endprog   
E0B2   38                     SEC      
E0B3   E9 21                  SBC   #21h   ; A = c - 21h
E0B5   90 30                  BCC   ign   ; 01h-20h
E0B7   C9 0F                  CMP   #0Fh   
E0B9   90 22                  BCC   punct   ; 21h-2Fh: index 0-14
E0BB   E9 0F                  SBC   #0Fh   ; (carry set) A = c - 30h
E0BD   C9 0A                  CMP   #10   
E0BF   90 2F                  BCC   digit   
E0C1   C9 11                  CMP   #11h   
E0C3   90 16                  BCC   p3a   ; 3Ah-40h
E0C5   E9 11                  SBC   #11h   ; (carry set) A = c - 41h
E0C7   C9 1A                  CMP   #1Ah   
E0C9   90 20                  BCC   upper   ; 41h-5Ah
E0CB   C9 20                  CMP   #20h   
E0CD   90 0A                  BCC   p5b   ; 5Bh-60h
E0CF   C9 3A                  CMP   #3Ah   
E0D1                          IF   1-SBASEU   
E0D1   90 25                  BCC   lower   ; 61h-7Ah: A = 20h-39h
E0D3                          ENDIF      
E0D3                          IF   SBASEU   
                              BCC   lowq   ; 61h-7Ah: A = 20h-39h
E0D3                          ENDIF      
E0D3   C9 3E                  CMP   #3Eh   
E0D5                          IF   1-CHECKED   
E0D5   B0 10                  BCS   ign   ; 7Fh-FFh
E0D7                          ENDIF      
E0D7                          IF   CHECKED   
                              BEQ   ign   ; 7Fh
                              BCS   e_resv   ; 80h-FFh: reserved
E0D7                          ENDIF      
E0D7                             ; The three adjustments below chain. Each ADC adds the carry the one
E0D7                             ; before it left, which the constants allow for.
E0D7   E9 1A                  SBC   #1Ah   ; 7Bh-7Eh: (carry clear: -1Bh) index 28-31
E0D9   69 F6        P5B:      ADC   #0F6h   ; 5Bh-60h: -10 (-9 when chained), index 22-27
E0DB   69 05        P3A:      ADC   #5   ; 3Ah-40h: +5 (+6 when chained), index 15-21
E0DD   0A           PUNCT:    ASL      ; (the index is small: the carry stays clear)
E0DE   A8                     TAY      
E0DF   B9 1B E2               LDA   PTAB+1,Y   
E0E2   48                     PHA      
E0E3   B9 1A E2               LDA   PTAB,Y   
E0E6   48                     PHA      
E0E7   60           IGN:      RTS      ; RTS trick: goes to the handler. Reached
E0E8                             ; directly, it just ends an ignored character.
E0E8                ENDPROG:      
E0E8                          IF   CHECKED   
                              LDA   IP+1   ; IP in page zero: an undefined word
                              BEQ   e_undef   
E0E8                          ENDIF      
E0E8   4C 09 FF               JMP   EXIT   
E0EB                             ; A-Z: call the word. The return address (the IP after the letter) goes on
E0EB                             ; the return stack, and the IP becomes the address in the letter's cell.
E0EB   0A           UPPER:    ASL      
E0EC   A8                     TAY      
E0ED   38                     SEC      
E0EE   B0 2C                  BCS   pushn   ; always
E0F0                             ; Digits: the first one is in A; read the rest of the number.
E0F0   A0 00        DIGIT:    LDY   #0   
E0F2   20 01 E1               JSR   pushay   
E0F5   4C 7F E2               JMP   rdnum   
E0F8                             ; a-z: push the cell's address (the cell is the variable)
E0F8   0A           LOWER:    ASL      
E0F9   A0 04                  LDY   #>LET   
E0FB   D0 04                  BNE   pushay   ; always
E0FD   A5 00        PUSHIP:   LDA   IP   ; push the reading position
E0FF   A4 01                  LDY   IP+1   
E101                             ; pushay: push a cell: A = its low byte, Y = its high byte
E101   48           PUSHAY:   PHA      
E102   20 0B E1               JSR   push   
E105   68                     PLA      
E106   85 02                  STA   TL   
E108   84 03                  STY   TH   
E10A   60                     RTS      
E10B   CA           PUSH:     DEX      ; ":" and every push (keeps Y)
E10C   A5 02                  LDA   TL   
E10E   9D 00 02               STA   DSL,X   
E111   A5 03                  LDA   TH   
E113   9D 00 03               STA   DSH,X   
E116   60                     RTS      
E117                          IF   SBASEU   
                                 ; a-z, in the unchecked QK builds: a variable followed by "@" or "!" is
                                 ; fetched or stored in the same step (x@ is the commonest pair in most
                                 ; programs). A checked build checks the stacks between the two, so it keeps
                                 ; them apart. (pvar calls lower, which only pushes.)
                    LOWQ:     ASL      
                              STA   T0   ; the cell's offset in the letter page
                              LDY   #0   
                              LDA   (IP),Y   
                              CMP   #"@"   
                              BEQ   lwf   
                              CMP   #"!"   
                              BEQ   lws   
                              LDA   T0   
                              LDY   #>LET   
                              BNE   pushay   ; always: the address
                    LWF:      JSR   incip   ; x@: TOS = the cell's value
                              JSR   push   
                              LDY   T0   
                              LDA   LET,Y   
                              STA   TL   
                              LDA   LET+1,Y   
                              STA   TH   
                              RTS      
                    LWS:      JSR   incip   ; x!: the cell = TOS, and NOS comes up
                              LDY   T0   
                              LDA   TL   
                              STA   LET,Y   
                              LDA   TH   
                              STA   LET+1,Y   
                              JMP   drop   
E117                          ENDIF      
E117                          IF   QK   
                                 ;  ---- Speed-ups (QK builds) ---------------------------------------------
                                 ;  The skip cache and the faster skip are at skip, "*" at h_mul and "/" at
                                 ;  udiv; x@ and x! (unchecked) at lowq, above.
                                 ; A true ")" reads the block start where it is, under the step frame,
                                 ; instead of popping it and pushing it back. The break key is looked at as
                                 ; pnext would.
                    CLOSEQ:   TXA      ; (TSX trashes X)
                              TSX      
                              LDY   103h,X   
                              STY   IP   
                              LDY   104h,X   
                              STY   IP+1   
                              TAX      
                              DEC   CDOWN   
                              BEQ   cq1   
                              RTS      ; into the loop
                    CQ1:      PLA      
                              PLA      ; the step frame
                              JMP   pkey   
E117                          ENDIF      
E117                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
E117                             ; the matching ")".
E117   20 BA E2     H_OPEN:   JSR   flag   ; (keeps the carry clear)
E11A                          IF   1-CHECKED   
E11A   F0 36                  BEQ   skip   
E11C                          ENDIF      
E11C                          IF   CHECKED   
                              BEQ   skpar   
E11C                          ENDIF      
E11C                             ; pushn: take the step frame off, push the reading position on the return
E11C                             ; stack, and go on. With the carry set (a word call) the reading position
E11C                             ; then becomes the address in the letter cell at LET,Y.
E11C   68           PUSHN:    PLA      
E11D   68                     PLA      ; drop the step frame
E11E   A5 01                  LDA   IP+1   
E120   48                     PHA      
E121   A5 00                  LDA   IP   
E123   48                     PHA      
E124   90 0A                  BCC   nxt   
E126   B9 00 04               LDA   LET,Y   
E129   85 00                  STA   IP   
E12B   B9 01 04               LDA   LET+1,Y   
E12E   85 01                  STA   IP+1   
E130   4C 1F E0     NXT:      JMP   pnext   
E133                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
E133                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
E133                             ; the body"s address instead. Either way it then skips to the matching "]'.
E133                             ; (The unchecked build takes anything that is not a letter as the space; the
E133                             ; checked build stops on it.)
E133                          IF   CHECKED   
                    DEF1:     CPY   #" "-"A"+256   
                              BEQ   def2   
                                 ; W: anything but a letter or a space after [. The place is that character,
                                 ; one past the [.
                              INC   PLACE   
                              BNE   eb1   
                              INC   PLACE+1   
                    EB1:      LDA   #"W"   
E133                          ENDIF      
E133                          IF   CHECKED*(1-QK)   
                              BNE   ejmp2   ; always
E133                          ENDIF      
E133                          IF   CHECKED*QK   
                              JMP   error   ; (the skip cache moved ejmp2 out of reach)
E133                          ENDIF      
E133                          IF   CHECKED   
                                 ; A false ( skips: the wrong closer for it is ].
                    SKPAR:    LDA   #"]"   
                              BNE   skip   ; always
E133                          ENDIF      
E133   20 A5 E2     H_DEF:    JSR   getc   
E136   38                     SEC      
E137   E9 41                  SBC   #"A"   ; a letter gives 0-25 or 32-57: lowercase
E139   A8                     TAY      ;   lands 64 bytes up
E13A   29 DF                  AND   #0DFh   ; fold case: 0-25 only for a letter
E13C   C9 1A                  CMP   #26   
E13E                          IF   1-CHECKED   
E13E   B0 0F                  BCS   def2   ; not a letter
E140                          ENDIF      
E140                          IF   CHECKED   
                              BCS   def1   
E140                          ENDIF      
E140   98                     TYA      
E141   0A                     ASL      
E142   A8                     TAY      ; Y -> the cell
E143   A5 00                  LDA   IP   
E145   99 00 04               STA   LET,Y   
E148   A5 01                  LDA   IP+1   
E14A   99 01 04               STA   LET+1,Y   
E14D   D0 03                  BNE   skdef   ; always: no program is in page zero
E14F   20 FD E0     DEF2:     JSR   puship   ; an anonymous block: push its address
E152                SKDEF:       
E152                          IF   CHECKED   
                              LDA   #")"   ; the wrong closer for [
E152                          ENDIF      
E152                             ; skip: read past text to the closer at this level, and return it in A.
E152                             ; Brackets of both kinds count together; strings are stepped over whole. A
E152                             ; NUL first ends the program.
E152                             ; In the checked build A holds, on the way in, the wrong closer for the
E152                             ; opener that started the skip, kept in T0: ] for (, ) for [, and 0 for \,
E152                             ; which takes either. Meeting the wrong closer at this level, or the end
E152                             ; (a NUL, or a string that runs into it), stops with N, except for \,
E152                             ; which then ends the program as before.
E152                SKIP:        
E152                          IF   CHECKED   
                              STA   T0   
E152                          ENDIF      
E152                          IF   1-QK   
E152   A9 00                  LDA   #0   
E154   85 09                  STA   D1   ; depth
E156   20 A5 E2     SK1:      JSR   getc   
E159                          ENDIF      
E159                          IF   (1-QK)*(1-CHECKED)   
E159   F0 8D                  BEQ   endprog   
E15B                          ENDIF      
E15B                          IF   (1-QK)*CHECKED   
                              BEQ   sknul   
E15B                          ENDIF      
E15B                          IF   1-QK   
E15B   C9 22                  CMP   #22h   
E15D   D0 03                  BNE   sk2   
E15F   20 7E E1               JSR   skipstr   ; leaves A = 22h (11h when checked), which
E162                             ;   matches nothing below
E162                          ENDIF      
E162                          IF   (1-QK)*CHECKED   
                              BEQ   sknul   ; the string ran into the end
E162                          ENDIF      
E162                          IF   1-QK   
E162   C9 28        SK2:      CMP   #"("   
E164   F0 11                  BEQ   sk3   
E166   C9 5B                  CMP   #"["   
E168   F0 0D                  BEQ   sk3   
E16A   C9 29                  CMP   #")"   
E16C   F0 04                  BEQ   sk4   
E16E   C9 5D                  CMP   #"]"   
E170   D0 E4                  BNE   sk1   
E172   C6 09        SK4:      DEC   D1   
E174   10 E0                  BPL   sk1   
E176                          ENDIF      
E176                          IF   (1-QK)*CHECKED   
                              CMP   T0   
                              BEQ   e_nest   ; the wrong kind
E176                          ENDIF      
E176                          IF   1-QK   
E176   60                     RTS      ; the closer at this level
E177   E6 09        SK3:      INC   D1   
E179   D0 DB                  BNE   sk1   
E17B                          ENDIF      
E17B                          IF   QK   
                                 ; The skip cache (QK builds). Nearly every skip is one that has happened
                                 ; before (a loop skips the same false block on every pass), so the first
                                 ; scan from each place is remembered: 64 entries of {start, the closer's
                                 ; address}, in CPAGE, found by the start's low byte times 4. Only skips that
                                 ; start in the program text are kept (the line buffer changes); the cache is
                                 ; emptied when the program starts. A program that changes its own text while
                                 ; it runs is not looked after.
                              LDA   IP+1   
                              CMP   #>PROG   
                              BCC   sks   ; below the program text: no cache
                              LDA   IP   
                              ASL      
                              ASL      
                              TAY      ; Y -> the entry
                              LDA   IP   
                              CMP   CPAGE*256,Y   
                              BNE   sks   
                              LDA   IP+1   
                              CMP   CPAGE*256+1,Y   
                              BNE   sks   
                              LDA   CPAGE*256+2,Y   ; a hit: the IP goes to the closer, which is
                              STA   IP   ;   read
                              LDA   CPAGE*256+3,Y   
                              STA   IP+1   
                              LDY   #0   
                              LDA   (IP),Y   
                              JMP   incip   
                    SKS:      LDA   IP   
                              STA   SKL   
                              LDA   IP+1   
                              STA   SKH   
                              LDY   #0   
                              STY   D1   ; depth
                                 ; The scan reads at IP+Y. Most characters are nothing to it, and two range
                                 ; tests rule them out: * to Z, and ^ and up. Only NUL " ( ) [ ] count.
                    SQ1:      LDA   (IP),Y   
                              INY      
                              BEQ   sqw   
                    SQ2:      CMP   #5Eh   
                              BCS   sq1   ; ^ _ ` a-z 00bbIHwg ~ and up: nothing
                              CMP   #5Bh   
                              BCS   sqb   ; [ \ ]
                              CMP   #2Ah   
                              BCS   sq1   ; * to Z: nothing
                              CMP   #28h   
                              BEQ   sqo   ; (
                              BCS   sqc   ; )
                              CMP   #22h   
                              BEQ   sqq   ; a string
                              CMP   #1   
                              BCS   sq1   ; the rest below "(": nothing
E17B                          ENDIF      
E17B                          IF   QK*(1-CHECKED)   
                              JMP   EXIT   ; NUL: the end of the program
E17B                          ENDIF      
E17B                          IF   QK*CHECKED   
                              JMP   sknul   
E17B                          ENDIF      
E17B                          IF   QK   
                    SQW:      INC   IP+1   ; Y went round: on into the next page
                              BNE   sq2   ; always
                    SQQ:      JSR   sqip   ; a string: step over it
                              JSR   skipstr   
E17B                          ENDIF      
E17B                          IF   QK*CHECKED   
                              BEQ   sknul   ; the string ran into the end
E17B                          ENDIF      
E17B                          IF   QK   
                              LDY   #0   
                              BEQ   sq1   ; always
                    SQO:      INC   D1   ; an opener
                              JMP   sq1   
                    SQB:      CMP   #5Ch   
                              BEQ   sq1   ; "\" is nothing here
                              BCC   sqo   ; [
                    SQC:      DEC   D1   ; ) ]
                              BPL   sq1   
                              JSR   sqip   ; the closer at this level: the IP past it
E17B                          ENDIF      
E17B                          IF   QK*CHECKED   
                              CMP   T0   
                              BEQ   e_nest   ; the wrong kind
E17B                          ENDIF      
E17B                          IF   QK   
                              PHA      
                              LDA   SKH   ; remember the skip, if it started in the
                              CMP   #>PROG   ;   program text
                              BCC   sq9   
                              LDA   SKL   
                              ASL      
                              ASL      
                              TAY      
                              LDA   SKL   
                              STA   CPAGE*256,Y   
                              LDA   SKH   
                              STA   CPAGE*256+1,Y   
                              LDA   IP   
                              SEC      
                              SBC   #1   
                              STA   CPAGE*256+2,Y   ; the closer's address
                              LDA   IP+1   
                              SBC   #0   
                              STA   CPAGE*256+3,Y   
                    SQ9:      PLA      
                              RTS      ; the closer at this level
                                 ; sqip: IP = IP + Y. Keeps A.
                    SQIP:     PHA      
                              TYA      
                              CLC      
                              ADC   IP   
                              STA   IP   
                              BCC   sp1   
                              INC   IP+1   
                    SP1:      PLA      
                              RTS      
E17B                          ENDIF      
E17B                          IF   CHECKED   
                    SKNUL:    LDA   T0   
                              BNE   e_nest   ; ( and [ stop with N
                              JMP   EXIT   ; \ ends the program
                                 ; The end of "$" (h_print): the string's address goes back into TOS; then a
                                 ; closing quote drops it, and a NUL (the carry clear) is Q.
                    PQ:       PLA      
                              STA   TL   
                              PLA      
                              STA   TH   
                              BCS   pdrop   
                              CPX   #DSE   ; a NUL: Q, unless "$" had nothing on the
                              LDA   #"s"   ;   stack at all (X at the empty mark): s
                              BCS   ejmp2   
                    E_QUOTE:   LDA   #"Q"   ; a string runs into the end
                              DB   2Ch   ; (BIT abs: hides the next instruction)
                    E_NEST:   LDA   #"N"   ; a skip from ( or [ found the wrong closer
                    EJMP2:    JMP   error   ;   or the end: the place is the opener
E17B                          ENDIF      
E17B                             ; 22h pushes the address of the text after it and skips the string.
E17B   20 FD E0     H_STR:    JSR   puship   
E17E                          IF   CHECKED   
                              JSR   skipstr   
                              BEQ   e_quote   ; it ran into the end: the place is the 22h
                              RTS      
E17E                          ENDIF      
E17E                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
E17E                             ; the next character, so "/"" does not end it.
E17E                             ; Unchecked, it returns with Z set and A = 22h, and it does not look for the
E17E                             ; end. Checked, it returns with Z clear and A = 11h, or with Z set if the
E17E                             ; text ended first (a NUL, also one just after "/").
E17E                          IF   1-CHECKED   
E17E   20 A5 E2     SKIPSTR:   JSR   getc   
E181   C9 2F                  CMP   #"/"   
E183   F0 05                  BEQ   ss0   
E185   C9 22                  CMP   #22h   
E187   D0 F5                  BNE   skipstr   
E189   60                     RTS      
E18A   20 A8 E2     SS0:      JSR   incip   
E18D   D0 EF                  BNE   skipstr   ; A is "/" here
E18F                          ENDIF      
E18F                          IF   CHECKED   
                    SKIPSTR:   JSR   getc   
                              BEQ   ss9   ; the end
                              CMP   #"/"   
                              BNE   ss1   
                              JSR   getc   ; the escaped character
                              BNE   skipstr   
                    SS9:      RTS      ; the end, just after "/"
                    SS1:      CMP   #22h   
                              BNE   skipstr   
                              LSR      ; A = 11h, Z clear
                              RTS      
E18F                          ENDIF      
E18F                             ; =============================================================================
E18F                             ;  Console
E18F                             ; =============================================================================
E18F                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
E18F                             ; 60h to 7Eh is one of the escapes at pesc; "/" plus any other character
E18F                             ; clears that character"s bit 6 (/M is CR, /? is DEL"s "?"; "/" and """ have
E18F                             ; no bit 6, so // and /" give themselves). TOS walks along the string; the
E18F                             ; checked build keeps the address on the hardware stack meanwhile, for a Q
E18F                             ; report (see pq).
E18F                          IF   CHECKED   
                    H_PRINT:   LDA   TH   
                              PHA      
                              LDA   TL   
                              PHA      
                              BCC   pr0   ; always: the carry is clear on the way in
E18F                          ENDIF      
E18F                          IF   1-CHECKED   
E18F                H_PRINT:   EQU   pr0   
E18F                          ENDIF      
E18F   20 C3 E1     PESC0:    JSR   pesc   ; (an escape, and back into the loop)
E192   20 B8 E1     PR0:      JSR   tosget   
E195   C9 22                  CMP   #22h   
E197                          IF   1-CHECKED   
E197   F0 1C                  BEQ   pdrop   
E199                          ENDIF      
E199                          IF   CHECKED   
                              BEQ   pq   ; the closing quote, with the carry set
                              TAY      ; (Y is free here)
                              BEQ   pq   ; a NUL, with the carry clear
E199                          ENDIF      
E199   C9 2F                  CMP   #"/"   
E19B   D0 0D                  BNE   pr1   
E19D   20 B8 E1               JSR   tosget   
E1A0   C9 60                  CMP   #60h   
E1A2   90 04                  BCC   pr2   
E1A4   C9 7F                  CMP   #7Fh   
E1A6   90 E7                  BCC   pesc0   ; 60h-7Eh, and the carry is clear
E1A8   29 BF        PR2:      AND   #0BFh   
E1AA   20 03 FF     PR1:      JSR   CONOUT   
E1AD   4C 92 E1               JMP   pr0   
E1B0   A5 02        H_EMIT:   LDA   TL   ; "'"
E1B2   20 03 FF               JSR   CONOUT   
E1B5   4C D2 E2     PDROP:    JMP   drop   
E1B8                             ; tosget: A = the byte at TOS, and TOS moves on.  inctos: TOS moves on.
E1B8   A0 00        TOSGET:   LDY   #0   
E1BA   B1 02                  LDA   (TL),Y   
E1BC   E6 02        INCTOS:   INC   TL   
E1BE   D0 02                  BNE   tg1   
E1C0   E6 03                  INC   TH   
E1C2   60           TG1:      RTS      
E1C3                             ; pesc: the escapes of "$". A = the character after the "/", 60h to 7Eh, and
E1C3                             ; the carry is clear. Each returns into the loop.
E1C3                             ;    /a-/z   print the variable, as "#" does
E1C3                             ;    /{      clear the screen, the cursor to the top left
E1C3                             ;    /}      clear from the cursor to the end of the line
E1C3                             ;    /|  /`  show the cursor, hide it
E1C3                             ;    /~      ( row col addr -- addr ): the cursor to that row and column,
E1C3                             ;            from 0. The two cells under TOS (the string's address) go.
E1C3                             ; A - 7Bh sorts them: 00bbIDAsIHwgMSwg 2, ~ 3 with the carry set, and ` E5h, a-z
E1C3                             ; E6h-FFh with it clear.
E1C3                          IF   1-ANSI   
E1C3                             ; With ANSI = 0 the machine's routines do the work.
E1C3   E9 7A        PESC:     SBC   #7Ah   ; (the carry is clear: - 7Bh)
E1C5   90 0D                  BCC   pe1   
E1C7   F0 08                  BEQ   pcls   ; {
E1C9   4A                     LSR      ; | 0, } 1, ~ 1; the carry set for | and ~
E1CA   F0 0C                  BEQ   pcur   ; |  show: the carry is set
E1CC   B0 0D                  BCS   pat   ; ~
E1CE   4C 0F FF               JMP   CONEOL   ; }
E1D1   4C 0C FF     PCLS:     JMP   CONCLS   
E1D4   C9 E6        PE1:      CMP   #0E6h   
E1D6   B0 0E                  BCS   pvar   
E1D8   4C 12 FF     PCUR:     JMP   CONCUR   ; `  hide: the carry is clear
E1DB                          ENDIF      
E1DB                             ; /~: the column is NOS, the row the cell under it.
E1DB                PAT:         
E1DB                          IF   CHECKED   
                              CPX   #DSE-2   ; fewer than two cells under TOS: s
                              BCS   e_atu   
E1DB                          ENDIF      
E1DB                          IF   1-ANSI   
E1DB   BC 00 02               LDY   DSL,X   ; the column
E1DE   BD 01 02               LDA   DSL+1,X   ; the row
E1E1   E8                     INX      
E1E2   E8                     INX      
E1E3   4C 15 FF               JMP   CONAT   
E1E6                          ENDIF      
E1E6                          IF   ANSI   
                                 ; ESC [ row+1 ; col+1 H (ANSI counts from 1). The row's cell and TOS change
                                 ; places first: then "#" prints the row and drops it, prints the column and
                                 ; drops it, and TOS is the string's address again.
                              INX      
                              JSR   h_swap   
                              DEX      
                              LDY   #M_CSI-MSG   
                              JSR   prs   ; ESC [
                              JSR   inctos   
                              JSR   h_num   ; the row + 1
                              LDA   #";"   
                              JSR   CONOUT   
                              JSR   inctos   
                              JSR   h_num   ; the column + 1
                              LDA   #"H"   
                              JMP   CONOUT   
E1E6                          ENDIF      
E1E6                          IF   CHECKED   
                    E_ATU:    JMP   e_stack   ; (X is FAh-FCh: an underflow)
E1E6                          ENDIF      
E1E6                             ; a-z: the carry is set. A + 3Ah is the letter - 41h, as step hands it to
E1E6                             ; lower: that pushes the variable"s address, "@" fetches it, and "#' (next)
E1E6                             ; prints it and drops it: TOS is the string's address again.
E1E6   69 39        PVAR:     ADC   #39h   
E1E8   20 F8 E0               JSR   lower   
E1EB   20 16 E4               JSR   h_fetch   
E1EE                             ; "#" prints TOS as a signed decimal number, with no space after it. The
E1EE                             ; digits are divided off and held on the hardware stack, ended by a 0.
E1EE   A5 03        H_NUM:    LDA   TH   
E1F0   10 08                  BPL   pn1   
E1F2   A9 2D                  LDA   #"-"   
E1F4   20 03 FF               JSR   CONOUT   
E1F7   20 2E E3               JSR   neg   
E1FA   A9 0A        PN1:      LDA   #10   
E1FC   85 08                  STA   D0   
E1FE   A9 00                  LDA   #0   
E200   85 09                  STA   D1   
E202   48                     PHA      ; the end marker
E203   20 DE E3     PN2:      JSR   udiv   
E206   A5 04                  LDA   T0   ; the remainder
E208   09 30                  ORA   #"0"   
E20A   48                     PHA      
E20B   A5 02                  LDA   TL   
E20D   05 03                  ORA   TH   
E20F   D0 F2                  BNE   pn2   
E211   68           PN3:      PLA      
E212   F0 A1                  BEQ   pdrop   
E214   20 03 FF               JSR   CONOUT   
E217   4C 11 E2               JMP   pn3   
E21A                          IF   ANSI   
                                 ; With ANSI = 1 they are sequences, each a message at MSG, printed by prs,
                                 ; which pesc runs on into. (It sits here, just above prs, for that.)
                    PESC:     SBC   #7Ah   ; (the carry is clear: - 7Bh). Y is 0, as
                                 ;   tosget leaves it, and M_CLS is the first
                                 ;   message: Y already points at it
                              BCC   pe1   
                              BEQ   prs   ; {  ESC [ H ESC [ J
                              LDY   #M_SHOW-MSG   
                              LSR      ; | 0, } 1, ~ 1; the carry set for ~
                              BEQ   prs   ; |  ESC [ ? 2 5 h
                              BCS   pat   ; ~
                              LDY   #M_EOL-MSG   ; }  ESC [ K
                              BNE   prs   ; always
                    PE1:      CMP   #0E6h   
                              BCS   pvar   
                              LDY   #M_HIDE-MSG   ; `  ESC [ ? 2 5 l, and on into prs
E21A                          ENDIF      
E21A                          IF   CHECKED+ANSI   
                                 ; prs: print the message at MSG+Y; its last byte has bit 7 set. Y ends just
                                 ; past it, at the next message.
                    PRS:      LDA   MSG,Y   
                              PHA      
                              AND   #7Fh   
                              JSR   CONOUT   
                              INY      
                              PLA      
                              BPL   prs   
                              RTS      
                    MSG:         
E21A                          ENDIF      
E21A                          IF   ANSI   
                    M_CLS:    DB   27,"[","H",27,"[","J"+80h   ; (the first: pesc counts on it)
                    M_SHOW:   DB   27,"[","?","2","5","h"+80h   
                    M_HIDE:   DB   27,"[","?","2","5","l"+80h   
                    M_EOL:    DB   27,"[","K"+80h   
                    M_CSI:    DB   27,"["+80h   
E21A                          ENDIF      
E21A                          IF   CHECKED   
                    M_ERR:    DB   13,10,"Err"," "+80h   
                              DB   " @"," "+80h   
                    M_NL:     DB   13,10+80h   
                    M_STK:    DB   13,10,"D",":"+80h   
                    M_CD:     DB   ": ..","."+80h   
                    M_C:      DB   ":"+80h   
                    M_RTN:    DB   13,10,"R",":"+80h   
E21A                          ENDIF      
E21A                             ; =============================================================================
E21A                             ;  Dispatch table: one handler per punctuation character, in code order.
E21A                             ;  Entries are handler-1 for the RTS trick.
E21A                             ; =============================================================================
E21A   C2 E2        PTAB:     DW   h_store-1   ; !
E21C   7A E1                  DW   h_str-1   ; "
E21E   ED E1                  DW   h_num-1   ; #
E220   91 E1                  DW   h_print-1   ; $
E222   87 E3                  DW   h_swap-1   ; %
E224   DD E2                  DW   h_and-1   ; &
E226   AF E1                  DW   h_emit-1   ; '
E228   16 E1                  DW   h_open-1   ; (
E22A   4D E0                  DW   h_close-1   ; )
E22C   60 E3                  DW   h_mul-1   ; *
E22E   0F E3                  DW   h_add-1   ; +
E230   21 E4                  DW   h_cfetch-1   ; ,
E232   07 E3                  DW   h_sub-1   ; -
E234   C9 E2                  DW   h_cstore-1   ; .
E236   9C E3                  DW   h_div-1   ; /
E238   0A E1                  DW   push-1   ; :
E23A   D1 E2                  DW   drop-1   ; ;
E23C   3E E3                  DW   h_lt-1   ; <
E23E   50 E3                  DW   h_eq-1   ; =
E240   3B E3                  DW   h_gt-1   ; >
E242   2A E4                  DW   h_key-1   ; ?
E244   15 E4                  DW   h_fetch-1   ; @
E246   32 E1                  DW   h_def-1   ; [
E248   64 E0                  DW   h_break-1   ; \
E24A   53 E0                  DW   h_ret-1   ; ]
E24C   F9 E2                  DW   h_xor-1   ; ^
E24E   C6 E3                  DW   h_alloc-1   ; _
E250   88 E4                  DW   h_grave-1   ; `
E252   33 E0                  DW   h_tor-1   ; {
E254   EB E2                  DW   h_or-1   ; |
E256   40 E0                  DW   h_fromr-1   ; }
E258   27 E3                  DW   h_not-1   ; ~
E25A                             ; rdnum: TOS = TOS*10 + digit for each digit at IP. Wraps at 16 bits. The
E25A                             ; test is at the bottom so the loop closes with a branch. Returns with the
E25A                             ; carry set.
E25A   20 A8 E2     RD1:      JSR   incip   ; (keeps A = the digit)
E25D   06 02                  ASL   TL   
E25F   26 03                  ROL   TH   ; x2
E261   18                     CLC      
E262   65 02                  ADC   TL   
E264   85 04                  STA   T0   
E266   A5 03                  LDA   TH   
E268   69 00                  ADC   #0   
E26A   A8                     TAY      ; Y:T0 = x2 + digit
E26B   06 02                  ASL   TL   
E26D   26 03                  ROL   TH   
E26F   06 02                  ASL   TL   
E271   26 03                  ROL   TH   ; x8
E273   18                     CLC      
E274   A5 02                  LDA   TL   
E276   65 04                  ADC   T0   
E278   85 02                  STA   TL   
E27A   98                     TYA      
E27B   65 03                  ADC   TH   
E27D   85 03                  STA   TH   ; x8 + x2 + digit
E27F   20 85 E2     RDNUM:    JSR   isdig   
E282   90 D6                  BCC   rd1   
E284   60                     RTS      
E285                             ; isdig: A = the character at IP minus "0"; the carry is clear if it is a
E285                             ; digit. Y = 0.
E285   20 A0 E2     ISDIG:    JSR   peek   
E288   38                     SEC      
E289   E9 30                  SBC   #"0"   
E28B   C9 0A                  CMP   #10   
E28D   60                     RTS      
E28E                             ; =============================================================================
E28E                             ;  Reading the program
E28E                             ;    peek: A = the character at IP, IP unchanged, Y = 0
E28E                             ;    getc: the same, then IP moves on; flags follow A
E28E                             ;    incip: IP moves on; keeps A, the carry and Y
E28E                             ; =============================================================================
E28E                             ; rdhex: if IP is at a hex digit (0-9, A-F, a-f), return its value in A with
E28E                             ; the carry clear and IP moved on; otherwise the carry is set and IP stays.
E28E                             ; Y = 0.
E28E   20 85 E2     RDHEX:    JSR   isdig   
E291   90 0A                  BCC   rh1   
E293   29 DF                  AND   #0DFh   
E295   E9 11                  SBC   #11h   ; (the carry is set)
E297   C9 06                  CMP   #6   
E299   B0 04                  BCS   rh9   
E29B   69 0A                  ADC   #10   
E29D   90 09        RH1:      BCC   incip   ; always: the carry is clear
E29F   60           RH9:      RTS      
E2A0   A0 00        PEEK:     LDY   #0   
E2A2   B1 00                  LDA   (IP),Y   
E2A4   60                     RTS      
E2A5   20 A0 E2     GETC:     JSR   peek   
E2A8   E6 00        INCIP:    INC   IP   
E2AA   D0 02                  BNE   ic1   
E2AC   E6 01                  INC   IP+1   
E2AE   09 00        IC1:      ORA   #0   
E2B0   60                     RTS      
E2B1                             ; rstip: point IP at the start of the program
E2B1   A9 00        RSTIP:    LDA   #<PROG   
E2B3   85 00                  STA   IP   
E2B5   A9 05                  LDA   #>PROG   
E2B7   85 01                  STA   IP+1   
E2B9   60                     RTS      
E2BA                             ; =============================================================================
E2BA                             ;  Stack
E2BA                             ; =============================================================================
E2BA                             ; flag: pops TOS and returns with Z set if it was 0. Keeps the carry.
E2BA   A5 02        FLAG:     LDA   TL   
E2BC   05 03                  ORA   TH   
E2BE   20 D2 E2               JSR   drop   
E2C1   A8                     TAY      ; (drop's INX changed the flags)
E2C2   60                     RTS      
E2C3                             ; "!" ( n addr -- ) is "." plus the high byte. Both end in drop.
E2C3                H_STORE:      
E2C3                          IF   CHECKED   
                              LDA   TL   ; both bytes must be in the program's space:
                              ADC   #1   ; check the page of addr+1 (the carry is
                              LDA   TH   ; clear on the way in)
                              ADC   #0   
                              JSR   chkst   
E2C3                          ENDIF      
E2C3   BD 00 03               LDA   DSH,X   
E2C6   A0 01                  LDY   #1   
E2C8   91 02                  STA   (TL),Y   
E2CA                H_CSTORE:      ; "." ( c addr -- )
E2CA                          IF   CHECKED   
                              LDA   TH   
                              JSR   chkst   
E2CA                          ENDIF      
E2CA   BD 00 02               LDA   DSL,X   
E2CD   A0 00                  LDY   #0   
E2CF   91 02                  STA   (TL),Y   
E2D1   E8                     INX      ; falls into drop
E2D2                             ; drop: ";" and every drop. It works through Y, so A and the carry are kept;
E2D2                             ; it returns with Z clear.
E2D2   BC 00 02     DROP:     LDY   DSL,X   
E2D5   84 02                  STY   TL   
E2D7   BC 00 03               LDY   DSH,X   
E2DA   84 03                  STY   TH   
E2DC   E8                     INX      
E2DD   60                     RTS      
E2DE                             ; =============================================================================
E2DE                             ;  Arithmetic and logic. Effects are ( NOS TOS -- result ).
E2DE                             ; =============================================================================
E2DE                             ; The logic operators leave the carry as they found it, clear, so they can
E2DE                             ; branch to fin.
E2DE   BD 00 02     H_AND:    LDA   DSL,X   
E2E1   25 02                  AND   TL   
E2E3   85 02                  STA   TL   
E2E5   BD 00 03               LDA   DSH,X   
E2E8   25 03                  AND   TH   
E2EA   90 31                  BCC   fin   ; always
E2EC   BD 00 02     H_OR:     LDA   DSL,X   
E2EF   05 02                  ORA   TL   
E2F1   85 02                  STA   TL   
E2F3   BD 00 03               LDA   DSH,X   
E2F6   05 03                  ORA   TH   
E2F8   90 23                  BCC   fin   ; always
E2FA   BD 00 02     H_XOR:    LDA   DSL,X   
E2FD   45 02                  EOR   TL   
E2FF   85 02                  STA   TL   
E301   BD 00 03               LDA   DSH,X   
E304   45 03                  EOR   TH   
E306   90 15                  BCC   fin   ; always
E308                             ; "-" has two jobs: directly before a digit it starts a negative number.
E308   20 85 E2     H_SUB:    JSR   isdig   
E30B   90 14                  BCC   negnum   
E30D   20 2E E3     SUB1:     JSR   neg   ; a - b = a + (-b)
E310   18           H_ADD:    CLC      
E311   BD 00 02               LDA   DSL,X   
E314   65 02                  ADC   TL   
E316   85 02                  STA   TL   
E318   BD 00 03               LDA   DSH,X   
E31B   65 03                  ADC   TH   ; falls into fin
E31D                             ; fin: finish a two-operand op: A = the high byte of the result
E31D   85 03        FIN:      STA   TH   
E31F   E8                     INX      
E320   60                     RTS      
E321   A9 00        NEGNUM:   LDA   #0   ; a number from 0 (the digit routine's start)
E323   20 F0 E0               JSR   digit   ; (comes back with the carry set)
E326   B0 06                  BCS   neg   ; always: the number, negated
E328                             ; "~": -x - 1, which is neg with the carry clear, as it is here
E328   90 05        H_NOT:    BCC   neg1   ; always
E32A                             ; absv: TOS = |TOS|.  negm: TOS = -TOS if the N flag is set.
E32A   A5 03        ABSV:     LDA   TH   
E32C   10 0D        NEGM:     BPL   ab9   
E32E                             ; neg: TOS = -TOS
E32E   38           NEG:      SEC      
E32F   A9 00        NEG1:     LDA   #0   
E331   E5 02                  SBC   TL   
E333   85 02                  STA   TL   
E335   A9 00                  LDA   #0   
E337   E5 03                  SBC   TH   
E339   85 03                  STA   TH   
E33B   60           AB9:      RTS      
E33C                             ; Signed compares: a - b sets N and V; N xor V is "a < b". The carry ends up
E33C                             ; clear for true, and bool turns it into -1 (true) or 0 (both pop NOS first).
E33C   20 88 E3     H_GT:     JSR   h_swap   ; a > b is b < a
E33F   BD 00 02     H_LT:     LDA   DSL,X   
E342   C5 02                  CMP   TL   
E344   BD 00 03               LDA   DSH,X   
E347   E5 03                  SBC   TH   
E349   70 02                  BVS   lt1   
E34B   49 80                  EOR   #80h   
E34D   0A           LT1:      ASL      
E34E   E8                     INX      ; (keeps the carry; never leaves X at 0)
E34F   D0 07                  BNE   bool   ; always
E351   20 0D E3     H_EQ:     JSR   sub1   ; a - b: zero if equal; A = its high byte
E354   05 02                  ORA   TL   
E356   C9 01                  CMP   #1   ; carry clear if A = 0
E358   A9 00        BOOL:     LDA   #0   
E35A   69 FF                  ADC   #0FFh   ; carry clear: FF, set: 00
E35C   85 02                  STA   TL   
E35E   85 03                  STA   TH   
E360   60                     RTS      
E361                             ; "*": the classic shift-right multiply. The multiplier leaves TH:TL from the
E361                             ; bottom while the product comes in at the top, through A:T0 above it; after
E361                             ; 16 rounds TH:TL hold the low 16 bits, which are all that is kept.
E361                          IF   FAST   
                                 ; (the fast build: as QK below, the rounds unrolled, with Y for the upper
                                 ; half's high byte while the low one is added)
                    H_MUL:    LDA   TH   
                              BEQ   mq8   
                              LDA   DSH,X   
                              BEQ   mqs   
                              JMP   mq16   ; (out of a branch's reach)
                    MQS:      JSR   h_swap   
                    MQ8:      LDA   #0   
                              STA   T0   
                              LSR   TL   
                              BCC   mu0   
                              TAY      
                              CLC      
                              LDA   T0   
                              ADC   DSL,X   
                              STA   T0   
                              TYA      
                              ADC   DSH,X   
                    MU0:      ROR      
                              ROR   T0   
                              ROR   TL   
                              BCC   mu1   
                              TAY      
                              CLC      
                              LDA   T0   
                              ADC   DSL,X   
                              STA   T0   
                              TYA      
                              ADC   DSH,X   
                    MU1:      ROR      
                              ROR   T0   
                              ROR   TL   
                              BCC   mu2   
                              TAY      
                              CLC      
                              LDA   T0   
                              ADC   DSL,X   
                              STA   T0   
                              TYA      
                              ADC   DSH,X   
                    MU2:      ROR      
                              ROR   T0   
                              ROR   TL   
                              BCC   mu3   
                              TAY      
                              CLC      
                              LDA   T0   
                              ADC   DSL,X   
                              STA   T0   
                              TYA      
                              ADC   DSH,X   
                    MU3:      ROR      
                              ROR   T0   
                              ROR   TL   
                              BCC   mu4   
                              TAY      
                              CLC      
                              LDA   T0   
                              ADC   DSL,X   
                              STA   T0   
                              TYA      
                              ADC   DSH,X   
                    MU4:      ROR      
                              ROR   T0   
                              ROR   TL   
                              BCC   mu5   
                              TAY      
                              CLC      
                              LDA   T0   
                              ADC   DSL,X   
                              STA   T0   
                              TYA      
                              ADC   DSH,X   
                    MU5:      ROR      
                              ROR   T0   
                              ROR   TL   
                              BCC   mu6   
                              TAY      
                              CLC      
                              LDA   T0   
                              ADC   DSL,X   
                              STA   T0   
                              TYA      
                              ADC   DSH,X   
                    MU6:      ROR      
                              ROR   T0   
                              ROR   TL   
                              BCC   mu7   
                              TAY      
                              CLC      
                              LDA   T0   
                              ADC   DSL,X   
                              STA   T0   
                              TYA      
                              ADC   DSH,X   
                    MU7:      ROR      
                              ROR   T0   
                              ROR   TL   
                              LDA   T0   
                              STA   TH   
                              INX      
                              RTS      
                    MQ16:     LDA   #0   
                              STA   T0   
                              LSR   TH   
                              ROR   TL   
                              BCC   mw0   
                              TAY      
                              CLC      
                              LDA   T0   
                              ADC   DSL,X   
