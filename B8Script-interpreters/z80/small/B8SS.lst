0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Spec: docs/b8script.md (2026-11-24).
0000                             ; 
0000                             ;  The switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    EDITOR   1 = with the line editor built in (see the end of this file):
0000                             ;                 the spec's suggested standard. It goes with either setting
0000                             ;                 of the other two.
0000                             ;    CHECKED  0 = no checks (spec: the programmer is responsible)
0000                             ;             1 = starts with every variable at 0 and every word undefined,
0000                             ;                 and stops on every error in the spec's table (and Ctrl-C)
0000                             ;                 with a three-line report: the letter and the place as line
0000                             ;                 and column, and both stacks. See `error`.
0000                             ;    SPEED    0 = small: the smallest build
0000                             ;             1 = base, the default: the speed-ups that cost bytes: a skip
0000                             ;                 cache, a faster skip, "*" and "/" quicker for small and
0000                             ;                 power-of-two operands, and more (see "Speed-ups")
0000                             ;             2 = fast: base and a dispatch table besides, with no size
0000                             ;                 limit (see "The fast build"). Not with EDITOR.
0000                             ;    ANSI     what the console escapes of "$" (/00bbIC8= /| /` /~) do:
0000                             ;             1 = send ANSI (VT100) sequences through CONOUT
0000                             ;             0 = call the machine's own routines CONCLS, CONEOL, CONCUR and
0000                             ;                 CONAT (see the equates). The CP/M builds always send ANSI.
0000                             ; 
0000                             ;  In every build Ctrl-C stops a running program (an unchecked build stops
0000                             ;  without a word): see the console layer for the rules, the held key and
0000                             ;  the break-off cell.
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   1   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   1   ; 1 = checked build
0000                EDITOR:   EQU   0   ; 1 = with the line editor
0000                ANSI:     EQU   0   ; 1 = the console escapes send ANSI sequences
0000                SPEED:    EQU   0   ; 0 = small, 1 = base, 2 = fast (not with EDITOR) (see "Speed-ups")
0000                FAST:     EQU   SPEED/2   ; (1: the fast build)
0000                SBASE:    EQU   SPEED-FAST*2   ; (1: the base build)
0000                ANS:      EQU   ANSI+CPM-ANSI*CPM   ; (CP/M: always ANSI)
0000                EDGEN:    EQU   EDITOR*(1-CPM)   ; (the generic build with the editor)
0000                             ; (IF takes any value but 0 as true, so
0000                             ;  IF CHECKED+EDITOR means "either")
0000                TABP0:    EQU   EDGEN*(1-CHECKED)   ; (the build with its table in page zero)
0000                PTLATE:   EQU   1-(1-CPM)*(1-EDITOR)*(1-CHECKED)*(1-ANS)   ; (1: the table goes after psgn and pdec,
0000                             ;   not before them: wherever it doesn't cross a
0000                             ;   page. chktab.py says if it does)
0000                QK:       EQU   SBASE+FAST-SBASE*FAST   ; (the speed-ups: base, or the fast build)
0000                SBASEU:   EQU   QK*(1-CHECKED)*(1-FAST)   ; (and those that only the unchecked
0000                             ;  builds take; the fast build has its own)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    IY   return-stack pointer. Entries are 2 bytes; the stack grows down.
0000                             ;         Only rpop and rpushn (and the checks) touch it. The alternate
0000                             ;         registers are not used at all: an interrupt routine may use them.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  One-byte calls. In a generic build the routines used most are reached
0000                             ;  with RST, one byte instead of three. The source writes them as macros:
0000                             ; 
0000                             ;    POPR   RST 08h  rpop    pop the return stack into DE
0000                             ;    DROP   RST 18h  drp     drop TOS, then next character  (ends a handler)
0000                             ;    NEGH   RST 20h  neg16   HL = -HL
0000                             ;    PUTA   RST 28h  putc    print A
0000                             ;    NEXT   RST 30h  next0   next character                 (ends a handler)
0000                             ; 
0000                             ;  RST 18h and RST 30h never return: an RST is a CALL, so the first thing
0000                             ;  each of them does is POP DE to throw the return address away.
0000                             ; 
0000                             ;  A CP/M build leaves page zero alone: there the macros are CALLs, and
0000                             ;  DROP and NEXT are jumps (DROPR and NEXTR: JR, where it reaches).
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (the top four bytes of the page are spare,
0000                             ;             so a full stack runs two bytes into the page below)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch, interpreter variables in the gaps, and the -n? line buffer
0000                             ;             at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack has a guard band: the data stack can
0000                             ;  overrun by a cell or two (and the calls made while it is full, the error
0000                             ;  report's included) into the top 32 bytes of the return-stack page, which
0000                             ;  are never used, and the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
0000                BDOS:     EQU   0005h   
0000                BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IF   CPM*(1-EDITOR)   
0000                EXIT:     EQU   0000h   ; warm boot
0000                          ENDIF      
0000                          IFN   CPM   
                                 ; ---- generic machine: edit these to suit -----------------------------------
                    KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
                                 ;   waiting. The zero flag must match A
                                 ;   (end the routine with OR A / RET).
                    CONOUT:   EQU   0FF03h   ; print the character in A
                                 ;   KEY and CONOUT must preserve BC, DE, HL and IY.
0000                          ENDIF      
0000                          IF   1-ANS   
                                 ; With ANSI = 0 the console escapes call these. All four must keep BC and
                                 ; IY, and all but CONAT also HL. They may change A, DE and the flags.
                    CONCLS:   EQU   0FF0Ch   ; /{  clear the screen, the cursor to the top left
                    CONEOL:   EQU   0FF0Fh   ; /}  clear from the cursor to the end of the line
                    CONCUR:   EQU   0FF12h   ; /| and /`  show the cursor if A is not 0, hide
                                 ;     it if A = 0
                    CONAT:    EQU   0FF15h   ; /~  the cursor to row HL, column DE, both
                                 ;     counted from 0. May change A, DE and HL
0000                          ENDIF      
0000                          IFN   CPM   
                    RSPAGE:   EQU   80h   ; 8000h return stack
                    DSPAGE:   EQU   81h   ; 8100h data stack
                    LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
                    PROG:     EQU   8300h   ; where the loader puts the program text
                    HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
                    CPAGE:    EQU   HEAPLIM   ; the skip cache's page (QK builds): the page
                                 ;   at the heap limit, which the heap never reaches
                    BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)   
                    EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                          ENDIF      
0000                          IF   EDGEN   
                    LEAVE:    EQU   0FF09h   ; where the editor's ^X goes
0000                          ENDIF      
0000                          IF   EDITOR*CPM   
                    LEAVE:    EQU   0000h   ; the editor's ^X: warm boot
0000                          ENDIF      
0000                          IF   EDITOR   
                    EXIT:     EQU   edend   ; a program that ends goes back to the editor,
                    SKEND:    EQU   skend   ;   also when it ends inside skip
0000                          ENDIF      
0000                          IF   1-EDITOR   
0000                SKEND:    EQU   EXIT   
0000                          ENDIF      
0000                MSLOOP:   EQU   40-36*CPM   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine. (The wait
0000                             ; for a second Ctrl-C uses it too: 250 ms.)
0000                             ; CP/M: 4, for a BDOS 6 call of about 280 us
0000                             ; (an RC2014 with RomWBW and ZPM3). A .COM can
0000                             ; be patched: see TIMING.B8S.
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                             ;   around machine code (and in the checked
0000                             ;   build the address "$" prints from);
0000                PCNT:     EQU   LET+36h   ;   the break-key poll count (see rpushn);
0000                SKPL:     EQU   LET+3Ch   ;   the checked skip's starting place;
0000                NPEND:    EQU   LET+38h   ;   minus the address of the program's end
0000                             ;   (the heap"s first byte), for the checked "_';
0000                EDLN:     EQU   LET+3Ah   ;   the editor: the number of the line that ^E
0000                             ;   put in the input line (0: none)
0000                KEYBUF:   EQU   LET+7Ah   ; gap after z: a key read by the break check and
0000                             ;   held for the next "?" (0: none);
0000                BRKOFF:   EQU   LET+7Bh   ;   the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FCh   ; empty data stack. The four bytes above it
0000                             ; are spare: a character can pop two cells
0000                             ; too many before the checked build sees it,
0000                             ; and the next call must not land on the
0000                             ; letter cells.
0000                             ; The five one-byte calls. A generic build owns page zero and reaches them
0000                             ; with RST. A CP/M build must leave page zero alone (CP/M keeps it for
0000                             ; interrupts, and RomWBW's BIOS calls itself through RST 08h), so there each
0000                             ; is a CALL, or a jump for the two that never return: DROP is a JP, and
0000                             ; NEXT is JP (IX), two bytes, with IX holding next0's address throughout.
0000                             ; (asm80 can't nest IF, so these are written with DS: a count of 0 writes
0000                             ; nothing. DS can't take a label that comes later, but EQU can, and DS can
0000                             ; take that.)
0000                AROP:     EQU   rpop   
0000                ANEG:     EQU   neg16   
0000                APUT:     EQU   putc   
0000                APTK:     EQU   putk   
0000                          IF   1-CPM   
                    PUTK:     EQU   putc   ; (CP/M only: here it is never used)
0000                          ENDIF      
0000                ANXT:     EQU   next0   
0000                          IF   CHECKED   
0000                ACHK:     EQU   chkstk   ; (for the fast build's dispatcher)
0000                          ENDIF      
0000                          IF   1-CHECKED   
                    ACHK:     EQU   0   
0000                          ENDIF      
0000                          IF   FAST   
                    DTPG:     EQU   DTAB/256   ; (the fast build"s table"s first page)
0000                          ENDIF      
0000                          IF   1-FAST   
0000                DTPG:     EQU   0   
0000                          ENDIF      
0000                .macro POPR,
0000                             ; 
0000                 DS      1-CPM,0CFh      ;   RST 08h
0000                 DS      CPM,0CDh        ;   CALL rpop
0000                 DS      CPM,AROP&0FFh
0000                 DS      CPM,AROP/256
0000                .endm
0000                 
0000                .macro DROP,
0000                             ; 
0000                 DS      (1-CPM)*(1-FAST),0DFh ; RST 18h
0000                 DS      CPM+FAST-CPM*FAST,0E1h ; POP HL
0000                 DS      CPM+FAST-CPM*FAST,0DDh ; JP (IX)
0000                 DS      CPM+FAST-CPM*FAST,0E9h
0000                .endm
0000                 
0000                .macro NEGH,
0000                             ; 
0000                 DS      1-CPM,0E7h      ;   RST 20h
0000                 DS      CPM,0CDh        ;   CALL neg16
0000                 DS      CPM,ANEG&0FFh
0000                 DS      CPM,ANEG/256
0000                .endm
0000                 
0000                .macro PUTA,
0000                             ; 
0000                 DS      1-CPM,0EFh      ;   RST 28h
0000                 DS      CPM,0CDh        ;   CALL putc
0000                 DS      CPM,APUT&0FFh
0000                 DS      CPM,APUT/256
0000                .endm
0000                 
0000                .macro PUTK,
0000                             ; 
0000                 DS      1-CPM,3Eh       ;   LD A,%%1 / RST 28h
0000                 DS      1-CPM,%%1
0000                 DS      1-CPM,0EFh
0000                 DS      CPM,0CDh        ;   CALL putk / DB %%1
0000                 DS      CPM,APTK&0FFh
0000                 DS      CPM,APTK/256
0000                 DS      CPM,%%1
0000                .endm
0000                 
0000                .macro PUTAR,
0000                             ; 
0000                 DS      1-CPM,0EFh      ;   RST 28h
0000                 DS      1-CPM,0C9h      ;   RET
0000                 DS      CPM,0C3h        ;   JP putc
0000                 DS      CPM,APUT&0FFh
0000                 DS      CPM,APUT/256
0000                .endm
0000                 
0000                .macro NEXT,
0000                             ; 
0000                 DS      (1-CPM)*(1-FAST),0F7h ; RST 30h
0000                 DS      CPM+FAST-CPM*FAST,0DDh ; JP (IX): IX holds next0
0000                 DS      CPM+FAST-CPM*FAST,0E9h
0000                .endm
0000                 
0000                .macro NEXTF,
0000                             ; 
0000                 DS      FAST*CHECKED,0CDh ;   (fast build: CALL chkstk, checked)
0000                 DS      FAST*CHECKED,ACHK&0FFh
0000                 DS      FAST*CHECKED,ACHK/256
0000                 DS      FAST,0Ah        ;   (fast build: the dispatcher: LD A,(BC)
0000                 DS      FAST,03h        ;   INC BC
0000                 DS      FAST,0EBh       ;   EX DE,HL
0000                 DS      FAST,6Fh        ;   LD L,A
0000                 DS      FAST,26h        ;   LD H,DTAB/256
0000                 DS      FAST,DTPG
0000                 DS      FAST,7Eh        ;   LD A,(HL)
0000                 DS      FAST,24h        ;   INC H
0000                 DS      FAST,66h        ;   LD H,(HL)
0000                 DS      FAST,6Fh        ;   LD L,A
0000                 DS      FAST,0E9h       ;   JP (HL))
0000                .endm
0000                 
0000                .macro NEXTZ,
0000                             ; 
0000                 DS      1-CPM,0F7h      ;   byte there in every build (RST 30h)
0000                 DS      CPM,0DDh        ; JP (IX)
0000                 DS      CPM,0E9h
0000                .endm
0000                 
0000                .macro SETIX,
0000                             ; 
0000                 DS      CPM+FAST-CPM*FAST,0DDh ; a generic build): LD IX,next0
0000                 DS      CPM+FAST-CPM*FAST,21h
0000                 DS      CPM+FAST-CPM*FAST,ANXT&0FFh
0000                 DS      CPM+FAST-CPM*FAST,ANXT/256
0000                .endm
0000                 
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is just the start of the .COM file.
0000                             ; =============================================================================
0100                          .ORG   BASE   
0100                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              XOR   A   ; 00  reset. (This byte, AFh, is also what an
0100                          ENDIF      ;     undefined word runs into: see e_hi.)
0100                          IF   1-EDGEN   
0100   31 FC 08               LD   SP,DSTOP   ; 00  reset, or the start of the .COM file
0103                          ENDIF      
0103                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)*(1-QK)   
                              LD   BC,PROG   ; 03  the IP
                              JR   st0   ; 06  (the rest of the startup is close by)
0103                          ENDIF      
0103                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)*QK   
                              JP   qstart   ; 03  (the skip cache is emptied first)
                              DW   0   ; 06  spare
0103                          ENDIF      
0103                          IF   (1-CPM)*(1-EDITOR)*CHECKED*(1-QK)   
                              JR   init   ; 04  (the rest of the startup is close by)
                              DW   0   ; 06  spare
0103                          ENDIF      
0103                          IF   (1-CPM)*(1-EDITOR)*CHECKED*QK   
                              JP   qinit   ; 04  (the skip cache is emptied first)
                              DB   0   ; 07  spare
0103                          ENDIF      
0103                          IF   EDGEN   
                              XOR   A   ; 00  reset: no program yet. (This byte, AFh,
                              LD   (PROG),A   ;     is also what an undefined word runs
                              JP   init   ; 04  into in the checked build: see e_hi.)
                              NOP      ; 07  spare
0103                          ENDIF      
0103                          IF   CPM*(1-EDITOR)   
0103   C3 50 06               JP   start   ; 03
0106                          ENDIF      
0106                          IF   CPM*EDITOR*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
                                 ; is held back.
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
0106                          ENDIF      
0106                          IF   CPM*EDITOR   
                              CALL   load   ; the file named on the command line
                              JP   edit0   
0106                          ENDIF      
0106                          IF   1-CPM   
                                 ; ---- RST 08h: rpop: pop the return stack into DE ---------------------------
                    RPOP:     LD   E,(IY+0)   ; 08
                              LD   D,(IY+1)   
                              JR   rp2   ; (the rest is at 2Bh)
                                 ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
                    CTL:      ADD   A,21h   ; 10  back to c; zero only for NUL
                              JR   NZ,next0   ;     the rest are ignored
                    ENDPROG:   JP   EXIT   ;     the program has ended
                              NOP      ; 17  spare
                                 ; ---- RST 18h: drop TOS, then next ------------------------------------------
                    RST18:    POP   DE   ; 18  discard the RST's return address
                    DRP:      POP   HL   ;     new TOS = NOS
                              JR   next0   
0106                          ENDIF      
0106   E5           H_FROMR:   PUSH   HL   ; 1C  "}" return stack to TOS
0107                          ;*Macro unroll:  POPR
0107                          DS   1-CPM,0CFh   
0107   CD                     DS   CPM,0CDh   
0108   E6                     DS   CPM,AROP&0FFh   
0109   04                     DS   CPM,AROP/256   
010A   EB                     EX   DE,HL   
010B                          ;*Macro unroll:  NEXTZ
010B                          DS   1-CPM,0F7h   
010B   DD                     DS   CPM,0DDh   
010C   E9                     DS   CPM,0E9h   
010D                          IF   1-CPM   
                                 ; ---- RST 20h: neg16: HL = -HL (keeps BC, DE) -------------------------------
                    NEG16:    XOR   A   ; 20
                              SUB   L   
                              LD   L,A   
                              SBC   A,A   
                              SUB   H   
                              LD   H,A   
                              RET      
                              NOP      ; 27  spare
                                 ; ---- RST 28h: putc: print A (keeps BC, DE, HL, IY) -------------------------
                    RST28:       
                    PUTC:     JP   CONOUT   ; 28
                    RP2:      INC   IY   ; 2B  the rest of rpop
                              INC   IY   
                              RET      
                                 ; ---- RST 30h: next character -----------------------------------------------
                    RST30:    POP   DE   ; 30  discard the RST's return address
010D                          ENDIF      
010D                          IF   CPM   
010D                             ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
010D   C6 21        CTL:      ADD   A,21h   ; back to c; zero only for NUL
010F   20 03                  JR   NZ,next0   ; the rest are ignored
0111   C3 00 00     ENDPROG:   JP   EXIT   ; the program has ended
0114                          ENDIF      
0114                             ; =============================================================================
0114                             ;  The inner loop: read one character and sort it by range.
0114                             ; 
0114                             ;    00h          end of program
0114                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0114                             ;    30h-39h      digit: read a whole number
0114                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0114                             ;    61h-7Ah      a-z: push the address of that letter's cell
0114                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0114                             ; =============================================================================
0114                          IF   FAST   
                              ;*Macro unroll: next0:  NEXTF                   ; (the fast build: the table dispatcher)
                    NEXT0:    DS   FAST*CHECKED,0CDh   ; (the fast build: the table dispatcher)
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
0114                          ENDIF      
0114                          IF   1-FAST   
0114                NEXT0:       
0114                          ENDIF      
0114                          IF   CHECKED*(1-FAST)   
0114   CD 28 05               CALL   chkstk   ; both stacks are checked once per character
0117                          ENDIF      
0117                          IF   1-FAST   
0117   0A                     LD   A,(BC)   
0118   03                     INC   BC   
0119   D6 21                  SUB   21h   ; A = c - 21h
011B   38 F0                  JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
011D   FE 0F                  CP   0Fh   
011F   38 25                  JR   C,punct   ; 21h-2Fh: PTAB index 0-14
0121   D6 0F                  SUB   0Fh   ; A = c - 30h
0123   FE 0A                  CP   0Ah   
0125   38 69                  JR   C,digit   ; 30h-39h
0127   FE 11                  CP   11h   
0129   38 19                  JR   C,p3a   ; 3Ah-40h
012B   D6 11                  SUB   11h   ; A = c - 41h
012D   FE 1A                  CP   1Ah   
012F   38 6D                  JR   C,upper   ; 41h-5Ah: A = letter index 0-25
0131   FE 20                  CP   20h   
0133   38 0D                  JR   C,p5b   ; 5Bh-60h
0135   FE 3A                  CP   3Ah   
0137   38 5E                  JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0139   FE 3E                  CP   3Eh   
013B                          ENDIF      
013B                          IF   (1-CHECKED)*(1-FAST)   
                              JR   NC,next0   ; 7Fh-FFh: ignored
013B                          ENDIF      
013B                          IF   CHECKED*(1-FAST)   
013B   28 D7                  JR   Z,next0   ; 7Fh, DEL: ignored
013D   D2 55 05               JP   NC,e_hi   ; 80h-FFh: reserved
0140                          ENDIF      
0140                          IF   1-FAST   
0140   D6 1A                  SUB   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
0142   D6 09        P5B:      SUB   9   ; 5Bh-60h: -4 in all, index 22-27
0144   C6 05        P3A:      ADD   A,5   ; 3Ah-40h: index 15-21
0146                          ENDIF      
0146                .macro PTABLE,
0146                             ; 
0146                 DB      h_store & 0FFh  ; !
0146                 DB      h_str & 0FFh    ; "
0146                 DB      h_num & 0FFh    ; #
0146                 DB      h_print & 0FFh  ; $
0146                 DB      h_swap & 0FFh   ; %
0146                 DB      h_and & 0FFh    ; &
0146                 DB      h_emit & 0FFh   ; '
0146                 DB      h_open & 0FFh   ; (
0146                 DB      h_close & 0FFh  ; )
0146                 DB      h_mul & 0FFh    ; *
0146                 DB      h_add & 0FFh    ; +
0146                 DB      h_cfetch & 0FFh ; ,
0146                 DB      h_sub & 0FFh    ; -
0146                 DB      h_cstore & 0FFh ; .
0146                 DB      h_div & 0FFh    ; /
0146                 DB      h_dup & 0FFh    ; :
0146                 DB      h_drop & 0FFh   ; ;
0146                 DB      h_lt & 0FFh     ; <
0146                 DB      h_eq & 0FFh     ; =
0146                 DB      h_gt & 0FFh     ; >
0146                 DB      h_key & 0FFh    ; ?
0146                 DB      h_fetch & 0FFh  ; @
0146                 DB      h_def & 0FFh    ; [
0146                 DB      h_break & 0FFh  ; \
0146                 DB      h_ret & 0FFh    ; ]
0146                 DB      h_xor & 0FFh    ; ^
0146                 DB      h_alloc & 0FFh  ; _
0146                 DB      h_grave & 0FFh  ; `
0146                 DB      h_tor & 0FFh    ; {
0146                 DB      h_or & 0FFh     ; |
0146                 DB      h_fromr & 0FFh  ; }
0146                 DB      h_not & 0FFh    ; ~
0146                .endm
0146                 
0146                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
0146                             ; untouched, and A, DE free.
0146                          IF   1-FAST   
0146   C6 88        PUNCT:    ADD   A,PTAB & 0FFh   ; PTAB never crosses a page
0148   5F                     LD   E,A   
0149   16 04                  LD   D,PTAB / 256   ; (0 if the table is in page zero)
014B   FE 9E                  CP   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
014D   1A                     LD   A,(DE)   
014E   5F                     LD   E,A   ; the handler's low byte
014F                          ENDIF      
014F                          IF   (1-CPM)*(1-TABP0)*(1-FAST)   
                              LD   D,0   
014F                          ENDIF      
014F                          IF   (1-CPM)*(1-FAST)   
                              RL   D   ; its page: 0 + carry
014F                          ENDIF      
014F                          IF   CPM*(1-FAST)   
014F   16 01                  LD   D,1   
0151   30 01                  JR   NC,pu1   
0153   14                     INC   D   ; its page: 1 + carry
0154                PU1:         
0154                          ENDIF      
0154                          IF   1-FAST   
0154   D5                     PUSH   DE   ; jump to it; the stack is balanced again
0155   C9                     RET      ;   when the handler starts
0156                          ENDIF      
0156                             ; The rest of the startup: here so that the generic reset code can reach it
0156                             ; with JR. st0: find the program's NUL; the heap starts after it.
0156                             ; (The editor build has its own copy of this, next to the editor.)
0156                             ; A checked build first clears the lower half of the letter page (A = 0):
0156                             ; every variable starts at 0, every word cell holds 0000h, the address an
0156                             ; undefined word is caught at (see e_hi), and no key is held back.
0156                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                    INIT:     LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
                              LD   BC,PROG   ; the IP
0156                          ENDIF      
0156                          IF   (1-CPM)*(1-EDITOR)   
                    ST0:      LD   H,B   
                              LD   L,C   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
0156                          ENDIF      
0156                          IF   1-EDITOR   
0156   22 7C 09     ST2:      LD   (HEAP),HL   
0159                          ENDIF      
0159                          IF   CHECKED*(1-EDITOR)   
0159                          ;*Macro unroll:  NEGH                    ; minus the heap's first address: '_' may not
0159                          DS   1-CPM,0E7h   ; minus the heap"s first address: "_' may not
0159   CD                     DS   CPM,0CDh   
015A   F1                     DS   CPM,ANEG&0FFh   
015B   04                     DS   CPM,ANEG/256   
015C   22 38 09               LD   (NPEND),HL   ;   release below it
015F                          ENDIF      
015F                          IF   (1-CHECKED)*(1-EDITOR)*(1-CPM)   
                              LD   H,A   ; (A = 0) no key is held, and the break key
                              LD   L,A   ;   is on (the checked build has cleared
015F                          ENDIF      ;   these)
015F                          IF   (1-CHECKED)*(1-EDITOR)*CPM   
                              LD   HL,0   
015F                          ENDIF      
015F                          IF   (1-CHECKED)*(1-EDITOR)   
                              LD   (KEYBUF),HL   
015F                          ENDIF      
015F                          IF   1-EDITOR   
015F                          ;*Macro unroll:  SETIX
015F   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0160   21                     DS   CPM+FAST-CPM*FAST,21h   
0161   14                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
0162   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
0163   FD 21 E0 07            LD   IY,RSTOP   ; the return stack is empty
0167                          ;*Macro unroll:  NEXT                    ; (its return address is thrown away)
0167                          DS   (1-CPM)*(1-FAST),0F7h   ; (its return address is thrown away)
0167   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0168   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0169                          ENDIF      
0169                             ; In the unchecked generic editor build the table is here, in the first
0169                             ; page, which saves loading D twice. (The other builds have no room for it
0169                             ; here: theirs is further down.)
0169                          IF   TABP0   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0169                          ENDIF      
0169                             ; =============================================================================
0169                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
0169                             ;  (00bbIGFuZCA= are up among the RST routines.) The machine-code call, exec,
0169                             ;  is here too: it belongs to "`" and makes the page come out right.
0169                             ; =============================================================================
0169   D1           H_XOR:    POP   DE   
016A   7C                     LD   A,H   
016B   AA                     XOR   D   
016C   67                     LD   H,A   
016D   7D                     LD   A,L   
016E   AB                     XOR   E   
016F   6F                     LD   L,A   
0170                          ;*Macro unroll:  NEXT
0170                          DS   (1-CPM)*(1-FAST),0F7h   
0170   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0171   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0172   D1           H_OR:     POP   DE   
0173   7C                     LD   A,H   
0174   B2                     OR   D   
0175   67                     LD   H,A   
0176   7D                     LD   A,L   
0177   B3                     OR   E   
0178   6F                     LD   L,A   
0179                          ;*Macro unroll:  NEXT
0179                          DS   (1-CPM)*(1-FAST),0F7h   
0179   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
017A   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
017B                          ;*Macro unroll: h_not:  NEGH                    ; ~x = -x - 1
017B                H_NOT:    DS   1-CPM,0E7h   ; ~x = -x - 1
017B   CD                     DS   CPM,0CDh   
017C   F1                     DS   CPM,ANEG&0FFh   
017D   04                     DS   CPM,ANEG/256   
017E   2B                     DEC   HL   
017F                          ;*Macro unroll:  NEXT
017F                          DS   (1-CPM)*(1-FAST),0F7h   
017F   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0180   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0181                             ; "_" ( n -- addr ): the heap pointer moves by n, a signed count (the add is
0181                             ; the same either way); TOS is the old pointer.
0181   ED 5B 7C 09  H_ALLOC:   LD   DE,(HEAP)   
0185                          IF   CHECKED*CPM   
0185   7C                     LD   A,H   ; the count's sign, for chkhp
0186                          ENDIF      
0186   19                     ADD   HL,DE   ; the new top
0187                          IF   CHECKED   
0187   CD 61 05               CALL   chkhp   
018A                          ENDIF      
018A   22 7C 09               LD   (HEAP),HL   
018D   EB                     EX   DE,HL   
018E                          ;*Macro unroll:  NEXT
018E                          DS   (1-CPM)*(1-FAST),0F7h   
018E   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
018F   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0190                          IF   1-CPM*CHECKED   
                    EXEC:     LD   (RSAVE),IY   ; machine code may change IX and IY
                              CALL   jphl   
                              LD   IY,(RSAVE)   
                              ;*Macro unroll:  SETIX
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,21h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
                              POP   HL   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
0190                          ENDIF      
0190                             ; ---- the letters and digits (here, in the middle, so that the inner loop's
0190                             ; ---- short jumps reach them, and the handlers after them reach rpushn) ------
0190                             ; Digits: step back onto the first digit and read the whole number.
0190   E5           DIGIT:    PUSH   HL   
0191   0B                     DEC   BC   
0192   CD F2 03               CALL   rdnum   
0195                          ;*Macro unroll:  NEXT
0195                          DS   (1-CPM)*(1-FAST),0F7h   
0195   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0196   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0197                             ; a-z: push the cell's address (the cell is the variable)
0197                             ;  (the unchecked builds with room do x@ and x! in one step: lowq)
0197                          IF   1-SBASEU   
0197   E5           LOWER:    PUSH   HL   
0198   87                     ADD   A,A   
0199   6F                     LD   L,A   
019A   26 09                  LD   H,LETPAGE   
019C                          ;*Macro unroll:  NEXT
019C                          DS   (1-CPM)*(1-FAST),0F7h   
019C   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
019D   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
019E                          ENDIF      
019E                          IF   SBASEU   
                    LOWER:    JP   lowq   
019E                          ENDIF      
019E                             ; A-Z: call the word. The return address (the IP after the letter) goes on
019E                             ; the return stack, and the IP becomes the address in the letter's cell.
019E   C5           UPPER:    PUSH   BC   ; the return address, for rpushn
019F   EB                     EX   DE,HL   ; park TOS
01A0   87                     ADD   A,A   
01A1   6F                     LD   L,A   
01A2   26 09                  LD   H,LETPAGE   ; HL -> cell
01A4   4E                     LD   C,(HL)   
01A5   2C                     INC   L   
01A6   46                     LD   B,(HL)   ; IP = the word's body
01A7   EB                     EX   DE,HL   ; TOS back, and fall into rpushn
01A8                             ; rpushn: move the top cell of the data stack (in memory) to the return
01A8                             ; stack, then next. Everything that pushes the return stack ends here.
01A8                             ; 
01A8                             ; The break key is looked at here, so at every word call and loop-back (and
01A8                             ; block entry and "{"), but only one time in 256: PCNT counts them.
01A8                             ; Reading the keyboard can be slow (it is a BDOS call under CP/M).
01A8   D1           RPUSHN:   POP   DE   
01A9   FD 72 FF               LD   (IY-1),D   
01AC   FD 73 FE               LD   (IY-2),E   
01AF   FD 2B                  DEC   IY   
01B1   FD 2B                  DEC   IY   
01B3   E5                     PUSH   HL   
01B4   21 36 09               LD   HL,PCNT   
01B7   35                     DEC   (HL)   
01B8   E1                     POP   HL   ; (the zero flag lasts)
01B9   CC A8 04               CALL   Z,pollk   
01BC                          ;*Macro unroll:  NEXT
01BC                          DS   (1-CPM)*(1-FAST),0F7h   
01BC   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
01BD   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
01BE                             ; "{" TOS to the return stack: the new TOS comes up, the old one goes across.
01BE   E3           H_TOR:    EX   (SP),HL   
01BF   18 E7                  JR   rpushn   
01C1   E9           JPHL:     JP   (HL)   ; (for the machine-code call)
01C2                             ; ---- machine code: the grave -----------------------------------------------
01C2                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
01C2                             ; are stored from addr until a non-hex character; then a RET (C9h) is
01C2                             ; written and its address is left. An odd last digit is consumed and dropped.
01C2                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
01C2                             ; code is entered by CALL with the data stack above the return address; it
01C2                             ; must keep BC, and on return the top cell becomes the new TOS.
01C2   CD 58 04     H_GRAVE:   CALL   hexc   
01C5                          IF   1-CPM*CHECKED   
                              JR   NC,exec   
01C5                          ENDIF      
01C5                          IF   CPM*CHECKED   
01C5   D2 F8 04               JP   NC,exec   ; (out of the way: see rpop)
01C8                          ENDIF      
01C8   77           HX1:      LD   (HL),A   ; the high digit goes in first ...
01C9   CD 58 04               CALL   hexc   
01CC   30 08                  JR   NC,hx2   ; odd digit: consumed, and the RET below
01CE   ED 6F                  RLD      ;   overwrites it
01D0   23                     INC   HL   ; ... and RLD shifts it up under the low one
01D1   CD 58 04               CALL   hexc   
01D4   38 F2                  JR   C,hx1   
01D6   36 C9        HX2:      LD   (HL),0C9h   ; (never range-checked: the spec says so)
01D8                          ;*Macro unroll:  NEXT
01D8                          DS   (1-CPM)*(1-FAST),0F7h   
01D8   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
01D9   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
01DA                             ; ---- where the two pages meet ----------------------------------------------
01DA                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
01DA                             ; are in falling code order for this), and where exactly differs between the
01DA                             ; builds: NPG1 follows. Every handler below these four must start in the
01DA                             ; second page, and every one above in the first; chktab.py checks both.
01DA                             ; "]" returns: pop an address and jump to it.
01DA                          ;*Macro unroll: h_ret:  POPR
01DA                H_RET:    DS   1-CPM,0CFh   
01DA   CD                     DS   CPM,0CDh   
01DB   E6                     DS   CPM,AROP&0FFh   
01DC   04                     DS   CPM,AROP/256   
01DD   42                     LD   B,D   
01DE   4B                     LD   C,E   
01DF                          ;*Macro unroll: brk1:   NEXT
01DF                BRK1:     DS   (1-CPM)*(1-FAST),0F7h   
01DF   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
01E0   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
01E1                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
01E1                             ; drops the block start, "]" returns. No closer at all ends the program.
01E1   7C           H_BREAK:   LD   A,H   
01E2   B5                     OR   L   
01E3   E1                     POP   HL   
01E4   28 F9                  JR   Z,brk1   
01E6   CD 19 04               CALL   skip   
01E9   B7                     OR   A   ; skip returns 0 for ")"
01EA   20 EE                  JR   NZ,h_ret   
01EC                          ;*Macro unroll: rdrop:  POPR
01EC                RDROP:    DS   1-CPM,0CFh   
01EC   CD                     DS   CPM,0CDh   
01ED   E6                     DS   CPM,AROP&0FFh   
01EE   04                     DS   CPM,AROP/256   
01EF                          ;*Macro unroll:  NEXT
01EF                          DS   (1-CPM)*(1-FAST),0F7h   
01EF   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
01F0   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
01F1                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
01F1                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
01F1                             ; the body"s address instead. Either way it then skips to the matching "]'.
01F1                             ; (The unchecked build takes anything that is not a letter as the space; the
01F1                             ; checked build stops on it.)
01F1   0A           H_DEF:    LD   A,(BC)   
01F2   03                     INC   BC   
01F3   D6 41                  SUB   "A"   ; a letter gives 0-25 or 32-57: lowercase
01F5   5F                     LD   E,A   ;   lands 64 bytes up
01F6   E6 DF                  AND   0DFh   ; fold case
01F8   FE 1A                  CP   26   
01FA   30 0B                  JR   NC,def2   ; not a letter
01FC   CB 23                  SLA   E   
01FE   16 09                  LD   D,LETPAGE   ; DE -> cell
0200   79                     LD   A,C   
0201   12                     LD   (DE),A   
0202   1C                     INC   E   
0203   78                     LD   A,B   
0204   12                     LD   (DE),A   
0205   18 09                  JR   skipnx   
0207                DEF2:        
0207                          IF   CHECKED   
0207   7B                     LD   A,E   
0208   FE DF                  CP   " "-"A"+256   
020A   C2 A9 05               JP   NZ,e_brack   ; anything but a letter or a space
020D                          ENDIF      
020D   E5                     PUSH   HL   ; an anonymous block: push its address
020E   60                     LD   H,B   
020F   69                     LD   L,C   
0210                SKIPNX:      
0210                          IF   CHECKED   
0210   0B                     DEC   BC   ; back onto the letter, so that skip finds its
0211                          ENDIF      ;   opener, the "[", just before where it starts
0211   CD 19 04     SKIPO:    CALL   skip   
0214                          ;*Macro unroll:  NEXT
0214                          DS   (1-CPM)*(1-FAST),0F7h   
0214   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0215   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0216   5E           H_FETCH:   LD   E,(HL)   ; "@"
0217   23                     INC   HL   
0218   56                     LD   D,(HL)   
0219   EB                     EX   DE,HL   
021A                          ;*Macro unroll:  NEXT
021A                          DS   (1-CPM)*(1-FAST),0F7h   
021A   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
021B   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
021C                             ; =============================================================================
021C                             ;  Handlers that must start in the image's second page.
021C                             ;  "?" is the last (with "," inside it), so its long tail may run past that
021C                             ;  page.
021C                             ; =============================================================================
021C                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
021C                             ; the matching ")".
021C   7C           H_OPEN:   LD   A,H   
021D   B5                     OR   L   
021E   E1                     POP   HL   
021F   28 F0                  JR   Z,skipo   
0221   C5                     PUSH   BC   ; the block starts at the IP
0222   18 84                  JR   rpushn   
0224                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
0224                             ; drops it and carries on.
0224   7C           H_CLOSE:   LD   A,H   
0225   B5                     OR   L   
0226   E1                     POP   HL   
0227   28 C3                  JR   Z,rdrop   
0229                          IF   QK   
                              JP   closeq   ; (out of the handlers' pages: see Speed-ups)
0229                          ENDIF      
0229                          IF   1-QK   
0229                          ;*Macro unroll:  POPR                    ; pop the block start ...
0229                          DS   1-CPM,0CFh   ; pop the block start ...
0229   CD                     DS   CPM,0CDh   
022A   E6                     DS   CPM,AROP&0FFh   
022B   04                     DS   CPM,AROP/256   
022C   42                     LD   B,D   
022D   4B                     LD   C,E   
022E   C5                     PUSH   BC   
022F                          ENDIF      
022F                          IF   (1-QK)*(1-CPM)   
                              JR   rpushn   ; ... and push it back
022F                          ENDIF      
022F                          IF   (1-QK)*CPM   
022F   C3 A8 01               JP   rpushn   
0232                          ENDIF      
0232                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
0232                             ; "-" has two jobs: directly before a digit it starts a negative number.
0232   0A           H_SUB:    LD   A,(BC)   
0233   D6 30                  SUB   "0"   
0235   FE 0A                  CP   10   
0237   38 07                  JR   C,negnum   
0239                          ;*Macro unroll:  NEGH                    ; a - b = a + (-b): fall into '+'
0239                          DS   1-CPM,0E7h   ; a - b = a + (-b): fall into "+"
0239   CD                     DS   CPM,0CDh   
023A   F1                     DS   CPM,ANEG&0FFh   
023B   04                     DS   CPM,ANEG/256   
023C   D1           H_ADD:    POP   DE   
023D   19                     ADD   HL,DE   
023E                          ;*Macro unroll:  NEXT
023E                          DS   (1-CPM)*(1-FAST),0F7h   
023E   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
023F   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0240   E5           NEGNUM:   PUSH   HL   ; a negative number: read it, negate it
0241   CD F2 03               CALL   rdnum   
0244                          ;*Macro unroll:  NEGH
0244                          DS   1-CPM,0E7h   
0244   CD                     DS   CPM,0CDh   
0245   F1                     DS   CPM,ANEG&0FFh   
0246   04                     DS   CPM,ANEG/256   
0247                          ;*Macro unroll:  NEXT
0247                          DS   (1-CPM)*(1-FAST),0F7h   
0247   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0248   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0249   D1           H_AND:    POP   DE   
024A   7C                     LD   A,H   
024B   A2                     AND   D   
024C   67                     LD   H,A   
024D   7D                     LD   A,L   
024E   A3                     AND   E   
024F   6F                     LD   L,A   
0250                          ;*Macro unroll:  NEXT
0250                          DS   (1-CPM)*(1-FAST),0F7h   
0250   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0251   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0252                             ; Signed compares. Both are "HL < DE" for the right pair: "<" swaps the two
0252                             ; cells first. Flipping both sign bits turns a signed compare into an
0252                             ; unsigned one (and XOR clears the carry for SBC); SBC HL,HL then turns the
0252                             ; carry into -1 or 0 with no branch.
0252   E3           H_LT:     EX   (SP),HL   ; a < b: HL = a, and b is popped next
0253   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
0254   7C                     LD   A,H   
0255   EE 80                  XOR   80h   
0257   67                     LD   H,A   
0258   7A                     LD   A,D   
0259   EE 80                  XOR   80h   
025B   57                     LD   D,A   
025C   ED 52                  SBC   HL,DE   ; carry if HL < DE
025E   ED 62        TF:       SBC   HL,HL   ; carry -> -1 or 0
0260                          ;*Macro unroll:  NEXT
0260                          DS   (1-CPM)*(1-FAST),0F7h   
0260   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0261   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0262   D1           H_EQ:     POP   DE   
0263   B7                     OR   A   
0264   ED 52                  SBC   HL,DE   
0266   7C                     LD   A,H   
0267   B5                     OR   L   
0268   FE 01                  CP   1   ; carry only if a - b = 0
026A   18 F2                  JR   tf   
026C                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept. The
026C                             ; multiplier shifts up through A:C.
026C                          IF   1-QK   
026C   D1           H_MUL:    POP   DE   ; DE = multiplicand
026D   C5                     PUSH   BC   
026E   7C                     LD   A,H   
026F   4D                     LD   C,L   ; A:C = multiplier
0270   21 00 00               LD   HL,0   
0273   06 10                  LD   B,16   
0275   29           MUL1:     ADD   HL,HL   
0276   CB 21                  SLA   C   
0278   17                     RLA      
0279   30 01                  JR   NC,mul2   
027B   19                     ADD   HL,DE   
027C   10 F7        MUL2:     DJNZ   mul1   
027E   C1                     POP   BC   
027F                          ;*Macro unroll:  NEXT
027F                          DS   (1-CPM)*(1-FAST),0F7h   
027F   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0280   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0281                          ENDIF      
0281                          IF   QK   
                    H_MUL:    POP   DE   ; DE = multiplicand
                              JP   mulq   ; (out of the handlers' pages: see Speed-ups)
0281                          ENDIF      
0281                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
0281                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
0281                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
0281                             ; stops on it.
0281                H_DIV:       
0281                          IF   CHECKED   
0281   7C                     LD   A,H   
0282   B5                     OR   L   
0283   CA A6 05               JP   Z,e_zero   
0286                          ENDIF      
0286   D1                     POP   DE   ; DE = a, HL = b
0287   D5                     PUSH   DE   ; a, for r's sign
0288   7A                     LD   A,D   
0289   AC                     XOR   H   
028A   F5                     PUSH   AF   ; S flag = sign of q
028B   CB 7C                  BIT   7,H   
028D   C4 F1 04               CALL   NZ,neg16   ; HL = |b|
0290   EB                     EX   DE,HL   
0291   CB 7C                  BIT   7,H   
0293   C4 F1 04               CALL   NZ,neg16   ; HL = |a|, DE = |b|
0296   CD CA 03               CALL   udiv   ; HL = q, DE = r
0299   F1                     POP   AF   
029A   FC F1 04               CALL   M,neg16   ; q's sign
029D   EB                     EX   DE,HL   ; HL = r, DE = q
029E   F1                     POP   AF   ; A = a's high byte
029F   B7                     OR   A   
02A0   FC F1 04               CALL   M,neg16   ; r's sign
02A3   D5                     PUSH   DE   ; q under r
02A4                          ;*Macro unroll:  NEXT
02A4                          DS   (1-CPM)*(1-FAST),0F7h   
02A4   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
02A5   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
02A6                             ; ---- stack and storage -----------------------------------------------------
02A6   E5           H_DUP:    PUSH   HL   ; ":"
02A7                          ;*Macro unroll:  NEXT
02A7                          DS   (1-CPM)*(1-FAST),0F7h   
02A7   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
02A8   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
02A9   E3           H_SWAP:   EX   (SP),HL   ; "%"
02AA                          ;*Macro unroll:  NEXT
02AA                          DS   (1-CPM)*(1-FAST),0F7h   
02AA   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
02AB   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
02AC                             ; (The checked build tests the address before it takes the value off the
02AC                             ; stack, so that an error report shows both.)
02AC                H_CSTORE:      ; "." ( c addr -- )
02AC                          IF   CHECKED   
02AC   CD 7E 05               CALL   chkst   
02AF                          ENDIF      
02AF   D1                     POP   DE   
02B0   73                     LD   (HL),E   
02B1                          ;*Macro unroll: h_drop: DROP                    ; ';' is this one byte
02B1                H_DROP:   DS   (1-CPM)*(1-FAST),0DFh   ; ";" is this one byte
02B1   E1                     DS   CPM+FAST-CPM*FAST,0E1h   
02B2   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
02B3   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
02B4                H_STORE:      ; "!" ( n addr -- )
02B4                          IF   CHECKED   
02B4   CD 7E 05               CALL   chkst   
02B7                          ENDIF      
02B7   D1                     POP   DE   
02B8   73                     LD   (HL),E   
02B9   23                     INC   HL   
02BA   72                     LD   (HL),D   
02BB                          ;*Macro unroll:  DROP
02BB                          DS   (1-CPM)*(1-FAST),0DFh   
02BB   E1                     DS   CPM+FAST-CPM*FAST,0E1h   
02BC   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
02BD   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
02BE                             ; ---- console ---------------------------------------------------------------
02BE                             ; 22h pushes the address of the text after it and skips the string.
02BE   E5           H_STR:    PUSH   HL   
02BF   60                     LD   H,B   
02C0   69                     LD   L,C   
02C1   CD 08 04               CALL   skipstr   
02C4                          IF   CHECKED   
02C4   B7                     OR   A   ; 0: the text ran out before the closing quote
02C5   CA 9E 05               JP   Z,e_quote   
02C8                          ENDIF      
02C8                          ;*Macro unroll:  NEXT
02C8                          DS   (1-CPM)*(1-FAST),0F7h   
02C8   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
02C9   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
02CA                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
02CA                             ; 60h to 7Eh is one of the escapes at pesc; "/" plus any other character
02CA                             ; clears that character"s bit 6 (/M is CR, and / then DEL gives "?"; "/',
02CA                             ; '"' and '?' have no bit 6, so //, /" and /? give themselves).
02CA                          IF   1-CHECKED   
                    H_PRINT:   LD   A,(HL)   
                              INC   HL   
                              CP   22h   
                              JR   Z,pr9   
                              CP   "/"   
                              JR   NZ,pr1   
                              LD   A,(HL)   
                              INC   HL   
                              CP   60h   
                              JR   C,pr0   
                              CP   7Fh   
                              JR   C,pesc   
                    PR0:      AND   0BFh   
                              ;*Macro unroll: pr1:    PUTA
                    PR1:      DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              JR   h_print   
                    PRLOOP:   EQU   h_print   ; (where the escapes go back to)
                    PRAGAIN:   EQU   h_print   ; (and where /~ goes back to)
02CA                          ENDIF      
02CA                          IF   CHECKED   
02CA                             ; (The checked build has the loop as a routine, prstr, which the error
02CA                             ; report uses too. The address is kept meanwhile, for a report: it shows
02CA                             ; the stack as it was before the "$". /~ comes back to hp1.)
02CA   22 34 09     H_PRINT:   LD   (RSAVE),HL   
02CD   CD 2F 03     HP1:      CALL   prstr   
02D0                          ;*Macro unroll:  DROP
02D0                          DS   (1-CPM)*(1-FAST),0DFh   
02D0   E1                     DS   CPM+FAST-CPM*FAST,0E1h   
02D1   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
02D2   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
02D3                          ENDIF      
02D3   7D           H_EMIT:   LD   A,L   ; "'"
02D4                          ;*Macro unroll:  PUTA
02D4                          DS   1-CPM,0EFh   
02D4   CD                     DS   CPM,0CDh   
02D5   12                     DS   CPM,APUT&0FFh   
02D6   05                     DS   CPM,APUT/256   
02D7                          ;*Macro unroll: pr9:    DROP
02D7                PR9:      DS   (1-CPM)*(1-FAST),0DFh   
02D7   E1                     DS   CPM+FAST-CPM*FAST,0E1h   
02D8   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
02D9   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
02DA                             ; "#" prints TOS as a signed decimal number, with no space after it.
02DA   CD 6A 04     H_NUM:    CALL   psgn   
02DD                          ;*Macro unroll:  DROP
02DD                          DS   (1-CPM)*(1-FAST),0DFh   
02DD   E1                     DS   CPM+FAST-CPM*FAST,0E1h   
02DE   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
02DF   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
02E0                             ; "?" ( n -- c ) or ( -n -- addr )
02E0                             ;   n > 0: wait about n ms for a key; 0 if none came
02E0                             ;   n = 0: wait for a key
02E0                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
02E0                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
02E0   CB 7C        H_KEY:    BIT   7,H   
02E2   20 1A                  JR   NZ,line   
02E4   1E 04        KT1:      LD   E,MSLOOP   ; one millisecond, roughly
02E6   CD D6 04     KT2:      CALL   getk   
02E9   20 0E                  JR   NZ,kt3   
02EB   1D                     DEC   E   
02EC   20 F8                  JR   NZ,kt2   
02EE   7C                     LD   A,H   ; 0? never counts down: it waits
02EF   B5                     OR   L   
02F0   28 F2                  JR   Z,kt1   
02F2   2B                     DEC   HL   
02F3   7C                     LD   A,H   
02F4   B5                     OR   L   
02F5   20 ED                  JR   NZ,kt1   ; A = 0 if the time ran out
02F7   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
02F8   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
02F9   6F           KT3:      LD   L,A   
02FA   26 00                  LD   H,0   
02FC                          ;*Macro unroll:  NEXT
02FC                          DS   (1-CPM)*(1-FAST),0F7h   
02FC   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
02FD   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
02FE                             ; Backspace takes the last character back (and is echoed as it
02FE                             ; is), CR ends (stored, not echoed), every other key is stored and
02FE                             ; echoed until the line is full. (CP/M too: getk reads through BDOS
02FE                             ; 6.) The line buffer starts at offset 80h of its page, so L alone
02FE                             ; is the place in the line: D holds the L of a full line.
02FE   11 7F 00     LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
0301   19                     ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
0302   9F                     SBC   A,A   
0303   A5                     AND   L   ; (0 for a count that is too big)
0304   2F                     CPL      
0305   57                     LD   D,A   ; D = the L of a full line: 80h + count, FFh
0306                             ;   at most
0306   21 80 09               LD   HL,LINEBUF   
0309   CD D6 04     LN2:      CALL   getk   
030C   28 FB                  JR   Z,ln2   
030E   FE 0D                  CP   13   
0310   28 18                  JR   Z,ln5   
0312   FE 08                  CP   8   
0314   28 0D                  JR   Z,ln4   
0316   5F                     LD   E,A   
0317   7D                     LD   A,L   
0318   BA                     CP   D   
0319   28 EE                  JR   Z,ln2   ; full
031B   73                     LD   (HL),E   
031C   2C                     INC   L   
031D   7B                     LD   A,E   
031E                          ;*Macro unroll: ln3:    PUTA
031E                LN3:      DS   1-CPM,0EFh   
031E   CD                     DS   CPM,0CDh   
031F   12                     DS   CPM,APUT&0FFh   
0320   05                     DS   CPM,APUT/256   
0321   18 E6                  JR   ln2   
0323   2D           LN4:      DEC   L   ; Backspace: one back, and echo it,
0324   FA 1E 03               JP   M,ln3   ;   unless the line was empty (L left the
0327   2C                     INC   L   ;   upper half of the page)
0328   18 DF                  JR   ln2   
032A   77           LN5:      LD   (HL),A   ; the CR
032B   2E 80                  LD   L,LINEBUF & 0FFh   
032D                          ;*Macro unroll:  NEXT
032D                          DS   (1-CPM)*(1-FAST),0F7h   
032D   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
032E   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
032F                             ; =============================================================================
032F                             ;  More routines (no handler starts past this point)
032F                             ; =============================================================================
032F                          IF   CHECKED   
032F                             ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
032F                             ; "$", and the texts of the report). A NUL first is an error: Q.
032F   7E           PRSTR:    LD   A,(HL)   
0330   23                     INC   HL   
0331   FE 22                  CP   22h   
0333   C8                     RET   Z   
0334   B7                     OR   A   
0335   CA 94 05               JP   Z,e_dollar   
0338   FE 2F                  CP   "/"   
033A   20 0C                  JR   NZ,prs1   
033C   7E                     LD   A,(HL)   
033D   23                     INC   HL   
033E   FE 60                  CP   60h   
0340   38 04                  JR   C,prs0   
0342   FE 7F                  CP   7Fh   
0344   38 13                  JR   C,pesc   
0346   E6 BF        PRS0:     AND   0BFh   
0348                          ;*Macro unroll: prs1:   PUTA
0348                PRS1:     DS   1-CPM,0EFh   
0348   CD                     DS   CPM,0CDh   
0349   12                     DS   CPM,APUT&0FFh   
034A   05                     DS   CPM,APUT/256   
034B   18 E2                  JR   prstr   
034D                PRLOOP:   EQU   prstr   ; (where the escapes go back to)
034D                PRAGAIN:   EQU   hp1   ; (and where /~ goes back to)
034D                             ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
034D                             ; pnl: the same, on a new line.
034D   CD 53 03     PNL:      CALL   pmsg   ; (pmsg's own CR LF, then on into pmsg for
0350   0D 0A 22               DB   13,10,22h   ;   the caller's text)
0353   E3           PMSG:     EX   (SP),HL   
0354   CD 2F 03               CALL   prstr   
0357   E3                     EX   (SP),HL   
0358   C9                     RET      
0359                          ENDIF      
0359                             ; pesc: the escapes of "$". A = the character after the "/", 60h to 7Eh, and
0359                             ; HL points past it. Each goes back into the loop that prints the string
0359                             ; (PRLOOP), but /~ has the stack to see to, and goes back by PRAGAIN.
0359                             ;    /a-/z   print the variable, as "#" does
0359                             ;    /{      clear the screen, the cursor to the top left
0359                             ;    /}      clear from the cursor to the end of the line
0359                             ;    /|  /`  show the cursor, hide it
0359                             ;    /~      ( row col -- ) the cursor to that row and column, from 0
0359   FE 7E        PESC:     CP   7Eh   
035B   28 1C                  JR   Z,pat   
035D   11 2F 03               LD   DE,PRLOOP   ; the others return into the loop
0360   D5                     PUSH   DE   
0361   D6 7B                  SUB   7Bh   ; 00bbIDAsIHwgMSwg 2, and no borrow
0363   30 4A                  JR   NC,pcon   
0365   C6 1A                  ADD   A,1Ah   ; a-z: 0-25, and a carry; `: FFh, and none
0367   30 37                  JR   NC,phide   
0369   87                     ADD   A,A   ; the variable's cell
036A   C6 40                  ADD   A,40h   
036C   E5                     PUSH   HL   
036D   6F                     LD   L,A   
036E   26 09                  LD   H,LETPAGE   
0370   7E                     LD   A,(HL)   
0371   2C                     INC   L   
0372   66                     LD   H,(HL)   
0373   6F                     LD   L,A   
0374   CD 6A 04               CALL   psgn   
0377   E1                     POP   HL   
0378   C9                     RET      
0379                             ; /~ ( row col addr -- ): the two cells under the string's address go. In
0379                             ; the checked build "$" is the routine prstr: its own return address goes
0379                             ; first, and hp1 calls it again afterwards. There each /~ first looks that
0379                             ; its two cells are there, and is s if not, before it prints anything.
0379                PAT:         
0379                          IF   CHECKED   
0379   E3                     EX   (SP),HL   ; the text pointer over prstr's return address
037A   21 0A F7               LD   HL,(6-DSTOP)&0FFFFh   ; a carry: the two cells aren't there
037D   39                     ADD   HL,SP   
037E   DA 4E 05               JP   C,e_under   
0381   E1                     POP   HL   
0382                          ENDIF      
0382   D1                     POP   DE   ; DE = the column
0383   E3                     EX   (SP),HL   ; HL = the row; the text pointer is kept
0384                          IF   1-ANS   
                              CALL   CONAT   
                              POP   HL   
                              JP   PRAGAIN   
                                 ; With ANSI = 0 the machine's routines do the rest.
                    PCON:     JP   Z,CONCLS   ; /{
                              CP   2   
                              JP   Z,CONEOL   ; /}
                              DB   0FEh   ; /|  (CP n steps over the XOR: A = 1, show)
                    PHIDE:    XOR   A   ; /`  (A = 0: hide)
                              JP   CONCUR   
0384                          ENDIF      
0384                          IF   ANS   
0384   D5                     PUSH   DE   
0385   CD C3 03               CALL   csi   ; ESC [ row+1 ; col+1 H (ANSI counts from 1)
0388   23                     INC   HL   
0389   CD 75 04               CALL   pdec   
038C                          ;*Macro unroll:  PUTK    3Bh             ; ';'
038C                          DS   1-CPM,3Eh   ; ";"
038C                          DS   1-CPM,3Bh   
038C                          DS   1-CPM,0EFh   
038C   CD                     DS   CPM,0CDh   
038D   0E                     DS   CPM,APTK&0FFh   
038E   05                     DS   CPM,APTK/256   
038F   3B                     DS   CPM,3Bh   
0390   E1                     POP   HL   
0391   23                     INC   HL   
0392   CD 75 04               CALL   pdec   
0395                          ;*Macro unroll:  PUTK    48h             ; 'H'
0395                          DS   1-CPM,3Eh   ; "H"
0395                          DS   1-CPM,48h   
0395                          DS   1-CPM,0EFh   
0395   CD                     DS   CPM,0CDh   
0396   0E                     DS   CPM,APTK&0FFh   
0397   05                     DS   CPM,APTK/256   
0398   48                     DS   CPM,48h   
0399   E1                     POP   HL   
039A   C3 CD 02               JP   PRAGAIN   
039D                             ; With ANSI = 1 they are sequences. The carry is clear on the way in.
039D   1E 68        PSHOW:    LD   E,"h"   ; /|  ESC [ ? 2 5 h
039F   DA                     DB   0DAh   ; (JP C,nn: with no carry it steps over two bytes)
03A0   1E 6C        PHIDE:    LD   E,"l"   ; /`  ESC [ ? 2 5 l
03A2                          ENDIF      
03A2                          IF   ANS*CHECKED   
03A2                             ; (The checked build prints the fixed parts with pmsg, which it has for the
03A2                             ; report: shorter than a character at a time.)
03A2   CD 53 03               CALL   pmsg   
03A5   1B 5B 3F 32 35 22      DB   27,"[?25",22h   
03AB   7B           PSE:      LD   A,E   ; then E
03AC                          ;*Macro unroll:  PUTAR
03AC                          DS   1-CPM,0EFh   
03AC                          DS   1-CPM,0C9h   
03AC   C3                     DS   CPM,0C3h   
03AD   12                     DS   CPM,APUT&0FFh   
03AE   05                     DS   CPM,APUT/256   
03AF                             ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into cse.
03AF   3D           PCON:     DEC   A   
03B0   28 EB                  JR   Z,pshow   ; /|
03B2   1E 4B                  LD   E,"K"   
03B4   F2 BE 03               JP   P,cse   ; /}  ESC [ K
03B7   1E 48                  LD   E,"H"   ; /{  ESC [ H ESC [ J
03B9   CD BE 03               CALL   cse   
03BC   1E 4A                  LD   E,"J"   ; (on into cse)
03BE                             ; cse: ESC [ and then E. csi: ESC [. Both keep HL.
03BE   CD C3 03     CSE:      CALL   csi   
03C1   18 E8                  JR   pse   
03C3   CD 53 03     CSI:      CALL   pmsg   
03C6   1B 5B 22               DB   27,"[",22h   
03C9   C9                     RET      
03CA                          ENDIF      
03CA                          IF   ANS*(1-CHECKED)   
                              LD   A,"?"   
                              CALL   csia   
                              ;*Macro unroll:  PUTK    32h             ; '2'
                              DS   1-CPM,3Eh   ; "2"
                              DS   1-CPM,32h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,32h   
                              ;*Macro unroll:  PUTK    35h             ; '5'
                              DS   1-CPM,3Eh   ; "5"
                              DS   1-CPM,35h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,35h   
                              LD   A,E   
                              ;*Macro unroll:  PUTAR
                              DS   1-CPM,0EFh   
                              DS   1-CPM,0C9h   
                              DS   CPM,0C3h   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                                 ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into csia.
                    PCON:     DEC   A   
                              JR   Z,pshow   ; /|
                              LD   A,"K"   
                              JP   P,csia   ; /}  ESC [ K
                              LD   A,"H"   ; /{  ESC [ H ESC [ J
                              CALL   csia   
                              LD   A,"J"   ; (on into csia)
                                 ; csia: ESC [ and then A. csi: ESC [, keeping A.
                    CSIA:     CALL   csi   
                              ;*Macro unroll:  PUTAR
                              DS   1-CPM,0EFh   
                              DS   1-CPM,0C9h   
                              DS   CPM,0C3h   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                    CSI:      PUSH   AF   
                              ;*Macro unroll:  PUTK    1Bh             ; ESC
                              DS   1-CPM,3Eh   ; ESC
                              DS   1-CPM,1Bh   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,1Bh   
                              ;*Macro unroll:  PUTK    5Bh             ; '['
                              DS   1-CPM,3Eh   ; "["
                              DS   1-CPM,5Bh   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,5Bh   
                              POP   AF   
                              RET      
03CA                          ENDIF      
03CA                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
03CA                             ; Uses A; keeps BC (the IP) itself. The dividend shifts up through A:C while
03CA                             ; the quotient bits arrive at the bottom of C.
03CA                             ; Dividing by 2 is one shift (the spec wants that fast).
03CA                          IF   1-QK   
03CA   7B           UDIV:     LD   A,E   
03CB   EE 02                  XOR   2   
03CD   B2                     OR   D   
03CE   20 07                  JR   NZ,udv0   
03D0   CB 3C                  SRL   H   
03D2   CB 1D                  RR   L   ; the quotient
03D4   8F                     ADC   A,A   
03D5   5F                     LD   E,A   ; the remainder: the bit that fell out (D is 0)
03D6   C9                     RET      
03D7                          ENDIF      
03D7                          IF   QK   
                                 ; (The builds with room divide by any power of two with shifts: 2, and 32,
                                 ; 64, 256 and the like, which fixed point and byte work use all the time.)
                    UDIV:     LD   A,D   
                              OR   A   
                              JR   NZ,uq1   ; 256 and up
                              OR   E   
                              JR   Z,udv0   ; by 0: the long way (it means nothing anyway)
                              DEC   A   
                              AND   E   
                              JR   NZ,udv0   ; not a power of two
                              LD   A,E   ; by 2^k below 256: q = HL >> k, and
                              DEC   A   ;   r = L & (2^k - 1)
                              AND   L   
                              PUSH   AF   
                    UQ2:      SRL   E   
                              JR   C,uq3   
                              SRL   H   
                              RR   L   
                              JR   uq2   
                    UQ3:      POP   AF   
                              LD   E,A   
                              LD   D,0   
                              RET      
                    UQ1:      LD   A,E   
                              OR   A   
                              JR   NZ,udv0   
                              LD   A,D   
                              DEC   A   
                              AND   D   
                              JR   NZ,udv0   ; not a power of two
                              LD   A,D   ; by 2^k, 256 and up: q = H >> (k - 8), and
                              DEC   A   ;   r = HL & (2^k - 1)
                              AND   H   
                              LD   E,A   ; (the remainder's high byte,
                              LD   A,L   ;   and its low byte)
                              LD   L,H   
                              LD   H,0   
                    UQ4:      SRL   D   
                              JR   C,uq5   
                              SRL   L   
                              JR   uq4   
                    UQ5:      LD   D,E   
                              LD   E,A   
                              RET      
03D7                          ENDIF      
03D7                          IF   1-FAST   
03D7   C5           UDV0:     PUSH   BC   
03D8   7C                     LD   A,H   
03D9   4D                     LD   C,L   
03DA   21 00 00               LD   HL,0   
03DD   06 10                  LD   B,16   
03DF   CB 21        UDV1:     SLA   C   
03E1   17                     RLA      
03E2   ED 6A                  ADC   HL,HL   
03E4   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
03E6   30 02                  JR   NC,udv2   ;   always fits in 16 bits
03E8   19                     ADD   HL,DE   ; too much: put it back, and cancel the
03E9   0D                     DEC   C   ;   INC below
03EA   0C           UDV2:     INC   C   ; a quotient bit
03EB   10 F2                  DJNZ   udv1   
03ED   EB                     EX   DE,HL   ; DE = remainder
03EE   67                     LD   H,A   
03EF   69                     LD   L,C   ; HL = quotient
03F0   C1                     POP   BC   
03F1   C9                     RET      
03F2                          ENDIF      
03F2                          IF   FAST   
                                 ; (the fast build: the same 16 rounds, unrolled)
                    UDV0:     PUSH   BC   
                              LD   A,H   
                              LD   C,L   
                              LD   HL,0   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr0   
                              ADD   HL,DE   
                              DEC   C   
                    UVR0:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr1   
                              ADD   HL,DE   
                              DEC   C   
                    UVR1:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr2   
                              ADD   HL,DE   
                              DEC   C   
                    UVR2:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr3   
                              ADD   HL,DE   
                              DEC   C   
                    UVR3:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr4   
                              ADD   HL,DE   
                              DEC   C   
                    UVR4:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr5   
                              ADD   HL,DE   
                              DEC   C   
                    UVR5:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr6   
                              ADD   HL,DE   
                              DEC   C   
                    UVR6:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr7   
                              ADD   HL,DE   
                              DEC   C   
                    UVR7:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr8   
                              ADD   HL,DE   
                              DEC   C   
                    UVR8:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr9   
                              ADD   HL,DE   
                              DEC   C   
                    UVR9:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr10   
                              ADD   HL,DE   
                              DEC   C   
                    UVR10:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr11   
                              ADD   HL,DE   
                              DEC   C   
                    UVR11:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr12   
                              ADD   HL,DE   
                              DEC   C   
                    UVR12:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr13   
                              ADD   HL,DE   
                              DEC   C   
                    UVR13:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr14   
                              ADD   HL,DE   
                              DEC   C   
                    UVR14:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr15   
                              ADD   HL,DE   
                              DEC   C   
                    UVR15:    INC   C   
                              EX   DE,HL   ; DE = remainder
                              LD   H,A   
                              LD   L,C   ; HL = quotient
                              POP   BC   
                              RET      
03F2                          ENDIF      
03F2                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
03F2                             ; non-digit. Values wrap at 16 bits, as the spec says.
03F2   21 00 00     RDNUM:    LD   HL,0   
03F5   0A           RDN1:     LD   A,(BC)   
03F6   D6 30                  SUB   "0"   
03F8   FE 0A                  CP   10   
03FA   D0                     RET   NC   
03FB   03                     INC   BC   
03FC   54                     LD   D,H   
03FD   5D                     LD   E,L   
03FE   29                     ADD   HL,HL   
03FF   29                     ADD   HL,HL   
0400   19                     ADD   HL,DE   
0401   29                     ADD   HL,HL   ; HL * 10
0402   5F                     LD   E,A   
0403   16 00                  LD   D,0   
0405   19                     ADD   HL,DE   
0406   18 ED                  JR   rdn1   
0408                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
0408                             ; the next character, so "/"" does not end it. Leaves A = 22h.
0408                          IF   1-CHECKED   
                    SS0:      INC   BC   
                    SKIPSTR:   LD   A,(BC)   
                              INC   BC   
                              CP   "/"   
                              JR   Z,ss0   
                              CP   22h   
                              JR   NZ,skipstr   
                              RET      
0408                          ENDIF      
0408                          IF   CHECKED   
0408                             ; The checked build never steps over a NUL: if the text runs out first it
0408                             ; returns A = 0 with the IP on the NUL.
0408   0A           SKIPSTR:   LD   A,(BC)   
0409   B7                     OR   A   
040A   C8                     RET   Z   
040B   03                     INC   BC   
040C   FE 22                  CP   22h   
040E   C8                     RET   Z   
040F   FE 2F                  CP   "/"   
0411   20 F5                  JR   NZ,skipstr   
0413   0A                     LD   A,(BC)   ; the escaped character
0414   B7                     OR   A   
0415   C8                     RET   Z   
0416   03                     INC   BC   
0417   18 EF                  JR   skipstr   
0419                          ENDIF      
0419                             ; skip: read past text to the closer at this level, and return A = 0 if it
0419                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
0419                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
0419                             ; no closer; anything else that runs into the NUL had unbalanced brackets
0419                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
0419                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
0419                             ; 
0419                             ; The checked build also looks at the character the skip was started by,
0419                             ; which is always the one just before where it starts: "(" must end at ")",
0419                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
0419                             ; quote counts as running into it. "\" takes either closer. SKPL keeps the
0419                             ; place where the skip started, for the report.
0419                          IF   1-QK   
0419                             ; (Without base: no skip cache.)
0419                SKIP:        
0419                          ENDIF      
0419                          IF   CHECKED*(1-QK)   
0419   ED 43 3C 09            LD   (SKPL),BC   
041D   0B                     DEC   BC   
041E   0A                     LD   A,(BC)   
041F   03                     INC   BC   
0420   5F                     LD   E,A   ; E = the opener: ( [ or \
0421                          ENDIF      
0421                          IF   1-QK   
0421   16 00                  LD   D,0   
0423   14           SK3:      INC   D   ; an opener: one deeper
0424   0A           SK1:      LD   A,(BC)   
0425                          ENDIF      
0425                          IF   (1-CHECKED)*(1-QK)   
                              INC   BC   
                              OR   A   
                              JP   Z,SKEND   ; (the end of the program)
0425                          ENDIF      
0425                          IF   CHECKED*(1-QK)   
0425   B7                     OR   A   
0426   28 22                  JR   Z,sk6   ; (the IP stays on the NUL)
0428   03                     INC   BC   
0429                          ENDIF      
0429                          IF   1-QK   
0429   FE 22                  CP   22h   
042B   CC 08 04               CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
042E   D6 28                  SUB   "("   ;   (or 0, and then the NUL is read next)
0430   28 F1                  JR   Z,sk3   
0432   3D                     DEC   A   ; ")"
0433   28 08                  JR   Z,sk4   
0435   D6 32                  SUB   "["-")"   
0437   28 EA                  JR   Z,sk3   
0439   FE 02                  CP   "]"-"["   
043B   20 E7                  JR   NZ,sk1   
043D   15           SK4:      DEC   D   
043E                          ENDIF      
043E                          IF   (1-CHECKED)*(1-QK)   
                              RET   Z   ; the closer at this level
                              JR   sk1   
043E                          ENDIF      
043E                          IF   CHECKED*(1-QK)   
043E   20 E4                  JR   NZ,sk1   
0440   57                     LD   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
0441   AB                     XOR   E   ;   opener is 0 for "(" and 1 for "[", and only
0442   E6 06                  AND   6   ;   "\" has bit 2: so this is 2 for the wrong
0444   FE 02                  CP   2   ;   closer, and only then
0446   7A                     LD   A,D   
0447   C0                     RET   NZ   
0448   18 05                  JR   sk7   
044A   CB 53        SK6:      BIT   2,E   ; the text ran out:
044C   C2 00 00               JP   NZ,SKEND   ;   "\" with no closer ends the program
044F   ED 4B 3C 09  SK7:      LD   BC,(SKPL)   ; N. The place is the opener
0453   3E 4E                  LD   A,"N"   
0455   C3 91 05               JP   errp   ; (errp drops skip's return address)
0458                          ENDIF      
0458                          IF   QK   
                                 ; The skip cache. Nearly every skip is one that has happened before (a loop
                                 ; skips the same false block on every pass), so the first scan from each
                                 ; place is remembered: 64 entries of 00bbc3RhcnQsIGVuZA==, at CPAGE, found by the
                                 ; start's low byte. Only skips that start in the program text are kept (the
                                 ; line buffer changes); the cache is emptied whenever a run starts (skclr).
                                 ; A program that changes its own text while it runs is not looked after.
                    SKIP:     LD   (SKPL),BC   ; where it starts: the cache's key (and the
                              LD   A,B   ;   checked report's place)
                              CP   PROG/256   
                              JR   C,sks   ; below the program text: no cache
                              LD   A,C   
                              ADD   A,A   
                              ADD   A,A   
                              LD   E,A   
                              LD   D,CPAGE   ; DE -> the entry
                              LD   A,(DE)   
                              CP   C   
                              JR   NZ,sks   
                              INC   E   
                              LD   A,(DE)   
                              CP   B   
                              JR   NZ,sks   
                              INC   E   
                              LD   A,(DE)   
                              LD   C,A   
                              INC   E   
                              LD   A,(DE)   
                              LD   B,A   ; a hit: the IP is past the closer
                              DEC   BC   
                              LD   A,(BC)   
                              INC   BC   
                              SUB   ")"   ; 0 for ")", not 0 for "]"
                              RET      
                    SKS:         
0458                          ENDIF      
0458                          IF   QK*CHECKED   
                              DEC   BC   
                              LD   A,(BC)   
                              INC   BC   
                              LD   E,A   ; E = the opener: ( [ or \
0458                          ENDIF      
0458                          IF   QK   
                                 ; The scan. Most characters are nothing to it, and two range tests rule
                                 ; them out: * to Z, and ^ and up. Only NUL " ( ) [ ] count.
                              LD   D,0   
                    SQ3:      INC   D   ; an opener: one deeper
                    SQ1:      LD   A,(BC)   
                              INC   BC   
                              CP   5Eh   
                              JR   NC,sq1   ; ^ _ ` a-z 00bbIHwg ~ and up: nothing
                              CP   5Bh   
                              JR   NC,sqb   ; [ \ ]
                              CP   2Ah   
                              JR   NC,sq1   ; * to Z: nothing
                              CP   28h   
                              JR   Z,sq3   ; (
                              JR   NC,sqc   ; )
                              CP   22h   
                              JR   Z,sqq   ; a string
                              OR   A   
                              JR   NZ,sq1   ; the rest below "(": nothing
0458                          ENDIF      
0458                          IF   QK*(1-CHECKED)   
                              JP   SKEND   ; NUL: the end of the program
0458                          ENDIF      
0458                          IF   QK*CHECKED   
                              DEC   BC   ; NUL: the IP stays on it
                              BIT   2,E   ; the text ran out:
                              JP   NZ,SKEND   ;   "\" with no closer ends the program
                    SQ7:      LD   BC,(SKPL)   ; N. The place is the opener
                              LD   A,"N"   
                              JP   errp   ; (errp drops skip's return address)
0458                          ENDIF      
0458                          IF   QK   
                    SQQ:      CALL   skipstr   ; step over the string
                              JR   sq1   
                    SQB:      SUB   5Ch   ; [ -1, \ 0, ] 1
                              JR   Z,sq1   ; "\" is nothing here
                              JR   C,sq3   ; [
                              LD   A,2   ; ]
                              JR   sq4   
                    SQC:      XOR   A   ; )
                    SQ4:      DEC   D   
                              JR   NZ,sq1   
0458                          ENDIF      
0458                          IF   QK*CHECKED   
                              LD   D,A   ; the closer at this level (as above): 2 here
                              XOR   E   ;   means the wrong closer
                              AND   6   
                              CP   2   
                              LD   A,D   
                              JR   Z,sq7   
0458                          ENDIF      
0458                          IF   QK   
                                 ; The closer at this level: remember the skip (if it started in the program
                                 ; text), and return A = 0 for ")" or 2 for "]".
                              PUSH   AF   
                              PUSH   HL   
                              LD   HL,(SKPL)   
                              LD   A,H   
                              CP   PROG/256   
                              JR   C,sq9   
                              LD   A,L   
                              ADD   A,A   
                              ADD   A,A   
                              LD   E,A   
                              LD   D,CPAGE   
                              LD   A,L   
                              LD   (DE),A   
                              INC   E   
                              LD   A,H   
                              LD   (DE),A   
                              INC   E   
                              LD   A,C   
                              LD   (DE),A   
                              INC   E   
                              LD   A,B   
                              LD   (DE),A   
                    SQ9:      POP   HL   
                              POP   AF   
                              RET      
                                 ; skclr: empty the skip cache (a start of 0000h matches no skip). Keeps HL.
                    SKCLR:    PUSH   HL   
                              LD   HL,CPAGE*256   
                    SKC1:     LD   (HL),0   
                              INC   L   
                              JR   NZ,skc1   
                              POP   HL   
                              RET      
0458                          ENDIF      
0458                             ;  ---- Speed-ups (base builds) -------------------------------------------
0458                             ;  The skip cache is above. These are the handlers' tails that the builds with
0458                             ;  room take, kept here, out of the handlers' first two pages.
0458                          IF   QK   
                                 ; "*" with an operand below 256 takes 8 rounds, not 16: that one becomes the
                                 ; multiplier (most multiplications have one, a count or a small constant).
                    MULQ:     LD   A,H   
                              OR   A   
                              JR   Z,mq8   ; the multiplier is below 256
                              LD   A,D   
                              OR   A   
                              JR   NZ,mq16   
                              EX   DE,HL   ; the multiplicand is: it becomes the multiplier
0458                          ENDIF      
0458                          IF   QK*(1-FAST)   
                    MQ8:      LD   A,L   
                              LD   HL,0   
                              PUSH   BC   
                              LD   B,8   
                    MQ1:      ADD   HL,HL   
                              RLA      
                              JR   NC,mq2   
                              ADD   HL,DE   
                    MQ2:      DJNZ   mq1   
                              POP   BC   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
                    MQ16:     PUSH   BC   ; 16 rounds; the multiplier shifts up through A:C
                              LD   A,H   
                              LD   C,L   
                              LD   HL,0   
                              LD   B,16   
                    MQ3:      ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mq4   
                              ADD   HL,DE   
                    MQ4:      DJNZ   mq3   
                              POP   BC   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
0458                          ENDIF      
0458                          IF   FAST   
                                 ; (the fast build: the same rounds, unrolled)
                    MQ8:      LD   A,L   
                              LD   HL,0   
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur0   
                              ADD   HL,DE   
                    MUR0:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur1   
                              ADD   HL,DE   
                    MUR1:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur2   
                              ADD   HL,DE   
                    MUR2:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur3   
                              ADD   HL,DE   
                    MUR3:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur4   
                              ADD   HL,DE   
                    MUR4:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur5   
                              ADD   HL,DE   
                    MUR5:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur6   
                              ADD   HL,DE   
                    MUR6:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur7   
                              ADD   HL,DE   
                    MUR7:        
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
                    MQ16:     PUSH   BC   
                              LD   A,H   
                              LD   C,L   
                              LD   HL,0   
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus0   
                              ADD   HL,DE   
                    MUS0:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus1   
                              ADD   HL,DE   
                    MUS1:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus2   
                              ADD   HL,DE   
                    MUS2:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus3   
                              ADD   HL,DE   
                    MUS3:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus4   
                              ADD   HL,DE   
                    MUS4:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus5   
                              ADD   HL,DE   
                    MUS5:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus6   
                              ADD   HL,DE   
                    MUS6:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus7   
                              ADD   HL,DE   
                    MUS7:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus8   
                              ADD   HL,DE   
                    MUS8:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus9   
                              ADD   HL,DE   
                    MUS9:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus10   
                              ADD   HL,DE   
                    MUS10:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus11   
                              ADD   HL,DE   
                    MUS11:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus12   
                              ADD   HL,DE   
                    MUS12:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus13   
                              ADD   HL,DE   
                    MUS13:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus14   
                              ADD   HL,DE   
                    MUS14:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus15   
                              ADD   HL,DE   
                    MUS15:       
                              POP   BC   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
0458                          ENDIF      
0458                          IF   QK   
                                 ; A true ")" reads the block start where it is, on top of the return stack,
                                 ; instead of popping it and pushing it back; the break key is looked at as
                                 ; rpushn would.
                    CLOSEQ:   LD   C,(IY+0)   
                              LD   B,(IY+1)   
                              PUSH   HL   
                              LD   HL,PCNT   
                              DEC   (HL)   
                              POP   HL   
                              CALL   Z,pollk   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
0458                          ENDIF      
0458                          IF   SBASEU   
                                 ; a-z, in the unchecked builds: a variable followed by "@" or "!" is fetched
                                 ; or stored in the same step (x@ is the commonest pair in most programs).
                                 ; (A checked build checks the stacks between the two, so it keeps them apart.)
                    LOWQ:     ADD   A,A   
                              LD   E,A   
                              LD   D,LETPAGE   ; DE -> the cell
                              LD   A,(BC)   
                              CP   "@"   
                              JR   Z,lwf   
                              CP   "!"   
                              JR   Z,lws   
                              PUSH   HL   
                              EX   DE,HL   ; TOS = the cell's address
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
                    LWF:      INC   BC   ; x@: TOS = the cell's value
                              PUSH   HL   
                              EX   DE,HL   
                              LD   E,(HL)   
                              INC   L   
                              LD   D,(HL)   
                              EX   DE,HL   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
                    LWS:      INC   BC   ; x!: the cell = TOS, and NOS comes up
                              EX   DE,HL   
                              LD   (HL),E   
                              INC   L   
                              LD   (HL),D   
                              POP   HL   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
0458                          ENDIF      
0458                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)*QK   
                    QSTART:   LD   BC,PROG   ; the generic reset goes on here: the IP,
                              CALL   skclr   ;   an empty skip cache, and the rest of the
                              JP   st0   ;   startup
0458                          ENDIF      
0458                          IF   (1-CPM)*(1-EDITOR)*CHECKED*QK   
                    QINIT:    CALL   skclr   ; (keeps A, which init wants 0)
                              JP   init   
0458                          ENDIF      
0458                             ; =============================================================================
0458                             ;  Dispatch table: the low byte of each handler's address, in code order
0458                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
0458                             ;  It must not cross a page (the dispatcher only adds to its low byte).
0458                             ; =============================================================================
0458                             ; The handlers of the first NPG1 characters start in the image's second page.
0458                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
0458                             ; differs between the builds, so the count is worked out here.
0458                             ; (One division to a line: asm80 only rounds down when it stores a value.)
0458                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
0458                PGBRK:    EQU   (h_break-BASE)/256   
0458                PGDEF:    EQU   (h_def-BASE)/256   
0458                PGFET:    EQU   (h_fetch-BASE)/256   
0458                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
0458                          IF   (1-TABP0)*(1-PTLATE)   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0458                          ENDIF      
0458                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
0458                             ; and return its value in A with the carry set; otherwise leave the IP and
0458                             ; return with the carry clear.
0458   0A           HEXC:     LD   A,(BC)   
0459   D6 30                  SUB   "0"   
045B   FE 0A                  CP   10   
045D   38 09                  JR   C,hc1   
045F   E6 DF                  AND   0DFh   
0461   D6 11                  SUB   11h   
0463   FE 06                  CP   6   
0465   D0                     RET   NC   
0466   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
0468   03           HC1:      INC   BC   
0469   C9                     RET      
046A                             ; psgn: print HL as a signed number. Keeps BC.
046A   CB 7C        PSGN:     BIT   7,H   
046C   28 07                  JR   Z,pdec   
046E                          ;*Macro unroll:  PUTK    2Dh             ; '-'
046E                          DS   1-CPM,3Eh   ; "-"
046E                          DS   1-CPM,2Dh   
046E                          DS   1-CPM,0EFh   
046E   CD                     DS   CPM,0CDh   
046F   0E                     DS   CPM,APTK&0FFh   
0470   05                     DS   CPM,APTK/256   
0471   2D                     DS   CPM,2Dh   
0472                          ;*Macro unroll:  NEGH
0472                          DS   1-CPM,0E7h   
0472   CD                     DS   CPM,0CDh   
0473   F1                     DS   CPM,ANEG&0FFh   
0474   04                     DS   CPM,ANEG/256   
0475                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
0475                             ; Keeps BC.
0475   11 0A 00     PDEC:     LD   DE,10   
0478   CD CA 03               CALL   udiv   ; HL = HL / 10, E = the last digit
047B   7B                     LD   A,E   
047C   F5                     PUSH   AF   
047D   7C                     LD   A,H   
047E   B5                     OR   L   
047F   C4 75 04               CALL   NZ,pdec   
0482   F1                     POP   AF   
0483   C6 30                  ADD   A,"0"   
0485                          ;*Macro unroll:  PUTAR
0485                          DS   1-CPM,0EFh   
0485                          DS   1-CPM,0C9h   
0485   C3                     DS   CPM,0C3h   
0486   12                     DS   CPM,APUT&0FFh   
0487   05                     DS   CPM,APUT/256   
0488                             ; (The table goes here instead in the builds where, before psgn, it would
0488                             ; cross a page: PTLATE. If it would cross one here too, it starts on the next
0488                             ; page: PTPAD is 0 unless it must.)
0488                          IF   (1-TABP0)*PTLATE   
0488                PTPH:     EQU   $ & 0FFh   
0488                PTPX:     EQU   (PTPH + 31) / 256   
0488                PTPAD:    EQU   PTPX * (256 - PTPH)   
0488                          DS   PTPAD   
0488                PTAB:        
0488                          ;*Macro unroll:  PTABLE
0488   B4                     DB   h_store & 0FFh   
0489   BE                     DB   h_str & 0FFh   
048A   DA                     DB   h_num & 0FFh   
048B   CA                     DB   h_print & 0FFh   
048C   A9                     DB   h_swap & 0FFh   
048D   49                     DB   h_and & 0FFh   
048E   D3                     DB   h_emit & 0FFh   
048F   1C                     DB   h_open & 0FFh   
0490   24                     DB   h_close & 0FFh   
0491   6C                     DB   h_mul & 0FFh   
0492   3C                     DB   h_add & 0FFh   
0493   F8                     DB   h_cfetch & 0FFh   
0494   32                     DB   h_sub & 0FFh   
0495   AC                     DB   h_cstore & 0FFh   
0496   81                     DB   h_div & 0FFh   
0497   A6                     DB   h_dup & 0FFh   
0498   B1                     DB   h_drop & 0FFh   
0499   52                     DB   h_lt & 0FFh   
049A   62                     DB   h_eq & 0FFh   
049B   53                     DB   h_gt & 0FFh   
049C   E0                     DB   h_key & 0FFh   
049D   16                     DB   h_fetch & 0FFh   
049E   F1                     DB   h_def & 0FFh   
049F   E1                     DB   h_break & 0FFh   
04A0   DA                     DB   h_ret & 0FFh   
04A1   69                     DB   h_xor & 0FFh   
04A2   81                     DB   h_alloc & 0FFh   
04A3   C2                     DB   h_grave & 0FFh   
04A4   BE                     DB   h_tor & 0FFh   
04A5   72                     DB   h_or & 0FFh   
04A6   06                     DB   h_fromr & 0FFh   
04A7   7B                     DB   h_not & 0FFh   
04A8                PTABEND:      
04A8                          ENDIF      
04A8                             ; =============================================================================
04A8                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
04A8                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
04A8                             ;  (RST 28h) prints A. Both keep BC, DE, HL and IY. In the generic build
04A8                             ;  they are the host's KEY and CONOUT routines themselves.
04A8                             ; 
04A8                             ;  A running program reads the keyboard only through getk and pollk, which
04A8                             ;  between them give the break key its rules:
04A8                             ;    - Ctrl-C stops the program;
04A8                             ;    - any other key that the break check reads is held in KEYBUF for the
04A8                             ;      next "?", and a newer one takes its place;
04A8                             ;    - "?" (getk) takes the held key first;
04A8                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
04A8                             ;      key like any other, but two of them within about 250 ms still stop it.
04A8                             ;  Both are called straight from a handler, never from a routine under one:
04A8                             ;  the checked build's report counts on finding one return address above the
04A8                             ;  data stack.
04A8                             ; =============================================================================
04A8                          IFN   CPM   
                    RAWK:     EQU   KEY   
04A8                          ENDIF      
04A8                             ; pollk: the break check (see rpushn).
04A8   CD 0A 05     POLLK:    CALL   rawk   
04AB   C8                     RET   Z   ; no key
04AC   32 7A 09               LD   (KEYBUF),A   ; held for the next "?"
04AF   FE 03        PK1:      CP   3   ; (getk joins here)
04B1   C0                     RET   NZ   
04B2                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
04B2                             ; the program has turned it off, wait about 250 ms for one more key: a
04B2                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
04B2                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
04B2   3A 7B 09     CTLC:     LD   A,(BRKOFF)   
04B5   B7                     OR   A   
04B6   CA 8F 05     CT0:      JP   Z,brk   
04B9   D5                     PUSH   DE   
04BA   11 E8 03               LD   DE,250*MSLOOP   
04BD   CD 0A 05     CT1:      CALL   rawk   
04C0   20 05                  JR   NZ,ct2   
04C2   1B                     DEC   DE   
04C3   7A                     LD   A,D   
04C4   B3                     OR   E   
04C5   20 F6                  JR   NZ,ct1   
04C7   D1           CT2:      POP   DE   ; A = the second key, or 0 if none came
04C8   FE 03                  CP   3   
04CA   28 EA                  JR   Z,ct0   ; (the zero flag takes the JP there)
04CC   B7                     OR   A   
04CD   28 03                  JR   Z,ct3   
04CF   32 7A 09               LD   (KEYBUF),A   
04D2   3E 03        CT3:      LD   A,3   
04D4   B7                     OR   A   
04D5   C9                     RET      
04D6                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
04D6   E5           GETK:     PUSH   HL   ; a held key goes first, and is taken out of
04D7   21 7A 09               LD   HL,KEYBUF   ;   the buffer
04DA   7E                     LD   A,(HL)   
04DB   36 00                  LD   (HL),0   
04DD   E1                     POP   HL   
04DE   B7                     OR   A   
04DF   C0                     RET   NZ   
04E0   CD 0A 05               CALL   rawk   
04E3   C8                     RET   Z   
04E4   18 C9                  JR   pk1   ; Ctrl-C? If not, that is the key
04E6                          IF   (1-CHECKED)*(1-EDITOR)   
                    BRK:      EQU   endprog   ; the unchecked build stops without a word
04E6                          ENDIF      ;   (with the editor, both stacks are cleared);
04E6                          IF   (1-CHECKED)*EDITOR   
                    BRK:      EQU   edit0   
04E6                          ENDIF      
04E6                          IF   CHECKED   
04E6                BRK:      EQU   e_break   ;   the checked build reports B
04E6                          ENDIF      
04E6                          IF   CPM   
04E6                             ; The routines a generic build keeps in page zero (see there). Here they are
04E6                             ; out of the way of the handlers, which must fit in the image's first two
04E6                             ; pages.
04E6   FD 5E 00     RPOP:     LD   E,(IY+0)   ; pop the return stack into DE
04E9   FD 56 01               LD   D,(IY+1)   
04EC   FD 23                  INC   IY   
04EE   FD 23                  INC   IY   
04F0   C9                     RET      
04F1   AF           NEG16:    XOR   A   ; HL = -HL (keeps BC, DE)
04F2   95                     SUB   L   
04F3   6F                     LD   L,A   
04F4   9F                     SBC   A,A   
04F5   94                     SUB   H   
04F6   67                     LD   H,A   
04F7   C9                     RET      
04F8                          ENDIF      
04F8                          IF   CPM*CHECKED   ; (the checked builds need the room)
04F8   FD 22 34 09  EXEC:     LD   (RSAVE),IY   ; machine code may change IX and IY
04FC   CD C1 01               CALL   jphl   
04FF   FD 2A 34 09            LD   IY,(RSAVE)   
0503                          ;*Macro unroll:  SETIX
0503   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0504   21                     DS   CPM+FAST-CPM*FAST,21h   
0505   14                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
0506   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
0507   E1                     POP   HL   
0508                          ;*Macro unroll:  NEXT
0508                          DS   (1-CPM)*(1-FAST),0F7h   
0508   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0509   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
050A                          ENDIF      
050A                          IF   CPM   
050A   3E FF        RAWK:     LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
050C   18 04                  JR   putc   
050E   E3           PUTK:     EX   (SP),HL   ; print the byte after the CALL
050F   7E                     LD   A,(HL)   
0510   23                     INC   HL   
0511   E3                     EX   (SP),HL   
0512                             ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
0512                             ; printing and could swallow a key that BDOS 6 then never sees.
0512                             ; It keeps every register but A and the flags: BDOS may change any of them
0512                             ; (IX and IY too, in a Z80 BDOS or BIOS).
0512   C5           PUTC:     PUSH   BC   
0513   D5                     PUSH   DE   
0514   E5                     PUSH   HL   
0515   DD E5                  PUSH   IX   
0517   FD E5                  PUSH   IY   
0519   5F                     LD   E,A   
051A   0E 06                  LD   C,6   
051C   CD 05 00               CALL   BDOS   
051F   FD E1                  POP   IY   
0521   DD E1                  POP   IX   
0523   E1                     POP   HL   
0524   D1                     POP   DE   
0525   C1                     POP   BC   
0526   B7                     OR   A   ; (for getk)
0527   C9                     RET      
0528                          ENDIF      
0528                             ; =============================================================================
0528                             ;  Checked build: the checks and the error report
0528                             ; =============================================================================
0528                          IF   CHECKED   
0528                             ; chkstk: both stacks are checked once per character, not in every handler.
0528                             ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
0528                             ; the constant carries if it is above (cells were popped that were never
0528                             ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
0528                             ; a character late at most: the bytes above DSTOP and the guard band below
0528                             ; the page take what happens meanwhile. DE is free between characters.
0528   EB           CHKSTK:   EX   DE,HL   
0529   21 05 F7               LD   HL,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
052C   39                     ADD   HL,SP   
052D   EB                     EX   DE,HL   
052E   38 1E                  JR   C,e_under   
0530   14                     INC   D   
0531   20 17                  JR   NZ,e_over   
0533   FD E5                  PUSH   IY   ; the return stack: in its page (or it has
0535   D1                     POP   DE   ;   overflowed), and not above its empty
0536   7A                     LD   A,D   ;   position (an underflow stays inside the
0537   FE 07                  CP   RSPAGE   ;   page, in the guard band)
0539   7B                     LD   A,E   
053A   20 0B                  JR   NZ,e_rover   
053C   FE E1                  CP   RSTOP&0FFh+1   
053E   D8                     RET   C   
053F   FD 21 E0 07            LD   IY,RSTOP   ; return stack underflow: it counts as empty
0543   3E 72                  LD   A,"r"   
0545   18 4A                  JR   errp   
0547   3E 52        E_ROVER:   LD   A,"R"   ; return stack overflow
0549   11                     DB   11h   ; (LD DE,nn hides the next entry)
054A   3E 53        E_OVER:   LD   A,"S"   ; data stack overflow
054C   18 43                  JR   errp   
054E   31 FC 08     E_UNDER:   LD   SP,DSTOP   ; data stack underflow: it counts as empty
0551   3E 73                  LD   A,"s"   
0553   18 56                  JR   error   
0555                             ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
0555                             ; was never defined still holds 0000h, and the byte there is a reserved one
0555                             ; in every build (AFh or C3h): if the IP is in page zero, this was a call of
0555                             ; an undefined word. The call is undone, so the place is the call itself.
0555   04           E_HI:     INC   B   
0556   10 4B                  DJNZ   e_resv   ; (B is as it was, and is not 0)
0558                          ;*Macro unroll:  POPR
0558                          DS   1-CPM,0CFh   
0558   CD                     DS   CPM,0CDh   
0559   E6                     DS   CPM,AROP&0FFh   
055A   04                     DS   CPM,AROP/256   
055B   42                     LD   B,D   
055C   4B                     LD   C,E   
055D   3E 55                  LD   A,"U"   
055F   18 4A                  JR   error   
0561                             ; chkhp: HL = the new heap top, DE = the old one, the carry is from adding
0561                             ; the count. Stop if the top is not below the limit page, or is below the
0561                             ; program's end.
0561                CHKHP:       
0561                          ENDIF      
0561                          IF   CHECKED*CPM   
0561                             ; With this much room a top that wrapped round can land back in
0561                             ; range, so the add is tested too: growing (A, the count's high
0561                             ; byte, is positive) must not carry, and releasing must.
0561   1F                     RRA      ; the carry comes in above the sign:
0562   C6 40                  ADD   A,40h   ;   bit 7 = carry XOR sign
0564   87                     ADD   A,A   
0565   38 10                  JR   C,e_heap   
0567   3A 07 00               LD   A,(0007h)   
056A   3D                     DEC   A   
056B   BC                     CP   H   
056C   38 09                  JR   C,e_heap   
056E                          ENDIF      
056E                          IF   CHECKED*(1-CPM)   
                                 ; (Here the program's space is under 32K, so a top that wrapped
                                 ; round always falls outside it.)
                              LD   A,H   
                              CP   HEAPLIM   
                              JR   NC,e_heap   
056E                          ENDIF      
056E                          IF   CHECKED   
056E   D5                     PUSH   DE   
056F   EB                     EX   DE,HL   
0570   2A 38 09               LD   HL,(NPEND)   
0573   19                     ADD   HL,DE   ; carry: at or above the program's end
0574   EB                     EX   DE,HL   
0575   D1                     POP   DE   
0576   D8                     RET   C   
0577   B7           E_HEAP:   OR   A   ; put the count back in TOS for the report
0578   ED 52                  SBC   HL,DE   
057A   3E 48                  LD   A,"H"   
057C   18 13                  JR   errp   
057E                             ; chkst: stop unless HL is in the program's own space: from the letter page
057E                             ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
057E                             ; whatever lies above the limit are safe. Memory above the heap top but
057E                             ; below the limit is the program's own: Tiny BASIC keeps its lines there.
057E                             ; It is the page of HL + 1 that is tested, so that one test serves both
057E                             ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
057E                             ; Keeps HL and BC. It runs on into its own error entry.
057E   23           CHKST:    INC   HL   
057F   7C                     LD   A,H   
0580   2B                     DEC   HL   
0581   FE 09                  CP   LETPAGE   
0583   38 07                  JR   C,e_store   
0585                          ENDIF      
0585                          IF   CHECKED*(1-CPM)   
                              CP   HEAPLIM   
                              RET   C   
0585                          ENDIF      
0585                          IF   CHECKED*CPM   
0585   5F                     LD   E,A   
0586   3A 07 00               LD   A,(0007h)   ; the BDOS page is the heap limit
0589   3D                     DEC   A   
058A   BB                     CP   E   
058B   D0                     RET   NC   
058C                          ENDIF      
058C                          IF   CHECKED   
058C                             ; Error entries. Each loads its letter and then hides the next entry inside
058C                             ; a 3-byte LD DE,nn (the 11h), so they all fall through to `error`.
058C   3E 4F        E_STORE:   LD   A,"O"   ; a store outside the program's space
058E   11                     DB   11h   
058F   3E 42        E_BREAK:   LD   A,"B"   ; Ctrl-C (found inside pollk or getk)
0591                             ; errp: an error found inside a routine: drop its return address first.
0591   D1           ERRP:     POP   DE   
0592   18 17                  JR   error   
0594                             ; e_dollar: "$" ran into a NUL (in prstr): Q, with the string's address
0594                             ; back in TOS. prstr"s return address goes first. But if "$' had no
0594                             ; address at all (the stack was empty), it is s, found now: chkstk, called
0594                             ; one cell up, sees the stack past its empty place then.
0594   D1           E_DOLLAR:   POP   DE   
0595   E1                     POP   HL   
0596   CD 28 05               CALL   chkstk   
0599   E5                     PUSH   HL   
059A   2A 34 09               LD   HL,(RSAVE)   
059D   11                     DB   11h   ; (LD DE,nn hides e_quote's first two bytes)
059E   44           E_QUOTE:   LD   B,H   ; an unclosed string: HL is its address, one
059F   4D                     LD   C,L   ;   past the opening quote, which is the place
05A0   3E 51                  LD   A,"Q"   
05A2   11                     DB   11h   
05A3   3E 58        E_RESV:   LD   A,"X"   ; a reserved byte outside a string
05A5   11                     DB   11h   
05A6   3E 5A        E_ZERO:   LD   A,"Z"   ; dividing by zero
05A8   11                     DB   11h   
05A9   3E 57        E_BRACK:   LD   A,"W"   ; bad character after [
05AB                             ; error: the report, then the end. A = the letter, BC = one past the place,
05AB                             ; HL = TOS, and both stacks as the report is to show them:
05AB                             ; 
05AB                             ;   Err X @ line,col
05AB                             ;   D:n: the top 8 cells at most, bottom to top
05AB                             ;   R:n
05AB   E5           ERROR:    PUSH   HL   ; now the whole data stack is in memory
05AC   5F                     LD   E,A   
05AD   CD 4D 03               CALL   pnl   
05B0   45 72 72 20 22         DB   "Err ",22h   
05B5   7B                     LD   A,E   
05B6                          ;*Macro unroll:  PUTA
05B6                          DS   1-CPM,0EFh   
05B6   CD                     DS   CPM,0CDh   
05B7   12                     DS   CPM,APUT&0FFh   
05B8   05                     DS   CPM,APUT/256   
05B9   CD 53 03               CALL   pmsg   
05BC   20 40 20 22            DB   " @ ",22h   
05C0   0B                     DEC   BC   ; BC = the place
05C1                             ; The line and column. A place below the program is in the line
05C1                             ; buffer: line 0. Otherwise count the LFs from the program's start;
05C1                             ; DE = the line's number, HL = where it starts.
05C1   21 80 09               LD   HL,LINEBUF   
05C4   11 00 00               LD   DE,0   
05C7   78                     LD   A,B   
05C8   FE 0A                  CP   PROG/256   
05CA   38 14                  JR   C,er3   
05CC   24                     INC   H   
05CD   6B                     LD   L,E   ; HL = PROG
05CE   13           ER1:      INC   DE   ; a new line starts at HL
05CF   E5                     PUSH   HL   
05D0   7D           ER2:      LD   A,L   
05D1   91                     SUB   C   
05D2   7C                     LD   A,H   
05D3   98                     SBC   A,B   
05D4   30 09                  JR   NC,er2x   ; reached the place
05D6   7E                     LD   A,(HL)   
05D7   23                     INC   HL   
05D8   FE 0A                  CP   10   
05DA   20 F4                  JR   NZ,er2   
05DC   F1                     POP   AF   
05DD   18 EF                  JR   er1   
05DF   E1           ER2X:     POP   HL   
05E0   C5           ER3:      PUSH   BC   
05E1   E5                     PUSH   HL   
05E2   EB                     EX   DE,HL   
05E3   CD 75 04               CALL   pdec   ; the line
05E6                          ;*Macro unroll:  PUTK    2Ch             ; ','
05E6                          DS   1-CPM,3Eh   ; ","
05E6                          DS   1-CPM,2Ch   
05E6                          DS   1-CPM,0EFh   
05E6   CD                     DS   CPM,0CDh   
05E7   0E                     DS   CPM,APTK&0FFh   
05E8   05                     DS   CPM,APTK/256   
05E9   2C                     DS   CPM,2Ch   
05EA   D1                     POP   DE   
05EB   E1                     POP   HL   
05EC   B7                     OR   A   
05ED   ED 52                  SBC   HL,DE   
05EF   23                     INC   HL   
05F0   CD 75 04               CALL   pdec   ; the column
05F3                             ; The two stack lines:  D:n: the top 8 cells at most, bottom to top
05F3                             ;                       R:n
05F3                             ; TOS is in memory with the rest (pushed) by now.
05F3   CD 4D 03               CALL   pnl   
05F6   44 3A 22               DB   "D:",22h   
05F9   21 FA 08               LD   HL,DSTOP-2   ; (DSTOP-2) - SP is twice the depth (the cell
05FC   ED 72                  SBC   HL,SP   ;   at DSTOP-2 was pushed with the first value
05FE                             ;   and holds nothing; pnl left the carry clear)
05FE   CD 46 06               CALL   phalf   ; the depth
0601                          ;*Macro unroll:  PUTK    3Ah             ; ':'
0601                          DS   1-CPM,3Eh   ; ":"
0601                          DS   1-CPM,3Ah   
0601                          DS   1-CPM,0EFh   
0601   CD                     DS   CPM,0CDh   
0602   0E                     DS   CPM,APTK&0FFh   
0603   05                     DS   CPM,APTK/256   
0604   3A                     DS   CPM,3Ah   
0605   79                     LD   A,C   
0606   FE 09                  CP   9   
0608   38 0A                  JR   C,er6   
060A   CD 53 03               CALL   pmsg   
060D   20 2E 2E 2E 22         DB   " ...",22h   
0612   0E 08                  LD   C,8   
0614   26 00        ER6:      LD   H,0   ; C = the number of cells to show
0616   69                     LD   L,C   
0617   29                     ADD   HL,HL   
0618   39                     ADD   HL,SP   ; HL -> just above the deepest of them
0619   0C                     INC   C   
061A   0D           ER7:      DEC   C   
061B   28 10                  JR   Z,er8   
061D   2B                     DEC   HL   
061E   56                     LD   D,(HL)   
061F   2B                     DEC   HL   
0620   5E                     LD   E,(HL)   
0621   E5                     PUSH   HL   
0622                          ;*Macro unroll:  PUTK    20h             ; ' '
0622                          DS   1-CPM,3Eh   ; " "
0622                          DS   1-CPM,20h   
0622                          DS   1-CPM,0EFh   
0622   CD                     DS   CPM,0CDh   
0623   0E                     DS   CPM,APTK&0FFh   
0624   05                     DS   CPM,APTK/256   
0625   20                     DS   CPM,20h   
0626   EB                     EX   DE,HL   
0627   CD 6A 04               CALL   psgn   
062A   E1                     POP   HL   
062B   18 ED                  JR   er7   
062D   CD 4D 03     ER8:      CALL   pnl   
0630   52 3A 22               DB   "R:",22h   
0633   FD E5                  PUSH   IY   ; RSTOP - IY is under 256 (the pointer is
0635   E1                     POP   HL   ;   at most one entry below its page), so
0636   3E E0                  LD   A,RSTOP&0FFh   ;   the low bytes are enough
0638   95                     SUB   L   
0639   6F                     LD   L,A   
063A   26 00                  LD   H,0   
063C   CD 46 06               CALL   phalf   
063F   CD 4D 03               CALL   pnl   
0642   22                     DB   22h   
0643                          ENDIF      
0643                          IF   CHECKED*(1-EDITOR)   
0643   C3 11 01               JP   endprog   
0646                          ENDIF      
0646                          IF   CHECKED*EDITOR   
                              JR   edit0   ; back to the editor, with both stacks cleared
0646                          ENDIF      
0646                          IF   CHECKED   
0646                             ; phalf: print half of HL, and leave it in C.
0646   CB 3C        PHALF:    SRL   H   
0648   CB 1D                  RR   L   
064A   E5                     PUSH   HL   
064B   CD 75 04               CALL   pdec   
064E   C1                     POP   BC   
064F   C9                     RET      
0650                          ENDIF      
0650                             ; =============================================================================
0650                             ;  The line editor (EDITOR = 1)
0650                             ; 
0650                             ;  The interpreter starts here, and a program that ends comes back here.
0650                             ;  There is no prompt. It follows the spec's suggested standard for a line
0650                             ;  editor (docs/b8script.md, Environments). Type a line and press Return:
0650                             ; 
0650                             ;    n text    put the text in as line n; the lines from n on move down. A
0650                             ;              number past the end (or 0) adds the line at the end.
0650                             ;    n         take line n out
0650                             ;    anything else is run at once, as B8Script. (Start such a line with a
0650                             ;    space if it would begin with a digit.)
0650                             ; 
0650                             ;  A command key ends the line too, and takes what was typed as its argument:
0650                             ; 
0650                             ;    ^G        run the program
0650                             ;    n ^L      list from line n (no number: all of it). Any key holds the
0650                             ;              list until another key is pressed; Ctrl-C ends it.
0650                             ;    n ^E      put line n in the input line; Return puts it back, changed
0650                             ;    name ^R   read. CP/M: the file of that name (no name: the same file as
0650                             ;              last time). Generic: what is typed, or pasted, from now until
0650                             ;              ^Z replaces the program; it is not echoed.
0650                             ;    name ^W   write. CP/M: to that file (no name: the same file as last
0650                             ;              time). Generic: the text is printed, as it is.
0650                             ;    ^N        new: no program
0650                             ;    ^X        leave (to LEAVE)
0650                             ; 
0650                             ;  In the line: the left and right arrow keys move the cursor;
0650                             ;  a character goes in at the cursor; Backspace and DEL take out the one
0650                             ;  before it; Esc drops the line. Only CR, LF, BS and printing characters are
0650                             ;  sent to the terminal, so any terminal will do.
0650                             ; 
0650                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
0650                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
0650                             ;  125 characters; the one character after a line number separates it from
0650                             ;  the text and is not stored. The text is kept as it is typed, each line
0650                             ;  ending in CR LF, at PROG.
0650                             ; 
0650                             ;  What lasts from one line to the next: the program, the words, the
0650                             ;  variables and the data stack. An error or a break clears both stacks. The
0650                             ;  return stack starts empty for every line.
0650                             ; 
0650                             ;  Things to know:
0650                             ;    - Reset empties the program (generic builds).
0650                             ;    - A word's address points into the program, so run the program again
0650                             ;      after editing it.
0650                             ;    - Nothing is printed between a program's output and what is typed next.
0650                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
0650                             ;      a line that calls -n? and carries on afterwards runs what was typed.
0650                             ;      (The stored program never comes back to the line, so it may.)
0650                             ;    - The editor"s own keys are not the program"s: -n? is the plain line
0650                             ;      read of the other builds.
0650                             ; 
0650                             ;  The data stack is the CPU's stack, so the editor works on top of whatever
0650                             ;  the last line left there, with TOS pushed like the rest.
0650                             ; =============================================================================
0650                          IF   EDGEN   
                    INIT:        ; reset (A = 0)
0650                          ENDIF      
0650                          IF   EDGEN*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at 0, and
                                 ; every word cell holds 0000h, the address an undefined word is caught at
                                 ; (see e_hi).
                              LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
0650                          ENDIF      
0650                          IF   EDGEN   
                              JR   edit0   
0650                          ENDIF      
0650                          IF   EDITOR   
                                 ; Right arrow: one to the right, by printing the character there
                    RIGHT:    LD   A,L   
                              CP   E   
                              JR   Z,ed1   ; at the end
                              LD   A,(HL)   
                              INC   L   
                              JR   lf1   
                                 ; Esc: alone it drops the line. An arrow key sends Esc [ and a letter, so
                                 ; wait about 5 ms for a second key: after a "[" read on to the letter that
                                 ; ends the sequence, and act on C (right) and D (left).
                    ESC:      LD   BC,5*MSLOOP   
                    ES1:      CALL   rawk   
                              JR   NZ,es2   
                              DEC   BC   
                              LD   A,B   
                              OR   C   
                              JR   NZ,es1   
                              CALL   fin   ; no second key: the line is dropped
                              JR   edit   
                    ES2:      CP   "["   
                              JR   NZ,ed1   ; not a sequence known here
                    ES3:      CALL   ekey   
                              CP   40h   
                              JR   C,es3   ; (its parameters)
                              SUB   "C"   
                              JR   Z,right   
                              DEC   A   ; "D"?
                              JR   NZ,ed1   ; no: on into left
                                 ; Left arrow: the cursor goes one to the left
                    LEFT:     LD   A,L   
                              ADD   A,A   
                              JR   Z,ed1   ; (L = 80h: at the start)
                              DEC   L   
                              LD   A,8   
                              ;*Macro unroll: lf1:    PUTA
                    LF1:      DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              JR   ed1   
                                 ; edit0: reset, an error or a break: both stacks are cleared, and the cursor
                                 ;   is shown, in case the program had hidden it and could not show it again.
                                 ; skend: a program that ended inside skip: its return address goes.
                                 ; edend: a program that ended: TOS joins the rest of the data stack.
                    EDIT0:    LD   SP,DSTOP-2   ; empty (the cell that stands for TOS is pushed)
0650                          ENDIF      
0650                          IF   EDITOR*ANS   
                              XOR   A   ; (pshow wants the carry clear)
                              CALL   pshow   ; ESC [ ? 2 5 h
0650                          ENDIF      
0650                          IF   EDITOR*(1-ANS)   
                              LD   A,1   
                              CALL   CONCUR   ; show the cursor
0650                          ENDIF      
0650                          IF   EDITOR   
                              DB   21h   ; (LD HL,nn: steps over the next two bytes)
                    SKEND:    POP   DE   
                    EDEND:    PUSH   HL   
                                 ; edit: start a new input line.
                    EDIT:     LD   IY,RSTOP   ; the return stack is empty
                              ;*Macro unroll:  SETIX                   ; (a file read or written may have changed IX)
                              DS   CPM+FAST-CPM*FAST,0DDh   ; (a file read or written may have changed IX)
                              DS   CPM+FAST-CPM*FAST,21h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
                              LD   HL,0   
                              LD   (KEYBUF),HL   ; no key is held, and the break key is on
                              LD   (EDLN),HL   ; no line is being edited
                              LD   HL,LINEBUF   ; HL = the cursor,
                              LD   E,L   ;   E = the end of the line (its low byte)
                    ED1:      CALL   ekey   
                              CP   7Fh   
                              JR   Z,bsp   ; DEL
                              CP   " "   
                              JR   NC,insc   
                              CP   9   
                              JR   Z,insc   ; Tab is text
                              CP   8   
                              JR   Z,bsp   
                              CP   1Bh   
                              JR   Z,esc   
                              PUSH   HL   ; a command key? Look it up
                              LD   HL,cmds   
                              LD   B,NCMD   
                    ED2:      CP   (HL)   
                              INC   HL   
                              JR   Z,ed3   
                              INC   HL   
                              INC   HL   
                              DJNZ   ed2   
                              POP   HL   
                              JR   ed1   ; no: the key is ignored
                    ED3:      LD   A,(HL)   
                              INC   HL   
                              LD   H,(HL)   
                              LD   L,A   
                              EX   (SP),HL   ; the command's address: fin returns to it
                                 ; fin: end the input line: CR LF and a NUL after it, and a new line on the
                                 ; terminal. Leaves BC -> the line and HL -> the NUL.
                    FIN:      LD   H,LETPAGE   
                              LD   L,E   
                              LD   (HL),13   
                              INC   L   
                              LD   (HL),10   
                              DEC   L   
                              CALL   prl   ; (prints the CR LF)
                              LD   (HL),0   
                              LD   BC,LINEBUF   
                              RET      
                                 ; Backspace, DEL: the character before the cursor goes. The cursor moves
                                 ; left, the rest of the line moves down over it, and the last place (now a
                                 ; space) is printed over along with the rest.
                    BSP:      LD   A,L   
                              ADD   A,A   
                              JR   Z,ed1   ; at the start
                              DEC   L   
                              ;*Macro unroll:  PUTK    08h             ; backspace
                              DS   1-CPM,3Eh   ; backspace
                              DS   1-CPM,08h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,08h   
                              PUSH   HL   
                    BS1:      INC   L   
                              LD   A,(HL)   
                              DEC   L   
                              LD   (HL),A   
                              INC   L   
                              LD   A,L   
                              CP   E   
                              JR   NZ,bs1   
                              DEC   L   
                              LD   (HL)," "   
                              POP   HL   
                              LD   D,E   
                              DEC   E   
                              JR   ic2   
                                 ; A character goes in at the cursor: it ripples up through the rest of the
                                 ; line, the cursor moves on, and the rest is printed again.
                    INSC:     LD   B,A   
                              LD   A,E   
                              CP   0FDh   
                              JR   Z,ed1   ; the line is full: 125 characters
                              LD   A,B   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              PUSH   HL   
                    IC1:      LD   A,(HL)   
                              LD   (HL),B   
                              LD   B,A   
                              LD   A,L   
                              INC   L   
                              CP   E   
                              JR   NZ,ic1   
                              POP   HL   
                              INC   L   
                              INC   E   
                              LD   D,E   
                    IC2:      CALL   tail   
                              JR   ed1   
                                 ; tail: print the line from the cursor to D (a low byte), and bring the
                                 ; cursor back with backspaces. Nothing at all if the cursor is at D.
                    TAIL:     LD   C,L   
                    TA1:      LD   A,L   
                              CP   D   
                              JR   Z,ta2   
                              LD   A,(HL)   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              INC   L   
                              JR   ta1   
                    TA2:      LD   A,L   
                              CP   C   
                              RET   Z   
                              ;*Macro unroll:  PUTK    08h             ; backspace
                              DS   1-CPM,3Eh   ; backspace
                              DS   1-CPM,08h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,08h   
                              DEC   L   
                              JR   ta2   
                                 ; ekey: wait for a key
                    EKEY:     CALL   rawk   
                              JR   Z,ekey   
                              RET      
                                 ; The command keys, and where each goes (after fin).
                    CMDS:     DB   13   
                              DW   cret   
                              DB   7   ; ^G
                              DW   crun   
                              DB   12   ; ^L
                              DW   clist   
                              DB   5   ; ^E
                              DW   cedln   
                              DB   18   ; ^R
                              DW   cread   
                              DB   23   ; ^W
                              DW   cwrite   
                              DB   14   ; ^N
                              DW   cnew   
                              DB   24   ; ^X
                              DW   LEAVE   
                    NCMD:     EQU   8   
                                 ; ^N: no program
                    CNEW:     XOR   A   
                              LD   (PROG),A   
                    GED0:     JR   gedit   
                                 ; ^E: line n goes into the input line, to be changed. EDLN remembers which
                                 ; line it was: Return puts the text back in its place.
                    CEDLN:    CALL   rdnum   
                              PUSH   HL   
                              CALL   find   ; HL -> the line, or the NUL if there is none
                              POP   DE   
                              LD   A,(HL)   
                              OR   A   
                              JR   Z,ged0   
                              LD   (EDLN),DE   
                              LD   DE,LINEBUF   
                    CE1:      LD   A,(HL)   ; copy it, and show it, up to its CR (or LF)
                              CP   13   
                              JR   Z,ce2   
                              CP   10   
                              JR   Z,ce2   
                              LD   (DE),A   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              INC   HL   
                              INC   E   
                              LD   A,E   
                              CP   0FDh   ; (a longer line is cut at 125 characters)
                              JR   NZ,ce1   
                    CE2:      EX   DE,HL   ; the cursor is at the line's end
                              LD   E,L   
                              JP   ed1   
                                 ; Return. If ^E put a line here, the text goes back in its place. If not:
                                 ; a number and text is a line to put in, a number alone a line to take out,
                                 ; and anything else is run where it is.
                    CRET:     PUSH   HL   ; the end of what was typed
                              LD   HL,(EDLN)   
                              LD   A,H   
                              OR   L   
                              JR   Z,cr1   
                              PUSH   HL   
                              CALL   delln   
                              POP   HL   
                              JR   ins   
                    CR1:      CALL   rdnum   ; HL = the number it starts with, BC -> after
                              LD   A,C   ; C is still 80h if there was no number:
                              ADD   A,A   ;   only then is twice it 0
                              JR   Z,st0p   ; no number: run the line
                              LD   A,(BC)   
                              CP   13   
                              JR   NZ,cr2   
                              POP   DE   ; the number alone: take that line out
                              CALL   delln   
                              JR   gedit   
                    CR2:      INC   BC   ; step over the one character after the number
                                 ; Put the text at BC in as line n (in HL): open a gap of its length there,
                                 ; CR and LF included, and copy it in.
                    INS:      CALL   find   ; HL -> where it goes
                              POP   DE   ; the end of what was typed
                              LD   A,E   
                              SUB   C   ; A = the length of the text, with its CR LF
                              PUSH   BC   ; the text
                              LD   C,A   
                              LD   B,0   
                              PUSH   BC   ; its length
                              LD   D,H   
                              LD   E,L   ; DE = where it goes
                              XOR   A   
                              LD   C,A   ; BC = 0: CPIR looks as far as it needs to
                              CPIR      ; HL -> one past the program's NUL
                              SBC   HL,DE   ; the number of bytes to move up, NUL included
                              LD   B,H   
                              LD   C,L   
                              ADD   HL,DE   
                              DEC   HL   ; HL -> the NUL
                              EX   DE,HL   
                              EX   (SP),HL   ; HL = the length; where it goes is kept
                              PUSH   HL   
                              ADD   HL,DE   ; the NUL's new place
                              EX   DE,HL   
                              LDDR      ; move the rest of the program up
                              POP   BC   ; the length
                              POP   DE   ; where it goes
                              POP   HL   ; the text
                              LDIR      
                    GEDIT:    JP   edit   
                                 ; ^G: run the program. st0p: run the typed line (BC -> it).
                    CRUN:     LD   BC,PROG   
                              DB   3Eh   ; (LD A,n: steps over the POP)
                    ST0P:     POP   HL   ; (the end of what was typed)
                                 ; st0: start running at BC. The heap starts after the stored program's NUL.
                    ST0:      LD   HL,PROG   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
                              LD   (HEAP),HL   
0650                          ENDIF      
0650                          IF   EDITOR*QK   
                              CALL   skclr   ; every run starts with an empty skip cache
0650                          ENDIF      
0650                          IF   EDITOR*CHECKED   
                              ;*Macro unroll:  NEGH                    ; minus the heap's first address: '_' may not
                              DS   1-CPM,0E7h   ; minus the heap"s first address: "_' may not
                              DS   CPM,0CDh   
                              DS   CPM,ANEG&0FFh   
                              DS   CPM,ANEG/256   
                              LD   (NPEND),HL   ;   release below it
0650                          ENDIF      
0650                          IF   EDITOR   
                              POP   HL   ; TOS: the data stack is as the last line left it
                              ;*Macro unroll:  NEXT                    ; (its return address is thrown away)
                              DS   (1-CPM)*(1-FAST),0F7h   ; (its return address is thrown away)
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
                                 ; ^L: list from line n. DE = the number of the line at HL.
                    CLIST:    CALL   rdnum   ; HL = n, or 0 if there was none:
                              LD   A,H   
                              OR   L   
                              JR   NZ,li0   
                              INC   L   ;   then from line 1
                    LI0:      PUSH   HL   
                              CALL   find   
                              POP   DE   
                    LI1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,gedit   ; the end of the text
                              CALL   rawk   
                              JR   Z,li3   ; no key: carry on
                              CP   3   
                              CALL   NZ,ekey   ; any key but Ctrl-C: wait for one more
                              CP   3   
                              JR   Z,gedit   ; Ctrl-C, first or second, ends the list
                    LI3:      PUSH   HL   
                              PUSH   DE   
                              EX   DE,HL   
                              CALL   pdec   ; the line's number,
                              LD   A," "   
                              ;*Macro unroll:  PUTA                    ;   a space,
                              DS   1-CPM,0EFh   ;   a space,
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              POP   DE   
                              POP   HL   
                              INC   DE   
                              CALL   prl   ;   and the line
                              JR   li1   
                                 ; delln: take line n (in HL) out: copy everything after it down over it.
                    DELLN:    CALL   find   
                              LD   D,H   
                              LD   E,L   
                              CALL   nxl   ; HL -> the next line
                    DE1:      LD   A,(HL)   
                              LD   (DE),A   
                              INC   HL   
                              INC   DE   
                              OR   A   
                              JR   NZ,de1   
                              RET      
                                 ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
                                 ; of the text if there are fewer lines (or the number is 0). Keeps BC.
                    FIND:     EX   DE,HL   
                              LD   HL,PROG   
                    FI1:      DEC   DE   
                              LD   A,D   
                              OR   E   
                              RET   Z   
                              CALL   nxl   
                              JR   NZ,fi1   
                              RET      
                                 ; nxl: step HL over one line, to just past its LF (and return not-zero), or
                                 ; stop at the NUL that ends the text (and return zero).
                    NXL:      LD   A,(HL)   
                              OR   A   
                              RET   Z   
                              INC   HL   
                              CP   10   
                              JR   NZ,nxl   
                              OR   A   
                              RET      
                                 ; prl: print the line at HL, to its LF; HL -> just past it.
                    PRL:      LD   A,(HL)   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              LD   A,(HL)   
                              INC   HL   
                              CP   10   
                              JR   NZ,prl   
                              RET      
0650                          ENDIF      
0650                          IF   EDGEN   
                    GED1:     JP   edit   
                                 ; ^R, generic: what comes in from now until ^Z is the program. A CR is
                                 ; stored as CR LF; a LF right after a line end is dropped (it is the CR's
                                 ; own, or an empty line's), and a LF anywhere else ends a line too. A last
                                 ; line with no end is given one. Nothing is echoed, and there is no check
                                 ; for running out of memory.
                    CREAD:    LD   HL,PROG-1   
                              LD   (HL),10   ; (as if a line had just ended: the byte is
                              INC   HL   ;   the line buffer's last, and spare)
                    RD1:      CALL   ekey   
                              LD   C,A   
                              CP   1Ah   
                              JR   NZ,rd2   
                              LD   A,10   ; ^Z ends the last line, as a LF would
                    RD2:      CP   10   
                              JR   NZ,rd3   
                              DEC   HL   
                              CP   (HL)   
                              INC   HL   
                              JR   Z,rd4   ; straight after a line end: dropped
                              LD   A,13   ; anywhere else it ends the line
                    RD3:      LD   (HL),A   
                              INC   HL   
                              CP   13   
                              JR   NZ,rd4   
                              LD   (HL),10   ; after a CR goes a LF
                              INC   HL   
                    RD4:      LD   A,C   
                              CP   1Ah   
                              JR   NZ,rd1   
                              LD   (HL),0   
                              JR   ged1   
                                 ; ^W, generic: the text is printed as it is, for the terminal to capture.
                    CWRITE:   LD   HL,PROG   
                    CW1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,ged1   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              INC   HL   
                              JR   cw1   
0650                          ENDIF      
0650                          IF   EDITOR*CPM   
                    CFCB:     EQU   005Ch   ; the file's name is kept here, where the CCP
                                 ;   put the one from the command line
                                 ; ^W, CP/M: write the file: delete the old one, make it anew, write the
                                 ; text in records of 128 bytes, and close it. The text's NUL and the 127
                                 ; bytes after it are set to ^Z meanwhile, which pads the last record. (A
                                 ; full disk or directory is not noticed: the calls fail and that is all.)
                    CWRITE:   CALL   setname   
                              LD   C,19   ; delete
                              CALL   fbdos   
                              LD   C,22   ; make
                              CALL   fbdos   
                              LD   HL,PROG   
                              XOR   A   
                    CW1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,cw1   
                              DEC   HL   ; HL -> the NUL
                              PUSH   HL   
                              LD   B,128   
                    CW2:      LD   (HL),1Ah   
                              INC   HL   
                              DJNZ   cw2   
                              POP   HL   
                              LD   DE,PROG   
                    CW3:      LD   A,E   ; a record that starts before the end is written
                              SUB   L   
                              LD   A,D   
                              SBC   A,H   
                              JR   NC,cw4   
                              PUSH   HL   
                              LD   C,21   ; write, from where the record lies
                              CALL   frec   
                              POP   HL   
                              JR   cw3   
                    CW4:      LD   (HL),0   ; the NUL again
                              LD   C,16   ; close
                              CALL   fbdos   
                              JP   edit   
                                 ; frec: BDOS function C (read or write a record) with the 128 bytes at DE.
                                 ; Returns A = the BDOS's answer, HL = DE and DE = DE + 128.
                    FREC:     PUSH   DE   
                              PUSH   BC   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              POP   BC   
                              CALL   fbdos   
                              POP   DE   
                              LD   HL,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              RET      
                                 ; setname: if a name was typed (the line does not start with its CR), put it
                                 ; in the FCB: up to 8 characters, a dot, up to 3 more, in capitals. The drive
                                 ; is the current one. Then, name or no name, clear the FCB after the name,
                                 ; as it must be before a file is opened or made.
                    SETNAME:   LD   DE,LINEBUF   
                              LD   A,(DE)   
                              CP   13   
                              JR   Z,fcbclr   
                              LD   HL,CFCB   
                              LD   (HL),0   ; the current drive
                              LD   B,11   
                    SN1:      INC   L   
                              LD   (HL)," "   
                              DJNZ   sn1   
                              LD   L,CFCB+1   
                    SN2:      LD   A,(DE)   
                              INC   DE   
                              CP   13   
                              JR   Z,fcbclr   
                              CP   "."   
                              JR   NZ,sn3   
                              LD   L,CFCB+9   ; the type
                              JR   sn2   
                    SN3:      CP   "a"   
                              JR   C,sn4   
                              AND   5Fh   ; a capital
                    SN4:      LD   (HL),A   
                              INC   L   
                              JR   sn2   
                    FCBCLR:   LD   HL,CFCB+12   
                              LD   B,24   
                    FC1:      LD   (HL),0   
                              INC   HL   
                              DJNZ   fc1   
                              RET      
                                 ; fbdos: BDOS function C on the file
                    FBDOS:    LD   DE,CFCB   
                              JP   BDOS   
                                 ; ^R, CP/M: read the file. A name typed before the key is the file's name
                                 ; from now on. (On into load, which returns to edit.)
                    CREAD:    CALL   setname   
                              LD   HL,edit   
                              PUSH   HL   
                                 ; load: read the file into PROG. No such file: no program. The text ends at
                                 ; the file"s first ^Z (1Ah), which pads a text file"s last record; one more
                                 ; goes after the last record, so the search always stops. And every line
                                 ; must end in LF: a last line without one is given a CR LF. (The FCB is
                                 ; clear after its name: the CCP left it so, or setname did.)
                    LOAD:     LD   C,15   ; open (no such file: the first read fails
                              CALL   fbdos   ;   too)
                              LD   DE,PROG   
                    LD1:      LD   C,20   ; read the next 128 bytes
                              CALL   frec   
                              OR   A   
                              JR   Z,ld1   
                              LD   (HL),1Ah   ; (HL = where the record that failed would be)
                              LD   HL,PROG-1   
                              LD   A,10   ; (a file with no text needs nothing added)
                    TR1:      INC   HL   
                              LD   E,A   ; E = the character before this one
                              LD   A,(HL)   
                              CP   1Ah   
                              JR   NZ,tr1   
                              LD   A,E   
                              CP   10   
                              JR   Z,tr2   
                              LD   (HL),13   
                              INC   HL   
                              LD   (HL),10   
                              INC   HL   
                    TR2:      LD   (HL),0   
                              RET      
0650                          ENDIF      
0650                             ; =============================================================================
0650                          IF   CPM   
0650                             ; The RAM pages follow the image; the heap may grow to the BDOS.
0650                START:       
0650                          ENDIF      
0650                          IF   CPM*CHECKED*(1-EDITOR)   
0650                             ; Clear the lower half of the letter page (as the editor build does
0650                             ; at its start).
0650   21 00 09               LD   HL,LET   
0653   AF                     XOR   A   
0654   77           INI1:     LD   (HL),A   
0655   2C                     INC   L   
0656   F2 54 06               JP   P,ini1   ; +00h to +7Fh
0659                          ENDIF      
0659                          IF   CPM*(1-EDITOR)   
0659   11 5C 00               LD   DE,005Ch   ; open the file named on the command line
065C   0E 0F                  LD   C,15   ; (no such file: the first read fails too,
065E   CD 05 00               CALL   BDOS   ;   and the program is empty)
0661   11 00 0A               LD   DE,PROG   
0664   D5           LD1:      PUSH   DE   
0665   0E 1A                  LD   C,26   ; set the DMA address
0667   CD 05 00               CALL   BDOS   
066A   11 5C 00               LD   DE,005Ch   
066D   0E 14                  LD   C,20   ; read the next 128 bytes
066F   CD 05 00               CALL   BDOS   
0672   E1                     POP   HL   ; HL = the address this record went to
0673   B7                     OR   A   
0674   20 07                  JR   NZ,ld2   
0676   11 80 00               LD   DE,128   
0679   19                     ADD   HL,DE   
067A   EB                     EX   DE,HL   
067B   18 E7                  JR   ld1   
067D   36 00        LD2:      LD   (HL),0   ; the end of the file counts as NUL
067F   23                     INC   HL   ; the heap starts after it
0680   01 00 0A               LD   BC,PROG   ; the IP
0683                          ENDIF      
0683                          IF   CPM*(1-EDITOR)*QK   
                              CALL   skclr   ; an empty skip cache
0683                          ENDIF      
0683                          IF   CPM*(1-EDITOR)   
0683   C3 56 01               JP   st2   
0686                          ENDIF      
0686                          IF   FAST   
                                 ; =============================================================================
                                 ;  The fast build (SPEED = 2)
                                 ; 
                                 ;  The inner loop is a table: 256 entries, the low bytes of the handlers'
                                 ;  addresses in one page and the high bytes in the next. The dispatcher (at
                                 ;  next0, and inline, as NEXTF, at the end of the fast build's own entries,
                                 ;  so there is no jump back to it; the ordinary handlers end in JP (IX), with
                                 ;  IX = next0, as in the CP/M builds):
                                 ; 
                                 ;      LD A,(BC) / INC BC / EX DE,HL / LD L,A / LD H,DTAB/256 /
                                 ;      LD A,(HL) / INC H / LD H,(HL) / LD L,A / JP (HL)
                                 ; 
                                 ;  So every entry starts with TOS in DE, not HL. The punctuation entries are
                                 ;  thunks into the ordinary handlers (EX DE,HL / JP handler); the letters and
                                 ;  digits have one entry each, which knows its cell or its value already.
                                 ; =============================================================================
                    FTSTORE:   EX   DE,HL   ; !
                              JP   h_store   
                    FTSTR:    EX   DE,HL   ; "
                              JP   h_str   
                    FTNUM:    EX   DE,HL   ; #
                              JP   h_num   
                    FTPRINT:   EX   DE,HL   ; $
                              JP   h_print   
                    FTSWAP:   EX   DE,HL   ; %
                              JP   h_swap   
                    FTAND:    EX   DE,HL   ; &
                              JP   h_and   
                    FTEMIT:   EX   DE,HL   ; '
                              JP   h_emit   
                    FTOPEN:   EX   DE,HL   ; (
                              JP   h_open   
                    FTCLOSE:   EX   DE,HL   ; )
                              JP   h_close   
                    FTMUL:    EX   DE,HL   ; *
                              JP   h_mul   
                    FTADD:    EX   DE,HL   ; +
                              JP   h_add   
                    FTCFETCH:   EX   DE,HL   ; ,
                              JP   h_cfetch   
                    FTSUB:    EX   DE,HL   ; -
                              JP   h_sub   
                    FTCSTORE:   EX   DE,HL   ; .
                              JP   h_cstore   
                    FTDIV:    EX   DE,HL   ; /
                              JP   h_div   
                    FTDUP:    EX   DE,HL   ; :
                              JP   h_dup   
                    FTDROP:   EX   DE,HL   ; ;
                              JP   h_drop   
                    FTLT:     EX   DE,HL   ; <
                              JP   h_lt   
                    FTEQ:     EX   DE,HL   ; =
                              JP   h_eq   
                    FTGT:     EX   DE,HL   ; >
                              JP   h_gt   
                    FTKEY:    EX   DE,HL   ; ?
                              JP   h_key   
                    FTFETCH:   EX   DE,HL   ; @
                              JP   h_fetch   
                    FTDEF:    EX   DE,HL   ; [
                              JP   h_def   
                    FTBREAK:   EX   DE,HL   ; \
                              JP   h_break   
                    FTRET:    EX   DE,HL   ; ]
                              JP   h_ret   
                    FTXOR:    EX   DE,HL   ; ^
                              JP   h_xor   
                    FTALLOC:   EX   DE,HL   ; _
                              JP   h_alloc   
                    FTGRAVE:   EX   DE,HL   ; `
                              JP   h_grave   
                    FTTOR:    EX   DE,HL   ; {
                              JP   h_tor   
                    FTOR:     EX   DE,HL   ; |
                              JP   h_or   
                    FTFROMR:   EX   DE,HL   ; }
                              JP   h_fromr   
                    FTNOT:    EX   DE,HL   ; ~
                              JP   h_not   
                                 ; The commonest punctuation, written for the fast build: TOS in DE on the
                                 ; way in, and the dispatcher inline on the way out.
                    FS_ADD:      ; +
                              POP   HL   
                              ADD   HL,DE   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_SUB:      ; -
                              LD   A,(BC)   ; a digit next: a negative number
                              SUB   "0"   
                              CP   10   
                              JR   C,fs_neg   
                              POP   HL   
                              OR   A   
                              SBC   HL,DE   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_NEG:   EX   DE,HL   
                              JP   h_sub   
                    FS_DUP:      ; :
                              PUSH   DE   
                              EX   DE,HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_DROP:      ; ;
                              POP   HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_SWAP:      ; %
                              POP   HL   
                              PUSH   DE   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_FET:      ; @
                              EX   DE,HL   
                              LD   E,(HL)   
                              INC   HL   
                              LD   D,(HL)   
                              EX   DE,HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_CFET:      ; ,
                              LD   A,(DE)   
                              LD   L,A   
                              LD   H,0   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_LT:       ; <
                              POP   HL   ; a < b: HL = a, DE = b
                    FS_LT1:   LD   A,H   
                              XOR   80h   
                              LD   H,A   
                              LD   A,D   
                              XOR   80h   
                              LD   D,A   
                              SBC   HL,DE   ; carry if HL < DE
                              SBC   HL,HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_GT:       ; >
                              POP   HL   ; a > b  is  b < a
                              EX   DE,HL   
                              JP   fs_lt1   
                    FS_EQ:       ; =
                              POP   HL   
                              OR   A   
                              SBC   HL,DE   
                              LD   A,H   
                              OR   L   
                              CP   1   ; carry only if a - b = 0
                              SBC   HL,HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_AND:      ; &
                              POP   HL   
                              LD   A,H   
                              AND   D   
                              LD   H,A   
                              LD   A,L   
                              AND   E   
                              LD   L,A   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_OR:       ; |
                              POP   HL   
                              LD   A,H   
                              OR   D   
                              LD   H,A   
                              LD   A,L   
                              OR   E   
                              LD   L,A   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
