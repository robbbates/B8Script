0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Intel 8080
0000                             ;  Spec: docs/b8script.md (2026-11-24).
0000                             ;  Design follows the Z80 interpreter (z80/b8s-z80.asm), with 8080 opcodes
0000                             ;  only.
0000                             ; 
0000                             ;  The switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    CHECKED  0 = no checks (spec: the programmer is responsible)
0000                             ;             1 = starts with every variable at 0 and every word undefined,
0000                             ;                 and stops on every error in the spec's table (and Ctrl-C)
0000                             ;                 with a three-line report: the letter and the place as line
0000                             ;                 and column, and both stacks. See `error`.
0000                             ;    ANSI     what the console escapes of "$" (/00bbIC8= /| /` /~) do:
0000                             ;             1 = send ANSI (VT100) sequences through CONOUT
0000                             ;             0 = call the machine's own routines CONCLS, CONEOL, CONCUR and
0000                             ;                 CONAT (see the equates). The CP/M builds always send ANSI.
0000                             ;    SPEED    0 = small: the smallest build
0000                             ;             1 = base, the default: the speed-ups that cost bytes: a skip
0000                             ;                 cache, a faster skip, "*" and "/" quicker for small and
0000                             ;                 power-of-two operands, and more (see "Speed-ups")
0000                             ;             2 = fast: base and a dispatch table besides, with no size
0000                             ;                 limit (see "The fast build").
0000                             ; 
0000                             ;  In every build Ctrl-C stops a running program (an unchecked build stops
0000                             ;  without a word): see the console layer for the rules, the held key and
0000                             ;  the break-off cell.
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), I8080 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   1   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   0   ; 1 = checked build
0000                ANSI:     EQU   0   ; 1 = the console escapes send ANSI sequences
0000                SPEED:    EQU   2   ; 0 = small, 1 = base, 2 = fast (see "Speed-ups")
0000                FAST:     EQU   SPEED/2   ; (1: the fast build)
0000                SBASE:    EQU   SPEED-FAST*2   ; (1: the base build)
0000                ANS:      EQU   ANSI+CPM-ANSI*CPM   ; (CP/M: always ANSI)
0000                QK:       EQU   SBASE+FAST-SBASE*FAST   ; (the speed-ups: base, or the fast build)
0000                SBASEU:   EQU   QK*(1-CHECKED)*(1-FAST)   ; (and those that only the unchecked
0000                             ;  builds take; the fast build has its own)
0000                PTLATE:   EQU   SBASEU*(1-CPM)   ; (1: the table goes after psgn and pdec, not
0000                             ;   before the routines: wherever it doesn't
0000                             ;   cross a page. chktab.py says if it does)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the 8080"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  The return stack pointer has no register (the 8080 has no spare pair): it
0000                             ;  is the RAM word RSP. Only rpop, rpushd and ")" (and the checks) touch it.
0000                             ; 
0000                             ;  One-byte calls. In a generic build the routines used most are reached
0000                             ;  with RST, one byte instead of three. The source writes them as macros:
0000                             ; 
0000                             ;    POPR   RST 1  08h  rpop    pop the return stack into HL
0000                             ;    DROP   RST 3  18h  drp     drop TOS, then next character  (ends a handler)
0000                             ;    NEGH   RST 4  20h  neg16   HL = -HL
0000                             ;    PUTA   RST 5  28h  putc    print A
0000                             ;    NEXT   RST 6  30h  next0   next character                 (ends a handler)
0000                             ; 
0000                             ;  RST 3 and RST 6 never return: an RST is a CALL, so the first thing each
0000                             ;  of them does is POP D to throw the return address away.
0000                             ; 
0000                             ;  A CP/M build leaves page zero alone (CP/M keeps it for interrupts, and
0000                             ;  RomWBW's BIOS calls itself through RST 1): there the macros are CALLs, and
0000                             ;  DROP and NEXT are JMPs.
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; 
0000                             ;  The fast build (FAST) dispatches through a full table instead, and there
0000                             ;  NEXT and DROP are jumps outside page zero: see "The fast build".
0000                             ; 
0000                             ;  What the 8080 lacks, and what replaces it: no JR (JMP/Jcc), no DJNZ, no
0000                             ;  SBC HL (byte-wise SUB/SBB, or negate and DAD), no shifts on register pairs
0000                             ;  (DAD H doubles; RAL/RAR through A), no LDIR/CPIR (small loops).
0000                             ; -----------------------------------------------------------------------------
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (the top four bytes of the page are spare,
0000                             ;             so a full stack runs two bytes into the page below)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch, interpreter variables in the gaps, and the -n? line buffer
0000                             ;             at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The base and fast builds have a fifth, CPAGE, for the skip cache: the
0000                             ;  page at the heap limit (F000h) in a generic build, and under CP/M the
0000                             ;  first page after the image, before the return stack, so that the letter
0000                             ;  page is still the one just below the program text.
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack has a guard band: the data stack can
0000                             ;  overrun by a cell or two (and the calls made while it is full, the error
0000                             ;  report's included) into the top 32 bytes of the return-stack page, which
0000                             ;  are never used, and the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
0000                BDOS:     EQU   0005h   
0000                EXIT:     EQU   0000h   ; warm boot
0000                BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IFN   CPM   
                                 ; ---- generic machine: edit these to suit -----------------------------------
                    KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
                                 ;   waiting. The zero flag must match A
                                 ;   (end the routine with ORA A / RET).
                    CONOUT:   EQU   0FF03h   ; print the character in A
                    EXIT:     EQU   0FF09h   ; where to go when the program ends
                                 ;   KEY and CONOUT must preserve BC, DE and HL.
0000                          ENDIF      
0000                          IF   1-ANS   
                                 ; With ANSI = 0 the console escapes call these. All four must keep BC, and
                                 ; all but CONAT also HL. They may change A, DE and the flags.
                    CONCLS:   EQU   0FF0Ch   ; /{  clear the screen, the cursor to the top left
                    CONEOL:   EQU   0FF0Fh   ; /}  clear from the cursor to the end of the line
                    CONCUR:   EQU   0FF12h   ; /| and /`  show the cursor if A is not 0, hide
                                 ;     it if A = 0
                    CONAT:    EQU   0FF15h   ; /~  the cursor to row HL, column DE, both
                                 ;     counted from 0. May change A, DE and HL
0000                          ENDIF      
0000                          IFN   CPM   
                    RSPAGE:   EQU   80h   ; 8000h return stack
                    DSPAGE:   EQU   81h   ; 8100h data stack
                    LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
                    PROG:     EQU   8300h   ; where the loader puts the program text
                    HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
                    CPAGE:    EQU   HEAPLIM   ; the skip cache's page (QK builds): the page
                                 ;   at the heap limit, which the heap never reaches
                    BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                MSLOOP:   EQU   40-36*CPM   ; n? inner loop count for about 1 ms (1-255;
0000                             ; the wait for a second Ctrl-C uses it too):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine. CP/M: 4,
0000                             ; for a BDOS 6 call of about 280 us (an RC2014
0000                             ; with RomWBW and ZPM3). A .COM can be
0000                             ; patched: see TIMING.B8S.
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer
0000                RSP:      EQU   LET+34h   ; gap after Z: the return stack pointer;
0000                BRKCNT:   EQU   LET+36h   ;   the break check's countdown;
0000                NPEND:    EQU   LET+38h   ;   minus the address of the program's end
0000                             ;   (the heap"s first byte), for the checked "_';
0000                PSAVE:    EQU   LET+3Ah   ;   the checked build: the address "$" prints
0000                             ;   from, for a report
0000                KEYBUF:   EQU   LET+7Ah   ; gap after z: a key read by the break check and
0000                             ;   held for the next "?" (0: none);
0000                BRKOFF:   EQU   LET+7Bh   ;   the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FCh   ; empty data stack. The four bytes above it
0000                             ; are spare: a character can pop two cells
0000                             ; too many before the checked build sees it,
0000                             ; and the next call must not land on the
0000                             ; letter cells.
0000                             ; The five one-byte calls (see the header). asm80 can't nest IF, so these
0000                             ; are written with DS: a count of 0 writes nothing. DS can't take a label
0000                             ; that comes later, but EQU can, and DS can take that.
0000                AROP:     EQU   rpop   
0000                ADRP:     EQU   drp   
0000                ANEG:     EQU   neg16   
0000                APUT:     EQU   putc   
0000                ANXT:     EQU   next0   
0000                          IF   CHECKED   
                    ACHK:     EQU   chkstk   ; (for the fast build's dispatcher)
0000                          ENDIF      
0000                          IF   1-CHECKED   
0000                ACHK:     EQU   0   
0000                          ENDIF      
0000                          IF   FAST   
0000                DTPG:     EQU   DTAB/256   ; (the fast build"s table"s first page)
0000                          ENDIF      
0000                          IF   1-FAST   
                    DTPG:     EQU   0   
0000                          ENDIF      
0000                .macro POPR,
0000                             ; 
0000                 DS      1-CPM,0CFh      ;   RST 1
0000                 DS      CPM,0CDh        ;   CALL rpop
0000                 DS      CPM,AROP&0FFh
0000                 DS      CPM,AROP/256
0000                .endm
0000                 
0000                .macro DROP,
0000                             ; 
0000                 DS      (1-CPM)*(1-FAST),0DFh ; RST 3
0000                 DS      CPM*(1-FAST),0C3h ;   JMP drp
0000                 DS      CPM*(1-FAST),ADRP&0FFh
0000                 DS      CPM*(1-FAST),ADRP/256
0000                 DS      FAST,0E1h       ;   (fast build: POP H / JMP next0)
0000                 DS      FAST,0C3h
0000                 DS      FAST,ANXT&0FFh
0000                 DS      FAST,ANXT/256
0000                .endm
0000                 
0000                .macro DROPZ,
0000                             ; 
0000                 DS      1-CPM,0DFh      ;   there in every build (RST 3)
0000                 DS      CPM,0C3h        ;   JMP drp
0000                 DS      CPM,ADRP&0FFh
0000                 DS      CPM,ADRP/256
0000                .endm
0000                 
0000                .macro NEGH,
0000                             ; 
0000                 DS      1-CPM,0E7h      ;   RST 4
0000                 DS      CPM,0CDh        ;   CALL neg16
0000                 DS      CPM,ANEG&0FFh
0000                 DS      CPM,ANEG/256
0000                .endm
0000                 
0000                .macro PUTA,
0000                             ; 
0000                 DS      1-CPM,0EFh      ;   RST 5
0000                 DS      CPM,0CDh        ;   CALL putc
0000                 DS      CPM,APUT&0FFh
0000                 DS      CPM,APUT/256
0000                .endm
0000                 
0000                .macro NEXT,
0000                             ; 
0000                 DS      (1-CPM)*(1-FAST),0F7h ; RST 6
0000                 DS      CPM+FAST-CPM*FAST,0C3h ; JMP next0 (CP/M, and the fast build)
0000                 DS      CPM+FAST-CPM*FAST,ANXT&0FFh
0000                 DS      CPM+FAST-CPM*FAST,ANXT/256
0000                .endm
0000                 
0000                .macro NEXTZ,
0000                             ; 
0000                 DS      1-CPM,0F7h      ;   byte there in every build (RST 6)
0000                 DS      CPM,0C3h        ;   JMP next0
0000                 DS      CPM,ANXT&0FFh
0000                 DS      CPM,ANXT/256
0000                .endm
0000                 
0000                .macro NEXTF,
0000                             ; 
0000                 DS      FAST*CHECKED,0CDh ; (checked: CALL chkstk)
0000                 DS      FAST*CHECKED,ACHK&0FFh
0000                 DS      FAST*CHECKED,ACHK/256
0000                 DS      FAST,0Ah        ;   LDAX B
0000                 DS      FAST,03h        ;   INX B
0000                 DS      FAST,0EBh       ;   XCHG        (TOS to DE)
0000                 DS      FAST,6Fh        ;   MOV L,A
0000                 DS      FAST,26h        ;   MVI H,DTAB/256
0000                 DS      FAST,DTPG
0000                 DS      FAST,7Eh        ;   MOV A,M     (the low byte)
0000                 DS      FAST,24h        ;   INR H
0000                 DS      FAST,66h        ;   MOV H,M     (the high byte)
0000                 DS      FAST,6Fh        ;   MOV L,A
0000                 DS      FAST,0E9h       ;   PCHL
0000                .endm
0000                 
0000                .macro NEXTD,
0000                             ; 
0000                 DS      FAST*CHECKED,0EBh ; A checked build's chkstk wants it in HL)
0000                 DS      FAST*CHECKED,0CDh
0000                 DS      FAST*CHECKED,ACHK&0FFh
0000                 DS      FAST*CHECKED,ACHK/256
0000                 DS      FAST,0Ah
0000                 DS      FAST,03h
0000                 DS      FAST*CHECKED,0EBh
0000                 DS      FAST,6Fh
0000                 DS      FAST,26h
0000                 DS      FAST,DTPG
0000                 DS      FAST,7Eh
0000                 DS      FAST,24h
0000                 DS      FAST,66h
0000                 DS      FAST,6Fh
0000                 DS      FAST,0E9h
0000                .endm
0000                 
0000                .macro NEXTX,
0000                             ; 
0000                 DS      FAST*CHECKED,0CDh ; in a checked build and in DE unchecked)
0000                 DS      FAST*CHECKED,ACHK&0FFh
0000                 DS      FAST*CHECKED,ACHK/256
0000                 DS      FAST,0Ah
0000                 DS      FAST,03h
0000                 DS      FAST*CHECKED,0EBh
0000                 DS      FAST,6Fh
0000                 DS      FAST,26h
0000                 DS      FAST,DTPG
0000                 DS      FAST,7Eh
0000                 DS      FAST,24h
0000                 DS      FAST,66h
0000                 DS      FAST,6Fh
0000                 DS      FAST,0E9h
0000                .endm
0000                 
0000                .macro XCHGC,
0000                             ; 
0000                 DS      CHECKED,0EBh
0000                .endm
0000                 
0000                .macro NEXTQ,
0000                             ; 
0000                 DS      (1-CPM)*(1-FAST),0F7h ; build the dispatcher inline)
0000                 DS      CPM*(1-FAST),0C3h
0000                 DS      CPM*(1-FAST),ANXT&0FFh
0000                 DS      CPM*(1-FAST),ANXT/256
0000                 DS      FAST*CHECKED,0CDh
0000                 DS      FAST*CHECKED,ACHK&0FFh
0000                 DS      FAST*CHECKED,ACHK/256
0000                 DS      FAST,0Ah
0000                 DS      FAST,03h
0000                 DS      FAST,0EBh
0000                 DS      FAST,6Fh
0000                 DS      FAST,26h
0000                 DS      FAST,DTPG
0000                 DS      FAST,7Eh
0000                 DS      FAST,24h
0000                 DS      FAST,66h
0000                 DS      FAST,6Fh
0000                 DS      FAST,0E9h
0000                .endm
0000                 
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is just the start of the .COM file.
0000                             ; =============================================================================
0100                          .ORG   BASE   
0100                          IF   1-(1-CPM)*CHECKED   
0100   31 FC 15               LXI   SP,DSTOP   ; 00  reset, or the start of the .COM file
0103                          ENDIF      
0103   C3 E2 06               JMP   start   ; In the checked generic build this is at 0000h
0106                             ;   (and `start` sets SP): its first byte, C3h,
0106                             ;   is what an undefined word runs into, as
0106                             ;   CP/M's own JMP at 0000h is in a .COM: e_hi.
0106                          IF   (1-CPM)*CHECKED   
                              DB   0,0,0   ; 03  spare
0106                          ENDIF      
0106                          ;*Macro unroll: rdrop:  POPR                    ; 06  drop the top of the return stack, then
0106                RDROP:    DS   1-CPM,0CFh   ; 06  drop the top of the return stack, then
0106   CD                     DS   CPM,0CDh   
0107   0C                     DS   CPM,AROP&0FFh   
0108   01                     DS   CPM,AROP/256   
0109                          ;*Macro unroll:  DROPZ                   ;     drop TOS (a spent flag) and go on
0109                          DS   1-CPM,0DFh   ;     drop TOS (a spent flag) and go on
0109   C3                     DS   CPM,0C3h   
010A   1C                     DS   CPM,ADRP&0FFh   
010B   01                     DS   CPM,ADRP/256   
010C                             ; ---- RST 1: rpop: pop the return stack into HL (DE is lost) -----------------
010C   2A 34 16     RPOP:     LHLD   RSP   ; 08
010F   5E                     MOV   E,M   
0110   23                     INX   H   
0111   56                     MOV   D,M   
0112   23                     INX   H   
0113   22 34 16               SHLD   RSP   
0116   EB                     XCHG      
0117   C9                     RET      ; 13  (so RST 2 is not used)
0118   EB           H_TOR:    XCHG      ; 14  "{" TOS to the return stack; rpushd
0119   C3 BD 06               JMP   rpushd   ;     brings up the new TOS
011C                             ; ---- RST 3: drop TOS, then next ---------------------------------------------
011C                          IF   1-CPM   
                    RST18:    POP   D   ; 18  discard the RST's return address
011C                          ENDIF      
011C   E1           DRP:      POP   H   ;     new TOS = NOS
011D   C3 36 01               JMP   next0   
0120   E5           H_FROMR:   PUSH   H   ; 1D  "}" return stack to TOS
0121                          ;*Macro unroll:  POPR
0121                          DS   1-CPM,0CFh   
0121   CD                     DS   CPM,0CDh   
0122   0C                     DS   CPM,AROP&0FFh   
0123   01                     DS   CPM,AROP/256   
0124                          ;*Macro unroll:  NEXTZ
0124                          DS   1-CPM,0F7h   
0124   C3                     DS   CPM,0C3h   
0125   36                     DS   CPM,ANXT&0FFh   
0126   01                     DS   CPM,ANXT/256   
0127                             ; ---- RST 4: neg16: HL = -HL (keeps BC, DE) ----------------------------------
0127   AF           NEG16:    XRA   A   ; 20
0128   95                     SUB   L   
0129   6F                     MOV   L,A   
012A   9F                     SBB   A   
012B   94                     SUB   H   
012C   67                     MOV   H,A   
012D   C9                     RET      
012E   E9           JPHL:     PCHL      ; 27  (for the machine-code call)
012F                             ; ---- RST 5: putc: print A (keeps BC, DE, HL) --------------------------------
012F                          IFN   CPM   
                    RST28:       
                    PUTC:     JMP   CONOUT   ; 28
012F                          ENDIF      
012F                             ; exec: "`" with no hex digit after it: call the machine code at TOS. It
012F                             ; returns here, with its top cell on the stack: that becomes the new TOS.
012F   CD 2E 01     EXEC:     CALL   jphl   ; 2B
0132   E1                     POP   H   
0133                          ;*Macro unroll:  NEXTZ
0133                          DS   1-CPM,0F7h   
0133   C3                     DS   CPM,0C3h   
0134   36                     DS   CPM,ANXT&0FFh   
0135   01                     DS   CPM,ANXT/256   
0136                             ; ---- RST 6: next character --------------------------------------------------
0136                          IF   1-CPM   
                    RST30:    POP   D   ; 30  discard the RST's return address
0136                          ENDIF      
0136                             ; The dispatch table (see PTAB, where it is placed)
0136                .macro PTABLE,
0136                             ; 
0136                 DB      h_store & 0FFh  ; !
0136                 DB      h_str & 0FFh    ; "
0136                 DB      h_num & 0FFh    ; #
0136                 DB      h_print & 0FFh  ; $
0136                 DB      h_swap & 0FFh   ; %
0136                 DB      h_and & 0FFh    ; &
0136                 DB      h_emit & 0FFh   ; '
0136                 DB      h_open & 0FFh   ; (
0136                 DB      h_close & 0FFh  ; )
0136                 DB      h_mul & 0FFh    ; *
0136                 DB      h_add & 0FFh    ; +
0136                 DB      h_cfetch & 0FFh ; ,
0136                 DB      h_sub & 0FFh    ; -
0136                 DB      h_cstore & 0FFh ; .
0136                 DB      h_div & 0FFh    ; /
0136                 DB      h_dup & 0FFh    ; :
0136                 DB      h_drop & 0FFh   ; ;
0136                 DB      h_lt & 0FFh     ; <
0136                 DB      h_eq & 0FFh     ; =
0136                 DB      h_gt & 0FFh     ; >
0136                 DB      h_key & 0FFh    ; ?
0136                 DB      h_fetch & 0FFh  ; @
0136                 DB      h_def & 0FFh    ; [
0136                 DB      h_break & 0FFh  ; \
0136                 DB      h_ret & 0FFh    ; ]
0136                 DB      h_xor & 0FFh    ; ^
0136                 DB      h_alloc & 0FFh  ; _
0136                 DB      h_grave & 0FFh  ; `
0136                 DB      h_tor & 0FFh    ; {
0136                 DB      h_or & 0FFh     ; |
0136                 DB      h_fromr & 0FFh  ; }
0136                 DB      h_not & 0FFh    ; ~
0136                .endm
0136                 
0136                             ; =============================================================================
0136                             ;  The inner loop: read one character and sort it by range.
0136                             ; 
0136                             ;    00h          end of program
0136                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0136                             ;    30h-39h      digit: read a whole number
0136                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0136                             ;    61h-7Ah      a-z: push the address of that letter's cell
0136                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0136                             ; =============================================================================
0136                          ;*Macro unroll: next0:  NEXTF                   ; (the fast build: the table dispatcher)
0136                NEXT0:    DS   FAST*CHECKED,0CDh   ; (the fast build: the table dispatcher)
0136                          DS   FAST*CHECKED,ACHK&0FFh   
0136                          DS   FAST*CHECKED,ACHK/256   
0136   0A                     DS   FAST,0Ah   
0137   03                     DS   FAST,03h   
0138   EB                     DS   FAST,0EBh   
0139   6F                     DS   FAST,6Fh   
013A   26                     DS   FAST,26h   
013B   11                     DS   FAST,DTPG   
013C   7E                     DS   FAST,7Eh   
013D   24                     DS   FAST,24h   
013E   66                     DS   FAST,66h   
