0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Intel 8080
0000                             ;  Spec: docs/b8script.md (2026-11-23).
0000                             ;  Design follows the Z80 interpreter (z80/b8s-z80.asm), with 8080 opcodes
0000                             ;  only.
0000                             ; 
0000                             ;  Three switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    CHECKED  0 = no checks (spec: the programmer is responsible)
0000                             ;             1 = starts with every variable at 0 and every word undefined,
0000                             ;                 and stops on every error in the spec's table (and Ctrl-C)
0000                             ;                 with a four-line report: the letter and the place as line
0000                             ;                 and column, the text there, and both stacks. See `error`.
0000                             ;    ANSI     1 = the four console codes (`@ `^ `_ `?) send ANSI escape
0000                             ;                 sequences through CONOUT
0000                             ;             0 = they call four routines of the machine's own instead:
0000                             ;                 CONAT, CONCLS, CONEOL and CONCUR (see the equates)
0000                             ; 
0000                             ;  In every build Ctrl-C stops a running program (an unchecked build stops
0000                             ;  without a word): see the console layer for the rules, the held key and
0000                             ;  the break-off cell.
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), I8080 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   1   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   0   ; 1 = checked build
0000                ANSI:     EQU   1   ; 1 = the console codes send ANSI sequences
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the 8080"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  The return stack pointer has no register (the 8080 has no spare pair): it
0000                             ;  is the RAM word RSP. Only rpop, rpushd and ")" (and the checks) touch it.
0000                             ; 
0000                             ;  One-byte calls. The routines used most are reached with RST, one byte
0000                             ;  instead of three. (asm80 wants the vector number: RST 1 = RST 08h.)
0000                             ; 
0000                             ;    RST 1  08h  rpop    pop the return stack into HL
0000                             ;    RST 3  18h  drop    drop TOS, then next character     (ends a handler)
0000                             ;    RST 4  20h  neg16   HL = -HL
0000                             ;    RST 5  28h  putc    print A
0000                             ;    RST 6  30h  next    next character                    (ends a handler)
0000                             ; 
0000                             ;  RST 3 and RST 6 never return: an RST is a CALL, so the first thing each
0000                             ;  of them does is POP D to throw the return address away.
0000                             ; 
0000                             ;  The CP/M build can't own page zero, so the block from `vecs` to `vecend`
0000                             ;  (image addresses 0108h-0133h) is copied to 0008h-0033h when it starts. The
0000                             ;  code in that block has no jumps inside itself, so it works at either place.
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; 
0000                             ;  What the 8080 lacks, and what replaces it: no JR (JMP/Jcc), no DJNZ, no
0000                             ;  SBC HL (byte-wise SUB/SBB, or negate and DAD), no shifts on register pairs
0000                             ;  (DAD H doubles; RAL/RAR through A), no LDIR/CPIR (small loops).
0000                             ; -----------------------------------------------------------------------------
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (the top four bytes of the page are spare,
0000                             ;             so a full stack runs two bytes into the page below)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch, interpreter variables in the gaps, and the -n? line buffer
0000                             ;             at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack has a guard band: the data stack can
0000                             ;  overrun by a cell or two (and the calls made while it is full, the error
0000                             ;  report's included) into the top 32 bytes of the return-stack page, which
0000                             ;  are never used, and the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
0000                BDOS:     EQU   0005h   
0000                EXIT:     EQU   0000h   ; warm boot
0000                BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IFN   CPM   
                                 ; ---- generic machine: edit these to suit -----------------------------------
                    KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
                                 ;   waiting. The zero flag must match A
                                 ;   (end the routine with ORA A / RET).
                    CONOUT:   EQU   0FF03h   ; print the character in A
                    EXIT:     EQU   0FF09h   ; where to go when the program ends
                                 ;   KEY and CONOUT must preserve BC, DE and HL.
                    RSPAGE:   EQU   80h   ; 8000h return stack
                    DSPAGE:   EQU   81h   ; 8100h data stack
                    LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
                    PROG:     EQU   8300h   ; where the loader puts the program text
                    HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
                    BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-ANSI)   
                                 ; ---- generic machine with ANSI = 0: the console codes call these ------------
                    CONAT:    EQU   0FF0Ch   ; `@  cursor to row E, column L, both from 0
                                 ;     (DE and HL hold the whole cells). May
                                 ;     change A, DE and HL
                    CONCLS:   EQU   0FF0Fh   ; `^  clear the screen and home the cursor
                    CONEOL:   EQU   0FF12h   ; `_  clear from the cursor to the end of the line
                    CONCUR:   EQU   0FF15h   ; `?  cursor off if A = 0 (the zero flag is set
                                 ;     to match), on if not. May change A, DE, HL
                                 ;   All four must preserve BC; CONCLS and CONEOL also DE and HL.
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms (1-255;
0000                             ; the wait for a second Ctrl-C uses it too):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer
0000                RSP:      EQU   LET+34h   ; gap after Z: the return stack pointer;
0000                BRKCNT:   EQU   LET+36h   ;   the break check's countdown;
0000                NPEND:    EQU   LET+38h   ;   minus the address of the program's end
0000                             ;   (the heap"s first byte), for the checked "_'
0000                SEED:     EQU   LET+76h   ; gap after z: the random seed, the cell whose
0000                             ;   address `. gives. Nothing sets it at the
0000                             ;   start but the checked build's clearing;
0000                KEYBUF:   EQU   LET+7Ah   ;   a key read by the break check and
0000                             ;   held for the next "?" (0: none);
0000                BRKOFF:   EQU   LET+7Bh   ;   the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                LBHDR:    EQU   LET+7Eh   ; CP/M BDOS 10 header: max, count
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FCh   ; empty data stack. The four bytes above it
0000                             ; are spare: a character can pop two cells
0000                             ; too many before the checked build sees it,
0000                             ; and the next call must not land on the
0000                             ; letter cells.
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is the start of the .COM file, and 0108h-0133h is also copied to
0000                             ;  page zero (see the header).
0000                             ; =============================================================================
0100                          .ORG   BASE   
0100                          IF   1-(1-CPM)*CHECKED   
0100   31 FC 07               LXI   SP,DSTOP   ; 00  reset, or the start of the .COM file
0103                          ENDIF      
0103   C3 08 05               JMP   start   ; In the checked generic build this is at 0000h
0106                             ;   (and `start` sets SP): its first byte, C3h,
0106                             ;   is what an undefined word runs into, as
0106                             ;   CP/M's own JMP at 0000h is in a .COM: e_hi.
0106                          IF   (1-CPM)*CHECKED   
                              DB   0,0,0   ; 03  spare
0106                          ENDIF      
0106   CF           RDROP:    RST   1   ; 06  drop the top of the return stack, then
0107   DF                     RST   3   ;     drop TOS (a spent flag) and go on
0108                VECS:        
0108                             ; ---- RST 1: rpop: pop the return stack into HL (DE is lost) -----------------
0108   2A 34 08     RPOP:     LHLD   RSP   ; 08
010B   5E                     MOV   E,M   
010C   23                     INX   H   
010D   56                     MOV   D,M   
010E   23                     INX   H   
010F   22 34 08               SHLD   RSP   
0112   EB                     XCHG      
0113   C9                     RET      ; 13  (so RST 2 is not used)
0114   EB           H_TOR:    XCHG      ; 14  "{" TOS to the return stack; rpushd
0115   C3 AE 01               JMP   rpushd   ;     brings up the new TOS
0118                             ; ---- RST 3: drop TOS, then next ---------------------------------------------
0118   D1           RST18:    POP   D   ; 18  discard the RST's return address
0119   E1                     POP   H   ;     new TOS = NOS
011A   C3 34 01               JMP   next0   
011D   E5           H_FROMR:   PUSH   H   ; 1D  "}" return stack to TOS
011E   CF                     RST   1   
011F   F7                     RST   6   
0120                             ; ---- RST 4: neg16: HL = -HL (keeps BC, DE) ----------------------------------
0120   AF           NEG16:    XRA   A   ; 20
0121   95                     SUB   L   
0122   6F                     MOV   L,A   
0123   9F                     SBB   A   
0124   94                     SUB   H   
0125   67                     MOV   H,A   
0126   C9                     RET      
0127   E9           JPHL:     PCHL      ; 27  (for the machine-code call)
0128                             ; ---- RST 5: putc: print A (keeps BC, DE, HL) --------------------------------
0128                RST28:       
0128                          IFN   CPM   
                    PUTC:     JMP   CONOUT   ; 28
0128                          ENDIF      
0128                          IF   CPM   
0128   C3 FA 04               JMP   putc   ; 28
012B                          ENDIF      
012B                             ; exec: "`" with no hex digit after it: call the machine code at TOS. It
012B                             ; returns here, with its top cell on the stack: that becomes the new TOS.
012B   CD 27 01     EXEC:     CALL   jphl   ; 2B
012E   E1                     POP   H   
012F   F7                     RST   6   
0130                             ; ---- RST 6: next character --------------------------------------------------
0130   D1           RST30:    POP   D   ; 30  discard the RST's return address
0131                          IF   CPM   
0131   C3 34 01               JMP   next0   ; (this copy runs in page zero)
0134                          ENDIF      
0134                VECEND:      
0134                             ; =============================================================================
0134                             ;  The inner loop: read one character and sort it by range.
0134                             ; 
0134                             ;    00h          end of program
0134                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0134                             ;    30h-39h      digit: read a whole number
0134                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0134                             ;    61h-7Ah      a-z: push the address of that letter's cell
0134                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0134                             ; =============================================================================
0134                NEXT0:       
0134                          IF   CHECKED   
                              CALL   chkstk   ; both stacks are checked once per character
0134                          ENDIF      
0134   0A                     LDAX   B   
0135   03                     INX   B   
0136   D6 21                  SUI   21h   ; A = c - 21h
0138   DA 78 01               JC   ctl   ; c < 21h: NUL ends, the rest are ignored
013B   FE 0F                  CPI   0Fh   
013D   DA 68 01               JC   punct   ; 21h-2Fh: PTAB index 0-14
0140   D6 0F                  SUI   0Fh   ; A = c - 30h
0142   FE 0A                  CPI   0Ah   
0144   DA 33 03               JC   digit   ; 30h-39h
0147   FE 11                  CPI   11h   
0149   DA 66 01               JC   p3a   ; 3Ah-40h
014C   D6 11                  SUI   11h   ; A = c - 41h
014E   FE 1A                  CPI   1Ah   
0150   DA A4 01               JC   upper   ; 41h-5Ah: A = letter index 0-25
0153   FE 20                  CPI   20h   
0155   DA 64 01               JC   p5b   ; 5Bh-60h
0158   FE 3A                  CPI   3Ah   
015A   DA 9E 01               JC   lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
015D   FE 3E                  CPI   3Eh   
015F                          IF   CHECKED   
                              JZ   next0   ; 7Fh, DEL: ignored
                              JNC   e_hi   ; 80h-FFh: reserved
015F                          ENDIF      
015F                          IF   1-CHECKED   
015F   D2 34 01               JNC   next0   ; 7Fh-FFh: ignored
0162                          ENDIF      
0162   D6 1A                  SUI   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
0164   D6 09        P5B:      SUI   9   ; 5Bh-60h: -4 in all, index 22-27
0166   C6 05        P3A:      ADI   5   ; 3Ah-40h: index 15-21
0168                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
0168                             ; untouched, and A, DE free.
0168   C6 13        PUNCT:    ADI   PTAB & 0FFh   ; PTAB never crosses a page
016A   5F                     MOV   E,A   
016B   16 03                  MVI   D,PTAB / 256   
016D   FE 29                  CPI   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
016F   1A                     LDAX   D   
0170   5F                     MOV   E,A   ; the handler's low byte
0171                          IFN   CPM   
                              MVI   A,0   
                              RAL      ; its page: 0 + carry
0171                          ENDIF      
0171                          IF   CPM   
0171   3E 01                  MVI   A,1   
0173   CE 00                  ACI   0   ; its page: 1 + carry
0175                          ENDIF      
0175   57                     MOV   D,A   
0176   D5                     PUSH   D   ; jump to it; the stack is balanced again
0177   C9                     RET      ;   when the handler starts
0178                             ; ctl: characters below 21h. A = c - 21h.
0178   C6 21        CTL:      ADI   21h   ; back to c; zero only for NUL
017A   C2 34 01               JNZ   next0   ; the rest are ignored
017D   C3 00 00     ENDPROG:   JMP   EXIT   ; the program has ended
0180                             ; =============================================================================
0180                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
0180                             ;  (00bbIGFuZCA= are up among the RST routines.)
0180                             ; =============================================================================
0180   D1           H_XOR:    POP   D   
0181   7C                     MOV   A,H   
0182   AA                     XRA   D   
0183   67                     MOV   H,A   
0184   7D                     MOV   A,L   
0185   AB                     XRA   E   
0186   6F                     MOV   L,A   
0187   F7                     RST   6   
0188   D1           H_OR:     POP   D   
0189   7C                     MOV   A,H   
018A   B2                     ORA   D   
018B   67                     MOV   H,A   
018C   7D                     MOV   A,L   
018D   B3                     ORA   E   
018E   6F                     MOV   L,A   
018F   F7                     RST   6   
0190   E7           H_NOT:    RST   4   ; ~x = -x - 1
0191   2B                     DCX   H   
0192   F7                     RST   6   
0193                             ; "_" ( n -- addr ): the heap pointer moves by n, a signed count (the add is
0193                             ; the same either way); TOS is the old pointer.
0193   EB           H_ALLOC:   XCHG      
0194   2A 7C 08               LHLD   HEAP   
0197   E5                     PUSH   H   
0198   19                     DAD   D   ; the new top
0199                          IF   CHECKED   
                              CALL   chkhp   
0199                          ENDIF      
0199   22 7C 08               SHLD   HEAP   
019C   E1                     POP   H   
019D   F7                     RST   6   
019E                             ; ---- the letters and digits --------------------------------------------------
019E                             ; a-z: push the cell's address (the cell is the variable)
019E   E5           LOWER:    PUSH   H   
019F   87                     ADD   A   
01A0   6F                     MOV   L,A   
01A1   26 08                  MVI   H,LETPAGE   
01A3   F7                     RST   6   
01A4                             ; A-Z: call the word. The return address (the IP after the letter) goes on
01A4                             ; the return stack, and the IP becomes the address in the letter's cell.
01A4   E5           UPPER:    PUSH   H   ; keep TOS: rpushd pops it back
01A5   87                     ADD   A   
01A6   6F                     MOV   L,A   
01A7   26 08                  MVI   H,LETPAGE   ; HL -> cell
01A9   50                     MOV   D,B   
01AA   59                     MOV   E,C   ; DE = the return address
01AB   4E                     MOV   C,M   
01AC   23                     INX   H   
01AD   46                     MOV   B,M   ; IP = the word's body, and fall into rpushd
01AE                             ; rpushd: push DE on the return stack, then pop TOS off the data stack and
01AE                             ; go on. Every push of the return stack ends here: for a word call the cell
01AE                             ; popped is the TOS that upper parked; for "(" and "{" it is the cell under
01AE                             ; the one that was used up.
01AE                             ; 
01AE                             ; The break key is looked at here, so at every word call and loop-back (and
01AE                             ; block entry and "{"), but only one time in 256: BRKCNT counts them. Reading
01AE                             ; the keyboard can be slow (it is a BDOS call under CP/M).
01AE   2A 34 08     RPUSHD:   LHLD   RSP   
01B1   2B                     DCX   H   
01B2   72                     MOV   M,D   
01B3   2B                     DCX   H   
01B4   73                     MOV   M,E   
01B5   22 34 08               SHLD   RSP   
01B8   21 36 08               LXI   H,BRKCNT   
01BB   35                     DCR   M   
01BC   E1                     POP   H   ; (keeps the flags)
01BD   CC B5 04               CZ   pollk   
01C0   F7                     RST   6   
01C1                             ; ---- the grave -------------------------------------------------------------
01C1                             ; The grave is a prefix: with the character after it, it is one command.
01C1                             ; GTAB holds each character with the place of its handler, as a byte to add
01C1                             ; to gbase. The handler starts with HL = TOS, A = the character and the
01C1                             ; carry clear. A character that is not in the table is unsafe: the unchecked
01C1                             ; build searches on through memory, the checked build stops with W.
01C1   0A           H_GRAVE:   LDAX   B   
01C2   03                     INX   B   
01C3   E5                     PUSH   H   ; TOS
01C4   21 38 04               LXI   H,GTAB-1   
01C7   23           GR1:      INX   H   
01C8                          IF   CHECKED   
                              MOV   E,M   
                              INR   E   
                              JZ   gbad   ; FFh ends the table
01C8                          ENDIF      
01C8   BE                     CMP   M   
01C9   23                     INX   H   
01CA   C2 C7 01               JNZ   gr1   
01CD   5E                     MOV   E,M   
01CE   16 00                  MVI   D,0   
01D0   21 88 03               LXI   H,gbase   
01D3   19                     DAD   D   ; the handler
01D4   E3                     XTHL      ; TOS back, and jump there
01D5   C9                     RET      
01D6                             ; ---- where the two pages meet ----------------------------------------------
01D6                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
01D6                             ; are in falling code order for this), and where exactly differs between the
01D6                             ; builds: NPG1 follows. Every handler below these four must start in the
01D6                             ; second page, and every one above in the first; chktab.py checks both.
01D6                             ; "]" returns: pop an address and jump to it. TOS is parked on the stack
01D6                             ; while rpop uses HL, and the drop at the end brings it back.
01D6   E5           H_RET:    PUSH   H   
01D7   CF           RET2:     RST   1   
01D8   44                     MOV   B,H   
01D9   4D                     MOV   C,L   
01DA   DF                     RST   3   
01DB                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
01DB                             ; drops the block start, "]" returns. No closer at all ends the program.
01DB                             ; The flag stays in HL as the spent cell that rdrop and ret2 drop.
01DB   7C           H_BREAK:   MOV   A,H   
01DC   B5                     ORA   L   
01DD   CA C0 02               JZ   h_drop   ; false: just drop the flag
01E0   CD 6E 04               CALL   skip   
01E3   B7                     ORA   A   ; skip returns 0 for ")"
01E4   C2 D7 01               JNZ   ret2   
01E7   C3 06 01               JMP   rdrop   
01EA                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
01EA                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
01EA                             ; the body"s address instead. Either way it then skips to the matching "]'.
01EA                             ; (The unchecked build takes anything that is not a letter as the space; the
01EA                             ; checked build stops on it.)
01EA   0A           H_DEF:    LDAX   B   
01EB   03                     INX   B   
01EC   D6 41                  SUI   "A"   ; a letter gives 0-25 or 32-57: lowercase
01EE   5F                     MOV   E,A   ;   lands 64 bytes up
01EF   E6 DF                  ANI   0DFh   ; fold case
01F1   FE 1A                  CPI   26   
01F3   D2 03 02               JNC   def2   ; not a letter
01F6   7B                     MOV   A,E   
01F7   87                     ADD   A   
01F8   5F                     MOV   E,A   
01F9   16 08                  MVI   D,LETPAGE   ; DE -> cell
01FB   79                     MOV   A,C   
01FC   12                     STAX   D   
01FD   1C                     INR   E   
01FE   78                     MOV   A,B   
01FF   12                     STAX   D   
0200   C3 06 02               JMP   skipnx   
0203                DEF2:        
0203                          IF   CHECKED   
                              MOV   A,E   
                              CPI   " "-"A"+256   
                              JNZ   e_brack   ; anything but a letter or a space
0203                          ENDIF      
0203   E5                     PUSH   H   ; an anonymous block: push its address
0204   60                     MOV   H,B   
0205   69                     MOV   L,C   
0206                SKIPNX:      
0206                          IF   CHECKED   
                              DCX   B   ; back onto the letter, so that skip finds its
0206                          ENDIF      ;   opener, the "[", just before where it starts
0206   CD 6E 04     SKIPO:    CALL   skip   
0209   F7                     RST   6   
020A   5E           H_FETCH:   MOV   E,M   ; "@"
020B   23                     INX   H   
020C   56                     MOV   D,M   
020D   EB                     XCHG      
020E   F7                     RST   6   
020F                             ; =============================================================================
020F                             ;  Handlers that must start in the image's second page.
020F                             ;  "?" is the last (with "," inside it in the unchecked build), so its long
020F                             ;  tail may run past that page.
020F                             ; =============================================================================
020F                             ; ---- flow control ----------------------------------------------------------
020F                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
020F                             ; the matching ")".
020F   7C           H_OPEN:   MOV   A,H   
0210   B5                     ORA   L   
0211   E1                     POP   H   
0212   CA 06 02               JZ   skipo   
0215   E5                     PUSH   H   ; (rpushd pops it again)
0216   50                     MOV   D,B   
0217   59                     MOV   E,C   ; the block starts at the IP
0218   C3 AE 01               JMP   rpushd   
021B                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
021B                             ; drops it and carries on.
021B   7C           H_CLOSE:   MOV   A,H   
021C   B5                     ORA   L   
021D   CA 06 01               JZ   rdrop   
0220   CF                     RST   1   ; pop the block start ...
0221   44                     MOV   B,H   
0222   4D                     MOV   C,L   ; ... jump to it ...
0223   EB                     XCHG      
0224   C3 AE 01               JMP   rpushd   ; ... and push it back (which drops the flag)
0227                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
0227                             ; "-" has two jobs: directly before a digit it starts a negative number.
0227   0A           H_SUB:    LDAX   B   
0228   D6 30                  SUI   "0"   
022A   FE 0A                  CPI   10   
022C   DA 39 03               JC   negnum   
022F   E7                     RST   4   ; a - b = a + (-b): fall into "+"
0230   D1           H_ADD:    POP   D   
0231   19                     DAD   D   
0232   F7                     RST   6   
0233   D1           H_AND:    POP   D   
0234   7C                     MOV   A,H   
0235   A2                     ANA   D   
0236   67                     MOV   H,A   
0237   7D                     MOV   A,L   
0238   A3                     ANA   E   
0239   6F                     MOV   L,A   
023A   F7                     RST   6   
023B                             ; Signed compares. Both are "DE < HL" for the right pair: > swaps the two
023B                             ; cells first (XTHL), < doesn't. There is no overflow flag, so the signed
023B                             ; answer is the unsigned borrow of DE - HL, flipped when the signs differ.
023B                             ; SBB A turns a carry into -1 or 0 with no branch.
023B   E3           H_GT:     XTHL      ; a > b  is  b < a
023C   D1           H_LT:     POP   D   ; a < b: DE = a, HL = b
023D   7B                     MOV   A,E   
023E   95                     SUB   L   
023F   7A                     MOV   A,D   
0240   9C                     SBB   H   
0241   9F                     SBB   A   ; A = -1 if DE < HL unsigned
0242   6F                     MOV   L,A   
0243   7C                     MOV   A,H   
0244   AA                     XRA   D   
0245   17                     RAL      ; carry = the signs differ
0246   9F                     SBB   A   
0247   AD                     XRA   L   ; flip when they do
0248   67                     MOV   H,A   
0249   6F                     MOV   L,A   
024A   F7                     RST   6   
024B   D1           H_EQ:     POP   D   
024C   7D                     MOV   A,L   
024D   AB                     XRA   E   
024E   6F                     MOV   L,A   
024F   7C                     MOV   A,H   
0250   AA                     XRA   D   
0251   B5                     ORA   L   ; zero if equal
0252   D6 01                  SUI   1   ; carry only for zero
0254   9F                     SBB   A   
0255   67                     MOV   H,A   
0256   6F                     MOV   L,A   
0257   F7                     RST   6   
0258                             ; "*": shift-and-add on the multiplier's low bit, so it stops as soon as the
0258                             ; multiplier is used up; only the low 16 bits are kept.
0258   D1           H_MUL:    POP   D   ; DE = multiplicand
0259   C5                     PUSH   B   
025A   44                     MOV   B,H   
025B   4D                     MOV   C,L   ; BC = multiplier
025C   21 00 00               LXI   H,0   
025F   78           MUL1:     MOV   A,B   
0260   B7                     ORA   A   ; clear carry
0261   1F                     RAR      
0262   47                     MOV   B,A   
0263   79                     MOV   A,C   
0264   1F                     RAR      
0265   4F                     MOV   C,A   ; BC >> 1, carry = the bit shifted out
0266   D2 6A 02               JNC   mul2   
0269   19                     DAD   D   
026A   EB           MUL2:     XCHG      
026B   29                     DAD   H   ; multiplicand << 1
026C   EB                     XCHG      
026D   78                     MOV   A,B   
026E   B1                     ORA   C   
026F   C2 5F 02               JNZ   mul1   
0272   C1                     POP   B   
0273   F7                     RST   6   
0274                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
0274                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
0274                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
0274                             ; stops on it.
0274                H_DIV:       
0274                          IF   CHECKED   
                              MOV   A,H   
                              ORA   L   
                              JZ   e_zero   
0274                          ENDIF      
0274   D1                     POP   D   ; DE = a, HL = b
0275   C5                     PUSH   B   
0276   7A                     MOV   A,D   
0277   B7                     ORA   A   
0278   F5                     PUSH   PSW   ; S flag = sign of a (for r)
0279   AC                     XRA   H   
027A   F5                     PUSH   PSW   ; S flag = sign of q
027B   7C                     MOV   A,H   
027C   B7                     ORA   A   
027D   FC 20 01               CM   neg16   ; HL = |b|
0280   EB                     XCHG      
0281   7C                     MOV   A,H   
0282   B7                     ORA   A   
0283   FC 20 01               CM   neg16   ; HL = |a|, DE = |b|
0286   CD 56 03               CALL   udiv   ; HL = q, BC = r
0289   F1                     POP   PSW   
028A   FC 20 01               CM   neg16   ; q's sign
028D   EB                     XCHG      ; DE = q
028E   60                     MOV   H,B   
028F   69                     MOV   L,C   ; HL = r
0290   F1                     POP   PSW   
0291   FC 20 01               CM   neg16   ; r's sign
0294   C1                     POP   B   
0295   D5                     PUSH   D   ; q under r
0296   F7                     RST   6   
0297                             ; ---- stack and storage -----------------------------------------------------
0297   E5           H_DUP:    PUSH   H   ; ":"
0298   F7                     RST   6   
0299   E3           H_SWAP:   XTHL      ; "%"
029A   F7                     RST   6   
029B                             ; (The checked build tests the address before it takes the value off the
029B                             ; stack, so that an error report shows both.)
029B                H_STORE:      ; "!" ( n addr -- )
029B                          IF   CHECKED   
                              CALL   chkst   
029B                          ENDIF      
029B   D1                     POP   D   
029C   73                     MOV   M,E   
029D   23                     INX   H   
029E   72                     MOV   M,D   
029F   DF                     RST   3   
02A0                H_CSTORE:      ; "." ( c addr -- )
02A0                          IF   CHECKED   
                              CALL   chkst   
02A0                          ENDIF      
02A0   D1                     POP   D   
02A1   73                     MOV   M,E   
02A2   DF                     RST   3   
02A3                             ; ---- console ---------------------------------------------------------------
02A3                             ; 22h pushes the address of the text after it and skips the string.
02A3   E5           H_STR:    PUSH   H   
02A4   60                     MOV   H,B   
02A5   69                     MOV   L,C   
02A6   CD 95 04               CALL   skipstr   
02A9                          IF   CHECKED   
                              ORA   A   ; 0: the text ran out before the closing quote
                              JZ   e_quote   
02A9                          ENDIF      
02A9   F7                     RST   6   
02AA                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character
02AA                             ; clears that character"s bit 6 (/M is CR, /` is space; "/" and ""' have no
02AA                             ; bit 6, so // and /" give themselves).
02AA                          IF   1-CHECKED   
02AA   7E           H_PRINT:   MOV   A,M   
02AB   23                     INX   H   
02AC   FE 22                  CPI   22h   
02AE   CA C0 02               JZ   h_drop   
02B1   FE 2F                  CPI   "/"   
02B3   C2 BA 02               JNZ   pr1   
02B6   7E                     MOV   A,M   
02B7   23                     INX   H   
02B8   E6 BF                  ANI   0BFh   
02BA   EF           PR1:      RST   5   
02BB   C3 AA 02               JMP   h_print   
02BE                          ENDIF      
02BE                          IF   CHECKED   
                                 ; (The checked build has the loop as a routine, prstr, which the error
                                 ; report uses too. The address is kept on the stack meanwhile: a report
                                 ; shows the stack as it was before the "$".)
                    H_PRINT:   PUSH   H   
                              CALL   prstr   
                              POP   D   
                              RST   3   
02BE                          ENDIF      
02BE   7D           H_EMIT:   MOV   A,L   ; "'"
02BF   EF                     RST   5   
02C0   DF           H_DROP:   RST   3   ; ";" is this one byte
02C1                             ; "#" prints TOS as a signed decimal number, with no space after it.
02C1   C5           H_NUM:    PUSH   B   
02C2   CD 53 04               CALL   psgn   
02C5   C1                     POP   B   
02C6   DF                     RST   3   
02C7                          IF   CHECKED   ; (the checked build has no room to start ","
                    H_CFETCH:   MOV   L,M   ;   as late as the unchecked one does: see
                              MVI   H,0   ;   the end of "?")
                              RST   6   
02C7                          ENDIF      
02C7                             ; "?" ( n -- c ) or ( -n -- addr )
02C7                             ;   n > 0: wait about n ms for a key; 0 if none came
02C7                             ;   n = 0: wait for a key
02C7                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
02C7                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
02C7   7C           H_KEY:    MOV   A,H   
02C8   B7                     ORA   A   
02C9   FA F2 02               JM   line   
02CC   1E 28        KT1:      MVI   E,MSLOOP   ; one millisecond, roughly
02CE   CD E7 04     KT2:      CALL   getk   
02D1   C2 EE 02               JNZ   kt3   
02D4   1D                     DCR   E   
02D5   C2 CE 02               JNZ   kt2   
02D8   EB                     XCHG      ; a millisecond with no key stirs the random
02D9   2A 76 08               LHLD   SEED   ;   seed by one: how long a key takes to come
02DC   23                     INX   H   ;   is the one thing here that is not the
02DD   22 76 08               SHLD   SEED   ;   same every time
02E0   EB                     XCHG      
02E1   7C                     MOV   A,H   ; 0? never counts down: it waits
02E2   B5                     ORA   L   
02E3   CA CC 02               JZ   kt1   
02E6   2B                     DCX   H   
02E7   7C                     MOV   A,H   
02E8   B5                     ORA   L   
02E9   C2 CC 02               JNZ   kt1   ; A = 0 if the time ran out
02EC                          IF   1-CHECKED   
02EC   FE                     DB   0FEh   ; (CPI: steps over the one byte of ",")
02ED   7E           H_CFETCH:   MOV   A,M   ; "," shares "?"s ending: A becomes TOS
02EE                          ENDIF      
02EE   6F           KT3:      MOV   L,A   
02EF   26 00                  MVI   H,0   
02F1   F7                     RST   6   
02F2                          IF   CPM   
02F2                             ; CP/M: BDOS 10 does the editing (the spec allows the platform's
02F2                             ; own line editor). It doesn't store the CR, so it is added here.
02F2   11 7F 00     LINE:     LXI   D,127   ; TOS is minus the count: adding 127 carries
02F5   19                     DAD   D   ;   only for 1 to 127, and leaves 127 - count
02F6   9F                     SBB   A   
02F7   A5                     ANA   L   ; (0 for a count that is too big)
02F8   EE 7F                  XRI   127   ; A = the count, 127 at most
02FA   32 7E 08               STA   LBHDR   
02FD   C5                     PUSH   B   
02FE   11 7E 08               LXI   D,LBHDR   
0301   0E 0A                  MVI   C,10   
0303   CD 05 00               CALL   BDOS   
0306   C1                     POP   B   
0307   21 7F 08               LXI   H,LBHDR+1   
030A   7E                     MOV   A,M   ; the count typed (0-127)
030B   2C                     INR   L   ; HL = LINEBUF, whose low byte is 80h:
030C   85                     ADD   L   ;   adding the count to L can't carry
030D   6F                     MOV   L,A   
030E   36 0D                  MVI   M,13   
0310   2E 80                  MVI   L,LINEBUF & 0FFh   
0312   F7                     RST   6   
0313                          ENDIF      
0313                          IFN   CPM   
                                 ; Generic: Backspace takes the last character back (and is echoed as
                                 ; it is), CR ends (stored, not echoed), every other key is stored and
                                 ; echoed until the line is full. The line buffer starts at offset 80h
                                 ; of its page, so L alone is the place in the line: D holds the L of
                                 ; a full line.
                    LINE:     LXI   D,127   ; TOS is minus the count: adding 127 carries
                              DAD   D   ;   only for 1 to 127, and leaves 127 - count
                              SBB   A   
                              ANA   L   ; (0 for a count that is too big)
                              CMA      
                              MOV   D,A   ; D = the L of a full line: 80h + count, FFh
                                 ;   at most
                              LXI   H,LINEBUF   
                    LN2:      CALL   getk   
                              JZ   ln2   
                              CPI   13   
                              JZ   ln5   
                              CPI   8   
                              JZ   ln4   
                              MOV   E,A   
                              MOV   A,L   
                              CMP   D   
                              JZ   ln2   ; full
                              MOV   M,E   
                              INR   L   
                              MOV   A,E   
                    LN3:      RST   5   
                              JMP   ln2   
                    LN4:      DCR   L   ; Backspace: one back, and echo it,
                              JM   ln3   ;   unless the line was empty (L left the
                              INR   L   ;   upper half of the page)
                              JMP   ln2   
                    LN5:      MOV   M,A   ; the CR
                              MVI   L,LINEBUF & 0FFh   
                              RST   6   
0313                          ENDIF      
0313                             ; =============================================================================
0313                             ;  Dispatch table: the low byte of each handler's address, in code order.
0313                             ;  It must not cross a page (the dispatcher only adds to its low byte).
0313                             ; =============================================================================
0313                             ; The handlers of the first NPG1 characters start in the image's second page.
0313                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
0313                             ; differs between the builds, so the count is worked out here.
0313                             ; (One division to a line: asm80 only rounds down when it stores a value.)
0313                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
0313                PGBRK:    EQU   (h_break-BASE)/256   
0313                PGDEF:    EQU   (h_def-BASE)/256   
0313                PGFET:    EQU   (h_fetch-BASE)/256   
0313                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
0313   9B           PTAB:     DB   h_store & 0FFh   ; !
0314   A3                     DB   h_str & 0FFh   ; "
0315   C1                     DB   h_num & 0FFh   ; #
0316   AA                     DB   h_print & 0FFh   ; $
0317   99                     DB   h_swap & 0FFh   ; %
0318   33                     DB   h_and & 0FFh   ; &
0319   BE                     DB   h_emit & 0FFh   ; '
031A   0F                     DB   h_open & 0FFh   ; (
031B   1B                     DB   h_close & 0FFh   ; )
031C   58                     DB   h_mul & 0FFh   ; *
031D   30                     DB   h_add & 0FFh   ; +
031E   ED                     DB   h_cfetch & 0FFh   ; ,
031F   27                     DB   h_sub & 0FFh   ; -
0320   A0                     DB   h_cstore & 0FFh   ; .
0321   74                     DB   h_div & 0FFh   ; /
0322   97                     DB   h_dup & 0FFh   ; :
0323   C0                     DB   h_drop & 0FFh   ; ;
0324   3C                     DB   h_lt & 0FFh   ; <
0325   4B                     DB   h_eq & 0FFh   ; =
0326   3B                     DB   h_gt & 0FFh   ; >
0327   C7                     DB   h_key & 0FFh   ; ?
0328   0A                     DB   h_fetch & 0FFh   ; @
0329   EA                     DB   h_def & 0FFh   ; [
032A   DB                     DB   h_break & 0FFh   ; \
032B   D6                     DB   h_ret & 0FFh   ; ]
032C   80                     DB   h_xor & 0FFh   ; ^
032D   93                     DB   h_alloc & 0FFh   ; _
032E   C1                     DB   h_grave & 0FFh   ; `
032F   14                     DB   h_tor & 0FFh   ; {
0330   88                     DB   h_or & 0FFh   ; |
0331   1D                     DB   h_fromr & 0FFh   ; }
0332   90                     DB   h_not & 0FFh   ; ~
0333                PTABEND:      
0333                             ; =============================================================================
0333                             ;  Routines (no handler starts past this point)
0333                             ; =============================================================================
0333                             ; Digits: step back onto the first digit and read the whole number.
0333   E5           DIGIT:    PUSH   H   
0334   0B                     DCX   B   
0335   CD 3F 03               CALL   rdnum   
0338   F7                     RST   6   
0339                             ; negnum: "-" directly before a digit: read the number, negate it.
0339   E5           NEGNUM:   PUSH   H   
033A   CD 3F 03               CALL   rdnum   
033D   E7                     RST   4   
033E   F7                     RST   6   
033F                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
033F                             ; non-digit. Values wrap at 16 bits, as the spec says.
033F   21 00 00     RDNUM:    LXI   H,0   
0342   0A           RDN1:     LDAX   B   
0343   D6 30                  SUI   "0"   
0345   FE 0A                  CPI   10   
0347   D0                     RNC      
0348   03                     INX   B   
0349   54                     MOV   D,H   
034A   5D                     MOV   E,L   
034B   29                     DAD   H   
034C   29                     DAD   H   
034D   19                     DAD   D   
034E   29                     DAD   H   ; HL * 10
034F   5F                     MOV   E,A   
0350   16 00                  MVI   D,0   
0352   19                     DAD   D   
0353   C3 42 03               JMP   rdn1   
0356                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, BC = remainder.
0356                             ; Uses A, BC; the caller saves the IP. HL holds the dividend and, as its bits
0356                             ; leave at the top, the quotient bits arrive at the bottom. The loop counter
0356                             ; lives on the stack, since A is busy with the shifts.
0356                             ; Dividing by 2 is one shift (the spec wants that fast).
0356   01 00 00     UDIV:     LXI   B,0   
0359   7B                     MOV   A,E   
035A   EE 02                  XRI   2   
035C   B2                     ORA   D   
035D   C2 6A 03               JNZ   udv0   
0360   B4                     ORA   H   ; A was 0, and the carry is clear
0361   1F                     RAR      
0362   67                     MOV   H,A   
0363   7D                     MOV   A,L   
0364   1F                     RAR      
0365   6F                     MOV   L,A   ; the quotient
0366   78                     MOV   A,B   
0367   17                     RAL      
0368   4F                     MOV   C,A   ; the remainder: the bit that fell out
0369   C9                     RET      
036A   3E 10        UDV0:     MVI   A,16   
036C   F5                     PUSH   PSW   
036D   29           UDV1:     DAD   H   ; next dividend bit into the carry
036E   79                     MOV   A,C   
036F   17                     RAL      
0370   4F                     MOV   C,A   
0371   78                     MOV   A,B   
0372   17                     RAL      
0373   47                     MOV   B,A   ; BC = BC*2 + bit
0374   79                     MOV   A,C   
0375   93                     SUB   E   
0376   78                     MOV   A,B   
0377   9A                     SBB   D   ; carry if BC < DE
0378   DA 80 03               JC   udv2   
037B   47                     MOV   B,A   ; BC - DE (high byte; A holds it)
037C   79                     MOV   A,C   
037D   93                     SUB   E   
037E   4F                     MOV   C,A   
037F   2C                     INR   L   ; quotient bit
0380   F1           UDV2:     POP   PSW   
0381   3D                     DCR   A   
0382   F5                     PUSH   PSW   
0383   C2 6D 03               JNZ   udv1   
0386   F1                     POP   PSW   
0387   C9                     RET      
0388                             ; =============================================================================
0388                             ;  The grave's codes (h_grave is the dispatcher). Each starts with HL = TOS,
0388                             ;  A = the character and the carry clear.
0388                             ; 
0388                             ;    `!  ( addr -- )        call the machine code at addr (exec)
0388                             ;    `$  ( addr -- addr' )  the hex loader
0388                             ;    `'  ( -- )             new line: CR LF
0388                             ;    `+  ( addr -- n )      add 1 to the cell at addr and leave its new value
0388                             ;    `,  ( n -- r )         a random number from 0 to n-1 (n is 1 to 32767)
0388                             ;    `-  ( addr -- n )      subtract 1 from the cell at addr, the same way
0388                             ;    `.  ( -- addr )        the address of the random seed
0388                             ;    `<  ( a b -- n )       the smaller of the two (signed)
0388                             ;    `>  ( a b -- n )       the larger
0388                             ;    `?  ( flag -- )        the cursor off (0) or on
0388                             ;    `@  ( row col -- )     the cursor to that row and column, both from 0
0388                             ;    `^  ( -- )             clear the screen and home the cursor
0388                             ;    `_  ( -- )             clear from the cursor to the end of the line
0388                             ; =============================================================================
0388                GBASE:       
0388   C3 2B 01     G_EXEC:   JMP   exec   ; (exec is up among the RST routines)
038B                             ; `$: pairs of hex digits are stored from addr until a non-hex character;
038B                             ; then a RET (C9h) is written and its address is left. An odd last digit is
038B                             ; consumed and dropped.
038B   CD A2 04     G_HEX:    CALL   hexc   
038E   D2 A2 03               JNC   hx2   
0391   87                     ADD   A   
0392   87                     ADD   A   
0393   87                     ADD   A   
0394   87                     ADD   A   
0395   57                     MOV   D,A   ; the high digit
0396   CD A2 04               CALL   hexc   
0399   D2 A2 03               JNC   hx2   ; odd digit: consumed and dropped
039C   B2                     ORA   D   
039D   77                     MOV   M,A   
039E   23                     INX   H   
039F   C3 8B 03               JMP   g_hex   
03A2   36 C9        HX2:      MVI   M,0C9h   ; (never range-checked: the spec says so)
03A4   F7                     RST   6   
03A5   3E 0D        G_NL:     MVI   A,13   
03A7   EF                     RST   5   
03A8   3E 0A                  MVI   A,10   
03AA   EF                     RST   5   
03AB   F7                     RST   6   
03AC                             ; `+ and `-: one routine. The character says which.
03AC                G_INC:       
03AC                          IF   CHECKED   
                              CALL   chkst   ; the address is tested first, as "!" does
                              DCX   B   
                              LDAX   B   ; (the test used A: the character again)
                              INX   B   
03AC                          ENDIF      
03AC   FE 2C                  CPI   ","   ; carry for "+"
03AE   5E                     MOV   E,M   
03AF   23                     INX   H   
03B0   56                     MOV   D,M   
03B1   D2 B6 03               JNC   gi1   
03B4   13                     INX   D   
03B5   13                     INX   D   
03B6   1B           GI1:      DCX   D   
03B7   72                     MOV   M,D   
03B8   2B                     DCX   H   
03B9   73                     MOV   M,E   
03BA   EB                     XCHG      ; the new value is TOS
03BB   F7                     RST   6   
03BC                             ; `. pushes the address of the random seed.
03BC   E5           G_SEED:   PUSH   H   
03BD   21 76 08               LXI   H,SEED   
03C0   F7                     RST   6   
03C1                             ; `, ( n -- r ). The seed goes one step on: seed * 261 + 1, which takes
03C1                             ; every 16-bit value in turn. The high bits of such a seed are the good ones
03C1                             ; and the low ones repeat soon, so the high byte is folded into the low
03C1                             ; (XOR) before the remainder of dividing by n is taken.
03C1                             ; n must be 1 to 32767: the checked build stops with Z on anything less
03C1                             ; than 1.
03C1                G_RND:       
03C1                          IF   CHECKED   
                              DCX   H   
                              MOV   A,H   ; n - 1 negative: n is 0 or less
                              INX   H   
                              ORA   A   
                              JM   e_zero   
03C1                          ENDIF      
03C1   EB                     XCHG      ; DE = n
03C2   C5                     PUSH   B   
03C3   2A 76 08               LHLD   SEED   
03C6   44                     MOV   B,H   
03C7   4D                     MOV   C,L   
03C8   29                     DAD   H   
03C9   29                     DAD   H   
03CA   09                     DAD   B   ; * 5
03CB   7C                     MOV   A,H   
03CC   81                     ADD   C   
03CD   67                     MOV   H,A   ; + * 256: * 261
03CE   23                     INX   H   
03CF   22 76 08               SHLD   SEED   
03D2   7C                     MOV   A,H   
03D3   AD                     XRA   L   
03D4   6F                     MOV   L,A   
03D5   CD 56 03               CALL   udiv   ; BC = the remainder
03D8   60                     MOV   H,B   
03D9   69                     MOV   L,C   
03DA   C1                     POP   B   
03DB   F7                     RST   6   
03DC                             ; `< and `>: one routine. b < a (signed) is the borrow of b - a, turned
03DC                             ; round if the two signs differ: RAR puts the borrow in bit 7, where the two
03DC                             ; XRAs meet it. Then the character is read again, 3Ch or 3Eh: RAR leaves
03DC                             ; 1Eh or 1Fh under the flag, and adding 61h carries into the flag for 1Fh
03DC                             ; only. So the carry ends up saying "keep b" for either character.
03DC   D1           G_MIN:    POP   D   ; DE = a, HL = b
03DD   7D                     MOV   A,L   
03DE   93                     SUB   E   
03DF   7C                     MOV   A,H   
03E0   9A                     SBB   D   
03E1   1F                     RAR      
03E2   AC                     XRA   H   
03E3   AA                     XRA   D   
03E4   17                     RAL      ; carry: b < a
03E5   0B                     DCX   B   
03E6   0A                     LDAX   B   
03E7   03                     INX   B   
03E8   1F                     RAR      
03E9   C6 61                  ADI   61h   
03EB   17                     RAL      
03EC   DA F0 03               JC   gm1   
03EF   EB                     XCHG      
03F0   F7           GM1:      RST   6   
03F1                          IF   ANSI   
03F1                             ; `^: ESC [ H homes the cursor, and ESC [ J clears from there to the end of
03F1                             ; the screen. `_: ESC [ K clears to the end of the line.
03F1   CD 32 04     G_CLS:    CALL   csi   
03F4   3E 48                  MVI   A,"H"   
03F6   EF                     RST   5   
03F7   3E 4A                  MVI   A,"J"   
03F9   11                     DB   11h   ; (LXI D: steps over the two bytes of g_eol)
03FA   3E 4B        G_EOL:    MVI   A,"K"   
03FC   5F                     MOV   E,A   
03FD   CD 32 04               CALL   csi   
0400   7B                     MOV   A,E   
0401   EF                     RST   5   
0402   F7                     RST   6   
0403                             ; `? ( flag -- ): ESC [ ? 2 5 l hides the cursor, ESC [ ? 2 5 h shows it.
0403   CD 32 04     G_CUR:    CALL   csi   
0406   3E 3F                  MVI   A,"?"   
0408   EF                     RST   5   
0409   3E 32                  MVI   A,"2"   
040B   EF                     RST   5   
040C   3E 35                  MVI   A,"5"   
040E   EF                     RST   5   
040F   7C                     MOV   A,H   
0410   B5                     ORA   L   
0411   3E 6C                  MVI   A,"l"   
0413   CA 18 04               JZ   gc1   
0416   3E 68                  MVI   A,"h"   
0418   EF           GC1:      RST   5   
0419   DF                     RST   3   
041A                             ; `@ ( row col -- ): ESC [ row+1 ; col+1 H. (ANSI counts from 1.)
041A   D1           G_AT:     POP   D   ; DE = the row
041B   C5                     PUSH   B   ; (pdec uses BC)
041C   E5                     PUSH   H   ; the column
041D   EB                     XCHG      
041E   CD 32 04               CALL   csi   
0421   23                     INX   H   
0422   CD 5C 04               CALL   pdec   
0425   3E 3B                  MVI   A,";"   
0427   EF                     RST   5   
0428   E1                     POP   H   
0429   23                     INX   H   
042A   CD 5C 04               CALL   pdec   
042D   3E 48                  MVI   A,"H"   
042F   EF                     RST   5   
0430   C1                     POP   B   
0431   DF                     RST   3   
0432                             ; csi: print ESC [, which starts every ANSI sequence. Keeps all but A.
0432   3E 1B        CSI:      MVI   A,27   
0434   EF                     RST   5   
0435   3E 5B                  MVI   A,"["   
0437   EF                     RST   5   
0438   C9                     RET      
0439                          ENDIF      
0439                          IF   1-ANSI   
                                 ; With ANSI = 0 the machine's own routines do the work (see the equates).
                    G_CLS:    CALL   CONCLS   
                              RST   6   
                    G_EOL:    CALL   CONEOL   
                              RST   6   
                    G_CUR:    MOV   A,H   
                              ORA   L   
                              CALL   CONCUR   
                              RST   3   
                    G_AT:     POP   D   ; DE = the row, HL = the column
                              CALL   CONAT   
                              RST   3   
0439                          ENDIF      
0439                          IF   CHECKED   
                    GBAD:     POP   H   ; no such code: W. The place is the character
                              JMP   e_brack   
0439                          ENDIF      
0439                             ; The table: a character, then its handler's distance from gbase.
0439   21 00        GTAB:     DB   "!",g_exec-gbase   
043B   24 03                  DB   "$",g_hex-gbase   
043D   27 1D                  DB   27h,g_nl-gbase   
043F   2B 24                  DB   "+",g_inc-gbase   
0441   2C 39                  DB   ",",g_rnd-gbase   
0443   2D 24                  DB   "-",g_inc-gbase   
0445   2E 34                  DB   ".",g_seed-gbase   
0447   3C 54                  DB   "<",g_min-gbase   
0449   3E 54                  DB   ">",g_min-gbase   
044B   3F 7B                  DB   "?",g_cur-gbase   
044D   40 92                  DB   "@",g_at-gbase   
044F   5E 69                  DB   "^",g_cls-gbase   
0451   5F 72                  DB   "_",g_eol-gbase   
0453                          IF   CHECKED   
                              DB   0FFh   ; the end
0453                          ENDIF      
0453                             ; psgn: print HL as a signed number. Uses BC.
0453   7C           PSGN:     MOV   A,H   
0454   B7                     ORA   A   
0455   F2 5C 04               JP   pdec   
0458   3E 2D                  MVI   A,"-"   
045A   EF                     RST   5   
045B   E7                     RST   4   
045C                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
045C                             ; Uses BC.
045C   11 0A 00     PDEC:     LXI   D,10   
045F   CD 56 03               CALL   udiv   ; HL = HL / 10, C = the last digit
0462   79                     MOV   A,C   
0463   F5                     PUSH   PSW   
0464   7C                     MOV   A,H   
0465   B5                     ORA   L   
0466   C4 5C 04               CNZ   pdec   
0469   F1                     POP   PSW   
046A   C6 30                  ADI   "0"   
046C   EF                     RST   5   
046D   C9                     RET      
046E                             ; skip: read past text to the closer at this level, and return A = 0 if it
046E                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
046E                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
046E                             ; no closer; anything else that runs into the NUL had unbalanced brackets
046E                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
046E                             ; skip sets it to 0 and falls through the INR that an opener comes back to.
046E                             ; 
046E                             ; The checked build also looks at the character the skip was started by,
046E                             ; which is always the one just before where it starts: "(" must end at ")",
046E                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
046E                             ; quote counts as running into it. "\" takes either closer. The place where
046E                             ; the skip started is kept on the stack, for the report.
046E                SKIP:        
046E                          IF   CHECKED   
                              PUSH   B   
                              DCX   B   
                              LDAX   B   
                              INX   B   
                              MOV   E,A   ; E = the opener: ( [ or \
046E                          ENDIF      
046E   16 00                  MVI   D,0   
0470   14           SK3:      INR   D   ; an opener: one deeper
0471   0A           SK1:      LDAX   B   
0472                          IF   1-CHECKED   
0472   03                     INX   B   
0473   B7                     ORA   A   
0474   CA 7D 01               JZ   endprog   
0477                          ENDIF      
0477                          IF   CHECKED   
                              ORA   A   
                              JZ   sk6   ; (the IP stays on the NUL)
                              INX   B   
0477                          ENDIF      
0477   FE 22                  CPI   22h   
0479   CC 95 04               CZ   skipstr   ; leaves A = 22h, which matches nothing below
047C   D6 28                  SUI   "("   ;   (or 0, and then the NUL is read next)
047E   CA 70 04               JZ   sk3   
0481   3D                     DCR   A   ; ")"
0482   CA 8F 04               JZ   sk4   
0485   D6 32                  SUI   "["-")"   
0487   CA 70 04               JZ   sk3   
048A   FE 02                  CPI   "]"-"["   
048C   C2 71 04               JNZ   sk1   
048F   15           SK4:      DCR   D   
0490                          IF   1-CHECKED   
0490   C8                     RZ      ; the closer at this level
0491   C3 71 04               JMP   sk1   
0494                          ENDIF      
0494                          IF   CHECKED   
                              JNZ   sk1   
                              MOV   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
                              XRA   E   ;   opener is 0 for "(" and 1 for "[", and only
                              ANI   6   ;   "\" has bit 2: so this is 2 for the wrong
                              CPI   2   ;   closer, and only then
                              MOV   A,D   
                              POP   D   ; (where the skip started)
                              RNZ      
                              MOV   B,D   ; N. The place is the opener
                              MOV   C,E   
                              JMP   sk7   
                    SK6:      MOV   A,E   ; the text ran out:
                              ANI   4   
                              JNZ   endprog   ;   "\" with no closer ends the program
                              POP   B   
                    SK7:      MVI   A,"N"   
                              JMP   errp   ; (errp drops skip's return address)
0494                          ENDIF      
0494                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
0494                             ; the next character, so "/"" does not end it. Leaves A = 22h.
0494                          IF   1-CHECKED   
0494   03           SS0:      INX   B   
0495   0A           SKIPSTR:   LDAX   B   
0496   03                     INX   B   
0497   FE 2F                  CPI   "/"   
0499   CA 94 04               JZ   ss0   
049C   FE 22                  CPI   22h   
049E   C2 95 04               JNZ   skipstr   
04A1   C9                     RET      
04A2                          ENDIF      
04A2                          IF   CHECKED   
                                 ; The checked build never steps over a NUL: if the text runs out first it
                                 ; returns A = 0 with the IP on the NUL.
                    SKIPSTR:   LDAX   B   
                              ORA   A   
                              RZ      
                              INX   B   
                              CPI   22h   
                              RZ      
                              CPI   "/"   
                              JNZ   skipstr   
                              LDAX   B   ; the escaped character
                              ORA   A   
                              RZ      
                              INX   B   
                              JMP   skipstr   
04A2                          ENDIF      
04A2                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
04A2                             ; and return its value in A with the carry set; otherwise leave the IP and
04A2                             ; return with the carry clear.
04A2   0A           HEXC:     LDAX   B   
04A3   D6 30                  SUI   "0"   
04A5   FE 0A                  CPI   10   
04A7   DA B3 04               JC   hc1   
04AA   E6 DF                  ANI   0DFh   
04AC   D6 11                  SUI   11h   
04AE   FE 06                  CPI   6   
04B0   D0                     RNC      
04B1   D6 F6                  SUI   0F6h   ; + 10, and sets the carry
04B3   03           HC1:      INX   B   
04B4   C9                     RET      
04B5                             ; =============================================================================
04B5                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
04B5                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
04B5                             ;  (RST 5) prints A. Both keep BC, DE and HL. In the generic build they are
04B5                             ;  the host's KEY and CONOUT routines themselves.
04B5                             ; 
04B5                             ;  A running program reads the keyboard only through getk and pollk, which
04B5                             ;  between them give the break key its rules:
04B5                             ;    - Ctrl-C stops the program;
04B5                             ;    - any other key that the break check reads is held in KEYBUF for the
04B5                             ;      next "?", and a newer one takes its place;
04B5                             ;    - "?" (getk) takes the held key first;
04B5                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
04B5                             ;      key like any other, but two of them within about 250 ms still stop it.
04B5                             ;  Both are called straight from a handler, never from a routine under one:
04B5                             ;  the checked build's report counts on finding one return address above the
04B5                             ;  data stack, and TOS in HL.
04B5                             ; =============================================================================
04B5                          IFN   CPM   
                    RAWK:     EQU   KEY   
04B5                          ENDIF      
04B5                             ; pollk: the break check (see rpushd).
04B5   CD F8 04     POLLK:    CALL   rawk   
04B8   C8                     RZ      ; no key
04B9   32 7A 08               STA   KEYBUF   ; held for the next "?"
04BC   FE 03        PK1:      CPI   3   ; (getk joins here)
04BE   C0                     RNZ      
04BF                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
04BF                             ; the program has turned it off, wait about 250 ms for one more key: a
04BF                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
04BF                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
04BF   3A 7B 08     CTLC:     LDA   BRKOFF   
04C2   B7                     ORA   A   
04C3   CA 7D 01               JZ   brk   
04C6   D5                     PUSH   D   
04C7   11 10 27               LXI   D,250*MSLOOP   
04CA   CD F8 04     CT1:      CALL   rawk   
04CD   C2 D6 04               JNZ   ct2   
04D0   1B                     DCX   D   
04D1   7A                     MOV   A,D   
04D2   B3                     ORA   E   
04D3   C2 CA 04               JNZ   ct1   
04D6   D1           CT2:      POP   D   ; A = the second key, or 0 if none came
04D7   FE 03                  CPI   3   
04D9   CA 7D 01               JZ   brk   
04DC   B7                     ORA   A   
04DD   CA E3 04               JZ   ct3   
04E0   32 7A 08               STA   KEYBUF   
04E3   3E 03        CT3:      MVI   A,3   
04E5   B7                     ORA   A   
04E6   C9                     RET      
04E7                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
04E7   E5           GETK:     PUSH   H   ; a held key goes first, and is taken out of
04E8   21 7A 08               LXI   H,KEYBUF   ;   the buffer
04EB   7E                     MOV   A,M   
04EC   36 00                  MVI   M,0   
04EE   E1                     POP   H   
04EF   B7                     ORA   A   
04F0   C0                     RNZ      
04F1   CD F8 04               CALL   rawk   
04F4   C8                     RZ      
04F5   C3 BC 04               JMP   pk1   ; Ctrl-C? If not, that is the key
04F8                          IF   1-CHECKED   
04F8                BRK:      EQU   endprog   ; the unchecked build stops without a word;
04F8                          ENDIF      
04F8                          IF   CHECKED   
                    BRK:      EQU   e_break   ;   the checked build reports B
04F8                          ENDIF      
04F8                          IF   CPM   
04F8   3E FF        RAWK:     MVI   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
04FA                             ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
04FA                             ; printing and could swallow a key that BDOS 6 then never sees.
04FA   C5           PUTC:     PUSH   B   
04FB   D5                     PUSH   D   
04FC   E5                     PUSH   H   
04FD   5F                     MOV   E,A   
04FE   0E 06                  MVI   C,6   
0500   CD 05 00               CALL   BDOS   
0503   E1                     POP   H   
0504   D1                     POP   D   
0505   C1                     POP   B   
0506   B7                     ORA   A   ; (for getk)
0507   C9                     RET      
0508                          ENDIF      
0508                             ; =============================================================================
0508                             ;  Checked build: the checks and the error report
0508                             ; =============================================================================
0508                          IF   CHECKED   
                                 ; chkhp: HL = the new heap top, DE = the count, the carry is from adding
                                 ; it, and the old top is on the stack under the return address. Stop if the
                                 ; new top is not below the limit page, or is below the program's end.
                    CHKHP:       
0508                          ENDIF      
0508                          IF   CHECKED*CPM   
                                 ; With this much room a top that wrapped round can land back in
                                 ; range, so the add is tested too: growing must not carry, and
                                 ; releasing must.
                              MOV   A,D   
                              RAR      ; the carry comes in above the count's sign:
                              ADI   40h   ;   bit 7 = carry XOR sign
                              ADD   A   
                              JC   e_heap   
                              LDA   0007h   
                              DCR   A   
                              CMP   H   
                              JC   e_heap   
0508                          ENDIF      
0508                          IF   CHECKED*(1-CPM)   
                                 ; (Here the program's space is under 32K, so a top that wrapped
                                 ; round always falls outside it.)
                              MOV   A,H   
                              CPI   HEAPLIM   
                              JNC   e_heap   
0508                          ENDIF      
0508                          IF   CHECKED   
                              XCHG      
                              PUSH   H   ; the count
                              LHLD   NPEND   
                              DAD   D   ; carry: at or above the program's end
                              POP   H   
                              XCHG      
                              RC      
                    E_HEAP:   XCHG      ; put the count back in TOS for the report,
                              POP   D   ;   and drop the return address (errp drops
                              MVI   A,"H"   ;   the old top)
                              JMP   errp   
                                 ; chkst: stop unless HL is in the program's own space: from the letter page
                                 ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
                                 ; whatever lies above the limit are safe. Memory above the heap top but
                                 ; below the limit is the program's own: Tiny BASIC keeps its lines there.
                                 ; It is the page of HL + 1 that is tested, so that one test serves both
                                 ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
                                 ; Keeps HL and BC. It runs on into its own error entry.
                    CHKST:    INX   H   
                              MOV   A,H   
                              DCX   H   
                              CPI   LETPAGE   
                              JC   e_store   
0508                          ENDIF      
0508                          IF   CHECKED*(1-CPM)   
                              CPI   HEAPLIM   
                              RC      
0508                          ENDIF      
0508                          IF   CHECKED*CPM   
                              MOV   E,A   
                              LDA   0007h   ; the BDOS page is the heap limit
                              DCR   A   
                              CMP   E   
                              RNC      
0508                          ENDIF      
0508                          IF   CHECKED   
                                 ; Two error entries for errors found inside a routine: the first hides the
                                 ; second inside a 3-byte LXI D (the 11h); errp then drops the routine's
                                 ; return address.
                    E_STORE:   MVI   A,"O"   ; a store outside the program's space
                              DB   11h   
                    E_BREAK:   MVI   A,"B"   ; Ctrl-C (found inside pollk or getk)
                              JMP   errp   
                                 ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
                                 ; "$", and the error report's texts). A NUL first is an error: Q.
                    PRSTR:    MOV   A,M   
                              INX   H   
                              CPI   22h   
                              RZ      
                              ORA   A   
                              JZ   e_dollar   
                              CPI   "/"   
                              JNZ   prs1   
                              MOV   A,M   
                              INX   H   
                              ANI   0BFh   
                    PRS1:     RST   5   
                              JMP   prstr   
                    E_DOLLAR:   POP   D   ; "$" ran into a NUL: drop the return address,
                              POP   H   ;   and put the string's address back in TOS
                              MVI   A,"Q"   
                              JMP   error   
                                 ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
                                 ; pnl: the same, on a new line.
                    PNL:      MVI   A,13   
                              RST   5   
                              MVI   A,10   
                              RST   5   
                    PMSG:     XTHL      
                              CALL   prstr   
                              XTHL      
                              RET      
                                 ; chkstk: both stacks are checked once per character, not in every handler.
                                 ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
                                 ; the constant carries if it is above (cells were popped that were never
                                 ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
                                 ; a character late at most: the bytes above DSTOP and the guard band below
                                 ; the page take what happens meanwhile.
                    CHKSTK:   XCHG      ; DE = TOS (HL is needed for the pointers)
                              LXI   H,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
                              DAD   SP   
                              JC   e_under   
                              INR   H   
                              JNZ   e_over   
                              LHLD   RSP   ; the return stack: in its page (or it has
                              MOV   A,H   ;   overflowed), and not above its empty
                              CPI   RSPAGE   ;   position (an underflow stays inside the
                              JNZ   e_rover   ;   page, in the guard band)
                              MOV   A,L   
                              CPI   RSTOP&0FFh+1   
                              JNC   e_runder   
                              XCHG      ; TOS back
                              RET      
                    E_RUNDER:   LXI   H,RSTOP   ; return stack underflow: it counts as empty
                              SHLD   RSP   
                              MVI   A,"r"   
                              DB   21h   ; (LXI H hides the next entry; HL is free)
                    E_ROVER:   MVI   A,"R"   ; return stack overflow
                              DB   21h   
                    E_OVER:   MVI   A,"S"   ; data stack overflow
                              XCHG      ; TOS back
                              JMP   errp   
                    E_UNDER:   LXI   SP,DSTOP   ; data stack underflow: it counts as empty
                              MVI   A,"s"   
                              JMP   error   
                                 ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
                                 ; was never defined still holds 0000h, and the byte there is a JMP, C3h, in
                                 ; every build: if the IP is in page zero, this was a call of an undefined
                                 ; word. The call is undone, so the place is the call itself.
                    E_HI:     INR   B   
                              DCR   B   
                              JNZ   e_resv   
                              PUSH   H   
                              RST   1   
                              MOV   B,H   
                              MOV   C,L   
                              POP   H   
                              MVI   A,"U"   
                              JMP   error   
                                 ; Error entries. Each loads its letter and then hides the next entry inside
                                 ; a 3-byte LXI D (the 11h), so they all fall through to `error`.
                    E_QUOTE:   MOV   B,H   ; an unclosed string: HL is its address, one
                              MOV   C,L   ;   past the opening quote, which is the place
                              MVI   A,"Q"   
                              DB   11h   
                    E_RESV:   MVI   A,"X"   ; a reserved byte outside a string
                              DB   11h   
                    E_ZERO:   MVI   A,"Z"   ; dividing by zero
                              DB   11h   
                    E_BRACK:   MVI   A,"W"   ; bad character after [
                              DB   0FEh   ; (CPI hides the one byte of errp)
                                 ; errp: an error found inside a routine: drop its return address first.
                    ERRP:     POP   D   
                                 ; error: the report, then the end. A = the letter, BC = one past the place,
                                 ; HL = TOS, and both stacks as the report is to show them:
                                 ; 
                                 ;   Err X @ line,col
                                 ;   up to 16 characters of the text from the place
                                 ;   Stk n: the top 8 cells at most, bottom to top
                                 ;   Rtn n
                    ERROR:    PUSH   H   ; now the whole data stack is in memory
                              MOV   E,A   
                              CALL   pnl   
                              DB   "Err ",22h   
                              MOV   A,E   
                              RST   5   
                              CALL   pmsg   
                              DB   " @ ",22h   
                              DCX   B   ; BC = the place
                                 ; The line and column. A place below the program is in the line
                                 ; buffer: line 0. Otherwise count the LFs from the program's start;
                                 ; DE = the line's number, HL = where it starts.
                              LXI   H,LINEBUF   
                              LXI   D,0   
                              MOV   A,B   
                              CPI   PROG/256   
                              JC   er3   
                              INR   H   
                              MOV   L,E   ; HL = PROG
                    ER1:      INX   D   ; a new line starts at HL
                              PUSH   H   
                    ER2:      MOV   A,L   
                              SUB   C   
                              MOV   A,H   
                              SBB   B   
                              JNC   er2x   ; reached the place
                              MOV   A,M   
                              INX   H   
                              CPI   10   
                              JNZ   er2   
                              POP   PSW   
                              JMP   er1   
                    ER2X:     POP   H   
                    ER3:      PUSH   B   
                              PUSH   H   
                              XCHG      
                              CALL   pdec   ; the line
                              MVI   A,","   
                              RST   5   
                              POP   D   
                              POP   H   
                              PUSH   H   
                              CALL   sub16   
                              INX   H   
                              CALL   pdec   ; the column
                              CALL   pnl   
                              DB   22h   
                              POP   H   ; the text, as it is: 16 characters, or fewer
                              MVI   B,16   ;   if the line or the program ends first
                    ER4:      MOV   A,M   
                              INX   H   
                              ORA   A   
                              JZ   er5   
                              CPI   13   
                              JZ   er5   
                              CPI   10   
                              JZ   er5   
0508                          ENDIF      
0508                          IF   CHECKED*CPM   
                              CPI   1Ah   ; (the ^Z that pads a file's last record ends
                              JZ   er5   ;   the text too: some terminals clear the
0508                          ENDIF      ;   screen on it)
0508                          IF   CHECKED   
                              RST   5   
                              DCR   B   
                              JNZ   er4   
                    ER5:      CALL   pnl   
                              DB   "Stk ",22h   
                              LXI   H,(2-DSTOP)&0FFFFh   ; SP - (DSTOP-2) is minus twice the depth
                              DAD   SP   ;   (the cell at DSTOP-2 was pushed with the
                              RST   4   ;   first value and holds nothing)
                              MOV   A,H   
                              CALL   phal2   ; the depth
                              MVI   A,":"   
                              RST   5   
                              MOV   A,C   
                              CPI   9   
                              JC   er6   
                              CALL   pmsg   
                              DB   " ...",22h   
                              MVI   C,8   
                    ER6:      MVI   H,0   ; C = the number of cells to show
                              MOV   L,C   
                              DAD   H   
                              DAD   SP   ; HL -> just above the deepest of them
                              INR   C   
                    ER7:      DCR   C   
                              JZ   er8   
                              DCX   H   
                              MOV   D,M   
                              DCX   H   
                              MOV   E,M   
                              PUSH   H   
                              PUSH   B   
                              MVI   A," "   
                              RST   5   
                              XCHG      
                              CALL   psgn   
                              POP   B   
                              POP   H   
                              JMP   er7   
                    ER8:      CALL   pnl   
                              DB   "Rtn ",22h   
                              LHLD   RSP   
                              XCHG      
                              LXI   H,RSTOP   
                              CALL   phalf   
                              CALL   pnl   
                              DB   22h   
                              JMP   endprog   
                                 ; phalf: print half of HL - DE, and leave it in BC
                    PHALF:    CALL   sub16   
                    PHAL2:    ORA   A   ; (A = H; this clears the carry)
                              RAR      
                              MOV   H,A   
                              MOV   A,L   
                              RAR      
                              MOV   L,A   
                              PUSH   H   
                              CALL   pdec   
                              POP   B   
                              RET      
                                 ; sub16: HL = HL - DE. Leaves A = H.
                    SUB16:    MOV   A,L   
                              SUB   E   
                              MOV   L,A   
                              MOV   A,H   
                              SBB   D   
                              MOV   H,A   
                              RET      
0508                          ENDIF      
0508                             ; =============================================================================
0508                             ;  Startup
0508                             ; =============================================================================
0508                START:       
0508                          IF   (1-CPM)*CHECKED   
                              LXI   SP,DSTOP   
0508                          ENDIF      
0508                          IF   CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi), and no key is held back.
                              LXI   H,LET   
                              XRA   A   
                    INI1:     MOV   M,A   
                              INR   L   
                              JP   ini1   ; +00h to +7Fh
0508                          ENDIF      
0508                          IF   CPM   
0508                             ; CP/M: the RAM pages follow the image; the heap may grow to the BDOS
0508   21 08 01               LXI   H,vecs   ; the RST routines go down into page zero
050B   11 08 00               LXI   D,0008h   
050E   06 2C                  MVI   B,vecend-vecs   
0510   7E           CPY:      MOV   A,M   
0511   12                     STAX   D   
0512   23                     INX   H   
0513   13                     INX   D   
0514   05                     DCR   B   
0515   C2 10 05               JNZ   cpy   
0518   11 5C 00               LXI   D,005Ch   ; open the file named on the command line
051B   0E 0F                  MVI   C,15   ; (no such file: the first read fails too,
051D   CD 05 00               CALL   BDOS   ;   and the program is empty)
0520   11 00 09               LXI   D,PROG   
0523   D5           LD1:      PUSH   D   
0524   0E 1A                  MVI   C,26   ; set the DMA address
0526   CD 05 00               CALL   BDOS   
0529   11 5C 00               LXI   D,005Ch   
052C   0E 14                  MVI   C,20   ; read the next 128 bytes
052E   CD 05 00               CALL   BDOS   
0531   E1                     POP   H   ; HL = the address this record went to
0532   B7                     ORA   A   
0533   C2 3E 05               JNZ   ld2   
0536   11 80 00               LXI   D,128   
0539   19                     DAD   D   
053A   EB                     XCHG      
053B   C3 23 05               JMP   ld1   
053E   36 00        LD2:      MVI   M,0   ; the end of the file counts as NUL
0540   23                     INX   H   ; the heap starts after it
0541                          ENDIF      
0541                          IFN   CPM   
                              LXI   H,PROG   ; the heap starts after the program's NUL
                    FNUL:     MOV   A,M   
                              INX   H   
                              ORA   A   
                              JNZ   fnul   
0541                          ENDIF      
0541   22 7C 08               SHLD   HEAP   
0544                          IF   CHECKED   
                              RST   4   ; minus the heap"s first address: "_' may not
                              SHLD   NPEND   ;   release below it
0544                          ENDIF      
0544   21 E0 06               LXI   H,RSTOP   ; the return stack is empty
0547   22 34 08               SHLD   RSP   
054A                          IF   (1-CHECKED)*(1-CPM)   
                              MOV   H,A   ; (A = 0, from the search for the NUL) no key
                              MOV   L,A   ;   is held, and the break key is on (the
054A                          ENDIF      ;   checked build has cleared these)
054A                          IF   (1-CHECKED)*CPM   
054A   21 00 00               LXI   H,0   
054D                          ENDIF      
054D                          IF   1-CHECKED   
054D   22 7A 08               SHLD   KEYBUF   
0550                          ENDIF      
0550   01 00 09               LXI   B,PROG   ; the IP
0553   F7                     RST   6   ; (its return address is thrown away)
0554                          IF   CPM   
0554                             ; RAM pages, after the image
0554                RSPAGE:   EQU   (imgend + 255) / 256   
0554                DSPAGE:   EQU   RSPAGE + 1   
0554                LETPAGE:   EQU   RSPAGE + 2   
0554                PROG:     EQU   LETPAGE*256 + 256   
0554                          ENDIF      
0554                IMGEND:      


