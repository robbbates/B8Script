022B                          DS   (1-CPM)*(1-FAST),0F7h   
022B   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
022C   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
022D   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
022E   D1           H_AND:    POP   D   
022F   7C                     MOV   A,H   
0230   A2                     ANA   D   
0231   67                     MOV   H,A   
0232   7D                     MOV   A,L   
0233   A3                     ANA   E   
0234   6F                     MOV   L,A   
0235                          ;*Macro unroll:  NEXT
0235                          DS   (1-CPM)*(1-FAST),0F7h   
0235   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
0236   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
0237   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
0238                             ; Signed compares. Both are "DE < HL" for the right pair: > swaps the two
0238                             ; cells first (XTHL), < doesn't. There is no overflow flag, so the signed
0238                             ; answer is the unsigned borrow of DE - HL, flipped when the signs differ.
0238                             ; SBB A turns a carry into -1 or 0 with no branch.
0238   E3           H_GT:     XTHL      ; a > b  is  b < a
0239   D1           H_LT:     POP   D   ; a < b: DE = a, HL = b
023A   7B                     MOV   A,E   
023B   95                     SUB   L   
023C   7A                     MOV   A,D   
023D   9C                     SBB   H   
023E   9F                     SBB   A   ; A = -1 if DE < HL unsigned
023F   6F                     MOV   L,A   
0240   7C                     MOV   A,H   
0241   AA                     XRA   D   
0242   17                     RAL      ; carry = the signs differ
0243   9F                     SBB   A   
0244   AD                     XRA   L   ; flip when they do
0245   67                     MOV   H,A   
0246   6F                     MOV   L,A   
0247                          ;*Macro unroll:  NEXT
0247                          DS   (1-CPM)*(1-FAST),0F7h   
0247   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
0248   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
0249   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
024A   D1           H_EQ:     POP   D   
024B   7D                     MOV   A,L   
024C   AB                     XRA   E   
024D   6F                     MOV   L,A   
024E   7C                     MOV   A,H   
024F   AA                     XRA   D   
0250   B5                     ORA   L   ; zero if equal
0251   D6 01                  SUI   1   ; carry only for zero
0253   9F                     SBB   A   
0254   67                     MOV   H,A   
0255   6F                     MOV   L,A   
0256                          ;*Macro unroll:  NEXT
0256                          DS   (1-CPM)*(1-FAST),0F7h   
0256   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
0257   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
0258   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
0259                             ; "*": shift-and-add on the multiplier's low bit, so it stops as soon as the
0259                             ; multiplier is used up; only the low 16 bits are kept.
0259                          IF   QK   
0259   D1           H_MUL:    POP   D   ; DE = multiplicand
025A   C3 0F 05               JMP   mulq   ; (out of the handlers' pages: see Speed-ups)
025D                          ENDIF      
025D                          IF   1-QK   
                    H_MUL:    POP   D   ; DE = multiplicand
                              PUSH   B   
                              MOV   B,H   
                              MOV   C,L   ; BC = multiplier
                              LXI   H,0   
                    MUL1:     MOV   A,B   
                              ORA   A   ; clear carry
                              RAR      
                              MOV   B,A   
                              MOV   A,C   
                              RAR      
                              MOV   C,A   ; BC >> 1, carry = the bit shifted out
                              JNC   mul2   
                              DAD   D   
                    MUL2:     XCHG      
                              DAD   H   ; multiplicand << 1
                              XCHG      
                              MOV   A,B   
                              ORA   C   
                              JNZ   mul1   
                              POP   B   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0C3h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
025D                          ENDIF      
025D                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
025D                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
025D                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
025D                             ; stops on it.
025D                H_DIV:       
025D                          IF   CHECKED   
                              MOV   A,H   
                              ORA   L   
                              JZ   e_zero   
025D                          ENDIF      
025D   D1                     POP   D   ; DE = a, HL = b
025E   C5                     PUSH   B   
025F   7A                     MOV   A,D   
0260   B7                     ORA   A   
0261   F5                     PUSH   PSW   ; S flag = sign of a (for r)
0262   AC                     XRA   H   
0263   F5                     PUSH   PSW   ; S flag = sign of q
0264   7C                     MOV   A,H   
0265   B7                     ORA   A   
0266   FC 27 01               CM   neg16   ; HL = |b|
0269   EB                     XCHG      
026A   7C                     MOV   A,H   
026B   B7                     ORA   A   
026C   FC 27 01               CM   neg16   ; HL = |a|, DE = |b|
026F   CD 56 03               CALL   udiv   ; HL = q, BC = r
0272   F1                     POP   PSW   
0273   FC 27 01               CM   neg16   ; q's sign
0276   EB                     XCHG      ; DE = q
0277   60                     MOV   H,B   
0278   69                     MOV   L,C   ; HL = r
0279   F1                     POP   PSW   
027A   FC 27 01               CM   neg16   ; r's sign
027D   C1                     POP   B   
027E   D5                     PUSH   D   ; q under r
027F                          ;*Macro unroll:  NEXT
027F                          DS   (1-CPM)*(1-FAST),0F7h   
027F   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
0280   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
0281   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
0282                             ; ---- stack and storage -----------------------------------------------------
0282   E5           H_DUP:    PUSH   H   ; ":"
0283                          ;*Macro unroll:  NEXT
0283                          DS   (1-CPM)*(1-FAST),0F7h   
0283   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
0284   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
0285   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
0286   E3           H_SWAP:   XTHL      ; "%"
0287                          ;*Macro unroll:  NEXT
0287                          DS   (1-CPM)*(1-FAST),0F7h   
0287   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
0288   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
0289   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
028A                             ; (The checked build tests the address before it takes the value off the
028A                             ; stack, so that an error report shows both.)
028A                H_STORE:      ; "!" ( n addr -- )
028A                          IF   CHECKED   
                              CALL   chkst   
028A                          ENDIF      
028A   D1                     POP   D   
028B   73                     MOV   M,E   
028C   23                     INX   H   
028D   72                     MOV   M,D   
028E                          ;*Macro unroll:  DROP
028E                          DS   (1-CPM)*(1-FAST),0DFh   
028E   C3                     DS   CPM*(1-FAST),0C3h   
028F   1C                     DS   CPM*(1-FAST),ADRP&0FFh   
0290   01                     DS   CPM*(1-FAST),ADRP/256   
0291                          DS   FAST,0E1h   
0291                          DS   FAST,0C3h   
0291                          DS   FAST,ANXT&0FFh   
0291                          DS   FAST,ANXT/256   
0291                H_CSTORE:      ; "." ( c addr -- )
0291                          IF   CHECKED   
                              CALL   chkst   
0291                          ENDIF      
0291   D1                     POP   D   
0292   73                     MOV   M,E   
0293                          ;*Macro unroll:  DROP
0293                          DS   (1-CPM)*(1-FAST),0DFh   
0293   C3                     DS   CPM*(1-FAST),0C3h   
0294   1C                     DS   CPM*(1-FAST),ADRP&0FFh   
0295   01                     DS   CPM*(1-FAST),ADRP/256   
0296                          DS   FAST,0E1h   
0296                          DS   FAST,0C3h   
0296                          DS   FAST,ANXT&0FFh   
0296                          DS   FAST,ANXT/256   
0296                             ; ---- console ---------------------------------------------------------------
0296                             ; 22h pushes the address of the text after it and skips the string.
0296   E5           H_STR:    PUSH   H   
0297   60                     MOV   H,B   
0298   69                     MOV   L,C   
0299   CD EF 04               CALL   skipstr   
029C                          IF   CHECKED   
                              ORA   A   ; 0: the text ran out before the closing quote
                              JZ   e_quote   
029C                          ENDIF      
029C                          ;*Macro unroll:  NEXT
029C                          DS   (1-CPM)*(1-FAST),0F7h   
029C   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
029D   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
029E   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
029F                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
029F                             ; 60h to 7Eh is one of the escapes at pesc; "/" plus any other character
029F                             ; clears that character"s bit 6 (/M is CR, and / then DEL gives "?"; "/',
029F                             ; '"' and '?' have no bit 6, so //, /" and /? give themselves).
029F                          IF   1-CHECKED   
029F   C3 CF 03     H_PRINT:   JMP   prlp   ; (the loop is with the escapes, out of the
02A2                PRLOOP:   EQU   prlp   ;   way of the handlers, which must fit in
02A2                PRAGAIN:   EQU   prlp   ;   the image's first two pages)
02A2                          ENDIF      
02A2                          IF   CHECKED   
                                 ; (The checked build has the loop as a routine, prstr, which the error
                                 ; report uses too. The address is kept meanwhile, for a report: it shows
                                 ; the stack as it was before the "$". /~ comes back to hp1.)
                    H_PRINT:   SHLD   PSAVE   
                    HP1:      CALL   prstr   
                              ;*Macro unroll:  DROP
                              DS   (1-CPM)*(1-FAST),0DFh   
                              DS   CPM*(1-FAST),0C3h   
                              DS   CPM*(1-FAST),ADRP&0FFh   
                              DS   CPM*(1-FAST),ADRP/256   
                              DS   FAST,0E1h   
                              DS   FAST,0C3h   
                              DS   FAST,ANXT&0FFh   
                              DS   FAST,ANXT/256   
02A2                          ENDIF      
02A2   7D           H_EMIT:   MOV   A,L   ; "'"
02A3                          ;*Macro unroll:  PUTA
02A3                          DS   1-CPM,0EFh   
02A3   CD                     DS   CPM,0CDh   
02A4   E8                     DS   CPM,APUT&0FFh   
02A5   05                     DS   CPM,APUT/256   
02A6                          ;*Macro unroll: h_drop: DROP                    ; ';' is this one byte
02A6                H_DROP:   DS   (1-CPM)*(1-FAST),0DFh   ; ";" is this one byte
02A6   C3                     DS   CPM*(1-FAST),0C3h   
02A7   1C                     DS   CPM*(1-FAST),ADRP&0FFh   
02A8   01                     DS   CPM*(1-FAST),ADRP/256   
02A9                          DS   FAST,0E1h   
02A9                          DS   FAST,0C3h   
02A9                          DS   FAST,ANXT&0FFh   
02A9                          DS   FAST,ANXT/256   
02A9                             ; "#" prints TOS as a signed decimal number, with no space after it.
02A9   C5           H_NUM:    PUSH   B   
02AA   CD AE 03               CALL   psgn   
02AD   C1                     POP   B   
02AE                          ;*Macro unroll:  DROP
02AE                          DS   (1-CPM)*(1-FAST),0DFh   
02AE   C3                     DS   CPM*(1-FAST),0C3h   
02AF   1C                     DS   CPM*(1-FAST),ADRP&0FFh   
02B0   01                     DS   CPM*(1-FAST),ADRP/256   
02B1                          DS   FAST,0E1h   
02B1                          DS   FAST,0C3h   
02B1                          DS   FAST,ANXT&0FFh   
02B1                          DS   FAST,ANXT/256   
02B1                          IF   CHECKED   ; (the checked build has no room to start ","
                    H_CFETCH:   MOV   L,M   ;   as late as the unchecked one does: see
                              MVI   H,0   ;   the end of "?")
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0C3h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
02B1                          ENDIF      
02B1                             ; "?" ( n -- c ) or ( -n -- addr )
02B1                             ;   n > 0: wait about n ms for a key; 0 if none came
02B1                             ;   n = 0: wait for a key
02B1                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
02B1                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
02B1   7C           H_KEY:    MOV   A,H   
02B2   B7                     ORA   A   
02B3   FA D5 02               JM   line   
02B6   1E 04        KT1:      MVI   E,MSLOOP   ; one millisecond, roughly
02B8   CD B6 05     KT2:      CALL   getk   
02BB   C2 CF 02               JNZ   kt3   
02BE   1D                     DCR   E   
02BF   C2 B8 02               JNZ   kt2   
02C2   7C                     MOV   A,H   ; 0? never counts down: it waits
02C3   B5                     ORA   L   
02C4   CA B6 02               JZ   kt1   
02C7   2B                     DCX   H   
02C8   7C                     MOV   A,H   
02C9   B5                     ORA   L   
02CA   C2 B6 02               JNZ   kt1   ; A = 0 if the time ran out
02CD                          IF   1-CHECKED   
02CD   FE                     DB   0FEh   ; (CPI: steps over the one byte of ",")
02CE   7E           H_CFETCH:   MOV   A,M   ; "," shares "?"s ending: A becomes TOS
02CF                          ENDIF      
02CF   6F           KT3:      MOV   L,A   
02D0   26 00                  MVI   H,0   
02D2                          ;*Macro unroll:  NEXT
02D2                          DS   (1-CPM)*(1-FAST),0F7h   
02D2   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
02D3   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
02D4   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
02D5                             ; Backspace takes the last character back (and is echoed as
02D5                             ; it is), CR ends (stored, not echoed), every other key is stored and
02D5                             ; echoed until the line is full. The line buffer starts at offset 80h
02D5                             ; of its page, so L alone is the place in the line: D holds the L of
02D5                             ; a full line.
02D5   11 7F 00     LINE:     LXI   D,127   ; TOS is minus the count: adding 127 carries
02D8   19                     DAD   D   ;   only for 1 to 127, and leaves 127 - count
02D9   9F                     SBB   A   
02DA   A5                     ANA   L   ; (0 for a count that is too big)
02DB   2F                     CMA      
02DC   57                     MOV   D,A   ; D = the L of a full line: 80h + count, FFh
02DD                             ;   at most
02DD   21 80 0A               LXI   H,LINEBUF   
02E0   CD B6 05     LN2:      CALL   getk   
02E3   CA E0 02               JZ   ln2   
02E6   FE 0D                  CPI   13   
02E8   CA 07 03               JZ   ln5   
02EB   FE 08                  CPI   8   
02ED   CA FF 02               JZ   ln4   
02F0   5F                     MOV   E,A   
02F1   7D                     MOV   A,L   
02F2   BA                     CMP   D   
02F3   CA E0 02               JZ   ln2   ; full
02F6   73                     MOV   M,E   
02F7   2C                     INR   L   
02F8   7B                     MOV   A,E   
02F9                          ;*Macro unroll: ln3:    PUTA
02F9                LN3:      DS   1-CPM,0EFh   
02F9   CD                     DS   CPM,0CDh   
02FA   E8                     DS   CPM,APUT&0FFh   
02FB   05                     DS   CPM,APUT/256   
02FC   C3 E0 02               JMP   ln2   
02FF   2D           LN4:      DCR   L   ; Backspace: one back, and echo it,
0300   FA F9 02               JM   ln3   ;   unless the line was empty (L left the
0303   2C                     INR   L   ;   upper half of the page)
0304   C3 E0 02               JMP   ln2   
0307   77           LN5:      MOV   M,A   ; the CR
0308   2E 80                  MVI   L,LINEBUF & 0FFh   
030A                          ;*Macro unroll:  NEXT
030A                          DS   (1-CPM)*(1-FAST),0F7h   
030A   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
030B   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
030C   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
030D                             ; =============================================================================
030D                             ;  Dispatch table: the low byte of each handler's address, in code order.
030D                             ;  It must not cross a page (the dispatcher only adds to its low byte).
030D                             ; =============================================================================
030D                             ; The handlers of the first NPG1 characters start in the image's second page.
030D                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
030D                             ; differs between the builds, so the count is worked out here.
030D                             ; (One division to a line: asm80 only rounds down when it stores a value.)
030D                          IF   1-FAST   
030D                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
030D                PGBRK:    EQU   (h_break-BASE)/256   
030D                PGDEF:    EQU   (h_def-BASE)/256   
030D                PGFET:    EQU   (h_fetch-BASE)/256   
030D                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
030D                          ENDIF      
030D                          IF   (1-FAST)*(1-PTLATE)   
030D                PTAB:        
030D                          ;*Macro unroll:  PTABLE
030D   8A                     DB   h_store & 0FFh   
030E   96                     DB   h_str & 0FFh   
030F   A9                     DB   h_num & 0FFh   
0310   9F                     DB   h_print & 0FFh   
0311   86                     DB   h_swap & 0FFh   
0312   2E                     DB   h_and & 0FFh   
0313   A2                     DB   h_emit & 0FFh   
0314   0A                     DB   h_open & 0FFh   
0315   16                     DB   h_close & 0FFh   
0316   59                     DB   h_mul & 0FFh   
0317   29                     DB   h_add & 0FFh   
0318   CE                     DB   h_cfetch & 0FFh   
0319   1E                     DB   h_sub & 0FFh   
031A   91                     DB   h_cstore & 0FFh   
031B   5D                     DB   h_div & 0FFh   
031C   82                     DB   h_dup & 0FFh   
031D   A6                     DB   h_drop & 0FFh   
031E   39                     DB   h_lt & 0FFh   
031F   4A                     DB   h_eq & 0FFh   
0320   38                     DB   h_gt & 0FFh   
0321   B1                     DB   h_key & 0FFh   
0322   03                     DB   h_fetch & 0FFh   
0323   E1                     DB   h_def & 0FFh   
0324   D2                     DB   h_break & 0FFh   
0325   C9                     DB   h_ret & 0FFh   
0326   82                     DB   h_xor & 0FFh   
0327   9D                     DB   h_alloc & 0FFh   
0328   AA                     DB   h_grave & 0FFh   
0329   18                     DB   h_tor & 0FFh   
032A   8C                     DB   h_or & 0FFh   
032B   20                     DB   h_fromr & 0FFh   
032C   96                     DB   h_not & 0FFh   
032D                PTABEND:      
032D                          ENDIF      
032D                             ; =============================================================================
032D                             ;  Routines (no handler starts past this point)
032D                             ; =============================================================================
032D                             ; Digits: step back onto the first digit and read the whole number.
032D   E5           DIGIT:    PUSH   H   
032E   0B                     DCX   B   
032F   CD 3F 03               CALL   rdnum   
0332                          ;*Macro unroll:  NEXT
0332                          DS   (1-CPM)*(1-FAST),0F7h   
0332   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
0333   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
0334   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
0335                             ; negnum: "-" directly before a digit: read the number, negate it.
0335   E5           NEGNUM:   PUSH   H   
0336   CD 3F 03               CALL   rdnum   
0339                          ;*Macro unroll:  NEGH
0339                          DS   1-CPM,0E7h   
0339   CD                     DS   CPM,0CDh   
033A   27                     DS   CPM,ANEG&0FFh   
033B   01                     DS   CPM,ANEG/256   
033C                          ;*Macro unroll:  NEXT
033C                          DS   (1-CPM)*(1-FAST),0F7h   
033C   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
033D   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
033E   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
033F                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
033F                             ; non-digit. Values wrap at 16 bits, as the spec says.
033F   21 00 00     RDNUM:    LXI   H,0   
0342   0A           RDN1:     LDAX   B   
0343   D6 30                  SUI   "0"   
0345   FE 0A                  CPI   10   
0347   D0                     RNC      
0348   03                     INX   B   
0349   54                     MOV   D,H   
034A   5D                     MOV   E,L   
034B   29                     DAD   H   
034C   29                     DAD   H   
034D   19                     DAD   D   
034E   29                     DAD   H   ; HL * 10
034F   5F                     MOV   E,A   
0350   16 00                  MVI   D,0   
0352   19                     DAD   D   
0353   C3 42 03               JMP   rdn1   
0356                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, BC = remainder.
0356                             ; Uses A, BC; the caller saves the IP. HL holds the dividend and, as its bits
0356                             ; leave at the top, the quotient bits arrive at the bottom. The loop counter
0356                             ; lives on the stack, since A is busy with the shifts.
0356                             ; Dividing by 2 is one shift (the spec wants that fast).
0356   01 00 00     UDIV:     LXI   B,0   
0359                          IF   1-QK   
                              MOV   A,E   
                              XRI   2   
                              ORA   D   
                              JNZ   udv0   
                              ORA   H   ; A was 0, and the carry is clear
                              RAR      
                              MOV   H,A   
                              MOV   A,L   
                              RAR      
                              MOV   L,A   ; the quotient
                              MOV   A,B   
                              RAL      
                              MOV   C,A   ; the remainder: the bit that fell out
                              RET      
0359                          ENDIF      
0359                          IF   QK   
0359                             ; (The builds with room divide by any power of two with shifts: 2, and 32,
0359                             ; 64, 256 and the like, which fixed point and byte work use all the time.)
0359   7A                     MOV   A,D   
035A   B7                     ORA   A   
035B   C2 79 03               JNZ   uq1   ; 256 and up
035E   B3                     ORA   E   
035F   CA 90 03               JZ   udv0   ; by 0: the long way (it means nothing anyway)
0362   3D                     DCR   A   
0363   A3                     ANA   E   
0364   C2 90 03               JNZ   udv0   ; not a power of two
0367   7B                     MOV   A,E   ; by 2^k below 256: q = HL >> k, and
0368   3D                     DCR   A   ;   r = L & (2^k - 1)
0369   A5                     ANA   L   
036A   4F                     MOV   C,A   
036B                          ENDIF      
036B                          IF   QK*(1-FAST)   
036B   7B           UQ2:      MOV   A,E   ; one shift for each halving of E down to 1
036C   B7                     ORA   A   
036D   1F                     RAR      
036E   D8                     RC      
036F   5F                     MOV   E,A   
0370   7C                     MOV   A,H   ; (the carry is clear: E's bit 0 was 0)
0371   1F                     RAR      
0372   67                     MOV   H,A   
0373   7D                     MOV   A,L   
0374   1F                     RAR      
0375   6F                     MOV   L,A   
0376   C3 6B 03               JMP   uq2   
0379                          ENDIF      
0379                          IF   FAST   
                                 ; (the fast build: the shifts unrolled. By 16 to 128 it is fewer shifts to
                                 ; go the other way: A:HL up by 8 - k, and A:H is the quotient)
                    UQ2:      MOV   A,E   
                              CPI   16   
                              JNC   uqh   
                              CPI   2   
                              RC      ; by 1
                              JZ   ur1   
                              CPI   4   
                              JZ   ur2   
                    UR3:         
                              MOV   A,H   
                              ORA   A   
                              RAR      
                              MOV   H,A   
                              MOV   A,L   
                              RAR      
                              MOV   L,A   
                    UR2:         
                              MOV   A,H   
                              ORA   A   
                              RAR      
                              MOV   H,A   
                              MOV   A,L   
                              RAR      
                              MOV   L,A   
                    UR1:         
                              MOV   A,H   
                              ORA   A   
                              RAR      
                              MOV   H,A   
                              MOV   A,L   
                              RAR      
                              MOV   L,A   
                              RET      
                    UQH:      CPI   64   
                              MVI   A,0   
                              JZ   ul2   
                              JNC   ul1   
                              MOV   A,E   
                              CPI   32   
                              MVI   A,0   
                              JZ   ul3   
                              DAD   H   ; by 16
                              ADC   A   
                    UL3:      DAD   H   
                              ADC   A   
                    UL2:      DAD   H   
                              ADC   A   
                    UL1:      DAD   H   
                              ADC   A   
                              MOV   L,H   
                              MOV   H,A   
                              RET      
0379                          ENDIF      
0379                          IF   QK   
0379   7B           UQ1:      MOV   A,E   
037A   B7                     ORA   A   
037B   C2 90 03               JNZ   udv0   
037E   7A                     MOV   A,D   
037F   3D                     DCR   A   
0380   A2                     ANA   D   
0381   C2 90 03               JNZ   udv0   ; not a power of two
0384   7A                     MOV   A,D   ; by 2^k, 256 and up: r = HL & (2^k - 1), and
0385   3D                     DCR   A   ;   q = H >> (k - 8)
0386   A4                     ANA   H   
0387   47                     MOV   B,A   
0388   4D                     MOV   C,L   
0389   6C                     MOV   L,H   
038A   26 00                  MVI   H,0   
038C   5A                     MOV   E,D   
038D   C3 6B 03               JMP   uq2   
0390                          ENDIF      
0390                          IF   1-FAST   
0390   3E 10        UDV0:     MVI   A,16   
0392   F5                     PUSH   PSW   
0393   29           UDV1:     DAD   H   ; next dividend bit into the carry
0394   79                     MOV   A,C   
0395   17                     RAL      
0396   4F                     MOV   C,A   
0397   78                     MOV   A,B   
0398   17                     RAL      
0399   47                     MOV   B,A   ; BC = BC*2 + bit
039A   79                     MOV   A,C   
039B   93                     SUB   E   
039C   78                     MOV   A,B   
039D   9A                     SBB   D   ; carry if BC < DE
039E   DA A6 03               JC   udv2   
03A1   47                     MOV   B,A   ; BC - DE (high byte; A holds it)
03A2   79                     MOV   A,C   
03A3   93                     SUB   E   
03A4   4F                     MOV   C,A   
03A5   2C                     INR   L   ; quotient bit
03A6   F1           UDV2:     POP   PSW   
03A7   3D                     DCR   A   
03A8   F5                     PUSH   PSW   
03A9   C2 93 03               JNZ   udv1   
03AC   F1                     POP   PSW   
03AD   C9                     RET      
03AE                          ENDIF      
03AE                          IF   FAST   
                                 ; (the fast build: the same 16 rounds, unrolled; and a dividend below 256
                                 ; starts 8 bits up and takes only the last 8, since its first 8 would only
                                 ; shift zeros)
                    UDV0:     MOV   A,H   
                              ORA   A   
                              JZ   uvs   
                    UV0:      DAD   H   
                              MOV   A,C   
                              RAL      
                              MOV   C,A   
                              MOV   A,B   
                              RAL      
                              MOV   B,A   ; BC = BC*2 + bit
                              MOV   A,C   
                              SUB   E   
                              MOV   A,B   
                              SBB   D   ; carry if BC < DE
                              JC   uw0   
                              MOV   B,A   
                              MOV   A,C   
                              SUB   E   
                              MOV   C,A   
                              INR   L   ; quotient bit
                    UW0:         
                    UV1:      DAD   H   
                              MOV   A,C   
                              RAL      
                              MOV   C,A   
                              MOV   A,B   
                              RAL      
                              MOV   B,A   ; BC = BC*2 + bit
                              MOV   A,C   
                              SUB   E   
                              MOV   A,B   
                              SBB   D   ; carry if BC < DE
                              JC   uw1   
                              MOV   B,A   
                              MOV   A,C   
                              SUB   E   
                              MOV   C,A   
                              INR   L   ; quotient bit
