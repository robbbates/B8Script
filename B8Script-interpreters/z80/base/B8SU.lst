028E                H_DROP:   DS   (1-CPM)*(1-FAST),0DFh   ; ";" is this one byte
028E   E1                     DS   CPM+FAST-CPM*FAST,0E1h   
028F   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0290   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0291                H_STORE:      ; "!" ( n addr -- )
0291                          IF   CHECKED   
                              CALL   chkst   
0291                          ENDIF      
0291   D1                     POP   DE   
0292   73                     LD   (HL),E   
0293   23                     INC   HL   
0294   72                     LD   (HL),D   
0295                          ;*Macro unroll:  DROP
0295                          DS   (1-CPM)*(1-FAST),0DFh   
0295   E1                     DS   CPM+FAST-CPM*FAST,0E1h   
0296   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
0297   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
0298                             ; ---- console ---------------------------------------------------------------
0298                             ; 22h pushes the address of the text after it and skips the string.
0298   E5           H_STR:    PUSH   HL   
0299   60                     LD   H,B   
029A   69                     LD   L,C   
029B   CD F4 03               CALL   skipstr   
029E                          IF   CHECKED   
                              OR   A   ; 0: the text ran out before the closing quote
                              JP   Z,e_quote   
029E                          ENDIF      
029E                          ;*Macro unroll:  NEXT
029E                          DS   (1-CPM)*(1-FAST),0F7h   
029E   DD                     DS   CPM+FAST-CPM*FAST,0DDh   
029F   E9                     DS   CPM+FAST-CPM*FAST,0E9h   
02A0                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
02A0                             ; 60h to 7Eh is one of the escapes at pesc; "/" plus any other character
02A0                             ; clears that character"s bit 6 (/M is CR, and / then DEL gives "?"; "/',
02A0                             ; '"' and '?' have no bit 6, so //, /" and /? give themselves).
02A0                          IF   1-CHECKED   
02A0   7E           H_PRINT:   LD   A,(HL)   
02A1   23                     INC   HL   
02A2   FE 22                  CP   22h   
02A4   28 19                  JR   Z,pr9   
02A6   FE 2F                  CP   "/"   
02A8   20 0C                  JR   NZ,pr1   
02AA   7E                     LD   A,(HL)   
02AB   23                     INC   HL   
02AC   FE 60                  CP   60h   
02AE   38 04                  JR   C,pr0   
02B0   FE 7F                  CP   7Fh   
02B2   38 63                  JR   C,pesc   
02B4   E6 BF        PR0:      AND   0BFh   
02B6                          ;*Macro unroll: pr1:    PUTA
02B6                PR1:      DS   1-CPM,0EFh   
02B6   CD                     DS   CPM,0CDh   
02B7   89                     DS   CPM,APUT&0FFh   
02B8   05                     DS   CPM,APUT/256   
02B9   18 E5                  JR   h_print   
02BB                PRLOOP:   EQU   h_print   ; (where the escapes go back to)
02BB                PRAGAIN:   EQU   h_print   ; (and where /~ goes back to)
02BB                          ENDIF      
02BB                          IF   CHECKED   
                                 ; (The checked build has the loop as a routine, prstr, which the error
                                 ; report uses too. The address is kept meanwhile, for a report: it shows
                                 ; the stack as it was before the "$". /~ comes back to hp1.)
                    H_PRINT:   LD   (RSAVE),HL   
                    HP1:      CALL   prstr   
                              ;*Macro unroll:  DROP
                              DS   (1-CPM)*(1-FAST),0DFh   
                              DS   CPM+FAST-CPM*FAST,0E1h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
02BB                          ENDIF      
02BB   7D           H_EMIT:   LD   A,L   ; "'"
02BC                          ;*Macro unroll:  PUTA
02BC                          DS   1-CPM,0EFh   
02BC   CD                     DS   CPM,0CDh   
02BD   89                     DS   CPM,APUT&0FFh   
02BE   05                     DS   CPM,APUT/256   
