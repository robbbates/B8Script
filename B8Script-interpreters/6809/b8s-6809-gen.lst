                              BEQ   gk9   
                              CMPA   #3   
                              LBEQ   e_break   
                              STA   <KEYBUF   
                              RTS      
                                 ; getk: a key held back by the break check goes first; then the host's KEY.
                    GETK:     LDA   <KEYBUF   
                              BEQ   gk1   
                              CLR   <KEYBUF   
                              TSTA      
                    GK9:      RTS      
                    GK1:      JMP   KEY   
F2E5                          ENDIF      
