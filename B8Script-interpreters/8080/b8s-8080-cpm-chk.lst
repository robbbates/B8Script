0565   EB                     XCHG      
0566   E5                     PUSH   H   ; the count
0567   2A 38 0A               LHLD   NPEND   
056A   19                     DAD   D   ; carry: at or above the program's end
056B   E1                     POP   H   
056C   EB                     XCHG      
056D   D8                     RC      
056E   EB           E_HEAP:   XCHG      ; put the count back in TOS for the report,
056F   D1                     POP   D   ;   and drop the return address (errp drops
0570   3E 48                  MVI   A,"H"   ;   the old top)
0572   C3 09 06               JMP   errp   
0575                             ; chkst: stop unless HL is in the program's own space: from the letter page
0575                             ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
0575                             ; whatever lies above the limit are safe. Memory above the heap top but
0575                             ; below the limit is the program's own: Tiny BASIC keeps its lines there.
0575                             ; It is the page of HL + 1 that is tested, so that one test serves both
0575                             ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
0575                             ; Keeps HL and BC. It runs on into its own error entry.
0575   23           CHKST:    INX   H   
0576   7C                     MOV   A,H   
0577   2B                     DCX   H   
