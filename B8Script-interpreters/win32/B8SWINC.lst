  1919 000007B4 00000000            <1>         dd      0                       ; TimeDateStamp
  1920 000007B8 00000000            <1>         dd      0                       ; ForwarderChain
  1921 000007BC [1009C0FF]          <1>         dd      dllname-IB              ; Name
  1922 000007C0 [2009C0FF]          <1>         dd      iat-IB                  ; FirstThunk: the IAT
  1923 000007C4 00<rep 14h>         <1>         times   20 db 0                 ; the null entry that ends the list
  1924                              <1> idesc_end:
