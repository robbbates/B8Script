   936                              <1> ; =============================================================================
   937                              <1> ;  Checked build: the checks and the error report (here, so that the
   938                              <1> ;  handlers' bodies above reach the error entries with short jumps)
   939                              <1> ; =============================================================================
   940                              <1> %if CHECKED
   941                              <1> e_zero: mov     al,'Z'                  ; dividing by zero
   942                              <1>         jmp     error
   943                              <1> e_heap: mov     al,'H'                  ; the heap
   944                              <1>         jmp     error
   945                              <1> 
   946                              <1> ; chkst1, chkst2: stop with O unless the 1 or 2 bytes at TOS are in the
   947                              <1> ; program's space: from the letter page up to the heap limit. Memory above
   948                              <1> ; the heap top but below the limit is the program's own: Tiny BASIC keeps
   949                              <1> ; its lines there.
   950                              <1> chkst2: mov     eax,ebx
   951                              <1>         sub     ax,LET
   952                              <1>         cmp     ax,LIMIT-LET-1
   953                              <1>         jmp     short chs1
   954                              <1> chkst1: mov     eax,ebx
   955                              <1>         sub     ax,LET
   956                              <1>         cmp     ax,LIMIT-LET
   957                              <1> chs1:   jae     e_store
   958                              <1>         ret
   959                              <1> 
   960                              <1> ; chkstk: both stacks are checked once per character, not in every handler.
   961                              <1> ; A character can pop a cell or two too many, or push one too many, before
   962                              <1> ; it is seen here: the data stack has the caller's frame above it and the
   963                              <1> ; thread's stack below, and the return stack has the image's spare space on
   964                              <1> ; both sides.
   965                              <1> chkstk: lea     eax,[esp+4]
   966                              <1>         sub     eax,[V(v_dstop)]        ; minus 4 x the depth
   967                              <1>         jg      e_under
   968                              <1>         cmp     eax,-4*DSMAX
   969                              <1>         jl      e_over
   970                              <1>         cmp     di,RSTOP & 0FFFFh       ; (the return stack is in one 64K: only
   971                              <1>         ja      e_rund                  ;   the low word changes)
   972                              <1>         cmp     di,(RSTOP-4*RSMAX) & 0FFFFh
   973                              <1>         jb      e_rover
   974                              <1>         ret
   975                              <1> e_under:mov     esp,[V(v_dstop)]        ; data stack underflow: it counts as
   976                              <1>         mov     al,'s'                  ;   empty
   977                              <1>         jmp     short error
   978                              <1> e_rund: mov     edi,RSTOP               ; return stack underflow: the same.
   979                              <1>         or      esi,ARENA               ;   (A ']' or ')' may have taken an IP
   980                              <1>         mov     al,'r'                  ;   of 0 from below the stack: keep the
   981                              <1>                                         ;   place readable)
   982                              <1>         jmp     short errp
   983                              <1> e_rover:mov     al,'R'
