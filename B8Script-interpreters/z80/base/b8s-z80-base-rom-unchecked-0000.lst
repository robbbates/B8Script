0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Spec: docs/b8script.md (2026-11-24).
0000                             ; 
0000                             ;  The switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    EDITOR   1 = with the line editor built in (see the end of this file):
0000                             ;                 the spec's suggested standard. It goes with either setting
0000                             ;                 of the other two.
0000                             ;    CHECKED  0 = no checks (spec: the programmer is responsible)
0000                             ;             1 = starts with every variable at 0 and every word undefined,
0000                             ;                 and stops on every error in the spec's table (and Ctrl-C)
0000                             ;                 with a three-line report: the letter and the place as line
0000                             ;                 and column, and both stacks. See `error`.
0000                             ;    SPEED    0 = small: the smallest build
0000                             ;             1 = base, the default: the speed-ups that cost bytes: a skip
0000                             ;                 cache, a faster skip, "*" and "/" quicker for small and
0000                             ;                 power-of-two operands, and more (see "Speed-ups")
0000                             ;             2 = fast: base and a dispatch table besides, with no size
0000                             ;                 limit (see "The fast build"). Not with EDITOR.
0000                             ;    ANSI     what the console escapes of "$" (/00bbIC8= /| /` /~) do:
0000                             ;             1 = send ANSI (VT100) sequences through CONOUT
0000                             ;             0 = call the machine's own routines CONCLS, CONEOL, CONCUR and
0000                             ;                 CONAT (see the equates). The CP/M builds always send ANSI.
0000                             ; 
0000                             ;  In every build Ctrl-C stops a running program (an unchecked build stops
0000                             ;  without a word): see the console layer for the rules, the held key and
0000                             ;  the break-off cell.
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   0   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   0   ; 1 = checked build
0000                EDITOR:   EQU   0   ; 1 = with the line editor
0000                ANSI:     EQU   0   ; 1 = the console escapes send ANSI sequences
0000                SPEED:    EQU   1   ; 0 = small, 1 = base, 2 = fast (not with EDITOR) (see "Speed-ups")
0000                FAST:     EQU   SPEED/2   ; (1: the fast build)
0000                SBASE:    EQU   SPEED-FAST*2   ; (1: the base build)
0000                ANS:      EQU   ANSI+CPM-ANSI*CPM   ; (CP/M: always ANSI)
0000                EDGEN:    EQU   EDITOR*(1-CPM)   ; (the generic build with the editor)
0000                             ; (IF takes any value but 0 as true, so
0000                             ;  IF CHECKED+EDITOR means "either")
0000                TABP0:    EQU   EDGEN*(1-CHECKED)   ; (the build with its table in page zero)
0000                PTLATE:   EQU   1-(1-CPM)*(1-EDITOR)*(1-CHECKED)*(1-ANS)   ; (1: the table goes after psgn and pdec,
0000                             ;   not before them: wherever it doesn't cross a
0000                             ;   page. chktab.py says if it does)
0000                QK:       EQU   SBASE+FAST-SBASE*FAST   ; (the speed-ups: base, or the fast build)
0000                SBASEU:   EQU   QK*(1-CHECKED)*(1-FAST)   ; (and those that only the unchecked
0000                             ;  builds take; the fast build has its own)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    IY   return-stack pointer. Entries are 2 bytes; the stack grows down.
0000                             ;         Only rpop and rpushn (and the checks) touch it. The alternate
0000                             ;         registers are not used at all: an interrupt routine may use them.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  One-byte calls. In a generic build the routines used most are reached
0000                             ;  with RST, one byte instead of three. The source writes them as macros:
0000                             ; 
0000                             ;    POPR   RST 08h  rpop    pop the return stack into DE
0000                             ;    DROP   RST 18h  drp     drop TOS, then next character  (ends a handler)
0000                             ;    NEGH   RST 20h  neg16   HL = -HL
0000                             ;    PUTA   RST 28h  putc    print A
0000                             ;    NEXT   RST 30h  next0   next character                 (ends a handler)
0000                             ; 
0000                             ;  RST 18h and RST 30h never return: an RST is a CALL, so the first thing
0000                             ;  each of them does is POP DE to throw the return address away.
0000                             ; 
0000                             ;  A CP/M build leaves page zero alone: there the macros are CALLs, and
0000                             ;  DROP and NEXT are jumps (DROPR and NEXTR: JR, where it reaches).
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (the top four bytes of the page are spare,
0000                             ;             so a full stack runs two bytes into the page below)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch, interpreter variables in the gaps, and the -n? line buffer
0000                             ;             at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack has a guard band: the data stack can
0000                             ;  overrun by a cell or two (and the calls made while it is full, the error
0000                             ;  report's included) into the top 32 bytes of the return-stack page, which
0000                             ;  are never used, and the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
                    BDOS:     EQU   0005h   
                    BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IF   CPM*(1-EDITOR)   
                    EXIT:     EQU   0000h   ; warm boot
0000                          ENDIF      
0000                          IFN   CPM   
0000                             ; ---- generic machine: edit these to suit -----------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The zero flag must match A
0000                             ;   (end the routine with OR A / RET).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                             ;   KEY and CONOUT must preserve BC, DE, HL and IY.
0000                          ENDIF      
0000                          IF   1-ANS   
0000                             ; With ANSI = 0 the console escapes call these. All four must keep BC and
0000                             ; IY, and all but CONAT also HL. They may change A, DE and the flags.
0000                CONCLS:   EQU   0FF0Ch   ; /{  clear the screen, the cursor to the top left
0000                CONEOL:   EQU   0FF0Fh   ; /}  clear from the cursor to the end of the line
0000                CONCUR:   EQU   0FF12h   ; /| and /`  show the cursor if A is not 0, hide
0000                             ;     it if A = 0
0000                CONAT:    EQU   0FF15h   ; /~  the cursor to row HL, column DE, both
0000                             ;     counted from 0. May change A, DE and HL
0000                          ENDIF      
0000                          IFN   CPM   
0000                RSPAGE:   EQU   80h   ; 8000h return stack
0000                DSPAGE:   EQU   81h   ; 8100h data stack
0000                LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
0000                PROG:     EQU   8300h   ; where the loader puts the program text
0000                HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
0000                CPAGE:    EQU   HEAPLIM   ; the skip cache's page (QK builds): the page
0000                             ;   at the heap limit, which the heap never reaches
0000                BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)   
0000                EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                          ENDIF      
0000                          IF   EDGEN   
                    LEAVE:    EQU   0FF09h   ; where the editor's ^X goes
0000                          ENDIF      
0000                          IF   EDITOR*CPM   
                    LEAVE:    EQU   0000h   ; the editor's ^X: warm boot
0000                          ENDIF      
0000                          IF   EDITOR   
                    EXIT:     EQU   edend   ; a program that ends goes back to the editor,
                    SKEND:    EQU   skend   ;   also when it ends inside skip
0000                          ENDIF      
0000                          IF   1-EDITOR   
0000                SKEND:    EQU   EXIT   
0000                          ENDIF      
0000                MSLOOP:   EQU   40-36*CPM   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine. (The wait
0000                             ; for a second Ctrl-C uses it too: 250 ms.)
0000                             ; CP/M: 4, for a BDOS 6 call of about 280 us
0000                             ; (an RC2014 with RomWBW and ZPM3). A .COM can
0000                             ; be patched: see TIMING.B8S.
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                             ;   around machine code (and in the checked
0000                             ;   build the address "$" prints from);
0000                PCNT:     EQU   LET+36h   ;   the break-key poll count (see rpushn);
0000                SKPL:     EQU   LET+3Ch   ;   the checked skip's starting place;
0000                NPEND:    EQU   LET+38h   ;   minus the address of the program's end
0000                             ;   (the heap"s first byte), for the checked "_';
0000                EDLN:     EQU   LET+3Ah   ;   the editor: the number of the line that ^E
0000                             ;   put in the input line (0: none)
0000                KEYBUF:   EQU   LET+7Ah   ; gap after z: a key read by the break check and
0000                             ;   held for the next "?" (0: none);
0000                BRKOFF:   EQU   LET+7Bh   ;   the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FCh   ; empty data stack. The four bytes above it
0000                             ; are spare: a character can pop two cells
0000                             ; too many before the checked build sees it,
0000                             ; and the next call must not land on the
0000                             ; letter cells.
0000                             ; The five one-byte calls. A generic build owns page zero and reaches them
0000                             ; with RST. A CP/M build must leave page zero alone (CP/M keeps it for
0000                             ; interrupts, and RomWBW's BIOS calls itself through RST 08h), so there each
0000                             ; is a CALL, or a jump for the two that never return: DROP is a JP, and
0000                             ; NEXT is JP (IX), two bytes, with IX holding next0's address throughout.
0000                             ; (asm80 can't nest IF, so these are written with DS: a count of 0 writes
0000                             ; nothing. DS can't take a label that comes later, but EQU can, and DS can
0000                             ; take that.)
0000                AROP:     EQU   rpop   
0000                ANEG:     EQU   neg16   
0000                APUT:     EQU   putc   
0000                APTK:     EQU   putk   
0000                          IF   1-CPM   
0000                PUTK:     EQU   putc   ; (CP/M only: here it is never used)
0000                          ENDIF      
0000                ANXT:     EQU   next0   
0000                          IF   CHECKED   
                    ACHK:     EQU   chkstk   ; (for the fast build's dispatcher)
0000                          ENDIF      
0000                          IF   1-CHECKED   
0000                ACHK:     EQU   0   
0000                          ENDIF      
0000                          IF   FAST   
                    DTPG:     EQU   DTAB/256   ; (the fast build"s table"s first page)
0000                          ENDIF      
0000                          IF   1-FAST   
0000                DTPG:     EQU   0   
0000                          ENDIF      
0000                .macro POPR,
0000                             ; 
0000                 DS      1-CPM,0CFh      ;   RST 08h
0000                 DS      CPM,0CDh        ;   CALL rpop
0000                 DS      CPM,AROP&0FFh
0000                 DS      CPM,AROP/256
0000                .endm
0000                 
0000                .macro DROP,
0000                             ; 
0000                 DS      (1-CPM)*(1-FAST),0DFh ; RST 18h
0000                 DS      CPM+FAST-CPM*FAST,0E1h ; POP HL
0000                 DS      CPM+FAST-CPM*FAST,0DDh ; JP (IX)
0000                 DS      CPM+FAST-CPM*FAST,0E9h
0000                .endm
0000                 
0000                .macro NEGH,
0000                             ; 
0000                 DS      1-CPM,0E7h      ;   RST 20h
0000                 DS      CPM,0CDh        ;   CALL neg16
0000                 DS      CPM,ANEG&0FFh
0000                 DS      CPM,ANEG/256
0000                .endm
0000                 
0000                .macro PUTA,
0000                             ; 
0000                 DS      1-CPM,0EFh      ;   RST 28h
0000                 DS      CPM,0CDh        ;   CALL putc
0000                 DS      CPM,APUT&0FFh
0000                 DS      CPM,APUT/256
0000                .endm
0000                 
0000                .macro PUTK,
0000                             ; 
0000                 DS      1-CPM,3Eh       ;   LD A,%%1 / RST 28h
0000                 DS      1-CPM,%%1
0000                 DS      1-CPM,0EFh
0000                 DS      CPM,0CDh        ;   CALL putk / DB %%1
0000                 DS      CPM,APTK&0FFh
0000                 DS      CPM,APTK/256
0000                 DS      CPM,%%1
0000                .endm
0000                 
0000                .macro PUTAR,
0000                             ; 
0000                 DS      1-CPM,0EFh      ;   RST 28h
0000                 DS      1-CPM,0C9h      ;   RET
0000                 DS      CPM,0C3h        ;   JP putc
0000                 DS      CPM,APUT&0FFh
0000                 DS      CPM,APUT/256
0000                .endm
0000                 
0000                .macro NEXT,
0000                             ; 
0000                 DS      (1-CPM)*(1-FAST),0F7h ; RST 30h
0000                 DS      CPM+FAST-CPM*FAST,0DDh ; JP (IX): IX holds next0
0000                 DS      CPM+FAST-CPM*FAST,0E9h
0000                .endm
0000                 
0000                .macro NEXTF,
0000                             ; 
0000                 DS      FAST*CHECKED,0CDh ;   (fast build: CALL chkstk, checked)
0000                 DS      FAST*CHECKED,ACHK&0FFh
0000                 DS      FAST*CHECKED,ACHK/256
0000                 DS      FAST,0Ah        ;   (fast build: the dispatcher: LD A,(BC)
0000                 DS      FAST,03h        ;   INC BC
0000                 DS      FAST,0EBh       ;   EX DE,HL
0000                 DS      FAST,6Fh        ;   LD L,A
0000                 DS      FAST,26h        ;   LD H,DTAB/256
0000                 DS      FAST,DTPG
0000                 DS      FAST,7Eh        ;   LD A,(HL)
0000                 DS      FAST,24h        ;   INC H
0000                 DS      FAST,66h        ;   LD H,(HL)
0000                 DS      FAST,6Fh        ;   LD L,A
0000                 DS      FAST,0E9h       ;   JP (HL))
0000                .endm
0000                 
0000                .macro NEXTZ,
0000                             ; 
0000                 DS      1-CPM,0F7h      ;   byte there in every build (RST 30h)
0000                 DS      CPM,0DDh        ; JP (IX)
0000                 DS      CPM,0E9h
0000                .endm
0000                 
0000                .macro SETIX,
0000                             ; 
0000                 DS      CPM+FAST-CPM*FAST,0DDh ; a generic build): LD IX,next0
0000                 DS      CPM+FAST-CPM*FAST,21h
0000                 DS      CPM+FAST-CPM*FAST,ANXT&0FFh
0000                 DS      CPM+FAST-CPM*FAST,ANXT/256
0000                .endm
0000                 
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is just the start of the .COM file.
0000                             ; =============================================================================
0000                          .ORG   BASE   
0000                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              XOR   A   ; 00  reset. (This byte, AFh, is also what an
0000                          ENDIF      ;     undefined word runs into: see e_hi.)
0000                          IF   1-EDGEN   
0000   31 FC 81               LD   SP,DSTOP   ; 00  reset, or the start of the .COM file
0003                          ENDIF      
0003                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)*(1-QK)   
                              LD   BC,PROG   ; 03  the IP
                              JR   st0   ; 06  (the rest of the startup is close by)
0003                          ENDIF      
0003                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)*QK   
0003   C3 8B 03               JP   qstart   ; 03  (the skip cache is emptied first)
0006   00 00                  DW   0   ; 06  spare
0008                          ENDIF      
0008                          IF   (1-CPM)*(1-EDITOR)*CHECKED*(1-QK)   
                              JR   init   ; 04  (the rest of the startup is close by)
                              DW   0   ; 06  spare
0008                          ENDIF      
0008                          IF   (1-CPM)*(1-EDITOR)*CHECKED*QK   
                              JP   qinit   ; 04  (the skip cache is emptied first)
                              DB   0   ; 07  spare
0008                          ENDIF      
0008                          IF   EDGEN   
                              XOR   A   ; 00  reset: no program yet. (This byte, AFh,
                              LD   (PROG),A   ;     is also what an undefined word runs
                              JP   init   ; 04  into in the checked build: see e_hi.)
                              NOP      ; 07  spare
0008                          ENDIF      
0008                          IF   CPM*(1-EDITOR)   
                              JP   start   ; 03
0008                          ENDIF      
0008                          IF   CPM*EDITOR*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
                                 ; is held back.
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
0008                          ENDIF      
0008                          IF   CPM*EDITOR   
                              CALL   load   ; the file named on the command line
                              JP   edit0   
0008                          ENDIF      
0008                          IF   1-CPM   
0008                             ; ---- RST 08h: rpop: pop the return stack into DE ---------------------------
0008   FD 5E 00     RPOP:     LD   E,(IY+0)   ; 08
000B   FD 56 01               LD   D,(IY+1)   
000E   18 1B                  JR   rp2   ; (the rest is at 2Bh)
0010                             ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
0010   C6 21        CTL:      ADD   A,21h   ; 10  back to c; zero only for NUL
0012   20 1D                  JR   NZ,next0   ;     the rest are ignored
0014   C3 09 FF     ENDPROG:   JP   EXIT   ;     the program has ended
0017   00                     NOP      ; 17  spare
0018                             ; ---- RST 18h: drop TOS, then next ------------------------------------------
0018   D1           RST18:    POP   DE   ; 18  discard the RST's return address
0019   E1           DRP:      POP   HL   ;     new TOS = NOS
001A   18 15                  JR   next0   
001C                          ENDIF      
001C   E5           H_FROMR:   PUSH   HL   ; 1C  "}" return stack to TOS
001D                          ;*Macro unroll:  POPR
001D   CF                     DS   1-CPM,0CFh   
001E                          DS   CPM,0CDh   
001E                          DS   CPM,AROP&0FFh   
001E                          DS   CPM,AROP/256   
001E   EB                     EX   DE,HL   
001F                          ;*Macro unroll:  NEXTZ
001F   F7                     DS   1-CPM,0F7h   
0020                          DS   CPM,0DDh   
0020                          DS   CPM,0E9h   
0020                          IF   1-CPM   
0020                             ; ---- RST 20h: neg16: HL = -HL (keeps BC, DE) -------------------------------
0020   AF           NEG16:    XOR   A   ; 20
0021   95                     SUB   L   
0022   6F                     LD   L,A   
0023   9F                     SBC   A,A   
0024   94                     SUB   H   
0025   67                     LD   H,A   
0026   C9                     RET      
0027   00                     NOP      ; 27  spare
0028                             ; ---- RST 28h: putc: print A (keeps BC, DE, HL, IY) -------------------------
0028                RST28:       
0028   C3 03 FF     PUTC:     JP   CONOUT   ; 28
002B   FD 23        RP2:      INC   IY   ; 2B  the rest of rpop
002D   FD 23                  INC   IY   
002F   C9                     RET      
0030                             ; ---- RST 30h: next character -----------------------------------------------
0030   D1           RST30:    POP   DE   ; 30  discard the RST's return address
0031                          ENDIF      
0031                          IF   CPM   
                                 ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
                    CTL:      ADD   A,21h   ; back to c; zero only for NUL
                              JR   NZ,next0   ; the rest are ignored
                    ENDPROG:   JP   EXIT   ; the program has ended
0031                          ENDIF      
0031                             ; =============================================================================
0031                             ;  The inner loop: read one character and sort it by range.
0031                             ; 
0031                             ;    00h          end of program
0031                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0031                             ;    30h-39h      digit: read a whole number
0031                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0031                             ;    61h-7Ah      a-z: push the address of that letter's cell
0031                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0031                             ; =============================================================================
0031                          IF   FAST   
                              ;*Macro unroll: next0:  NEXTF                   ; (the fast build: the table dispatcher)
                    NEXT0:    DS   FAST*CHECKED,0CDh   ; (the fast build: the table dispatcher)
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
0031                          ENDIF      
0031                          IF   1-FAST   
0031                NEXT0:       
0031                          ENDIF      
0031                          IF   CHECKED*(1-FAST)   
                              CALL   chkstk   ; both stacks are checked once per character
0031                          ENDIF      
0031                          IF   1-FAST   
0031   0A                     LD   A,(BC)   
0032   03                     INC   BC   
0033   D6 21                  SUB   21h   ; A = c - 21h
0035   38 D9                  JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
0037   FE 0F                  CP   0Fh   
0039   38 22                  JR   C,punct   ; 21h-2Fh: PTAB index 0-14
003B   D6 0F                  SUB   0Fh   ; A = c - 30h
003D   FE 0A                  CP   0Ah   
003F   38 69                  JR   C,digit   ; 30h-39h
0041   FE 11                  CP   11h   
0043   38 16                  JR   C,p3a   ; 3Ah-40h
0045   D6 11                  SUB   11h   ; A = c - 41h
0047   FE 1A                  CP   1Ah   
0049   38 68                  JR   C,upper   ; 41h-5Ah: A = letter index 0-25
004B   FE 20                  CP   20h   
004D   38 0A                  JR   C,p5b   ; 5Bh-60h
004F   FE 3A                  CP   3Ah   
0051   38 5D                  JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0053   FE 3E                  CP   3Eh   
0055                          ENDIF      
0055                          IF   (1-CHECKED)*(1-FAST)   
0055   30 DA                  JR   NC,next0   ; 7Fh-FFh: ignored
0057                          ENDIF      
0057                          IF   CHECKED*(1-FAST)   
                              JR   Z,next0   ; 7Fh, DEL: ignored
                              JP   NC,e_hi   ; 80h-FFh: reserved
0057                          ENDIF      
0057                          IF   1-FAST   
0057   D6 1A                  SUB   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
0059   D6 09        P5B:      SUB   9   ; 5Bh-60h: -4 in all, index 22-27
005B   C6 05        P3A:      ADD   A,5   ; 3Ah-40h: index 15-21
005D                          ENDIF      
005D                .macro PTABLE,
005D                             ; 
005D                 DB      h_store & 0FFh  ; !
005D                 DB      h_str & 0FFh    ; "
005D                 DB      h_num & 0FFh    ; #
005D                 DB      h_print & 0FFh  ; $
005D                 DB      h_swap & 0FFh   ; %
005D                 DB      h_and & 0FFh    ; &
005D                 DB      h_emit & 0FFh   ; '
005D                 DB      h_open & 0FFh   ; (
005D                 DB      h_close & 0FFh  ; )
005D                 DB      h_mul & 0FFh    ; *
005D                 DB      h_add & 0FFh    ; +
005D                 DB      h_cfetch & 0FFh ; ,
005D                 DB      h_sub & 0FFh    ; -
005D                 DB      h_cstore & 0FFh ; .
005D                 DB      h_div & 0FFh    ; /
005D                 DB      h_dup & 0FFh    ; :
005D                 DB      h_drop & 0FFh   ; ;
005D                 DB      h_lt & 0FFh     ; <
005D                 DB      h_eq & 0FFh     ; =
005D                 DB      h_gt & 0FFh     ; >
005D                 DB      h_key & 0FFh    ; ?
005D                 DB      h_fetch & 0FFh  ; @
005D                 DB      h_def & 0FFh    ; [
005D                 DB      h_break & 0FFh  ; \
005D                 DB      h_ret & 0FFh    ; ]
005D                 DB      h_xor & 0FFh    ; ^
005D                 DB      h_alloc & 0FFh  ; _
005D                 DB      h_grave & 0FFh  ; `
005D                 DB      h_tor & 0FFh    ; {
005D                 DB      h_or & 0FFh     ; |
005D                 DB      h_fromr & 0FFh  ; }
005D                 DB      h_not & 0FFh    ; ~
005D                .endm
005D                 
005D                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
005D                             ; untouched, and A, DE free.
005D                          IF   1-FAST   
005D   C6 94        PUNCT:    ADD   A,PTAB & 0FFh   ; PTAB never crosses a page
005F   5F                     LD   E,A   
0060   16 03                  LD   D,PTAB / 256   ; (0 if the table is in page zero)
0062   FE AA                  CP   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
0064   1A                     LD   A,(DE)   
0065   5F                     LD   E,A   ; the handler's low byte
0066                          ENDIF      
0066                          IF   (1-CPM)*(1-TABP0)*(1-FAST)   
0066   16 00                  LD   D,0   
0068                          ENDIF      
0068                          IF   (1-CPM)*(1-FAST)   
0068   CB 12                  RL   D   ; its page: 0 + carry
006A                          ENDIF      
006A                          IF   CPM*(1-FAST)   
                              LD   D,1   
                              JR   NC,pu1   
                              INC   D   ; its page: 1 + carry
                    PU1:         
006A                          ENDIF      
006A                          IF   1-FAST   
006A   D5                     PUSH   DE   ; jump to it; the stack is balanced again
006B   C9                     RET      ;   when the handler starts
006C                          ENDIF      
006C                             ; The rest of the startup: here so that the generic reset code can reach it
006C                             ; with JR. st0: find the program's NUL; the heap starts after it.
006C                             ; (The editor build has its own copy of this, next to the editor.)
006C                             ; A checked build first clears the lower half of the letter page (A = 0):
006C                             ; every variable starts at 0, every word cell holds 0000h, the address an
006C                             ; undefined word is caught at (see e_hi), and no key is held back.
006C                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                    INIT:     LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
                              LD   BC,PROG   ; the IP
006C                          ENDIF      
006C                          IF   (1-CPM)*(1-EDITOR)   
006C   60           ST0:      LD   H,B   
006D   69                     LD   L,C   
006E   AF                     XOR   A   
006F   BE           ST1:      CP   (HL)   
0070   23                     INC   HL   
0071   20 FC                  JR   NZ,st1   
0073                          ENDIF      
0073                          IF   1-EDITOR   
0073   22 7C 82     ST2:      LD   (HEAP),HL   
0076                          ENDIF      
0076                          IF   CHECKED*(1-EDITOR)   
                              ;*Macro unroll:  NEGH                    ; minus the heap's first address: '_' may not
                              DS   1-CPM,0E7h   ; minus the heap"s first address: "_' may not
                              DS   CPM,0CDh   
                              DS   CPM,ANEG&0FFh   
                              DS   CPM,ANEG/256   
                              LD   (NPEND),HL   ;   release below it
0076                          ENDIF      
0076                          IF   (1-CHECKED)*(1-EDITOR)*(1-CPM)   
0076   67                     LD   H,A   ; (A = 0) no key is held, and the break key
0077   6F                     LD   L,A   ;   is on (the checked build has cleared
0078                          ENDIF      ;   these)
0078                          IF   (1-CHECKED)*(1-EDITOR)*CPM   
                              LD   HL,0   
0078                          ENDIF      
0078                          IF   (1-CHECKED)*(1-EDITOR)   
0078   22 7A 82               LD   (KEYBUF),HL   
007B                          ENDIF      
007B                          IF   1-EDITOR   
007B                          ;*Macro unroll:  SETIX
007B                          DS   CPM+FAST-CPM*FAST,0DDh   
007B                          DS   CPM+FAST-CPM*FAST,21h   
007B                          DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
007B                          DS   CPM+FAST-CPM*FAST,ANXT/256   
007B   FD 21 E0 80            LD   IY,RSTOP   ; the return stack is empty
007F                          ;*Macro unroll:  NEXT                    ; (its return address is thrown away)
007F   F7                     DS   (1-CPM)*(1-FAST),0F7h   ; (its return address is thrown away)
0080                          DS   CPM+FAST-CPM*FAST,0DDh   
0080                          DS   CPM+FAST-CPM*FAST,0E9h   
0080                          ENDIF      
0080                             ; In the unchecked generic editor build the table is here, in the first
0080                             ; page, which saves loading D twice. (The other builds have no room for it
0080                             ; here: theirs is further down.)
0080                          IF   TABP0   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0080                          ENDIF      
0080                             ; =============================================================================
0080                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
0080                             ;  (00bbIGFuZCA= are up among the RST routines.) The machine-code call, exec,
0080                             ;  is here too: it belongs to "`" and makes the page come out right.
0080                             ; =============================================================================
0080   D1           H_XOR:    POP   DE   
0081   7C                     LD   A,H   
0082   AA                     XOR   D   
0083   67                     LD   H,A   
0084   7D                     LD   A,L   
0085   AB                     XOR   E   
0086   6F                     LD   L,A   
0087                          ;*Macro unroll:  NEXT
0087   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0088                          DS   CPM+FAST-CPM*FAST,0DDh   
0088                          DS   CPM+FAST-CPM*FAST,0E9h   
0088   D1           H_OR:     POP   DE   
0089   7C                     LD   A,H   
008A   B2                     OR   D   
008B   67                     LD   H,A   
008C   7D                     LD   A,L   
008D   B3                     OR   E   
008E   6F                     LD   L,A   
008F                          ;*Macro unroll:  NEXT
008F   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0090                          DS   CPM+FAST-CPM*FAST,0DDh   
0090                          DS   CPM+FAST-CPM*FAST,0E9h   
0090                          ;*Macro unroll: h_not:  NEGH                    ; ~x = -x - 1
0090   E7           H_NOT:    DS   1-CPM,0E7h   ; ~x = -x - 1
0091                          DS   CPM,0CDh   
0091                          DS   CPM,ANEG&0FFh   
0091                          DS   CPM,ANEG/256   
0091   2B                     DEC   HL   
0092                          ;*Macro unroll:  NEXT
0092   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0093                          DS   CPM+FAST-CPM*FAST,0DDh   
0093                          DS   CPM+FAST-CPM*FAST,0E9h   
0093                             ; "_" ( n -- addr ): the heap pointer moves by n, a signed count (the add is
0093                             ; the same either way); TOS is the old pointer.
0093   ED 5B 7C 82  H_ALLOC:   LD   DE,(HEAP)   
0097                          IF   CHECKED*CPM   
                              LD   A,H   ; the count's sign, for chkhp
0097                          ENDIF      
0097   19                     ADD   HL,DE   ; the new top
0098                          IF   CHECKED   
                              CALL   chkhp   
0098                          ENDIF      
0098   22 7C 82               LD   (HEAP),HL   
009B   EB                     EX   DE,HL   
009C                          ;*Macro unroll:  NEXT
009C   F7                     DS   (1-CPM)*(1-FAST),0F7h   
009D                          DS   CPM+FAST-CPM*FAST,0DDh   
009D                          DS   CPM+FAST-CPM*FAST,0E9h   
009D                          IF   1-CPM*CHECKED   
009D   FD 22 34 82  EXEC:     LD   (RSAVE),IY   ; machine code may change IX and IY
00A1   CD D5 00               CALL   jphl   
00A4   FD 2A 34 82            LD   IY,(RSAVE)   
00A8                          ;*Macro unroll:  SETIX
00A8                          DS   CPM+FAST-CPM*FAST,0DDh   
00A8                          DS   CPM+FAST-CPM*FAST,21h   
00A8                          DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
00A8                          DS   CPM+FAST-CPM*FAST,ANXT/256   
00A8   E1                     POP   HL   
00A9                          ;*Macro unroll:  NEXT
00A9   F7                     DS   (1-CPM)*(1-FAST),0F7h   
00AA                          DS   CPM+FAST-CPM*FAST,0DDh   
00AA                          DS   CPM+FAST-CPM*FAST,0E9h   
00AA                          ENDIF      
00AA                             ; ---- the letters and digits (here, in the middle, so that the inner loop's
00AA                             ; ---- short jumps reach them, and the handlers after them reach rpushn) ------
00AA                             ; Digits: step back onto the first digit and read the whole number.
00AA   E5           DIGIT:    PUSH   HL   
00AB   0B                     DEC   BC   
00AC   CD 8D 02               CALL   rdnum   
00AF                          ;*Macro unroll:  NEXT
00AF   F7                     DS   (1-CPM)*(1-FAST),0F7h   
00B0                          DS   CPM+FAST-CPM*FAST,0DDh   
00B0                          DS   CPM+FAST-CPM*FAST,0E9h   
00B0                             ; a-z: push the cell's address (the cell is the variable)
00B0                             ;  (the unchecked builds with room do x@ and x! in one step: lowq)
00B0                          IF   1-SBASEU   
                    LOWER:    PUSH   HL   
                              ADD   A,A   
                              LD   L,A   
                              LD   H,LETPAGE   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
00B0                          ENDIF      
00B0                          IF   SBASEU   
00B0   C3 6C 03     LOWER:    JP   lowq   
00B3                          ENDIF      
00B3                             ; A-Z: call the word. The return address (the IP after the letter) goes on
00B3                             ; the return stack, and the IP becomes the address in the letter's cell.
00B3   C5           UPPER:    PUSH   BC   ; the return address, for rpushn
00B4   EB                     EX   DE,HL   ; park TOS
00B5   87                     ADD   A,A   
00B6   6F                     LD   L,A   
00B7   26 82                  LD   H,LETPAGE   ; HL -> cell
00B9   4E                     LD   C,(HL)   
00BA   2C                     INC   L   
00BB   46                     LD   B,(HL)   ; IP = the word's body
00BC   EB                     EX   DE,HL   ; TOS back, and fall into rpushn
00BD                             ; rpushn: move the top cell of the data stack (in memory) to the return
00BD                             ; stack, then next. Everything that pushes the return stack ends here.
00BD                             ; 
00BD                             ; The break key is looked at here, so at every word call and loop-back (and
00BD                             ; block entry and "{"), but only one time in 256: PCNT counts them.
00BD                             ; Reading the keyboard can be slow (it is a BDOS call under CP/M).
00BD   D1           RPUSHN:   POP   DE   
00BE   FD 72 FF               LD   (IY-1),D   
00C1   FD 73 FE               LD   (IY-2),E   
00C4   FD 2B                  DEC   IY   
00C6   FD 2B                  DEC   IY   
00C8   E5                     PUSH   HL   
00C9   21 36 82               LD   HL,PCNT   
00CC   35                     DEC   (HL)   
00CD   E1                     POP   HL   ; (the zero flag lasts)
00CE   CC E0 03               CALL   Z,pollk   
00D1                          ;*Macro unroll:  NEXT
00D1   F7                     DS   (1-CPM)*(1-FAST),0F7h   
00D2                          DS   CPM+FAST-CPM*FAST,0DDh   
00D2                          DS   CPM+FAST-CPM*FAST,0E9h   
00D2                             ; "{" TOS to the return stack: the new TOS comes up, the old one goes across.
00D2   E3           H_TOR:    EX   (SP),HL   
00D3   18 E8                  JR   rpushn   
00D5   E9           JPHL:     JP   (HL)   ; (for the machine-code call)
00D6                             ; ---- machine code: the grave -----------------------------------------------
00D6                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
00D6                             ; are stored from addr until a non-hex character; then a RET (C9h) is
00D6                             ; written and its address is left. An odd last digit is consumed and dropped.
00D6                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
00D6                             ; code is entered by CALL with the data stack above the return address; it
00D6                             ; must keep BC, and on return the top cell becomes the new TOS.
00D6   CD B4 03     H_GRAVE:   CALL   hexc   
00D9                          IF   1-CPM*CHECKED   
00D9   30 C2                  JR   NC,exec   
00DB                          ENDIF      
00DB                          IF   CPM*CHECKED   
                              JP   NC,exec   ; (out of the way: see rpop)
00DB                          ENDIF      
00DB   77           HX1:      LD   (HL),A   ; the high digit goes in first ...
00DC   CD B4 03               CALL   hexc   
00DF   30 08                  JR   NC,hx2   ; odd digit: consumed, and the RET below
00E1   ED 6F                  RLD      ;   overwrites it
00E3   23                     INC   HL   ; ... and RLD shifts it up under the low one
00E4   CD B4 03               CALL   hexc   
00E7   38 F2                  JR   C,hx1   
00E9   36 C9        HX2:      LD   (HL),0C9h   ; (never range-checked: the spec says so)
00EB                          ;*Macro unroll:  NEXT
00EB   F7                     DS   (1-CPM)*(1-FAST),0F7h   
00EC                          DS   CPM+FAST-CPM*FAST,0DDh   
00EC                          DS   CPM+FAST-CPM*FAST,0E9h   
00EC                             ; ---- where the two pages meet ----------------------------------------------
00EC                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
00EC                             ; are in falling code order for this), and where exactly differs between the
00EC                             ; builds: NPG1 follows. Every handler below these four must start in the
00EC                             ; second page, and every one above in the first; chktab.py checks both.
00EC                             ; "]" returns: pop an address and jump to it.
00EC                          ;*Macro unroll: h_ret:  POPR
00EC   CF           H_RET:    DS   1-CPM,0CFh   
00ED                          DS   CPM,0CDh   
00ED                          DS   CPM,AROP&0FFh   
00ED                          DS   CPM,AROP/256   
00ED   42                     LD   B,D   
00EE   4B                     LD   C,E   
00EF                          ;*Macro unroll: brk1:   NEXT
00EF   F7           BRK1:     DS   (1-CPM)*(1-FAST),0F7h   
00F0                          DS   CPM+FAST-CPM*FAST,0DDh   
00F0                          DS   CPM+FAST-CPM*FAST,0E9h   
00F0                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
00F0                             ; drops the block start, "]" returns. No closer at all ends the program.
00F0   7C           H_BREAK:   LD   A,H   
00F1   B5                     OR   L   
00F2   E1                     POP   HL   
00F3   28 FA                  JR   Z,brk1   
00F5   CD AF 02               CALL   skip   
00F8   B7                     OR   A   ; skip returns 0 for ")"
00F9   20 F1                  JR   NZ,h_ret   
00FB                          ;*Macro unroll: rdrop:  POPR
00FB   CF           RDROP:    DS   1-CPM,0CFh   
00FC                          DS   CPM,0CDh   
00FC                          DS   CPM,AROP&0FFh   
00FC                          DS   CPM,AROP/256   
00FC                          ;*Macro unroll:  NEXT
00FC   F7                     DS   (1-CPM)*(1-FAST),0F7h   
00FD                          DS   CPM+FAST-CPM*FAST,0DDh   
00FD                          DS   CPM+FAST-CPM*FAST,0E9h   
00FD                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
00FD                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
00FD                             ; the body"s address instead. Either way it then skips to the matching "]'.
00FD                             ; (The unchecked build takes anything that is not a letter as the space; the
00FD                             ; checked build stops on it.)
00FD   0A           H_DEF:    LD   A,(BC)   
00FE   03                     INC   BC   
00FF   D6 41                  SUB   "A"   ; a letter gives 0-25 or 32-57: lowercase
0101   5F                     LD   E,A   ;   lands 64 bytes up
0102   E6 DF                  AND   0DFh   ; fold case
0104   FE 1A                  CP   26   
0106   30 0B                  JR   NC,def2   ; not a letter
0108   CB 23                  SLA   E   
010A   16 82                  LD   D,LETPAGE   ; DE -> cell
010C   79                     LD   A,C   
010D   12                     LD   (DE),A   
010E   1C                     INC   E   
010F   78                     LD   A,B   
0110   12                     LD   (DE),A   
0111   18 03                  JR   skipnx   
0113                DEF2:        
0113                          IF   CHECKED   
                              LD   A,E   
                              CP   " "-"A"+256   
                              JP   NZ,e_brack   ; anything but a letter or a space
0113                          ENDIF      
0113   E5                     PUSH   HL   ; an anonymous block: push its address
0114   60                     LD   H,B   
0115   69                     LD   L,C   
0116                SKIPNX:      
0116                          IF   CHECKED   
                              DEC   BC   ; back onto the letter, so that skip finds its
0116                          ENDIF      ;   opener, the "[", just before where it starts
0116   CD AF 02     SKIPO:    CALL   skip   
0119                          ;*Macro unroll:  NEXT
0119   F7                     DS   (1-CPM)*(1-FAST),0F7h   
011A                          DS   CPM+FAST-CPM*FAST,0DDh   
011A                          DS   CPM+FAST-CPM*FAST,0E9h   
011A   5E           H_FETCH:   LD   E,(HL)   ; "@"
011B   23                     INC   HL   
011C   56                     LD   D,(HL)   
011D   EB                     EX   DE,HL   
011E                          ;*Macro unroll:  NEXT
011E   F7                     DS   (1-CPM)*(1-FAST),0F7h   
011F                          DS   CPM+FAST-CPM*FAST,0DDh   
011F                          DS   CPM+FAST-CPM*FAST,0E9h   
011F                             ; =============================================================================
011F                             ;  Handlers that must start in the image's second page.
011F                             ;  "?" is the last (with "," inside it), so its long tail may run past that
011F                             ;  page.
011F                             ; =============================================================================
011F                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
011F                             ; the matching ")".
011F   7C           H_OPEN:   LD   A,H   
0120   B5                     OR   L   
0121   E1                     POP   HL   
0122   28 F2                  JR   Z,skipo   
0124   C5                     PUSH   BC   ; the block starts at the IP
0125   18 96                  JR   rpushn   
0127                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
0127                             ; drops it and carries on.
0127   7C           H_CLOSE:   LD   A,H   
0128   B5                     OR   L   
0129   E1                     POP   HL   
012A   28 CF                  JR   Z,rdrop   
012C                          IF   QK   
012C   C3 5C 03               JP   closeq   ; (out of the handlers' pages: see Speed-ups)
012F                          ENDIF      
012F                          IF   1-QK   
                              ;*Macro unroll:  POPR                    ; pop the block start ...
                              DS   1-CPM,0CFh   ; pop the block start ...
                              DS   CPM,0CDh   
                              DS   CPM,AROP&0FFh   
                              DS   CPM,AROP/256   
                              LD   B,D   
                              LD   C,E   
                              PUSH   BC   
012F                          ENDIF      
012F                          IF   (1-QK)*(1-CPM)   
                              JR   rpushn   ; ... and push it back
012F                          ENDIF      
012F                          IF   (1-QK)*CPM   
                              JP   rpushn   
012F                          ENDIF      
012F                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
012F                             ; "-" has two jobs: directly before a digit it starts a negative number.
012F   0A           H_SUB:    LD   A,(BC)   
0130   D6 30                  SUB   "0"   
0132   FE 0A                  CP   10   
0134   38 04                  JR   C,negnum   
0136                          ;*Macro unroll:  NEGH                    ; a - b = a + (-b): fall into '+'
0136   E7                     DS   1-CPM,0E7h   ; a - b = a + (-b): fall into "+"
0137                          DS   CPM,0CDh   
0137                          DS   CPM,ANEG&0FFh   
0137                          DS   CPM,ANEG/256   
0137   D1           H_ADD:    POP   DE   
0138   19                     ADD   HL,DE   
0139                          ;*Macro unroll:  NEXT
0139   F7                     DS   (1-CPM)*(1-FAST),0F7h   
013A                          DS   CPM+FAST-CPM*FAST,0DDh   
013A                          DS   CPM+FAST-CPM*FAST,0E9h   
013A   E5           NEGNUM:   PUSH   HL   ; a negative number: read it, negate it
013B   CD 8D 02               CALL   rdnum   
013E                          ;*Macro unroll:  NEGH
013E   E7                     DS   1-CPM,0E7h   
013F                          DS   CPM,0CDh   
013F                          DS   CPM,ANEG&0FFh   
013F                          DS   CPM,ANEG/256   
013F                          ;*Macro unroll:  NEXT
013F   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0140                          DS   CPM+FAST-CPM*FAST,0DDh   
0140                          DS   CPM+FAST-CPM*FAST,0E9h   
0140   D1           H_AND:    POP   DE   
0141   7C                     LD   A,H   
0142   A2                     AND   D   
0143   67                     LD   H,A   
0144   7D                     LD   A,L   
0145   A3                     AND   E   
0146   6F                     LD   L,A   
0147                          ;*Macro unroll:  NEXT
0147   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0148                          DS   CPM+FAST-CPM*FAST,0DDh   
0148                          DS   CPM+FAST-CPM*FAST,0E9h   
0148                             ; Signed compares. Both are "HL < DE" for the right pair: "<" swaps the two
0148                             ; cells first. Flipping both sign bits turns a signed compare into an
0148                             ; unsigned one (and XOR clears the carry for SBC); SBC HL,HL then turns the
0148                             ; carry into -1 or 0 with no branch.
0148   E3           H_LT:     EX   (SP),HL   ; a < b: HL = a, and b is popped next
0149   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
014A   7C                     LD   A,H   
014B   EE 80                  XOR   80h   
014D   67                     LD   H,A   
014E   7A                     LD   A,D   
014F   EE 80                  XOR   80h   
0151   57                     LD   D,A   
0152   ED 52                  SBC   HL,DE   ; carry if HL < DE
0154   ED 62        TF:       SBC   HL,HL   ; carry -> -1 or 0
0156                          ;*Macro unroll:  NEXT
0156   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0157                          DS   CPM+FAST-CPM*FAST,0DDh   
0157                          DS   CPM+FAST-CPM*FAST,0E9h   
0157   D1           H_EQ:     POP   DE   
0158   B7                     OR   A   
0159   ED 52                  SBC   HL,DE   
015B   7C                     LD   A,H   
015C   B5                     OR   L   
015D   FE 01                  CP   1   ; carry only if a - b = 0
015F   18 F3                  JR   tf   
0161                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept. The
0161                             ; multiplier shifts up through A:C.
0161                          IF   1-QK   
                    H_MUL:    POP   DE   ; DE = multiplicand
                              PUSH   BC   
                              LD   A,H   
                              LD   C,L   ; A:C = multiplier
                              LD   HL,0   
                              LD   B,16   
                    MUL1:     ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mul2   
                              ADD   HL,DE   
                    MUL2:     DJNZ   mul1   
                              POP   BC   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
0161                          ENDIF      
0161                          IF   QK   
0161   D1           H_MUL:    POP   DE   ; DE = multiplicand
0162   C3 30 03               JP   mulq   ; (out of the handlers' pages: see Speed-ups)
0165                          ENDIF      
0165                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
0165                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
0165                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
0165                             ; stops on it.
0165                H_DIV:       
0165                          IF   CHECKED   
                              LD   A,H   
                              OR   L   
                              JP   Z,e_zero   
0165                          ENDIF      
0165   D1                     POP   DE   ; DE = a, HL = b
0166   D5                     PUSH   DE   ; a, for r's sign
0167   7A                     LD   A,D   
0168   AC                     XOR   H   
0169   F5                     PUSH   AF   ; S flag = sign of q
016A   CB 7C                  BIT   7,H   
016C   C4 20 00               CALL   NZ,neg16   ; HL = |b|
016F   EB                     EX   DE,HL   
0170   CB 7C                  BIT   7,H   
0172   C4 20 00               CALL   NZ,neg16   ; HL = |a|, DE = |b|
0175   CD 38 02               CALL   udiv   ; HL = q, DE = r
0178   F1                     POP   AF   
0179   FC 20 00               CALL   M,neg16   ; q's sign
017C   EB                     EX   DE,HL   ; HL = r, DE = q
017D   F1                     POP   AF   ; A = a's high byte
017E   B7                     OR   A   
017F   FC 20 00               CALL   M,neg16   ; r's sign
0182   D5                     PUSH   DE   ; q under r
0183                          ;*Macro unroll:  NEXT
0183   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0184                          DS   CPM+FAST-CPM*FAST,0DDh   
0184                          DS   CPM+FAST-CPM*FAST,0E9h   
0184                             ; ---- stack and storage -----------------------------------------------------
0184   E5           H_DUP:    PUSH   HL   ; ":"
0185                          ;*Macro unroll:  NEXT
0185   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0186                          DS   CPM+FAST-CPM*FAST,0DDh   
0186                          DS   CPM+FAST-CPM*FAST,0E9h   
0186   E3           H_SWAP:   EX   (SP),HL   ; "%"
0187                          ;*Macro unroll:  NEXT
0187   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0188                          DS   CPM+FAST-CPM*FAST,0DDh   
0188                          DS   CPM+FAST-CPM*FAST,0E9h   
0188                             ; (The checked build tests the address before it takes the value off the
0188                             ; stack, so that an error report shows both.)
0188                H_CSTORE:      ; "." ( c addr -- )
0188                          IF   CHECKED   
                              CALL   chkst   
0188                          ENDIF      
0188   D1                     POP   DE   
0189   73                     LD   (HL),E   
018A                          ;*Macro unroll: h_drop: DROP                    ; ';' is this one byte
018A   DF           H_DROP:   DS   (1-CPM)*(1-FAST),0DFh   ; ";" is this one byte
018B                          DS   CPM+FAST-CPM*FAST,0E1h   
018B                          DS   CPM+FAST-CPM*FAST,0DDh   
018B                          DS   CPM+FAST-CPM*FAST,0E9h   
018B                H_STORE:      ; "!" ( n addr -- )
018B                          IF   CHECKED   
                              CALL   chkst   
018B                          ENDIF      
018B   D1                     POP   DE   
018C   73                     LD   (HL),E   
018D   23                     INC   HL   
018E   72                     LD   (HL),D   
018F                          ;*Macro unroll:  DROP
018F   DF                     DS   (1-CPM)*(1-FAST),0DFh   
0190                          DS   CPM+FAST-CPM*FAST,0E1h   
0190                          DS   CPM+FAST-CPM*FAST,0DDh   
0190                          DS   CPM+FAST-CPM*FAST,0E9h   
0190                             ; ---- console ---------------------------------------------------------------
0190                             ; 22h pushes the address of the text after it and skips the string.
0190   E5           H_STR:    PUSH   HL   
0191   60                     LD   H,B   
0192   69                     LD   L,C   
0193   CD A4 02               CALL   skipstr   
0196                          IF   CHECKED   
                              OR   A   ; 0: the text ran out before the closing quote
                              JP   Z,e_quote   
0196                          ENDIF      
0196                          ;*Macro unroll:  NEXT
0196   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0197                          DS   CPM+FAST-CPM*FAST,0DDh   
0197                          DS   CPM+FAST-CPM*FAST,0E9h   
0197                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
0197                             ; 60h to 7Eh is one of the escapes at pesc; "/" plus any other character
0197                             ; clears that character"s bit 6 (/M is CR, and / then DEL gives "?"; "/',
0197                             ; '"' and '?' have no bit 6, so //, /" and /? give themselves).
0197                          IF   1-CHECKED   
0197   7E           H_PRINT:   LD   A,(HL)   
0198   23                     INC   HL   
0199   FE 22                  CP   22h   
019B   28 15                  JR   Z,pr9   
019D   FE 2F                  CP   "/"   
019F   20 0C                  JR   NZ,pr1   
01A1   7E                     LD   A,(HL)   
01A2   23                     INC   HL   
01A3   FE 60                  CP   60h   
01A5   38 04                  JR   C,pr0   
01A7   FE 7F                  CP   7Fh   
01A9   38 57                  JR   C,pesc   
01AB   E6 BF        PR0:      AND   0BFh   
01AD                          ;*Macro unroll: pr1:    PUTA
01AD   EF           PR1:      DS   1-CPM,0EFh   
01AE                          DS   CPM,0CDh   
01AE                          DS   CPM,APUT&0FFh   
01AE                          DS   CPM,APUT/256   
01AE   18 E7                  JR   h_print   
01B0                PRLOOP:   EQU   h_print   ; (where the escapes go back to)
01B0                PRAGAIN:   EQU   h_print   ; (and where /~ goes back to)
01B0                          ENDIF      
01B0                          IF   CHECKED   
                                 ; (The checked build has the loop as a routine, prstr, which the error
                                 ; report uses too. The address is kept meanwhile, for a report: it shows
                                 ; the stack as it was before the "$". /~ comes back to hp1.)
                    H_PRINT:   LD   (RSAVE),HL   
                    HP1:      CALL   prstr   
                              ;*Macro unroll:  DROP
                              DS   (1-CPM)*(1-FAST),0DFh   
                              DS   CPM+FAST-CPM*FAST,0E1h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
01B0                          ENDIF      
01B0   7D           H_EMIT:   LD   A,L   ; "'"
01B1                          ;*Macro unroll:  PUTA
01B1   EF                     DS   1-CPM,0EFh   
01B2                          DS   CPM,0CDh   
01B2                          DS   CPM,APUT&0FFh   
01B2                          DS   CPM,APUT/256   
01B2                          ;*Macro unroll: pr9:    DROP
01B2   DF           PR9:      DS   (1-CPM)*(1-FAST),0DFh   
01B3                          DS   CPM+FAST-CPM*FAST,0E1h   
01B3                          DS   CPM+FAST-CPM*FAST,0DDh   
01B3                          DS   CPM+FAST-CPM*FAST,0E9h   
01B3                             ; "#" prints TOS as a signed decimal number, with no space after it.
01B3   CD C6 03     H_NUM:    CALL   psgn   
01B6                          ;*Macro unroll:  DROP
01B6   DF                     DS   (1-CPM)*(1-FAST),0DFh   
01B7                          DS   CPM+FAST-CPM*FAST,0E1h   
01B7                          DS   CPM+FAST-CPM*FAST,0DDh   
01B7                          DS   CPM+FAST-CPM*FAST,0E9h   
01B7                             ; "?" ( n -- c ) or ( -n -- addr )
01B7                             ;   n > 0: wait about n ms for a key; 0 if none came
01B7                             ;   n = 0: wait for a key
01B7                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
01B7                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
01B7   CB 7C        H_KEY:    BIT   7,H   
01B9   20 19                  JR   NZ,line   
01BB   1E 28        KT1:      LD   E,MSLOOP   ; one millisecond, roughly
01BD   CD 0E 04     KT2:      CALL   getk   
01C0   20 0E                  JR   NZ,kt3   
01C2   1D                     DEC   E   
01C3   20 F8                  JR   NZ,kt2   
01C5   7C                     LD   A,H   ; 0? never counts down: it waits
01C6   B5                     OR   L   
01C7   28 F2                  JR   Z,kt1   
01C9   2B                     DEC   HL   
01CA   7C                     LD   A,H   
01CB   B5                     OR   L   
01CC   20 ED                  JR   NZ,kt1   ; A = 0 if the time ran out
01CE   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
01CF   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
01D0   6F           KT3:      LD   L,A   
01D1   26 00                  LD   H,0   
01D3                          ;*Macro unroll:  NEXT
01D3   F7                     DS   (1-CPM)*(1-FAST),0F7h   
01D4                          DS   CPM+FAST-CPM*FAST,0DDh   
01D4                          DS   CPM+FAST-CPM*FAST,0E9h   
01D4                             ; Backspace takes the last character back (and is echoed as it
01D4                             ; is), CR ends (stored, not echoed), every other key is stored and
01D4                             ; echoed until the line is full. (CP/M too: getk reads through BDOS
01D4                             ; 6.) The line buffer starts at offset 80h of its page, so L alone
01D4                             ; is the place in the line: D holds the L of a full line.
01D4   11 7F 00     LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
01D7   19                     ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
01D8   9F                     SBC   A,A   
01D9   A5                     AND   L   ; (0 for a count that is too big)
01DA   2F                     CPL      
01DB   57                     LD   D,A   ; D = the L of a full line: 80h + count, FFh
01DC                             ;   at most
01DC   21 80 82               LD   HL,LINEBUF   
01DF   CD 0E 04     LN2:      CALL   getk   
01E2   28 FB                  JR   Z,ln2   
01E4   FE 0D                  CP   13   
01E6   28 16                  JR   Z,ln5   
01E8   FE 08                  CP   8   
01EA   28 0B                  JR   Z,ln4   
01EC   5F                     LD   E,A   
01ED   7D                     LD   A,L   
01EE   BA                     CP   D   
01EF   28 EE                  JR   Z,ln2   ; full
01F1   73                     LD   (HL),E   
01F2   2C                     INC   L   
01F3   7B                     LD   A,E   
01F4                          ;*Macro unroll: ln3:    PUTA
01F4   EF           LN3:      DS   1-CPM,0EFh   
01F5                          DS   CPM,0CDh   
01F5                          DS   CPM,APUT&0FFh   
01F5                          DS   CPM,APUT/256   
01F5   18 E8                  JR   ln2   
01F7   2D           LN4:      DEC   L   ; Backspace: one back, and echo it,
01F8   FA F4 01               JP   M,ln3   ;   unless the line was empty (L left the
01FB   2C                     INC   L   ;   upper half of the page)
01FC   18 E1                  JR   ln2   
01FE   77           LN5:      LD   (HL),A   ; the CR
01FF   2E 80                  LD   L,LINEBUF & 0FFh   
0201                          ;*Macro unroll:  NEXT
0201   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0202                          DS   CPM+FAST-CPM*FAST,0DDh   
0202                          DS   CPM+FAST-CPM*FAST,0E9h   
0202                             ; =============================================================================
0202                             ;  More routines (no handler starts past this point)
0202                             ; =============================================================================
0202                          IF   CHECKED   
                                 ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
                                 ; "$", and the texts of the report). A NUL first is an error: Q.
                    PRSTR:    LD   A,(HL)   
                              INC   HL   
                              CP   22h   
                              RET   Z   
                              OR   A   
                              JP   Z,e_dollar   
                              CP   "/"   
                              JR   NZ,prs1   
                              LD   A,(HL)   
                              INC   HL   
                              CP   60h   
                              JR   C,prs0   
                              CP   7Fh   
                              JR   C,pesc   
                    PRS0:     AND   0BFh   
                              ;*Macro unroll: prs1:   PUTA
                    PRS1:     DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              JR   prstr   
                    PRLOOP:   EQU   prstr   ; (where the escapes go back to)
                    PRAGAIN:   EQU   hp1   ; (and where /~ goes back to)
                                 ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
                                 ; pnl: the same, on a new line.
                    PNL:      CALL   pmsg   ; (pmsg's own CR LF, then on into pmsg for
                              DB   13,10,22h   ;   the caller's text)
                    PMSG:     EX   (SP),HL   
                              CALL   prstr   
                              EX   (SP),HL   
                              RET      
0202                          ENDIF      
0202                             ; pesc: the escapes of "$". A = the character after the "/", 60h to 7Eh, and
0202                             ; HL points past it. Each goes back into the loop that prints the string
0202                             ; (PRLOOP), but /~ has the stack to see to, and goes back by PRAGAIN.
0202                             ;    /a-/z   print the variable, as "#" does
0202                             ;    /{      clear the screen, the cursor to the top left
0202                             ;    /}      clear from the cursor to the end of the line
0202                             ;    /|  /`  show the cursor, hide it
0202                             ;    /~      ( row col -- ) the cursor to that row and column, from 0
0202   FE 7E        PESC:     CP   7Eh   
0204   28 1C                  JR   Z,pat   
0206   11 97 01               LD   DE,PRLOOP   ; the others return into the loop
0209   D5                     PUSH   DE   
020A   D6 7B                  SUB   7Bh   ; 00bbIDAsIHwgMSwg 2, and no borrow
020C   30 1D                  JR   NC,pcon   
020E   C6 1A                  ADD   A,1Ah   ; a-z: 0-25, and a carry; `: FFh, and none
0210   30 22                  JR   NC,phide   
0212   87                     ADD   A,A   ; the variable's cell
0213   C6 40                  ADD   A,40h   
0215   E5                     PUSH   HL   
0216   6F                     LD   L,A   
0217   26 82                  LD   H,LETPAGE   
0219   7E                     LD   A,(HL)   
021A   2C                     INC   L   
021B   66                     LD   H,(HL)   
021C   6F                     LD   L,A   
021D   CD C6 03               CALL   psgn   
0220   E1                     POP   HL   
0221   C9                     RET      
0222                             ; /~ ( row col addr -- ): the two cells under the string's address go. In
0222                             ; the checked build "$" is the routine prstr: its own return address goes
0222                             ; first, and hp1 calls it again afterwards. There each /~ first looks that
0222                             ; its two cells are there, and is s if not, before it prints anything.
0222                PAT:         
0222                          IF   CHECKED   
                              EX   (SP),HL   ; the text pointer over prstr's return address
                              LD   HL,(6-DSTOP)&0FFFFh   ; a carry: the two cells aren't there
                              ADD   HL,SP   
                              JP   C,e_under   
                              POP   HL   
0222                          ENDIF      
0222   D1                     POP   DE   ; DE = the column
0223   E3                     EX   (SP),HL   ; HL = the row; the text pointer is kept
0224                          IF   1-ANS   
0224   CD 15 FF               CALL   CONAT   
0227   E1                     POP   HL   
0228   C3 97 01               JP   PRAGAIN   
022B                             ; With ANSI = 0 the machine's routines do the rest.
022B   CA 0C FF     PCON:     JP   Z,CONCLS   ; /{
022E   FE 02                  CP   2   
0230   CA 0F FF               JP   Z,CONEOL   ; /}
0233   FE                     DB   0FEh   ; /|  (CP n steps over the XOR: A = 1, show)
0234   AF           PHIDE:    XOR   A   ; /`  (A = 0: hide)
0235   C3 12 FF               JP   CONCUR   
0238                          ENDIF      
0238                          IF   ANS   
                              PUSH   DE   
                              CALL   csi   ; ESC [ row+1 ; col+1 H (ANSI counts from 1)
                              INC   HL   
                              CALL   pdec   
                              ;*Macro unroll:  PUTK    3Bh             ; ';'
                              DS   1-CPM,3Eh   ; ";"
                              DS   1-CPM,3Bh   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,3Bh   
                              POP   HL   
                              INC   HL   
                              CALL   pdec   
                              ;*Macro unroll:  PUTK    48h             ; 'H'
                              DS   1-CPM,3Eh   ; "H"
                              DS   1-CPM,48h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,48h   
                              POP   HL   
                              JP   PRAGAIN   
                                 ; With ANSI = 1 they are sequences. The carry is clear on the way in.
                    PSHOW:    LD   E,"h"   ; /|  ESC [ ? 2 5 h
                              DB   0DAh   ; (JP C,nn: with no carry it steps over two bytes)
                    PHIDE:    LD   E,"l"   ; /`  ESC [ ? 2 5 l
0238                          ENDIF      
0238                          IF   ANS*CHECKED   
                                 ; (The checked build prints the fixed parts with pmsg, which it has for the
                                 ; report: shorter than a character at a time.)
                              CALL   pmsg   
                              DB   27,"[?25",22h   
                    PSE:      LD   A,E   ; then E
                              ;*Macro unroll:  PUTAR
                              DS   1-CPM,0EFh   
                              DS   1-CPM,0C9h   
                              DS   CPM,0C3h   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                                 ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into cse.
                    PCON:     DEC   A   
                              JR   Z,pshow   ; /|
                              LD   E,"K"   
                              JP   P,cse   ; /}  ESC [ K
                              LD   E,"H"   ; /{  ESC [ H ESC [ J
                              CALL   cse   
                              LD   E,"J"   ; (on into cse)
                                 ; cse: ESC [ and then E. csi: ESC [. Both keep HL.
                    CSE:      CALL   csi   
                              JR   pse   
                    CSI:      CALL   pmsg   
                              DB   27,"[",22h   
                              RET      
0238                          ENDIF      
0238                          IF   ANS*(1-CHECKED)   
                              LD   A,"?"   
                              CALL   csia   
                              ;*Macro unroll:  PUTK    32h             ; '2'
                              DS   1-CPM,3Eh   ; "2"
                              DS   1-CPM,32h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,32h   
                              ;*Macro unroll:  PUTK    35h             ; '5'
                              DS   1-CPM,3Eh   ; "5"
                              DS   1-CPM,35h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,35h   
                              LD   A,E   
                              ;*Macro unroll:  PUTAR
                              DS   1-CPM,0EFh   
                              DS   1-CPM,0C9h   
                              DS   CPM,0C3h   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                                 ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into csia.
                    PCON:     DEC   A   
                              JR   Z,pshow   ; /|
                              LD   A,"K"   
                              JP   P,csia   ; /}  ESC [ K
                              LD   A,"H"   ; /{  ESC [ H ESC [ J
                              CALL   csia   
                              LD   A,"J"   ; (on into csia)
                                 ; csia: ESC [ and then A. csi: ESC [, keeping A.
                    CSIA:     CALL   csi   
                              ;*Macro unroll:  PUTAR
                              DS   1-CPM,0EFh   
                              DS   1-CPM,0C9h   
                              DS   CPM,0C3h   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                    CSI:      PUSH   AF   
                              ;*Macro unroll:  PUTK    1Bh             ; ESC
                              DS   1-CPM,3Eh   ; ESC
                              DS   1-CPM,1Bh   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,1Bh   
                              ;*Macro unroll:  PUTK    5Bh             ; '['
                              DS   1-CPM,3Eh   ; "["
                              DS   1-CPM,5Bh   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,5Bh   
                              POP   AF   
                              RET      
0238                          ENDIF      
0238                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
0238                             ; Uses A; keeps BC (the IP) itself. The dividend shifts up through A:C while
0238                             ; the quotient bits arrive at the bottom of C.
0238                             ; Dividing by 2 is one shift (the spec wants that fast).
0238                          IF   1-QK   
                    UDIV:     LD   A,E   
                              XOR   2   
                              OR   D   
                              JR   NZ,udv0   
                              SRL   H   
                              RR   L   ; the quotient
                              ADC   A,A   
                              LD   E,A   ; the remainder: the bit that fell out (D is 0)
                              RET      
0238                          ENDIF      
0238                          IF   QK   
0238                             ; (The builds with room divide by any power of two with shifts: 2, and 32,
0238                             ; 64, 256 and the like, which fixed point and byte work use all the time.)
0238   7A           UDIV:     LD   A,D   
0239   B7                     OR   A   
023A   20 1A                  JR   NZ,uq1   ; 256 and up
023C   B3                     OR   E   
023D   28 33                  JR   Z,udv0   ; by 0: the long way (it means nothing anyway)
023F   3D                     DEC   A   
0240   A3                     AND   E   
0241   20 2F                  JR   NZ,udv0   ; not a power of two
0243   7B                     LD   A,E   ; by 2^k below 256: q = HL >> k, and
0244   3D                     DEC   A   ;   r = L & (2^k - 1)
0245   A5                     AND   L   
0246   F5                     PUSH   AF   
0247   CB 3B        UQ2:      SRL   E   
0249   38 06                  JR   C,uq3   
024B   CB 3C                  SRL   H   
024D   CB 1D                  RR   L   
024F   18 F6                  JR   uq2   
0251   F1           UQ3:      POP   AF   
0252   5F                     LD   E,A   
0253   16 00                  LD   D,0   
0255   C9                     RET      
0256   7B           UQ1:      LD   A,E   
0257   B7                     OR   A   
0258   20 18                  JR   NZ,udv0   
025A   7A                     LD   A,D   
025B   3D                     DEC   A   
025C   A2                     AND   D   
025D   20 13                  JR   NZ,udv0   ; not a power of two
025F   7A                     LD   A,D   ; by 2^k, 256 and up: q = H >> (k - 8), and
0260   3D                     DEC   A   ;   r = HL & (2^k - 1)
0261   A4                     AND   H   
0262   5F                     LD   E,A   ; (the remainder's high byte,
0263   7D                     LD   A,L   ;   and its low byte)
0264   6C                     LD   L,H   
0265   26 00                  LD   H,0   
0267   CB 3A        UQ4:      SRL   D   
0269   38 04                  JR   C,uq5   
026B   CB 3D                  SRL   L   
026D   18 F8                  JR   uq4   
026F   53           UQ5:      LD   D,E   
0270   5F                     LD   E,A   
0271   C9                     RET      
0272                          ENDIF      
0272                          IF   1-FAST   
0272   C5           UDV0:     PUSH   BC   
0273   7C                     LD   A,H   
0274   4D                     LD   C,L   
0275   21 00 00               LD   HL,0   
0278   06 10                  LD   B,16   
027A   CB 21        UDV1:     SLA   C   
027C   17                     RLA      
027D   ED 6A                  ADC   HL,HL   
027F   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
0281   30 02                  JR   NC,udv2   ;   always fits in 16 bits
0283   19                     ADD   HL,DE   ; too much: put it back, and cancel the
0284   0D                     DEC   C   ;   INC below
0285   0C           UDV2:     INC   C   ; a quotient bit
0286   10 F2                  DJNZ   udv1   
0288   EB                     EX   DE,HL   ; DE = remainder
0289   67                     LD   H,A   
028A   69                     LD   L,C   ; HL = quotient
028B   C1                     POP   BC   
028C   C9                     RET      
028D                          ENDIF      
028D                          IF   FAST   
                                 ; (the fast build: the same 16 rounds, unrolled)
                    UDV0:     PUSH   BC   
                              LD   A,H   
                              LD   C,L   
                              LD   HL,0   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr0   
                              ADD   HL,DE   
                              DEC   C   
                    UVR0:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr1   
                              ADD   HL,DE   
                              DEC   C   
                    UVR1:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr2   
                              ADD   HL,DE   
                              DEC   C   
                    UVR2:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr3   
                              ADD   HL,DE   
                              DEC   C   
                    UVR3:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr4   
                              ADD   HL,DE   
                              DEC   C   
                    UVR4:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr5   
                              ADD   HL,DE   
                              DEC   C   
                    UVR5:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr6   
                              ADD   HL,DE   
                              DEC   C   
                    UVR6:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr7   
                              ADD   HL,DE   
                              DEC   C   
                    UVR7:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr8   
                              ADD   HL,DE   
                              DEC   C   
                    UVR8:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr9   
                              ADD   HL,DE   
                              DEC   C   
                    UVR9:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr10   
                              ADD   HL,DE   
                              DEC   C   
                    UVR10:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr11   
                              ADD   HL,DE   
                              DEC   C   
                    UVR11:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr12   
                              ADD   HL,DE   
                              DEC   C   
                    UVR12:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr13   
                              ADD   HL,DE   
                              DEC   C   
                    UVR13:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr14   
                              ADD   HL,DE   
                              DEC   C   
                    UVR14:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr15   
                              ADD   HL,DE   
                              DEC   C   
                    UVR15:    INC   C   
                              EX   DE,HL   ; DE = remainder
                              LD   H,A   
                              LD   L,C   ; HL = quotient
                              POP   BC   
                              RET      
028D                          ENDIF      
028D                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
028D                             ; non-digit. Values wrap at 16 bits, as the spec says.
028D   21 00 00     RDNUM:    LD   HL,0   
0290   0A           RDN1:     LD   A,(BC)   
0291   D6 30                  SUB   "0"   
0293   FE 0A                  CP   10   
0295   D0                     RET   NC   
0296   03                     INC   BC   
0297   54                     LD   D,H   
0298   5D                     LD   E,L   
0299   29                     ADD   HL,HL   
029A   29                     ADD   HL,HL   
029B   19                     ADD   HL,DE   
029C   29                     ADD   HL,HL   ; HL * 10
029D   5F                     LD   E,A   
029E   16 00                  LD   D,0   
02A0   19                     ADD   HL,DE   
02A1   18 ED                  JR   rdn1   
02A3                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
02A3                             ; the next character, so "/"" does not end it. Leaves A = 22h.
02A3                          IF   1-CHECKED   
02A3   03           SS0:      INC   BC   
02A4   0A           SKIPSTR:   LD   A,(BC)   
02A5   03                     INC   BC   
02A6   FE 2F                  CP   "/"   
02A8   28 F9                  JR   Z,ss0   
02AA   FE 22                  CP   22h   
02AC   20 F6                  JR   NZ,skipstr   
02AE   C9                     RET      
02AF                          ENDIF      
02AF                          IF   CHECKED   
                                 ; The checked build never steps over a NUL: if the text runs out first it
                                 ; returns A = 0 with the IP on the NUL.
                    SKIPSTR:   LD   A,(BC)   
                              OR   A   
                              RET   Z   
                              INC   BC   
                              CP   22h   
                              RET   Z   
                              CP   "/"   
                              JR   NZ,skipstr   
                              LD   A,(BC)   ; the escaped character
                              OR   A   
                              RET   Z   
                              INC   BC   
                              JR   skipstr   
02AF                          ENDIF      
02AF                             ; skip: read past text to the closer at this level, and return A = 0 if it
02AF                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
02AF                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
02AF                             ; no closer; anything else that runs into the NUL had unbalanced brackets
02AF                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
02AF                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
02AF                             ; 
02AF                             ; The checked build also looks at the character the skip was started by,
02AF                             ; which is always the one just before where it starts: "(" must end at ")",
02AF                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
02AF                             ; quote counts as running into it. "\" takes either closer. SKPL keeps the
02AF                             ; place where the skip started, for the report.
02AF                          IF   1-QK   
                                 ; (Without base: no skip cache.)
                    SKIP:        
02AF                          ENDIF      
02AF                          IF   CHECKED*(1-QK)   
                              LD   (SKPL),BC   
                              DEC   BC   
                              LD   A,(BC)   
                              INC   BC   
                              LD   E,A   ; E = the opener: ( [ or \
02AF                          ENDIF      
02AF                          IF   1-QK   
                              LD   D,0   
                    SK3:      INC   D   ; an opener: one deeper
                    SK1:      LD   A,(BC)   
02AF                          ENDIF      
02AF                          IF   (1-CHECKED)*(1-QK)   
                              INC   BC   
                              OR   A   
                              JP   Z,SKEND   ; (the end of the program)
02AF                          ENDIF      
02AF                          IF   CHECKED*(1-QK)   
                              OR   A   
                              JR   Z,sk6   ; (the IP stays on the NUL)
                              INC   BC   
02AF                          ENDIF      
02AF                          IF   1-QK   
                              CP   22h   
                              CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
                              SUB   "("   ;   (or 0, and then the NUL is read next)
                              JR   Z,sk3   
                              DEC   A   ; ")"
                              JR   Z,sk4   
                              SUB   "["-")"   
                              JR   Z,sk3   
                              CP   "]"-"["   
                              JR   NZ,sk1   
                    SK4:      DEC   D   
02AF                          ENDIF      
02AF                          IF   (1-CHECKED)*(1-QK)   
                              RET   Z   ; the closer at this level
                              JR   sk1   
02AF                          ENDIF      
02AF                          IF   CHECKED*(1-QK)   
                              JR   NZ,sk1   
                              LD   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
                              XOR   E   ;   opener is 0 for "(" and 1 for "[", and only
                              AND   6   ;   "\" has bit 2: so this is 2 for the wrong
                              CP   2   ;   closer, and only then
                              LD   A,D   
                              RET   NZ   
                              JR   sk7   
                    SK6:      BIT   2,E   ; the text ran out:
                              JP   NZ,SKEND   ;   "\" with no closer ends the program
                    SK7:      LD   BC,(SKPL)   ; N. The place is the opener
                              LD   A,"N"   
                              JP   errp   ; (errp drops skip's return address)
02AF                          ENDIF      
02AF                          IF   QK   
02AF                             ; The skip cache. Nearly every skip is one that has happened before (a loop
02AF                             ; skips the same false block on every pass), so the first scan from each
02AF                             ; place is remembered: 64 entries of 00bbc3RhcnQsIGVuZA==, at CPAGE, found by the
02AF                             ; start's low byte. Only skips that start in the program text are kept (the
02AF                             ; line buffer changes); the cache is emptied whenever a run starts (skclr).
02AF                             ; A program that changes its own text while it runs is not looked after.
02AF   ED 43 3C 82  SKIP:     LD   (SKPL),BC   ; where it starts: the cache's key (and the
02B3   78                     LD   A,B   ;   checked report's place)
02B4   FE 83                  CP   PROG/256   
02B6   38 1B                  JR   C,sks   ; below the program text: no cache
02B8   79                     LD   A,C   
02B9   87                     ADD   A,A   
02BA   87                     ADD   A,A   
02BB   5F                     LD   E,A   
02BC   16 F0                  LD   D,CPAGE   ; DE -> the entry
02BE   1A                     LD   A,(DE)   
02BF   B9                     CP   C   
02C0   20 11                  JR   NZ,sks   
02C2   1C                     INC   E   
02C3   1A                     LD   A,(DE)   
02C4   B8                     CP   B   
02C5   20 0C                  JR   NZ,sks   
02C7   1C                     INC   E   
02C8   1A                     LD   A,(DE)   
02C9   4F                     LD   C,A   
02CA   1C                     INC   E   
02CB   1A                     LD   A,(DE)   
02CC   47                     LD   B,A   ; a hit: the IP is past the closer
02CD   0B                     DEC   BC   
02CE   0A                     LD   A,(BC)   
02CF   03                     INC   BC   
02D0   D6 29                  SUB   ")"   ; 0 for ")", not 0 for "]"
02D2   C9                     RET      
02D3                SKS:         
02D3                          ENDIF      
02D3                          IF   QK*CHECKED   
                              DEC   BC   
                              LD   A,(BC)   
                              INC   BC   
                              LD   E,A   ; E = the opener: ( [ or \
02D3                          ENDIF      
02D3                          IF   QK   
02D3                             ; The scan. Most characters are nothing to it, and two range tests rule
02D3                             ; them out: * to Z, and ^ and up. Only NUL " ( ) [ ] count.
02D3   16 00                  LD   D,0   
02D5   14           SQ3:      INC   D   ; an opener: one deeper
02D6   0A           SQ1:      LD   A,(BC)   
02D7   03                     INC   BC   
02D8   FE 5E                  CP   5Eh   
02DA   30 FA                  JR   NC,sq1   ; ^ _ ` a-z 00bbIHwg ~ and up: nothing
02DC   FE 5B                  CP   5Bh   
02DE   30 19                  JR   NC,sqb   ; [ \ ]
02E0   FE 2A                  CP   2Ah   
02E2   30 F2                  JR   NC,sq1   ; * to Z: nothing
02E4   FE 28                  CP   28h   
02E6   28 ED                  JR   Z,sq3   ; (
02E8   30 19                  JR   NC,sqc   ; )
02EA   FE 22                  CP   22h   
02EC   28 06                  JR   Z,sqq   ; a string
02EE   B7                     OR   A   
02EF   20 E5                  JR   NZ,sq1   ; the rest below "(": nothing
02F1                          ENDIF      
02F1                          IF   QK*(1-CHECKED)   
02F1   C3 09 FF               JP   SKEND   ; NUL: the end of the program
02F4                          ENDIF      
02F4                          IF   QK*CHECKED   
                              DEC   BC   ; NUL: the IP stays on it
                              BIT   2,E   ; the text ran out:
                              JP   NZ,SKEND   ;   "\" with no closer ends the program
                    SQ7:      LD   BC,(SKPL)   ; N. The place is the opener
                              LD   A,"N"   
                              JP   errp   ; (errp drops skip's return address)
02F4                          ENDIF      
02F4                          IF   QK   
02F4   CD A4 02     SQQ:      CALL   skipstr   ; step over the string
02F7   18 DD                  JR   sq1   
02F9   D6 5C        SQB:      SUB   5Ch   ; [ -1, \ 0, ] 1
02FB   28 D9                  JR   Z,sq1   ; "\" is nothing here
02FD   38 D6                  JR   C,sq3   ; [
02FF   3E 02                  LD   A,2   ; ]
0301   18 01                  JR   sq4   
0303   AF           SQC:      XOR   A   ; )
0304   15           SQ4:      DEC   D   
0305   20 CF                  JR   NZ,sq1   
0307                          ENDIF      
0307                          IF   QK*CHECKED   
                              LD   D,A   ; the closer at this level (as above): 2 here
                              XOR   E   ;   means the wrong closer
                              AND   6   
                              CP   2   
                              LD   A,D   
                              JR   Z,sq7   
0307                          ENDIF      
0307                          IF   QK   
0307                             ; The closer at this level: remember the skip (if it started in the program
0307                             ; text), and return A = 0 for ")" or 2 for "]".
0307   F5                     PUSH   AF   
0308   E5                     PUSH   HL   
0309   2A 3C 82               LD   HL,(SKPL)   
030C   7C                     LD   A,H   
030D   FE 83                  CP   PROG/256   
030F   38 11                  JR   C,sq9   
0311   7D                     LD   A,L   
0312   87                     ADD   A,A   
0313   87                     ADD   A,A   
0314   5F                     LD   E,A   
0315   16 F0                  LD   D,CPAGE   
0317   7D                     LD   A,L   
0318   12                     LD   (DE),A   
0319   1C                     INC   E   
031A   7C                     LD   A,H   
031B   12                     LD   (DE),A   
031C   1C                     INC   E   
031D   79                     LD   A,C   
031E   12                     LD   (DE),A   
031F   1C                     INC   E   
0320   78                     LD   A,B   
0321   12                     LD   (DE),A   
0322   E1           SQ9:      POP   HL   
0323   F1                     POP   AF   
0324   C9                     RET      
0325                             ; skclr: empty the skip cache (a start of 0000h matches no skip). Keeps HL.
0325   E5           SKCLR:    PUSH   HL   
0326   21 00 F0               LD   HL,CPAGE*256   
0329   36 00        SKC1:     LD   (HL),0   
032B   2C                     INC   L   
032C   20 FB                  JR   NZ,skc1   
032E   E1                     POP   HL   
032F   C9                     RET      
0330                          ENDIF      
0330                             ;  ---- Speed-ups (base builds) -------------------------------------------
0330                             ;  The skip cache is above. These are the handlers' tails that the builds with
0330                             ;  room take, kept here, out of the handlers' first two pages.
0330                          IF   QK   
0330                             ; "*" with an operand below 256 takes 8 rounds, not 16: that one becomes the
0330                             ; multiplier (most multiplications have one, a count or a small constant).
0330   7C           MULQ:     LD   A,H   
0331   B7                     OR   A   
0332   28 05                  JR   Z,mq8   ; the multiplier is below 256
0334   7A                     LD   A,D   
0335   B7                     OR   A   
0336   20 11                  JR   NZ,mq16   
0338   EB                     EX   DE,HL   ; the multiplicand is: it becomes the multiplier
0339                          ENDIF      
0339                          IF   QK*(1-FAST)   
0339   7D           MQ8:      LD   A,L   
033A   21 00 00               LD   HL,0   
033D   C5                     PUSH   BC   
033E   06 08                  LD   B,8   
0340   29           MQ1:      ADD   HL,HL   
0341   17                     RLA      
0342   30 01                  JR   NC,mq2   
0344   19                     ADD   HL,DE   
0345   10 F9        MQ2:      DJNZ   mq1   
0347   C1                     POP   BC   
0348                          ;*Macro unroll:  NEXT
0348   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0349                          DS   CPM+FAST-CPM*FAST,0DDh   
0349                          DS   CPM+FAST-CPM*FAST,0E9h   
0349   C5           MQ16:     PUSH   BC   ; 16 rounds; the multiplier shifts up through A:C
034A   7C                     LD   A,H   
034B   4D                     LD   C,L   
034C   21 00 00               LD   HL,0   
034F   06 10                  LD   B,16   
0351   29           MQ3:      ADD   HL,HL   
0352   CB 21                  SLA   C   
0354   17                     RLA      
0355   30 01                  JR   NC,mq4   
0357   19                     ADD   HL,DE   
0358   10 F7        MQ4:      DJNZ   mq3   
035A   C1                     POP   BC   
035B                          ;*Macro unroll:  NEXT
035B   F7                     DS   (1-CPM)*(1-FAST),0F7h   
035C                          DS   CPM+FAST-CPM*FAST,0DDh   
035C                          DS   CPM+FAST-CPM*FAST,0E9h   
035C                          ENDIF      
035C                          IF   FAST   
                                 ; (the fast build: the same rounds, unrolled)
                    MQ8:      LD   A,L   
                              LD   HL,0   
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur0   
                              ADD   HL,DE   
                    MUR0:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur1   
                              ADD   HL,DE   
                    MUR1:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur2   
                              ADD   HL,DE   
                    MUR2:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur3   
                              ADD   HL,DE   
                    MUR3:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur4   
                              ADD   HL,DE   
                    MUR4:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur5   
                              ADD   HL,DE   
                    MUR5:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur6   
                              ADD   HL,DE   
                    MUR6:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur7   
                              ADD   HL,DE   
                    MUR7:        
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
                    MQ16:     PUSH   BC   
                              LD   A,H   
                              LD   C,L   
                              LD   HL,0   
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus0   
                              ADD   HL,DE   
                    MUS0:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus1   
                              ADD   HL,DE   
                    MUS1:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus2   
                              ADD   HL,DE   
                    MUS2:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus3   
                              ADD   HL,DE   
                    MUS3:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus4   
                              ADD   HL,DE   
                    MUS4:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus5   
                              ADD   HL,DE   
                    MUS5:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus6   
                              ADD   HL,DE   
                    MUS6:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus7   
                              ADD   HL,DE   
                    MUS7:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus8   
                              ADD   HL,DE   
                    MUS8:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus9   
                              ADD   HL,DE   
                    MUS9:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus10   
                              ADD   HL,DE   
                    MUS10:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus11   
                              ADD   HL,DE   
                    MUS11:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus12   
                              ADD   HL,DE   
                    MUS12:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus13   
                              ADD   HL,DE   
                    MUS13:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus14   
                              ADD   HL,DE   
                    MUS14:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus15   
                              ADD   HL,DE   
                    MUS15:       
                              POP   BC   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
035C                          ENDIF      
035C                          IF   QK   
035C                             ; A true ")" reads the block start where it is, on top of the return stack,
035C                             ; instead of popping it and pushing it back; the break key is looked at as
035C                             ; rpushn would.
035C   FD 4E 00     CLOSEQ:   LD   C,(IY+0)   
035F   FD 46 01               LD   B,(IY+1)   
0362   E5                     PUSH   HL   
0363   21 36 82               LD   HL,PCNT   
0366   35                     DEC   (HL)   
0367   E1                     POP   HL   
0368   CC E0 03               CALL   Z,pollk   
036B                          ;*Macro unroll:  NEXT
036B   F7                     DS   (1-CPM)*(1-FAST),0F7h   
036C                          DS   CPM+FAST-CPM*FAST,0DDh   
036C                          DS   CPM+FAST-CPM*FAST,0E9h   
036C                          ENDIF      
036C                          IF   SBASEU   
036C                             ; a-z, in the unchecked builds: a variable followed by "@" or "!" is fetched
036C                             ; or stored in the same step (x@ is the commonest pair in most programs).
036C                             ; (A checked build checks the stacks between the two, so it keeps them apart.)
036C   87           LOWQ:     ADD   A,A   
036D   5F                     LD   E,A   
036E   16 82                  LD   D,LETPAGE   ; DE -> the cell
0370   0A                     LD   A,(BC)   
0371   FE 40                  CP   "@"   
0373   28 07                  JR   Z,lwf   
0375   FE 21                  CP   "!"   
0377   28 0B                  JR   Z,lws   
0379   E5                     PUSH   HL   
037A   EB                     EX   DE,HL   ; TOS = the cell's address
037B                          ;*Macro unroll:  NEXT
037B   F7                     DS   (1-CPM)*(1-FAST),0F7h   
037C                          DS   CPM+FAST-CPM*FAST,0DDh   
037C                          DS   CPM+FAST-CPM*FAST,0E9h   
037C   03           LWF:      INC   BC   ; x@: TOS = the cell's value
037D   E5                     PUSH   HL   
037E   EB                     EX   DE,HL   
037F   5E                     LD   E,(HL)   
0380   2C                     INC   L   
0381   56                     LD   D,(HL)   
0382   EB                     EX   DE,HL   
0383                          ;*Macro unroll:  NEXT
0383   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0384                          DS   CPM+FAST-CPM*FAST,0DDh   
0384                          DS   CPM+FAST-CPM*FAST,0E9h   
0384   03           LWS:      INC   BC   ; x!: the cell = TOS, and NOS comes up
0385   EB                     EX   DE,HL   
0386   73                     LD   (HL),E   
0387   2C                     INC   L   
0388   72                     LD   (HL),D   
0389   E1                     POP   HL   
038A                          ;*Macro unroll:  NEXT
038A   F7                     DS   (1-CPM)*(1-FAST),0F7h   
038B                          DS   CPM+FAST-CPM*FAST,0DDh   
038B                          DS   CPM+FAST-CPM*FAST,0E9h   
038B                          ENDIF      
038B                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)*QK   
038B   01 00 83     QSTART:   LD   BC,PROG   ; the generic reset goes on here: the IP,
038E   CD 25 03               CALL   skclr   ;   an empty skip cache, and the rest of the
0391   C3 6C 00               JP   st0   ;   startup
0394                          ENDIF      
0394                          IF   (1-CPM)*(1-EDITOR)*CHECKED*QK   
                    QINIT:    CALL   skclr   ; (keeps A, which init wants 0)
                              JP   init   
0394                          ENDIF      
0394                             ; =============================================================================
0394                             ;  Dispatch table: the low byte of each handler's address, in code order
0394                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
0394                             ;  It must not cross a page (the dispatcher only adds to its low byte).
0394                             ; =============================================================================
0394                             ; The handlers of the first NPG1 characters start in the image's second page.
0394                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
0394                             ; differs between the builds, so the count is worked out here.
0394                             ; (One division to a line: asm80 only rounds down when it stores a value.)
0394                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
0394                PGBRK:    EQU   (h_break-BASE)/256   
0394                PGDEF:    EQU   (h_def-BASE)/256   
0394                PGFET:    EQU   (h_fetch-BASE)/256   
0394                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
0394                          IF   (1-TABP0)*(1-PTLATE)   
0394                PTAB:        
0394                          ;*Macro unroll:  PTABLE
0394   8B                     DB   h_store & 0FFh   
0395   90                     DB   h_str & 0FFh   
0396   B3                     DB   h_num & 0FFh   
0397   97                     DB   h_print & 0FFh   
0398   86                     DB   h_swap & 0FFh   
0399   40                     DB   h_and & 0FFh   
039A   B0                     DB   h_emit & 0FFh   
039B   1F                     DB   h_open & 0FFh   
039C   27                     DB   h_close & 0FFh   
039D   61                     DB   h_mul & 0FFh   
039E   37                     DB   h_add & 0FFh   
039F   CF                     DB   h_cfetch & 0FFh   
03A0   2F                     DB   h_sub & 0FFh   
03A1   88                     DB   h_cstore & 0FFh   
03A2   65                     DB   h_div & 0FFh   
03A3   84                     DB   h_dup & 0FFh   
03A4   8A                     DB   h_drop & 0FFh   
03A5   48                     DB   h_lt & 0FFh   
03A6   57                     DB   h_eq & 0FFh   
03A7   49                     DB   h_gt & 0FFh   
03A8   B7                     DB   h_key & 0FFh   
03A9   1A                     DB   h_fetch & 0FFh   
03AA   FD                     DB   h_def & 0FFh   
03AB   F0                     DB   h_break & 0FFh   
03AC   EC                     DB   h_ret & 0FFh   
03AD   80                     DB   h_xor & 0FFh   
03AE   93                     DB   h_alloc & 0FFh   
03AF   D6                     DB   h_grave & 0FFh   
03B0   D2                     DB   h_tor & 0FFh   
03B1   88                     DB   h_or & 0FFh   
03B2   1C                     DB   h_fromr & 0FFh   
03B3   90                     DB   h_not & 0FFh   
03B4                PTABEND:      
03B4                          ENDIF      
03B4                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
03B4                             ; and return its value in A with the carry set; otherwise leave the IP and
03B4                             ; return with the carry clear.
03B4   0A           HEXC:     LD   A,(BC)   
03B5   D6 30                  SUB   "0"   
03B7   FE 0A                  CP   10   
03B9   38 09                  JR   C,hc1   
03BB   E6 DF                  AND   0DFh   
03BD   D6 11                  SUB   11h   
03BF   FE 06                  CP   6   
03C1   D0                     RET   NC   
03C2   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
03C4   03           HC1:      INC   BC   
03C5   C9                     RET      
03C6                             ; psgn: print HL as a signed number. Keeps BC.
03C6   CB 7C        PSGN:     BIT   7,H   
03C8   28 04                  JR   Z,pdec   
03CA                          ;*Macro unroll:  PUTK    2Dh             ; '-'
03CA   3E                     DS   1-CPM,3Eh   ; "-"
03CB   2D                     DS   1-CPM,2Dh   
03CC   EF                     DS   1-CPM,0EFh   
03CD                          DS   CPM,0CDh   
03CD                          DS   CPM,APTK&0FFh   
03CD                          DS   CPM,APTK/256   
03CD                          DS   CPM,2Dh   
03CD                          ;*Macro unroll:  NEGH
03CD   E7                     DS   1-CPM,0E7h   
03CE                          DS   CPM,0CDh   
03CE                          DS   CPM,ANEG&0FFh   
03CE                          DS   CPM,ANEG/256   
03CE                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
03CE                             ; Keeps BC.
03CE   11 0A 00     PDEC:     LD   DE,10   
03D1   CD 38 02               CALL   udiv   ; HL = HL / 10, E = the last digit
03D4   7B                     LD   A,E   
03D5   F5                     PUSH   AF   
03D6   7C                     LD   A,H   
03D7   B5                     OR   L   
03D8   C4 CE 03               CALL   NZ,pdec   
03DB   F1                     POP   AF   
03DC   C6 30                  ADD   A,"0"   
03DE                          ;*Macro unroll:  PUTAR
03DE   EF                     DS   1-CPM,0EFh   
03DF   C9                     DS   1-CPM,0C9h   
03E0                          DS   CPM,0C3h   
03E0                          DS   CPM,APUT&0FFh   
03E0                          DS   CPM,APUT/256   
03E0                             ; (The table goes here instead in the builds where, before psgn, it would
03E0                             ; cross a page: PTLATE. If it would cross one here too, it starts on the next
03E0                             ; page: PTPAD is 0 unless it must.)
03E0                          IF   (1-TABP0)*PTLATE   
                    PTPH:     EQU   $ & 0FFh   
                    PTPX:     EQU   (PTPH + 31) / 256   
                    PTPAD:    EQU   PTPX * (256 - PTPH)   
                              DS   PTPAD   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
03E0                          ENDIF      
03E0                             ; =============================================================================
03E0                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
03E0                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
03E0                             ;  (RST 28h) prints A. Both keep BC, DE, HL and IY. In the generic build
03E0                             ;  they are the host's KEY and CONOUT routines themselves.
03E0                             ; 
03E0                             ;  A running program reads the keyboard only through getk and pollk, which
03E0                             ;  between them give the break key its rules:
03E0                             ;    - Ctrl-C stops the program;
03E0                             ;    - any other key that the break check reads is held in KEYBUF for the
03E0                             ;      next "?", and a newer one takes its place;
03E0                             ;    - "?" (getk) takes the held key first;
03E0                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
03E0                             ;      key like any other, but two of them within about 250 ms still stop it.
03E0                             ;  Both are called straight from a handler, never from a routine under one:
03E0                             ;  the checked build's report counts on finding one return address above the
03E0                             ;  data stack.
03E0                             ; =============================================================================
03E0                          IFN   CPM   
03E0                RAWK:     EQU   KEY   
03E0                          ENDIF      
03E0                             ; pollk: the break check (see rpushn).
03E0   CD 06 FF     POLLK:    CALL   rawk   
03E3   C8                     RET   Z   ; no key
03E4   32 7A 82               LD   (KEYBUF),A   ; held for the next "?"
03E7   FE 03        PK1:      CP   3   ; (getk joins here)
03E9   C0                     RET   NZ   
03EA                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
03EA                             ; the program has turned it off, wait about 250 ms for one more key: a
03EA                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
03EA                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
03EA   3A 7B 82     CTLC:     LD   A,(BRKOFF)   
03ED   B7                     OR   A   
03EE   CA 14 00     CT0:      JP   Z,brk   
03F1   D5                     PUSH   DE   
03F2   11 10 27               LD   DE,250*MSLOOP   
03F5   CD 06 FF     CT1:      CALL   rawk   
03F8   20 05                  JR   NZ,ct2   
03FA   1B                     DEC   DE   
03FB   7A                     LD   A,D   
03FC   B3                     OR   E   
03FD   20 F6                  JR   NZ,ct1   
03FF   D1           CT2:      POP   DE   ; A = the second key, or 0 if none came
0400   FE 03                  CP   3   
0402   28 EA                  JR   Z,ct0   ; (the zero flag takes the JP there)
0404   B7                     OR   A   
0405   28 03                  JR   Z,ct3   
0407   32 7A 82               LD   (KEYBUF),A   
040A   3E 03        CT3:      LD   A,3   
040C   B7                     OR   A   
040D   C9                     RET      
040E                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
040E   E5           GETK:     PUSH   HL   ; a held key goes first, and is taken out of
040F   21 7A 82               LD   HL,KEYBUF   ;   the buffer
0412   7E                     LD   A,(HL)   
0413   36 00                  LD   (HL),0   
0415   E1                     POP   HL   
0416   B7                     OR   A   
0417   C0                     RET   NZ   
0418   CD 06 FF               CALL   rawk   
041B   C8                     RET   Z   
041C   18 C9                  JR   pk1   ; Ctrl-C? If not, that is the key
041E                          IF   (1-CHECKED)*(1-EDITOR)   
041E                BRK:      EQU   endprog   ; the unchecked build stops without a word
041E                          ENDIF      ;   (with the editor, both stacks are cleared);
041E                          IF   (1-CHECKED)*EDITOR   
                    BRK:      EQU   edit0   
041E                          ENDIF      
041E                          IF   CHECKED   
                    BRK:      EQU   e_break   ;   the checked build reports B
041E                          ENDIF      
041E                          IF   CPM   
                                 ; The routines a generic build keeps in page zero (see there). Here they are
                                 ; out of the way of the handlers, which must fit in the image's first two
                                 ; pages.
                    RPOP:     LD   E,(IY+0)   ; pop the return stack into DE
                              LD   D,(IY+1)   
                              INC   IY   
                              INC   IY   
                              RET      
                    NEG16:    XOR   A   ; HL = -HL (keeps BC, DE)
                              SUB   L   
                              LD   L,A   
                              SBC   A,A   
                              SUB   H   
                              LD   H,A   
                              RET      
041E                          ENDIF      
041E                          IF   CPM*CHECKED   ; (the checked builds need the room)
                    EXEC:     LD   (RSAVE),IY   ; machine code may change IX and IY
                              CALL   jphl   
                              LD   IY,(RSAVE)   
                              ;*Macro unroll:  SETIX
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,21h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
                              POP   HL   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
041E                          ENDIF      
041E                          IF   CPM   
                    RAWK:     LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
                              JR   putc   
                    PUTK:     EX   (SP),HL   ; print the byte after the CALL
                              LD   A,(HL)   
                              INC   HL   
                              EX   (SP),HL   
                                 ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
                                 ; printing and could swallow a key that BDOS 6 then never sees.
                                 ; It keeps every register but A and the flags: BDOS may change any of them
                                 ; (IX and IY too, in a Z80 BDOS or BIOS).
                    PUTC:     PUSH   BC   
                              PUSH   DE   
                              PUSH   HL   
                              PUSH   IX   
                              PUSH   IY   
                              LD   E,A   
                              LD   C,6   
                              CALL   BDOS   
                              POP   IY   
                              POP   IX   
                              POP   HL   
                              POP   DE   
                              POP   BC   
                              OR   A   ; (for getk)
                              RET      
041E                          ENDIF      
041E                             ; =============================================================================
041E                             ;  Checked build: the checks and the error report
041E                             ; =============================================================================
041E                          IF   CHECKED   
                                 ; chkstk: both stacks are checked once per character, not in every handler.
                                 ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
                                 ; the constant carries if it is above (cells were popped that were never
                                 ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
                                 ; a character late at most: the bytes above DSTOP and the guard band below
                                 ; the page take what happens meanwhile. DE is free between characters.
                    CHKSTK:   EX   DE,HL   
                              LD   HL,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
                              ADD   HL,SP   
                              EX   DE,HL   
                              JR   C,e_under   
                              INC   D   
                              JR   NZ,e_over   
                              PUSH   IY   ; the return stack: in its page (or it has
                              POP   DE   ;   overflowed), and not above its empty
                              LD   A,D   ;   position (an underflow stays inside the
                              CP   RSPAGE   ;   page, in the guard band)
                              LD   A,E   
                              JR   NZ,e_rover   
                              CP   RSTOP&0FFh+1   
                              RET   C   
                              LD   IY,RSTOP   ; return stack underflow: it counts as empty
                              LD   A,"r"   
                              JR   errp   
                    E_ROVER:   LD   A,"R"   ; return stack overflow
                              DB   11h   ; (LD DE,nn hides the next entry)
                    E_OVER:   LD   A,"S"   ; data stack overflow
                              JR   errp   
                    E_UNDER:   LD   SP,DSTOP   ; data stack underflow: it counts as empty
                              LD   A,"s"   
                              JR   error   
                                 ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
                                 ; was never defined still holds 0000h, and the byte there is a reserved one
                                 ; in every build (AFh or C3h): if the IP is in page zero, this was a call of
                                 ; an undefined word. The call is undone, so the place is the call itself.
                    E_HI:     INC   B   
                              DJNZ   e_resv   ; (B is as it was, and is not 0)
                              ;*Macro unroll:  POPR
                              DS   1-CPM,0CFh   
                              DS   CPM,0CDh   
                              DS   CPM,AROP&0FFh   
                              DS   CPM,AROP/256   
                              LD   B,D   
                              LD   C,E   
                              LD   A,"U"   
                              JR   error   
                                 ; chkhp: HL = the new heap top, DE = the old one, the carry is from adding
                                 ; the count. Stop if the top is not below the limit page, or is below the
                                 ; program's end.
                    CHKHP:       
041E                          ENDIF      
041E                          IF   CHECKED*CPM   
                                 ; With this much room a top that wrapped round can land back in
                                 ; range, so the add is tested too: growing (A, the count's high
                                 ; byte, is positive) must not carry, and releasing must.
                              RRA      ; the carry comes in above the sign:
                              ADD   A,40h   ;   bit 7 = carry XOR sign
                              ADD   A,A   
                              JR   C,e_heap   
                              LD   A,(0007h)   
                              DEC   A   
                              CP   H   
                              JR   C,e_heap   
041E                          ENDIF      
041E                          IF   CHECKED*(1-CPM)   
                                 ; (Here the program's space is under 32K, so a top that wrapped
                                 ; round always falls outside it.)
                              LD   A,H   
                              CP   HEAPLIM   
                              JR   NC,e_heap   
041E                          ENDIF      
041E                          IF   CHECKED   
                              PUSH   DE   
                              EX   DE,HL   
                              LD   HL,(NPEND)   
                              ADD   HL,DE   ; carry: at or above the program's end
                              EX   DE,HL   
                              POP   DE   
                              RET   C   
                    E_HEAP:   OR   A   ; put the count back in TOS for the report
                              SBC   HL,DE   
                              LD   A,"H"   
                              JR   errp   
                                 ; chkst: stop unless HL is in the program's own space: from the letter page
                                 ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
                                 ; whatever lies above the limit are safe. Memory above the heap top but
                                 ; below the limit is the program's own: Tiny BASIC keeps its lines there.
                                 ; It is the page of HL + 1 that is tested, so that one test serves both
                                 ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
                                 ; Keeps HL and BC. It runs on into its own error entry.
                    CHKST:    INC   HL   
                              LD   A,H   
                              DEC   HL   
                              CP   LETPAGE   
                              JR   C,e_store   
041E                          ENDIF      
041E                          IF   CHECKED*(1-CPM)   
                              CP   HEAPLIM   
                              RET   C   
041E                          ENDIF      
041E                          IF   CHECKED*CPM   
                              LD   E,A   
                              LD   A,(0007h)   ; the BDOS page is the heap limit
                              DEC   A   
                              CP   E   
                              RET   NC   
041E                          ENDIF      
041E                          IF   CHECKED   
                                 ; Error entries. Each loads its letter and then hides the next entry inside
                                 ; a 3-byte LD DE,nn (the 11h), so they all fall through to `error`.
                    E_STORE:   LD   A,"O"   ; a store outside the program's space
                              DB   11h   
                    E_BREAK:   LD   A,"B"   ; Ctrl-C (found inside pollk or getk)
                                 ; errp: an error found inside a routine: drop its return address first.
                    ERRP:     POP   DE   
                              JR   error   
                                 ; e_dollar: "$" ran into a NUL (in prstr): Q, with the string's address
                                 ; back in TOS. prstr"s return address goes first. But if "$' had no
                                 ; address at all (the stack was empty), it is s, found now: chkstk, called
                                 ; one cell up, sees the stack past its empty place then.
                    E_DOLLAR:   POP   DE   
                              POP   HL   
                              CALL   chkstk   
                              PUSH   HL   
                              LD   HL,(RSAVE)   
                              DB   11h   ; (LD DE,nn hides e_quote's first two bytes)
                    E_QUOTE:   LD   B,H   ; an unclosed string: HL is its address, one
                              LD   C,L   ;   past the opening quote, which is the place
                              LD   A,"Q"   
                              DB   11h   
                    E_RESV:   LD   A,"X"   ; a reserved byte outside a string
                              DB   11h   
                    E_ZERO:   LD   A,"Z"   ; dividing by zero
                              DB   11h   
                    E_BRACK:   LD   A,"W"   ; bad character after [
                                 ; error: the report, then the end. A = the letter, BC = one past the place,
                                 ; HL = TOS, and both stacks as the report is to show them:
                                 ; 
                                 ;   Err X @ line,col
                                 ;   D:n: the top 8 cells at most, bottom to top
                                 ;   R:n
                    ERROR:    PUSH   HL   ; now the whole data stack is in memory
                              LD   E,A   
                              CALL   pnl   
                              DB   "Err ",22h   
                              LD   A,E   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              CALL   pmsg   
                              DB   " @ ",22h   
                              DEC   BC   ; BC = the place
                                 ; The line and column. A place below the program is in the line
                                 ; buffer: line 0. Otherwise count the LFs from the program's start;
                                 ; DE = the line's number, HL = where it starts.
                              LD   HL,LINEBUF   
                              LD   DE,0   
                              LD   A,B   
                              CP   PROG/256   
                              JR   C,er3   
                              INC   H   
                              LD   L,E   ; HL = PROG
                    ER1:      INC   DE   ; a new line starts at HL
                              PUSH   HL   
                    ER2:      LD   A,L   
                              SUB   C   
                              LD   A,H   
                              SBC   A,B   
                              JR   NC,er2x   ; reached the place
                              LD   A,(HL)   
                              INC   HL   
                              CP   10   
                              JR   NZ,er2   
                              POP   AF   
                              JR   er1   
                    ER2X:     POP   HL   
                    ER3:      PUSH   BC   
                              PUSH   HL   
                              EX   DE,HL   
                              CALL   pdec   ; the line
                              ;*Macro unroll:  PUTK    2Ch             ; ','
                              DS   1-CPM,3Eh   ; ","
                              DS   1-CPM,2Ch   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,2Ch   
                              POP   DE   
                              POP   HL   
                              OR   A   
                              SBC   HL,DE   
                              INC   HL   
                              CALL   pdec   ; the column
                                 ; The two stack lines:  D:n: the top 8 cells at most, bottom to top
                                 ;                       R:n
                                 ; TOS is in memory with the rest (pushed) by now.
                              CALL   pnl   
                              DB   "D:",22h   
                              LD   HL,DSTOP-2   ; (DSTOP-2) - SP is twice the depth (the cell
                              SBC   HL,SP   ;   at DSTOP-2 was pushed with the first value
                                 ;   and holds nothing; pnl left the carry clear)
                              CALL   phalf   ; the depth
                              ;*Macro unroll:  PUTK    3Ah             ; ':'
                              DS   1-CPM,3Eh   ; ":"
                              DS   1-CPM,3Ah   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,3Ah   
                              LD   A,C   
                              CP   9   
                              JR   C,er6   
                              CALL   pmsg   
                              DB   " ...",22h   
                              LD   C,8   
                    ER6:      LD   H,0   ; C = the number of cells to show
                              LD   L,C   
                              ADD   HL,HL   
                              ADD   HL,SP   ; HL -> just above the deepest of them
                              INC   C   
                    ER7:      DEC   C   
                              JR   Z,er8   
                              DEC   HL   
                              LD   D,(HL)   
                              DEC   HL   
                              LD   E,(HL)   
                              PUSH   HL   
                              ;*Macro unroll:  PUTK    20h             ; ' '
                              DS   1-CPM,3Eh   ; " "
                              DS   1-CPM,20h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,20h   
                              EX   DE,HL   
                              CALL   psgn   
                              POP   HL   
                              JR   er7   
                    ER8:      CALL   pnl   
                              DB   "R:",22h   
                              PUSH   IY   ; RSTOP - IY is under 256 (the pointer is
                              POP   HL   ;   at most one entry below its page), so
                              LD   A,RSTOP&0FFh   ;   the low bytes are enough
                              SUB   L   
                              LD   L,A   
                              LD   H,0   
                              CALL   phalf   
                              CALL   pnl   
                              DB   22h   
041E                          ENDIF      
041E                          IF   CHECKED*(1-EDITOR)   
                              JP   endprog   
041E                          ENDIF      
041E                          IF   CHECKED*EDITOR   
                              JR   edit0   ; back to the editor, with both stacks cleared
041E                          ENDIF      
041E                          IF   CHECKED   
                                 ; phalf: print half of HL, and leave it in C.
                    PHALF:    SRL   H   
                              RR   L   
                              PUSH   HL   
                              CALL   pdec   
                              POP   BC   
                              RET      
041E                          ENDIF      
041E                             ; =============================================================================
041E                             ;  The line editor (EDITOR = 1)
041E                             ; 
041E                             ;  The interpreter starts here, and a program that ends comes back here.
041E                             ;  There is no prompt. It follows the spec's suggested standard for a line
041E                             ;  editor (docs/b8script.md, Environments). Type a line and press Return:
041E                             ; 
041E                             ;    n text    put the text in as line n; the lines from n on move down. A
041E                             ;              number past the end (or 0) adds the line at the end.
041E                             ;    n         take line n out
041E                             ;    anything else is run at once, as B8Script. (Start such a line with a
041E                             ;    space if it would begin with a digit.)
041E                             ; 
041E                             ;  A command key ends the line too, and takes what was typed as its argument:
041E                             ; 
041E                             ;    ^G        run the program
041E                             ;    n ^L      list from line n (no number: all of it). Any key holds the
041E                             ;              list until another key is pressed; Ctrl-C ends it.
041E                             ;    n ^E      put line n in the input line; Return puts it back, changed
041E                             ;    name ^R   read. CP/M: the file of that name (no name: the same file as
041E                             ;              last time). Generic: what is typed, or pasted, from now until
041E                             ;              ^Z replaces the program; it is not echoed.
041E                             ;    name ^W   write. CP/M: to that file (no name: the same file as last
041E                             ;              time). Generic: the text is printed, as it is.
041E                             ;    ^N        new: no program
041E                             ;    ^X        leave (to LEAVE)
041E                             ; 
041E                             ;  In the line: the left and right arrow keys move the cursor;
041E                             ;  a character goes in at the cursor; Backspace and DEL take out the one
041E                             ;  before it; Esc drops the line. Only CR, LF, BS and printing characters are
041E                             ;  sent to the terminal, so any terminal will do.
041E                             ; 
041E                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
041E                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
041E                             ;  125 characters; the one character after a line number separates it from
041E                             ;  the text and is not stored. The text is kept as it is typed, each line
041E                             ;  ending in CR LF, at PROG.
041E                             ; 
041E                             ;  What lasts from one line to the next: the program, the words, the
041E                             ;  variables and the data stack. An error or a break clears both stacks. The
041E                             ;  return stack starts empty for every line.
041E                             ; 
041E                             ;  Things to know:
041E                             ;    - Reset empties the program (generic builds).
041E                             ;    - A word's address points into the program, so run the program again
041E                             ;      after editing it.
041E                             ;    - Nothing is printed between a program's output and what is typed next.
041E                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
041E                             ;      a line that calls -n? and carries on afterwards runs what was typed.
041E                             ;      (The stored program never comes back to the line, so it may.)
041E                             ;    - The editor"s own keys are not the program"s: -n? is the plain line
041E                             ;      read of the other builds.
041E                             ; 
041E                             ;  The data stack is the CPU's stack, so the editor works on top of whatever
041E                             ;  the last line left there, with TOS pushed like the rest.
041E                             ; =============================================================================
041E                          IF   EDGEN   
                    INIT:        ; reset (A = 0)
041E                          ENDIF      
041E                          IF   EDGEN*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at 0, and
                                 ; every word cell holds 0000h, the address an undefined word is caught at
                                 ; (see e_hi).
                              LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
041E                          ENDIF      
041E                          IF   EDGEN   
                              JR   edit0   
041E                          ENDIF      
041E                          IF   EDITOR   
                                 ; Right arrow: one to the right, by printing the character there
                    RIGHT:    LD   A,L   
                              CP   E   
                              JR   Z,ed1   ; at the end
                              LD   A,(HL)   
                              INC   L   
                              JR   lf1   
                                 ; Esc: alone it drops the line. An arrow key sends Esc [ and a letter, so
                                 ; wait about 5 ms for a second key: after a "[" read on to the letter that
                                 ; ends the sequence, and act on C (right) and D (left).
                    ESC:      LD   BC,5*MSLOOP   
                    ES1:      CALL   rawk   
                              JR   NZ,es2   
                              DEC   BC   
                              LD   A,B   
                              OR   C   
                              JR   NZ,es1   
                              CALL   fin   ; no second key: the line is dropped
                              JR   edit   
                    ES2:      CP   "["   
                              JR   NZ,ed1   ; not a sequence known here
                    ES3:      CALL   ekey   
                              CP   40h   
                              JR   C,es3   ; (its parameters)
                              SUB   "C"   
                              JR   Z,right   
                              DEC   A   ; "D"?
                              JR   NZ,ed1   ; no: on into left
                                 ; Left arrow: the cursor goes one to the left
                    LEFT:     LD   A,L   
                              ADD   A,A   
                              JR   Z,ed1   ; (L = 80h: at the start)
                              DEC   L   
                              LD   A,8   
                              ;*Macro unroll: lf1:    PUTA
                    LF1:      DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              JR   ed1   
                                 ; edit0: reset, an error or a break: both stacks are cleared, and the cursor
                                 ;   is shown, in case the program had hidden it and could not show it again.
                                 ; skend: a program that ended inside skip: its return address goes.
                                 ; edend: a program that ended: TOS joins the rest of the data stack.
                    EDIT0:    LD   SP,DSTOP-2   ; empty (the cell that stands for TOS is pushed)
041E                          ENDIF      
041E                          IF   EDITOR*ANS   
                              XOR   A   ; (pshow wants the carry clear)
                              CALL   pshow   ; ESC [ ? 2 5 h
041E                          ENDIF      
041E                          IF   EDITOR*(1-ANS)   
                              LD   A,1   
                              CALL   CONCUR   ; show the cursor
041E                          ENDIF      
041E                          IF   EDITOR   
                              DB   21h   ; (LD HL,nn: steps over the next two bytes)
                    SKEND:    POP   DE   
                    EDEND:    PUSH   HL   
                                 ; edit: start a new input line.
                    EDIT:     LD   IY,RSTOP   ; the return stack is empty
                              ;*Macro unroll:  SETIX                   ; (a file read or written may have changed IX)
                              DS   CPM+FAST-CPM*FAST,0DDh   ; (a file read or written may have changed IX)
                              DS   CPM+FAST-CPM*FAST,21h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
                              LD   HL,0   
                              LD   (KEYBUF),HL   ; no key is held, and the break key is on
                              LD   (EDLN),HL   ; no line is being edited
                              LD   HL,LINEBUF   ; HL = the cursor,
                              LD   E,L   ;   E = the end of the line (its low byte)
                    ED1:      CALL   ekey   
                              CP   7Fh   
                              JR   Z,bsp   ; DEL
                              CP   " "   
                              JR   NC,insc   
                              CP   9   
                              JR   Z,insc   ; Tab is text
                              CP   8   
                              JR   Z,bsp   
                              CP   1Bh   
                              JR   Z,esc   
                              PUSH   HL   ; a command key? Look it up
                              LD   HL,cmds   
                              LD   B,NCMD   
                    ED2:      CP   (HL)   
                              INC   HL   
                              JR   Z,ed3   
                              INC   HL   
                              INC   HL   
                              DJNZ   ed2   
                              POP   HL   
                              JR   ed1   ; no: the key is ignored
                    ED3:      LD   A,(HL)   
                              INC   HL   
                              LD   H,(HL)   
                              LD   L,A   
                              EX   (SP),HL   ; the command's address: fin returns to it
                                 ; fin: end the input line: CR LF and a NUL after it, and a new line on the
                                 ; terminal. Leaves BC -> the line and HL -> the NUL.
                    FIN:      LD   H,LETPAGE   
                              LD   L,E   
                              LD   (HL),13   
                              INC   L   
                              LD   (HL),10   
                              DEC   L   
                              CALL   prl   ; (prints the CR LF)
                              LD   (HL),0   
                              LD   BC,LINEBUF   
                              RET      
                                 ; Backspace, DEL: the character before the cursor goes. The cursor moves
                                 ; left, the rest of the line moves down over it, and the last place (now a
                                 ; space) is printed over along with the rest.
                    BSP:      LD   A,L   
                              ADD   A,A   
                              JR   Z,ed1   ; at the start
                              DEC   L   
                              ;*Macro unroll:  PUTK    08h             ; backspace
                              DS   1-CPM,3Eh   ; backspace
                              DS   1-CPM,08h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,08h   
                              PUSH   HL   
                    BS1:      INC   L   
                              LD   A,(HL)   
                              DEC   L   
                              LD   (HL),A   
                              INC   L   
                              LD   A,L   
                              CP   E   
                              JR   NZ,bs1   
                              DEC   L   
                              LD   (HL)," "   
                              POP   HL   
                              LD   D,E   
                              DEC   E   
                              JR   ic2   
                                 ; A character goes in at the cursor: it ripples up through the rest of the
                                 ; line, the cursor moves on, and the rest is printed again.
                    INSC:     LD   B,A   
                              LD   A,E   
                              CP   0FDh   
                              JR   Z,ed1   ; the line is full: 125 characters
                              LD   A,B   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              PUSH   HL   
                    IC1:      LD   A,(HL)   
                              LD   (HL),B   
                              LD   B,A   
                              LD   A,L   
                              INC   L   
                              CP   E   
                              JR   NZ,ic1   
                              POP   HL   
                              INC   L   
                              INC   E   
                              LD   D,E   
                    IC2:      CALL   tail   
                              JR   ed1   
                                 ; tail: print the line from the cursor to D (a low byte), and bring the
                                 ; cursor back with backspaces. Nothing at all if the cursor is at D.
                    TAIL:     LD   C,L   
                    TA1:      LD   A,L   
                              CP   D   
                              JR   Z,ta2   
                              LD   A,(HL)   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              INC   L   
                              JR   ta1   
                    TA2:      LD   A,L   
                              CP   C   
                              RET   Z   
                              ;*Macro unroll:  PUTK    08h             ; backspace
                              DS   1-CPM,3Eh   ; backspace
                              DS   1-CPM,08h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,08h   
                              DEC   L   
                              JR   ta2   
                                 ; ekey: wait for a key
                    EKEY:     CALL   rawk   
                              JR   Z,ekey   
                              RET      
                                 ; The command keys, and where each goes (after fin).
                    CMDS:     DB   13   
                              DW   cret   
                              DB   7   ; ^G
                              DW   crun   
                              DB   12   ; ^L
                              DW   clist   
                              DB   5   ; ^E
                              DW   cedln   
                              DB   18   ; ^R
                              DW   cread   
                              DB   23   ; ^W
                              DW   cwrite   
                              DB   14   ; ^N
                              DW   cnew   
                              DB   24   ; ^X
                              DW   LEAVE   
                    NCMD:     EQU   8   
                                 ; ^N: no program
                    CNEW:     XOR   A   
                              LD   (PROG),A   
                    GED0:     JR   gedit   
                                 ; ^E: line n goes into the input line, to be changed. EDLN remembers which
                                 ; line it was: Return puts the text back in its place.
                    CEDLN:    CALL   rdnum   
                              PUSH   HL   
                              CALL   find   ; HL -> the line, or the NUL if there is none
                              POP   DE   
                              LD   A,(HL)   
                              OR   A   
                              JR   Z,ged0   
                              LD   (EDLN),DE   
                              LD   DE,LINEBUF   
                    CE1:      LD   A,(HL)   ; copy it, and show it, up to its CR (or LF)
                              CP   13   
                              JR   Z,ce2   
                              CP   10   
                              JR   Z,ce2   
                              LD   (DE),A   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              INC   HL   
                              INC   E   
                              LD   A,E   
                              CP   0FDh   ; (a longer line is cut at 125 characters)
                              JR   NZ,ce1   
                    CE2:      EX   DE,HL   ; the cursor is at the line's end
                              LD   E,L   
                              JP   ed1   
                                 ; Return. If ^E put a line here, the text goes back in its place. If not:
                                 ; a number and text is a line to put in, a number alone a line to take out,
                                 ; and anything else is run where it is.
                    CRET:     PUSH   HL   ; the end of what was typed
                              LD   HL,(EDLN)   
                              LD   A,H   
                              OR   L   
                              JR   Z,cr1   
                              PUSH   HL   
                              CALL   delln   
                              POP   HL   
                              JR   ins   
                    CR1:      CALL   rdnum   ; HL = the number it starts with, BC -> after
                              LD   A,C   ; C is still 80h if there was no number:
                              ADD   A,A   ;   only then is twice it 0
                              JR   Z,st0p   ; no number: run the line
                              LD   A,(BC)   
                              CP   13   
                              JR   NZ,cr2   
                              POP   DE   ; the number alone: take that line out
                              CALL   delln   
                              JR   gedit   
                    CR2:      INC   BC   ; step over the one character after the number
                                 ; Put the text at BC in as line n (in HL): open a gap of its length there,
                                 ; CR and LF included, and copy it in.
                    INS:      CALL   find   ; HL -> where it goes
                              POP   DE   ; the end of what was typed
                              LD   A,E   
                              SUB   C   ; A = the length of the text, with its CR LF
                              PUSH   BC   ; the text
                              LD   C,A   
                              LD   B,0   
                              PUSH   BC   ; its length
                              LD   D,H   
                              LD   E,L   ; DE = where it goes
                              XOR   A   
                              LD   C,A   ; BC = 0: CPIR looks as far as it needs to
                              CPIR      ; HL -> one past the program's NUL
                              SBC   HL,DE   ; the number of bytes to move up, NUL included
                              LD   B,H   
                              LD   C,L   
                              ADD   HL,DE   
                              DEC   HL   ; HL -> the NUL
                              EX   DE,HL   
                              EX   (SP),HL   ; HL = the length; where it goes is kept
                              PUSH   HL   
                              ADD   HL,DE   ; the NUL's new place
                              EX   DE,HL   
                              LDDR      ; move the rest of the program up
                              POP   BC   ; the length
                              POP   DE   ; where it goes
                              POP   HL   ; the text
                              LDIR      
                    GEDIT:    JP   edit   
                                 ; ^G: run the program. st0p: run the typed line (BC -> it).
                    CRUN:     LD   BC,PROG   
                              DB   3Eh   ; (LD A,n: steps over the POP)
                    ST0P:     POP   HL   ; (the end of what was typed)
                                 ; st0: start running at BC. The heap starts after the stored program's NUL.
                    ST0:      LD   HL,PROG   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
                              LD   (HEAP),HL   
041E                          ENDIF      
041E                          IF   EDITOR*QK   
                              CALL   skclr   ; every run starts with an empty skip cache
041E                          ENDIF      
041E                          IF   EDITOR*CHECKED   
                              ;*Macro unroll:  NEGH                    ; minus the heap's first address: '_' may not
                              DS   1-CPM,0E7h   ; minus the heap"s first address: "_' may not
                              DS   CPM,0CDh   
                              DS   CPM,ANEG&0FFh   
                              DS   CPM,ANEG/256   
                              LD   (NPEND),HL   ;   release below it
041E                          ENDIF      
041E                          IF   EDITOR   
                              POP   HL   ; TOS: the data stack is as the last line left it
                              ;*Macro unroll:  NEXT                    ; (its return address is thrown away)
                              DS   (1-CPM)*(1-FAST),0F7h   ; (its return address is thrown away)
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
                                 ; ^L: list from line n. DE = the number of the line at HL.
                    CLIST:    CALL   rdnum   ; HL = n, or 0 if there was none:
                              LD   A,H   
                              OR   L   
                              JR   NZ,li0   
                              INC   L   ;   then from line 1
                    LI0:      PUSH   HL   
                              CALL   find   
                              POP   DE   
                    LI1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,gedit   ; the end of the text
                              CALL   rawk   
                              JR   Z,li3   ; no key: carry on
                              CP   3   
                              CALL   NZ,ekey   ; any key but Ctrl-C: wait for one more
                              CP   3   
                              JR   Z,gedit   ; Ctrl-C, first or second, ends the list
                    LI3:      PUSH   HL   
                              PUSH   DE   
                              EX   DE,HL   
                              CALL   pdec   ; the line's number,
                              LD   A," "   
                              ;*Macro unroll:  PUTA                    ;   a space,
                              DS   1-CPM,0EFh   ;   a space,
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              POP   DE   
                              POP   HL   
                              INC   DE   
                              CALL   prl   ;   and the line
                              JR   li1   
                                 ; delln: take line n (in HL) out: copy everything after it down over it.
                    DELLN:    CALL   find   
                              LD   D,H   
                              LD   E,L   
                              CALL   nxl   ; HL -> the next line
                    DE1:      LD   A,(HL)   
                              LD   (DE),A   
                              INC   HL   
                              INC   DE   
                              OR   A   
                              JR   NZ,de1   
                              RET      
                                 ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
                                 ; of the text if there are fewer lines (or the number is 0). Keeps BC.
                    FIND:     EX   DE,HL   
                              LD   HL,PROG   
                    FI1:      DEC   DE   
                              LD   A,D   
                              OR   E   
                              RET   Z   
                              CALL   nxl   
                              JR   NZ,fi1   
                              RET      
                                 ; nxl: step HL over one line, to just past its LF (and return not-zero), or
                                 ; stop at the NUL that ends the text (and return zero).
                    NXL:      LD   A,(HL)   
                              OR   A   
                              RET   Z   
                              INC   HL   
                              CP   10   
                              JR   NZ,nxl   
                              OR   A   
                              RET      
                                 ; prl: print the line at HL, to its LF; HL -> just past it.
                    PRL:      LD   A,(HL)   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              LD   A,(HL)   
                              INC   HL   
                              CP   10   
                              JR   NZ,prl   
                              RET      
041E                          ENDIF      
041E                          IF   EDGEN   
                    GED1:     JP   edit   
                                 ; ^R, generic: what comes in from now until ^Z is the program. A CR is
                                 ; stored as CR LF; a LF right after a line end is dropped (it is the CR's
                                 ; own, or an empty line's), and a LF anywhere else ends a line too. A last
                                 ; line with no end is given one. Nothing is echoed, and there is no check
                                 ; for running out of memory.
                    CREAD:    LD   HL,PROG-1   
                              LD   (HL),10   ; (as if a line had just ended: the byte is
                              INC   HL   ;   the line buffer's last, and spare)
                    RD1:      CALL   ekey   
                              LD   C,A   
                              CP   1Ah   
                              JR   NZ,rd2   
                              LD   A,10   ; ^Z ends the last line, as a LF would
                    RD2:      CP   10   
                              JR   NZ,rd3   
                              DEC   HL   
                              CP   (HL)   
                              INC   HL   
                              JR   Z,rd4   ; straight after a line end: dropped
                              LD   A,13   ; anywhere else it ends the line
                    RD3:      LD   (HL),A   
                              INC   HL   
                              CP   13   
                              JR   NZ,rd4   
                              LD   (HL),10   ; after a CR goes a LF
                              INC   HL   
                    RD4:      LD   A,C   
                              CP   1Ah   
                              JR   NZ,rd1   
                              LD   (HL),0   
                              JR   ged1   
                                 ; ^W, generic: the text is printed as it is, for the terminal to capture.
                    CWRITE:   LD   HL,PROG   
                    CW1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,ged1   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              INC   HL   
                              JR   cw1   
041E                          ENDIF      
041E                          IF   EDITOR*CPM   
                    CFCB:     EQU   005Ch   ; the file's name is kept here, where the CCP
                                 ;   put the one from the command line
                                 ; ^W, CP/M: write the file: delete the old one, make it anew, write the
                                 ; text in records of 128 bytes, and close it. The text's NUL and the 127
                                 ; bytes after it are set to ^Z meanwhile, which pads the last record. (A
                                 ; full disk or directory is not noticed: the calls fail and that is all.)
                    CWRITE:   CALL   setname   
                              LD   C,19   ; delete
                              CALL   fbdos   
                              LD   C,22   ; make
                              CALL   fbdos   
                              LD   HL,PROG   
                              XOR   A   
                    CW1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,cw1   
                              DEC   HL   ; HL -> the NUL
                              PUSH   HL   
                              LD   B,128   
                    CW2:      LD   (HL),1Ah   
                              INC   HL   
                              DJNZ   cw2   
                              POP   HL   
                              LD   DE,PROG   
                    CW3:      LD   A,E   ; a record that starts before the end is written
                              SUB   L   
                              LD   A,D   
                              SBC   A,H   
                              JR   NC,cw4   
                              PUSH   HL   
                              LD   C,21   ; write, from where the record lies
                              CALL   frec   
                              POP   HL   
                              JR   cw3   
                    CW4:      LD   (HL),0   ; the NUL again
                              LD   C,16   ; close
                              CALL   fbdos   
                              JP   edit   
                                 ; frec: BDOS function C (read or write a record) with the 128 bytes at DE.
                                 ; Returns A = the BDOS's answer, HL = DE and DE = DE + 128.
                    FREC:     PUSH   DE   
                              PUSH   BC   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              POP   BC   
                              CALL   fbdos   
                              POP   DE   
                              LD   HL,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              RET      
                                 ; setname: if a name was typed (the line does not start with its CR), put it
                                 ; in the FCB: up to 8 characters, a dot, up to 3 more, in capitals. The drive
                                 ; is the current one. Then, name or no name, clear the FCB after the name,
                                 ; as it must be before a file is opened or made.
                    SETNAME:   LD   DE,LINEBUF   
                              LD   A,(DE)   
                              CP   13   
                              JR   Z,fcbclr   
                              LD   HL,CFCB   
                              LD   (HL),0   ; the current drive
                              LD   B,11   
                    SN1:      INC   L   
                              LD   (HL)," "   
                              DJNZ   sn1   
                              LD   L,CFCB+1   
                    SN2:      LD   A,(DE)   
                              INC   DE   
                              CP   13   
                              JR   Z,fcbclr   
                              CP   "."   
                              JR   NZ,sn3   
                              LD   L,CFCB+9   ; the type
                              JR   sn2   
                    SN3:      CP   "a"   
                              JR   C,sn4   
                              AND   5Fh   ; a capital
                    SN4:      LD   (HL),A   
                              INC   L   
                              JR   sn2   
                    FCBCLR:   LD   HL,CFCB+12   
                              LD   B,24   
                    FC1:      LD   (HL),0   
                              INC   HL   
                              DJNZ   fc1   
                              RET      
                                 ; fbdos: BDOS function C on the file
                    FBDOS:    LD   DE,CFCB   
                              JP   BDOS   
                                 ; ^R, CP/M: read the file. A name typed before the key is the file's name
                                 ; from now on. (On into load, which returns to edit.)
                    CREAD:    CALL   setname   
                              LD   HL,edit   
                              PUSH   HL   
                                 ; load: read the file into PROG. No such file: no program. The text ends at
                                 ; the file"s first ^Z (1Ah), which pads a text file"s last record; one more
                                 ; goes after the last record, so the search always stops. And every line
                                 ; must end in LF: a last line without one is given a CR LF. (The FCB is
                                 ; clear after its name: the CCP left it so, or setname did.)
                    LOAD:     LD   C,15   ; open (no such file: the first read fails
                              CALL   fbdos   ;   too)
                              LD   DE,PROG   
                    LD1:      LD   C,20   ; read the next 128 bytes
                              CALL   frec   
                              OR   A   
                              JR   Z,ld1   
                              LD   (HL),1Ah   ; (HL = where the record that failed would be)
                              LD   HL,PROG-1   
                              LD   A,10   ; (a file with no text needs nothing added)
                    TR1:      INC   HL   
                              LD   E,A   ; E = the character before this one
                              LD   A,(HL)   
                              CP   1Ah   
                              JR   NZ,tr1   
                              LD   A,E   
                              CP   10   
                              JR   Z,tr2   
                              LD   (HL),13   
                              INC   HL   
                              LD   (HL),10   
                              INC   HL   
                    TR2:      LD   (HL),0   
                              RET      
041E                          ENDIF      
041E                             ; =============================================================================
041E                          IF   CPM   
                                 ; The RAM pages follow the image; the heap may grow to the BDOS.
                    START:       
041E                          ENDIF      
041E                          IF   CPM*CHECKED*(1-EDITOR)   
                                 ; Clear the lower half of the letter page (as the editor build does
                                 ; at its start).
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
041E                          ENDIF      
041E                          IF   CPM*(1-EDITOR)   
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:      LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
041E                          ENDIF      
041E                          IF   CPM*(1-EDITOR)*QK   
                              CALL   skclr   ; an empty skip cache
041E                          ENDIF      
041E                          IF   CPM*(1-EDITOR)   
                              JP   st2   
041E                          ENDIF      
041E                          IF   FAST   
                                 ; =============================================================================
                                 ;  The fast build (SPEED = 2)
                                 ; 
                                 ;  The inner loop is a table: 256 entries, the low bytes of the handlers'
                                 ;  addresses in one page and the high bytes in the next. The dispatcher (at
                                 ;  next0, and inline, as NEXTF, at the end of the fast build's own entries,
                                 ;  so there is no jump back to it; the ordinary handlers end in JP (IX), with
                                 ;  IX = next0, as in the CP/M builds):
                                 ; 
                                 ;      LD A,(BC) / INC BC / EX DE,HL / LD L,A / LD H,DTAB/256 /
                                 ;      LD A,(HL) / INC H / LD H,(HL) / LD L,A / JP (HL)
                                 ; 
                                 ;  So every entry starts with TOS in DE, not HL. The punctuation entries are
                                 ;  thunks into the ordinary handlers (EX DE,HL / JP handler); the letters and
                                 ;  digits have one entry each, which knows its cell or its value already.
                                 ; =============================================================================
                    FTSTORE:   EX   DE,HL   ; !
                              JP   h_store   
                    FTSTR:    EX   DE,HL   ; "
                              JP   h_str   
                    FTNUM:    EX   DE,HL   ; #
                              JP   h_num   
                    FTPRINT:   EX   DE,HL   ; $
                              JP   h_print   
                    FTSWAP:   EX   DE,HL   ; %
                              JP   h_swap   
                    FTAND:    EX   DE,HL   ; &
                              JP   h_and   
                    FTEMIT:   EX   DE,HL   ; '
                              JP   h_emit   
                    FTOPEN:   EX   DE,HL   ; (
                              JP   h_open   
                    FTCLOSE:   EX   DE,HL   ; )
                              JP   h_close   
                    FTMUL:    EX   DE,HL   ; *
                              JP   h_mul   
                    FTADD:    EX   DE,HL   ; +
                              JP   h_add   
                    FTCFETCH:   EX   DE,HL   ; ,
                              JP   h_cfetch   
                    FTSUB:    EX   DE,HL   ; -
                              JP   h_sub   
                    FTCSTORE:   EX   DE,HL   ; .
                              JP   h_cstore   
                    FTDIV:    EX   DE,HL   ; /
                              JP   h_div   
                    FTDUP:    EX   DE,HL   ; :
                              JP   h_dup   
                    FTDROP:   EX   DE,HL   ; ;
                              JP   h_drop   
                    FTLT:     EX   DE,HL   ; <
                              JP   h_lt   
                    FTEQ:     EX   DE,HL   ; =
                              JP   h_eq   
                    FTGT:     EX   DE,HL   ; >
                              JP   h_gt   
                    FTKEY:    EX   DE,HL   ; ?
                              JP   h_key   
                    FTFETCH:   EX   DE,HL   ; @
                              JP   h_fetch   
                    FTDEF:    EX   DE,HL   ; [
                              JP   h_def   
                    FTBREAK:   EX   DE,HL   ; \
                              JP   h_break   
                    FTRET:    EX   DE,HL   ; ]
                              JP   h_ret   
                    FTXOR:    EX   DE,HL   ; ^
                              JP   h_xor   
                    FTALLOC:   EX   DE,HL   ; _
                              JP   h_alloc   
                    FTGRAVE:   EX   DE,HL   ; `
                              JP   h_grave   
                    FTTOR:    EX   DE,HL   ; {
                              JP   h_tor   
                    FTOR:     EX   DE,HL   ; |
                              JP   h_or   
                    FTFROMR:   EX   DE,HL   ; }
                              JP   h_fromr   
                    FTNOT:    EX   DE,HL   ; ~
                              JP   h_not   
                                 ; The commonest punctuation, written for the fast build: TOS in DE on the
                                 ; way in, and the dispatcher inline on the way out.
                    FS_ADD:      ; +
                              POP   HL   
                              ADD   HL,DE   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_SUB:      ; -
                              LD   A,(BC)   ; a digit next: a negative number
                              SUB   "0"   
                              CP   10   
                              JR   C,fs_neg   
                              POP   HL   
                              OR   A   
                              SBC   HL,DE   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_NEG:   EX   DE,HL   
                              JP   h_sub   
                    FS_DUP:      ; :
                              PUSH   DE   
                              EX   DE,HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_DROP:      ; ;
                              POP   HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_SWAP:      ; %
                              POP   HL   
                              PUSH   DE   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_FET:      ; @
                              EX   DE,HL   
                              LD   E,(HL)   
                              INC   HL   
                              LD   D,(HL)   
                              EX   DE,HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_CFET:      ; ,
                              LD   A,(DE)   
                              LD   L,A   
                              LD   H,0   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_LT:       ; <
                              POP   HL   ; a < b: HL = a, DE = b
                    FS_LT1:   LD   A,H   
                              XOR   80h   
                              LD   H,A   
                              LD   A,D   
                              XOR   80h   
                              LD   D,A   
                              SBC   HL,DE   ; carry if HL < DE
                              SBC   HL,HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_GT:       ; >
                              POP   HL   ; a > b  is  b < a
                              EX   DE,HL   
                              JP   fs_lt1   
                    FS_EQ:       ; =
                              POP   HL   
                              OR   A   
                              SBC   HL,DE   
                              LD   A,H   
                              OR   L   
                              CP   1   ; carry only if a - b = 0
                              SBC   HL,HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_AND:      ; &
                              POP   HL   
                              LD   A,H   
                              AND   D   
                              LD   H,A   
                              LD   A,L   
                              AND   E   
                              LD   L,A   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_OR:       ; |
                              POP   HL   
                              LD   A,H   
                              OR   D   
                              LD   H,A   
                              LD   A,L   
                              OR   E   
                              LD   L,A   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
