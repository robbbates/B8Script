  1014 000004DC 53                  <1>         push    ebx
  1015 000004DD FF755A              <1>         push    dword [V(v_hin)]
  1016 000004E0 FF55B2              <1>         call    [V(iat_WaitForSingleObject)]
  1017 000004E3 85C0                <1>         test    eax,eax
  1018 000004E5 7559                <1>         jnz     .wk8                    ; WAIT_TIMEOUT: no key
  1019 000004E7 8D4556              <1>         lea     eax,[V(v_cnt)]
  1020 000004EA 50                  <1>         push    eax
  1021 000004EB 6A01                <1>         push    1
