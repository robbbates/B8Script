E94D                          ENDIF      
E94D                             ; pesc: the escapes of "$". A = the character after the "/", 60h to 7Eh, and
E94D                             ; the carry is clear. Each returns into the loop.
E94D                             ;    /a-/z   print the variable, as "#" does
E94D                             ;    /{      clear the screen, the cursor to the top left
E94D                             ;    /}      clear from the cursor to the end of the line
E94D                             ;    /|  /`  show the cursor, hide it
E94D                             ;    /~      ( row col addr -- addr ): the cursor to that row and column,
E94D                             ;            from 0. The two cells under the string's address go.
E94D                             ; A - 7Bh sorts them: 00bbIDAsIHwgMSwg 2, ~ 3 with the carry set, and ` E5h, a-z
E94D                             ; E6h-FFh with it clear.
E94D                          IF   1-ANSI   
E94D                             ; With ANSI = 0 the machine's routines do the work.
E94D   E9 7A        PESC:     SBC   #7Ah   ; (the carry is clear: - 7Bh)
E94F   90 0D                  BCC   pe1   
E951   F0 08                  BEQ   pcls   ; {
E953   4A                     LSR      ; | 0, } 1, ~ 1; the carry set for | and ~
E954   F0 0C                  BEQ   pcur   ; |  show: the carry is set
E956   B0 18                  BCS   pat   ; ~
E958   4C 0F FF               JMP   CONEOL   ; }
E95B   4C 0C FF     PCLS:     JMP   CONCLS   
E95E   C9 E6        PE1:      CMP   #0E6h   
E960   B0 03                  BCS   pvar   
E962   4C 12 FF     PCUR:     JMP   CONCUR   ; `  hide: the carry is clear
E965                          ENDIF      
E965                             ; a-z: the carry is set. A + 3Ah is the letter - 41h, as step hands it to
E965                             ; lower: that pushes the variable"s address, "@" fetches it, and "#' prints
E965                             ; it and drops it: TOS is the string's address again.
E965   69 39        PVAR:     ADC   #39h   
E967   20 08 EA               JSR   lowp   
E96A   20 37 E4               JSR   h_fetch   
E96D   4C 79 E2               JMP   h_num   
E970                          IF   ANSI   
                                 ; With ANSI = 1 they are sequences, each a message at MSG, printed by prs,
                                 ; which pesc runs on into.
                    PESC:     LDY   #M_CLS-MSG   
                              SBC   #7Ah   ; (the carry is clear: - 7Bh)
                              BCC   pe1   
                              BEQ   prs   ; {  ESC [ H ESC [ J
                              LDY   #M_SHOW-MSG   
                              LSR      ; | 0, } 1, ~ 1; the carry set for ~
                              BEQ   prs   ; |  ESC [ ? 2 5 h
                              BCS   pat   ; ~
                              LDY   #M_EOL-MSG   ; }  ESC [ K
                              BNE   prs   ; always
                    PE1:      CMP   #0E6h   
                              BCS   pvar   
                              LDY   #M_HIDE-MSG   ; `  ESC [ ? 2 5 l, and on into prs
E970                          ENDIF      
E970                          IF   CHECKED+ANSI   
                                 ; prs: print the message at MSG+Y; its last byte has bit 7 set. Y ends just
                                 ; past it, at the next message.
                    PRS:      LDA   MSG,Y   
                              PHA      
                              AND   #7Fh   
                              JSR   CONOUT   
                              INY      
                              PLA      
                              BPL   prs   
                              RTS      
E970                          ENDIF      
E970                             ; /~: the row is at 4,X, the column at 2,X, the string's address at 0,X.
E970                PAT:         
E970                          IF   CHECKED   
                              CPX   #DSE-5   ; fewer than two cells under TOS: s
                              BCS   e_sund   
E970                          ENDIF      
E970                          IF   1-ANSI   
E970   B5 04                  LDA   4,X   ; the row
E972   B4 02                  LDY   2,X   ; the column
E974   20 15 FF               JSR   CONAT   
E977   20 7A E9               JSR   nip   ; two nips leave the address, 4 bytes up
E97A   20 B1 E2     NIP:      JSR   h_swap   ; nip: ( a b -- b )
E97D   4C 0B E3               JMP   drop   
E980                          ENDIF      
E980                          IF   ANSI   
                                 ; ESC [ row+1 ; col+1 H (ANSI counts from 1). Three swaps put the row on top
                                 ; and the address under the column: "#" prints the row and drops it, prints
                                 ; the column and drops it, and TOS is the string's address again.
                              JSR   h_swap   
                              INX      
                              INX      
                              JSR   h_swap   
                              DEX      
                              DEX      
                              JSR   h_swap   
                              LDY   #M_CSI-MSG   
                              JSR   prs   ; ESC [
                              JSR   inctos   
                              JSR   h_num   ; the row + 1
                              LDA   #";"   
                              JSR   CONOUT   
                              JSR   inctos   
                              JSR   h_num   ; the column + 1
                              LDA   #"H"   
                              JMP   CONOUT   
E980                          ENDIF      
E980                          IF   CHECKED   
                                 ; The checked build's inner loop, out of page 1, where it would not fit,
                                 ; and its break check (described with the unchecked one in page 1).
                                 ; pnext: the break check, then (falling through) next. A word call, a true
                                 ; "(" and a true ")" end here, but the keyboard is looked at only once in 256
                                 ; of them: CDOWN counts them down. A key found is held; a Ctrl-C goes on to ctlc. (Startup
                                 ; falls in here too, which does no harm.)
                    PNEXT:    DEC   CDOWN   
                              BNE   next   
                    PKEY:     JSR   KEY   
                              BEQ   next   ; no key
                              STA   KEYBUF   ; held for the next "?"
                              JSR   chk3   ; (Ctrl-C: back only if the break key is off)
                    NEXT:        
E980                          ENDIF      
E980                          IF   CHECKED*FAST   
                              JMP   fnext   ; (the fast build: see "The fast build")
E980                          ENDIF      
E980                          IF   CHECKED*(1-FAST)   
                                 ; Both stacks are checked once per character, after it has run. The
                                 ; return stack has overrun when S is below RSLIM: an overflow leaves
                                 ; it at 1Eh or 1Fh, an underflow wraps it to 01h (no handler pulls
                                 ; more than one entry). The data stack has when X is above DSE (an
                                 ; underflow) or below DSFULL (an overflow). No handler moves X by
                                 ; more than 4 (but "$", whose /~ escapes each look first), so X is
                                 ; caught before it wraps; an overrun by a cell or two writes on the
                                 ; scratch bytes below or above the stack.
                                 ; S is kept in RSV, for the report's R: line (an error found inside
                                 ; a handler has its own calls on the hardware stack), and the place
                                 ; of the character about to run in PLACE.
                              TXA      ; TSX trashes X: keep it in A
                              TSX      
                              STX   RSV   
                              CPX   #RSLIM   
                              TAX      ; TAX leaves the carry alone
                              BCC   e_rstack   
                              CPX   #DSE+1   
                              BCS   e_sund   
                              CPX   #DSFULL   
                              BCC   e_sovr   
                              LDA   IP   
                              STA   PLACE   
                              LDA   IP+1   
                              STA   PLACE+1   
                              JSR   step   
                              JMP   next   
E980                          ENDIF      
E980                          IF   CHECKED   
                                 ; S/R are overflows, s/r underflows. After an underflow that stack counts as
                                 ; empty.
                    E_RSTACK:   LDA   RSV   
                              CMP   #10h   
                              LDA   #"R"   
                              BCS   ejmp   ; S is 1Eh-1Fh: an overflow
                              LDA   #0FFh   
                              STA   RSV   ; S wrapped to 01h: R:0
                              LDA   #"r"   
                              BNE   ejmp   ; always
                    E_SUND:   LDX   #DSE   ; D:0
                              LDA   #"s"   
                              DB   2Ch   ; (BIT abs: hides the next instruction)
                    E_SOVR:   LDA   #"S"   
                    EJMP:     JMP   error   
                                 ; skip, checked: as the unchecked one above, and A holds, on the way in, the wrong closer for the
                                 ; opener that started the skip, kept in T0: ] for (, ) for [, and 0 for \,
                                 ; which takes either. Meeting the wrong closer at this level, or the end
                                 ; (a NUL, or a string that runs into it), stops with N, except for \,
                                 ; which then ends the program as before.
E980                          ENDIF      
E980                          IF   CHECKED*(1-QK)   
                    SKIP:     STA   T0   
                              LDA   #0   
                              STA   T2   ; depth
                    SK1:      JSR   getc   
                              BEQ   sknul   
                              CMP   #22h   
                              BNE   sk2   
                              JSR   skipstr   ; leaves A = 11h, which matches nothing below
                              BEQ   sknul   ; the string ran into the end
                    SK2:      CMP   #"("   
                              BEQ   sk3   
                              CMP   #"["   
                              BEQ   sk3   
                              CMP   #")"   
                              BEQ   sk4   
                              CMP   #"]"   
                              BNE   sk1   
                    SK4:      DEC   T2   
                              BPL   sk1   
                              CMP   T0   
                              BEQ   e_nest   ; the wrong kind
                              RTS      ; the closer at this level
                    SK3:      INC   T2   
                              BNE   sk1   
E980                          ENDIF      
E980                          IF   CHECKED   
                    SKNUL:    LDA   T0   
                              BNE   e_nest   ; ( and [ stop with N
                              JMP   EXIT   ; \ ends the program
                    E_NEST:   LDA   #"N"   ; a skip from ( or [ found the wrong closer
                              JMP   error   ;   or the end: the place is the opener
E980                          ENDIF      
E980                          IF   1-CHECKED   
E980                CBREAK:   EQU   endp   ; the unchecked build stops without a word
E980                          ENDIF      
E980                          IF   CHECKED   
                    CBREAK:   EQU   e_break   ; the checked build reports B
E980                          ENDIF      
E980                             ; getk: a key for "?" in A (zero flag clear), or A = 0 with the zero flag
E980                             ; set when there is none. Keeps X and Y. The held key goes first, and is
E980                             ; taken out of KEYBUF.
E980   AD 7A 04     GETK:     LDA   KEYBUF   
E983   F0 08                  BEQ   gk1   
E985   48                     PHA      
E986   A9 00                  LDA   #0   
E988   8D 7A 04               STA   KEYBUF   
E98B   68                     PLA      
E98C   60                     RTS      
E98D   20 06 FF     GK1:      JSR   KEY   
E990   F0 04                  BEQ   gk9   
E992                             ; chk3: a key in A (not 0). A Ctrl-C goes on to ctlc, which gives the 03h
E992                             ; back if it comes back at all.
E992   C9 03        CHK3:     CMP   #3   
E994   F0 01                  BEQ   ctlc   
E996   60           GK9:      RTS      
E997                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
E997                             ; the program has turned it off, wait about 250 ms (about 250 times MSLOOP
E997                             ; looks: T1 counts the 256s, T2 runs on from whatever it holds) for one more
E997                             ; key: a second Ctrl-C is the end too; any other key is held (the newest
E997                             ; wins). Returns A = 03h with the zero flag clear. Keeps X and Y.
E997   AD 7B 04     CTLC:     LDA   BRKOFF   
E99A   F0 5D                  BEQ   cbreak   
E99C   A9 28                  LDA   #CWAIT+1   
E99E   85 05                  STA   T1   
E9A0   20 06 FF     CT2:      JSR   KEY   
E9A3   D0 0A                  BNE   ct3   
E9A5   C6 06                  DEC   T2   
E9A7   D0 F7                  BNE   ct2   
E9A9   C6 05                  DEC   T1   
E9AB   D0 F3                  BNE   ct2   
E9AD   F0 07                  BEQ   ct9   ; always: none came
E9AF   C9 03        CT3:      CMP   #3   
E9B1   F0 46                  BEQ   cbreak   
E9B3   8D 7A 04               STA   KEYBUF   
E9B6   A9 03        CT9:      LDA   #3   
E9B8   60                     RTS      
E9B9                          IF   CHECKED   
                    E_BREAK:   LDA   #"B"   ; Ctrl-C (the stacks as they stand)
                              DB   2Ch   ; (BIT abs: hides the next instruction)
                    E_RESV:   LDA   #"X"   ; a reserved byte, 80h-FFh
                    EJMP2:    JMP   error   
                                 ; e_undef: the word cells of undefined words hold 0000h. A call there reads
                                 ; the byte at 0000h, which is IP's own low byte: 00h while IP is 0000h, so
                                 ; the call reads a NUL with IP in page zero, where no program can be. The
                                 ; call is undone first: the step frame and the return address come off the
                                 ; hardware stack, and the place is the call letter (the return address - 1).
                    E_UNDEF:   PLA      
                              PLA      ; the step frame
                              PLA      
                              SEC      
                              SBC   #1   
                              STA   PLACE   
                              PLA      
                              SBC   #0   
                              STA   PLACE+1   
                              INC   RSV   
                              INC   RSV   ; R: does not count the call
                              LDA   #"U"   
                              BNE   ejmp2   ; always
E9B9                          ENDIF      
E9B9                             ; step: read one character and sort it by range.
E9B9                             ;    00h          end of program
E9B9                             ;    01h-20h, 7Fh-FFh   ignored
E9B9                             ;    30h-39h      digit: read a whole number
E9B9                             ;    41h-5Ah      A-Z: call the word in that letter's cell
E9B9                             ;    61h-7Ah      a-z: push the address of that letter's cell
E9B9                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
E9B9   20 85 EA     STEP:     JSR   getc   ; flags follow A
E9BC   F0 3B                  BEQ   endp   
E9BE   38                     SEC      
E9BF   E9 21                  SBC   #21h   ; A = c - 21h
E9C1   90 35                  BCC   ign   ; 01h-20h
E9C3   C9 0F                  CMP   #0Fh   
E9C5   90 22                  BCC   punct   ; 21h-2Fh: index 0-14
E9C7   E9 0F                  SBC   #0Fh   ; (carry set) A = c - 30h
E9C9   C9 0A                  CMP   #10   
E9CB   90 6C                  BCC   digit   
E9CD   C9 11                  CMP   #11h   
E9CF   90 16                  BCC   p3a   ; 3Ah-40h
E9D1   E9 11                  SBC   #11h   ; (carry set) A = c - 41h
E9D3   C9 1A                  CMP   #1Ah   
E9D5   90 25                  BCC   upper   ; 41h-5Ah
E9D7   C9 20                  CMP   #20h   
E9D9   90 0A                  BCC   p5b   ; 5Bh-60h
E9DB   C9 3A                  CMP   #3Ah   
E9DD   90 29                  BCC   lower   ; 61h-7Ah: A = 20h-39h
E9DF   C9 3E                  CMP   #3Eh   
E9E1                          IF   1-CHECKED   
E9E1   B0 15                  BCS   ign   ; 7Fh-FFh
E9E3                          ENDIF      
E9E3                          IF   CHECKED   
                              BEQ   ign   ; 7Fh
                              BCS   e_resv   ; 80h-FFh: reserved
E9E3                          ENDIF      
E9E3                             ; The three adjustments below chain. Each ADC adds the carry the one
E9E3                             ; before it left, which the constants allow for.
E9E3   E9 1A                  SBC   #1Ah   ; 7Bh-7Eh: (carry clear: -1Bh) index 28-31
E9E5   69 F6        P5B:      ADC   #0F6h   ; 5Bh-60h: -10 (-9 when chained), index 22-27
E9E7   69 05        P3A:      ADC   #5   ; 3Ah-40h: +5 (+6 when chained), index 15-21
E9E9                             ; Punctuation: A = the index. The handler's page is the first, plus one if
E9E9                             ; the index is N1 or more, plus one more if it is N2 or more.
E9E9   C9 08        PUNCT:    CMP   #N1   
E9EB   A8                     TAY      
E9EC   A9 70                  LDA   #HALFPG   
E9EE   2A                     ROL      ; the first page, or the second (carry clear)
E9EF   C0 15                  CPY   #N2   
E9F1   69 00                  ADC   #0   ; ... or the third (and the carry is clear)
E9F3   48                     PHA      
E9F4   B9 19 EA               LDA   PTAB,Y   
E9F7   48                     PHA      
E9F8   60           IGN:      RTS      ; RTS trick: goes to the handler. Reached
E9F9                             ; directly, it just ends an ignored character.
E9F9                ENDP:        ; the program has ended
E9F9                          IF   CHECKED   
                              LDA   IP+1   ; IP in page zero: an undefined word
                              BEQ   e_undef   
E9F9                          ENDIF      
E9F9   4C 09 FF               JMP   EXIT   
E9FC                             ; A-Z: call the word. The return address (the IP after the letter) goes on
E9FC                             ; the return stack, and the IP becomes the address in the letter's cell.
E9FC   0A           UPPER:    ASL      
E9FD   A8                     TAY      
E9FE   38                     SEC      
E9FF   4C D2 E2               JMP   pushn   
EA02   A5 00        PUSHIP:   LDA   IP   ; push the reading position
EA04   A4 01                  LDY   IP+1   
EA06   D0 03                  BNE   pushay   ; always: no program is in page zero
EA08                             ; a-z: push the cell's address (the cell is the variable)
EA08                             ;  (the unchecked QK builds do x@ and x! in one step: lowq)
EA08                          IF   SBASEU   
                    LOWER:    JMP   lowq   
                    LOWP:        
EA08                          ENDIF      
EA08                          IF   1-SBASEU   
EA08                LOWER:       
EA08                LOWP:        
EA08                          ENDIF      
EA08   0A                     ASL      
EA09   A0 04                  LDY   #>LET   
EA0B                             ; pushay: push a cell: A = its low byte, Y = its high byte
EA0B   CA           PUSHAY:   DEX      
EA0C   CA                     DEX      
EA0D   95 00        SETAY:    STA   0,X   ; setay: TOS = A (low), Y (high)
EA0F   94 01                  STY   1,X   
EA11   60                     RTS      
EA12                             ; flag: pops TOS and returns with Z set if it was 0. Keeps the carry.
EA12   E8           FLAG:     INX      
EA13   E8                     INX      
EA14   B5 FE                  LDA   0FEh,X   
EA16   15 FF                  ORA   0FFh,X   
EA18   60                     RTS      
EA19                             ; =============================================================================
EA19                             ;  Dispatch table: the low byte of (handler - 1) for each punctuation
EA19                             ;  character, in code order.
EA19                             ; =============================================================================
EA19   A4           PTAB:     DB   (h_store-1) & 0FFh   ; !
EA1A   5C                     DB   (h_str-1) & 0FFh   ; "
EA1B   78                     DB   (h_num-1) & 0FFh   ; #
EA1C   3E                     DB   (h_print-1) & 0FFh   ; $
EA1D   B0                     DB   (h_swap-1) & 0FFh   ; %
EA1E   C1                     DB   (h_and-1) & 0FFh   ; &
EA1F   70                     DB   (h_emit-1) & 0FFh   ; '
EA20   CC                     DB   (h_open-1) & 0FFh   ; (
EA21   7B                     DB   (h_close-1) & 0FFh   ; )
EA22   4C                     DB   (h_mul-1) & 0FFh   ; *
EA23   16                     DB   (h_add-1) & 0FFh   ; +
EA24   72                     DB   (h_cfetch-1) & 0FFh   ; ,
EA25   0D                     DB   (h_sub-1) & 0FFh   ; -
EA26   04                     DB   (h_cstore-1) & 0FFh   ; .
EA27   4F                     DB   (h_div-1) & 0FFh   ; /
EA28   FD                     DB   (h_dup-1) & 0FFh   ; :
EA29   0A                     DB   (drop-1) & 0FFh   ; ;
EA2A   2B                     DB   (h_lt-1) & 0FFh   ; <
EA2B   3C                     DB   (h_eq-1) & 0FFh   ; =
EA2C   28                     DB   (h_gt-1) & 0FFh   ; >
EA2D   83                     DB   (h_key-1) & 0FFh   ; ?
EA2E   36                     DB   (h_fetch-1) & 0FFh   ; @
EA2F   4C                     DB   (h_def-1) & 0FFh   ; [
EA30   E0                     DB   (h_break-1) & 0FFh   ; \
EA31   F2                     DB   (h_ret-1) & 0FFh   ; ]
EA32   20                     DB   (h_xor-1) & 0FFh   ; ^
EA33   9C                     DB   (h_alloc-1) & 0FFh   ; _
EA34   6E                     DB   (h_grave-1) & 0FFh   ; `
EA35   04                     DB   (h_tor-1) & 0FFh   ; {
EA36   2B                     DB   (h_or-1) & 0FFh   ; |
EA37   10                     DB   (h_fromr-1) & 0FFh   ; }
EA38   1D                     DB   (h_not-1) & 0FFh   ; ~
EA39                             ; Digits: the first one is in A; read the rest of the number.
EA39   A0 00        DIGIT:    LDY   #0   
EA3B   20 0B EA               JSR   pushay   
EA3E                             ; rdnum: TOS = TOS*10 + digit for each digit at IP. Wraps at 16 bits.
EA3E                             ; Returns with the carry set.
EA3E   20 6B EA     RDNUM:    JSR   isdig   
EA41   B0 4D                  BCS   ic9   ; (an RTS)
EA43   20 88 EA               JSR   incip   ; (keeps A = the digit)
EA46   16 00                  ASL   0,X   
EA48   36 01                  ROL   1,X   ; x2
EA4A   18                     CLC      
EA4B   75 00                  ADC   0,X   
EA4D   85 04                  STA   T0   
EA4F   B5 01                  LDA   1,X   
EA51   69 00                  ADC   #0   
EA53   A8                     TAY      ; Y:T0 = x2 + digit
EA54   16 00                  ASL   0,X   
EA56   36 01                  ROL   1,X   
EA58   16 00                  ASL   0,X   
EA5A   36 01                  ROL   1,X   ; x8
EA5C   18                     CLC      
EA5D   B5 00                  LDA   0,X   
EA5F   65 04                  ADC   T0   
EA61   95 00                  STA   0,X   
EA63   98                     TYA      
EA64   75 01                  ADC   1,X   
EA66   95 01                  STA   1,X   ; x8 + x2 + digit
EA68   4C 3E EA               JMP   rdnum   
EA6B                             ; isdig: A = the character at IP minus "0"; the carry is clear if it is a
EA6B                             ; digit. Y = 0.
EA6B   20 91 EA     ISDIG:    JSR   peek   
EA6E   38                     SEC      
EA6F   E9 30                  SBC   #"0"   
EA71   C9 0A                  CMP   #10   
EA73   60                     RTS      
EA74                             ; rdhex: if IP is at a hex digit (0-9, A-F, a-f), return its value in A with
EA74                             ; the carry clear and IP moved on; otherwise the carry is set and IP stays.
EA74   20 6B EA     RDHEX:    JSR   isdig   
EA77   90 0F                  BCC   incip   
EA79   29 DF                  AND   #0DFh   
EA7B   E9 11                  SBC   #11h   ; (the carry is set)
EA7D   C9 06                  CMP   #6   
EA7F   B0 0F                  BCS   ic9   
EA81   69 0A                  ADC   #10   
EA83   D0 03                  BNE   incip   ; always
EA85                             ; Reading the program
EA85                             ;    peek: A = the character at IP, IP unchanged, Y = 0
EA85                             ;    getc: the same, then IP moves on; flags follow A
EA85                             ;    incip: IP moves on; keeps A, the carry and Y
EA85   20 91 EA     GETC:     JSR   peek   
EA88   E6 00        INCIP:    INC   IP   
EA8A   D0 02                  BNE   ic1   
EA8C   E6 01                  INC   IP+1   
EA8E   09 00        IC1:      ORA   #0   
EA90   60           IC9:      RTS      
EA91   A0 00        PEEK:     LDY   #0   
EA93   B1 00                  LDA   (IP),Y   
EA95   60                     RTS      
EA96                             ; rstip: point IP at the start of the program
EA96   A9 00        RSTIP:    LDA   #<PROG   
EA98   85 00                  STA   IP   
EA9A   A9 05                  LDA   #>PROG   
EA9C   85 01                  STA   IP+1   
EA9E   60                     RTS      
EA9F                          IF   CHECKED   
                                 ; =============================================================================
                                 ;  Checked build: the error report
                                 ; =============================================================================
                                 ; error: the report, then EXIT. A = the letter, PLACE = the place, X = the
                                 ; data stack to show, RSV = S for the R: line. Nothing here relies on S: an
                                 ; overflowed or underflowed hardware stack wraps inside its page, and only
                                 ; its depth is shown.
                                 ;   CR LF
                                 ;   Err X @ line,col CR LF
                                 ;   D:n: [...] and the top 8 cells at most, bottom to top  CR LF
                                 ;   R:n CR LF
                                 ; The numbers go through "#" (prnum), which pushes them over the data stack
                                 ; and pops them again, so the stack is shown as it was. With the stack full
                                 ; (X = 0Eh) that reaches down to 0Ah, so nothing the report keeps is there.
                    ERROR:    PHA      ; the letter
                              LDA   PLACE   
                              STA   P   
                              LDA   PLACE+1   
                              STA   P+1   ; (CO is the report's scratch from here on)
                              LDY   #M_ERR-MSG   
                              JSR   prs   ; CR LF "Err "
                              PLA      
                              JSR   CONOUT   
                              JSR   prs   ; " @ " (it follows M_ERR)
                              JSR   lcol   
                              LDA   LN   
                              LDY   LN+1   
                              JSR   prnum   ; the line
                              LDA   #","   
                              JSR   CONOUT   
                              LDA   CO   
                              LDY   CO+1   
                              JSR   prnum   ; the column
                              LDY   #M_STK-MSG   
                              JSR   prs   ; CR LF "D:"
                              TXA      
                              EOR   #0FFh   
                              SEC      
                              SBC   #0FFh-DSE   
                              LSR      ; the depth, (DSE - X) / 2
                              PHA      
                              JSR   prnum8   
                              PLA      
                              LDY   #M_C-MSG   ; ":"
                              CMP   #9   
                              BCC   er3   
                              LDA   #8   ; more than 8: ": ..." and the top 8
                              LDY   #M_CD-MSG   
                    ER3:      STA   CO   ; CO = how many cells to show
                              JSR   prs   
                    ER4:      LDA   CO   ; cells CO-1 down to 0, the top last: cell i
                              BEQ   er5   ;   from the top is at X+2i
                              DEC   CO   
                              LDA   #" "   
                              JSR   CONOUT   
                              LDA   CO   
                              ASL      
                              STA   CO+1   
                              TXA      
                              ADC   CO+1   ; (the carry is clear)
                              TAY      
                              LDA   0,Y   
                              PHA      
                              LDA   1,Y   
                              TAY      
                              PLA      
                              JSR   prnum   
                              JMP   er4   
                    ER5:      LDY   #M_RTN-MSG   
                              JSR   prs   ; CR LF "R:"
                              LDA   RSV   
                              EOR   #0FFh   
                              LSR      ; (FFh - S) / 2 entries
                              JSR   prnum8   
                              LDY   #M_NL-MSG   
                              JSR   prs   
                              JMP   EXIT   
                                 ; prnum: print the number A (low), Y (high), signed, keeping the data stack.
                                 ; prnum8: the same for A alone, 0-255.
                    PRNUM8:   LDY   #0   
                    PRNUM:    JSR   pushay   
                              JMP   h_num   
EA9F                          ENDIF      
EA9F                          IF   CHECKED+ANSI   
                    MSG:         
EA9F                          ENDIF      
EA9F                          IF   ANSI   
                    M_CLS:    DB   27,"[","H",27,"[","J"+80h   
                    M_SHOW:   DB   27,"[","?","2","5","h"+80h   
                    M_HIDE:   DB   27,"[","?","2","5","l"+80h   
                    M_EOL:    DB   27,"[","K"+80h   
                    M_CSI:    DB   27,"["+80h   
EA9F                          ENDIF      
EA9F                          IF   CHECKED   
                    M_ERR:    DB   13,10,"Err"," "+80h   
                              DB   " @"," "+80h   
                    M_NL:     DB   13,10+80h   
                    M_STK:    DB   13,10,"D",":"+80h   
                    M_CD:     DB   ": ..","."+80h   
                    M_C:      DB   ":"+80h   
                    M_RTN:    DB   13,10,"R",":"+80h   
EA9F                          ENDIF      
EA9F                          IF   CHECKED   
                                 ; lcol: the line (LN) and the column (CO) of the place at P, both from
                                 ; 1. A place below the program is in the -n? line buffer: line 0, and the
                                 ; column is the place in the buffer. Otherwise IP (free now: the program has
                                 ; stopped) runs from PROG to the place, counting LFs; CO keeps where the
                                 ; last line started, and the column is the place minus that, plus 1.
                    LCOL:     LDA   #0   
                              STA   LN+1   
                              STA   LN   
                              LDA   #<LINEBUF   
                              STA   CO   
                              LDA   #>LINEBUF   
                              STA   CO+1   
                              LDA   P   
                              CMP   #<PROG   
                              LDA   P+1   
                              SBC   #>PROG   
                              BCC   lc9   ; below the program: line 0
                              INC   LN   
                              JSR   rstip   
                    LC3:      LDA   IP   ; a line starts here
                              STA   CO   
                              LDA   IP+1   
                              STA   CO+1   
                    LC1:      LDA   IP   
                              CMP   P   
                              LDA   IP+1   
                              SBC   P+1   
                              BCS   lc9   ; at the place
                              JSR   getc   
                              CMP   #10   
                              BNE   lc1   
                              INC   LN   ; an LF: a new line starts after it
                              BNE   lc3   
                              INC   LN+1   
                              BNE   lc3   ; always
                    LC9:      LDA   P   
                              SEC      
                              SBC   CO   
                              STA   CO   
                              LDA   P+1   
                              SBC   CO+1   
                              STA   CO+1   
                              INC   CO   ; + 1
                              BNE   lc8   
                              INC   CO+1   
                    LC8:      RTS      
EA9F                          ENDIF      
EA9F                             ; =============================================================================
EA9F                             ;  The fast build (SPEED = 2)
EA9F                             ; 
EA9F                             ;  The inner loop is a table: 256 entries, the low bytes of the handlers'
EA9F                             ;  addresses in one page (DTL) and the high bytes in the next (DTH). The
EA9F                             ;  dispatcher, NEXTF, is inline at the end of the fast build's own entries,
EA9F                             ;  so there is no JSR and no RTS per character:
EA9F                             ;      LDY #0 / LDA (IP),Y / INC IP / BNE $+4 / INC IP+1 / TAY /
EA9F                             ;      LDA DTL,Y / STA V / LDA DTH,Y / STA V+1 / JMP (V)
EA9F                             ;  The letters and digits have one entry each, which knows its cell or its
EA9F                             ;  value already; the commonest punctuation is written for the table; the
EA9F                             ;  rest reach the ordinary handlers through a thunk (CLC / JSR handler /
EA9F                             ;  NEXTF, or JMP fnext for the rare ones), which gives them the step frame
EA9F                             ;  and the clear carry they expect.
EA9F                             ;  The ordinary handlers that end at next or pnext go to fnext, the same
EA9F                             ;  dispatcher. In the checked build NEXTF is JMP fnext, which checks the
EA9F                             ;  stacks first, as next does in the other builds.
EA9F                             ;  Everything here is read-only: the image can be ROM, as the others are.
EA9F                             ;  The table takes the image's first two pages (E000h-E1FFh); the code
EA9F                             ;  starts after it.
EA9F                             ; =============================================================================
EA9F                          IF   FAST   
EA9F                             ; fnext: the dispatcher, after the checks of the checked build
EA9F                FNEXT:       
EA9F                          ENDIF      
EA9F                          IF   FAST*CHECKED   
                                 ; (the same checks as next in the other checked builds)
                              TXA      ; TSX trashes X: keep it in A
                              TSX      
                              STX   RSV   
                              CPX   #RSLIM   
                              TAX      
                              BCS   fn1   
                              JMP   e_rstack   
                    FN1:      CPX   #DSE+1   
                              BCS   fn2   
                              CPX   #DSFULL   
                              BCS   fn3   
                              JMP   e_sovr   
                    FN2:      JMP   e_sund   
                    FN3:      LDA   IP   
                              STA   PLACE   
                              LDA   IP+1   
                              STA   PLACE+1   
EA9F                          ENDIF      
EA9F                          IF   FAST   
EA9F   A0 00                  LDY   #0   
EAA1   B1 00                  LDA   (IP),Y   
EAA3   E6 00                  INC   IP   
EAA5   D0 02                  BNE   fn4   
EAA7   E6 01                  INC   IP+1   
EAA9   A8           FN4:      TAY      
EAAA   B9 00 E0               LDA   DTL,Y   
EAAD   85 04                  STA   V   
EAAF   B9 00 E1               LDA   DTH,Y   
EAB2   85 05                  STA   V+1   
EAB4   6C 04 00               JMP   (V)   
EAB7                             ; fpoll: the break check of pnext, as a subroutine, for the entries that
EAB7                             ; look at the keyboard (a word call, a true ( and a true ))
EAB7   20 06 FF     FPOLL:    JSR   KEY   
EABA   F0 06                  BEQ   fp9   ; no key
EABC   8D 7A 04               STA   KEYBUF   ; held for the next "?"
EABF   4C 92 E9               JMP   chk3   ; (Ctrl-C: back only if the break key is off)
EAC2   60           FP9:      RTS      
EAC3                             ; The thunks: the rest of the punctuation, through the ordinary handlers
EAC3   18           FT_STR:   CLC      ; "
EAC4   20 5D E2               JSR   h_str   
EAC7   4C 9F EA               JMP   fnext   ; (rare enough: the shared dispatcher)
EACA   18           FT_NUM:   CLC      ; #
EACB   20 79 E2               JSR   h_num   
EACE   4C 9F EA               JMP   fnext   ; (rare enough: the shared dispatcher)
EAD1   18           FT_PRT:   CLC      ; $
EAD2   20 3F E2               JSR   h_print   
EAD5   4C 9F EA               JMP   fnext   ; (rare enough: the shared dispatcher)
EAD8   18           FT_EMIT:   CLC      ; '
EAD9   20 71 E2               JSR   h_emit   
EADC   4C 9F EA               JMP   fnext   ; (rare enough: the shared dispatcher)
EADF   18           FT_DIV:   CLC      ; /
EAE0   20 50 E3               JSR   h_div   
EAE3                          ;*Macro unroll:  NEXTF
EAE3   A0                     DS   1-CHECKED,0A0h   
EAE4   00                     DS   1-CHECKED,0   
EAE5   B1                     DS   1-CHECKED,0B1h   
EAE6   00                     DS   1-CHECKED,IP   
EAE7   E6                     DS   1-CHECKED,0E6h   
EAE8   00                     DS   1-CHECKED,IP   
EAE9   D0                     DS   1-CHECKED,0D0h   
EAEA   02                     DS   1-CHECKED,2   
EAEB   E6                     DS   1-CHECKED,0E6h   
EAEC   01                     DS   1-CHECKED,IP+1   
EAED   A8                     DS   1-CHECKED,0A8h   
EAEE   B9                     DS   1-CHECKED,0B9h   
EAEF   00                     DS   1-CHECKED,ADTL&0FFh   
EAF0   E0                     DS   1-CHECKED,ADTL/256   
EAF1   85                     DS   1-CHECKED,85h   
EAF2   04                     DS   1-CHECKED,V   
EAF3   B9                     DS   1-CHECKED,0B9h   
EAF4   00                     DS   1-CHECKED,ADTH&0FFh   
EAF5   E1                     DS   1-CHECKED,ADTH/256   
EAF6   85                     DS   1-CHECKED,85h   
EAF7   05                     DS   1-CHECKED,V+1   
EAF8   6C                     DS   1-CHECKED,6Ch   
EAF9   04                     DS   1-CHECKED,V   
EAFA   00                     DS   1-CHECKED,0   
EAFB                          DS   CHECKED,4Ch   
EAFB                          DS   CHECKED,AFNX&0FFh   
EAFB                          DS   CHECKED,AFNX/256   
EAFB   18           FT_KEY:   CLC      ; ?
EAFC   20 84 E3               JSR   h_key   
EAFF   4C 9F EA               JMP   fnext   ; (rare enough: the shared dispatcher)
EB02   18           FT_DEF:   CLC      ; [
EB03   20 4D E4               JSR   h_def   
EB06                          ;*Macro unroll:  NEXTF
EB06   A0                     DS   1-CHECKED,0A0h   
EB07   00                     DS   1-CHECKED,0   
EB08   B1                     DS   1-CHECKED,0B1h   
EB09   00                     DS   1-CHECKED,IP   
EB0A   E6                     DS   1-CHECKED,0E6h   
EB0B   00                     DS   1-CHECKED,IP   
EB0C   D0                     DS   1-CHECKED,0D0h   
EB0D   02                     DS   1-CHECKED,2   
EB0E   E6                     DS   1-CHECKED,0E6h   
EB0F   01                     DS   1-CHECKED,IP+1   
EB10   A8                     DS   1-CHECKED,0A8h   
EB11   B9                     DS   1-CHECKED,0B9h   
EB12   00                     DS   1-CHECKED,ADTL&0FFh   
EB13   E0                     DS   1-CHECKED,ADTL/256   
EB14   85                     DS   1-CHECKED,85h   
EB15   04                     DS   1-CHECKED,V   
EB16   B9                     DS   1-CHECKED,0B9h   
EB17   00                     DS   1-CHECKED,ADTH&0FFh   
EB18   E1                     DS   1-CHECKED,ADTH/256   
EB19   85                     DS   1-CHECKED,85h   
EB1A   05                     DS   1-CHECKED,V+1   
EB1B   6C                     DS   1-CHECKED,6Ch   
EB1C   04                     DS   1-CHECKED,V   
EB1D   00                     DS   1-CHECKED,0   
EB1E                          DS   CHECKED,4Ch   
EB1E                          DS   CHECKED,AFNX&0FFh   
EB1E                          DS   CHECKED,AFNX/256   
EB1E   18           FT_BRK:   CLC      ; \
EB1F   20 E1 E3               JSR   h_break   
EB22                          ;*Macro unroll:  NEXTF
EB22   A0                     DS   1-CHECKED,0A0h   
EB23   00                     DS   1-CHECKED,0   
EB24   B1                     DS   1-CHECKED,0B1h   
EB25   00                     DS   1-CHECKED,IP   
EB26   E6                     DS   1-CHECKED,0E6h   
EB27   00                     DS   1-CHECKED,IP   
EB28   D0                     DS   1-CHECKED,0D0h   
EB29   02                     DS   1-CHECKED,2   
EB2A   E6                     DS   1-CHECKED,0E6h   
EB2B   01                     DS   1-CHECKED,IP+1   
EB2C   A8                     DS   1-CHECKED,0A8h   
EB2D   B9                     DS   1-CHECKED,0B9h   
EB2E   00                     DS   1-CHECKED,ADTL&0FFh   
EB2F   E0                     DS   1-CHECKED,ADTL/256   
EB30   85                     DS   1-CHECKED,85h   
EB31   04                     DS   1-CHECKED,V   
EB32   B9                     DS   1-CHECKED,0B9h   
EB33   00                     DS   1-CHECKED,ADTH&0FFh   
EB34   E1                     DS   1-CHECKED,ADTH/256   
EB35   85                     DS   1-CHECKED,85h   
EB36   05                     DS   1-CHECKED,V+1   
EB37   6C                     DS   1-CHECKED,6Ch   
EB38   04                     DS   1-CHECKED,V   
EB39   00                     DS   1-CHECKED,0   
EB3A                          DS   CHECKED,4Ch   
EB3A                          DS   CHECKED,AFNX&0FFh   
EB3A                          DS   CHECKED,AFNX/256   
EB3A   18           FT_ALC:   CLC      ; _
EB3B   20 9D E4               JSR   h_alloc   
EB3E   4C 9F EA               JMP   fnext   ; (rare enough: the shared dispatcher)
EB41   18           FT_GRV:   CLC      ; `
EB42   20 6F E4               JSR   h_grave   
EB45   4C 9F EA               JMP   fnext   ; (rare enough: the shared dispatcher)
EB48   18           FT_TOR:   CLC      ; {
EB49   20 05 E4               JSR   h_tor   
EB4C   4C 9F EA               JMP   fnext   ; (rare enough: the shared dispatcher)
EB4F   18           FT_FRR:   CLC      ; }
EB50   20 11 E4               JSR   h_fromr   
EB53   4C 9F EA               JMP   fnext   ; (rare enough: the shared dispatcher)
EB56                          ENDIF      
EB56                          IF   FAST*CHECKED   
                    FT_STO:   CLC      ; ! (checked: it checks the address)
                              JSR   h_store   
                              JMP   fnext   
                    FT_CST:   CLC      ; . (the same)
                              JSR   h_cstore   
                              JMP   fnext   
EB56                          ENDIF      
EB56                          IF   FAST   
EB56                             ; The commonest punctuation, written for the table
EB56   18           FS_ADD:   CLC      ; +
EB57   B5 00                  LDA   0,X   
EB59   75 02                  ADC   2,X   
EB5B   95 02                  STA   2,X   
EB5D   B5 01                  LDA   1,X   
EB5F   75 03                  ADC   3,X   
EB61   95 03                  STA   3,X   
EB63   E8                     INX      
EB64   E8                     INX      
EB65                          ;*Macro unroll:  NEXTF
EB65   A0                     DS   1-CHECKED,0A0h   
EB66   00                     DS   1-CHECKED,0   
EB67   B1                     DS   1-CHECKED,0B1h   
EB68   00                     DS   1-CHECKED,IP   
EB69   E6                     DS   1-CHECKED,0E6h   
EB6A   00                     DS   1-CHECKED,IP   
EB6B   D0                     DS   1-CHECKED,0D0h   
EB6C   02                     DS   1-CHECKED,2   
EB6D   E6                     DS   1-CHECKED,0E6h   
EB6E   01                     DS   1-CHECKED,IP+1   
EB6F   A8                     DS   1-CHECKED,0A8h   
EB70   B9                     DS   1-CHECKED,0B9h   
EB71   00                     DS   1-CHECKED,ADTL&0FFh   
