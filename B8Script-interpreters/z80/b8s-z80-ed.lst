0173   D5                     PUSH   DE   ; a, for r's sign
0174   7A                     LD   A,D   
0175   AC                     XOR   H   
0176   F5                     PUSH   AF   ; S flag = sign of q
0177   CB 7C                  BIT   7,H   
0179   C4 20 00               CALL   NZ,neg16   ; HL = |b|
017C   EB                     EX   DE,HL   
017D   CB 7C                  BIT   7,H   
017F   C4 20 00               CALL   NZ,neg16   ; HL = |a|, DE = |b|
