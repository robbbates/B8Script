01B7   73                     LD   (HL),E   
01B8   DF           H_DROP:   RST   18h   ; ";" is this one byte
01B9                H_STORE:      ; "!" ( n addr -- )
01B9                          IF   CHECKED   
01B9   CD F2 03               CALL   chkst   
01BC                          ENDIF      
