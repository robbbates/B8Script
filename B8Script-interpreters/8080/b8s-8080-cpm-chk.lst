06E8                             ; =============================================================================
06E8                             ;  Startup
06E8                             ; =============================================================================
06E8                START:       
06E8                          IF   (1-CPM)*CHECKED   
                              LXI   SP,DSTOP   
06E8                          ENDIF      
06E8                          IF   CHECKED   
06E8                             ; Clear the lower half of the letter page: every variable starts at
06E8                             ; 0, every word cell holds 0000h, the address an undefined word is
06E8                             ; caught at (see e_hi), and no key is held back.
06E8   21 00 0A               LXI   H,LET   
06EB   AF                     XRA   A   
06EC   77           INI1:     MOV   M,A   
06ED   2C                     INR   L   
06EE   F2 EC 06               JP   ini1   ; +00h to +7Fh
06F1                          ENDIF      
06F1                          IF   CPM   
06F1                             ; CP/M: the RAM pages follow the image; the heap may grow to the BDOS
06F1   11 5C 00               LXI   D,005Ch   ; open the file named on the command line
06F4   0E 0F                  MVI   C,15   ; (no such file: the first read fails too,
06F6   CD 05 00               CALL   BDOS   ;   and the program is empty)
06F9   11 00 0B               LXI   D,PROG   
06FC   D5           LD1:      PUSH   D   
06FD   0E 1A                  MVI   C,26   ; set the DMA address
06FF   CD 05 00               CALL   BDOS   
0702   11 5C 00               LXI   D,005Ch   
0705   0E 14                  MVI   C,20   ; read the next 128 bytes
0707   CD 05 00               CALL   BDOS   
070A   E1                     POP   H   ; HL = the address this record went to
070B   B7                     ORA   A   
070C   C2 17 07               JNZ   ld2   
070F   11 80 00               LXI   D,128   
0712   19                     DAD   D   
0713   EB                     XCHG      
0714   C3 FC 06               JMP   ld1   
0717   36 00        LD2:      MVI   M,0   ; the end of the file counts as NUL
0719   23                     INX   H   ; the heap starts after it
071A                          ENDIF      
071A                          IFN   CPM   
                              LXI   H,PROG   ; the heap starts after the program's NUL
                    FNUL:     MOV   A,M   
                              INX   H   
                              ORA   A   
                              JNZ   fnul   
071A                          ENDIF      
071A   22 7C 0A               SHLD   HEAP   
071D                          IF   CHECKED   
071D                          ;*Macro unroll:  NEGH                    ; minus the heap's first address: '_' may not
071D                          DS   1-CPM,0E7h   ; minus the heap"s first address: "_' may not
071D   CD                     DS   CPM,0CDh   
071E   27                     DS   CPM,ANEG&0FFh   
071F   01                     DS   CPM,ANEG/256   
0720   22 38 0A               SHLD   NPEND   ;   release below it
0723                          ENDIF      
0723   21 E0 08               LXI   H,RSTOP   ; the return stack is empty
0726   22 34 0A               SHLD   RSP   
0729                          IF   (1-CHECKED)*(1-CPM)   
                              MOV   H,A   ; (A = 0, from the search for the NUL) no key
                              MOV   L,A   ;   is held, and the break key is on (the
0729                          ENDIF      ;   checked build has cleared these)
0729                          IF   (1-CHECKED)*CPM   
                              LXI   H,0   
0729                          ENDIF      
0729                          IF   1-CHECKED   
                              SHLD   KEYBUF   
0729                          ENDIF      
0729   01 00 0B               LXI   B,PROG   ; the IP
072C                          ;*Macro unroll:  NEXT                    ; (its return address is thrown away)
072C                          DS   1-CPM,0F7h   ; (its return address is thrown away)
072C   C3                     DS   CPM,0C3h   
072D   36                     DS   CPM,ANXT&0FFh   
072E   01                     DS   CPM,ANXT/256   
072F                          IF   CPM   
072F                             ; RAM pages, after the image
072F                RSPAGE:   EQU   (imgend + 255) / 256   
072F                DSPAGE:   EQU   RSPAGE + 1   
072F                LETPAGE:   EQU   RSPAGE + 2   
072F                PROG:     EQU   LETPAGE*256 + 256   
072F                          ENDIF      
072F                IMGEND:      


