  1053 00000520 7452                <1>         je      .wk6
  1054 00000522 85FF                <1>         test    edi,edi
  1055 00000524 740F                <1>         jz      .wk2
  1056 00000526 6AFF                <1>         push    -1                      ; INFINITE: the timer ends it
  1057 00000528 6A00                <1>         push    0                       ; any one of the two
  1058 0000052A 8D455A              <1>         lea     eax,[V(v_hin)]
  1059 0000052D 50                  <1>         push    eax
  1060 0000052E 6A02                <1>         push    2
  1061 00000530 FF55AA              <1>         call    [V(iat_WaitForMultipleObjects)]
  1062 00000533 EB07                <1>         jmp     short .wk4
