03E6                             ; psgn: print HL as a signed number. Uses BC.
03E6   7C           PSGN:     MOV   A,H   
03E7   B7                     ORA   A   
03E8   F2 EF 03               JP   pdec   
03EB   3E 2D                  MVI   A,"-"   
03ED                          ;*Macro unroll:  PUTA
03ED   EF                     DS   1-CPM,0EFh   
03EE                          DS   CPM,0CDh   
03EE                          DS   CPM,APUT&0FFh   
03EE                          DS   CPM,APUT/256   
03EE                          ;*Macro unroll:  NEGH
03EE   E7                     DS   1-CPM,0E7h   
03EF                          DS   CPM,0CDh   
03EF                          DS   CPM,ANEG&0FFh   
03EF                          DS   CPM,ANEG/256   
03EF                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
03EF                             ; Uses BC.
03EF   11 0A 00     PDEC:     LXI   D,10   
03F2   CD 3A 02               CALL   udiv   ; HL = HL / 10, C = the last digit
03F5   79                     MOV   A,C   
03F6   F5                     PUSH   PSW   
03F7   7C                     MOV   A,H   
03F8   B5                     ORA   L   
03F9   C4 EF 03               CNZ   pdec   
03FC   F1                     POP   PSW   
03FD   C6 30                  ADI   "0"   
03FF                          ;*Macro unroll:  PUTA
03FF   EF                     DS   1-CPM,0EFh   
0400                          DS   CPM,0CDh   
0400                          DS   CPM,APUT&0FFh   
0400                          DS   CPM,APUT/256   
0400   C9                     RET      
0401                             ; (The table goes here instead in the builds where, before the routines, it
0401                             ; would cross a page: PTLATE. If it would cross one here too, it starts on
0401                             ; the next page: PTPAD is 0 unless it must.)
0401                          IF   (1-FAST)*PTLATE   
                    PTPH:     EQU   $ & 0FFh   
                    PTPX:     EQU   (PTPH + 31) / 256   
                    PTPAD:    EQU   PTPX * (256 - PTPH)   
                              DS   PTPAD   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0401                          ENDIF      
0401                          IF   1-CHECKED   
                                 ; "$" prints the string at TOS (see h_print).
                    PRLP:     MOV   A,M   
                              INX   H   
                              CPI   22h   
                              JZ   h_drop   
                              CPI   "/"   
                              JNZ   pr1   
                              MOV   A,M   
                              INX   H   
                              CPI   60h   
                              JC   pr0   
                              CPI   7Fh   
                              JC   pesc   
                    PR0:      ANI   0BFh   
                              ;*Macro unroll: pr1:    PUTA
                    PR1:      DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              JMP   prlp   
0401                          ENDIF      
0401                             ;-----------------------------------------------------------------------------
0401                             ; pesc: the escapes of "$". A = the character after the "/", 60h to 7Eh, and
0401                             ; HL points past it. Each goes back into the loop that prints the string
0401                             ; (PRLOOP), but /~ has the stack to see to, and goes back by PRAGAIN.
0401                             ;    /a-/z   print the variable, as "#" does
0401                             ;    /{      clear the screen, the cursor to the top left
0401                             ;    /}      clear from the cursor to the end of the line
0401                             ;    /|  /`  show the cursor, hide it
0401                             ;    /~      ( row col -- ) the cursor to that row and column, from 0
0401   FE 7E        PESC:     CPI   7Eh   
0403   CA 26 04               JZ   pat   
0406   11 D6 05               LXI   D,PRLOOP   ; the others return into the loop
0409   D5                     PUSH   D   
040A   D6 7B                  SUI   7Bh   ; 00bbIDAsIHwgMSwg 2, and no borrow
040C   D2 38 04               JNC   pcon   
040F   C6 1A                  ADI   1Ah   ; a-z: 0-25, and a carry; `: FFh, and none
0411   D2 41 04               JNC   phide   
0414   87                     ADD   A   ; the variable's cell
0415   C6 40                  ADI   40h   
0417   E5                     PUSH   H   
0418   C5                     PUSH   B   
0419   6F                     MOV   L,A   
041A   26 82                  MVI   H,LETPAGE   
041C   7E                     MOV   A,M   
041D   2C                     INR   L   
041E   66                     MOV   H,M   
041F   6F                     MOV   L,A   
0420   CD E6 03               CALL   psgn   
0423   C1                     POP   B   
0424   E1                     POP   H   
0425   C9                     RET      
0426                             ; /~ ( row col addr -- ): the two cells under the string's address go. In
0426                             ; the checked build "$" is the routine prstr: its own return address goes
0426                             ; first, and hp1 calls it again afterwards. There each /~ first looks that
0426                             ; its two cells are there, and is s if not, before it prints anything.
0426                PAT:         
0426                          IF   CHECKED   
0426   E3                     XTHL      ; the text pointer over prstr's return address
0427   21 0A 7E               LXI   H,(6-DSTOP)&0FFFFh   ; a carry: the two cells aren't there
042A   39                     DAD   SP   
042B   DA 31 06               JC   e_under   
042E   E1                     POP   H   
042F                          ENDIF      
042F   D1                     POP   D   ; DE = the column
0430   E3                     XTHL      ; HL = the row; the text pointer is kept
0431                          IF   1-ANS   
0431   CD 15 FF               CALL   CONAT   
0434   E1                     POP   H   
0435   C3 9F 01               JMP   PRAGAIN   
0438                             ; With ANSI = 0 the machine's routines do the rest.
0438   CA 0C FF     PCON:     JZ   CONCLS   ; /{
043B   FE 02                  CPI   2   
043D   CA 0F FF               JZ   CONEOL   ; /}
0440   FE                     DB   0FEh   ; /|  (CPI steps over the XRA: A = 1, show)
0441   AF           PHIDE:    XRA   A   ; /`  (A = 0: hide)
0442   C3 12 FF               JMP   CONCUR   
0445                          ENDIF      
0445                          IF   ANS   
                              PUSH   B   ; (pdec uses BC)
                              PUSH   D   
                              CALL   csi   ; ESC [ row+1 ; col+1 H (ANSI counts from 1)
                              INX   H   
                              CALL   pdec   
                              MVI   A,";"   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              POP   H   
                              INX   H   
                              CALL   pdec   
                              MVI   A,"H"   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              POP   B   
                              POP   H   
                              JMP   PRAGAIN   
                                 ; With ANSI = 1 they are sequences. The carry is clear on the way in.
                    PSHOW:    MVI   E,"h"   ; /|  ESC [ ? 2 5 h
                              DB   0DAh   ; (JC nn: with no carry it steps over two bytes)
                    PHIDE:    MVI   E,"l"   ; /`  ESC [ ? 2 5 l
                              MVI   A,"?"   
                              CALL   csia   
                              MVI   A,"2"   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              MVI   A,"5"   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              MOV   A,E   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              RET      
                                 ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into csia.
                    PCON:     DCR   A   
                              JZ   pshow   ; /|
                              MVI   A,"K"   
                              JP   csia   ; /}  ESC [ K
                              MVI   A,"H"   ; /{  ESC [ H ESC [ J
                              CALL   csia   
                              MVI   A,"J"   ; (on into csia)
                                 ; csia: ESC [ and then A. csi: ESC [. Both keep all but A.
                    CSIA:     PUSH   PSW   
                              CALL   csi   
                              POP   PSW   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              RET      
                    CSI:      MVI   A,27   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              MVI   A,"["   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              RET      
0445                          ENDIF      
0445                             ; skip: read past text to the closer at this level, and return A = 0 if it
0445                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
0445                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
0445                             ; no closer; anything else that runs into the NUL had unbalanced brackets
0445                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
0445                             ; skip sets it to 0 and falls through the INR that an opener comes back to.
0445                             ; 
0445                             ; The checked build also looks at the character the skip was started by,
0445                             ; which is always the one just before where it starts: "(" must end at ")",
0445                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
0445                             ; quote counts as running into it. "\" takes either closer. The place where
0445                             ; the skip started is kept on the stack, for the report.
0445                          IF   1-QK   
                                 ; (Without base: no skip cache.)
                    SKIP:        
0445                          ENDIF      
0445                          IF   CHECKED*(1-QK)   
                              PUSH   B   
                              DCX   B   
                              LDAX   B   
                              INX   B   
                              MOV   E,A   ; E = the opener: ( [ or \
0445                          ENDIF      
0445                          IF   1-QK   
                              MVI   D,0   
                    SK3:      INR   D   ; an opener: one deeper
                    SK1:      LDAX   B   
0445                          ENDIF      
0445                          IF   (1-CHECKED)*(1-QK)   
                              INX   B   
                              ORA   A   
                              JZ   endprog   
0445                          ENDIF      
0445                          IF   CHECKED*(1-QK)   
                              ORA   A   
                              JZ   sk6   ; (the IP stays on the NUL)
                              INX   B   
0445                          ENDIF      
0445                          IF   1-QK   
                              CPI   22h   
                              CZ   skipstr   ; leaves A = 22h, which matches nothing below
                              SUI   "("   ;   (or 0, and then the NUL is read next)
                              JZ   sk3   
                              DCR   A   ; ")"
                              JZ   sk4   
                              SUI   "["-")"   
                              JZ   sk3   
                              CPI   "]"-"["   
                              JNZ   sk1   
                    SK4:      DCR   D   
0445                          ENDIF      
0445                          IF   (1-CHECKED)*(1-QK)   
                              RZ      ; the closer at this level
                              JMP   sk1   
0445                          ENDIF      
0445                          IF   CHECKED*(1-QK)   
                              JNZ   sk1   
                              MOV   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
                              XRA   E   ;   opener is 0 for "(" and 1 for "[", and only
                              ANI   6   ;   "\" has bit 2: so this is 2 for the wrong
                              CPI   2   ;   closer, and only then
                              MOV   A,D   
                              POP   D   ; (where the skip started)
                              RNZ      
                              MOV   B,D   ; N. The place is the opener
                              MOV   C,E   
                              JMP   sk7   
                    SK6:      MOV   A,E   ; the text ran out:
                              ANI   4   
                              JNZ   endprog   ;   "\" with no closer ends the program
                              POP   B   
                    SK7:      MVI   A,"N"   
                              JMP   errp   ; (errp drops skip's return address)
0445                          ENDIF      
0445                          IF   QK   
0445                             ; The skip cache. Nearly every skip is one that has happened before (a loop
0445                             ; skips the same false block on every pass), so the first scan from each
0445                             ; place is remembered: 64 entries of 00bbc3RhcnQsIGVuZA==, in the page CPAGE, found
0445                             ; by the start's low byte (times 4). Only skips that start in the program
0445                             ; text are kept (the line buffer changes); the cache is emptied whenever a
0445                             ; run starts (see start). A program that changes its own text while it
0445                             ; runs is not looked after.
0445   78           SKIP:     MOV   A,B   
0446   FE 83                  CPI   PROG/256   
0448   DA 68 04               JC   sks   ; below the program text: no cache
044B   79                     MOV   A,C   
044C   87                     ADD   A   
044D   87                     ADD   A   
044E   5F                     MOV   E,A   
044F   16 F0                  MVI   D,CPAGE   ; DE -> the entry
0451   1A                     LDAX   D   
0452   B9                     CMP   C   
0453   C2 68 04               JNZ   sks   
0456   1C                     INR   E   
0457   1A                     LDAX   D   
0458   B8                     CMP   B   
0459   C2 68 04               JNZ   sks   
045C   1C                     INR   E   
045D   1A                     LDAX   D   
045E   4F                     MOV   C,A   
045F   1C                     INR   E   
0460   1A                     LDAX   D   
0461   47                     MOV   B,A   ; a hit: the IP is past the closer
0462   0B                     DCX   B   
0463   0A                     LDAX   B   
0464   03                     INX   B   
0465   D6 29                  SUI   ")"   ; 0 for ")", not 0 for "]"
0467   C9                     RET      
0468   C5           SKS:      PUSH   B   ; where it starts: the cache's key (and the
0469                          ENDIF      ;   checked report's place)
0469                          IF   QK*CHECKED   
0469   0B                     DCX   B   
046A   0A                     LDAX   B   
046B   03                     INX   B   
046C   5F                     MOV   E,A   ; E = the opener: ( [ or \
046D                          ENDIF      
046D                          IF   QK   
046D                             ; The scan. Most characters are nothing to it, and two range tests rule
046D                             ; them out: * to Z, and ^ and up. Only NUL " ( ) [ ] count.
046D   16 00                  MVI   D,0   
046F   14           SQ3:      INR   D   ; an opener: one deeper
0470   0A           SQ1:      LDAX   B   
0471   03                     INX   B   
0472   FE 5E                  CPI   5Eh   
0474   D2 70 04               JNC   sq1   ; ^ _ ` a-z 00bbIHwg ~ and up: nothing
0477   FE 5B                  CPI   5Bh   
0479   D2 A5 04               JNC   sqb   ; [ \ ]
047C   FE 2A                  CPI   2Ah   
047E   D2 70 04               JNC   sq1   ; * to Z: nothing
0481   FE 28                  CPI   28h   
0483   CA 6F 04               JZ   sq3   ; (
0486   D2 B0 04               JNC   sqc   ; )
0489   FE 22                  CPI   22h   
048B   CA 9F 04               JZ   sqq   ; a string
048E   B7                     ORA   A   
048F   C2 70 04               JNZ   sq1   ; the rest below "(": nothing
0492                          ENDIF      
0492                          IF   QK*(1-CHECKED)   
                              JMP   endprog   ; NUL: the end of the program
0492                          ENDIF      
0492                          IF   QK*CHECKED   
0492   0B                     DCX   B   ; NUL: the IP stays on it
0493   7B                     MOV   A,E   ; the text ran out:
0494   E6 04                  ANI   4   
0496   C2 3F 00               JNZ   endprog   ;   "\" with no closer ends the program
0499   C1                     POP   B   
049A   3E 4E        SQ7:      MVI   A,"N"   ; N. The place is the opener
049C   C3 60 06               JMP   errp   ; (errp drops skip's return address)
049F                          ENDIF      
049F                          IF   QK   
049F   CD E0 04     SQQ:      CALL   skipstr   ; step over the string
04A2   C3 70 04               JMP   sq1   
04A5   D6 5C        SQB:      SUI   5Ch   ; [ -1, \ 0, ] 1
04A7   CA 70 04               JZ   sq1   ; "\" is nothing here
04AA   DA 6F 04               JC   sq3   ; [
04AD   3E 02                  MVI   A,2   ; ]
04AF   FE                     DB   0FEh   ; (CPI: steps over the XRA)
04B0   AF           SQC:      XRA   A   ; )
04B1   15           SQ4:      DCR   D   
04B2   C2 70 04               JNZ   sq1   
04B5                          ENDIF      
04B5                          IF   QK*CHECKED   
04B5   57                     MOV   D,A   ; the closer at this level (as above): 2 here
04B6   AB                     XRA   E   ;   means the wrong closer
04B7   E6 06                  ANI   6   
04B9   FE 02                  CPI   2   
04BB   7A                     MOV   A,D   
04BC   D1                     POP   D   ; (where the skip started)
04BD   C2 C5 04               JNZ   sq8   
04C0   42                     MOV   B,D   
04C1   4B                     MOV   C,E   
04C2   C3 9A 04               JMP   sq7   
04C5                SQ8:         
04C5                          ENDIF      
04C5                          IF   QK*(1-CHECKED)   
                              POP   D   ; where the skip started
04C5                          ENDIF      
04C5                          IF   QK   
04C5                             ; The closer at this level: remember the skip (if it started in the program
04C5                             ; text), and return A = 0 for ")" or 2 for "]". DE = the start, BC = the end.
04C5   E5                     PUSH   H   
04C6   67                     MOV   H,A   
04C7   7A                     MOV   A,D   
04C8   FE 83                  CPI   PROG/256   
04CA   DA DD 04               JC   sq9   
04CD   7B                     MOV   A,E   
04CE   87                     ADD   A   
04CF   87                     ADD   A   
04D0   6F                     MOV   L,A   
04D1   7C                     MOV   A,H   
04D2   26 F0                  MVI   H,CPAGE   
04D4   73                     MOV   M,E   
04D5   2C                     INR   L   
04D6   72                     MOV   M,D   
04D7   2C                     INR   L   
04D8   71                     MOV   M,C   
04D9   2C                     INR   L   
04DA   70                     MOV   M,B   
04DB   E1                     POP   H   
04DC   C9                     RET      
04DD   7C           SQ9:      MOV   A,H   
04DE   E1                     POP   H   
04DF   C9                     RET      
04E0                          ENDIF      
04E0                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
04E0                             ; the next character, so "/"" does not end it. Leaves A = 22h.
04E0                          IF   1-CHECKED   
                    SS0:      INX   B   
                    SKIPSTR:   LDAX   B   
                              INX   B   
                              CPI   "/"   
                              JZ   ss0   
                              CPI   22h   
                              JNZ   skipstr   
                              RET      
04E0                          ENDIF      
04E0                          IF   CHECKED   
04E0                             ; The checked build never steps over a NUL: if the text runs out first it
04E0                             ; returns A = 0 with the IP on the NUL.
04E0   0A           SKIPSTR:   LDAX   B   
04E1   B7                     ORA   A   
04E2   C8                     RZ      
04E3   03                     INX   B   
04E4   FE 22                  CPI   22h   
04E6   C8                     RZ      
04E7   FE 2F                  CPI   "/"   
04E9   C2 E0 04               JNZ   skipstr   
04EC   0A                     LDAX   B   ; the escaped character
04ED   B7                     ORA   A   
04EE   C8                     RZ      
04EF   03                     INX   B   
04F0   C3 E0 04               JMP   skipstr   
04F3                          ENDIF      
04F3                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
04F3                             ; and return its value in A with the carry set; otherwise leave the IP and
04F3                             ; return with the carry clear.
04F3   0A           HEXC:     LDAX   B   
04F4   D6 30                  SUI   "0"   
04F6   FE 0A                  CPI   10   
04F8   DA 04 05               JC   hc1   
04FB   E6 DF                  ANI   0DFh   
04FD   D6 11                  SUI   11h   
04FF   FE 06                  CPI   6   
0501   D0                     RNC      
0502   D6 F6                  SUI   0F6h   ; + 10, and sets the carry
0504   03           HC1:      INX   B   
0505   C9                     RET      
0506                             ;  ---- Speed-ups (base builds) -------------------------------------------
0506                             ;  The skip cache and "/" by a power of two are above. These are the
0506                             ;  handlers' tails that the builds with room take, kept here, out of the
0506                             ;  handlers' first two pages.
0506                          IF   QK   
0506                             ; "*" with an operand below 256: that one becomes the multiplier, a byte in
0506                             ; A, and the loop stops as soon as its bits are used up (most
0506                             ; multiplications have one, a count or a small constant). With both at 256
0506                             ; and up, the multiplier's low byte takes exactly 8 rounds (a marker bit
0506                             ; shifted in above it says when), and its high byte goes on as a small one.
0506                             ; DE = NOS, HL = TOS.
0506   7C           MULQ:     MOV   A,H   
0507   B7                     ORA   A   
0508   CA 11 05               JZ   mq8   ; the multiplier is below 256
050B   7A                     MOV   A,D   
050C   B7                     ORA   A   
050D   C2 33 05               JNZ   mq16   
0510   EB                     XCHG      ; the multiplicand is: it becomes the multiplier
0511   7D           MQ8:      MOV   A,L   
0512   21 00 00               LXI   H,0   
0515   B7                     ORA   A   ; (clears the carry)
0516   CA 25 05               JZ   mq9   
0519   1F           MQ1:      RAR      ; the next bit
051A   D2 1E 05               JNC   mq2   
051D   19                     DAD   D   
051E   EB           MQ2:      XCHG      
051F   29                     DAD   H   ; multiplicand << 1
0520   EB                     XCHG      
0521   B7                     ORA   A   ; bits left? (and clears the carry)
0522   C2 19 05               JNZ   mq1   
0525                          ;*Macro unroll: mq9:    NEXTQ
0525                MQ9:      DS   (1-CPM)*(1-FAST),0F7h   
0525                          DS   CPM*(1-FAST),0C3h   
0525                          DS   CPM*(1-FAST),ANXT&0FFh   
0525                          DS   CPM*(1-FAST),ANXT/256   
0525   CD                     DS   FAST*CHECKED,0CDh   
0526   02                     DS   FAST*CHECKED,ACHK&0FFh   
0527   06                     DS   FAST*CHECKED,ACHK/256   
0528   0A                     DS   FAST,0Ah   
0529   03                     DS   FAST,03h   
052A   EB                     DS   FAST,0EBh   
052B   6F                     DS   FAST,6Fh   
052C   26                     DS   FAST,26h   
052D   11                     DS   FAST,DTPG   
052E   7E                     DS   FAST,7Eh   
052F   24                     DS   FAST,24h   
0530   66                     DS   FAST,66h   
0531   6F                     DS   FAST,6Fh   
0532   E9                     DS   FAST,0E9h   
0533   C5           MQ16:     PUSH   B   
0534   44                     MOV   B,H   ; the high byte, for later
0535   7D                     MOV   A,L   
0536   21 00 00               LXI   H,0   
0539   37                     STC      ; the marker
053A   1F                     RAR      
053B   D2 3F 05     MQ3:      JNC   mq4   
053E   19                     DAD   D   
053F   EB           MQ4:      XCHG      
0540   29                     DAD   H   
0541   EB                     XCHG      
0542   FE 01                  CPI   1   ; only the marker left: 8 rounds done (and
0544   1F                     RAR      ;   the carry was clear for the shift)
0545   C2 3B 05               JNZ   mq3   
0548   78                     MOV   A,B   
0549   C1                     POP   B   
054A   B7                     ORA   A   
054B   C3 19 05               JMP   mq1   ; the high byte, as a small multiplier
054E                             ; A true ")" reads the block start where it is, on top of the return stack,
054E                             ; instead of popping it and pushing it back; the break key is looked at as
054E                             ; rpushd would.
054E   2A 34 82     CLOSEQ:   LHLD   RSP   
0551   4E                     MOV   C,M   
0552   23                     INX   H   
0553   46                     MOV   B,M   
0554   21 36 82               LXI   H,BRKCNT   
0557   35                     DCR   M   
0558   E1                     POP   H   ; (keeps the flags)
0559   CC 6A 05               CZ   pollk   
055C                          ;*Macro unroll:  NEXTQ
055C                          DS   (1-CPM)*(1-FAST),0F7h   
055C                          DS   CPM*(1-FAST),0C3h   
055C                          DS   CPM*(1-FAST),ANXT&0FFh   
055C                          DS   CPM*(1-FAST),ANXT/256   
055C   CD                     DS   FAST*CHECKED,0CDh   
055D   02                     DS   FAST*CHECKED,ACHK&0FFh   
055E   06                     DS   FAST*CHECKED,ACHK/256   
055F   0A                     DS   FAST,0Ah   
0560   03                     DS   FAST,03h   
0561   EB                     DS   FAST,0EBh   
0562   6F                     DS   FAST,6Fh   
0563   26                     DS   FAST,26h   
0564   11                     DS   FAST,DTPG   
0565   7E                     DS   FAST,7Eh   
0566   24                     DS   FAST,24h   
0567   66                     DS   FAST,66h   
0568   6F                     DS   FAST,6Fh   
0569   E9                     DS   FAST,0E9h   
056A                          ENDIF      
056A                          IF   SBASEU   
                                 ; a-z, in the unchecked builds: a variable followed by "@" or "!" is fetched
                                 ; or stored in the same step (x@ is the commonest pair in most programs).
                                 ; (A checked build checks the stacks between the two, so it keeps them apart.)
                    LOWER:    EQU   lowq   
                    LOWQ:     ADD   A   
                              MOV   E,A   
                              MVI   D,LETPAGE   ; DE -> the cell
                              LDAX   B   
                              CPI   "@"   
                              JZ   lwf   
                              CPI   "!"   
                              JZ   lws   
                              PUSH   H   
                              XCHG      ; TOS = the cell's address
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0C3h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
                    LWF:      INX   B   ; x@: TOS = the cell's value
                              PUSH   H   
                              XCHG      
                              MOV   E,M   
                              INX   H   
                              MOV   D,M   
                              XCHG      
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0C3h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
                    LWS:      INX   B   ; x!: the cell = TOS, and NOS comes up
                              XCHG      
                              MOV   M,E   
                              INX   H   
                              MOV   M,D   
                              POP   H   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0C3h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
056A                          ENDIF      
056A                             ; =============================================================================
056A                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
056A                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
056A                             ;  (RST 5) prints A. Both keep BC, DE and HL. In the generic build they are
056A                             ;  the host's KEY and CONOUT routines themselves.
056A                             ; 
056A                             ;  A running program reads the keyboard only through getk and pollk, which
056A                             ;  between them give the break key its rules:
056A                             ;    - Ctrl-C stops the program;
056A                             ;    - any other key that the break check reads is held in KEYBUF for the
056A                             ;      next "?", and a newer one takes its place;
056A                             ;    - "?" (getk) takes the held key first;
056A                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
056A                             ;      key like any other, but two of them within about 250 ms still stop it.
056A                             ;  Both are called straight from a handler, never from a routine under one:
056A                             ;  the checked build's report counts on finding one return address above the
056A                             ;  data stack, and TOS in HL.
056A                             ; =============================================================================
056A                          IFN   CPM   
056A                RAWK:     EQU   KEY   
056A                          ENDIF      
056A                             ; pollk: the break check (see rpushd).
056A   CD 06 FF     POLLK:    CALL   rawk   
056D   C8                     RZ      ; no key
056E   32 7A 82               STA   KEYBUF   ; held for the next "?"
0571   FE 03        PK1:      CPI   3   ; (getk joins here)
0573   C0                     RNZ      
0574                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
0574                             ; the program has turned it off, wait about 250 ms for one more key: a
0574                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
0574                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
0574   3A 7B 82     CTLC:     LDA   BRKOFF   
0577   B7                     ORA   A   
0578   CA D1 05               JZ   brk   
057B   D5                     PUSH   D   
057C   11 10 27               LXI   D,250*MSLOOP   
057F   CD 06 FF     CT1:      CALL   rawk   
0582   C2 8B 05               JNZ   ct2   
0585   1B                     DCX   D   
0586   7A                     MOV   A,D   
0587   B3                     ORA   E   
0588   C2 7F 05               JNZ   ct1   
058B   D1           CT2:      POP   D   ; A = the second key, or 0 if none came
058C   FE 03                  CPI   3   
058E   CA D1 05               JZ   brk   
0591   B7                     ORA   A   
0592   CA 98 05               JZ   ct3   
0595   32 7A 82               STA   KEYBUF   
0598   3E 03        CT3:      MVI   A,3   
059A   B7                     ORA   A   
059B   C9                     RET      
059C                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
059C   E5           GETK:     PUSH   H   ; a held key goes first, and is taken out of
059D   21 7A 82               LXI   H,KEYBUF   ;   the buffer
05A0   7E                     MOV   A,M   
05A1   36 00                  MVI   M,0   
05A3   E1                     POP   H   
05A4   B7                     ORA   A   
05A5   C0                     RNZ      
05A6   CD 06 FF               CALL   rawk   
05A9   C8                     RZ      
05AA   C3 71 05               JMP   pk1   ; Ctrl-C? If not, that is the key
05AD                          IF   1-CHECKED   
                    BRK:      EQU   endprog   ; the unchecked build stops without a word;
05AD                          ENDIF      
05AD                          IF   CHECKED   
05AD                BRK:      EQU   e_break   ;   the checked build reports B
05AD                          ENDIF      
05AD                          IF   CPM   
                                 ; (In a CP/M build the letters and digits are here, out of the way of the
                                 ; handlers, which must fit in the image's first two pages. The same code as
                                 ; in the generic build.)
                                 ; ---- the letters and digits --------------------------------------------------
                                 ; a-z: push the cell's address (the cell is the variable)
05AD                          ENDIF      
05AD                          IF   CPM*(1-SBASEU)   
                    LOWER:    PUSH   H   
                              ADD   A   
                              MOV   L,A   
                              MVI   H,LETPAGE   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0C3h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
05AD                          ENDIF      
05AD                          IF   CPM   
                                 ; A-Z: call the word. The return address (the IP after the letter) goes on
                                 ; the return stack, and the IP becomes the address in the letter's cell.
                    UPPER:    PUSH   H   ; keep TOS: rpushd pops it back
                              ADD   A   
                              MOV   L,A   
                              MVI   H,LETPAGE   ; HL -> cell
                              MOV   D,B   
                              MOV   E,C   ; DE = the return address
                              MOV   C,M   
                              INX   H   
                              MOV   B,M   ; IP = the word's body, and fall into rpushd
                                 ; rpushd: push DE on the return stack, then pop TOS off the data stack and
                                 ; go on. Every push of the return stack ends here: for a word call the cell
                                 ; popped is the TOS that upper parked; for "(" and "{" it is the cell under
                                 ; the one that was used up.
                                 ; 
                                 ; The break key is looked at here, so at every word call and loop-back (and
                                 ; block entry and "{"), but only one time in 256: BRKCNT counts them. Reading
                                 ; the keyboard can be slow (it is a BDOS call under CP/M).
                    RPUSHD:   LHLD   RSP   
                              DCX   H   
                              MOV   M,D   
                              DCX   H   
                              MOV   M,E   
                              SHLD   RSP   
                              LXI   H,BRKCNT   
                              DCR   M   
                              POP   H   ; (keeps the flags)
                              CZ   pollk   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0C3h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
                    RAWK:     MVI   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
                                 ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
                                 ; printing and could swallow a key that BDOS 6 then never sees.
                    PUTC:     PUSH   B   
                              PUSH   D   
                              PUSH   H   
                              MOV   E,A   
                              MVI   C,6   
                              CALL   BDOS   
                              POP   H   
                              POP   D   
                              POP   B   
                              ORA   A   ; (for getk)
                              RET      
05AD                          ENDIF      
05AD                             ; =============================================================================
05AD                             ;  Checked build: the checks and the error report
05AD                             ; =============================================================================
05AD                          IF   CHECKED   
05AD                             ; chkhp: HL = the new heap top, DE = the count, the carry is from adding
05AD                             ; it, and the old top is on the stack under the return address. Stop if the
05AD                             ; new top is not below the limit page, or is below the program's end.
05AD                CHKHP:       
05AD                          ENDIF      
05AD                          IF   CHECKED*CPM   
                                 ; With this much room a top that wrapped round can land back in
                                 ; range, so the add is tested too: growing must not carry, and
                                 ; releasing must.
                              MOV   A,D   
                              RAR      ; the carry comes in above the count's sign:
                              ADI   40h   ;   bit 7 = carry XOR sign
                              ADD   A   
                              JC   e_heap   
                              LDA   0007h   
                              DCR   A   
                              CMP   H   
                              JC   e_heap   
05AD                          ENDIF      
05AD                          IF   CHECKED*(1-CPM)   
05AD                             ; (Here the program's space is under 32K, so a top that wrapped
05AD                             ; round always falls outside it.)
05AD   7C                     MOV   A,H   
05AE   FE F0                  CPI   HEAPLIM   
05B0   D2 BC 05               JNC   e_heap   
05B3                          ENDIF      
05B3                          IF   CHECKED   
05B3   EB                     XCHG      
05B4   E5                     PUSH   H   ; the count
05B5   2A 38 82               LHLD   NPEND   
05B8   19                     DAD   D   ; carry: at or above the program's end
05B9   E1                     POP   H   
05BA   EB                     XCHG      
05BB   D8                     RC      
05BC   EB           E_HEAP:   XCHG      ; put the count back in TOS for the report,
05BD   D1                     POP   D   ;   and drop the return address (errp drops
05BE   3E 48                  MVI   A,"H"   ;   the old top)
05C0   C3 60 06               JMP   errp   
05C3                             ; chkst: stop unless HL is in the program's own space: from the letter page
05C3                             ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
05C3                             ; whatever lies above the limit are safe. Memory above the heap top but
05C3                             ; below the limit is the program's own: Tiny BASIC keeps its lines there.
05C3                             ; It is the page of HL + 1 that is tested, so that one test serves both
05C3                             ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
05C3                             ; Keeps HL and BC. It runs on into its own error entry.
05C3   23           CHKST:    INX   H   
05C4   7C                     MOV   A,H   
05C5   2B                     DCX   H   
05C6   FE 82                  CPI   LETPAGE   
05C8   DA CE 05               JC   e_store   
05CB                          ENDIF      
05CB                          IF   CHECKED*(1-CPM)   
05CB   FE F0                  CPI   HEAPLIM   
05CD   D8                     RC      
05CE                          ENDIF      
05CE                          IF   CHECKED*CPM   
                              MOV   E,A   
                              LDA   0007h   ; the BDOS page is the heap limit
                              DCR   A   
                              CMP   E   
                              RNC      
05CE                          ENDIF      
05CE                          IF   CHECKED   
05CE                             ; Two error entries for errors found inside a routine: the first hides the
05CE                             ; second inside a 3-byte LXI D (the 11h); errp then drops the routine's
05CE                             ; return address.
05CE   3E 4F        E_STORE:   MVI   A,"O"   ; a store outside the program's space
05D0   11                     DB   11h   
05D1   3E 42        E_BREAK:   MVI   A,"B"   ; Ctrl-C (found inside pollk or getk)
05D3   C3 60 06               JMP   errp   
05D6                             ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
05D6                             ; "$", and the error report's texts). A NUL first is an error: Q.
05D6   7E           PRSTR:    MOV   A,M   
05D7   23                     INX   H   
05D8   FE 22                  CPI   22h   
05DA   C8                     RZ      
05DB   B7                     ORA   A   
05DC   CA 48 06               JZ   e_dollar   
05DF   FE 2F                  CPI   "/"   
05E1   C2 F2 05               JNZ   prs1   
05E4   7E                     MOV   A,M   
05E5   23                     INX   H   
05E6   FE 60                  CPI   60h   
