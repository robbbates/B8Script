0229                             ; "*": shift-and-add on the multiplier's low bit, so it stops as soon as the
0229                             ; multiplier is used up; only the low 16 bits are kept.
0229                          IF   QK   
0229   D1           H_MUL:    POP   D   ; DE = multiplicand
022A   C3 3C 06               JMP   mulq   ; (out of the handlers' pages: see Speed-ups)
022D                          ENDIF      
