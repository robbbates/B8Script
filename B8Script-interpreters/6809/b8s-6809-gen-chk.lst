F32B   8C                     FCB   8Ch   
F32C   86 48        E_HEAP:   LDA   #"H"   ; _ past the limit, or below the program's end
F32E   8C                     FCB   8Ch   
F32F   86 51        E_QUOTE:   LDA   #"Q"   ; " or $ ran into the NUL
F331   8C                     FCB   8Ch   
F332   86 4E        E_NEST:   LDA   #"N"   ; a skip from ( or [: the NUL or the wrong closer
F334   32 62        EH1:      LEAS   2,S   ; the dispatcher's return address
F336                             ; and fall into error
F336                             ; =============================================================================
F336                             ;  Checked build: the error report. A = the letter, AT = the place; U and S
F336                             ;  are as the program left them (see "the error entries" after `upper`).
F336                             ;  It sits here, ahead of h_num, pdec and putc, so that it reaches them with
F336                             ;  short calls. Prints
F336                             ; 
F336                             ;     CR LF
F336                             ;     Err X @ line,col CR LF
F336                             ;     <up to 16 raw characters from the place, ending early at CR, LF, NUL>
F336                             ;     CR LF
F336                             ;     Stk n:[ ...][ v]*  CR LF     (the top 8 cells, bottom to top, signed)
F336                             ;     Rtn n CR LF
F336                             ; 
F336                             ;  and goes to EXIT. Line and column count from 1: the line is one more
F336                             ;  than the LFs between PROG and the place, the column the distance from the
F336                             ;  last LF (or from PROG-1). A place below PROG is in the -n? line buffer:
F336                             ;  line 0, column = its offset there + 1. Numbers other than the cells are
F336                             ;  printed unsigned (pdec), the cells signed (h_num).
F336                             ; 
F336                             ;  The data stack may be one cell past its limit (S, U = 80FEh): the
F336                             ;  report's own cells then reach 8 bytes further down, to 80F6h, into the
F336                             ;  return stack page, so the report runs on a fresh return stack at RSREP
F336                             ;  (80F0h), below those bytes.
F336                             ; =============================================================================
F336   1F 89        ERROR:    TFR   A,B   ; the letter (pmsg and CONOUT keep B)
F338   BD F3 FA               JSR   pmsg   
F33B   0D 0A 45 72 72 A0      FCB   13,10,"Err"," "+80h   
F341   1F 98                  TFR   B,A   
F343   BD FF 03               JSR   CONOUT   
F346   1F 40                  TFR   S,D   ; the return stack's depth, (RSTOP - S) / 2:
F348   43                     COMA      ;   -S-1 ...
F349   53                     COMB      
F34A   C3 81 01               ADDD   #RSTOP+1   ;   ... + RSTOP+1
F34D   44                     LSRA      
F34E   56                     RORB      
F34F   10 CE 80 F0            LDS   #RSREP   
F353   36 06                  PSHU   D   ; kept on the data stack, printed last
F355   BD F3 FA               JSR   pmsg   
F358   20 40 A0               FCB   " @"," "+80h   
F35B                             ; the place: Y counts the lines, X walks, the cell at ,U holds the
F35B                             ; address of the last LF (PROG-1 to begin with)
F35B   10 8E 00 00            LDY   #0   
F35F   8E 82 7F               LDX   #LINEBUF-1   
F362   36 10                  PSHU   X   
F364   8E 82 FF               LDX   #PROG-1   
F367   9C 36                  CMPX   <AT   
F369   24 14                  BHS   lc3   ; the place is below PROG: line 0
F36B   AF C4                  STX   ,U   
F36D   31 21        LC1:      LEAY   1,Y   ; a line
F36F   30 01        LC2:      LEAX   1,X   
F371   9C 36                  CMPX   <AT   
F373   24 0A                  BHS   lc3   
F375   A6 84                  LDA   ,X   
F377   81 0A                  CMPA   #10   
F379   26 F4                  BNE   lc2   
F37B   AF C4                  STX   ,U   
F37D   20 EE                  BRA   lc1   
F37F   DC 36        LC3:      LDD   <AT   
F381   A3 C4                  SUBD   ,U   
F383   ED C4                  STD   ,U   ; the column
F385   36 20                  PSHU   Y   
F387   BD F4 12               JSR   pdec   ; the line
F38A   8D 6E                  BSR   pmsg   
F38C   AC                     FCB   ","+80h   
F38D   BD F4 12               JSR   pdec   ; the column
F390   8D 68                  BSR   pmsg   
F392   0D 8A                  FCB   13,10+80h   
F394                             ; the text at the place
F394   9E 36                  LDX   <AT   
F396   C6 10                  LDB   #16   
F398   A6 80        TX1:      LDA   ,X+   
F39A   27 0E                  BEQ   tx9   
F39C   81 0A                  CMPA   #10   
F39E   27 0A                  BEQ   tx9   
F3A0   81 0D                  CMPA   #13   
F3A2   27 06                  BEQ   tx9   
F3A4   BD F4 2B               JSR   putc   
F3A7   5A                     DECB      
F3A8   26 EE                  BNE   tx1   
F3AA   8D 4E        TX9:      BSR   pmsg   
F3AC   0D 0A 53 74 6B A0      FCB   13,10,"Stk"," "+80h   
F3B2                             ; the data stack: its depth, then its top 8 cells, from Y down to
F3B2                             ; the program"s top cell, which is under the return stack"s depth,
F3B2                             ; at 2,U.
F3B2   31 42                  LEAY   2,U   
F3B4   34 20                  PSHS   Y   ; where the walk ends
F3B6   CC 81 FC               LDD   #DSTOP   
F3B9   A3 E4                  SUBD   ,S   
F3BB   44                     LSRA      
F3BC   56                     RORB      
F3BD   36 06                  PSHU   D   
F3BF   8D 51                  BSR   pdec   ; the depth
F3C1   8D 37                  BSR   pmsg   
F3C3   BA                     FCB   ":"+80h   
F3C4   31 A8 10               LEAY   16,Y   ; past the 8th cell from the top ...
F3C7   10 8C 81 FC            CMPY   #DSTOP   
F3CB   24 08                  BHS   sl1   
F3CD   8D 2B                  BSR   pmsg   ; (there are more than 8)
F3CF   20 2E 2E AE            FCB   " ..","."+80h   
F3D3   20 04                  BRA   sl2   
F3D5   10 8E 81 FC  SL1:      LDY   #DSTOP   ; ... or the whole stack, if no more than 8
F3D9   10 AC E4     SL2:      CMPY   ,S   
F3DC   23 0B                  BLS   sl9   
F3DE   EC A3                  LDD   ,--Y   
F3E0   36 06                  PSHU   D   
F3E2   8D 16                  BSR   pmsg   
F3E4   A0                     FCB   " "+80h   
F3E5   8D 21                  BSR   h_num   
F3E7   20 F0                  BRA   sl2   
F3E9   8D 0F        SL9:      BSR   pmsg   
F3EB   0D 0A 52 74 6E A0      FCB   13,10,"Rtn"," "+80h   
F3F1   8D 1F                  BSR   pdec   ; the depth of the return stack, pushed first
F3F3   8D 05                  BSR   pmsg   
F3F5   0D 8A                  FCB   13,10+80h   
F3F7   7E FF 09               JMP   EXIT   
F3FA                             ; pmsg: print the text after the call, up to and including the character
F3FA                             ; that has bit 7 set (it is printed without it), then return after it.
F3FA   35 10        PMSG:     PULS   X   
F3FC   A6 84        PM1:      LDA   ,X   
F3FE   84 7F                  ANDA   #7Fh   
F400   8D 29                  BSR   putc   
F402   6D 80                  TST   ,X+   
F404   2A F6                  BPL   pm1   
F406   6E 84                  JMP   ,X   
F408                          ENDIF      
F408                             ; "#" prints TOS as a signed decimal number, with no space after it.
F408   6D C4        H_NUM:    TST   ,U   
F40A   2A 06                  BPL   pdec   
F40C   86 2D                  LDA   #"-"   
F40E   8D 1B                  BSR   putc   
F410   8D 5F                  BSR   negt   
F412                             ; pdec: print the top cell as unsigned and drop it, by recursion on /10
F412   CC 00 0A     PDEC:     LDD   #10   
F415   36 06                  PSHU   D   
F417   8D 69                  BSR   udiv   ; NOS = quotient, TOS = digit
F419   37 06                  PULU   D   ; the digit
F41B   34 04                  PSHS   B   
F41D   EC C4                  LDD   ,U   
F41F   27 04                  BEQ   pd1   
F421   8D EF                  BSR   pdec   
F423   20 02                  BRA   pd2   
F425   33 42        PD1:      LEAU   2,U   ; drop the zero quotient
F427   35 02        PD2:      PULS   A   
F429   8B 30                  ADDA   #"0"   ; and fall into putc
F42B   7E FF 03     PUTC:     JMP   CONOUT   
F42E                             ; ---- more arithmetic ---------------------------------------------------------
F42E   EC C1        H_AND:    LDD   ,U++   
F430   A4 C4                  ANDA   ,U   
F432   E4 41                  ANDB   1,U   
F434   20 04                  BRA   st   
F436   EC C1        H_ADD:    LDD   ,U++   
F438   E3 C4                  ADDD   ,U   
F43A   ED C4        ST:       STD   ,U   
F43C   39                     RTS      
F43D                             ; "-" has two jobs: directly before a digit it starts a negative number.
F43D   BD F0 B4     H_SUB:    JSR   isdig   
F440   25 2C                  BLO   negnum   
F442   EC 42                  LDD   2,U   
F444   A3 C1                  SUBD   ,U++   
F446   20 F2                  BRA   st   
F448                             ; ---- the tail ---------------------------------------------------------------
F448                             ; "/" is the last handler, so what follows its first byte may lie past the
F448                             ; second range: the divide itself and the routines after it.
F448                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
F448                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
F448                             ; of a. Unchecked, dividing by zero returns two cells of no meaning; checked,
F448                             ; it stops with Z, both operands still on the stack.
F448                H_DIV:       
F448                          IF   CHECKED   
F448   EC C4                  LDD   ,U   
F44A   10 27 FE DB            LBEQ   e_zero   
F44E                          ENDIF      
F44E   A6 42                  LDA   2,U   
F450   34 02                  PSHS   A   ; a's sign: for r
F452   A8 C4                  EORA   ,U   
F454   34 02                  PSHS   A   ; a xor b: for q
F456   30 42                  LEAX   2,U   
F458   8D 22                  BSR   absx   ; |a|
F45A   1F 31                  TFR   U,X   
F45C   8D 1E                  BSR   absx   ; |b|
F45E   8D 22                  BSR   udiv   ; NOS = q, TOS = r
F460   30 42                  LEAX   2,U   
F462   6D E0                  TST   ,S+   
F464   2A 02                  BPL   dv1   
F466   8D 0B                  BSR   negx   ; q's sign
F468   6D E0        DV1:      TST   ,S+   
F46A   2A 0F                  BPL   ng9   
F46C   20 03                  BRA   negt   ; r's sign
F46E   BD F0 BB     NEGNUM:   JSR   rdnum   ; a negative literal: read it, then negate
F471   1F 31        NEGT:     TFR   U,X   
F473   EC 84        NEGX:     LDD   ,X   ; negx: negate the cell at X
F475   40                     NEGA      
F476   50                     NEGB      
F477   82 00                  SBCA   #0   
F479   ED 84                  STD   ,X   
F47B   39           NG9:      RTS      
F47C   6D 84        ABSX:     TST   ,X   ; absx: negate the cell at X if negative
F47E   2A FB                  BPL   ng9   
F480   20 F1                  BRA   negx   
F482                             ; udiv: unsigned divide, in place. The dividend is the NOS cell and the
F482                             ; divisor the TOS cell, both <= 8000h; the NOS cell becomes the quotient and
F482                             ; the TOS cell the remainder. The remainder is built in D (always < the
F482                             ; divisor, so 2R+1 fits in 16 bits).
F482                             ; Dividing by 2 is one shift (the spec wants that fast).
F482   EC C4        UDIV:     LDD   ,U   
F484   83 00 02               SUBD   #2   
F487   26 07                  BNE   ud0   
F489   64 42                  LSR   2,U   
F48B   66 43                  ROR   3,U   ; the quotient
F48D   59                     ROLB      ; the remainder: the bit that fell out (D was 0)
F48E   20 18                  BRA   ud3   
F490   8E 00 10     UD0:      LDX   #16   
F493   4F                     CLRA      
F494   5F                     CLRB      
F495   68 43        UD1:      ASL   3,U   
F497   69 42                  ROL   2,U   ; the dividend's top bit ...
F499   59                     ROLB      
F49A   49                     ROLA      ; ... into the remainder
F49B   10 A3 C4               CMPD   ,U   
F49E   25 04                  BLO   ud2   
F4A0   A3 C4                  SUBD   ,U   
F4A2   6C 43                  INC   3,U   ; a quotient bit
F4A4   30 1F        UD2:      LEAX   -1,X   
F4A6   26 ED                  BNE   ud1   
F4A8   ED C4        UD3:      STD   ,U   
F4AA   39                     RTS      
F4AB                          IF   CHECKED   
F4AB                             ; getk: a key held back by the break check goes first; then the host's KEY.
F4AB   96 34        GETK:     LDA   <KEYBUF   
F4AD   27 04                  BEQ   gk1   
F4AF   0F 34                  CLR   <KEYBUF   
F4B1   4D                     TSTA      
F4B2   39                     RTS      
F4B3   7E FF 06     GK1:      JMP   KEY   
F4B6                          ENDIF      
F4B6                IMGEND:      


