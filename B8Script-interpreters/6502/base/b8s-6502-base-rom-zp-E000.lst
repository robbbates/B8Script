E458                             ; udiv (QK): as the macro UDIV, and any power of two is shifts: 2, and 32,
E458                             ; 64, 256 and the like, which fixed point and byte work use all the time.
E458   A9 00        UDIV:     LDA   #0   
E45A   95 FE                  STA   0FEh,X   
E45C   95 FF                  STA   0FFh,X   
E45E   A4 05                  LDY   D0   
E460   A5 06                  LDA   D1   
E462   D0 12                  BNE   uq1   ; 256 and up
E464   98                     TYA      
E465   F0 38                  BEQ   ud0   ; by 0: the long way (it means nothing anyway)
E467   88                     DEY      
E468   98                     TYA      
E469   25 05                  AND   D0   
E46B   D0 32                  BNE   ud0   ; not a power of two
E46D   98                     TYA      ; by 2^k below 256: r = a & (2^k - 1),
E46E   35 00                  AND   0,X   
E470   95 FE                  STA   0FEh,X   
E472   A5 05                  LDA   D0   ;   and q = a >> k
E474   D0 1E                  BNE   uq2   ; always
E476   98           UQ1:      TYA      
E477   D0 26                  BNE   ud0   ; not a power of two
E479   A4 06                  LDY   D1   
E47B   88                     DEY      
E47C   98                     TYA      
E47D   25 06                  AND   D1   
E47F   D0 1E                  BNE   ud0   ; not a power of two
E481   98                     TYA      ; by 2^k, 256 and up: r = a & (2^k - 1),
E482   35 01                  AND   1,X   
E484   95 FF                  STA   0FFh,X   
E486   B5 00                  LDA   0,X   
E488   95 FE                  STA   0FEh,X   
E48A   B5 01                  LDA   1,X   ;   and q = (a >> 8) >> (k - 8)
E48C   95 00                  STA   0,X   
E48E   A9 00                  LDA   #0   
E490   95 01                  STA   1,X   
E492   A5 06                  LDA   D1   
