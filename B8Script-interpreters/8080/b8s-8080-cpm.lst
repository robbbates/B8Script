0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Intel 8080
0000                             ;  Spec: docs/b8script.md (2026-11-21).
0000                             ;  Design follows the Z80 interpreter (z80/b8s-z80.asm), with 8080 opcodes
0000                             ;  only.
0000                             ; 
0000                             ;  Two switches, set in the two EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    CHECKED  0 = no checks (spec: the programmer is responsible)
0000                             ;             1 = starts with every variable at 0 and every word undefined,
0000                             ;                 and stops on every error in the spec's table (and Ctrl-C)
0000                             ;                 with a four-line report: the letter and the place as line
0000                             ;                 and column, the text there, and both stacks. See `error`.
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), I8080 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   1   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   0   ; 1 = checked build
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the 8080"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  The return stack pointer has no register (the 8080 has no spare pair): it
0000                             ;  is the RAM word RSP. Only rpop, rpushd and ")" (and the checks) touch it.
0000                             ; 
0000                             ;  One-byte calls. The routines used most are reached with RST, one byte
0000                             ;  instead of three. (asm80 wants the vector number: RST 1 = RST 08h.)
0000                             ; 
0000                             ;    RST 1  08h  rpop    pop the return stack into HL
0000                             ;    RST 3  18h  drop    drop TOS, then next character     (ends a handler)
0000                             ;    RST 4  20h  neg16   HL = -HL
0000                             ;    RST 5  28h  putc    print A
0000                             ;    RST 6  30h  next    next character                    (ends a handler)
0000                             ; 
0000                             ;  RST 3 and RST 6 never return: an RST is a CALL, so the first thing each
0000                             ;  of them does is POP D to throw the return address away.
0000                             ; 
0000                             ;  The CP/M build can't own page zero, so the block from `vecs` to `vecend`
0000                             ;  (image addresses 0108h-0133h) is copied to 0008h-0033h when it starts. The
0000                             ;  code in that block has no jumps inside itself, so it works at either place.
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; 
0000                             ;  What the 8080 lacks, and what replaces it: no JR (JMP/Jcc), no DJNZ, no
0000                             ;  SBC HL (byte-wise SUB/SBB, or negate and DAD), no shifts on register pairs
0000                             ;  (DAD H doubles; RAL/RAR through A), no LDIR/CPIR (small loops).
0000                             ; -----------------------------------------------------------------------------
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (the top four bytes of the page are spare,
0000                             ;             so a full stack runs two bytes into the page below)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch, interpreter variables in the gaps, and the -n? line buffer
0000                             ;             at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack has a guard band: the data stack can
0000                             ;  overrun by a cell or two (and the calls made while it is full, the error
0000                             ;  report's included) into the top 32 bytes of the return-stack page, which
0000                             ;  are never used, and the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
0000                BDOS:     EQU   0005h   
0000                EXIT:     EQU   0000h   ; warm boot
0000                BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IFN   CPM   
                                 ; ---- generic machine: edit these to suit -----------------------------------
                    KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
                                 ;   waiting. The zero flag must match A
                                 ;   (end the routine with ORA A / RET).
                    CONOUT:   EQU   0FF03h   ; print the character in A
                    EXIT:     EQU   0FF09h   ; where to go when the program ends
                                 ;   KEY and CONOUT must preserve BC, DE and HL.
                    RSPAGE:   EQU   80h   ; 8000h return stack
                    DSPAGE:   EQU   81h   ; 8100h data stack
                    LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
                    PROG:     EQU   8300h   ; where the loader puts the program text
                    HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
                    BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer
0000                RSP:      EQU   LET+34h   ; gap after Z: the return stack pointer;
0000                KEYBUF:   EQU   LET+36h   ;   a held-back key;
0000                NPEND:    EQU   LET+38h   ;   minus the address of the program's end
0000                             ;   (the heap"s first byte), for the checked "_'
0000                LBHDR:    EQU   LET+7Eh   ; CP/M BDOS 10 header: max, count
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FCh   ; empty data stack. The four bytes above it
0000                             ; are spare: a character can pop two cells
0000                             ; too many before the checked build sees it,
0000                             ; and the next call must not land on the
0000                             ; letter cells.
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is the start of the .COM file, and 0108h-0133h is also copied to
0000                             ;  page zero (see the header).
0000                             ; =============================================================================
0100                          .ORG   BASE   
0100                          IF   1-(1-CPM)*CHECKED   
0100   31 FC 06               LXI   SP,DSTOP   ; 00  reset, or the start of the .COM file
0103                          ENDIF      
0103   C3 F2 03               JMP   start   ; In the checked generic build this is at 0000h
0106                             ;   (and `start` sets SP): its first byte, C3h,
0106                             ;   is what an undefined word runs into, as
0106                             ;   CP/M's own JMP at 0000h is in a .COM: e_hi.
0106                          IF   (1-CPM)*CHECKED   
                              DB   0,0,0   ; 03  spare
0106                          ENDIF      
0106   CF           RDROP:    RST   1   ; 06  drop the top of the return stack, then
0107   DF                     RST   3   ;     drop TOS (a spent flag) and go on
0108                VECS:        
0108                             ; ---- RST 1: rpop: pop the return stack into HL (DE is lost) -----------------
0108   2A 34 07     RPOP:     LHLD   RSP   ; 08
010B   5E                     MOV   E,M   
010C   23                     INX   H   
010D   56                     MOV   D,M   
010E   23                     INX   H   
010F   22 34 07               SHLD   RSP   
0112   EB                     XCHG      
0113   C9                     RET      ; 13  (so RST 2 is not used)
0114   EB           H_TOR:    XCHG      ; 14  "{" TOS to the return stack; rpushd
0115   C3 AE 01               JMP   rpushd   ;     brings up the new TOS
0118                             ; ---- RST 3: drop TOS, then next ---------------------------------------------
0118   D1           RST18:    POP   D   ; 18  discard the RST's return address
0119   E1                     POP   H   ;     new TOS = NOS
011A   C3 34 01               JMP   next0   
011D   E5           H_FROMR:   PUSH   H   ; 1D  "}" return stack to TOS
011E   CF                     RST   1   
011F   F7                     RST   6   
0120                             ; ---- RST 4: neg16: HL = -HL (keeps BC, DE) ----------------------------------
0120   AF           NEG16:    XRA   A   ; 20
0121   95                     SUB   L   
0122   6F                     MOV   L,A   
0123   9F                     SBB   A   
0124   94                     SUB   H   
0125   67                     MOV   H,A   
0126   C9                     RET      
0127   E9           JPHL:     PCHL      ; 27  (for the machine-code call)
0128                             ; ---- RST 5: putc: print A (keeps BC, DE, HL) --------------------------------
0128                RST28:       
0128                          IFN   CPM   
                    PUTC:     JMP   CONOUT   ; 28
0128                          ENDIF      
0128                          IF   CPM   
0128   C3 E4 03               JMP   putc   ; 28
012B                          ENDIF      
012B                             ; exec: "`" with no hex digit after it: call the machine code at TOS. It
012B                             ; returns here, with its top cell on the stack: that becomes the new TOS.
012B   CD 27 01     EXEC:     CALL   jphl   ; 2B
012E   E1                     POP   H   
012F   F7                     RST   6   
0130                             ; ---- RST 6: next character --------------------------------------------------
0130   D1           RST30:    POP   D   ; 30  discard the RST's return address
0131                          IF   CPM   
0131   C3 34 01               JMP   next0   ; (this copy runs in page zero)
0134                          ENDIF      
0134                VECEND:      
0134                             ; =============================================================================
0134                             ;  The inner loop: read one character and sort it by range.
0134                             ; 
0134                             ;    00h          end of program
0134                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0134                             ;    30h-39h      digit: read a whole number
0134                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0134                             ;    61h-7Ah      a-z: push the address of that letter's cell
0134                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0134                             ; =============================================================================
0134                NEXT0:       
0134                          IF   CHECKED   
                              CALL   chkstk   ; both stacks are checked once per character
0134                          ENDIF      
0134   0A                     LDAX   B   
0135   03                     INX   B   
0136   D6 21                  SUI   21h   ; A = c - 21h
0138   DA 78 01               JC   ctl   ; c < 21h: NUL ends, the rest are ignored
013B   FE 0F                  CPI   0Fh   
013D   DA 68 01               JC   punct   ; 21h-2Fh: PTAB index 0-14
0140   D6 0F                  SUI   0Fh   ; A = c - 30h
0142   FE 0A                  CPI   0Ah   
0144   DA 2B 03               JC   digit   ; 30h-39h
0147   FE 11                  CPI   11h   
0149   DA 66 01               JC   p3a   ; 3Ah-40h
014C   D6 11                  SUI   11h   ; A = c - 41h
014E   FE 1A                  CPI   1Ah   
0150   DA A4 01               JC   upper   ; 41h-5Ah: A = letter index 0-25
0153   FE 20                  CPI   20h   
0155   DA 64 01               JC   p5b   ; 5Bh-60h
0158   FE 3A                  CPI   3Ah   
015A   DA 9E 01               JC   lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
015D   FE 3E                  CPI   3Eh   
015F                          IF   CHECKED   
                              JZ   next0   ; 7Fh, DEL: ignored
                              JNC   e_hi   ; 80h-FFh: reserved
015F                          ENDIF      
015F                          IF   1-CHECKED   
015F   D2 34 01               JNC   next0   ; 7Fh-FFh: ignored
0162                          ENDIF      
0162   D6 1A                  SUI   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
0164   D6 09        P5B:      SUI   9   ; 5Bh-60h: -4 in all, index 22-27
0166   C6 05        P3A:      ADI   5   ; 3Ah-40h: index 15-21
0168                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
0168                             ; untouched, and A, DE free.
0168   C6 0B        PUNCT:    ADI   PTAB & 0FFh   ; PTAB never crosses a page
016A   5F                     MOV   E,A   
016B   16 03                  MVI   D,PTAB / 256   
016D   FE 21                  CPI   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
016F   1A                     LDAX   D   
0170   5F                     MOV   E,A   ; the handler's low byte
0171                          IFN   CPM   
                              MVI   A,0   
                              RAL      ; its page: 0 + carry
0171                          ENDIF      
0171                          IF   CPM   
0171   3E 01                  MVI   A,1   
0173   CE 00                  ACI   0   ; its page: 1 + carry
0175                          ENDIF      
0175   57                     MOV   D,A   
0176   D5                     PUSH   D   ; jump to it; the stack is balanced again
0177   C9                     RET      ;   when the handler starts
0178                             ; ctl: characters below 21h. A = c - 21h.
0178   C6 21        CTL:      ADI   21h   ; back to c; zero only for NUL
017A   C2 34 01               JNZ   next0   ; the rest are ignored
017D   C3 00 00     ENDPROG:   JMP   EXIT   ; the program has ended
0180                             ; =============================================================================
0180                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
0180                             ;  (00bbIGFuZCA= are up among the RST routines.)
0180                             ; =============================================================================
0180   D1           H_XOR:    POP   D   
0181   7C                     MOV   A,H   
0182   AA                     XRA   D   
0183   67                     MOV   H,A   
0184   7D                     MOV   A,L   
0185   AB                     XRA   E   
0186   6F                     MOV   L,A   
0187   F7                     RST   6   
0188   D1           H_OR:     POP   D   
0189   7C                     MOV   A,H   
018A   B2                     ORA   D   
018B   67                     MOV   H,A   
018C   7D                     MOV   A,L   
018D   B3                     ORA   E   
018E   6F                     MOV   L,A   
018F   F7                     RST   6   
0190   E7           H_NOT:    RST   4   ; ~x = -x - 1
0191   2B                     DCX   H   
0192   F7                     RST   6   
0193                             ; "_" ( n -- addr ): the heap pointer moves by n, a signed count (the add is
0193                             ; the same either way); TOS is the old pointer.
0193   EB           H_ALLOC:   XCHG      
0194   2A 7C 07               LHLD   HEAP   
0197   E5                     PUSH   H   
0198   19                     DAD   D   ; the new top
0199                          IF   CHECKED   
                              CALL   chkhp   
0199                          ENDIF      
0199   22 7C 07               SHLD   HEAP   
019C   E1                     POP   H   
019D   F7                     RST   6   
019E                             ; ---- the letters and digits --------------------------------------------------
019E                             ; a-z: push the cell's address (the cell is the variable)
019E   E5           LOWER:    PUSH   H   
019F   87                     ADD   A   
01A0   6F                     MOV   L,A   
01A1   26 07                  MVI   H,LETPAGE   
01A3   F7                     RST   6   
01A4                             ; A-Z: call the word. The return address (the IP after the letter) goes on
01A4                             ; the return stack, and the IP becomes the address in the letter's cell.
01A4   E5           UPPER:    PUSH   H   ; keep TOS: rpushd pops it back
01A5   87                     ADD   A   
01A6   6F                     MOV   L,A   
01A7   26 07                  MVI   H,LETPAGE   ; HL -> cell
01A9   50                     MOV   D,B   
01AA   59                     MOV   E,C   ; DE = the return address
01AB   4E                     MOV   C,M   
01AC   23                     INX   H   
01AD   46                     MOV   B,M   ; IP = the word's body, and fall into rpushd
01AE                             ; rpushd: push DE on the return stack, then pop TOS off the data stack and
01AE                             ; go on. Every push of the return stack ends here: for a word call the cell
01AE                             ; popped is the TOS that upper parked; for "(" and "{" it is the cell under
01AE                             ; the one that was used up.
01AE                RPUSHD:      
01AE                          IF   CHECKED   
                              CALL   chkbrk   ; Ctrl-C is checked at every word call, block
01AE                          ENDIF      ;   entry, loop-back and "{"
01AE   2A 34 07               LHLD   RSP   
01B1   2B                     DCX   H   
01B2   72                     MOV   M,D   
01B3   2B                     DCX   H   
01B4   73                     MOV   M,E   
01B5   22 34 07               SHLD   RSP   
01B8   E1                     POP   H   
01B9   F7                     RST   6   
01BA                             ; ---- machine code: the grave -----------------------------------------------
01BA                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
01BA                             ; are stored from addr until a non-hex character; then a RET (C9h) is
01BA                             ; written and its address is left. An odd last digit is consumed and dropped.
01BA                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
01BA                             ; code is entered by CALL with the data stack above the return address; it
01BA                             ; must keep BC, and on return the top cell becomes the new TOS.
01BA   CD CF 03     H_GRAVE:   CALL   hexc   
01BD   D2 2B 01               JNC   exec   
01C0   87           HX1:      ADD   A   
01C1   87                     ADD   A   
01C2   87                     ADD   A   
01C3   87                     ADD   A   
01C4   57                     MOV   D,A   ; the high digit
01C5   CD CF 03               CALL   hexc   
01C8   D2 D4 01               JNC   hx2   ; odd digit: consumed and dropped
01CB   B2                     ORA   D   
01CC   77                     MOV   M,A   
01CD   23                     INX   H   
01CE   CD CF 03               CALL   hexc   
01D1   DA C0 01               JC   hx1   
01D4   36 C9        HX2:      MVI   M,0C9h   ; (never range-checked: the spec says so)
01D6   F7                     RST   6   
01D7                             ; ---- where the two pages meet ----------------------------------------------
01D7                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
01D7                             ; are in falling code order for this), and where exactly differs between the
01D7                             ; builds: NPG1 follows. Every handler below these four must start in the
01D7                             ; second page, and every one above in the first; chktab.py checks both.
01D7                             ; "]" returns: pop an address and jump to it. TOS is parked on the stack
01D7                             ; while rpop uses HL, and the drop at the end brings it back.
01D7   E5           H_RET:    PUSH   H   
01D8   CF           RET2:     RST   1   
01D9   44                     MOV   B,H   
01DA   4D                     MOV   C,L   
01DB   DF                     RST   3   
01DC                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
01DC                             ; drops the block start, "]" returns. No closer at all ends the program.
01DC                             ; The flag stays in HL as the spent cell that rdrop and ret2 drop.
01DC   7C           H_BREAK:   MOV   A,H   
01DD   B5                     ORA   L   
01DE   CA C1 02               JZ   h_drop   ; false: just drop the flag
01E1   CD 9B 03               CALL   skip   
01E4   B7                     ORA   A   ; skip returns 0 for ")"
01E5   C2 D8 01               JNZ   ret2   
01E8   C3 06 01               JMP   rdrop   
01EB                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
01EB                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
01EB                             ; the body"s address instead. Either way it then skips to the matching "]'.
01EB                             ; (The unchecked build takes anything that is not a letter as the space; the
01EB                             ; checked build stops on it.)
01EB   0A           H_DEF:    LDAX   B   
01EC   03                     INX   B   
01ED   D6 41                  SUI   "A"   ; a letter gives 0-25 or 32-57: lowercase
01EF   5F                     MOV   E,A   ;   lands 64 bytes up
01F0   E6 DF                  ANI   0DFh   ; fold case
01F2   FE 1A                  CPI   26   
01F4   D2 04 02               JNC   def2   ; not a letter
01F7   7B                     MOV   A,E   
01F8   87                     ADD   A   
01F9   5F                     MOV   E,A   
01FA   16 07                  MVI   D,LETPAGE   ; DE -> cell
01FC   79                     MOV   A,C   
01FD   12                     STAX   D   
01FE   1C                     INR   E   
01FF   78                     MOV   A,B   
0200   12                     STAX   D   
0201   C3 07 02               JMP   skipnx   
0204                DEF2:        
0204                          IF   CHECKED   
                              MOV   A,E   
                              CPI   " "-"A"+256   
                              JNZ   e_brack   ; anything but a letter or a space
0204                          ENDIF      
0204   E5                     PUSH   H   ; an anonymous block: push its address
0205   60                     MOV   H,B   
0206   69                     MOV   L,C   
0207                SKIPNX:      
0207                          IF   CHECKED   
                              DCX   B   ; back onto the letter, so that skip finds its
0207                          ENDIF      ;   opener, the "[", just before where it starts
0207   CD 9B 03     SKIPO:    CALL   skip   
020A   F7                     RST   6   
020B   5E           H_FETCH:   MOV   E,M   ; "@"
020C   23                     INX   H   
020D   56                     MOV   D,M   
020E   EB                     XCHG      
020F   F7                     RST   6   
0210                             ; =============================================================================
0210                             ;  Handlers that must start in the image's second page.
0210                             ;  "?" is the last (with "," inside it in the unchecked build), so its long
0210                             ;  tail may run past that page.
0210                             ; =============================================================================
0210                             ; ---- flow control ----------------------------------------------------------
0210                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
0210                             ; the matching ")".
0210   7C           H_OPEN:   MOV   A,H   
0211   B5                     ORA   L   
0212   E1                     POP   H   
0213   CA 07 02               JZ   skipo   
0216   E5                     PUSH   H   ; (rpushd pops it again)
0217   50                     MOV   D,B   
0218   59                     MOV   E,C   ; the block starts at the IP
0219   C3 AE 01               JMP   rpushd   
021C                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
021C                             ; drops it and carries on.
021C   7C           H_CLOSE:   MOV   A,H   
021D   B5                     ORA   L   
021E   CA 06 01               JZ   rdrop   
0221   CF                     RST   1   ; pop the block start ...
0222   44                     MOV   B,H   
0223   4D                     MOV   C,L   ; ... jump to it ...
0224   EB                     XCHG      
0225   C3 AE 01               JMP   rpushd   ; ... and push it back (which drops the flag)
0228                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
0228                             ; "-" has two jobs: directly before a digit it starts a negative number.
0228   0A           H_SUB:    LDAX   B   
0229   D6 30                  SUI   "0"   
022B   FE 0A                  CPI   10   
022D   DA 31 03               JC   negnum   
0230   E7                     RST   4   ; a - b = a + (-b): fall into "+"
0231   D1           H_ADD:    POP   D   
0232   19                     DAD   D   
0233   F7                     RST   6   
0234   D1           H_AND:    POP   D   
0235   7C                     MOV   A,H   
0236   A2                     ANA   D   
0237   67                     MOV   H,A   
0238   7D                     MOV   A,L   
0239   A3                     ANA   E   
023A   6F                     MOV   L,A   
023B   F7                     RST   6   
023C                             ; Signed compares. Both are "DE < HL" for the right pair: > swaps the two
023C                             ; cells first (XTHL), < doesn't. There is no overflow flag, so the signed
023C                             ; answer is the unsigned borrow of DE - HL, flipped when the signs differ.
023C                             ; SBB A turns a carry into -1 or 0 with no branch.
023C   E3           H_GT:     XTHL      ; a > b  is  b < a
023D   D1           H_LT:     POP   D   ; a < b: DE = a, HL = b
023E   7B                     MOV   A,E   
023F   95                     SUB   L   
0240   7A                     MOV   A,D   
0241   9C                     SBB   H   
0242   9F                     SBB   A   ; A = -1 if DE < HL unsigned
0243   6F                     MOV   L,A   
0244   7C                     MOV   A,H   
0245   AA                     XRA   D   
0246   17                     RAL      ; carry = the signs differ
0247   9F                     SBB   A   
0248   AD                     XRA   L   ; flip when they do
0249   67                     MOV   H,A   
024A   6F                     MOV   L,A   
024B   F7                     RST   6   
024C   D1           H_EQ:     POP   D   
024D   7D                     MOV   A,L   
024E   AB                     XRA   E   
024F   6F                     MOV   L,A   
0250   7C                     MOV   A,H   
0251   AA                     XRA   D   
0252   B5                     ORA   L   ; zero if equal
0253   D6 01                  SUI   1   ; carry only for zero
0255   9F                     SBB   A   
0256   67                     MOV   H,A   
0257   6F                     MOV   L,A   
0258   F7                     RST   6   
0259                             ; "*": shift-and-add on the multiplier's low bit, so it stops as soon as the
0259                             ; multiplier is used up; only the low 16 bits are kept.
0259   D1           H_MUL:    POP   D   ; DE = multiplicand
025A   C5                     PUSH   B   
025B   44                     MOV   B,H   
025C   4D                     MOV   C,L   ; BC = multiplier
025D   21 00 00               LXI   H,0   
0260   78           MUL1:     MOV   A,B   
0261   B7                     ORA   A   ; clear carry
0262   1F                     RAR      
0263   47                     MOV   B,A   
0264   79                     MOV   A,C   
0265   1F                     RAR      
0266   4F                     MOV   C,A   ; BC >> 1, carry = the bit shifted out
0267   D2 6B 02               JNC   mul2   
026A   19                     DAD   D   
026B   EB           MUL2:     XCHG      
026C   29                     DAD   H   ; multiplicand << 1
026D   EB                     XCHG      
026E   78                     MOV   A,B   
026F   B1                     ORA   C   
0270   C2 60 02               JNZ   mul1   
0273   C1                     POP   B   
0274   F7                     RST   6   
0275                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
0275                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
0275                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
0275                             ; stops on it.
0275                H_DIV:       
0275                          IF   CHECKED   
                              MOV   A,H   
                              ORA   L   
                              JZ   e_zero   
0275                          ENDIF      
0275   D1                     POP   D   ; DE = a, HL = b
0276   C5                     PUSH   B   
0277   7A                     MOV   A,D   
0278   B7                     ORA   A   
0279   F5                     PUSH   PSW   ; S flag = sign of a (for r)
027A   AC                     XRA   H   
027B   F5                     PUSH   PSW   ; S flag = sign of q
027C   7C                     MOV   A,H   
027D   B7                     ORA   A   
027E   FC 20 01               CM   neg16   ; HL = |b|
0281   EB                     XCHG      
0282   7C                     MOV   A,H   
0283   B7                     ORA   A   
0284   FC 20 01               CM   neg16   ; HL = |a|, DE = |b|
0287   CD 4E 03               CALL   udiv   ; HL = q, BC = r
028A   F1                     POP   PSW   
028B   FC 20 01               CM   neg16   ; q's sign
028E   EB                     XCHG      ; DE = q
028F   60                     MOV   H,B   
0290   69                     MOV   L,C   ; HL = r
0291   F1                     POP   PSW   
0292   FC 20 01               CM   neg16   ; r's sign
0295   C1                     POP   B   
0296   D5                     PUSH   D   ; q under r
0297   F7                     RST   6   
0298                             ; ---- stack and storage -----------------------------------------------------
0298   E5           H_DUP:    PUSH   H   ; ":"
0299   F7                     RST   6   
029A   E3           H_SWAP:   XTHL      ; "%"
029B   F7                     RST   6   
029C                             ; (The checked build tests the address before it takes the value off the
029C                             ; stack, so that an error report shows both.)
029C                H_STORE:      ; "!" ( n addr -- )
029C                          IF   CHECKED   
                              CALL   chkst   
029C                          ENDIF      
029C   D1                     POP   D   
029D   73                     MOV   M,E   
029E   23                     INX   H   
029F   72                     MOV   M,D   
02A0   DF                     RST   3   
02A1                H_CSTORE:      ; "." ( c addr -- )
02A1                          IF   CHECKED   
                              CALL   chkst   
02A1                          ENDIF      
02A1   D1                     POP   D   
02A2   73                     MOV   M,E   
02A3   DF                     RST   3   
02A4                             ; ---- console ---------------------------------------------------------------
02A4                             ; 22h pushes the address of the text after it and skips the string.
02A4   E5           H_STR:    PUSH   H   
02A5   60                     MOV   H,B   
02A6   69                     MOV   L,C   
02A7   CD C2 03               CALL   skipstr   
02AA                          IF   CHECKED   
                              ORA   A   ; 0: the text ran out before the closing quote
                              JZ   e_quote   
02AA                          ENDIF      
02AA   F7                     RST   6   
02AB                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character
02AB                             ; clears that character"s bit 6 (/M is CR, /` is space; "/" and ""' have no
02AB                             ; bit 6, so // and /" give themselves).
02AB                          IF   1-CHECKED   
02AB   7E           H_PRINT:   MOV   A,M   
02AC   23                     INX   H   
02AD   FE 22                  CPI   22h   
02AF   CA C1 02               JZ   h_drop   
02B2   FE 2F                  CPI   "/"   
02B4   C2 BB 02               JNZ   pr1   
02B7   7E                     MOV   A,M   
02B8   23                     INX   H   
02B9   E6 BF                  ANI   0BFh   
02BB   EF           PR1:      RST   5   
02BC   C3 AB 02               JMP   h_print   
02BF                          ENDIF      
02BF                          IF   CHECKED   
                                 ; (The checked build has the loop as a routine, prstr, which the error
                                 ; report uses too. The address is kept on the stack meanwhile: a report
                                 ; shows the stack as it was before the "$".)
                    H_PRINT:   PUSH   H   
                              CALL   prstr   
                              POP   D   
                              RST   3   
02BF                          ENDIF      
02BF   7D           H_EMIT:   MOV   A,L   ; "'"
02C0   EF                     RST   5   
02C1   DF           H_DROP:   RST   3   ; ";" is this one byte
02C2                             ; "#" prints TOS as a signed decimal number, with no space after it.
02C2   C5           H_NUM:    PUSH   B   
02C3   CD 80 03               CALL   psgn   
02C6   C1                     POP   B   
02C7   DF                     RST   3   
02C8                          IF   CHECKED   ; (the checked build has no room to start ","
                    H_CFETCH:   MOV   L,M   ;   as late as the unchecked one does: see
                              MVI   H,0   ;   the end of "?")
                              RST   6   
02C8                          ENDIF      
02C8                             ; "?" ( n -- c ) or ( -n -- addr )
02C8                             ;   n > 0: wait about n ms for a key; 0 if none came
02C8                             ;   n = 0: wait for a key
02C8                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
02C8                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
02C8   7C           H_KEY:    MOV   A,H   
02C9   B7                     ORA   A   
02CA   FA EA 02               JM   line   
02CD   1E 28        KT1:      MVI   E,MSLOOP   ; one millisecond, roughly
02CF   CD E2 03     KT2:      CALL   getk   
02D2   C2 E6 02               JNZ   kt3   
02D5   1D                     DCR   E   
02D6   C2 CF 02               JNZ   kt2   
02D9   7C                     MOV   A,H   ; 0? never counts down: it waits
02DA   B5                     ORA   L   
02DB   CA CD 02               JZ   kt1   
02DE   2B                     DCX   H   
02DF   7C                     MOV   A,H   
02E0   B5                     ORA   L   
02E1   C2 CD 02               JNZ   kt1   ; A = 0 if the time ran out
02E4                          IF   1-CHECKED   
02E4   FE                     DB   0FEh   ; (CPI: steps over the one byte of ",")
02E5   7E           H_CFETCH:   MOV   A,M   ; "," shares "?"s ending: A becomes TOS
02E6                          ENDIF      
02E6   6F           KT3:      MOV   L,A   
02E7   26 00                  MVI   H,0   
02E9   F7                     RST   6   
02EA                          IF   CPM   
02EA                             ; CP/M: BDOS 10 does the editing (the spec allows the platform's
02EA                             ; own line editor). It doesn't store the CR, so it is added here.
02EA   11 7F 00     LINE:     LXI   D,127   ; TOS is minus the count: adding 127 carries
02ED   19                     DAD   D   ;   only for 1 to 127, and leaves 127 - count
02EE   9F                     SBB   A   
02EF   A5                     ANA   L   ; (0 for a count that is too big)
02F0   EE 7F                  XRI   127   ; A = the count, 127 at most
02F2   32 7E 07               STA   LBHDR   
02F5   C5                     PUSH   B   
02F6   11 7E 07               LXI   D,LBHDR   
02F9   0E 0A                  MVI   C,10   
02FB   CD 05 00               CALL   BDOS   
02FE   C1                     POP   B   
02FF   21 7F 07               LXI   H,LBHDR+1   
0302   7E                     MOV   A,M   ; the count typed (0-127)
0303   2C                     INR   L   ; HL = LINEBUF, whose low byte is 80h:
0304   85                     ADD   L   ;   adding the count to L can't carry
0305   6F                     MOV   L,A   
0306   36 0D                  MVI   M,13   
0308   2E 80                  MVI   L,LINEBUF & 0FFh   
030A   F7                     RST   6   
030B                          ENDIF      
030B                          IFN   CPM   
                                 ; Generic: Backspace takes the last character back (and is echoed as
                                 ; it is), CR ends (stored, not echoed), every other key is stored and
                                 ; echoed until the line is full. The line buffer starts at offset 80h
                                 ; of its page, so L alone is the place in the line: D holds the L of
                                 ; a full line.
                    LINE:     LXI   D,127   ; TOS is minus the count: adding 127 carries
                              DAD   D   ;   only for 1 to 127, and leaves 127 - count
                              SBB   A   
                              ANA   L   ; (0 for a count that is too big)
                              CMA      
                              MOV   D,A   ; D = the L of a full line: 80h + count, FFh
                                 ;   at most
                              LXI   H,LINEBUF   
                    LN2:      CALL   getk   
                              JZ   ln2   
                              CPI   13   
                              JZ   ln5   
                              CPI   8   
                              JZ   ln4   
                              MOV   E,A   
                              MOV   A,L   
                              CMP   D   
                              JZ   ln2   ; full
                              MOV   M,E   
                              INR   L   
                              MOV   A,E   
                    LN3:      RST   5   
                              JMP   ln2   
                    LN4:      DCR   L   ; Backspace: one back, and echo it,
                              JM   ln3   ;   unless the line was empty (L left the
                              INR   L   ;   upper half of the page)
                              JMP   ln2   
                    LN5:      MOV   M,A   ; the CR
                              MVI   L,LINEBUF & 0FFh   
                              RST   6   
030B                          ENDIF      
030B                             ; =============================================================================
030B                             ;  Dispatch table: the low byte of each handler's address, in code order.
030B                             ;  It must not cross a page (the dispatcher only adds to its low byte).
030B                             ; =============================================================================
030B                             ; The handlers of the first NPG1 characters start in the image's second page.
030B                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
030B                             ; differs between the builds, so the count is worked out here.
030B                             ; (One division to a line: asm80 only rounds down when it stores a value.)
030B                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
030B                PGBRK:    EQU   (h_break-BASE)/256   
030B                PGDEF:    EQU   (h_def-BASE)/256   
030B                PGFET:    EQU   (h_fetch-BASE)/256   
030B                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
030B   9C           PTAB:     DB   h_store & 0FFh   ; !
030C   A4                     DB   h_str & 0FFh   ; "
030D   C2                     DB   h_num & 0FFh   ; #
030E   AB                     DB   h_print & 0FFh   ; $
030F   9A                     DB   h_swap & 0FFh   ; %
0310   34                     DB   h_and & 0FFh   ; &
0311   BF                     DB   h_emit & 0FFh   ; '
0312   10                     DB   h_open & 0FFh   ; (
0313   1C                     DB   h_close & 0FFh   ; )
0314   59                     DB   h_mul & 0FFh   ; *
0315   31                     DB   h_add & 0FFh   ; +
0316   E5                     DB   h_cfetch & 0FFh   ; ,
0317   28                     DB   h_sub & 0FFh   ; -
0318   A1                     DB   h_cstore & 0FFh   ; .
0319   75                     DB   h_div & 0FFh   ; /
031A   98                     DB   h_dup & 0FFh   ; :
031B   C1                     DB   h_drop & 0FFh   ; ;
031C   3D                     DB   h_lt & 0FFh   ; <
031D   4C                     DB   h_eq & 0FFh   ; =
031E   3C                     DB   h_gt & 0FFh   ; >
031F   C8                     DB   h_key & 0FFh   ; ?
0320   0B                     DB   h_fetch & 0FFh   ; @
0321   EB                     DB   h_def & 0FFh   ; [
0322   DC                     DB   h_break & 0FFh   ; \
0323   D7                     DB   h_ret & 0FFh   ; ]
0324   80                     DB   h_xor & 0FFh   ; ^
0325   93                     DB   h_alloc & 0FFh   ; _
0326   BA                     DB   h_grave & 0FFh   ; `
0327   14                     DB   h_tor & 0FFh   ; {
0328   88                     DB   h_or & 0FFh   ; |
0329   1D                     DB   h_fromr & 0FFh   ; }
032A   90                     DB   h_not & 0FFh   ; ~
032B                PTABEND:      
032B                             ; =============================================================================
032B                             ;  Routines (no handler starts past this point)
032B                             ; =============================================================================
032B                             ; Digits: step back onto the first digit and read the whole number.
032B   E5           DIGIT:    PUSH   H   
032C   0B                     DCX   B   
032D   CD 37 03               CALL   rdnum   
0330   F7                     RST   6   
0331                             ; negnum: "-" directly before a digit: read the number, negate it.
0331   E5           NEGNUM:   PUSH   H   
0332   CD 37 03               CALL   rdnum   
0335   E7                     RST   4   
0336   F7                     RST   6   
0337                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
0337                             ; non-digit. Values wrap at 16 bits, as the spec says.
0337   21 00 00     RDNUM:    LXI   H,0   
033A   0A           RDN1:     LDAX   B   
033B   D6 30                  SUI   "0"   
033D   FE 0A                  CPI   10   
033F   D0                     RNC      
0340   03                     INX   B   
0341   54                     MOV   D,H   
0342   5D                     MOV   E,L   
0343   29                     DAD   H   
0344   29                     DAD   H   
0345   19                     DAD   D   
0346   29                     DAD   H   ; HL * 10
0347   5F                     MOV   E,A   
0348   16 00                  MVI   D,0   
034A   19                     DAD   D   
034B   C3 3A 03               JMP   rdn1   
034E                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, BC = remainder.
034E                             ; Uses A, BC; the caller saves the IP. HL holds the dividend and, as its bits
034E                             ; leave at the top, the quotient bits arrive at the bottom. The loop counter
034E                             ; lives on the stack, since A is busy with the shifts.
034E                             ; Dividing by 2 is one shift (the spec wants that fast).
034E   01 00 00     UDIV:     LXI   B,0   
0351   7B                     MOV   A,E   
0352   EE 02                  XRI   2   
0354   B2                     ORA   D   
0355   C2 62 03               JNZ   udv0   
0358   B4                     ORA   H   ; A was 0, and the carry is clear
0359   1F                     RAR      
035A   67                     MOV   H,A   
035B   7D                     MOV   A,L   
035C   1F                     RAR      
035D   6F                     MOV   L,A   ; the quotient
035E   78                     MOV   A,B   
035F   17                     RAL      
0360   4F                     MOV   C,A   ; the remainder: the bit that fell out
0361   C9                     RET      
0362   3E 10        UDV0:     MVI   A,16   
0364   F5                     PUSH   PSW   
0365   29           UDV1:     DAD   H   ; next dividend bit into the carry
0366   79                     MOV   A,C   
0367   17                     RAL      
0368   4F                     MOV   C,A   
0369   78                     MOV   A,B   
036A   17                     RAL      
036B   47                     MOV   B,A   ; BC = BC*2 + bit
036C   79                     MOV   A,C   
036D   93                     SUB   E   
036E   78                     MOV   A,B   
036F   9A                     SBB   D   ; carry if BC < DE
0370   DA 78 03               JC   udv2   
0373   47                     MOV   B,A   ; BC - DE (high byte; A holds it)
0374   79                     MOV   A,C   
0375   93                     SUB   E   
0376   4F                     MOV   C,A   
0377   2C                     INR   L   ; quotient bit
0378   F1           UDV2:     POP   PSW   
0379   3D                     DCR   A   
037A   F5                     PUSH   PSW   
037B   C2 65 03               JNZ   udv1   
037E   F1                     POP   PSW   
037F   C9                     RET      
0380                             ; psgn: print HL as a signed number. Uses BC.
0380   7C           PSGN:     MOV   A,H   
0381   B7                     ORA   A   
0382   F2 89 03               JP   pdec   
0385   3E 2D                  MVI   A,"-"   
0387   EF                     RST   5   
0388   E7                     RST   4   
0389                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
0389                             ; Uses BC.
0389   11 0A 00     PDEC:     LXI   D,10   
038C   CD 4E 03               CALL   udiv   ; HL = HL / 10, C = the last digit
038F   79                     MOV   A,C   
0390   F5                     PUSH   PSW   
0391   7C                     MOV   A,H   
0392   B5                     ORA   L   
0393   C4 89 03               CNZ   pdec   
0396   F1                     POP   PSW   
0397   C6 30                  ADI   "0"   
0399   EF                     RST   5   
039A   C9                     RET      
039B                             ; skip: read past text to the closer at this level, and return A = 0 if it
039B                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
039B                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
039B                             ; no closer; anything else that runs into the NUL had unbalanced brackets
039B                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
039B                             ; skip sets it to 0 and falls through the INR that an opener comes back to.
039B                             ; 
039B                             ; The checked build also looks at the character the skip was started by,
039B                             ; which is always the one just before where it starts: "(" must end at ")",
039B                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
039B                             ; quote counts as running into it. "\" takes either closer. The place where
039B                             ; the skip started is kept on the stack, for the report.
039B                SKIP:        
039B                          IF   CHECKED   
                              PUSH   B   
                              DCX   B   
                              LDAX   B   
                              INX   B   
                              MOV   E,A   ; E = the opener: ( [ or \
039B                          ENDIF      
039B   16 00                  MVI   D,0   
039D   14           SK3:      INR   D   ; an opener: one deeper
039E   0A           SK1:      LDAX   B   
039F                          IF   1-CHECKED   
039F   03                     INX   B   
03A0   B7                     ORA   A   
03A1   CA 7D 01               JZ   endprog   
03A4                          ENDIF      
03A4                          IF   CHECKED   
                              ORA   A   
                              JZ   sk6   ; (the IP stays on the NUL)
                              INX   B   
03A4                          ENDIF      
03A4   FE 22                  CPI   22h   
03A6   CC C2 03               CZ   skipstr   ; leaves A = 22h, which matches nothing below
03A9   D6 28                  SUI   "("   ;   (or 0, and then the NUL is read next)
03AB   CA 9D 03               JZ   sk3   
03AE   3D                     DCR   A   ; ")"
03AF   CA BC 03               JZ   sk4   
03B2   D6 32                  SUI   "["-")"   
03B4   CA 9D 03               JZ   sk3   
03B7   FE 02                  CPI   "]"-"["   
03B9   C2 9E 03               JNZ   sk1   
03BC   15           SK4:      DCR   D   
03BD                          IF   1-CHECKED   
03BD   C8                     RZ      ; the closer at this level
03BE   C3 9E 03               JMP   sk1   
03C1                          ENDIF      
03C1                          IF   CHECKED   
                              JNZ   sk1   
                              MOV   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
                              XRA   E   ;   opener is 0 for "(" and 1 for "[", and only
                              ANI   6   ;   "\" has bit 2: so this is 2 for the wrong
                              CPI   2   ;   closer, and only then
                              MOV   A,D   
                              POP   D   ; (where the skip started)
                              RNZ      
                              MOV   B,D   ; N. The place is the opener
                              MOV   C,E   
                              JMP   sk7   
                    SK6:      MOV   A,E   ; the text ran out:
                              ANI   4   
                              JNZ   endprog   ;   "\" with no closer ends the program
                              POP   B   
                    SK7:      MVI   A,"N"   
                              JMP   errp   ; (errp drops skip's return address)
03C1                          ENDIF      
03C1                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
03C1                             ; the next character, so "/"" does not end it. Leaves A = 22h.
03C1                          IF   1-CHECKED   
03C1   03           SS0:      INX   B   
03C2   0A           SKIPSTR:   LDAX   B   
03C3   03                     INX   B   
03C4   FE 2F                  CPI   "/"   
03C6   CA C1 03               JZ   ss0   
03C9   FE 22                  CPI   22h   
03CB   C2 C2 03               JNZ   skipstr   
03CE   C9                     RET      
03CF                          ENDIF      
03CF                          IF   CHECKED   
                                 ; The checked build never steps over a NUL: if the text runs out first it
                                 ; returns A = 0 with the IP on the NUL.
                    SKIPSTR:   LDAX   B   
                              ORA   A   
                              RZ      
                              INX   B   
                              CPI   22h   
                              RZ      
                              CPI   "/"   
                              JNZ   skipstr   
                              LDAX   B   ; the escaped character
                              ORA   A   
                              RZ      
                              INX   B   
                              JMP   skipstr   
03CF                          ENDIF      
03CF                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
03CF                             ; and return its value in A with the carry set; otherwise leave the IP and
03CF                             ; return with the carry clear.
03CF   0A           HEXC:     LDAX   B   
03D0   D6 30                  SUI   "0"   
03D2   FE 0A                  CPI   10   
03D4   DA E0 03               JC   hc1   
03D7   E6 DF                  ANI   0DFh   
03D9   D6 11                  SUI   11h   
03DB   FE 06                  CPI   6   
03DD   D0                     RNC      
03DE   D6 F6                  SUI   0F6h   ; + 10, and sets the carry
03E0   03           HC1:      INX   B   
03E1   C9                     RET      
03E2                             ; =============================================================================
03E2                             ;  Console layer: getk returns a waiting key in A (zero flag clear), or
03E2                             ;  A = 0 with the zero flag set when none is waiting. putc (RST 5) prints A.
03E2                             ;  Both keep BC, DE and HL. In the generic build they are the host's KEY and
03E2                             ;  CONOUT routines themselves.
03E2                             ; =============================================================================
03E2                          IF   (1-CPM)*(1-CHECKED)   
                    GETK:     EQU   KEY   ; the host's routine does the whole job
03E2                          ENDIF      
03E2                          IF   CHECKED   
                    GETK:     PUSH   H   ; a key held back by the break check goes
                              LXI   H,KEYBUF   ;   first, and is taken out of the buffer
                              MOV   A,M   
                              MVI   M,0   
                              POP   H   
                              ORA   A   
                              RNZ      
03E2                          ENDIF      
03E2                          IF   (1-CPM)*CHECKED   
                              JMP   KEY   
03E2                          ENDIF      
03E2                          IF   CPM*(1-CHECKED)   
03E2                GETK:        
03E2                          ENDIF      
03E2                          IF   CPM   
03E2   3E FF                  MVI   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
03E4                             ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
03E4                             ; printing and could swallow a key that BDOS 6 then never sees.
03E4   C5           PUTC:     PUSH   B   
03E5   D5                     PUSH   D   
03E6   E5                     PUSH   H   
03E7   5F                     MOV   E,A   
03E8   0E 06                  MVI   C,6   
03EA   CD 05 00               CALL   BDOS   
03ED   E1                     POP   H   
03EE   D1                     POP   D   
03EF   C1                     POP   B   
03F0   B7                     ORA   A   ; (for getk)
03F1   C9                     RET      
03F2                          ENDIF      
03F2                             ; =============================================================================
03F2                             ;  Checked build: the checks and the error report
03F2                             ; =============================================================================
03F2                          IF   CHECKED   
                                 ; chkst: stop unless HL is in the program's own space: from the letter page
                                 ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
                                 ; whatever lies above the limit are safe. Memory above the heap top but
                                 ; below the limit is the program's own: Tiny BASIC keeps its lines there.
                                 ; It is the page of HL + 1 that is tested, so that one test serves both
                                 ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
                                 ; Keeps HL and BC.
                    CHKST:    INX   H   
                              MOV   A,H   
                              DCX   H   
                              CPI   LETPAGE   
                              JC   e_store   
03F2                          ENDIF      
03F2                          IF   CHECKED*(1-CPM)   
                              CPI   HEAPLIM   
                              RC      
03F2                          ENDIF      
03F2                          IF   CHECKED*CPM   
                              MOV   E,A   
                              LDA   0007h   ; the BDOS page is the heap limit
                              DCR   A   
                              CMP   E   
                              RNC      
03F2                          ENDIF      
03F2                          IF   CHECKED   
                    E_STORE:   MVI   A,"O"   ; a store outside the program's space
                              JMP   errp   
                                 ; chkhp: HL = the new heap top, DE = the count, the carry is from adding
                                 ; it, and the old top is on the stack under the return address. Stop if the
                                 ; new top is not below the limit page, or is below the program's end.
                    CHKHP:       
03F2                          ENDIF      
03F2                          IF   CHECKED*CPM   
                                 ; With this much room a top that wrapped round can land back in
                                 ; range, so the add is tested too: growing must not carry, and
                                 ; releasing must.
                              MOV   A,D   
                              RAR      ; the carry comes in above the count's sign:
                              ADI   40h   ;   bit 7 = carry XOR sign
                              ADD   A   
                              JC   e_heap   
                              LDA   0007h   
                              DCR   A   
                              CMP   H   
                              JC   e_heap   
03F2                          ENDIF      
03F2                          IF   CHECKED*(1-CPM)   
                                 ; (Here the program's space is under 32K, so a top that wrapped
                                 ; round always falls outside it.)
                              MOV   A,H   
                              CPI   HEAPLIM   
                              JNC   e_heap   
03F2                          ENDIF      
03F2                          IF   CHECKED   
                              XCHG      
                              PUSH   H   ; the count
                              LHLD   NPEND   
                              DAD   D   ; carry: at or above the program's end
                              POP   H   
                              XCHG      
                              RC      
                    E_HEAP:   XCHG      ; put the count back in TOS for the report,
                              POP   D   ;   and drop the return address and the old
                              MVI   A,"H"   ;   top
                              JMP   errp   
                                 ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
                                 ; "$", and the error report's texts). A NUL first is an error: Q.
                    PRSTR:    MOV   A,M   
                              INX   H   
                              CPI   22h   
                              RZ      
                              ORA   A   
                              JZ   e_dollar   
                              CPI   "/"   
                              JNZ   prs1   
                              MOV   A,M   
                              INX   H   
                              ANI   0BFh   
                    PRS1:     RST   5   
                              JMP   prstr   
                    E_DOLLAR:   POP   D   ; "$" ran into a NUL: drop the return address,
                              POP   H   ;   and put the string's address back in TOS
                              MVI   A,"Q"   
                              JMP   error   
                                 ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
                                 ; pnl: the same, on a new line.
                    PNL:      MVI   A,13   
                              RST   5   
                              MVI   A,10   
                              RST   5   
                    PMSG:     XTHL      
                              CALL   prstr   
                              XTHL      
                              RET      
                                 ; chkstk: both stacks are checked once per character, not in every handler.
                                 ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
                                 ; the constant carries if it is above (cells were popped that were never
                                 ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
                                 ; a character late at most: the bytes above DSTOP and the guard band below
                                 ; the page take what happens meanwhile.
                    CHKSTK:   XCHG      ; DE = TOS (HL is needed for the pointers)
                              LXI   H,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
                              DAD   SP   
                              JC   e_under   
                              INR   H   
                              JNZ   e_over   
                              LHLD   RSP   ; the return stack: in its page (or it has
                              MOV   A,H   ;   overflowed), and not above its empty
                              CPI   RSPAGE   ;   position (an underflow stays inside the
                              JNZ   e_rover   ;   page, in the guard band)
                              MOV   A,L   
                              CPI   RSTOP&0FFh+1   
                              JNC   e_runder   
                              XCHG      ; TOS back
                              RET      
                    E_RUNDER:   LXI   H,RSTOP   ; return stack underflow: it counts as empty
                              SHLD   RSP   
                              MVI   A,"r"   
                              DB   21h   ; (LXI H hides the next entry; HL is free)
                    E_ROVER:   MVI   A,"R"   ; return stack overflow
                              DB   21h   
                    E_OVER:   MVI   A,"S"   ; data stack overflow
                              XCHG      ; TOS back
                              JMP   errp   
                    E_UNDER:   LXI   SP,DSTOP   ; data stack underflow: it counts as empty
                              MVI   A,"s"   
                              JMP   error   
                                 ; chkbrk: a waiting key is read now; Ctrl-C stops the program, anything
                                 ; else is held for the next "?". Keeps BC, DE, HL.
                    CHKBRK:   CALL   getk   
                              RZ      
                              CPI   3   
                              STA   KEYBUF   
                              RNZ      
                              XRA   A   
                              STA   KEYBUF   
                              POP   D   ; Ctrl-C. Drop the return address; the cell on
                              POP   H   ;   top of the stack is the TOS that rpushd
                              MVI   A,"B"   ;   was about to bring back
                              JMP   error   
                                 ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
                                 ; was never defined still holds 0000h, and the byte there is a JMP, C3h, in
                                 ; every build: if the IP is in page zero, this was a call of an undefined
                                 ; word. The call is undone, so the place is the call itself.
                    E_HI:     INR   B   
                              DCR   B   
                              JNZ   e_resv   
                              PUSH   H   
                              RST   1   
                              MOV   B,H   
                              MOV   C,L   
                              POP   H   
                              MVI   A,"U"   
                              JMP   error   
                                 ; Error entries. Each loads its letter and then hides the next entry inside
                                 ; a 3-byte LXI D (the 11h), so they all fall through to `error`.
                    E_QUOTE:   MOV   B,H   ; an unclosed string: HL is its address, one
                              MOV   C,L   ;   past the opening quote, which is the place
                              MVI   A,"Q"   
                              DB   11h   
                    E_RESV:   MVI   A,"X"   ; a reserved byte outside a string
                              DB   11h   
                    E_ZERO:   MVI   A,"Z"   ; dividing by zero
                              DB   11h   
                    E_BRACK:   MVI   A,"W"   ; bad character after [
                              DB   0FEh   ; (CPI hides the one byte of errp)
                                 ; errp: an error found inside a routine: drop its return address first.
                    ERRP:     POP   D   
                                 ; error: the report, then the end. A = the letter, BC = one past the place,
                                 ; HL = TOS, and both stacks as the report is to show them:
                                 ; 
                                 ;   Err X @ line,col
                                 ;   up to 16 characters of the text from the place
                                 ;   Stk n: the top 8 cells at most, bottom to top
                                 ;   Rtn n
                    ERROR:    PUSH   H   ; now the whole data stack is in memory
                              MOV   E,A   
                              CALL   pnl   
                              DB   "Err ",22h   
                              MOV   A,E   
                              RST   5   
                              CALL   pmsg   
                              DB   " @ ",22h   
                              DCX   B   ; BC = the place
                                 ; The line and column. A place below the program is in the line
                                 ; buffer: line 0. Otherwise count the LFs from the program's start;
                                 ; DE = the line's number, HL = where it starts.
                              LXI   H,LINEBUF   
                              LXI   D,0   
                              MOV   A,B   
                              CPI   PROG/256   
                              JC   er3   
                              INR   H   
                              MOV   L,E   ; HL = PROG
                    ER1:      INX   D   ; a new line starts at HL
                              PUSH   H   
                    ER2:      MOV   A,L   
                              SUB   C   
                              MOV   A,H   
                              SBB   B   
                              JNC   er2x   ; reached the place
                              MOV   A,M   
                              INX   H   
                              CPI   10   
                              JNZ   er2   
                              POP   PSW   
                              JMP   er1   
                    ER2X:     POP   H   
                    ER3:      PUSH   B   
                              PUSH   H   
                              XCHG      
                              CALL   pdec   ; the line
                              MVI   A,","   
                              RST   5   
                              POP   D   
                              POP   H   
                              PUSH   H   
                              CALL   sub16   
                              INX   H   
                              CALL   pdec   ; the column
                              CALL   pnl   
                              DB   22h   
                              POP   H   ; the text, as it is: 16 characters, or fewer
                              MVI   B,16   ;   if the line or the program ends first
                    ER4:      MOV   A,M   
                              INX   H   
                              ORA   A   
                              JZ   er5   
                              CPI   13   
                              JZ   er5   
                              CPI   10   
                              JZ   er5   
03F2                          ENDIF      
03F2                          IF   CHECKED*CPM   
                              CPI   1Ah   ; (the ^Z that pads a file's last record ends
                              JZ   er5   ;   the text too: some terminals clear the
03F2                          ENDIF      ;   screen on it)
03F2                          IF   CHECKED   
                              RST   5   
                              DCR   B   
                              JNZ   er4   
                    ER5:      CALL   pnl   
                              DB   "Stk ",22h   
                              LXI   H,0   
                              DAD   SP   
                              XCHG      
                              LXI   H,DSTOP-2   ; (the cell at DSTOP-2 was pushed with the
                              CALL   phalf   ;   first value and holds nothing): the depth
                              MVI   A,":"   
                              RST   5   
                              MOV   A,C   
                              CPI   9   
                              JC   er6   
                              CALL   pmsg   
                              DB   " ...",22h   
                              MVI   C,8   
                    ER6:      MVI   H,0   ; C = the number of cells to show
                              MOV   L,C   
                              DAD   H   
                              DAD   SP   ; HL -> just above the deepest of them
                              INR   C   
                    ER7:      DCR   C   
                              JZ   er8   
                              DCX   H   
                              MOV   D,M   
                              DCX   H   
                              MOV   E,M   
                              PUSH   H   
                              PUSH   B   
                              MVI   A," "   
                              RST   5   
                              XCHG      
                              CALL   psgn   
                              POP   B   
                              POP   H   
                              JMP   er7   
                    ER8:      CALL   pnl   
                              DB   "Rtn ",22h   
                              LHLD   RSP   
                              XCHG      
                              LXI   H,RSTOP   
                              CALL   phalf   
                              CALL   pnl   
                              DB   22h   
                              JMP   endprog   
                                 ; phalf: print half of HL - DE, and leave it in BC
                    PHALF:    CALL   sub16   
                              ORA   A   ; (A = H; this clears the carry)
                              RAR      
                              MOV   H,A   
                              MOV   A,L   
                              RAR      
                              MOV   L,A   
                              PUSH   H   
                              CALL   pdec   
                              POP   B   
                              RET      
                                 ; sub16: HL = HL - DE. Leaves A = H.
                    SUB16:    MOV   A,L   
                              SUB   E   
                              MOV   L,A   
                              MOV   A,H   
                              SBB   D   
                              MOV   H,A   
                              RET      
03F2                          ENDIF      
03F2                             ; =============================================================================
03F2                             ;  Startup
03F2                             ; =============================================================================
03F2                START:       
03F2                          IF   (1-CPM)*CHECKED   
                              LXI   SP,DSTOP   
03F2                          ENDIF      
03F2                          IF   CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi), and no key is held back.
                              LXI   H,LET   
                              XRA   A   
                    INI1:     MOV   M,A   
                              INR   L   
                              JP   ini1   ; +00h to +7Fh
03F2                          ENDIF      
03F2                          IF   CPM   
03F2                             ; CP/M: the RAM pages follow the image; the heap may grow to the BDOS
03F2   21 08 01               LXI   H,vecs   ; the RST routines go down into page zero
03F5   11 08 00               LXI   D,0008h   
03F8   06 2C                  MVI   B,vecend-vecs   
03FA   7E           CPY:      MOV   A,M   
03FB   12                     STAX   D   
03FC   23                     INX   H   
03FD   13                     INX   D   
03FE   05                     DCR   B   
03FF   C2 FA 03               JNZ   cpy   
0402   11 5C 00               LXI   D,005Ch   ; open the file named on the command line
0405   0E 0F                  MVI   C,15   ; (no such file: the first read fails too,
0407   CD 05 00               CALL   BDOS   ;   and the program is empty)
040A   11 00 08               LXI   D,PROG   
040D   D5           LD1:      PUSH   D   
040E   0E 1A                  MVI   C,26   ; set the DMA address
0410   CD 05 00               CALL   BDOS   
0413   11 5C 00               LXI   D,005Ch   
0416   0E 14                  MVI   C,20   ; read the next 128 bytes
0418   CD 05 00               CALL   BDOS   
041B   E1                     POP   H   ; HL = the address this record went to
041C   B7                     ORA   A   
041D   C2 28 04               JNZ   ld2   
0420   11 80 00               LXI   D,128   
0423   19                     DAD   D   
0424   EB                     XCHG      
0425   C3 0D 04               JMP   ld1   
0428   36 00        LD2:      MVI   M,0   ; the end of the file counts as NUL
042A   23                     INX   H   ; the heap starts after it
042B                          ENDIF      
042B                          IFN   CPM   
                              LXI   H,PROG   ; the heap starts after the program's NUL
                    FNUL:     MOV   A,M   
                              INX   H   
                              ORA   A   
                              JNZ   fnul   
042B                          ENDIF      
042B   22 7C 07               SHLD   HEAP   
042E                          IF   CHECKED   
                              RST   4   ; minus the heap"s first address: "_' may not
                              SHLD   NPEND   ;   release below it
042E                          ENDIF      
042E   21 E0 05               LXI   H,RSTOP   ; the return stack is empty
0431   22 34 07               SHLD   RSP   
0434   01 00 08               LXI   B,PROG   ; the IP
0437   F7                     RST   6   ; (its return address is thrown away)
0438                          IF   CPM   
0438                             ; RAM pages, after the image
0438                RSPAGE:   EQU   (imgend + 255) / 256   
0438                DSPAGE:   EQU   RSPAGE + 1   
0438                LETPAGE:   EQU   RSPAGE + 2   
0438                PROG:     EQU   LETPAGE*256 + 256   
0438                          ENDIF      
0438                IMGEND:      


