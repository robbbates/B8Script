06E1   7D           SUB16:    MOV   A,L   
06E2   93                     SUB   E   
06E3   6F                     MOV   L,A   
06E4   7C                     MOV   A,H   
06E5   9A                     SBB   D   
06E6   67                     MOV   H,A   
06E7   C9                     RET      
06E8                          ENDIF      
06E8                             ; =============================================================================
06E8                             ;  Startup
06E8                             ; =============================================================================
06E8                START:       
06E8                          IF   (1-CPM)*CHECKED   
                              LXI   SP,DSTOP   
06E8                          ENDIF      
06E8                          IF   QK   
                              LXI   H,CPAGE*256   ; every run starts with an empty skip cache (a
                              XRA   A   ;   start of 0000h matches no skip)
                    SKC1:     MOV   M,A   
                              INR   L   
                              JNZ   skc1   
06E8                          ENDIF      
06E8                          IF   CHECKED   
06E8                             ; Clear the lower half of the letter page: every variable starts at
06E8                             ; 0, every word cell holds 0000h, the address an undefined word is
06E8                             ; caught at (see e_hi), and no key is held back.
06E8   21 00 0A               LXI   H,LET   
06EB   AF                     XRA   A   
06EC   77           INI1:     MOV   M,A   
06ED   2C                     INR   L   
06EE   F2 EC 06               JP   ini1   ; +00h to +7Fh
06F1                          ENDIF      
06F1                          IF   CPM   
06F1                             ; CP/M: the RAM pages follow the image; the heap may grow to the BDOS
06F1   11 5C 00               LXI   D,005Ch   ; open the file named on the command line
06F4   0E 0F                  MVI   C,15   ; (no such file: the first read fails too,
06F6   CD 05 00               CALL   BDOS   ;   and the program is empty)
06F9   11 00 0B               LXI   D,PROG   
06FC   D5           LD1:      PUSH   D   
06FD   0E 1A                  MVI   C,26   ; set the DMA address
06FF   CD 05 00               CALL   BDOS   
0702   11 5C 00               LXI   D,005Ch   
0705   0E 14                  MVI   C,20   ; read the next 128 bytes
0707   CD 05 00               CALL   BDOS   
070A   E1                     POP   H   ; HL = the address this record went to
070B   B7                     ORA   A   
070C   C2 17 07               JNZ   ld2   
070F   11 80 00               LXI   D,128   
0712   19                     DAD   D   
0713   EB                     XCHG      
0714   C3 FC 06               JMP   ld1   
0717   36 00        LD2:      MVI   M,0   ; the end of the file counts as NUL
0719   23                     INX   H   ; the heap starts after it
071A                          ENDIF      
071A                          IFN   CPM   
                              LXI   H,PROG   ; the heap starts after the program's NUL
                    FNUL:     MOV   A,M   
                              INX   H   
                              ORA   A   
                              JNZ   fnul   
071A                          ENDIF      
071A   22 7C 0A               SHLD   HEAP   
071D                          IF   CHECKED   
071D                          ;*Macro unroll:  NEGH                    ; minus the heap's first address: '_' may not
071D                          DS   1-CPM,0E7h   ; minus the heap"s first address: "_' may not
071D   CD                     DS   CPM,0CDh   
071E   27                     DS   CPM,ANEG&0FFh   
071F   01                     DS   CPM,ANEG/256   
0720   22 38 0A               SHLD   NPEND   ;   release below it
0723                          ENDIF      
0723   21 E0 08               LXI   H,RSTOP   ; the return stack is empty
0726   22 34 0A               SHLD   RSP   
0729                          IF   (1-CHECKED)*(1-CPM)   
                              MOV   H,A   ; (A = 0, from the search for the NUL) no key
                              MOV   L,A   ;   is held, and the break key is on (the
0729                          ENDIF      ;   checked build has cleared these)
0729                          IF   (1-CHECKED)*CPM   
                              LXI   H,0   
0729                          ENDIF      
0729                          IF   1-CHECKED   
                              SHLD   KEYBUF   
0729                          ENDIF      
0729   01 00 0B               LXI   B,PROG   ; the IP
072C                          ;*Macro unroll:  NEXT                    ; (its return address is thrown away)
072C                          DS   (1-CPM)*(1-FAST),0F7h   ; (its return address is thrown away)
072C   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
072D   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
072E   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
072F                          IF   FAST   
                                 ; =============================================================================
                                 ;  The fast build (SPEED = 2)
                                 ; 
                                 ;  The inner loop is a table: 256 entries, the low bytes of the handlers'
                                 ;  addresses in one page and the high bytes in the next. The dispatcher (at
                                 ;  next0, and inline, as NEXTF, at the end of the fast build's own entries,
                                 ;  so there is no jump back to it; the ordinary handlers end in JMP next0):
                                 ; 
                                 ;      LDAX B / INX B / XCHG / MOV L,A / MVI H,DTAB/256 /
                                 ;      MOV A,M / INR H / MOV H,M / MOV L,A / PCHL
                                 ; 
                                 ;  So every entry starts with TOS in DE, not HL. The rest of the punctuation
                                 ;  is reached through thunks into the ordinary handlers (XCHG / JMP handler);
                                 ;  the letters and digits have one entry each, which knows its cell or its
                                 ;  value already.
                                 ; =============================================================================
                    FTSTORE:   XCHG      ; !
                              JMP   h_store   
                    FTSTR:    XCHG      ; "
                              JMP   h_str   
                    FTNUM:    XCHG      ; #
                              JMP   h_num   
                    FTPRINT:   XCHG      ; $
                              JMP   h_print   
                    FTEMIT:   XCHG      ; '
                              JMP   h_emit   
                    FTCSTORE:   XCHG      ; .
                              JMP   h_cstore   
                    FTDIV:    XCHG      ; /
                              JMP   h_div   
                    FTKEY:    XCHG      ; ?
                              JMP   h_key   
                    FTDEF:    XCHG      ; [
                              JMP   h_def   
                    FTBREAK:   XCHG      ; \
                              JMP   h_break   
                    FTALLOC:   XCHG      ; _
                              JMP   h_alloc   
                    FTGRAVE:   XCHG      ; `
                              JMP   h_grave   
                                 ; The commonest punctuation, written for the fast build: TOS in DE on the
                                 ; way in, and the dispatcher inline on the way out.
                    FS_ADD:   POP   H   ; +
                              DAD   D   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_SUB:   LDAX   B   ; -
                              SUI   "0"   
                              CPI   10   
                              JC   fs_neg   
                              POP   H   
                              MOV   A,L   
                              SUB   E   
                              MOV   E,A   
                              MOV   A,H   
                              SBB   D   
                              MOV   D,A   
                              ;*Macro unroll:  NEXTD
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_NEG:   XCHG      ; a digit next: a negative number
                              JMP   negnum   
                    FS_DUP:   PUSH   D   ; :
                              ;*Macro unroll:  NEXTD
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_DROP:   POP   H   ; ;
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_SWAP:   POP   H   ; %
                              PUSH   D   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_FET:   XCHG      ; @
                              MOV   E,M   
                              INX   H   
                              MOV   D,M   
                              ;*Macro unroll:  NEXTD
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_CFET:   LDAX   D   ; ,
                              MOV   E,A   
                              MVI   D,0   
                              ;*Macro unroll:  NEXTD
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST*CHECKED,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
