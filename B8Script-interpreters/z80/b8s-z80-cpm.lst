0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Spec: docs/b8script.md (2026-11-21).
0000                             ; 
0000                             ;  Three switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    EDITOR   1 = with a small line editor built in (see the end of this
0000                             ;                 file). It goes with either setting of the other two.
0000                             ;    CHECKED  0 = no checks (spec: the programmer is responsible)
0000                             ;             1 = starts with every variable at 0 and every word undefined,
0000                             ;                 and stops on every error in the spec's table (and Ctrl-C)
0000                             ;                 with a four-line report: the letter and the place as line
0000                             ;                 and column, the text there, and both stacks. See `error`.
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   1   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   0   ; 1 = checked build
0000                EDITOR:   EQU   0   ; 1 = with the line editor
0000                EDGEN:    EQU   EDITOR*(1-CPM)   ; (the generic build with the editor)
0000                TABP0:    EQU   EDGEN*(1-CHECKED)   ; (the build with its table in page zero)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    HL'  return-stack pointer (the alternate HL). Entries are 2 bytes; the
0000                             ;         stack grows down. Only rpop and rpushn (and the checks) touch it.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  One-byte calls. The routines used most are reached with RST, one byte
0000                             ;  instead of three:
0000                             ; 
0000                             ;    RST 08h  rpop    pop the return stack into DE
0000                             ;    RST 18h  drop    drop TOS, then next character     (ends a handler)
0000                             ;    RST 20h  neg16   HL = -HL
0000                             ;    RST 28h  putc    print A
0000                             ;    RST 30h  next    next character                    (ends a handler)
0000                             ; 
0000                             ;  RST 18h and RST 30h never return: an RST is a CALL, so the first thing
0000                             ;  each of them does is POP DE to throw the return address away.
0000                             ; 
0000                             ;  The CP/M build can't own page zero, so the block from `vecs` to `vecend`
0000                             ;  (image addresses 0108h-0133h) is copied to 0008h-0033h when it starts. The
0000                             ;  code in that block is written to work at either place.
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (the top four bytes of the page are spare,
0000                             ;             so a full stack runs two bytes into the page below)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch, interpreter variables in the gaps, and the -n? line buffer
0000                             ;             at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack has a guard band: the data stack can
0000                             ;  overrun by a cell or two (and the calls made while it is full, the error
0000                             ;  report's included) into the top 32 bytes of the return-stack page, which
0000                             ;  are never used, and the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
0000                BDOS:     EQU   0005h   
0000                BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IF   CPM*(1-EDITOR)   
0000                EXIT:     EQU   0000h   ; warm boot
0000                          ENDIF      
0000                          IFN   CPM   
                                 ; ---- generic machine: edit these to suit -----------------------------------
                    KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
                                 ;   waiting. The zero flag must match A
                                 ;   (end the routine with OR A / RET).
                    CONOUT:   EQU   0FF03h   ; print the character in A
                                 ;   KEY and CONOUT must preserve BC, DE, HL and HL'.
                    RSPAGE:   EQU   80h   ; 8000h return stack
                    DSPAGE:   EQU   81h   ; 8100h data stack
                    LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
                    PROG:     EQU   8300h   ; where the loader puts the program text
                    HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
                    BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)   
                    EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                          ENDIF      
0000                          IF   EDITOR   
                    EXIT:     EQU   edit   ; a program that ends goes back to the editor
0000                          ENDIF      
0000                MSLOOP:   EQU   40   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine. (The wait
0000                             ; for a second Ctrl-C uses it too: 250 ms.)
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                             ;   around machine code;
0000                NPEND:    EQU   LET+38h   ;   minus the address of the program's end
0000                             ;   (the heap"s first byte), for the checked "_'
0000                KEYBUF:   EQU   LET+7Ah   ; gap after z: a key read by the break check and
0000                             ;   held for the next "?" (0: none);
0000                BRKOFF:   EQU   LET+7Bh   ;   the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                LBHDR:    EQU   LET+7Eh   ; CP/M BDOS 10 header: max, count
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FCh   ; empty data stack. The four bytes above it
0000                             ; are spare: a character can pop two cells
0000                             ; too many before the checked build sees it,
0000                             ; and the next call must not land on the
0000                             ; letter cells.
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is the start of the .COM file, and 0108h-0133h is also copied to
0000                             ;  page zero (see the header).
0000                             ; =============================================================================
0100                          .ORG   BASE   
0100                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              XOR   A   ; 00  reset. (This byte, AFh, is also what an
0100                          ENDIF      ;     undefined word runs into: see e_hi.)
0100                          IF   1-EDGEN   
0100   31 FC 06               LD   SP,DSTOP   ; 00  reset, or the start of the .COM file
0103                          ENDIF      
0103                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)   
                              LD   BC,PROG   ; 03  the IP
                              JR   st0   ; 06  (the rest of the startup is close by)
0103                          ENDIF      
0103                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              JR   init   ; 04  (the rest of the startup is close by)
                              DW   0   ; 06  spare
0103                          ENDIF      
0103                          IF   EDGEN   
                              XOR   A   ; 00  reset: no program yet
                              LD   (PROG),A   
0103                          ENDIF      
0103                          IF   EDGEN*(1-CHECKED)   
                              JP   edit   ; 04
0103                          ENDIF      
0103                          IF   EDGEN*CHECKED   
                              JP   init   ; 04  (and no key held back)
0103                          ENDIF      
0103                          IF   EDGEN   
                              NOP      ; 07  spare
0103                          ENDIF      
0103                          IF   CPM   
0103   C3 0E 04               JP   start   ; 03
0106   00 00                  DW   0   ; 06  spare
0108                          ENDIF      
0108                VECS:        
0108                             ; ---- RST 08h: rpop: pop the return stack into DE ---------------------------
0108   D9           RPOP:     EXX      ; 08
0109   5E                     LD   E,(HL)   
010A   23                     INC   HL   
010B   56                     LD   D,(HL)   
010C   23                     INC   HL   
010D   D5                     PUSH   DE   ; across to the main registers
010E   D9                     EXX      
010F   D1                     POP   DE   
0110   C9                     RET      ; 10  (so RST 10h is not used)
0111                             ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
0111   C6 21        CTL:      ADD   A,21h   ; 11  back to c; zero only for NUL
0113   20 1F                  JR   NZ,next0   ;     the rest are ignored
0115   C3 00 00     ENDPROG:   JP   EXIT   ;     the program has ended
0118                             ; ---- RST 18h: drop TOS, then next ------------------------------------------
0118   D1           RST18:    POP   DE   ; 18  discard the RST's return address
0119   E1                     POP   HL   ;     new TOS = NOS
011A   18 15                  JR   nx   
011C   E5           H_FROMR:   PUSH   HL   ; 1C  "}" return stack to TOS
011D   CF                     RST   08h   
011E   EB                     EX   DE,HL   
011F   F7                     RST   30h   
0120                             ; ---- RST 20h: neg16: HL = -HL (keeps BC, DE) -------------------------------
0120   AF           NEG16:    XOR   A   ; 20
0121   95                     SUB   L   
0122   6F                     LD   L,A   
0123   9F                     SBC   A,A   
0124   94                     SUB   H   
0125   67                     LD   H,A   
0126   C9                     RET      
0127   00                     NOP      ; 27  spare
0128                             ; ---- RST 28h: putc: print A (keeps BC, DE, HL, HL') ------------------------
0128                RST28:       
0128                          IFN   CPM   
                    PUTC:     JP   CONOUT   ; 28
0128                          ENDIF      
0128                          IF   CPM   
0128   C3 F5 03               JP   putc   ; 28
012B                          ENDIF      
012B   E9           JPHL:     JP   (HL)   ; 2B  (for the machine-code call)
012C   E3           H_TOR:    EX   (SP),HL   ; 2C  "{" TOS to the return stack: the new TOS
012D   C3 C1 01               JP   rpushn   ;     comes up, the old one goes across
0130                             ; ---- RST 30h: next character -----------------------------------------------
0130   D1           RST30:    POP   DE   ; 30  discard the RST's return address
0131                NX:          
0131                          IF   CPM   
0131   C3 34 01               JP   next0   ; (this copy runs in page zero)
0134                          ENDIF      
0134                VECEND:      
0134                             ; =============================================================================
0134                             ;  The inner loop: read one character and sort it by range.
0134                             ; 
0134                             ;    00h          end of program
0134                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0134                             ;    30h-39h      digit: read a whole number
0134                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0134                             ;    61h-7Ah      a-z: push the address of that letter's cell
0134                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0134                             ; =============================================================================
0134                NEXT0:       
0134                          IF   CHECKED   
                              CALL   chkstk   ; both stacks are checked once per character
0134                          ENDIF      
0134   0A                     LD   A,(BC)   
0135   03                     INC   BC   
0136   D6 21                  SUB   21h   ; A = c - 21h
0138   38 D7                  JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
013A   FE 0F                  CP   0Fh   
013C   38 22                  JR   C,punct   ; 21h-2Fh: PTAB index 0-14
013E   D6 0F                  SUB   0Fh   ; A = c - 30h
0140   FE 0A                  CP   0Ah   
0142   38 67                  JR   C,digit   ; 30h-39h
0144   FE 11                  CP   11h   
0146   38 16                  JR   C,p3a   ; 3Ah-40h
0148   D6 11                  SUB   11h   ; A = c - 41h
014A   FE 1A                  CP   1Ah   
014C   38 69                  JR   C,upper   ; 41h-5Ah: A = letter index 0-25
014E   FE 20                  CP   20h   
0150   38 0A                  JR   C,p5b   ; 5Bh-60h
0152   FE 3A                  CP   3Ah   
0154   38 5B                  JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0156   FE 3E                  CP   3Eh   
0158                          IF   1-CHECKED   
0158   30 DA                  JR   NC,next0   ; 7Fh-FFh: ignored
015A                          ENDIF      
015A                          IF   CHECKED   
                              JR   Z,next0   ; 7Fh, DEL: ignored
                              JP   NC,e_hi   ; 80h-FFh: reserved
015A                          ENDIF      
015A   D6 1A                  SUB   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
015C   D6 09        P5B:      SUB   9   ; 5Bh-60h: -4 in all, index 22-27
015E   C6 05        P3A:      ADD   A,5   ; 3Ah-40h: index 15-21
0160                .macro PTABLE,
0160                             ; 
0160                 DB      h_store & 0FFh  ; !
0160                 DB      h_str & 0FFh    ; "
0160                 DB      h_num & 0FFh    ; #
0160                 DB      h_print & 0FFh  ; $
0160                 DB      h_swap & 0FFh   ; %
0160                 DB      h_and & 0FFh    ; &
0160                 DB      h_emit & 0FFh   ; '
0160                 DB      h_open & 0FFh   ; (
0160                 DB      h_close & 0FFh  ; )
0160                 DB      h_mul & 0FFh    ; *
0160                 DB      h_add & 0FFh    ; +
0160                 DB      h_cfetch & 0FFh ; ,
0160                 DB      h_sub & 0FFh    ; -
0160                 DB      h_cstore & 0FFh ; .
0160                 DB      h_div & 0FFh    ; /
0160                 DB      h_dup & 0FFh    ; :
0160                 DB      h_drop & 0FFh   ; ;
0160                 DB      h_lt & 0FFh     ; <
0160                 DB      h_eq & 0FFh     ; =
0160                 DB      h_gt & 0FFh     ; >
0160                 DB      h_key & 0FFh    ; ?
0160                 DB      h_fetch & 0FFh  ; @
0160                 DB      h_def & 0FFh    ; [
0160                 DB      h_break & 0FFh  ; \
0160                 DB      h_ret & 0FFh    ; ]
0160                 DB      h_xor & 0FFh    ; ^
0160                 DB      h_alloc & 0FFh  ; _
0160                 DB      h_grave & 0FFh  ; `
0160                 DB      h_tor & 0FFh    ; {
0160                 DB      h_or & 0FFh     ; |
0160                 DB      h_fromr & 0FFh  ; }
0160                 DB      h_not & 0FFh    ; ~
0160                .endm
0160                 
0160                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
0160                             ; untouched, and A, DE free.
0160   C6 7F        PUNCT:    ADD   A,PTAB & 0FFh   ; PTAB never crosses a page
0162   5F                     LD   E,A   
0163   16 03                  LD   D,PTAB / 256   ; (0 if the table is in page zero)
0165   FE 95                  CP   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
0167   1A                     LD   A,(DE)   
0168   5F                     LD   E,A   ; the handler's low byte
0169                          IF   (1-CPM)*(1-TABP0)   
                              LD   D,0   
0169                          ENDIF      
0169                          IFN   CPM   
                              RL   D   ; its page: 0 + carry
0169                          ENDIF      
0169                          IF   CPM   
0169   16 01                  LD   D,1   
016B   30 01                  JR   NC,pu1   
016D   14                     INC   D   ; its page: 1 + carry
016E                PU1:         
016E                          ENDIF      
016E   D5                     PUSH   DE   ; jump to it; the stack is balanced again
016F   C9                     RET      ;   when the handler starts
0170                             ; The rest of the startup: here so that the generic reset code can reach it
0170                             ; with JR. st0: find the program's NUL; the heap starts after it.
0170                             ; (The editor build has its own copy of this, next to the editor.)
0170                             ; A checked build first clears the lower half of the letter page (A = 0):
0170                             ; every variable starts at 0, every word cell holds 0000h, the address an
0170                             ; undefined word is caught at (see e_hi), and no key is held back.
0170                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                    INIT:     LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
                              LD   BC,PROG   ; the IP
0170                          ENDIF      
0170                          IF   (1-CPM)*(1-EDITOR)   
                    ST0:      LD   H,B   
                              LD   L,C   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
0170                          ENDIF      
0170                          IF   1-EDITOR   
0170   22 7C 07     ST2:      LD   (HEAP),HL   
0173                          ENDIF      
0173                          IF   CHECKED*(1-EDITOR)   
                              RST   20h   ; minus the heap"s first address: "_' may not
                              LD   (NPEND),HL   ;   release below it
0173                          ENDIF      
0173                          IF   (1-CHECKED)*(1-EDITOR)   
0173   21 00 00               LD   HL,0   ; no key is held, and the break key is on
0176   22 7A 07               LD   (KEYBUF),HL   ;   (the checked build has cleared these)
0179                          ENDIF      
0179                          IF   1-EDITOR   
0179   D9                     EXX      
017A   21 E0 05               LD   HL,RSTOP   ; the return stack is empty
017D   D9                     EXX      
017E   F7                     RST   30h   ; (its return address is thrown away)
017F                          ENDIF      
017F                             ; In the unchecked generic editor build the table is here, in the first
017F                             ; page, which saves loading D twice. (The other builds have no room for it
017F                             ; here: theirs is further down.)
017F                          IF   TABP0   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
017F                          ENDIF      
017F                             ; =============================================================================
017F                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
017F                             ;  (00bbIGFuZCA= are up among the RST routines.) The machine-code call, exec,
017F                             ;  is here too: it belongs to "`" and makes the page come out right.
017F                             ; =============================================================================
017F   D1           H_XOR:    POP   DE   
0180   7C                     LD   A,H   
0181   AA                     XOR   D   
0182   67                     LD   H,A   
0183   7D                     LD   A,L   
0184   AB                     XOR   E   
0185   6F                     LD   L,A   
0186   F7                     RST   30h   
0187   D1           H_OR:     POP   DE   
0188   7C                     LD   A,H   
0189   B2                     OR   D   
018A   67                     LD   H,A   
018B   7D                     LD   A,L   
018C   B3                     OR   E   
018D   6F                     LD   L,A   
018E   F7                     RST   30h   
018F   E7           H_NOT:    RST   20h   ; ~x = -x - 1
0190   2B                     DEC   HL   
0191   F7                     RST   30h   
0192                             ; "_" ( n -- addr ): the heap pointer moves by n, a signed count (the add is
0192                             ; the same either way); TOS is the old pointer.
0192   ED 5B 7C 07  H_ALLOC:   LD   DE,(HEAP)   
0196                          IF   CHECKED*CPM   
                              LD   A,H   ; the count's sign, for chkhp
0196                          ENDIF      
0196   19                     ADD   HL,DE   ; the new top
0197                          IF   CHECKED   
                              CALL   chkhp   
0197                          ENDIF      
0197   22 7C 07               LD   (HEAP),HL   
019A   EB                     EX   DE,HL   
019B   F7                     RST   30h   
019C   D9           EXEC:     EXX      
019D   22 34 07               LD   (RSAVE),HL   ; machine code may change the alternates
01A0   D9                     EXX      
01A1   CD 2B 01               CALL   jphl   
01A4   D9                     EXX      
01A5   2A 34 07               LD   HL,(RSAVE)   
01A8   D9                     EXX      
01A9   E1                     POP   HL   
01AA   F7                     RST   30h   
01AB                             ; ---- the letters and digits (here, in the middle, so that the inner loop's
01AB                             ; ---- short jumps reach them, and the handlers after them reach rpushn) ------
01AB                             ; Digits: step back onto the first digit and read the whole number.
01AB   E5           DIGIT:    PUSH   HL   
01AC   0B                     DEC   BC   
01AD   CD 22 03               CALL   rdnum   
01B0   F7                     RST   30h   
01B1                             ; a-z: push the cell's address (the cell is the variable)
01B1   E5           LOWER:    PUSH   HL   
01B2   87                     ADD   A,A   
01B3   6F                     LD   L,A   
01B4   26 07                  LD   H,LETPAGE   
01B6   F7                     RST   30h   
01B7                             ; A-Z: call the word. The return address (the IP after the letter) goes on
01B7                             ; the return stack, and the IP becomes the address in the letter's cell.
01B7   C5           UPPER:    PUSH   BC   ; the return address, for rpushn
01B8   EB                     EX   DE,HL   ; park TOS
01B9   87                     ADD   A,A   
01BA   6F                     LD   L,A   
01BB   26 07                  LD   H,LETPAGE   ; HL -> cell
01BD   4E                     LD   C,(HL)   
01BE   2C                     INC   L   
01BF   46                     LD   B,(HL)   ; IP = the word's body
01C0   EB                     EX   DE,HL   ; TOS back, and fall into rpushn
01C1                             ; rpushn: move the top cell of the data stack (in memory) to the return
01C1                             ; stack, then next. Everything that pushes the return stack ends here.
01C1                             ; 
01C1                             ; The break key is looked at here, so at every word call and loop-back (and
01C1                             ; block entry and "{"), but only one time in 256: B', which nothing else
01C1                             ; uses, counts them. Reading the keyboard can be slow (it is a BDOS call
01C1                             ; under CP/M), and this way it costs a loop two bytes and 13 T-states.
01C1   D9           RPUSHN:   EXX      
01C2   D1                     POP   DE   
01C3   2B                     DEC   HL   
01C4   72                     LD   (HL),D   
01C5   2B                     DEC   HL   
01C6   73                     LD   (HL),E   
01C7   10 05                  DJNZ   rp1   
01C9   D9                     EXX      
01CA   CD B1 03               CALL   pollk   
01CD   F7                     RST   30h   
01CE   D9           RP1:      EXX      
01CF   F7                     RST   30h   
01D0                             ; ---- machine code: the grave -----------------------------------------------
01D0                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
01D0                             ; are stored from addr until a non-hex character; then a RET (C9h) is
01D0                             ; written and its address is left. An odd last digit is consumed and dropped.
01D0                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
01D0                             ; code is entered by CALL with the data stack above the return address; it
01D0                             ; must keep BC, and on return the top cell becomes the new TOS.
01D0   CD 9F 03     H_GRAVE:   CALL   hexc   
01D3   30 C7                  JR   NC,exec   
01D5   77           HX1:      LD   (HL),A   ; the high digit goes in first ...
01D6   CD 9F 03               CALL   hexc   
01D9   30 08                  JR   NC,hx2   ; odd digit: consumed, and the RET below
01DB   ED 6F                  RLD      ;   overwrites it
01DD   23                     INC   HL   ; ... and RLD shifts it up under the low one
01DE   CD 9F 03               CALL   hexc   
01E1   38 F2                  JR   C,hx1   
01E3   36 C9        HX2:      LD   (HL),0C9h   ; (never range-checked: the spec says so)
01E5   F7                     RST   30h   
01E6                             ; ---- where the two pages meet ----------------------------------------------
01E6                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
01E6                             ; are in falling code order for this), and where exactly differs between the
01E6                             ; builds: NPG1 follows. Every handler below these four must start in the
01E6                             ; second page, and every one above in the first; chktab.py checks both.
01E6                             ; "]" returns: pop an address and jump to it.
01E6   CF           H_RET:    RST   08h   
01E7   42                     LD   B,D   
01E8   4B                     LD   C,E   
01E9   F7           BRK1:     RST   30h   
01EA                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
01EA                             ; drops the block start, "]" returns. No closer at all ends the program.
01EA   7C           H_BREAK:   LD   A,H   
01EB   B5                     OR   L   
01EC   E1                     POP   HL   
01ED   28 FA                  JR   Z,brk1   
01EF   CD 44 03               CALL   skip   
01F2   B7                     OR   A   ; skip returns 0 for ")"
01F3   20 F1                  JR   NZ,h_ret   
01F5   CF           RDROP:    RST   08h   
01F6   F7                     RST   30h   
01F7                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
01F7                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
01F7                             ; the body"s address instead. Either way it then skips to the matching "]'.
01F7                             ; (The unchecked build takes anything that is not a letter as the space; the
01F7                             ; checked build stops on it.)
01F7   0A           H_DEF:    LD   A,(BC)   
01F8   03                     INC   BC   
01F9   D6 41                  SUB   "A"   ; a letter gives 0-25 or 32-57: lowercase
01FB   5F                     LD   E,A   ;   lands 64 bytes up
01FC   E6 DF                  AND   0DFh   ; fold case
01FE   FE 1A                  CP   26   
0200   30 0B                  JR   NC,def2   ; not a letter
0202   CB 23                  SLA   E   
0204   16 07                  LD   D,LETPAGE   ; DE -> cell
0206   79                     LD   A,C   
0207   12                     LD   (DE),A   
0208   1C                     INC   E   
0209   78                     LD   A,B   
020A   12                     LD   (DE),A   
020B   18 03                  JR   skipnx   
020D                DEF2:        
020D                          IF   CHECKED   
                              LD   A,E   
                              CP   " "-"A"+256   
                              JP   NZ,e_brack   ; anything but a letter or a space
020D                          ENDIF      
020D   E5                     PUSH   HL   ; an anonymous block: push its address
020E   60                     LD   H,B   
020F   69                     LD   L,C   
0210                SKIPNX:      
0210                          IF   CHECKED   
                              DEC   BC   ; back onto the letter, so that skip finds its
0210                          ENDIF      ;   opener, the "[", just before where it starts
0210   CD 44 03     SKIPO:    CALL   skip   
0213   F7                     RST   30h   
0214   5E           H_FETCH:   LD   E,(HL)   ; "@"
0215   23                     INC   HL   
0216   56                     LD   D,(HL)   
0217   EB                     EX   DE,HL   
0218   F7                     RST   30h   
0219                             ; =============================================================================
0219                             ;  Handlers that must start in the image's second page.
0219                             ;  "?" is the last (with "," inside it), so its long tail may run past that
0219                             ;  page.
0219                             ; =============================================================================
0219                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
0219                             ; the matching ")".
0219   7C           H_OPEN:   LD   A,H   
021A   B5                     OR   L   
021B   E1                     POP   HL   
021C   28 F2                  JR   Z,skipo   
021E   C5                     PUSH   BC   ; the block starts at the IP
021F   18 A0                  JR   rpushn   
0221                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
0221                             ; drops it and carries on.
0221   7C           H_CLOSE:   LD   A,H   
0222   B5                     OR   L   
0223   E1                     POP   HL   
0224   28 CF                  JR   Z,rdrop   
0226   CF                     RST   08h   ; pop the block start ...
0227   42                     LD   B,D   
0228   4B                     LD   C,E   
0229   C5                     PUSH   BC   
022A   18 95                  JR   rpushn   ; ... and push it back
022C                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
022C                             ; "-" has two jobs: directly before a digit it starts a negative number.
022C   0A           H_SUB:    LD   A,(BC)   
022D   D6 30                  SUB   "0"   
022F   FE 0A                  CP   10   
0231   38 04                  JR   C,negnum   
0233   E7                     RST   20h   ; a - b = a + (-b): fall into "+"
0234   D1           H_ADD:    POP   DE   
0235   19                     ADD   HL,DE   
0236   F7                     RST   30h   
0237   E5           NEGNUM:   PUSH   HL   ; a negative number: read it, negate it
0238   CD 22 03               CALL   rdnum   
023B   E7                     RST   20h   
023C   F7                     RST   30h   
023D   D1           H_AND:    POP   DE   
023E   7C                     LD   A,H   
023F   A2                     AND   D   
0240   67                     LD   H,A   
0241   7D                     LD   A,L   
0242   A3                     AND   E   
0243   6F                     LD   L,A   
0244   F7                     RST   30h   
0245                             ; Signed compares. Both are "HL < DE" for the right pair: "<" swaps the two
0245                             ; cells first. Flipping both sign bits turns a signed compare into an
0245                             ; unsigned one (and XOR clears the carry for SBC); SBC HL,HL then turns the
0245                             ; carry into -1 or 0 with no branch.
0245   E3           H_LT:     EX   (SP),HL   ; a < b: HL = a, and b is popped next
0246   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
0247   7C                     LD   A,H   
0248   EE 80                  XOR   80h   
024A   67                     LD   H,A   
024B   7A                     LD   A,D   
024C   EE 80                  XOR   80h   
024E   57                     LD   D,A   
024F   ED 52                  SBC   HL,DE   ; carry if HL < DE
0251   ED 62        TF:       SBC   HL,HL   ; carry -> -1 or 0
0253   F7                     RST   30h   
0254   D1           H_EQ:     POP   DE   
0255   B7                     OR   A   
0256   ED 52                  SBC   HL,DE   
0258   7C                     LD   A,H   
0259   B5                     OR   L   
025A   FE 01                  CP   1   ; carry only if a - b = 0
025C   18 F3                  JR   tf   
025E                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept. The
025E                             ; multiplier shifts up through A:C.
025E   D1           H_MUL:    POP   DE   ; DE = multiplicand
025F   C5                     PUSH   BC   
0260   7C                     LD   A,H   
0261   4D                     LD   C,L   ; A:C = multiplier
0262   21 00 00               LD   HL,0   
0265   06 10                  LD   B,16   
0267   29           MUL1:     ADD   HL,HL   
0268   CB 21                  SLA   C   
026A   17                     RLA      
026B   30 01                  JR   NC,mul2   
026D   19                     ADD   HL,DE   
026E   10 F7        MUL2:     DJNZ   mul1   
0270   C1                     POP   BC   
0271   F7                     RST   30h   
0272                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
0272                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
0272                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
0272                             ; stops on it.
0272                H_DIV:       
0272                          IF   CHECKED   
                              LD   A,H   
                              OR   L   
                              JP   Z,e_zero   
0272                          ENDIF      
0272   D1                     POP   DE   ; DE = a, HL = b
0273   C5                     PUSH   BC   ; free BC for udiv
0274   D5                     PUSH   DE   ; a, for r's sign
0275   7A                     LD   A,D   
0276   AC                     XOR   H   
0277   F5                     PUSH   AF   ; S flag = sign of q
0278   CB 7C                  BIT   7,H   
027A   C4 20 01               CALL   NZ,neg16   ; HL = |b|
027D   EB                     EX   DE,HL   
027E   CB 7C                  BIT   7,H   
0280   C4 20 01               CALL   NZ,neg16   ; HL = |a|, DE = |b|
0283   CD FC 02               CALL   udiv   ; HL = q, DE = r
0286   F1                     POP   AF   
0287   FC 20 01               CALL   M,neg16   ; q's sign
028A   EB                     EX   DE,HL   ; HL = r, DE = q
028B   F1                     POP   AF   ; A = a's high byte
028C   B7                     OR   A   
028D   FC 20 01               CALL   M,neg16   ; r's sign
0290   C1                     POP   BC   
0291   D5                     PUSH   DE   ; q under r
0292   F7                     RST   30h   
0293                             ; ---- stack and storage -----------------------------------------------------
0293   E5           H_DUP:    PUSH   HL   ; ":"
0294   F7                     RST   30h   
0295   E3           H_SWAP:   EX   (SP),HL   ; "%"
0296   F7                     RST   30h   
0297                             ; (The checked build tests the address before it takes the value off the
0297                             ; stack, so that an error report shows both.)
0297                H_CSTORE:      ; "." ( c addr -- )
0297                          IF   CHECKED   
                              CALL   chkst   
0297                          ENDIF      
0297   D1                     POP   DE   
0298   73                     LD   (HL),E   
0299   DF           H_DROP:   RST   18h   ; ";" is this one byte
029A                H_STORE:      ; "!" ( n addr -- )
029A                          IF   CHECKED   
                              CALL   chkst   
029A                          ENDIF      
029A   D1                     POP   DE   
029B   73                     LD   (HL),E   
029C   23                     INC   HL   
029D   72                     LD   (HL),D   
029E   DF                     RST   18h   
029F                             ; ---- console ---------------------------------------------------------------
029F                             ; 22h pushes the address of the text after it and skips the string.
029F   E5           H_STR:    PUSH   HL   
02A0   60                     LD   H,B   
02A1   69                     LD   L,C   
02A2   CD 39 03               CALL   skipstr   
02A5                          IF   CHECKED   
                              OR   A   ; 0: the text ran out before the closing quote
                              JP   Z,e_quote   
02A5                          ENDIF      
02A5   F7                     RST   30h   
02A6                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character
02A6                             ; clears that character"s bit 6 (/M is CR, /` is space; "/" and ""' have no
02A6                             ; bit 6, so // and /" give themselves).
02A6                          IF   1-CHECKED   
02A6   7E           H_PRINT:   LD   A,(HL)   
02A7   23                     INC   HL   
02A8   FE 22                  CP   22h   
02AA   28 0D                  JR   Z,pr9   
02AC   FE 2F                  CP   "/"   
02AE   20 04                  JR   NZ,pr1   
02B0   7E                     LD   A,(HL)   
02B1   23                     INC   HL   
02B2   E6 BF                  AND   0BFh   
02B4   EF           PR1:      RST   28h   
02B5   18 EF                  JR   h_print   
02B7                          ENDIF      
02B7                          IF   CHECKED   
                                 ; (The checked build has the loop as a routine, prstr, which the error
                                 ; report uses too. The address is kept on the stack meanwhile: a report
                                 ; shows the stack as it was before the "$".)
                    H_PRINT:   PUSH   HL   
                              CALL   prstr   
                              POP   DE   
                              RST   18h   
02B7                          ENDIF      
02B7   7D           H_EMIT:   LD   A,L   ; "'"
02B8   EF                     RST   28h   
02B9   DF           PR9:      RST   18h   
02BA                             ; "#" prints TOS as a signed decimal number, with no space after it.
02BA   C5           H_NUM:    PUSH   BC   
02BB   CD 65 03               CALL   psgn   
02BE   C1                     POP   BC   
02BF   DF                     RST   18h   
02C0                             ; "?" ( n -- c ) or ( -n -- addr )
02C0                             ;   n > 0: wait about n ms for a key; 0 if none came
02C0                             ;   n = 0: wait for a key
02C0                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
02C0                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
02C0   CB 7C        H_KEY:    BIT   7,H   
02C2   20 19                  JR   NZ,line   
02C4   1E 28        KT1:      LD   E,MSLOOP   ; one millisecond, roughly
02C6   CD BD 03     KT2:      CALL   getk   
02C9   20 0E                  JR   NZ,kt3   
02CB   1D                     DEC   E   
02CC   20 F8                  JR   NZ,kt2   
02CE   7C                     LD   A,H   ; 0? never counts down: it waits
02CF   B5                     OR   L   
02D0   28 F2                  JR   Z,kt1   
02D2   2B                     DEC   HL   
02D3   7C                     LD   A,H   
02D4   B5                     OR   L   
02D5   20 ED                  JR   NZ,kt1   ; A = 0 if the time ran out
02D7   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
02D8   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
02D9   6F           KT3:      LD   L,A   
02DA   26 00                  LD   H,0   
02DC   F7                     RST   30h   
02DD                          IF   CPM   
02DD                             ; CP/M: BDOS 10 does the editing (the spec allows the platform's
02DD                             ; own line editor). It doesn't store the CR, so it is added here.
02DD   11 7F 00     LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
02E0   19                     ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
02E1   9F                     SBC   A,A   
02E2   A5                     AND   L   ; (0 for a count that is too big)
02E3   EE 7F                  XOR   127   ; A = the count, 127 at most
02E5                          ENDIF      
02E5                          IF   CPM*EDITOR   
                              CALL   rdline   ; (the editor calls rdline too)
                              LD   L,LINEBUF & 0FFh   
                              RST   30h   
                                 ; rdline: read a line of at most A characters; HL -> the CR that ends it
                    RDLINE:      
02E5                          ENDIF      
02E5                          IF   CPM   
02E5   32 7E 07               LD   (LBHDR),A   
02E8   11 7E 07               LD   DE,LBHDR   
02EB   3E 0A                  LD   A,10   
02ED   CD 01 04               CALL   bdosx   
02F0   21 7F 07               LD   HL,LBHDR+1   
02F3   7E                     LD   A,(HL)   ; the count typed (0-127)
02F4   2C                     INC   L   ; HL = LINEBUF, whose low byte is 80h:
02F5   85                     ADD   A,L   ;   adding the count to L can't carry
02F6   6F                     LD   L,A   
02F7   36 0D                  LD   (HL),13   
02F9                          ENDIF      
02F9                          IF   CPM*(1-EDITOR)   
02F9   2E 80                  LD   L,LINEBUF & 0FFh   
02FB   F7                     RST   30h   
02FC                          ENDIF      
02FC                          IF   CPM*EDITOR   
                              RET      
02FC                          ENDIF      
02FC                          IFN   CPM   
                                 ; Generic: Backspace takes the last character back (and is echoed as
                                 ; it is), CR ends (stored, not echoed), every other key is stored and
                                 ; echoed until the line is full. The line buffer starts at offset 80h
                                 ; of its page, so L alone is the place in the line: D holds the L of
                                 ; a full line.
02FC                          ENDIF      
02FC                          IFN   CPM   
                    LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
                              ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
                              SBC   A,A   
                              AND   L   ; (0 for a count that is too big)
                              CPL      
                              LD   D,A   ; D = the L of a full line: 80h + count, FFh
02FC                          ENDIF      ;   at most
02FC                          IF   EDGEN   
                              CALL   rdline   ; (the editor calls rdline too)
                              LD   L,LINEBUF & 0FFh   
                              RST   30h   
                                 ; rdline: read a line that is full when L reaches D; HL -> the CR that ends it
                    RDLINE:      
02FC                          ENDIF      
02FC                          IFN   CPM   
                              LD   HL,LINEBUF   
                    LN2:      CALL   getk   
                              JR   Z,ln2   
                              CP   13   
                              JR   Z,ln5   
                              CP   8   
                              JR   Z,ln4   
                              LD   E,A   
                              LD   A,L   
                              CP   D   
                              JR   Z,ln2   ; full
                              LD   (HL),E   
                              INC   L   
                              LD   A,E   
                    LN3:      RST   28h   
                              JR   ln2   
                    LN4:      DEC   L   ; Backspace: one back, and echo it,
                              JP   M,ln3   ;   unless the line was empty (L left the
                              INC   L   ;   upper half of the page)
                              JR   ln2   
                    LN5:      LD   (HL),A   ; the CR
02FC                          ENDIF      
02FC                          IF   (1-CPM)*(1-EDITOR)   
                              LD   L,LINEBUF & 0FFh   
                              RST   30h   
02FC                          ENDIF      
02FC                          IF   EDGEN   
                              RET      
02FC                          ENDIF      
02FC                             ; =============================================================================
02FC                             ;  More routines (no handler starts past this point)
02FC                             ; =============================================================================
02FC                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
02FC                             ; Uses A, BC; the caller saves the IP. The dividend shifts up through A:C
02FC                             ; while the quotient bits arrive at the bottom of C.
02FC                             ; Dividing by 2 is one shift (the spec wants that fast).
02FC   7B           UDIV:     LD   A,E   
02FD   EE 02                  XOR   2   
02FF   B2                     OR   D   
0300   20 07                  JR   NZ,udv0   
0302   CB 3C                  SRL   H   
0304   CB 1D                  RR   L   ; the quotient
0306   8F                     ADC   A,A   
0307   5F                     LD   E,A   ; the remainder: the bit that fell out (D is 0)
0308   C9                     RET      
0309   7C           UDV0:     LD   A,H   
030A   4D                     LD   C,L   
030B   21 00 00               LD   HL,0   
030E   06 10                  LD   B,16   
0310   CB 21        UDV1:     SLA   C   
0312   17                     RLA      
0313   ED 6A                  ADC   HL,HL   
0315   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
0317   30 02                  JR   NC,udv2   ;   always fits in 16 bits
0319   19                     ADD   HL,DE   ; too much: put it back, and cancel the
031A   0D                     DEC   C   ;   INC below
031B   0C           UDV2:     INC   C   ; a quotient bit
031C   10 F2                  DJNZ   udv1   
031E   EB                     EX   DE,HL   ; DE = remainder
031F   67                     LD   H,A   
0320   69                     LD   L,C   ; HL = quotient
0321   C9                     RET      
0322                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
0322                             ; non-digit. Values wrap at 16 bits, as the spec says.
0322   21 00 00     RDNUM:    LD   HL,0   
0325   0A           RDN1:     LD   A,(BC)   
0326   D6 30                  SUB   "0"   
0328   FE 0A                  CP   10   
032A   D0                     RET   NC   
032B   03                     INC   BC   
032C   54                     LD   D,H   
032D   5D                     LD   E,L   
032E   29                     ADD   HL,HL   
032F   29                     ADD   HL,HL   
0330   19                     ADD   HL,DE   
0331   29                     ADD   HL,HL   ; HL * 10
0332   5F                     LD   E,A   
0333   16 00                  LD   D,0   
0335   19                     ADD   HL,DE   
0336   18 ED                  JR   rdn1   
0338                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
0338                             ; the next character, so "/"" does not end it. Leaves A = 22h.
0338                          IF   1-CHECKED   
0338   03           SS0:      INC   BC   
0339   0A           SKIPSTR:   LD   A,(BC)   
033A   03                     INC   BC   
033B   FE 2F                  CP   "/"   
033D   28 F9                  JR   Z,ss0   
033F   FE 22                  CP   22h   
0341   20 F6                  JR   NZ,skipstr   
0343   C9                     RET      
0344                          ENDIF      
0344                          IF   CHECKED   
                                 ; The checked build never steps over a NUL: if the text runs out first it
                                 ; returns A = 0 with the IP on the NUL.
                    SKIPSTR:   LD   A,(BC)   
                              OR   A   
                              RET   Z   
                              INC   BC   
                              CP   22h   
                              RET   Z   
                              CP   "/"   
                              JR   NZ,skipstr   
                              LD   A,(BC)   ; the escaped character
                              OR   A   
                              RET   Z   
                              INC   BC   
                              JR   skipstr   
0344                          ENDIF      
0344                             ; skip: read past text to the closer at this level, and return A = 0 if it
0344                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
0344                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
0344                             ; no closer; anything else that runs into the NUL had unbalanced brackets
0344                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
0344                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
0344                             ; 
0344                             ; The checked build also looks at the character the skip was started by,
0344                             ; which is always the one just before where it starts: "(" must end at ")",
0344                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
0344                             ; quote counts as running into it. "\" takes either closer. IX keeps the
0344                             ; place where the skip started, for the report.
0344                SKIP:        
0344                          IF   CHECKED   
                              PUSH   BC   
                              POP   IX   
                              DEC   BC   
                              LD   A,(BC)   
                              INC   BC   
                              LD   E,A   ; E = the opener: ( [ or \
0344                          ENDIF      
0344   16 00                  LD   D,0   
0346   14           SK3:      INC   D   ; an opener: one deeper
0347   0A           SK1:      LD   A,(BC)   
0348                          IF   1-CHECKED   
0348   03                     INC   BC   
0349   B7                     OR   A   
034A   CA 15 01               JP   Z,endprog   
034D                          ENDIF      
034D                          IF   CHECKED   
                              OR   A   
                              JR   Z,sk6   ; (the IP stays on the NUL)
                              INC   BC   
034D                          ENDIF      
034D   FE 22                  CP   22h   
034F   CC 39 03               CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
0352   D6 28                  SUB   "("   ;   (or 0, and then the NUL is read next)
0354   28 F0                  JR   Z,sk3   
0356   3D                     DEC   A   ; ")"
0357   28 08                  JR   Z,sk4   
0359   D6 32                  SUB   "["-")"   
035B   28 E9                  JR   Z,sk3   
035D   FE 02                  CP   "]"-"["   
035F   20 E6                  JR   NZ,sk1   
0361   15           SK4:      DEC   D   
0362                          IF   1-CHECKED   
0362   C8                     RET   Z   ; the closer at this level
0363   18 E2                  JR   sk1   
0365                          ENDIF      
0365                          IF   CHECKED   
                              JR   NZ,sk1   
                              LD   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
                              XOR   E   ;   opener is 0 for "(" and 1 for "[", and only
                              AND   6   ;   "\" has bit 2: so this is 2 for the wrong
                              CP   2   ;   closer, and only then
                              LD   A,D   
                              RET   NZ   
                              JR   sk7   
                    SK6:      BIT   2,E   ; the text ran out:
                              JP   NZ,endprog   ;   "\" with no closer ends the program
                    SK7:      PUSH   IX   ; N. The place is the opener
                              POP   BC   
                              LD   A,"N"   
                              JP   errp   ; (errp drops skip's return address)
0365                          ENDIF      
0365                             ; psgn: print HL as a signed number. Uses BC.
0365   CB 7C        PSGN:     BIT   7,H   
0367   28 04                  JR   Z,pdec   
0369   3E 2D                  LD   A,"-"   
036B   EF                     RST   28h   
036C   E7                     RST   20h   
036D                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
036D                             ; Uses BC.
036D   11 0A 00     PDEC:     LD   DE,10   
0370   CD FC 02               CALL   udiv   ; HL = HL / 10, E = the last digit
0373   7B                     LD   A,E   
0374   F5                     PUSH   AF   
0375   7C                     LD   A,H   
0376   B5                     OR   L   
0377   C4 6D 03               CALL   NZ,pdec   
037A   F1                     POP   AF   
037B   C6 30                  ADD   A,"0"   
037D   EF                     RST   28h   
037E   C9                     RET      
037F                             ; =============================================================================
037F                             ;  Dispatch table: the low byte of each handler's address, in code order
037F                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
037F                             ;  It must not cross a page (the dispatcher only adds to its low byte).
037F                             ; =============================================================================
037F                             ; The handlers of the first NPG1 characters start in the image's second page.
037F                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
037F                             ; differs between the builds, so the count is worked out here.
037F                             ; (One division to a line: asm80 only rounds down when it stores a value.)
037F                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
037F                PGBRK:    EQU   (h_break-BASE)/256   
037F                PGDEF:    EQU   (h_def-BASE)/256   
037F                PGFET:    EQU   (h_fetch-BASE)/256   
037F                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
037F                          IF   1-TABP0   
037F                PTAB:        
037F                          ;*Macro unroll:  PTABLE
037F   9A                     DB   h_store & 0FFh   
0380   9F                     DB   h_str & 0FFh   
0381   BA                     DB   h_num & 0FFh   
0382   A6                     DB   h_print & 0FFh   
0383   95                     DB   h_swap & 0FFh   
0384   3D                     DB   h_and & 0FFh   
0385   B7                     DB   h_emit & 0FFh   
0386   19                     DB   h_open & 0FFh   
0387   21                     DB   h_close & 0FFh   
0388   5E                     DB   h_mul & 0FFh   
0389   34                     DB   h_add & 0FFh   
038A   D8                     DB   h_cfetch & 0FFh   
038B   2C                     DB   h_sub & 0FFh   
038C   97                     DB   h_cstore & 0FFh   
038D   72                     DB   h_div & 0FFh   
038E   93                     DB   h_dup & 0FFh   
038F   99                     DB   h_drop & 0FFh   
0390   45                     DB   h_lt & 0FFh   
0391   54                     DB   h_eq & 0FFh   
0392   46                     DB   h_gt & 0FFh   
0393   C0                     DB   h_key & 0FFh   
0394   14                     DB   h_fetch & 0FFh   
0395   F7                     DB   h_def & 0FFh   
0396   EA                     DB   h_break & 0FFh   
0397   E6                     DB   h_ret & 0FFh   
0398   7F                     DB   h_xor & 0FFh   
0399   92                     DB   h_alloc & 0FFh   
039A   D0                     DB   h_grave & 0FFh   
039B   2C                     DB   h_tor & 0FFh   
039C   87                     DB   h_or & 0FFh   
039D   1C                     DB   h_fromr & 0FFh   
039E   8F                     DB   h_not & 0FFh   
039F                PTABEND:      
039F                          ENDIF      
039F                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
039F                             ; and return its value in A with the carry set; otherwise leave the IP and
039F                             ; return with the carry clear.
039F   0A           HEXC:     LD   A,(BC)   
03A0   D6 30                  SUB   "0"   
03A2   FE 0A                  CP   10   
03A4   38 09                  JR   C,hc1   
03A6   E6 DF                  AND   0DFh   
03A8   D6 11                  SUB   11h   
03AA   FE 06                  CP   6   
03AC   D0                     RET   NC   
03AD   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
03AF   03           HC1:      INC   BC   
03B0   C9                     RET      
03B1                             ; =============================================================================
03B1                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
03B1                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
03B1                             ;  (RST 28h) prints A. Both keep BC, DE, HL and HL'. In the generic build
03B1                             ;  they are the host's KEY and CONOUT routines themselves.
03B1                             ; 
03B1                             ;  A running program reads the keyboard only through getk and pollk, which
03B1                             ;  between them give the break key its rules:
03B1                             ;    - Ctrl-C stops the program;
03B1                             ;    - any other key that the break check reads is held in KEYBUF for the
03B1                             ;      next "?", and a newer one takes its place;
03B1                             ;    - "?" (getk) takes the held key first;
03B1                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
03B1                             ;      key like any other, but two of them within about 250 ms still stop it.
03B1                             ;  Both are called straight from a handler, never from a routine under one:
03B1                             ;  the checked build's report counts on finding one return address above the
03B1                             ;  data stack.
03B1                             ; =============================================================================
03B1                          IFN   CPM   
                    RAWK:     EQU   KEY   
03B1                          ENDIF      
03B1                             ; pollk: the break check (see rpushn).
03B1   CD F3 03     POLLK:    CALL   rawk   
03B4   C8                     RET   Z   ; no key
03B5   32 7A 07               LD   (KEYBUF),A   ; held for the next "?"
03B8   FE 03                  CP   3   
03BA   C0                     RET   NZ   
03BB   18 11                  JR   ctlc   
03BD                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
03BD   E5           GETK:     PUSH   HL   ; a held key goes first, and is taken out of
03BE   21 7A 07               LD   HL,KEYBUF   ;   the buffer
03C1   7E                     LD   A,(HL)   
03C2   36 00                  LD   (HL),0   
03C4   E1                     POP   HL   
03C5   B7                     OR   A   
03C6   C0                     RET   NZ   
03C7   CD F3 03               CALL   rawk   
03CA   C8                     RET   Z   
03CB   FE 03                  CP   3   
03CD   C0                     RET   NZ   
03CE                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
03CE                             ; the program has turned it off, wait about 250 ms for one more key: a
03CE                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
03CE                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
03CE   3A 7B 07     CTLC:     LD   A,(BRKOFF)   
03D1   B7                     OR   A   
03D2   CA 15 01               JP   Z,brk   
03D5   D5                     PUSH   DE   
03D6   11 10 27               LD   DE,250*MSLOOP   
03D9   CD F3 03     CT1:      CALL   rawk   
03DC   20 05                  JR   NZ,ct2   
03DE   1B                     DEC   DE   
03DF   7A                     LD   A,D   
03E0   B3                     OR   E   
03E1   20 F6                  JR   NZ,ct1   
03E3   D1           CT2:      POP   DE   ; A = the second key, or 0 if none came
03E4   FE 03                  CP   3   
03E6   CA 15 01               JP   Z,brk   
03E9   B7                     OR   A   
03EA   28 03                  JR   Z,ct3   
03EC   32 7A 07               LD   (KEYBUF),A   
03EF   3E 03        CT3:      LD   A,3   
03F1   B7                     OR   A   
03F2   C9                     RET      
03F3                          IF   1-CHECKED   
03F3                BRK:      EQU   endprog   ; the unchecked build stops without a word;
03F3                          ENDIF      
03F3                          IF   CHECKED   
                    BRK:      EQU   e_break   ;   the checked build reports B
03F3                          ENDIF      
03F3                          IF   CPM   
03F3   3E FF        RAWK:     LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
03F5                             ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
03F5                             ; printing and could swallow a key that BDOS 6 then never sees.
03F5   D5           PUTC:     PUSH   DE   
03F6   E5                     PUSH   HL   
03F7   5F                     LD   E,A   
03F8   3E 06                  LD   A,6   
03FA   CD 01 04               CALL   bdosx   
03FD   E1                     POP   HL   
03FE   D1                     POP   DE   
03FF   B7                     OR   A   ; (for getk)
0400   C9                     RET      
0401                             ; bdosx: call BDOS function A with DE, keeping BC and HL'
0401   C5           BDOSX:    PUSH   BC   
0402   D9                     EXX      
0403   E5                     PUSH   HL   
0404   D9                     EXX      
0405   4F                     LD   C,A   
0406   CD 05 00               CALL   BDOS   
0409   D9                     EXX      
040A   E1                     POP   HL   
040B   D9                     EXX      
040C   C1                     POP   BC   
040D   C9                     RET      
040E                          ENDIF      
040E                             ; =============================================================================
040E                             ;  Checked build: the checks and the error report
040E                             ; =============================================================================
040E                          IF   CHECKED   
                                 ; chkst: stop unless HL is in the program's own space: from the letter page
                                 ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
                                 ; whatever lies above the limit are safe. Memory above the heap top but
                                 ; below the limit is the program's own: Tiny BASIC keeps its lines there.
                                 ; It is the page of HL + 1 that is tested, so that one test serves both
                                 ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
                                 ; Keeps HL and BC.
                    CHKST:    INC   HL   
                              LD   A,H   
                              DEC   HL   
                              CP   LETPAGE   
                              JR   C,chs1   
040E                          ENDIF      
040E                          IF   CHECKED*(1-CPM)   
                              CP   HEAPLIM   
                              RET   C   
040E                          ENDIF      
040E                          IF   CHECKED*CPM   
                              LD   E,A   
                              LD   A,(0007h)   ; the BDOS page is the heap limit
                              DEC   A   
                              CP   E   
                              RET   NC   
040E                          ENDIF      
040E                          IF   CHECKED   
                    CHS1:     JP   e_store   
                                 ; chkhp: HL = the new heap top, DE = the old one, the carry is from adding
                                 ; the count. Stop if the top is not below the limit page, or is below the
                                 ; program's end.
                    CHKHP:       
040E                          ENDIF      
040E                          IF   CHECKED*CPM   
                                 ; With this much room a top that wrapped round can land back in
                                 ; range, so the add is tested too: growing (A, the count's high
                                 ; byte, is positive) must not carry, and releasing must.
                              RRA      ; the carry comes in above the sign:
                              ADD   A,40h   ;   bit 7 = carry XOR sign
                              ADD   A,A   
                              JR   C,e_heap   
                              LD   A,(0007h)   
                              DEC   A   
                              CP   H   
                              JR   C,e_heap   
040E                          ENDIF      
040E                          IF   CHECKED*(1-CPM)   
                                 ; (Here the program's space is under 32K, so a top that wrapped
                                 ; round always falls outside it.)
                              LD   A,H   
                              CP   HEAPLIM   
                              JR   NC,e_heap   
040E                          ENDIF      
040E                          IF   CHECKED   
                              PUSH   DE   
                              EX   DE,HL   
                              LD   HL,(NPEND)   
                              ADD   HL,DE   ; carry: at or above the program's end
                              EX   DE,HL   
                              POP   DE   
                              RET   C   
                    E_HEAP:   OR   A   ; put the count back in TOS for the report
                              SBC   HL,DE   
                              JP   e_heap1   
                                 ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
                                 ; "$", and the error report's texts). A NUL first is an error: Q.
                    PRSTR:    LD   A,(HL)   
                              INC   HL   
                              CP   22h   
                              RET   Z   
                              OR   A   
                              JR   Z,e_dollar   
                              CP   "/"   
                              JR   NZ,prs1   
                              LD   A,(HL)   
                              INC   HL   
                              AND   0BFh   
                    PRS1:     RST   28h   
                              JR   prstr   
                    E_DOLLAR:   POP   DE   ; "$" ran into a NUL: drop the return address,
                              POP   HL   ;   and put the string's address back in TOS
                              LD   A,"Q"   
                              JP   error   
                                 ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
                                 ; pnl: the same, on a new line.
                    PNL:      LD   A,13   
                              RST   28h   
                              LD   A,10   
                              RST   28h   
                    PMSG:     EX   (SP),HL   
                              CALL   prstr   
                              EX   (SP),HL   
                              RET      
                                 ; chkstk: both stacks are checked once per character, not in every handler.
                                 ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
                                 ; the constant carries if it is above (cells were popped that were never
                                 ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
                                 ; a character late at most: the bytes above DSTOP and the guard band below
                                 ; the page take what happens meanwhile. DE is free between characters.
                    CHKSTK:   EX   DE,HL   
                              LD   HL,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
                              ADD   HL,SP   
                              EX   DE,HL   
                              JR   C,e_under   
                              INC   D   
                              JR   NZ,e_over   
                              EXX      ; the return stack: in its page (or it has
                              LD   A,H   ;   overflowed), and not above its empty
                              CP   RSPAGE   ;   position (an underflow stays inside the
                              LD   A,L   ;   page, in the guard band)
                              EXX      
                              JR   NZ,e_rover   
                              CP   RSTOP&0FFh+1   
                              RET   C   
                              EXX      ; return stack underflow: it counts as empty
                              LD   HL,RSTOP   
                              EXX      
                              LD   A,"r"   
                              JR   errp   
                    E_ROVER:   LD   A,"R"   ; return stack overflow
                              DB   11h   ; (LD DE,nn hides the next entry)
                    E_OVER:   LD   A,"S"   ; data stack overflow
                              JR   errp   
                    E_UNDER:   LD   SP,DSTOP   ; data stack underflow: it counts as empty
                              LD   A,"s"   
                              JR   error   
                                 ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
                                 ; was never defined still holds 0000h, and the byte there is a reserved one
                                 ; in every build (AFh or C3h): if the IP is in page zero, this was a call of
                                 ; an undefined word. The call is undone, so the place is the call itself.
                    E_HI:     INC   B   
                              DJNZ   e_resv   ; (B is as it was, and is not 0)
                              RST   08h   
                              LD   B,D   
                              LD   C,E   
                              LD   A,"U"   
                              JR   error   
                                 ; Error entries. Each loads its letter and then hides the next entry inside
                                 ; a 3-byte LD DE,nn (the 11h), so they all fall through to `error`.
                    E_BREAK:   LD   A,"B"   ; Ctrl-C (found inside pollk or getk)
                              DB   11h   
                    E_HEAP1:   LD   A,"H"   ; heap (found inside chkhp)
                              DB   11h   
                    E_STORE:   LD   A,"O"   ; a store outside the program's space (chkst)
                                 ; errp: an error found inside a routine: drop its return address first.
                    ERRP:     POP   DE   
                              JR   error   
                    E_QUOTE:   LD   B,H   ; an unclosed string: HL is its address, one
                              LD   C,L   ;   past the opening quote, which is the place
                              LD   A,"Q"   
                              DB   11h   
                    E_RESV:   LD   A,"X"   ; a reserved byte outside a string
                              DB   11h   
                    E_ZERO:   LD   A,"Z"   ; dividing by zero
                              DB   11h   
                    E_BRACK:   LD   A,"W"   ; bad character after [
                                 ; error: the report, then the end. A = the letter, BC = one past the place,
                                 ; HL = TOS, and both stacks as the report is to show them:
                                 ; 
                                 ;   Err X @ line,col
                                 ;   up to 16 characters of the text from the place
                                 ;   Stk n: the top 8 cells at most, bottom to top
                                 ;   Rtn n
                    ERROR:    PUSH   HL   ; now the whole data stack is in memory
                              LD   E,A   
                              CALL   pnl   
                              DB   "Err ",22h   
                              LD   A,E   
                              RST   28h   
                              CALL   pmsg   
                              DB   " @ ",22h   
                              DEC   BC   ; BC = the place
                                 ; The line and column. A place below the program is in the line
                                 ; buffer: line 0. Otherwise count the LFs from the program's start;
                                 ; DE = the line's number, HL = where it starts.
                              LD   HL,LINEBUF   
                              LD   DE,0   
                              LD   A,B   
                              CP   PROG/256   
                              JR   C,er3   
                              INC   H   
                              LD   L,E   ; HL = PROG
                    ER1:      INC   DE   ; a new line starts at HL
                              PUSH   HL   
                    ER2:      LD   A,L   
                              SUB   C   
                              LD   A,H   
                              SBC   A,B   
                              JR   NC,er2x   ; reached the place
                              LD   A,(HL)   
                              INC   HL   
                              CP   10   
                              JR   NZ,er2   
                              POP   AF   
                              JR   er1   
                    ER2X:     POP   HL   
                    ER3:      PUSH   BC   
                              PUSH   HL   
                              EX   DE,HL   
                              CALL   pdec   ; the line
                              LD   A,","   
                              RST   28h   
                              POP   DE   
                              POP   HL   
                              PUSH   HL   
                              OR   A   
                              SBC   HL,DE   
                              INC   HL   
                              CALL   pdec   ; the column
                              CALL   pnl   
                              DB   22h   
                              POP   HL   ; the text, as it is: 16 characters, or fewer
                              LD   B,16   ;   if the line or the program ends first
                    ER4:      LD   A,(HL)   
                              INC   HL   
                              OR   A   
                              JR   Z,er5   
                              CP   13   
                              JR   Z,er5   
                              CP   10   
                              JR   Z,er5   
040E                          ENDIF      
040E                          IF   CHECKED*CPM   
                              CP   1Ah   ; (the ^Z that pads a file's last record ends
                              JR   Z,er5   ;   the text too: some terminals clear the
040E                          ENDIF      ;   screen on it)
040E                          IF   CHECKED   
                              RST   28h   
                              DJNZ   er4   
                    ER5:      CALL   pnl   
                              DB   "Stk ",22h   
                              LD   HL,DSTOP-2   ; (the cell at DSTOP-2 was pushed with the
                              OR   A   ;   first value and holds nothing)
                              SBC   HL,SP   
                              CALL   phalf   ; the depth
                              LD   A,":"   
                              RST   28h   
                              LD   A,C   
                              CP   9   
                              JR   C,er6   
                              CALL   pmsg   
                              DB   " ...",22h   
                              LD   C,8   
                    ER6:      LD   H,0   ; C = the number of cells to show
                              LD   L,C   
                              ADD   HL,HL   
                              ADD   HL,SP   ; HL -> just above the deepest of them
                              INC   C   
                    ER7:      DEC   C   
                              JR   Z,er8   
                              DEC   HL   
                              LD   D,(HL)   
                              DEC   HL   
                              LD   E,(HL)   
                              PUSH   HL   
                              PUSH   BC   
                              LD   A," "   
                              RST   28h   
                              EX   DE,HL   
                              CALL   psgn   
                              POP   BC   
                              POP   HL   
                              JR   er7   
                    ER8:      CALL   pnl   
                              DB   "Rtn ",22h   
                              EXX      
                              PUSH   HL   
                              EXX      
                              POP   DE   
                              LD   HL,RSTOP   
                              OR   A   
                              SBC   HL,DE   
                              CALL   phalf   
                              CALL   pnl   
                              DB   22h   
                              JP   endprog   
                                 ; phalf: print half of HL, and leave it in C
                    PHALF:    SRL   H   
                              RR   L   
                              PUSH   HL   
                              CALL   pdec   
                              POP   BC   
                              RET      
040E                          ENDIF      
040E                             ; =============================================================================
040E                             ;  The line editor (EDITOR = 1)
040E                             ; 
040E                             ;  The interpreter starts here, and a program that ends comes back here. Type
040E                             ;  a line and press Return:
040E                             ; 
040E                             ;    n text    put the text in as line n; the lines from n on move down.
040E                             ;              A number past the end, or 0, adds the line at the end.
040E                             ;    n         take line n out
040E                             ;    0         run the program
040E                             ;    -n        list the program from line n on (-1 lists all of it). Any key
040E                             ;              stops the list until another key is pressed; Ctrl-C ends it.
040E                             ;    anything else is run at once, as B8Script. (Start such a line with a
040E                             ;    space if it would begin with a digit or a minus sign.)
040E                             ; 
040E                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
040E                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
040E                             ;  125 characters, the line number and the one character after it included;
040E                             ;  that character is not stored. The text is kept as it is typed, each line
040E                             ;  ending in CR LF, at PROG. Nothing is checked.
040E                             ; 
040E                             ;  With CPM = 1 the file named on the command line is the program to start
040E                             ;  with (no file, or no such file: no program). Lines are read by BDOS 10, so
040E                             ;  its editing keys work, and Ctrl-C as the first key of a line goes back to
040E                             ;  CP/M. Nothing is written back: there is no command to save.
040E                             ; 
040E                             ;  With CHECKED = 1 a program that is stopped (an error, or Ctrl-C) prints
040E                             ;  its report and comes back here, with both stacks empty. The place is a
040E                             ;  line and column of the program; in a line typed here it is line 0.
040E                             ; 
040E                             ;  Things to know:
040E                             ;    - Reset empties the program (generic builds).
040E                             ;    - Words and variables last from one line to the next. A word's address
040E                             ;      points into the program, so run the program again after editing it.
040E                             ;    - Nothing is printed between a program's output and what is typed next.
040E                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
040E                             ;      a line that calls -n? and carries on afterwards runs what was typed.
040E                             ;      (The stored program never comes back to the line, so it may.)
040E                             ; =============================================================================
040E                          IF   EDGEN*CHECKED   
                                 ; Reset (A = 0): clear the lower half of the letter page. Every variable
                                 ; starts at 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi), and no key is held back.
                    INIT:     LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
                              JR   edit   
040E                          ENDIF      
040E                          IF   EDITOR   
                                 ; -n: list from line n. DE = the number of the line at HL.
                    LIST:     INC   BC   
                              CALL   rdnum   ; HL = n
                              PUSH   HL   
                              CALL   find   
                              POP   DE   
                    LI1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,edit   ; the end of the text
                              CALL   rawk   
                              JR   Z,li3   ; no key: carry on
                              CP   3   
                              JR   Z,edit   ; Ctrl-C
                    LI2:      CALL   rawk   ; any other key: wait for one more
                              JR   Z,li2   
                              CP   3   
                              JR   Z,edit   
                    LI3:      PUSH   HL   
                              PUSH   DE   
                              EX   DE,HL   
                              CALL   pdec   ; the line's number,
                              LD   A," "   
                              RST   28h   ;   a space,
                              POP   DE   
                              POP   HL   
                              INC   DE   
                              CALL   prl   ;   and the line
                              JR   li1   
                                 ; Take line n (in HL) out: copy everything after it down over it.
                    DEL:      CALL   find   
                              LD   D,H   
                              LD   E,L   
                              CALL   nxl   ; HL -> the next line
                    DE1:      LD   A,(HL)   
                              LD   (DE),A   
                              INC   HL   
                              INC   DE   
                              OR   A   
                              JR   NZ,de1   ; and fall into the editor
                    EDIT:     LD   SP,DSTOP   
                              XOR   A   ; a key that the break check held while the
                              LD   (KEYBUF),A   ;   program ran is let go (the Ctrl-C that
040E                          ENDIF      ;   stopped it, for one)
040E                          IF   EDGEN   
                              LD   D,0FDh   ; 125 characters at most
040E                          ENDIF      
040E                          IF   EDITOR*CPM   
                              LD   A,125   
040E                          ENDIF      
040E                          IF   EDITOR   
                              CALL   rdline   ; HL -> the CR that ended the line
                              INC   L   
                              LD   (HL),10   ; a LF after it,
                              DEC   L   
                              CALL   prl   ; (print the CR LF: a new line)
                              LD   (HL),0   ;   and a NUL after that
                              PUSH   HL   ; the end of what was typed
                              LD   BC,LINEBUF   
                              LD   A,(BC)   
                              CP   "-"   
                              JR   Z,list   
                              CALL   rdnum   ; HL = the number it starts with, BC -> after
                              LD   A,C   ; C is still 80h if there was no number:
                              ADD   A,A   ;   only then is twice it 0
                              JR   Z,st0   ; no number: run the line where it is
                              LD   A,(BC)   
                              SUB   13   
                              JR   NZ,ins   ; text follows the number
                              OR   H   ; the number alone:
                              OR   L   
                              JR   NZ,del   ;   not 0: take that line out
                              LD   BC,PROG   ;   0: run the program
                                 ; st0: start running at BC. The heap starts after the stored program's NUL.
                    ST0:      POP   HL   ; (the end of what was typed: the stack is empty)
                              XOR   A   
                              LD   H,A   ; no key is held, and the break key is on: a
                              LD   L,A   ;   key left over from the last run is let go
                              LD   (KEYBUF),HL   
                              LD   HL,PROG   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
                              LD   (HEAP),HL   
040E                          ENDIF      
040E                          IF   EDITOR*CHECKED   
                              RST   20h   ; minus the heap"s first address: "_' may not
                              LD   (NPEND),HL   ;   release below it
040E                          ENDIF      
040E                          IF   EDITOR   
                              EXX      
                              LD   HL,RSTOP   ; the return stack is empty
                              EXX      
                              RST   30h   ; (its return address is thrown away)
                                 ; Put the typed text in as line n (in HL): open a gap of its length there,
                                 ; CR and LF included, and copy it in.
                    INS:      CALL   find   ; HL -> where it goes
                              INC   BC   ; step over the one character after the number
                              POP   DE   ; the end of what was typed
                              LD   A,E   
                              SUB   C   ; A = the length of the text, with its CR LF
                              PUSH   BC   ; the text
                              LD   C,A   
                              LD   B,0   
                              PUSH   BC   ; its length
                              LD   D,H   
                              LD   E,L   ; DE = where it goes
                              XOR   A   
                              LD   C,A   ; BC = 0: CPIR looks as far as it needs to
                              CPIR      ; HL -> one past the program's NUL
                              SBC   HL,DE   ; the number of bytes to move up, NUL included
                              LD   B,H   
                              LD   C,L   
                              ADD   HL,DE   
                              DEC   HL   ; HL -> the NUL
                              EX   DE,HL   
                              EX   (SP),HL   ; HL = the length; where it goes is kept
                              PUSH   HL   
                              ADD   HL,DE   ; the NUL's new place
                              EX   DE,HL   
                              LDDR      ; move the rest of the program up
                              POP   BC   ; the length
                              POP   DE   ; where it goes
                              POP   HL   ; the text
                              LDIR      
                              JR   edit   
                                 ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
                                 ; of the text if there are fewer lines (or the number is 0). Keeps BC.
                    FIND:     EX   DE,HL   
                              LD   HL,PROG   
                    FI1:      DEC   DE   
                              LD   A,D   
                              OR   E   
                              RET   Z   
                              CALL   nxl   
                              JR   NZ,fi1   
                              RET      
                                 ; nxl: step HL over one line, to just past its LF (and return not-zero), or
                                 ; stop at the NUL that ends the text (and return zero).
                    NXL:      LD   A,(HL)   
                              OR   A   
                              RET   Z   
                              INC   HL   
                              CP   10   
                              JR   NZ,nxl   
                              OR   A   
                              RET      
                                 ; prl: print the line at HL, to its LF; HL -> just past it.
                    PRL:      LD   A,(HL)   
                              RST   28h   
                              LD   A,(HL)   
                              INC   HL   
                              CP   10   
                              JR   NZ,prl   
                              RET      
040E                          ENDIF      
040E                             ; =============================================================================
040E                             ;  CP/M startup (the generic build starts at address 0: see st0)
040E                             ; =============================================================================
040E                          IF   CPM   
040E                             ; The RAM pages follow the image; the heap may grow to the BDOS.
040E                START:       
040E                          ENDIF      
040E                          IF   CPM*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
                                 ; is held back.
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
040E                          ENDIF      
040E                          IF   CPM   
040E   21 08 01               LD   HL,vecs   ; the RST routines go down into page zero
0411   11 08 00               LD   DE,0008h   
0414   01 2C 00               LD   BC,vecend-vecs   
0417   ED B0                  LDIR      
0419   11 5C 00               LD   DE,005Ch   ; open the file named on the command line
041C   0E 0F                  LD   C,15   ; (no such file: the first read fails too,
041E   CD 05 00               CALL   BDOS   ;   and the program is empty)
0421   11 00 08               LD   DE,PROG   
0424   D5           LD1:      PUSH   DE   
0425   0E 1A                  LD   C,26   ; set the DMA address
0427   CD 05 00               CALL   BDOS   
042A   11 5C 00               LD   DE,005Ch   
042D   0E 14                  LD   C,20   ; read the next 128 bytes
042F   CD 05 00               CALL   BDOS   
0432   E1                     POP   HL   ; HL = the address this record went to
0433   B7                     OR   A   
0434   20 07                  JR   NZ,ld2   
0436   11 80 00               LD   DE,128   
0439   19                     ADD   HL,DE   
043A   EB                     EX   DE,HL   
043B   18 E7                  JR   ld1   
043D                LD2:         
043D                          ENDIF      
043D                          IF   CPM*(1-EDITOR)   
043D   36 00                  LD   (HL),0   ; the end of the file counts as NUL
043F   23                     INC   HL   ; the heap starts after it
0440   01 00 08               LD   BC,PROG   ; the IP
0443   C3 70 01               JP   st2   
0446                          ENDIF      
0446                          IF   CPM*EDITOR   
                                 ; The editor wants the text to end where the file's text ends: at
                                 ; the first ^Z (1Ah), which pads a text file's last record. One more
                                 ; goes after the last record, so the search always stops. And every
                                 ; line must end in LF: a last line without one is given a CR LF.
                              LD   (HL),1Ah   
                              LD   HL,PROG-1   
                              LD   A,10   ; (a file with no text needs nothing added)
                    TR1:      INC   HL   
                              LD   E,A   ; E = the character before this one
                              LD   A,(HL)   
                              CP   1Ah   
                              JR   NZ,tr1   
                              LD   A,E   
                              CP   10   
                              JR   Z,tr2   
                              LD   (HL),13   
                              INC   HL   
                              LD   (HL),10   
                              INC   HL   
                    TR2:      LD   (HL),0   
                              JP   edit   
0446                          ENDIF      
0446                          IF   CPM   
0446                             ; RAM pages, after the image
0446                RSPAGE:   EQU   (imgend + 255) / 256   
0446                DSPAGE:   EQU   RSPAGE + 1   
0446                LETPAGE:   EQU   RSPAGE + 2   
0446                PROG:     EQU   LETPAGE*256 + 256   
0446                          ENDIF      
0446                IMGEND:      


