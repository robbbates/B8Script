0255   6F                     MOV   L,A   
0256   7C                     MOV   A,H   
0257   AA                     XRA   D   
0258   17                     RAL      ; carry = the signs differ
0259   9F                     SBB   A   
025A   AD                     XRA   L   ; flip when they do
025B   67                     MOV   H,A   
025C   6F                     MOV   L,A   
025D                          ;*Macro unroll:  NEXT
025D                          DS   (1-CPM)*(1-FAST),0F7h   
025D   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
025E   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
025F   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
0260   D1           H_EQ:     POP   D   
0261   7D                     MOV   A,L   
0262   AB                     XRA   E   
0263   6F                     MOV   L,A   
0264   7C                     MOV   A,H   
0265   AA                     XRA   D   
0266   B5                     ORA   L   ; zero if equal
0267   D6 01                  SUI   1   ; carry only for zero
0269   9F                     SBB   A   
026A   67                     MOV   H,A   
026B   6F                     MOV   L,A   
026C                          ;*Macro unroll:  NEXT
026C                          DS   (1-CPM)*(1-FAST),0F7h   
026C   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
026D   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
026E   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
026F                             ; "*": shift-and-add on the multiplier's low bit, so it stops as soon as the
026F                             ; multiplier is used up; only the low 16 bits are kept.
026F                          IF   QK   
                    H_MUL:    POP   D   ; DE = multiplicand
                              JMP   mulq   ; (out of the handlers' pages: see Speed-ups)
026F                          ENDIF      
026F                          IF   1-QK   
026F   D1           H_MUL:    POP   D   ; DE = multiplicand
0270   C5                     PUSH   B   
0271   44                     MOV   B,H   
0272   4D                     MOV   C,L   ; BC = multiplier
0273   21 00 00               LXI   H,0   
0276   78           MUL1:     MOV   A,B   
0277   B7                     ORA   A   ; clear carry
0278   1F                     RAR      
0279   47                     MOV   B,A   
027A   79                     MOV   A,C   
027B   1F                     RAR      
027C   4F                     MOV   C,A   ; BC >> 1, carry = the bit shifted out
027D   D2 81 02               JNC   mul2   
0280   19                     DAD   D   
0281   EB           MUL2:     XCHG      
0282   29                     DAD   H   ; multiplicand << 1
0283   EB                     XCHG      
0284   78                     MOV   A,B   
0285   B1                     ORA   C   
0286   C2 76 02               JNZ   mul1   
0289   C1                     POP   B   
028A                          ;*Macro unroll:  NEXT
028A                          DS   (1-CPM)*(1-FAST),0F7h   
028A   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
028B   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
028C   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
028D                          ENDIF      
028D                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
028D                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
028D                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
028D                             ; stops on it.
028D                H_DIV:       
028D                          IF   CHECKED   
028D   7C                     MOV   A,H   
028E   B5                     ORA   L   
028F   CA 23 06               JZ   e_zero   
0292                          ENDIF      
0292   D1                     POP   D   ; DE = a, HL = b
0293   C5                     PUSH   B   
0294   7A                     MOV   A,D   
0295   B7                     ORA   A   
0296   F5                     PUSH   PSW   ; S flag = sign of a (for r)
0297   AC                     XRA   H   
0298   F5                     PUSH   PSW   ; S flag = sign of q
0299   7C                     MOV   A,H   
029A   B7                     ORA   A   
029B   FC 27 01               CM   neg16   ; HL = |b|
029E   EB                     XCHG      
029F   7C                     MOV   A,H   
02A0   B7                     ORA   A   
02A1   FC 27 01               CM   neg16   ; HL = |a|, DE = |b|
02A4   CD 9F 03               CALL   udiv   ; HL = q, BC = r
02A7   F1                     POP   PSW   
02A8   FC 27 01               CM   neg16   ; q's sign
02AB   EB                     XCHG      ; DE = q
02AC   60                     MOV   H,B   
02AD   69                     MOV   L,C   ; HL = r
02AE   F1                     POP   PSW   
02AF   FC 27 01               CM   neg16   ; r's sign
02B2   C1                     POP   B   
02B3   D5                     PUSH   D   ; q under r
02B4                          ;*Macro unroll:  NEXT
02B4                          DS   (1-CPM)*(1-FAST),0F7h   
02B4   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
02B5   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
02B6   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
02B7                             ; ---- stack and storage -----------------------------------------------------
02B7   E5           H_DUP:    PUSH   H   ; ":"
02B8                          ;*Macro unroll:  NEXT
02B8                          DS   (1-CPM)*(1-FAST),0F7h   
02B8   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
02B9   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
02BA   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
02BB   E3           H_SWAP:   XTHL      ; "%"
02BC                          ;*Macro unroll:  NEXT
02BC                          DS   (1-CPM)*(1-FAST),0F7h   
02BC   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
02BD   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
02BE   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
02BF                             ; (The checked build tests the address before it takes the value off the
02BF                             ; stack, so that an error report shows both.)
02BF                H_STORE:      ; "!" ( n addr -- )
02BF                          IF   CHECKED   
02BF   CD 80 05               CALL   chkst   
02C2                          ENDIF      
02C2   D1                     POP   D   
02C3   73                     MOV   M,E   
02C4   23                     INX   H   
02C5   72                     MOV   M,D   
02C6                          ;*Macro unroll:  DROP
02C6                          DS   (1-CPM)*(1-FAST),0DFh   
02C6   C3                     DS   CPM*(1-FAST),0C3h   
02C7   1C                     DS   CPM*(1-FAST),ADRP&0FFh   
02C8   01                     DS   CPM*(1-FAST),ADRP/256   
02C9                          DS   FAST,0E1h   
02C9                          DS   FAST,0C3h   
02C9                          DS   FAST,ANXT&0FFh   
02C9                          DS   FAST,ANXT/256   
02C9                H_CSTORE:      ; "." ( c addr -- )
02C9                          IF   CHECKED   
02C9   CD 80 05               CALL   chkst   
02CC                          ENDIF      
02CC   D1                     POP   D   
02CD   73                     MOV   M,E   
02CE                          ;*Macro unroll:  DROP
02CE                          DS   (1-CPM)*(1-FAST),0DFh   
02CE   C3                     DS   CPM*(1-FAST),0C3h   
02CF   1C                     DS   CPM*(1-FAST),ADRP&0FFh   
02D0   01                     DS   CPM*(1-FAST),ADRP/256   
02D1                          DS   FAST,0E1h   
02D1                          DS   FAST,0C3h   
02D1                          DS   FAST,ANXT&0FFh   
02D1                          DS   FAST,ANXT/256   
02D1                             ; ---- console ---------------------------------------------------------------
02D1                             ; 22h pushes the address of the text after it and skips the string.
02D1   E5           H_STR:    PUSH   H   
02D2   60                     MOV   H,B   
02D3   69                     MOV   L,C   
02D4   CD C0 04               CALL   skipstr   
02D7                          IF   CHECKED   
02D7   B7                     ORA   A   ; 0: the text ran out before the closing quote
02D8   CA 1B 06               JZ   e_quote   
02DB                          ENDIF      
02DB                          ;*Macro unroll:  NEXT
02DB                          DS   (1-CPM)*(1-FAST),0F7h   
02DB   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
02DC   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
02DD   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
02DE                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
02DE                             ; 60h to 7Eh is one of the escapes at pesc; "/" plus any other character
02DE                             ; clears that character"s bit 6 (/M is CR, and / then DEL gives "?"; "/',
02DE                             ; '"' and '?' have no bit 6, so //, /" and /? give themselves).
02DE                          IF   1-CHECKED   
                    H_PRINT:   JMP   prlp   ; (the loop is with the escapes, out of the
                    PRLOOP:   EQU   prlp   ;   way of the handlers, which must fit in
                    PRAGAIN:   EQU   prlp   ;   the image's first two pages)
02DE                          ENDIF      
02DE                          IF   CHECKED   
02DE                             ; (The checked build has the loop as a routine, prstr, which the error
02DE                             ; report uses too. The address is kept meanwhile, for a report: it shows
02DE                             ; the stack as it was before the "$". /~ comes back to hp1.)
02DE   22 3A 0A     H_PRINT:   SHLD   PSAVE   
02E1   CD 97 05     HP1:      CALL   prstr   
02E4                          ;*Macro unroll:  DROP
02E4                          DS   (1-CPM)*(1-FAST),0DFh   
02E4   C3                     DS   CPM*(1-FAST),0C3h   
02E5   1C                     DS   CPM*(1-FAST),ADRP&0FFh   
02E6   01                     DS   CPM*(1-FAST),ADRP/256   
02E7                          DS   FAST,0E1h   
02E7                          DS   FAST,0C3h   
02E7                          DS   FAST,ANXT&0FFh   
02E7                          DS   FAST,ANXT/256   
02E7                          ENDIF      
02E7   7D           H_EMIT:   MOV   A,L   ; "'"
02E8                          ;*Macro unroll:  PUTA
02E8                          DS   1-CPM,0EFh   
02E8   CD                     DS   CPM,0CDh   
02E9   52                     DS   CPM,APUT&0FFh   
02EA   05                     DS   CPM,APUT/256   
02EB                          ;*Macro unroll: h_drop: DROP                    ; ';' is this one byte
02EB                H_DROP:   DS   (1-CPM)*(1-FAST),0DFh   ; ";" is this one byte
02EB   C3                     DS   CPM*(1-FAST),0C3h   
02EC   1C                     DS   CPM*(1-FAST),ADRP&0FFh   
02ED   01                     DS   CPM*(1-FAST),ADRP/256   
02EE                          DS   FAST,0E1h   
02EE                          DS   FAST,0C3h   
02EE                          DS   FAST,ANXT&0FFh   
02EE                          DS   FAST,ANXT/256   
02EE                             ; "#" prints TOS as a signed decimal number, with no space after it.
02EE   C5           H_NUM:    PUSH   B   
02EF   CD D1 03               CALL   psgn   
02F2   C1                     POP   B   
02F3                          ;*Macro unroll:  DROP
02F3                          DS   (1-CPM)*(1-FAST),0DFh   
02F3   C3                     DS   CPM*(1-FAST),0C3h   
02F4   1C                     DS   CPM*(1-FAST),ADRP&0FFh   
02F5   01                     DS   CPM*(1-FAST),ADRP/256   
02F6                          DS   FAST,0E1h   
02F6                          DS   FAST,0C3h   
02F6                          DS   FAST,ANXT&0FFh   
02F6                          DS   FAST,ANXT/256   
02F6                          IF   CHECKED   ; (the checked build has no room to start ","
02F6   6E           H_CFETCH:   MOV   L,M   ;   as late as the unchecked one does: see
02F7   26 00                  MVI   H,0   ;   the end of "?")
02F9                          ;*Macro unroll:  NEXT
02F9                          DS   (1-CPM)*(1-FAST),0F7h   
02F9   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
02FA   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
02FB   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
02FC                          ENDIF      
02FC                             ; "?" ( n -- c ) or ( -n -- addr )
02FC                             ;   n > 0: wait about n ms for a key; 0 if none came
02FC                             ;   n = 0: wait for a key
02FC                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
02FC                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
02FC   7C           H_KEY:    MOV   A,H   
02FD   B7                     ORA   A   
02FE   FA 1E 03               JM   line   
0301   1E 04        KT1:      MVI   E,MSLOOP   ; one millisecond, roughly
0303   CD 18 05     KT2:      CALL   getk   
0306   C2 18 03               JNZ   kt3   
0309   1D                     DCR   E   
030A   C2 03 03               JNZ   kt2   
030D   7C                     MOV   A,H   ; 0? never counts down: it waits
030E   B5                     ORA   L   
030F   CA 01 03               JZ   kt1   
0312   2B                     DCX   H   
0313   7C                     MOV   A,H   
0314   B5                     ORA   L   
0315   C2 01 03               JNZ   kt1   ; A = 0 if the time ran out
0318                          IF   1-CHECKED   
                              DB   0FEh   ; (CPI: steps over the one byte of ",")
                    H_CFETCH:   MOV   A,M   ; "," shares "?"s ending: A becomes TOS
0318                          ENDIF      
0318   6F           KT3:      MOV   L,A   
0319   26 00                  MVI   H,0   
031B                          ;*Macro unroll:  NEXT
031B                          DS   (1-CPM)*(1-FAST),0F7h   
031B   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
031C   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
031D   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
031E                             ; Backspace takes the last character back (and is echoed as
031E                             ; it is), CR ends (stored, not echoed), every other key is stored and
031E                             ; echoed until the line is full. The line buffer starts at offset 80h
031E                             ; of its page, so L alone is the place in the line: D holds the L of
031E                             ; a full line.
031E   11 7F 00     LINE:     LXI   D,127   ; TOS is minus the count: adding 127 carries
0321   19                     DAD   D   ;   only for 1 to 127, and leaves 127 - count
0322   9F                     SBB   A   
0323   A5                     ANA   L   ; (0 for a count that is too big)
0324   2F                     CMA      
0325   57                     MOV   D,A   ; D = the L of a full line: 80h + count, FFh
0326                             ;   at most
0326   21 80 0A               LXI   H,LINEBUF   
0329   CD 18 05     LN2:      CALL   getk   
032C   CA 29 03               JZ   ln2   
032F   FE 0D                  CPI   13   
0331   CA 50 03               JZ   ln5   
0334   FE 08                  CPI   8   
0336   CA 48 03               JZ   ln4   
0339   5F                     MOV   E,A   
033A   7D                     MOV   A,L   
033B   BA                     CMP   D   
033C   CA 29 03               JZ   ln2   ; full
033F   73                     MOV   M,E   
0340   2C                     INR   L   
0341   7B                     MOV   A,E   
0342                          ;*Macro unroll: ln3:    PUTA
0342                LN3:      DS   1-CPM,0EFh   
0342   CD                     DS   CPM,0CDh   
0343   52                     DS   CPM,APUT&0FFh   
0344   05                     DS   CPM,APUT/256   
0345   C3 29 03               JMP   ln2   
0348   2D           LN4:      DCR   L   ; Backspace: one back, and echo it,
0349   FA 42 03               JM   ln3   ;   unless the line was empty (L left the
034C   2C                     INR   L   ;   upper half of the page)
034D   C3 29 03               JMP   ln2   
0350   77           LN5:      MOV   M,A   ; the CR
0351   2E 80                  MVI   L,LINEBUF & 0FFh   
0353                          ;*Macro unroll:  NEXT
0353                          DS   (1-CPM)*(1-FAST),0F7h   
0353   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
0354   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
0355   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
0356                             ; =============================================================================
0356                             ;  Dispatch table: the low byte of each handler's address, in code order.
0356                             ;  It must not cross a page (the dispatcher only adds to its low byte).
0356                             ; =============================================================================
0356                             ; The handlers of the first NPG1 characters start in the image's second page.
0356                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
0356                             ; differs between the builds, so the count is worked out here.
0356                             ; (One division to a line: asm80 only rounds down when it stores a value.)
0356                          IF   1-FAST   
0356                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
0356                PGBRK:    EQU   (h_break-BASE)/256   
0356                PGDEF:    EQU   (h_def-BASE)/256   
0356                PGFET:    EQU   (h_fetch-BASE)/256   
0356                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
0356                          ENDIF      
0356                          IF   (1-FAST)*(1-PTLATE)   
0356                PTAB:        
0356                          ;*Macro unroll:  PTABLE
0356   BF                     DB   h_store & 0FFh   
0357   D1                     DB   h_str & 0FFh   
0358   EE                     DB   h_num & 0FFh   
0359   DE                     DB   h_print & 0FFh   
035A   BB                     DB   h_swap & 0FFh   
035B   44                     DB   h_and & 0FFh   
035C   E7                     DB   h_emit & 0FFh   
035D   1A                     DB   h_open & 0FFh   
035E   26                     DB   h_close & 0FFh   
035F   6F                     DB   h_mul & 0FFh   
0360   3F                     DB   h_add & 0FFh   
0361   F6                     DB   h_cfetch & 0FFh   
0362   34                     DB   h_sub & 0FFh   
0363   C9                     DB   h_cstore & 0FFh   
0364   8D                     DB   h_div & 0FFh   
0365   B7                     DB   h_dup & 0FFh   
0366   EB                     DB   h_drop & 0FFh   
0367   4F                     DB   h_lt & 0FFh   
0368   60                     DB   h_eq & 0FFh   
0369   4E                     DB   h_gt & 0FFh   
036A   FC                     DB   h_key & 0FFh   
036B   13                     DB   h_fetch & 0FFh   
036C   EA                     DB   h_def & 0FFh   
036D   DB                     DB   h_break & 0FFh   
036E   D2                     DB   h_ret & 0FFh   
036F   88                     DB   h_xor & 0FFh   
0370   A3                     DB   h_alloc & 0FFh   
0371   B3                     DB   h_grave & 0FFh   
0372   18                     DB   h_tor & 0FFh   
0373   92                     DB   h_or & 0FFh   
0374   20                     DB   h_fromr & 0FFh   
0375   9C                     DB   h_not & 0FFh   
0376                PTABEND:      
0376                          ENDIF      
0376                             ; =============================================================================
0376                             ;  Routines (no handler starts past this point)
0376                             ; =============================================================================
0376                             ; Digits: step back onto the first digit and read the whole number.
0376   E5           DIGIT:    PUSH   H   
0377   0B                     DCX   B   
0378   CD 88 03               CALL   rdnum   
037B                          ;*Macro unroll:  NEXT
037B                          DS   (1-CPM)*(1-FAST),0F7h   
037B   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
037C   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
037D   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
037E                             ; negnum: "-" directly before a digit: read the number, negate it.
037E   E5           NEGNUM:   PUSH   H   
037F   CD 88 03               CALL   rdnum   
0382                          ;*Macro unroll:  NEGH
0382                          DS   1-CPM,0E7h   
0382   CD                     DS   CPM,0CDh   
0383   27                     DS   CPM,ANEG&0FFh   
0384   01                     DS   CPM,ANEG/256   
0385                          ;*Macro unroll:  NEXT
0385                          DS   (1-CPM)*(1-FAST),0F7h   
0385   C3                     DS   CPM+FAST-CPM*FAST,0C3h   
0386   36                     DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
0387   01                     DS   CPM+FAST-CPM*FAST,ANXT/256   
0388                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
0388                             ; non-digit. Values wrap at 16 bits, as the spec says.
0388   21 00 00     RDNUM:    LXI   H,0   
038B   0A           RDN1:     LDAX   B   
038C   D6 30                  SUI   "0"   
038E   FE 0A                  CPI   10   
0390   D0                     RNC      
0391   03                     INX   B   
0392   54                     MOV   D,H   
0393   5D                     MOV   E,L   
0394   29                     DAD   H   
0395   29                     DAD   H   
0396   19                     DAD   D   
0397   29                     DAD   H   ; HL * 10
0398   5F                     MOV   E,A   
0399   16 00                  MVI   D,0   
039B   19                     DAD   D   
039C   C3 8B 03               JMP   rdn1   
039F                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, BC = remainder.
039F                             ; Uses A, BC; the caller saves the IP. HL holds the dividend and, as its bits
039F                             ; leave at the top, the quotient bits arrive at the bottom. The loop counter
039F                             ; lives on the stack, since A is busy with the shifts.
039F                             ; Dividing by 2 is one shift (the spec wants that fast).
039F   01 00 00     UDIV:     LXI   B,0   
03A2                          IF   1-QK   
03A2   7B                     MOV   A,E   
03A3   EE 02                  XRI   2   
03A5   B2                     ORA   D   
03A6   C2 B3 03               JNZ   udv0   
03A9   B4                     ORA   H   ; A was 0, and the carry is clear
03AA   1F                     RAR      
03AB   67                     MOV   H,A   
03AC   7D                     MOV   A,L   
03AD   1F                     RAR      
03AE   6F                     MOV   L,A   ; the quotient
03AF   78                     MOV   A,B   
03B0   17                     RAL      
03B1   4F                     MOV   C,A   ; the remainder: the bit that fell out
03B2   C9                     RET      
03B3                          ENDIF      
03B3                          IF   QK   
                                 ; (The builds with room divide by any power of two with shifts: 2, and 32,
                                 ; 64, 256 and the like, which fixed point and byte work use all the time.)
                              MOV   A,D   
                              ORA   A   
                              JNZ   uq1   ; 256 and up
                              ORA   E   
                              JZ   udv0   ; by 0: the long way (it means nothing anyway)
                              DCR   A   
                              ANA   E   
                              JNZ   udv0   ; not a power of two
                              MOV   A,E   ; by 2^k below 256: q = HL >> k, and
                              DCR   A   ;   r = L & (2^k - 1)
                              ANA   L   
                              MOV   C,A   
03B3                          ENDIF      
03B3                          IF   QK*(1-FAST)   
                    UQ2:      MOV   A,E   ; one shift for each halving of E down to 1
                              ORA   A   
                              RAR      
                              RC      
                              MOV   E,A   
                              MOV   A,H   ; (the carry is clear: E's bit 0 was 0)
                              RAR      
                              MOV   H,A   
                              MOV   A,L   
                              RAR      
                              MOV   L,A   
                              JMP   uq2   
03B3                          ENDIF      
03B3                          IF   FAST   
                                 ; (the fast build: the shifts unrolled. By 16 to 128 it is fewer shifts to
                                 ; go the other way: A:HL up by 8 - k, and A:H is the quotient)
                    UQ2:      MOV   A,E   
                              CPI   16   
                              JNC   uqh   
                              CPI   2   
                              RC      ; by 1
                              JZ   ur1   
                              CPI   4   
                              JZ   ur2   
                    UR3:         
                              MOV   A,H   
                              ORA   A   
                              RAR      
                              MOV   H,A   
                              MOV   A,L   
                              RAR      
                              MOV   L,A   
                    UR2:         
                              MOV   A,H   
                              ORA   A   
                              RAR      
                              MOV   H,A   
                              MOV   A,L   
                              RAR      
                              MOV   L,A   
                    UR1:         
                              MOV   A,H   
                              ORA   A   
                              RAR      
                              MOV   H,A   
                              MOV   A,L   
                              RAR      
                              MOV   L,A   
                              RET      
                    UQH:      CPI   64   
                              MVI   A,0   
                              JZ   ul2   
                              JNC   ul1   
                              MOV   A,E   
                              CPI   32   
                              MVI   A,0   
                              JZ   ul3   
                              DAD   H   ; by 16
                              ADC   A   
                    UL3:      DAD   H   
                              ADC   A   
                    UL2:      DAD   H   
                              ADC   A   
                    UL1:      DAD   H   
                              ADC   A   
                              MOV   L,H   
                              MOV   H,A   
                              RET      
03B3                          ENDIF      
03B3                          IF   QK   
                    UQ1:      MOV   A,E   
                              ORA   A   
                              JNZ   udv0   
                              MOV   A,D   
                              DCR   A   
                              ANA   D   
                              JNZ   udv0   ; not a power of two
                              MOV   A,D   ; by 2^k, 256 and up: r = HL & (2^k - 1), and
                              DCR   A   ;   q = H >> (k - 8)
                              ANA   H   
                              MOV   B,A   
                              MOV   C,L   
                              MOV   L,H   
                              MVI   H,0   
                              MOV   E,D   
                              JMP   uq2   
03B3                          ENDIF      
03B3                          IF   1-FAST   
03B3   3E 10        UDV0:     MVI   A,16   
03B5   F5                     PUSH   PSW   
03B6   29           UDV1:     DAD   H   ; next dividend bit into the carry
03B7   79                     MOV   A,C   
03B8   17                     RAL      
03B9   4F                     MOV   C,A   
03BA   78                     MOV   A,B   
03BB   17                     RAL      
03BC   47                     MOV   B,A   ; BC = BC*2 + bit
03BD   79                     MOV   A,C   
03BE   93                     SUB   E   
03BF   78                     MOV   A,B   
03C0   9A                     SBB   D   ; carry if BC < DE
03C1   DA C9 03               JC   udv2   
03C4   47                     MOV   B,A   ; BC - DE (high byte; A holds it)
03C5   79                     MOV   A,C   
03C6   93                     SUB   E   
03C7   4F                     MOV   C,A   
03C8   2C                     INR   L   ; quotient bit
03C9   F1           UDV2:     POP   PSW   
03CA   3D                     DCR   A   
03CB   F5                     PUSH   PSW   
03CC   C2 B6 03               JNZ   udv1   
03CF   F1                     POP   PSW   
03D0   C9                     RET      
03D1                          ENDIF      
03D1                          IF   FAST   
                                 ; (the fast build: the same 16 rounds, unrolled; and a dividend below 256
                                 ; starts 8 bits up and takes only the last 8, since its first 8 would only
                                 ; shift zeros)
                    UDV0:     MOV   A,H   
                              ORA   A   
                              JZ   uvs   
                    UV0:      DAD   H   
                              MOV   A,C   
                              RAL      
                              MOV   C,A   
                              MOV   A,B   
                              RAL      
                              MOV   B,A   ; BC = BC*2 + bit
                              MOV   A,C   
                              SUB   E   
                              MOV   A,B   
                              SBB   D   ; carry if BC < DE
                              JC   uw0   
                              MOV   B,A   
                              MOV   A,C   
                              SUB   E   
                              MOV   C,A   
                              INR   L   ; quotient bit
                    UW0:         
                    UV1:      DAD   H   
                              MOV   A,C   
                              RAL      
                              MOV   C,A   
                              MOV   A,B   
                              RAL      
                              MOV   B,A   ; BC = BC*2 + bit
                              MOV   A,C   
                              SUB   E   
                              MOV   A,B   
                              SBB   D   ; carry if BC < DE
                              JC   uw1   
                              MOV   B,A   
                              MOV   A,C   
                              SUB   E   
                              MOV   C,A   
                              INR   L   ; quotient bit
                    UW1:         
                    UV2:      DAD   H   
                              MOV   A,C   
                              RAL      
                              MOV   C,A   
                              MOV   A,B   
                              RAL      
                              MOV   B,A   ; BC = BC*2 + bit
                              MOV   A,C   
                              SUB   E   
                              MOV   A,B   
                              SBB   D   ; carry if BC < DE
                              JC   uw2   
                              MOV   B,A   
                              MOV   A,C   
                              SUB   E   
                              MOV   C,A   
                              INR   L   ; quotient bit
                    UW2:         
                    UV3:      DAD   H   
                              MOV   A,C   
                              RAL      
                              MOV   C,A   
                              MOV   A,B   
                              RAL      
                              MOV   B,A   ; BC = BC*2 + bit
                              MOV   A,C   
                              SUB   E   
                              MOV   A,B   
                              SBB   D   ; carry if BC < DE
                              JC   uw3   
                              MOV   B,A   
                              MOV   A,C   
                              SUB   E   
                              MOV   C,A   
                              INR   L   ; quotient bit
                    UW3:         
                    UV4:      DAD   H   
                              MOV   A,C   
                              RAL      
                              MOV   C,A   
                              MOV   A,B   
                              RAL      
                              MOV   B,A   ; BC = BC*2 + bit
                              MOV   A,C   
                              SUB   E   
                              MOV   A,B   
                              SBB   D   ; carry if BC < DE
                              JC   uw4   
                              MOV   B,A   
                              MOV   A,C   
                              SUB   E   
                              MOV   C,A   
                              INR   L   ; quotient bit
                    UW4:         
                    UV5:      DAD   H   
                              MOV   A,C   
                              RAL      
                              MOV   C,A   
                              MOV   A,B   
                              RAL      
                              MOV   B,A   ; BC = BC*2 + bit
                              MOV   A,C   
                              SUB   E   
                              MOV   A,B   
                              SBB   D   ; carry if BC < DE
                              JC   uw5   
                              MOV   B,A   
                              MOV   A,C   
                              SUB   E   
                              MOV   C,A   
                              INR   L   ; quotient bit
                    UW5:         
                    UV6:      DAD   H   
                              MOV   A,C   
                              RAL      
                              MOV   C,A   
                              MOV   A,B   
                              RAL      
                              MOV   B,A   ; BC = BC*2 + bit
                              MOV   A,C   
                              SUB   E   
                              MOV   A,B   
                              SBB   D   ; carry if BC < DE
                              JC   uw6   
                              MOV   B,A   
                              MOV   A,C   
                              SUB   E   
                              MOV   C,A   
                              INR   L   ; quotient bit
                    UW6:         
                    UV7:      DAD   H   
                              MOV   A,C   
                              RAL      
                              MOV   C,A   
                              MOV   A,B   
                              RAL      
                              MOV   B,A   ; BC = BC*2 + bit
                              MOV   A,C   
                              SUB   E   
                              MOV   A,B   
                              SBB   D   ; carry if BC < DE
                              JC   uw7   
                              MOV   B,A   
                              MOV   A,C   
                              SUB   E   
                              MOV   C,A   
                              INR   L   ; quotient bit
                    UW7:         
                    UV8:      DAD   H   
                              MOV   A,C   
                              RAL      
                              MOV   C,A   
                              MOV   A,B   
                              RAL      
                              MOV   B,A   ; BC = BC*2 + bit
                              MOV   A,C   
                              SUB   E   
                              MOV   A,B   
                              SBB   D   ; carry if BC < DE
                              JC   uw8   
                              MOV   B,A   
                              MOV   A,C   
                              SUB   E   
                              MOV   C,A   
                              INR   L   ; quotient bit
                    UW8:         
                    UV9:      DAD   H   
                              MOV   A,C   
                              RAL      
                              MOV   C,A   
                              MOV   A,B   
                              RAL      
                              MOV   B,A   ; BC = BC*2 + bit
                              MOV   A,C   
                              SUB   E   
                              MOV   A,B   
                              SBB   D   ; carry if BC < DE
                              JC   uw9   
                              MOV   B,A   
                              MOV   A,C   
                              SUB   E   
                              MOV   C,A   
