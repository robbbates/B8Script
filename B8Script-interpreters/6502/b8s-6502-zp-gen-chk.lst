                              BCS   ign   ; 7Fh-FFh
E47D                          ENDIF      
E47D                          IF   CHECKED   
E47D   F0 17                  BEQ   ign   ; 7Fh
E47F   B0 B6                  BCS   e_resv   ; 80h-FFh: reserved
E481                          ENDIF      
E481                             ; The three adjustments below chain. Each ADC adds the carry the one
E481                             ; before it left, which the constants allow for.
E481   E9 1A                  SBC   #1Ah   ; 7Bh-7Eh: (carry clear: -1Bh) index 28-31
E483   69 F6        P5B:      ADC   #0F6h   ; 5Bh-60h: -10 (-9 when chained), index 22-27
E485   69 05        P3A:      ADC   #5   ; 3Ah-40h: +5 (+6 when chained), index 15-21
E487                             ; Punctuation: A = the index. The handler's page is the first, plus one if
E487                             ; the index is N1 or more, plus one more if it is N2 or more.
E487   C9 08        PUNCT:    CMP   #N1   
E489   A8                     TAY      
E48A   A9 70                  LDA   #HALFPG   
E48C   2A                     ROL      ; the first page, or the second (carry clear)
E48D   C0 15                  CPY   #N2   
E48F   69 00                  ADC   #0   ; ... or the third (and the carry is clear)
E491   48                     PHA      
E492   B9 BB E4               LDA   PTAB,Y   
E495   48                     PHA      
E496   60           IGN:      RTS      ; RTS trick: goes to the handler. Reached
E497                             ; directly, it just ends an ignored character.
E497                ENDP:        ; the program has ended
