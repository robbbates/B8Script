E2EA                             ; ---- "_" is the last handler: its body may leave the page
E2EA                             ; "_" ( n -- addr ): the heap top moves by n, which is signed: a negative
E2EA                             ; count releases. TOS becomes the old top. (The carry is clear on the way in.)
E2EA                          IF   1-CHECKED   
                    H_ALLOC:   LDA   HEAP   
                              TAY      
                              ADC   0,X   
                              STA   HEAP   
                              STY   0,X   
                              LDA   HEAP+1   
                              TAY      
                              ADC   1,X   
                              STA   HEAP+1   
                              STY   1,X   
                              RTS      
