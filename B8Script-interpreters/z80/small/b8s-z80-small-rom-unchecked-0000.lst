0000                             ; =============================================================================
0000                             ;  B8Script interpreter for the Z80
0000                             ;  Required Notice: Copyright 2026 Robb Bates (https://github.com/robbbates)
0000                             ;  Licence: PolyForm Noncommercial License 1.0.0 (LICENSE.md at the top of
0000                             ;  the repository, or https://polyformproject.org/licenses/noncommercial/1.0.0)
0000                             ;  Spec: docs/b8script.md (2026-11-24).
0000                             ; 
0000                             ;  The switches, set in the EQU lines below:
0000                             ;    CPM      0 = generic ROM build (KEY/CONOUT at fixed addresses)
0000                             ;             1 = CP/M 2.2 .COM file: loads the file named on the command line
0000                             ;    EDITOR   1 = with the line editor built in (see the end of this file):
0000                             ;                 the spec's suggested standard. It goes with either setting
0000                             ;                 of the other two.
0000                             ;    CHECKED  0 = no checks (spec: the programmer is responsible)
0000                             ;             1 = starts with every variable at 0 and every word undefined,
0000                             ;                 and stops on every error in the spec's table (and Ctrl-C)
0000                             ;                 with a three-line report: the letter and the place as line
0000                             ;                 and column, and both stacks. See `error`.
0000                             ;    SPEED    0 = small: the smallest build
0000                             ;             1 = base, the default: the speed-ups that cost bytes: a skip
0000                             ;                 cache, a faster skip, "*" and "/" quicker for small and
0000                             ;                 power-of-two operands, and more (see "Speed-ups")
0000                             ;             2 = fast: base and a dispatch table besides, with no size
0000                             ;                 limit (see "The fast build"). Not with EDITOR.
0000                             ;    ANSI     what the console escapes of "$" (/00bbIC8= /| /` /~) do:
0000                             ;             1 = send ANSI (VT100) sequences through CONOUT
0000                             ;             0 = call the machine's own routines CONCLS, CONEOL, CONCUR and
0000                             ;                 CONAT (see the equates). The CP/M builds always send ANSI.
0000                             ; 
0000                             ;  In every build Ctrl-C stops a running program (an unchecked build stops
0000                             ;  without a word): see the console layer for the rules, the held key and
0000                             ;  the break-off cell.
0000                             ; 
0000                             ;  Assembler: asm80 (https://maly.github.io/asm80-node/), Z80 mode.
0000                             ; =============================================================================
0000                CPM:      EQU   0   ; 1 = CP/M .COM build
0000                CHECKED:   EQU   0   ; 1 = checked build
0000                EDITOR:   EQU   0   ; 1 = with the line editor
0000                ANSI:     EQU   0   ; 1 = the console escapes send ANSI sequences
0000                SPEED:    EQU   0   ; 0 = small, 1 = base, 2 = fast (not with EDITOR) (see "Speed-ups")
0000                FAST:     EQU   SPEED/2   ; (1: the fast build)
0000                SBASE:    EQU   SPEED-FAST*2   ; (1: the base build)
0000                ANS:      EQU   ANSI+CPM-ANSI*CPM   ; (CP/M: always ANSI)
0000                EDGEN:    EQU   EDITOR*(1-CPM)   ; (the generic build with the editor)
0000                             ; (IF takes any value but 0 as true, so
0000                             ;  IF CHECKED+EDITOR means "either")
0000                TABP0:    EQU   EDGEN*(1-CHECKED)   ; (the build with its table in page zero)
0000                PTLATE:   EQU   1-(1-CPM)*(1-EDITOR)*(1-CHECKED)*(1-ANS)   ; (1: the table goes after psgn and pdec,
0000                             ;   not before them: wherever it doesn't cross a
0000                             ;   page. chktab.py says if it does)
0000                QK:       EQU   SBASE+FAST-SBASE*FAST   ; (the speed-ups: base, or the fast build)
0000                SBASEU:   EQU   QK*(1-CHECKED)*(1-FAST)   ; (and those that only the unchecked
0000                             ;  builds take; the fast build has its own)
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Register use, everywhere in the interpreter
0000                             ; 
0000                             ;    BC   IP: the address of the next program character to read
0000                             ;    HL   TOS: the top data-stack cell is kept here, not in memory
0000                             ;    SP   the data stack: (SP) is NOS, the cell under TOS. The data stack is
0000                             ;         the Z80"s own stack, which is what the spec"s machine-code contract
0000                             ;         needs ("the data cells above the return address").
0000                             ;    IY   return-stack pointer. Entries are 2 bytes; the stack grows down.
0000                             ;         Only rpop and rpushn (and the checks) touch it. The alternate
0000                             ;         registers are not used at all: an interrupt routine may use them.
0000                             ;    A DE scratch. Every handler is entered with HL = TOS and may use A, DE.
0000                             ; 
0000                             ;  One-byte calls. In a generic build the routines used most are reached
0000                             ;  with RST, one byte instead of three. The source writes them as macros:
0000                             ; 
0000                             ;    POPR   RST 08h  rpop    pop the return stack into DE
0000                             ;    DROP   RST 18h  drp     drop TOS, then next character  (ends a handler)
0000                             ;    NEGH   RST 20h  neg16   HL = -HL
0000                             ;    PUTA   RST 28h  putc    print A
0000                             ;    NEXT   RST 30h  next0   next character                 (ends a handler)
0000                             ; 
0000                             ;  RST 18h and RST 30h never return: an RST is a CALL, so the first thing
0000                             ;  each of them does is POP DE to throw the return address away.
0000                             ; 
0000                             ;  A CP/M build leaves page zero alone: there the macros are CALLs, and
0000                             ;  DROP and NEXT are jumps (DROPR and NEXTR: JR, where it reaches).
0000                             ; 
0000                             ;  Dispatch. PTAB holds one byte per punctuation character: the low byte of
0000                             ;  its handler's address. The high byte is worked out from the character:
0000                             ;  the handlers of the first NPG1 characters (in code order) start in the
0000                             ;  image's second page, the rest in its first. The layout below keeps to
0000                             ;  that, and testing/chktab.py checks it in every build.
0000                             ; -----------------------------------------------------------------------------
0000                             ;  Memory map. Everything the interpreter writes is in four RAM pages:
0000                             ; 
0000                             ;    RSPAGE   return stack, 112 entries (the pointer stays inside this page)
0000                             ;    DSPAGE   data stack, 127 cells (the top four bytes of the page are spare,
0000                             ;             so a full stack runs two bytes into the page below)
0000                             ;    LETPAGE  letter cells: A..Z at +00h..+33h, a..z at +40h..+73h (so a word
0000                             ;             cell is always 64 bytes below its variable), the heap pointer at
0000                             ;             +7Ch, interpreter variables in the gaps, and the -n? line buffer
0000                             ;             at +80h..+FFh
0000                             ;    PROG     the program text, NUL-terminated; the heap starts after the NUL
0000                             ; 
0000                             ;  The stacks sit below the letter page, so "the program's own space" (what
0000                             ;  the checked build lets ! and . write) is the single range from the letter
0000                             ;  page up to the heap limit. Each stack has a guard band: the data stack can
0000                             ;  overrun by a cell or two (and the calls made while it is full, the error
0000                             ;  report's included) into the top 32 bytes of the return-stack page, which
0000                             ;  are never used, and the return stack by one entry into the page below it.
0000                             ; -----------------------------------------------------------------------------
0000                          IF   CPM   
                    BDOS:     EQU   0005h   
                    BASE:     EQU   0100h   ; where the image starts
0000                          ENDIF      
0000                          IF   CPM*(1-EDITOR)   
                    EXIT:     EQU   0000h   ; warm boot
0000                          ENDIF      
0000                          IFN   CPM   
0000                             ; ---- generic machine: edit these to suit -----------------------------------
0000                KEY:      EQU   0FF06h   ; a waiting key in A, or A = 0 if none is
0000                             ;   waiting. The zero flag must match A
0000                             ;   (end the routine with OR A / RET).
0000                CONOUT:   EQU   0FF03h   ; print the character in A
0000                             ;   KEY and CONOUT must preserve BC, DE, HL and IY.
0000                          ENDIF      
0000                          IF   1-ANS   
0000                             ; With ANSI = 0 the console escapes call these. All four must keep BC and
0000                             ; IY, and all but CONAT also HL. They may change A, DE and the flags.
0000                CONCLS:   EQU   0FF0Ch   ; /{  clear the screen, the cursor to the top left
0000                CONEOL:   EQU   0FF0Fh   ; /}  clear from the cursor to the end of the line
0000                CONCUR:   EQU   0FF12h   ; /| and /`  show the cursor if A is not 0, hide
0000                             ;     it if A = 0
0000                CONAT:    EQU   0FF15h   ; /~  the cursor to row HL, column DE, both
0000                             ;     counted from 0. May change A, DE and HL
0000                          ENDIF      
0000                          IFN   CPM   
0000                RSPAGE:   EQU   80h   ; 8000h return stack
0000                DSPAGE:   EQU   81h   ; 8100h data stack
0000                LETPAGE:   EQU   82h   ; 8200h letter cells and line buffer
0000                PROG:     EQU   8300h   ; where the loader puts the program text
0000                HEAPLIM:   EQU   0F0h   ; the heap must stay below F000h (a page)
0000                CPAGE:    EQU   HEAPLIM   ; the skip cache's page (QK builds): the page
0000                             ;   at the heap limit, which the heap never reaches
0000                BASE:     EQU   0000h   ; where the image starts
0000                          ENDIF      
0000                          IF   (1-CPM)*(1-EDITOR)   
0000                EXIT:     EQU   0FF09h   ; where to go when the program ends
0000                          ENDIF      
0000                          IF   EDGEN   
                    LEAVE:    EQU   0FF09h   ; where the editor's ^X goes
0000                          ENDIF      
0000                          IF   EDITOR*CPM   
                    LEAVE:    EQU   0000h   ; the editor's ^X: warm boot
0000                          ENDIF      
0000                          IF   EDITOR   
                    EXIT:     EQU   edend   ; a program that ends goes back to the editor,
                    SKEND:    EQU   skend   ;   also when it ends inside skip
0000                          ENDIF      
0000                          IF   1-EDITOR   
0000                SKEND:    EQU   EXIT   
0000                          ENDIF      
0000                MSLOOP:   EQU   40-36*CPM   ; n? inner loop count for about 1 ms (1-255):
0000                             ; each pass calls getk once, so tune it for
0000                             ; your clock and your KEY routine. (The wait
0000                             ; for a second Ctrl-C uses it too: 250 ms.)
0000                             ; CP/M: 4, for a BDOS 6 call of about 280 us
0000                             ; (an RC2014 with RomWBW and ZPM3). A .COM can
0000                             ; be patched: see TIMING.B8S.
0000                             ; letter-page layout (offsets inside LETPAGE)
0000                LET:      EQU   LETPAGE*256   
0000                HEAP:     EQU   LET+7Ch   ; the heap pointer
0000                RSAVE:    EQU   LET+34h   ; gap after Z: return stack pointer, saved
0000                             ;   around machine code (and in the checked
0000                             ;   build the address "$" prints from);
0000                PCNT:     EQU   LET+36h   ;   the break-key poll count (see rpushn);
0000                SKPL:     EQU   LET+3Ch   ;   the checked skip's starting place;
0000                NPEND:    EQU   LET+38h   ;   minus the address of the program's end
0000                             ;   (the heap"s first byte), for the checked "_';
0000                EDLN:     EQU   LET+3Ah   ;   the editor: the number of the line that ^E
0000                             ;   put in the input line (0: none)
0000                KEYBUF:   EQU   LET+7Ah   ; gap after z: a key read by the break check and
0000                             ;   held for the next "?" (0: none);
0000                BRKOFF:   EQU   LET+7Bh   ;   the break-off cell: a program that stores a
0000                             ;   non-zero byte here gets Ctrl-C as a key
0000                LINEBUF:   EQU   LET+80h   ; -n? text, ending in CR
0000                RSTOP:    EQU   RSPAGE*256+0E0h   ; empty return stack: the 32 bytes above it
0000                             ; take calls made while the data stack is full
0000                DSTOP:    EQU   DSPAGE*256+0FCh   ; empty data stack. The four bytes above it
0000                             ; are spare: a character can pop two cells
0000                             ; too many before the checked build sees it,
0000                             ; and the next call must not land on the
0000                             ; letter cells.
0000                             ; The five one-byte calls. A generic build owns page zero and reaches them
0000                             ; with RST. A CP/M build must leave page zero alone (CP/M keeps it for
0000                             ; interrupts, and RomWBW's BIOS calls itself through RST 08h), so there each
0000                             ; is a CALL, or a jump for the two that never return: DROP is a JP, and
0000                             ; NEXT is JP (IX), two bytes, with IX holding next0's address throughout.
0000                             ; (asm80 can't nest IF, so these are written with DS: a count of 0 writes
0000                             ; nothing. DS can't take a label that comes later, but EQU can, and DS can
0000                             ; take that.)
0000                AROP:     EQU   rpop   
0000                ANEG:     EQU   neg16   
0000                APUT:     EQU   putc   
0000                APTK:     EQU   putk   
0000                          IF   1-CPM   
0000                PUTK:     EQU   putc   ; (CP/M only: here it is never used)
0000                          ENDIF      
0000                ANXT:     EQU   next0   
0000                          IF   CHECKED   
                    ACHK:     EQU   chkstk   ; (for the fast build's dispatcher)
0000                          ENDIF      
0000                          IF   1-CHECKED   
0000                ACHK:     EQU   0   
0000                          ENDIF      
0000                          IF   FAST   
                    DTPG:     EQU   DTAB/256   ; (the fast build"s table"s first page)
0000                          ENDIF      
0000                          IF   1-FAST   
0000                DTPG:     EQU   0   
0000                          ENDIF      
0000                .macro POPR,
0000                             ; 
0000                 DS      1-CPM,0CFh      ;   RST 08h
0000                 DS      CPM,0CDh        ;   CALL rpop
0000                 DS      CPM,AROP&0FFh
0000                 DS      CPM,AROP/256
0000                .endm
0000                 
0000                .macro DROP,
0000                             ; 
0000                 DS      (1-CPM)*(1-FAST),0DFh ; RST 18h
0000                 DS      CPM+FAST-CPM*FAST,0E1h ; POP HL
0000                 DS      CPM+FAST-CPM*FAST,0DDh ; JP (IX)
0000                 DS      CPM+FAST-CPM*FAST,0E9h
0000                .endm
0000                 
0000                .macro NEGH,
0000                             ; 
0000                 DS      1-CPM,0E7h      ;   RST 20h
0000                 DS      CPM,0CDh        ;   CALL neg16
0000                 DS      CPM,ANEG&0FFh
0000                 DS      CPM,ANEG/256
0000                .endm
0000                 
0000                .macro PUTA,
0000                             ; 
0000                 DS      1-CPM,0EFh      ;   RST 28h
0000                 DS      CPM,0CDh        ;   CALL putc
0000                 DS      CPM,APUT&0FFh
0000                 DS      CPM,APUT/256
0000                .endm
0000                 
0000                .macro PUTK,
0000                             ; 
0000                 DS      1-CPM,3Eh       ;   LD A,%%1 / RST 28h
0000                 DS      1-CPM,%%1
0000                 DS      1-CPM,0EFh
0000                 DS      CPM,0CDh        ;   CALL putk / DB %%1
0000                 DS      CPM,APTK&0FFh
0000                 DS      CPM,APTK/256
0000                 DS      CPM,%%1
0000                .endm
0000                 
0000                .macro PUTAR,
0000                             ; 
0000                 DS      1-CPM,0EFh      ;   RST 28h
0000                 DS      1-CPM,0C9h      ;   RET
0000                 DS      CPM,0C3h        ;   JP putc
0000                 DS      CPM,APUT&0FFh
0000                 DS      CPM,APUT/256
0000                .endm
0000                 
0000                .macro NEXT,
0000                             ; 
0000                 DS      (1-CPM)*(1-FAST),0F7h ; RST 30h
0000                 DS      CPM+FAST-CPM*FAST,0DDh ; JP (IX): IX holds next0
0000                 DS      CPM+FAST-CPM*FAST,0E9h
0000                .endm
0000                 
0000                .macro NEXTF,
0000                             ; 
0000                 DS      FAST*CHECKED,0CDh ;   (fast build: CALL chkstk, checked)
0000                 DS      FAST*CHECKED,ACHK&0FFh
0000                 DS      FAST*CHECKED,ACHK/256
0000                 DS      FAST,0Ah        ;   (fast build: the dispatcher: LD A,(BC)
0000                 DS      FAST,03h        ;   INC BC
0000                 DS      FAST,0EBh       ;   EX DE,HL
0000                 DS      FAST,6Fh        ;   LD L,A
0000                 DS      FAST,26h        ;   LD H,DTAB/256
0000                 DS      FAST,DTPG
0000                 DS      FAST,7Eh        ;   LD A,(HL)
0000                 DS      FAST,24h        ;   INC H
0000                 DS      FAST,66h        ;   LD H,(HL)
0000                 DS      FAST,6Fh        ;   LD L,A
0000                 DS      FAST,0E9h       ;   JP (HL))
0000                .endm
0000                 
0000                .macro NEXTZ,
0000                             ; 
0000                 DS      1-CPM,0F7h      ;   byte there in every build (RST 30h)
0000                 DS      CPM,0DDh        ; JP (IX)
0000                 DS      CPM,0E9h
0000                .endm
0000                 
0000                .macro SETIX,
0000                             ; 
0000                 DS      CPM+FAST-CPM*FAST,0DDh ; a generic build): LD IX,next0
0000                 DS      CPM+FAST-CPM*FAST,21h
0000                 DS      CPM+FAST-CPM*FAST,ANXT&0FFh
0000                 DS      CPM+FAST-CPM*FAST,ANXT/256
0000                .endm
0000                 
0000                             ; =============================================================================
0000                             ;  The first 49 bytes: the entry, then the RST routines, with small handlers
0000                             ;  and routines filling the gaps between them. Generic: this IS page zero.
0000                             ;  CP/M: it is just the start of the .COM file.
0000                             ; =============================================================================
0000                          .ORG   BASE   
0000                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                              XOR   A   ; 00  reset. (This byte, AFh, is also what an
0000                          ENDIF      ;     undefined word runs into: see e_hi.)
0000                          IF   1-EDGEN   
0000   31 FC 81               LD   SP,DSTOP   ; 00  reset, or the start of the .COM file
0003                          ENDIF      
0003                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)*(1-QK)   
0003   01 00 83               LD   BC,PROG   ; 03  the IP
0006   18 64                  JR   st0   ; 06  (the rest of the startup is close by)
0008                          ENDIF      
0008                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)*QK   
                              JP   qstart   ; 03  (the skip cache is emptied first)
                              DW   0   ; 06  spare
0008                          ENDIF      
0008                          IF   (1-CPM)*(1-EDITOR)*CHECKED*(1-QK)   
                              JR   init   ; 04  (the rest of the startup is close by)
                              DW   0   ; 06  spare
0008                          ENDIF      
0008                          IF   (1-CPM)*(1-EDITOR)*CHECKED*QK   
                              JP   qinit   ; 04  (the skip cache is emptied first)
                              DB   0   ; 07  spare
0008                          ENDIF      
0008                          IF   EDGEN   
                              XOR   A   ; 00  reset: no program yet. (This byte, AFh,
                              LD   (PROG),A   ;     is also what an undefined word runs
                              JP   init   ; 04  into in the checked build: see e_hi.)
                              NOP      ; 07  spare
0008                          ENDIF      
0008                          IF   CPM*(1-EDITOR)   
                              JP   start   ; 03
0008                          ENDIF      
0008                          IF   CPM*EDITOR*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at
                                 ; 0, every word cell holds 0000h, the address an undefined word is
                                 ; caught at (see e_hi: the byte there is CP/M's JP, C3h), and no key
                                 ; is held back.
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
0008                          ENDIF      
0008                          IF   CPM*EDITOR   
                              CALL   load   ; the file named on the command line
                              JP   edit0   
0008                          ENDIF      
0008                          IF   1-CPM   
0008                             ; ---- RST 08h: rpop: pop the return stack into DE ---------------------------
0008   FD 5E 00     RPOP:     LD   E,(IY+0)   ; 08
000B   FD 56 01               LD   D,(IY+1)   
000E   18 1B                  JR   rp2   ; (the rest is at 2Bh)
0010                             ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
0010   C6 21        CTL:      ADD   A,21h   ; 10  back to c; zero only for NUL
0012   20 1D                  JR   NZ,next0   ;     the rest are ignored
0014   C3 09 FF     ENDPROG:   JP   EXIT   ;     the program has ended
0017   00                     NOP      ; 17  spare
0018                             ; ---- RST 18h: drop TOS, then next ------------------------------------------
0018   D1           RST18:    POP   DE   ; 18  discard the RST's return address
0019   E1           DRP:      POP   HL   ;     new TOS = NOS
001A   18 15                  JR   next0   
001C                          ENDIF      
001C   E5           H_FROMR:   PUSH   HL   ; 1C  "}" return stack to TOS
001D                          ;*Macro unroll:  POPR
001D   CF                     DS   1-CPM,0CFh   
001E                          DS   CPM,0CDh   
001E                          DS   CPM,AROP&0FFh   
001E                          DS   CPM,AROP/256   
001E   EB                     EX   DE,HL   
001F                          ;*Macro unroll:  NEXTZ
001F   F7                     DS   1-CPM,0F7h   
0020                          DS   CPM,0DDh   
0020                          DS   CPM,0E9h   
0020                          IF   1-CPM   
0020                             ; ---- RST 20h: neg16: HL = -HL (keeps BC, DE) -------------------------------
0020   AF           NEG16:    XOR   A   ; 20
0021   95                     SUB   L   
0022   6F                     LD   L,A   
0023   9F                     SBC   A,A   
0024   94                     SUB   H   
0025   67                     LD   H,A   
0026   C9                     RET      
0027   00                     NOP      ; 27  spare
0028                             ; ---- RST 28h: putc: print A (keeps BC, DE, HL, IY) -------------------------
0028                RST28:       
0028   C3 03 FF     PUTC:     JP   CONOUT   ; 28
002B   FD 23        RP2:      INC   IY   ; 2B  the rest of rpop
002D   FD 23                  INC   IY   
002F   C9                     RET      
0030                             ; ---- RST 30h: next character -----------------------------------------------
0030   D1           RST30:    POP   DE   ; 30  discard the RST's return address
0031                          ENDIF      
0031                          IF   CPM   
                                 ; ctl: the inner loop comes here for characters below 21h. A = c - 21h.
                    CTL:      ADD   A,21h   ; back to c; zero only for NUL
                              JR   NZ,next0   ; the rest are ignored
                    ENDPROG:   JP   EXIT   ; the program has ended
0031                          ENDIF      
0031                             ; =============================================================================
0031                             ;  The inner loop: read one character and sort it by range.
0031                             ; 
0031                             ;    00h          end of program
0031                             ;    01h-20h, 7Fh-FFh   ignored (control, space, DEL, high bytes)
0031                             ;    30h-39h      digit: read a whole number
0031                             ;    41h-5Ah      A-Z: call the word in that letter's cell
0031                             ;    61h-7Ah      a-z: push the address of that letter's cell
0031                             ;    the rest     punctuation: jump through PTAB, 32 entries, in code order
0031                             ; =============================================================================
0031                          IF   FAST   
                              ;*Macro unroll: next0:  NEXTF                   ; (the fast build: the table dispatcher)
                    NEXT0:    DS   FAST*CHECKED,0CDh   ; (the fast build: the table dispatcher)
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
0031                          ENDIF      
0031                          IF   1-FAST   
0031                NEXT0:       
0031                          ENDIF      
0031                          IF   CHECKED*(1-FAST)   
                              CALL   chkstk   ; both stacks are checked once per character
0031                          ENDIF      
0031                          IF   1-FAST   
0031   0A                     LD   A,(BC)   
0032   03                     INC   BC   
0033   D6 21                  SUB   21h   ; A = c - 21h
0035   38 D9                  JR   C,ctl   ; c < 21h: NUL ends, the rest are ignored
0037   FE 0F                  CP   0Fh   
0039   38 22                  JR   C,punct   ; 21h-2Fh: PTAB index 0-14
003B   D6 0F                  SUB   0Fh   ; A = c - 30h
003D   FE 0A                  CP   0Ah   
003F   38 69                  JR   C,digit   ; 30h-39h
0041   FE 11                  CP   11h   
0043   38 16                  JR   C,p3a   ; 3Ah-40h
0045   D6 11                  SUB   11h   ; A = c - 41h
0047   FE 1A                  CP   1Ah   
0049   38 6B                  JR   C,upper   ; 41h-5Ah: A = letter index 0-25
004B   FE 20                  CP   20h   
004D   38 0A                  JR   C,p5b   ; 5Bh-60h
004F   FE 3A                  CP   3Ah   
0051   38 5D                  JR   C,lower   ; 61h-7Ah: A = 20h-39h (cell +64 bytes)
0053   FE 3E                  CP   3Eh   
0055                          ENDIF      
0055                          IF   (1-CHECKED)*(1-FAST)   
0055   30 DA                  JR   NC,next0   ; 7Fh-FFh: ignored
0057                          ENDIF      
0057                          IF   CHECKED*(1-FAST)   
                              JR   Z,next0   ; 7Fh, DEL: ignored
                              JP   NC,e_hi   ; 80h-FFh: reserved
0057                          ENDIF      
0057                          IF   1-FAST   
0057   D6 1A                  SUB   1Ah   ; 7Bh-7Eh: -1Eh in all, index 28-31
0059   D6 09        P5B:      SUB   9   ; 5Bh-60h: -4 in all, index 22-27
005B   C6 05        P3A:      ADD   A,5   ; 3Ah-40h: index 15-21
005D                          ENDIF      
005D                .macro PTABLE,
005D                             ; 
005D                 DB      h_store & 0FFh  ; !
005D                 DB      h_str & 0FFh    ; "
005D                 DB      h_num & 0FFh    ; #
005D                 DB      h_print & 0FFh  ; $
005D                 DB      h_swap & 0FFh   ; %
005D                 DB      h_and & 0FFh    ; &
005D                 DB      h_emit & 0FFh   ; '
005D                 DB      h_open & 0FFh   ; (
005D                 DB      h_close & 0FFh  ; )
005D                 DB      h_mul & 0FFh    ; *
005D                 DB      h_add & 0FFh    ; +
005D                 DB      h_cfetch & 0FFh ; ,
005D                 DB      h_sub & 0FFh    ; -
005D                 DB      h_cstore & 0FFh ; .
005D                 DB      h_div & 0FFh    ; /
005D                 DB      h_dup & 0FFh    ; :
005D                 DB      h_drop & 0FFh   ; ;
005D                 DB      h_lt & 0FFh     ; <
005D                 DB      h_eq & 0FFh     ; =
005D                 DB      h_gt & 0FFh     ; >
005D                 DB      h_key & 0FFh    ; ?
005D                 DB      h_fetch & 0FFh  ; @
005D                 DB      h_def & 0FFh    ; [
005D                 DB      h_break & 0FFh  ; \
005D                 DB      h_ret & 0FFh    ; ]
005D                 DB      h_xor & 0FFh    ; ^
005D                 DB      h_alloc & 0FFh  ; _
005D                 DB      h_grave & 0FFh  ; `
005D                 DB      h_tor & 0FFh    ; {
005D                 DB      h_or & 0FFh     ; |
005D                 DB      h_fromr & 0FFh  ; }
005D                 DB      h_not & 0FFh    ; ~
005D                .endm
005D                 
005D                             ; Punctuation: A = the PTAB index. The handler starts with HL = TOS,
005D                             ; untouched, and A, DE free.
005D                          IF   1-FAST   
005D   C6 B9        PUNCT:    ADD   A,PTAB & 0FFh   ; PTAB never crosses a page
005F   5F                     LD   E,A   
0060   16 02                  LD   D,PTAB / 256   ; (0 if the table is in page zero)
0062   FE D0                  CP   (PTAB & 0FFh) + NPG1   ; carry: one of the first NPG1
0064   1A                     LD   A,(DE)   
0065   5F                     LD   E,A   ; the handler's low byte
0066                          ENDIF      
0066                          IF   (1-CPM)*(1-TABP0)*(1-FAST)   
0066   16 00                  LD   D,0   
0068                          ENDIF      
0068                          IF   (1-CPM)*(1-FAST)   
0068   CB 12                  RL   D   ; its page: 0 + carry
006A                          ENDIF      
006A                          IF   CPM*(1-FAST)   
                              LD   D,1   
                              JR   NC,pu1   
                              INC   D   ; its page: 1 + carry
                    PU1:         
006A                          ENDIF      
006A                          IF   1-FAST   
006A   D5                     PUSH   DE   ; jump to it; the stack is balanced again
006B   C9                     RET      ;   when the handler starts
006C                          ENDIF      
006C                             ; The rest of the startup: here so that the generic reset code can reach it
006C                             ; with JR. st0: find the program's NUL; the heap starts after it.
006C                             ; (The editor build has its own copy of this, next to the editor.)
006C                             ; A checked build first clears the lower half of the letter page (A = 0):
006C                             ; every variable starts at 0, every word cell holds 0000h, the address an
006C                             ; undefined word is caught at (see e_hi), and no key is held back.
006C                          IF   (1-CPM)*(1-EDITOR)*CHECKED   
                    INIT:     LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
                              LD   BC,PROG   ; the IP
006C                          ENDIF      
006C                          IF   (1-CPM)*(1-EDITOR)   
006C   60           ST0:      LD   H,B   
006D   69                     LD   L,C   
006E   AF                     XOR   A   
006F   BE           ST1:      CP   (HL)   
0070   23                     INC   HL   
0071   20 FC                  JR   NZ,st1   
0073                          ENDIF      
0073                          IF   1-EDITOR   
0073   22 7C 82     ST2:      LD   (HEAP),HL   
0076                          ENDIF      
0076                          IF   CHECKED*(1-EDITOR)   
                              ;*Macro unroll:  NEGH                    ; minus the heap's first address: '_' may not
                              DS   1-CPM,0E7h   ; minus the heap"s first address: "_' may not
                              DS   CPM,0CDh   
                              DS   CPM,ANEG&0FFh   
                              DS   CPM,ANEG/256   
                              LD   (NPEND),HL   ;   release below it
0076                          ENDIF      
0076                          IF   (1-CHECKED)*(1-EDITOR)*(1-CPM)   
0076   67                     LD   H,A   ; (A = 0) no key is held, and the break key
0077   6F                     LD   L,A   ;   is on (the checked build has cleared
0078                          ENDIF      ;   these)
0078                          IF   (1-CHECKED)*(1-EDITOR)*CPM   
                              LD   HL,0   
0078                          ENDIF      
0078                          IF   (1-CHECKED)*(1-EDITOR)   
0078   22 7A 82               LD   (KEYBUF),HL   
007B                          ENDIF      
007B                          IF   1-EDITOR   
007B                          ;*Macro unroll:  SETIX
007B                          DS   CPM+FAST-CPM*FAST,0DDh   
007B                          DS   CPM+FAST-CPM*FAST,21h   
007B                          DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
007B                          DS   CPM+FAST-CPM*FAST,ANXT/256   
007B   FD 21 E0 80            LD   IY,RSTOP   ; the return stack is empty
007F                          ;*Macro unroll:  NEXT                    ; (its return address is thrown away)
007F   F7                     DS   (1-CPM)*(1-FAST),0F7h   ; (its return address is thrown away)
0080                          DS   CPM+FAST-CPM*FAST,0DDh   
0080                          DS   CPM+FAST-CPM*FAST,0E9h   
0080                          ENDIF      
0080                             ; In the unchecked generic editor build the table is here, in the first
0080                             ; page, which saves loading D twice. (The other builds have no room for it
0080                             ; here: theirs is further down.)
0080                          IF   TABP0   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0080                          ENDIF      
0080                             ; =============================================================================
0080                             ;  Handlers that must start in the image's first page: ^ _ ` | ~
0080                             ;  (00bbIGFuZCA= are up among the RST routines.) The machine-code call, exec,
0080                             ;  is here too: it belongs to "`" and makes the page come out right.
0080                             ; =============================================================================
0080   D1           H_XOR:    POP   DE   
0081   7C                     LD   A,H   
0082   AA                     XOR   D   
0083   67                     LD   H,A   
0084   7D                     LD   A,L   
0085   AB                     XOR   E   
0086   6F                     LD   L,A   
0087                          ;*Macro unroll:  NEXT
0087   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0088                          DS   CPM+FAST-CPM*FAST,0DDh   
0088                          DS   CPM+FAST-CPM*FAST,0E9h   
0088   D1           H_OR:     POP   DE   
0089   7C                     LD   A,H   
008A   B2                     OR   D   
008B   67                     LD   H,A   
008C   7D                     LD   A,L   
008D   B3                     OR   E   
008E   6F                     LD   L,A   
008F                          ;*Macro unroll:  NEXT
008F   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0090                          DS   CPM+FAST-CPM*FAST,0DDh   
0090                          DS   CPM+FAST-CPM*FAST,0E9h   
0090                          ;*Macro unroll: h_not:  NEGH                    ; ~x = -x - 1
0090   E7           H_NOT:    DS   1-CPM,0E7h   ; ~x = -x - 1
0091                          DS   CPM,0CDh   
0091                          DS   CPM,ANEG&0FFh   
0091                          DS   CPM,ANEG/256   
0091   2B                     DEC   HL   
0092                          ;*Macro unroll:  NEXT
0092   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0093                          DS   CPM+FAST-CPM*FAST,0DDh   
0093                          DS   CPM+FAST-CPM*FAST,0E9h   
0093                             ; "_" ( n -- addr ): the heap pointer moves by n, a signed count (the add is
0093                             ; the same either way); TOS is the old pointer.
0093   ED 5B 7C 82  H_ALLOC:   LD   DE,(HEAP)   
0097                          IF   CHECKED*CPM   
                              LD   A,H   ; the count's sign, for chkhp
0097                          ENDIF      
0097   19                     ADD   HL,DE   ; the new top
0098                          IF   CHECKED   
                              CALL   chkhp   
0098                          ENDIF      
0098   22 7C 82               LD   (HEAP),HL   
009B   EB                     EX   DE,HL   
009C                          ;*Macro unroll:  NEXT
009C   F7                     DS   (1-CPM)*(1-FAST),0F7h   
009D                          DS   CPM+FAST-CPM*FAST,0DDh   
009D                          DS   CPM+FAST-CPM*FAST,0E9h   
009D                          IF   1-CPM*CHECKED   
009D   FD 22 34 82  EXEC:     LD   (RSAVE),IY   ; machine code may change IX and IY
00A1   CD D8 00               CALL   jphl   
00A4   FD 2A 34 82            LD   IY,(RSAVE)   
00A8                          ;*Macro unroll:  SETIX
00A8                          DS   CPM+FAST-CPM*FAST,0DDh   
00A8                          DS   CPM+FAST-CPM*FAST,21h   
00A8                          DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
00A8                          DS   CPM+FAST-CPM*FAST,ANXT/256   
00A8   E1                     POP   HL   
00A9                          ;*Macro unroll:  NEXT
00A9   F7                     DS   (1-CPM)*(1-FAST),0F7h   
00AA                          DS   CPM+FAST-CPM*FAST,0DDh   
00AA                          DS   CPM+FAST-CPM*FAST,0E9h   
00AA                          ENDIF      
00AA                             ; ---- the letters and digits (here, in the middle, so that the inner loop's
00AA                             ; ---- short jumps reach them, and the handlers after them reach rpushn) ------
00AA                             ; Digits: step back onto the first digit and read the whole number.
00AA   E5           DIGIT:    PUSH   HL   
00AB   0B                     DEC   BC   
00AC   CD 76 02               CALL   rdnum   
00AF                          ;*Macro unroll:  NEXT
00AF   F7                     DS   (1-CPM)*(1-FAST),0F7h   
00B0                          DS   CPM+FAST-CPM*FAST,0DDh   
00B0                          DS   CPM+FAST-CPM*FAST,0E9h   
00B0                             ; a-z: push the cell's address (the cell is the variable)
00B0                             ;  (the unchecked builds with room do x@ and x! in one step: lowq)
00B0                          IF   1-SBASEU   
00B0   E5           LOWER:    PUSH   HL   
00B1   87                     ADD   A,A   
00B2   6F                     LD   L,A   
00B3   26 82                  LD   H,LETPAGE   
00B5                          ;*Macro unroll:  NEXT
00B5   F7                     DS   (1-CPM)*(1-FAST),0F7h   
00B6                          DS   CPM+FAST-CPM*FAST,0DDh   
00B6                          DS   CPM+FAST-CPM*FAST,0E9h   
00B6                          ENDIF      
00B6                          IF   SBASEU   
                    LOWER:    JP   lowq   
00B6                          ENDIF      
00B6                             ; A-Z: call the word. The return address (the IP after the letter) goes on
00B6                             ; the return stack, and the IP becomes the address in the letter's cell.
00B6   C5           UPPER:    PUSH   BC   ; the return address, for rpushn
00B7   EB                     EX   DE,HL   ; park TOS
00B8   87                     ADD   A,A   
00B9   6F                     LD   L,A   
00BA   26 82                  LD   H,LETPAGE   ; HL -> cell
00BC   4E                     LD   C,(HL)   
00BD   2C                     INC   L   
00BE   46                     LD   B,(HL)   ; IP = the word's body
00BF   EB                     EX   DE,HL   ; TOS back, and fall into rpushn
00C0                             ; rpushn: move the top cell of the data stack (in memory) to the return
00C0                             ; stack, then next. Everything that pushes the return stack ends here.
00C0                             ; 
00C0                             ; The break key is looked at here, so at every word call and loop-back (and
00C0                             ; block entry and "{"), but only one time in 256: PCNT counts them.
00C0                             ; Reading the keyboard can be slow (it is a BDOS call under CP/M).
00C0   D1           RPUSHN:   POP   DE   
00C1   FD 72 FF               LD   (IY-1),D   
00C4   FD 73 FE               LD   (IY-2),E   
00C7   FD 2B                  DEC   IY   
00C9   FD 2B                  DEC   IY   
00CB   E5                     PUSH   HL   
00CC   21 36 82               LD   HL,PCNT   
00CF   35                     DEC   (HL)   
00D0   E1                     POP   HL   ; (the zero flag lasts)
00D1   CC 05 03               CALL   Z,pollk   
00D4                          ;*Macro unroll:  NEXT
00D4   F7                     DS   (1-CPM)*(1-FAST),0F7h   
00D5                          DS   CPM+FAST-CPM*FAST,0DDh   
00D5                          DS   CPM+FAST-CPM*FAST,0E9h   
00D5                             ; "{" TOS to the return stack: the new TOS comes up, the old one goes across.
00D5   E3           H_TOR:    EX   (SP),HL   
00D6   18 E8                  JR   rpushn   
00D8   E9           JPHL:     JP   (HL)   ; (for the machine-code call)
00D9                             ; ---- machine code: the grave -----------------------------------------------
00D9                             ; "`" plus a hex digit loads bytes: ( addr -- addr' ). Pairs of hex digits
00D9                             ; are stored from addr until a non-hex character; then a RET (C9h) is
00D9                             ; written and its address is left. An odd last digit is consumed and dropped.
00D9                             ; "`" plus anything else calls the machine code at TOS: ( addr -- ). The
00D9                             ; code is entered by CALL with the data stack above the return address; it
00D9                             ; must keep BC, and on return the top cell becomes the new TOS.
00D9   CD D9 02     H_GRAVE:   CALL   hexc   
00DC                          IF   1-CPM*CHECKED   
00DC   30 BF                  JR   NC,exec   
00DE                          ENDIF      
00DE                          IF   CPM*CHECKED   
                              JP   NC,exec   ; (out of the way: see rpop)
00DE                          ENDIF      
00DE   77           HX1:      LD   (HL),A   ; the high digit goes in first ...
00DF   CD D9 02               CALL   hexc   
00E2   30 08                  JR   NC,hx2   ; odd digit: consumed, and the RET below
00E4   ED 6F                  RLD      ;   overwrites it
00E6   23                     INC   HL   ; ... and RLD shifts it up under the low one
00E7   CD D9 02               CALL   hexc   
00EA   38 F2                  JR   C,hx1   
00EC   36 C9        HX2:      LD   (HL),0C9h   ; (never range-checked: the spec says so)
00EE                          ;*Macro unroll:  NEXT
00EE   F7                     DS   (1-CPM)*(1-FAST),0F7h   
00EF                          DS   CPM+FAST-CPM*FAST,0DDh   
00EF                          DS   CPM+FAST-CPM*FAST,0E9h   
00EF                             ; ---- where the two pages meet ----------------------------------------------
00EF                             ; The first page ends somewhere among the next four handlers, ] \ [ @ (they
00EF                             ; are in falling code order for this), and where exactly differs between the
00EF                             ; builds: NPG1 follows. Every handler below these four must start in the
00EF                             ; second page, and every one above in the first; chktab.py checks both.
00EF                             ; "]" returns: pop an address and jump to it.
00EF                          ;*Macro unroll: h_ret:  POPR
00EF   CF           H_RET:    DS   1-CPM,0CFh   
00F0                          DS   CPM,0CDh   
00F0                          DS   CPM,AROP&0FFh   
00F0                          DS   CPM,AROP/256   
00F0   42                     LD   B,D   
00F1   4B                     LD   C,E   
00F2                          ;*Macro unroll: brk1:   NEXT
00F2   F7           BRK1:     DS   (1-CPM)*(1-FAST),0F7h   
00F3                          DS   CPM+FAST-CPM*FAST,0DDh   
00F3                          DS   CPM+FAST-CPM*FAST,0E9h   
00F3                             ; "\" ( flag -- ): true skips to the next ")" or "]" at this level; ")"
00F3                             ; drops the block start, "]" returns. No closer at all ends the program.
00F3   7C           H_BREAK:   LD   A,H   
00F4   B5                     OR   L   
00F5   E1                     POP   HL   
00F6   28 FA                  JR   Z,brk1   
00F8   CD 98 02               CALL   skip   
00FB   B7                     OR   A   ; skip returns 0 for ")"
00FC   20 F1                  JR   NZ,h_ret   
00FE                          ;*Macro unroll: rdrop:  POPR
00FE   CF           RDROP:    DS   1-CPM,0CFh   
00FF                          DS   CPM,0CDh   
00FF                          DS   CPM,AROP&0FFh   
00FF                          DS   CPM,AROP/256   
00FF                          ;*Macro unroll:  NEXT
00FF   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0100                          DS   CPM+FAST-CPM*FAST,0DDh   
0100                          DS   CPM+FAST-CPM*FAST,0E9h   
0100                             ; "[" followed by a letter stores the body"s address in that letter"s cell:
0100                             ; uppercase is a word, lowercase a variable. Followed by a space it pushes
0100                             ; the body"s address instead. Either way it then skips to the matching "]'.
0100                             ; (The unchecked build takes anything that is not a letter as the space; the
0100                             ; checked build stops on it.)
0100   0A           H_DEF:    LD   A,(BC)   
0101   03                     INC   BC   
0102   D6 41                  SUB   "A"   ; a letter gives 0-25 or 32-57: lowercase
0104   5F                     LD   E,A   ;   lands 64 bytes up
0105   E6 DF                  AND   0DFh   ; fold case
0107   FE 1A                  CP   26   
0109   30 0B                  JR   NC,def2   ; not a letter
010B   CB 23                  SLA   E   
010D   16 82                  LD   D,LETPAGE   ; DE -> cell
010F   79                     LD   A,C   
0110   12                     LD   (DE),A   
0111   1C                     INC   E   
0112   78                     LD   A,B   
0113   12                     LD   (DE),A   
0114   18 03                  JR   skipnx   
0116                DEF2:        
0116                          IF   CHECKED   
                              LD   A,E   
                              CP   " "-"A"+256   
                              JP   NZ,e_brack   ; anything but a letter or a space
0116                          ENDIF      
0116   E5                     PUSH   HL   ; an anonymous block: push its address
0117   60                     LD   H,B   
0118   69                     LD   L,C   
0119                SKIPNX:      
0119                          IF   CHECKED   
                              DEC   BC   ; back onto the letter, so that skip finds its
0119                          ENDIF      ;   opener, the "[", just before where it starts
0119   CD 98 02     SKIPO:    CALL   skip   
011C                          ;*Macro unroll:  NEXT
011C   F7                     DS   (1-CPM)*(1-FAST),0F7h   
011D                          DS   CPM+FAST-CPM*FAST,0DDh   
011D                          DS   CPM+FAST-CPM*FAST,0E9h   
011D   5E           H_FETCH:   LD   E,(HL)   ; "@"
011E   23                     INC   HL   
011F   56                     LD   D,(HL)   
0120   EB                     EX   DE,HL   
0121                          ;*Macro unroll:  NEXT
0121   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0122                          DS   CPM+FAST-CPM*FAST,0DDh   
0122                          DS   CPM+FAST-CPM*FAST,0E9h   
0122                             ; =============================================================================
0122                             ;  Handlers that must start in the image's second page.
0122                             ;  "?" is the last (with "," inside it), so its long tail may run past that
0122                             ;  page.
0122                             ; =============================================================================
0122                             ; "(" ( flag -- ): true pushes the block start and enters; false skips to
0122                             ; the matching ")".
0122   7C           H_OPEN:   LD   A,H   
0123   B5                     OR   L   
0124   E1                     POP   HL   
0125   28 F2                  JR   Z,skipo   
0127   C5                     PUSH   BC   ; the block starts at the IP
0128   18 96                  JR   rpushn   
012A                             ; ")" ( flag -- ): true jumps back to the block start (and keeps it); false
012A                             ; drops it and carries on.
012A   7C           H_CLOSE:   LD   A,H   
012B   B5                     OR   L   
012C   E1                     POP   HL   
012D   28 CF                  JR   Z,rdrop   
012F                          IF   QK   
                              JP   closeq   ; (out of the handlers' pages: see Speed-ups)
012F                          ENDIF      
012F                          IF   1-QK   
012F                          ;*Macro unroll:  POPR                    ; pop the block start ...
012F   CF                     DS   1-CPM,0CFh   ; pop the block start ...
0130                          DS   CPM,0CDh   
0130                          DS   CPM,AROP&0FFh   
0130                          DS   CPM,AROP/256   
0130   42                     LD   B,D   
0131   4B                     LD   C,E   
0132   C5                     PUSH   BC   
0133                          ENDIF      
0133                          IF   (1-QK)*(1-CPM)   
0133   18 8B                  JR   rpushn   ; ... and push it back
0135                          ENDIF      
0135                          IF   (1-QK)*CPM   
                              JP   rpushn   
0135                          ENDIF      
0135                             ; ---- arithmetic and logic: ( NOS TOS -- result ) ---------------------------
0135                             ; "-" has two jobs: directly before a digit it starts a negative number.
0135   0A           H_SUB:    LD   A,(BC)   
0136   D6 30                  SUB   "0"   
0138   FE 0A                  CP   10   
013A   38 04                  JR   C,negnum   
013C                          ;*Macro unroll:  NEGH                    ; a - b = a + (-b): fall into '+'
013C   E7                     DS   1-CPM,0E7h   ; a - b = a + (-b): fall into "+"
013D                          DS   CPM,0CDh   
013D                          DS   CPM,ANEG&0FFh   
013D                          DS   CPM,ANEG/256   
013D   D1           H_ADD:    POP   DE   
013E   19                     ADD   HL,DE   
013F                          ;*Macro unroll:  NEXT
013F   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0140                          DS   CPM+FAST-CPM*FAST,0DDh   
0140                          DS   CPM+FAST-CPM*FAST,0E9h   
0140   E5           NEGNUM:   PUSH   HL   ; a negative number: read it, negate it
0141   CD 76 02               CALL   rdnum   
0144                          ;*Macro unroll:  NEGH
0144   E7                     DS   1-CPM,0E7h   
0145                          DS   CPM,0CDh   
0145                          DS   CPM,ANEG&0FFh   
0145                          DS   CPM,ANEG/256   
0145                          ;*Macro unroll:  NEXT
0145   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0146                          DS   CPM+FAST-CPM*FAST,0DDh   
0146                          DS   CPM+FAST-CPM*FAST,0E9h   
0146   D1           H_AND:    POP   DE   
0147   7C                     LD   A,H   
0148   A2                     AND   D   
0149   67                     LD   H,A   
014A   7D                     LD   A,L   
014B   A3                     AND   E   
014C   6F                     LD   L,A   
014D                          ;*Macro unroll:  NEXT
014D   F7                     DS   (1-CPM)*(1-FAST),0F7h   
014E                          DS   CPM+FAST-CPM*FAST,0DDh   
014E                          DS   CPM+FAST-CPM*FAST,0E9h   
014E                             ; Signed compares. Both are "HL < DE" for the right pair: "<" swaps the two
014E                             ; cells first. Flipping both sign bits turns a signed compare into an
014E                             ; unsigned one (and XOR clears the carry for SBC); SBC HL,HL then turns the
014E                             ; carry into -1 or 0 with no branch.
014E   E3           H_LT:     EX   (SP),HL   ; a < b: HL = a, and b is popped next
014F   D1           H_GT:     POP   DE   ; a > b  is  b < a: HL = b, DE = a
0150   7C                     LD   A,H   
0151   EE 80                  XOR   80h   
0153   67                     LD   H,A   
0154   7A                     LD   A,D   
0155   EE 80                  XOR   80h   
0157   57                     LD   D,A   
0158   ED 52                  SBC   HL,DE   ; carry if HL < DE
015A   ED 62        TF:       SBC   HL,HL   ; carry -> -1 or 0
015C                          ;*Macro unroll:  NEXT
015C   F7                     DS   (1-CPM)*(1-FAST),0F7h   
015D                          DS   CPM+FAST-CPM*FAST,0DDh   
015D                          DS   CPM+FAST-CPM*FAST,0E9h   
015D   D1           H_EQ:     POP   DE   
015E   B7                     OR   A   
015F   ED 52                  SBC   HL,DE   
0161   7C                     LD   A,H   
0162   B5                     OR   L   
0163   FE 01                  CP   1   ; carry only if a - b = 0
0165   18 F3                  JR   tf   
0167                             ; "*": shift-and-add, 16 rounds; only the low 16 bits are kept. The
0167                             ; multiplier shifts up through A:C.
0167                          IF   1-QK   
0167   D1           H_MUL:    POP   DE   ; DE = multiplicand
0168   C5                     PUSH   BC   
0169   7C                     LD   A,H   
016A   4D                     LD   C,L   ; A:C = multiplier
016B   21 00 00               LD   HL,0   
016E   06 10                  LD   B,16   
0170   29           MUL1:     ADD   HL,HL   
0171   CB 21                  SLA   C   
0173   17                     RLA      
0174   30 01                  JR   NC,mul2   
0176   19                     ADD   HL,DE   
0177   10 F7        MUL2:     DJNZ   mul1   
0179   C1                     POP   BC   
017A                          ;*Macro unroll:  NEXT
017A   F7                     DS   (1-CPM)*(1-FAST),0F7h   
017B                          DS   CPM+FAST-CPM*FAST,0DDh   
017B                          DS   CPM+FAST-CPM*FAST,0E9h   
017B                          ENDIF      
017B                          IF   QK   
                    H_MUL:    POP   DE   ; DE = multiplicand
                              JP   mulq   ; (out of the handlers' pages: see Speed-ups)
017B                          ENDIF      
017B                             ; "/" ( a b -- q r ): the remainder is on top. Truncates toward zero; r takes
017B                             ; a's sign. Divide |a| by |b|, then q gets the sign of a XOR b and r the sign
017B                             ; of a. Dividing by zero returns two cells of no meaning; the checked build
017B                             ; stops on it.
017B                H_DIV:       
017B                          IF   CHECKED   
                              LD   A,H   
                              OR   L   
                              JP   Z,e_zero   
017B                          ENDIF      
017B   D1                     POP   DE   ; DE = a, HL = b
017C   D5                     PUSH   DE   ; a, for r's sign
017D   7A                     LD   A,D   
017E   AC                     XOR   H   
017F   F5                     PUSH   AF   ; S flag = sign of q
0180   CB 7C                  BIT   7,H   
0182   C4 20 00               CALL   NZ,neg16   ; HL = |b|
0185   EB                     EX   DE,HL   
0186   CB 7C                  BIT   7,H   
0188   C4 20 00               CALL   NZ,neg16   ; HL = |a|, DE = |b|
018B   CD 4E 02               CALL   udiv   ; HL = q, DE = r
018E   F1                     POP   AF   
018F   FC 20 00               CALL   M,neg16   ; q's sign
0192   EB                     EX   DE,HL   ; HL = r, DE = q
0193   F1                     POP   AF   ; A = a's high byte
0194   B7                     OR   A   
0195   FC 20 00               CALL   M,neg16   ; r's sign
0198   D5                     PUSH   DE   ; q under r
0199                          ;*Macro unroll:  NEXT
0199   F7                     DS   (1-CPM)*(1-FAST),0F7h   
019A                          DS   CPM+FAST-CPM*FAST,0DDh   
019A                          DS   CPM+FAST-CPM*FAST,0E9h   
019A                             ; ---- stack and storage -----------------------------------------------------
019A   E5           H_DUP:    PUSH   HL   ; ":"
019B                          ;*Macro unroll:  NEXT
019B   F7                     DS   (1-CPM)*(1-FAST),0F7h   
019C                          DS   CPM+FAST-CPM*FAST,0DDh   
019C                          DS   CPM+FAST-CPM*FAST,0E9h   
019C   E3           H_SWAP:   EX   (SP),HL   ; "%"
019D                          ;*Macro unroll:  NEXT
019D   F7                     DS   (1-CPM)*(1-FAST),0F7h   
019E                          DS   CPM+FAST-CPM*FAST,0DDh   
019E                          DS   CPM+FAST-CPM*FAST,0E9h   
019E                             ; (The checked build tests the address before it takes the value off the
019E                             ; stack, so that an error report shows both.)
019E                H_CSTORE:      ; "." ( c addr -- )
019E                          IF   CHECKED   
                              CALL   chkst   
019E                          ENDIF      
019E   D1                     POP   DE   
019F   73                     LD   (HL),E   
01A0                          ;*Macro unroll: h_drop: DROP                    ; ';' is this one byte
01A0   DF           H_DROP:   DS   (1-CPM)*(1-FAST),0DFh   ; ";" is this one byte
01A1                          DS   CPM+FAST-CPM*FAST,0E1h   
01A1                          DS   CPM+FAST-CPM*FAST,0DDh   
01A1                          DS   CPM+FAST-CPM*FAST,0E9h   
01A1                H_STORE:      ; "!" ( n addr -- )
01A1                          IF   CHECKED   
                              CALL   chkst   
01A1                          ENDIF      
01A1   D1                     POP   DE   
01A2   73                     LD   (HL),E   
01A3   23                     INC   HL   
01A4   72                     LD   (HL),D   
01A5                          ;*Macro unroll:  DROP
01A5   DF                     DS   (1-CPM)*(1-FAST),0DFh   
01A6                          DS   CPM+FAST-CPM*FAST,0E1h   
01A6                          DS   CPM+FAST-CPM*FAST,0DDh   
01A6                          DS   CPM+FAST-CPM*FAST,0E9h   
01A6                             ; ---- console ---------------------------------------------------------------
01A6                             ; 22h pushes the address of the text after it and skips the string.
01A6   E5           H_STR:    PUSH   HL   
01A7   60                     LD   H,B   
01A8   69                     LD   L,C   
01A9   CD 8D 02               CALL   skipstr   
01AC                          IF   CHECKED   
                              OR   A   ; 0: the text ran out before the closing quote
                              JP   Z,e_quote   
01AC                          ENDIF      
01AC                          ;*Macro unroll:  NEXT
01AC   F7                     DS   (1-CPM)*(1-FAST),0F7h   
01AD                          DS   CPM+FAST-CPM*FAST,0DDh   
01AD                          DS   CPM+FAST-CPM*FAST,0E9h   
01AD                             ; "$" prints the string at TOS, decoding escapes: "/" plus a character from
01AD                             ; 60h to 7Eh is one of the escapes at pesc; "/" plus any other character
01AD                             ; clears that character"s bit 6 (/M is CR, and / then DEL gives "?"; "/',
01AD                             ; '"' and '?' have no bit 6, so //, /" and /? give themselves).
01AD                          IF   1-CHECKED   
01AD   7E           H_PRINT:   LD   A,(HL)   
01AE   23                     INC   HL   
01AF   FE 22                  CP   22h   
01B1   28 15                  JR   Z,pr9   
01B3   FE 2F                  CP   "/"   
01B5   20 0C                  JR   NZ,pr1   
01B7   7E                     LD   A,(HL)   
01B8   23                     INC   HL   
01B9   FE 60                  CP   60h   
01BB   38 04                  JR   C,pr0   
01BD   FE 7F                  CP   7Fh   
01BF   38 57                  JR   C,pesc   
01C1   E6 BF        PR0:      AND   0BFh   
01C3                          ;*Macro unroll: pr1:    PUTA
01C3   EF           PR1:      DS   1-CPM,0EFh   
01C4                          DS   CPM,0CDh   
01C4                          DS   CPM,APUT&0FFh   
01C4                          DS   CPM,APUT/256   
01C4   18 E7                  JR   h_print   
01C6                PRLOOP:   EQU   h_print   ; (where the escapes go back to)
01C6                PRAGAIN:   EQU   h_print   ; (and where /~ goes back to)
01C6                          ENDIF      
01C6                          IF   CHECKED   
                                 ; (The checked build has the loop as a routine, prstr, which the error
                                 ; report uses too. The address is kept meanwhile, for a report: it shows
                                 ; the stack as it was before the "$". /~ comes back to hp1.)
                    H_PRINT:   LD   (RSAVE),HL   
                    HP1:      CALL   prstr   
                              ;*Macro unroll:  DROP
                              DS   (1-CPM)*(1-FAST),0DFh   
                              DS   CPM+FAST-CPM*FAST,0E1h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
01C6                          ENDIF      
01C6   7D           H_EMIT:   LD   A,L   ; "'"
01C7                          ;*Macro unroll:  PUTA
01C7   EF                     DS   1-CPM,0EFh   
01C8                          DS   CPM,0CDh   
01C8                          DS   CPM,APUT&0FFh   
01C8                          DS   CPM,APUT/256   
01C8                          ;*Macro unroll: pr9:    DROP
01C8   DF           PR9:      DS   (1-CPM)*(1-FAST),0DFh   
01C9                          DS   CPM+FAST-CPM*FAST,0E1h   
01C9                          DS   CPM+FAST-CPM*FAST,0DDh   
01C9                          DS   CPM+FAST-CPM*FAST,0E9h   
01C9                             ; "#" prints TOS as a signed decimal number, with no space after it.
01C9   CD EB 02     H_NUM:    CALL   psgn   
01CC                          ;*Macro unroll:  DROP
01CC   DF                     DS   (1-CPM)*(1-FAST),0DFh   
01CD                          DS   CPM+FAST-CPM*FAST,0E1h   
01CD                          DS   CPM+FAST-CPM*FAST,0DDh   
01CD                          DS   CPM+FAST-CPM*FAST,0E9h   
01CD                             ; "?" ( n -- c ) or ( -n -- addr )
01CD                             ;   n > 0: wait about n ms for a key; 0 if none came
01CD                             ;   n = 0: wait for a key
01CD                             ;   n < 0: read a line of at most -n characters, with echo. The buffer
01CD                             ;          holds 127 characters and the CR: a bigger count is taken as 127.
01CD   CB 7C        H_KEY:    BIT   7,H   
01CF   20 19                  JR   NZ,line   
01D1   1E 28        KT1:      LD   E,MSLOOP   ; one millisecond, roughly
01D3   CD 33 03     KT2:      CALL   getk   
01D6   20 0E                  JR   NZ,kt3   
01D8   1D                     DEC   E   
01D9   20 F8                  JR   NZ,kt2   
01DB   7C                     LD   A,H   ; 0? never counts down: it waits
01DC   B5                     OR   L   
01DD   28 F2                  JR   Z,kt1   
01DF   2B                     DEC   HL   
01E0   7C                     LD   A,H   
01E1   B5                     OR   L   
01E2   20 ED                  JR   NZ,kt1   ; A = 0 if the time ran out
01E4   FE                     DB   0FEh   ; (CP n: steps over the one byte of ",")
01E5   7E           H_CFETCH:   LD   A,(HL)   ; "," shares "?"s ending: A becomes TOS
01E6   6F           KT3:      LD   L,A   
01E7   26 00                  LD   H,0   
01E9                          ;*Macro unroll:  NEXT
01E9   F7                     DS   (1-CPM)*(1-FAST),0F7h   
01EA                          DS   CPM+FAST-CPM*FAST,0DDh   
01EA                          DS   CPM+FAST-CPM*FAST,0E9h   
01EA                             ; Backspace takes the last character back (and is echoed as it
01EA                             ; is), CR ends (stored, not echoed), every other key is stored and
01EA                             ; echoed until the line is full. (CP/M too: getk reads through BDOS
01EA                             ; 6.) The line buffer starts at offset 80h of its page, so L alone
01EA                             ; is the place in the line: D holds the L of a full line.
01EA   11 7F 00     LINE:     LD   DE,127   ; TOS is minus the count: adding 127 carries
01ED   19                     ADD   HL,DE   ;   only for 1 to 127, and leaves 127 - count
01EE   9F                     SBC   A,A   
01EF   A5                     AND   L   ; (0 for a count that is too big)
01F0   2F                     CPL      
01F1   57                     LD   D,A   ; D = the L of a full line: 80h + count, FFh
01F2                             ;   at most
01F2   21 80 82               LD   HL,LINEBUF   
01F5   CD 33 03     LN2:      CALL   getk   
01F8   28 FB                  JR   Z,ln2   
01FA   FE 0D                  CP   13   
01FC   28 16                  JR   Z,ln5   
01FE   FE 08                  CP   8   
0200   28 0B                  JR   Z,ln4   
0202   5F                     LD   E,A   
0203   7D                     LD   A,L   
0204   BA                     CP   D   
0205   28 EE                  JR   Z,ln2   ; full
0207   73                     LD   (HL),E   
0208   2C                     INC   L   
0209   7B                     LD   A,E   
020A                          ;*Macro unroll: ln3:    PUTA
020A   EF           LN3:      DS   1-CPM,0EFh   
020B                          DS   CPM,0CDh   
020B                          DS   CPM,APUT&0FFh   
020B                          DS   CPM,APUT/256   
020B   18 E8                  JR   ln2   
020D   2D           LN4:      DEC   L   ; Backspace: one back, and echo it,
020E   FA 0A 02               JP   M,ln3   ;   unless the line was empty (L left the
0211   2C                     INC   L   ;   upper half of the page)
0212   18 E1                  JR   ln2   
0214   77           LN5:      LD   (HL),A   ; the CR
0215   2E 80                  LD   L,LINEBUF & 0FFh   
0217                          ;*Macro unroll:  NEXT
0217   F7                     DS   (1-CPM)*(1-FAST),0F7h   
0218                          DS   CPM+FAST-CPM*FAST,0DDh   
0218                          DS   CPM+FAST-CPM*FAST,0E9h   
0218                             ; =============================================================================
0218                             ;  More routines (no handler starts past this point)
0218                             ; =============================================================================
0218                          IF   CHECKED   
                                 ; prstr: print the string at HL, to its closing quote, decoding "/" (this is
                                 ; "$", and the texts of the report). A NUL first is an error: Q.
                    PRSTR:    LD   A,(HL)   
                              INC   HL   
                              CP   22h   
                              RET   Z   
                              OR   A   
                              JP   Z,e_dollar   
                              CP   "/"   
                              JR   NZ,prs1   
                              LD   A,(HL)   
                              INC   HL   
                              CP   60h   
                              JR   C,prs0   
                              CP   7Fh   
                              JR   C,pesc   
                    PRS0:     AND   0BFh   
                              ;*Macro unroll: prs1:   PUTA
                    PRS1:     DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              JR   prstr   
                    PRLOOP:   EQU   prstr   ; (where the escapes go back to)
                    PRAGAIN:   EQU   hp1   ; (and where /~ goes back to)
                                 ; pmsg: print the text that follows the CALL, to its closing quote. Keeps HL.
                                 ; pnl: the same, on a new line.
                    PNL:      CALL   pmsg   ; (pmsg's own CR LF, then on into pmsg for
                              DB   13,10,22h   ;   the caller's text)
                    PMSG:     EX   (SP),HL   
                              CALL   prstr   
                              EX   (SP),HL   
                              RET      
0218                          ENDIF      
0218                             ; pesc: the escapes of "$". A = the character after the "/", 60h to 7Eh, and
0218                             ; HL points past it. Each goes back into the loop that prints the string
0218                             ; (PRLOOP), but /~ has the stack to see to, and goes back by PRAGAIN.
0218                             ;    /a-/z   print the variable, as "#" does
0218                             ;    /{      clear the screen, the cursor to the top left
0218                             ;    /}      clear from the cursor to the end of the line
0218                             ;    /|  /`  show the cursor, hide it
0218                             ;    /~      ( row col -- ) the cursor to that row and column, from 0
0218   FE 7E        PESC:     CP   7Eh   
021A   28 1C                  JR   Z,pat   
021C   11 AD 01               LD   DE,PRLOOP   ; the others return into the loop
021F   D5                     PUSH   DE   
0220   D6 7B                  SUB   7Bh   ; 00bbIDAsIHwgMSwg 2, and no borrow
0222   30 1D                  JR   NC,pcon   
0224   C6 1A                  ADD   A,1Ah   ; a-z: 0-25, and a carry; `: FFh, and none
0226   30 22                  JR   NC,phide   
0228   87                     ADD   A,A   ; the variable's cell
0229   C6 40                  ADD   A,40h   
022B   E5                     PUSH   HL   
022C   6F                     LD   L,A   
022D   26 82                  LD   H,LETPAGE   
022F   7E                     LD   A,(HL)   
0230   2C                     INC   L   
0231   66                     LD   H,(HL)   
0232   6F                     LD   L,A   
0233   CD EB 02               CALL   psgn   
0236   E1                     POP   HL   
0237   C9                     RET      
0238                             ; /~ ( row col addr -- ): the two cells under the string's address go. In
0238                             ; the checked build "$" is the routine prstr: its own return address goes
0238                             ; first, and hp1 calls it again afterwards. There each /~ first looks that
0238                             ; its two cells are there, and is s if not, before it prints anything.
0238                PAT:         
0238                          IF   CHECKED   
                              EX   (SP),HL   ; the text pointer over prstr's return address
                              LD   HL,(6-DSTOP)&0FFFFh   ; a carry: the two cells aren't there
                              ADD   HL,SP   
                              JP   C,e_under   
                              POP   HL   
0238                          ENDIF      
0238   D1                     POP   DE   ; DE = the column
0239   E3                     EX   (SP),HL   ; HL = the row; the text pointer is kept
023A                          IF   1-ANS   
023A   CD 15 FF               CALL   CONAT   
023D   E1                     POP   HL   
023E   C3 AD 01               JP   PRAGAIN   
0241                             ; With ANSI = 0 the machine's routines do the rest.
0241   CA 0C FF     PCON:     JP   Z,CONCLS   ; /{
0244   FE 02                  CP   2   
0246   CA 0F FF               JP   Z,CONEOL   ; /}
0249   FE                     DB   0FEh   ; /|  (CP n steps over the XOR: A = 1, show)
024A   AF           PHIDE:    XOR   A   ; /`  (A = 0: hide)
024B   C3 12 FF               JP   CONCUR   
024E                          ENDIF      
024E                          IF   ANS   
                              PUSH   DE   
                              CALL   csi   ; ESC [ row+1 ; col+1 H (ANSI counts from 1)
                              INC   HL   
                              CALL   pdec   
                              ;*Macro unroll:  PUTK    3Bh             ; ';'
                              DS   1-CPM,3Eh   ; ";"
                              DS   1-CPM,3Bh   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,3Bh   
                              POP   HL   
                              INC   HL   
                              CALL   pdec   
                              ;*Macro unroll:  PUTK    48h             ; 'H'
                              DS   1-CPM,3Eh   ; "H"
                              DS   1-CPM,48h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,48h   
                              POP   HL   
                              JP   PRAGAIN   
                                 ; With ANSI = 1 they are sequences. The carry is clear on the way in.
                    PSHOW:    LD   E,"h"   ; /|  ESC [ ? 2 5 h
                              DB   0DAh   ; (JP C,nn: with no carry it steps over two bytes)
                    PHIDE:    LD   E,"l"   ; /`  ESC [ ? 2 5 l
024E                          ENDIF      
024E                          IF   ANS*CHECKED   
                                 ; (The checked build prints the fixed parts with pmsg, which it has for the
                                 ; report: shorter than a character at a time.)
                              CALL   pmsg   
                              DB   27,"[?25",22h   
                    PSE:      LD   A,E   ; then E
                              ;*Macro unroll:  PUTAR
                              DS   1-CPM,0EFh   
                              DS   1-CPM,0C9h   
                              DS   CPM,0C3h   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                                 ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into cse.
                    PCON:     DEC   A   
                              JR   Z,pshow   ; /|
                              LD   E,"K"   
                              JP   P,cse   ; /}  ESC [ K
                              LD   E,"H"   ; /{  ESC [ H ESC [ J
                              CALL   cse   
                              LD   E,"J"   ; (on into cse)
                                 ; cse: ESC [ and then E. csi: ESC [. Both keep HL.
                    CSE:      CALL   csi   
                              JR   pse   
                    CSI:      CALL   pmsg   
                              DB   27,"[",22h   
                              RET      
024E                          ENDIF      
024E                          IF   ANS*(1-CHECKED)   
                              LD   A,"?"   
                              CALL   csia   
                              ;*Macro unroll:  PUTK    32h             ; '2'
                              DS   1-CPM,3Eh   ; "2"
                              DS   1-CPM,32h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,32h   
                              ;*Macro unroll:  PUTK    35h             ; '5'
                              DS   1-CPM,3Eh   ; "5"
                              DS   1-CPM,35h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,35h   
                              LD   A,E   
                              ;*Macro unroll:  PUTAR
                              DS   1-CPM,0EFh   
                              DS   1-CPM,0C9h   
                              DS   CPM,0C3h   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                                 ; pcon: /00bbIC98IC8=, with A = 0, 1, 2. /{ runs on into csia.
                    PCON:     DEC   A   
                              JR   Z,pshow   ; /|
                              LD   A,"K"   
                              JP   P,csia   ; /}  ESC [ K
                              LD   A,"H"   ; /{  ESC [ H ESC [ J
                              CALL   csia   
                              LD   A,"J"   ; (on into csia)
                                 ; csia: ESC [ and then A. csi: ESC [, keeping A.
                    CSIA:     CALL   csi   
                              ;*Macro unroll:  PUTAR
                              DS   1-CPM,0EFh   
                              DS   1-CPM,0C9h   
                              DS   CPM,0C3h   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                    CSI:      PUSH   AF   
                              ;*Macro unroll:  PUTK    1Bh             ; ESC
                              DS   1-CPM,3Eh   ; ESC
                              DS   1-CPM,1Bh   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,1Bh   
                              ;*Macro unroll:  PUTK    5Bh             ; '['
                              DS   1-CPM,3Eh   ; "["
                              DS   1-CPM,5Bh   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,5Bh   
                              POP   AF   
                              RET      
024E                          ENDIF      
024E                             ; udiv: unsigned HL / DE (DE <= 8000h). Returns HL = quotient, DE = remainder.
024E                             ; Uses A; keeps BC (the IP) itself. The dividend shifts up through A:C while
024E                             ; the quotient bits arrive at the bottom of C.
024E                             ; Dividing by 2 is one shift (the spec wants that fast).
024E                          IF   1-QK   
024E   7B           UDIV:     LD   A,E   
024F   EE 02                  XOR   2   
0251   B2                     OR   D   
0252   20 07                  JR   NZ,udv0   
0254   CB 3C                  SRL   H   
0256   CB 1D                  RR   L   ; the quotient
0258   8F                     ADC   A,A   
0259   5F                     LD   E,A   ; the remainder: the bit that fell out (D is 0)
025A   C9                     RET      
025B                          ENDIF      
025B                          IF   QK   
                                 ; (The builds with room divide by any power of two with shifts: 2, and 32,
                                 ; 64, 256 and the like, which fixed point and byte work use all the time.)
                    UDIV:     LD   A,D   
                              OR   A   
                              JR   NZ,uq1   ; 256 and up
                              OR   E   
                              JR   Z,udv0   ; by 0: the long way (it means nothing anyway)
                              DEC   A   
                              AND   E   
                              JR   NZ,udv0   ; not a power of two
                              LD   A,E   ; by 2^k below 256: q = HL >> k, and
                              DEC   A   ;   r = L & (2^k - 1)
                              AND   L   
                              PUSH   AF   
                    UQ2:      SRL   E   
                              JR   C,uq3   
                              SRL   H   
                              RR   L   
                              JR   uq2   
                    UQ3:      POP   AF   
                              LD   E,A   
                              LD   D,0   
                              RET      
                    UQ1:      LD   A,E   
                              OR   A   
                              JR   NZ,udv0   
                              LD   A,D   
                              DEC   A   
                              AND   D   
                              JR   NZ,udv0   ; not a power of two
                              LD   A,D   ; by 2^k, 256 and up: q = H >> (k - 8), and
                              DEC   A   ;   r = HL & (2^k - 1)
                              AND   H   
                              LD   E,A   ; (the remainder's high byte,
                              LD   A,L   ;   and its low byte)
                              LD   L,H   
                              LD   H,0   
                    UQ4:      SRL   D   
                              JR   C,uq5   
                              SRL   L   
                              JR   uq4   
                    UQ5:      LD   D,E   
                              LD   E,A   
                              RET      
025B                          ENDIF      
025B                          IF   1-FAST   
025B   C5           UDV0:     PUSH   BC   
025C   7C                     LD   A,H   
025D   4D                     LD   C,L   
025E   21 00 00               LD   HL,0   
0261   06 10                  LD   B,16   
0263   CB 21        UDV1:     SLA   C   
0265   17                     RLA      
0266   ED 6A                  ADC   HL,HL   
0268   ED 52                  SBC   HL,DE   ; carry is clear here: the remainder
026A   30 02                  JR   NC,udv2   ;   always fits in 16 bits
026C   19                     ADD   HL,DE   ; too much: put it back, and cancel the
026D   0D                     DEC   C   ;   INC below
026E   0C           UDV2:     INC   C   ; a quotient bit
026F   10 F2                  DJNZ   udv1   
0271   EB                     EX   DE,HL   ; DE = remainder
0272   67                     LD   H,A   
0273   69                     LD   L,C   ; HL = quotient
0274   C1                     POP   BC   
0275   C9                     RET      
0276                          ENDIF      
0276                          IF   FAST   
                                 ; (the fast build: the same 16 rounds, unrolled)
                    UDV0:     PUSH   BC   
                              LD   A,H   
                              LD   C,L   
                              LD   HL,0   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr0   
                              ADD   HL,DE   
                              DEC   C   
                    UVR0:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr1   
                              ADD   HL,DE   
                              DEC   C   
                    UVR1:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr2   
                              ADD   HL,DE   
                              DEC   C   
                    UVR2:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr3   
                              ADD   HL,DE   
                              DEC   C   
                    UVR3:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr4   
                              ADD   HL,DE   
                              DEC   C   
                    UVR4:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr5   
                              ADD   HL,DE   
                              DEC   C   
                    UVR5:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr6   
                              ADD   HL,DE   
                              DEC   C   
                    UVR6:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr7   
                              ADD   HL,DE   
                              DEC   C   
                    UVR7:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr8   
                              ADD   HL,DE   
                              DEC   C   
                    UVR8:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr9   
                              ADD   HL,DE   
                              DEC   C   
                    UVR9:     INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr10   
                              ADD   HL,DE   
                              DEC   C   
                    UVR10:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr11   
                              ADD   HL,DE   
                              DEC   C   
                    UVR11:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr12   
                              ADD   HL,DE   
                              DEC   C   
                    UVR12:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr13   
                              ADD   HL,DE   
                              DEC   C   
                    UVR13:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr14   
                              ADD   HL,DE   
                              DEC   C   
                    UVR14:    INC   C   
                              SLA   C   
                              RLA      
                              ADC   HL,HL   
                              SBC   HL,DE   
                              JR   NC,uvr15   
                              ADD   HL,DE   
                              DEC   C   
                    UVR15:    INC   C   
                              EX   DE,HL   ; DE = remainder
                              LD   H,A   
                              LD   L,C   ; HL = quotient
                              POP   BC   
                              RET      
0276                          ENDIF      
0276                             ; rdnum: read decimal digits at IP into HL; IP is left on the first
0276                             ; non-digit. Values wrap at 16 bits, as the spec says.
0276   21 00 00     RDNUM:    LD   HL,0   
0279   0A           RDN1:     LD   A,(BC)   
027A   D6 30                  SUB   "0"   
027C   FE 0A                  CP   10   
027E   D0                     RET   NC   
027F   03                     INC   BC   
0280   54                     LD   D,H   
0281   5D                     LD   E,L   
0282   29                     ADD   HL,HL   
0283   29                     ADD   HL,HL   
0284   19                     ADD   HL,DE   
0285   29                     ADD   HL,HL   ; HL * 10
0286   5F                     LD   E,A   
0287   16 00                  LD   D,0   
0289   19                     ADD   HL,DE   
028A   18 ED                  JR   rdn1   
028C                             ; skipstr: IP is inside a string; step past its closing quote. "/" escapes
028C                             ; the next character, so "/"" does not end it. Leaves A = 22h.
028C                          IF   1-CHECKED   
028C   03           SS0:      INC   BC   
028D   0A           SKIPSTR:   LD   A,(BC)   
028E   03                     INC   BC   
028F   FE 2F                  CP   "/"   
0291   28 F9                  JR   Z,ss0   
0293   FE 22                  CP   22h   
0295   20 F6                  JR   NZ,skipstr   
0297   C9                     RET      
0298                          ENDIF      
0298                          IF   CHECKED   
                                 ; The checked build never steps over a NUL: if the text runs out first it
                                 ; returns A = 0 with the IP on the NUL.
                    SKIPSTR:   LD   A,(BC)   
                              OR   A   
                              RET   Z   
                              INC   BC   
                              CP   22h   
                              RET   Z   
                              CP   "/"   
                              JR   NZ,skipstr   
                              LD   A,(BC)   ; the escaped character
                              OR   A   
                              RET   Z   
                              INC   BC   
                              JR   skipstr   
0298                          ENDIF      
0298                             ; skip: read past text to the closer at this level, and return A = 0 if it
0298                             ; was ")" and 2 if it was "]". Brackets of both kinds count together;
0298                             ; strings are stepped over whole. A NUL first ends the program (for "\" with
0298                             ; no closer; anything else that runs into the NUL had unbalanced brackets
0298                             ; anyway). D counts the open levels, starting at 1 for the one we are in:
0298                             ; skip sets it to 0 and falls through the INC that an opener comes back to.
0298                             ; 
0298                             ; The checked build also looks at the character the skip was started by,
0298                             ; which is always the one just before where it starts: "(" must end at ")",
0298                             ; "[" at "]", and neither may run into the NUL (N); a string with no closing
0298                             ; quote counts as running into it. "\" takes either closer. SKPL keeps the
0298                             ; place where the skip started, for the report.
0298                          IF   1-QK   
0298                             ; (Without base: no skip cache.)
0298                SKIP:        
0298                          ENDIF      
0298                          IF   CHECKED*(1-QK)   
                              LD   (SKPL),BC   
                              DEC   BC   
                              LD   A,(BC)   
                              INC   BC   
                              LD   E,A   ; E = the opener: ( [ or \
0298                          ENDIF      
0298                          IF   1-QK   
0298   16 00                  LD   D,0   
029A   14           SK3:      INC   D   ; an opener: one deeper
029B   0A           SK1:      LD   A,(BC)   
029C                          ENDIF      
029C                          IF   (1-CHECKED)*(1-QK)   
029C   03                     INC   BC   
029D   B7                     OR   A   
029E   CA 09 FF               JP   Z,SKEND   ; (the end of the program)
02A1                          ENDIF      
02A1                          IF   CHECKED*(1-QK)   
                              OR   A   
                              JR   Z,sk6   ; (the IP stays on the NUL)
                              INC   BC   
02A1                          ENDIF      
02A1                          IF   1-QK   
02A1   FE 22                  CP   22h   
02A3   CC 8D 02               CALL   Z,skipstr   ; leaves A = 22h, which matches nothing below
02A6   D6 28                  SUB   "("   ;   (or 0, and then the NUL is read next)
02A8   28 F0                  JR   Z,sk3   
02AA   3D                     DEC   A   ; ")"
02AB   28 08                  JR   Z,sk4   
02AD   D6 32                  SUB   "["-")"   
02AF   28 E9                  JR   Z,sk3   
02B1   FE 02                  CP   "]"-"["   
02B3   20 E6                  JR   NZ,sk1   
02B5   15           SK4:      DEC   D   
02B6                          ENDIF      
02B6                          IF   (1-CHECKED)*(1-QK)   
02B6   C8                     RET   Z   ; the closer at this level
02B7   18 E2                  JR   sk1   
02B9                          ENDIF      
02B9                          IF   CHECKED*(1-QK)   
                              JR   NZ,sk1   
                              LD   D,A   ; the closer at this level: 0 or 2. Bit 1 of the
                              XOR   E   ;   opener is 0 for "(" and 1 for "[", and only
                              AND   6   ;   "\" has bit 2: so this is 2 for the wrong
                              CP   2   ;   closer, and only then
                              LD   A,D   
                              RET   NZ   
                              JR   sk7   
                    SK6:      BIT   2,E   ; the text ran out:
                              JP   NZ,SKEND   ;   "\" with no closer ends the program
                    SK7:      LD   BC,(SKPL)   ; N. The place is the opener
                              LD   A,"N"   
                              JP   errp   ; (errp drops skip's return address)
02B9                          ENDIF      
02B9                          IF   QK   
                                 ; The skip cache. Nearly every skip is one that has happened before (a loop
                                 ; skips the same false block on every pass), so the first scan from each
                                 ; place is remembered: 64 entries of 00bbc3RhcnQsIGVuZA==, at CPAGE, found by the
                                 ; start's low byte. Only skips that start in the program text are kept (the
                                 ; line buffer changes); the cache is emptied whenever a run starts (skclr).
                                 ; A program that changes its own text while it runs is not looked after.
                    SKIP:     LD   (SKPL),BC   ; where it starts: the cache's key (and the
                              LD   A,B   ;   checked report's place)
                              CP   PROG/256   
                              JR   C,sks   ; below the program text: no cache
                              LD   A,C   
                              ADD   A,A   
                              ADD   A,A   
                              LD   E,A   
                              LD   D,CPAGE   ; DE -> the entry
                              LD   A,(DE)   
                              CP   C   
                              JR   NZ,sks   
                              INC   E   
                              LD   A,(DE)   
                              CP   B   
                              JR   NZ,sks   
                              INC   E   
                              LD   A,(DE)   
                              LD   C,A   
                              INC   E   
                              LD   A,(DE)   
                              LD   B,A   ; a hit: the IP is past the closer
                              DEC   BC   
                              LD   A,(BC)   
                              INC   BC   
                              SUB   ")"   ; 0 for ")", not 0 for "]"
                              RET      
                    SKS:         
02B9                          ENDIF      
02B9                          IF   QK*CHECKED   
                              DEC   BC   
                              LD   A,(BC)   
                              INC   BC   
                              LD   E,A   ; E = the opener: ( [ or \
02B9                          ENDIF      
02B9                          IF   QK   
                                 ; The scan. Most characters are nothing to it, and two range tests rule
                                 ; them out: * to Z, and ^ and up. Only NUL " ( ) [ ] count.
                              LD   D,0   
                    SQ3:      INC   D   ; an opener: one deeper
                    SQ1:      LD   A,(BC)   
                              INC   BC   
                              CP   5Eh   
                              JR   NC,sq1   ; ^ _ ` a-z 00bbIHwg ~ and up: nothing
                              CP   5Bh   
                              JR   NC,sqb   ; [ \ ]
                              CP   2Ah   
                              JR   NC,sq1   ; * to Z: nothing
                              CP   28h   
                              JR   Z,sq3   ; (
                              JR   NC,sqc   ; )
                              CP   22h   
                              JR   Z,sqq   ; a string
                              OR   A   
                              JR   NZ,sq1   ; the rest below "(": nothing
02B9                          ENDIF      
02B9                          IF   QK*(1-CHECKED)   
                              JP   SKEND   ; NUL: the end of the program
02B9                          ENDIF      
02B9                          IF   QK*CHECKED   
                              DEC   BC   ; NUL: the IP stays on it
                              BIT   2,E   ; the text ran out:
                              JP   NZ,SKEND   ;   "\" with no closer ends the program
                    SQ7:      LD   BC,(SKPL)   ; N. The place is the opener
                              LD   A,"N"   
                              JP   errp   ; (errp drops skip's return address)
02B9                          ENDIF      
02B9                          IF   QK   
                    SQQ:      CALL   skipstr   ; step over the string
                              JR   sq1   
                    SQB:      SUB   5Ch   ; [ -1, \ 0, ] 1
                              JR   Z,sq1   ; "\" is nothing here
                              JR   C,sq3   ; [
                              LD   A,2   ; ]
                              JR   sq4   
                    SQC:      XOR   A   ; )
                    SQ4:      DEC   D   
                              JR   NZ,sq1   
02B9                          ENDIF      
02B9                          IF   QK*CHECKED   
                              LD   D,A   ; the closer at this level (as above): 2 here
                              XOR   E   ;   means the wrong closer
                              AND   6   
                              CP   2   
                              LD   A,D   
                              JR   Z,sq7   
02B9                          ENDIF      
02B9                          IF   QK   
                                 ; The closer at this level: remember the skip (if it started in the program
                                 ; text), and return A = 0 for ")" or 2 for "]".
                              PUSH   AF   
                              PUSH   HL   
                              LD   HL,(SKPL)   
                              LD   A,H   
                              CP   PROG/256   
                              JR   C,sq9   
                              LD   A,L   
                              ADD   A,A   
                              ADD   A,A   
                              LD   E,A   
                              LD   D,CPAGE   
                              LD   A,L   
                              LD   (DE),A   
                              INC   E   
                              LD   A,H   
                              LD   (DE),A   
                              INC   E   
                              LD   A,C   
                              LD   (DE),A   
                              INC   E   
                              LD   A,B   
                              LD   (DE),A   
                    SQ9:      POP   HL   
                              POP   AF   
                              RET      
                                 ; skclr: empty the skip cache (a start of 0000h matches no skip). Keeps HL.
                    SKCLR:    PUSH   HL   
                              LD   HL,CPAGE*256   
                    SKC1:     LD   (HL),0   
                              INC   L   
                              JR   NZ,skc1   
                              POP   HL   
                              RET      
02B9                          ENDIF      
02B9                             ;  ---- Speed-ups (base builds) -------------------------------------------
02B9                             ;  The skip cache is above. These are the handlers' tails that the builds with
02B9                             ;  room take, kept here, out of the handlers' first two pages.
02B9                          IF   QK   
                                 ; "*" with an operand below 256 takes 8 rounds, not 16: that one becomes the
                                 ; multiplier (most multiplications have one, a count or a small constant).
                    MULQ:     LD   A,H   
                              OR   A   
                              JR   Z,mq8   ; the multiplier is below 256
                              LD   A,D   
                              OR   A   
                              JR   NZ,mq16   
                              EX   DE,HL   ; the multiplicand is: it becomes the multiplier
02B9                          ENDIF      
02B9                          IF   QK*(1-FAST)   
                    MQ8:      LD   A,L   
                              LD   HL,0   
                              PUSH   BC   
                              LD   B,8   
                    MQ1:      ADD   HL,HL   
                              RLA      
                              JR   NC,mq2   
                              ADD   HL,DE   
                    MQ2:      DJNZ   mq1   
                              POP   BC   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
                    MQ16:     PUSH   BC   ; 16 rounds; the multiplier shifts up through A:C
                              LD   A,H   
                              LD   C,L   
                              LD   HL,0   
                              LD   B,16   
                    MQ3:      ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mq4   
                              ADD   HL,DE   
                    MQ4:      DJNZ   mq3   
                              POP   BC   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
02B9                          ENDIF      
02B9                          IF   FAST   
                                 ; (the fast build: the same rounds, unrolled)
                    MQ8:      LD   A,L   
                              LD   HL,0   
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur0   
                              ADD   HL,DE   
                    MUR0:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur1   
                              ADD   HL,DE   
                    MUR1:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur2   
                              ADD   HL,DE   
                    MUR2:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur3   
                              ADD   HL,DE   
                    MUR3:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur4   
                              ADD   HL,DE   
                    MUR4:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur5   
                              ADD   HL,DE   
                    MUR5:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur6   
                              ADD   HL,DE   
                    MUR6:        
                              ADD   HL,HL   
                              RLA      
                              JR   NC,mur7   
                              ADD   HL,DE   
                    MUR7:        
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
                    MQ16:     PUSH   BC   
                              LD   A,H   
                              LD   C,L   
                              LD   HL,0   
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus0   
                              ADD   HL,DE   
                    MUS0:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus1   
                              ADD   HL,DE   
                    MUS1:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus2   
                              ADD   HL,DE   
                    MUS2:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus3   
                              ADD   HL,DE   
                    MUS3:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus4   
                              ADD   HL,DE   
                    MUS4:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus5   
                              ADD   HL,DE   
                    MUS5:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus6   
                              ADD   HL,DE   
                    MUS6:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus7   
                              ADD   HL,DE   
                    MUS7:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus8   
                              ADD   HL,DE   
                    MUS8:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus9   
                              ADD   HL,DE   
                    MUS9:        
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus10   
                              ADD   HL,DE   
                    MUS10:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus11   
                              ADD   HL,DE   
                    MUS11:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus12   
                              ADD   HL,DE   
                    MUS12:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus13   
                              ADD   HL,DE   
                    MUS13:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus14   
                              ADD   HL,DE   
                    MUS14:       
                              ADD   HL,HL   
                              SLA   C   
                              RLA      
                              JR   NC,mus15   
                              ADD   HL,DE   
                    MUS15:       
                              POP   BC   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
02B9                          ENDIF      
02B9                          IF   QK   
                                 ; A true ")" reads the block start where it is, on top of the return stack,
                                 ; instead of popping it and pushing it back; the break key is looked at as
                                 ; rpushn would.
                    CLOSEQ:   LD   C,(IY+0)   
                              LD   B,(IY+1)   
                              PUSH   HL   
                              LD   HL,PCNT   
                              DEC   (HL)   
                              POP   HL   
                              CALL   Z,pollk   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
02B9                          ENDIF      
02B9                          IF   SBASEU   
                                 ; a-z, in the unchecked builds: a variable followed by "@" or "!" is fetched
                                 ; or stored in the same step (x@ is the commonest pair in most programs).
                                 ; (A checked build checks the stacks between the two, so it keeps them apart.)
                    LOWQ:     ADD   A,A   
                              LD   E,A   
                              LD   D,LETPAGE   ; DE -> the cell
                              LD   A,(BC)   
                              CP   "@"   
                              JR   Z,lwf   
                              CP   "!"   
                              JR   Z,lws   
                              PUSH   HL   
                              EX   DE,HL   ; TOS = the cell's address
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
                    LWF:      INC   BC   ; x@: TOS = the cell's value
                              PUSH   HL   
                              EX   DE,HL   
                              LD   E,(HL)   
                              INC   L   
                              LD   D,(HL)   
                              EX   DE,HL   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
                    LWS:      INC   BC   ; x!: the cell = TOS, and NOS comes up
                              EX   DE,HL   
                              LD   (HL),E   
                              INC   L   
                              LD   (HL),D   
                              POP   HL   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
02B9                          ENDIF      
02B9                          IF   (1-CPM)*(1-EDITOR)*(1-CHECKED)*QK   
                    QSTART:   LD   BC,PROG   ; the generic reset goes on here: the IP,
                              CALL   skclr   ;   an empty skip cache, and the rest of the
                              JP   st0   ;   startup
02B9                          ENDIF      
02B9                          IF   (1-CPM)*(1-EDITOR)*CHECKED*QK   
                    QINIT:    CALL   skclr   ; (keeps A, which init wants 0)
                              JP   init   
02B9                          ENDIF      
02B9                             ; =============================================================================
02B9                             ;  Dispatch table: the low byte of each handler's address, in code order
02B9                             ;  (the table itself is the macro PTABLE, defined above the dispatcher).
02B9                             ;  It must not cross a page (the dispatcher only adds to its low byte).
02B9                             ; =============================================================================
02B9                             ; The handlers of the first NPG1 characters start in the image's second page.
02B9                             ; ] \ [ @ sit where the two pages meet, and which side each lands on
02B9                             ; differs between the builds, so the count is worked out here.
02B9                             ; (One division to a line: asm80 only rounds down when it stores a value.)
02B9                PGRET:    EQU   (h_ret-BASE)/256   ; 0 = first page, 1 = second
02B9                PGBRK:    EQU   (h_break-BASE)/256   
02B9                PGDEF:    EQU   (h_def-BASE)/256   
02B9                PGFET:    EQU   (h_fetch-BASE)/256   
02B9                NPG1:     EQU   21 + PGFET + PGDEF + PGBRK + PGRET   
02B9                          IF   (1-TABP0)*(1-PTLATE)   
02B9                PTAB:        
02B9                          ;*Macro unroll:  PTABLE
02B9   A1                     DB   h_store & 0FFh   
02BA   A6                     DB   h_str & 0FFh   
02BB   C9                     DB   h_num & 0FFh   
02BC   AD                     DB   h_print & 0FFh   
02BD   9C                     DB   h_swap & 0FFh   
02BE   46                     DB   h_and & 0FFh   
02BF   C6                     DB   h_emit & 0FFh   
02C0   22                     DB   h_open & 0FFh   
02C1   2A                     DB   h_close & 0FFh   
02C2   67                     DB   h_mul & 0FFh   
02C3   3D                     DB   h_add & 0FFh   
02C4   E5                     DB   h_cfetch & 0FFh   
02C5   35                     DB   h_sub & 0FFh   
02C6   9E                     DB   h_cstore & 0FFh   
02C7   7B                     DB   h_div & 0FFh   
02C8   9A                     DB   h_dup & 0FFh   
02C9   A0                     DB   h_drop & 0FFh   
02CA   4E                     DB   h_lt & 0FFh   
02CB   5D                     DB   h_eq & 0FFh   
02CC   4F                     DB   h_gt & 0FFh   
02CD   CD                     DB   h_key & 0FFh   
02CE   1D                     DB   h_fetch & 0FFh   
02CF   00                     DB   h_def & 0FFh   
02D0   F3                     DB   h_break & 0FFh   
02D1   EF                     DB   h_ret & 0FFh   
02D2   80                     DB   h_xor & 0FFh   
02D3   93                     DB   h_alloc & 0FFh   
02D4   D9                     DB   h_grave & 0FFh   
02D5   D5                     DB   h_tor & 0FFh   
02D6   88                     DB   h_or & 0FFh   
02D7   1C                     DB   h_fromr & 0FFh   
02D8   90                     DB   h_not & 0FFh   
02D9                PTABEND:      
02D9                          ENDIF      
02D9                             ; hexc: if the character at IP is a hex digit (0-9, A-F, a-f), step over it
02D9                             ; and return its value in A with the carry set; otherwise leave the IP and
02D9                             ; return with the carry clear.
02D9   0A           HEXC:     LD   A,(BC)   
02DA   D6 30                  SUB   "0"   
02DC   FE 0A                  CP   10   
02DE   38 09                  JR   C,hc1   
02E0   E6 DF                  AND   0DFh   
02E2   D6 11                  SUB   11h   
02E4   FE 06                  CP   6   
02E6   D0                     RET   NC   
02E7   D6 F6                  SUB   0F6h   ; + 10, and sets the carry
02E9   03           HC1:      INC   BC   
02EA   C9                     RET      
02EB                             ; psgn: print HL as a signed number. Keeps BC.
02EB   CB 7C        PSGN:     BIT   7,H   
02ED   28 04                  JR   Z,pdec   
02EF                          ;*Macro unroll:  PUTK    2Dh             ; '-'
02EF   3E                     DS   1-CPM,3Eh   ; "-"
02F0   2D                     DS   1-CPM,2Dh   
02F1   EF                     DS   1-CPM,0EFh   
02F2                          DS   CPM,0CDh   
02F2                          DS   CPM,APTK&0FFh   
02F2                          DS   CPM,APTK/256   
02F2                          DS   CPM,2Dh   
02F2                          ;*Macro unroll:  NEGH
02F2   E7                     DS   1-CPM,0E7h   
02F3                          DS   CPM,0CDh   
02F3                          DS   CPM,ANEG&0FFh   
02F3                          DS   CPM,ANEG/256   
02F3                             ; pdec: print HL unsigned, by recursion on HL / 10 (the stack holds digits).
02F3                             ; Keeps BC.
02F3   11 0A 00     PDEC:     LD   DE,10   
02F6   CD 4E 02               CALL   udiv   ; HL = HL / 10, E = the last digit
02F9   7B                     LD   A,E   
02FA   F5                     PUSH   AF   
02FB   7C                     LD   A,H   
02FC   B5                     OR   L   
02FD   C4 F3 02               CALL   NZ,pdec   
0300   F1                     POP   AF   
0301   C6 30                  ADD   A,"0"   
0303                          ;*Macro unroll:  PUTAR
0303   EF                     DS   1-CPM,0EFh   
0304   C9                     DS   1-CPM,0C9h   
0305                          DS   CPM,0C3h   
0305                          DS   CPM,APUT&0FFh   
0305                          DS   CPM,APUT/256   
0305                             ; (The table goes here instead in the builds where, before psgn, it would
0305                             ; cross a page: PTLATE. If it would cross one here too, it starts on the next
0305                             ; page: PTPAD is 0 unless it must.)
0305                          IF   (1-TABP0)*PTLATE   
                    PTPH:     EQU   $ & 0FFh   
                    PTPX:     EQU   (PTPH + 31) / 256   
                    PTPAD:    EQU   PTPX * (256 - PTPH)   
                              DS   PTPAD   
                    PTAB:        
                              ;*Macro unroll:  PTABLE
                              DB   h_store & 0FFh   
                              DB   h_str & 0FFh   
                              DB   h_num & 0FFh   
                              DB   h_print & 0FFh   
                              DB   h_swap & 0FFh   
                              DB   h_and & 0FFh   
                              DB   h_emit & 0FFh   
                              DB   h_open & 0FFh   
                              DB   h_close & 0FFh   
                              DB   h_mul & 0FFh   
                              DB   h_add & 0FFh   
                              DB   h_cfetch & 0FFh   
                              DB   h_sub & 0FFh   
                              DB   h_cstore & 0FFh   
                              DB   h_div & 0FFh   
                              DB   h_dup & 0FFh   
                              DB   h_drop & 0FFh   
                              DB   h_lt & 0FFh   
                              DB   h_eq & 0FFh   
                              DB   h_gt & 0FFh   
                              DB   h_key & 0FFh   
                              DB   h_fetch & 0FFh   
                              DB   h_def & 0FFh   
                              DB   h_break & 0FFh   
                              DB   h_ret & 0FFh   
                              DB   h_xor & 0FFh   
                              DB   h_alloc & 0FFh   
                              DB   h_grave & 0FFh   
                              DB   h_tor & 0FFh   
                              DB   h_or & 0FFh   
                              DB   h_fromr & 0FFh   
                              DB   h_not & 0FFh   
                    PTABEND:      
0305                          ENDIF      
0305                             ; =============================================================================
0305                             ;  Console layer. rawk is the host's key routine: a waiting key in A (zero
0305                             ;  flag clear), or A = 0 with the zero flag set when none is waiting. putc
0305                             ;  (RST 28h) prints A. Both keep BC, DE, HL and IY. In the generic build
0305                             ;  they are the host's KEY and CONOUT routines themselves.
0305                             ; 
0305                             ;  A running program reads the keyboard only through getk and pollk, which
0305                             ;  between them give the break key its rules:
0305                             ;    - Ctrl-C stops the program;
0305                             ;    - any other key that the break check reads is held in KEYBUF for the
0305                             ;      next "?", and a newer one takes its place;
0305                             ;    - "?" (getk) takes the held key first;
0305                             ;    - a program that has stored a non-zero byte at BRKOFF gets Ctrl-C as a
0305                             ;      key like any other, but two of them within about 250 ms still stop it.
0305                             ;  Both are called straight from a handler, never from a routine under one:
0305                             ;  the checked build's report counts on finding one return address above the
0305                             ;  data stack.
0305                             ; =============================================================================
0305                          IFN   CPM   
0305                RAWK:     EQU   KEY   
0305                          ENDIF      
0305                             ; pollk: the break check (see rpushn).
0305   CD 06 FF     POLLK:    CALL   rawk   
0308   C8                     RET   Z   ; no key
0309   32 7A 82               LD   (KEYBUF),A   ; held for the next "?"
030C   FE 03        PK1:      CP   3   ; (getk joins here)
030E   C0                     RET   NZ   
030F                             ; ctlc: Ctrl-C has been read. If the break key is on, that is the end. If
030F                             ; the program has turned it off, wait about 250 ms for one more key: a
030F                             ; second Ctrl-C is the end too; any other key is held (the newest wins),
030F                             ; and the Ctrl-C goes to the program: returns A = 3, zero flag clear.
030F   3A 7B 82     CTLC:     LD   A,(BRKOFF)   
0312   B7                     OR   A   
0313   CA 14 00     CT0:      JP   Z,brk   
0316   D5                     PUSH   DE   
0317   11 10 27               LD   DE,250*MSLOOP   
031A   CD 06 FF     CT1:      CALL   rawk   
031D   20 05                  JR   NZ,ct2   
031F   1B                     DEC   DE   
0320   7A                     LD   A,D   
0321   B3                     OR   E   
0322   20 F6                  JR   NZ,ct1   
0324   D1           CT2:      POP   DE   ; A = the second key, or 0 if none came
0325   FE 03                  CP   3   
0327   28 EA                  JR   Z,ct0   ; (the zero flag takes the JP there)
0329   B7                     OR   A   
032A   28 03                  JR   Z,ct3   
032C   32 7A 82               LD   (KEYBUF),A   
032F   3E 03        CT3:      LD   A,3   
0331   B7                     OR   A   
0332   C9                     RET      
0333                             ; getk: a key for "?", or A = 0 and the zero flag if there is none.
0333   E5           GETK:     PUSH   HL   ; a held key goes first, and is taken out of
0334   21 7A 82               LD   HL,KEYBUF   ;   the buffer
0337   7E                     LD   A,(HL)   
0338   36 00                  LD   (HL),0   
033A   E1                     POP   HL   
033B   B7                     OR   A   
033C   C0                     RET   NZ   
033D   CD 06 FF               CALL   rawk   
0340   C8                     RET   Z   
0341   18 C9                  JR   pk1   ; Ctrl-C? If not, that is the key
0343                          IF   (1-CHECKED)*(1-EDITOR)   
0343                BRK:      EQU   endprog   ; the unchecked build stops without a word
0343                          ENDIF      ;   (with the editor, both stacks are cleared);
0343                          IF   (1-CHECKED)*EDITOR   
                    BRK:      EQU   edit0   
0343                          ENDIF      
0343                          IF   CHECKED   
                    BRK:      EQU   e_break   ;   the checked build reports B
0343                          ENDIF      
0343                          IF   CPM   
                                 ; The routines a generic build keeps in page zero (see there). Here they are
                                 ; out of the way of the handlers, which must fit in the image's first two
                                 ; pages.
                    RPOP:     LD   E,(IY+0)   ; pop the return stack into DE
                              LD   D,(IY+1)   
                              INC   IY   
                              INC   IY   
                              RET      
                    NEG16:    XOR   A   ; HL = -HL (keeps BC, DE)
                              SUB   L   
                              LD   L,A   
                              SBC   A,A   
                              SUB   H   
                              LD   H,A   
                              RET      
0343                          ENDIF      
0343                          IF   CPM*CHECKED   ; (the checked builds need the room)
                    EXEC:     LD   (RSAVE),IY   ; machine code may change IX and IY
                              CALL   jphl   
                              LD   IY,(RSAVE)   
                              ;*Macro unroll:  SETIX
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,21h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
                              POP   HL   
                              ;*Macro unroll:  NEXT
                              DS   (1-CPM)*(1-FAST),0F7h   
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
0343                          ENDIF      
0343                          IF   CPM   
                    RAWK:     LD   A,0FFh   ; BDOS 6 with E = FFh: a key, or 0
                              JR   putc   
                    PUTK:     EX   (SP),HL   ; print the byte after the CALL
                              LD   A,(HL)   
                              INC   HL   
                              EX   (SP),HL   
                                 ; putc: BDOS 6 for every character. BDOS 2 would check for ^S while
                                 ; printing and could swallow a key that BDOS 6 then never sees.
                                 ; It keeps every register but A and the flags: BDOS may change any of them
                                 ; (IX and IY too, in a Z80 BDOS or BIOS).
                    PUTC:     PUSH   BC   
                              PUSH   DE   
                              PUSH   HL   
                              PUSH   IX   
                              PUSH   IY   
                              LD   E,A   
                              LD   C,6   
                              CALL   BDOS   
                              POP   IY   
                              POP   IX   
                              POP   HL   
                              POP   DE   
                              POP   BC   
                              OR   A   ; (for getk)
                              RET      
0343                          ENDIF      
0343                             ; =============================================================================
0343                             ;  Checked build: the checks and the error report
0343                             ; =============================================================================
0343                          IF   CHECKED   
                                 ; chkstk: both stacks are checked once per character, not in every handler.
                                 ; The data stack is right when SP lies in the 256 bytes below DSTOP: adding
                                 ; the constant carries if it is above (cells were popped that were never
                                 ; pushed), and leaves a high byte of FFh if it is in range. Errors are found
                                 ; a character late at most: the bytes above DSTOP and the guard band below
                                 ; the page take what happens meanwhile. DE is free between characters.
                    CHKSTK:   EX   DE,HL   
                              LD   HL,(1-DSTOP)&0FFFFh   ; (SP is 2 lower here: the call)
                              ADD   HL,SP   
                              EX   DE,HL   
                              JR   C,e_under   
                              INC   D   
                              JR   NZ,e_over   
                              PUSH   IY   ; the return stack: in its page (or it has
                              POP   DE   ;   overflowed), and not above its empty
                              LD   A,D   ;   position (an underflow stays inside the
                              CP   RSPAGE   ;   page, in the guard band)
                              LD   A,E   
                              JR   NZ,e_rover   
                              CP   RSTOP&0FFh+1   
                              RET   C   
                              LD   IY,RSTOP   ; return stack underflow: it counts as empty
                              LD   A,"r"   
                              JR   errp   
                    E_ROVER:   LD   A,"R"   ; return stack overflow
                              DB   11h   ; (LD DE,nn hides the next entry)
                    E_OVER:   LD   A,"S"   ; data stack overflow
                              JR   errp   
                    E_UNDER:   LD   SP,DSTOP   ; data stack underflow: it counts as empty
                              LD   A,"s"   
                              JR   error   
                                 ; e_hi: the inner loop read a reserved byte, 80h-FFh: X. But a word cell that
                                 ; was never defined still holds 0000h, and the byte there is a reserved one
                                 ; in every build (AFh or C3h): if the IP is in page zero, this was a call of
                                 ; an undefined word. The call is undone, so the place is the call itself.
                    E_HI:     INC   B   
                              DJNZ   e_resv   ; (B is as it was, and is not 0)
                              ;*Macro unroll:  POPR
                              DS   1-CPM,0CFh   
                              DS   CPM,0CDh   
                              DS   CPM,AROP&0FFh   
                              DS   CPM,AROP/256   
                              LD   B,D   
                              LD   C,E   
                              LD   A,"U"   
                              JR   error   
                                 ; chkhp: HL = the new heap top, DE = the old one, the carry is from adding
                                 ; the count. Stop if the top is not below the limit page, or is below the
                                 ; program's end.
                    CHKHP:       
0343                          ENDIF      
0343                          IF   CHECKED*CPM   
                                 ; With this much room a top that wrapped round can land back in
                                 ; range, so the add is tested too: growing (A, the count's high
                                 ; byte, is positive) must not carry, and releasing must.
                              RRA      ; the carry comes in above the sign:
                              ADD   A,40h   ;   bit 7 = carry XOR sign
                              ADD   A,A   
                              JR   C,e_heap   
                              LD   A,(0007h)   
                              DEC   A   
                              CP   H   
                              JR   C,e_heap   
0343                          ENDIF      
0343                          IF   CHECKED*(1-CPM)   
                                 ; (Here the program's space is under 32K, so a top that wrapped
                                 ; round always falls outside it.)
                              LD   A,H   
                              CP   HEAPLIM   
                              JR   NC,e_heap   
0343                          ENDIF      
0343                          IF   CHECKED   
                              PUSH   DE   
                              EX   DE,HL   
                              LD   HL,(NPEND)   
                              ADD   HL,DE   ; carry: at or above the program's end
                              EX   DE,HL   
                              POP   DE   
                              RET   C   
                    E_HEAP:   OR   A   ; put the count back in TOS for the report
                              SBC   HL,DE   
                              LD   A,"H"   
                              JR   errp   
                                 ; chkst: stop unless HL is in the program's own space: from the letter page
                                 ; up to the heap limit (the OS, or HEAPLIM), so the interpreter's stacks and
                                 ; whatever lies above the limit are safe. Memory above the heap top but
                                 ; below the limit is the program's own: Tiny BASIC keeps its lines there.
                                 ; It is the page of HL + 1 that is tested, so that one test serves both
                                 ; bytes of a cell: the last byte below the limit can"t be stored to with ".'.
                                 ; Keeps HL and BC. It runs on into its own error entry.
                    CHKST:    INC   HL   
                              LD   A,H   
                              DEC   HL   
                              CP   LETPAGE   
                              JR   C,e_store   
0343                          ENDIF      
0343                          IF   CHECKED*(1-CPM)   
                              CP   HEAPLIM   
                              RET   C   
0343                          ENDIF      
0343                          IF   CHECKED*CPM   
                              LD   E,A   
                              LD   A,(0007h)   ; the BDOS page is the heap limit
                              DEC   A   
                              CP   E   
                              RET   NC   
0343                          ENDIF      
0343                          IF   CHECKED   
                                 ; Error entries. Each loads its letter and then hides the next entry inside
                                 ; a 3-byte LD DE,nn (the 11h), so they all fall through to `error`.
                    E_STORE:   LD   A,"O"   ; a store outside the program's space
                              DB   11h   
                    E_BREAK:   LD   A,"B"   ; Ctrl-C (found inside pollk or getk)
                                 ; errp: an error found inside a routine: drop its return address first.
                    ERRP:     POP   DE   
                              JR   error   
                                 ; e_dollar: "$" ran into a NUL (in prstr): Q, with the string's address
                                 ; back in TOS. prstr"s return address goes first. But if "$' had no
                                 ; address at all (the stack was empty), it is s, found now: chkstk, called
                                 ; one cell up, sees the stack past its empty place then.
                    E_DOLLAR:   POP   DE   
                              POP   HL   
                              CALL   chkstk   
                              PUSH   HL   
                              LD   HL,(RSAVE)   
                              DB   11h   ; (LD DE,nn hides e_quote's first two bytes)
                    E_QUOTE:   LD   B,H   ; an unclosed string: HL is its address, one
                              LD   C,L   ;   past the opening quote, which is the place
                              LD   A,"Q"   
                              DB   11h   
                    E_RESV:   LD   A,"X"   ; a reserved byte outside a string
                              DB   11h   
                    E_ZERO:   LD   A,"Z"   ; dividing by zero
                              DB   11h   
                    E_BRACK:   LD   A,"W"   ; bad character after [
                                 ; error: the report, then the end. A = the letter, BC = one past the place,
                                 ; HL = TOS, and both stacks as the report is to show them:
                                 ; 
                                 ;   Err X @ line,col
                                 ;   D:n: the top 8 cells at most, bottom to top
                                 ;   R:n
                    ERROR:    PUSH   HL   ; now the whole data stack is in memory
                              LD   E,A   
                              CALL   pnl   
                              DB   "Err ",22h   
                              LD   A,E   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              CALL   pmsg   
                              DB   " @ ",22h   
                              DEC   BC   ; BC = the place
                                 ; The line and column. A place below the program is in the line
                                 ; buffer: line 0. Otherwise count the LFs from the program's start;
                                 ; DE = the line's number, HL = where it starts.
                              LD   HL,LINEBUF   
                              LD   DE,0   
                              LD   A,B   
                              CP   PROG/256   
                              JR   C,er3   
                              INC   H   
                              LD   L,E   ; HL = PROG
                    ER1:      INC   DE   ; a new line starts at HL
                              PUSH   HL   
                    ER2:      LD   A,L   
                              SUB   C   
                              LD   A,H   
                              SBC   A,B   
                              JR   NC,er2x   ; reached the place
                              LD   A,(HL)   
                              INC   HL   
                              CP   10   
                              JR   NZ,er2   
                              POP   AF   
                              JR   er1   
                    ER2X:     POP   HL   
                    ER3:      PUSH   BC   
                              PUSH   HL   
                              EX   DE,HL   
                              CALL   pdec   ; the line
                              ;*Macro unroll:  PUTK    2Ch             ; ','
                              DS   1-CPM,3Eh   ; ","
                              DS   1-CPM,2Ch   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,2Ch   
                              POP   DE   
                              POP   HL   
                              OR   A   
                              SBC   HL,DE   
                              INC   HL   
                              CALL   pdec   ; the column
                                 ; The two stack lines:  D:n: the top 8 cells at most, bottom to top
                                 ;                       R:n
                                 ; TOS is in memory with the rest (pushed) by now.
                              CALL   pnl   
                              DB   "D:",22h   
                              LD   HL,DSTOP-2   ; (DSTOP-2) - SP is twice the depth (the cell
                              SBC   HL,SP   ;   at DSTOP-2 was pushed with the first value
                                 ;   and holds nothing; pnl left the carry clear)
                              CALL   phalf   ; the depth
                              ;*Macro unroll:  PUTK    3Ah             ; ':'
                              DS   1-CPM,3Eh   ; ":"
                              DS   1-CPM,3Ah   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,3Ah   
                              LD   A,C   
                              CP   9   
                              JR   C,er6   
                              CALL   pmsg   
                              DB   " ...",22h   
                              LD   C,8   
                    ER6:      LD   H,0   ; C = the number of cells to show
                              LD   L,C   
                              ADD   HL,HL   
                              ADD   HL,SP   ; HL -> just above the deepest of them
                              INC   C   
                    ER7:      DEC   C   
                              JR   Z,er8   
                              DEC   HL   
                              LD   D,(HL)   
                              DEC   HL   
                              LD   E,(HL)   
                              PUSH   HL   
                              ;*Macro unroll:  PUTK    20h             ; ' '
                              DS   1-CPM,3Eh   ; " "
                              DS   1-CPM,20h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,20h   
                              EX   DE,HL   
                              CALL   psgn   
                              POP   HL   
                              JR   er7   
                    ER8:      CALL   pnl   
                              DB   "R:",22h   
                              PUSH   IY   ; RSTOP - IY is under 256 (the pointer is
                              POP   HL   ;   at most one entry below its page), so
                              LD   A,RSTOP&0FFh   ;   the low bytes are enough
                              SUB   L   
                              LD   L,A   
                              LD   H,0   
                              CALL   phalf   
                              CALL   pnl   
                              DB   22h   
0343                          ENDIF      
0343                          IF   CHECKED*(1-EDITOR)   
                              JP   endprog   
0343                          ENDIF      
0343                          IF   CHECKED*EDITOR   
                              JR   edit0   ; back to the editor, with both stacks cleared
0343                          ENDIF      
0343                          IF   CHECKED   
                                 ; phalf: print half of HL, and leave it in C.
                    PHALF:    SRL   H   
                              RR   L   
                              PUSH   HL   
                              CALL   pdec   
                              POP   BC   
                              RET      
0343                          ENDIF      
0343                             ; =============================================================================
0343                             ;  The line editor (EDITOR = 1)
0343                             ; 
0343                             ;  The interpreter starts here, and a program that ends comes back here.
0343                             ;  There is no prompt. It follows the spec's suggested standard for a line
0343                             ;  editor (docs/b8script.md, Environments). Type a line and press Return:
0343                             ; 
0343                             ;    n text    put the text in as line n; the lines from n on move down. A
0343                             ;              number past the end (or 0) adds the line at the end.
0343                             ;    n         take line n out
0343                             ;    anything else is run at once, as B8Script. (Start such a line with a
0343                             ;    space if it would begin with a digit.)
0343                             ; 
0343                             ;  A command key ends the line too, and takes what was typed as its argument:
0343                             ; 
0343                             ;    ^G        run the program
0343                             ;    n ^L      list from line n (no number: all of it). Any key holds the
0343                             ;              list until another key is pressed; Ctrl-C ends it.
0343                             ;    n ^E      put line n in the input line; Return puts it back, changed
0343                             ;    name ^R   read. CP/M: the file of that name (no name: the same file as
0343                             ;              last time). Generic: what is typed, or pasted, from now until
0343                             ;              ^Z replaces the program; it is not echoed.
0343                             ;    name ^W   write. CP/M: to that file (no name: the same file as last
0343                             ;              time). Generic: the text is printed, as it is.
0343                             ;    ^N        new: no program
0343                             ;    ^X        leave (to LEAVE)
0343                             ; 
0343                             ;  In the line: the left and right arrow keys move the cursor;
0343                             ;  a character goes in at the cursor; Backspace and DEL take out the one
0343                             ;  before it; Esc drops the line. Only CR, LF, BS and printing characters are
0343                             ;  sent to the terminal, so any terminal will do.
0343                             ; 
0343                             ;  Lines are counted, not numbered: the text holds no line numbers, and the
0343                             ;  list shows each line's place. There can be 65535 lines. A typed line holds
0343                             ;  125 characters; the one character after a line number separates it from
0343                             ;  the text and is not stored. The text is kept as it is typed, each line
0343                             ;  ending in CR LF, at PROG.
0343                             ; 
0343                             ;  What lasts from one line to the next: the program, the words, the
0343                             ;  variables and the data stack. An error or a break clears both stacks. The
0343                             ;  return stack starts empty for every line.
0343                             ; 
0343                             ;  Things to know:
0343                             ;    - Reset empties the program (generic builds).
0343                             ;    - A word's address points into the program, so run the program again
0343                             ;      after editing it.
0343                             ;    - Nothing is printed between a program's output and what is typed next.
0343                             ;    - A line run at once sits in the line buffer, which -n? also reads into:
0343                             ;      a line that calls -n? and carries on afterwards runs what was typed.
0343                             ;      (The stored program never comes back to the line, so it may.)
0343                             ;    - The editor"s own keys are not the program"s: -n? is the plain line
0343                             ;      read of the other builds.
0343                             ; 
0343                             ;  The data stack is the CPU's stack, so the editor works on top of whatever
0343                             ;  the last line left there, with TOS pushed like the rest.
0343                             ; =============================================================================
0343                          IF   EDGEN   
                    INIT:        ; reset (A = 0)
0343                          ENDIF      
0343                          IF   EDGEN*CHECKED   
                                 ; Clear the lower half of the letter page: every variable starts at 0, and
                                 ; every word cell holds 0000h, the address an undefined word is caught at
                                 ; (see e_hi).
                              LD   HL,LET   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
0343                          ENDIF      
0343                          IF   EDGEN   
                              JR   edit0   
0343                          ENDIF      
0343                          IF   EDITOR   
                                 ; Right arrow: one to the right, by printing the character there
                    RIGHT:    LD   A,L   
                              CP   E   
                              JR   Z,ed1   ; at the end
                              LD   A,(HL)   
                              INC   L   
                              JR   lf1   
                                 ; Esc: alone it drops the line. An arrow key sends Esc [ and a letter, so
                                 ; wait about 5 ms for a second key: after a "[" read on to the letter that
                                 ; ends the sequence, and act on C (right) and D (left).
                    ESC:      LD   BC,5*MSLOOP   
                    ES1:      CALL   rawk   
                              JR   NZ,es2   
                              DEC   BC   
                              LD   A,B   
                              OR   C   
                              JR   NZ,es1   
                              CALL   fin   ; no second key: the line is dropped
                              JR   edit   
                    ES2:      CP   "["   
                              JR   NZ,ed1   ; not a sequence known here
                    ES3:      CALL   ekey   
                              CP   40h   
                              JR   C,es3   ; (its parameters)
                              SUB   "C"   
                              JR   Z,right   
                              DEC   A   ; "D"?
                              JR   NZ,ed1   ; no: on into left
                                 ; Left arrow: the cursor goes one to the left
                    LEFT:     LD   A,L   
                              ADD   A,A   
                              JR   Z,ed1   ; (L = 80h: at the start)
                              DEC   L   
                              LD   A,8   
                              ;*Macro unroll: lf1:    PUTA
                    LF1:      DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              JR   ed1   
                                 ; edit0: reset, an error or a break: both stacks are cleared, and the cursor
                                 ;   is shown, in case the program had hidden it and could not show it again.
                                 ; skend: a program that ended inside skip: its return address goes.
                                 ; edend: a program that ended: TOS joins the rest of the data stack.
                    EDIT0:    LD   SP,DSTOP-2   ; empty (the cell that stands for TOS is pushed)
0343                          ENDIF      
0343                          IF   EDITOR*ANS   
                              XOR   A   ; (pshow wants the carry clear)
                              CALL   pshow   ; ESC [ ? 2 5 h
0343                          ENDIF      
0343                          IF   EDITOR*(1-ANS)   
                              LD   A,1   
                              CALL   CONCUR   ; show the cursor
0343                          ENDIF      
0343                          IF   EDITOR   
                              DB   21h   ; (LD HL,nn: steps over the next two bytes)
                    SKEND:    POP   DE   
                    EDEND:    PUSH   HL   
                                 ; edit: start a new input line.
                    EDIT:     LD   IY,RSTOP   ; the return stack is empty
                              ;*Macro unroll:  SETIX                   ; (a file read or written may have changed IX)
                              DS   CPM+FAST-CPM*FAST,0DDh   ; (a file read or written may have changed IX)
                              DS   CPM+FAST-CPM*FAST,21h   
                              DS   CPM+FAST-CPM*FAST,ANXT&0FFh   
                              DS   CPM+FAST-CPM*FAST,ANXT/256   
                              LD   HL,0   
                              LD   (KEYBUF),HL   ; no key is held, and the break key is on
                              LD   (EDLN),HL   ; no line is being edited
                              LD   HL,LINEBUF   ; HL = the cursor,
                              LD   E,L   ;   E = the end of the line (its low byte)
                    ED1:      CALL   ekey   
                              CP   7Fh   
                              JR   Z,bsp   ; DEL
                              CP   " "   
                              JR   NC,insc   
                              CP   9   
                              JR   Z,insc   ; Tab is text
                              CP   8   
                              JR   Z,bsp   
                              CP   1Bh   
                              JR   Z,esc   
                              PUSH   HL   ; a command key? Look it up
                              LD   HL,cmds   
                              LD   B,NCMD   
                    ED2:      CP   (HL)   
                              INC   HL   
                              JR   Z,ed3   
                              INC   HL   
                              INC   HL   
                              DJNZ   ed2   
                              POP   HL   
                              JR   ed1   ; no: the key is ignored
                    ED3:      LD   A,(HL)   
                              INC   HL   
                              LD   H,(HL)   
                              LD   L,A   
                              EX   (SP),HL   ; the command's address: fin returns to it
                                 ; fin: end the input line: CR LF and a NUL after it, and a new line on the
                                 ; terminal. Leaves BC -> the line and HL -> the NUL.
                    FIN:      LD   H,LETPAGE   
                              LD   L,E   
                              LD   (HL),13   
                              INC   L   
                              LD   (HL),10   
                              DEC   L   
                              CALL   prl   ; (prints the CR LF)
                              LD   (HL),0   
                              LD   BC,LINEBUF   
                              RET      
                                 ; Backspace, DEL: the character before the cursor goes. The cursor moves
                                 ; left, the rest of the line moves down over it, and the last place (now a
                                 ; space) is printed over along with the rest.
                    BSP:      LD   A,L   
                              ADD   A,A   
                              JR   Z,ed1   ; at the start
                              DEC   L   
                              ;*Macro unroll:  PUTK    08h             ; backspace
                              DS   1-CPM,3Eh   ; backspace
                              DS   1-CPM,08h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,08h   
                              PUSH   HL   
                    BS1:      INC   L   
                              LD   A,(HL)   
                              DEC   L   
                              LD   (HL),A   
                              INC   L   
                              LD   A,L   
                              CP   E   
                              JR   NZ,bs1   
                              DEC   L   
                              LD   (HL)," "   
                              POP   HL   
                              LD   D,E   
                              DEC   E   
                              JR   ic2   
                                 ; A character goes in at the cursor: it ripples up through the rest of the
                                 ; line, the cursor moves on, and the rest is printed again.
                    INSC:     LD   B,A   
                              LD   A,E   
                              CP   0FDh   
                              JR   Z,ed1   ; the line is full: 125 characters
                              LD   A,B   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              PUSH   HL   
                    IC1:      LD   A,(HL)   
                              LD   (HL),B   
                              LD   B,A   
                              LD   A,L   
                              INC   L   
                              CP   E   
                              JR   NZ,ic1   
                              POP   HL   
                              INC   L   
                              INC   E   
                              LD   D,E   
                    IC2:      CALL   tail   
                              JR   ed1   
                                 ; tail: print the line from the cursor to D (a low byte), and bring the
                                 ; cursor back with backspaces. Nothing at all if the cursor is at D.
                    TAIL:     LD   C,L   
                    TA1:      LD   A,L   
                              CP   D   
                              JR   Z,ta2   
                              LD   A,(HL)   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              INC   L   
                              JR   ta1   
                    TA2:      LD   A,L   
                              CP   C   
                              RET   Z   
                              ;*Macro unroll:  PUTK    08h             ; backspace
                              DS   1-CPM,3Eh   ; backspace
                              DS   1-CPM,08h   
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APTK&0FFh   
                              DS   CPM,APTK/256   
                              DS   CPM,08h   
                              DEC   L   
                              JR   ta2   
                                 ; ekey: wait for a key
                    EKEY:     CALL   rawk   
                              JR   Z,ekey   
                              RET      
                                 ; The command keys, and where each goes (after fin).
                    CMDS:     DB   13   
                              DW   cret   
                              DB   7   ; ^G
                              DW   crun   
                              DB   12   ; ^L
                              DW   clist   
                              DB   5   ; ^E
                              DW   cedln   
                              DB   18   ; ^R
                              DW   cread   
                              DB   23   ; ^W
                              DW   cwrite   
                              DB   14   ; ^N
                              DW   cnew   
                              DB   24   ; ^X
                              DW   LEAVE   
                    NCMD:     EQU   8   
                                 ; ^N: no program
                    CNEW:     XOR   A   
                              LD   (PROG),A   
                    GED0:     JR   gedit   
                                 ; ^E: line n goes into the input line, to be changed. EDLN remembers which
                                 ; line it was: Return puts the text back in its place.
                    CEDLN:    CALL   rdnum   
                              PUSH   HL   
                              CALL   find   ; HL -> the line, or the NUL if there is none
                              POP   DE   
                              LD   A,(HL)   
                              OR   A   
                              JR   Z,ged0   
                              LD   (EDLN),DE   
                              LD   DE,LINEBUF   
                    CE1:      LD   A,(HL)   ; copy it, and show it, up to its CR (or LF)
                              CP   13   
                              JR   Z,ce2   
                              CP   10   
                              JR   Z,ce2   
                              LD   (DE),A   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              INC   HL   
                              INC   E   
                              LD   A,E   
                              CP   0FDh   ; (a longer line is cut at 125 characters)
                              JR   NZ,ce1   
                    CE2:      EX   DE,HL   ; the cursor is at the line's end
                              LD   E,L   
                              JP   ed1   
                                 ; Return. If ^E put a line here, the text goes back in its place. If not:
                                 ; a number and text is a line to put in, a number alone a line to take out,
                                 ; and anything else is run where it is.
                    CRET:     PUSH   HL   ; the end of what was typed
                              LD   HL,(EDLN)   
                              LD   A,H   
                              OR   L   
                              JR   Z,cr1   
                              PUSH   HL   
                              CALL   delln   
                              POP   HL   
                              JR   ins   
                    CR1:      CALL   rdnum   ; HL = the number it starts with, BC -> after
                              LD   A,C   ; C is still 80h if there was no number:
                              ADD   A,A   ;   only then is twice it 0
                              JR   Z,st0p   ; no number: run the line
                              LD   A,(BC)   
                              CP   13   
                              JR   NZ,cr2   
                              POP   DE   ; the number alone: take that line out
                              CALL   delln   
                              JR   gedit   
                    CR2:      INC   BC   ; step over the one character after the number
                                 ; Put the text at BC in as line n (in HL): open a gap of its length there,
                                 ; CR and LF included, and copy it in.
                    INS:      CALL   find   ; HL -> where it goes
                              POP   DE   ; the end of what was typed
                              LD   A,E   
                              SUB   C   ; A = the length of the text, with its CR LF
                              PUSH   BC   ; the text
                              LD   C,A   
                              LD   B,0   
                              PUSH   BC   ; its length
                              LD   D,H   
                              LD   E,L   ; DE = where it goes
                              XOR   A   
                              LD   C,A   ; BC = 0: CPIR looks as far as it needs to
                              CPIR      ; HL -> one past the program's NUL
                              SBC   HL,DE   ; the number of bytes to move up, NUL included
                              LD   B,H   
                              LD   C,L   
                              ADD   HL,DE   
                              DEC   HL   ; HL -> the NUL
                              EX   DE,HL   
                              EX   (SP),HL   ; HL = the length; where it goes is kept
                              PUSH   HL   
                              ADD   HL,DE   ; the NUL's new place
                              EX   DE,HL   
                              LDDR      ; move the rest of the program up
                              POP   BC   ; the length
                              POP   DE   ; where it goes
                              POP   HL   ; the text
                              LDIR      
                    GEDIT:    JP   edit   
                                 ; ^G: run the program. st0p: run the typed line (BC -> it).
                    CRUN:     LD   BC,PROG   
                              DB   3Eh   ; (LD A,n: steps over the POP)
                    ST0P:     POP   HL   ; (the end of what was typed)
                                 ; st0: start running at BC. The heap starts after the stored program's NUL.
                    ST0:      LD   HL,PROG   
                              XOR   A   
                    ST1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,st1   
                              LD   (HEAP),HL   
0343                          ENDIF      
0343                          IF   EDITOR*QK   
                              CALL   skclr   ; every run starts with an empty skip cache
0343                          ENDIF      
0343                          IF   EDITOR*CHECKED   
                              ;*Macro unroll:  NEGH                    ; minus the heap's first address: '_' may not
                              DS   1-CPM,0E7h   ; minus the heap"s first address: "_' may not
                              DS   CPM,0CDh   
                              DS   CPM,ANEG&0FFh   
                              DS   CPM,ANEG/256   
                              LD   (NPEND),HL   ;   release below it
0343                          ENDIF      
0343                          IF   EDITOR   
                              POP   HL   ; TOS: the data stack is as the last line left it
                              ;*Macro unroll:  NEXT                    ; (its return address is thrown away)
                              DS   (1-CPM)*(1-FAST),0F7h   ; (its return address is thrown away)
                              DS   CPM+FAST-CPM*FAST,0DDh   
                              DS   CPM+FAST-CPM*FAST,0E9h   
                                 ; ^L: list from line n. DE = the number of the line at HL.
                    CLIST:    CALL   rdnum   ; HL = n, or 0 if there was none:
                              LD   A,H   
                              OR   L   
                              JR   NZ,li0   
                              INC   L   ;   then from line 1
                    LI0:      PUSH   HL   
                              CALL   find   
                              POP   DE   
                    LI1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,gedit   ; the end of the text
                              CALL   rawk   
                              JR   Z,li3   ; no key: carry on
                              CP   3   
                              CALL   NZ,ekey   ; any key but Ctrl-C: wait for one more
                              CP   3   
                              JR   Z,gedit   ; Ctrl-C, first or second, ends the list
                    LI3:      PUSH   HL   
                              PUSH   DE   
                              EX   DE,HL   
                              CALL   pdec   ; the line's number,
                              LD   A," "   
                              ;*Macro unroll:  PUTA                    ;   a space,
                              DS   1-CPM,0EFh   ;   a space,
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              POP   DE   
                              POP   HL   
                              INC   DE   
                              CALL   prl   ;   and the line
                              JR   li1   
                                 ; delln: take line n (in HL) out: copy everything after it down over it.
                    DELLN:    CALL   find   
                              LD   D,H   
                              LD   E,L   
                              CALL   nxl   ; HL -> the next line
                    DE1:      LD   A,(HL)   
                              LD   (DE),A   
                              INC   HL   
                              INC   DE   
                              OR   A   
                              JR   NZ,de1   
                              RET      
                                 ; find: HL = a line number. Returns HL -> that line, or -> the NUL at the end
                                 ; of the text if there are fewer lines (or the number is 0). Keeps BC.
                    FIND:     EX   DE,HL   
                              LD   HL,PROG   
                    FI1:      DEC   DE   
                              LD   A,D   
                              OR   E   
                              RET   Z   
                              CALL   nxl   
                              JR   NZ,fi1   
                              RET      
                                 ; nxl: step HL over one line, to just past its LF (and return not-zero), or
                                 ; stop at the NUL that ends the text (and return zero).
                    NXL:      LD   A,(HL)   
                              OR   A   
                              RET   Z   
                              INC   HL   
                              CP   10   
                              JR   NZ,nxl   
                              OR   A   
                              RET      
                                 ; prl: print the line at HL, to its LF; HL -> just past it.
                    PRL:      LD   A,(HL)   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              LD   A,(HL)   
                              INC   HL   
                              CP   10   
                              JR   NZ,prl   
                              RET      
0343                          ENDIF      
0343                          IF   EDGEN   
                    GED1:     JP   edit   
                                 ; ^R, generic: what comes in from now until ^Z is the program. A CR is
                                 ; stored as CR LF; a LF right after a line end is dropped (it is the CR's
                                 ; own, or an empty line's), and a LF anywhere else ends a line too. A last
                                 ; line with no end is given one. Nothing is echoed, and there is no check
                                 ; for running out of memory.
                    CREAD:    LD   HL,PROG-1   
                              LD   (HL),10   ; (as if a line had just ended: the byte is
                              INC   HL   ;   the line buffer's last, and spare)
                    RD1:      CALL   ekey   
                              LD   C,A   
                              CP   1Ah   
                              JR   NZ,rd2   
                              LD   A,10   ; ^Z ends the last line, as a LF would
                    RD2:      CP   10   
                              JR   NZ,rd3   
                              DEC   HL   
                              CP   (HL)   
                              INC   HL   
                              JR   Z,rd4   ; straight after a line end: dropped
                              LD   A,13   ; anywhere else it ends the line
                    RD3:      LD   (HL),A   
                              INC   HL   
                              CP   13   
                              JR   NZ,rd4   
                              LD   (HL),10   ; after a CR goes a LF
                              INC   HL   
                    RD4:      LD   A,C   
                              CP   1Ah   
                              JR   NZ,rd1   
                              LD   (HL),0   
                              JR   ged1   
                                 ; ^W, generic: the text is printed as it is, for the terminal to capture.
                    CWRITE:   LD   HL,PROG   
                    CW1:      LD   A,(HL)   
                              OR   A   
                              JR   Z,ged1   
                              ;*Macro unroll:  PUTA
                              DS   1-CPM,0EFh   
                              DS   CPM,0CDh   
                              DS   CPM,APUT&0FFh   
                              DS   CPM,APUT/256   
                              INC   HL   
                              JR   cw1   
0343                          ENDIF      
0343                          IF   EDITOR*CPM   
                    CFCB:     EQU   005Ch   ; the file's name is kept here, where the CCP
                                 ;   put the one from the command line
                                 ; ^W, CP/M: write the file: delete the old one, make it anew, write the
                                 ; text in records of 128 bytes, and close it. The text's NUL and the 127
                                 ; bytes after it are set to ^Z meanwhile, which pads the last record. (A
                                 ; full disk or directory is not noticed: the calls fail and that is all.)
                    CWRITE:   CALL   setname   
                              LD   C,19   ; delete
                              CALL   fbdos   
                              LD   C,22   ; make
                              CALL   fbdos   
                              LD   HL,PROG   
                              XOR   A   
                    CW1:      CP   (HL)   
                              INC   HL   
                              JR   NZ,cw1   
                              DEC   HL   ; HL -> the NUL
                              PUSH   HL   
                              LD   B,128   
                    CW2:      LD   (HL),1Ah   
                              INC   HL   
                              DJNZ   cw2   
                              POP   HL   
                              LD   DE,PROG   
                    CW3:      LD   A,E   ; a record that starts before the end is written
                              SUB   L   
                              LD   A,D   
                              SBC   A,H   
                              JR   NC,cw4   
                              PUSH   HL   
                              LD   C,21   ; write, from where the record lies
                              CALL   frec   
                              POP   HL   
                              JR   cw3   
                    CW4:      LD   (HL),0   ; the NUL again
                              LD   C,16   ; close
                              CALL   fbdos   
                              JP   edit   
                                 ; frec: BDOS function C (read or write a record) with the 128 bytes at DE.
                                 ; Returns A = the BDOS's answer, HL = DE and DE = DE + 128.
                    FREC:     PUSH   DE   
                              PUSH   BC   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              POP   BC   
                              CALL   fbdos   
                              POP   DE   
                              LD   HL,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              RET      
                                 ; setname: if a name was typed (the line does not start with its CR), put it
                                 ; in the FCB: up to 8 characters, a dot, up to 3 more, in capitals. The drive
                                 ; is the current one. Then, name or no name, clear the FCB after the name,
                                 ; as it must be before a file is opened or made.
                    SETNAME:   LD   DE,LINEBUF   
                              LD   A,(DE)   
                              CP   13   
                              JR   Z,fcbclr   
                              LD   HL,CFCB   
                              LD   (HL),0   ; the current drive
                              LD   B,11   
                    SN1:      INC   L   
                              LD   (HL)," "   
                              DJNZ   sn1   
                              LD   L,CFCB+1   
                    SN2:      LD   A,(DE)   
                              INC   DE   
                              CP   13   
                              JR   Z,fcbclr   
                              CP   "."   
                              JR   NZ,sn3   
                              LD   L,CFCB+9   ; the type
                              JR   sn2   
                    SN3:      CP   "a"   
                              JR   C,sn4   
                              AND   5Fh   ; a capital
                    SN4:      LD   (HL),A   
                              INC   L   
                              JR   sn2   
                    FCBCLR:   LD   HL,CFCB+12   
                              LD   B,24   
                    FC1:      LD   (HL),0   
                              INC   HL   
                              DJNZ   fc1   
                              RET      
                                 ; fbdos: BDOS function C on the file
                    FBDOS:    LD   DE,CFCB   
                              JP   BDOS   
                                 ; ^R, CP/M: read the file. A name typed before the key is the file's name
                                 ; from now on. (On into load, which returns to edit.)
                    CREAD:    CALL   setname   
                              LD   HL,edit   
                              PUSH   HL   
                                 ; load: read the file into PROG. No such file: no program. The text ends at
                                 ; the file"s first ^Z (1Ah), which pads a text file"s last record; one more
                                 ; goes after the last record, so the search always stops. And every line
                                 ; must end in LF: a last line without one is given a CR LF. (The FCB is
                                 ; clear after its name: the CCP left it so, or setname did.)
                    LOAD:     LD   C,15   ; open (no such file: the first read fails
                              CALL   fbdos   ;   too)
                              LD   DE,PROG   
                    LD1:      LD   C,20   ; read the next 128 bytes
                              CALL   frec   
                              OR   A   
                              JR   Z,ld1   
                              LD   (HL),1Ah   ; (HL = where the record that failed would be)
                              LD   HL,PROG-1   
                              LD   A,10   ; (a file with no text needs nothing added)
                    TR1:      INC   HL   
                              LD   E,A   ; E = the character before this one
                              LD   A,(HL)   
                              CP   1Ah   
                              JR   NZ,tr1   
                              LD   A,E   
                              CP   10   
                              JR   Z,tr2   
                              LD   (HL),13   
                              INC   HL   
                              LD   (HL),10   
                              INC   HL   
                    TR2:      LD   (HL),0   
                              RET      
0343                          ENDIF      
0343                             ; =============================================================================
0343                          IF   CPM   
                                 ; The RAM pages follow the image; the heap may grow to the BDOS.
                    START:       
0343                          ENDIF      
0343                          IF   CPM*CHECKED*(1-EDITOR)   
                                 ; Clear the lower half of the letter page (as the editor build does
                                 ; at its start).
                              LD   HL,LET   
                              XOR   A   
                    INI1:     LD   (HL),A   
                              INC   L   
                              JP   P,ini1   ; +00h to +7Fh
0343                          ENDIF      
0343                          IF   CPM*(1-EDITOR)   
                              LD   DE,005Ch   ; open the file named on the command line
                              LD   C,15   ; (no such file: the first read fails too,
                              CALL   BDOS   ;   and the program is empty)
                              LD   DE,PROG   
                    LD1:      PUSH   DE   
                              LD   C,26   ; set the DMA address
                              CALL   BDOS   
                              LD   DE,005Ch   
                              LD   C,20   ; read the next 128 bytes
                              CALL   BDOS   
                              POP   HL   ; HL = the address this record went to
                              OR   A   
                              JR   NZ,ld2   
                              LD   DE,128   
                              ADD   HL,DE   
                              EX   DE,HL   
                              JR   ld1   
                    LD2:      LD   (HL),0   ; the end of the file counts as NUL
                              INC   HL   ; the heap starts after it
                              LD   BC,PROG   ; the IP
0343                          ENDIF      
0343                          IF   CPM*(1-EDITOR)*QK   
                              CALL   skclr   ; an empty skip cache
0343                          ENDIF      
0343                          IF   CPM*(1-EDITOR)   
                              JP   st2   
0343                          ENDIF      
0343                          IF   FAST   
                                 ; =============================================================================
                                 ;  The fast build (SPEED = 2)
                                 ; 
                                 ;  The inner loop is a table: 256 entries, the low bytes of the handlers'
                                 ;  addresses in one page and the high bytes in the next. The dispatcher (at
                                 ;  next0, and inline, as NEXTF, at the end of the fast build's own entries,
                                 ;  so there is no jump back to it; the ordinary handlers end in JP (IX), with
                                 ;  IX = next0, as in the CP/M builds):
                                 ; 
                                 ;      LD A,(BC) / INC BC / EX DE,HL / LD L,A / LD H,DTAB/256 /
                                 ;      LD A,(HL) / INC H / LD H,(HL) / LD L,A / JP (HL)
                                 ; 
                                 ;  So every entry starts with TOS in DE, not HL. The punctuation entries are
                                 ;  thunks into the ordinary handlers (EX DE,HL / JP handler); the letters and
                                 ;  digits have one entry each, which knows its cell or its value already.
                                 ; =============================================================================
                    FTSTORE:   EX   DE,HL   ; !
                              JP   h_store   
                    FTSTR:    EX   DE,HL   ; "
                              JP   h_str   
                    FTNUM:    EX   DE,HL   ; #
                              JP   h_num   
                    FTPRINT:   EX   DE,HL   ; $
                              JP   h_print   
                    FTSWAP:   EX   DE,HL   ; %
                              JP   h_swap   
                    FTAND:    EX   DE,HL   ; &
                              JP   h_and   
                    FTEMIT:   EX   DE,HL   ; '
                              JP   h_emit   
                    FTOPEN:   EX   DE,HL   ; (
                              JP   h_open   
                    FTCLOSE:   EX   DE,HL   ; )
                              JP   h_close   
                    FTMUL:    EX   DE,HL   ; *
                              JP   h_mul   
                    FTADD:    EX   DE,HL   ; +
                              JP   h_add   
                    FTCFETCH:   EX   DE,HL   ; ,
                              JP   h_cfetch   
                    FTSUB:    EX   DE,HL   ; -
                              JP   h_sub   
                    FTCSTORE:   EX   DE,HL   ; .
                              JP   h_cstore   
                    FTDIV:    EX   DE,HL   ; /
                              JP   h_div   
                    FTDUP:    EX   DE,HL   ; :
                              JP   h_dup   
                    FTDROP:   EX   DE,HL   ; ;
                              JP   h_drop   
                    FTLT:     EX   DE,HL   ; <
                              JP   h_lt   
                    FTEQ:     EX   DE,HL   ; =
                              JP   h_eq   
                    FTGT:     EX   DE,HL   ; >
                              JP   h_gt   
                    FTKEY:    EX   DE,HL   ; ?
                              JP   h_key   
                    FTFETCH:   EX   DE,HL   ; @
                              JP   h_fetch   
                    FTDEF:    EX   DE,HL   ; [
                              JP   h_def   
                    FTBREAK:   EX   DE,HL   ; \
                              JP   h_break   
                    FTRET:    EX   DE,HL   ; ]
                              JP   h_ret   
                    FTXOR:    EX   DE,HL   ; ^
                              JP   h_xor   
                    FTALLOC:   EX   DE,HL   ; _
                              JP   h_alloc   
                    FTGRAVE:   EX   DE,HL   ; `
                              JP   h_grave   
                    FTTOR:    EX   DE,HL   ; {
                              JP   h_tor   
                    FTOR:     EX   DE,HL   ; |
                              JP   h_or   
                    FTFROMR:   EX   DE,HL   ; }
                              JP   h_fromr   
                    FTNOT:    EX   DE,HL   ; ~
                              JP   h_not   
                                 ; The commonest punctuation, written for the fast build: TOS in DE on the
                                 ; way in, and the dispatcher inline on the way out.
                    FS_ADD:      ; +
                              POP   HL   
                              ADD   HL,DE   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_SUB:      ; -
                              LD   A,(BC)   ; a digit next: a negative number
                              SUB   "0"   
                              CP   10   
                              JR   C,fs_neg   
                              POP   HL   
                              OR   A   
                              SBC   HL,DE   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_NEG:   EX   DE,HL   
                              JP   h_sub   
                    FS_DUP:      ; :
                              PUSH   DE   
                              EX   DE,HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_DROP:      ; ;
                              POP   HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_SWAP:      ; %
                              POP   HL   
                              PUSH   DE   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_FET:      ; @
                              EX   DE,HL   
                              LD   E,(HL)   
                              INC   HL   
                              LD   D,(HL)   
                              EX   DE,HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_CFET:      ; ,
                              LD   A,(DE)   
                              LD   L,A   
                              LD   H,0   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_LT:       ; <
                              POP   HL   ; a < b: HL = a, DE = b
                    FS_LT1:   LD   A,H   
                              XOR   80h   
                              LD   H,A   
                              LD   A,D   
                              XOR   80h   
                              LD   D,A   
                              SBC   HL,DE   ; carry if HL < DE
                              SBC   HL,HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_GT:       ; >
                              POP   HL   ; a > b  is  b < a
                              EX   DE,HL   
                              JP   fs_lt1   
                    FS_EQ:       ; =
                              POP   HL   
                              OR   A   
                              SBC   HL,DE   
                              LD   A,H   
                              OR   L   
                              CP   1   ; carry only if a - b = 0
                              SBC   HL,HL   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_AND:      ; &
                              POP   HL   
                              LD   A,H   
                              AND   D   
                              LD   H,A   
                              LD   A,L   
                              AND   E   
                              LD   L,A   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_OR:       ; |
                              POP   HL   
                              LD   A,H   
                              OR   D   
                              LD   H,A   
                              LD   A,L   
                              OR   E   
                              LD   L,A   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_XOR:      ; ^
                              POP   HL   
                              LD   A,H   
                              XOR   D   
                              LD   H,A   
                              LD   A,L   
                              XOR   E   
                              LD   L,A   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_NOT:      ; ~
                              LD   A,E   
                              CPL      
                              LD   L,A   
                              LD   A,D   
                              CPL      
                              LD   H,A   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
                              DS   FAST,0EBh   
                              DS   FAST,6Fh   
                              DS   FAST,26h   
                              DS   FAST,DTPG   
                              DS   FAST,7Eh   
                              DS   FAST,24h   
                              DS   FAST,66h   
                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_MUL:      ; *
                              POP   HL   ; (the two the other way round: the same)
                              JP   mulq   
                    FS_OPEN:      ; (
                              LD   A,D   
                              OR   E   
                              POP   HL   
                              JR   Z,fs_op0   
                              PUSH   BC   ; the block start
                              JP   rpushn   
                    FS_OP0:   CALL   skip   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
                              DS   FAST,0Ah   
                              DS   FAST,03h   
