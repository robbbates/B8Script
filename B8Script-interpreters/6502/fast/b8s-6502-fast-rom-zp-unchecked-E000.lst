                    UD0:      LDY   #16   
                    UD1:      ASL   0,X   
                              ROL   1,X   
                              ROL   0FEh,X   
                              ROL   0FFh,X   
                              SEC      
                              LDA   0FEh,X   
                              SBC   D0   
                              STA   T0   
                              LDA   0FFh,X   
                              SBC   D1   
                              BCC   ud2   
                              STA   0FFh,X   
                              LDA   T0   
                              STA   0FEh,X   
                              INC   0,X   ; the quotient bit (bit 0 is free)
                    UD2:      DEY      
                              BNE   ud1   
                              RTS      
E7AC                          ENDIF      
