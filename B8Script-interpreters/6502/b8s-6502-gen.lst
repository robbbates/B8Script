E29A   20 F0 E0               JSR   digit   ; (comes back with the carry set)
E29D   B0 06                  BCS   neg   ; always: the number, negated
E29F                             ; "~": -x - 1, which is neg with the carry clear, as it is here
E29F   90 05        H_NOT:    BCC   neg1   ; always
E2A1                             ; absv: TOS = |TOS|.  negm: TOS = -TOS if the N flag is set.
E2A1   A5 03        ABSV:     LDA   TH   
E2A3   10 0D        NEGM:     BPL   ab9   
E2A5                             ; neg: TOS = -TOS
E2A5   38           NEG:      SEC      
E2A6   A9 00        NEG1:     LDA   #0   
E2A8   E5 02                  SBC   TL   
E2AA   85 02                  STA   TL   
E2AC   A9 00                  LDA   #0   
E2AE   E5 03                  SBC   TH   
E2B0   85 03                  STA   TH   
E2B2   60           AB9:      RTS      
E2B3                             ; Signed compares: a - b sets N and V; N xor V is "a < b". The carry ends up
E2B3                             ; clear for true, and bool turns it into -1 (true) or 0 (both pop NOS first).
E2B3   20 00 E3     H_GT:     JSR   h_swap   ; a > b is b < a
E2B6   BD 00 02     H_LT:     LDA   DSL,X   
E2B9   C5 02                  CMP   TL   
E2BB   BD 00 03               LDA   DSH,X   
E2BE   E5 03                  SBC   TH   
E2C0   70 02                  BVS   lt1   
E2C2   49 80                  EOR   #80h   
E2C4   0A           LT1:      ASL      
E2C5   E8                     INX      ; (keeps the carry; never leaves X at 0)
E2C6   D0 07                  BNE   bool   ; always
E2C8   20 84 E2     H_EQ:     JSR   sub1   ; a - b: zero if equal; A = its high byte
E2CB   05 02                  ORA   TL   
E2CD   C9 01                  CMP   #1   ; carry clear if A = 0
E2CF   A9 00        BOOL:     LDA   #0   
E2D1   69 FF                  ADC   #0FFh   ; carry clear: FF, set: 00
E2D3   85 02                  STA   TL   
E2D5   85 03                  STA   TH   
E2D7   60                     RTS      
E2D8                             ; "*": the classic shift-right multiply. The multiplier leaves TH:TL from the
E2D8                             ; bottom while the product comes in at the top, through A:T0 above it; after
E2D8                             ; 16 rounds TH:TL hold the low 16 bits, which are all that is kept.
E2D8   A0 10        H_MUL:    LDY   #16   
E2DA   84 05                  STY   T1   ; the round count
E2DC   A9 00                  LDA   #0   
E2DE   85 04                  STA   T0   ; A:T0 = the upper half
E2E0   46 03                  LSR   TH   
E2E2   66 02                  ROR   TL   ; the first multiplier bit
E2E4   90 0D        ML1:      BCC   ml2   
E2E6   A8                     TAY      
E2E7   18                     CLC      
E2E8   A5 04                  LDA   T0   
E2EA   7D 00 02               ADC   DSL,X   
E2ED   85 04                  STA   T0   
E2EF   98                     TYA      
E2F0   7D 00 03               ADC   DSH,X   ; upper half += the multiplicand
E2F3   6A           ML2:      ROR      
E2F4   66 04                  ROR   T0   
E2F6   66 03                  ROR   TH   
E2F8   66 02                  ROR   TL   ; everything one place right; next bit out
E2FA   C6 05                  DEC   T1   
E2FC   D0 E6                  BNE   ml1   
