  1892                              <1> ; =============================================================================
  1893                              <1> ;  The imports: kernel32.dll only. An import directory entry, the import
  1894                              <1> ;  lookup table, the hint/name entries and the DLL's name; then the import
  1895                              <1> ;  address table, which the loader fills in, right below `next`, so that
  1896                              <1> ;  CALL [EBP+d8] reaches it.
  1897                              <1> ; =============================================================================
  1898                              <1> %macro  IMPORTS 1
  1899                              <1>         IMP     GetStdHandle
  1900                              <1>         IMP     GetConsoleMode
  1901                              <1>         IMP     SetConsoleMode
  1902                              <1>         IMP     GetCommandLineA
  1903                              <1>         IMP     CreateFileA
  1904                              <1>         IMP     ReadFile
  1905                              <1>         IMP     WriteFile
  1906                              <1> %if EDITOR
  1907                              <1>         IMP     CloseHandle             ; (a runner leaves its file open)
  1908                              <1> %endif
  1909                              <1>         IMP     WaitForSingleObject
  1910                              <1>         IMP     WaitForMultipleObjects
  1911                              <1>         IMP     CreateWaitableTimerExW
  1912                              <1>         IMP     SetWaitableTimer
  1913                              <1>         IMP     ReadConsoleInputA
  1914                              <1>         IMP     GetTickCount
  1915                              <1>         IMP     ExitProcess
  1916                              <1> %endmacro
