                              DS   CHECKED,AFNX&0FFh   
                              DS   CHECKED,AFNX/256   
E5C2                          ENDIF      
E5C2                             ; skpo: a false ( skips (the checked build: ] is the wrong closer for it)
E5C2                          IF   FAST*CHECKED   
                    SKPO:     LDA   #"]"   
                              JMP   skip   
E5C2                          ENDIF      
E5C2                          IF   FAST*(1-CHECKED)   
                    SKPO:     JMP   skip   
                                 ; ! and . (unchecked)
                    FT_STO:   LDA   2,X   ; !
                              STA   (0,X)   
                              INC   0,X   
                              BNE   fst1   
                              INC   1,X   
                    FST1:     LDA   3,X   
                              STA   (0,X)   
                              INX      
                              INX      
                              INX      
                              INX      
                              ;*Macro unroll:  NEXTF
                              DS   1-CHECKED,0A0h   
