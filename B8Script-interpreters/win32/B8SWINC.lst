  1524 0000066F 894570              <1>         mov     [V(v_npend)],eax
  1525                              <1> %endif
  1526 00000672 5B                  <1>         pop     ebx
  1527 00000673 FFE5                <1>         jmp     ebp
  1528                              <1> 
  1529                              <1> %if EDITOR
  1530                              <1> ; ^L: list from line n. EDX = the number of the line at ESI.
  1531                              <1> clist:  call    rdnum                   ; DX = n, or 0 if there was none:
  1532                              <1>         movzx   eax,dx
  1533                              <1>         test    eax,eax
  1534                              <1>         jnz     .li0
  1535                              <1>         inc     eax                     ;   then from line 1
  1536                              <1> .li0:   push    eax
  1537                              <1>         call    find
  1538                              <1>         pop     edx
  1539                              <1>         mov     esi,edi
  1540                              <1> .li1:   cmp     byte [esi],0
  1541                              <1>         je      gedit                   ; the end of the text
  1542                              <1>         xor     eax,eax
  1543                              <1>         call    waitk
  1544                              <1>         jz      .li3                    ; no key: carry on
  1545                              <1>         cmp     al,3
  1546                              <1>         je      gedit                   ; Ctrl-C ends the list,
  1547                              <1>         call    ekey                    ;   any other key holds it until the
  1548                              <1>         cmp     al,3                    ;   next (and a Ctrl-C then ends it)
  1549                              <1>         je      gedit
  1550                              <1> .li3:   push    edx
  1551                              <1>         xchg    eax,edx
  1552                              <1>         call    pdec                    ; the line's number,
  1553                              <1>         mov     al,' '
  1554                              <1>         call    putc                    ;   a space,
  1555                              <1>         pop     edx
  1556                              <1>         inc     edx
  1557                              <1>         call    prl                     ;   and the line
  1558                              <1>         jmp     .li1
  1559                              <1> 
  1560                              <1> ; ^V: view.
  1561                              <1> cview:  call    pmsg
