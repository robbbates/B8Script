                              DS   FAST,6Fh   
                              DS   FAST,0E9h   
                    FS_AND:      ; &
                              POP   HL   
                              LD   A,H   
                              AND   D   
                              LD   H,A   
                              LD   A,L   
                              AND   E   
                              LD   L,A   
                              ;*Macro unroll:  NEXTF
                              DS   FAST*CHECKED,0CDh   
                              DS   FAST*CHECKED,ACHK&0FFh   
                              DS   FAST*CHECKED,ACHK/256   
